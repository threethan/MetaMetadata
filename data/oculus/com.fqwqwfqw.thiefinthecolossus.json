ZTMTtlgbUyryIeGmqwg&oe=69F20D62"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dq7T7B8klI4Q7kNvwG_mnmE&_nc_oc=AdrPoJJCsHLw10vz_L9oc5-7pBaCqZt7HVyaKckCajawi2FOHKu8lJlDmF7dPlWWoOM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2NcI-d2qv-Ly7w5uCIwP8CTkdLJTe53_4UZhYwMLiVIQ&oe=69F1FFA9"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAWmjOwbVwoQ7kNvwGJImP_&_nc_oc=AdpzzFhaxfTV2r7hD8al-r52yFSPYpeBMdOfzn4uP3uJaSbSMX7R1HxZw3F4eqIRIpg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2duhNk1uRXfANp5XZHNzb1HUZ9xmEJkeA4wIon4v_obg&oe=69F1F3B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQzj9mW19HsQ7kNvwEgNXjJ&_nc_oc=AdqRE3YgtcOrbDmKdPH6MB6GDfJHQYe8ApKoXhFKgfjPRjP9dzjTuZ7Vl5u6yj9YeYw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af108w8P5qjimqwger0EaOiBMxF6Rk371YxPnDwvo76fvA&oe=69F21929"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7612113488916145"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7612199288907565", "version": "1.0"}, "id": "103678698
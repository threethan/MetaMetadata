3RFuevJSbgHEXYeOF0t1LJS1S2d9o1My2CE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTldIJn9gIEmJQFoun43u2uHPEgzHSrl3EY42_QUEjvcw&oe=6AF89ACC"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1OsL5t7xsgQ7kNvwH3HuiV&_nc_oc=Adog97QUSskAxYCO9HbwtqpZ72Bm-LAwkbFaFCCBG8X5CdNO3S-PhFVG6k_I7lhXMj8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7yBvKr6oNLqaLcHrJELlthZCYT7LA2ePoDwiAMEplKg&oe=6AF8A022"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXDqCIWV2DIQ7kNvwHVXnUQ&_nc_oc=Ado9yh7S1S4LmOQgbmGf3xxAe4mGXPV40AOcJOFBBc3QM9dhuWNYEkXxhRrcFZuwGpU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMr5wyTU8rgws3UkVHcuE3nlu1AfueDkYdUx4XDxAvlQ&oe=6AF89269"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjGFBvIhBmUQ7kNvwE89kdy&_nc_oc=Adpzl5lGXuSmQVVD96zTgSf7hHCmiPyxxpo5aV7ipnuaeQpVwZf_pHhGsLJt5Tjhke8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL8odAQAlYB2bJ6lzkjkc8nkLYl_sOkoxsZz65jraz_g&oe=6AF88678"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrF1uDRqBtYQ7kNvwFdC1Nz&_nc_oc=AdqjAZ04N0DFl29Xdr1j5tKbO8a0Y4kqqjEc8Mn7mkuZ1_QLyJpimJa0LBjyKRnQQOg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7UJUKwZaUHdgT5Gzj5zPYYnuKI7aHZHBk-yt2mXx1kQ&oe=6AF8ABE9"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
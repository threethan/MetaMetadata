2GtpoArcTzZfeWZQf63Kvq_oDeVUF-iMvAGSDhm-ChZfU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZJtSHsJqnFLAHNCwHeSdBmeT1MWee9nixI8_5O5WpqQ&oe=6AA4028C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OADpwQaPDKgQ7kNvwFXKwfu&_nc_oc=AdqHTiO-oDdRN74hALdtzi9WOnpIZsyTmnWBQaoD143-MaCcEXAlgFTIS2lPrCgODw4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt07tyV1EOfRWLyN2Rjiz4JP-PB6marIzZGwDle9fp3g&oe=6AA407E2"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eurrH_cS40AQ7kNvwEtQ1Vh&_nc_oc=AdoOhz38Sq1Xj14GMU8L3ah9SMlVW_rl7MOskfEO2tME9zrC6mHxtPUCzm_eqbzMDPU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrM7p1KK4T7CJZwi6zXo4Rw9cZ6ZWKg_l9veTGhxGjhw&oe=6AA3FA29"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqHMVeurvE0Q7kNvwH-W4Dh&_nc_oc=Ado0Ex5UV0idVC6RYKtJDSqFWMdlH2z0GfmNxfovDTE9p_OQa8vhw5Oo3Fh3qDPQUss&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbpuAPs6vb6ZyQiBsDg4iR9YfEkrCxxhUvVB4mIAxcdA&oe=6AA3EE38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qbl9nVTkepQQ7kNvwFndZP4&_nc_oc=AdqDTj6yNnDKpXVLnRgcrR0vOb7GJVlxRgu-rCr-3FS8g4GxMMx5l3OqtJ3wDTF05tM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLujh9p6mJOVPKVNda38rCk2GpqNas4p-eXjxSqTYZqOQ&oe=6AA413A9"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
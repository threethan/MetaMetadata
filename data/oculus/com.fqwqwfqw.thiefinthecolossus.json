Epw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx420RiF8dl5_JiUdLpnQev9LLbHue4tBN2BskrbtWUkA&oe=69AECB8C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTRu1uOg-9oQ7kNvwHHShBN&_nc_oc=AdmFBnqsmm7DLZFLRJ7ICcqqW9vA7V8Sn5Y5AmynLGe_YPI9Zlq9L89QJzkhUL6-Mqo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtZIe_upaQfDvYNrl59ABgPjiDgFPRuu4tIZA8c9iIwA&oe=69AED0E2"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ty7a3mWCyKMQ7kNvwHe8tek&_nc_oc=AdmdxEClGUR9tiJiLfhdWN9AIb-XE1k5xVo8rfCNL-3Ccly8QSN3k47yLsAJ6ya-xQA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZ1TpNq5_BIdSA9YWlEpr7VhdicrE_qQvW0w790u25cg&oe=69AEC329"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6YLY6hDggAQ7kNvwEbjE8K&_nc_oc=AdlpfUnr8iYpzwCsn7Nh9PQEOFqsdAh1tduHFFjTB07WjhD73c39oDe-2OQW78Pr4fM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5eNm14rOivpQJGTo7CNDQHTCc2ZIoe22hQRLhcUhfRQ&oe=69AEB738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtCR49XxZcUQ7kNvwGpurDV&_nc_oc=AdkxftQmkW0KLctkua-mSbnIw8D4LzA3sUEL_PqdD__7m3R8waSKSOIOjKYjqveJOVM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMMzDCGymzfhRksqgkRP4Z0CARyfOT0Dc4Ngu3Zsr_7w&oe=69AEA469"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
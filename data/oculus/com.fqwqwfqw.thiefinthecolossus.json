YFiwBuyQsrjKqa3v9iLZ0fVp3FfWwkCu0Cw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1i4mpDKEbdIpYVfahu5-CFFCDS16tV5N7iLFz78UDJrg&oe=69DB9E8C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwj40WttqPAQ7kNvwHPOQh5&_nc_oc=AdoAYBBRhcmhdDbIHnONZROVOSw610qrk6qz52Llq0MJQ7D_5BVqCV0X3VE9T6VifJA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_vp-iKO29vPjqktjH8pmEC-vGlF6_Yihg5DtDeBvFvw&oe=69DBA3E2"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBvyukFztIEQ7kNvwHY0yG9&_nc_oc=AdqnZeMzLQeZ724DXawfB_cheKVbbY-AYJ5UKts1E3RL3h4I3eF1QgtZLsuCKVb0g1A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DpVI5sUQ0IJuCZTX1T4uil6kdcu7nWL8l-WjXBVbghg&oe=69DB9629"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_Dn8B1LRF4Q7kNvwEOjmHP&_nc_oc=Adr8x_onUEgS2WptbNaeTiLEIbw3gZbjEobj_lFat3sRnhEQ513P4w0gCSr8XPebZcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08fxZLRb4BAs7wTJEyDgbxxJh5tkm9V73ZcBlJfDlJUQ&oe=69DB8A38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvgCQWeRHyoQ7kNvwGZMuEI&_nc_oc=AdpAozvfuo40i0FcwSzLJcQmUH8ISxE09D2fQKlI1Ki9xDfEA7PBXD4XJwZin6KclD8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SrTCOf1k97e8uJl01LFis48iNHg1mEIqUYJ6AH-FUvw&oe=69DBAFA9"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
xh69PufiDIz8PDwned3Lzzs02pxhhPVZotU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9idpAogzH97_QKBESV9AODF3mR9lTMLv4WntvYL9O_tA&oe=6A3D2D8C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_50-WWuulKQQ7kNvwGwQfev&_nc_oc=AdqEoQxVE1oI8N4i3bE_7afWFwxgtmvHRwzi0DriIsPb_rJ8YID370LfprpYynRZ1-0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Es4s3i7nld_jHKOIEYTJkiPoDxF313Vy1ic2K6Hv7bw&oe=6A3D32E2"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42o1lkq8lpsQ7kNvwGwMYIR&_nc_oc=AdoXj7BUVsM6ZHoYdE_9fTACtsDss4zqRY8umZIIonrJQpd3mf2yIMDH6QCGsSx5NAw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8ZwruOPHiu8y-Bf5yl1Bonrk7ZGcRP2z61N0AH54ucA&oe=6A3D5D69"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ub0Ug5JBqUQ7kNvwGRiN4W&_nc_oc=Adps8ljiSHg8a76fWY63LpFbNy9yTPuaMDZUCDF3AkwJt0DGd-zb4BYnoKagYMpkP38&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qSJ_M1cbtErRS3BKlDch7CyQgnrhDVDIaGAnrpQT-wA&oe=6A3D5178"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWJ868o1yv0Q7kNvwEL5H4L&_nc_oc=AdqseZP7z5xBg0ra_hSs-R5ifXAFvXKLKtKFre83_yF8euriq0kEDYxxd-PK9DTnMpc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Br9E8OVAzGY9JBjgpUvganTdorECuO-0egpVNVeWLRA&oe=6A3D3EA9"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
_u8nAZokR0jYSAfan3yfAmk_JoBGLsWfh3g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iBax4Z0sybrRZzGyBl9z1IeP-Yc5_cJb0HHytgB1hhA&oe=6A08718C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99Yq8Ol8plgQ7kNvwFWxqrv&_nc_oc=AdpmvJVj9ZLCoHSueMqPbAgdUC4JkMMQYUYODerEmCmlNKeKmn7X75bqXq0Gikq_e4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cw3tr-tpLT-9sHRdvXuRNlt9rlk4d0FfOyp47DsyPGQ&oe=6A0876E2"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fA6gIC8ZiFgQ7kNvwGm4g0F&_nc_oc=Adr0XLvhX8riD22Cbigd9Cj7z42Knm3goDt73ehZnRLQ8RLhGP8vAkQy-nazn-iefVk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kkdoTxyYqrxBXmb2hSA9vuMIwMeBbqJZpnMDb5H0VkA&oe=6A086929"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zygWyJagcOQQ7kNvwFAL5ES&_nc_oc=AdoChh-DjBlWRO0dyq2T_7W-ySE535o0H_3te1tRoGU2qqpMgqUYDfbn4cEoHTYqOP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ei4mR9UUGFYVazmG3qZleOLjPYwgC05rPm4xZ0G9Axw&oe=6A089578"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyFmuenJXSIQ7kNvwEn6Q4n&_nc_oc=AdrHhUCaPpWYnPdXWEhJH-n7Rr_eylxjjA1HpUFpDbL8dWglDnL1fmugG3hVMxk6pB8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rhjYWXdmrRQooGuYk0Ro1Ch0CrXlxWvbuqiHx2fDfQQ&oe=6A0882A9"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
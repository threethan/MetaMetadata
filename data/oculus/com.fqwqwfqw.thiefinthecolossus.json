q-guSwa8j1AhnmC2259LNpzgsbE36nUbKRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXA65uWv0d66IXq9EVJC764RTliFwU9SvXNPD47YSihQ&oe=6A60C60C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MAUWk41iAoQ7kNvwFfXMBk&_nc_oc=AdocIPiAbqlUbiVb1k9gZDgKIWjXkW6h15gsgLFQ6clSrzTbQU0YVjbAeT_dnQbGPlA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA98I8NKdDv_kPihx1O9LXhD-5kQkbm_Uv-7gm_kCQyqg&oe=6A60CB62"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHIkhS7S73gQ7kNvwF3nqnq&_nc_oc=Ado3BJu_WLEqG7IvIuxpDpcqRwUcf-l5ZZ_GlBmHRSGrhhs1VBEnCGc4TlBGba1OFak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFiiyJi_vdWuDN0LwaETlTVeYT7bxbPjFCIubAnNbyLQ&oe=6A60BDA9"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArTXKx7BVl4Q7kNvwFkkqmj&_nc_oc=AdphPVmKUXMQArUOiLif7h3WXKhHI8SdgHwtw-OiOd-dQKzBWHFcRtS_WII834HWcJo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0xc4TZL2W9K5MrwFgi_Gf5aK_QFLwsGipht6ovx-0eQ&oe=6A60B1B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdCDPjeVaNEQ7kNvwEEEtMl&_nc_oc=Adq6rrPMQOHYyPAztdqVJui9iGMsjxKJlbZxbU6QutVxuGBF8WrPdeI5ZRPKG-V8csQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUdsu0l28_Ntjkky1QFLquoHPVbgnqu8sI_DoOlPhwbA&oe=6A60D729"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
BGxmIXGJ11TT-5EUfX6Vw-pctTRCrMdBRtM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxReFF0F6CHhV4-nR-uTzGFNA47vBhxuhv3JpWeK57ew&oe=6AB3D48C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHh5MYf4qr4Q7kNvwEJlRCA&_nc_oc=AdrR5We2gmUpRXqXxTLarxiYQZFjhB_t80qYHOz-f_IFazbrk3ihsyUMUGo9n4wM0MA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4OdXEn2rDP8_sNFLNBOxqS0fegE-3eD4RQTRxFElxZA&oe=6AB3D9E2"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypFsoS4EZCYQ7kNvwFxMHmt&_nc_oc=AdpuuppoN9BBy-wPkF80xJt0fLvSZqFPDaqCNaNqX76zw957CW2UyGGiT31e2gdNtck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcujMabnCVLExFrkVqAfHArVSgy6wp-AX7cZpeWJ4o4g&oe=6AB3CC29"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92HWhoEDOuoQ7kNvwFIIqe7&_nc_oc=AdrhAvtB-YYVzWiZ_YRFvfVYtpiu_ZwOAslcPgkTOQkyWX36MhEUPiU3PprL-FdMzVs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAhrU5ESBa8gPklrhG39AhgQh1AHjlhFXbGtjbuD-YSA&oe=6AB3F878"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWX6gmlZRzQQ7kNvwHTKMR5&_nc_oc=Adr-Xhk4EY9y9cxqVucRYtzfS_XGZ--iYiKpUHdZ3BWrUEMmxDYW-HSNdJxY9gkf_aU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeVgmgE0ktS6DWybBfCNU4FxSMC0_DXVysOwlHnJgAkg&oe=6AB3E5A9"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
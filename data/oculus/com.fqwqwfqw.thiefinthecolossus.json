PZM0fuxOA93P6l3j6LiSsjDnFxS56RI-9ZKZuGfbmqekg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SZqJYfCAhaQZj5s6NfkOXygmILjc1BfCOPWP285oTJg&oe=6A11AC0C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaPqoWhb_AEQ7kNvwHLWOzG&_nc_oc=Adpfn-H9e97V4-bV6LSzsym6ZVAWJ6PagAPtTf7pTz_XyHV1_D5Bbdtn9QqlBUI5T5A&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yevQQfrHfuRdhkx7er6ny3labNft4MdAPNu9qpp9FAw&oe=6A11B162"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iai5pS851jgQ7kNvwEXvBZj&_nc_oc=Adpa5qEiDH3_EnMqprdyAkLLeFc18YKHm6Xt6HxG5FRUPdeXzjiW_yM--fV_UTlZwVI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pLlE7OPJzLWzc_FGi3kVy6lozANUrllnioCOMeL7zTA&oe=6A11A3A9"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Nrh7pPXvqEQ7kNvwGbuSq8&_nc_oc=AdpT9pVBlb1M-E-8M_meBiZCLwrn7PJcWObZ0CLLLqz9qNaC1xfBS4QDZC5GZYXHT84&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hpsm5ogSg-PWkCI0LYk6BSO6n8BQ5KkmLyDBgCj8r7A&oe=6A1197B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKvHIwpOSz4Q7kNvwEqH9fS&_nc_oc=Adre7fD3yb9jWQDQ2HyHb0fugonYPjo6mkIPiXIZGuRPqMTBZJZJr9QvvnEbSkWQgHQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5imFOqGpRQhk317AkCROv9ACKhng3Z-zwAt9-SW6WP1g&oe=6A11BD29"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
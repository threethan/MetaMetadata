-1hqSvqlAKTIr1_WE5-uj6s4czfDe6KHatA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MpWfpNZth0yE-TbZ-jkmq5KxPNERbwe7p6HXwh3x0vQ&oe=69E8CD8C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uvp4-cfW6QQ7kNvwFrf0bR&_nc_oc=AdqSR2qvGpv2ofqzV5NVZMlw2wGe8Ye7lWNhTH8Tm-oJrQ9W4IzA1EeIje4yvdFgbYI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fi0EE7lIKCMbOsP-boYE7exqhIMnCRkw1014HThGJmQ&oe=69E8D2E2"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3vHisTPn6EQ7kNvwFuEQor&_nc_oc=Adp8cr879paHfFUbF_RsA15rk0cZYxBuWKyYc__MM6-KM8edzZO56oGhnSwQS26pRhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34YJyC77XOVuaTyTxgp1XtHg_P4TEH2_Cnea2o_P8R7A&oe=69E8C529"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnmBO94HPK0Q7kNvwG4soqM&_nc_oc=AdpVLHFrlfip_rewBp8-VkYgnLyjUa-qIs9QdF55xNwooPq8yHlbAflcxZe9paHIgek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35WuhodCFQkBPcwgkEDaW05ts7ZhG4XI8ZLFK4lnWxsg&oe=69E8B938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-2RFksqfbMQ7kNvwEB9TGs&_nc_oc=AdoKAj7VEVhBOAeBhVb-wETdaRTuSMpthrJmxS1wD59dSJfyK8pUgPtkvs9V6tD6uBw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3B7XZ8S6_lcqBtwKKb18PbF9wclqG-tfCf6LsIZlsgzw&oe=69E8DEA9"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
imdjoB5tI0Lxgg0EnchKu3rcPnT7YTJxLLs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GVh7DafqFsyKrmoU8vB2YG2ucUdNL8yz-CwfE53WGog&oe=6A26C40C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sp8vphtfDMAQ7kNvwGcQJ7A&_nc_oc=Adr6xqbxL08PEk_RSrEUd2Fr5LhnKX0VmEcHhat6E3kGtlERru0HO1meRtk1umPwHFU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ie4hWVzn17CMSb-YfwvUBZOUjCjksm2T8LC0ebmvgnQ&oe=6A26C962"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-upH623fG1wQ7kNvwExc4MW&_nc_oc=AdpQxUIDCgsq4fu2r7Sdx2w6K1l0efbTS_Y01k-3UwPObMXp1fHQmR1gJmc9N5AXeIk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h2KFWHnm4KM4khp1wR8oBQNbyx27QhjA0KNXsghkkFQ&oe=6A26BBA9"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppYAIGgSZnQQ7kNvwEu7GOM&_nc_oc=AdpfMrU04onTjYpnDkpYLN8tgWF-xC8B70yGm2G64c23WWIpi2__TkdgenlQzWYdRhQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-Zoda_VbpGFRYNWr1_NSxxHa1Byns_Snht0_5GmrDkA&oe=6A26E7F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNKKV7qxBmgQ7kNvwErr8sa&_nc_oc=Adps2eF6xvYg7sy3Rb126jYwJu15f3NGPBDtOtzo6StB-TTF7NjS3718PxkbuhiuOP8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6lHB9ng-t_7oeXIU6k9jCOfVxK8oqkPy9_zN98oYgDA&oe=6A26D529"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
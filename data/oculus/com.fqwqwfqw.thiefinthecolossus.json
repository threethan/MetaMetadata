Eb8084CgZ0s_Ll6F4SVPyjDhHyE8uB5vvzmJ0DQ-_PeN4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQydjs7yQeq24GHTFfO2ytO8kn-kf6x0Sy_AK3PnQ_0Q&oe=6AA9488C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6zPmcI9rU0Q7kNvwEdQTmE&_nc_oc=AdqEkkFpc0WqFUSJWV1VZ3jVNHXPRHAOSE3OUUlxZFSReWuQLTwgc3KVULsi5vZbF7w&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyf0x_COprtKguht5GzsmDU4DEQdPY_ZxK6IxjDteCQg&oe=6AA94DE2"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnjrfOFOX3UQ7kNvwE87gIy&_nc_oc=AdpnbVi6gueCnPaaH4bn09vENs5iCWiWrzA3b5urS1CGnGI3cBK8I12az2Q1C84B38c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfd9Qhs3BNowNU_s02Mx-JaNJPU4eMxstiZtXzLm_QkA&oe=6AA94029"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXYWgXhKUmQQ7kNvwHTjYio&_nc_oc=AdqvWSTSVPHX2aOAvhXXOw0jII-7rUBk6UE5AIu0PXj5L1xYRhuzQ9iT1h9x81sDiHc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcyc2kZN-WKddXyS_hzayVEV0rqn6YYA9IU2p1Lhu18A&oe=6AA93438"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKcOsXXVH8UQ7kNvwEIRRI1&_nc_oc=Adrg9Xm88v5rE7x7n7blsx-heau98UwUrjqBzlEVlUhT32P3uPUq7qrn_AUTecniwNk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3X7skzYsa4XC7fN3zYy8FEKl46LzH_JqkvcmUiRRjcA&oe=6AA959A9"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
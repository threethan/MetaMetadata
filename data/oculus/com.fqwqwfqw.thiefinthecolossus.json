kSZHHuNwYksiKZGF7EyF3bLE8Sj3NTJU6TaZnKP5QIcuY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jrBuHBk1BPr94j5Afzhn7WiefdS4UDFisqIZUNWLdrg&oe=6A36960C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mW8HQ6yiQC4Q7kNvwG_-Izq&_nc_oc=AdqBOxqs-bBhjlK02NXKJOC5AT74v37o8PGa9d0GkFa9MJu8AUpmiZP1w5XBE8yFRaE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KjL9uDtxk1DSV4guq_o0aMtWc9GQ-_y1DH-9agjKt7Q&oe=6A369B62"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJFgAYcbRXgQ7kNvwEx36sF&_nc_oc=Adrr6dBPZ6QBz0Gnxe60ZQnQE9u-_EjMWJB15bkKVswL8XsbV4yhiQLIzP_oqcl6N_w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FSm68_JRE3FUrdXeSk7e3fuq5uS4PQtN8Z19MgLRAWg&oe=6A36C5E9"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrkjsMqIIX4Q7kNvwGOUMih&_nc_oc=AdrJfEgUug2-jzWunPledrqV5Qcklt51kdVdxe886gEQZShnPexl9aZ_I4j78dKfq0o&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VAB349fv3LTRgcaM7UAqyIFlWek2kYUtsr4VYaHJeOQ&oe=6A36B9F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8xA6VlonQUQ7kNvwE5RB92&_nc_oc=Adpy0nLoj0ZH9X2uCH6loIf9Kj4XifmJ5YL6cwUnZYFe7acRqkKYzI-gbku21KzCRCw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1fJB4IaX0SXKq_R-dXzBMzDzhTMXz9cds50pQFDG54Q&oe=6A36A729"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
fQS2bI7bgQIREe2aNpp0kseiip0jMy0WYjk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQMZa61yUlJkMlvtk7Hr0ZxMy7sJTPxZhtPetxJOxtcQ&oe=6A94308C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-r2b8Ere_4UQ7kNvwEmeMif&_nc_oc=AdrA7BbTt_zr-GFLHeSp3ukTRMq1-RYDT5R-7pjp7DnxaVUdIh0abUlWz0E033jRKeA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPh0XNLe3dWLLLDMLdGPcPsKwf8VS4_NvmHDYeHRf-tw&oe=6A93FDA2"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEJxcsDwRsUQ7kNvwGAd6vd&_nc_oc=Adoz1TIK02E4L5C_erTOw_TWSS1jdbofaCDIEOL5xEfSESbvt4XUZGRwqfZCmbl4X58&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB4Ksii3M37I9bGtAlWOHnJ-cvvrTtnX7zu_UwOehiBQ&oe=6A942829"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofD3O96f1ZwQ7kNvwEmTjsU&_nc_oc=AdoODsmHYCWIQuLG_pxyVkpKmqsL17JHCrsEKohbfom8Dk-cVhpdywqRrKbUxNUphTA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVkMg6ceXt69SH-S6Z8NSEA0yaK8sVFFL8T3II-RkPFQ&oe=6A941C38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkY5FachW3MQ7kNvwG4pGl3&_nc_oc=Adoyg7NE5bBnjhlHB2ZtVLjrhOmQBKejfsmCFmvQCoabj3LDETrOYIjxjslm2LEpLe0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEGSnesJBs-ddHZsKcEX0Rhx0Sze9qZDTGAijovMecTQ&oe=6A940969"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
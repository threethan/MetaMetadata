-W2Bkw5H70DXT2BLT-k7t9FWoIL7YDxV2gA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JDD1TJPHH3fwRVMs9rLCeHzKKFwUPpt9WeF2SMMNLmA&oe=6A16F20C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMx1IJ4IOPEQ7kNvwGfETmd&_nc_oc=AdqrjcKDYe68GEBOSVTLecsNoK-jMj_k-rs81KlQ2VLOP_41609BhJXdwTC9OAcYR8w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af555xOflDG25ynWADjzNhe74BvUAtbkCm8vEn-1dE-v7g&oe=6A16F762"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ao_xeETs70wQ7kNvwEerMTN&_nc_oc=AdoqdrQg8bTl7yFdDCS62xdqNUnv3zmPo5Yt3Z4_p8UyREw-2WpFQer7VHvUYohpjzc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gvqWN1joslcqeNWeOiVhI9E0vs7Z9rRpelclxbgmdtw&oe=6A16E9A9"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrHo_qczRycQ7kNvwEPkO77&_nc_oc=AdovdEOCByhR0DAwIgFTUk05Dx9H17pHsJZXk2xVltah33VeGv1jK8gOCrTI7gyYMdA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ds-7WK48GyVEw2FL_een2KUf-iPvwBFkOKJZbaPGhhg&oe=6A16DDB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcBEI9snb78Q7kNvwHTJxO8&_nc_oc=AdrcCw4n7Wdd6uyIvcox7C7yQzgdzP3ZVpOZUiMcRoYv3widY-SmgUR8RYXYgrLoir8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QWqdH1JW_n3zzHnxQmTFKurZmLCxGb687Qudsuia8Gw&oe=6A170329"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
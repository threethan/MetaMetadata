d7eXCLVD-sbYLzKJ_KYZPrZxjnVxwZ4pzQjlKGUrVUiXY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_5Q1Sn3Nmyi0CbN3qX6lcWCI3W1z87NVpN6iTkWXMcw&oe=6A7DC70C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leGELRqKWM0Q7kNvwH34llf&_nc_oc=Adou3lXUHvJBjHmj1BuioarQr-SJsk2tMf2XuG29tgRJ0mhnYTKho--9N6Zk8IdnPRY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkNSF72i7iYPVUN_vCb8NjJPbF_sk89RvnleFDRa5vzw&oe=6A7DCC62"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWda1QQn4HsQ7kNvwGr702Y&_nc_oc=AdojCFJOcMz8G4oJQHKAK_jRHz4ZxnFqkOjPXvXkXXoQHKCk07KjB4gbat_F5Iz51t0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgy-MFKP2-XadCku36VsZLSB7PK5Qxt6hDS_NAdb3gmw&oe=6A7DBEA9"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93NvmArFcVMQ7kNvwEFa8oz&_nc_oc=AdomfM4iyhVX8vZfY1CHttJz3QVAu9pz-UbFOukBEDlBBBRPO4vf-dyCXcu0sYOd-NU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYdGzHilJcb4JwTHeQnbVfi_1MkDRcoTvAYo_RqjRI7g&oe=6A7DB2B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HNxROZblrQQ7kNvwECUZwj&_nc_oc=AdpxhSVABKS4QmnoU4khZnI4zzVK4R4TXMyHQOL12LgQXXq1t3suzCPjSBlj5yTHlQw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4lZKguJFtCuk_JjkXQ8AWsJ7yg0jFP43-TKfnERK_KA&oe=6A7D9FE9"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
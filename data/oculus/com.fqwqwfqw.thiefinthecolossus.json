-4k93kj67TifwP_JrJUBwXlxEV2XbM-EJQY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sVQUMpgUTe9OWjHewjbaUkDAUcGdA-6LLxP9pFNe2jQ&oe=69D2640C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVwgwrErufsQ7kNvwFNpoaq&_nc_oc=AdriBEz8DeFnIgxCc2gU4128CQ09ZKJx5yhPGqYHsJWPeeLVp6mEpk1vACNyqEuObdw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32aiVcfsXqFKI9tMOaSbl-WbpMcZAO0y9Xt1rYJ7aldg&oe=69D26962"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqRpjImjHesQ7kNvwEVMalD&_nc_oc=AdrNrqrGDnI2wEeiJb_NTs8qj02XL8bU9Nq2nCZSXoTAxvAGUUKFCPx2M94MU4SaW0I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zNvvBq82JRSlYbFUtKqXogr9Ib8iUC-cUt0b3sVeliA&oe=69D25BA9"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFuzNuf53jIQ7kNvwGkpjZo&_nc_oc=AdradMkOS7Zq3NWgs7xKqFOGpQSl8CWkpLSqSWkd_0eI7MZuzuVKXsKoSlP0I9hrnzs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bkhUPCQwf_lDs-bXVgKHxoRSkE9wJoZtFJD8hfo2PDQ&oe=69D24FB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f28ffIMRH_4Q7kNvwFd7q-b&_nc_oc=AdrWtQlpFlcLHbgxGr3OeJ1GStq1RhxXDlmStNEm4U2VlM3NfjrFxsXOtf0V882XzWs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CaPjuRwJKlBRAdUswu9qQgGSI-wHc7hB2pY2NwgV1Ig&oe=69D27529"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
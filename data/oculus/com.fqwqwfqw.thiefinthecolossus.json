jZg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfykDIXTnrHrcXHSMEW-4OXRCIJA0FP3QQqrccKgpokojw&oe=69BBFA8C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SRSKLztLh4Q7kNvwHTa6Fj&_nc_oc=AdlwmyVnWwgi-TyE7ciIRvI1wYfOhoZnIO7LPpXR1JSsSo8WIuN9eroAy3WiRRVgHJs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzsZe3gQ3ArDdOhn4Ddcq82ePVW4scFcABq36Zd2IPadA&oe=69BBFFE2"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvTwvfV3FHMQ7kNvwEkvMRK&_nc_oc=AdnuoKZS-KWA5OIhRTyWbz9jY4cIXSMQjKMbT_jmcPSYCtbGZu9Toz951dXGuIMfWdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzOd-9XYvWfgxf3rDEjotsCAjYDH60koEYThFh1rMjEBA&oe=69BBF229"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krBL_6OCduYQ7kNvwFH5i2_&_nc_oc=Adn-4HTSW5w0QXIiX05b_MwcbOusrFRTMzJh2e9akfXHjoSmJWuXqduPtkk77fL2ipU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzRImaZIxRvIvpZ_pvps7D2FhzfF-dHYxHwbyP3pFzLtg&oe=69BBE638"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kddglxI_gEEQ7kNvwFykJ7c&_nc_oc=AdnbzgQr-Hb_c7kuy_KchzPfA8PdLo_ManqazlU94sldUjQnRb3ctRkGJQ-qGPN5d0M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFI07Z3xiKKh5zhtUkHbRvvSha3lHTMDe1KpMWh0rBFQ&oe=69BC0BA9"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
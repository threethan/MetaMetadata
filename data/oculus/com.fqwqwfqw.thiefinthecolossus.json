G61mg11NBoSmhOv-OiSh1bTTIXi00VpIIFk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QP3jIcMeQvxhpBLZR9p2IUX0SG97ZHszB2_oXlYgYWQ&oe=69FB428C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOEOw7o67WYQ7kNvwEF4B5G&_nc_oc=Adq1gYVXrMgTOziGMVgOOruFWW1MMrOVRf2MnavhtCyds6ut0irv6hq9-0PX1AGCloM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dtiQWzhnmCEBXAedCTeUFix7dNqGqLgkOO8TFlWslWg&oe=69FB47E2"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auw6SlW1O1kQ7kNvwFxrQeN&_nc_oc=AdqLKnfD6CJWmH6qrXg0_11OKKCBnERAd3TbALPLBrvFzkudX1MoLbDa5kdGxeC_WTk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5K4nc09JJ_tCbqmqRUfjYGEKvJz302d1MeAtraeuMYJw&oe=69FB3A29"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1TUhW4mxVwQ7kNvwEDf4gr&_nc_oc=AdoBIhmiW8W2ld40EvE4xKrnQ7Ai4zXf-ZhQ09s_wnrc86O1bzHhtDdxInMGKvVZ_k4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bbUILtf0IQvOg0IkK8DvfVo-tjvIVw-MG2cv3IWEHAQ&oe=69FB2E38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwE9ulE0MkMQ7kNvwFA3uyB&_nc_oc=AdqWZ_lE_lDy800eruWkSSLBQjMvpQE14sH6YEZC2B8GXmG0VlVhxfUoOhHYiDZZQZY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p6Wc-AgWntNuOhGB4LhY03vK9pbffXHqw8gA35Uw8ug&oe=69FB53A9"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
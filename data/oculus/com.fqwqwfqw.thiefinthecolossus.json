9c3wt5CGofq3jSzG-KpR_9-qxe3bAZjzSEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hFw1MEdgcQK3BWha0glYaE8Q_4lbrk_WKONRgVIZbUg&oe=6A032B8C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYCC0lydENAQ7kNvwH3etKc&_nc_oc=AdqMmllv7qGKt6p4t80VzJDJ522T47ck7cbo1SqBCMPyAx8lWSKx0w33KRdy3nXexks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UxyRG-WqFPzT5ZxP86gBb4_ozhbhsL1Hxy24dlLgGBg&oe=6A0330E2"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5X9nV1mft1AQ7kNvwHzikpZ&_nc_oc=Adr0u_Kk6oUQyTXF99rysIgLxdPXVw7QXQJEBPW3stapFuEiPzlzlalFsed7BlMcbDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54NBxsv23ct_zTE6ezYqVSjJ7m9uw3jW6PmhpQAerQag&oe=6A032329"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZ3ODz3RHr0Q7kNvwHhKALo&_nc_oc=Ado9crb5GPsPk3bX2iXuAuN0tT5ZmCfmJaxVF0eNsVqu9LNffZFBpK4zZZIaa3vu804&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Cu1BDD4LE8_umhQNnLIaaqDMGnv4h4dyauURVt_YMSQ&oe=6A031738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yx_HbdzYDAcQ7kNvwHz84NE&_nc_oc=Adpe7_LMPaKb2TN3VKFdAd2_QS0OLQrRxSZxx-Ub0sQdyu3KosdXUElml1WEZASODZA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52EoS7jOCnN9zVaW9_YzxB7X-DqLbLemBVMya-0aQl6Q&oe=6A033CA9"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
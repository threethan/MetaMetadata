9TjPaMCQW6lHe-TLYse-fSFNsLTuajUcKz4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMKzaDK_RbyY_kIEadKIRHI7JGY6DUstzNDHjiPR909A&oe=6A58DD0C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_tt2KD_HEsQ7kNvwGmPRza&_nc_oc=Adpp0ZMevzz6iYLFzCgQoMH2KqaJtDR3Xd-Sb_oON9_ZICQyPpNf8HvLDEt58x6Lzq0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdtaWFuhu5h1zz2rMrfioMwx9_rh0DLZKfBXpQoTDNQQ&oe=6A58E262"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMMrDTOkvm0Q7kNvwFkCQex&_nc_oc=AdoBI2sSImtK4ARPq-mkh1fPwQB3nouwfAB0vivP4siluS8ze343R8NSuL1VwklF00s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwjmNf0GBcyZhClD2x7ffU8d5hJfGi0vi_7AHKSPtIwA&oe=6A58D4A9"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fk4_2qdujUQ7kNvwEDk-vw&_nc_oc=AdpiCZ_hpyP454cNGmslYbRGvsZtPJ29bLJS8p0ANccOvssjkfufr-4Ned6EojmXtoA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9rN6LbtBU8JDrE-Fr_VBGGr_36pb5W99n4BYfyZynCA&oe=6A58C8B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_btncEWcflkQ7kNvwF40-ev&_nc_oc=AdrghHe0fBlLwkz6ccCy_1PlQSyma7o2pnsuL7uLytADemUomIRhzXUj1octk7wxWpk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzb-m_fA_qsOPrd2i3dJ5o95BicjJDxP1qh0-flb1LeQ&oe=6A58EE29"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
_gXeGF1yqLFWBAWnO2UamRYTCHFUD9l64ac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o-iJfw98LQHuDgeTngUWtV6Chzw61Fg_zaa3kUSyy9A&oe=6A2D5B8C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlLjmPXNnboQ7kNvwHbxflh&_nc_oc=Ado28yvQ_9sh3CSu4etBWrhrm6K6ORtfr6P85Lxx5fN5DC_wOH60-rE5EfVJLGD1wfQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__DDecFk0NM_lE-Fmd0o61ADSYtyFCplRH3uKCDkCtwQ&oe=6A2D60E2"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-W3mXlkcd4kQ7kNvwFaBWlW&_nc_oc=AdoLTjdfWKnXD4baNoB7qWpqcgnaucHti1wDq_WOHyhbEmMIxNupOVhFqIWKHXOHDf0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b7JRMjlWTIiEDZdoo_xB5NV_FQzuHeLxnTM-SDU3cng&oe=6A2D5329"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WH8KwDFjE90Q7kNvwHOEcpN&_nc_oc=Adri9mGCao0WYgaGiuPd8t6eH0B8mDBC-P9dMKh5eMpv-04ZulmVGyAz_0LZA-53p-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9M0Lf04IUkilrsxaM8dz7D3dklu757_e6zuCWSyV1ewg&oe=6A2D4738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZ6uu5t_kCsQ7kNvwHCr5K1&_nc_oc=AdrAu_FJBXTMtxObXJOcdDeDYdERREx-iFhx7sSIhNJLCBpABB4ePp_xRzvDZElRK74&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-s6xZeST_WyIbTklGZzLv8JDRdT8M7Ta3Rfs1xiS67dQ&oe=6A2D6CA9"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
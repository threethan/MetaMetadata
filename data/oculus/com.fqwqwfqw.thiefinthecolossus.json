IiZa5h3xb2nM3b6vk-DisDfCzUzXVPv2ISY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6A1LUsLPqpea_3jUvhbCC-S6MWreATfSqCC7afAX5NA&oe=6ADF560C"}, {"file_name": "ss1.png", "id": "1448633165841123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195906_1448633169174456_2867898511672009797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uB2SnI4i-K0Q7kNvwE-Ktr9&_nc_oc=AdrjlszGhLAkikOqa7Ro1nw66VWJ_dwX_s7SmkMnTVc_VUZ9I70NPc4x4ccvXidSeqc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZf8VLGimufMwBA4-84aGdnNL-lr6qsgNl2p7OkWFshQ&oe=6ADF5B62"}, {"file_name": "ss5.png", "id": "2253978911602216", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54809986_2253978914935549_4499949495113059499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hDn6mxMUoEQ7kNvwGFeASj&_nc_oc=AdqSqBAwBiRKTO2tePN74jU0gdDRhEO5EA3m98_zZMb8Y0qM-e2bbuKe-_zaTkWmSG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiVhmrr8EwezXuzoEuyIzyThHGXvPjRa0u_lsKWbO6JA&oe=6ADF4DA9"}, {"file_name": "ss2.png", "id": "846454223549290", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207235_846454226882623_4099923352520741554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuaaiW4Teg0Q7kNvwET5DY5&_nc_oc=AdrLgpmVYaBREdxJa_fbgBbXY7wkRZ7ozWT1MRDSQvmym_ZKfwvIMDBH8Gp3zfYzud4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3C2aUcH4pGahB1LDRr7nKMWKfOYHx1TKZE_I5y7YzWw&oe=6ADF79F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7957285167664031", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_7957285174330697_8761544827049069134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kc2qD2ksQ5wQ7kNvwHRFvd0&_nc_oc=Adpx13-qyi7PJfriG5zeg6IesXFPTjWCPHBkpIQOlz5Vll7xLvjeyP5nbx-pHR2wH2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmKhIgN98HlmRr63ZoGm2NZgntiGO4hfGJr9zDpZRxyg&oe=6ADF6729"}, "display_name": "Thief in the Colossus", "keywords": [], "long_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment.\n\nGame Features:\n\n    Immersive VR Experience:\n        Fully immerse yourself in a beautifully crafted, gigantic space with state-of-the-art VR graphics. Feel the tension as you navigate through vast rooms filled with high-tech gadgets and traps.\n\n    Stealth and Strategy:\n        Use your cunning and skills to outsmart the colossal room owner. Plan your heist meticulously, use shadows to your advantage, and deploy advanced tools to avoid detection.", "short_description": "Description:\nStep into the shoes of a master thief in the thrilling VR game \"Thief in the Colossus.\" Your mission is to \"borrow\" precious items from an enormous, high-tech space, while avoiding detection by the colossal room owner. This immersive game offers an unparalleled blend of stealth, strategy, and futuristic adventure, set in a sprawling, technologically advanced environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thief-in-the-colossus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jame Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/thief-in-the-colossus", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
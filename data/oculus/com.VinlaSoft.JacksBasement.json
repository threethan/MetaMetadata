829759_3372792151132203173_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSToIi14JyAQ7kNvwEYY6Oo&_nc_oc=Adq8xkW0xPVq-RjaWh_2uM5MH5_1JLUh_Qhkw-V5fNrZvawGH-oMvIW-Yomer-Gp1Xg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoVmAa_1sqcRWRJkc4-uCruC9cQt6_LngyBEN7BHWFXA&oe=6AFDD497"}, "display_name": "That Time in Jack's Basement", "keywords": [], "long_description": "\"Remember that time I got trapped in Jacks Basement and 1000 giant spiders tried to eat me!\"\n\"Err. no. I remember when you went into the basement and saw a spider and freaked out\"\n\nIn this short experience you take on the role of a youth and relive the time they became trapped in their friends basement and has to fight off terrifying giant spiders. At least that's how they remember it...\n\n(Logo contains Color Spray by \u2726 Shmidt Sergey \u2726 from the Noun Project)", "short_description": "Experience the terrifying experience of a young teen when they got trapped in their friends basement. With just a lighter and a spray can survive until help arrives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vinlasoft.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Vinlasoft", "support_website_url": "https://vinlewt.itch.io/jacks-basement", "website_url": "https://www.vinlasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_mo
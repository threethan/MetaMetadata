05.png", "id": "1157582191358481", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75485580_1157582194691814_4376023616065303629_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzMdvveA4j0Q7kNvwGWWNB0&_nc_oc=AdlX-uwGlkNMSpK7tkgTAmEGBfRzpOAzhnhWYzi6juowMrzl2CaBgrfAOVQE5d8d_kg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5tEV6P859MFdRq1NLT-NWdLXHzl596kKCEsHQjCWtmw&oe=69AAC83C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ttjb_landscape.png", "id": "3001232913496426", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75240097_3001232916829759_3372792151132203173_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGRiLahR61wQ7kNvwGIS1T_&_nc_oc=Adn2b_j1St1lP9cHNGd2lZtRMJ9GttfjPzcQmRer4t1OMN2QfFr7JvsXDdH5lRrM8fY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afz8iIQKQPH4ZLxS2dGcFnpyx_HZkZQd2vpBalvEx7FV3w&oe=69AACAD7"}, "display_name": "That Time in Jack's Basement", "keywords": [], "long_description": "\"Remember that time I got trapped in Jacks Basement and 1000 giant spiders tried to eat me!\"\n\"Err. no. I remember when you went into the basement and saw a spider and freaked out\"\n\nIn this short experience you take on the role of a youth and relive the time they became trapped in their friends basement and has to fight off terrifying giant spiders. At least that's how they remember it...\n\n(Logo contains Color Spray by \u2726 Shmidt Sergey \u2726 from the Noun Project)", "short_description": "Experience the terrifying experience of a young teen when they got trapped in their friends basement. With just a lighter and a spray can survive until help arrives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vinlasoft.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Vinlasoft", "support_website_url": "https://vinlewt.itch.io/jacks-basement", "website_url": "https://www.vinlasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATE
JAFWEg5GvIzw_vSRdHxAgxZL5bFSAQUmJSA&oe=6A11CA75"}, {"file_name": "Aetheria 2560x1440.png", "id": "1384346388956256", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974861_1384346392289589_210857074265909497_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPDUrpgYjz8Q7kNvwEQNOj6&_nc_oc=Adr3niK33m_QAv6e2Ind6pSR7Q2OYPg_tdRvEqINrlNECijpfv5ZbHsI7Rc7AKMsNPk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tUwWuZMc0AI1HssJcVR2cDwtSGaOCeYb4mPfZ93SoPQ&oe=6A11CEA3"}, {"file_name": "Novaris 2560x1440.png", "id": "1627140404526615", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38984476_1627140407859948_3767891823011137971_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWPfrL-vHlwQ7kNvwGU-d5W&_nc_oc=AdrNQRjGCH2nr-QN5HLI07i9wzr4DrWVTljW8np-GWwwlpYDFHpE52b_v6H5GEoMFG4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-NISjF2L4bwOlxw52U8_w2fqX_y_PyZ-UjHdApgDGfw&oe=6A11AA5E"}, {"file_name": "Eldoria 2560x1440.png", "id": "1050200259945411", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001705_1050200263278744_2536765123562298486_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sr_k-5_CDA8Q7kNvwGyCl0g&_nc_oc=Adp34YZDKMUMU8h0jYe2H2oBXHU47gXU8Hw-KIhWoGc1N5pzT1gFJNSJEhjhQqooWJw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NScf2M_y8wCAhZsUy9imNvzanhysM0mkzruQ9ShzPmA&oe=6A119DCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Level - Tilted 2560x1440.png", "id": "1253462735677317", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974547_1253462742343983_8818318723270229370_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytz5ITx4to0Q7kNvwFdRwnd&_nc_oc=AdqnC-J6DqxeMEXNQ1tOFkP4gx9WtygREPfy4cU4JMN3GXW-5Twv3Gjq8VMD5t1G9w4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R5-s4cvT5FdzlipACrfuaQoGoiDeAKLaaw0UsdDgRZw&oe=6A11B560"}, "display_name": "Close Encounters Demo", "keywords": ["UFO", "Paddle", "Ball", "Space"], "long_description": "VRelity Review: \"25 Best games in VR for Meta Quest 3 and Quest 2 that you have to play.\"\n\nUse your controller thumb sticks to deflect one or more balls to targets for collection.\n\nEach planet presents a challenging array of targets that must be collected to the waiting UFO above.\n\nPower-ups become available to assist in the collection process:\n- Extra Ball = Additional ball added to total balls available\n- Multi-Ball = Additional ball launched at location of power up\n- Power Ball = Blows through targets.  Lasts for 30 seconds.\n- Extra Time = Adds 60 to level timer\n\nBall speed increases and paddle size decreases as you progress through each challenge.\n\nTimed Demo Version: Play specific levels for about 60 seconds to get a feel for this game.\n", "short_description": "Lightning-fast reflexes are required to collect samples from each world and upload them to the hovering UFO.\n\nVRelity Review: \"25 Best games in VR for Meta Quest 3 and Quest 2 that you have to play.\"\n\nTimed Demo Version of \"Close Encounters\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abbynormalproductions.net/privacy-policy-close-encounters", "developer_terms_of_service_url": "https://www.abbynormalproductions.net/terms-of-service", "publisher_name": "Abby Normal Productions, LLC", "support_website_url": null, "website_url": "https://www.abbynormalproductions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_S
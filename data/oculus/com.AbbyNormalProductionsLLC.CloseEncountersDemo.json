ZQ&oe=69BD3663"}, {"file_name": "Novaris 2560x1440.png", "id": "1627140404526615", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984476_1627140407859948_3767891823011137971_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sM6v94Uzx0sQ7kNvwHl6QXz&_nc_oc=AdlsG6YUfj3b1Eaw1aBDZFbF1LcFXa7ZncOPtrzIqk34rXzbzN-7AYbGuY4quN3pTps&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzucL3ifOSBMQNi03zeIE2nP1XS3L6zO1t6cxsU_NwXCA&oe=69BD4A5E"}, {"file_name": "Eldoria 2560x1440.png", "id": "1050200259945411", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001705_1050200263278744_2536765123562298486_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXeE0eQFgj0Q7kNvwHSOKVA&_nc_oc=Adl1RbJsD0_zRjGGj9-NXcIrBdoYQiXRT06xqQYtYI2SsGYsvJPl85N9GN_89HbaIIY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxG_ncGrLabfZFTFzLHMZisqF0y6nCpxvsR82l6cVqO_w&oe=69BD3DCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Level - Tilted 2560x1440.png", "id": "1253462735677317", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974547_1253462742343983_8818318723270229370_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRzjMoICMnQQ7kNvwH12QZ5&_nc_oc=AdklhI08WbzT3U3GIyNPZblT3KURzPxrb27BNNNq4yG6_B8VUYXYQUsuQk0SvGfEAFk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2ml43JdCHHr9TtEgYpI5_GhVAHd_xYUtZdn1A-QyevQ&oe=69BD5560"}, "display_name": "Close Encounters Demo", "keywords": ["Breakout", "UFO", "Paddle", "Ball", "Space"], "long_description": "Use your controller thumb sticks to deflect one or more balls to targets for collection.\n\nEach planet presents a challenging array of targets that must be collected to the waiting UFO above.\n\nPower-ups become available to assist in the collection process:\n- Extra Ball = Additional ball added to total balls available\n- Multi-Ball = Additional ball launched at location of power up\n- Power Ball = Blows through targets.  Lasts for 30 seconds.\n- Extra Time = Adds 60 to level timer\n\nBall speed increases and paddle size decreases as you progress through each challenge.\n\nTimed Demo Version: Play specific levels for about 60 seconds to get a feel for this game.\n", "short_description": "Timed Demo Version of Close Encounters.\n\nLightning-fast reflexes are required to collect samples from each world and upload them to the hovering UFO."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abbynormalproductions.net/privacy-policy-close-encounters", "developer_terms_of_service_url": "https://www.abbynormalproductions.net/terms-of-service", "publisher_name": "Abby Normal Productions, LLC", "support_website_url": null, "website_url": "https://www.abbynormalproductions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8167124973372116"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "521066623841606"}]}, "baseline_offer": {"id": "521066623841606"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1726077540, "status": "PUBLISHED", "id": "521066623841606"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8191067080977905", "version": "1.0.1"}, "id": "478537885164273", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typena
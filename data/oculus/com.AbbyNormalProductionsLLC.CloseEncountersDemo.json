NvwH7fewC&_nc_oc=AdpylCDaOz61hZGsnzKEdVUsJY_r6p-Vl-jM91mNR2uOWC3KMcaemtlUR6hasGuXCLw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3eiLgUGpiAoMhSK3_LY_kMYb7JRNgrH2doPJdZziIDQ&oe=6B0B1920"}, "display_name": "Close Encounters Demo", "keywords": ["Breakout", "UFO", "Paddle", "Ball", "Space"], "long_description": "Use your controller thumb sticks to deflect one or more balls to targets for collection.\n\nEach planet presents a challenging array of targets that must be collected to the waiting UFO above.\n\nPower-ups become available to assist in the collection process:\n- Extra Ball = Additional ball added to total balls available\n- Multi-Ball = Additional ball launched at location of power up\n- Power Ball = Blows through targets.  Lasts for 30 seconds.\n- Extra Time = Adds 60 to level timer\n\nBall speed increases and paddle size decreases as you progress through each challenge.\n\nTimed Demo Version: Play specific levels for about 60 seconds to get a feel for this game.\n", "short_description": "Timed Demo Version of Close Encounters.\n\nLightning-fast reflexes are required to collect samples from each world and upload them to the hovering UFO."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abbynormalproductions.net/privacy-policy-close-encounters", "developer_terms_of_service_url": "https://www.abbynormalproductions.net/terms-of-service", "publisher_name": "Abby Normal Productions, LLC", "support_website_url": null, "website_url": "https://www.abbynormalproductions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
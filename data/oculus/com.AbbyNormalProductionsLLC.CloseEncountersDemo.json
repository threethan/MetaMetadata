qIf9dscja4Y8TMwS4IL0WSwqODhlDRkUAEw&oe=6A22EDF5"}, {"file_name": "Aetheria 2560x1440.png", "id": "1384346388956256", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974861_1384346392289589_210857074265909497_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwX5uY0FtiwQ7kNvwFiMuuU&_nc_oc=AdoBqwqgkY_6RxISn6I6Ms1q5Z917qbvQ0tm9bOzqt9v-5tuytv4hGvzblyjsEyIw_M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MDcxWh9JYzkIxY4naIm9pzk52vMzWWX5VqMITM_QlHg&oe=6A22F223"}, {"file_name": "Novaris 2560x1440.png", "id": "1627140404526615", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38984476_1627140407859948_3767891823011137971_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLZQJ97WJL8Q7kNvwG2Aoaz&_nc_oc=Adol1U6tLUYBfeD7OEfQ5dUdKS4GBYsgcZ5c2mGIwt2BW4te1t-IhtIAkBY-aC0HD8E&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Z4OZdUTlArruOSSsMlnL-haDYLexwgDl9V8v7M8CjRQ&oe=6A22CDDE"}, {"file_name": "Eldoria 2560x1440.png", "id": "1050200259945411", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001705_1050200263278744_2536765123562298486_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgA0Et5bnLYQ7kNvwHaPzth&_nc_oc=Adq2O07a7XQhW7np2UzvPRJrVhCjYz26JXldgC2ErYJzQn-2RICsSJMsECMhB6Mz49w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oP3u2UoFuJppyfvEqiNnN6uCQd015PpOomTn0ga_jJg&oe=6A22F98B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Level - Tilted 2560x1440.png", "id": "1253462735677317", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974547_1253462742343983_8818318723270229370_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-Gp_G-kqBYQ7kNvwG02Nev&_nc_oc=AdqHyM6s1S-BiOczdamfPWdd2o2Z-BYJs91kOf4A26C5jdO1cIjyPqS12491OFFL9hA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82uEcjkySxqxSGj_S4WOwj8Cxikq_bcUqatRWZbgd4FQ&oe=6A22D8E0"}, "display_name": "Close Encounters Demo", "keywords": ["UFO", "Paddle", "Ball", "Space"], "long_description": "VRelity Review: \"25 Best games in VR for Meta Quest 3 and Quest 2 that you have to play.\"\n\nUse your controller thumb sticks to deflect one or more balls to targets for collection.\n\nEach planet presents a challenging array of targets that must be collected to the waiting UFO above.\n\nPower-ups become available to assist in the collection process:\n- Extra Ball = Additional ball added to total balls available\n- Multi-Ball = Additional ball launched at location of power up\n- Power Ball = Blows through targets.  Lasts for 30 seconds.\n- Extra Time = Adds 60 to level timer\n\nBall speed increases and paddle size decreases as you progress through each challenge.\n\nTimed Demo Version: Play specific levels for about 60 seconds to get a feel for this game.\n", "short_description": "Lightning-fast reflexes are required to collect samples from each world and upload them to the hovering UFO.\n\nVRelity Review: \"25 Best games in VR for Meta Quest 3 and Quest 2 that you have to play.\"\n\nTimed Demo Version of \"Close Encounters\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abbynormalproductions.net/privacy-policy-close-encounters", "developer_terms_of_service_url": "https://www.abbynormalproductions.net/terms-of-service", "publisher_name": "Abby Normal Productions, LLC", "support_website_url": null, "website_url": "https://www.abbynormalproductions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_S
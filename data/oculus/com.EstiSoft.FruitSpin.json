c_ss=7f20f&oh=00_AQKXP-u5oCCpvdErDytFGgvEdfWFCFChxWdMib8HXeEKiw&oe=6A9C22E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-12-17 040710.png", "id": "1777892972976978", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_1777892979643644_8101286287131172038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9o0v4-Pr_qgQ7kNvwEqmDVU&_nc_oc=Adp300CPu7obpnKDcxppDUJburpR3jl16QVFSrlzWyIZjHQ1lvqRlPX6tXEVIsi01HQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIXphO-igi2O7E-rbmQo0KdrmKpb50u_JGkX2hA0alEQ&oe=6A9C24FC"}, "display_name": "Fruit Spin", "keywords": ["Spin", "Fruit", "Cut", "Casual", "Comfort"], "long_description": "Dive into the exciting world of Fruit Spin, a VR arcade game crafted for adults who enjoy fast-paced, strategic challenges. In this immersive experience, your goal is to spin vibrant fruit wheels, align matching symbols, and rack up massive combos as the game becomes progressively more challenging. With its sleek design and dynamic VR controls, every spin feels intuitive and rewarding.\n\nWhat sets Fruit Spin apart is its blend of visual appeal and strategic depth. The game features stunning 3D environments, colorful animations, and satisfying sound effects that pull you into the action. Each spin is a test of your timing and decision-making skills, requiring you to adapt as the pace picks up. Will you go for high-risk, high-reward moves or play it safe to sustain your streak?\n\nDesigned specifically for Meta Quest, Fruit Spin leverages the power of VR to create a deeply engaging and responsive gaming experience. Whether you're chasing high scores, competing on leaderboards, or simply enjoying quick gaming sessions, this game is the perfect addition to your VR library.\n\nNo matter your playstyle, Fruit Spin offers endless replayability and fun for VR enthusiasts looking for a unique and exhilarating challenge.", "short_description": "Enter the vibrant world of Fruit Spin, a thrilling VR arcade game designed for adults seeking an immersive and fast-paced challenge. Spin the fruit wheels, align matching combinations, and rack up points as the difficulty intensifies. With stunning visuals and responsive VR controls, every spin feels exciting. Whether you're aiming for a high score or casual fun, Fruit Spin delivers endless entertainment. Perfect for quick gaming sessions or mastering strategies."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/fruit-spin", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1672577396871977"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9036404659801538"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1021818920847673"}, {"status": "PUBLISHED", "id": "990027600114509"}, {"status": "PUBLISHED", "id": "1525666138688083"}, {"status": "PUBLISHED", "id": "1094727076164352"}, {"status": "PUBLISHED", "id": "625575990648993"}, {"status": "PUBLISHED", "id": "2115229525608309"}, {"status": "PUBLISHED", "id": "669555215448694"}, {"status": "PUBLISHED", "id": "962376849287847"}, {"status": "PUBLISHED", "id": "10
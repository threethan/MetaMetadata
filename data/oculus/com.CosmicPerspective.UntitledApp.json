O8t2EDA8T0X_DxJkBsJFM-2UhgrxF8N3oQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAuXyS9YOE2W3U8vxnt_4hcl3jk2KsEf6GWPuBlIczuw&oe=6B085073"}, {"file_name": "Untitled-6.png", "id": "1268513557406085", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031556_1268513560739418_8128185752261582571_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1kEGynu3LMQ7kNvwGEJkbM&_nc_oc=AdpEuQI6wXUNw5rURp0x54U9EO9tHtZKGlblJ_BZqh4RGv8HkoC4rlk6a11Dvop_NFQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5Kd9Wp1iDE5omF20LqCAq_vSYfCduFycJxnXl6r0CWw&oe=6B086119"}, {"file_name": "screens-5.png", "id": "736259608137227", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982558_736259611470560_3566202125264914141_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOKIJ7kXX3AQ7kNvwFYBJhy&_nc_oc=AdrrIxDCJUHr0COc-sj3di39EezQhGKBVQOR7jtwgJT5LtgXLePT3Vy7gky7vt5imkU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPOG8W03y4Fc9iGxy9mKdenPPMFTnr5MZ-Gb9yxGAxAA&oe=6B08500D"}, {"file_name": "screens-4.png", "id": "3544551479115080", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974513_3544551482448413_901906659547366997_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5qLfqnQJpQQ7kNvwHIoe5I&_nc_oc=Adphw4Ym_kZsc87Ply6FqXVZ5-gYL9ORFvirujG0RIaNF0H2NmGp6OU7sbyGCnoc8tA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdimREE7NRjMdAMUyDveAVKLtYViIbTH4QAm6LcFh5Xw&oe=6B085E63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens-1.png", "id": "1246384082652658", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974733_1246384085985991_5209142970159529378_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G783sfBTJaYQ7kNvwGTT-Hi&_nc_oc=Adpq5m6BqqZFTxIVHeqPRhu_SIA12vkfsrpoYbkIo78y1LaxqOlIe_d8LOb8Tw_TY4w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnmeFgElE5yqy7fHUQ1aHDZvumWjtw-1klm2yE8_GmAw&oe=6B085FCA"}, "display_name": "Rocket Launch Films VR", "keywords": [], "long_description": "Experience real rocket launches up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of Cape Canaveral, Starbase, and more.  See Falcon 9, Starship, Atlas V, SLS, Terran 1, Delta IV, and others, up close during liftoff and testing where no humans can be. \n\nPerfect for high-quality headphones (and haptic rumble suits), feel the Earth-shaking jolt of rockets like never before with professionally recorded ambisonic audio. \n\nJoin our community on Discord and also go behind the scenes as we film new experiences and exciting spaceflight events. ", "short_description": "Experience a real rocket launch up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of SpaceX Falcon 9 and Starship, NASA Artemis, Atlas V, and more during actual liftoff events. Feel the rumble of rockets like never before with professionally recorded ambisonic audio. New experience films are added to the library regularly. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicperspective.com/privacy-policy2023/", "developer_terms_of_service_url": null, "publisher_name": "Cosmic Perspective", "support_website_url": "https://cosmicperspective.com/contact/", "website_url": "http://www.cosmicperspective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
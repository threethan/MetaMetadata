J4TiO8r56L1KABr-U70E_3v1PsWmqEDFl0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVxwdyxgqbPXfAHv4PF81txlugCcbW1g7RiyF2pfeDAg&oe=6B09A1F3"}, {"file_name": "Untitled-6.png", "id": "1268513557406085", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031556_1268513560739418_8128185752261582571_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1kEGynu3LMQ7kNvwHHZCyt&_nc_oc=Adru6J6zIwD37acyZn848PJG3sdpypjE6YAvA9yRw4jxS5zN9Qw4kZ9va3O6WmD2G6U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqX0NZlDRWoXsmXSYpuh1UJS1uJOm4mAN75t7RXDTInw&oe=6B09B299"}, {"file_name": "screens-5.png", "id": "736259608137227", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982558_736259611470560_3566202125264914141_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnWU_9L72h4Q7kNvwGj3ynB&_nc_oc=AdoeV_0Y0qul-xvQTaYgvLciIPGyGdtUWN-MQYA1nQao9i_gdW3Kwb2GorI4BCBIcRA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTST2UWnDKtPBoSpBYlmU3MWOjmxvnHBsXt8YX1rMFQtA&oe=6B09A18D"}, {"file_name": "screens-4.png", "id": "3544551479115080", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974513_3544551482448413_901906659547366997_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5qLfqnQJpQQ7kNvwE9FzVb&_nc_oc=AdpXRugOt0qwRKdfZYGE0S6bXGnbFNLbuzV2XEh4kEGEaTR5SRLOMI0GFQd36DvFmck&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYIlw0akZXBeTy6k5eVKezBMrYaWF6EngCNxYjtlzFSg&oe=6B09AFE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens-1.png", "id": "1246384082652658", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974733_1246384085985991_5209142970159529378_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXOjnM-5i9AQ7kNvwFXsE0v&_nc_oc=AdqJGLxRBuxwD7Lnb0TKexUe9Dq4-Qh-dsBcOQsH3dzWnY3k3iQiQKxEd_uulddIEpk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3Q9NoJZYJ4oQyPsTmiP_2lpuc2A4ZGdfFq0AeNo78dg&oe=6B09B14A"}, "display_name": "Rocket Launch Films VR", "keywords": [], "long_description": "Experience real rocket launches up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of Cape Canaveral, Starbase, and more.  See Falcon 9, Starship, Atlas V, SLS, Terran 1, Delta IV, and others, up close during liftoff and testing where no humans can be. \n\nPerfect for high-quality headphones (and haptic rumble suits), feel the Earth-shaking jolt of rockets like never before with professionally recorded ambisonic audio. \n\nJoin our community on Discord and also go behind the scenes as we film new experiences and exciting spaceflight events. ", "short_description": "Experience a real rocket launch up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of SpaceX Falcon 9 and Starship, NASA Artemis, Atlas V, and more during actual liftoff events. Feel the rumble of rockets like never before with professionally recorded ambisonic audio. New experience films are added to the library regularly. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicperspective.com/privacy-policy2023/", "developer_terms_of_service_url": null, "publisher_name": "Cosmic Perspective", "support_website_url": "https://cosmicperspective.com/contact/", "website_url": "http://www.cosmicperspective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
//scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031556_1268513560739418_8128185752261582571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Thf6K5FdWBwQ7kNvwFuXRl4&_nc_oc=AdqLJbcSJ6rD95zhb-hXE2BGXar7jBDLv-H4kc4BzXIdg4s1uCcAoExltBq0T6MFn5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR6NMm934y1KjruqGA-TPPVPiW4Mas16mYKSUFVnpZNg&oe=6AF73D99"}, {"file_name": "screens-5.png", "id": "736259608137227", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982558_736259611470560_3566202125264914141_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFZPYlw3h0EQ7kNvwEkn26Q&_nc_oc=AdosrcBC5X2F_QHRBrpUETEP1ygAPNFfHiwtDFhqPbhK_j84sdjYMETSKfh2z2Z4vgk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdEIBn8GLxTZLnDV4yuHZCO0q5FWTbh_OTR2H3fhkl4g&oe=6AF72C8D"}, {"file_name": "screens-4.png", "id": "3544551479115080", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_3544551482448413_901906659547366997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiNRR0Veje4Q7kNvwEiVJlB&_nc_oc=Adpl_PH34b-P0gt7EIGXBrihYC36ZztXbJW24eQSn3oToR_k5U-eGk-MXfTB7X2WaYs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl6bBNrNK7LfxADWc_ZiSu8kUuuulmbjf2O2KrFnYhyA&oe=6AF73AE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens-1.png", "id": "1246384082652658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_1246384085985991_5209142970159529378_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E41BNoXKpC0Q7kNvwFRDygN&_nc_oc=AdqUKtjAzfWk982G-FFva9nem5ghKn0kfTRG93q6PfIiBQSFIeM0HnqMI90fkrB2t8k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQL24quPztoZNmqEsyh01PJHvfRQ916byUuvL5DcQ0ltA&oe=6AF73C4A"}, "display_name": "Rocket Launch Films VR", "keywords": [], "long_description": "Experience real rocket launches up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of Cape Canaveral, Starbase, and more.  See Falcon 9, Starship, Atlas V, SLS, Terran 1, Delta IV, and others, up close during liftoff and testing where no humans can be. \n\nPerfect for high-quality headphones (and haptic rumble suits), feel the Earth-shaking jolt of rockets like never before with professionally recorded ambisonic audio. \n\nJoin our community on Discord and also go behind the scenes as we film new experiences and exciting spaceflight events. ", "short_description": "Experience a real rocket launch up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of SpaceX Falcon 9 and Starship, NASA Artemis, Atlas V, and more during actual liftoff events. Feel the rumble of rockets like never before with professionally recorded ambisonic audio. New experience films are added to the library regularly. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicperspective.com/privacy-policy2023/", "developer_terms_of_service_url": null, "publisher_name": "Cosmic Perspective", "support_website_url": "https://cosmicperspective.com/contact/", "website_url": "http://www.cosmicperspective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5688744381225735"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003225_1336329183830830_423506541559213616_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_n
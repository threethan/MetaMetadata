3e3kKnh39RrgaxovJ3AAigPbpJ9lULeMpU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4-8guGu4-6y_cj9r4BRjYTtRmetkmYxURDSphMa3Yfw&oe=6AFF15F3"}, {"file_name": "Untitled-6.png", "id": "1268513557406085", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031556_1268513560739418_8128185752261582571_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1FCA47LAz8Q7kNvwFWtY84&_nc_oc=Adq-1QUM09uS3ndRiVm9WzKuqUz_cQeDTyS7-vcQY5xQL2InQMGRdGWQ8SJ3g0r8fhI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQEy2fLqr6DNBtxWHgR_9Rgosvy6uQwEbd5qmibCswqA&oe=6AFF2699"}, {"file_name": "screens-5.png", "id": "736259608137227", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982558_736259611470560_3566202125264914141_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sr0aBLZkGncQ7kNvwEp1UQC&_nc_oc=AdqOjaV2aarNGEr7Dwf2DLl4PQEHBkvy5SiGgE3rQ6NaX2orQXhldDfHU6oXoTRF0MU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV0nt2ssdJmzkTBN7eKkWpkumUuDQ2eUEcVjk6o6P1BA&oe=6AFF158D"}, {"file_name": "screens-4.png", "id": "3544551479115080", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974513_3544551482448413_901906659547366997_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4vlrBgVeo4Q7kNvwGYp3eK&_nc_oc=AdqFT5aDH9ipBdkA37viCfUf5hUEyg_hbnXrrTAvwBLZgmssIm4dn4mHWsr5heoBGek&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbYPh3MzAdlTotZvPCeozW6BeqLQpp66oirXhLVQfS4A&oe=6AFF23E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens-1.png", "id": "1246384082652658", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974733_1246384085985991_5209142970159529378_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23i-TbiP8a0Q7kNvwFw_vOQ&_nc_oc=AdqAWoNrWYv1cjUWaEQcnc8PvyR6KcMIH2hvArBieJpE1ERD4fqkYvTyLNj95s25XjA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzCZRjFojwM_S1vzEAF-yZ1P_4q3h-0RcLTrJr1J7myQ&oe=6AFF254A"}, "display_name": "Rocket Launch Films VR", "keywords": [], "long_description": "Experience real rocket launches up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of Cape Canaveral, Starbase, and more.  See Falcon 9, Starship, Atlas V, SLS, Terran 1, Delta IV, and others, up close during liftoff and testing where no humans can be. \n\nPerfect for high-quality headphones (and haptic rumble suits), feel the Earth-shaking jolt of rockets like never before with professionally recorded ambisonic audio. \n\nJoin our community on Discord and also go behind the scenes as we film new experiences and exciting spaceflight events. ", "short_description": "Experience a real rocket launch up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of SpaceX Falcon 9 and Starship, NASA Artemis, Atlas V, and more during actual liftoff events. Feel the rumble of rockets like never before with professionally recorded ambisonic audio. New experience films are added to the library regularly. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicperspective.com/privacy-policy2023/", "developer_terms_of_service_url": null, "publisher_name": "Cosmic Perspective", "support_website_url": "https://cosmicperspective.com/contact/", "website_url": "http://www.cosmicperspective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
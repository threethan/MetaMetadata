4.5771-25/39031556_1268513560739418_8128185752261582571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rnw2a894LbYQ7kNvwF0ZAbF&_nc_oc=Adl8NMIyPimqF29sqyPXCGzrHDARyEInxFeft-sBch_5UXpG27vU7U8EsFAif_bb05I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwg8WYH0_xHEqcyBMSjS_9VHsU9C8wzuoXMEaQx4EbPcQ&oe=69BE91D9"}, {"file_name": "screens-5.png", "id": "736259608137227", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982558_736259611470560_3566202125264914141_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDFaV8klcC8Q7kNvwElVssz&_nc_oc=AdnNCQp5-19VuUA2AbalB5xdpEQh0bb-jp2OCsYI-RMJYq7UKFh-zAgwvpCCetSSz9U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8wplpNLyYgbx_3KFI-3DT8pYJbKN7fEpBi15534hz1g&oe=69BE80CD"}, {"file_name": "screens-4.png", "id": "3544551479115080", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974513_3544551482448413_901906659547366997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Dy4wDENdLwQ7kNvwFZvzlr&_nc_oc=Adkx_i7jGprF5TDmCLgxIPSo3VBcxQxO4FaA2w2MjscSK5OVHOYi291Yf8xuJJ9EIBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMNc-3QKJzLCbIJ308ftup1Wsnb8NhhKvSSU7NzvpFRQ&oe=69BE8F23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens-1.png", "id": "1246384082652658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974733_1246384085985991_5209142970159529378_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTKRhlT2gi8Q7kNvwEbnBI0&_nc_oc=Admg88RhQaMKThe99QcOmLnFgtypo_5Lk0NEg7xeFmDXbZx0OOybsC1Hp1RRJpUkabE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfytC5DR9ZGuBDgU3TvKI7dkgLJUkHw60mK7kaDIxc56jg&oe=69BE908A"}, "display_name": "Rocket Launch Films VR", "keywords": [], "long_description": "Experience real rocket launches up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of Cape Canaveral, Starbase, and more.  See Falcon 9, Starship, Atlas V, SLS, Terran 1, Delta IV, and others, up close during liftoff and testing where no humans can be. \n\nPerfect for high-quality headphones (and haptic rumble suits), feel the Earth-shaking jolt of rockets like never before with professionally recorded ambisonic audio. \n\nJoin our community on Discord and also go behind the scenes as we film new experiences and exciting spaceflight events. ", "short_description": "Experience a real rocket launch up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of SpaceX Falcon 9 and Starship, NASA Artemis, Atlas V, and more during actual liftoff events. Feel the rumble of rockets like never before with professionally recorded ambisonic audio. New experience films are added to the library regularly. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicperspective.com/privacy-policy2023/", "developer_terms_of_service_url": null, "publisher_name": "Cosmic Perspective", "support_website_url": "https://cosmicperspective.com/contact/", "website_url": "http://www.cosmicperspective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5688744381225735"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003225_1336329183830830_423506541559213616_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0C20U7X9dkQ7kNvwFKb7td&_nc_oc=
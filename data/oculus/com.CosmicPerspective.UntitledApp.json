//scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031556_1268513560739418_8128185752261582571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKVhZR794jgQ7kNvwGVEer4&_nc_oc=AdpXhp88WjsgjywTvez-wspYufJh9Ql3IDBYAZodBOVG7kffP1sWnURwY1NUHszJsxw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9d9275WCAkWTxUV145hJb-lUmiF7-vpWKoHm3fk2Lk4A&oe=6A341F99"}, {"file_name": "screens-5.png", "id": "736259608137227", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982558_736259611470560_3566202125264914141_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNSbDBKjGTkQ7kNvwFpTqiX&_nc_oc=AdrSZcAJ4WvBfBPTdObHNkwYvbTxnEG4LlSeepRnY0iMahFUD52p7xCk-w6vJlpCM1U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JbSq6yQ2GxsO4QJm7SOuJLb3ZZKVq8t9lvvGU-ZqLFQ&oe=6A340E8D"}, {"file_name": "screens-4.png", "id": "3544551479115080", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974513_3544551482448413_901906659547366997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t61MgPwP0hIQ7kNvwGIO6RM&_nc_oc=AdpBvOlS8uhHVOIq-dQi93TI9yl7i5KH9azWLoKXafpNe04RoADna4HGXbv1zWaJlpE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D_HJ8FYyrUE7bGOPDoMKvDvHBY6ndCkrsxyXY5Vl5dw&oe=6A341CE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens-1.png", "id": "1246384082652658", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974733_1246384085985991_5209142970159529378_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sX9W0o1iMcQ7kNvwESzg2B&_nc_oc=AdorooQyE2A3f48gNN4dAmgwwx_wZs0wNgBOofeRYDwPyoqUz4ypQJLbUahsQaggC3I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x5BugV959NIJlulJ2rYBwYrfPlgZEdjgBZZj5U0nGUA&oe=6A341E4A"}, "display_name": "Rocket Launch Films VR", "keywords": [], "long_description": "Experience real rocket launches up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of Cape Canaveral, Starbase, and more.  See Falcon 9, Starship, Atlas V, SLS, Terran 1, Delta IV, and others, up close during liftoff and testing where no humans can be. \n\nPerfect for high-quality headphones (and haptic rumble suits), feel the Earth-shaking jolt of rockets like never before with professionally recorded ambisonic audio. \n\nJoin our community on Discord and also go behind the scenes as we film new experiences and exciting spaceflight events. ", "short_description": "Experience a real rocket launch up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of SpaceX Falcon 9 and Starship, NASA Artemis, Atlas V, and more during actual liftoff events. Feel the rumble of rockets like never before with professionally recorded ambisonic audio. New experience films are added to the library regularly. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicperspective.com/privacy-policy2023/", "developer_terms_of_service_url": null, "publisher_name": "Cosmic Perspective", "support_website_url": "https://cosmicperspective.com/contact/", "website_url": "http://www.cosmicperspective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5688744381225735"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003225_1336329183830830_423506541559213616_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_n
5752261582571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r39zM8JsuwUQ7kNvwG5hLwT&_nc_oc=AdrEYzodDpM8xaXitrdixw__H3ECYGJRywFTN2FzOBnbieapzLKslXcjKelLQCb0qW8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af18B0f5-IZR6EQTAd41fWPmIO0pCE8OxTcTWAkgQVLu1g&oe=69F1FC59"}, {"file_name": "screens-5.png", "id": "736259608137227", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982558_736259611470560_3566202125264914141_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kok0hkgcKGoQ7kNvwGmolF4&_nc_oc=AdquIn0EjjYAByFE1scmKCK0cqah6OWKUr0oGr1SOaD81RCnqZP9E6W-MNzu_syf7HY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0zdVI20Gig2sk__EV-YGiji0gDYfI344gRsEa4iGF-5g&oe=69F1EB4D"}, {"file_name": "screens-4.png", "id": "3544551479115080", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974513_3544551482448413_901906659547366997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVMMjfkd8xwQ7kNvwGVdRfo&_nc_oc=AdpajIMFpkM0-thjgrNyW1xBHDm1jcjvBJuHFTBnw4nhzShELA8puTa0Gfkc73UC934&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af03y6wDsxGGKRtaY6i4VJE_gepilcWtCz6Ds7vqbmkP9A&oe=69F1F9A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens-1.png", "id": "1246384082652658", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974733_1246384085985991_5209142970159529378_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCTwCjcOXioQ7kNvwG5TPX6&_nc_oc=Adro7XamSk4UBfNBhI_BNacS3QbkiKse6GyBn751_16vsuZc_WluqMiSpHlNC0-BbqU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0-qmceJ_6FHBFRnEQQlKz_Lmk4SAp8V8Fcp4RZ4Sbp8g&oe=69F1FB0A"}, "display_name": "Rocket Launch Films VR", "keywords": [], "long_description": "Experience real rocket launches up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of Cape Canaveral, Starbase, and more.  See Falcon 9, Starship, Atlas V, SLS, Terran 1, Delta IV, and others, up close during liftoff and testing where no humans can be. \n\nPerfect for high-quality headphones (and haptic rumble suits), feel the Earth-shaking jolt of rockets like never before with professionally recorded ambisonic audio. \n\nJoin our community on Discord and also go behind the scenes as we film new experiences and exciting spaceflight events. ", "short_description": "Experience a real rocket launch up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of SpaceX Falcon 9 and Starship, NASA Artemis, Atlas V, and more during actual liftoff events. Feel the rumble of rockets like never before with professionally recorded ambisonic audio. New experience films are added to the library regularly. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicperspective.com/privacy-policy2023/", "developer_terms_of_service_url": null, "publisher_name": "Cosmic Perspective", "support_website_url": "https://cosmicperspective.com/contact/", "website_url": "http://www.cosmicperspective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5688744381225735"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003225_1336329183830830_423506541559213616_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGthsVVcQMcQ7kNvwFZRZZ1&_nc_oc=Adr4RV9a0bL5OcmRSVTVRP0RZ-ZzJwroz34IfLMAM9n7o5uJbeZsE4-YwJv-OrOGyVQ&_nc_zt=3&_
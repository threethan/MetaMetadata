WZ59uCPoHn29_V6AQ0StPzGsdn1XTZH0MQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT6btIAIVJZoeTO4hz7az0YZ1FWezcDK7LQSNLsTAAw8A&oe=6B0B2BB3"}, {"file_name": "Untitled-6.png", "id": "1268513557406085", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031556_1268513560739418_8128185752261582571_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VDpS23NpeEQ7kNvwFuypda&_nc_oc=AdrRnVlGFcYNtt1TLNBdSg0Hq6pyKusGLrm73OkGEzUzH_lzNPK04muDmEXIDVdGdBw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQScsbTImx9sVYDQ5IKw07ioMhQdazjzsDbegI-BuyOtOQ&oe=6B0B3C59"}, {"file_name": "screens-5.png", "id": "736259608137227", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982558_736259611470560_3566202125264914141_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnWU_9L72h4Q7kNvwHhJHYT&_nc_oc=Adrm17BTDnpoZJpqytLRg7QwLe_KIEt6hH9OZmcf7N36qiPRJppRDg9vIlQnvfGal1A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR6J9C1ipYmh_7QLoZxV4gj3YRkK5Gozzr4uVir6Oj8qA&oe=6B0B2B4D"}, {"file_name": "screens-4.png", "id": "3544551479115080", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974513_3544551482448413_901906659547366997_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhc0AyB_3ocQ7kNvwGylS5V&_nc_oc=AdqhrRw8ZU62ybZYLRp2UzmQgRDVox46MEv0DAoqfgfGSluDx-RW_totQEKln2pJx9Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTZNayy6OiT7GmI01ZwOfcPPEXqfeMgK2ygy8uvqthB7g&oe=6B0B39A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens-1.png", "id": "1246384082652658", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974733_1246384085985991_5209142970159529378_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXOjnM-5i9AQ7kNvwGH2VTO&_nc_oc=AdrP51x5x6m684kQHnBo76rury9wpKwtA3chymt5j4KSRKF15olUJyTDY4pRoGjm2jw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQFwNILYgDsSm9wg4zkY7pRIz3grssjiOnayvsgZK7pxg&oe=6B0B3B0A"}, "display_name": "Rocket Launch Films VR", "keywords": [], "long_description": "Experience real rocket launches up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of Cape Canaveral, Starbase, and more.  See Falcon 9, Starship, Atlas V, SLS, Terran 1, Delta IV, and others, up close during liftoff and testing where no humans can be. \n\nPerfect for high-quality headphones (and haptic rumble suits), feel the Earth-shaking jolt of rockets like never before with professionally recorded ambisonic audio. \n\nJoin our community on Discord and also go behind the scenes as we film new experiences and exciting spaceflight events. ", "short_description": "Experience a real rocket launch up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of SpaceX Falcon 9 and Starship, NASA Artemis, Atlas V, and more during actual liftoff events. Feel the rumble of rockets like never before with professionally recorded ambisonic audio. New experience films are added to the library regularly. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicperspective.com/privacy-policy2023/", "developer_terms_of_service_url": null, "publisher_name": "Cosmic Perspective", "support_website_url": "https://cosmicperspective.com/contact/", "website_url": "http://www.cosmicperspective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
25264914141_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VonVvtbRMlgQ7kNvwHehl4n&_nc_oc=Adrup8bMwHcWc2kuYZv8NGDeU_ptynARAN2eRHpqAJSmv6mQWBEmO03efQLzaeglnWs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1lCJEMsfYjpXUflxwL-tDc3TMmodp9I2l8NbmM_RuHA&oe=6A85934D"}, {"file_name": "screens-4.png", "id": "3544551479115080", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974513_3544551482448413_901906659547366997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ud50NzBLjAQ7kNvwFM4WCf&_nc_oc=Adpn6jgXTbMeEhkNpzi22zTF2_nIRLCYLGZl6p_zDdyCfTxFVFidhuQbO8o4sE648bc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwfUnGu9JMaB_oTLIzMD7k_VbE2ZiHUwsZyc-VMshiNw&oe=6A85A1A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens-1.png", "id": "1246384082652658", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974733_1246384085985991_5209142970159529378_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVCRsrtgyC4Q7kNvwHXO6aA&_nc_oc=Adrnc-Fg-NVkZdUql3DoD1jGPVbkc_T6MYfTMXW0kx8I6sf6qXAKP94LeHQamfvbl1U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0XvyxkCWF98NihrkOqlp93aOmcgxzwpLYnE5_PQ8qIA&oe=6A85A30A"}, "display_name": "Rocket Launch Films VR", "keywords": [], "long_description": "Experience a real rocket launch up close like never before!\n\nNow witness rockets from Cape Canaveral to Starbase like Falcon 9, Starship, Atlas V, and more, up close where no humans can be during liftoff. Travel from Cape Canaveral to Starbase and more with our 3D cinema cameras and ambisonic microphones. \n\nPerfect for high-quality headphones (and haptic rumble suits), feel the Earth-shaking jolt of rockets like never before with professionally recorded ambisonic audio. \n\nJoin our community on Discord and also go behind the scenes as we film new experiences and exciting spaceflight events. ", "short_description": "Experience a real rocket launch up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of SpaceX Falcon 9 and Starship, NASA Artemis, Atlas V, and more during actual liftoff events. Feel the rumble of rockets like never before with professionally recorded ambisonic audio. New experience films are added to the library regularly. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicperspective.com/privacy-policy2023/", "developer_terms_of_service_url": null, "publisher_name": "Cosmic Perspective", "support_website_url": "https://cosmicperspective.com/contact/", "website_url": "http://www.cosmicperspective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "756002609417342"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PENDING", "id": "618983111116269"}, {"status": "PUBLISHED", "id": "899983518914208"}, {"status": "CANCELLED", "id": "917644453766091"}, {"status": "PUBLISHED", "id": "3785597241757077"}, {"status": "PUBLISHED", "id": "157406560566852"}]}, "baseline_offer": {"id": "157406560566852"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "618983111116269"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5416952075072909", "version": "1.0.0"}, "id": "748551556297846", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "prima
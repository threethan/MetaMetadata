//scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031556_1268513560739418_8128185752261582571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNvdDQDwgfoQ7kNvwH9xvLi&_nc_oc=AdpGePp-Wt3FgGvXTg_V8uSTjYiopdOYCWEfaD6zUNZwAP9Aegp0bjkgAGO_M-02250&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeq_7ZkexqJJ2gDNTWGfEsUQSGISVAYpaOg_KPGX2TSw&oe=6AECB199"}, {"file_name": "screens-5.png", "id": "736259608137227", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982558_736259611470560_3566202125264914141_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13Zyi7fYiqIQ7kNvwFqEZ0M&_nc_oc=Adq_tQM5ai32esBhENHy0WO38HPDyHUySyRgIQcp5yft_uUIvRYBRKoPR4urKMs8m1o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyu_u5H-2ybR3mYE9LSDL4BrLgiWgafYtbus-sSKqQiA&oe=6AECA08D"}, {"file_name": "screens-4.png", "id": "3544551479115080", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974513_3544551482448413_901906659547366997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DD4kpHLmPyYQ7kNvwEqEv4C&_nc_oc=Adqn61oVoujJuYzfRGCtHCDmLqtWT38ZJYyB59nL3TdS1ajMhhPfTyLocBBuHG3hcJo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4mbXHhd0m1R_-1BD5e0ZGDcqi-t4fTPKqfshm1HrLHA&oe=6AECAEE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens-1.png", "id": "1246384082652658", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974733_1246384085985991_5209142970159529378_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y3gCOtPw9MQ7kNvwF1lMmo&_nc_oc=AdqDiyYUlsPpN6Fz5OI0Nj3zOOZed4iRZCT_G2ckMkg95dmVg2q1YKaHhe24B3hPO0U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDx9qWm6UBj8kEjIzh6QUovi_xsZfxT9_5bZ-czpkKRg&oe=6AECB04A"}, "display_name": "Rocket Launch Films VR", "keywords": [], "long_description": "Experience real rocket launches up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of Cape Canaveral, Starbase, and more.  See Falcon 9, Starship, Atlas V, SLS, Terran 1, Delta IV, and others, up close during liftoff and testing where no humans can be. \n\nPerfect for high-quality headphones (and haptic rumble suits), feel the Earth-shaking jolt of rockets like never before with professionally recorded ambisonic audio. \n\nJoin our community on Discord and also go behind the scenes as we film new experiences and exciting spaceflight events. ", "short_description": "Experience a real rocket launch up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of SpaceX Falcon 9 and Starship, NASA Artemis, Atlas V, and more during actual liftoff events. Feel the rumble of rockets like never before with professionally recorded ambisonic audio. New experience films are added to the library regularly. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicperspective.com/privacy-policy2023/", "developer_terms_of_service_url": null, "publisher_name": "Cosmic Perspective", "support_website_url": "https://cosmicperspective.com/contact/", "website_url": "http://www.cosmicperspective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5688744381225735"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003225_1336329183830830_423506541559213616_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_n
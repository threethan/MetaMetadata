e": "Untitled-6.png", "id": "1268513557406085", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031556_1268513560739418_8128185752261582571_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPLSXK9oPb8Q7kNvwHxaOVv&_nc_oc=Adoi26gLB3VAapSQiy0YbswyFpHS7SdIZrPYpcKZ4rWywNfD0MpReas4_ITBCbXlBHo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGj0oFNnGuwVbfi91A-yUnnnW1NEwUTH42k1psf9z7Qg&oe=6B046C99"}, {"file_name": "screens-5.png", "id": "736259608137227", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982558_736259611470560_3566202125264914141_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9ZC7EmmOgsQ7kNvwEaXkGC&_nc_oc=AdplNnmL6d8DZgXZ5de4Xszhu-Hj32oDZCiaFXuPsSb_Lq1evnaZ_Qjg3-cC7nntX7w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZF8Ejl6yjuFDWQkm9yHAZVjjHba2tuZ_dh3RS6jTS6A&oe=6B045B8D"}, {"file_name": "screens-4.png", "id": "3544551479115080", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974513_3544551482448413_901906659547366997_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joYoE5mfRMwQ7kNvwF8a2ee&_nc_oc=AdrFkdePAK-whyMtS-4QRAKRbJhOAysS-zcBB_p_dF97EcaYjoEJFE2HSq6mYDtLGqY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnJUwBVCYXchWxaqhLsOL4ZB7hKqD8TbB-4Mz9gRdNHA&oe=6B0469E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens-1.png", "id": "1246384082652658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1246384085985991_5209142970159529378_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcyGbZRxRAkQ7kNvwEghQB8&_nc_oc=Ado33GO8AmxICmUkEQiUVmgbtHqbAtuZrw-xRMrMgHjU9XNMKD1gF0JGrcFJ9ZTaZTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-l6616KqM2mMRviJlq2bdmN7bOL9DymKVhJeDMUB0-Q&oe=6B046B4A"}, "display_name": "Rocket Launch Films VR", "keywords": [], "long_description": "Experience a real rocket launch up close like never before!\n\nNow witness rockets from Cape Canaveral to Starbase like Falcon 9, Starship, Atlas V, and more, up close where no humans can be during liftoff. Travel from Cape Canaveral to Starbase and more with our 3D cinema cameras and ambisonic microphones. \n\nPerfect for high-quality headphones (and haptic rumble suits), feel the Earth-shaking jolt of rockets like never before with professionally recorded ambisonic audio. \n\nJoin our community on Discord and also go behind the scenes as we film new experiences and exciting spaceflight events. ", "short_description": "Experience a real rocket launch up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of SpaceX Falcon 9 and Starship, NASA Artemis, Atlas V, and more during actual liftoff events. Feel the rumble of rockets like never before with professionally recorded ambisonic audio. New experience films are added to the library regularly. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicperspective.com/privacy-policy2023/", "developer_terms_of_service_url": null, "publisher_name": "Cosmic Perspective", "support_website_url": "https://cosmicperspective.com/contact/", "website_url": "http://www.cosmicperspective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "756002609417342"}}]}, "scheduled_offers": {"count": 5, "n
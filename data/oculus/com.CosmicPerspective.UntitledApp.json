4.5771-25/39031556_1268513560739418_8128185752261582571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfKzE4QhlXkQ7kNvwEiFn5w&_nc_oc=Adn8tx4YMOBiZ5Mdbd-m96rrCZpJEOW8iXsAoKg98JgcZ6tBC0irkRQxtA3JY2GPZqk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxl0tOb1_2cye2ioD9kO07-s5e4IF91WLwGQLZYysNw9Q&oe=69AEBFD9"}, {"file_name": "screens-5.png", "id": "736259608137227", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982558_736259611470560_3566202125264914141_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gi5VIcj2yWoQ7kNvwGliAHQ&_nc_oc=Adm0UMY6isQapMT20MvHRXvS0gzLRLLO3-LQUHrlH9nzFJX0bNoeNO0fgl3tS2KyIOc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0VNwoKOiSb9aUGzm6MZvfxIgy01Wtj9yFGzhH1PQtzQ&oe=69AEAECD"}, {"file_name": "screens-4.png", "id": "3544551479115080", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974513_3544551482448413_901906659547366997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A70iQpSMIN8Q7kNvwFeMaSV&_nc_oc=Adk00g5P_CQnB_7n_SKWYjozSfqekJ-d_Qj1-708XePIyOEjMbMLqLZp6uvOBjwKhf0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQD-zk0tNy0O9ba3-0PeZB38qgmXot2mqEHZQ2Xgq2Dw&oe=69AEBD23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens-1.png", "id": "1246384082652658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1246384085985991_5209142970159529378_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLu2QrJoCGsQ7kNvwEItZmO&_nc_oc=AdkSlaDQMwOws5NVbyFiHn_p_nVEkGTeK6oCFQeXmmXzYb9bwNeX2XzXGPLoDTVoCzg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqwdsfOSc7sHgYNHjnmjylJOyFP0bOncRof--_Zgc6LA&oe=69AEBE8A"}, "display_name": "Rocket Launch Films VR", "keywords": [], "long_description": "Experience real rocket launches up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of Cape Canaveral, Starbase, and more.  See Falcon 9, Starship, Atlas V, SLS, Terran 1, Delta IV, and others, up close during liftoff and testing where no humans can be. \n\nPerfect for high-quality headphones (and haptic rumble suits), feel the Earth-shaking jolt of rockets like never before with professionally recorded ambisonic audio. \n\nJoin our community on Discord and also go behind the scenes as we film new experiences and exciting spaceflight events. ", "short_description": "Experience a real rocket launch up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of SpaceX Falcon 9 and Starship, NASA Artemis, Atlas V, and more during actual liftoff events. Feel the rumble of rockets like never before with professionally recorded ambisonic audio. New experience films are added to the library regularly. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicperspective.com/privacy-policy2023/", "developer_terms_of_service_url": null, "publisher_name": "Cosmic Perspective", "support_website_url": "https://cosmicperspective.com/contact/", "website_url": "http://www.cosmicperspective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5688744381225735"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003225_1336329183830830_423506541559213616_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbqkkjGF2vUQ7kNvwHl4b3V&_nc_oc=
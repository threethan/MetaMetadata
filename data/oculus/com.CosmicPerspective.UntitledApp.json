4.5771-25/39031556_1268513560739418_8128185752261582571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qyz2ybDkBXEQ7kNvwHMF4e_&_nc_oc=AdmI41_6iTtprimBcACx8jVhsJMcyqumMyIJeHqskj2RoaTh2BLEJ2bZOaW7d3vzCaQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzItUloX9BnQPGLY52d9jEeR0u9tWQnqJH4xMSgp-FkGQ&oe=69BA9D59"}, {"file_name": "screens-5.png", "id": "736259608137227", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982558_736259611470560_3566202125264914141_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBAex0lrE5sQ7kNvwHE6Izg&_nc_oc=AdmLVKNkl5pPq3uPh_Dqj7byPEXSvQ8vCvzR5FrvwFKZupHXjjyI0QCnBcDxmPVxSUU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxL3tE1UUyCrvv0V85v_AL4B2Mz42M1trhrsIahBbJoQ&oe=69BA8C4D"}, {"file_name": "screens-4.png", "id": "3544551479115080", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974513_3544551482448413_901906659547366997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8swpJOe0GUQ7kNvwFaz7i7&_nc_oc=AdnOTRHOHScitUgGYpCkP42ncgAvaAZ8yyvW2RViWkax4GNm0zTsvLzig7wDWz-gQD8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzDv-mXmhzlT5_J4Oy8_wH1gZS11QlYrkJ29C88wtasPw&oe=69BA9AA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens-1.png", "id": "1246384082652658", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974733_1246384085985991_5209142970159529378_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tggBRhAToUQQ7kNvwHHDiOW&_nc_oc=Admj2nLN1bZ6Ksr5RwpRFQjoNXeICFcYxwgUOgzLXBGEKZghpPwkygwjPMpXwI_UqJA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxb3E2yhkojrO0XyUcUUOFoa6aiOZbwHvNSqgB-lo113A&oe=69BA9C0A"}, "display_name": "Rocket Launch Films VR", "keywords": [], "long_description": "Experience real rocket launches up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of Cape Canaveral, Starbase, and more.  See Falcon 9, Starship, Atlas V, SLS, Terran 1, Delta IV, and others, up close during liftoff and testing where no humans can be. \n\nPerfect for high-quality headphones (and haptic rumble suits), feel the Earth-shaking jolt of rockets like never before with professionally recorded ambisonic audio. \n\nJoin our community on Discord and also go behind the scenes as we film new experiences and exciting spaceflight events. ", "short_description": "Experience a real rocket launch up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of SpaceX Falcon 9 and Starship, NASA Artemis, Atlas V, and more during actual liftoff events. Feel the rumble of rockets like never before with professionally recorded ambisonic audio. New experience films are added to the library regularly. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicperspective.com/privacy-policy2023/", "developer_terms_of_service_url": null, "publisher_name": "Cosmic Perspective", "support_website_url": "https://cosmicperspective.com/contact/", "website_url": "http://www.cosmicperspective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5688744381225735"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003225_1336329183830830_423506541559213616_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEhvyMecPOsQ7kNvwERQdtI&_nc_oc=
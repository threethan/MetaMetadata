xNVTIZ2tpvhnIycUXkH8xg-5Fry26YFS1c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbF4MvCa0cJT_LwfdYwcx2FdZdQxxwjmH1VFyc9mrqxQ&oe=6AFB2173"}, {"file_name": "Untitled-6.png", "id": "1268513557406085", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031556_1268513560739418_8128185752261582571_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIWYFNMQtcMQ7kNvwGsr-vk&_nc_oc=AdoVvdOsWjspN7vmc-xcJn4QBfcf2n3L9P5TsIORMFeVx3fLZmGsZdaM5-H4axOb_QY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQShi0dwlRORLA2ELim7aIzbXl1nfLyU6U_dK1kLdLPBA&oe=6AFB3219"}, {"file_name": "screens-5.png", "id": "736259608137227", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982558_736259611470560_3566202125264914141_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBhRtetZI44Q7kNvwHHPz72&_nc_oc=AdoBrubyhg0BRRqRd_1wcxWV_sk0-oQLG8IBUFdWgySNhYgONcVHvEtLtJ2EZPO982Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHqct7BPJkJXdMq4a0YUDkXxNRxY1LXiq2sEyHc8pXCw&oe=6AFB210D"}, {"file_name": "screens-4.png", "id": "3544551479115080", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974513_3544551482448413_901906659547366997_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fwfbNvkcSkQ7kNvwEitRwy&_nc_oc=AdoAm2cSW9Pqwxe7Qcur9Z9YLkUq3issWZv_AU-lWkobC_H60KpHWgj5M4Xkey1twU8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf68PGe-u6OfMzoekZ8ZWCGRZDjrtpTyg2zrDPbYEy1A&oe=6AFB2F63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens-1.png", "id": "1246384082652658", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974733_1246384085985991_5209142970159529378_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agIrUOjqcaEQ7kNvwEtOc9j&_nc_oc=AdrNyZ9bBFUcYDphF_Piy-JnENsLabxYavrjJ8KrjNGL5PZooACIKUskp0-DPXnO4ls&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ8Zd1BkCL_4vRCYAA37Gf28Lz9HloYLuohsMMvwm1kA&oe=6AFB30CA"}, "display_name": "Rocket Launch Films VR", "keywords": [], "long_description": "Experience real rocket launches up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of Cape Canaveral, Starbase, and more.  See Falcon 9, Starship, Atlas V, SLS, Terran 1, Delta IV, and others, up close during liftoff and testing where no humans can be. \n\nPerfect for high-quality headphones (and haptic rumble suits), feel the Earth-shaking jolt of rockets like never before with professionally recorded ambisonic audio. \n\nJoin our community on Discord and also go behind the scenes as we film new experiences and exciting spaceflight events. ", "short_description": "Experience a real rocket launch up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of SpaceX Falcon 9 and Starship, NASA Artemis, Atlas V, and more during actual liftoff events. Feel the rumble of rockets like never before with professionally recorded ambisonic audio. New experience films are added to the library regularly. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicperspective.com/privacy-policy2023/", "developer_terms_of_service_url": null, "publisher_name": "Cosmic Perspective", "support_website_url": "https://cosmicperspective.com/contact/", "website_url": "http://www.cosmicperspective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
gVuDUTGkidQXcpDsC7a8MVvzdb37kztBPc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT0oAR8QkDM8VzfWIHuBrJOl_sbr6_TvU6WflCU4i-gNw&oe=6B0C7D33"}, {"file_name": "Untitled-6.png", "id": "1268513557406085", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031556_1268513560739418_8128185752261582571_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VDpS23NpeEQ7kNvwH2vuLb&_nc_oc=Adq4Nv-fR5ELDvfXAuHMv_MVjUCZqIrcwICwZxJtVPKJiL-StfET-m_QIWPHiXxgfDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQGki1iGEdsRR3cqT9ePfj27jDlRFlVgRaByEW0BaNT_A&oe=6B0C5599"}, {"file_name": "screens-5.png", "id": "736259608137227", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982558_736259611470560_3566202125264914141_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnWU_9L72h4Q7kNvwFR9hSl&_nc_oc=AdovHxDfPnY5DqOEM9TiOzawdXWvqladf5XJ5Mlyibf81AECMcpn5pwaytwOUFL31fo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS72qL23BaCurna28UMPJRo18J4zykW0EJn_fKqOtE0tw&oe=6B0C7CCD"}, {"file_name": "screens-4.png", "id": "3544551479115080", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974513_3544551482448413_901906659547366997_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhc0AyB_3ocQ7kNvwFc0W-q&_nc_oc=Adptr1UE0OHZch1oCLFUjLFEo2Qco0Y__RZf0Fg1ZDCANEpxvb2t1WecTYLwBSDHlXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSz_sCBN7ndyD7WLXWT3uPwWs2kXfOjd2qDqUEaM4d3KA&oe=6B0C52E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens-1.png", "id": "1246384082652658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1246384085985991_5209142970159529378_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXOjnM-5i9AQ7kNvwEnwKe7&_nc_oc=AdrrG1qUbzKIrxQu6stbPBIA32CNLf-myHPnAlIPRQCznc06oFuwvqq_lZAA3M1wqE8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTF1BjX2QKk4eATlon9i70gtpiwm0eOA9CI02ZAc3k_lA&oe=6B0C544A"}, "display_name": "Rocket Launch Films VR", "keywords": [], "long_description": "Experience real rocket launches up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of Cape Canaveral, Starbase, and more.  See Falcon 9, Starship, Atlas V, SLS, Terran 1, Delta IV, and others, up close during liftoff and testing where no humans can be. \n\nPerfect for high-quality headphones (and haptic rumble suits), feel the Earth-shaking jolt of rockets like never before with professionally recorded ambisonic audio. \n\nJoin our community on Discord and also go behind the scenes as we film new experiences and exciting spaceflight events. ", "short_description": "Experience a real rocket launch up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of SpaceX Falcon 9 and Starship, NASA Artemis, Atlas V, and more during actual liftoff events. Feel the rumble of rockets like never before with professionally recorded ambisonic audio. New experience films are added to the library regularly. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicperspective.com/privacy-policy2023/", "developer_terms_of_service_url": null, "publisher_name": "Cosmic Perspective", "support_website_url": "https://cosmicperspective.com/contact/", "website_url": "http://www.cosmicperspective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
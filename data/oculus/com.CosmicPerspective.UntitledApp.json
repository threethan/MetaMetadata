c_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpHYwPGPz4wQ7kNvwHI1Kk1&_nc_oc=Adr9yXWq77XnGvJUKqZSdzO3EApB0oogZetzWYaBBoWGn_s66B3dK8RL6aiqx7mfakk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3W63uOyFFcI1p0084OauckhkGPYyCGcWZu97u6uhB1g&oe=6AE2148D"}, {"file_name": "screens-4.png", "id": "3544551479115080", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974513_3544551482448413_901906659547366997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67cmqRF4vvwQ7kNvwE49WE3&_nc_oc=AdqOF0XrYxggxhQYDUbrsmLgk5STyBodyR3RXbkyRlXakM2Gt374IZ8Rw3-WOtO-McQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZAWy-hEm9jWJukW5cR9CoMsRj77S1wOCjSb5uIHEdYQ&oe=6AE1EAA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens-1.png", "id": "1246384082652658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974733_1246384085985991_5209142970159529378_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOWA3JOmo9QQ7kNvwF1ic_G&_nc_oc=AdrJyAB8dUtf7_Y_fBOHYx9e4kOfRtdDzQpoo5S81W2rE-9k45ZxgIbx0JYUTuEluII&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPU4VOe-2cDWxYToX9ExgjWjGFbaeTUwlYECUswxanMg&oe=6AE1EC0A"}, "display_name": "Rocket Launch Films VR", "keywords": [], "long_description": "Experience a real rocket launch up close like never before!\n\nNow witness rockets from Cape Canaveral to Starbase like Falcon 9, Starship, Atlas V, and more, up close where no humans can be during liftoff. Travel from Cape Canaveral to Starbase and more with our 3D cinema cameras and ambisonic microphones. \n\nPerfect for high-quality headphones (and haptic rumble suits), feel the Earth-shaking jolt of rockets like never before with professionally recorded ambisonic audio. \n\nJoin our community on Discord and also go behind the scenes as we film new experiences and exciting spaceflight events. ", "short_description": "Experience a real rocket launch up close like never before!\n\nThrough the lens of our 3D VR cinema cameras, we take you to the launchpads of SpaceX Falcon 9 and Starship, NASA Artemis, Atlas V, and more during actual liftoff events. Feel the rumble of rockets like never before with professionally recorded ambisonic audio. New experience films are added to the library regularly. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicperspective.com/privacy-policy2023/", "developer_terms_of_service_url": null, "publisher_name": "Cosmic Perspective", "support_website_url": "https://cosmicperspective.com/contact/", "website_url": "http://www.cosmicperspective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "756002609417342"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PENDING", "id": "618983111116269"}, {"status": "PUBLISHED", "id": "899983518914208"}, {"status": "CANCELLED", "id": "917644453766091"}, {"status": "PUBLISHED", "id": "3785597241757077"}, {"status": "PUBLISHED", "id": "157406560566852"}]}, "baseline_offer": {"id": "157406560566852"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "618983111116269"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5416952075072909", "version": "1.0.0"}, "id": "748551556297846", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes"
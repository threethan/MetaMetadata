culuscdn.com/v/t64.5771-25/38974465_7066515133472288_8350505265608192282_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spLONy_eSxcQ7kNvwFC_Xhl&_nc_oc=Adm5h6ypuv8J9rG49PPcwFVDqRhKOP2wB_BpKnfNWTwM3Rxo6BoKHy_KBTMY7x8hNzg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvFu6OjmNl8TNA4DGW1oKUoG6GUloX4icS8Wmi8KywtSQ&oe=69A57F73"}, {"file_name": "Sequence 01.00_08_10_24.Still003.png", "id": "881724380428999", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75469631_881724387095665_1689731681183126631_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XWcFRmcuyYQ7kNvwHPbecJ&_nc_oc=Adnbu4Dw6fsha7icomTauXd51CeKc7IlEMJwPhHTnSTGbMHGif9Z1Wg4eC2m-TgQhgs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvCFSIp7NfNj58DcywcbhOtzA0jLVYOLZ14L5f0c9h81g&oe=69A58B9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Run The Planet", "keywords": ["planet", "run", "scifi", "alien", "simulator"], "long_description": "\"Run the Planet\" is an immersive diorama-style game where you take on the role of a godlike overseer, guiding a tiny stick-figure inhabitant to grow and evolve their small planet. \n\nSet in a charming, minimalistic universe, your goal is to nurture and expand this tiny celestial body by controlling the stick figure as they run across the planet, gathering resources, unlocking upgrades and survive alien invasions.\n\nFollow the illustrated tutorials to understand the game mechanics and enjoy the adventure!\n\nAs the planet evolves, it transforms into more complex ecosystems, unlocking new challenges and mechanics. Witness your planet go from a barren rock to a lush, vibrant world teeming with life and activity\u2014all from your 3rd-person, godlike perspective.\n\n", "short_description": "Witness your planet go from a barren rock to a lush, vibrant world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evresnce.com/run-the-planet-privacypolicy", "developer_terms_of_service_url": null, "publisher_name":
culuscdn.com/v/t64.5771-25/38974465_7066515133472288_8350505265608192282_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BH6aq_XK1QYQ7kNvwE-LcSz&_nc_oc=AdrLla3KzGyoIcTTQjzU7XRQZqTgWkbpYxgF-WIErIXVFPevvr8YwBHCpVFG9WkWMn8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2bX9urFpfFx5IvOhdHrMypE24fidK2XQLRnOunf5D-_Q&oe=69F0A4F3"}, {"file_name": "Sequence 01.00_08_10_24.Still003.png", "id": "881724380428999", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75469631_881724387095665_1689731681183126631_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUUxHG-z7PQQ7kNvwEBr_F7&_nc_oc=Adpdrv5Vk2lvPNqiqHFe4Av5sETw3P-UIiwpujxhTRK6d93OO1EvLPEOT40rRBbBGB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1DHfJOu1aW_Cp4PpAukod67j-KgF5yA4IgnYYRz1il0w&oe=69F0B11A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Run The Planet", "keywords": ["planet", "run", "scifi", "alien", "simulator"], "long_description": "\"Run the Planet\" is an immersive diorama-style game where you take on the role of a godlike overseer, guiding a tiny stick-figure inhabitant to grow and evolve their small planet. \n\nSet in a charming, minimalistic universe, your goal is to nurture and expand this tiny celestial body by controlling the stick figure as they run across the planet, gathering resources, unlocking upgrades and survive alien invasions.\n\nFollow the illustrated tutorials to understand the game mechanics and enjoy the adventure!\n\nAs the planet evolves, it transforms into more complex ecosystems, unlocking new challenges and mechanics. Witness your planet go from a barren rock to a lush, vibrant world teeming with life and activity\u2014all from your 3rd-person, godlike perspective.\n\n", "short_description": "Witness your planet go from a barren rock to a lush, vibrant world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evresnce.com/run-the-planet-privacypolicy", "developer_terms_of_service_url": null, "publisher_name":
20f&oh=00_AQL9jdht0oh2KQkIDZxBsAcwdMePkm4HCjexiAKCieRFbQ&oe=6AA40621"}, {"file_name": "Sequence 01.00_08_10_24.Still003.png", "id": "881724380428999", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75469631_881724387095665_1689731681183126631_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiC-DYPrGiMQ7kNvwGiY-uZ&_nc_oc=Adr5V8-DzcW17GhOn66LCRQdWh3U6FXkYzNq17pmA1-at-Nv6CNbYbLRDhrjeGgGs-M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZzX4qAsQunECCYI2-j8KLBFxS-vG2NmKFw_oqVqWr1g&oe=6AA3FD1A"}, {"file_name": "Sequence 01.00_01_23_28.Still004.png", "id": "3676207732671570", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974551_3676207736004903_7841880672543588648_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCcfVb-A6qQQ7kNvwGm-Syz&_nc_oc=AdrceynH9qlGbaKzJlWGjHKv5g9cemO3jf-DJr8Q6MjGWh3KyW37ZUDbtUNpM7yq1Go&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1K6db3lmFPpXJLE9vuwJI0Op_569WzGxqzfiCg4i1aw&oe=6AA3F2A0"}, {"file_name": "RTP_Trailer_01.00_00_11_03.Still006.png", "id": "543971625212762", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75272208_543971631879428_6249463980223903576_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPtfJdqjYxUQ7kNvwFyN9tL&_nc_oc=AdrdkOaNLPk9AMbvf3vR91uHLdhwnASniIGlTUF7K-1GtilnyJJVYkyfE5BdCqtlqRM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3QPwDKpPBhqbFjCH4bZUytDerqQfKvjALKYg9Q03qlw&oe=6AA40112"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "runtheplanet_new_A.png", "id": "1738071120797404", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823930_1738071124130737_4974988272168659390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yc9ufNj2KqkQ7kNvwEj1Ho_&_nc_oc=AdrYND3OlF2P5dwBzQ7IWMwZaxJOJgOtqA9OOtzEmfLujakD9BAW2AH-v8nd2C1_R9A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhcsJNs0Xfl9gNxmnpDXC9dY7Mgh4Y2LltfSy0Ome21Q&oe=6AA41A9D"}, "display_name": "Run The Planet", "keywords": ["planet", "run", "alien", "simulator", "shoot"], "long_description": "\"Run the Planet\" is an immersive diorama-style game where you take on the role of a godlike overseer, guiding a tiny stick-figure inhabitant to grow and evolve their small planet. \n\nSet in a charming, minimalistic universe, your goal is to nurture and expand this tiny celestial body by controlling the stick figure as they run across the planet, gathering resources, unlocking upgrades and survive alien invasions.\n\nFollow the illustrated tutorials to understand the game mechanics and enjoy the adventure!\n\nAs the planet evolves, it transforms into more complex ecosystems, unlocking new challenges and mechanics. Witness your planet go from a barren rock to a lush, vibrant world teeming with life and activity\u2014all from your 3rd-person, godlike perspective.\n\n", "short_description": "Witness your planet go from a barren rock to a lush, vibrant world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://evresnce-games.com/runtheplanet-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "EVRESNCE", "support_website_url": null, "website_url": "https://evresnce-games.com/runtheplanet", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27295927956702066"}, "review_messa
s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0sx07E3fk4Q7kNvwE5SJ9x&_nc_oc=AdrMm5n-_5qBEl7JcKsOEVnJrgqcelS7wktNdb94QhBIk7dYtPG2lEvymAoQM8fa-Vs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXmor7BP5dBh85f8T7XZ2kxKIJNCFzUMm6mTFJo_x37g&oe=6AFDC09D"}, "display_name": "Run The Planet", "keywords": ["planet", "run", "alien", "simulator", "shoot"], "long_description": "\"Run the Planet\" is an immersive diorama-style game where you take on the role of a godlike overseer, guiding a tiny stick-figure inhabitant to grow and evolve their small planet. \n\nSet in a charming, minimalistic universe, your goal is to nurture and expand this tiny celestial body by controlling the stick figure as they run across the planet, gathering resources, unlocking upgrades and survive alien invasions.\n\nFollow the illustrated tutorials to understand the game mechanics and enjoy the adventure!\n\nAs the planet evolves, it transforms into more complex ecosystems, unlocking new challenges and mechanics. Witness your planet go from a barren rock to a lush, vibrant world teeming with life and activity\u2014all from your 3rd-person, godlike perspective.\n\n", "short_description": "Witness your planet go from a barren rock to a lush, vibrant world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://evresnce-games.com/runtheplanet-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "EVRESNCE", "support_website_url": null, "website_url": "https://evresnce-games.com/runtheplanet", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_
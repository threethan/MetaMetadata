Sg51Ujt65MOa0HNo5XBI_gP_NVceU4bJwKIFqbZOHf225ANVQgT4IU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOcquAkLbeZRgNmDHMFnNjkC0pgbh9bBWcBSqi6XDGLQ&oe=6AF5E7E0"}, {"file_name": "Sequence 01.00_09_49_14.Still005.png", "id": "7066515130138955", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974465_7066515133472288_8350505265608192282_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7m9kzlK0wHEQ7kNvwGYaEnA&_nc_oc=Adr1coB-rkj58whV6rIFDLQ4Hg52747dC7gKGuuY8-kLCVWtsmf-KJc3cKmZurF0DHw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIEMFCP25VL2T9_pYMbbwQNMv5I_1WRezw9OdsnzoJ4g&oe=6AF5E633"}, {"file_name": "Sequence 01.00_08_10_24.Still003.png", "id": "881724380428999", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75469631_881724387095665_1689731681183126631_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgrhtIp9qekQ7kNvwE7DT3U&_nc_oc=AdrtJ_eOdd2Ov2hI-hw4mEouwbEwdambOKSxqjrxVIRkynxk-ME185Al0D_7ji5tu6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgGY7uWyclHO7KtHmX6p_0rF67UA6Dzx8lvzbzK3QS8Q&oe=6AF5F25A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Run The Planet", "keywords": ["planet", "run", "scifi", "alien", "simulator"], "long_description": "\"Run the Planet\" is an immersive diorama-style game where you take on the role of a godlike overseer, guiding a tiny stick-figure inhabitant to grow and evolve their small planet. \n\nSet in a charming, minimalistic universe, your goal is to nurture and expand this tiny celestial body by controlling the stick figure as they run across the planet, gathering resources, unlocking upgrades and survive alien invasions.\n\nFollow the illustrated tutorials to understand the game mechanics and enjoy the adventure!\n\nAs the planet evolves, it transforms into more complex ecosystems, unlocking new challenges and mechanics. Witness your planet go from a barren rock to a lush, vibrant world teeming with life and activity\u2014all from your 3rd-person, godlike perspective.\n\n", "short_description": "Witness your planet go from a barren rock to a lush, vibrant world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evresnce.com/run-the-planet-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "EVRESNCE", "support_website_url": null, "website_url": "https://www.evresnce.com/runtheplanet", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677825668938910"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1643966734073345"}, {"status": "PUBLISHED", "id": "1701079627773592"}, {"status": "PUBLISHED", "id": "2039788093634037"}, {"status": "PUBLISHED", "id": "24792384877057993"}, {"status": "PUBLISHED", "id": "1028679882456628"}, {"status": "PUBLISHED", "id": "1374089800424834"}, {"status": "PUBLISHED", "id": "27813501201628337"}, {"status": "PUBLISHED", "id": "1145163596945983"}]}, "baseline_offer": {"id": "1701079627773592"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1643966734073345"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8920779631310178", "version": "0.1.7"}, "id": "2016060658906502", "channel_name": "
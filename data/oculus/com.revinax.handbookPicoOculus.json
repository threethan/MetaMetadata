9366_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ol0DGD2hUKkQ7kNvwH_Y2HU&_nc_oc=AdkHzBlXMd-2mpvHn_uTb0XRAboL8T7RWVrtYrnuPjfc_rFoWj7GYMuAbfZji59O27I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQ3CrP1y_kWyUNhyTzQ7Wyvibf1TTC0ZQURT9cuC57Ng&oe=69BEA851"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "1059824768058414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_1059824771391747_7042719105495369902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlb6xfunVXUQ7kNvwGX7dfu&_nc_oc=Admo9y7hcEeicG32wppLNP21bjSq_0XVFhq911Q4dAnNl6N9wmv-fWczqxiE21cEynA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfztGRpMr8OAA-8GPzwHYYgTC6q2JiPZS8eo8sapF8ghAw&oe=69BE9133"}, "display_name": "Revinax Handbook", "keywords": [], "long_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster.\n\nLearners can memorize and reproduce complex gestures. The unique Revinax content creation method is based on 3D HD recordings of real situations. Users can observe each situation, procedure and gestures from the point of view of different protagonists. Students can review each detail as many times as necessary through the eyes of the expert.\n\nMore information: revinax.net/en\n\nContact us at: hello@revinax.net\n", "short_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handbook.revinax.net/terms", "developer_terms_of_service_url": "https://handbook.revinax.net/terms-of-use/", "publisher_name": "Revinax", "support_website_url": null, "website_url": "https://www.revinax.net/", "category": "APPS", "comfort_rating":
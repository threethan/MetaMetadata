71-25/75303837_464146485735003_6134031607111459366_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMGF24xhGBcQ7kNvwEhqpTu&_nc_oc=AdprxDBfYgO16BMRubYHK6MlBGbc2krqwcvuINjZkT_gQQghEdj0NTauo8NlnLAnoyA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCM5adKJAbx3c2Q6kDr7DwJdmlef_BCwaIEyIicO0cig&oe=6AC7A5D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "1059824768058414", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974526_1059824771391747_7042719105495369902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeB68FLkw34Q7kNvwFtLp8b&_nc_oc=AdrlJKdF1IfVCr9zbsF5jcMKiwgSXOQZEHW3nhUNozlsCcPrzb2y2qKjnNg600GMn4Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPI2mhCFVfJbRjEEb-P74Zk3ZE31n9PSptaqm3QPCC__Q&oe=6AC7C6F3"}, "display_name": "Revinax Handbook", "keywords": [], "long_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster.\n\nLearners can memorize and reproduce complex gestures. The unique Revinax content creation method is based on 3D HD recordings of real situations. Users can observe each situation, procedure and gestures from the point of view of different protagonists. Students can review each detail as many times as necessary through the eyes of the expert.\n\nMore information: revinax.net/en\n\nContact us at: hello@revinax.net\n", "short_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handbook.revinax.net/terms", "developer_terms_of_service_url": "https://handbook.revinax.net/terms-of-use/", "publisher_name": "Revinax", "support_website_url": null, "website_url": "https://ww
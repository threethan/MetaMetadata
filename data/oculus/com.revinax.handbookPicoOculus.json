s. Students can review each detail as many times as necessary through the eyes of the expert.\n\nMore information: revinax.net/en\n\nContact us at: hello@revinax.net\n", "short_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://keyros-medica.com/personal-data", "developer_terms_of_service_url": "https://keyros-medica.com/terms-of-service", "publisher_name": "Revinax", "support_website_url": null, "website_url": "https://keyros-medica.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_AU", "fr", "en_GB", "fr_CA", "en_US", "en_CA", "fr_BE", "en_ZA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27238363742510650"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974681_399713605545960_4289530900982017745_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6Gnn70RkWUQ7kNvwE9WC7Q&_nc_oc=AdrdVtCZ5CxsNFIUYPggtGX4p3LZo4IwcfgaP2r8N5qAY_u3D9plvs_ni90FNIo1UHk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVvk-TeB-W2mWBTBZWrDJt8p6wAYaO6DCAhvhS1u6pOA&oe=6AFB4025"}, "is_concept":
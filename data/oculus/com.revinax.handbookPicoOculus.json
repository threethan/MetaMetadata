71-25/75303837_464146485735003_6134031607111459366_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5o4xlkchzboQ7kNvwGdXr35&_nc_oc=AdoroXOoJV_iXF2R4XhduMPOHKw5mcA7ShAj-HBLyuqfpHSC-_AzL2UfjrauwpkWxGg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj9zxwFloNr2aPJZSt-p2IpXfK3P6Ujxl8izK4f0bOqA&oe=6AB13C51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "1059824768058414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_1059824771391747_7042719105495369902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i70GUMxVUi4Q7kNvwEI-GEL&_nc_oc=AdpDrGr5eRy0_gIT-a7JIXJR80_7Jo0a4rAaTpVf0CFnDdEusAazjoRaKVpnpUiN4oM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdbqiyJ8ETaGxvLxfFAfLqQooH32bJWoePTT6RAskx7g&oe=6AB12533"}, "display_name": "Revinax Handbook", "keywords": [], "long_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster.\n\nLearners can memorize and reproduce complex gestures. The unique Revinax content creation method is based on 3D HD recordings of real situations. Users can observe each situation, procedure and gestures from the point of view of different protagonists. Students can review each detail as many times as necessary through the eyes of the expert.\n\nMore information: revinax.net/en\n\nContact us at: hello@revinax.net\n", "short_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handbook.revinax.net/terms", "developer_terms_of_service_url": "https://handbook.revinax.net/terms-of-use/", "publisher_name": "Revinax", "support_website_url": null, "website_url": "https://ww
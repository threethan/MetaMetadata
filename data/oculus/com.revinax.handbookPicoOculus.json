3b8W8oBcwQ7kNvwEehvPt&_nc_oc=AdoFdpnCEUPmj7OBwm0a3FiyXnFQIznYAqf2uMtb-hhFaJSLH38utTgshjlUpskE_zk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcv1HVd-aJ6k_icW1cgW3aIBYT9jJEMOMT4Q5R790hPw&oe=6A635E47"}, {"file_name": "S2.png", "id": "1495351002624857", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823837_1495351005958190_7626227457120787621_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iStqo2NU0w4Q7kNvwGfV63v&_nc_oc=AdrQULexS7l_doj5lemAxUTxN_9mP1SSxnZuK4z3VicLQCB3GCKbN0PBAofdRP38Uxs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJVlKJet0R8KT7jyOw7jscB4rssfXafahXAOV4LDXpuw&oe=6A636C6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "1059824768058414", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_1059824771391747_7042719105495369902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sDzDPkkSDEQ7kNvwGvScYi&_nc_oc=AdoT9xLT1VK2wdPmjX3yCBJoB2f_X8ROZMjorO432qShb9L8n76GJb0nWLHqS2ZjOCY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATUnCjkQEqoyYhB2ogLKk3ABV1PcJPhbtfC4XkqxhCVw&oe=6A635CB3"}, "display_name": "Keyros Medica (Ex Revinax)", "keywords": [], "long_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster.\n\nLearners can memorize and reproduce complex gestures. The unique Revinax content creation method is based on 3D HD recordings of real situations. Users can observe each situation, procedure and gestures from the point of view of different protagonists. Students can review each detail as many times as necessary through the eyes of the expert.\n\nMore information: revinax.net/en\n\nContact us at: hello@revinax.net\n", "short_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://keyros-medica.com/personal-data", "developer_terms_of_service_url": "https://keyros-medica.com/terms-of-service", "publisher_name": "Revinax", "support_website_url": null, "website_url": "https://keyros-medica.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_AU", "fr", "en_GB", "fr_CA", "en_US", "en_CA", "fr_BE", "en_ZA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27238363742510650"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974681_399713605545960_4289530900982017745_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHBauRXK_4oQ7kNvwGR3Xpu&_nc_oc=AdqLZSsSYiZPuJrm3hpSh9NP6YaP-15GIySS8k3vGkoXDelRP6vBTfQQX-eKeUlJOdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFWgYIaVQ-WbojVTSlWGwYvo2P-mr5SQAtn5RJAcv1Lw&oe=6A636B65"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Keyros Medica (Ex Revinax)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"
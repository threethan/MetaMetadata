d6r_5V87GZG6ihq5ZUgYCENUKL_s0-Vx0Ej9zOsRgNxA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuIWP9WloLIjBPMF1BddxnNJKw3N0su1MsIXt5CRdK9cA&oe=69A1A751"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "1059824768058414", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974526_1059824771391747_7042719105495369902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9wUUlxR8SkQ7kNvwEEUx_P&_nc_oc=Adl6cfE2Lw71pDF-2EMcp0O6al8Rf3hHdjDU2TPUk9kBqsgdElqqPYyLNnfCjIFZS-Y&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft99bp_Q36Uy0rJ_fJtcpEZ4TKRJTGvBhQkJiiEjtW1vA&oe=69A19033"}, "display_name": "Revinax Handbook", "keywords": [], "long_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster.\n\nLearners can memorize and reproduce complex gestures. The unique Revinax content creation method is based on 3D HD recordings of real situations. Users can observe each situation, procedure and gestures from the point of view of different protagonists. Students can review each detail as many times as necessary through the eyes of the expert.\n\nMore information: revinax.net/en\n\nContact us at: hello@revinax.net\n", "short_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handbook.revinax.net/terms", "developer_terms_of_service_url": "https://handbook.revinax.net/terms-of-use/", "publisher_name": "Revinax", "support_website_url": null, "website_url": "https://www.revinax.net/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics":
lOUpV20eXKXudHfO2cxxt9ayeAu57r9Tdq4DVY1o9fVg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvj20EXh-Qb1uGY3i1YcLWbJLT64V_zRzN_BPnCpKlOIA&oe=699C6151"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "1059824768058414", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_1059824771391747_7042719105495369902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vxmq-jKAuuUQ7kNvwHmKBqD&_nc_oc=AdmWAgGGP2aRvJpASTX94YxTqZmxWW8WiLSFYXPWcJ1o5zyJRogYZE5XcKJMYNS0crg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuW-YeyeyCfUFfeoygbyvqL_XOIDSamiQEBtw1NIo4SxQ&oe=699C4A33"}, "display_name": "Revinax Handbook", "keywords": [], "long_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster.\n\nLearners can memorize and reproduce complex gestures. The unique Revinax content creation method is based on 3D HD recordings of real situations. Users can observe each situation, procedure and gestures from the point of view of different protagonists. Students can review each detail as many times as necessary through the eyes of the expert.\n\nMore information: revinax.net/en\n\nContact us at: hello@revinax.net\n", "short_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handbook.revinax.net/terms", "developer_terms_of_service_url": "https://handbook.revinax.net/terms-of-use/", "publisher_name": "Revinax", "support_website_url": null, "website_url": "https://www.revinax.net/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics":
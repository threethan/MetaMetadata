au6Gpw_zYQ7kNvwEmJj-P&_nc_oc=Ado4CZci74hlEMTGu6uErju1BPKkkB70hR_HAmmoZYyITtMQT_Qh4hZRoOACAmxpOaE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxqqbC_0_F1FBzcryGl9S6Nl9A4F4WTSKCLOyRemdwJg&oe=6A9D6047"}, {"file_name": "S2.png", "id": "1495351002624857", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823837_1495351005958190_7626227457120787621_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogf1gconp2QQ7kNvwFX3V6K&_nc_oc=AdoFrD2SzAj5ehf05sBkVPSza7PL6FVNH6DgJG-TL5GMyrzoILMS_sSV4RZsTmxi0eY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv8OnrxpDfPwHzhdJ8RVnJFnB-lUwZQCnYjhuIIg4mlw&oe=6A9D6E6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "1059824768058414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_1059824771391747_7042719105495369902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2oPe9xgWS8Q7kNvwGJJbEU&_nc_oc=AdoBn7T0ERCSU1RoBbg4OzqlodLjcJh7VMKJ6RV-BHbNnm2Q6qv8-bmr8aT23zeJQrI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOVeAlj_0PSimJ0oeZn9Bn1wb7pNzsHehFQFpn6OyFoA&oe=6A9D5EB3"}, "display_name": "Keyros Medica (Ex Revinax)", "keywords": [], "long_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster.\n\nLearners can memorize and reproduce complex gestures. The unique Revinax content creation method is based on 3D HD recordings of real situations. Users can observe each situation, procedure and gestures from the point of view of different protagonists. Students can review each detail as many times as necessary through the eyes of the expert.\n\nMore information: revinax.net/en\n\nContact us at: hello@revinax.net\n", "short_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://keyros-medica.com/personal-data", "developer_terms_of_service_url": "https://keyros-medica.com/terms-of-service", "publisher_name": "Revinax", "support_website_url": null, "website_url": "https://keyros-medica.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_AU", "fr", "en_GB", "fr_CA", "en_US", "en_CA", "fr_BE", "en_ZA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27238363742510650"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974681_399713605545960_4289530900982017745_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5B9GhoWhxgAQ7kNvwG_bx5s&_nc_oc=Adr4i4_zH2pNnhmdZHxIXl7wCTHJsKQXZ6iu__b1hcQ7QzvMKDAqhrssveq7Fwm4k1I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJm8U6z2cc_tk9Fnz0bCfHv05RGp06HwZ0y4NzT200gWA&oe=6A9D6D65"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Keyros Medica (Ex Revinax)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"
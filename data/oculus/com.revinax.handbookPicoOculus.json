_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcYRYVWD4U0Q7kNvwG0zTzD&_nc_oc=AdrcCSs2INL58vwyXRM_Knz-V71Cfr2SPxXiCACeryAQPcXBVaNcAl7ohMbRRZxYaWk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af239L8klyhCR91V21zVlS9itVSeTictd9HPvAwi_Tlxfg&oe=69F212D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "1059824768058414", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974526_1059824771391747_7042719105495369902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSN0fqJHxCwQ7kNvwG2nQYf&_nc_oc=Adp_GfD3RSWprrqBX7WlHjGboZEFqs3_3oiBSi1JWPeyncTswS2SLX0mhACTGl0Q9-g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2e4qGc8kinQPNahqqoV_NgrARwOZ8uTBZxAXOA5ZXaNw&oe=69F1FBB3"}, "display_name": "Revinax Handbook", "keywords": [], "long_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster.\n\nLearners can memorize and reproduce complex gestures. The unique Revinax content creation method is based on 3D HD recordings of real situations. Users can observe each situation, procedure and gestures from the point of view of different protagonists. Students can review each detail as many times as necessary through the eyes of the expert.\n\nMore information: revinax.net/en\n\nContact us at: hello@revinax.net\n", "short_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handbook.revinax.net/terms", "developer_terms_of_service_url": "https://handbook.revinax.net/terms-of-use/", "publisher_name": "Revinax", "support_website_url": null, "website_url": "https://www.revinax.net/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort
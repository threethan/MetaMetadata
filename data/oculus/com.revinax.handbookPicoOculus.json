au6Gpw_zYQ7kNvwGWJLIm&_nc_oc=AdpsFwuiLmtBIgqh2WF47BXD2CWGF9LEVX8DHz07naSM2oXXsJ21m8BF27spksLPDDg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJT40tHOptLrgbkUYeeqVkHNtg9gfjeGJa8rCkEukH9w&oe=6A9C0EC7"}, {"file_name": "S2.png", "id": "1495351002624857", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823837_1495351005958190_7626227457120787621_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogf1gconp2QQ7kNvwHhl_T-&_nc_oc=AdoZ-aVnszIQosuK664u8mjw2nMnv7tQ_Owr_ly21hZmo5LV5X7RSFScr99EdTW4axU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN7ezbzSwOKUIkB7AJY-0oEseo_xwE9Uxi_xVvYlywbQ&oe=6A9C1CEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "1059824768058414", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974526_1059824771391747_7042719105495369902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2oPe9xgWS8Q7kNvwH0rvVR&_nc_oc=AdpgfOXyKZcZT1o166VxjtgHodqI2WisDoKUgprvKk18HeSZjkqN3TFQmcjpMia6eKw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxYY6JVFNngGN8JYujD09FtnJbuP9UHitpryont5EsSg&oe=6A9C0D33"}, "display_name": "Keyros Medica (Ex Revinax)", "keywords": [], "long_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster.\n\nLearners can memorize and reproduce complex gestures. The unique Revinax content creation method is based on 3D HD recordings of real situations. Users can observe each situation, procedure and gestures from the point of view of different protagonists. Students can review each detail as many times as necessary through the eyes of the expert.\n\nMore information: revinax.net/en\n\nContact us at: hello@revinax.net\n", "short_description": "Immersive virtual reality tutorials allow you to experience a real situation through the eyes of the one who experienced it. It has been proven that this approach helps to learn better and faster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://keyros-medica.com/personal-data", "developer_terms_of_service_url": "https://keyros-medica.com/terms-of-service", "publisher_name": "Revinax", "support_website_url": null, "website_url": "https://keyros-medica.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_AU", "fr", "en_GB", "fr_CA", "en_US", "en_CA", "fr_BE", "en_ZA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27238363742510650"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974681_399713605545960_4289530900982017745_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5B9GhoWhxgAQ7kNvwGpCsQi&_nc_oc=AdqgeWQvgCeCjIo8243YWp4Zwi5x0C8iDk97rRNDMjKP2R6W926Nip4eacEYr7sQy7M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0cgGOtXczOv685JY-tUueQFgM9-_onKxJEo92SB2-AA&oe=6A9C1BE5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Keyros Medica (Ex Revinax)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"
-1.oculuscdn.com/v/t64.5771-25/491827626_1399496192370382_5588247801369805953_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Ms3ogon_ZkQ7kNvwHrrc1t&_nc_oc=AdqHcaUxbqjAh9lriABAU0efg_93xWAa8ZJgpJ1NpgvNJpvjdUB0prt1hwk_cf-S-sg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ27iRJ4fGhTsKjmde_wXAqQeNsnue8yP_WzRFDlfIxXg&oe=6AF7350A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "va-lineup-16x9-dark 1.png", "id": "39781974628060319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593860406_39781974641393651_5568939992195671507_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XF_Ypzc5yE4Q7kNvwFT-trV&_nc_oc=Adqcc1B_LwhjkOlSk7m9waVEg2LVg1A4aBt-hID0L8arqaRaQafO7WNKFp6oUuO4uHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSThW9P319eBomSVRgmqJ0DTfrDCtVqHTYKxd3uK4rQxQ&oe=6AF71588"}, "display_name": "Vision Anatomy", "keywords": ["anatomy", "medical", "education", "humanbody", "mixedreality"], "long_description": "# Vision Anatomy: Anatomy You Can Step Inside\n\nVision Anatomy turns your Meta Quest into a life-size, fully interactive human anatomy lab. Explore **2,392 individually named parts** across **11 body systems** in mixed reality, right in your own room. Grab the body, peel it back layer by layer, and pull any structure into your hands to study it from every angle.\n\n## Activate Your **Free Trial**\n\n1. Email **contact@3dsurgical.com** for a free 1-month trial licence.\n2. We send your login details to your email.\n3. Sign in on the login screen and unlock every system and layer.\n\nAfter the trial, the skeletal system stays free and other layers lock.\n\n## **Licence Options**\n\n- **Monthly**, **Annual** or **Perpetual**\n- **Student:** Monthly or Annual\n- **Institutions:** multi-headset licences\n\nWe extend your existing login, no reinstall needed.\n\n## **Features**\n\n- Grab, rotate and reposition the model anywhere\n- Passthrough by default, stay in your real space\n- Show or hide systems, skin to bone\n- Scale and magnify structures\n- Tap-to-learn info panels\n- Hand and controller interaction\n\n## **11 Systems**\n\nSkeletal \u00b7 Connective \u00b7 Muscular \u00b7 Circulatory \u00b7 Lymphatic \u00b7 Nervous \u00b7 Cartilage \u00b7 Eyes \u00b7 Ears \u00b7 Organs \u00b7 Skin\n\n---\n\nBuilt for medical, nursing and allied health students, educators, universities, clinicians and patient education.\n\nPowered by **3D Surgical** with anatomy content by **Zygote Body**.", "short_description": "Vision Anatomy brings the human body into your room in mixed reality. Explore a fully interactive 3D anatomical model \u2014 grab it, rotate it, scale it up, and peel back layers from skin to skeleton. Select any structure to reveal detailed clinical information drawn from a comprehensive anatomy dataset. Designed for medical students, educators, and clinicians who want to study anatomy in true 3D, at any scale, right in front of them."}]}, "developer_name": "3d surgical", "developer_privacy_policy_url": "https://www.visionanatomy.com/privacy", "developer_terms_of_service_url": "https://www.visionanatomy.com/terms", "publisher_name": "3d surgical", "support_website_url": "https://www.visionanatomy.com/contact", "website_url": "https://visionanatomy.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1079254164918022"}, "review_mes
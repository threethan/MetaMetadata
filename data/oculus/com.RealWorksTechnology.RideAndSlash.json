zTxGZqAOJY7l5xWoAVUqHag5XGae_YG_PLdx3CYsqBJ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu7JNZvN7hfjtq1AXaDTaJjePKd-yZiL7BQbFyWF6A6Q&oe=6B05B4E1"}, {"file_name": "rasss3.png", "id": "415380047939219", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254868_415380051272552_4063168980256891441_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pn2uU3_Vcx0Q7kNvwG20Y2B&_nc_oc=AdprI4Wd1S31-35-KF_ejUBbcnijZqwEcPtxqkKvMOySacfeEMPRJ-f290qX8TjwCCE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-WHWiFNRerJZ2KFy-44KKrFbdC4ncUhGOV6TTgZQWmA&oe=6B05CA14"}, {"file_name": "rasss5.png", "id": "436166719018771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_436166722352104_492424978908504375_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANrXUy1t37IQ7kNvwFQ4veT&_nc_oc=AdozDiy78BkbJ-6CMIij27lW8cut0pP3kobzyfhvGsiRmXYOfoxFbkWoqgDw487Jp9U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUVsPSJO_kXK24ZzWWIHc1WBq7wC2OkDI5r3LbJDtjFw&oe=6B05B397"}, {"file_name": "rasss1.png", "id": "3705575456351905", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203615_3705575463018571_7728644717057500601_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCx_NAXXBJUQ7kNvwHba797&_nc_oc=Adq9Hyc8LFM5HfPucNGS_rkeWezfIcSMcHVKN3ulRKP1gKa-gmeCmV3ts1RqTnUJP1Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFkaY7I-A7GUZHaWBtxj6fneNxCYByM30Ip-RDibHuBA&oe=6B05D02B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt2560x1440.png", "id": "865913838628782", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75394636_865913841962115_4299115666124477588_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWiaT4n2U78Q7kNvwFtlRwb&_nc_oc=AdruC4C4BMDM66UQDzPhvg0MXorgASzPUiueUcyYoy34eUutYRgB2fv2yvdMU0QLcZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5KxcO-1_tf6geK_guBsQRYD6weIAAIQrVngSDYVDapA&oe=6B05BE31"}, "display_name": "Ride&Slash: Revenge Of Salur", "keywords": [], "long_description": "In this immersive Meta Quest game, step into the boots of Salur, a fearless rider traversing the infinite roads of the Middle East. With his loyal steed and a trusty sword, Salur faces waves of oncoming foes determined to stop him. Engage in intense combat where every slash and block counts. Use your sword to cut down enemies as they charge at you, while your shield guards against a barrage of arrows from distant archers.\n\nDesigned for VR, the game combines engaging melee combat with strategic defense, compelling players to master both swordsmanship and timing. The dynamic environments and culturally rich settings enhance the experience, providing a visually stunning backdrop to the action. With intuitive controls and a gripping storyline, this game is a must-play for fans of action and adventure. Dive into a world of ancient intrigue and modern gameplay mechanics as you fight to make every journey legendary.", "short_description": "Embark on an endless journey through the Middle Eastern landscapes as Salur, a valiant warrior on horseback. Defend against hordes of enemies with your sword and shield, slashing through attackers and blocking arrows to survive the relentless assault."}]}, "developer_name": "RealWorks Technology", "developer_privacy_policy_url": "https://realworkstechnology.com/privacy.pdf", "developer_terms_of_service_url": null, "publisher_name": "RealWorks Teknoloji A.\u015e.", "support_website_url": null, "website_url": "https://realworkstechnology.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
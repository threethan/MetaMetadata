JztoFEtyoEoFNBCPtmz8lTi4oFk0ef3cspDVZDj_2O2I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb0olrI-k01R4Zw1x923x4AaXz2l-xa0A1Ki4nCER25Q&oe=6AFB28E1"}, {"file_name": "rasss3.png", "id": "415380047939219", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75254868_415380051272552_4063168980256891441_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C92flGh4QEsQ7kNvwEvi-pI&_nc_oc=AdplQ2VS_Qw_teDCX4cUfxY3QUysIXsxdl_igDvCBIAhq4k1YEP8kEJyxY0cN7NR4KQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlEhXAHnolCvCh_vX1uYBYrL640Z9vWLHnXpeKK0hJWw&oe=6AFB3E14"}, {"file_name": "rasss5.png", "id": "436166719018771", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003282_436166722352104_492424978908504375_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zT3Ub9puyPcQ7kNvwErQiCQ&_nc_oc=Adpegi83CfkhWeOtl0aL7EDeWTi7O1CjM8_AIFc3vliZVJzcpOSKv1sAukh0txMwmZs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZRXvw2vWDr2MnLdQON00p5QEyulN_BxVkdjmi7gRN4A&oe=6AFB2797"}, {"file_name": "rasss1.png", "id": "3705575456351905", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203615_3705575463018571_7728644717057500601_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r24o3a2MdVcQ7kNvwEBzkL4&_nc_oc=AdqAHm-h0Hg3i7clISKthwLjTEHHLaC5op700H6LJ0JlCv9ftoXHVBtuoEQRcg7Hywg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2rRbskUpzArUPnc4Rdqav-sAMyr4H7q9vLz6TwXCmjQ&oe=6AFB442B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt2560x1440.png", "id": "865913838628782", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75394636_865913841962115_4299115666124477588_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_OM_vpua2AQ7kNvwHX7DyM&_nc_oc=AdpcqjxPKRNobr-zlzOufbHMRWAha87bR5jUKagLwpRiQZkEA3v7HIk10JRBVN4ueT4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0FnmeJ1fJYWq4PFWULzPR77w_UR-qT5dqhabSAfWweQ&oe=6AFB3231"}, "display_name": "Ride&Slash: Revenge Of Salur", "keywords": [], "long_description": "In this immersive Meta Quest game, step into the boots of Salur, a fearless rider traversing the infinite roads of the Middle East. With his loyal steed and a trusty sword, Salur faces waves of oncoming foes determined to stop him. Engage in intense combat where every slash and block counts. Use your sword to cut down enemies as they charge at you, while your shield guards against a barrage of arrows from distant archers.\n\nDesigned for VR, the game combines engaging melee combat with strategic defense, compelling players to master both swordsmanship and timing. The dynamic environments and culturally rich settings enhance the experience, providing a visually stunning backdrop to the action. With intuitive controls and a gripping storyline, this game is a must-play for fans of action and adventure. Dive into a world of ancient intrigue and modern gameplay mechanics as you fight to make every journey legendary.", "short_description": "Embark on an endless journey through the Middle Eastern landscapes as Salur, a valiant warrior on horseback. Defend against hordes of enemies with your sword and shield, slashing through attackers and blocking arrows to survive the relentless assault."}]}, "developer_name": "RealWorks Technology", "developer_privacy_policy_url": "https://realworkstechnology.com/privacy.pdf", "developer_terms_of_service_url": null, "publisher_name": "RealWorks Teknoloji A.\u015e.", "support_website_url": null, "website_url": "https://realworkstechnology.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
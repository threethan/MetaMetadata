6xRi1-uwpbJaxfIO80XPCn9zJjvukaDvrqxz3N4c0iBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhzTWr4n2bCZY877KxuKuDulV9tD7PFeIJTvXiTjYdwg&oe=6AFDCBE1"}, {"file_name": "rasss3.png", "id": "415380047939219", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254868_415380051272552_4063168980256891441_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vir9EbICJ4UQ7kNvwF2VTAW&_nc_oc=Adr3simgReyWQdw-yj4eHMBp7uhfsNLSBwGs03pzH7uy0fwURXl13nuDZsQIvxJv6KE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR542wz7_3ukkrOofEFL50lSmSSW1j9RSMvghHLWJevCA&oe=6AFDE114"}, {"file_name": "rasss5.png", "id": "436166719018771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003282_436166722352104_492424978908504375_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcqMpZXIlCsQ7kNvwFn3TH9&_nc_oc=AdpX8fyI4url0MQehg6BwRSXNYxw98Ybvtq8uaJO2EqiieP32t40KyDezq3B3CyR3r8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ4tlaVQ3BF8jI7Pd5XjqebP3Yo_NOjTPS4HYjFEEIMg&oe=6AFDCA97"}, {"file_name": "rasss1.png", "id": "3705575456351905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203615_3705575463018571_7728644717057500601_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r24o3a2MdVcQ7kNvwFY90j5&_nc_oc=AdpiVLrmKH_PaGRjGOoIHpfWO9YIp339X9qs91EcB7WREP0cXx4NGKEs6EcjL3DO004&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCV8Z8TcJjzE67vy0MoEynLrRGaTlNrYflBBwAiEHIgA&oe=6AFDAEEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt2560x1440.png", "id": "865913838628782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75394636_865913841962115_4299115666124477588_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CKSMJB0EOAQ7kNvwEIYSz5&_nc_oc=AdptLy6ALQX5ylFV_GBgIlQN-6mm8Nv6tWcsJdukLwAOJetHqSQwXytM_-agox1y-Jw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPUcmC6fnEnYCvs2DfmWwXhovGlwBWm4mUDcPOyD5O-w&oe=6AFDD531"}, "display_name": "Ride&Slash: Revenge Of Salur", "keywords": [], "long_description": "In this immersive Meta Quest game, step into the boots of Salur, a fearless rider traversing the infinite roads of the Middle East. With his loyal steed and a trusty sword, Salur faces waves of oncoming foes determined to stop him. Engage in intense combat where every slash and block counts. Use your sword to cut down enemies as they charge at you, while your shield guards against a barrage of arrows from distant archers.\n\nDesigned for VR, the game combines engaging melee combat with strategic defense, compelling players to master both swordsmanship and timing. The dynamic environments and culturally rich settings enhance the experience, providing a visually stunning backdrop to the action. With intuitive controls and a gripping storyline, this game is a must-play for fans of action and adventure. Dive into a world of ancient intrigue and modern gameplay mechanics as you fight to make every journey legendary.", "short_description": "Embark on an endless journey through the Middle Eastern landscapes as Salur, a valiant warrior on horseback. Defend against hordes of enemies with your sword and shield, slashing through attackers and blocking arrows to survive the relentless assault."}]}, "developer_name": "RealWorks Technology", "developer_privacy_policy_url": "https://realworkstechnology.com/privacy.pdf", "developer_terms_of_service_url": null, "publisher_name": "RealWorks Teknoloji A.\u015e.", "support_website_url": null, "website_url": "https://realworkstechnology.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
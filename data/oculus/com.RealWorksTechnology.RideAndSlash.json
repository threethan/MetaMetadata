6aQPI-4g8TcbXCIK9DIpeEVbQMeAW7-IQ0rltUkZ5V1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYWwmSj65ibSJfnLzTiirWut68V2p6Txw3pg_OLGRfpg&oe=6B0C84A1"}, {"file_name": "rasss3.png", "id": "415380047939219", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254868_415380051272552_4063168980256891441_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDn3bbgvRbgQ7kNvwH0HgCc&_nc_oc=AdrwZtoMmU4KywCEVfD9jBEnbRmGLLdtj1UAqwncKSkRkPR_kqHlOBzPIvXQp4yydOI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaLaPg6e7mFO_Mv1_bs-d3FPmUmwbWJJOMepOVmRd-dw&oe=6B0C6194"}, {"file_name": "rasss5.png", "id": "436166719018771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_436166722352104_492424978908504375_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yObpjIJoSkQ7kNvwGAA834&_nc_oc=AdoPbZlnu1ehhco3K54gRp2ZDLhK7FAwz0lmjuxnyhWfVaXoaQTuCai626zRb-Ozzmo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSueE9w6TGBHyajcJioKR1DxPc5g3HhaHqPFsOswppUHQ&oe=6B0C8357"}, {"file_name": "rasss1.png", "id": "3705575456351905", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203615_3705575463018571_7728644717057500601_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vn2kTnd5cwYQ7kNvwFUJCo_&_nc_oc=AdqZOHCVqod5K1n7BxECdqKGQqg8wg9RxpkOBEsFpmej2Bhro-P9Ll-g64NNRX4FYYQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoWv1qWC1Op3JHvVS4jgwCvbEk4mGd3VUyIMzngvpNTQ&oe=6B0C67AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt2560x1440.png", "id": "865913838628782", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75394636_865913841962115_4299115666124477588_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-E19ZClMHiUQ7kNvwEY9UjB&_nc_oc=Adp_3014Vst_AMSeAuQEatD_UtRpbizEG36qSGtOnHaCZyGUYnIgBu7bg0QstOvUQtk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRjJNMFNjETmSXkI8CJRakCOnjayH_GleH9kGXZc0n9jw&oe=6B0C55B1"}, "display_name": "Ride&Slash: Revenge Of Salur", "keywords": [], "long_description": "In this immersive Meta Quest game, step into the boots of Salur, a fearless rider traversing the infinite roads of the Middle East. With his loyal steed and a trusty sword, Salur faces waves of oncoming foes determined to stop him. Engage in intense combat where every slash and block counts. Use your sword to cut down enemies as they charge at you, while your shield guards against a barrage of arrows from distant archers.\n\nDesigned for VR, the game combines engaging melee combat with strategic defense, compelling players to master both swordsmanship and timing. The dynamic environments and culturally rich settings enhance the experience, providing a visually stunning backdrop to the action. With intuitive controls and a gripping storyline, this game is a must-play for fans of action and adventure. Dive into a world of ancient intrigue and modern gameplay mechanics as you fight to make every journey legendary.", "short_description": "Embark on an endless journey through the Middle Eastern landscapes as Salur, a valiant warrior on horseback. Defend against hordes of enemies with your sword and shield, slashing through attackers and blocking arrows to survive the relentless assault."}]}, "developer_name": "RealWorks Technology", "developer_privacy_policy_url": "https://realworkstechnology.com/privacy.pdf", "developer_terms_of_service_url": null, "publisher_name": "RealWorks Teknoloji A.\u015e.", "support_website_url": null, "website_url": "https://realworkstechnology.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
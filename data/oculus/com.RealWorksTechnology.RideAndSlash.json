zoM7UOFNY6d1WwLziq279JKGKzUgEaddcqle4AQ1Rrco&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq9dchPWvfPcI9hP_nHqWtOndrXPD8UBoR6MjR3N_Fzg&oe=6B0311E1"}, {"file_name": "rasss3.png", "id": "415380047939219", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254868_415380051272552_4063168980256891441_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhoR-7NYjTcQ7kNvwHqBnvB&_nc_oc=Ado4MrizUm8J83r3bB-bm5EptMxar6O3_fAGJ631Y4pX4CvP1HchlEexucAW-O7C6-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7Eubywi91JtDS_2rifknA3SVHAdRLGmNlEJAps5hMLg&oe=6B032714"}, {"file_name": "rasss5.png", "id": "436166719018771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_436166722352104_492424978908504375_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLhpEnQKuugQ7kNvwFF8TlT&_nc_oc=AdrovrbwD8Q_q9KELKZrfbFD5XVmzYJAliGvUNstNODkIhcWdCO0XjY85oRBmqITO8E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4x_A-G_HHmzcRsj8YtobdoSJ_8lSB4ZXO0RNadAQ9-w&oe=6B031097"}, {"file_name": "rasss1.png", "id": "3705575456351905", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75203615_3705575463018571_7728644717057500601_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCx_NAXXBJUQ7kNvwFNtTfC&_nc_oc=AdqcFRztDmccNO2fH6dZtNLC2T0-zWAPTqaOm3drMm4oVrr3Pt6ImfKiFah-hhMpg28&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsL13YzwtjsiydAj60tEb0rW8uexI-pBfmpNKYlAUPCA&oe=6B032D2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt2560x1440.png", "id": "865913838628782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75394636_865913841962115_4299115666124477588_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMKeiip4enwQ7kNvwFdsibD&_nc_oc=AdrYgvXiKOlz6xZ7NWY7It50JJ4uTbPb18PBkvAi4NETe8PbSJ-MUpETWi1g0h0bO5g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu4HiAejZOFQaOdoRekDG5nUCVRDH-l-27KlKZP73FcQ&oe=6B031B31"}, "display_name": "Ride&Slash: Revenge Of Salur", "keywords": [], "long_description": "In this immersive Meta Quest game, step into the boots of Salur, a fearless rider traversing the infinite roads of the Middle East. With his loyal steed and a trusty sword, Salur faces waves of oncoming foes determined to stop him. Engage in intense combat where every slash and block counts. Use your sword to cut down enemies as they charge at you, while your shield guards against a barrage of arrows from distant archers.\n\nDesigned for VR, the game combines engaging melee combat with strategic defense, compelling players to master both swordsmanship and timing. The dynamic environments and culturally rich settings enhance the experience, providing a visually stunning backdrop to the action. With intuitive controls and a gripping storyline, this game is a must-play for fans of action and adventure. Dive into a world of ancient intrigue and modern gameplay mechanics as you fight to make every journey legendary.", "short_description": "Embark on an endless journey through the Middle Eastern landscapes as Salur, a valiant warrior on horseback. Defend against hordes of enemies with your sword and shield, slashing through attackers and blocking arrows to survive the relentless assault."}]}, "developer_name": "RealWorks Technology", "developer_privacy_policy_url": "https://realworkstechnology.com/privacy.pdf", "developer_terms_of_service_url": null, "publisher_name": "RealWorks Teknoloji A.\u015e.", "support_website_url": null, "website_url": "https://realworkstechnology.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSyVj98HamrAPxj0iIMPsu4HjLO1kaZft4HHcZ_v9SKUQ&oe=6B0DCD4B"}, {"file_name": "Bas\u0327l\u0131ks\u0131z-3.png", "id": "1106951777048063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75476594_1106951780381396_800040314572054554_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UStm8k9ovvQQ7kNvwFUPQDU&_nc_oc=AdpZWAmFYaGVoRqwiGx5p2W8UfIJUrFgZSNqPUjQdK-xW_28OK5Gvs4mWhIUzWJNdfk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqS__3yZ8KB7MMnOUw8lJADAF-S2bVMrA8BB5MVy88eg&oe=6B0DC67A"}, {"file_name": "Bas\u0327l\u0131ks\u0131z-4.png", "id": "470128315497076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974566_470128318830409_8353128994454621313_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpPQTpT11CQQ7kNvwFQlkEd&_nc_oc=Adp6eeOEGEuQU-KUxJNj9Yi5Oq2KMjVAtszjrh8hMXxInUCnRAYIlE3-FbHKrvmtP9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTY6n1VhTjTt63RW0POlC1wb5Ug2uJeY8mCAEe0yU2LxA&oe=6B0DC4EF"}, {"file_name": "Bas\u0327l\u0131ks\u0131z-1.png", "id": "1065800595213183", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003283_1065800601879849_4376497102901880768_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4mJkuGHVQUQ7kNvwFOA194&_nc_oc=Adrzjm4wn9hkMMh9R88_oSoescNPQNa1PnwweH2zeR0g074F6WndZeSEnofqrepclUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTQ22A9heMdkA-JEd7G5cDorsQLkqa8hMP-WEDGKYZ3Ow&oe=6B0DB7AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt2560x1440.png", "id": "865913838628782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75394636_865913841962115_4299115666124477588_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUeYoGS2-xkQ7kNvwFzNcMA&_nc_oc=AdoUGHbL2UiDE99B9w-xbnQaRxlafTPPUg5oXtEm5dKkwUbUX1sFqwUsGwLUEHA6oFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqA88NTFFgCYKQWk4HC-lziUDOGH4CY8nB1epwdB5GlQ&oe=6B0DA731"}, "display_name": "Ride&Slash: Revenge Of Salur", "keywords": [], "long_description": "In this immersive Meta Quest game, step into the boots of Salur, a fearless rider traversing the infinite roads of the Middle East. With his loyal steed and a trusty sword, Salur faces waves of oncoming foes determined to stop him. Engage in intense combat where every slash and block counts. Use your sword to cut down enemies as they charge at you, while your shield guards against a barrage of arrows from distant archers.\n\nDesigned for VR, the game combines engaging melee combat with strategic defense, compelling players to master both swordsmanship and timing. The dynamic environments and culturally rich settings enhance the experience, providing a visually stunning backdrop to the action. With intuitive controls and a gripping storyline, this game is a must-play for fans of action and adventure. Dive into a world of ancient intrigue and modern gameplay mechanics as you fight to make every journey legendary.", "short_description": "Embark on an endless journey through the Middle Eastern landscapes as Salur, a valiant warrior on horseback. Defend against hordes of enemies with your sword and shield, slashing through attackers and blocking arrows to survive the relentless assault."}]}, "developer_name": "RealWorks Technology", "developer_privacy_policy_url": "https://realworkstechnology.com/privacy.pdf", "developer_terms_of_service_url": null, "publisher_name": "RealWorks Teknoloji A.\u015e.", "support_website_url": null, "website_url": "https://realworkstechnology.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED",
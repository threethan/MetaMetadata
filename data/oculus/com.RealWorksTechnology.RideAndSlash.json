nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR3sIq-lPhJI4z203I8239QcaeWOM9ty5csyfb5SqdKA&oe=6AFC718B"}, {"file_name": "Bas\u0327l\u0131ks\u0131z-3.png", "id": "1106951777048063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476594_1106951780381396_800040314572054554_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJFnF18bDiwQ7kNvwG8nxfX&_nc_oc=AdpyxjZxo_KV87C5w75lxRahs0T4et8bR3DXSr64AsfCvVm2DLzdnD59PrWU7JFyM5c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJTt9I0hdffvJkJi7-aX2NghXooY_m7AxtcaoVtGO4Eg&oe=6AFC6ABA"}, {"file_name": "Bas\u0327l\u0131ks\u0131z-4.png", "id": "470128315497076", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974566_470128318830409_8353128994454621313_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9vVck-_tVUQ7kNvwHzUzSz&_nc_oc=AdrLIKU62dxjPAdppMliPcCcHq5dF-J-jtKUCoS_hMs5F6RVBfA0LfrHtAn50QHZrOc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYtNsZbM142Lhik9nryVdEDybUdSRR51RgpcWhBxlrNA&oe=6AFC692F"}, {"file_name": "Bas\u0327l\u0131ks\u0131z-1.png", "id": "1065800595213183", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003283_1065800601879849_4376497102901880768_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jv0JL8tQuqIQ7kNvwGUQW4j&_nc_oc=AdrCFsjQVEQzMa6iQn7AzCy8yVMhC08YHd3xbaKJZ2ukMo4CnL0YO0QfmmF8kQYyXFY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzj-Wd4IO7Ajzq8n6xMysEyFxqXXGDHov06TZN9algMA&oe=6AFC942A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt2560x1440.png", "id": "865913838628782", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75394636_865913841962115_4299115666124477588_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_OM_vpua2AQ7kNvwEQ5-bA&_nc_oc=AdqarZMtUIduk6QR5IsggGdI5Y3FGs1XKTKam23gOuqxY2DP29VztwC1WZV0P3bN-Qk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzZSxm8iDtMxTpX6eNJ4_3b7cHHM0BwOmHVTrz5TYGfw&oe=6AFC83B1"}, "display_name": "Ride&Slash: Revenge Of Salur", "keywords": [], "long_description": "In this immersive Meta Quest game, step into the boots of Salur, a fearless rider traversing the infinite roads of the Middle East. With his loyal steed and a trusty sword, Salur faces waves of oncoming foes determined to stop him. Engage in intense combat where every slash and block counts. Use your sword to cut down enemies as they charge at you, while your shield guards against a barrage of arrows from distant archers.\n\nDesigned for VR, the game combines engaging melee combat with strategic defense, compelling players to master both swordsmanship and timing. The dynamic environments and culturally rich settings enhance the experience, providing a visually stunning backdrop to the action. With intuitive controls and a gripping storyline, this game is a must-play for fans of action and adventure. Dive into a world of ancient intrigue and modern gameplay mechanics as you fight to make every journey legendary.", "short_description": "Embark on an endless journey through the Middle Eastern landscapes as Salur, a valiant warrior on horseback. Defend against hordes of enemies with your sword and shield, slashing through attackers and blocking arrows to survive the relentless assault."}]}, "developer_name": "RealWorks Technology", "developer_privacy_policy_url": "https://realworkstechnology.com/privacy.pdf", "developer_terms_of_service_url": null, "publisher_name": "RealWorks Teknoloji A.\u015e.", "support_website_url": null, "website_url": "https://realworkstechnology.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED",
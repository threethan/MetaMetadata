x1TSyV9b7YjTdzxNikf0Bj8kYdR5msFtPMerJ0WXpZv8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWvpo0FYBgJgPZawsbdxjbxdHhNEozE9aYPGeJqsjbtQ&oe=6B0857E1"}, {"file_name": "rasss3.png", "id": "415380047939219", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75254868_415380051272552_4063168980256891441_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pn2uU3_Vcx0Q7kNvwESBRcJ&_nc_oc=Adq7_Lkr57vYKJBY2_4SqapRt1_ceDPDH7EU00LDG_PVzCVDiSdwPhv_vaj2K8IKbu0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH_WtBM1xSq-SfpSfe4BQm5r1ZrUltUDQMSgSsQk7-Qg&oe=6B086D14"}, {"file_name": "rasss5.png", "id": "436166719018771", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003282_436166722352104_492424978908504375_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXLY8OsRTnEQ7kNvwGafHFH&_nc_oc=AdrUKJWi6DNXEJSProBT9UES_eJKlms4T2EDeNloBAWkZywcV9_bJUP48LSS8Q25ejw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1HRDnht9vlyhqrJv6FRn93iAeU73vRlU3olxzimZJwQ&oe=6B085697"}, {"file_name": "rasss1.png", "id": "3705575456351905", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75203615_3705575463018571_7728644717057500601_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXKo6O09L9MQ7kNvwFppSGK&_nc_oc=AdpPj0jTk0z6x4XXGrEAA9Iro3ULQ1HkSLZwLuvQnWyytRZSTLIW_Jlwhl2n9OaFsZ8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs2qy_Dx6zrkr8RrkSNefmYP2k8MAOaMltB4Z3yItOeg&oe=6B08732B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt2560x1440.png", "id": "865913838628782", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75394636_865913841962115_4299115666124477588_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWiaT4n2U78Q7kNvwEHNF-A&_nc_oc=AdqgEI0OSRuXl31GMqwb2OewrWxq85zQInq5RDc43Y_VKqGbWZlaIz3Z2Ui8bzdWA44&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMtXQQcEe_G0ChS4whDjt7WlO2BGwG3wYLlBoyf7B7kw&oe=6B086131"}, "display_name": "Ride&Slash: Revenge Of Salur", "keywords": [], "long_description": "In this immersive Meta Quest game, step into the boots of Salur, a fearless rider traversing the infinite roads of the Middle East. With his loyal steed and a trusty sword, Salur faces waves of oncoming foes determined to stop him. Engage in intense combat where every slash and block counts. Use your sword to cut down enemies as they charge at you, while your shield guards against a barrage of arrows from distant archers.\n\nDesigned for VR, the game combines engaging melee combat with strategic defense, compelling players to master both swordsmanship and timing. The dynamic environments and culturally rich settings enhance the experience, providing a visually stunning backdrop to the action. With intuitive controls and a gripping storyline, this game is a must-play for fans of action and adventure. Dive into a world of ancient intrigue and modern gameplay mechanics as you fight to make every journey legendary.", "short_description": "Embark on an endless journey through the Middle Eastern landscapes as Salur, a valiant warrior on horseback. Defend against hordes of enemies with your sword and shield, slashing through attackers and blocking arrows to survive the relentless assault."}]}, "developer_name": "RealWorks Technology", "developer_privacy_policy_url": "https://realworkstechnology.com/privacy.pdf", "developer_terms_of_service_url": null, "publisher_name": "RealWorks Teknoloji A.\u015e.", "support_website_url": null, "website_url": "https://realworkstechnology.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
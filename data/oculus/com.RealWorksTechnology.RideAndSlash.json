xZMIBTewD3Y5d149WHTlVJGzksUluNpqwwu3SgBBNMgw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnfoWyZY3F9A21SsaRn48KNX2ODT-ImKK673yI7zwRqQ&oe=6AFC7A61"}, {"file_name": "rasss3.png", "id": "415380047939219", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75254868_415380051272552_4063168980256891441_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C92flGh4QEsQ7kNvwGE0564&_nc_oc=Adr5EDTNgLjgswYHk-HDaILSlO4IM4khtQrLP3fuHLMmgrmz867_epUCO8wkMu8Or5o&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnrxclEjKNruO8dj-UUIgurFy4YPkiZ_MimtRmyutUeg&oe=6AFC8F94"}, {"file_name": "rasss5.png", "id": "436166719018771", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39003282_436166722352104_492424978908504375_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcqMpZXIlCsQ7kNvwHjNAsh&_nc_oc=AdpLOg9vRDuLtVScHc16bCRjJuoKWdr7v8wlJQVV33Du9YAGLhh-VYz3KDJ4O-y8aiM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCDHf2CXLe3IOpnl3IBYK9iIMRr4C3WyHOg908J5lMOQ&oe=6AFC7917"}, {"file_name": "rasss1.png", "id": "3705575456351905", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75203615_3705575463018571_7728644717057500601_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r24o3a2MdVcQ7kNvwGLTVhF&_nc_oc=Adoy4PBFNYN1jCfXds9pPLA1_DozDM3p1VGI0-2uZdo-ZvYPVna8lXNqi5qc4U6lZyY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFLmhltRsxX8iDCDS5tKRlppHMwc__5FeK0MGWYa_jgA&oe=6AFC95AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt2560x1440.png", "id": "865913838628782", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75394636_865913841962115_4299115666124477588_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_OM_vpua2AQ7kNvwEQ5-bA&_nc_oc=AdqarZMtUIduk6QR5IsggGdI5Y3FGs1XKTKam23gOuqxY2DP29VztwC1WZV0P3bN-Qk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzZSxm8iDtMxTpX6eNJ4_3b7cHHM0BwOmHVTrz5TYGfw&oe=6AFC83B1"}, "display_name": "Ride&Slash: Revenge Of Salur", "keywords": [], "long_description": "In this immersive Meta Quest game, step into the boots of Salur, a fearless rider traversing the infinite roads of the Middle East. With his loyal steed and a trusty sword, Salur faces waves of oncoming foes determined to stop him. Engage in intense combat where every slash and block counts. Use your sword to cut down enemies as they charge at you, while your shield guards against a barrage of arrows from distant archers.\n\nDesigned for VR, the game combines engaging melee combat with strategic defense, compelling players to master both swordsmanship and timing. The dynamic environments and culturally rich settings enhance the experience, providing a visually stunning backdrop to the action. With intuitive controls and a gripping storyline, this game is a must-play for fans of action and adventure. Dive into a world of ancient intrigue and modern gameplay mechanics as you fight to make every journey legendary.", "short_description": "Embark on an endless journey through the Middle Eastern landscapes as Salur, a valiant warrior on horseback. Defend against hordes of enemies with your sword and shield, slashing through attackers and blocking arrows to survive the relentless assault."}]}, "developer_name": "RealWorks Technology", "developer_privacy_policy_url": "https://realworkstechnology.com/privacy.pdf", "developer_terms_of_service_url": null, "publisher_name": "RealWorks Teknoloji A.\u015e.", "support_website_url": null, "website_url": "https://realworkstechnology.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
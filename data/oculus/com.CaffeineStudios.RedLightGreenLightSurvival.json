sid=6e7a0a&_nc_ohc=JFKgqWDdK0wQ7kNvwErJUCE&_nc_oc=Ado5uVm1DLeZnaplC929awNhxVPf9aZODRFXA3raTKsX8wG66dqpyDToMyki2SL8lUk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWMGNeytE-MPb4YA1SCZKsR654w5d-8eeBa2gqhsR0VGw&oe=6B10423E"}, {"file_name": "07-Screenshot-Watchful-Doll-2560x1440.png", "id": "1121765583861483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831964_1121765587194816_1534960522104758004_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIHoeBXJcDgQ7kNvwGDrm9i&_nc_oc=Adpye3Pn_hCdXvzirNgwTNZ0EOEu_CiEqS2KOMU7sDQiZ74dQ31ROEJ-xnS852oCuuc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUm94eAsNaMjCS4fBRXm_ftgNGQaEwNAG8f52gyDdvAWg&oe=6B104FD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03-Cover-Landscape-2560x1440.png", "id": "2931503913873628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830904_2931503917206961_545956777962720901_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjPxQg_kNt8Q7kNvwH3rUA5&_nc_oc=AdqITn0ezXEF_7MHvMEW0C8NbMK130jVFzqLqNKCMI4Pe0fiQGYrVe5XiS1kR7xdPZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXAw8HluvthEn12OXjGh_Ods17WdfQn9sM41m4KiXttiw&oe=6B105CF7"}, "display_name": "Red Light Green Light: Survival", "keywords": ["survival", "arcade", "action", "reflexes", "challenge"], "long_description": "Run on green. Freeze on red. Reach the finish before the doll catches you moving.\n\nRed Light Green Light: Survival is a single-player VR survival challenge where speed only matters if you know when to stop. Swing your arms with your controllers to run, then hold your head and hands still when the light turns red. This blend of arcade action, arm-swing running, and split-second decisions puts your reflexes and nerves to the test.\n\nChoose your challenge:\n\u2022 Hardcore: Race 10 AI opponents against the clock. A mistake ends your run.\n\u2022 Casual: Keep racing with respawns and no time limit. Every death and extra second affects your score.\n\u2022 Training: Practice solo, master the stop-and-go rhythm and chase your fastest finish.\n\nBuild a career through ten medal tiers, from Bronze to Mythic. Improve your personal bests, track lifetime statistics, and compare your average scores on separate weekly and all-time global leaderboards for Hardcore and Casual.\n\nEasy to understand and demanding to master, each attempt asks you to balance a faster finish against the risk of elimination. Make your next move count.\n\nPlay with tracked controllers. Internet access and an eligible Meta account are required for global leaderboards.", "short_description": "Run on green. Freeze on red.\n\nRed Light Green Light: Survival turns arm-swing running into a tense single-player VR survival challenge.\n\nTest your reflexes in arcade action against 10 AI opponents.\n\nBeat the clock in Hardcore, keep trying with Casual respawns, or chase your best time in Training.\n\nEarn competitive scores, climb ten medal tiers from Bronze to Mythic, and compare your performance on weekly and all-time global leaderboards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/red-light-green-light-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
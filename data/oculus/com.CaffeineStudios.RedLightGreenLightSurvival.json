XFLNG4800gZFh9GbO1pZdNi7tI70WJkOzqmHEk8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQup5bYJCYKtO_VE84jEdhLLzmIsXcTvyyHsJL5OlnhEA&oe=6AFC8952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03-Cover-Landscape-2560x1440.png", "id": "2931503913873628", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_2931503917206961_545956777962720901_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bigHFteoaoQQ7kNvwHdlwuM&_nc_oc=AdoARar5A6p9rwM3-Ubx7IZGjap34eX2_2wOOezJHSG9Rom_A9A9mqWIhUXM5d8dfBE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReZ7i9x6vdLF-BNVWKv9_BeCphLeG6Zp1c8-zcmPnHlA&oe=6AFC5E37"}, "display_name": "Red Light Green Light: Survival", "keywords": ["survival", "arcade", "action", "reflexes", "challenge"], "long_description": "Run on green. Freeze on red. Reach the finish before the doll catches you moving.\n\nRed Light Green Light: Survival is a single-player VR survival challenge where speed only matters if you know when to stop. Swing your arms with your controllers to run, then hold your head and hands still when the light turns red. This blend of arcade action, arm-swing running, and split-second decisions puts your reflexes and nerves to the test.\n\nChoose your challenge:\n\u2022 Hardcore: Race 10 AI opponents against the clock. A mistake ends your run.\n\u2022 Casual: Keep racing with respawns and no time limit. Every death and extra second affects your score.\n\u2022 Training: Practice solo, master the stop-and-go rhythm and chase your fastest finish.\n\nBuild a career through ten medal tiers, from Bronze to Mythic. Improve your personal bests, track lifetime statistics, and compare your average scores on separate weekly and all-time global leaderboards for Hardcore and Casual.\n\nEasy to understand and demanding to master, each attempt asks you to balance a faster finish against the risk of elimination. Make your next move count.\n\nPlay with tracked controllers. Internet access and an eligible Meta account are required for global leaderboards.", "short_description": "Run on green. Freeze on red.\n\nRed Light Green Light: Survival turns arm-swing running into a tense single-player VR survival challenge.\n\nTest your reflexes in arcade action against 10 AI opponents.\n\nBeat the clock in Hardcore, keep trying with Casual respawns, or chase your best time in Training.\n\nEarn competitive scores, climb ten medal tiers from Bronze to Mythic, and compare your performance on weekly and all-time global leaderboards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/red-light-green-light-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1389810410880901"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2122451048403459"}, {"status": "PUBLISHED", "id": "1608251144136608"}]}, "baseline_offer": {"id": "1608251144136608"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2122451048403459"}]}, "liveChannel": {"nodes": [{"la
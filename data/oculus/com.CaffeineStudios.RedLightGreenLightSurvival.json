IwPKsfsQ7kNvwFAAwlG&_nc_oc=Adp4S0yaTXSg8brPqt30yyiUqJajwqbek8jfS3xQY3ww3njbtwSa7mVidvM4OIGIdjA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmBzPt3HexWfyN6o0z-hYOc3Z9etty-pZmLGaGIxxG8g&oe=6AFC7A94"}, {"file_name": "09-Screenshot-Green-Light-2560x1440.png", "id": "1074949678661228", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/604360590_1074949685327894_4017209127207065233_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXMAxbzcyHEQ7kNvwHPNl0Y&_nc_oc=Adpfqnt5_mgLPUuiT4qpysf3dPgg_BdjNYoawFB_qAiYobfNsVon8s6gpTXKqEhsK5E&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfXvhW-RizKGLBWrkQKPFhtIIQj-pIBvEIzPdXZe_mQA&oe=6AFC898E"}, {"file_name": "10-Screenshot-Hardcore-Stakes-2560x1440.png", "id": "1590635025386412", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604375581_1590635028719745_5810221297362939691_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnQGEeYpnJAQ7kNvwFLquXg&_nc_oc=AdqI0nsug5tlcij8tBtQN1G8yw1OOd3dqwc66cVJ9ocmUtJQUebkzBfDiKsEM6dVAJc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQokNnYMetH4zxDEcxcdr_58eH4Ka7Vg39R2o645W_jGA&oe=6AFC7BBE"}, {"file_name": "07-Screenshot-Watchful-Doll-2560x1440.png", "id": "1121765583861483", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831964_1121765587194816_1534960522104758004_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68HxzkZ1QjAQ7kNvwHbRMIV&_nc_oc=Adq2EWp1SYRrVz2yqOOper_A1U2cXFLNG4800gZFh9GbO1pZdNi7tI70WJkOzqmHEk8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQup5bYJCYKtO_VE84jEdhLLzmIsXcTvyyHsJL5OlnhEA&oe=6AFC8952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03-Cover-Landscape-2560x1440.png", "id": "2931503913873628", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_2931503917206961_545956777962720901_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bigHFteoaoQQ7kNvwHdlwuM&_nc_oc=AdoARar5A6p9rwM3-Ubx7IZGjap34eX2_2wOOezJHSG9Rom_A9A9mqWIhUXM5d8dfBE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReZ7i9x6vdLF-BNVWKv9_BeCphLeG6Zp1c8-zcmPnHlA&oe=6AFC5E37"}, "display_name": "Red Light Green Light: Survival", "keywords": ["survival", "arcade", "action", "reflexes", "challenge"], "long_description": "Run on green. Freeze on red. Reach the finish before the doll catches you moving.\n\nRed Light Green Light: Survival is a single-player VR survival challenge where speed only matters if you know when to stop. Swing your arms with your controllers to run, then hold your head and hands still when the light turns red. This blend of arcade action, arm-swing running, and split-second decisions puts your reflexes and nerves to the test.\n\nChoose your challenge:\n\u2022 Hardcore: Race 10 AI opponents against the clock. A mistake ends your run.\n\u2022 Casual: Keep racing with respawns and no time limit. Every death and extra second affects your score.\n\u2022 Training: Practice solo, master the stop-and-go rhythm and chase your fastest finish.\n\nBuild a career through ten medal tiers, from Bronze to Mythic. Improve your personal bests, track lifetime statistics, and compare your average scores on separate weekly and all-time global leaderboards for Hardcore and Casual.\n\nEasy to understand and demanding to master, each attempt asks you to balance a faster finish against the risk of elimination. Make your next move count.\n\nPlay with tracked controllers. Internet access and an eligible Meta account are required for global leaderboards.", "short_description": "Run on green. Freeze on red.\n\nRed Light Green Light: Survival turns arm-swing running into a tense single-player VR survival challenge.\n\nTest your reflexes in arcade action against 10 AI opponents.\n\nBeat the clock in Hardcore, keep trying with Casual respawns, or chase your best time in Training.\n\nEarn competitive scores, climb ten meda
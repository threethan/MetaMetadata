5771-25/499618453_1194262399124988_2876604418119675559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jp39_KcwsMQ7kNvwHHsrFg&_nc_oc=Adpa7YUjdZbZrkR5i6U-omNgjJZSSKyiEpGHCOeRS_yyZJbL5M_Ynbb9NylldUs-RKg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kSShagiYl-bRiePeZa92n5YrfrlcXxG9O1Abr5Qz9hQ&oe=6A144421"}, {"file_name": "Untitl234234234ed.png", "id": "1578893173158330", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308522_1578893176491663_8452783552928471525_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcKNgWn4kqQQ7kNvwFxEGSE&_nc_oc=AdqHEnzC323RTMtr-dQZ2vIbrLCJ6WPfC7PdRkg5-YOe8fXxXmuWDjhpAJ74D0pLgkQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gNflc5h4WiciBvHcO28jnSqbxVs0tUV3T5iuiHwayxg&oe=6A144237"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium 2", "keywords": ["Tag", "Taggers"], "long_description": "Opium 2 drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opium 2 is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1MK_TCk75-Q6l
quarium", "nausicaa", "france", "fish", "3d"], "long_description": "The Nausica\u00e4 Centre National de la Mer Aquarium in France is the largest aquarium in Europe. It is located on the Boulogne sur Mer in the north-east of France. From Paris it takes about 1 hour by train. The video shows impressive underwater shots in 3D - ideal for the Meta Quest. You can use the controller buttons X, Y and A, B to switch the view from 3D to 2D. You are in a 3D environment and see the 3D video on a curved screen.", "short_description": "The Nausica\u00e4 Centre National de la Mer Aquarium in France is the largest aquarium in Europe. It is located on the Boulogne sur Mer in the north-east of France. From Paris it takes about 1 hour by train."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pocketkai.net/asp/meta-nausica.htm", "developer_terms_of_service_url": null, "publisher_name": "Pocketkai", "support_website_url": null, "website_url": "https://pocketkai.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9440092196052550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391794_590182390468139_8408949448276405368_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFfZI9cuZGUQ7kNvwEc1GJz&_nc_oc=Ado3PvvWHSEH691uakY8KepgCyurmWBXVqeMd
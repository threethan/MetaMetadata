25/38982659_348905824630210_4120830458585330501_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6xx7TXpCz4Q7kNvwHiJIKd&_nc_oc=AdqSpX6nk2A_-09F_xBSum9PJpadM0B_NLAsHGQ92Ztn70MpugUa-LZsgoHJ-5XmPBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYVSDO1lv3FZ8BRLEGg7xXDaHLVKZ7zmGsY1fiUN8DXw&oe=6B0C50DA"}, {"file_name": "screenshot5.png", "id": "244200138767530", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207243_244200142100863_5611657876494598870_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5slcwNJ2pIQ7kNvwFcSBc3&_nc_oc=AdrMC9oQhDCydjHMKrp0WFKAWWSJUzAnYUQi-LMdCOdrvRyoemMjdA46m0SbbuJ3BZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_H0fzaiIbBYXyYFmdf4V7mtqKCSgg5Y2X4LdaJv1BNQ&oe=6B0C5560"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "767034311945054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036610_767034315278387_2467300473194688590_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pni8rKCDLm8Q7kNvwE-Ie5A&_nc_oc=AdqpfZ7DdQVcmD9hxUCytV8rpleehpIBeO1twWplRqiF6yuV4pPwsc98OGB95O-Dgsc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRu1SEb1qgdRyxhcXjD8YyQPG4jTKc4_UvAZtGFy4YxmA&oe=6B0C5BC1"}, "display_name": "Smath!", "keywords": [], "long_description": "Smath! provides an First Person Action game to aid math education. While many kids find math to be boring and abstract to understand, they consider challenging puzzles in games to be interesting. This game aims to leverage this interest, by embedding math questions into the world environment, and encourage players to find questions to solve with a purpose, whether its to compete with other players, or to achieve a score in single player mode. ", "short_description": "Smath! is a Frist Person Action game embedded with primary school to high school math knowledge. This game is dedicated to provide a imme
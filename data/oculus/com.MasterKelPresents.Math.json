25/38982659_348905824630210_4120830458585330501_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qfVXM7_c3gQ7kNvwEsGDz-&_nc_oc=AdrPuvO4hQMg57p48KAQpwjN5gqEDGlnayPzBA3DhiVCvLO0N5FmKbLGNIRn5Q20gvk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1zuoYgDbgdP-5W29_XZdeHrJrRDsfI6FHfzIv-56lzQ&oe=6B085C5A"}, {"file_name": "screenshot5.png", "id": "244200138767530", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75207243_244200142100863_5611657876494598870_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TFvUTKUqOAQ7kNvwFzlWwl&_nc_oc=AdphtQnZhLGWt2GWzwIi8vA_JjNjfxL4BKQtzzt4qlFTG_0648mJ9yLyX8rwwZdEcY0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKpnvshzytzKXsu2m95eGGS0g5wdMK1yTxMR0Es6nNXA&oe=6B0860E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "767034311945054", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39036610_767034315278387_2467300473194688590_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5CulXBKgUgQ7kNvwEEcEJy&_nc_oc=Adrpy2-YKcd3hQ8B7y42CmnDFkXflvNeZg6IXwgGeGmfaYk-fXMOPPUwfQcuB7umhyM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIbAzzJh7tqhhtU4BWxikJt_DKAynj4hf7974YmLfk9A&oe=6B086741"}, "display_name": "Smath!", "keywords": [], "long_description": "Smath! provides an First Person Action game to aid math education. While many kids find math to be boring and abstract to understand, they consider challenging puzzles in games to be interesting. This game aims to leverage this interest, by embedding math questions into the world environment, and encourage players to find questions to solve with a purpose, whether its to compete with other players, or to achieve a score in single player mode. ", "short_description": "Smath! is a Frist Person Action game embedded with primary school to high school math knowledge. This game is dedicated to provide a imme
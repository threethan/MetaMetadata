 "Smath! provides a First Person Action game to aid math education. While many kids find math to be boring and abstract to understand, they consider challenging puzzles in games to be interesting. This game aims to leverage this interest, by embedding math questions into the world environment, and encourage players to find questions to solve with a purpose, whether its to compete with other players, or to achieve a score in single player mode. ", "short_description": "Smath! is a Frist Person Action game embedded with primary school to high school math knowledge. This game is dedicated to provide an immersive experience to learn math in a fun way. Put on your headset, Smash, and S your math!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://markelyu.me/projects/smath/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Master Kel Presents", "support_website_url": null, "website_url": "https://markelyu.me/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7775257845890453"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974788_1071676260819875_58751719503362254_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OOqXr_Rdw8Q7kNvwGMkpKk&_nc_oc=AdpfkVB54iORAIkyeB0yh2SkCWrnJ3F9MvetK9Bwadi0r6HWzFM
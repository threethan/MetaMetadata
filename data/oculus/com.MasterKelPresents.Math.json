25/38982659_348905824630210_4120830458585330501_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5H_UZ7831EQ7kNvwHfy5Cq&_nc_oc=AdoZMfeD1NBSQRTQDE-WhfROhCJuTY6OiwmFSO8dVmYGeSlW0-NlowCS19BE1PGBz6I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN2QBI_Hfv9KUi0KCuK1_ytqA_fsvuMyVSJ9BOsyYvqA&oe=6AFF21DA"}, {"file_name": "screenshot5.png", "id": "244200138767530", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75207243_244200142100863_5611657876494598870_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqIQx9ulJwEQ7kNvwGuIqWU&_nc_oc=Ado8bOJfb3XxOQU2LmmzZ9fJStIOi1uV5eiFGy26e2I9UVMee4E9FrfxDEZAWr63JYg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLcZ8o5BcBUpZP-1N6OXmMOignwVTRixZ0REUv1Ka9sg&oe=6AFF2660"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "767034311945054", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036610_767034315278387_2467300473194688590_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bZePdHjjfEQ7kNvwFMA94V&_nc_oc=AdquzDxtxj7a2pZMspbUPpS8yh-wKwuUcYLxln3w6hCJ_J1x6Obfm4R0BcfjS3pSEcM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScFJ2DcXM4sud2ecYuhqsv1F7wv2-PsN1DjzTjyUiGCA&oe=6AFF2CC1"}, "display_name": "Smath!", "keywords": [], "long_description": "Smath! provides an First Person Action game to aid math education. While many kids find math to be boring and abstract to understand, they consider challenging puzzles in games to be interesting. This game aims to leverage this interest, by embedding math questions into the world environment, and encourage players to find questions to solve with a purpose, whether its to compete with other players, or to achieve a score in single player mode. ", "short_description": "Smath! is a Frist Person Action game embedded with primary school to high school math knowledge. This game is dedicated to provide a immersive experience to learn math in a fun way. Put on your headset, Smash, and S your math!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://masterkelpresents.tech/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Master Kel Presents", "support_website_url": null, "website_url": "https://masterkelpresents.tech/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7084015315014713"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6977808752302037", "version": "0.1"}, "id": "1084825572558111", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6948078058608440", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6977808752302037"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1084825572558111"}]}, "change_log": "This is the initial build showcasing some ideas to make math fun.\nPlease try the game out, and let me know what you think!\nIf you have ideas on how to make the game b
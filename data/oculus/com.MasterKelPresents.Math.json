me embedded with primary school to high school math knowledge. This game is dedicated to provide an immersive experience to learn math in a fun way. Put on your headset, Smash, and S your math!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://markelyu.me/projects/smath/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Master Kel Presents", "support_website_url": null, "website_url": "https://markelyu.me/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7775257845890453"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974788_1071676260819875_58751719503362254_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4WhQWLPFxwQ7kNvwGLzaZN&_nc_oc=AdlNOfCbwtSSF0_uZChC1yhDrj80y0TRkA0LjVaTGXbtCAAHWmNNP6SC4TZNV3_K6bA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afssq1Fp9HKBKkvBPTXNFWGGOpywLno6-ADEOCxB835Oug&oe=69A6E173"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Smath!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1706901283, "lastRevision": {"nodes": [{"id": "694807809194
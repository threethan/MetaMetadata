25/38982659_348905824630210_4120830458585330501_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Z-xXNCxT_wQ7kNvwEs1IBm&_nc_oc=AdoUorCSVg4s2GmvTGdGqdWMg0FozFJ_bM_QOk24soDZLLKI3q3q-ApwdQ_aQ2vS9L8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo_DgFlMLixJpmEZkha8LEawBtRXfDkn1_p7zQ7ZIDYQ&oe=6AFB2D5A"}, {"file_name": "screenshot5.png", "id": "244200138767530", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75207243_244200142100863_5611657876494598870_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FiKN7ZgEYgQ7kNvwE9nWEC&_nc_oc=AdrmO_ZFzICF7j7Hw1atoOU7gYtrWdMudxmgmLAAmqIyFE1Eu51RR_BRCATTwHenp5Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0jYTaUkZwKZwr3FQF7LTSmJ-vKLyP2F-C3591k1Uphw&oe=6AFB31E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "767034311945054", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036610_767034315278387_2467300473194688590_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TqGbqvZ-EIQ7kNvwGW-u3q&_nc_oc=AdoqAeSqEJliWXqkHy3rTvLIyUR-SWwe2JpNU0Z5fI-LBTmW5n_2JNuZn6r-DjTwE54&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0XDLAAW2gDqPMXtZtdFVbMT_REYT1ZTimqvlcgqihAQ&oe=6AFB3841"}, "display_name": "Smath!", "keywords": [], "long_description": "Smath! provides an First Person Action game to aid math education. While many kids find math to be boring and abstract to understand, they consider challenging puzzles in games to be interesting. This game aims to leverage this interest, by embedding math questions into the world environment, and encourage players to find questions to solve with a purpose, whether its to compete with other players, or to achieve a score in single player mode. ", "short_description": "Smath! is a Frist Person Action game embedded with primary school to high school math knowledge. This game is dedicated to provide a imme
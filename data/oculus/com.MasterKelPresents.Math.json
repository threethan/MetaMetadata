AtNQmE22QDI6HCmVA&oe=69BFE320"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "767034311945054", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036610_767034315278387_2467300473194688590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toawrpvjObYQ7kNvwGR3Qz8&_nc_oc=AdleS-hhkVL9xTuVJ_jdGlOtaQiIOmTN7HlcS9M0XzGBAZQUFVd3x2kjpj6TUXfMpYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxouS1WYBnkLSip1URWqM86QnOvzGp-_tg8HzQ43JpxCA&oe=69BFE981"}, "display_name": "Smath!", "keywords": [], "long_description": "Smath! provides an First Person Action game to aid math education. While many kids find math to be boring and abstract to understand, they consider challenging puzzles in games to be interesting. This game aims to leverage this interest, by embedding math questions into the world environment, and encourage players to find questions to solve with a purpose, whether its to compete with other players, or to achieve a score in single player mode. ", "short_description": "Smath! is a Frist Person Action game embedded with primary school to high school math knowledge. This game is dedicated to provide a immersive experience to learn math in a fun way. Put on your headset, Smash, and S your math!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://masterkelpresents.tech/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Master Kel Presents", "support_website_url": null, "website_url": "https://masterkelpresents.tech/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor":
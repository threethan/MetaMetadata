&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftSrmrd4IeatzPuC1wvCXIoRiKBgc8i6QsTkqGf_VotlA&oe=699868BA"}, {"file_name": "screenshot4.png", "id": "348905821296877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982659_348905824630210_4120830458585330501_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Q08Qhk6vqQQ7kNvwGk7xBN&_nc_oc=Admd61mETPXP0S6tk4HrW4DdXnp3KwApJ5Nzt5fhqJDvfM_CCauHtM4KFzGFlRru6M8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsRvosI3kRgcMY-D0JeUcnpDJe2HLTwy2xwH9huZeXEJA&oe=6998519A"}, {"file_name": "screenshot5.png", "id": "244200138767530", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75207243_244200142100863_5611657876494598870_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4l4eOTw1n4Q7kNvwHq6TFf&_nc_oc=AdmlE1koNRrry2KZOr6bj9oQ5FImM8flaGJyEI945mkwbfE8_tES-NyntIgUrPnjH3w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvyHbpo-OBC-7vA-7v41bYEGMJq5UBk13VKukm-6Du7DA&oe=69985620"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "767034311945054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036610_767034315278387_2467300473194688590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DpsIjofe-IQ7kNvwEejgbC&_nc_oc=Admt0KkxjLTkA58PVJuBpMswQB6wrAQi2oiFQ4Lx5Dzfcist_3lHy01QL-lAgoKVREI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftW_dN0onW67quy-ZQQgogzX-gQ-xJ87Zb6ly5ZlzuyJQ&oe=69985C81"}, "display_name": "Smath!", "keywords": [], "long_description": "Smath! provides a First Person Action game to aid math education. While many kids find math to be boring and abstract to understand, they consider challenging puzzles in games to be interesting. This game aims to leverage this interest, by embedding math questions into the world environment, and encourage players to find questions to solve with a purpose, whether its to compete with other players, or to achieve a score in single player mode. ", "short_description": "Smath! is a Frist Person Action game embedded with primary school to high school math knowledge. This game is dedicated to provide an immersive experience to learn math in a fun way. Put on your headset, Smash, and S your math!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://markelyu.me/projects/smath/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Master Kel Presents", "support_website_url": null, "website_url": "https://markelyu.me/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7775257845890453"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_1071676260819875_58751719503362254_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhkBNeX5EYkQ7kNvwGXwQAD&_nc_oc=Adn-6xi_DaXqjYv55lZkOqG4g1kGKidue5_9RuJOWgOaAqKGQD2jDFb-udm8emylfgk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs7_tqs8APaXerhrzCpCDd5_-8pHUUKPQqT-Nq4HdFpEA&oe=699860F3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Smath!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1706901283, "lastRevision": {"nodes": [{"id": "694807809194
.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raa7QtFLSv8Q7kNvwF1TBrw&_nc_oc=AdqtjR_1ldEQQS8jkhrn8IfvqiwwI9QfpSEjvsPuLP0as6_FRq25AX45_wZzbU-6Crc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79_XepiuCWpu9osDlFA4NPj5KgSvzQvTbLlGwkk-FU8w&oe=6A106F78"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6hbmr3-7_oQ7kNvwErtU26&_nc_oc=AdqByKH8ylrSaS-_tmOpO0TrR5NxtEBid18NiRUD0P3ziM1cIJGpkAKPcHZ8lhAZ8F8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4my-VKEvxR6GPC49oyN5npFjKuo25LJiXBlRRDUMWKMA&oe=6A105662"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMPTRhxBoCEQ7kNvwGUFcsi&_nc_oc=Adooxuo-pOo5uFt2bAX2f2GmJjyOENm4XQQbEaet_x-JSwZmxT-JNhBgPmYlfNaRviE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NGohBiiXvEJXdSeBxo0rFKmEXLHV7VSZ0dkE1PiD4SA&oe=6A107AAC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hq_Qf1SHPdEQ7kNvwEx8_IW&_nc_oc=AdppXV2CgIln87qdEFUv7YOB0GxXG-Pu9VoHY8bPjftz_QhZ_zO6MkS5ukEg2vzfeAQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66YGbseZDubur5nrYaxcJiAfqufLBzBgsr1VdJxYl-GA&oe=6A106837"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rVUB83Pxl4Q7kNvwF41P59&_nc_oc=AdrOAbY0L48xwgZlA0soRIQxWXkcOxRvRfaDFKQbzrw4IBtCPWlgKbMvxSeieExw_zU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UYe4MnIO4xP5smVf-OuTLJF8BSRFa3IeZPlXPpSsykA&oe=6A106088"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNsEB5malZwQ7kNvwEdNjQd&_nc_oc=Adr9oE0EmSe2OD8Ub5s06lvOobKznuzgoDpaenJsqI5o_lYGwjCgIaf3Ujb7GrWEUg0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RDG_CVQbPk_z1ekYV2i2HVAAwgSLGLAAZXugY_tA8Bg&oe=6A1068C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwRSU6tOqjQQ7kNvwEO7mEY&_nc_oc=AdpQo2HpBl0j8AKNdwN-RZl4cSvJFiJTxcUKoHtHFv4JtQaSvD-Jg7eChkcRGZoe0ZQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MamzAdyHSfLkx3IT9ZGq5vXZ2PlPP9qFhi9qhM2U9jQ&oe=6A1057B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=673vHfKVD1kQ7kNvwFlc7xC&_nc_oc=AdoqtTSZWmWUwH1HVWWyuLvWf5Ns6kfoKFy3v3JzZB-7Vj-bYWJ7PyGPHYtMJe1Mn5Y&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OrQu4p9RfRBj6afyCzF2n0DETYy9-ik5Vp2JQB4hr1A&oe=6A1064A6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculus
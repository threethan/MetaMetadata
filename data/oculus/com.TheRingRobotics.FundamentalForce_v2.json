.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBscECWMiLIQ7kNvwFJKr77&_nc_oc=AdrJENAD9CPDuRUhC94VT3WG3bgUjIVBOhD8MWpU-vKdchKF3N7d5PXDcbckVZWZt4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwqL4G62ZFP07kJVldt4iiiFAzxK_hww-xwJVjWRRhkw&oe=6A7C5238"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHxfURWvBgEQ7kNvwF3mO61&_nc_oc=AdqxYFfHV6pXFcMCsJU-49LmMLjWpuMa1I-nZUPwiOCWUnyksZ1rvcj6YUc7IYWlCa0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-XggCAZtzSD4Hww8oNG4GN8EWvZGaakkxdGMMMw4qGw&oe=6A7C7162"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acwz8j8WG6IQ7kNvwFaC1P6&_nc_oc=AdoBMdXw-Q6KtQF10soi1syD8FZdqaENvp9EFIGECT9ZVb80xjRpwQDO8EU-674-1h8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdv-gAc4w7UIERK2EqOGEB-14HyOnZ-_gqsbSiG6c5gw&oe=6A7C5D6C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzrRUnJ7pnoQ7kNvwHMKyHl&_nc_oc=AdqSqUNp_GhZdoShFDYJU46Y5f0AYa6P8YEcFwNzAzoshFwqrWVMwmjTIo9CZpyQfME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjTbWmVizhE7LiE7ulNtDK4QUD8puxEUWjpbP8Gr5DHQ&oe=6A7C4AF7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dS70B355g8Q7kNvwFX5eiM&_nc_oc=AdpSjExlOdPRd4x9zR8sReqnkTpUILYgi3F3c7RMhDT7y9H6zZ_WMIZ-gSM8ftdz3HU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsel9F7_A32x0FL6FMny04qVzbN9tupIFBuER-h3Rz7A&oe=6A7C7B88"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVcJu4RIb5oQ7kNvwGvFell&_nc_oc=AdqHSuFmv7ZKlZMbRVeAQOrFBf5vHkHorfBrR_gBcgNZ4IpZp2W96XsA0XoGbdMwKdg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvI4ub8Jmjj_PsILLZmqw_lRkMCRjPyRpW99DNaNDC6w&oe=6A7C4B86"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsA7H3LLcdQQ7kNvwFmQPOe&_nc_oc=Adpvdv6vOjQLznwhBgVgFXmihy55cRfscn_lEAF3h1IWUwXMNhH3xt1AsK7ELXdxq3o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0dVc5uzgBjrh-ku3moYbONdwcBC8EC_3W9XwrKDvpzA&oe=6A7C72B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIVNkcNyQW4Q7kNvwGPHOtI&_nc_oc=AdouaR0QB8feIgDlsH49Ps6PNuhunpoH5rqiZ6e4NSRzAoMeNNRe8D7XtU2Rk9a_JTA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9fIwcLdhNkzxDbbiDKCAJ-s_7k1LROHSp_mMlRZNflQ&oe=6A7C4766"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculus
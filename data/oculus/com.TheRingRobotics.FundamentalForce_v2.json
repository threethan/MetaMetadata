.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3J0iPs5uE8YQ7kNvwFJU82y&_nc_oc=Adp73rKOUhRZb8mDUlzgDSB0w2Y3uM6mxZ15T-SrkwZYiQRhUUU-ek1z4Ywk59eKzA8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_liv6OxuYN7BslXmnyH6nvoGjZuXk8ZT57531hp3NwQ&oe=6A6CB878"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elIU8aRjmOMQ7kNvwFcFGt7&_nc_oc=AdoF0i8wq6R3cv94Y61gStWdU_0D9ouGKpDdJRx183S6MBZqE5tiJ87eUQ8LHivt-WU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB05rfq4EtYlMoXvF6V4fkyJHCsVP9gZNIbKEVXAsDHhw&oe=6A6C9F62"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQljXwNME1EQ7kNvwHtbOVL&_nc_oc=Adrz_4CKUpXFyvS2YT_jjBvFTzhZKssXA-55O8oBEAeJacnqdDEnsrJ9WuBVkFazKyw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLAAUQe9nPMCvyZwy2qAOJ7IgoWUCD02KMoQF4qprguA&oe=6A6C8B6C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTKuUcGTsMUQ7kNvwH1NMwq&_nc_oc=AdrctYMCvYAwqEqhR_rEBWuviliZ8ymgYMzTSZ6eW8cJfBwYxAq7sBpV1zTWn4472GM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU-PVjXqKPQYkemQ6PuwlRtI49Xyxe52P2nwtWpGPkiw&oe=6A6CB137"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBI8qVo02bcQ7kNvwEVHNRd&_nc_oc=Adpp7EApBmo_C80C_rUewD-27NvGjNG-yePPr7bmd1O3n3sXjp0IGTaCKySgYn0BhXw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOkU385WNUDAO8iTIe9HimQMEoY372g568lYwPH9uhTg&oe=6A6CA988"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8BBNc6BuTYQ7kNvwHl2spD&_nc_oc=Adr_6aeL11dKYWWL6694Z3FZmjW_7YrpVBPHMroNBAZT7aBbR3IpKzG04V_prS3T3dc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8ymWViJ-ZXStd85UMd-PyVaYQtXL3Kji78rD_mov4uA&oe=6A6CB1C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sGz0wSepWAQ7kNvwGCsjUf&_nc_oc=AdqMvLgSZ73lR7aEmgljY78tVagkglG-g8MNbFa18ASuaY88rH5-c4P9Hhmc88_HoKE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAzCIRk65gVd3pEHQYHYzh27xfs1YBg_5jDUpptjvT_w&oe=6A6CA0B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEP_7no617AQ7kNvwEDhvpJ&_nc_oc=AdqYg1r7PpsgsfU2Bc5lNajLTg0qB9cWA5X5q1MGdJCBp7qxeG2l7ATommWp0HRKhAY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpjRIYWna7x98zi-gYjdUqFtXdaAzOCHm2fI0zldHsmQ&oe=6A6CADA6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculus
.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_tW-n02my8Q7kNvwGyE-ft&_nc_oc=AdqroQslHfjbACSr3cLj_gX35QlbWjPE5wwa1WrVATLS0jqKlvmIe6Ay_a4tSFmndqo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17mHiQ8sv6WUjvRmHt1vVxQY0eeeoGKHsXjx_Pcgqsww&oe=69D39238"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YrXJ3xKqgoQ7kNvwE6pU1R&_nc_oc=AdoT4akjgHAkUGLI0MRNVIWNnTpgzbL7_pJpkmTpU7HfSrti10n_lAq2_wR2Bv7_EG0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ofn6lVYaO80MoZs_-ep7UV2T9rVBNbqnHdS_l3K873A&oe=69D3B162"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6E17blvLDYQ7kNvwG_SxO9&_nc_oc=AdpeTfSC36YYFnWSn9Z7afuwMz5CPIKbeVfbbiA_e5CZ2-bKJ4Do-goembB37bLejvo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cW0pF0DtuWT0_fzubBvttx1JaEm2SusLouObbCaVN7w&oe=69D39D6C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9rcOzCTL8gQ7kNvwEn_M0T&_nc_oc=AdrYOS4LO_Dmp1zCb6Bn8uOsewiocr0ItbNc-y0p0X6YQUUllD2pDNd8T8OI9Zq-aRk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eKgLrQQcmD4C54x1RzB7T1rv10dC-xym-N3bB8ukRzw&oe=69D3C337"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66DEqh0oubcQ7kNvwFzZ3qZ&_nc_oc=AdotBc-2YEViv-fdcV2bt950VamAyYPxTvXAGBTdrmOjJzf8eAIOW5_uZdGfgWPjqa0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35pIb8caY1KNanDpxyfTdVbVaqmPBqKEtpbIms7VNkGQ&oe=69D3BB88"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEhhzzW6jYIQ7kNvwFpsEUe&_nc_oc=AdqAQaylWFeNfyKLDjmEwLgjEZ1GyY_2Pii0Hd4TvYTxsxbeA3xDbZigam_EyuFswJA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18_6p4TuX6dDS3565vK5nJN_lpLwt_e-V59_00k3hDAg&oe=69D3C3C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YH2tkedlz7UQ7kNvwGk7mY8&_nc_oc=Adqsn3bLJ2zKP2fglxBSLDqmYkxWln2IPNw7ZgqdjxCyJtuFA6nsl8R25Y7kGg61tAQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10Lhxu34jygGKWMkloAZFZYGdyeumP_ka5qy3c-TbJWA&oe=69D3B2B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NSWI7mF2DkQ7kNvwGWAzG4&_nc_oc=AdqsdzCcHqEgoQm9nMci44F-QSAHcpLhbgnqTA_iaBabG9L2o7b89WT2klnP3D6VC6E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36Kg5EO1P2_uRD3W0mkAqgku3oS35V1AVIdfY3TXFdSw&oe=69D3BFA6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculus
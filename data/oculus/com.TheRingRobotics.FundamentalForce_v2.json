.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPlK6T3ItjMQ7kNvwFXPWJd&_nc_oc=AdqNLhEXvXsidO-oTd-HAXIgh2Uh58TcQcjJYbWL3HCl0HUL9Bjz9ZduA06Qjxhe6X4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPn0sBgbTVTlLRtADLL_S5YXtv9RcliTekTvEfGxPXAA&oe=6A92BBB8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFKGbNlRpiwQ7kNvwH69_8-&_nc_oc=Adr61zGoWErJU2z7j_v3G_hKtE1w3_2qOPb51TpAzrh2AYa5024gGCoXmDMvZwuFQTM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMCl9jINYWeHCphI9zB0_dC3CutV-Ax6eXWduVBAcrmw&oe=6A92DAE2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrAP-yYBxEsQ7kNvwEw5EkP&_nc_oc=AdohOXp90OrAZG0j-rZ4JHUPPnjMIOG_d0OJl7tSLuu4VFdXIs0LCEc0S2zT8Bi0zWk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb2BYu58FQHV1pzdFThdFw7xiVhvt3NAGzx8lcuEDLgw&oe=6A92C6EC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhq9BMU12rQQ7kNvwH18wiM&_nc_oc=Adr3-nh0A07iBmI6VokYve7bwzkOkE38VhQrv0-LZD4YKbPhe5WrZ8rsmKF6X6zlAn4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfBm5vF0crssL71P_sl6x5H6rCRLFwZ4UKO-6NiSVnXQ&oe=6A92B477"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drbkaEI1XcEQ7kNvwE0IHps&_nc_oc=AdoVUSIv6R9cS8keHm2uAdg0cbYGNwcZUFvDT5U3mhnUScc1AudI_hbLUKRR2wSELig&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaoy8tn9E5CJJSRNeF8a1vorFr_y1HiXC84aIphMfcWA&oe=6A92ACC8"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIfKvwLddwUQ7kNvwGvIZGd&_nc_oc=Adp2cW0DoT7JvAWOw5HTl7IZgjVk-aP9E3xWl3Dflrjn3vPqa8snt_qBRspkhcOmklc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGu3v3PUYHDG0vWdRTc9SugZ-8B-dfjWcMvfPk66wa_TA&oe=6A92B506"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVizH88NVIwQ7kNvwFdk6Ug&_nc_oc=Adq-o2sjG2-40Lm6SDhLB-KGytv6AieVG0RYXuLdYIsrKqv4N59gewojUdgrl-SlMfw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKu5_Wm2ijh2ZACeAe_s2kxUlRfdbjH3pmHhGrdCpDug&oe=6A92DC32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mt3vMzjHS3oQ7kNvwGWYWBe&_nc_oc=AdpNvqPpgQKy3yq2ql95hAfoQmjtQ3UT3xw7wFvj83WeOZAw7yNpSxL-9eOyZwVO19A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1E3tRXKRH7Su4zVrKDWiD_I1WBSsOGSHHoIeey2ICqA&oe=6A92B0E6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculus
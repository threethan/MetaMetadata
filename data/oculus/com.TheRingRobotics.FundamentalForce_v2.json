.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qWve3gP2XwQ7kNvwH78uK9&_nc_oc=Adrb9QeXQ3iYn6l4A0dKvTda5KiAWJFEX9DdExaFu7FIAXVw-PpmhIuZyTrnUizjdog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afylwdrofo_VyxGpcdW8yJftYLcrnZ4YDksiHeCm3HviNg&oe=69CD32F8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bN1j2Krymn8Q7kNvwEXe2j9&_nc_oc=Adphy2soo6r8r82oKv0_cHW1EFr4-PQt_8FbljNSo8FAgepWVLA7PsWFcz6BQzYFzdk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCfs6NVRmo0Vq3vmnbLBuGnZisu460ij8RLqFeldkTYw&oe=69CD19E2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ztcd2D-n-AQ7kNvwFh7JF6&_nc_oc=Adqsw1fGWzD1FaTGOnfaYQicbBrBOTjrlZZuLkQv_iyoKN7gsfovveFMDm9j1Ge7vco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFRYLAk19YlF0WXG8y60Uu84Mf3RG0efeGaGdIDpdp5A&oe=69CD05EC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjSrBUqwIOUQ7kNvwEXUFHH&_nc_oc=Ados3HB5lmdg7vps-g5ap-LlpcRmAMi57fR4Er27rsQqPck6NPlrKN-deLvRjPaGBLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMLtRhj4slzXJQlm4V4KMY0HnjvvYxHScz3JoQmOwLNg&oe=69CD2BB7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sNwpnz7b_YQ7kNvwHPvAyA&_nc_oc=Adqmx7eW1zVVRMviY2Ai7h6cxgn2V2Ho0w7ZiD9Csq-djvEE8KIfPYTxO8DkdduAbt8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbTjUV9TieZaJjhb8PSpYcNZt58FMwmG4mARifvD1seQ&oe=69CD2408"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Y3mLdd5okQQ7kNvwFm0EFg&_nc_oc=AdrBRhhLaAP9m77xoo7UN2KKqcVlPmlEXqNnzNgK5NAxb1iwrSfv97LyBPoExdWmlEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYhTDzgjMtOmR3Hd6DP350cj7DBCt29drd2XCa6MaxLw&oe=69CD2C46"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YWxAMF8MPEQ7kNvwGBgHSM&_nc_oc=AdpscNrHdQ5f5a9lnvAW0HM3N3VCEOxC7zcx67A59LiIjC1HPpsH_9YKWKW0P-jgIYY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUh1J4ljtv2aHtCDz3BBGgHmtYPW6E67_rQ_Hl_keTzQ&oe=69CD1B32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pg_cPMPcq0MQ7kNvwEjw0_8&_nc_oc=AdqORY9_9W1Ww48CMuLoaecAEWH1pBZzWJjV_6Gf6pWvOgDa5aDzpb5xOD_I6X5Np4M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfziPg_oZ9YjFdytezsNSwf2_ZCtenOBxw1aqcSyjd3ATA&oe=69CD2826"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculus
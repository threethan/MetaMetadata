.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diGWW4HsowEQ7kNvwEc_Yp2&_nc_oc=AdpOaqO0A5_UGzhzFybMDrLXG99pZuw7KOqsQymM6cHyW2AIh4kygMjsz23Qbfb1lJk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzEreMZdIE4HogfW3uLbC5YoSiBF7AfJjo8wUJ4CpApA&oe=6ABE7578"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uboB6aCKzbYQ7kNvwEa9mWF&_nc_oc=AdpMGYzyU99MaYod0U3Icy4mKEDcKuX5aT8kEP6I9MrFA_xtMGfqxeLCVs3qFhPCRIk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqTDiNMAjJ3oPJNIR5xqWSDj-72JStc8sRjGjMAxcKig&oe=6ABE5C62"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9dJOfvetdYQ7kNvwGVkBWl&_nc_oc=AdqqK-ivPrpnGFUV8y8y89GJFlhBFM37SHucLBOz6GtQilBOPcY7mzNfMYT-4iksnpE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHWD7_OQLT2wh-pVl6qRpLM8-XkOVJYi-bg_Af2ZDGhw&oe=6ABE80AC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xq71W3csXkcQ7kNvwH_PrdN&_nc_oc=AdolTL3IXbNtV4OQmKrvrvmWozN6Jh_pK4-snp4Qynnlv0OIDJmjtNH25d9j60lVEo0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-kbku3XUa9cFpwi7-hZURUVEow5GNTL-4yB7KQ6sCMg&oe=6ABE6E37"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MW0wD-CvdZ0Q7kNvwEfg_1C&_nc_oc=Ado8eNhIi1M-hpEOKFI2IzPDrsbK2rA1PZIgRpBTWWvZAD5_cYexzU6HzQuKm9bYlEI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGeMhDb_mHuyUikMiRlPqkSOhJ3XTGavBv4okndx083g&oe=6ABE6688"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hD3EwrMv_CAQ7kNvwFOg1rk&_nc_oc=AdqB1VueqJZXKn6XXabUBSeKx7kMDwN_Q9Q7jPp_hzojKA4sAycUc0vFpnRg8EDP7sk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIL6YLTNQ0y8ldX7Kegixvsq9m4WyEGyveZnavKRBkDPA&oe=6ABE6EC6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WIfRuX5HzkQ7kNvwG9cr_x&_nc_oc=AdoAmL-0211foj6OH3UM3K_0znxWX-AmtjtBfRta7POfZ8FZlz_ii3gJHPJF06Afr5A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQrMFOuJLUwwG4aQo4tGwWxjuOptYWe_J0v7MZk9Wc4g&oe=6ABE5DB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZCXWLS7SbcQ7kNvwG3D0en&_nc_oc=AdpU0GcKTd9-vPkjdU2_o9IGGg085mLJ-ncndq147k4nh6ZUJ2FGg09vM9cpxIq36zA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9tEdyJmajAK5ELeuvhJCaLet6xI-sgMUysVSw05qIZw&oe=6ABE6AA6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculus
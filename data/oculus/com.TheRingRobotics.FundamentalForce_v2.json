.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s79YKoNR6RIQ7kNvwEGooGC&_nc_oc=Adqe3-PuXZxwnGOp2ke8BTRHqMSgXNyAjvxeWgbKMouXp7dCVh6Z-rczHI29B73LrDg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA_6T8syfbv3cVo3cGUSpPF18JQteUpYcUSdQVoR4cfw&oe=6A8C2438"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2yEtwHmQ_QQ7kNvwHHRCzE&_nc_oc=AdoZaju2zmWe2DWToYfCSYWt4dof-l82N5yYufxjMfSpKx5wVeR-tE30MsZHkRRjlgc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVIiJ_uc_3WWTCz4LYqst8Nd7tIM6PffrQOtkXS1I9uQ&oe=6A8C4362"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VM-xFK_jap0Q7kNvwErhvaA&_nc_oc=AdpzjtHO0O0OLx879hGRqkv9OaRs-rUWOxRh4xc5KYfj9EG71VEsaA9Ik1WOEuJdHZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdHDr527xqCKueMyObxIXLK4fMZqbZfCJQgMD0CjfiNw&oe=6A8C2F6C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TimCXHOWcncQ7kNvwEdg96x&_nc_oc=AdqXtyNwXwTt98VKcjQtP8cmaMXnHva9ZbiW2M_dqt9EI8IQbL5F5i8WRVe20VOmWG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPwIYl-P2EJyNiO-cM2TXPmJVd0AiID-8fWg5VBOG0FQ&oe=6A8C1CF7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObC4GlHWXb4Q7kNvwFFQxlT&_nc_oc=AdrI1LwbLU2YMbEveFtFz_eBSZUGPCRJu0MHzT2QPPxlTs84zZOx-2kJA3f7_gW_6V0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzXSHy4vZF3DMg9hj0NAmDm54algtWuiVSFrg24ERkqw&oe=6A8C1548"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=al0R_UeQyW8Q7kNvwFSpBRM&_nc_oc=AdoXQUeku5dHbm-sNW9-Fz9bJNRYhwe8y3LdrK7pTRfbgQXWsETV-LTWjJoYFmvO480&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEmdEFal5oqbiQXj-crojlCREysgaPkR8OqaNcBBpdLA&oe=6A8C1D86"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPnmVhBzSyQQ7kNvwGOslys&_nc_oc=AdrD8NTiztIVj7ODbnU6lnnjFNiTB1AQTwpoIfzJvmETR3rM4eqlbwCa-ebos5T1hl8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgq-ZinvnUkLiPUEsSvOPr8HG-evXg6CHRDA9IcttZLw&oe=6A8C44B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BfHeBMw414Q7kNvwGgowRJ&_nc_oc=Adp9WrB_c7SSIJRPVIqNMq_l4BBHkQrJVnxoc3eyhdXsV5NDpAumq4cN9B_0iXFMjBA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErdMBK0cVDT5fBkz0-Ii6kbQiG2HDWl3s1uKZJUk7ZYQ&oe=6A8C1966"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculus
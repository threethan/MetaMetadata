.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BMMaTe57JAQ7kNvwEy22yR&_nc_oc=AdqCeBU7kkfo9UcrQkRRbReDx9y6BMHyI3bcowJkORM3svg8KP5kMKIDlK8X-jP00OY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnFANT6Rgk0wV6uFd0f5yWTXPplDNUFo35cE26FWdaWw&oe=6A4D1478"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYcQ0UpmBe4Q7kNvwGPnZRO&_nc_oc=AdrtIJq1lSXdSE_x85E_FMZNSoroLMvG_u0m35c50x7xelBIOH3dWRlQc8Ii3gUNnQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiyv4b5dzzhBIoQv_0CMXLlD0ILtgz64FLBltzOBnGsw&oe=6A4CFB62"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h8E-39nJUEQ7kNvwHiVHIc&_nc_oc=AdqZzXpKBQWo9rJjSG9JFI2seooPSqe3qOmehNDBUghEvDKGtudEPyOAl9d1R-AyEjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-SJeDqiMWFtMKfIGBLhpS3eVV-FHBnmXMgphsVBXYCw&oe=6A4D1FAC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfr7EeODIxYQ7kNvwHJqV1c&_nc_oc=AdrWzVvpiSWPXZxuSrUXl7HCVKLgRhmAa6tfcKj5q7-foPGD6m560YbEU-4ltNk38JM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2bg6Uj20NfUZ2iHb9kwwdtAXEh_QDnpMg0eYZE8Wsrw&oe=6A4D0D37"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAn8ad4KhNYQ7kNvwEdcGvU&_nc_oc=AdogaiPnBfTcA57_NxClsOihMNVGmXA2RkNo5dZg5TGF-CgYSBR5-nJ6jBnHACGLIoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCna0a7Pm6P3cv8VRx6VYlzQpTq5uP2chmI3wKiXcNaQg&oe=6A4D0588"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_037fdUkcoQ7kNvwGOwlqO&_nc_oc=AdpVC2xPUzIWbE-mtb24A_lGeAI5x8qnqph4ZyYFrBzE4Kn-6-aJpm5WIOR2rnMsSlQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDXGQjJ8oChIo-bHkebxmbiZjyZaHBtx3Na5DRSo5xgA&oe=6A4D0DC6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bSBFbX72IAQ7kNvwHpDIOa&_nc_oc=AdoPkN5HfdJuKEETqUq3LJO-Dd9i3wcnQ69BW74klVy5q8RwidB-jQ58rgxkUXlmEvc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXX7xgJW8LLD1i4mpqi4-c0FKG7-4vpaO3D06acv7sBQ&oe=6A4CFCB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnE_4nCkz7cQ7kNvwHaJpkh&_nc_oc=AdqU8kPC5bg5xen4POQ4PURhK5BpsvsgpGtoSU1-KD6DfwFq4_J9TrpnCcQ0wf1Q7-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl1ZVC9sgAM1OlRB3nGxMjPV0Y_utLOWz9BgP3rPQB8Q&oe=6A4D09A6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculus
.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5dxOkaiyV0Q7kNvwFlIPSW&_nc_oc=AdrC0A5yTJysXlbScK83dpxEhZvqXQs6g80cTHYNDebmEEM_APM1Y0Okl-80xNeVA7o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPmhXNqvJqkOvLlZkImGNHyXLOoaSZoAZ7h7I5__Pg9g&oe=6A82E9B8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtRxXlfv_jIQ7kNvwEVkNm4&_nc_oc=AdowH9owiTck-4c_EKDudO4lG5W-djKwbQ59zYr-KCBPPnVaAgFqEjABveASr9vZOHg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtBt1hZhncMk_zWupexceNTpyYSE1flOu2K6tnA1A6ug&oe=6A8308E2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NE5s_iqSWkQ7kNvwE0Z-PM&_nc_oc=AdrgfoagGjoT2sjJySVI07-PHDVkklY4MBeTfWveJqdK35EjCu8HDqM_APVXvLS6cv0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElNlajJ9zpKmGEt5OgV0U-MJI-wxWTft8GpeFISEXMow&oe=6A82F4EC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3wgi6z28xkQ7kNvwGTxCzA&_nc_oc=AdpTm_ye40ps_NBfmvAr7dTUtbG6QlePKrmzAXrRxliEQb0mlgKmi_fkvMQ6Th7-AjI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFUbKgQm6Qml7NlV5CloR_H5ot2_JBsZigQNCcNhnwEw&oe=6A831AB7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJOTpzD5DKIQ7kNvwECnOjH&_nc_oc=AdqBHXgDjE7PQdjAw4IH-HdCTlqj-_ojboj1DSUebQa9wK5pEPFpz-2W5Runw113GaA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEisSs9b2lOeM89Khw-1MVte1gJdhPlB0sVEgf2azDxJg&oe=6A831308"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_J99fnUdmwQ7kNvwH845Lw&_nc_oc=AdpLZ3rs0f8giA6TxFlhtsFP-SD1xdb6hvmgQ147Eoa5lGQ29wBfWreTiPKohbhfbrA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpHVRPk4VfV9WTkaBI70ih7LUOCDTDFkgp7bjpyCIVOg&oe=6A82E306"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oParw7lQO-sQ7kNvwHFOIz1&_nc_oc=Ado_e2s4dkLhbwEG1TPXLTfp32dMS3lRnKfxx8oapq21ULCQ4SLMJhFLhkCdlQO5M5Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSarWTy4ctqpfsFWlCkLKJCX0nGPozLbY91UIknfZ2bw&oe=6A830A32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ur-T_XUGFdYQ7kNvwEAvuNT&_nc_oc=AdqT0xOXYMU5qUfANimP--iFQuxGKrvb3Ypq__9N7Wd2-gNzw8li4BmSBzKZ_1HKZvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvPd4i5HrHVauCC5yzk2EaikQ5xehR2TcT50qN689XKA&oe=6A831726"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculus
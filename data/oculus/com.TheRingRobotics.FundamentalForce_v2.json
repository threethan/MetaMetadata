.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8qZZGgNNYQQ7kNvwHchxVW&_nc_oc=AdqQuNxqDsoslwwn8eR-pTc3ius7Qjm8lCrUdmJroLLWPF4v0fwg98Bq0SCmrOnrqNI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC8q6Dc0tG3UUfCaW8fpYouXWP8sEvrvzdDf23jdJ80w&oe=6AF725F8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrkAbW6O7XMQ7kNvwEXaZba&_nc_oc=AdpaoOIWx18o5N0AfmZiSe7_vZVA81B1XlkBd3O10ngv3cZfeHSo-HhG8ht6a7iHcns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsXtHkM_PJznqmUFhgCZRL3ENC7yPuLGvh9u-xGe1GyQ&oe=6AF74522"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gaOwV0xk8gQ7kNvwF8MLhS&_nc_oc=Adr2Mwj-Qp3Xtpe7rqrDanK9jDT5u2v_QuzpJd93DS58IsqvzWn3djJM7gOvNyq8eV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpG0NRhn5BD9UyqOsoCgVz1JRRYJsZXCN8-wtaIWe-pw&oe=6AF7312C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVIal1Uz1tMQ7kNvwFNvcrd&_nc_oc=Ado_8bxkQMeK0j5mwvdacDP8aVWoMXmZvjkbYdrWA7SCAvh4xMyzn_SWmiT2rnmyOZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLQpuXxUJ_iJNe8JywMdg8U4iSN7Yx3i6bfq5yWiDeCQ&oe=6AF71EB7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-80YzZCwS_oQ7kNvwHWwJRF&_nc_oc=AdorlcEA2MXDdcS6hLEpgpe62cKXcuJnvSgvLlDNj1rRXLaxUgLxD0Q2_Z0_Qm68NvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGown6Te2VrPbpuCTPcUoCn7siAWvyvhwNG3HDXNq4nA&oe=6AF71708"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyOCfQpm9t0Q7kNvwEPLMTH&_nc_oc=AdqJ6kwFL1ILi90VokcujCZHz6bbaWzdr-kYAzdHeh4RcPIcPkLkj3h4jooRm_yhON0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA2QGbutOmxperiS3l-FXO5nNn5Oxfk3r9psWjYZTgiw&oe=6AF71F46"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcfdxiJGffwQ7kNvwHp5zh1&_nc_oc=Adp2UHQL0HPihe_P1UxYzUSP6PXNtG2h_TXuRDV_FS7FHeAxUvcUvf0x5FqrFFFHyaE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDaU-sUuaatHCe1ENrdBJikIWiVGLyDX6Cjdh6tPU-6Q&oe=6AF74672"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwgEvhCltTwQ7kNvwGrTviZ&_nc_oc=AdpiP_H_5ufte3loaLKVKeb92RIXC2AoWJHAFO1ylY88yQgKlH5pzEuPV4SQN8gunx0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7dLdn_OkIdCIXbeFX9tFybAokVVCytOlpCtFjEdHN3Q&oe=6AF71B26"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculus
.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3J0iPs5uE8YQ7kNvwEa52Gw&_nc_oc=Adoz6-CdjKKnYDSBMHCg9agWXzWSn4b2jMiIP18IPXvKfbEWn4PPDm74MpqfQxfSeL0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCopg-ryxQc_GQHsEc-_PzNkudBa0tKeL5sWawJxOnk-w&oe=6A6E09F8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elIU8aRjmOMQ7kNvwGE0gkV&_nc_oc=AdqVnm7F_QXvXERM7v4QeNG0nx_BXtsauivYUSYC8EPF3vFlvf6cXcmzUCugm0O6ors&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB33-PaWuFWpFvLmz_9doAWnXZfWclu7aZQg2hDTe1vqA&oe=6A6DF0E2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQljXwNME1EQ7kNvwELSotx&_nc_oc=Ado18cfkpdE0LecuhwKX_jo6khTbyI3gMArR3HpCucCkYrKuTjF-tiQiR07eELnzqFY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlACvowG1MAMqJT7j1eDb4LZGdflPSVgZlQBRZtfcoEQ&oe=6A6DDCEC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTKuUcGTsMUQ7kNvwHpyx39&_nc_oc=AdpXpGLEv1cwP6S3CsZ4Rl7MP6a5HwxXP1XjXBTE7402tH0EMMuTU3yhkPTQgD2vz04&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS3EFxsFVpbiefcubhp10IDqPQ07aaKC-R0HYa1DQIXg&oe=6A6E02B7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBI8qVo02bcQ7kNvwGoBHft&_nc_oc=Adp_y20Vc7nfDn3SHKL6LPIxrLAAOmWqt9YTDCqlbJj9VPojnH9Wc1yYGOscf_YX_e0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPKQm40L_LiamZWtAk8TyAIKkwW6f9_Ig_SvZ0b8O4vQ&oe=6A6DFB08"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8BBNc6BuTYQ7kNvwFhUSRj&_nc_oc=Adp_lDPdrrO8CC51LqFGKMQW-NyLFpnjRdoUw5Gqz7oELQqDy5OKHLWFn-8IhGLIRM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKHed64-UHj2y10VrkeDiNOg1WN1cMa_qhHFkQ2D94Cg&oe=6A6E0346"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sGz0wSepWAQ7kNvwFV5Kgs&_nc_oc=AdrGO8PjacgUUUtfLQ9O3g6J4h2kCJY-iU6v6iPPt5MHL4xlGKlO3d_o8UyVhBE84CI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbgfA0Byi9f6yJFUdignxJDjS-q31K4rmu1wRzmF_uCw&oe=6A6DF232"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6g4oaIEaWaQQ7kNvwGdiuRn&_nc_oc=AdpHkTXGn5MRwizCwK_X1xEKN-VPQ65K2lpRQhl272Ukmb9xDtv07UHH-pBiXOsYOqQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2yrAOGwu1P_yYfzoJ4Zh3LZT4dlokLwhJDsuEtAogrg&oe=6A6DFF26"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculus
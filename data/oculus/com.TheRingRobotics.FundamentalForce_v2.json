.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3J0iPs5uE8YQ7kNvwFn1JPO&_nc_oc=Ado_D9WgYOAoGUKeoCXb-ui7z1iA3_YRorMqZVGGqYWcRs4XibIMu4NjCMijascsFx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBR9iCpzGV0d0UIXWtfdwJfa2YaSPuy1Fi24Gm-t9rSkQ&oe=6A6B66F8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elIU8aRjmOMQ7kNvwEqqdYM&_nc_oc=AdqHvN976rliKu8LeDsw42d8H1zXpE0ARf4IXBqRW-l5BfSUTczby6YN9gN0sYQC4Ro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxLwl2Hj9oIum1v5ZCG2xuywlFQNuTvlh9UeSpfcEUpw&oe=6A6B4DE2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQljXwNME1EQ7kNvwFfhkDK&_nc_oc=AdpJvlxeaGW0y3lqgG17PCJlMqbdcC7jq-nvLLAsH7CkuweN_nlvaqIpG53xUf1KKQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcEenedqwbt5Y03cS8BbG1zB80tM-oTZivAjh4fQs8dg&oe=6A6B39EC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QoU4rDAAIcQ7kNvwEL8hIb&_nc_oc=AdpBfe1V_rto3YtAW_KTpx2wDT496QiOzPUKjDQwDUWbSMAHpPZX-Phc5pcR2Zz5HQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCO2DA7e8J5IawNgzV4s9NIxU3nhzx-hTnsJoEGh5WBSw&oe=6A6B5FB7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGlZyPJZk-gQ7kNvwFCJfLf&_nc_oc=Adpx9L4LbhoJY6TNsxVJCFrSe5oz61mPqLlXcmUW0_P13XY7KpWki4fFBGT_6JVH3bE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNkDBZlrK4fJLEfa7xsZVgeK1wELbrzu2moukrzFtYiw&oe=6A6B5808"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8BBNc6BuTYQ7kNvwEu9ga7&_nc_oc=AdrzyVwO5LxO-9H7dqSZKyxl_vqRzsmY_KVdKbTgVexKMMNcGsYuMkab1pvjcigdayo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHy_6m3i96SZHfuqdynAXeGAR5uWfM_Sjg7p7zalDuBg&oe=6A6B6046"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiumC2QmPQEQ7kNvwEnyRwJ&_nc_oc=AdoJvrJe-PCv2C7Uq8Ej0g-dDmm2IvFPibygciYAIAulb6VsX5aGDAVN0S_ViTiILdA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI-Q60hgYYHHw5eh8Rnn65m3gkCZZh8KK8Lkib9vT9IQ&oe=6A6B4F32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEP_7no617AQ7kNvwGr8zMQ&_nc_oc=Adr0RBjgnjjvNyFm3VE0xm9JezGSzpyhGy4Y48TxHhRKUSFKVJUKNlh2pb8VlgSHg28&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBP21f2J1pYQUHJJnMVycBqZX_-X5hcAGmlfJ0KUB0b0g&oe=6A6B5C26"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculus
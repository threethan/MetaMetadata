", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZPpJsUCJrgQ7kNvwGW7LZd&_nc_oc=AdnOJ6S6FOcI043egDLwU2htrhqGmnwnB06-FwgAvF9CjqrlElh08l1UB6gkoUH3H_E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6Nl8olf420jkh0mvsS0f40XBFCWZMg0IOUadeZCPJvA&oe=69B6B062"}]}, "id": "122201803184211", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brO1QASqmN8Q7kNvwFv0cvb&_nc_oc=AdlNH9wY9c0eioSQGj-pOCQcgk2ASQP2bl-KZ3Hz1wLzR-wLVrzWq-XALZF1o7-Kd18&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOcPaVj-tVKR1chELOI7GK9Z8kaD4fWDTJBzsYyKM3Iw&oe=69B69C6C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqVXUkjir2AQ7kNvwFdG4qX&_nc_oc=AdmI9BUggXz_SfuAsLctDgNda49iUYG7zrsTJvXmqDYPw74dq5i9X2g0auJi2-pkTks&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3wJUURD3NjFkJ9F1cKLAr_fSof-3IKS9dg96LAkJehQ&oe=69B6C237"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8nUU25Z9MwQ7kNvwGxfLd-&_nc_oc=AdnHn95LAuF9lV04mPUE3NJ-2orxrxLeg7PgYtNf_yuQiuapOoyp44hMUxNX4uYSwBU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGuLZfIEuOK8gpIvHoIxacgFskvqAQWSNQo4YV1Uz9mg&oe=69B6BA88"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roxlG09exdYQ7kNvwE3NPWD&_nc_oc=Adl-CfmzVqiNCNsiBeL9hEA49SgniRXThkxiT9szO3JuUDeWGyQltxulQhqiISc-yb0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfygHFvFjZIG4DL7zCXdPjcByqn2zfY5xDAyhyOMjMH3kA&oe=69B68A86"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJ7MEcEOnmIQ7kNvwGbV4h-&_nc_oc=Adk5duEZiJMj3y8glrzV6k1nUFBmYdi8lLjge1BtX4XAILSzN6NfYmDCbUQF8ljLUoc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxluGF4O1FyeJkJdFCQlqxQoUPsOFWoJwIoWToZnLev3A&oe=69B6B1B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bZl4mtmjq8Q7kNvwGrVHlc&_nc_oc=Adniwqb8f8ZsFo11wc5GcwhpmcYxH-Pp6svdiyEMcSCOBBuyjxBrnkHRuHnoK8-X5ak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNvnjKiqhw4PJl6RobFJ-nCTzDmVKfYOCFcTJMWupphw&oe=69B6BEA6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "Fundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/74df57f1-65d4-4483-901e-75c434315d09", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://dniken.itch.io/fundamental-force", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "978156409785706"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1090770348471277"}, {"status": "PUBLISHED", "id": "411661066950323"}]}, "baseline_offer": {"id": "1090770348471277"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1663088400, "status": "PUBLISHED", "id": "1090770348471277"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8797499026942607", "version": "0.4"}, "id": "500850604628269", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6092508
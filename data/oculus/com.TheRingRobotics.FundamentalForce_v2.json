.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tivi3oycGMkQ7kNvwERubCG&_nc_oc=AdoGnoHiJOHxtstKvxek4u_TYV4QLDBgES6QSOTxzwU7cJXXahWL66SaQErBj4dKus8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-Bnq9-qq4QKDRAMAS7NNHjQ5e-BR2CYO2aJraJf7mmQ&oe=6A6A1578"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UbzX-2w70QQ7kNvwHrhxpw&_nc_oc=Adq1e_fwjPPx3zJa-zF0Ll_YsXocJPbhyxBEQ7lyIvimsHJHKu1DvDjOgAub5XUScbs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC59JCAhrHSkMiMGdNsfiERiUktphnu9k8qM81BPf7G4Q&oe=6A69FC62"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0belCZ5hUkQ7kNvwF1yLwf&_nc_oc=AdomBLTIx2BQclS3hzTcrXGD2pLKGVfNlwOIrZdBJooZ3_p4OJjrQLmuiUxftnQdpxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGsEr97exZwNZ7JGEvFHcN22cy4SF6BRSvXK-PFBk_ew&oe=6A69E86C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QoU4rDAAIcQ7kNvwFzmIWK&_nc_oc=AdpT8sPQ35dvKqiW9Gl3_ehLHcEtH2dVFMS4cIT2e2JT4eDLzIZiL33iRDlIBnY1RE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmkjccBFUF-jlSHJ6Hb8AJEwMff1_cUhszbjhJ6BGy5Q&oe=6A6A0E37"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGlZyPJZk-gQ7kNvwHBP1Ub&_nc_oc=AdpU9iAJl1OjS6ViuvGkREjmeazIU7RYjIx4wU7U0JsPXBqVUCGUR9u5mvnWePAYQ5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw79ysKUPz2HJ2JXIbJYDtL5vZYgHzRrQC6djJAk4yew&oe=6A6A0688"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWUJSr4OpbMQ7kNvwEG1tX6&_nc_oc=AdrMWddWZfeT4WP0_k5ft4F7mNLRseYRM6EAuJhrYEqmcAAVsvv0BrBrlKr1-OnRdpo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm73S6l0ay8rRUVbXP0eFfZX7NPNaNFX9JuYaRzP56JQ&oe=6A6A0EC6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiumC2QmPQEQ7kNvwFlrgpP&_nc_oc=AdpV5Cwoc7CDgM_ZAMb-v83dvpudWnoDFgnK0BJRViOUgJHsjkO1s3n1QX-8BDjpoik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4OcOflMxU-pcw-EP0ZQsVHE4fWb8P5SGaGHiwZGk_nQ&oe=6A69FDB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEP_7no617AQ7kNvwGCV9R3&_nc_oc=AdruHW682GnCkJlQHJnQfNgVEgC4om1w3wX2msd91V7qNcCFntIu1zKC4O9WdCoYaps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbXV3ZMAdEGVLePEd7qWGdUGA8zM2bZCvJlmcIkuGllw&oe=6A6A0AA6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculus
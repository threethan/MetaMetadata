.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzThsulzcT0Q7kNvwGTSNYp&_nc_oc=AdqvaKPwQnIfioET6RBG5WcXsAX74Tj0O04310gEDNOnL1373Zy5yAEdkYIDsi7hPAM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUjXgwBjv66MuT8nEBH0xVwLzmfEzkYVTNfWozRxQrrA&oe=6ACBA478"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKYhVUgPB6EQ7kNvwHh0vGw&_nc_oc=Adoixzcw184k_7pXkeQtHWwQ-QDJBdNH5DtIGCtVN_ac9RdSta7tAeYEPyQraZjPXAE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlUwDh7pW5l22morqT3tuDmebA7l5NUSKAvNrre6GydA&oe=6ACBC3A2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsuNfv12UpsQ7kNvwH1EBWF&_nc_oc=AdruYtCJS43OZdrGEoXr1DezeZnFB9yjRbHIxfsq1mV4yZEmxRG-2kj2dpAUe5U5q8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6miNr9lR88bh8-IWSej9samFqwNYVJFBftEPTn8ZO-g&oe=6ACBAFAC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhU0eHk6e0oQ7kNvwFTCMgz&_nc_oc=Adqtwy0jw78FWLxHB3cqcfFiXbRfqtNu0OgY8AoEW5kazriJCdVmvyNN0t2nC3Q6Awg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND71MR-H1By9tYy2VkUEHUqTvT7rPLXC5_6m_hcOLZCg&oe=6ACB9D37"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMRbw54BShEQ7kNvwHGQuur&_nc_oc=AdppQd0DkRHDwgDLlV7Acd7flluvKuZTb_kcUHDPtgBXv19P2JiDlRz4VjYCZIu2GPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvgtoay4_j_0YtntxCwmQPSTbaNrorn53lrKFDiNSivQ&oe=6ACB9588"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezZ1M2cOEFAQ7kNvwFhANKt&_nc_oc=Adoxos9_n_Ep0E4l6uNUWKGJi1DLQJVLAddOP8qTS1qvXP-mBLIYfupKOVSeTOLYuVM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJAkp154cD7Cu4OXCrMYKSQevY1r8yaBALFzGeHHjlHQ&oe=6ACB9DC6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xoPJ47PL5kQ7kNvwEuwYq1&_nc_oc=AdpA7wzmz9U--Gr0YBT4ZY5i1wOASawMCJve30VCAYMW6bJxRxoP2dVRNOhJOfJUnAQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQ1OU4H8mbYoJxGPik0T0Mjb-lwTBa3BcI_ai4at5hXQ&oe=6ACB8CB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9idk5Es7q-UQ7kNvwGGm8_L&_nc_oc=AdpBzCWY0Ku9omF4qGKUPU6YCXGJesAHWaL8o08rfpM67K4niyzHrtwOcFKt-LRY-94&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZlwhdSWXKvnfYCWHwHAY9NoMRp9yDJFlyk0b5nuucDw&oe=6ACB99A6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculus
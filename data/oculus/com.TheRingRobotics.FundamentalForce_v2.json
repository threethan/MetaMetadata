.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFJMKD24zXoQ7kNvwFgcZWt&_nc_oc=Adp3HLYXYAsFns1eG0XaEdDhuEFi4vr14f5ILJqPjZi0m6tGXPLBjOnYVmMJaIiQe5M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CCUYU_ArThzGw0LHoQrZUvKhqGLXxKHM_LFJ7g_tEcQ&oe=6A26D8F8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iw9HVF2DGd0Q7kNvwFsYeiR&_nc_oc=AdrGPN0i3cXDpgGHQKpzeBR_Crdi81Aj5xARTvrTA--mOvUppA9McHYBTPQucZilBMU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82hnDMMolS5wjXhT-YEvMv-wXILS6Ue1c4C9ItHGAZgA&oe=6A26BFE2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NM_KvAnbyZAQ7kNvwFNQVmO&_nc_oc=Ado3D8rMVk0P68sS7maBTNeOEQtk5FLNj7MyfGQFOrjEb30t_yyB0eP8Ci9ohQpFz1E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3QjBjKzEleJ8RdGL3E7rGJKLNVDYtRC0odX4F7A6PMA&oe=6A26E42C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj5qe9F1i3oQ7kNvwGezx3U&_nc_oc=AdrramTCW9fXRrZ4k0cFhvwROxW_SCwKjZJJBB5jNrVitgOS2_fOiY_2Tjy4tJ3DA2g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1TyFZuwqsl1zv8npHoTaGG-WXz_mzmuYqsEP5wFPmew&oe=6A26D1B7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qriUvVNMFFEQ7kNvwGZXbzg&_nc_oc=AdpoDDWyhuk6zhQU1PBluC5FwH9YKpURMavxlc9TFBSZme-2ZynhiJuhylH8dM5dF5U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Kqi7CNI1_IPLQ0yNHCS5Gui87kgyFNkxsotQtrQNn_A&oe=6A26CA08"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1fIg4qEVrsQ7kNvwGF4nbO&_nc_oc=Adr6ApGG-JosoRA7emfZAzGt6zdtuAwRdW0jUZq0wkhhKfXu607WNEnbh-XXstenyY8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99WEgAxoVlKxb_pNXQ2PpZcHbOqfpkF5b6lS2WNghEzQ&oe=6A26D246"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRewygrs_fAQ7kNvwFc4QNi&_nc_oc=Adr1FuzbmyPkd0K6p0juTPVxbLh6r0APJgcgR-3DSUfpjqmlMG8gntvbCuEsRBDnU5A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8USsKx7s7tHOukuTHAyWEagLlQpQ9z8GvAqUyjEP8L4A&oe=6A26C132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Lpf0j6TOa0Q7kNvwEAvsaZ&_nc_oc=Adpkhytc2eGwGi5CNvRMhMCCbMq0ng0ctFDM1e2EeNydSJdT5SF3nzSLbK3mHguhImw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ISk9Rpa2NrmIk__yc121rfeJYswxy6S5G9OJxAQNUYQ&oe=6A26CE26"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculus
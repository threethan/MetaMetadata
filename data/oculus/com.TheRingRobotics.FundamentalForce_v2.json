.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaAdCcXsVs4Q7kNvwGUS7R3&_nc_oc=AdqU6OZRHIV77Q-bhd29lcbd_vI5EFgnK0lz7k1ZrVl9Sb12uC1_CHoVtEnWZKfHxXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JXunrhDVfV5nIopzR8QHHN6bj_tiekq8vxk-JoAiznQ&oe=69FCA8F8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-ILFd_zvCYQ7kNvwFH7sIt&_nc_oc=AdrInz5Hql2996iG9s5z1A2hYUQWjTNvS-mKqAnS0liAYQnNW2ygIbYPiEltA-xtgB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7U2SGLfBwpmAdFgcLj4GvSO6wnyGus4rx7s_d1mXuuzg&oe=69FC8FE2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1QTRp3hCIIQ7kNvwHvYGJ3&_nc_oc=AdpTWVt-s8C_w3_JhSJCc1qW6nrP-Akzm4YyPgZNGbc-gv5xXTdJXloNgtE2tSxOn-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Rrkr0tarZa02_d6m9uQ48CKuTaS7iw8-J3AdmI8XpRA&oe=69FC7BEC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTlxOnNeS08Q7kNvwFNhgpH&_nc_oc=Adr68fUYSPp7Qoy_8sChusdxKZcyuQHWfCMGsRmjMzIsr-72kEE_WqAcKS54jNKkqs4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CeVlFNYNQlJjwSQQf0u96PTdRU26JZlucVDm4QvkRvQ&oe=69FCA1B7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wl37MP5xqt8Q7kNvwHC0ebU&_nc_oc=AdrG6q7SuxHrwKHjvtj1r7yR8ciBwZ8EYjdHt1eL1aOgVzLXax1ljCbr76dhD8UqhHE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FkwumPRioflfNZJDEi-j5z084AY8ENwVG2WvKwNVhww&oe=69FC9A08"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsBXXCma0PAQ7kNvwFiXY3S&_nc_oc=Adppm3uNJe8tjUI_sGWTQs4dRqnkPDUdy1_EpqJ8Bs_BZaeL_u9zHPQkHCxL_7QNJsU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rRHXSlnwQ__S5bHSv1rwN-mEKHGsJfBzH5qFNmz081Q&oe=69FCA246"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R358aAJDMOYQ7kNvwFdhUn6&_nc_oc=AdorwqWDDGqiXSBBi6QUrinsvy7mq3uWmLxiIPvFwcH4PNuSvgx9iw5pnFSySnLgTww&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NdP3Hp0hX2J9K37e5xnGHpvTkLdQaIZNntFIhQ-eYWw&oe=69FC9132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YijoQJ8i8_8Q7kNvwHxlwIg&_nc_oc=AdpbS1FfIM_jXlu6ZrWxjxCSm_otc-O9YP5SEoaTQ4momQ_9t21yav1n2iZRj6VpRG8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55PCs31lA5A4V4_90o5Prbg2QgYt81s2vnzQfqWO8-zw&oe=69FC9E26"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculus
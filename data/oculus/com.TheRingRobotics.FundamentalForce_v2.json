t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZKDjHkpYlve_cv5WgNEZw5jY_klPbF7fz_zBOgrlZjQ&oe=6AFC64B7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjNjhfv3yVEQ7kNvwErF14s&_nc_oc=Adrfi-LybR0n2Nly-fmhl02x7a_-3By0cCcd3QN_GibTqGwtwsO231fIZBGBPb3g3VE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgDZh8h2gm1IJJ88e6C3RDuDQdA3vZ11iLHsc43UlkCg&oe=6AFC9548"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8gN6K7pczsQ7kNvwFWuNok&_nc_oc=AdpHHcSWrJv-dNz9gN4frML-tlntWA5FApOUJWfI_mxsOREFIQyEfQFHBd1Tr8yYKJw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR55GSSBiXyXfcHrDr4Of974JE_ZwxJh600nCesFroGRw&oe=6AFC6546"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STVneHLv_i8Q7kNvwFR4Z_x&_nc_oc=Adpe0OoAXSqI2vuQOotBu7qPoSj9wjYYXoV5cg5ltKsn6BgcA-0TyCEPG9vioT8ZTWQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyQEfg0KohVNV_GQAfGLXpzgiPbLKmsLZ_IAf3-7gADQ&oe=6AFC8C72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aNF1D6gjuYQ7kNvwG7i8zk&_nc_oc=Adp9FiEx2hfSR4uwG7VHi_8_qZAhyDnUq14RjYnsBuHypDEvZvl2kXc6xlEpHQ0O5i4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuZ-jNJUjIYccEefJHUoWvYMW8X2Wo_fXGB79HExfZ4w&oe=6AFC6126"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
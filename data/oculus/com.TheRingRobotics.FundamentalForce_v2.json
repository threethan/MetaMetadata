.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFJMKD24zXoQ7kNvwFZeJEI&_nc_oc=AdqIWf2tHTqoqG3tzl4w58EYrZpdQa32dDecDUP-s9sOZun0IXHwFwf5qh3B5I61ki0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V2KCde1dKQ7IkM3fm6XVhlSJAQPViqS2PSxQkQmvtfQ&oe=6A258778"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iw9HVF2DGd0Q7kNvwG4GwVm&_nc_oc=AdqsFd4vvNzUPV4CNIJpdx1JAVXXLZMFPLdnzqpdQIRwknXmc_702rFYjdn43k-1BCo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fdzROE_Uv4ThbUME5qTJQAYe5UdqGUpxm9pqQW4nS0g&oe=6A256E62"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPIMwFkCXMgQ7kNvwF9E7pO&_nc_oc=AdoBRUNhDsyFsWfIx0MYP0uYZBywIdVdbiTuYaqq6Er_xGGwA69OXCSy-0NLvP2PKZ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y4z8-RJyp4Hho7EZXXyXUCeWXP7j8De6ZdEDN7Qf2NQ&oe=6A2592AC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj5qe9F1i3oQ7kNvwFxGCPm&_nc_oc=AdpajYtBxEgh22iBDo75UVxHBSa5ivKzWrae6QxjJ3z0Wor9MwOutJvimw-1i1ouBT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UpirUbM91Dfvd-rp54_MHyNaBbeZ2SpAOd7jZutG1zA&oe=6A258037"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qriUvVNMFFEQ7kNvwF1jlYG&_nc_oc=AdphMYgep-ccgVL299OqFSG9uzRB_XMcSqCEnx6xs6uToTEbhuDa3d8gVnOg5TwR9Hk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wCBr2EfkCpqXCBt6GLSEWvkl-dLvBvApRxLRYLtKCwQ&oe=6A257888"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1fIg4qEVrsQ7kNvwH0JU_8&_nc_oc=AdoJ9mlquG34kLf0PTIZQe-eOM927XLe2aUl1uQoOaKI5XL-CaU9AsU-TwHwdssQY2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uElPGfC5D5N1C4OyjT5FoHiFMOgxDhiwlyOeLu-_8lg&oe=6A2580C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRewygrs_fAQ7kNvwH7Xvhk&_nc_oc=AdquRbw77nWfhKGiqm-3P5N4SQV9V1CYiAT4zeiGLm9FupLVtxpEtXtP7qRlKQcEKBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FXwcoP4rev0mcZSPpOZKKUjSxcK7x0MTZYWM22LTfxg&oe=6A256FB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJWf37Kj2swQ7kNvwGDL8_L&_nc_oc=Adou7sOd-89k5RuOouTGJsk9TuFIfjXDrrGy3ufx4dQ_2RKLt4hn-Jeb8pR_BpE2Cfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q8ej_RZm3ueIS20zDXVgiOM4FsqPKF0-uk-YmNOyazQ&oe=6A257CA6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculus
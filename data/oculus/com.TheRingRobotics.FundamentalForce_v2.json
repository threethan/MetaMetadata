.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIH_gM1G3FwQ7kNvwHxXLIX&_nc_oc=Ado2YNRLOXE2zEnGK28NbSG3Be8kvin8VyYM5c2KkJflH6XhcXs1EsKAm3J-hlVWXRc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsojzbn4Tt5E0UzzL18ZiSeBt-r2xw1q8BtvBBH_ZmFQ&oe=6AEC99F8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPq_ThgTZxIQ7kNvwGrAE6_&_nc_oc=AdpPsO34GBzsFeV9vkUoO_WOyhnD_oJbNYDr8uoZXNBcvJYjnf-4DTYXiYr1pLmICH4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT76HyvDV1FEWaA3rigb5LhrY-LRZA_hLtK31Er5GBPMA&oe=6AECB922"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgLaM-LDqOoQ7kNvwEkeHhR&_nc_oc=Adq5azNpjwAWItsWO7ICNNGRzAdsgX_Edxc0trnOWTNGD2qsK27-xydAHOp5MCiwwb8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpJPUDXTaOBQ7kSZ_8InaUE_BYcXmaQGfY18hFqC3tFw&oe=6AECA52C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzxM_cjXGscQ7kNvwHdEXuW&_nc_oc=Adrj454jHbCe_BTfdgER6n4WcDVHlKG2FJwOvJfRLU-bqPZv9zub3XbNsknDt-oht1k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz8emHzMbDr33jICv1JGKrBSRTQMV08F6HNGTD4_Dr7A&oe=6AEC92B7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rI4S8yd9JzAQ7kNvwEanUpu&_nc_oc=AdoD9Ga24UAZygsaGouL6bqQUZ0ZlBwzmxuLqVf4CZ3OhDmFBgpQ0fC8h53GixRS_Lo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX7m3jp8ySzks0N1l6y5VtDN37I0tHuhrNlf82fJ3MvQ&oe=6AEC8B08"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkemJ6CTqqIQ7kNvwEBkpFX&_nc_oc=AdroW73q_k2e4nCu5iSp1f9Z10SAULLQ00ByqTta2eFHtaak9Vf5fhWRuDMwcPIG5sc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTseCNc3JC84WGrU-3kjmPgeg8tZ1dtcxomwzag4glpPA&oe=6AEC9346"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkS8AiqhRhAQ7kNvwEctpfa&_nc_oc=Adr9R_--Golni5zmgp9BMPHoLkdh6qHSD38h0hX3AD93lHLLo0tdqH2YBHiLhnzyguE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT34LXVjzGMF9ME_MAzB5UCW_t67UxqGjFNJ03pWhTs_g&oe=6AECBA72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-CHAiqmaogQ7kNvwFaZEKi&_nc_oc=AdrqFqrU6agwHE5nS4kvJJOZKXaHfbey_e5ptAPU8v3GyHQG2T6aNBUV5IzuRezZrZw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-0XV9i0TSzKQxW_RDpTSQZ94S_Xr5Mp15z3mDupzzIg&oe=6AEC8F26"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculus
.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQ2_JOAKc0EQ7kNvwGjtSXa&_nc_oc=AdqOUlgVKXwlcfTh8Fu-ZOdrlmM-KDR3qHdViq_F7J8gx7MrdODPw0-CxDYuC0mNkaI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHmOr9DAHSQ-qUsShoTEzUFUbcPh7Cz6bEvn74POixYQ&oe=6AA568F8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs3bEYIneIUQ7kNvwF1lXn6&_nc_oc=Adou7y5m0CYLyyU8YV2P2Zn2xWh8zKwGcXgqeaCW-PnLJGG7-yEHlAoj6MXmXL0k0aU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKiD3kg4J5Rn__Mpon1syqg4rMx1xuy1wLeDt7DhzCKA&oe=6AA54FE2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tr1tWS0HdnsQ7kNvwHofzRM&_nc_oc=AdqiEvQd3aa_uaB7x-qgbdWgUstCQFuy0GoNc8CM1ZZi0sSEU0KM9fgvzEt9vP1DPwQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfzqJr1sIL9oPSRlDZXIwI8wesoK2SSPDdANE1PqGsFg&oe=6AA5742C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gv2-15N5_UQQ7kNvwF7JZ-l&_nc_oc=AdpEIQE5XINsYc2VuyJnsc8e0-c_c4DI5RACiDJiKzQ3Zdwig41If_t1txMYyWGeZ-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdoWdgdcE3T7Y_b9Y61y4f8r4sDqrEWYA-7SsrL2PH2g&oe=6AA561B7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppT1PM9YaC4Q7kNvwHTG5rb&_nc_oc=AdoY3EdcDxjG0rHQsDKy_uAx9PDQyV6oZNXxwa8rSM1Aosgl9YPCiBRqgbzIg8APrmk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZaG-Con6hn04fNKnmoZqcxcqWezZPrx821-oKeZEOqw&oe=6AA55A08"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vo_OOoEAb3QQ7kNvwE0RPx0&_nc_oc=AdojgK2laxfLGELmVvVJQX09aDzjAnDcH5O4vgsWsGC2qi02uwBjnKLbyywJBUlcU3k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4C8jE-uEEp3OkK1x5Q1O1yJVqL6SXefvxZLSYbQXJCg&oe=6AA56246"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdODNuzOXugQ7kNvwGNLqGN&_nc_oc=Ado8g4Y2LCloTYbhm9dNv1wuJPn0zuxn4lPIrGNZuuFuEBDO0YgXN63QQzdiIm-GTeQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeMduDS32Qc9EjXyG4F8O4ANir49XKotEhPucbswceiA&oe=6AA55132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CeNZWiA56QQ7kNvwGn0S2b&_nc_oc=AdqUMqBWhoKtETJDV3Kglz-GAq-HHoBptjox-G5en9mc2L52NilP7PZA1SDASU7XWmU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7mIcw8T_LOlSOnP37lIwbMJ2J1y5fr3aEhQhCGP4ItA&oe=6AA55E26"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculus
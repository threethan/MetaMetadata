.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRSrFgP9EfgQ7kNvwEfdMI1&_nc_oc=AdpOP9o6BuQQFzkh877z-h42ac-MxJ6EgAJgEyIDk6WI4cDD5KCfyks5jASn0MAwIYw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q_yVv3kB9veKeP68C11LqsW-HJAcY3w6lbcMkzP1L5w&oe=6A37FC78"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2SlCWSewmoQ7kNvwGwWGUE&_nc_oc=AdoVKCxeNJ1_hFaU9M0dnv7QK8SmmB3KQ2zf_oVwnt-fDLLZbIpJG0yyBg6Z6Ie0D3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fqkB1W8MhbP6OnvEiWcEQCPrfvowGp_7ijNxOVbC_nA&oe=6A37E362"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PUhomgrpn8Q7kNvwHxo6ge&_nc_oc=AdpSNSBaajzHyTIUq5o7bkX9doCL0TIZtc-6iorrbChjBh1Xcw5OTSORl32hLb19ibU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Zfe2zIlgg158gxh717KEZz1_dkjRFvkUlrCbsbi_dXQ&oe=6A3807AC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iICmU900_lUQ7kNvwH27YkK&_nc_oc=AdprePhwWpF0EIuCdmef9qWrlndqzbmWiEtVwMt_ZdGPKgV9TKrLs9BKiDCRBigohfY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8__nTqvqKu21RyJShWOBWTL2f2m_03kKK0c8Thnfqraw&oe=6A37F537"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZLw_MAd-gkQ7kNvwEdCPwh&_nc_oc=AdodgfCl-vZe2ssSK5lnCb3SaE3cN0r4AklD7F9boaEIkwE7Hp68nDAj4fCssNe9y4c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5fT7TtR6r1cHZpwvuoWSa4bVfAQw_7unHz631iQhxZg&oe=6A37ED88"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHQnm_3d42MQ7kNvwF_c_XZ&_nc_oc=AdoJh2S1ECpwKs0S5jZuLSwbSXPaKTfQOAPPA7A8Sw3NeWYfucOIAqqnqwm8tLaFsuE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rhHLbLuvpxmfN8DQO-38v8cJmM0eLyl1pNLrPR-T5xw&oe=6A37F5C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bB_K4W2FOpoQ7kNvwEKGjod&_nc_oc=AdrlIvPlMNxuRNx3DBNqE44chRlOwzT0kXjHHjh-KPCDISquwbqCcMx0LlQ7WZepNxI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gVM82hTJoP4X163ovaBhNH3sHrbWYZxrSTgLO18Ptdw&oe=6A37E4B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G95V-UMBocEQ7kNvwHToYkG&_nc_oc=AdrZ5GXO52bIRcDUxXnVTSAtoUDLLI3zphbJeP06qfxd3zdyrtD5W_GOBj2e8i1HZvk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91iWLJbd8VwjD8adJP5evzChbbBCL0PhwdDuJ_vEzY5w&oe=6A37F1A6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculus
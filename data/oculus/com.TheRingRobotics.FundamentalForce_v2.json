.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMxIghEDD44Q7kNvwHH-ZWc&_nc_oc=AdpGvlmprxjORIDi6n88Uc1BnVxuiI1dXEOUTCuagl7b_20W7rcoQe_7yz3Cp11Q-_I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IKAFKHL8DbVptoRzJLrXinqz2rzPEzCW0oyBTKUYIug&oe=6A4136F8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8Z8sVTQWB8Q7kNvwEqZ6xF&_nc_oc=AdpO2ZZxEJ7PdbceUm-61CG_INK8K0_GjieteVtA1sUQhNN-hUGvbSFmtEZreUbLZMs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aJvCgLHuV47J6i7pCwinORj0nKcYVkCRHcF3FFn35ig&oe=6A411DE2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_I0N-I5wJcQ7kNvwG5AscL&_nc_oc=AdqqIdiDTLvDtKk9WH1q-wiufeTO92zOTAPheKpDWkjj9KxWUzJI7hXx5C2flE2rjuY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xkHZYS53g9ydK0Xf6rNZKNkHFx9igznQc_La2nU5ZLg&oe=6A41422C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYamjMXI5skQ7kNvwHYKfFi&_nc_oc=AdqlKV8oZRCw3lO8xvtkkO_QchniLXDwDxuGQiTQxZ23AX5aZKnxHz5adz9wHbafxLo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8A6KvBz8wxytYjRC4IAExq-thr5FjAGP7UbY8G_f84FQ&oe=6A412FB7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FpJ4HWL49EQ7kNvwGlfVsR&_nc_oc=AdqLpTKcIhYUK9PjOM2s0pQa4ZBn2sBiP3Fc5a_o0rid42cKNcNwv58m6qUVik1llQw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hqkPD6OR21hXVb552mLL7xrVSOTrrTRTvJhgzDZbLag&oe=6A412808"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ezg6x_4PbdgQ7kNvwHu8dGy&_nc_oc=AdrYKaSkso3uV145ZwkbRgj7kakzeMdSNB2ityfqblBBvdOpibn3R7CEf5_baeB_eos&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5IubE18sM3zAHuW-cokr4FQqVyMfVQjzrYE4tbDkoxQ&oe=6A413046"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehhMxk1hBloQ7kNvwG7PLbU&_nc_oc=Adpw_AC9DDch3w2BN32ZjM5AcyWelrzBoTUg7b9FIJwmc8N9NJlaApfAWh-2z3gcp10&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ayvy-Bkke90XNIjMCnz8uNm6lM66QwDZ3P9Gi8aKHVg&oe=6A411F32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5p7Cd8-zRacQ7kNvwFXIQ_a&_nc_oc=AdphjDrbDCXIKz7lv2dQ0Ez-TdzULd_nCnWMjtbKEAxxJG0bEqDSijIhPnqxRhkiqAQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8O5-5C_ENMziEwC_dn0oVnyXypfNlUboGyJu1gfUqhJw&oe=6A412C26"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculus
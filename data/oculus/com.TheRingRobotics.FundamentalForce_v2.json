.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Dwb_UfK6aMQ7kNvwHPGVzi&_nc_oc=AdqydATSRfRFOgamAaQHX3kJ4M1ki8_paQQSZfgpUyrm0CpaYX80GueW0rtpXcfHs5s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSmIT26WM9i5xXaqgA9euRqzKR3mRS_kgs399BKKxnnw&oe=6A734FF8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9r3lEyG_VoQ7kNvwExZOO3&_nc_oc=AdofOC4QVao0ZjE-0qM0QDxW-VFlFq0BQBIZP3__2_XlhMQp6EJnH4IXfBXvkuOxU9M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf4Y1iaLm96FZVjq3278AJ8PMun0Y9Tv1L-Y_jFi1ZGw&oe=6A7336E2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7kaOVkmEC8Q7kNvwGy_O6D&_nc_oc=Adqudjzjl1zl2xiL-WmlRmWbns3WHxd5eGH1HQofXELOiq2oB_jYgEqeJSjWCkHsx2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXugZD7Q9NGjlFaXwfN5A4GAVPDXUBNpmrNivhIv-Klg&oe=6A7322EC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qwxxy5aiNWYQ7kNvwEivXX1&_nc_oc=Adp2F9HIZ8SbxsqC-W7SihaiWAXvzfyq5IoZcJfjE6oFyuUInMLEpRrKdotyBSHFAXY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9hL1HB4dWt8rAQE7ZliBLGDHnZ1YlL-uBplMzfy9aNg&oe=6A7348B7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMfuEJ4w0cAQ7kNvwG3Wmem&_nc_oc=AdpHbW24XiOsHFosmrU9PLSkOPaOwiCONQXtA7IXrKohlk9VU4zTQA3hW0pXgZDvosU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ4gCVEeD7kaUSZ1bHkk_8Mu2wHTLokSGxegulIMOCDA&oe=6A734108"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TDt5NnhhfsQ7kNvwEuFsfq&_nc_oc=Adr_HDz7S9tKlyGTiNVorQLMcpMN7F-udsQ4Pz0CMWi_BBZ0Ne5i2bR0997M1huq6Gw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSEf4WcN62EOQxm5vdNChrUQgB1vKjfzGbG9QThuHXMw&oe=6A734946"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrsSBczj44EQ7kNvwEDV1n0&_nc_oc=Adp6qlXkfEHQ0Dxwfw04DwSiC8XMpGNoZ7gIVlgp3gxy49XYHSluA_qeB9P_paP8dAA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKaoNM9xU42F1WDRZGm1O_U5C7C1STsqYal2iPP2UgEg&oe=6A733832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qkwdL5LWO8Q7kNvwEJyXfn&_nc_oc=Ado4Ct3iY77axBgvPQ3JVVTXBJSiR2ENRBURZHcSzz8oG7eR0X2vohRBUGlPMZ0a80Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGcgOjjXU9ob3x1UlJErSMdMNfJd5YR1jBgLbz196g1g&oe=6A734526"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculus
.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AG5koCvE7kAQ7kNvwFNjIkW&_nc_oc=AdpJaSxoB_Nl6uQD6u5ywdbiCG47LHipg-God1f5G0mAvAIa3g5bc977R9nmsk_gaWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6odm2GgXydv5BmqZPhBoQLnXm8SfxNj3zCobXngsl3Og&oe=6A009D78"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8TX45IQsUsQ7kNvwGGQMUB&_nc_oc=AdokR4hV6WVSYuDCjvLx5VvvU_M8i3X6z5k91iEkxfPEgI_pNoWk-cLulHJysFrE5Fg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FP7c5vuOR7C_2_5clDFFKVPhPS7nnbmkgjwsf-drG_w&oe=6A008462"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njNSpoejL_YQ7kNvwFQyasw&_nc_oc=AdpuyvjHcgNzYyyaWjIgs985mLK_aYmIhno7m2NBubUy8GN4fpQcf9HZ2rF6-hQqMcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Edy3ppFR-wHd0edgXxkCKu_4YTQM6vZuEAaDs3lGRew&oe=6A00706C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWZ1esGkEXkQ7kNvwE6jlsM&_nc_oc=AdqE2w_q4zxfXpwTlv5eHLdt2-IT3ky__VwMH865xarmvgqVV_JspjnOaWne62UmosY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BOyAeY4jGbGK4nd-un66G4aOJ4gB02mFTgloqEjBBFg&oe=6A009637"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_zthTO1PxQQ7kNvwGh26pJ&_nc_oc=AdqIcz4_yXEq6uVnX8s9EsC5qZ5TRTK70F46DXI7LnuPp8oP6sqq2wkrnwTwIiIoCOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jb634PuQlfwI20LOAN4DP21uu3-DMu6I6Iw7LIXuVOA&oe=6A008E88"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8DuzNdtN6YQ7kNvwG9Cyny&_nc_oc=AdonuWX35X_aNC--YmYFgJUpSa6W0MeS7RJEWXVenvGFwuIltm82CThrSNuB3VRWtPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ihl1IEa3k8VQas0r-FMtHdY-m1WHTEPjgNpcBD3-1Ng&oe=6A0096C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJJ0TQTQsRMQ7kNvwEIt13l&_nc_oc=AdrKVxklPImv26V3ulOwiLWxOhZ4-RBSNbUbuF-q2fiBNjZk7SUg32d8aBAt_9Mmilk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Lq-iIpV2mLIFcer1gSTfLKN5wtW9WsTXVDi09IabJ3A&oe=6A0085B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv6Zz6wzQ3EQ7kNvwFi166B&_nc_oc=AdpWSTxBSGF0_2tELwuJqsbau5OzCHpF65e2hqr9Uw1A5kbFLd612a5MpKUNfXSc-Og&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LzkLdRbHaMSrM1L895pc2MNlBXkr0ICTPdKCRttu-9Q&oe=6A0092A6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculus
", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=To--JQkrad8Q7kNvwE1PcDe&_nc_oc=Adl7XTA1BGo_mGIW7TjSgWtVGCxPJT_U6BlPBgwqOou6PFLEyfwkCcP9_vVAHRstASo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfD733DgpC62sfJzjNZTxjdsUO5wizDp0kDriJedp43Q&oe=69B16A62"}]}, "id": "122201803184211", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGlucceIlTsQ7kNvwFZXpL1&_nc_oc=AdndOr6uouVMgoOQKzlppjWbg6YHk3JrVbO-GgK8fXyBYVWx1usa4GDfKrDwvWKxRaU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxKS99A_d38xA2KNacd953x0uw9bUb7fXSg98uzKzZOwQ&oe=69B1566C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSxLMcbL_uEQ7kNvwGOvp6u&_nc_oc=AdmOidi-Q3jynRfohYXQq6HqUVCY58AJe0yaNHLceEBoK0C2BfYmYFwRcaK7_bIk2Q8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOKvv2povTB7eSTxSB3bs6Iom7qCOnK4pW-HsS0rcUXA&oe=69B17C37"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgOJW2DMo_MQ7kNvwE4Y4Yk&_nc_oc=AdnJRGV4wmNShSi7EbPQ87iW8NU2oYDXZZivo2Z9OUnzg5u2Wny86nRQQ2jJaKuCwAo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTA0OsSwHTTg7EY64MEZIk94VV1tjrzUQZM2646Eu5aw&oe=69B17488"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rADnnphWYQMQ7kNvwHoDKr7&_nc_oc=AdmnJgvdrRTq-vzQS42f7lGMo0qa_rOsJCpNtKScv-Pm4b8KNRGsdpxp3fsdlchieZ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqFFgq7KNVSiNs1-a4rcKjFsnnULtjnyxlpQ6Z4mdaGw&oe=69B17CC6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRUx1yJFrRsQ7kNvwF_uXAB&_nc_oc=AdkWzD5oVgTWaoGcvx0klA71G4-rrmuhqzkdi1--xRNiwroyadZcfd4iyFpOnDUheoA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSceEaECGyygiisJggunQMY_rFz5KvK2gOdnZ03olT5A&oe=69B16BB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UL1FNS1Su-sQ7kNvwEpEGTO&_nc_oc=AdnM_pbX2Z-2R3KgjY28NEmuK85Wg8Ao_3dy7itiy5P6x64Xd5kqNMjA7AUAV-7wRjw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyhg1GoJ1bxpUGksLyANXhxdg-qDsVvJ1ErcJPFDCyWkQ&oe=69B178A6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "Fundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/74df57f1-65d4-4483-901e-75c434315d09", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://dniken.itch.io/fundamental-force", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "978156409785706"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1090770348471277"}, {"status": "PUBLISHED", "id": "411661066950323"}]}, "baseline_offer": {"id": "1090770348471277"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1663088400, "status": "PUBLISHED", "id": "1090770348471277"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8797499026942607", "version": "0.4"}, "id": "500850604628269", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6092508
.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWlAxW1GvsEQ7kNvwG0-T_3&_nc_oc=AdoTxWdECyKxQpZNkXpQKmbe68Ag6mY0hCctKQxmzDnwnBKB5jWqdGifmQz-_rAqRTk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCryvOXyZrxGl1I_8YiWwYHrMf6OZtslBYgRdb62PhVxg&oe=6A5B94F8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAN49-bpPQUQ7kNvwF4USfi&_nc_oc=Adrj7hxII4zriB7Z-WFiwFy0fdaGe7Bmi9Yet-d-v1Ku2eFZBiCq0FAshPg0NWkmSVc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaxeIkdSx6g-75WRfZS5b1B1C1c4HKheHGd80ULqx1dg&oe=6A5B7BE2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jmoITXIN6cQ7kNvwFO_3ra&_nc_oc=Adrm-OUSYsHBJbt4VUEB7PQaskd2x7p7Jkdk9bg8k7Z7s-8R-ED85_xtHqQclbJuy84&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGJHa5CoKjN772rN4Ed5onE5Ag-FcL5shpvX5ZX7RB3Q&oe=6A5B67EC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJ4GHFpGF0MQ7kNvwGkOfa5&_nc_oc=Adr8BD9_8Qhe7_g5e4mTNRyHMKb3i2QlOpWi1i0U7ubj1hYS6rIxw-y8i5zcuEMqZD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAJP-M2lhHvYvdugdN6RTpzU9GgVuGd2t855BC6gRMHg&oe=6A5B8DB7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjoWq_hr7jsQ7kNvwHFZYVR&_nc_oc=Ado7m64SX55l-tZopNODjILbS-kiXQXixYQXnKmgeSs10B0ps_iyLIETO90NbXsuOx8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDV8mg-EDcIWzi3RTQlo5BZoY3icu1DLj_zQOl1PHZiPQ&oe=6A5B8608"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVTg04wxJckQ7kNvwEo-vM7&_nc_oc=AdpHIEJD9yIOMdJShrab_m6jkwrCqrL4zqwQ8gRB1pW-Myz6t8lt-tWJYCGqfaN-ITs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEQLYIEZ56M0ZwVKabVbIum5wOHk7m8vvzD5Qui-_w8g&oe=6A5B8E46"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EAvOmyXaMQQ7kNvwH-yrjO&_nc_oc=Adoc7N3IjdiF0ymI8-kDuTMtZaU5m5yhowPCyKyyKaEUL4PEXHdR8NsIL9s1TxGJr-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0zIOU2WtQfe2wqAZFLrtZMoRE8jghCM7asN2ujJoyrA&oe=6A5B7D32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNQQ2CqvOqEQ7kNvwFrYOCP&_nc_oc=Adraca7ElYQH7fzrym1_-ZpFkHZi2hJuj5GhKATf0jVGs8NIJWqLenZ5xP8XD4Q7_JM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJv3XY-oFdzZKnAMxPoKZg2ckvSoKm-aVB4ML4VVJQtQ&oe=6A5B8A26"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculus
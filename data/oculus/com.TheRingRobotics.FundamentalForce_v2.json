.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DP95C8437UgQ7kNvwFTJgkP&_nc_oc=AdpLcO-TNT6Iw9pRASzcTHD1crfsHhOnZj6Ai7UFk-5O_OhYx8C6WR-sTxYuW1mDE0A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lsp_vSxJWnGLsv4VXR340VlHv5CvUZaBDideeBa4z4w&oe=6A1D9E78"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSF8loUkD9oQ7kNvwEuvCSj&_nc_oc=Adq4mHQ8gUUcyIvAOQIlRGi-NrQWYIgVbAq6Cf9trehTZmFYzFvPSlDBJS5nnTyXC8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66wnWr_jk2DPUYVyXpwEkIcKVngYkJFOzKn5nf4ko5zw&oe=6A1D8562"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVro7oe6dhgQ7kNvwHiM5-H&_nc_oc=Ado4xwyZ9S13psRUrvdCBumKjWb1MIk1kkNUN8clYvk4OLgYSQdwHMkdwU3VjYBwx0I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uS0vgfWw8U7KvccctwVUC1XJvYuO5ZdL3obnpClAVUg&oe=6A1DA9AC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8jXfRVpnQkQ7kNvwHVXbQN&_nc_oc=Adog_un3fr1WX7H_QrK7Hr2uXkSrTg18HlRQYQzQbeKdvrozEyRw8rG926iKFOt5nz0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vNceBFP2MAGJQjSu9wTe1pt5BqtL0JeiPDIVaFCKM4g&oe=6A1D9737"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eb0JqSyvgqMQ7kNvwH2IdsS&_nc_oc=AdqhxyLTxOoVNXxDpN0xu43FLEzaGuSSuJTYGSx2yHeX1q11DrURb1wJ5LyE9otApkg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jMSVZx6WzP6xshjvn-ARP5CVrVTEOZ02fetP3PfHsBQ&oe=6A1D8F88"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tH8CyAxWwKQQ7kNvwHAD2z9&_nc_oc=AdptkWyHl_fvkoS0g5ItC6s14AVJ8T0n6leYlVbeo6zhgDeVoaBy7HvUUvhrIqO-SZc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UHsEhpU7hxgwDQ5AB50m6e1Ma5PniLIkJF7SWToq07g&oe=6A1D97C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xtzy-6P32LYQ7kNvwFqhbMl&_nc_oc=AdqHi3Appiyz1KQcCHPzv5_hV6nLdCgej3INaGvrJpY9_QWkieStRLsVZk4dCCxTFYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4glosNhnV98BlkqiRcmCVBkKHToRubbSoZKP-rewtY6Q&oe=6A1D86B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ilJBqUGuX8Q7kNvwGMx-p5&_nc_oc=AdqE-lsb8xfIer19163aZZk5g12T_tGqjf0lyCaA23_poqRAtRSzjfOJv46fsbVRAwY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46acGBAfH__m4qKWXfl1CjHtb6r-t1QwtNfZM0_l9ugg&oe=6A1D93A6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculus
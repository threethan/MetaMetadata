t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVZjw6Fc0eW6h-04XH2WjwKP-z4R7Fe6tlx-nPXM1RQA&oe=6AFF07B7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1s73xtO1zEQ7kNvwHFmD75&_nc_oc=AdroazAGt1p2-3MLnBCotCuK2n8Ih_WGRpzLA_W4bQl2KTVGe-_VFGNDbQAr87GsAKU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMx-tSYBXKocUXHoC4Rw2fZ2H5FqCFsXB9jYqS_T0tQg&oe=6AFF0008"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bekFY2jwikgQ7kNvwEd1KR3&_nc_oc=AdrqepQURaJvJ_m_ZGeoDdS_Ki_iRka2zgLAcX9uIH6apH98mEiqpH3_Kuzv769BHmA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXcTTd5dt0VpgZMCoVVpcFNl56HS8wlHyWU7QCidu_YA&oe=6AFF0846"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRUn_VXueHQQ7kNvwFZ2o5J&_nc_oc=AdpOLbl4wvPX02klaw1NakHVdt78eOEXEdaO46oDjD7lO4M8Rpw1XGQ832ebbXCoVuU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS7410n8zMKhJ1Tf6OHKAXK1WW3AIkOQgeZBIYSYfqFw&oe=6AFF2F72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aNF1D6gjuYQ7kNvwGOU3Ak&_nc_oc=AdqJBBLfqxTL9SzkTO4YVod2MxAt9YuWRBtxemW_ukLmkYXOlSr4UjhcbprgQTstWwA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSRibdhlJHt59ACuam90M8fS8MnGfoVnkoWFRBLb7gAA&oe=6AFF0426"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
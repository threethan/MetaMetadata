.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AG5koCvE7kAQ7kNvwEHx5mo&_nc_oc=AdrEEyMIO9I-SEJ4teIUByEUZsOCgs-u7KYDhVVDvoP8sefN1g1fB1JpHHJS7-_XYFA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6USJ93-_p-0yK65AuIu2lfBZXrkuE9mAqaGSguuy4PPA&oe=6A01EEF8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8TX45IQsUsQ7kNvwEclQfj&_nc_oc=AdrAvvB2wUjv1esdIgB3fMcduiOHBOrzLaMPtMKQAVgZjH4jCbWeKlKGjcznJJhxve8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76QvF2LHOp4WxYRfxxH_DQE841cgH28y63fD_qVYRiGA&oe=6A01D5E2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njNSpoejL_YQ7kNvwGN8aqi&_nc_oc=AdqDNg4lef4QsB3PNGKLixuQ1VBrKbOiIKtgwrPl4IKHglcVdz2KZj_tBqXvTBbZmWo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AjTZGdwXU1BWkDHbZjjY_CXQFg5scdZspPhTlMyIUcA&oe=6A01FA2C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBEuQJ7ISZYQ7kNvwHaX1IJ&_nc_oc=AdoBxMw19fArF08tCM3aU_mJvCTATnZLM-V1V7ZeZ-fwGqq9rNDeVYZXMOpcmevS39Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5L-b8F2HyVGzYP0EaUEx-JtvoDovmUhKlgSrV65HOkPQ&oe=6A01E7B7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1HZ7nI99_oQ7kNvwEhACLZ&_nc_oc=AdpKb38c1TnP-PFNaHW0LT4g_MtDyhTdm1edJMFXIRRypa-af09daleS8xRhxtpBqvk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b-9NCV_5RkWo-DU5RfM__DrCqt-13YBMWf3KwATP8jw&oe=6A01E008"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8DuzNdtN6YQ7kNvwHLQMHb&_nc_oc=AdoG3-1i1zOGkwCHMAqYlsvW0A1OvfxwDhcSBxzOQvdOX4Gz9kZEGH-M94XZUnYBcpA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oHJWN346_NQqV5V3sAKmdkxXZvbSmTue9lZPHYA2ZVg&oe=6A01E846"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmDD-zEE3Q8Q7kNvwHiwD-F&_nc_oc=Adr6t00BNwb62w1VjbV9236ajfu779BBCdLUh0m2Y3g5L7abtvCP2QEWrwdZp_RfUnw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HtOPHf3jdBRf7DNgrREAdAwilPXmePGcp5G_5RRmDdw&oe=6A01D732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv6Zz6wzQ3EQ7kNvwFcGQgd&_nc_oc=AdobRqziFITXxgas7j_dRt8kUrVak0u2fHoYlDnci80KdtiTVJZWcPD79-sMwSlm5Zg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qNQK0AqgvM4O_rYM2P-pEpR2myIAkrqQX1Alz5-txUA&oe=6A01E426"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculus
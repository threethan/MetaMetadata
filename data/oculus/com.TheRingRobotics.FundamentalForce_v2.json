.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdDcQvuKA_QQ7kNvwFcQCAc&_nc_oc=AdoERdw6Vs9zQ8fheC7fbAxW2nhhsc3dV3rVnWc3qgaRSnXooST-cDs3M37iqH2icA4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnm9IFtKJL8ahqgdE9hkNBkzOc9L5lon_v2fld05KqPA&oe=6AA6BA78"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezVid39_bs4Q7kNvwG9GjiI&_nc_oc=AdrNf9Vn930fASt6nGylH3O1X5aQPal1EFYpmzsgtPvB4MRS0d5MADbNJaIj7IQMMc4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn62cxacm6Hs98T_K3S456LjHIvpgDm5LcJlq-fHrpeg&oe=6AA6A162"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tr1tWS0HdnsQ7kNvwFog6PW&_nc_oc=AdqKTSSHXk9HsgmxR43m9am62pHbITwXXKMEK_vewtl3VXxg3cauA-hB2pnOhKyHc6s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrX9aCBObf66Xk23EvmY3v_uifX-ehp6w7Y1FzO0ALgw&oe=6AA6C5AC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gv2-15N5_UQQ7kNvwHRav-p&_nc_oc=AdpfERM9TT4Z3v_bbz3t16_LEEquXJ2Be2bIrANXdQO5ve0zi0ZLxD5dobVJw9P_oeA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVrYz4a6OcXuwg4dOm1jkDnGs8DurlZzb4i7PVNh76xg&oe=6AA6B337"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppT1PM9YaC4Q7kNvwE1qEbI&_nc_oc=AdpYffRpRZcFRxcnILbbQDI7ItMs2Yzi7ZTqay4boZ9voaQrWWFFMHX_RIZ8mLhaE1Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILsVh9FdkJz1SqfeyeaURX4OV-FHgeDVu9N5RuCeenwQ&oe=6AA6AB88"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4HecqSXsvwQ7kNvwHhMdoH&_nc_oc=AdqlVhYlVIJZYLZ3O2NDPE1d_BIC_WqRXwsCtIZodN9JFxVc0rVridwRAvcqbJGTHpE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgDHCVULEsY2Fxey3GkoOP1Jrf3FHzWp9Sk1bSEheZYQ&oe=6AA6B3C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdODNuzOXugQ7kNvwFmR63J&_nc_oc=AdrquJCYfNEy3Ge2DFoywX0irA7X7WkMnYcX4xSxWDOJywqHx6FJNxsGNZHyVQabfzY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEu5DS3sUxTtbBLn1MwYh4ViNZca5-o_JJdYQeirvlxQ&oe=6AA6A2B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CeNZWiA56QQ7kNvwHuMnCR&_nc_oc=Adp59K0wHNlj-9ZI0gLLQFxPAcqUZJNaTXea-L_lvome4P6gTb3gQYl73ONjX7quhuw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0bxbiHtPIiPhdOD7LmxTX1Idt9Nn8yDA4cS9ZQI_WrQ&oe=6AA6AFA6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculus
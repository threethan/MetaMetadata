.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyR90JLdcKcQ7kNvwFd041R&_nc_oc=AdrSF9vfaOV0Ml3YHXFNzSOAaCZCe11RXR0oAPx3YE4cikM3i7JwM45clUxLki9mfCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32-xE6okONowXTXFbgRxTl_autyDtKpoHUDKgbDLmwGw&oe=69E0F978"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WiQnQC0UnsQ7kNvwHWcoyW&_nc_oc=AdoIbGtoGZmv034KesTbHtOl3KiyjTpmKkBFchoeSJozn9JLzVJYjccvJycm31rynak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FoYdGRRi0ZWKpg5n6vKzvkY6-jRr1ojurhWE8Mj7DAQ&oe=69E0E062"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APkybP0M4k4Q7kNvwEeIex_&_nc_oc=AdprglgoqzCAOeyR20ODE-HxXo79DvVpbMxaQhM7V_cOpJ11j0Esy4CMWADM1oG1dtQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18a_glCzFYDT1M1grtK_l-9VCqJNYzueHbILO2o08HdQ&oe=69E0CC6C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akhlfNUmxBkQ7kNvwEgSv8D&_nc_oc=AdoZsMyyeJr8Q__n0spPzkzLeAKY2swyuvyy9MO-_nPI80mWBDHD31CjQoEzB7tTT8U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OeM4AGAhdd4UMaFLuyjmlEUf8w6CfoHpcrLtodSeVlQ&oe=69E0F237"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZ6S-ZGgOMsQ7kNvwGtmmHB&_nc_oc=AdrU_0ulBhRH4l4GgQbDuVLdlTqJ6w5tgDveNiuaWBDQZlcB7HKYLQd3nsmPAZula1s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yb3JO9HdhpE9Yndpj4Nf9yx7mMpFDAA9a70rbdekXPg&oe=69E0EA88"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1MyRkei9wMQ7kNvwH87141&_nc_oc=AdoLRtjsqiUjDdqyRBt6wzYQN5wLcrguHnyPtTGXVdtergwoQVAU_p_cLyaJpSyigkI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af219MTfxzp6Ud8Ed2QsgG7cPQZLwKai1VuvUJeWQ8ffCw&oe=69E0F2C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RBoBsu5wmkQ7kNvwE_JhVH&_nc_oc=Adp-EyYdxsE85RjWe5w_DbzzUN6FlpvCyroEl9U-ha8nzPYEAQg6TnCle69zXZbtVoA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36g0WaMDxq0NXeHggoLz9IEzpglZCO9kQ1UAy7uGYbqw&oe=69E0E1B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0_m7FgUNScQ7kNvwHjEXeS&_nc_oc=AdqE46oGriIHgyswGxVTly2L9enEw6462WHvaCmksy5yU8qDMSbFo9d22haAfqXMLdY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ion6zqfh0S-kVm8P2ufcFjTnyh9pHMFWt9d1mvepQCA&oe=69E0EEA6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculus
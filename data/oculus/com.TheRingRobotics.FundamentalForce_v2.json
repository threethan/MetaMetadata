.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0viX63AQRq4Q7kNvwFwi1xN&_nc_oc=Adpex7BeOSersOKBsCUUghuNzF9cJ68vDrgFq1p4tunZggNM-22RfjwGPHBJkniV5fY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6pCO_9aCPtwxopQwuaw8K_2YSexjtCRpUtnr7SF_Upg&oe=6AEDEB78"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEz3So_mhBEQ7kNvwE2qkXd&_nc_oc=Ado90dOm5ruTtrwxedvsv4CLRMKzdVXSrTpiuY2aTwxc9rjhiEHBPQRuHReDCELmF5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa8_0rJd71r0uCHbLaJ8bU71iLh-YpCO3eD8En9qmDLA&oe=6AEE0AA2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgLaM-LDqOoQ7kNvwHBHlJT&_nc_oc=AdorpKYoFJYhDdW-kdp1264oNCZED8SfAjN6DsN_4E2e0zQ0VGYShrDx-oki4-xJO1k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAv4PSRVPqwMoncKdlPewoWRwPAf38JS1lrP6aK3Et1g&oe=6AEDF6AC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzxM_cjXGscQ7kNvwGV6KVJ&_nc_oc=AdqIH6rudXXa0_kwHmrwY-_5EwUK7ukyMDEIWxRwAO_LzWl1s4c5bME34VFupXKvnCg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaMf8Y1D0NfoRMvno4XpoEIBJD95EhSYaIV-AHyPOiSw&oe=6AEDE437"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rI4S8yd9JzAQ7kNvwEm-Zue&_nc_oc=Adq_QcT85tlXNi92whjDjBTWwBooPOF-TMtEiKHmA5MILjjIkgFbyA5MC3a7bjRS8Kw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq8QTMYMzgbzv3fSr_WK6wTDBkCTycexWQwI3ATMw4kw&oe=6AEDDC88"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tf2PiKNfUBAQ7kNvwGe7Oo-&_nc_oc=AdoBunWuU-MkiDn_OvbZxFxgE_TMYo4uaWfdw9-yrEqa_Af2mnC9OGAbZ5PMiGWcVUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxmdr7N0x_h94KS1xUEh8OSXeM-z9hUEEGU6fymn3fTQ&oe=6AEDE4C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkS8AiqhRhAQ7kNvwGUHeRV&_nc_oc=AdreiCHieD1nsUe_7dLqeMZ9U_Y4KoZUqmaQ2nwdOGTp-Ofr2v2LXnTi__HiGyERaXo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZSH0Qhj_f3Tnp8DLzs3Y4w9_ag3wUz3laf9SuFNsCPg&oe=6AEE0BF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-CHAiqmaogQ7kNvwGZ_IRu&_nc_oc=Adptp97wJIfeTmv6ffdzRrHRuhBtCcNCAIqZKkP_S1pm4EX2_tllXl0uaDSsizLM_vs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOfy-Kid6YlLaFKAi82_9gSC_pd3RofHpJShOk10u_Ow&oe=6AEDE0A6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculus
.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3eocIWZHkMQ7kNvwFsEbA9&_nc_oc=AdpY22kHfnJlaO8vtf_1Sqj3f8_WhiMb8tpN_9600LJz3ZODHMp3whpLvk_qxxbxUG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zud7p5e_aV_ESixwqzU5NzazoxPJprXkSZocgfzotFQ&oe=69E4B5B8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n358_ZLKd74Q7kNvwFsmmuI&_nc_oc=AdoGqq8AaYaihk1SZ0az_qRLz8pv14I-SY86YdJXouoxTN1k9wkckqlV-Ltf45wVpXg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZFwvgWYsw9-9pfTMFMl-95Op8jxL8rnnG5kipIB97Mg&oe=69E4D4E2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80J6o6Wg0ZcQ7kNvwHJbSyE&_nc_oc=AdrEuGk1nnsjklQVrizsGaXrS_exXYGkZTCDZIfFcADYD7hFwjJdxX2-s3aly8zyrT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uYE4ntJGjI-AyDjOEfKUjU9x4qRORrDhOPiMlYAdv8Q&oe=69E4C0EC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0alY0j1210Q7kNvwHSzlS_&_nc_oc=AdrL64xodL7G1X2cJI6eNthANGdv6Ty-QwBgKiQP-uIwLzHHm5SOSYnxJkIv6ZLbWCc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qnmCU8eHdCjtcuKN5Tzadbivcbrc06tL-lCMVNUDldg&oe=69E4E6B7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SVeb4Tx6lIQ7kNvwFWMzvf&_nc_oc=AdqkGei2KK6MxtLnOuhy3sb7KhWbEVicAHvmPA0yiAXy101vF5sXFCwK524TkuUH3Tw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M5wIHpwPTSA0UfprSB4VLoCOpIY3X5ub4VvjvDwwX_Q&oe=69E4DF08"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQ1DcgUaF4cQ7kNvwGr8ZCa&_nc_oc=AdrHqg82UUxi_HLa5O2kjKrDMOXDGa282-dG3IFuaJetijAqS6tkxb2rusi3VJXqPFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3opdAmdk2hrQ7KDuhJ6CGbDcusN8fYGIm1IRejO8Pt5Q&oe=69E4E746"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTFPz4gKLYcQ7kNvwHfsbVZ&_nc_oc=AdpTjBAlZ0bjgmuGJq67nVy-02DG8d3euYKPQyC5aGaHo0ZAevH1nlWucTuzW4fDV6M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tDkIcMcm5xrbL70kBAXMeHO9E9B_OgG5aW9x7Q_JDMg&oe=69E4D632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBZuvBl5DRsQ7kNvwHzb2U1&_nc_oc=AdorRy6bQxkYOSrwrFnDibHb2Tt9c4300F1r9P5Ny7-jwBp5jXaWVActQnwxt8WhO_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dG7piH5MnRpxjMYGgqSuAQhWrk9ms10gU2lXXdY7nBw&oe=69E4E326"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculus
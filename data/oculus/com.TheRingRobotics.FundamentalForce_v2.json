.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaTuPDCcgIIQ7kNvwE_Vi1-&_nc_oc=AdriaYgzHzbGwkJt8FAXPrSOjPu9ZL-V5RCdnBVyw3kmvJpQOD6Pz_efKFP52OArCjA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWx442HrR-xKNXZKzq0JnfVw1UMLJc151v1bu1wroVaw&oe=6A622C78"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBKKYA1UEzAQ7kNvwFfeLpp&_nc_oc=Adp3yx8F2kw-o320duecOYG1fvdSwuYxwEDcHyWj01F9IA9ld3DBex-8n5wjAL1S3Nk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCA_GyZaO7TLBW58NTzwm99U3QfHRpSNGC_VtpMLmA0Sw&oe=6A621362"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zl6H3uOiZA8Q7kNvwFyXS5y&_nc_oc=Adpb-dtw_DlUKxAv0tKcgEtM2ij1nUdphAVGlBys5tG30aCuwX6qx83-GPekCTZGYXs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj2tNPNfHsUVAC-fjgaari5XFjuy0cSUOxGxSoM_kqBg&oe=6A61FF6C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mfe-S-D7wnIQ7kNvwHEiI3c&_nc_oc=AdqKeTPvYiQA2lQp20KatdKXEpuitKT1lJS9pEb_t7BfqLZg4jCqpjIuQnOmPJmNU1M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVnlooaEeo0Iko72kibV2rpoQv7ZabbqXqOI81sdRWXw&oe=6A622537"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47eCHvsA_GEQ7kNvwHIATw9&_nc_oc=AdpDvKkwcuYQdjlosz7aAE6Gh6udsn_ERzZKA1qln58_p-6cZCuE7C9vOC_WyxhC6vY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBH39Ym7Hbb5HuE1MR5yMYQCPIgfx-GEsNhtCSW6JkHeQ&oe=6A621D88"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGpCNFIXe44Q7kNvwFzaAyj&_nc_oc=AdrCy_6LDqZiV4byBxJmHsjlKQdpTF6KMSs2sOyhdAjb9GTqdN5zL95K7gFXr7XOqRA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7_olAnu11g5C7KMXpvsJ6LSEq5ry2SouewR_jOadS3Q&oe=6A6225C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ihLhmVX9GkQ7kNvwHhuv8-&_nc_oc=AdoAp5z95bXyfSwNP52I7M6miPTiSD3cEjZUw0vHdI8NzNVfEgS2vhBGYyhVj1h95V8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBc1N-F5t7BvvDEoiKDq4k1wPRgAoOC8XFDSFzv8DTgmA&oe=6A6214B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0z8Y2EZc2pEQ7kNvwEGqCr1&_nc_oc=AdonJpGP_pzdnhGkZQpQ3kax3PlNwV_LlR9P7_WfbmgS8uTcMEnCdYrFhl9N_tMXuek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu-5RugcWAVfrjYzf3mrmkXmL6OJAFX4bDkuA5xeqHcw&oe=6A6221A6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculus
7543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoAqTf3viRAQ7kNvwGStaON&_nc_oc=AdkGHLg9GW9Qg5Y8rARNJXyEuByzLRL7rhHxkrWWLMefVY1CzLkz6oMnTCT1BQ8qkmY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyMtE_WWFdAKEjJeSzuMdAj8IHSHicatE-apQWYGhARw&oe=69BD5208"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FP57o4ki1oQ7kNvwF5kaJi&_nc_oc=Adkeg3VZMaYbAQ8s-PhjtN0GBGDaFx01jZ-TO_xeJt4so1ioAQV-W34ytVNx3XusI3c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxoPSJn0Ci6J-eidee76RwMrjPNtpGNlZaZGOwLT4qNg&oe=69BD5A46"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6hNLTEV0HwQ7kNvwFEwvP-&_nc_oc=AdlybJvXE64afjx1AhkzrOYPVJvtyFVBEnasbB1_RdkaM_PSir9mzhqmcrHuYW7UW6E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvEPupflprrk-PfKCjxGDeL0WuBYQPfxiUuXzxNcpxYQ&oe=69BD4932"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLSeRdqTYpQQ7kNvwGLt2Cc&_nc_oc=AdnCZqbA2IiKgLaqQ2RPFRWGQnjhxrepsfNrhCXofKaTF_V23cl1L2lNNwL2_2YZlYY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5uFejH-mmSA3359-WRwLRWMO4tKtnP38cbxPHPrwbSg&oe=69BD5626"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_44583
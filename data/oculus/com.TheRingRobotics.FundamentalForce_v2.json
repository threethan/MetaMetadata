.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4nsfGZwkw4Q7kNvwEK0x4h&_nc_oc=Ado4R084cHDRexOPHlZgtq1buYepDebEaIAVLVr_rlhc1UOr9jjmtEBY4SaHJkJD7hM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRRtqD-7e-XG00CblVXzUMBXf1DRdmSfX4Dy00j_MAkA&oe=6A9ED178"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebtxStbmpm0Q7kNvwFunjhW&_nc_oc=AdpOGwTi2cp2g8-QCU_MiLnb0UzOD0yL6hIgVyPz81UeadnqqoLFeyrLx3VHfdQAEE8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdArH8VDz-5zB2GoCFUB7uJUzmFXIAxFddxxtE5fbDmA&oe=6A9EB862"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmQvLhc2OFMQ7kNvwE-CJAm&_nc_oc=AdprWRqKGMISY_kicugHg17PMDQKnqPWTvdvs2h1KlTuiiCm8oB4pDidZ7g-sxv56SI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFkngSkULn_B66MpQGrYUk8iNYrgu0aNVfsjFBmzPdwQ&oe=6A9EDCAC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5L0-xY-K2UQ7kNvwExZgbT&_nc_oc=AdoTWVKEvHL8xg049LUuwjxALTcJKa8hYWu7cU7PsdkAfFTRW5faS2xZRHX0dWGJqgY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVL-8o05jVk0lyMQQ3oWwbuMysgSTm1ZjYTEzOEBehYA&oe=6A9ECA37"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wElLX4J3lKIQ7kNvwF2sN3L&_nc_oc=AdoMlpDeeX5UzZNq4kOAhCs64sq7X0Wq8kdnWizTA0vvMTa1a9Bd7KtVknhnZ9Wk8AQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5kzcr3Kq0iq6mlIzP3bdiZgps8AljvUTykW38OmwLeg&oe=6A9EC288"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWUzW79Biy8Q7kNvwE5BF8B&_nc_oc=AdrdR4TZaOM_Lt2uFNzsP8GzFVBCfD3wAcZeWiEAhDLRjQV0JAa58a43TJf7ePq_vbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFE55haTeULU-sJIy1ObN68B_b2JqWRTtwHqf8qU-bxw&oe=6A9ECAC6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9_W43kycCYQ7kNvwHQRkjp&_nc_oc=AdppgJziohCxMtZQue_nHTpxuviNoaMe9nUwjEesLWVZMdVoPZRtRtA7P9kif2_FPUI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBvMhTMbFuaXiqRkpvZoa2mDKmMbnN6wUKyxnKNx1Ogg&oe=6A9EB9B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ob4ZvpdmW1IQ7kNvwEum7rV&_nc_oc=Ado_KN9EqwiH81lAoBjn9ys9ni5PpdcIINjuv4_ajZKSLwESCuzCsqCuPpLnZ04eopU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI89uUeyjVxzzXzkf0r6Z6K9_4tP2bzVD4XZfJNK8zDWA&oe=6A9EC6A6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculus
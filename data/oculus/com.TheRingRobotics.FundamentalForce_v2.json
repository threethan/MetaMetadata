.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkkGe7ao390Q7kNvwGP34CJ&_nc_oc=AdoEjPqxd2mT4-L-XatT9wzQXTFnlj61ObalFHA57pYY6PcqI6XNcJOQk3LRSQFJQIk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-qUMBKzEQ8kyfwoRnyHLqUx1LjjpjSRtH_ju-u7dVVA&oe=69FA05F8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6FIFX5nFeoQ7kNvwETFd_p&_nc_oc=AdrW4GCJcu0bqeR1w75qeYm2j-WwaAmfp1_J-iN5TBL4-dUhl3Ce-T-YWTRVrDbLw-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4F9zdYApWjq43EKVOod4EufBZtU0oSuKNlP2E2ArNRqA&oe=69F9ECE2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTu1U8mmtMMQ7kNvwFVVqit&_nc_oc=AdrSgidjviUrYL9SyXwf25p6dif-mi1JATSqhWaPCe0l30GMy6BQcp3tmopRwKVcIgs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gsBulo_kuYvhTH0xMaTdshSHoQSoTmqIy5aLh5WEKJg&oe=69FA112C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTlxOnNeS08Q7kNvwF9sY3J&_nc_oc=Adqc22L0VOP96Rovx84UJBrjpLdyqFhDgTtb4mQDM5a0jZIMV5gOKq-t2sI2fyL5ijA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Dz-swA6RjMUg3L2uJ3aQfJwZE2mzm2sfL2ANbHEhOrw&oe=69F9FEB7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wl37MP5xqt8Q7kNvwF1lm-1&_nc_oc=AdpYmDFLeQmxbS1afnqOAB3hOzCSahHnTpqfY6pxd9TVCZ6J2z9wBo4uS0ruWKJkrMs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lBSgwf7Pcw4fFfn9uW_nEHo_8zKsJIyEzNyMthRyGvw&oe=69F9F708"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUXm-NGz7aEQ7kNvwExP892&_nc_oc=Adqma61zstC0WMnVSOgL9zyWPjvkARg7xVraRK6teHmjtwxNeHE7MthOXvNca5aIzGo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5r5G-BX6SUdOh_qsgMuA7DQibDVYDFuqqgNuboFSfabA&oe=69F9FF46"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R358aAJDMOYQ7kNvwENbyUm&_nc_oc=Adqm_lvKoP7qhHSR4Es-AP2xYIUqTh_yaMl5L9sXNSgnDW1_JU4BWsB2pZv2sLitePE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7raNWaidg9deDYxdZYSc1N3JYmRfTf7tnnCevPQPCxaA&oe=69F9EE32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8z0talId0zYQ7kNvwFYb4Pc&_nc_oc=AdpmNtis2kJ5NCG7w-v2sUSbJLBgQZUPb5EvL7tzANEz8uqjT93nJxVaXdAwQsJWm_Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ioU1twxZ1Fci4HgVoNO5aVDWA0cLrTiNNqr6Ea1vFkA&oe=69F9FB26"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculus
/scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LW_awnuQd9wQ7kNvwHqlZlo&_nc_oc=Adr90x65fu7XMZZuX1haSWnwto_w_ecg26WP981aM0AtF6xI83HdhupYLlfQwx3xfWc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzpNEoJFRRCLPHLxPKsKqeCsU0eHbkG7UAh5HPaCz8og&oe=6AAE9CC6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TivdrNjTiKsQ7kNvwE8PhIM&_nc_oc=AdruZeZd-dFxBlSogEi-zh8qztfYqpfn0d2_B3UWYFxra7mW2cWQA1rueVeShgDpWko&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoWbsnl7lH2sjxos3fqQ4T5Gp9EKnlDIRlSsG1IiTSSA&oe=6AAE8BB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faknmqZWgboQ7kNvwFNBU7B&_nc_oc=AdrGjRhdBjvDMLqXMTXGbddmE6wcU2ep_MYcrSuRrG4ZL0j9lRXYJQJK2qmG5P6dR5w&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGtXJ-aOWyXEzTd8LiYjXvVBJeJZkshqUS4ch0-B2lTw&oe=6AAE98A6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "Fundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/74df57f1-65d4-4483-901e-75c434315d09", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://dniken.itch.io/fundamental-force", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "978156409785706"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1090770348471277"}, {"status": "PUBLISHED", "id": "411661066950323"}]}, "baseline_offer": {"id": "1090770348471277"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1663088400, "status": "PUBLISHED", "id": "1090770348471277"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8797499026942607", "version": "0.4"}, "id": "500850604628269", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__type
.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQqZqJqTNR0Q7kNvwGSRkaY&_nc_oc=AdpGVOB1H2unpoVjz5djctB4Qu-4fi44qfyO4FdbQSVKwny0D0Z6Hiu--qXK1_PRIUg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMTy18MVDZPvjTPnsRsgMCHoA3eyQo8xdanOwiAiIuvw&oe=6A998B78"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMe0iNXmPqMQ7kNvwGyvQRO&_nc_oc=Adq8oUCYR_BooIrHdm2iQARryzy_5ni1pLNQLDX__u4HodHDEqvanyjIP30xow1Xe8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOD-5PdErjEhEKdwZA8GrrPyX4P2dsXX88pYLY6_-YpQ&oe=6A997262"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSnHD4-keyoQ7kNvwE40nTq&_nc_oc=AdpmYhvQJL20vHarTs6Q2bRc-70SPBXYQdqs1VvXWP3cjnkToUD74gO5JERJylJtedk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIFOCTK0TTmwDNL6ESl-OtZznaoDm6cmEurvKFyLsaGQ&oe=6A9996AC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-QSZmqJQ_kQ7kNvwExCxdN&_nc_oc=AdqmS7GrMpY4mE4DCPgPBx2CXOvPJ8VJzV0ReC0JLYUknvpXMCWLjS3WoTGtyv0Xa18&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1G1IPyYshglSin1iZLN0bUVWENWWJLlYPzCWlDEySuw&oe=6A998437"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fINmDiVrOwMQ7kNvwHau0ob&_nc_oc=Adp-S6qnQ3apoJ_XBm59wdFBT8VIbtctX75E9HtW8rWsmKHt9HNFNam1ciSOpFrZNyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_rPZAVwdBG-QN1mYxuFuaeG6nqv9m8xryJxqFaz4MoA&oe=6A997C88"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAnQguTXyuIQ7kNvwFyRiyv&_nc_oc=AdpKvP7_5n-AIN9jKFNPbtouoG3ByF14bokIFTRllPp7UbA5I36fe54HazbLMW5s4dY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx1bzrTYaFBtuJN8iHX4tg-Dy2qkWHfKNbQI67OF-spQ&oe=6A9984C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1leLn7o--H4Q7kNvwGdwsCd&_nc_oc=AdqGzC6eFnBqmtvFvxMtlBhqDWNFyNiP69hxCpcpzZtkVG7q8W-qtbX_jRIMLa7CVEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkfB-LEn68B6HRhNAD2_f281FJtnk3UG5R3p-nxq--jQ&oe=6A9973B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Tn2aRN4zC4Q7kNvwGVL39n&_nc_oc=Adr9TDNUF0-XRFUezrhFRJKNJuffiuSicixtI_XAbkkF6rfqqdxY3qxJckzwsQjNut8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQ552YI104dK8-QTsUK-8FVIljcgI5Ka_kBL0cR6qrdQ&oe=6A9980A6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculus
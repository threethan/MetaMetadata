.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaTuPDCcgIIQ7kNvwF3QB9I&_nc_oc=Adre-poaMqA_fD4s_BQ7-qp0EVIx7BtXkRHFZayg-dvEukz1O8qw_ULza2zysBTrNuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCduHtVfAQD074pccwqN9dE9l52ONxD_4Q-yJFOPpsBuA&oe=6A5F8978"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBKKYA1UEzAQ7kNvwGeIq2C&_nc_oc=AdobvmlwYMCQoRGwUw_lMJ9O25cB-KWQC5ZJcZQ-bD6qPkDPM3kFga58id9KK5JRlyI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4Bp9NErVeqTkpC8zfwjNys6TOGxml_DmRHZ5VFRecEw&oe=6A5F7062"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zl6H3uOiZA8Q7kNvwGOSWaY&_nc_oc=AdqnrYZIV3Lv6F1YZrszCo2Axh5Kd494LUMVFEKliIYbFh2D0l86t-RXoXrDU-I0vtI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_LwHIC-0frMoxqAnLEecgDkuht4wgHDDuw8LBRPDM8A&oe=6A5F5C6C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hD9wJpJQBuMQ7kNvwFlm8xV&_nc_oc=Adq_KOC_4lTn0WVm4-l5MgqSzRAzcrRd1zj9yTXQC5yKUFG2uVC-UZSSuFZOgTcZFn8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0TvkVT5jEqYi15S22wyhW3nHYcHvfrtlyUWEXwOmpnQ&oe=6A5F8237"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtLVXXUIABgQ7kNvwHaPOdw&_nc_oc=AdoFUdY3f_i5yweBw6XhwgePdwKAnx_75yfcn8TO9KUWiya6R6IW8_n5KAjuWpFBJqg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFiHWuLY7QEJfTaWA1aN5mBcWYimEbhJ3fXm9Xc8M8Pg&oe=6A5F7A88"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGpCNFIXe44Q7kNvwEUg9mw&_nc_oc=AdqtXi65r3YuXa5BK5hDJNe4cVaUOQl_Mdmm18D09CXSXWnp-ZC0pSK71kjVn4Pvnxg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWHh0hR3mEWj3KzAxBAxx2Z1NiWWrrXyy_uIiHf-Zlig&oe=6A5F82C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QyvD-mWzyUQ7kNvwFAFRhC&_nc_oc=AdrqDoRQjtQvuYK0SZM9IGvk-Gk69BrvH5jBhPH4kDSlJXsT0UGamicaeIyBkhoLoU8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNwI7gBwXnoKkyg8JkVvaqSGiXeTEbafCzV40gbxhk0Q&oe=6A5F71B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNDIDcSXzGoQ7kNvwHyc1Ib&_nc_oc=AdrE3flPD6ZGq3C069Iz_7u3HG2JfQXV5SF-_gcKljhKogveQv4U_KNEMV2FCUOZpao&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4UW0KEgTK37PYQYnS05km6RkMzlSb1Nxa6e5pynDYLQ&oe=6A5F7EA6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculus
.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMxIghEDD44Q7kNvwFqF-fl&_nc_oc=Adp36bn4cnk2jSfoweC_paKegZFxc6ZcUtiZD_1itZrkEvv2z9YIOkcmtZJF-0ZcN04&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JfSbcOAuumRCDIgELv-0D-kAkbbelmhN2DTStX3GxuA&oe=6A428878"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8Z8sVTQWB8Q7kNvwGG9iHt&_nc_oc=Ado4wUZqn4LgtifMAjE_mA_hWRnlXETGm8kQM5W8fc1YMMmCcVuB6xwq1Hdt1fwiazs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vA4VzwlESRa-NKwnvh1iY8mtGue60Awsm2C7KfZMoZw&oe=6A426F62"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhIgr8-MwpgQ7kNvwHT_dYw&_nc_oc=AdpFTSN3yM8AN2n1UsvRjJyhMQo5sy774CnvL0LepMmgCNF9TqUarLgG-c45rXkJYP4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9F5bnRJbfihcl-pRB3Pysbat0yW9wv9hrZviFwo9OB4Q&oe=6A4293AC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYamjMXI5skQ7kNvwHUtkYk&_nc_oc=AdpJqAcqvZXlvinfNAUyYob-WjDFAJXj1IvpJqawSMRgJ4KYVNSrppyn0rUS120_pvg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gk3uynY6MoFO1rSghsFpgdnqS5whooRiQY8oeWPdGzQ&oe=6A428137"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FpJ4HWL49EQ7kNvwGyazSE&_nc_oc=Adrp0I8QN70x-1nE5x-sqWoOQc_VBqqhZMy2Tsym9vFI9UHaR7pibBQXSLa_icTDI6c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GSs2lkVkpoUFuZOXYrnYkfjTh1L6tZIJfX1ZhOWwdHg&oe=6A427988"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ezg6x_4PbdgQ7kNvwEquZjd&_nc_oc=AdrDYvGIzehb87NQCJz9Aqu8UlczdcMdw8Q13_65rYazjQS7kiPtUGqXU6P0oybo1Uc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zRI0poiQu42t3bOnHJoksOuCF8FHDSqRT21FGYTqdxA&oe=6A4281C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehhMxk1hBloQ7kNvwG3L-MQ&_nc_oc=Adon-gSnljC4QXLX7Usl8qywiGqHEp16wGIjCUx_cxfG5zlI-x-E4OOCDoVylZep7lY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pxxgWFxAL99mFVmW2RF3oUG1IIwErGC_GogYTdVjuEQ&oe=6A4270B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYcgwaJkLbsQ7kNvwFbidsz&_nc_oc=AdpuNuHyuXK4kZGsRtVdSUSJSms2rijF4uM-a-5qi_Be_jezU1QTJ6WJxReiYk8VjyY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80vRCjkhkaEkVVfEvTBtw0V5YXYcL2ey7QmWbiLDGB2A&oe=6A427DA6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculus
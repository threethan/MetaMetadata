vwG8seJj&_nc_oc=Adl16bIKqsOpzX4TPLYmSnGGTKcIXrYk6T3yIeyGnr8qsV_UEkfB-mlPhrlDFul1YVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsLUniPkWE-LRDjd4-kqJEl9Lsmtdh6MyYIjoSHloGiLg&oe=69A2F408"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heuAzoijBe4Q7kNvwFmY22e&_nc_oc=Admq-bk1KInHSKyaRZURuLNpfu5It5rE5-oiytGz-Ne_JJBAP71hbxcMoZKvBiDM2nM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftFURNgNviAPpOwurtSxhBC7x4Jz43GNnKKUJWsBqK4xg&oe=69A2FC46"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxbZUWRh5tgQ7kNvwEVgsaL&_nc_oc=AdmpmjXGQ_gnYNmKD5kXExmdpFsY9zpDNzZQd6X_3lZsnC0wdPcXYWXBYvDD53jnacM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftOuFT5HsBdijAZ70woB84RuNutumooBO3ngbJcTK0BCg&oe=69A2EB32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-2Fk8eHWhcQ7kNvwHFhljz&_nc_oc=Adm2W58toqPkO5MBcWVnL17cOnHSvKpvNYzbA5rA3uk8I4zFwAN8YHSRwtlMjUBMhw4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftt47wxVfUbxqHHr5Odwkv_dRElFYVYM2Jxf8rXnuEK0A&oe=69A2F826"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eV5jUGbYo0Q7kNvwFAVrOc&_nc_oc=Ad
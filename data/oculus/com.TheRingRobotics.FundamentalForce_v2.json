.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95hub3KqiIEQ7kNvwH-c7L_&_nc_oc=AdpcF4DnmqihK-L6ch8T_pjTcPUQZ6PXPZxviEX-AGJb3FgqoRjiGZcxJb2DmIkDMKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYu4ztwRAEDgT5x5ulC_n_RgBry0-DcskwBVuhQ5qbSA&oe=6A7EF538"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ss7ZRj5I2HYQ7kNvwHRDZlh&_nc_oc=AdqmboUSyuXwIdIeDep17GAvpkD5cw22UJmHlvFhUjB9_phwoHMqj0oVfEqZXAe3-M8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjVA4HeeZy_0HAQxQvU1XOG-l2N8q6Pq7Cqsp7mncCsQ&oe=6A7F1462"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbWQAiAHzBUQ7kNvwG7x9nW&_nc_oc=AdrW_xqGNdeAB5q3urwRRTsyM6KbX5iX15F0terWzchX9SanfEm6rG-aDo2fK4U0pBk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_hy-BytnXjA9JTKcochwhXK-yA2qG-FTwO5h8jHeziQ&oe=6A7F006C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzrRUnJ7pnoQ7kNvwHEQZLE&_nc_oc=Adp1FiZf0cpOYzgukopttigx68xoAL2gKuOdXLpTXDlLsi2S0MhVBdU_uxi3z0kHt_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtnMtrBrYxoQsT6G98wdlmRFhOVWJWXZSS9SQyd3HNGg&oe=6A7F2637"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dS70B355g8Q7kNvwGop8zM&_nc_oc=AdrIKY-BDkst6qeNA8AmcIN98o8eOflJHj0L2yCLOhnMoGFucTChS2UW8XQj2BlMtfI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQie2YDu2BW0VhBBggtyKYnvGE-ivC2bnxfO1Bl6z_pg&oe=6A7F1E88"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdsyGhK1QrMQ7kNvwGa77RV&_nc_oc=Ado0ptN6d7jbUv0duP3zEnhm4aD6h9qkR-S6QrOJe-n_DaSHFv8TeeFU_GYII4ROpe4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbj2EcGegxzZTfWPp2QjiMxu_OVDJIehJp-eXvmJpxvw&oe=6A7F26C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsA7H3LLcdQQ7kNvwFOFEy3&_nc_oc=AdohXNW09htVmkRnBtd7jhAJrqDDYOEb_dwTZCgcIH0usHKsQJSqgZZv_3ji4VTf9Cs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUL8qRdeLJtbgED-A2ZjsoL4Y32tYhqPOfuILLhlLi-A&oe=6A7F15B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yDr6glfbBgQ7kNvwFD-HSJ&_nc_oc=Adp6Ks38xQUdd1lnO7NkMRZlPyEkyQJyaAUBNb6e8VZmBdEropCMeZs6s3mR2d7G-Qc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7PkJZ2HxgLXoR7i8I19MfhKQWQkHFlgG3NMx3-uhbdQ&oe=6A7F22A6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculus
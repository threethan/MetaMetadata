.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhFvEin1NxkQ7kNvwEJxorx&_nc_oc=Adqv8R9IXFuXUehaSJRDaFFBW3TIi6yUdzWV-xOB7bPPTnOZiI5NRJc69hFHj529E-8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-zSW-_APDlaOepp48LvxtEuQeIbhk-iSJANcsbYofMA&oe=6A32B678"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8CfwrWQ-CIQ7kNvwG8ESpE&_nc_oc=Ado0kXXM2UAPrxBdgZNX404SSYTwyWo5PvfKjmkwGmKaFmVHBdxeOUG0LVEu8dxzSU0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9shKODzNM58BSVPMxoRLBNbEPT7_A5gbTTp9NrA8iWlg&oe=6A329D62"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDOp9m3pbxMQ7kNvwFD7j1k&_nc_oc=AdojkY3auwZ-YdesaBOPHieEi9aeY8B6r-QS1rWYsiBb6TGDyOH7M5wupJKhKn7M_Uo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dgLY8ofg31PSZstB-Ko8fYp563K-Nj815YsvdfKBAoQ&oe=6A32C1AC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHG8l0sNRnMQ7kNvwFXuPBM&_nc_oc=AdrRQJwHVnr9m5xw542A9Zv5_MPhUMcpd7r5ggtzNw6K8Tlv0DrQkyrD8HsCPt6z4dY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jeL0xMUVV5VnO_lPrg0tMSusZTkVf6a2VqjUskU3Txw&oe=6A32AF37"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue6gbEoyEJgQ7kNvwH7pmzE&_nc_oc=AdrvQXOo4bCTS5A0YxTrP3z4odioMEdWgnB5qgiUm6tg_GHiPHNq0M-JTPPrIAE3Rk4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GIQ5lUoPfVAUsxu4_Rx0PTxzMK6zxUgzAJPiQQ73Bkw&oe=6A32A788"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkvngFrIiE4Q7kNvwGB8g8G&_nc_oc=Adov1rcUB2kAldJ71ViGEFMyA_FGN22YFKCvyEQzdQjApRVUEMTDFpJtcG2qAirJlS0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hPuV3QvfHfsaEi6YV8PB6fuXXbCoFZvWQT06wxhnyFw&oe=6A32AFC6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNAiClLkSOQQ7kNvwGeBGwb&_nc_oc=AdoWmHHUE1GAe9eq-IZDS6X5J2Zn6LLyCY_zQ3OzIbVJG5salXOrcBAyYtAye559iXE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92fZX6vSLKfYNw30k3czhoflHQighRQZUzQdJWFVcaFg&oe=6A329EB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66xR2nhUht0Q7kNvwHdyu2G&_nc_oc=AdrhYjhJr2by4NUDzApfFje_M7MvmEINM9IBRNWVOFP3VxEh5sCjPoumspCxaBBJ-eE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EyutIjoN0MphJRH4vM0PXaTvOE0wWkmGcqCC8A3H_Ew&oe=6A32ABA6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculus
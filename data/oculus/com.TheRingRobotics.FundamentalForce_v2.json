.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHl7BKmbKDwQ7kNvwFZpaoE&_nc_oc=AdouRIRtrsDAN0KZ2hOO7sWd2Ito3HWi-csV8YepiallNRvLhXiGVCGWSpYQYq2wvxg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcXzTBS7z0mLkD_RQrCL6vX-PjIY4wb9fRKQpdYGrvXw&oe=6A916A38"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAh0a_z2kN0Q7kNvwE_8eJ9&_nc_oc=Adqbkl2QsVA79JiUyUSj6n9wwf_5ueZk6wajlnFopLVXPY2aSotiBdOIqzp-HuPHGD0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqYSWWntMeb7PC8QHtkClI2nvPCLCCGfdBDW1ODPXzJA&oe=6A918962"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJxbMaXZzOMQ7kNvwHnDySo&_nc_oc=Adpdm08-BslFMXrn_W_Rjj4g4mOYYBFHEhTMJDzDbk76xL0u8Vi7jhMFpn-Vuxq_I-8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENaidXxYY_TbJM2lERUAlY6jPR1Vr2fNULFGDNDpi6Uw&oe=6A91756C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhq9BMU12rQQ7kNvwFivv29&_nc_oc=Adrb13n0H9tKwzdDlKy2W-jE782z-bC_e_r4_oE1YBsUvlU-Z0smaLhY06LR55VSVRM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgjX5NS-lPZBQLk_31cC63akLwcSTNp-w7NqySYdQ-pQ&oe=6A9162F7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drbkaEI1XcEQ7kNvwHsAbKn&_nc_oc=AdpVwArwdgkxYYDZLhwOxfQkuBKy8ZaG-GcEB_53TGrIp4vUYtTN3IW_pmYCO4sEYX8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWKR70hR0PBan-Jz1MOv5GwGYOgVvr77yztrbmbLXhyw&oe=6A915B48"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzZa3g72d_8Q7kNvwGjN_yx&_nc_oc=AdpIt75hW7hZwWbnYTUE0sfVuF0eWNCF-Vm-JD1lNcdo8Ta7nrbyLmymp2ztT-q8QDc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFClvimyBsMT8hKTpKGnnNGLn5nuKPTyq2qHzTcBbiTQQ&oe=6A916386"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVizH88NVIwQ7kNvwHlflyI&_nc_oc=Adp1-SlcoT4ksXUnhh-VsY8BOP0dGFLzD6Stm-SXY9niJ8F9D1YQ4X1HzJTmRZ0p7xM&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGW3AHO4QL35nPBnBzo4XxIjSSZHuHDAeTSpXq9gp4j7Q&oe=6A918AB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mt3vMzjHS3oQ7kNvwGvJz8G&_nc_oc=AdrR0oUQsTF2ZMn77RYZtWytq2yTV-e83NRAoGU9SGvhNB_LVozLxa8ee-aCRavNMiM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvg6KuYEavHeHd9rjZjvMlEoQU4W1dNiStBApCvrYL8Q&oe=6A915F66"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculus
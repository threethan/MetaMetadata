.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUY8DIRSwZcQ7kNvwFqqJnl&_nc_oc=AdqampNDfBZd-Rzol1UyIt9xPolqaG-7tZaDOoGWET1D6yvckwZqr1tIs-1Yo-PIbwk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af473qlp1fJkCsCJyiRytO2xCp3ALUrzn_qM0adsaG8uNw&oe=6A185878"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlIxvl8zDYEQ7kNvwGVwkFb&_nc_oc=AdpFLewzIRRFF2LqMrrmizxIItt_x6iSqcHI91YNDznNmSOuIWkMgPD4pmtSPgkcofg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QxPPKa3ugFy1jTeiYClJmEI_Z5kRyYI4VMbNkzJeKPA&oe=6A183F62"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKsSABRXCm8Q7kNvwHdMmD2&_nc_oc=Ado3HCHfDZfKEyNDFcEOF9MBgMCvORDCACPQoUnFpTl7VR5fVtAcAn6wJ5jXwMe3HGQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FyggJNXG62NXumiqKxggiLeFB_-ocOYeqqafAmw4NxA&oe=6A1863AC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUag9_C3uK8Q7kNvwFKEe_W&_nc_oc=AdpGgtn_gPmTal4uIJfugprlmShp_qmGFa1yBiU6QKxRZOeuYpDLwqTjFzyhTmdsETs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XQ3Vb2Q6fSp37myuuA2IgfMiZLvqOgn9_Wzb4U8_3fA&oe=6A185137"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSDibTR8R6YQ7kNvwGOK0bg&_nc_oc=AdqUWrgdsZpR5dstkSHxt2BzEdOt1SKSikKN3cvEptSeXxPdaRSAMnzjgKwF2y4YdqA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BRPZZpB2RSflL9JZ-Fxm10Os0o8zR37YEx5alWtFUlg&oe=6A184988"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uq7OGp6npR8Q7kNvwHMX7Vf&_nc_oc=AdqkRZV1XJI_PPvlObd7bAH0KNDqdqm9DaX_dqvTpSGoRoK4C61uT_SPLOdjQvRCFN8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uzUSRMTG-265Pkp0frCtJwB_mtupw2pn94MsRGLABLw&oe=6A1851C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9jk2LLJtqIQ7kNvwGwzUMS&_nc_oc=Adr0pFeAeT-0ygcGPiOtVJ1RcXIooSRFMsoeLG8hh6LeRh31uaFS745fvGyv0GGGS84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sMYwVKxwceTAuDL-CDb2b7Gi9C0Wt1-WtciUsPI5d9Q&oe=6A1840B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eboNU0f4j_oQ7kNvwEdfkLz&_nc_oc=AdqUIkaRK2fiEyzV1bXvE1esIXF95EDZW_Ju_y-hdcFIAAwGC6ePbTo5tqsnRPcwpz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56ebw5oeEGriHo0zNV_LsjVNhxWamrkRVKzgrzzpBmog&oe=6A184DA6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculus
.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkkGe7ao390Q7kNvwHEUSZv&_nc_oc=AdpmefD22WQKmVybJytcrdWcWyOkS69SkY0ZPxoMBMGYsQ-SEK8tmVV-1EJNPlzmCiA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I7cBywB4AmR9bQJKf_NjSzT2tUc_dN8g9mVErlcRKvw&oe=69FB5778"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6FIFX5nFeoQ7kNvwEknNqw&_nc_oc=AdpCusoM0UgMKW0XRZ59vWL4Mr5wyDye2F5Yre31KAn8YhZxEq9bqv_13iGgsY_dPQo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PJ9Ofj90JyDOpReb5WczXi8uTvovYyro9EpJ8KdFifQ&oe=69FB3E62"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTu1U8mmtMMQ7kNvwEfbtwP&_nc_oc=AdpXd1H1bfDTkyuQH_bVEn_6Sr_r4sscPJFmmFdzizuLT97ec8pf5dmwcxCfpGEtyto&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jUWwu7G3EkdWeoGdXCJiHLGLSQuyT6R9eDwrg-AlDAA&oe=69FB2A6C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTlxOnNeS08Q7kNvwFkHwMn&_nc_oc=AdqZZsQKBKv4Zaa81_ntv4WBBLw2RLKbDTxMy5bBz94961_-YPSwd8x80Nd_Gadmex4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46oGyUrtpZzdvP38UwaYGLLkSFATJ8nJhGCd4qqUknVQ&oe=69FB5037"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wl37MP5xqt8Q7kNvwGnbVQe&_nc_oc=AdpEoHEGRkczpu1Kn8NKMsQpxgW8KD8fgrPHRKTnohNSFUEUA6cI41Uu1mXwe2px5EQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aBHv0lUOqAUitS5l6Fpv6saI7U8EjAy-6ZDLoX-0oNQ&oe=69FB4888"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUXm-NGz7aEQ7kNvwE4mRiR&_nc_oc=Adq6lUrx9ubeKiNv6ZPIWypo51-B4-axMwxm5C81swdRHYVtXfb-3jrI0Yp20j4OCKE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6enq5DdSdbyP-9uXHm4aYVBwWG8ClDSbeFYLdMeQ4G3A&oe=69FB50C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R358aAJDMOYQ7kNvwF20OPI&_nc_oc=AdoXAj8Yk8LxZk55q0F744RzUILe-rQKVP-ZmyrhlDJLV9vwzX9TqaqSbDoI8gL75NM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uPO0msaXTCZv_mIfVWzXnWCaEH8nI_rKJpv6CfHBXWg&oe=69FB3FB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YijoQJ8i8_8Q7kNvwEQCl6t&_nc_oc=Adp1UwgJROejbsuksET3tWCIlzIcn5rtJGVTVeVml0X_bvJnfscWHbKHUtI5jqNqtAE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sNgctO2OpRL2Q4F82DoP2XLe_kM1OcFWYRJL0UnbaVA&oe=69FB4CA6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculus
.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpMgXG0jwGkQ7kNvwHCR68B&_nc_oc=AdpiNpnNRtfDSM2r-gyyEmPnF8JOlnFrUd2hUnGyWasq3WJUthG6puvepYwkfhy0r6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKLEdB3kKurd4RiPKfcF10-WuvQ0AiEAc1nebdJz3SDA&oe=6AE753F8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxfpR9Ay6AgQ7kNvwF-na2a&_nc_oc=Adqjew6mzK-rOL7J5U7p-p30SqMNYTxCkrjRYdlwJPzJa1zew2-bSJ4WVGKLCCFHFBc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkb0SUOkhPdnVGkV5UuWfakZ1clFliJd86KAHv5x_ZmQ&oe=6AE73AE2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApFe5t_MQ8cQ7kNvwHs1RSb&_nc_oc=AdroyYJHTnKsaOx7_-XFF--WYJTBxYfFh6_wP_FK0WC5vARyalvgRk4KcWoWAUMGhNQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrqXiw7t-gMr8ntSIevJxy-hK5IPqBo9YgbAjAPIYwhg&oe=6AE75F2C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2j25rP4XtIQ7kNvwEgjKrz&_nc_oc=AdpEHgM0908hEfv_lJJ_zfUtPtMGQ-5MLWcxWn6PSR_KxxDQoOqontDAZCQz5l8kMzQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA4PQunMxUUhS7eUDTcTL1Fit_wx9s1gG0gxI5dkzMcQ&oe=6AE74CB7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwzGHOEF1oUQ7kNvwECcuO8&_nc_oc=AdrgdDtt-BKsNG5Le7SbIfwzQnK1QbvYRZ5H32no3L87e4WTAWiN79hcAoq_JbN-mdw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQwGcSbUCkNxFYdOuK8WXxWYL23oMeRIEtMUbdzOAQGw&oe=6AE74508"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoSW7IilkpcQ7kNvwECUZBQ&_nc_oc=AdrmlV4hTRIFIJqu5Wo98UmWJ3n9g22lFp-2NiSNzwWtGiI7-8s19bTpA558ml65pqA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRib0aV7mdRjdslFgMKBsgIDbGAaPVvCwMrjjBXWHwqOA&oe=6AE74D46"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDuaYvz9S6gQ7kNvwG_1XjF&_nc_oc=Adr1eUoAcfsilQe_ocrj9qJc7IeWDveS3nP3LT_oSL8UFzvc9kez05S29g6iBGG3zw0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaO8SH74i1yJVzGlGPVhILgW0XDveo8_EdSKYYByvGew&oe=6AE73C32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gsOuyxMQSMQ7kNvwEK-vJN&_nc_oc=AdqtzMU0fThw1BXLiYFokls9v1-qzF64WE3jl-o0zvzi5Dzcd7MShKOVdTlA_fIIhg4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWXSORGtNkx_IH528wIeZVu9SdB8B--rETwnFSh_IBog&oe=6AE74926"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculus
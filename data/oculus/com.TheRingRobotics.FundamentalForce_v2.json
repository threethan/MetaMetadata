.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J108cvZBK6MQ7kNvwH5MDjF&_nc_oc=Adp1wZlEDf8qyfTL196jgM1ak10me_cU_l0mRS7-KkywOU5kgSnsjASTUjBD4LzgABM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHd31SZnnsKjParLtpJn078-KPpTiSsoBPfRW2_KiXNsg&oe=6A79E778"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h687btiruqAQ7kNvwEjtyEs&_nc_oc=AdppiSIGAcOTWFNjjGgdvRnTnK6kNfhr_X82FvYNEa1gaaWCw9maPaQLO9XLPKwRPZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNQqzSGiZydprYBmQv41D9l7SFYHEV1NkT6wOXZlvRsg&oe=6A79CE62"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Y9yMM06xZkQ7kNvwEm8uzD&_nc_oc=Adq3rbuB0g2p2GW0Yz6nIEFQt8hDKQInzGKLofaeVR9msRZWXYdNCsqG3Vf16iKijm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdj4-A7ozE9j5y4BsvWNmjKj7Npk7okYiCA2CBFWJd5g&oe=6A79BA6C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ot0_K0CZ8wQ7kNvwG4QGhk&_nc_oc=AdogPBxgKMuMm3PuknJ0UKRaFBCuzfKMmTHLZ3gNCIOItdRyZXCh-aA9OBiAkAAMM08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_1rnptD2C0Zv6JMmVgaZ0o5x1H3cyw9BbeCtZt1cDyQ&oe=6A79E037"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1v4m4waWwEQ7kNvwH_UcnV&_nc_oc=Adr-7VQ9ozHCrVpUWw7o2YE9URrKXt-pNUBEXjDfEm1nkgdqrNFO88bwQCpRHCNs0FU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs58-2Mr8BtaoVvX6JF1GuwgIWtQFYfss0qpViH3jd6w&oe=6A79D888"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uLIJe5AvnYQ7kNvwE8ROjF&_nc_oc=Adoj3yzVBbaes28IFW89nYONWjXXGKtBYCgjrTFCRDEe2Cnkcdh0BuHmP4B6g3SkoxY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKSA-az4qYhRyprg2AXcoPF8KM3oyfFv5noSxJ1Z5a6Q&oe=6A79E0C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWuQvQTyIdkQ7kNvwG6PYil&_nc_oc=AdqNSWt8LMKs_TcBuJzbxyjjw5lAN3baoYiKhUjHacsTYaaW_JKtAKzctY09_SjiNN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI5ER7Hwh_hUQzajEE5AnxUpV41EpJtIV1dJBwAR0Esw&oe=6A79CFB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIVNkcNyQW4Q7kNvwHyG6Xv&_nc_oc=AdouvnqQYSYSlX2tYnRTbiHY73b1v7mRVnx67Vcu1pvZcqOmjeBElxXCLkdE1U5OMTE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ7ofRz52le1K4myu5pgwtja-EFimqZ8TeZRgZbg3P-w&oe=6A79DCA6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculus
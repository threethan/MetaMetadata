.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vc8XAL_DLVQQ7kNvwFPGxOD&_nc_oc=AdqPkDLNjXn4FmRY47qPVI3ZnycysR0h_W2txpKQLht4-lHuuaqNIIn-_oQ5rDceX_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3zIYoG3BWaMmabkLW9iBM0TcOa2AA-hgHvvot3M6lwXQ&oe=69F762F8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgonI9YMTZcQ7kNvwHPMaCQ&_nc_oc=AdqoEOaAcbw71dCMwEWFAtSo929cImweBR1bROhbXKUK1vdqggb7sCnDq8fTmj1Hp3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3_6RLPxexjCUZA0AEzTGqvBX6wE4NG0Y9mG1vmNQ8deQ&oe=69F749E2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTu1U8mmtMMQ7kNvwH0O_Sz&_nc_oc=AdqU1lpa6fjje9w3CL8G_1mDMhHmOw328-qnoxH1cM0NzJ_5rplMGu9u8kAVI5oaUbc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1lKgNEnaoMiJfpGwsyVIbmR49BSJxMqTrcNKan7te6Aw&oe=69F735EC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgKD_3tzVb0Q7kNvwEAOGxB&_nc_oc=AdoQBJAM5SkoocCmdtWLquiNM_3qWbQXHD09_TeGwPmtGVkamSLE-M_ejx5MBYbukTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2m4he9x4aHF1wTBhtScn1DQpa7kHnz8F79j0qaVl23MA&oe=69F75BB7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHUQWBT2eywQ7kNvwHiZOUD&_nc_oc=AdojexUrkUpFFofiLXzUqX0tL7QTvx4aFm1WvL6UCvXVucKY0AeGI5H9MLlLQEEPJWE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kY4rPYa_rd_fsfxHJJy2ZMBwPTvw9MEuwKgzwmqnF1w&oe=69F75408"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nkew58kRJ4Q7kNvwGAEHOP&_nc_oc=Adrct5iWqdEJkHkl80w7zmp5fz4oJsw26JuGNXDjPpPyYdP2m5FMQgVup_aUt6G1H8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01LgLyMqNJV9KhCsTwBAaLkq8O4CG_n3-ZSwIiXo1_hA&oe=69F75C46"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wyD5XOzy8EQ7kNvwE4H_Ki&_nc_oc=AdoLR2Xy6WhGrvUq7Kckff2NmK9M-N-HD5MwYUy3wLqIWxy-dSmEdBWbJ8B1lbs7qKU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2uafUjkIAjgC1pbEsSmVRaKbAgb_Spf2e9O0m6_qy_FQ&oe=69F74B32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8z0talId0zYQ7kNvwHrYW29&_nc_oc=Adpl3zVa8_QUbmyya7F-HaS7iM2vYVTnO6t4ECPOD4V4RPNaRgW06OU_u_3OlIxYlBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2yWyizuS0z3D-zEK_-KG_-aO1nEEF5BGRkuVpx4K6U6w&oe=69F75826"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculus
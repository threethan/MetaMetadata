.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3eocIWZHkMQ7kNvwHE5o9V&_nc_oc=AdqbkzObVXQRq-9blHqYHvxXMi5YgTL-TwedjYC1e99NylUVQnsIibcaI9OrfzqjPp4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vWXLoWLISvTFRGk_B2WJLsH3xCFsSBqZUVJ8nreEwFg&oe=69E63F78"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n358_ZLKd74Q7kNvwH1pMoE&_nc_oc=AdoWwYI5mzZFifhkCUS-TLhJPv0AnyForzvPsx6R6jeGljSZ4ofNqW5vUL0KxovIyFQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wFFBCFbCUBB5CfpiTHLOVdQjkBMA1hVAJNPPfTe9Rdg&oe=69E62662"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80J6o6Wg0ZcQ7kNvwGmaFI3&_nc_oc=Adqj_O7bRvl5g0h9uiQutKM2My7IdjDqCXki-4aFJPIUlP2QSM_SD_IX6wu6WCrC5B0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1agxq3xHgm3YwPgqp9WxyezxJdfim-y_y4Xx8pD0jqAg&oe=69E64AAC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ooJyWtOKr4Q7kNvwHtX6-x&_nc_oc=AdrFwPcByeFreVqxYjoYkRpI7jS3_BCDO16i0RD_TSmUpaA1KLld10u81kyK50kZSvc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LuOSeHUOZL4MN-OxwAif2GCL6XeSRNPVLOLNznXJKNA&oe=69E63837"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdPZ8Vvhsh0Q7kNvwGBSPNn&_nc_oc=Adqj7cCbyGCbSzKPw6ONCNQn49li9KeIaACGB7l2rmJze8pwWTy3nQZGR6xXNhskdJ4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Vdmy45XfzmuTnHK_lb2S9WRBtfex-pP9qbSv_QMX3rA&oe=69E63088"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQ1DcgUaF4cQ7kNvwGzkZyw&_nc_oc=AdoECP2IKQn_f7caUNdwPd6xGmUJBgElFE9kxZRVLP0VHCRTtbm-dUmgsxU1jycVzEg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ct_u4TK4srnZMMKpsDHR4h6mtsLxPXTAjxfHE7G6E-w&oe=69E638C6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KM580qceV6oQ7kNvwHiw60W&_nc_oc=AdqkH4w0AtsmJPPtL6a0pHM5gSekM5fzsvnJlY6hvbDtY1CaKAIvwH4qPhq9mRyMFNA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rqnOq6Lf-h7POnz_IHiD_-3hxdiEEVFMa_8b5BHjaFw&oe=69E627B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBZuvBl5DRsQ7kNvwEdMke9&_nc_oc=AdpFVwww3sAIxdSLGLxX7dZmMeofqHNG9J6MPSQqQv_hwdsFfCW11BwH-2HVGfGsH2c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hSpW3bAlEOVQHBm6FKkTKXOyVig-wbTcFCC41Px0VpQ&oe=69E634A6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculus
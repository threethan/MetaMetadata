.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDLvzuf9yZoQ7kNvwGJw5Qy&_nc_oc=AdrfL8bRaGAGRKWA-OuwM5eDwzLWPvkGEHDiqzLAlgwpaJ9Kr5xlPKJRLpJNBYE-HsU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vBTqW7vFXnmznXwH43riJL9NXkvyNciGNyTFmkoXn-g&oe=69DA29B8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUsgf_-DWqYQ7kNvwHPXIOE&_nc_oc=Adpwkxat0rT5J2IMKiOzqn2rsyQQaJYNdJF1y4PQxNMGBs5sCoWjGQ8h4tiIaou65Xc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-qpJU_zA-PY9fUJM9tiiVk9JhrT3JnkomIj4dUmk79A&oe=69DA48E2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7VURPNw92kQ7kNvwFNY8x7&_nc_oc=Adr1zRh2BH37LlEjknjm50qQSf5tLkYR8XCYm8bJa4u4BwoRmDH5yNG3of6WQNMPCLk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gwZiIuch4J3DjUBYF6mWQWVDJDAvYIuxB6sE6TxpzaQ&oe=69DA34EC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbPvuoSZrtgQ7kNvwHz3Xj5&_nc_oc=Adq8u_L55J9KmlmgWiz8EyTENdVHAe-AdPqCLjJ_0RDZN4ZwVOLS3dubj8IYSr_46VY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aQ32PQq8UT1Wu3tP3btfx0p7AHmKpKMqsivMBEuTqaQ&oe=69DA5AB7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyU4CmCCtJoQ7kNvwHTTLQD&_nc_oc=AdqcJeaFU61kybTMoeM7raoNV6QJsCcqQwpOnv9fff3fB7EUG7kS5g3I05Vgq4zVzg8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cgs_qBwZLoc6hlXD-FZUGMXMpglNN8DNJoQzsOPdR9g&oe=69DA5308"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Knf_fG-6zbAQ7kNvwGTQBb5&_nc_oc=AdpHUwGFMHwqGuaASDCP65LEIEamEsYamFFmeNwIjbXhKkJE4BLQwVmiborA5HurTkk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YjNPbVOqnB_mCtQ3evdOJTe8Z9yLqEBISXlepbI9vVQ&oe=69DA5B46"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfmgjNK9eQsQ7kNvwG1BMtJ&_nc_oc=AdoFF0lgk9_oUa2p5nUhqFy33q2kAYKlmOQ4biprCZ1dKI33WXWB3xdgCo-P4e0l6sQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bv6_sG2_UB5gcMLDjT0D4LFoyzE0tKjDPkQ57MIDoOA&oe=69DA4A32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWWfFbrHNl0Q7kNvwFPlmVe&_nc_oc=AdpcsfnouOebgDyQ6nv9dReIag_uZSKAXewWYLzY4CdMAuDfe63mx66P3Nm6QKQ6_j0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0v-WmI3_DyvVs01E60a2XmeBD3JbrPzVzVciVibHsHSw&oe=69DA5726"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculus
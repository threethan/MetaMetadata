.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiH9s0AtRdgQ7kNvwGlQEkf&_nc_oc=AdpWwPXxWSx_S6_5DmFVsgK5Ryd09NOzxPJjH2_KfFs6eMtvS8ofPJqhJZ6SU9ZELjs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4pitymXkWYMATB13aFqDHDKzwdYim7ETKsDWuDBPS2w&oe=6AF482F8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuPNW4nIdR0Q7kNvwGEPuOn&_nc_oc=AdopLuuTP4XecSF1_hogmL4KueAZBLQayuJOiG6Dx_7JqsP98zuQ_7eP0wNGGKijWfQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuc51y73RV0--ag5XR7gjBqFgwATtiu5mlKw6h233gtA&oe=6AF4A222"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gaOwV0xk8gQ7kNvwE_HLXu&_nc_oc=Ado_1tJ-0nCAtOJuUisD_aNRPtbjrZs2S6JoPMJPkNlLDuWcPWL3OwZaah_PTmpHVJg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPwJZCHYCXmargLq7ZdR3xx_cwA3W5Sh5LrkICH06KcQ&oe=6AF48E2C"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sec4O8tbiGcQ7kNvwHqBitz&_nc_oc=Adr4q3eVrzH-ts8hK9SO4MYE5t5vWotXflaWnOeFVtNQh4nbHM22jXqi_wGqjh-Vic0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJFO9TLg104NsyENR9kpBX331NNQUvaklnRnj90XUujg&oe=6AF47BB7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=colgUxvBgN0Q7kNvwFIUQnO&_nc_oc=AdqwpLDU9_8GgL_RyS2JMzUCYAQJtmWikvnj2nGFVgJM9l4_p3RpqXXFjgg-_bnSHJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdqOQSnh9rKKccZJPKdGYRZTpFb0D-6_1SgqykKILbFQ&oe=6AF47408"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Or_km6wz6Z8Q7kNvwGNpICI&_nc_oc=Ado6HA3ByXBQGaiSbZbV8nmdmZ3_HCJWTuL6Tf41ozKWwXBDGD6VB0-7CcmqZHcTZpE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6-oWtejqS3ekvMMhC0zNJfKOWF-Wdf_8WH_LlGuyN2w&oe=6AF47C46"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oxIXmw2xBsQ7kNvwGyHVCA&_nc_oc=AdqR95Ujhuc-E0sa7GCn9ny4R-t3cn_NvXdUL2jovkyinl27l9bmIF0J4at0pvwtqwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD6JIIC4E3Ei5CjONtg_UGF88uK-K4wivJJP-Vw7e5Gw&oe=6AF4A372"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwgEvhCltTwQ7kNvwFek0Yn&_nc_oc=AdqSTkfFFR7IWcKSgU4BUOKX56dp2Ih-BVhTU0JQRs5VUjefeK5yzmkr8986qQwTDPw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-ZJBxB-sw0K-BZcUvElyCqaD7UBrdKpRBjA3qrsf-MQ&oe=6AF47826"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculus
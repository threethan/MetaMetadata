.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkkGe7ao390Q7kNvwE6kQuI&_nc_oc=AdrJpa2JPJNGdxW6pjzkXZYmHBp9LyYzY-T2u2hogGJkoByVjtkpZn2c7w99SVgKZwI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fZxy8-q0jnUDRSbCkCMQiWLstnOCzdCYYKmZr8qM0Vw&oe=69F8B478"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6FIFX5nFeoQ7kNvwEAcsrG&_nc_oc=Adp0K2e5_xVZ1UNpTdIg0LPoksAtaXxX4BJzMk__GEsrGwtsWlnP-1Ni3t36pV1zmsI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CR1WUOExEj_xLiuReN43j3Dlhl6y2UQ9Ty-Y2yi9VIg&oe=69F89B62"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTu1U8mmtMMQ7kNvwFWVAlE&_nc_oc=Adp0DIoudWgeWMulr1xKed3M_J6EP3UshCY1YZ9JhdbTRAXV3WDOU2h84c8fDLpHmSc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3eBo2PGOioOuE2CM3FxFdoL0WoLrP6V2WPboQyYuVAHw&oe=69F8BFAC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgKD_3tzVb0Q7kNvwH6OwfU&_nc_oc=AdoskCLi26JM9jiQ-VE_pW4CbLppOzOFf_MDv7kzFFUu5AzawbZhzzd2zIu1HkqKsbM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2nauj6h5pGtqTMAIqdzvWzzs_5zManOEfa71KihHBUYg&oe=69F8AD37"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHUQWBT2eywQ7kNvwFXVMdA&_nc_oc=Adrzhla9yZPdNt6vRJsZG-i2AE7gKL4idM6L-ysY6iE_3FqK5q8yYs3GT6FuZh94Wvk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2IAb63-X7iJXpR9ILNqvH0cCPdMMXclZYur7fmHiGVgA&oe=69F8A588"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUXm-NGz7aEQ7kNvwHLJNaR&_nc_oc=AdqmZASSErxxC5Zct6kcM6cxBflcNhM8XBe2mC5YpiSAXgaAfoMKxh_t6yLXgo53Oag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0x4lcVKqDEH06hwVN7m8cmL5cTHNmlNeSSychpeyzsbA&oe=69F8ADC6"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wyD5XOzy8EQ7kNvwG5Jrmk&_nc_oc=AdrGQYS73U4Ycy6qjq7Z7LCTbMoIU6c9jNGflq01fYVVh09tbt8VSRfZ2axYaXcgBhQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0MtxFceN2GyJ9L75VN29-StsVRnKH9upZebI5LKem4Yw&oe=69F89CB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8z0talId0zYQ7kNvwFEpqAc&_nc_oc=AdrpKj0qF5GfN3e7Ibqh3wx9iKcxpuBCoQRP19UkJQx8_R0sDNeBuH7wtKBNEtWqIzU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Gv4gQLdXYyGfutACinC5lmzYPPGpBuezki0UX18_FKA&oe=69F8A9A6"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculus
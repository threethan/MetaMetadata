.png", "id": "286130703175879", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_286130706509212_445834982014320147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaTuPDCcgIIQ7kNvwFhw8Wn&_nc_oc=AdqDypQ4bP42TRzkEjV98gqofWxgcuARUcZOSIO7Sfso54alEOxSlca1geEnu_u547I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAe93zzNapW5v8Q1_GVodya_vhqYKhPitBOroEr2o_-2g&oe=6A60DAF8"}, {"file_name": "TrailerTitle_portrait.png", "id": "133926402037072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_133926405370405_8625744696243559721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBKKYA1UEzAQ7kNvwEJVgvy&_nc_oc=AdrsDxj2urN4oUu1mI_M58AgoR-hAHHul1Sx2TMPwENHGhSH-oAX-8tEEjiZ5u8XfYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkuRE32aJ2IK2wIwOs6D6T0Fvg9JdYshUr1nfsPLil_A&oe=6A60C1E2"}]}, "id": "1132291137667874", "locale": "en_US", "screenshots": [{"file_name": "Piramide.png", "id": "1518733215130441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348045_1518733218463774_2356035575141477648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zl6H3uOiZA8Q7kNvwFkoCxr&_nc_oc=AdpAJt7gD37b6bUHKGnTNgc0i0GCwCX8lZ7jjw8lFabzbtUdxupE0kU5ux-igI_9FSI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIngTu2G4wQYwt8aNeRg4XxBXEkcjC65JFMd2n1Nb0RQ&oe=6A60ADEC"}, {"file_name": "L_18.png", "id": "1869501299886313", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75612004_1869501309886312_6159179922160885241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mfe-S-D7wnIQ7kNvwGKbphb&_nc_oc=AdomwwWtlRoyWosEdMH5VYjJ-EiF_t2NRN9J_g4Qrs0395hIEV1X6mk842XWi8W_WJw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsKPECyVW5agaYXUS5jR7_Ih6xEKRtjsapiHk9KmH4cw&oe=6A60D3B7"}, {"file_name": "vlcsnap-2021-04-17-12h41m11s730.png", "id": "280543573555506", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476593_280543576888839_4557543221826205009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47eCHvsA_GEQ7kNvwEWc8Vi&_nc_oc=AdojhSR6PsXazhN8vh591Ur1q89xu3J5i1iQxlRwK6pEAZZsxzrQgkHsRSp4kDfLZqE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD4DFTmpPcchb7rgLC8yGMAzfxnpmd6UVROsTOHmcUrw&oe=6A60CC08"}, {"file_name": "vlcsnap-2021-04-17-13h05m42s414.png", "id": "198090791897661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207240_198090795230994_9065264850185005880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGpCNFIXe44Q7kNvwF0y1T6&_nc_oc=AdptHHDFrj2hucsN96mM1AsZh4ScKqiswMdDzGxJpl-NZfR_2oni8Ei4HDlCcKKxAO0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-Yyv9ecRYyrdWldk4sByVx9voBs4hDHzKaEAlYQ0zjQ&oe=6A60D446"}, {"file_name": "Level3.png", "id": "482504346534167", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462209_482504349867500_8378253719107638253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ihLhmVX9GkQ7kNvwHS1CnV&_nc_oc=AdoC1izoUatm7TCjECSaR6H8svwZpcQ36wEBw9KW2HCLytEbd9LEtdGEaCU57TdDydw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABBVX6P4o1NcgeVssogZHueEOYi_PtI1cKZIo_dcWbrA&oe=6A60C332"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle_2.png", "id": "2886143558326806", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_2886143561660139_3739212636586911702_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNDIDcSXzGoQ7kNvwEMsGK-&_nc_oc=Adqj6GV_7AY4QpPFBlbkvAmH54MO7LXIYARzRhdzXtz4xAe4SxJe-96gdjbaKObSSXw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPe_6LgGiyKnaMnEwwNnOX5YeyEMwE0qbnE8SlPkTWsA&oe=6A60D026"}, "display_name": "Fundamental Force", "keywords": [], "long_description": "NEW! The endless mode is finally out! Compete with your friends in 3 new levels of endless enemy waves!\n\nFundamental Force is a game that challenges your spatial thinking over 21 mind-blowing celestial levels. Fight against mysterious creatures in Escher-style environments and deny laws of physics!\n\nForget what \"up\" and \"down\" means, you can change the direction of gravity at any time. Ever wanted to walk on walls or to stroll along the ceiling? We\u2019ve got a solution! Feel the true freedom of movement by picking one of the two gravity changing devices.\n\nTACHYON allows you to teleport onto any flat surface and make it your new floor. Appear out of nowhere to catch the enemy off guard, then disappear in an instant!\n\nWith GRAVITON, you can change gravity in place, meaning that you will start falling towards your new \"floor\". Keep switching the gravity while you are falling, and now you can fly!\n\nUse the gravity, find your way, dodge and pick the right moments to shoot and you will win!", "short_description": "Fast mind-blowing VR action-shooter with gravity control"}]}, "developer_name": "The Ring Robotics", "developer_privacy_policy_url": "http://fundamentalforce.freecluster.eu/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Ring Robotics", "support_website_url": null, "website_url": "https://www.oculus.com/experiences/quest/6092508024108401/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418282680294501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculus
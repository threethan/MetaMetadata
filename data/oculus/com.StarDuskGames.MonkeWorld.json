 the same place as before\u2026 it was different.\n\nThey saw there\u2019s was a VHS tape and a tv in a dark hallway with something lurking inside\u2026 they\u2019ve explored all around the lab opening a huge door by playing the tape. And before they knew it they\u2019re lives were taken by the evil Anomaly.\n\nEver since then more Apes has appeared learning how to survive the monster but an abandoned village stood next, with a stronger Anomaly inside\u2026", "short_description": "run, hide, or fight what lays within..."}]}, "developer_name": "St4rDu5k", "developer_privacy_policy_url": "https://monkeminigames.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "St4rDu5k", "support_website_url": null, "website_url": "https://monkeminigames.webnode.page/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7520926837962318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031652_794677549524442_7906460422629596017_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xgy-xZd0M5IQ7kNvwHktPWr&_nc_oc=Adk_78kr7P9CSMYYWhYQESMkeDf9j43qBrQugCO5Yxr8cd1jdigCNoMI9dG2yGzecjU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftm537xS-fmwbbhh9UNMeczfwDqYepqZ4kQFuiF6rFM_g&oe=699AED72"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_
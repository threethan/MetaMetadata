oc=AdrQFJ-P61q8um9jArW63rN3l6UEv8UApEe-L7AwNSuCkbETXFSEhIuGDmA1WX0yQYQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZ3hT3bZ76aehDUwankA9LkuMRmas1Ic4zUo9NkEBcLQ&oe=6AE20AE1"}, {"file_name": "Screenshot_5.png", "id": "1111859883654973", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982533_1111859886988306_5027322092324578348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIXAXdO3IlkQ7kNvwEIYmQX&_nc_oc=AdpcKL3mpsxuvf81f_8lPZz8xxpQvE2tHIbg8ezC2Sv8FKe7EARiAKCwyvVrVrOrmMM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQML94OXkgOOYgK8WvgQ1eL0cRnU-7JWYvGrFExZi9cL6g&oe=6AE1E725"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_1.png", "id": "607050131899209", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031492_607050141899208_7789688884095174699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b40kE2NbvjkQ7kNvwFjJakS&_nc_oc=AdoMtyBJno_uehC6K6FkWOzvHNijYDooerEd3VZY2BqTzry1hyy6QYFrHbme5ZUpID0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNX-Wr4EhtPNxd_6ZGQZMUhKN0xKPXoKhn-g4xodVWWYw&oe=6AE20672"}, "display_name": "Pixel Arcade", "keywords": ["pixel", "arcade", "tag", "cyberspace", "platformer"], "long_description": "Portal into Pixel Arcade, a VR platformer set in a neon cyberspace playground. Navigate and race through over 10 unique levels at launch, unlocking new chapters in the campaign while aiming to beat your all-time high score. It's not just a game\u2014it's an adrenaline packed, calorie-burning adventure that pushes the boundaries of VR locomotion mechanics. Master levels to achieve global dominance in the leaderboard.\n\nAdrenaline-Packed Gameplay: Experience gravity-defying movement in VR.\n\nLevel Progression: Progress through over 10 meticulously designed levels, each offering unique challenges.\n\nReplayability: Master every level to perfection and climb the global leaderboard.\n\nCheckpoints and Strategies: Activate checkpoints in any order, allowing for diverse strategies to complete each level.\n\n\nFuture Multiplayer Support: Look forward to co-op and 6 player race mode in future updates!\n\nSeasonal Updates: The game supports cheat codes, find the terminal and keep an eye out for codes on social media!\n\nExclusive In-Game Content: Unlock special content by replaying levels and achieving mastery.\n\nChallenge yourself, compete globally, and immerse yourself in Pixel Arcade. Defy gravity, perfect your strategy, and become a VR champion.", "short_description": "Portal into neon cyberspace in Pixel Arcade\u00ae. Defy gravity, optimize your route, and vault through adrenaline-packed levels. Achieve global dominance in the leaderboard to become a VR champion in the ultimate test of precision and agility. "}]}, "developer_name": "CJG Studio", "developer_privacy_policy_url": "https://cjgstudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "CJG Studio", "support_website_url": null, "website_url": "https://cjgstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8759252157490388"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes
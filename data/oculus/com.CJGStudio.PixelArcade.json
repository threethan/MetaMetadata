0f&oh=00_AQR_3az2dYsYSymOFLBy3-8m-jzyn-d6t_A1y8lI4OEqqg&oe=6B0DC96C"}, {"file_name": "Screenshot_4.png", "id": "614703951146320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566680_614703954479653_1690680479658797768_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckkc9hQVs9QQ7kNvwE2p5St&_nc_oc=AdqZxQDxUNg7DHymWjoCDfIe0_1Fw8XlerbBw1cHsYFsoQFcdlKBAOnINL48XIbzBko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNJ0lZ9x0C1PfWYcP1KD54eUKs-CTM9Xd0q_ehbV56_A&oe=6B0DC4A1"}, {"file_name": "Screenshot_5.png", "id": "1111859883654973", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982533_1111859886988306_5027322092324578348_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjX8R6LWNXgQ7kNvwE_lmw0&_nc_oc=AdrzW6dwIZQFMBoCsR3KVjQNFTUA__WxW8jYj6JWPBxnr0F9CtoYr0I7J8Scto0hE4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQq2bMBjUBlBjDJPWeDE339Rk5xM3MiSV6WJMtkfUDkIA&oe=6B0DA0E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_1.png", "id": "607050131899209", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031492_607050141899208_7789688884095174699_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1c82tYRPxsUQ7kNvwH2iGNV&_nc_oc=AdrClDxgKJYAXcG5bS7D6ypcM5o6o8KMAL5SkgsAIIcDxwYlRQq1CtNFfcri9kFbWaA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRl83CZKvZiVIG-LOzg0CNRL9oQHygCJVm6UenV2FxYuw&oe=6B0DC032"}, "display_name": "Pixel Arcade", "keywords": ["pixel", "arcade", "tag", "cyberspace", "platformer"], "long_description": "Portal into Pixel Arcade, a VR platformer set in a neon cyberspace playground. Navigate and race through over 10 unique levels at launch, unlocking new chapters in the campaign while aiming to beat your all-time high score. It's not just a game\u2014it's an adrenaline packed, calorie-burning adventure that pushes the boundaries of VR locomotion mechanics. Master levels to achieve global dominance in the leaderboard.\n\nAdrenaline-Packed Gameplay: Experience gravity-defying movement in VR.\n\nLevel Progression: Progress through over 10 meticulously designed levels, each offering unique challenges.\n\nReplayability: Master every level to perfection and climb the global leaderboard.\n\nCheckpoints and Strategies: Activate checkpoints in any order, allowing for diverse strategies to complete each level.\n\n\nFuture Multiplayer Support: Look forward to co-op and 6 player race mode in future updates!\n\nSeasonal Updates: The game supports cheat codes, find the terminal and keep an eye out for codes on social media!\n\nExclusive In-Game Content: Unlock special content by replaying levels and achieving mastery.\n\nChallenge yourself, compete globally, and immerse yourself in Pixel Arcade. Defy gravity, perfect your strategy, and become a VR champion.", "short_description": "Portal into neon cyberspace in Pixel Arcade\u00ae. Defy gravity, optimize your route, and vault through adrenaline-packed levels. Achieve global dominance in the leaderboard to become a VR champion in the ultimate test of precision and agility. "}]}, "developer_name": "CJG Studio", "developer_privacy_policy_url": "https://cjgstudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "CJG Studio", "support_website_url": null, "website_url": "https://cjgstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
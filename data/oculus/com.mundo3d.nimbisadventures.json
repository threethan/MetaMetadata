tail.png", "id": "1600293125028691", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499296127_1600293128362024_698039398750824693_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbyX4s7AvegQ7kNvwEULBfB&_nc_oc=AdoQaHocHmTUNxkr6X5hrZv67vTKjF-NnfkTJB2gtF9yytIUP53XaQx4cDdOYKupo5E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIax-gsNqKofa6EXm6K0fDvDKy0N0QR4FlU-9t2mNN_xg&oe=6A9AE6E3"}, {"file_name": "screenshot_02_nimbi_world.png", "id": "2286916665045619", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499302374_2286916668378952_4859557919208368209_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0O7hw8nVS-oQ7kNvwGqyaHn&_nc_oc=Adqspj_OK5V2N5KLdDorchVwGjb2X9_qQk0VjVdLXU_mC9U5TEhXHo9-L5QWRl3O81s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr2ykNhcr1kgkLVQwOpbF8YoI9AMVAOmIawksRPx2iqQ&oe=6A9AF398"}, {"file_name": "screenshot_05_comfort_menu.png", "id": "2058621092196858", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307309_2058621095530191_366338629048714481_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dfHnNu2XxQQ7kNvwHQoQNh&_nc_oc=Adr9kcWCqYpZml_gU3VdVf7T9feK2RCa5FI3m-cZEJB_v-f7N24R1wcGR0OcaDpCFlE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3zKiiptobzkveiWP3ElOXHtGd_Spr7js0H5yVs6KiWw&oe=6A9AEBFC"}, {"file_name": "screenshot_01_coin_trail.png", "id": "888256780666510", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/673780696_888256783999843_1367271276265712207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8vOANH266wQ7kNvwFwJA4r&_nc_oc=Ado79oq9eEWfIcjIJOh7p7J6usXzggcfPzOgQDnzwfTRithz8_3jStokDA84Fa3jQdM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRsv6WnvF12cOe5QBAfmTGvhfehdEgfOuF-ABNA7_Zew&oe=6A9AE396"}, {"file_name": "screenshot_03_level_vista.png", "id": "1295268972503088", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312310_1295268975836421_9133143210799255965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJuhTW767q8Q7kNvwELTD9Z&_nc_oc=AdojpTNCTkrTBs8DNV-E3qD1zNJpka9WyyKQ4Y5tcAdwPAR-xu2aaVfgzGSt9mRpG5s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgorbPgskiOSDoKVhuBEcv7fekBD_3MH6OakhRmJFSMg&oe=6A9AF41E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1602252444830748", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619681_1602252448164081_2145720626556957219_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDa6ctwGg_UQ7kNvwHh62Wy&_nc_oc=Adq5peM0ntdGEuL3j9U1bLqNNmrKqQJKm7Fd8It-tKErR1gZfu53WBpOjyFRBA3NZss&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYFUjFfBas9_rP23xbRb8kCeomae_DPVh3T5tuWDNenw&oe=6A9ACD22"}, "display_name": "Nimbi's Adventures", "keywords": ["platformer", "family", "adventure"], "long_description": "THE BREAKOUT VR PLATFORMER OF THE YEAR\n\nRemember the first time a video game made you smile? Nimbi's Adventures brings that feeling back... except this time you are inside the world. Join Nimbi, an adorable white mushroom with a red polka-dot cap, on a third-person 3D platforming adventure built for Meta Quest. Every level feels like a life-size toy diorama: castles towering over you, pipes full of secrets, and waves sparkling beneath wooden piers.\n\nCLASSIC MECHANICS, BRAND-NEW FEELING\n- Run, jump and chain precise double jumps.\n- Attack enemies and smash breakable blocks full of surprises.\n- Collect regular and red coins: each one buzzes in your hand with haptic feedback.\n- Gather 60 coins to transform into GOLDEN NIMBI: your attack shatters blocks and defeats enemies in your path.\n\nTWO WORLDS TO EXPLORE\n- Hills: green meadows, castles and mysterious pipes.\n- Beach: wooden piers, warm sand and sparkling water.\n- Your progress is saved: clear the Hills to unlock the Beach.\n- Generous checkpoints and a goal flag to celebrate every victory.\n\nREAL VR COMFORT\n- Orbital camera with 30-degree snap turns: no continuous rotation, no queasiness.\n- Instant one-button recentering.\n- World-anchored HUD, never glued to your face.\n- Comfortable menus: just point with your controller.\n- Native 72-120 Hz on Meta Quest for constant smoothness.\n\nFUN FOR ALL AGES\nColorful, cheerful and easy to learn: a perfect first VR game, great for kids and for lifelong platformer fans alike. Classic platfor", "short_description": "Jump into a life-size toy world. Run, double-jump and go golden with Nimbi in a comfort-first third-person VR platformer made for Meta Quest.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/2f4ad790-50df-44e8-a18d-18378f5108ac", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/code/artifact/2f4ad790-50df-44e8-a18d-18378f5108ac", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1101077435691692"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1357278929356774"}]}, "baseline_offer": {"id": "1357278929356774"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786539960, "status": "PUBLISHED", "id": "1357278929356774"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1101134279019341", "version
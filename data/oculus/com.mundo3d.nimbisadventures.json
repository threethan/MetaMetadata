71-25/499302374_2286916668378952_4859557919208368209_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQ1Ex4NPnV0Q7kNvwG5o3mb&_nc_oc=AdrJxu3XeFB3NvA2KSv6xvtdCU8oKFgiR0BFburaJP8XeOfNL3R3xvflYYjlTlW1p_U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV8fBdobwSN4sDQlKfzpROabvcJrIudDKdEt-Mc_1A4w&oe=6AE1EC58"}, {"file_name": "screenshot_05_comfort_menu.png", "id": "2058621092196858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307309_2058621095530191_366338629048714481_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iqhiURIsqkQ7kNvwGoVvf6&_nc_oc=AdqbDe1wglPy2MzqymnYqXgAu1ZhEI59yQhXRu5uQqfsXnCYsVZggJRg6MlWJCuKUQ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh480AAiKHV0Moa9Xx2va5Mgj7ht7s6X-iC7r92iolTg&oe=6AE1E4BC"}, {"file_name": "screenshot_01_coin_trail.png", "id": "888256780666510", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673780696_888256783999843_1367271276265712207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VdU4fZoxc8Q7kNvwE2nES2&_nc_oc=Adr4oRZDpWZi7qdOwe3Kzqt3r8AlI6lLHCQ-p1q1qUZ02Nd-i7k7TvXSFnPpm91gRhM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwena1df7kIP7tXoKD9EeBMxyYYrJ4IGbebSpWDTJzrA&oe=6AE21496"}, {"file_name": "screenshot_03_level_vista.png", "id": "1295268972503088", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312310_1295268975836421_9133143210799255965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leHNGZ7lMMAQ7kNvwEKhkwo&_nc_oc=AdrwLYBKc3z2Fnu-DruFRNdw9Sb0mY0BiSQ-BwHU4AJfFqzQJhJtpb_HxLD36DjtFp0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDe6iO3BlHhh6g0S6ENX-0PIOFyBdG1Jr_hfKGYVHx_A&oe=6AE1ECDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1602252444830748", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619681_1602252448164081_2145720626556957219_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0-02ii7gdUQ7kNvwEuXsJp&_nc_oc=AdqTkMkDBi43UO_-3-zR1pH4hkLWJbG6v0TzzUZ8DLsg2bvtXpkM4QlKYG997RZqfwk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7CkLttKJpYRp1tFy-Uldpe_2Wn2jDYhvKVGLWiStlTQ&oe=6AE1FE22"}, "display_name": "Nimbi's Adventures", "keywords": ["platformer", "family", "adventure"], "long_description": "THE BREAKOUT VR PLATFORMER OF THE YEAR\n\nRemember the first time a video game made you smile? Nimbi's Adventures brings that feeling back... except this time you are inside the world. Join Nimbi, an adorable white mushroom with a red polka-dot cap, on a third-person 3D platforming adventure built for Meta Quest. Every level feels like a life-size toy diorama: castles towering over you, pipes full of secrets, and waves sparkling beneath wooden piers.\n\nCLASSIC MECHANICS, BRAND-NEW FEELING\n- Run, jump and chain precise double jumps.\n- Attack enemies and smash breakable blocks full of surprises.\n- Collect regular and red coins: each one buzzes in your hand with haptic feedback.\n- Gather 60 coins to transform into GOLDEN NIMBI: your attack shatters blocks and defeats enemies in your path.\n\nTWO WORLDS TO EXPLORE\n- Hills: green meadows, castles and mysterious pipes.\n- Beach: wooden piers, warm sand and sparkling water.\n- Your progress is saved: clear the Hills to unlock the Beach.\n- Generous checkpoints and a goal flag to celebrate every victory.\n\nREAL VR COMFORT\n- Orbital camera with 30-degree snap turns: no continuous rotation, no queasiness.\n- Instant one-button recentering.\n- World-anchored HUD, never glued to your face.\n- Comfortable menus: just point with your controller.\n- Native 72-120 Hz on Meta Quest for constant smoothness.\n\nFUN FOR ALL AGES\nColorful, cheerful and easy to learn: a perfect first VR game, great for kids and for lifelong platformer fans alike. Classic platfor", "short_description": "Jump into a life-size toy world. Run, double-jump and go golden with Nimbi in a comfort-first third-person VR platformer made for Meta Quest.\n"}
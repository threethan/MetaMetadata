dn.com&_nc_ss=7f20f&oh=00_AQJDyLer5X9YsNtvxyU_3EYqtlrfsR-stTbd_gooxD6IRA&oe=6AAEB27C"}, {"file_name": "screenshot_01_coin_trail.png", "id": "888256780666510", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/673780696_888256783999843_1367271276265712207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_QRdTuBrhIQ7kNvwEVNF-1&_nc_oc=AdoTiyxrXF9X5jpBPYbU7exNdfbidZrxlj5JYC7UkCu9WOsMn5e8a2mGQcQkqsu5DLk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4oCos1Lv1ZQBOMswrHIDhCbXOzVgyAucyCw5poFJ7ag&oe=6AAEAA16"}, {"file_name": "screenshot_03_level_vista.png", "id": "1295268972503088", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499312310_1295268975836421_9133143210799255965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLxBRnKFPuEQ7kNvwGTo7s3&_nc_oc=AdprHdpEKqozPtQuQrtRXkRpH5dGazbqJ0LouYLzEVRMkwxcS4XK2SOe7IXoGKiej7A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmhPQp67_25m1lwyKlDLkR4d_9QboEHwYMKmbeXLImDg&oe=6AAE825E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1602252444830748", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619681_1602252448164081_2145720626556957219_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNveLqGpUKoQ7kNvwHkBPJw&_nc_oc=AdqF1_OBA1LYjioYLz7lsWLzSPNXp2oc7qdm4toDT7D0iVes_RLJE83bko3zn3I-sVQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ43gpgWj1upY5847yRWsj-to6VOV1vK7YBYbpOzle7CQ&oe=6AAE93A2"}, "display_name": "Nimbi's Adventures", "keywords": ["platformer", "family", "adventure"], "long_description": "THE BREAKOUT VR PLATFORMER OF THE YEAR\n\nRemember the first time a video game made you smile? Nimbi's Adventures brings that feeling back... except this time you are inside the world. Join Nimbi, an adorable white mushroom with a red polka-dot cap, on a third-person 3D platforming adventure built for Meta Quest. Every level feels like a life-size toy diorama: castles towering over you, pipes full of secrets, and waves sparkling beneath wooden piers.\n\nCLASSIC MECHANICS, BRAND-NEW FEELING\n- Run, jump and chain precise double jumps.\n- Attack enemies and smash breakable blocks full of surprises.\n- Collect regular and red coins: each one buzzes in your hand with haptic feedback.\n- Gather 60 coins to transform into GOLDEN NIMBI: your attack shatters blocks and defeats enemies in your path.\n\nTWO WORLDS TO EXPLORE\n- Hills: green meadows, castles and mysterious pipes.\n- Beach: wooden piers, warm sand and sparkling water.\n- Your progress is saved: clear the Hills to unlock the Beach.\n- Generous checkpoints and a goal flag to celebrate every victory.\n\nREAL VR COMFORT\n- Orbital camera with 30-degree snap turns: no continuous rotation, no queasiness.\n- Instant one-button recentering.\n- World-anchored HUD, never glued to your face.\n- Comfortable menus: just point with your controller.\n- Native 72-120 Hz on Meta Quest for constant smoothness.\n\nFUN FOR ALL AGES\nColorful, cheerful and easy to learn: a perfect first VR game, great for kids and for lifelong platformer fans alike. Classic platfor", "short_description": "Jump into a life-size toy world. Run, double-jump and go golden with Nimbi in a comfort-first third-person VR platformer made for Meta Quest.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/2f4ad790-50df-44e8-a18d-18378f5108ac", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/code/artifact/2f4ad790-50df-44e8-a18d-18378f5108ac", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOV
48714481_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmQ_yn1YDS8Q7kNvwFNu89D&_nc_oc=Adr1Z1NbE4jjKI2slJ8feaodId6_oCKis8D7jRbAc3JUXA7wJIQQB6R9yYZjzK2zAoY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV-8WzDg3jksy5VNN0OQp6kXj5yl7_AUD3Tjl1OzlgOA&oe=6ACBB37C"}, {"file_name": "screenshot_01_coin_trail.png", "id": "888256780666510", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673780696_888256783999843_1367271276265712207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZDHJRkB-QMQ7kNvwEB2PtV&_nc_oc=AdpWSsUkPM3tzm_qi8h1idBmWK7ggT2myIAPz_aFQ2BJzGYTr436SiP45CuAzIVONsc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7JdHPr6abcxy_4McW4OqbNfM7OFxnh7zrAo98xxBB-w&oe=6ACBAB16"}, {"file_name": "screenshot_03_level_vista.png", "id": "1295268972503088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312310_1295268975836421_9133143210799255965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nt9QlD0fCaMQ7kNvwHc7Ab5&_nc_oc=AdrNggyUbZGVkn21SMOHcaRFoUfROiNLJlDov_ThLBMzUtFSqrAdZb5LdAiL_Huv9g0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTfoWGPmyPv9aTaZadyr744Z7o-gR68p6DHSGxlCLREQ&oe=6ACBBB9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1602252444830748", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619681_1602252448164081_2145720626556957219_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3h3LmNmT2O8Q7kNvwFv5yNZ&_nc_oc=AdohAT5xxNMKMwixPU9d825vvP0_s7P7Dy0TwItDvwPxDwWEMJU6WRC7ndzBXlNtP8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuC4KgAJKvuJ9Jgc9B4f_gV-T0PR2DM2Rkl1_BgMPR4A&oe=6ACB94A2"}, "display_name": "Nimbi's Adventures", "keywords": ["platformer", "family", "adventure"], "long_description": "THE BREAKOUT VR PLATFORMER OF THE YEAR\n\nRemember the first time a video game made you smile? Nimbi's Adventures brings that feeling back... except this time you are inside the world. Join Nimbi, an adorable white mushroom with a red polka-dot cap, on a third-person 3D platforming adventure built for Meta Quest. Every level feels like a life-size toy diorama: castles towering over you, pipes full of secrets, and waves sparkling beneath wooden piers.\n\nCLASSIC MECHANICS, BRAND-NEW FEELING\n- Run, jump and chain precise double jumps.\n- Attack enemies and smash breakable blocks full of surprises.\n- Collect regular and red coins: each one buzzes in your hand with haptic feedback.\n- Gather 60 coins to transform into GOLDEN NIMBI: your attack shatters blocks and defeats enemies in your path.\n\nTWO WORLDS TO EXPLORE\n- Hills: green meadows, castles and mysterious pipes.\n- Beach: wooden piers, warm sand and sparkling water.\n- Your progress is saved: clear the Hills to unlock the Beach.\n- Generous checkpoints and a goal flag to celebrate every victory.\n\nREAL VR COMFORT\n- Orbital camera with 30-degree snap turns: no continuous rotation, no queasiness.\n- Instant one-button recentering.\n- World-anchored HUD, never glued to your face.\n- Comfortable menus: just point with your controller.\n- Native 72-120 Hz on Meta Quest for constant smoothness.\n\nFUN FOR ALL AGES\nColorful, cheerful and easy to learn: a perfect first VR game, great for kids and for lifelong platformer fans alike. Classic platfor", "short_description": "Jump into a life-size toy world. Run, double-jump and go golden with Nimbi in a comfort-first third-person VR platformer made for Meta Quest.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/2f4ad790-50df-44e8-a18d-18378f5108ac", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/code/artifact/2f4ad790-50df-44e8-a18d-18378f5108ac", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAME
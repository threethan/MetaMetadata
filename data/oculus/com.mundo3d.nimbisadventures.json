71-25/499302374_2286916668378952_4859557919208368209_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6N2OzJ9_omMQ7kNvwECackd&_nc_oc=AdqUzjOjdpQR_16Z2WaZbxgcwpAlY9OnepiKd3DbqGroy8Le480P3NDi0p3inyNH12Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNB_F-k-9a4IuHrvqiEE-xIm7GnkY-5Ur6UD2BARRhpUA&oe=6AE61918"}, {"file_name": "screenshot_05_comfort_menu.png", "id": "2058621092196858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307309_2058621095530191_366338629048714481_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNm3gRC2AOUQ7kNvwGmCyRI&_nc_oc=AdrZVmYhl-UhovKh9kW694Jm5F-qY94xA2lo3M29Y4sTrwfQQus96M1N_3BRJ0T07NM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOxmWqmGw9gdAsgO7CZIekfu0TwdtmSzizxk0j2i3tIw&oe=6AE6117C"}, {"file_name": "screenshot_01_coin_trail.png", "id": "888256780666510", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673780696_888256783999843_1367271276265712207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPNCLmZFyQgQ7kNvwGUT7v1&_nc_oc=AdqIk5qMkJqIEjTUw5gUFn0pyymumegy1rXMnSK4QHWgzKUHtViGRc0mpZwgWOBKSKA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME8QlY9KpgBgDJC7ZSVMPQp10QC36o45eXKGL596SM3w&oe=6AE60916"}, {"file_name": "screenshot_03_level_vista.png", "id": "1295268972503088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312310_1295268975836421_9133143210799255965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yjnw-gDRRXEQ7kNvwFYoUJv&_nc_oc=AdqlrFk5mI4l4j8zr3U_M-4TZxGSR0ZRPqWlpOnuI6BnLiOY_RzMUyggVjcn5lXdZFg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdXXgbMh7oBeNwsRAJRd-AZdX91XlVxknk1tMDu5ioMg&oe=6AE5E15E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1602252444830748", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619681_1602252448164081_2145720626556957219_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QfDFLRB1zMQ7kNvwG96HB6&_nc_oc=AdqPGdvBGz3fcUtFMgQZqoWvanHhs17ZYTb614PUlSMDrTufCyYGSkD0ObPwe3b8fA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBmQ58vuxw045sB422R9OlyFH13nmoV65ZIJDgKaopyA&oe=6AE5F2A2"}, "display_name": "Nimbi's Adventures", "keywords": ["platformer", "family", "adventure"], "long_description": "THE BREAKOUT VR PLATFORMER OF THE YEAR\n\nRemember the first time a video game made you smile? Nimbi's Adventures brings that feeling back... except this time you are inside the world. Join Nimbi, an adorable white mushroom with a red polka-dot cap, on a third-person 3D platforming adventure built for Meta Quest. Every level feels like a life-size toy diorama: castles towering over you, pipes full of secrets, and waves sparkling beneath wooden piers.\n\nCLASSIC MECHANICS, BRAND-NEW FEELING\n- Run, jump and chain precise double jumps.\n- Attack enemies and smash breakable blocks full of surprises.\n- Collect regular and red coins: each one buzzes in your hand with haptic feedback.\n- Gather 60 coins to transform into GOLDEN NIMBI: your attack shatters blocks and defeats enemies in your path.\n\nTWO WORLDS TO EXPLORE\n- Hills: green meadows, castles and mysterious pipes.\n- Beach: wooden piers, warm sand and sparkling water.\n- Your progress is saved: clear the Hills to unlock the Beach.\n- Generous checkpoints and a goal flag to celebrate every victory.\n\nREAL VR COMFORT\n- Orbital camera with 30-degree snap turns: no continuous rotation, no queasiness.\n- Instant one-button recentering.\n- World-anchored HUD, never glued to your face.\n- Comfortable menus: just point with your controller.\n- Native 72-120 Hz on Meta Quest for constant smoothness.\n\nFUN FOR ALL AGES\nColorful, cheerful and easy to learn: a perfect first VR game, great for kids and for lifelong platformer fans alike. Classic platfor", "short_description": "Jump into a life-size toy world. Run, double-jump and go golden with Nimbi in a comfort-first third-person VR platformer made for Meta Quest.\n"}
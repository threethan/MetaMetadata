tail.png", "id": "1600293125028691", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296127_1600293128362024_698039398750824693_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2K3sTuT17kQ7kNvwFSbCba&_nc_oc=AdrXilFEhQdKif2bqpFY0QjgYytcuM6AN-dkJE9ryfgVb4Il6w07nvZHsYnnzuX3KAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4LfwMGU8dXyOC_RbtYUh8IGfyMg2DRPS8BED7h6pX5g&oe=6A95D923"}, {"file_name": "screenshot_02_nimbi_world.png", "id": "2286916665045619", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302374_2286916668378952_4859557919208368209_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i75bAD8INIQ7kNvwGHbZ_8&_nc_oc=Adp-FcRQuy70_7zwDNLFsdSOhNel_tZ8wOvZtfyxS6wm7f0TUbnRj2HGmLG-VRyHLWY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqAE-QlM_cAYr4HlwiO71KboV-awLhQ29uUao1fBtXbQ&oe=6A95E5D8"}, {"file_name": "screenshot_05_comfort_menu.png", "id": "2058621092196858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307309_2058621095530191_366338629048714481_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtpD44VITvkQ7kNvwGJe1BG&_nc_oc=AdoJqKFyxDV7w-yfY2oKQ2dxWJVPa4nG38YK_VmHa8lsEkKCOhDNqD0wo5bsTmQ7FOU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0V5Pmrmrvm9hrU8wrZ1WgBN3dooSFM2wp0CH8ECk7ww&oe=6A95DE3C"}, {"file_name": "screenshot_01_coin_trail.png", "id": "888256780666510", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673780696_888256783999843_1367271276265712207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-I5luGWTdwoQ7kNvwH5aZ8R&_nc_oc=AdoBm-ENok9VY_Ijh9lTm2kCVxn_9bCGmpcrIklxV4qUpbZ5UmuCY0OSERTBNBPCnMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeaUNf56hyII6uKRzI_OmwhcYKl1ci3CorPRU-Bs8IDA&oe=6A95D5D6"}, {"file_name": "screenshot_03_level_vista.png", "id": "1295268972503088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312310_1295268975836421_9133143210799255965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6q8JeShMnkQ7kNvwEDk62Y&_nc_oc=AdqnVpPd5SeFVuvrGps1Vgg5Not_nO-Cm5p2yEoMklOKZg0s3ICSt-C7tbMv4pkLJhA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2UouV4R1NbEcWHMoTYPGA6-a2iF_JQwT6qrH2n9n6XA&oe=6A95AE1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1602252444830748", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619681_1602252448164081_2145720626556957219_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zivOTY6mbUQ7kNvwG2DYOH&_nc_oc=AdqpyopbbYeVEqgl-sw_gaAO8Sa7LESZs94t8UST75krMun8PfjqiSS7bzB6VKwFa6s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaTw8x2NMpfiBcawypGfuv499X6z9Wgr_CTxy9DBsz0w&oe=6A95BF62"}, "display_name": "Nimbi's Adventures", "keywords": ["platformer", "family", "adventure"], "long_description": "THE BREAKOUT VR PLATFORMER OF THE YEAR\n\nRemember the first time a video game made you smile? Nimbi's Adventures brings that feeling back... except this time you are inside the world. Join Nimbi, an adorable white mushroom with a red polka-dot cap, on a third-person 3D platforming adventure built for Meta Quest. Every level feels like a life-size toy diorama: castles towering over you, pipes full of secrets, and waves sparkling beneath wooden piers.\n\nCLASSIC MECHANICS, BRAND-NEW FEELING\n- Run, jump and chain precise double jumps.\n- Attack enemies and smash breakable blocks full of surprises.\n- Collect regular and red coins: each one buzzes in your hand with haptic feedback.\n- Gather 60 coins to transform into GOLDEN NIMBI: your attack shatters blocks and defeats enemies in your path.\n\nTWO WORLDS TO EXPLORE\n- Hills: green meadows, castles and mysterious pipes.\n- Beach: wooden piers, warm sand and sparkling water.\n- Your progress is saved: clear the Hills to unlock the Beach.\n- Generous checkpoints and a goal flag to celebrate every victory.\n\nREAL VR COMFORT\n- Orbital camera with 30-degree snap turns: no continuous rotation, no queasiness.\n- Instant one-button recentering.\n- World-anchored HUD, never glued to your face.\n- Comfortable menus: just point with your controller.\n- Native 72-120 Hz on Meta Quest for constant smoothness.\n\nFUN FOR ALL AGES\nColorful, cheerful and easy to learn: a perfect first VR game, great for kids and for lifelong platformer fans alike. Classic platfor", "short_description": "Jump into a life-size toy world. Run, double-jump and go golden with Nimbi in a comfort-first third-person VR platformer made for Meta Quest.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/2f4ad790-50df-44e8-a18d-18378f5108ac", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/code/artifact/2f4ad790-50df-44e8-a18d-18378f5108ac", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1101077435691692"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1357278929356774"}]}, "baseline_offer": {"id": "1357278929356774"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786539960, "status": "PUBLISHED", "id": "1357278929356774"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1101134279019341", "version
https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296127_1600293128362024_698039398750824693_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUBtC-VTD9YQ7kNvwFWCsN7&_nc_oc=AdrCREjANamGgWpUHEsiq8CHe1dt-k52BOVuYho5bMUoHeUuzfkZ-oRVs8i-DKczCvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObMlsZyPaqqmTspndY5j0QIQPASBimE-Jti0_xY0iuGw&oe=6ABFD0E3"}, {"file_name": "screenshot_02_nimbi_world.png", "id": "2286916665045619", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302374_2286916668378952_4859557919208368209_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFqQ0vs7SlQQ7kNvwF1f0gi&_nc_oc=AdpBzFnTgStSYeuTH_4Av5Uf6jVV-9MqeGA-i-P9zeUVCYUbglY6JL1vSB_N1OixuHc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFZdsTAYZ01GcdWyib4pVIMRfYE3LmolM67Zs8BrW5LQ&oe=6ABFDD98"}, {"file_name": "screenshot_05_comfort_menu.png", "id": "2058621092196858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307309_2058621095530191_366338629048714481_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwZWwShmASMQ7kNvwGQbW3X&_nc_oc=AdqMnxCsFKitr984QI-G_jx7uMeX4x1f7h_SU-scymUMr_uXGa-P8RZx5E1TUSYPaNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPX3R1Nr5fz4XAAX2y1ud_d2FnxExJc9HUBuJ2_q7qYuA&oe=6ABFD5FC"}, {"file_name": "screenshot_01_coin_trail.png", "id": "888256780666510", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673780696_888256783999843_1367271276265712207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mX76bSSHTd8Q7kNvwHaNtiI&_nc_oc=Adqm2gvbBVDFHf_Xu2j1wSBeBSO2zk42k6_bbS7AIwdSnGTDWLzn37aqJaFibkLwA80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0pAMk7OgCms_ZyFaEey5195s3gHTFEYXFokd7Q7Ey7w&oe=6ABFCD96"}, {"file_name": "screenshot_03_level_vista.png", "id": "1295268972503088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312310_1295268975836421_9133143210799255965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GCB8CxHU8sQ7kNvwEuYCA6&_nc_oc=AdpLhEeg-YebLKEVjyMLXSQj8y8Suy5MzxUjDIiaZ9iMdZtQLnSjV84ZLy7KJH992DI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw5-jKXpGyB2nW4nmVBc0LVoJl375yXGAfJcYeF4kqkQ&oe=6ABFA5DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1602252444830748", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619681_1602252448164081_2145720626556957219_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nl6O_1yO6vYQ7kNvwHSf9yF&_nc_oc=AdrlIRc7T0SjRodga0JW5kuR_xNkmt2wQ_S_FS3u7tSdz_PYMUmswjC-C-DS0S97_pM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPlQripuAS0m_syRKI4LE9yxQ643mr_nurr9Zlf0G-Pg&oe=6ABFB722"}, "display_name": "Nimbi's Adventures", "keywords": ["platformer", "family", "adventure"], "long_description": "THE BREAKOUT VR PLATFORMER OF THE YEAR\n\nRemember the first time a video game made you smile? Nimbi's Adventures brings that feeling back... except this time you are inside the world. Join Nimbi, an adorable white mushroom with a red polka-dot cap, on a third-person 3D platforming adventure built for Meta Quest. Every level feels like a life-size toy diorama: castles towering over you, pipes full of secrets, and waves sparkling beneath wooden piers.\n\nCLASSIC MECHANICS, BRAND-NEW FEELING\n- Run, jump and chain precise double jumps.\n- Attack enemies and smash breakable blocks full of surprises.\n- Collect regular and red coins: each one buzzes in your hand with haptic feedback.\n- Gather 60 coins to transform into GOLDEN NIMBI: your attack shatters blocks and defeats enemies in your path.\n\nTWO WORLDS TO EXPLORE\n- Hills: green meadows, castles and mysterious pipes.\n- Beach: wooden piers, warm sand and sparkling water.\n- Your progress is saved: clear the Hills to unlock the Beach.\n- Generous checkpoints and a goal flag to celebrate every victory.\n\nREAL VR COMFORT\n- Orbital camera with 30-degree snap turns: no continuous rotation, no queasiness.\n- Instant one-button recentering.\n- World-anchored HUD, never glued to your face.\n- Comfortable menus: just point with your controller.\n- Native 72-120 Hz on Meta Quest for constant smoothness.\n\nFUN FOR ALL AGES\nColorful, cheerful and easy to learn: a perfect first VR game, great for kids and for lifelong platformer fans alike. Classic platfor", "short_description": "Jump into a life-size toy world. Run, double-jump and go golden with Nimbi in a comfort-first third-person VR platformer made for Meta Quest.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/2f4ad790-50df-44e8-a18d-18378f5108ac", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/code/artifact/2f4ad790-50df-44e8-a18d-18378f5108ac", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1101077435691692"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619805_1434268211848975_4519859917854250233_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2ZKGLImJRsQ7kNvwFNkvXu&_nc_oc=Adpn0zKOmSmbnU-lBz-W9P-3vy44hswN0i4zl7afQC6tj7Mg032rD4iG_9r1fIk4VqQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtcQ1xbMWSQURRawyU4yJ9Z4QgQhooN2-T-3czYJ8gtw&oe=6ABFDD75"}, "is_concept": false, 
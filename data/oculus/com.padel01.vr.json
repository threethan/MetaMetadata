g_cciu7wD9daT4oFDRbzHFHQjpYhdG8SS3v9WA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI7wahrPtS5eFvAXT7ysRGo0MB_eq42Jl8Zr8R5xvfZA&oe=6AFC6113"}, {"file_name": "01_01-Immersive-1v1-incoming.png", "id": "1783712422918546", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673652249_1783712426251879_2103893628972338834_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNjKtSgvGm4Q7kNvwGpsSX3&_nc_oc=Ado-vIuOs-dhYxXYIwBFy4tI5vXzQavKk_PR7FlkiMStP57pXXT6PdeTYyLATnydTN4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEq_WU1nzL0WM3x8DINW-L0ikkkmtMGFMIahND2Zc7Vg&oe=6AFC83DB"}, {"file_name": "04_05-Targets-drill.png", "id": "1750328809356814", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604347072_1750328812690147_3124753942794966689_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHKNWmqkmFAQ7kNvwF5K2MP&_nc_oc=Adry4Q6qyDZtzNrcxBuQQEUzqcNDy-WZVP4Dyed0UEALgrSQw7s3SA_chVoK5SNmknU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQscNn1dJY5UNsuhVLg9uy0PrVmrNLzoSGYH3XHO3FJKg&oe=6AFC7C93"}, {"file_name": "03_04-Doubles-two-opponents.png", "id": "971325798828379", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830576_971325802161712_2436298973952341413_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Pk6zjrlPm0Q7kNvwFRTNHE&_nc_oc=Adqsxc-r2MDyuBp-isw9-efktSkT-5997WvZUOsX_8GmIcG-c_KSDzGRAfVjsW8geu0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc13hdjX2eXFafJ_9KSxCMG7VNBBKqpAXnMWwe5PsLYA&oe=6AFC766C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PADEL 01", "keywords": ["padel", "sports", "tennis", "racket", "mixedreality"], "long_description": "PADEL 01 brings padel to Meta Quest. The court appears in your own room at the size that fits your space, and every shot follows padel physics: spin, bounces and rebounds off the back and side glass.\n\nWHAT YOU CAN PLAY NOW\n- Singles and doubles matches against bots, from Gentle to Pro level\n- Free rally to warm up and practise at your own pace\n- Drills for back wall, side wall, lob, volley, bandeja, vibora, smash, serve, reflexes and more, with stars and personal bests\n- Optional online rankings for the monthly drill challenge and the bot league\n- Three racket shapes with their own feel: Round for control, Teardrop for balance, Diamond for power\n- Passthrough, portal or fully immersive court\n\nEARLY ACCESS\nPADEL 01 is free and in Early Access. This version does not include online multiplayer, avatars, a shop or in-app purchases. Coming next: the PADEL 01 club with online matches, tournaments, avatars and cosmetics. Nothing you can buy will ever give a gameplay advantage.\n\nRankings, cloud progress backup and play-test diagnostics are optional and can be turned on or off in the privacy settings.\n\nJoin the community and tell us what to improve: https://discord.gg/h44S3ZS3yn\n\nPlay in a clear area of at least 2 x 2 m and keep your headset's boundary on.", "short_description": "Real padel in mixed reality. Your room becomes a padel court: play singles and doubles against bots, use the back and side glass, and train volleys, bandejas and smashes with three rackets that each feel different."}]}, "developer_name": "Wilzig Studios", "developer_privacy_policy_url": "https://sites.google.com/view/padel-01-privacy", "developer_terms_of_service_url": null, "publisher_name": "Wilzig Studios", "support_website_url": null, "website_url": "https://discord.gg/j6h2qf64r", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1859477188830588"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1411336207826288"}]}, "baseline_offer": {"id": "1411336207826288"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793116800, "status": "PUBLISHED", "id": "1411336207826288"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1885208749590765", "version": "0.1.3-ea"}, "id": "2588151591687704", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1859477185497255", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1885208749590765"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2588151591687704"}]}, "change_log": "EN: New ball and racket physics, with Club selected on first launch and Real still available. Updated bot movement and difficulty, clearer player card and match summary, and larger scoreboards on bigger courts.\r\nES: Nueva f\u00edsica de bola y pala. Club se selecciona al primer arranque y Real sigue disponible. Mejoras en movimiento y dificultad de los bots, tarjeta y resumen m\u00e1s claros y marcadores m\u00e1s grandes en las pistas grandes.", "created_date": 1794397958, "id": "1888618045916502", "version": "0.1.4-ea", "version_code": 112, "release_status": "PENDING", "status": "SUBMITTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "An
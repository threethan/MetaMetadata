sid=6e7a0a&_nc_ohc=DoEg2hdrbeYQ7kNvwFJYjOj&_nc_oc=Adr1F9rvCsngLg7IqJxw2bzKwRRdR-97UcoghTXk6MFURia6BxzBU22ZatU82HjutCo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVNn63cKmN6_LcDSni2yTRMnB-Fvlu4Bzu_54-8cAsWxA&oe=6B0F1F09"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yU0IP8HWeIUQ7kNvwE6lvSd&_nc_oc=Adp2uUdpXQSGMzQdpMCcdGsJjJx7NUGPRyne9aZEHOwR1C5EdZoKaMMM8SX_IKqbm3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEWxcMUY85oOY7GRQPbqRgh2f4kmGg7OVeSlBw37UtHA&oe=6B0F01BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmixnGQOpawQ7kNvwFrk9Zx&_nc_oc=Adp2gnPY7kW-zs5Nrjo8yX0_gmw--_4mkwaqp5wcez-QLNVqif8jJ3nH_SqudU_ak-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVR7Bn3G6KpAPbAteftA5fwgC02Cnsr6x23DiuDTclSmA&oe=6B0F0F49"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHNs_PEUyfEQ7kNvwE4Ld3B&_nc_oc=AdohREFUQ9dxazVumPG5Z_5OwJKe-tfYfzwTRejbOWmhgM1bP0TsOOE_vpRVwHN1hXo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW-oZwS-r1fR1AR8Dy-xgF3N4d7ZSIJIpfeZDFULP8drQ&oe=6B0F03E1"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NItOJFzcJoEQ7kNvwG09ivM&_nc_oc=Adomlyjbbcm3cgNsJgWII3TLdIdaCpOUVvgSwtmhSTqpX1w8okoXgYDR_bxawWSnL7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWU-CPGolfnQWK4CBvQ2u97qk92uHK-qeg7Wm10P6wkpg&oe=6B0F16DA"}, "display_name": "\u30a2\u30eb\u30c6\u30a3\u30e1\u30c3\u30c8 \u30b9\u30a4\u30f3\u30b0 \u30b4\u30eb\u30d5", "keywords": ["Chat", "ONLINE", "SPORTS", "MR", "SHOT"], "long
f&oh=00_Af9S2TZg_ZUhJbdGZWOdqH4WZos7_4gM11L4l4fBG0B73g&oe=6A34034A"}, {"file_name": "\u4e3b\u89b3\u8996\u70b900.png", "id": "1124599562013630", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035401_1124599565346963_4804926702366139894_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJdf2Q9gS3EQ7kNvwE0ddno&_nc_oc=Adrt8rXi-VGTe6AK7n88iyjU_ubrHQk0VvO5kak5giH2iQ3aS-LSW30dxyW-dxSQCd0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3dZQDtH6sF-w0MQxCE9eTBRkjzJISvLxfl8qCMlMILw&oe=6A34145F"}, {"file_name": "\u3010\u30a2\u30d0\u30bf\u30fc\u3011\u4e0b\u534a\u8eab\u8868\u793a2K.png", "id": "1591040491515800", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974771_1591040494849133_2136140886031552571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7OE8O1ZHv4Q7kNvwGRyZaU&_nc_oc=Adr5bkNn-_iqNLxDe6qmaQguH0IUp3RA-Js5AqNPz1pgb9C2s2mxj-Bh3gEuLPG61k0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99JYGOyWoNyr4V86wpht8wHngRmfNCN8UaHaGxKzNPxA&oe=6A341B83"}, {"file_name": "\u30b9\u30af\u30b7\u30e702.png", "id": "1203234357544530", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570294_1203234360877863_9145783152507878137_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTQ-0KxNlx0Q7kNvwEHb6g1&_nc_oc=AdpKGf7MR78pBjv4sVo38j1SzJoQaQut5968wD4Mobe8fB_QB_LYCpOqyuBP-FCgGvY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QsuKYdzkDxZ1yqgIdCuFz2Lpr4fTrPha62mMXgiTddQ&oe=6A340DB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560-1440.png", "id": "981137503977837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392123_981137507311170_7676455766277365046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouds2yNDg6YQ7kNvwEuDgsf&_nc_oc=Adq6yERjs3YllTOd8ryxNMXFzU8eicw-nyrNIoo8S2GqnCfDNAsJe-6_O5U2B9IAHtw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xV2iiqosCbBDIcqNR0bY7kMcHqQUx_jbtv5myavN6sw&oe=6A341048"}, "display_name": "ULTIMATE SWING GOLF by Clap Hanz", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "\u26f3\ufe0fNever played golf before? Don\u2019t know the rules? No problem!\nYou can still have a blast with \"ULTIMATE SWING GOLF by Clap Hanz!\"\n\nDeveloped by Clap Hanz, the world\u2019s longest-running pro golf game studio, this title brings the fun of golf to everyone\u2014no experience required.\n\nJust grab your controller, swing away, and enjoy ultra-realistic golf in stunning VR!\n\nWhether you\u2019re a total beginner or a seasoned pro, there\u2019s something here for you.\n\nWorried that golf takes too long?\nNot with this game!\nLearn the basics step by step by answering simple questions\u2014then level up your skills in no time.\nSoon, you\u2019ll be swinging with confidence!\n\nAnd here\u2019s the best part:\n\"ULTIMATE SWING GOLF by Clap Hanz\" is now available at a drastically reduced price!\n\nThere\u2019s never been a better time to start your golf journey.\nWhy not tee off today?\ud83c\udfcc\ufe0f\u200d\u2640\ufe0f", "short_description": "Your very own golf course\u2014just a headset away.\nJump into the ultimate VR golf game anytime, with anyone!\n\nBrought to you by Clap Hanz\u2014the team behind hit golf games for over 25 years\u2014this is their latest and most immersive VR experience yet.\n\nJust pop on your headset and you're instantly transported to a stunning course that feels like it's right there with you.\n\nWhether you're brand new to golf or a longtime fan, Ultimate Swing Golf by Clap Hanz is packed with fun for everyone!"}, {"images": {"nodes": [{"file_name": "PORTRAIT_1008-1440.png", "id": "3552859728348491", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393846_3552859731681824_3714380810341091286_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5tEK1qTljYQ7kNvwF0LHPD&_nc_oc=Adr47zkt6ZCbpX5mQgBm7MYMazJpnMAL7IhT13At6aLDiz6Ir0qNt2d7WQxY1Wf_lsQ&_nc_zt=3&_nc_ht=scontent-atl3-
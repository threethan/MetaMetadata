sid=6e7a0a&_nc_ohc=rTv9LU9jd-IQ7kNvwEPSjfG&_nc_oc=AdryvG7mWmiSyeCJ8JhIBI-RQtdbAbIxJY7vLL6kuYqUl2Y_u6GEw7DwqoMVs7YfWN0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA-B2EbDTeg_Nk3beG5zLsV_vBi5cCzZyebVgFD5e3WQ&oe=6B09A0C9"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyXwE988a7oQ7kNvwGc3iEw&_nc_oc=AdpCpMGVFbrsI0D2LABPC8PSOphM8H4_9PTZDwC32exzSRjvvH8oqSgtpE4UltLjRp8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6lwXIGsjeY7krpaB_tsXnJpHw7ewSWX28uClMB-NRjw&oe=6B09BBBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3Ub6FJHF8sQ7kNvwGY9WYN&_nc_oc=AdpbDd1YGyHeMQah6MyWJCxlEST9WiLRH4rJwEFI7rD2VVV4TYrbE9KLTEY0-llX08o&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY5oKY5EDD50BnlurMi881QZEitUh8kf5BBJ-ByfNSiw&oe=6B09C949"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hBn1GBaI74Q7kNvwHMiRyO&_nc_oc=AdqxGCJZpnLhsLRxRN0fdYPQSoXzXMBB0gTbY3H8xMQpaKri-MI9GvvTlir9K3EMYYc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvqmk5-R_HsTYJNibwXEKcK3yrX-whv7qeh7bAUfStnw&oe=6B09BDE1"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aXYOUpskPkQ7kNvwGkqK8K&_nc_oc=AdqNMcyeha5HdsHz3bb_0VA4SDX9HsXM0oEHcbPRqr1-8H1M51brk40ChNz4Zb4ChKM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpM3GqSIGZY_CnNNgSH6PxNywSUW76UyBvXwL6jLGiuQ&oe=6B09989A"}, "display_name": "\u30a2\u30eb\u30c6\u30a3\u30e1\u30c3\u30c8 \u30b9\u30a4\u30f3\u30b0 \u30b4\u30eb\u30d5", "keywords": ["Chat", "ONLINE", "SPORTS", "MR", "SHOT"], "long
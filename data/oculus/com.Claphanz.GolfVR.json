sid=6e7a0a&_nc_ohc=aIwJWcGhhkgQ7kNvwEwwYCy&_nc_oc=AdpBuq1hDGT__XsG_D9bOAjXIpHPQG9rv2Vh3mZWchJUKb2PO6UKRLXZPivyOwQIPDA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCuMWDP-82fZsr6o1K29Otb7zAFZObClvp3rOp4edv_w&oe=6AFDC349"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXbXx7QmeJUQ7kNvwE-Fi6K&_nc_oc=Adpyw2SIynLCTf4a85WmqQ_AgsryHqUQ1GKaSJfa7CnLDX3y4UtP-aCBs0CvopfiZ70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8ILof7Gw1QxIVMbFkiNrBE7JMM9XyA5EiF2gpObyEIA&oe=6AFDDE3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmw01BMVwc4Q7kNvwH0LDdy&_nc_oc=AdqOUDPDXoKkPcaiYap6HgB_It7MpbSxrNpPv87SUKLmIhnxSR6IPsE-AoNnKMSmAMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFLJHT_8rto-GvPDvDJxX3aDjh9fmg4_geDcWY3FIvug&oe=6AFDB389"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgj9k1tZcgkQ7kNvwEkktzW&_nc_oc=AdqMueLhztUIOMaIaYQglK34RDreGqmI1QDewOHG-hi1CLL_gUiq_4ETG69OBQcgot8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQylOoa9xFYAeuT2KACTT5CNOvr4Ozsb3mTLnPi8ax2ow&oe=6AFDE061"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRcDuwRB5koQ7kNvwFJ069X&_nc_oc=AdphKB3h0kGBo42EHDSH-l5VUYrkXHht1uD3V1WHRNSTLeBsqg-IMq_Clcw4Hrf7DT8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbgE5wT2lR45kLu8NQmhlUa24SBGh6S9kLOF58D2pt7w&oe=6AFDBB1A"}, "display_name": "\u30a2\u30eb\u30c6\u30a3\u30e1\u30c3\u30c8 \u30b9\u30a4\u30f3\u30b0 \u30b4\u30eb\u30d5", "keywords": ["Chat", "ONLINE", "SPORTS", "MR", "SHOT"], "long
sid=6e7a0a&_nc_ohc=aIwJWcGhhkgQ7kNvwHd_SRK&_nc_oc=AdrgIlbyS20GEBQAc99F1hfOx_k0xzfJP3-_AcB9unTGNtnJgtGbWINVFhU-TF47AWU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhA4_uTUQefFZ5PbgRXjVbwa85zZDowzINLAw9NQ9YAg&oe=6AFB2049"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXbXx7QmeJUQ7kNvwFMfJLD&_nc_oc=AdriwO83jlj3KU7nHd8w7LQXzGTAQGwRxiDUfqcu3-IUinHNvPWaM42eYJFyMrsoDzg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYV4CvffFUQ99xMSOOaAwoFG56SikoIF1Lj9Z7p-hJWg&oe=6AFB3B3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rinH2D9NlsYQ7kNvwEBXcQu&_nc_oc=AdoaWmNCcBcPEG9qxcTa-wCyPA_Jj29DWCvTapdnHoqMeHZ-uEfGKu9Y1LiDenUkx0E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwPWp7GZgI5If_9pZ64C4Gs3b6isX4Do_7LpWzGlY6hA&oe=6AFB48C9"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFNgWNeDvpwQ7kNvwGuQh_4&_nc_oc=Adqe84jrturw4Wiyo8MayTlr5CBWEUDFOjoNlPD9GQ3vIhR2eRoCBl8F5178q7W3u2o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScjwmxQwKObLs_xjNqSO9iU5BKOZEslzYNTqh54dC74w&oe=6AFB3D61"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwArypaoCMUQ7kNvwFunpH7&_nc_oc=AdrVUdvGIoO80q1cg4s4sk-q-ppGwc2uC6K25rGVAt-GuQ2OKf7nZCeHr6StmfV5lsA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLfYqozZ7bsy4Q7k6z3u7itKIAbJQ6RcpmcJZes5m36g&oe=6AFB181A"}, "display_name": "\u30a2\u30eb\u30c6\u30a3\u30e1\u30c3\u30c8 \u30b9\u30a4\u30f3\u30b0 \u30b4\u30eb\u30d5", "keywords": ["Chat", "ONLINE", "SPORTS", "MR", "SHOT"], "long
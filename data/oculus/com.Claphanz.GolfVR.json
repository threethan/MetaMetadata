25/39003277_1594968264641130_4705740987765687396_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ib4MedTB9EQ7kNvwGhRf9w&_nc_oc=Adluu9vHPZhFUm45-AXV9b3Hbk1yqADbLUZW-_2PSuR32dNQvMPU4yU3uh3Gt4VJ-sI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxBdUpaVZ_Sfhx8ujnKkYifQ9rf_gMTOW3JBS1OnOIBng&oe=69BBEE5C"}, {"file_name": "\u30aa\u30f3\u30e9\u30a4\u30f301.png", "id": "730391658875123", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003266_730391662208456_8955265094551262484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PLF1Fe-0HEQ7kNvwHOh-SJ&_nc_oc=AdlN8MYYmy0Idf_5Gy7cmTcz4SlqagxPvyqGIHbNkyQS1HKKXC63VOCj5WBWhshmTw0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx9cRyKC9BEWdLPdMmVXcopQc5oAdTXL6W-uxnibbnjYA&oe=69BBDD09"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aexHp-UGsRwQ7kNvwHYzJTR&_nc_oc=Adlq2c6oBHaZvYrhDuFVLPZLB-TEVu9b80aq_80QYnXcVfYc5CXvEh6sUo68KTIEvLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzPoD3-ZlgrhX6d9D4M8lM8akKgq8Kuqcr8e9MDy1EM4g&oe=69BBF7FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7XWH001VRUQ7kNvwEeA4yT&_nc_oc=Adm9x1EjC0C8cwBAfO-fqKjQZHHv2mF2_Wpoeq8lMxdq3TSdIYJvlwb7PaDkw9fIzmQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyhGCVYOtZnnP4b5TUYuuhGLD8AOT93dy_Rwnb8n4aHJA&oe=69BC0589"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5zX-eAxwqAQ7kNvwEJRyhT&_nc_oc=Admz2SyQs8EKEX9YTotfQJDLIycf7wd2QxpmbbdSypwyW6qxT17YYRuv5kB7ZWkajS4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHVy_qE9UR-gGC8JCqX4293Lv7yhzF837BZzSWU3Zi7Q&oe=69BBFA21"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&ccb=1-7&_n
sid=6e7a0a&_nc_ohc=rTv9LU9jd-IQ7kNvwEreW5H&_nc_oc=AdrdFW85xhm5g2sj_EUZ7byte4WoY0tBVpNfdcjztCHsPXBHJ9c4v67PVtf0Cwdmy6o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUeZhZet0yWAd95tE7JQ_6I6hpbsLw6uTvnmb-Z0-R8Q&oe=6B06FDC9"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyXwE988a7oQ7kNvwHXuRzF&_nc_oc=AdrHYzz5JDX1soLbWeDNkh9bTEtO5UtFSg5d7cN-pf2iOmPgr4IeUaNHRpusF7ztvww&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7kR_OADF9iUWmwiviMwDzOa9CFwfpHQv3NkOk_WkjMA&oe=6B0718BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HyZjsE8vAYQ7kNvwHXVvhb&_nc_oc=AdoYWN85RjLfhrDLfMm0M0j6F5Q7sRoa9LQhwn6vLdr1lDxucNyUvNj5JVpLttFkxLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQUdyIoSG7B5Ya8GN3mUmTKn7cbL1jk56OkrBCb2qqYA&oe=6B072649"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fm5GqXa3f84Q7kNvwEY-XYu&_nc_oc=AdpY_p1Iqg5PDep5HYOg4jzOe4KeeNcknWe-An-4TvLOFYgaORZiWK68AiIPoEKPrCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzgm4BnVnsGHoT3ZA5q9UWKCC0r-UGFmiAYi0S0PX_Bw&oe=6B071AE1"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fd-L88Ngx6sQ7kNvwG1OOMC&_nc_oc=AdrPMOuDutd9lZNJ8MdQ4D9I734aevQciVOvdUpiFZTfea0RNWKsMUqCg2vZnMZPy1c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjc3dMSzqjv8cODv2Z8AwCrJtKK1LBK-G2RNldH3SYUg&oe=6B06F59A"}, "display_name": "\u30a2\u30eb\u30c6\u30a3\u30e1\u30c3\u30c8 \u30b9\u30a4\u30f3\u30b0 \u30b4\u30eb\u30d5", "keywords": ["Chat", "ONLINE", "SPORTS", "MR", "SHOT"], "long
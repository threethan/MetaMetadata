culuscdn.com/v/t64.5771-25/39003266_730391662208456_8955265094551262484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCY-9SNi3X0Q7kNvwGulmB2&_nc_oc=AdkYTpJAkwxt9p1fWWFWHH__z_7MFvEdJSS_K2t5pbZWrpmSKAX3eecr-Oyzn_8jaDU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftiT0rWDcIrk7kgLTQHzNebZDBlW2lk5fanhK9TVISbMA&oe=69984489"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Q75jUHv3scQ7kNvwEQkzSx&_nc_oc=AdljREopFTtE1znvE1Xot8KeoFietmKy8TxYyAQ9QwTFzdWLvYma755MmDllCM223yo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsB_HvzabM5C8hqHTl9ToNxuCW5qNkB0SAoZXIBXwfnrQ&oe=69985F7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7POfo5ttrAQ7kNvwGH9IWY&_nc_oc=AdnZL9WMAjoRMiJTvhDgrQHe1iEZBlXWxqRtvaDHaYPV5U7HOU5wJpociBnQsks2sSk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftZE5FEVrpd_pqtAFjjjHBZ27L0semGRo4lVuzce53wWw&oe=69986D09"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTdVrFRp8rsQ7kNvwHKiyri&_nc_oc=Admofa9zcG1hnfp9WwGDpQj8mqR85geUZb4zs8WNOI83tnNaL4gnAs38SKCnU6MgCak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfutTaCc9we452Y_CMm3RnqqTb2YG1b0eF5j9wQ0e2fBlA&oe=699861A1"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bj_C_8VaZHcQ7kNvwHpH1aJ&_nc_oc=AdnaQnCQ7GkcVIVfpPgLPiJqqSXDsti4BtyQPxiA4DJoIy07lt4jxch_2jQmY6puxK8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsaQRNlDzC7P3td1ZkltgPsiZtneRSUaXA-1Yjp9-9cwA&oe=69983C5A"}, "display_name": "\u30a2\u30eb\u30c6\u30a3\u30e1\u30c3\u30c8 \u30b9\u30a4\u30f3\u30b0 \u30b4\u30eb\u30d5", "keywords": ["Chat", "ONLINE", "SPORTS", "MR", "SHOT"], "long_description": "\u9577\u304d\u306b\u308f\u305f\u308a\u30b4\u30eb\u3
culuscdn.com/v/t64.5771-25/39003266_730391662208456_8955265094551262484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7p7zvWi-SMQ7kNvwFs5mIM&_nc_oc=AdkgNbHN_9rvqDQsFitYQxqnOeu8FrDJs_lLm4F-UQp0mz1XdQB9H0oknVjB490e8Ns&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvgWlj3c-0J839j71oW0HGWwgJ244dT28PsAn7Vr6Di1g&oe=699C3909"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbfnJGd4FWsQ7kNvwGhyal5&_nc_oc=Adlog_va4SSnmiSgV-I-0siqu9TsSvQvqPvLVJVfjgsGvzId8fbDlOT7l1mzUt2aO7g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuitqJuJSfKsH4axNyZ_jQ4P6ZRROkygMFTPPh1U9QUHg&oe=699C53FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqTM9wmXTPAQ7kNvwHl1o1n&_nc_oc=AdldshF5eR23yBlsKWq2qc7OQSkRfkO6u7NWZcDuipfVSABp_ifgwh0H_8oFZzCDUNY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs-ieEZW9X4rwBj_C6qkC5ZFLDN8ueTDcIqT3sSAmMNEA&oe=699C6189"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aACFS-tfL7AQ7kNvwFipVYm&_nc_oc=AdmSVkXvT0V3sHJ3ggkMwZC3c38rHiv8qJgSZY8k5bNbNP2apU6sB4655YOpyloHuOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftVk_HqS5NIG2I6yvMl3geDfmW5_gqnf2RTxzETVGaoCQ&oe=699C5621"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsVkca73wuQQ7kNvwEfQnvx&_nc_oc=AdmXaDg0pe8I2JpXUt24Q5yFTrPsaXHMhUBtUQ6SSNrWUFr_HtCghk4E7o35JMo7s_E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfucCYZEpsSIE_d6eisw05MP0oEpHD5H-YA_AAAhAhUVRQ&oe=699C30DA"}, "display_name": "\u30a2\u30eb\u30c6\u30a3\u30e1\u30c3\u30c8 \u30b9\u30a4\u30f3\u30b0 \u30b4\u30eb\u30d5", "keywords": ["Chat", "ONLINE", "SPORTS", "MR", "SHOT"], "long_description": "\u9577\u304d\u306b\u308f\u305f\u308a\u30b4\u30eb\u3
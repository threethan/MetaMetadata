culuscdn.com/v/t64.5771-25/39003266_730391662208456_8955265094551262484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVv3EQKKEkQQ7kNvwE8Hjui&_nc_oc=Adlj_cN6rq5aU7m5R5Svegmyo1DCOapSQ3AI0tSVviU8ivkSx5FlsfF2VruPp4GuE5w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsD-roPvhHHcYZNS-zQoaJ51x_wDIHL_b2QxgT_GkmKdg&oe=69A57389"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYdNjPtfeaoQ7kNvwEspMMo&_nc_oc=AdmZtsZNPxYR6C5hMXb1dbtyxDNYM__7wB0j_vyS7yYtmBdR1ZFPhsYybIfb5cRM414&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvgUI5TsD-pPhYg9ptyPaUUnbKwcSKC3ox0YZTh_H2sng&oe=69A58E7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8EHilII3m8Q7kNvwG9dr7G&_nc_oc=Adn4W2lYq0WieVi_rxC4VO4DOnECNzq_P-4I0LHauND39raymO2Ut4Nn1Qcmfb_gqmg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsDPmcoXX0zK0HpzUQ-WJUZrz_aPh904uAyEy4U0BRycw&oe=69A59C09"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Up7AG4Tg9cQ7kNvwG1_fyI&_nc_oc=AdniMX1_qT0ugSvdqFjifLn1yjsSO6SDHmI7rchmQqE-lFvOyINhTcfypMjgP3jGCr0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aftb8lyEUQoxruDSPzmCIvxcUOYOSNzH73LcYC1C-VsauQ&oe=69A590A1"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slC53v8HP2IQ7kNvwFmJNtV&_nc_oc=AdmwBiitAxcqmS1yric4W6iHsxrliEEabBo4L8pc8zy4mm-EPaLjyujBbcGwgI4jqtE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvnL1qaSsjiV2ZY1WzRyBqLa2OPMDXB0IpYQpixk9dIMA&oe=69A56B5A"}, "display_name": "\u30a2\u30eb\u30c6\u30a3\u30e1\u30c3\u30c8 \u30b9\u30a4\u30f3\u30b0 \u30b4\u30eb\u30d5", "keywords": ["Chat", "ONLINE", "SPORTS", "MR", "SHOT"], "long_description": "\u9577\u304d\u306b\u308f\u305f\u308a\u30b4\u30eb\u3
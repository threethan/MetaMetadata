sid=6e7a0a&_nc_ohc=DoEg2hdrbeYQ7kNvwFNj69L&_nc_oc=Adr4uEQQpSoZCEV9hinnCxKxfmc1ExwPVEVsghzzYeUos3HASPdpEN6HyO-N8J3D7HY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVSItqpIySSl-dVzzwnlf1wUBk06VEcTIPyZohLmRHNVw&oe=6B103849"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yU0IP8HWeIUQ7kNvwHHKDXd&_nc_oc=AdpIB8nlTJWmvotWaTs1zTw4kkcmWKfzrgAPqi9kAil0HnwAWfIK1Kr-x-XWvY-yX2o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUrUGGZcwCfbKOUyT4qm3HcsrE_QEl6u-5evkUCgOsOkA&oe=6B10533F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmixnGQOpawQ7kNvwF6TcZp&_nc_oc=AdoPaEgyDNt4Pz9EaEYAhTLBGp45McY1xrc0Wh3_KOmCB7VIHHDxlcIvwl0663J24zw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVicUV02IeG13RXMSnGGs4S4P8QdDDn-2fIRQbqSQJYJQ&oe=6B1060C9"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8VmllcITI4Q7kNvwGnEktW&_nc_oc=AdpPCemixoGTmnC9w5bMWSD6kzNGw7bfgNEtM5K57WsAoRRfZITWF7izA1uasP1t8yE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX_DQiak1ex8AT0vJ_UOrsg3uziRlvL_9l5afxr4oviUw&oe=6B105561"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0s_-YPDZ_SwQ7kNvwFTuZL8&_nc_oc=AdoyuE7f5VQIkLFNp37zGfStACbBpLT-_t5gissBTuWQ87E2-1VW8MJTEKGSTYnFV3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXtE_hCv8qgcl7scYw1NAVGetpleDqq6MSwt-6SytpN0A&oe=6B10685A"}, "display_name": "\u30a2\u30eb\u30c6\u30a3\u30e1\u30c3\u30c8 \u30b9\u30a4\u30f3\u30b0 \u30b4\u30eb\u30d5", "keywords": ["Chat", "ONLINE", "SPORTS", "MR", "SHOT"], "long
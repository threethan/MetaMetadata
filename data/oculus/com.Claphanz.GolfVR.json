f&oh=00_Afw-5TtEmN7KWG5M6RQYTEM6GWJU9HQ_52enh5ubzgisuw&oe=69C3BB8A"}, {"file_name": "\u4e3b\u89b3\u8996\u70b900.png", "id": "1124599562013630", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035401_1124599565346963_4804926702366139894_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHC8xZNjnEcQ7kNvwG8vZmC&_nc_oc=Adp7_6VQwjlT-2dpdmF8aM9AkdnP3CuBaMwCaLzw0OIHdW-1KVM2JoO3ahI1-K1WiiM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwVT1-imTve7rDjnDnXUpB4UBkKrlspHfExFTnbhi5sRQ&oe=69C3CC9F"}, {"file_name": "\u3010\u30a2\u30d0\u30bf\u30fc\u3011\u4e0b\u534a\u8eab\u8868\u793a2K.png", "id": "1591040491515800", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974771_1591040494849133_2136140886031552571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nI5asgJaSu0Q7kNvwEgzsBi&_nc_oc=AdpmjbGjS9sh7O-XJPT8Y8i5Yq5RlYeG9FaQ6aetNU6cLNGxwA0MFiBVodPaPh5CuR0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2sMH9f6JqBEp0sFe4M4Ef6l9rS_98Hzu285Qbdba3BA&oe=69C3D3C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e702.png", "id": "1203234357544530", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570294_1203234360877863_9145783152507878137_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDyevbk-n_8Q7kNvwFYFXMs&_nc_oc=AdqWqHe87CyYxLnPQjBK8AsxzR-SgVlxDk5g3yF4-6M8u-JbFMMOREF9KXR95-IrDRM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwW1dI4uuwas_TUIL55uLl5zeyVSx61WWKfNILwgBaGvQ&oe=69C3C5F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560-1440.png", "id": "981137503977837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392123_981137507311170_7676455766277365046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8H42E0GDoUQ7kNvwHTX3fM&_nc_oc=Adq-ExHxqa2-XiktOpzl1uk1CG6vtsfFJcYFsIqTT8p9qB6pvw-vQjxniNwMVplrKPk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzo6IxzUXTwOJVvigRUMbo2EhboS2tHbHE3s8gTDaNy4w&oe=69C3C888"}, "display_name": "ULTIMATE SWING GOLF by Clap Hanz", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "\u26f3\ufe0fNever played golf before? Don\u2019t know the rules? No problem!\nYou can still have a blast with \"ULTIMATE SWING GOLF by Clap Hanz!\"\n\nDeveloped by Clap Hanz, the world\u2019s longest-running pro golf game studio, this title brings the fun of golf to everyone\u2014no experience required.\n\nJust grab your controller, swing away, and enjoy ultra-realistic golf in stunning VR!\n\nWhether you\u2019re a total beginner or a seasoned pro, there\u2019s something here for you.\n\nWorried that golf takes too long?\nNot with this game!\nLearn the basics step by step by answering simple questions\u2014then level up your skills in no time.\nSoon, you\u2019ll be swinging with confidence!\n\nAnd here\u2019s the best part:\n\"ULTIMATE SWING GOLF by Clap Hanz\" is now available at a drastically reduced price!\n\nThere\u2019s never been a better time to start your golf journey.\nWhy not tee off today?\ud83c\udfcc\ufe0f\u200d\u2640\ufe0f", "short_description": "Your very own golf course\u2014just a headset away.\nJump into the ultimate VR golf game anytime, with anyone!\n\nBrought to you by Clap Hanz\u2014the team behind hit golf games for over 25 years\u2014this is their latest and most immersive VR experience yet.\n\nJust pop on your headset and you're instantly transported to a stunning course that feels like it's right there with you.\n\nWhether you're brand new to golf or a longtime fan, Ultimate Swing Golf by Clap Hanz is packed with fun for everyone!"}, {"images": {"nodes": [{"file_name": "PORTRAIT_1008-1440.png", "id": "3552859728348491", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393846_3552859731681824_3714380810341091286_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVNvsmZ01rwQ7kNvwGq2mwZ&_nc_oc=AdoARlI4u7Lb-hj25Wvqp8U77rVKckHLHOJKwdsgxvd3TQzFF6W-NX9MK07qggjyGoI&_nc_zt=3&_nc_ht=scontent-atl3-
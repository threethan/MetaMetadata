iad3-1.oculuscdn.com/v/t64.5771-25/39035401_1124599565346963_4804926702366139894_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvKTru1dXDAQ7kNvwHndPmY&_nc_oc=AdnR0l8VFce0I9IIXiEXAin_rIRU7aagDQUjY-TUhB9SkJhWoP-qoN_6fpeAa8C8Ftg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuY13mnjUc_jWEDKdkRkyNM9e9QZ5ih1ToUZWdQV1TjPw&oe=69A2D71F"}, {"file_name": "\u3010\u30a2\u30d0\u30bf\u30fc\u3011\u4e0b\u534a\u8eab\u8868\u793a2K.png", "id": "1591040491515800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974771_1591040494849133_2136140886031552571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yzDYYlErakQ7kNvwEwk_z3&_nc_oc=AdmeH9eBMFOwn-2d_9ov3jZhLX9WAes4DDehEV94picu-_vL6zo5SNuBVH2IwPm7l8s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGWpheWGpkapYI59PHLdFZtNszB7vS47XEXYPrslozcw&oe=69A2DE43"}, {"file_name": "\u30b9\u30af\u30b7\u30e702.png", "id": "1203234357544530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570294_1203234360877863_9145783152507878137_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhZkbgQkgR8Q7kNvwHLqGPx&_nc_oc=AdmqFkxGAylwiyoqtwxYz9gouegg7IUt7Zb84oBDzRrA7dBrnLWpYptMbqn4JJNRWLM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsKAoN4sICpXOI5aqj1N4lmd1_Gg37WvwXusydKlsCMZA&oe=69A2D077"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560-1440.png", "id": "981137503977837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392123_981137507311170_7676455766277365046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjndHQsCxjEQ7kNvwHiEnVs&_nc_oc=Adnwh1CwLYkycVcIYjYCL1LPR0gcjdieek4XiL5JB2ZDb-MSZMdFKaE1QCW4WJlYSOM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJA_xNFSu2GGq7RbBe2lBzDY8k6oSQc5pdSviIid5lrw&oe=69A2D308"}, "display_name": "ULTIMATE SWING GOLF by Clap Hanz", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "\u26f3\ufe0fNever played golf before? Don\u2019t know the rules? No problem!\nYou can still have a blast with \"ULTIMATE SWING GOLF by Clap Hanz!\"\n\nDeveloped by Clap Hanz, the world\u2019s longest-running pro golf game studio, this title brings the fun of golf to everyone\u2014no experience required.\n\nJust grab your controller, swing away, and enjoy ultra-realistic golf in stunning VR!\n\nWhether you\u2019re a total beginner or a seasoned pro, there\u2019s something here for you.\n\nWorried that golf takes too long?\nNot with this game!\nLearn the basics step by step by answering simple questions\u2014then level up your skills in no time.\nSoon, you\u2019ll be swinging with confidence!\n\nAnd here\u2019s the best part:\n\"ULTIMATE SWING GOLF by Clap Hanz\" is now available at a drastically reduced price!\n\nThere\u2019s never been a better time to start your golf journey.\nWhy not tee off today?\ud83c\udfcc\ufe0f\u200d\u2640\ufe0f", "short_description": "Your very own golf course\u2014just a headset away.\nJump into the ultimate VR golf game anytime, with anyone!\n\nBrought to you by Clap Hanz\u2014the team behind hit golf games for over 25 years\u2014this is their latest and most immersive VR experience yet.\n\nJust pop on your headset and you're instantly transported to a stunning course that feels like it's right there with you.\n\nWhether you're brand new to golf or a longtime fan, Ultimate Swing Golf by Clap Hanz is packed with fun for everyone!"}, {"images": {"nodes": [{"file_name": "PORTRAIT_1008-1440.png", "id": "3552859728348491", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393846_3552859731681824_3714380810341091286_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waPk0jlHGU4Q7kNvwHy0wib&_nc_oc=Adm9f-ede6UoCmanHnQ6z9cmiaJT25vEo6zWPRTW1gwT42apQE9S-2Uu4c96lwd8o2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsbXK602LKUYPzCVCQbR_eI8wsKdlVVBkjdZvyOw_F5Gw&oe=69A2EB67"}, {"file_name": "\u30a4\u30de\u30fc\u30b7\u30d6\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u5de6_400-700.png", "id": "1725309208224365", "image_ty
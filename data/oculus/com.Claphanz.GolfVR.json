f&oh=00_AQTeXUWVxlqd6n11ih2RS1b0ZrClJhxyXsZJuA_0xAnZUA&oe=6AF32CCA"}, {"file_name": "\u4e3b\u89b3\u8996\u70b900.png", "id": "1124599562013630", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035401_1124599565346963_4804926702366139894_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y84MLbCrvEUQ7kNvwG4jUWO&_nc_oc=AdotJ14K-fKo8t5cMLC8Nbrztr66aTA-a285wW07NTmj6YXVozrFWTIw8UmOsqlZmHw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyF5Ti57vY2Mk8Fj_C-WKbqDjxpaMl9vu1wp65qdYOVQ&oe=6AF33DDF"}, {"file_name": "\u3010\u30a2\u30d0\u30bf\u30fc\u3011\u4e0b\u534a\u8eab\u8868\u793a2K.png", "id": "1591040491515800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974771_1591040494849133_2136140886031552571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BI_Vn2zdksQ7kNvwG5CR22&_nc_oc=AdrXKb_kyhCjz-v0j2cGD-8KNBqa1LgtjhKnzaxmySjyxOar7SGltXXZjmO6kEG2C5w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXrTdMeKcxNnN2S8kza1umGx5TeqImATjplHRe_fWygw&oe=6AF34503"}, {"file_name": "\u30b9\u30af\u30b7\u30e702.png", "id": "1203234357544530", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570294_1203234360877863_9145783152507878137_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgVb4-H7kQwQ7kNvwFE2ctH&_nc_oc=Adpx8PFm6he7Zx4I1zNa5j3FgdPA0QAwy0pY7-vDJL1RLUQObWV8iptGha0LFu8AzXI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNREWOsz1WiqlKG1ZiP89Q86NHbdKMJcFsd-9ekHcBqQ&oe=6AF33737"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560-1440.png", "id": "981137503977837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392123_981137507311170_7676455766277365046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOflAD980VwQ7kNvwEWcEG6&_nc_oc=AdpEjBOmOvRW_ZPQay8IKSJLJwUMnVgrcgdMYvwZlNprfAXhim7MM8khYtu0vdNmJGg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiRF9kjXMdAKC8O1lUCl-r3VhQ03irblEumZPZT__a1w&oe=6AF339C8"}, "display_name": "ULTIMATE SWING GOLF by Clap Hanz", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "\u26f3\ufe0fNever played golf before? Don\u2019t know the rules? No problem!\nYou can still have a blast with \"ULTIMATE SWING GOLF by Clap Hanz!\"\n\nDeveloped by Clap Hanz, the world\u2019s longest-running pro golf game studio, this title brings the fun of golf to everyone\u2014no experience required.\n\nJust grab your controller, swing away, and enjoy ultra-realistic golf in stunning VR!\n\nWhether you\u2019re a total beginner or a seasoned pro, there\u2019s something here for you.\n\nWorried that golf takes too long?\nNot with this game!\nLearn the basics step by step by answering simple questions\u2014then level up your skills in no time.\nSoon, you\u2019ll be swinging with confidence!\n\nAnd here\u2019s the best part:\n\"ULTIMATE SWING GOLF by Clap Hanz\" is now available at a drastically reduced price!\n\nThere\u2019s never been a better time to start your golf journey.\nWhy not tee off today?\ud83c\udfcc\ufe0f\u200d\u2640\ufe0f", "short_description": "Your very own golf course\u2014just a headset away.\nJump into the ultimate VR golf game anytime, with anyone!\n\nBrought to you by Clap Hanz\u2014the team behind hit golf games for over 25 years\u2014this is their latest and most immersive VR experience yet.\n\nJust pop on your headset and you're instantly transported to a stunning course that feels like it's right there with you.\n\nWhether you're brand new to golf or a longtime fan, Ultimate Swing Golf by Clap Hanz is packed with fun for everyone!"}, {"images": {"nodes": [{"file_name": "PORTRAIT_1008-1440.png", "id": "3552859728348491", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393846_3552859731681824_3714380810341091286_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1bcZCRqyz0Q7kNvwFz5Xcg&_nc_oc=Adr9PKoB1PB-PgVNn9lgjI3Gr2oZXiDmrUfuKqpk5EPkr_b3vPhy6OvEo51LGmcZAfw&_nc_zt=3&_nc_ht=scontent-sea5-
25/39003277_1594968264641130_4705740987765687396_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ib4MedTB9EQ7kNvwF8S-dM&_nc_oc=AdlCkiHsLG9lOKOmLMLAs8LZhBfZ_6JrrLkh8DU7R-BKf_lR1oOqlOIIMb11PKN1pGg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuA05u0NVEn8-WHqNqtaQZSx_5gAWsll3Js--gELIt6g&oe=69BD3FDC"}, {"file_name": "\u30aa\u30f3\u30e9\u30a4\u30f301.png", "id": "730391658875123", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003266_730391662208456_8955265094551262484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PLF1Fe-0HEQ7kNvwFle-VP&_nc_oc=Admczn-OXS70U9SgOulx0mKJd-B5asHE0m8EYMwu7SjZ5m0N9S8yuF37E0-h9y58D_o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfytRJcfEiMc_UGsUxwFo4pIblGamMZdWyMh_fwGUGB0Ng&oe=69BD2E89"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aexHp-UGsRwQ7kNvwE7AA-e&_nc_oc=Adn9kvzmEgI4Rlr-fo5ozcI-Hj2m3YkEHppv0Y0zwHQQmigHkFoRzZ5DOhCtLTYoN54&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwY9m8bZeBEvsumSHQgnPf0wMpZyE2BfNm7vhmY7qkNlA&oe=69BD497F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjO7sHkxSGMQ7kNvwEjCPym&_nc_oc=AdlAY6qd9hRhlyNlpnDr0nb2_l3mSMRP711EjodB2y4lWSoI42WspPfgW9hG8ITWMEw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afym8BSdG5t2hqjqXAlwTLk2clLKOuqniyGPuaA6MMvI8g&oe=69BD5709"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5zX-eAxwqAQ7kNvwF51T72&_nc_oc=AdmP7SSr0UYh9Z3gzQ-i6CnX7X7IfS7yrpg4PLgx6jIorZdU03BeH6VxPmUPIieg9yk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyea8U_KqHkoUeiDHlo7-MnhJi4nDrUEOIA7yfIdOZEkA&oe=69BD4BA1"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&ccb=1-7&_n
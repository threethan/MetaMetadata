sid=6e7a0a&_nc_ohc=ff-q5gacwAQQ7kNvwECuyjR&_nc_oc=AdqTmHgKYdW-6862x8UlqeOut1UskOXvJ-1GqXgCn54Ttzu8HKQeLlKPvublcDAi1g4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwiQdlcTczlhTPhVc7Kurux13BlPg3kN4NJ2M3VvSMHw&oe=6B030949"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUEbUuhrWQQQ7kNvwFJrBqR&_nc_oc=AdpGT8aWplrsipfWfm50GnB5D0xL92nhdNPeFnTjHOok8KPqPYqwyn_HtgwoG3z8oCg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPs1EatIfIiaKilhzd5MF3M7rHzalcEaVLYuKjLvSFww&oe=6B03243F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ept1PEcHH8oQ7kNvwEmaJgM&_nc_oc=Adrlgu6sk0gktwbMC1ouCpBXas3VChHX8oarZcdvBjJEjQ8ZSFsgeFbluDD22ws9x_E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh4ADCvccu7EDIAUYM2t6-68QzMZOAoImBu5YM3s1Sjw&oe=6B0331C9"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S00_wR8iBlkQ7kNvwHhKXHY&_nc_oc=Adq2HcsP_Z7NZM3B5RBF_No_BzgzyCYKBtnrwW2MJ7cYCAJTONZLyPctqxR1pCPm2ag&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdnLqDxQYU0bdh2_I0ToZujNNWqMqZKokm3mYw38FPDQ&oe=6B032661"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBnBPxtlX2cQ7kNvwGp2Wna&_nc_oc=AdpX0SzHoakJ2D2JNpMcH1O2Kk7v8LkXwd8zp5_C75bXs7ruOi_m0jZjmXuhJJcLWLw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfkYQy5EcYyzYCP3-ccBkF3WwWQLZgI9FViKUETFQDhw&oe=6B03395A"}, "display_name": "\u30a2\u30eb\u30c6\u30a3\u30e1\u30c3\u30c8 \u30b9\u30a4\u30f3\u30b0 \u30b4\u30eb\u30d5", "keywords": ["Chat", "ONLINE", "SPORTS", "MR", "SHOT"], "long
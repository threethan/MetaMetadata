culuscdn.com/v/t64.5771-25/39003266_730391662208456_8955265094551262484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVv3EQKKEkQQ7kNvwEXGd3P&_nc_oc=Adkqrfo8lKkAcRsmwFZBh6Q6SkDZ3aAuYop9tvSoy0IElW5pj4JmUreSFbL7C52ZXyA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv9Sl-RkbZlg9oMQMr3tlOaevosBJVDmS48_e0Ouql5pQ&oe=69A2D089"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYdNjPtfeaoQ7kNvwH8zIi3&_nc_oc=Adk9CGlgX4AbS4MvBJWycw7mVbIOQ1DACmxoJizQtNpxJhoJNT3sAalnBGROJETRT-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfseD9oalCdV644Vd-D-Z3EVjF6Vt6xk3FBdJe7PLxwi8w&oe=69A2EB7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8EHilII3m8Q7kNvwH12kkK&_nc_oc=AdkD05vV-FD4Sd6OysiZC0cAGN2wQEYUoKUpTxZ7QUPioFv1h-i_48zSDRqx9G5SZ58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftiApXudRb0O0aa_zO6kDMfJ7sqTdPL9pTGx-sUeJmFmw&oe=69A2F909"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPzIKXvUwnkQ7kNvwHwIC9x&_nc_oc=Adm41YqRDyZdk5v3BntnEIfNS6ctUvgog9a0drGhnCiGG9KmgQbGN214FqCREgSQohI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvF8yUlazeHbFpA9UOAjgNtqjdvcLC1T9czI0Hc6ajGLg&oe=69A2EDA1"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGL3fJAEi38Q7kNvwGvhCT5&_nc_oc=Adl8DXG7XjXM1NVH-qKxL2W4p5T9rPiNpZw6Qb9Qv9-Be_V-Y-YnHkKXQdzOpWb-r7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvPDphMuRkSb0vh2T3f08MssYGuiCUL-vEvoFBhzvuffg&oe=69A2C85A"}, "display_name": "\u30a2\u30eb\u30c6\u30a3\u30e1\u30c3\u30c8 \u30b9\u30a4\u30f3\u30b0 \u30b4\u30eb\u30d5", "keywords": ["Chat", "ONLINE", "SPORTS", "MR", "SHOT"], "long_description": "\u9577\u304d\u306b\u308f\u305f\u308a\u30b4\u30eb\u3
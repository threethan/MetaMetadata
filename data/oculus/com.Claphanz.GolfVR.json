atl3-3.oculuscdn.com/v/t64.5771-25/39035401_1124599565346963_4804926702366139894_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvKTru1dXDAQ7kNvwF8PhmF&_nc_oc=AdlJ59JyIVIaJ_YsM8YfJ6aeiI-WOLQSyUk7RC39F1HHyH5UsOw1eAsmMg976_q7bRk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftikTavvBdXGaczyq94iYct8NaV3ofh-iXgVo_D9E_D9Q&oe=69A57A1F"}, {"file_name": "\u3010\u30a2\u30d0\u30bf\u30fc\u3011\u4e0b\u534a\u8eab\u8868\u793a2K.png", "id": "1591040491515800", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974771_1591040494849133_2136140886031552571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VBqfojh75oQ7kNvwHkUnn-&_nc_oc=AdleQeeieaOs2-fzPytw-iGsu0p27iLeFTf7xY3T_QcH9BZ9kP5PUNSFhKtHnJf-584&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsRcA9gkqyYiuXuihXPPz2X1Sobs53cfH2JekR23gR42Q&oe=69A58143"}, {"file_name": "\u30b9\u30af\u30b7\u30e702.png", "id": "1203234357544530", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570294_1203234360877863_9145783152507878137_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlSryjsJvw0Q7kNvwFKBRbK&_nc_oc=AdnwtkDJt5knXg708RcfE4dLHrVQIkR-A8VLmzqFwVxOJSjsmQ370XfcAFJm2vyyPvE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvXx7MVS-epS2FTRCsIQ65tzIXJSveq_HCgI9c19KyLJA&oe=69A57377"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560-1440.png", "id": "981137503977837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392123_981137507311170_7676455766277365046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFPUqeLCSkEQ7kNvwHUyOqa&_nc_oc=AdkPPVFJ440BzVNevSfC6SNFEYFCDl44RxwenPoJjEsCtsGbzuCoWaJCOspRVF0tV90&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftZ2TJVHMAAKH5M0Z_00-DpqzOCjKValEoD_U0hlO6Otw&oe=69A57608"}, "display_name": "ULTIMATE SWING GOLF by Clap Hanz", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "\u26f3\ufe0fNever played golf before? Don\u2019t know the rules? No problem!\nYou can still have a blast with \"ULTIMATE SWING GOLF by Clap Hanz!\"\n\nDeveloped by Clap Hanz, the world\u2019s longest-running pro golf game studio, this title brings the fun of golf to everyone\u2014no experience required.\n\nJust grab your controller, swing away, and enjoy ultra-realistic golf in stunning VR!\n\nWhether you\u2019re a total beginner or a seasoned pro, there\u2019s something here for you.\n\nWorried that golf takes too long?\nNot with this game!\nLearn the basics step by step by answering simple questions\u2014then level up your skills in no time.\nSoon, you\u2019ll be swinging with confidence!\n\nAnd here\u2019s the best part:\n\"ULTIMATE SWING GOLF by Clap Hanz\" is now available at a drastically reduced price!\n\nThere\u2019s never been a better time to start your golf journey.\nWhy not tee off today?\ud83c\udfcc\ufe0f\u200d\u2640\ufe0f", "short_description": "Your very own golf course\u2014just a headset away.\nJump into the ultimate VR golf game anytime, with anyone!\n\nBrought to you by Clap Hanz\u2014the team behind hit golf games for over 25 years\u2014this is their latest and most immersive VR experience yet.\n\nJust pop on your headset and you're instantly transported to a stunning course that feels like it's right there with you.\n\nWhether you're brand new to golf or a longtime fan, Ultimate Swing Golf by Clap Hanz is packed with fun for everyone!"}, {"images": {"nodes": [{"file_name": "PORTRAIT_1008-1440.png", "id": "3552859728348491", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393846_3552859731681824_3714380810341091286_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJWKfoSPf48Q7kNvwEFGQ1v&_nc_oc=Adnhc-juL0UiQrUuWMcY8gn3kezbX0Ib2RDtvWBAUYckXwtZCqFYku6OI_fo5egjSrc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftX2GxdhLf9jAnnEcp3e_b03D9gcF6jN1QxFzp9d_HyLA&oe=69A58E67"}, {"file_name": "\u30a4\u30de\u30fc\u30b7\u30d6\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u5de6_400-700.png", "id": "1725309208224365", "image_ty
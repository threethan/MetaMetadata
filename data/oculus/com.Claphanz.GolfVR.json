sjc6-1.oculuscdn.com/v/t64.5771-25/39035401_1124599565346963_4804926702366139894_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkxSrBStagwQ7kNvwEw12Fw&_nc_oc=AdkdzH0V113Nw8US2TZvxICR5EpQ0Ts4Iun3uS9dgAYd173OmLGiaIZWxEJ1EMfHvXg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvNdOLqs6wi5NH6nidZ5-Fo3ZIoHO9_EU6GzyPBMSqCWg&oe=69984B1F"}, {"file_name": "\u3010\u30a2\u30d0\u30bf\u30fc\u3011\u4e0b\u534a\u8eab\u8868\u793a2K.png", "id": "1591040491515800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974771_1591040494849133_2136140886031552571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q--htR5lLFkQ7kNvwFgNoaU&_nc_oc=AdmI5Dzx61U3GZzzIX0lAhV7uQs49mr9tk5SSVUns0po4RmkVhppolFgD1qasTlXzrc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvvxfhpOrHz0efvsjgncQ1RieJqajaLjz_HpdnR2NMPPQ&oe=69985243"}, {"file_name": "\u30b9\u30af\u30b7\u30e702.png", "id": "1203234357544530", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570294_1203234360877863_9145783152507878137_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gc8CnmSziwUQ7kNvwGjOPPl&_nc_oc=AdnbUMlAGmLGdubnLen--tCJH3X5O_ijf3iIKYJkRmqt8ztOPvCXtReCmhcIC0IBdxw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuEn5FAANJTrGhv4Skw4E_D_NFbUsR4djyy2yyzG60kUg&oe=69984477"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560-1440.png", "id": "981137503977837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392123_981137507311170_7676455766277365046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iy1ZCLLK_eIQ7kNvwFHtMra&_nc_oc=Adl_suszFkMuyMppHTtH48RyzvfIHPZBcM7CijkmyFmO4YFz8wuRarxFRDTe_zwao7c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvKgZMDa05XSRA-MG3B9WCVU69kruIf4DjMCyGhmRpkuA&oe=69984708"}, "display_name": "ULTIMATE SWING GOLF by Clap Hanz", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "\u26f3\ufe0fNever played golf before? Don\u2019t know the rules? No problem!\nYou can still have a blast with \"ULTIMATE SWING GOLF by Clap Hanz!\"\n\nDeveloped by Clap Hanz, the world\u2019s longest-running pro golf game studio, this title brings the fun of golf to everyone\u2014no experience required.\n\nJust grab your controller, swing away, and enjoy ultra-realistic golf in stunning VR!\n\nWhether you\u2019re a total beginner or a seasoned pro, there\u2019s something here for you.\n\nWorried that golf takes too long?\nNot with this game!\nLearn the basics step by step by answering simple questions\u2014then level up your skills in no time.\nSoon, you\u2019ll be swinging with confidence!\n\nAnd here\u2019s the best part:\n\"ULTIMATE SWING GOLF by Clap Hanz\" is now available at a drastically reduced price!\n\nThere\u2019s never been a better time to start your golf journey.\nWhy not tee off today?\ud83c\udfcc\ufe0f\u200d\u2640\ufe0f", "short_description": "Your very own golf course\u2014just a headset away.\nJump into the ultimate VR golf game anytime, with anyone!\n\nBrought to you by Clap Hanz\u2014the team behind hit golf games for over 25 years\u2014this is their latest and most immersive VR experience yet.\n\nJust pop on your headset and you're instantly transported to a stunning course that feels like it's right there with you.\n\nWhether you're brand new to golf or a longtime fan, Ultimate Swing Golf by Clap Hanz is packed with fun for everyone!"}, {"images": {"nodes": [{"file_name": "PORTRAIT_1008-1440.png", "id": "3552859728348491", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393846_3552859731681824_3714380810341091286_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xM9NTqmclcQ7kNvwHbe2BE&_nc_oc=AdncbE7Y7XArs70YfGAtGmWtVifPhSryiNxTE-4sbxHAPgYAV1OzbJQFJMIPb6MNkAc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfviUzQsDcIjr6bge1wOmKDcc-pKaR060bg-3ac7RXEH6w&oe=69985F67"}, {"file_name": "\u30a4\u30de\u30fc\u30b7\u30d6\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u5de6_400-700.png", "id": "1725309208224365", "image_ty
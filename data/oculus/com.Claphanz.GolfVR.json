sid=6e7a0a&_nc_ohc=aB8xCL2gR34Q7kNvwECd2G_&_nc_oc=AdpNUo_oz8f7Tz7ShtyV8A-uCDQ2CaAmq0qoa205TWROFCBZv7dtw6YzGY2aNE2Z8Wk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzq1qllVCr9Hha2BXq60HncA3mwoJf6-4AsqqmRlmRLA&oe=6B01B7C9"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqKMGDc7avQQ7kNvwHeqllg&_nc_oc=AdrNJNP82kAEsi5mJ08ekm65PcEhbItFBO2em8AlhpFcD1ogm5EmFCkFMkxv2qrqijQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkWl9AkX-D57c_ITt5H1G7jU2tIkgID3xd88SG2S_YLg&oe=6B01D2BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ept1PEcHH8oQ7kNvwGS5mHI&_nc_oc=Adpw3Cpo6eEcVsBcRvikf4sM9lshYpHArYVqnN-Im8wDSYsHev-cC_uZc66xP_Hf8cY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrzpR6oAsj564J27-s7t_GDfay_SpVMyhyLd_8qyLKmw&oe=6B01E049"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S00_wR8iBlkQ7kNvwF-Gnjj&_nc_oc=Adpbl-34RV1_cDpZXmMYM7OuKhQhaUcxiNEU02iXA5IKNxqtYp8REKcqa4A4mL9uTUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJK7hRf04Cka_D0SHoXLb-eZoRwiSRZxdb4KrJBz7zbg&oe=6B01D4E1"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBnBPxtlX2cQ7kNvwEdz_Ji&_nc_oc=Adph1FOK9dPRRwLx3zNXaPxXzZJZH5g0AjZCMdPQfEAMvXKWrbpgBWNgg1iDQMs4kJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzHh0eWTf0K1uHGgs4HgR0Q6YWCcnr5VUtWghCscaT4g&oe=6B01E7DA"}, "display_name": "\u30a2\u30eb\u30c6\u30a3\u30e1\u30c3\u30c8 \u30b9\u30a4\u30f3\u30b0 \u30b4\u30eb\u30d5", "keywords": ["Chat", "ONLINE", "SPORTS", "MR", "SHOT"], "long
iad6-1.oculuscdn.com/v/t64.5771-25/39035401_1124599565346963_4804926702366139894_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ep3dM5tcf4UQ7kNvwFZudqp&_nc_oc=Adp1erdVOPvcsQdZzkAodnUkbc65djhJmYeJouyVVFBfyF6J6iWb8WjTKGjzhD6yX-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af27ice4_QA5YL79qXIfRJ2Nj3KnTSzaGZAQun34OgWKEg&oe=69F09F9F"}, {"file_name": "\u3010\u30a2\u30d0\u30bf\u30fc\u3011\u4e0b\u534a\u8eab\u8868\u793a2K.png", "id": "1591040491515800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974771_1591040494849133_2136140886031552571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8csJFGsP4wQ7kNvwFuoRx-&_nc_oc=AdqPwT1urocMFA1fkwpX9-5roANLH2jW5oDaGXsFPJE6WPvt-e3Ka63yYsty4gP0ouc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3W7Q2BmUAE26ZnYZ6BlTWR_tGDJSeGlxD9qD6efOuZYA&oe=69F0A6C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e702.png", "id": "1203234357544530", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570294_1203234360877863_9145783152507878137_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gsxn58ifnzkQ7kNvwHyhp9l&_nc_oc=AdoTED7iIrXiwubZPJCMjTGGWr65DH8sRWHBj4ih2dK8aq3ffDN8J6ZveGO4Hi_cBg0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2wCDoI1cEvNQqBn0cUoyo884I8MNnIhn8AeMP6MsbT_Q&oe=69F0D137"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560-1440.png", "id": "981137503977837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392123_981137507311170_7676455766277365046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TONoqKtrfMwQ7kNvwGlwU8F&_nc_oc=Adon5w5W1Tf_HmCdOGyuDIsXly5BTBytigGZydbHRKroDpHBLo8PZCpYpD73aTMFbAI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1KDRAW4FW1GSHPCpGuDH0Ary2waN7HwpZjhHIfxcbpuQ&oe=69F09B88"}, "display_name": "ULTIMATE SWING GOLF by Clap Hanz", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "\u26f3\ufe0fNever played golf before? Don\u2019t know the rules? No problem!\nYou can still have a blast with \"ULTIMATE SWING GOLF by Clap Hanz!\"\n\nDeveloped by Clap Hanz, the world\u2019s longest-running pro golf game studio, this title brings the fun of golf to everyone\u2014no experience required.\n\nJust grab your controller, swing away, and enjoy ultra-realistic golf in stunning VR!\n\nWhether you\u2019re a total beginner or a seasoned pro, there\u2019s something here for you.\n\nWorried that golf takes too long?\nNot with this game!\nLearn the basics step by step by answering simple questions\u2014then level up your skills in no time.\nSoon, you\u2019ll be swinging with confidence!\n\nAnd here\u2019s the best part:\n\"ULTIMATE SWING GOLF by Clap Hanz\" is now available at a drastically reduced price!\n\nThere\u2019s never been a better time to start your golf journey.\nWhy not tee off today?\ud83c\udfcc\ufe0f\u200d\u2640\ufe0f", "short_description": "Your very own golf course\u2014just a headset away.\nJump into the ultimate VR golf game anytime, with anyone!\n\nBrought to you by Clap Hanz\u2014the team behind hit golf games for over 25 years\u2014this is their latest and most immersive VR experience yet.\n\nJust pop on your headset and you're instantly transported to a stunning course that feels like it's right there with you.\n\nWhether you're brand new to golf or a longtime fan, Ultimate Swing Golf by Clap Hanz is packed with fun for everyone!"}, {"images": {"nodes": [{"file_name": "PORTRAIT_1008-1440.png", "id": "3552859728348491", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393846_3552859731681824_3714380810341091286_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2ovfRE1i5wQ7kNvwEPXNcr&_nc_oc=Adpkno4X09Q_6cGFwXoHiJ3tyMQM5_SZUG30eMlTxdrdEsVkknU6JXoQ3B1on1S1BxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1cGa07iIYAbVFXsYO_9Zrbo9vS1im87UAf0i-tPE4H9A&oe=69F0B3E7"}, {"file_name": "\u30a4\u30de\u30fc\u30b7\u30d6\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u5de6_400-700.png", "id": "1725309208224365", "image_ty
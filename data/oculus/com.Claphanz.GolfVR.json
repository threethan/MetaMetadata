culuscdn.com/v/t64.5771-25/39003266_730391662208456_8955265094551262484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MGgBNYPoSYQ7kNvwGESUm8&_nc_oc=AdnvlYAVLXlYWaYzfrggXIeqm2gSlhwMzozuRXIi1d4wSPALiZTpRB_deO-MvFhO29w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs8gHpuxlEcI34NlnpGxpvnbciKSda1K6FwxZK1XViBaQ&oe=69A6C509"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cx2duE4_YUQ7kNvwFxD21D&_nc_oc=AdkHV53MoVA6EhG5u6qH8xlUdVIJrT3xJ-iDTpHWroCf2YdUZVHSLj8Q9jSsexyWkr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfstLmEF7pD52yglJMXJdBhMg2vyVkRcmGsHQN8IdNV0_A&oe=69A6DFFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bvQi0Z42FQQ7kNvwEGXg2c&_nc_oc=AdkKB0GdxGlAnxExbQXDoA1Cp1uaZQALUXalrnscLesLbCcESreix20iEnvPIV91WGs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuycTJql7y6catADcwmCBarsG20o-Wo39Jeoshe6YwRaQ&oe=69A6ED89"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Up7AG4Tg9cQ7kNvwEwkCBm&_nc_oc=Adn2S4b94Up2BZDtzvnNvj8h5KPNQhNvYZy6jb-exYhAVc-u3aK7Licx3Jckx71Dz3M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvnAQbESiUwlqt2WSc4Knwagb-F2W6WSApegb50lqiaNw&oe=69A6E221"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slC53v8HP2IQ7kNvwGFdcX3&_nc_oc=AdlIg8kzRRPqOf7_knkTM3x2Yq2tDiiOFvTp7G99qXb8w6eqU35Wqae1dtbQB3ddAC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afttfpe1l6U1232Dw3O5pT21o--MFM0RK7TkCkumRPEvkg&oe=69A6F51A"}, "display_name": "\u30a2\u30eb\u30c6\u30a3\u30e1\u30c3\u30c8 \u30b9\u30a4\u30f3\u30b0 \u30b4\u30eb\u30d5", "keywords": ["Chat", "ONLINE", "SPORTS", "MR", "SHOT"], "long_description": "\u9577\u304d\u306b\u308f\u305f\u308a\u30b4\u30eb\u3
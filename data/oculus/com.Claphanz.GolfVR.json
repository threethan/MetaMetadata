f&oh=00_Af1cs7kZUk6cCQeC0CXVhzUYQaDUp4jBhVijgY8Dt8zlQA&oe=69EB80CA"}, {"file_name": "\u4e3b\u89b3\u8996\u70b900.png", "id": "1124599562013630", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035401_1124599565346963_4804926702366139894_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGpL9XRZWHUQ7kNvwFPEerB&_nc_oc=AdpRGErZ0FcOe9DiOX6-k0hqKXujbNlQnl8V4FwoWhTBniE6jpqMz9Dd126Lkplw2HM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36huOpGdPZCJ6lAYUNQ8gtaHLXifN1zBg_SEL1M1EmxA&oe=69EB599F"}, {"file_name": "\u3010\u30a2\u30d0\u30bf\u30fc\u3011\u4e0b\u534a\u8eab\u8868\u793a2K.png", "id": "1591040491515800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974771_1591040494849133_2136140886031552571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jI9B5pPcGcQ7kNvwH3d_gy&_nc_oc=AdqoQPD_9LG9BJrPobWa7jfgcEVl1pQgqaw_Vb7ubtxP2e5Lfss7SXzYHN8uLf1CXrg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GjE8GCGN8jZ37LkxOzbZbZKIeYzZxbgSy9AGIoDD-Fg&oe=69EB60C3"}, {"file_name": "\u30b9\u30af\u30b7\u30e702.png", "id": "1203234357544530", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570294_1203234360877863_9145783152507878137_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtvakFnTDKEQ7kNvwFZgqH6&_nc_oc=Adq9EKhe5bdSgD9R1_9qIypKFqCsL6R5XNHB4URU4VBZfY0uhMOl9rheIW_6MxwbNVY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aB2EqeCTuv0tKwqMh2tKOSxNHhAyfaP9umNu1NlBnVA&oe=69EB8B37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560-1440.png", "id": "981137503977837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392123_981137507311170_7676455766277365046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYa0GOCNbbcQ7kNvwEpi1ng&_nc_oc=Ado-BZj4nGC1CNJZpaY_WpYgfEYNOEQHoCmTgTkyEkAKZvXwXJEM9hA893dmgZBNIUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iDf40UquG4Y4Loy3lRSUYKtAJKa1SFckURcDV9EY2dw&oe=69EB8DC8"}, "display_name": "ULTIMATE SWING GOLF by Clap Hanz", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "\u26f3\ufe0fNever played golf before? Don\u2019t know the rules? No problem!\nYou can still have a blast with \"ULTIMATE SWING GOLF by Clap Hanz!\"\n\nDeveloped by Clap Hanz, the world\u2019s longest-running pro golf game studio, this title brings the fun of golf to everyone\u2014no experience required.\n\nJust grab your controller, swing away, and enjoy ultra-realistic golf in stunning VR!\n\nWhether you\u2019re a total beginner or a seasoned pro, there\u2019s something here for you.\n\nWorried that golf takes too long?\nNot with this game!\nLearn the basics step by step by answering simple questions\u2014then level up your skills in no time.\nSoon, you\u2019ll be swinging with confidence!\n\nAnd here\u2019s the best part:\n\"ULTIMATE SWING GOLF by Clap Hanz\" is now available at a drastically reduced price!\n\nThere\u2019s never been a better time to start your golf journey.\nWhy not tee off today?\ud83c\udfcc\ufe0f\u200d\u2640\ufe0f", "short_description": "Your very own golf course\u2014just a headset away.\nJump into the ultimate VR golf game anytime, with anyone!\n\nBrought to you by Clap Hanz\u2014the team behind hit golf games for over 25 years\u2014this is their latest and most immersive VR experience yet.\n\nJust pop on your headset and you're instantly transported to a stunning course that feels like it's right there with you.\n\nWhether you're brand new to golf or a longtime fan, Ultimate Swing Golf by Clap Hanz is packed with fun for everyone!"}, {"images": {"nodes": [{"file_name": "PORTRAIT_1008-1440.png", "id": "3552859728348491", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393846_3552859731681824_3714380810341091286_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9zfGn5CJ-EQ7kNvwEG-s-4&_nc_oc=AdoY_RMdlOaZ9IAzVTJfVjz964R1FsytNlIwzWCmNS3v_K8pBsywOfD5ZhmDy2uar5A&_nc_zt=3&_nc_ht=scontent-ord5-
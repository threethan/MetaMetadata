25/39003277_1594968264641130_4705740987765687396_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQUYZoaDo_wQ7kNvwHPYVzz&_nc_oc=AdlZ05oLwHWdfy3ARMIExOIeoazbWDRTd0dMsvrWMucpz9HKN5qGdSvy8MZ4Qac2-Pc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyCaFt4cWYKH90mSWFpMzMbeSm84UUNahiJTrmBDhHJlg&oe=69BA9CDC"}, {"file_name": "\u30aa\u30f3\u30e9\u30a4\u30f301.png", "id": "730391658875123", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003266_730391662208456_8955265094551262484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PLF1Fe-0HEQ7kNvwHYAPlp&_nc_oc=AdmJyZH9g9MqJk-kiQTdPhIbDw5n_5pop-4vaPVA49qkQSB85lJb0pAZWvkQUqkbD8s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLS2Y6WCZBYpE0qq9-DGIj8JvA_gWAbzP278aNQj2Xbw&oe=69BA8B89"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aexHp-UGsRwQ7kNvwEOjOva&_nc_oc=AdlPl2W0OAPSepFoP0n0LPRf5lhTyDl_80qNKo4qs0klUSb9IISrSiyGgRO8oEZFnOs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzkYIreSdk32TSdrMELHYx9LLEf-_0bsfklgYWsz9oXxg&oe=69BAA67F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7XWH001VRUQ7kNvwGSyVK3&_nc_oc=AdlM0d3MMDvmLgv9MKJ4ed90aaA9ITE-_HPiR-UX-BGp0k0ZXWd8C-Zqa_jSwebIHQQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzx3-lAaVVmA3f5oJt8zPlVCpH296rgZ4Wq3sNnuKZAsQ&oe=69BAB409"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHpn7Pcp4KQQ7kNvwGmyL2S&_nc_oc=AdmjlA0Sogf-LfhkjftZQZ77biMQpeHH3-HiguX8FeLmnYesU0f18wSd_MS_XQAxJ54&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfygVgR6Y0fvKn4hb04DRm0QaxS1PbVOi6LeBnwDjvHJdw&oe=69BAA8A1"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&ccb=1-7&_n
culuscdn.com/v/t64.5771-25/39003266_730391662208456_8955265094551262484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCY-9SNi3X0Q7kNvwEoRGqo&_nc_oc=Adl4yg_rc7b-W41S3DsjNrXlV9mvkWg6T6Zf69ZhVIcKcWNIW0F7vTaAxEUlhpSIBa8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuS6Dw8HuZtxHraIwJX1Ty9MmHsKSXKSwDkAYFq-tbd6Q&oe=69999609"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Q75jUHv3scQ7kNvwFW2bUg&_nc_oc=AdlisUkoW_yXF-To7nnKcDpN-mnw2d2NgepAbOUBrwjSzI8E9d6tnk_suTsrXTmumRQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu34sLDcJTz21FRNBDt1933mhQyD7NlUgGE1vo-4SpR9w&oe=6999B0FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqTM9wmXTPAQ7kNvwHuv_cw&_nc_oc=AdnBhj7bEkY9PBURzHuP5rO5ld5q-BJI6hVPm6fqGxcv74qOlVpsBqb0-RtKB3Wim18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsgvg6oPn6fiaszFFwc1anS9oaO10RIe7Q3ckpaABPtsA&oe=6999BE89"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTdVrFRp8rsQ7kNvwH1F1RY&_nc_oc=Adky48szz0LKRQmWSyI4n0EG7-Eix1xnlHyoHRJC3S3PONvTRy3fz_E0G5r7RZf9bPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsQx3oQlhdCe9sM5ofZB1zydcJIEvEuBxI8WhfkgBsWbw&oe=6999B321"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bj_C_8VaZHcQ7kNvwHZYQ3m&_nc_oc=AdkQT_gDMHWOa6QoR6xiCMOsvbwXa3OBT6CbiAK6hmxtbP67rHMeSy-a1iTO4kLNZgo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvMmIL_1dwFPLTn1NIxAkxIr4-5ROxg4hM-w6tOzeEdsQ&oe=69998DDA"}, "display_name": "\u30a2\u30eb\u30c6\u30a3\u30e1\u30c3\u30c8 \u30b9\u30a4\u30f3\u30b0 \u30b4\u30eb\u30d5", "keywords": ["Chat", "ONLINE", "SPORTS", "MR", "SHOT"], "long_description": "\u9577\u304d\u306b\u308f\u305f\u308a\u30b4\u30eb\u3
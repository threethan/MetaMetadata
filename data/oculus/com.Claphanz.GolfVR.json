25/39003277_1594968264641130_4705740987765687396_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-2jEUiFEPUQ7kNvwH2IpmB&_nc_oc=AdnJ6RrHTF9RYfovtfraacF207aD_S8uRmjjiH6eosqpzN_MGlUJyIJVhSYkVVtSVZo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfulSv5mQE8Gi5hCL2w-GqANyRJKNBtehXYebN0N1v7v8g&oe=69A827DC"}, {"file_name": "\u30aa\u30f3\u30e9\u30a4\u30f301.png", "id": "730391658875123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003266_730391662208456_8955265094551262484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MGgBNYPoSYQ7kNvwHSY9x6&_nc_oc=AdkFSMjE9FnVRCtQfF_bN5D-VyE3hyTZwse4AkxTE1TX1rZAKD08tU2C5bwo1iuDqi4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft_SCxAQMYTp84BMJ7wdT_de6KkN_eS2V6EtHprwawvKg&oe=69A81689"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cx2duE4_YUQ7kNvwEhI4WM&_nc_oc=AdlQeX-EP-bmtgQA1k245BOn6JjfeuVw2L2ACd4jCHZ8Zvj23XgRDIFJtGy6Udj9wtw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv7wYIhjvQKkrbf76R5h8BwkS0npxWeeDrUdWXBhWtAkw&oe=69A8317F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bvQi0Z42FQQ7kNvwFV09oW&_nc_oc=Adn8PPpCy2FcG8o9xwaYpBrKBUHsYZsbWpL6QxsqWB-7eFJ_i0L__jlUAb2EdTmMeCw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftM7sQetdFNzOox3V811fTt-xiK8hcwLcYZxjvT-xZdlQ&oe=69A83F09"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NweXLuJ26wcQ7kNvwGJbV9Z&_nc_oc=Adn9T0izZ9NxuDF0JU4J-YO2CMuzjtsZwco4Fgi5y4uRSJDCRdWARxiK8VuL3fKwWIU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfujYZl8XRO5H2HgPE-aW_q55Cgyj5z1W4BHNOT1p0sn2w&oe=69A833A1"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&ccb=1-7&_n
culuscdn.com/v/t64.5771-25/39003266_730391662208456_8955265094551262484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaBuH56YigkQ7kNvwHjrPwe&_nc_oc=AdoUBZlbM7huvCVNEo1y0QCOKF4IgNUcfdjvMKR1sOZdIiejhtJajoPMmdOmiPxTXKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1Hv0U0cWbZZC9En14K4i-OqrYIS8PRXhw0sSQDU96APA&oe=69F0D149"}, {"file_name": "\u30ed\u30d3\u30fc00.png", "id": "929376048584916", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_929376051918249_8542661393386288777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MDMQUn3j4gQ7kNvwEfE0N2&_nc_oc=AdqDkK8wPO67YcI-Ap_mc97yqZxd96fhGKfqUgwkuaBYf8aBDdfxs9RQ-Q2UjAvNTck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2qiaDl7pNmIs2KGfHg3DwJC2Z8YGDJG7MR4DdnE2t6MQ&oe=69F0B3FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440.png", "id": "1349991142355797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371504_1349991145689130_5675624595774220636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hkd0ij0FQwQ7kNvwHIHY1c&_nc_oc=Adri8SJDC2aGaBUbUIBXIVo0npnJa6L82rppzS2CUoqgIOWjs0Pmxic67hGAkYuMp60&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2WBhn02I-mjV-uiAn0cNBfesA3QpCvx0ujlnL4Jgx5lw&oe=69F0C189"}, "display_name": "ULTIMATE SWING GOLF", "keywords": ["Chat", "ONLINE", "MR", "SPORTS", "SHOT"], "long_description": "Clap Hanz, the beloved golf game developer, presents the definitive golf experience in Ultimate Swing Golf!\n\nThe intuitive shot system recreates the feel and exhilaration of golf in a VR world. Simply swing your controller to adjust your power and the direction of the ball!\n\nNo matter your golfing preference, there's a mode for you. Hit the links in the Free Play and Training modes, clear missions and hone your skills in Challenge mode, or turn your room into a proper golf venue with MR Play mode!\n\nHit a bucket of balls and shoot the breeze with friends from around the world in Online Match mode, where a maximum of 4 players can enjoy a game of golf together, complete with voice chat, quick messages, and emotes!\n", "short_description": "It's like having your very own golf course.\nPlay a round of VR golf anywhere, anytime, and with anybody!\n\nEnjoy the latest VR golf game from Clap Hanz, a beloved golf game developer for the past 25 years!\nPut on your headset to be instantly surrounded by the lush greens and rolling slopes of expansive golf courses\u2014no travel, reservations, or club memberships required.\nWhether you're a beginner or a seasoned golf pro, Ultimate Swing Golf offers an immersive world of golf that everyone can enjoy!"}, {"images": {"nodes": [{"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440jp\u534a\u89d2.png", "id": "339646909090947", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031428_339646912424280_2312519129757564492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKq0FLrIYwgQ7kNvwFcq7eE&_nc_oc=AdpccYZBEZUdFI4xnYABf8yXh0xOiiZnDG27oiqXtuOqHvpgd31LK0aAqggAE-CHelI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af12oC-vtmkBs5JK4XWYT9ZaXxEpmEYfLs7dUkEyWCoVtQ&oe=69F0B621"}]}, "id": "201306306175709", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_UltimateSwingGolf_Landscape_2560x1440_jp.png", "id": "1099469434669935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75282162_1099469438003268_8173936974024535901_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbxzqj56zZoQ7kNvwGtNZTx&_nc_oc=Ado9n3FpUDkLeq-YTqzgFzUdeu90zQ-U2x5CHT6JZlZcyQ759y116sMC40R_w_qMKRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af11Nwfye8oNfHoY_nGdxVW1_lfxN57g8CURa3KpehtmDA&oe=69F0C91A"}, "display_name": "\u30a2\u30eb\u30c6\u30a3\u30e1\u30c3\u30c8 \u30b9\u30a4\u30f3\u30b0 \u30b4\u30eb\u30d5", "keywords": ["Chat", "ONLINE", "SPORTS", "MR", "SHOT"], "long_description": "\u9577\u304d\u306b\u308f\u305f\u308a\u30b4\u30eb\u3
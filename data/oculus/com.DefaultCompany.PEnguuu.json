ohc=yzAY5yLhGcMQ7kNvwGRM953&_nc_oc=Ado2NkYNgaEjqu-dsf0fO3tmwpupUVY--RPQuw9jFaAtF32E5KdCXQt-HaqPzO4aUOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSToZma9QxVGu420wUEJeHeyH7tHKXnwKn0-sChFlitpQ&oe=6B072395"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (16).png", "id": "1371560167540199", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394258_1371560170873532_4096155768136498153_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHhhnHUltocQ7kNvwH7bUfi&_nc_oc=AdqnvCGjLOwCiOTzEAW93lARhxS75TIr0v0sS7HILPymsIKmu0UQSjsUiz4lurehha8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEAUjS4CwjC1qSNTh0Ry7I5YWK6J7gfURFqSs2Avk0uw&oe=6B070999"}, "display_name": "Pengu", "keywords": [], "long_description": "Pengu is an adventure-horror game that will keep you on the edge of your seat as you explore eerie, frozen landscapes filled with mystery and danger.\n\nVenture through various chilling maps, each with unique objectives and puzzles that must be completed in order to progress to the next level. But be warned\u2014you\u2019re not alone in these icy caves. Sinister monsters lurk in the shadows, watching your every move, waiting for the perfect moment to strike. They don\u2019t want you to escape, and they\u2019ll do whatever it takes to keep you trapped forever!\n\nDo you have what it takes to outsmart the creatures, complete your objectives, and make it out alive? Team up with your friends, strategize, and brace yourself for a heart-pounding adventure like no other.\n\nDownload Pengu today and experience the ultimate multiplayer horror challenge!", "short_description": "Looking for a fun game to play with your friends? Well you have came to the right place! Pengu is a Adventure, Horror Game where you explore different maps and have objectives to continue to the next levels. But your not alone as there are scary monsters that don't want you to leave! so download and have fun!"}]}, "developer_name": "Torquoise :) ", "developer_privacy_policy_url": "https://sites.google.com/view/catmayhem?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Torquoise :)", "support_website_url": null, "website_url": "https://sites.google.com/view/penguvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9543590665685474"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9632421836802356", "version": "29"}, "id": "1145535403908374", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9514731358571405", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9632421836802356"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1145535403908374"}]}, "change_log": null, "created_date": 1740452143, "id": "9632421836802356", "version": "29", "version_code": 29, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes
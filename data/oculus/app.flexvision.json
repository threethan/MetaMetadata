771246_1115032154484618_3138219255107159121_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMd7OCrZetoQ7kNvwFTkPRR&_nc_oc=Adqf6768cLGIq_DldCl1WKUHm21kiUP3KKWUfGjZHb59kXyicT1v7xAJnNUhX2l-q7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXvpPG70q3QQKWGmBSt5MyTKWFP98ex-5iHgvV8MObvBA&oe=6B0EF959"}, {"file_name": "02-celebration.png", "id": "1664265188472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771278_1664265191806265_7893628654020093438_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ss9_l0pSa8Q7kNvwEjzFEe&_nc_oc=AdoOnYT74ANsTK-LulbChFuyyQDGpAYmb8lq6WuE5g3H4wTyVOvBDZVFGBBiZIBw4T4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVyvD4xXCS68xPelgdyEFxfF_Lvm6V_e9gdPe3KIdEpVg&oe=6B0EEF58"}, {"file_name": "03-crown.png", "id": "1699786798426405", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771237_1699786801759738_5052469021416916771_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skkRUS6B3vIQ7kNvwHaGbXr&_nc_oc=AdqDHphqNGoW9djQ0TihgxwW1uJM29LMbJB1sZeqAodAiv-IVL__qOUwN0qlZd723z4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX1o7_rCJJWegWBldnBUznwa6ZohHpVvZpdo66uE_dB8A&oe=6B0F0084"}, {"file_name": "04-solution.png", "id": "1869690270831589", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771281_1869690274164922_6054954049639769795_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zyKJQS0nWYQ7kNvwGXiWHT&_nc_oc=AdoUR_GDw_-FAIrO2rio28kSjxgBmFGjEN0xx4p2JL58JJ0hsXNlLFX1VsfCej8RIVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVHSqpGjMzAuH2jXk5Q7EMX2vreQaKs3UCOXbeZk94ciQ&oe=6B0F0536"}, {"file_name": "05-heart.png", "id": "1071166455943385", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771267_1071166459276718_3634540530971259370_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXljzuXZnL4Q7kNvwEag2dq&_nc_oc=Ado4C4wEMl4l-TN_z5APM0f1N47dQd6RE547k3U2XDI1LBHMJquHmsWI25a8MZNPTTI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUrpBDI8Qmslv_4mnI7R5sKqO0f_KpZq-fbwsCUsiVlGA&oe=6B0EF232"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FlexVision", "keywords": ["puzzle", "logic", "shapes", "lines", "brain"], "long_description": "One thousand shapes, each hiding inside a tangle of lines. Can you straighten it out?\n\nFlexVision gives you a target figure and a cord that almost makes it. Pull the middle of a line onto a dot and it bends into a new corner. Pull another and the picture snaps into place. Every level looks wrong for about ten seconds, and then it doesn't.\n\nWHAT YOU'LL DRAW\n\u2022 1,000 levels drawn from dozens of hand-built figures: hearts, houses, crowns, stars, arrows, letters\n\u2022 Every figure rotated and mirrored into drawings you haven't seen before\n\u2022 5\u00d75 and 7\u00d77 boards, from a couple of quiet moves to real multi-step reasoning\n\nTEN WORLDS\nIron, Bronze, Silver, Gold, Platinum, Emerald, Diamond, Master, Grandmaster and Legend, one hundred levels each. The first 10 Iron levels and level 1 of every other world are free. Unlock a world with a one-time purchase, or every world at once with the All Worlds Bundle. No subscriptions.\n\nBUILT FOR THINKERS\n\u2022 No countdown, no lives, no energy meter\n\u2022 Three stars for solving in the fewest moves\n\u2022 Undo and restart whenever you like\n\u2022 Truly stuck? Solution credits let you watch the solution draw itself, corner by corner. Your first one is free.\n\nQUIETLY RESPECTFUL\n\u2022 No ads, no account, no tracking\n\u2022 Plays offline\n\nPoint and pull with your controllers or your hands.", "short_description": "One thousand shapes, each hiding inside a tangle of lines. Pull the middle of a line onto a dot and it bends into a new corner; pull another and the picture snaps into place. Ten worlds from Iron to Legend, no timers, no lives, no ads \u2014 just you, a pegboard, and the one move that makes the shape appear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Meshy-SC/FlexVision/blob/main/PRIVACY_POLICY_MH.md", "developer_terms_of_service_url": null, "publisher_name": "Meshy", "support_website_url": "https://github.com/Meshy-SC/FlexVision/blob/main/SUPPORT_MH.md", "website_url": "https://github.com/Meshy-SC/FlexVision", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2063296427715592"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771241_4735435063351971_6343692141142120833_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIkfa15bwY0Q7kNvwEoNcIv&_nc_oc=Ado9acsaXyFgvtSeg543aOuJAn-Hxf0d-OxE8FKrbcuofuSkbfqAlJpxmXt3zM9ciIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXZfXaZqnKkofJ4ax9pl15fmT95Qo5O0cuiNDZgaT5DtQ&oe=6B0F2201"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "FlexVision", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1795198320, "lastRevision": {"nodes": [{"id": "2063296437715591", "release_type": "SCHEDULED
: [{"file_name": "01-gameplay.png", "id": "1115032147817952", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771246_1115032154484618_3138219255107159121_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMd7OCrZetoQ7kNvwHgRvTF&_nc_oc=AdrlnE1Urgf8Lq6DQiaYTSBMd9tcu7B7k21ftX3xvjUC4u018zoM-P8rBSV4k_2p2-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVXOlQOJ3nyIg7RRUi1SPX6gm9DTkrStYrj3G001j49fw&oe=6B104AD9"}, {"file_name": "02-celebration.png", "id": "1664265188472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771278_1664265191806265_7893628654020093438_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18in3qC--rIQ7kNvwE3qYl6&_nc_oc=AdrAVlJELhZk-DEpnY6SgxBsVCjNCOTcgWYow7Uju3xFGdyqy8yWw9hLJK8aFF2fDi0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVxdqMoZWCFKcXYjST0mLwo-g5GmIMP29dva5XU6tf-iA&oe=6B1040D8"}, {"file_name": "03-crown.png", "id": "1699786798426405", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771237_1699786801759738_5052469021416916771_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1WMkFSxYd0Q7kNvwELxjKD&_nc_oc=Adqj5bP7868FCg0isggYH-1tbaq8yKoTCwkIcy4GfDfyOVk8Yo7IS0aFZoIHoP7tlQI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWOOjkNY2yuJBf2VlqgWblifiMdq9MckUuacWjcYB34cQ&oe=6B105204"}, {"file_name": "04-solution.png", "id": "1869690270831589", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771281_1869690274164922_6054954049639769795_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXr2LjIONpAQ7kNvwH0wJhQ&_nc_oc=Adps8utsdizfU95AhiQ6jPIaJkaiO4e6vMXN0ZRx1Ruvw83XSGbWO50SidKTUXK5iME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWUx7QT9C5fm4nAaZmMgiRpxTsF1Xk8a8kh8OzbzG59MA&oe=6B1056B6"}, {"file_name": "05-heart.png", "id": "1071166455943385", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771267_1071166459276718_3634540530971259370_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXljzuXZnL4Q7kNvwF-0Z4m&_nc_oc=AdrIeEm8tKAK-Vh6BwealDZIvzmRtRRIT-P9TkOj-7WG8fRwBx1UPxrPD3UbMK_MaAU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW1ILdeFJadOrLJmEAiikFCAFQAbdYTTWxLou-xLptWHw&oe=6B1043B2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FlexVision", "keywords": ["puzzle", "logic", "shapes", "lines", "brain"], "long_description": "One thousand shapes, each hiding inside a tangle of lines. Can you straighten it out?\n\nFlexVision gives you a target figure and a cord that almost makes it. Pull the middle of a line onto a dot and it bends into a new corner. Pull another and the picture snaps into place. Every level looks wrong for about ten seconds, and then it doesn't.\n\nWHAT YOU'LL DRAW\n\u2022 1,000 levels drawn from dozens of hand-built figures: hearts, houses, crowns, stars, arrows, letters\n\u2022 Every figure rotated and mirrored into drawings you haven't seen before\n\u2022 5\u00d75 and 7\u00d77 boards, from a couple of quiet moves to real multi-step reasoning\n\nTEN WORLDS\nIron, Bronze, Silver, Gold, Platinum, Emerald, Diamond, Master, Grandmaster and Legend, one hundred levels each. The first 10 Iron levels and level 1 of every other world are free. Unlock a world with a one-time purchase, or every world at once with the All Worlds Bundle. No subscriptions.\n\nBUILT FOR THINKERS\n\u2022 No countdown, no lives, no energy meter\n\u2022 Three stars for solving in the fewest moves\n\u2022 Undo and restart whenever you like\n\u2022 Truly stuck? Solution credits let you watch the solution draw itself, corner by corner. Your first one is free.\n\nQUIETLY RESPECTFUL\n\u2022 No ads, no account, no tracking\n\u2022 Plays offline\n\nPoint and pull with your controllers or your hands.", "short_description": "One thousand shapes, each hiding inside a tangle of lines. Pull the middle of a line onto a dot and it bends into a new corner; pull another and the picture snaps into place. Ten worlds from Iron to Legend, no timers, no lives, no ads \u2014 just you, a pegboard, and the one move that makes the shape appear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Meshy-SC/FlexVision/blob/main/PRIVACY_POLICY_MH.md", "developer_terms_of_service_url": null, "publisher_name": "Meshy", "support_website_url": "https://github.com/Meshy-SC/FlexVision/blob/main/SUPPORT_MH.md", "website_url": "https://github.com/Meshy-SC/FlexVision", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2063296427715592"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771241_4735435063351971_6343692141142120833_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIkfa15bwY0Q7kNvwEDxhqR&_nc_oc=Adpel8ELd0kExy6nnf8DR6fKADlY2OiM48p1xzy1aAEa68QZzi3ldHiPPXSo_e-Zrnk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXR69N2iJrWQDObxfQkCUmeCkCf9rrsaYYbWO8iWO444A&oe=6B103B41"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "FlexVision", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377
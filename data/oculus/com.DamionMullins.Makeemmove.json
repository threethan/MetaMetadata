g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUvkInfhDQvw1BhicOrJF2G7WQAAcm5kWStCFbpCBV5g&oe=6AECB381"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "3734532373428372", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75223476_3734532376761705_8293038932070830669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6x1iGwwexUQ7kNvwH7jOU_&_nc_oc=AdrjgTkPSDTStuaCJQ-TZFfQJk4NMpZsCGxTpCYZ6IfvjVnMfVNWbGobD_M3sxPapLM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9GkgOUwj1pLSaAYETdH_IWPSCAtHIhUY9HN5KCiDcYw&oe=6AEC9825"}, "display_name": "Make'em Move", "keywords": [], "long_description": "Make'em Move is a unique Mixed Reality (MR) game that combines virtual shapes and objects with real-life. You can choose from a variety of virtual shapes and objects and make them move by placing them on paths that you draw with your hands.\n\nYou can choose shapes like spheres and cubes or objects like rain clouds or trucks. Many of the objects include sounds and fun graphics like exhaust smoke for vehicles and rain or snow for clouds. Additionally, you can merge shapes to form your own objects.\n\nYou can add roads or train tracks to your paths, as well as make your paths invisible so that your shapes and objects appear to move autonomously.\n\nFrom playing with virtual objects that can be animated, to creating complex scenes of animated objects and shapes, all in mixed reality, Make'em Move is perfect for anyone with any level of experience with VR.", "short_description": "Make all types of virtual shapes and objects move around in your own real-life environment using Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://damionmullins.com/makeemmove#privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Damion Mullins", "support_website_url": null, "website_url": "https://damionmullins.com/makeemmove", "category": null, "comfort_rating": "NOT_
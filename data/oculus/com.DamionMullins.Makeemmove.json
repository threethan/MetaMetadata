AFDC58E"}, {"file_name": "ss3.png", "id": "241691128958260", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75542956_241691135624926_1222689598582205690_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD2O7Kc6blcQ7kNvwGZOpza&_nc_oc=AdqlH4P-i-DaNJhESC128rAXLKDtpMiHXa16yIW5NRi0l7U16jHwXie8Ldtq-JVWBtw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn0L3O4x93gGLMwp35eG7UPDsMOIJaHSBJq_knUnWnGQ&oe=6AFDD701"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "3734532373428372", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223476_3734532376761705_8293038932070830669_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yVCSifKSYQQ7kNvwGW0q9T&_nc_oc=AdoKwnYmTR_IZoWEPcPV0st45ocwZIQ-skoloNNgRyAIQKHvh6vrESDxUCrp3QfwN3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9XPaHbUi7KR2ke6GgoQtK0Rv99d5WDuAKWjs6teksLw&oe=6AFDBBA5"}, "display_name": "Make'em Move", "keywords": [], "long_description": "Make'em Move is a unique Mixed Reality (MR) game that combines virtual shapes and objects with real-life. You can choose from a variety of virtual shapes and objects and make them move by placing them on paths that you draw with your hands.\n\nYou can choose shapes like spheres and cubes or objects like rain clouds or trucks. Many of the objects include sounds and fun graphics like exhaust smoke for vehicles and rain or snow for clouds. Additionally, you can merge shapes to form your own objects.\n\nYou can add roads or train tracks to your paths, as well as make your paths invisible so that your shapes and objects appear to move autonomously.\n\nFrom playing with virtual objects that can be animated, to creating complex scenes of animated objects and shapes, all in mixed reality, Make'em Move is perfect for anyone with any level of experience with VR.", "short_description": "Make all types of virtual shapes and objects move around in your own real-life environment using Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://damionmullins.com/makeemmove#privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Damion Mullins", "support_website_url": null, "website_url": "https://damionmullins.com/makeemmove", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24441716065476836"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1169315330860544"}, {"status": "PUBLISHED", "id": "258491310404947"}]}, "baseline_offer": {"id": "1169315330860544"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1721228832, "status": "PUBLISHED", "id": "1169315330860544"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25770136535968109", "version": "14"}, "id": "1545710022851403", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24423023930679383", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25770136535968109"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1545710022851403"}]}, "change_log": null, "created_date": 1719427902, "i
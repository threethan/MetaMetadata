png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8P6M9XwC17EQ7kNvwGhMG6R&_nc_oc=AdkqjQYoUsoMr_6MpHbbPrgsUWBIZQ4zNjKSn_qdVlHGd_Uh3zNNkl6E8H8iO80xb24&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyddMCXzN8ePF1kdAzttzMAY5cyusm_OK_6IltPcDl__A&oe=69AAD5FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connections", "keywords": [], "long_description": "Play Connections from New York Times Games. Group words that share a common thread. You can also track your stats and streaks. A new puzzle is released daily.\n\nHow to play\nFind groups of four items that share something in common. Each group is assigned a color, which will be revealed as you solve. You have four chances to find the correct groups. Watch out for words that seem to belong to multiple categories. Each puzzle has exactly one solution.   \n\nShare your results with friends on Quest, Instagram, Facebook and WhatsApp. Want to follow your progress? Track your stats and streaks.", "short_description": "Play Connections from New York Times Games. Group words that share a common thread. You can also track your stats and streaks. A new puzzle is released daily."}]}, "developer_name": null, "developer_privacy_policy_url": "https://help.nytimes.com/hc/en-us/articles/10940941449492-The-New-York-Times-Company-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "The New York Times Company", "support_website_url": null, "website_url": "https://www.nytimes.com/crosswords/apps", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
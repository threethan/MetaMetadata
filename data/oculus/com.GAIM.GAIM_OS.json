-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH_vXk4IFJkQ7kNvwHU9IG3&_nc_oc=Adq7886PMEn3n4-uj_LhjZRTBg2aqErS-1oQwg884zWbE1XGW3KR_euVFEO3xls5spM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9qqn8itxs9OdFLL5ZrVxyzTqe0rAWx9895-Vpj-hUoQ&oe=6AB7E172"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DX3SXuSidOEQ7kNvwHGW_nE&_nc_oc=AdoXg8Lv0hNdnOF5-Q148MHYsJ6PHr05UAkl5MxYcMrkootbpUrL7JAPTyrNkJEKhyM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoSaz88PH0XB8XjvTpKT9IQ-jmFHAfMY7FygjUTiBiOQ&oe=6AB7CED5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a53_Sa6FScYQ7kNvwE1Qjlg&_nc_oc=AdqwaPCwf918jte4N2lwf8E3Yf4Elm6Doz8fsR7Kap2irx4LupFyrpW6Gxt7GMX56qQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWQT8AheONZpQgo-aU0tNWSAuPuuHEYVRGVRjz_XuU1Q&oe=6AB7E539"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
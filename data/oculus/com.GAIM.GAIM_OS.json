-2.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ouYjX9ySyoQ7kNvwFFANbJ&_nc_oc=AdrGEKDHSG5ja3QuOpXZiYz7K9t9jlNLQMORvZq5ayxrYMkXGejc1d4EoMEEI6vs4UE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3mq8QIFnmayAD6VVkpgu7J5QYAze41KVumSWRyHYAJWg&oe=69EF7D72"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yrx7qDNJPHkQ7kNvwGGD2pm&_nc_oc=Ado1y3c_kKaQcBtC_2X0g0nRvvF0juioEFlhoPxrytcQRl7ren9CkCq4VetxauOCBQM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af23Wl8kxAZGUJSqmCwgiz9geyk2AKv4JKmM5jNwXOHpsQ&oe=69EF6AD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOVBJl42mpYQ7kNvwHR59AI&_nc_oc=AdqWmzb_HSfywd-eYCd6FR3qlbDYEOr74gIFJRSSyaJiKhPs3Qa526m-wWGwk9znv20&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0AH9iK9CxxncHQF3MzAVWNt_1y9IrWe0GbgaXBzuCvbQ&oe=69EF8139"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
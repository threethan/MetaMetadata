-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX-_S1i3LREQ7kNvwGGIsPI&_nc_oc=AdqPX2h4IGwU0m2HrIj_XcrjS2lOAWH8hCuvHNGbmLm9nbRRiZjE6zdZcdAG0vHvCvU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyEVhoU1hxu1zjx8p48SuXCcUzDIWXV3QlG-qOqCGfXw&oe=6A74A4F2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgtN7nyZG6oQ7kNvwEebNr9&_nc_oc=AdqJThAIO0YO5LdIIZvEE-DUsA_VepFFY-no_ryX4lQBXU8ooXbVCcJ5jIkk8e7hpTw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwn2h68NB0sBm59CuVSo2kC4NKUs1Uya2Z5VeH4SfTjw&oe=6A749255"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7Pe_F9qnv4Q7kNvwGtV-7_&_nc_oc=AdqODbMtiny_oXB9TcsoziwHqGeL81v5E8b4pl-tELR8jzZLl826RYTVl10hjKxeeQw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTZ4VZ58VOm8WDuTRiAijUoF6Pko5hrKiOvfiDNKhy0A&oe=6A74A8B9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
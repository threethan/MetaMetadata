-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK8nWQgWqbAQ7kNvwE_p_kc&_nc_oc=Ado6X1fvdsmyTuf8oy48xLLUCUUZd-3ocXhuLRJyOR_0m8Ywas9T9PygpNBIKeWkRw8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Z7rolo933zeMul7iG-vXSKMwxq_cFtvlFfm8gYyWqOA&oe=6A3AA2F2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUhHLhTo1VoQ7kNvwFlgKRM&_nc_oc=Adrc-ibH6U53mpuVgfohDDYdHYfGFBKKINzhTyISxysdDx2iDQE9PIOAnCWX9SEpefY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Xaltzx3-fnoG0am_TcNlP4tr6B-V9LwedsBgEQFBa4w&oe=6A3A9055"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4F0iMlkAMIQ7kNvwG22ogO&_nc_oc=AdrD-d48Qb-O-fUjvb-m8RjjrQDqZHZhImYL3DS_3GPMdDGSck_OVMJx6oBtWd90twc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WhfQxp0VxQWdcQhzk3QETCJ0cXHzMJ66ESrmhs3CHQQ&oe=6A3AA6B9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
-2.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rohAl9rOa0AQ7kNvwGISC0n&_nc_oc=AdpSkX9D76m2ESHd5I8_2qf09greGN_2x62e9JEVwLGNtj0IOEYiSplvSBATdqaGXvc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-qGMcyJJcJHgRRDpjogvKG501rqop5hXbTYcPrInQ3w&oe=69F4C372"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK8hMHEcQYEQ7kNvwGNrj-i&_nc_oc=AdohWZG4n9LFA8-tUgXC0ex0iHOd0u7o-L5XYofJPC00bybfHOQQE4uLy5wXx7yOjf4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36TYBHvX3NcWJLEar1EzgzYs8k2Kg_LkDoJZ5EEPtX1w&oe=69F4B0D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPUJBsNy70UQ7kNvwHgVpqT&_nc_oc=AdqNCsAwtZ_AwHSLyhBaggj5kKEOP2oaIP4kqzVesozsa5yX0OD3K4mbhBILmaG2VSg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3y3PYkrulydcmv7-LwCXNOHmrbMNuhLQWaNmX1GcbMrg&oe=69F4C739"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
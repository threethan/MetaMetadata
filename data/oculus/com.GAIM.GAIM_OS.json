-3.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWri4Cx4mbMQ7kNvwEfTLZR&_nc_oc=Adrg_2X03lAMOha6uvzNIjzxPrJDA0P4hphtfFI_4w5n5ocEHAkaSb3hvDf7IePdXH8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYQpD3cFCcsRvUCemml3DdO6VcHBR6j6r4YQu-q8vkFg&oe=6AE8A8F2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRt5inTL434Q7kNvwGh85VO&_nc_oc=Adpt5Sw-uDTy-VWejt0XxVV8r1TsgisemqRJPmxaoee8vTNkUY5Dww5yl71kHwpu8d4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxwok56cBxPAmLSG31KcQMxyKIl_rkAjgRrNgaQ4LuwA&oe=6AE89655"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ph3PslVfWN8Q7kNvwEGy3fA&_nc_oc=Adr7t5l8MjEv6tZ3FOZwFeAus2YjFOWYO745SOVKD5J-JNNU0dqc8M5DDYQvtGzie_Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2QhfksijJq4z1klWr3d-RRpgJnSdbDajfY19iUcMdkw&oe=6AE8ACB9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
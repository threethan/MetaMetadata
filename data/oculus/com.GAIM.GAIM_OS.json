-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTC7Z9XSpuoQ7kNvwGfDjtF&_nc_oc=Adr1bcA2qgGuq3fhpqK3iVAoNZBJ3sunj6unQJhXpJZrAdqHyFRbrDSIDeN9hsPfZnc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24LhMkuVggEqe2p9TGCVcBbywrb6dfAfyqQphZ8UQuUw&oe=69E4B932"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtyZnbf_-sMQ7kNvwGGLRbD&_nc_oc=Adq5_ObRpZw9BPj6UeKKnVpH3KKm_-odNRF2Fxu0qaZLcm3kNEXcYFvFmVyBNIAhfcU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ofb_VjQ89RsulbzwVhM3RimXe_RiLnbLK-hL_XHNHGA&oe=69E4DED5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apkkxhRPEkYQ7kNvwGE7FQW&_nc_oc=Adr9--tENb8rBwV3pOi7WyDh-w4hNsAieKC-fgZqni0kROqatVUSdpFJ0Ax8nFsPSLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04j8mrN9xKq-T9rd0LplPA-OvAXJkZZ4e-j610hCDfUQ&oe=69E4BCF9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWA3jd_uHLQQ7kNvwFWxXnt&_nc_oc=Adr3vchXf0VyF-83Wor6XJ5D5mRUZvQEDmF1x4q_eQ_WjpwMJr2QwxsVg3J0HrlMkfY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M27p8lBzvQiBlATqb0YcKEjuqSG2utzOp2_r7jb_7lA&oe=6A297F72"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTfXGV_Vk5UQ7kNvwF3Mh9q&_nc_oc=AdqVGRnFI0Wxzke0OqRk_SIkSXTtva69BroDJRqoKHxGoWteHaiOxwIMlwpEJqf-NuI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ND__qVHTOKmJ0VowEX1vpyTqNkpiQ0NYI3RVdTX5ceA&oe=6A296CD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7muVnpvDrIQ7kNvwEBMhra&_nc_oc=AdrLstSOSM7LU2ie1SHZEGBQNq-RkUA1PVUwAF6cnkL-kgEJS1az-J231fMtK6d6xro&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88bAttE25euXX-CxAfOUAf1WjxB9QiUmAWuh7ZVUj2mQ&oe=6A298339"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
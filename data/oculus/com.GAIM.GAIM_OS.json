b=1-7&_nc_sid=6e7a0a&_nc_ohc=VDcvQWGk4VAQ7kNvwFOfU0p&_nc_oc=AdnjlZvS0XDSGBbQmELNgv0HaYLxjS1mTqV_gXCkUrYb53hGhT0H2fzEwT3kehfy79k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJlg_t_fnXqMxRYkrCirXy7qYWfItsx2I9G8nUNYFwhA&oe=69B2A032"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMF3Hn-pBvYQ7kNvwFqrs7u&_nc_oc=AdlDr9kTGbutbrEJ76ZNA95O5bdCIcarHQTXwufwY8Vg7QBBKG7RLyANljzynt55zus&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZRzJ01_msac9l9BkLt4pIOU0duobv00CdlQnpRDaDpw&oe=69B2C5D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzfmS7482EEQ7kNvwGoO5MG&_nc_oc=AdkoE0IlbWyrepbAnVDirc3_eBn4731aeOvbSI6RKj22f6dCC6ygQtf-J-DqvdEKx3A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz481ladSQfR4jw3Udg409TVyt-PHxen03nHAMaLv6Nkg&oe=69B2A3F9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting and sport shooting skills to new levels with GAIM virtual training simulator. Practice your skills at home w
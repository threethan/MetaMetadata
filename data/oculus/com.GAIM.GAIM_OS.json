-2.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AH7xg1VrcBEQ7kNvwEb9GPi&_nc_oc=Ado64DBOOgZPW5lrXe3_qEsyxb-BClilT5A4VevC1rKl63DroiaHs_u38j6VQL7aups&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ewE59LvQP3EcZs2xMUyVnElLQXjSu6OuOWVjWOSZlLQ&oe=69FDFDF2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yvive1dpFoQ7kNvwGlzpsV&_nc_oc=Adri2-wUbFFmhZ9hd6ACivQyYmuIZYjre5yJXc40aeRtbKUHuBFv57PRwNqwa8Quuiw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DfY1hs2hf0MSdL8eEgR5wvbb7rSw2loklBPf6qfSbuQ&oe=69FDEB55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvwLcCUkTVMQ7kNvwFMLQbN&_nc_oc=AdoF4e1yU4A-95CJZbxKi6UP4oIT1lIvoCe2IjWWkcb0dYEpT1TcPzKCh32yCBCyDuI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FfUoh9hCHh3bOwkZ02SGyB8ZqS2fAT3pfxv8PY1RRJw&oe=69FE01B9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
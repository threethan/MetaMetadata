-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQKyJnxz5HcQ7kNvwHrhI9N&_nc_oc=Adqk1a70w1phPfjepxG1warEgbfLbYUeX3-xy5PrSOjNZgcmwRQPwSEds4fqEvTGHQU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6X3nUhfA58v5JtiYKg4gr8BuEi-RsHxfvYD-ZFCNaG3w&oe=6A00A0F2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yvive1dpFoQ7kNvwHlvW_l&_nc_oc=Ado-8gMnA5A_QPCm5NMFVz5gBLuW4njCqadl5Ifa8Sox7Pcqt-DpX8Xtqv80UA0ZthA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7j99NKd1Vu5zUNMFiMryl79HmC93yOBEAD7OUfkgBz8A&oe=6A008E55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMzJyYFc8p8Q7kNvwG28pMg&_nc_oc=AdobSmKpElY7qgHlpHWEVB5rTvLJTf6xrrKlTb4OmVPNwp_DKDgCJEfVvO7iFtjaHg0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70mvulm8PzAuqRfsL6f-zuj2rxlJlaQoHnNcihCzjwOw&oe=6A00A4B9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
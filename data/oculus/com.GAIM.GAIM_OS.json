-2.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hE-in566r8Q7kNvwGoIPUx&_nc_oc=AdrOrXG4yJ7V1s_mR-Xx9Yq7m70xDQUl4vWQTArJSgjPO0FxkrO64UYskHOn4geMlws&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDUiWexQUFIVR3uUmdFL0TwHjYQ2s1ArQw7Y5WMHQryw&oe=69C51532"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsnUa4btTzYQ7kNvwE6QYpS&_nc_oc=AdrDijzphNrWGh5A_VhEIWzkU9ITXRkCh_Rd6Jabv814CEParMWgtsQXsi4P-nqpL9c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8ajZCuxARoaArb3Rcp6Z76H39BWDEyvmTgDPEsciWSQ&oe=69C53AD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WuV2dZO48cQ7kNvwG6EFRY&_nc_oc=AdrNm39i-G9lwrEWGy-1K2Lcft_2mkLrl6NyGaUJBRZflrIjr3qBv6ysEn8j9Ti9udY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRPNps70vac1uuCvy646dKq9JKx4n6RiNSSrW8CsPL-A&oe=69C518F9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
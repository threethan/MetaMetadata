-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOdZiW7awEwQ7kNvwHsdmwN&_nc_oc=Adpdwf5nL7bH7nyfBxEtxAG9Ht_Pa2sHggaaGBccaQpyD1FvXYLlBmRt8Sd7n3e4slE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKqiM8aYF_Jio7Wd65tBgIB7kB9yRdRbfUsHJKPF8G6A&oe=6A622FF2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5I4TrS3ibUQ7kNvwGDMjyv&_nc_oc=AdoraTskxWBGYSQp8DznbP6ar45gxL5sEJkK8xrQhXrIj-49-nweFB0Pbp2dogWQ7Aw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4JtBH1vfwusn82MUP-Fjc1-nLK-vZfZ9NaPGXrmxXlg&oe=6A621D55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_gxEBYUF_IQ7kNvwHK9tzb&_nc_oc=Adr17-XgYxK75rKATrpXorDVSg6buSvjI_fOhVpoj2kD_lczjy6m2gyDiLgy7E_0DCs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrMhmQ7vjBU4Ad-6Lb3rlj8NoglTgnwAbKRHIzTXtJkw&oe=6A61FB79"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
-2.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbYx8Pf-HPcQ7kNvwHsPrx9&_nc_oc=AdqaId0oc5nBh75eMIfabodK3BkNfvRrvQsgMjK4eHwn38PI4bvS7Cq8qcknTFyT974&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_gi-o6GLIdDQwV5aWJmH3MQOVFH92xILJkugy7Bf4eg&oe=6AE362F2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GW-504N28kQ7kNvwEp2dOs&_nc_oc=Adrm6mc8vlQYfimGFLclIqaI7HiwBYsdJ3qzvK2uE9z6_VJJORluvSQZl2-3KcHE6TQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUzFW4kcchauXcPt44odLEar6S1O7wMsJLYawo69B_Bg&oe=6AE35055"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kv18swAKom0Q7kNvwH_p9n5&_nc_oc=Ado8AJcjEK_LXWyUxkNXrItrQc-hr8VAbmgeV6Ck3-SyqOzQOyCD1n-JM8EBRS8iXt4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPb1yU36RrFmB7s6hXSmcvmavBLLN-P8wRtL-v5dOIEtA&oe=6AE366B9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
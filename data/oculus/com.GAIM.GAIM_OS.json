-2.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1lv69Y-HzAQ7kNvwHekjUx&_nc_oc=Ado-rPcLCZsEgJFiidbsZRfvZgMoAzxE-fWD5RDkWJudHtMf2Jmg8sbbziCs5wcSMfI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82r_V1KhCovYVHpd4RjX8iE6PFcoZWhtEdZCZRqcckPQ&oe=6A243972"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxrIaQpRrF8Q7kNvwGEzImV&_nc_oc=Adp2tBiKr5E0sb55ufDUeJTQ1FHFAj6DcuaCK6EAFoGPVwVzk2J22hJ59RdKm3jkcu8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KCEk_kBTJZKDz3iux8vlpeSSon8C3cEroMPiN2HOt-w&oe=6A2426D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wK8zc4qfjmsQ7kNvwFEpqAW&_nc_oc=AdppzmhGS54mODv-scXKNgLe-k5u0TGi-xs9ACdzePy4jOOvKix3ChEv4ix0Qqi6hSU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gHV-BTvh_mAV0lB1tj-DI90CXAvaLfIqcqyddIeqBBg&oe=6A243D39"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
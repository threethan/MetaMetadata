h32fHc3Lww&oe=69A6C2B2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTDi-1E0ZdoQ7kNvwH9DZQQ&_nc_oc=AdlC9yR2IWbGwBc-9BJ_Uo7_pQ4YOPelTJVP2yPdTQPuO_HQ-9B6tYguj3Oo1tMc0t8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu3Y7Rf3DFBr3YrqEYI4Z9fluYGbSbPc9Db4bIe4NQqTA&oe=69A6E855"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29lzeLteX_8Q7kNvwGtC_sv&_nc_oc=AdlV2Dd1RE8NEdt-Y_A6jUNZL3993GnAktTnSY5XcfSYnCG0CK88CY6UdXJ_M9CG60Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftiua5YoJ8MOrkWRDRqFRF1-13KIsl8ZYkx1U4RJetH_g&oe=69A6C679"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting and sport shooting skills to new levels with GAIM virtual training simulator. Practice your skills at home with precision tracking of your barrel movements to understand how you produce a hit with anatomically correct animal models or sport shooting environment. Get ready for reality!"}]}, "developer_name": "GAIM", "developer_privacy_policy_url": "h
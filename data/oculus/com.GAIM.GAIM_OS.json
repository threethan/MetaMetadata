-3.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XMIdBiitWEQ7kNvwGZ7KLF&_nc_oc=Adrznvx7Akk5V0oI6nKnF3x02MLkv7xX6AkN5i-BLq0ok5yjQ4GBovwf8qQ2X-EcEjI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnZm-PLTWVJA4A2sqvUC6pr2MSwLekwynLgHH8lEvWOQ&oe=6A4E6972"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5oBk1rUnEQQ7kNvwGZp0p7&_nc_oc=AdpF-lvhssFVMuiUd7ToGSVmSgkJ2DQu0cZD1N5yCiPanO4mYcpm6eay3o1RHVZITIQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD533baNeyQ6w_ALC2ELuTkum62KqM4B7_qkm38naLcw&oe=6A4E56D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_tT-b4W1yYQ7kNvwE4rqZr&_nc_oc=Adr0yjanr8Qg7WpgNnrWY68Uk5yr_yOXwRREdZACoxB3W9mhgOdn2l5QxYaJ0Zq3kBQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDp0vOJa5oKqRKUtg7z4zb7IBVhZttJKt7T72KDD94iTA&oe=6A4E6D39"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
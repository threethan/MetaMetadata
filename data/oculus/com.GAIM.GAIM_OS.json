b=1-7&_nc_sid=6e7a0a&_nc_ohc=yrtWJgt17UkQ7kNvwF4GRNd&_nc_oc=AdnhwrgU0AZ-CO_Yuxw2lH25lQJ3UaoDzfOY3ZAbY6C4rrgo2UqzweISlA9L2e9sLQk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFfpz63aSAlN0bWFizM26YjeSMK9Ber0ICboyWJkTlDw&oe=69AEABB2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hftuVsNt8sQ7kNvwEO9MnA&_nc_oc=AdmXNxkhbuD5f9Kn2CJNYL59F1mWxePSTAgOMugECJGfIysp9t4gHNdwGlKQvcNVBWk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfrAYxvIBynC9pKx1JV0Ke3n86sWOrQqGVeFTBsefyDg&oe=69AED155"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wh6DlkHEUh8Q7kNvwG5x8HY&_nc_oc=Adn06E2eBw2dz1ChPk_3SEunOSI5jlKnCFI0POx8GKFdGTXW5i3IWtF4EWXxTIkN65U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3us2X-JfmPd5BFXykirXsjLT6efu5ml75SCGuETZOdA&oe=69AEAF79"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting and sport shooting skills to new levels with GAIM virtual training simulator. Practice your skills at home w
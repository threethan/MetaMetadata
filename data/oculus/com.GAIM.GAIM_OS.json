-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KunbtLFAkEQ7kNvwErfTKU&_nc_oc=AdorBUenBIlyjV8O61GgZ_Qs7Q2YZYIjg_N3h4gqIFl6OtYaU9eblrkN9z3IdiFl5uk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfyPexANYI3yCZpsh3GxU8l3Hb4ntW2XaZaHb4kam1Ow&oe=69CA5B32"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EYyBm4hMdgQ7kNvwGTrVkO&_nc_oc=AdqwcoBekca-9Kg0HCG5sGx1_bbydifv-WuEhav8Y0Dr29BRbTbJ0UvhM-K9wMkbNaQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZ629dY8gEnp_0Y-_jFwJMksCtl2ysVErAL56_1yr2Gg&oe=69CA80D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGqiLmjUIGEQ7kNvwHF6iu4&_nc_oc=AdqO3Q3nrVR09KxUh767dg5vOGnacteObo3X4twJYk_1gCGY7bUwgDERp-G_enht2DU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHFwkNuCAQG_tH2ZWzhm495bRB3gqypSbTdRMoc8U6jg&oe=69CA5EF9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
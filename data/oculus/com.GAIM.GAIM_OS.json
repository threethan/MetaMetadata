-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ouYjX9ySyoQ7kNvwF-IWG1&_nc_oc=AdoXLrYqEpQYScjyk-X7bBg9Qy1bYLGY0SlafKkHjEvrZ9wOC4I-F0L2umlZadxsUtY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Oe7e_qLnD2jV8H7mC-2A-QI039TUiLuumEuYE6od2ww&oe=69EDF3B2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yrx7qDNJPHkQ7kNvwGRB_WL&_nc_oc=Ado0oNAvozuAn79fEAcL-KTtAWU3ogpSRp9dhKn_RmOdxdwbMfm7CXBjThBMRiViI-Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mzM3e2PZSJpil7K3TtchzPk-l5Hnn-LX3nlJauxeR1g&oe=69EE1955"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAfcJOe4hJMQ7kNvwFu4yJh&_nc_oc=AdojDHUNKlgZfJLK8alUOJKRrt1svVnKpmgJXHM9xzDT0WBLlPnbm-tZUXk8rKEfw7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1A7qcUQcNjVjAC5TvchS56X-hRZ2VND2QPOcb4DV_tBQ&oe=69EDF779"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
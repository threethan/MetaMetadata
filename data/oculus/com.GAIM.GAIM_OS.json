reenshots_11.png", "id": "1694967164020999", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75221314_1694967167354332_3699015625018926501_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYZOiem-C5YQ7kNvwEb7EIS&_nc_oc=Adq_iQp8r2ReD01t8KqX4cGq4GirL9bw47McJ44-M5X87pbqPz12wcOyn0e_r-C8KD8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xLipviqoz2WPCCnJ4rp2q90LdFW3lNyxoAA824BvJEg&oe=6A22DD5F"}, {"file_name": "Screenshots_09.png", "id": "549763186433424", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGaLeaLkRRIQ7kNvwF6eLRr&_nc_oc=Adobj7GEMfIjAvWSvQ35MouGc0ZvLJmDLkM_jNIViR9CnAtQKp8X7OHC4-h_2eowuzQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Pua_m0M6hj8BvcWmk-MYWu3RGLiw8_PC-fAINYfAF1Q&oe=6A22E7F2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxrIaQpRrF8Q7kNvwFa0FuO&_nc_oc=Adpgz2CC6MSO79FTZRDj3ReMiIxBRDRx2-L3jhYPJYS3ZBYJyvhueQ_1Otrt1ilBBOE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bQjfZlrgOvwtr-XhphTkbTSgDkBKlaW7vf2Eh0GMX4g&oe=6A22D555"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wK8zc4qfjmsQ7kNvwGN6U80&_nc_oc=Ado2gKe28pQ2VM4660aKxQegSwET5RemV4-hRzJcB2zDuaMPu33TJWo8Qd6LWS2ocVE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-svx0N0V5gOzXeWJFXSc5RboivwBSmjKzT1MuiejrPIg&oe=6A22EBB9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting and sport shooting skills to new levels with GAIM virtual training simulator. Practice your skills at home with precision tracking of your barrel movements to understand how you produce a hit with anatomically correct animal models or sport shooting environment. Get ready for reality!"}]}, "developer_name": "GAIM", "developer_privacy_policy_url": "https://gaim.com/privacy-policy", "developer_terms_of_service_url": "https://www.gaim.com/media/hypdm2hm/gaim_s-b2c-general-conditions-of-sale_eu-usa.pdf", "publisher_name": "GAIM Immersive Technology Group", "support_website_url": "https://www.gaim.com/support", "website_url": "http://www.gaim.com/", "category": "ENTERTAINMENT", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7869307306493194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin
-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGaLeaLkRRIQ7kNvwHdXZZB&_nc_oc=AdoU0IV_1DcTnlbGm693zaaFPFPBcd8FRa02SSgJ0RnJYj4g7rZxpmrQAYoYfx7Yh0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YLK23vM7-9HxPgGW2zSEnzDVMLRJ-S3qSnoadX7yTGQ&oe=6A2044F2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNAPjfQKktcQ7kNvwFWUw-c&_nc_oc=AdrTLcxHE8Gwi3w4eolJJx4NiiRtbb1nwSHn2P9AouDOjNl8Z_QQjKGlc7Ha40FT9To&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jrify_aLrKkA1GJENAwSR3BtfwKxzcATIZocdLviMPQ&oe=6A203255"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljiATIzTia4Q7kNvwFSlPlw&_nc_oc=AdoV7dLfDbB9mzia_3bOOMxT1WlQNWaWC_KNHWF-AfeLFJuEJuQs1MVzsNTSq19U-Uk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wjQwxb741ekxaESjqRzylaIzIlkkosMyG2PwjxIH57A&oe=6A2048B9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoVrti0Ou3UQ7kNvwGBoifu&_nc_oc=AdoQHKBZPY0NBwqBwTRNQotJzGc8q5H7bO-f39eRzs2fHT_eq1RBByLIMgXz25tKzZg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXQnb203tskq2U5hOCTMt8rOvLh4eG97z6LtX55hEcfw&oe=6A7EF8B2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRX7B7j4jk8Q7kNvwEAdBmD&_nc_oc=AdrV7UoDvTppIvx4xlsSlBk1A0-QSDHmkxWY88J6bzqviCKtYWxQJi34mWuKRosjK6k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjVJZDRk2V3oPQKYwgAWCDDMN1eZzdg2mbhqm1DF-MJQ&oe=6A7F1E55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eftaDACKc1wQ7kNvwGxzQ9s&_nc_oc=Adoz_SrxFst7Rs8-B6RvDGsAgEPF_4ok3mSv7yAb4dF8iKWY7ZuzJ2qpCtX00Dfqm94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn3CuxunDA3gWqLkP78S_waHM9vYx4PJitrqxXx2-7Dg&oe=6A7EFC79"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
-3.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l28ulgR4El4Q7kNvwGbrzvq&_nc_oc=Adpj0xGqsDb-CkaMJXlqpof34-bbO5SLCsWkw_WvOjHSKD4Eu8qZQNvpTSYJspGgwWA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qBUTqM-URBiRh1XQER0npnqPp5GLLIuh76t2WtyIB4Q&oe=6A0C7E72"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kUI5wpe0Q0Q7kNvwGViTuB&_nc_oc=AdrlVcgMrQTl6VNfnQd1J4xpb5H_j1pxokjcRqhfXcjiqHezYS9j6iQPtucU31o33Kg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4F1Tj2FYMqAGrj_PpFpTGUVXnQQv7RryEyrF2_9D7dgQ&oe=6A0C6BD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZqUqHB8apIQ7kNvwFc9gdv&_nc_oc=AdrjjcWVZ1TQ4Li2TV1KoFp8jFDSDsGQ2a6d8ceRuj-JZhefgYvfUIZJIw5l01FEC9A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5agFOxa3JA4iBOg9WhiSUQUEO1b6BgUO6pCNlqbm1P6w&oe=6A0C8239"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
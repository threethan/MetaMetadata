cCy51GYtIw&oe=69F0CEF2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yrx7qDNJPHkQ7kNvwGYIjhz&_nc_oc=AdqabGrqlv7dKQhfZYWos-NgGkCQ29K-aJQUUYQFktSvkW-IkQbTv5gnIoi2-X9DrVk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af04Zv6lvuWs9fkfO-u48-dTc2e2FHZnKa6_2WZrz6HOuA&oe=69F0BC55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOVBJl42mpYQ7kNvwEVCGuY&_nc_oc=Adpaa1KN6Q1ek1Mx2AD09sAZ9Xak2dNoKGZ4A9wAim8UJTg7LtbXIj1vpyOLo3BtyUk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0g9764eGbeLXWxzWNhSJP-hlkmWi_HPIXZqu7mPH5XNg&oe=69F0D2B9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting and sport shooting skills to new levels with GAIM virtual training simulator. Practice your skills at home with precision tracking of your barrel movements to understand how you produce a hit with anatomically correct animal models or sport shooting environment. Get ready for reality!"}]}, "developer_name": "GAIM", "developer_privacy_policy_url": "h
-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0JCEZckZ-sQ7kNvwGGmddf&_nc_oc=AdpOej5vyI4Lwz0WNMPCSbm8iMPf_83vCrvlkrtAEF6-ULlViQX_kQcqquawZxT0-Ms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af776k-JdkzINTpoemqTiYOCbD-H-az8CR-eRrblgETAoQ&oe=6A0889F2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6vyJGA5ijEQ7kNvwGPQ5xy&_nc_oc=Adr4YVwF2Kv9Od7cgzYm7_9Is4najL-hRiFg8eTs0urBFsSCjukRGV6FfgrpfKZtYwg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BsScX_LU-iKEbUCEhqBcz5s8-lRrJvyIaVV56tqkcgQ&oe=6A087755"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8giFHeSJMVcQ7kNvwEBvZSN&_nc_oc=AdrNDOHTB3YYmKD38G61ztUcqb7k8vxOaOnYtA-cvKVwLRl4Lx0K3SD60SMb8ZkSq8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4F50ioYz-WwW07GWabYs4s-b-GThXcF1ndIRmo__INNg&oe=6A088DB9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
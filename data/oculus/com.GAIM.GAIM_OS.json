-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sTTeedCfIMQ7kNvwGUPYhQ&_nc_oc=AdqhOWQJj8m7Df-FnlslkZnT2K2FmZlmMsS-R7ht4elKgO7Xx9jenW8jtKxaXuA0khE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dw7qXa67EQ3X793RQ-Zvs6dp1D5rzihIoQDbnw7TmAQ&oe=69D8DBB2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoXDQGWOfR0Q7kNvwH5CjWA&_nc_oc=AdoSRAjRQXQ204Ksfhb-EuuHXshWMpf8-t7WZP4EWdzEXthdUY368uvzKFzIY57N4Jw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YjYnoSgyiriilESOeK_caRSOnQVAHERGtYl07KVE64g&oe=69D90155"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=momRpKgf3eEQ7kNvwG2pzmo&_nc_oc=AdoxyKHcTgJRNYjguDOHEN_i9gCtOlHkOasyJth5k4avbOF4YxkNwO6MeQFRCwwfdfg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17dO6BH7eaSPP9pUFtWmZnnyZVS3YgfYkJlkQXYv2xOw&oe=69D8DF79"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
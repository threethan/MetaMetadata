-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g36Ls4YoKncQ7kNvwFjv3BR&_nc_oc=AdrMuAoJnlpPfaIjvBUwN8gwCX2mAr1qYixmqm-a_Oj7BWpTFdZusshRI3AewFw6cRQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1butckp2qj_6GcMcFKsKvGJm2J-J9UYjiLioaCUMsj4g&oe=69E8ADB2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_v8MOxFOcU0Q7kNvwFs-SI7&_nc_oc=AdqxjbyX-HtdW2Cg7uSPpMxxqbUCWXI2SEQvfJ_YLDyXdJvkcTYSjKJUIkxX6V9mczs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tHi25Zl8unku_aKx07VKw62Fxurz-7EnfYpR_iUjxiA&oe=69E8D355"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIfan21TvsYQ7kNvwEh9oHL&_nc_oc=AdoSynyyeUmyZo5GUgLIDor1q2bQmb3Nz4yEhJ_bOGAyzcJM6bZx7v8YZqkALxTV2jc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XPQNlidfpPYkh7pfsxbJKvhnWheIvvkYMVsFP2vLLmQ&oe=69E8B179"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
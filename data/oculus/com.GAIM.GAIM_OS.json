-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NdCE08KNwcQ7kNvwGxRyR4&_nc_oc=AdpHV6XycAlnoUhfMk1HUIeSGxdBAPexOme2vLcmR0r6pDgIPh2XDl7AU-v67X2XOKk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8EoY8YVfRNC0chneJ_6j75_h02AE2CN3Nj-YtPRBRiw&oe=6A9410B2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1DNPlGCK-EQ7kNvwE0O9sB&_nc_oc=Adr3lNtk-ZfU7YZHEVOAnk6sBO3EkJO0FimQ_cL6FxbqSWhpAawIdY5Ko4PK_ngnF2o&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzhNzDK18sF0-9kgJa_WYoqd09YKQOE_qomR3yOeIc_g&oe=6A93FE15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yPso1zGgqMQ7kNvwFfMu_O&_nc_oc=AdpPjFa5bs3Yd0tm5e5tAfriFBzKMVpDbcqXhbJBcnoPLznIAaTlzbAf5QGf_fZ-vIA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_BdcSBpxeovNCj3SRWldaKaBuDPOEbmLQzMNBVaGjVQ&oe=6A941479"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
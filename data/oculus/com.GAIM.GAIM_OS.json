-3.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoVrti0Ou3UQ7kNvwEQ5gmw&_nc_oc=AdoOQO8lj8iGe5ceIEsyxa135cY13h7vgH_5JB6F-jMBddAOFavnp7mHzzLS7i4k9-Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIuwkhZMNxnhWU_0TMSA6Y-RWvH8A4dMZPdFqlkyERvQ&oe=6A804A32"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLgPAEfryzYQ7kNvwG6kA35&_nc_oc=AdppkVsaHp9V4n8r7B5TYHsSxGIwOrqfkUkhoXefZ9VUKtaODBIp1T8BPoHxWtYsCO8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTRzsHN2W6gAxAS9cTPhcg89JQ5sAd-NoA_v-RgjsEOg&oe=6A806FD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eftaDACKc1wQ7kNvwHVjVR1&_nc_oc=AdoKoJ6iZ5wmPsJqyVXpQSsNq14UHDwCmYzrfOqvBOVBOFIOi-NLxpvncLIMiztdzpE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXqst9NECXMfyTM1G0TlBoT1JT27XBSBW8l3DWd00WEw&oe=6A804DF9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
y correct animal models or sport shooting environment. Get ready for reality!"}]}, "developer_name": "GAIM", "developer_privacy_policy_url": "https://www.gaim.com/media/wm1jw4g4/privacy-notice-for-gaim-software.pdf", "developer_terms_of_service_url": "https://www.gaim.com/media/avkfvz5o/gaims-gtcs-b2c.pdf", "publisher_name": "GAIM Immersive Technology Group", "support_website_url": "http://www.gaim.com/support", "website_url": "http://www.gaim.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1120015775476226"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "213795230625965"}]}, "baseline_offer": {"id": "213795230625965"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1626385380, "status": "PUBLISHED", "id": "213795230625965"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25712155978448386", "version": "2.19.3"}, "id": "454990642245782", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3879816798775618", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25712155978448386"}, "re
-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9FVB4b5FJcQ7kNvwEF30MQ&_nc_oc=AdpgnLct39xsxTXFYPGFXfZq9YFsvgszyEZlHfJfGho27tOqVoeI7jqHiZpHvYRnJvc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VifBfgq4oV9evTV6uVwYDVuA6SPJZ-5pJBLT36MqZnQ&oe=6A1072F2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLki3fjGqbYQ7kNvwFCJp1Z&_nc_oc=Adp5_gZD7n4QTOLGBjdn7rH51gViazkqEADdGHOTRp1c7ZXN1wM5O9twXNVCMZaMl5w&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KbUp4hsRTxspyFFX02TiNgu8gmM-dz_VwwXc34PnZKg&oe=6A106055"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hSc1BVPk6gQ7kNvwEdtDMS&_nc_oc=AdqaUnxV7OqFwHwn5Dniu1NQBUpN62f6Gf1NbX6I0daRhC1sVsKibFoDVcuJeHx2oyk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nb8p-d2_ZZZ98RMB6wNAK_Gv3am_txWXm1vl9y_p3yg&oe=6A1076B9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
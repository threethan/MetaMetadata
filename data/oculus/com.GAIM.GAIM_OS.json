-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8Yb-6u0-4wQ7kNvwHuDdfV&_nc_oc=Ado4XrIVZyClZJ9mdDyHrJP8pVF1vOO0wOv2Th_WVNc6gV5QLFyQtt2XkIooyeVEryk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzn4rTFQDgvlvVV_DUVgXv_D51ujE6pFpMYnni5_8xwA&oe=6A707832"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BokS3AgnEzgQ7kNvwER02N1&_nc_oc=AdoLqETAK9gq3ZZ2lxrPBNQsNmbt9CLx7WYdkfkxCYuWQpJaX4WLY4CaC5y960DD_WA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVEDXod6e6nPoztjf7SLPQvh1Pf0QsPIyA0qL9ZQeUNQ&oe=6A709DD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlyZlD9AtmcQ7kNvwHr-uPG&_nc_oc=AdqZVO5cgGDYIbIdMRPnyoYitZheOikUMMpak0iohAU3_kocTMc9i1QxJHQ1jLaolck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfzuZ79ylyUFi-xCu2atY7NnWEuLdtUtITIHkQg-5PyA&oe=6A707BF9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
-2.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1lv69Y-HzAQ7kNvwFORZ9e&_nc_oc=Adqtz0KjugN2I9l0NCvmRrTSBy8mB2RBJq0XfqeC1H4NYIHd6wfYdvpq5k-vW_yX2Mc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rTaDiREeStQGOeRVH3tIFPTpbF8CK9rPOROve_F0j6g&oe=6A26DC72"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NupPsLYll5kQ7kNvwFaJuun&_nc_oc=Adr-_FXOaK4ZNpz_hQxFdr4qzN3nNmYz1peV-W6w3U0v6Aq9H1itmIjzmczw-iTbzNE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bEnmDgQe11HyVcLEdoSTtJUugr3l1QprhQEayBhsYFA&oe=6A26C9D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7muVnpvDrIQ7kNvwEkKnEH&_nc_oc=AdrPspdGRD38CV2mHYsguITpVAfJOowH8u9hPLfEU2xuBNf1PWhvniyim5GmyiyX0HQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OjvtovWq6ANLe1lQ_6oRafSEfJ_KJrO1WJJZTuBcXlw&oe=6A26E039"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNbIrl1HqxYQ7kNvwHt3WBz&_nc_oc=AdoVQs0k6i2pfxzJDS3XV0Ggx8xTx_GhJ82-s_AF0CUGJpl-qcz2wLpTdB_KGYSw4P8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NPpb4cVduAgWEPBWSRGNGStf6p0Qiov689ejMHSITmA&oe=69FB5AF2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xe0Gz-g14NcQ7kNvwG2mwRo&_nc_oc=AdoF5upot2mS10TEFf4A-GIgmTaec89TfWFfBpW-JI8L-uYJWRLb0ZUz0IDSzpSJCeQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yEVvOTdqZyGDMhTucLI0WSIp_pMImp8JK7huekXtRFw&oe=69FB4855"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvwLcCUkTVMQ7kNvwE4BvyY&_nc_oc=Adqcw6FVPpSohZ75rc0U7x_WJV4Xu7eMbT-Hq0fQkOuQv9lpvf0_gDHTyWyyPmscStE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4E76Fv7oXqaPOEqzBB3motPMwp_x554whd_EXexi9_zQ&oe=69FB2679"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
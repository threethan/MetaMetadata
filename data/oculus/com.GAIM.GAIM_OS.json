-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3V2Rld3v4tMQ7kNvwGRE2Ym&_nc_oc=AdoNgs7HD8nhR9Rl4KCtQrkALja4jKBZNlpbYUVs_0ABgnyBH72pwbIV3hb81ANh6s8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aZ_SGPMv_0Mn0Tm-nYQSY7vxK6NutWC84bmEkoHyAhA&oe=6A355CF2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjvwGw9-GMAQ7kNvwGtkOLi&_nc_oc=AdopJxDIep3ONBuXSddvqpRNvatdWvpIVymY48vOlqIo6QTnMWFgDitMicHbGNbS5CU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aZ2CS44MRHHUzBB82Iqj-OckXxBAByWRmbUB52NgHww&oe=6A354A55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7Udb9r6DF8Q7kNvwG1SjAs&_nc_oc=Ado-l6T4-5ou8xFY2DmFycMSeh2P7o3G3nEkrCqkskBnkOT6OvphzrHCei7nU73bmRI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7pQhbc9he1M_mUnYyePtojM0ZcWuG_R2IJxx0Bza7EA&oe=6A3560B9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
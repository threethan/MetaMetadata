-2.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCFQ49FcrikQ7kNvwFuPJYz&_nc_oc=AdrauMgwmBi7nVmhQGFZeysD89NGVREeaWGGmVk3jKofVHum2R5J68P7fFOyVmNSCBA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfVIvjcLv3NQVzu4rH_bAKl1jLqPRM0IDszfpSU_7-Yw&oe=6A8AD632"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qTmty16IR4Q7kNvwE7TtYf&_nc_oc=Adr-ktSHM87MT_FAaHKc0ax0GDi5s8fUdGj-UdWYAAuUOscue9mTsp_2CbpOsyOyINs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgbZmOnVxMjM0-0vt7bJOJsFJp-GerYg8KyObFlDdckg&oe=6A8AC395"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0CLzg9cNesQ7kNvwEUttLQ&_nc_oc=AdpaVaFyYUcDYf7o6be-CUqNPEwkS6hc933sRn5BUwzUCpu9YiUoYMJkGFTOCJ4ugOQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHU991M9cGS67gEj_kAD2ckQcmGYn76B6mKtdJ7YDxB1A&oe=6A8AD9F9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWns-r1325sQ7kNvwHqmovs&_nc_oc=AdrbBSFqNSuzbkW_73UyLlWrV6cowMPDtGW9J5nQUmo5blM8WofNcSjq-ZPYSAox_Jc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvffkLjaf6nJJJgd5-uplGoaYq9m-byAgvWVXdcS8Hew&oe=6A510C72"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFex9e4wakoQ7kNvwEHwvKj&_nc_oc=AdqXa6oc8EMUroLTfnE413PbSP_kuDfTW5qeDUPXxCCNDALmEcVSRIhA_58XudQApBY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6Wff1W_qnXsHyuRs5tiVDrE0ACPRPJ3RgklNCxMo7Hw&oe=6A50F9D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_tT-b4W1yYQ7kNvwFV1pPL&_nc_oc=AdpEO_JtrR0bEEfEHzYcY5_6vl3sKfh40fgbh18SxhMs-ohdZRxf9Y7bJNmVKKbcQQU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrBgeqvdMwnsXWWEme-EI-uUmfWvdPT8-GYKQQX4_XVQ&oe=6A511039"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
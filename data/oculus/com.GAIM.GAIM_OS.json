-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtzhB7btsikQ7kNvwFMK3cZ&_nc_oc=AdoFz_YaU0ryaKsyxiVsA85fhcNS1CjJscNr-BkLfY0vu6rmSyOEi7hF_AzWxjuHCFc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDK-yVvT2zvs2HrdJuUtFAfpnEkTMaUHiMx7GJ_hX-caQ&oe=6A576BB2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzGiyY7FAW8Q7kNvwG0cDxC&_nc_oc=AdoCVW1TNaEkYGplkyuWOlWTwGZYeYvcLW-VU-3sU0cywaocfu6DHNBXtppzjbmcZZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDArToDQeFDydzkYBZgQYBe0JfTGQeAU820wA8VxMVvtw&oe=6A579155"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqzNy8N4VoEQ7kNvwFSZ0qO&_nc_oc=AdpMWNI4f1-u3iayfqdBw-KIb6oD_B2K8N20BCLsx-1HfjpZSmDJWo4dExI6o1OLPk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS9BT9pwI7tETDUAq8cxkCLILX-Oe415WN_X7fHm9GSA&oe=6A576F79"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
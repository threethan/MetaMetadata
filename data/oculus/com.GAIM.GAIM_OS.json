b=1-7&_nc_sid=6e7a0a&_nc_ohc=KRB0J2fnMtUQ7kNvwGjy_HT&_nc_oc=AdlFQKipVF8EvDNr8_KBzOtiMuTKcsExP39tcBEFJYQSp5P-4ALU-yTDEioddohsH7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afze6ALd20l8IE72Xj2de6hQeM_lhC7j700a7n5PUNlQtA&oe=69B937B2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcsbhCwwr7cQ7kNvwEc33bc&_nc_oc=AdnfJC02ZRwTJl4csKqN2a3V01Yvkx4n9ems8K4joJTn9-revHiPRGRPPVCJ3ZGFcpw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxrx2y4lVeaLggXSzdQ502c__ssDfzsgaZlVndyVfNzfg&oe=69B95D55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgQfjB9Q9aEQ7kNvwFhRAir&_nc_oc=Adk20pdDcmjOW0jsY_7LpbCf7H4zN3HAn6SDgYrsp205hbeHRnMpc3Pf9pk5IiRboH4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx0DfY5r-DD9wn2RAxizoeGH7RODyeiIIysqtcqf0zXhQ&oe=69B93B79"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting and sport shooting skills to new levels with GAIM virtual training simulator. Practice your skills at home w
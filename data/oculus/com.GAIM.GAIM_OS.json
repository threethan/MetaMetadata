FUdLTBxMzw&oe=69A57132"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=of2nk9eoensQ7kNvwEdE9qb&_nc_oc=AdnyFX0cmVQbivXVLKkCZnjSx7npBX5ypxuusWjpJY-TK_H5TnToW8YHDrZGXUfG6O0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvJTZA6Wr1RpaD-HBGJqWJNXHDrDdC_ZUxwqzSrAOjJ5w&oe=69A596D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29lzeLteX_8Q7kNvwHtFXdQ&_nc_oc=Adkl6Nt_-iCLxGdrXx-1p-3uZNyCzzBBB8D9Yp8BGXWwR-SvG2O_USF3-qS1ILdRMfU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvSFWdIidrCD8qm_IZr0sW4rd5YuN__ipphyOOljAeDFQ&oe=69A574F9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting and sport shooting skills to new levels with GAIM virtual training simulator. Practice your skills at home with precision tracking of your barrel movements to understand how you produce a hit with anatomically correct animal models or sport shooting environment. Get ready for reality!"}]}, "developer_name": "GAIM", "developer_privacy_policy_url": "h
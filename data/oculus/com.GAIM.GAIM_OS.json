-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkqCjQpaQ1QQ7kNvwFI-mdl&_nc_oc=AdqshWob-hh1__hPi_bM1hjSJdNONnr_sUGSs2lJbMNrZWSFbW7Q7WpmFfhHP6AUQYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-2aTEosVwEY7-u-lvdNRJtzehD3Lt5jiCzmRKjcGZFA&oe=6A3BF472"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUhHLhTo1VoQ7kNvwETEFW4&_nc_oc=Adr_WryVBDaCRZlnO89ELAQtWqtCBqE9P5NqN1bpy8khBWdbBDHRNYjdsAPoqHmw5FQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FuLvqz8g8M2XdmV-roRX8Emi9rrSNwEOTW2NVRLq0dQ&oe=6A3BE1D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4F0iMlkAMIQ7kNvwFsBAQS&_nc_oc=AdriRPS2VGfN0ZKeyzfzWMqVMfRXrH_Zck8LrYkMgZdPAxQPDuv0I1UJlYnItHwWidk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ybJcKPaoqIi9Swm0girxZQ1spVUgmv-bptD5TVDttyQ&oe=6A3BF839"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bphK2QovnEYQ7kNvwGBH_vX&_nc_oc=AdqEOnkbz_2lNUE0oTD2gz3_gns77p6HRXH2fCkf-HkUjI5DLcJZz8xrkZC_fqXe3g4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvATri1JjsN5iCTYrVPeuI5e1Vhfg6A9I_Ytw3ki-dtQ&oe=6AC26D72"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMF7GS8ACQAQ7kNvwFq7FEb&_nc_oc=AdoDlYOxZHw3lwzUssV-KDrsCUxMwTcgzh-tIoTrgv7MyAsqyO5yPSpB1lNjgbX3_ss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4ds7LauuoLx3a1_vXFjPdm_4bbvldxwNFVZDPp_AZGw&oe=6AC25AD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pemaTc4gxPMQ7kNvwECDUIk&_nc_oc=AdpTP9jUyzPMGIljeTFRKbKM0Vq3ZWxk9d2_5MS5QF5yjc6DExB76Jjd24HQbBobl_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgRek4J0IlAKSIuJ1g07yEZkGf4HiKw4IXkE2mvtePgw&oe=6AC27139"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
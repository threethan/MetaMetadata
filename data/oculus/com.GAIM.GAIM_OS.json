-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XMIdBiitWEQ7kNvwFRly7N&_nc_oc=AdoKzZU1upCftHsKmLScIP-zSxNBQnLBulqu4ogLJ925wXSmrDivnt8mEUDV2cEtcFk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAq9vwNN4T2MkZWXFhPQh4ykK8d9CwsHGQ4f6jGh-ySOQ&oe=6A4BC672"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tYdtjOkxsMQ7kNvwFCCrmp&_nc_oc=AdpIjMsQyIW7bnH39G5hAyxquschtyoyRsqfBbH8GBeYgCvVIxZIFAsGY1jzQ8--H8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjjXr9corRjKbHucryEg9d4r3iw6sziI3YOvXUmVlobg&oe=6A4BB3D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NEQsbnzlK0Q7kNvwEkXQGc&_nc_oc=Ado0qyRM2j9Z6YzSUSvsDZWJm7Dbb-fZfDEvv3Q0ocAmHt5dt92Sp-_B2fKFs1geDmE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrFbkKrHayaKJYiA5OFPm4CJ55xAMqHMLQDeceG8pxXA&oe=6A4BCA39"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
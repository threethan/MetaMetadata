b=1-7&_nc_sid=6e7a0a&_nc_ohc=H5iLL1yAA9gQ7kNvwFPgph2&_nc_oc=AdmiYjIatF3p8lJFSGV5WKNpcVtp-nnmehbzSx4P3w-mj78zbCK8K2NdrLXImcYnbYk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLNT3aRcUqlVL_HB7qyXr_mPXsLazou0ariSe9NP6Yog&oe=69AC08B2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hm0IRw-bFRsQ7kNvwH0qY6C&_nc_oc=AdlKSnVKcpjuIBi1mfiiKLwYswbeYHN1YcsIX2udtL_CuCNmcLUdg7GNJycPtJSNzyo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJZ9mqRnoliHM7AfLEJSOowiqZW_fMOPKFJzuoMlPWEA&oe=69AC2E55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wh6DlkHEUh8Q7kNvwGQHLIv&_nc_oc=AdkMHeuF6BSu6uNvuy1ZE0vWPj6YxKNRgCS4b-wQnUTTA1jk31LSgv1fCR7Enrorz6g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxoBcVTgPyjvnlL3KNMhJucV7dl03OpKGeZastgqNedsQ&oe=69AC0C79"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting and sport shooting skills to new levels with GAIM virtual training simulator. Practice your skills at home w
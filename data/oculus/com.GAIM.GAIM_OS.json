-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWtvjAEyjnUQ7kNvwGCxK6W&_nc_oc=Ado0CSIOLnEkEHe5PCT36hDEBilc1YVaXdOTdzng-6spdPHC7JGhsAkOhhxpIzYBf-M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-w8NjKUBJow9qO-Nit5lDK-YWQ1WYLW2EeXqAy883Emw&oe=6A428BF2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Os1x5xnjwUQQ7kNvwH2wBuv&_nc_oc=AdqjMCy_JyJM0aYHEhbM2fRCl40MiyllPqBh8Vag6yQ-E1ubFwyoeRoorxKe78wWRGs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wHsFibUvS31s_catqrQuZ87tbFhAPA1L6ZFtSPXuo6g&oe=6A427955"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDaN0aQjqqMQ7kNvwG2UnyE&_nc_oc=AdrWu-Uc3gUxgZkqPBhngQw9l_K-RVzNDkP3rWwxh2I8Q0-d4Xb2sKBc5tX1fGWJKyk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kLwTxpM0UmPYAfzhjOfcdSaN79CaQal5rg8U8A-4jCw&oe=6A428FB9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
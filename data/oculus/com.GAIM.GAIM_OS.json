-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK8nWQgWqbAQ7kNvwHYjsE4&_nc_oc=Adqt1RdXfSa7L2YE06P1pFQ9TkRCj_X43K0JJ65vvSxxPPp7CJG74b1zGs6aMi-tqBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tB36QuULUTx-CVE3uTwnasNPqxF4fehaxSNSwWcSgFg&oe=6A37FFF2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjvwGw9-GMAQ7kNvwFa74tf&_nc_oc=Adpsrdere6KcQyn7x0ihc3wbjGWQD-0SQubmFc55L6GD0JFQYYTEkdmMKLFu40vSNNQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_G6WqaaJ3GIV7zqVslhO71YJMNeN6XbsZwcwBmGGBPCg&oe=6A37ED55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvVTmnVA34UQ7kNvwHG0uKh&_nc_oc=Adr90lluFX2fcYnreAziP0i8TlkBBlpZowy2w8RTI8yyVdCGtAB5P85yz4C0C5VPK4M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QFcMyqwJGSZ3Nt3w0wK35ZuJrvh5lxgKNSfkqPt2C9Q&oe=6A3803B9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_7FN6WVek4Q7kNvwF6qT9c&_nc_oc=AdoF17-Qh89uqdGE6oAQ25igIveErmusOG3a53aazAs-W9j_o-DMoc90Sy0_mH_4bEE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13JuVf1cfUT0dZnxYz6ljJFFEfFgEnd5SqAqaymtclrA&oe=69E24E72"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtyZnbf_-sMQ7kNvwG2Hwdp&_nc_oc=Adr1nO8Agdhloi_kWUUoh3IshTRfFPmFU2ZK3qGJPd58tgsFRmyUjYeHRE_YaC6UOl4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OWY-3c6iCzclFMNkCmg4Gu-cV1-U9czbdqIdTGV6rWA&oe=69E23BD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GktLxLnHZUQQ7kNvwFYr4cJ&_nc_oc=Adr4So4YGT9aeedGQ4L1X7RuMkK0eHPeQkACD2xW9-vPrMEyvwJ-xXY70UfXfO_4Dms&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iso5IBXmM9uFMfZEL9ZoP7DCa46m7w0Pna_3NcUt96w&oe=69E25239"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
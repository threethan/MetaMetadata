-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0JCEZckZ-sQ7kNvwGUSuK8&_nc_oc=Adp-wBX_kWnvJCrJ7Lmd7cIrD9BJWnb2b1bkRRt7YHB5A3x6wmOWhlwgXB1fmlB50jw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dZyyVTub6Fi9tiI9zfLXDI2Sm6N_jfSxCUHy9zi80vA&oe=6A0B2CF2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kUI5wpe0Q0Q7kNvwHTcTeS&_nc_oc=AdpgwDgTqZXybtF7NMMyfVdVQQThIASfEDn5gORH_igf4EWh9OOKLEWTAeOrGSCUl3k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TzvQccOZmqDWJbQ0dzBRWT_R1nX4H36bO8YGLygejvQ&oe=6A0B1A55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZqUqHB8apIQ7kNvwEABaYd&_nc_oc=AdrUqaJpWA--F1XNVa6kIUWan27veQREBEdLyqAO2MxdFPA5gOg1RoccuFLKHMOvkRc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jY5bZHM8uDkhkgB5qCUEsZrLO7gRTgTROocsDt_tWQg&oe=6A0B30B9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
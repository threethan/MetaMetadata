-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l28ulgR4El4Q7kNvwFVafnT&_nc_oc=AdrGciVjFfrcv7s7MQbboEAUmDQ4O70IA_jxKaIHU4OWz8i5_mzb5tnJ2K78tFXQoLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uEkmhmnh2HgibtH0ha8dTk1eQpjWAkAr-MVrXligzxA&oe=6A0DCFF2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLki3fjGqbYQ7kNvwHbwOBY&_nc_oc=AdoDbELezOnnMFgzOOcyIWnXV82TGi4S-kzXYOhDCniPOUM7TRvq7PXz49kVjDbU9qM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Fh0EqAgTrNmZfm-41j5MBUKkH4g9a8hCb7KKSiPJSVw&oe=6A0DBD55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZqUqHB8apIQ7kNvwFspIli&_nc_oc=AdoD7VhqwJ8sgLzOYNNVswMBuMiuBIjuZPShigDl5oVHn9uvwMNtasn4NZPDDsVdKX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43DuhrNuQKjFnoT2HiDSW0SBSvC7OO8VKGw84GNiy44Q&oe=6A0DD3B9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
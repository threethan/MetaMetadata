67167354332_3699015625018926501_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLm0TCyT_SQQ7kNvwGdM7Md&_nc_oc=Adljd3bgOE9fXxpgQf2MXGGqkSvBE9QnfnsqTzGtxlP7rSNwk6GpoQc7fFj6yhYHfJM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfugEV4g_NxTZR9fYPtc84-veAS_6QYBouVzvI7lrf4KZg&oe=69A058DF"}, {"file_name": "Screenshots_09.png", "id": "549763186433424", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETcB6NYARXcQ7kNvwHez_Su&_nc_oc=AdkNVfjNVnPAvS3pSEE2_ZblNVlDUWJJ6Pp6cEm2TA9F7DMIFK0D4jJwSKFaK-XlnCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuFYMDBUN6OdEPDPSv35VKVtc1h1CTxkWQS3ynwUW0UgA&oe=69A02B32"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnr_bZX42tUQ7kNvwEKl-A2&_nc_oc=AdlwEZ6XGHqFABIcz-Ewszsj7kHYiwcYFQHYfd2oAskCwNRqYKSCC1KbWRJDC99B_LQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftLznm2ifqfL6bPuz8hVZ7TVCOAvJoyw0hBegVhIQ3eTQ&oe=69A050D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UIwLt7xSTEQ7kNvwFA-t7V&_nc_oc=AdlUmZcGRsbyLD6u3eskZebaWZvVbXaeZEvZ-1xx13eiQMWiNP4lCPUm32JPDniJDTU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvZBXx6u3p3_k821ocY5MdD2vTYMs2c_mViuawQLAw22Q&oe=69A02EF9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting and sport shooting skills to new levels with GAIM virtual training simulator. Practice your skills at home with precision tracking of your barrel movements to understand how you produce a hit with anatomically correct animal models or sport shooting environment. Get ready for reality!"}]}, "developer_name": "GAIM", "developer_privacy_policy_url": "https://gaim.com/privacy-policy", "developer_terms_of_service_url": "https://www.gaim.com/media/hypdm2hm/gaim_s-b2c-general-conditions-of-sale_eu-usa.pdf", "publisher_name": "GAIM Immersive Technology Group", "support_website_url": "https://www.gaim.com/support", "website_url": "http://www.gaim.com/", "category": "ENTERTAINMENT", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7869307306493194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75429293_833542404039149_366075588194638757_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOZ4Zuex0mwQ7kNvwFQKHGD&_nc
-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFs4VPHXIQgQ7kNvwHbV88m&_nc_oc=AdoMqyj0bdKG4nu57SdDWqeulPCx8XI8BOpPGdl1-6AgbFP8S8up7Bia-FwTc_ezW-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiHDHKlP3jvB3J9jEb9pAdQFBDM7DHtO6LZTnJxMyrtQ&oe=6AA2C972"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbo34oWqFbwQ7kNvwFOtqYT&_nc_oc=AdqWPPGDdIHOVNtIZTbdfcWQY5YL5nP4Fk9a7dj3-9qn3SI2eh3dINM6r-yriaaSsos&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsnuvGLAdIRjrTh1_jCDz0VoozRh5XyXdNj1J5WAcg-A&oe=6AA2B6D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuERvZmYJ1YQ7kNvwHExPH5&_nc_oc=AdqG5auvC3C6o4N9HxP0-YmsnJ7kfulqvTQgB64a6CORj3DmsF9azq-AY5U8ICaWA-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbz8cdNcXxJBe3_LzbAtXPJu0il8UDrdOsOyKPYgcCwA&oe=6AA2CD39"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
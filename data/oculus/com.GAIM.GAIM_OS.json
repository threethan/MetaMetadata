-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sTTeedCfIMQ7kNvwF7nqs7&_nc_oc=AdrELl-QwW5ulT5a9EUvLwlQQwijLapX8-zROmJFp3-_hGjpPbfJ0bZSfXCKe9abrW0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ehj_ey0JQyW_e-b4GB69CPp7afgppnGw6BqZFoe7KOA&oe=69DB7EB2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpamUp04DGIQ7kNvwF5Xpuj&_nc_oc=Adq3OSu-Wpqlnd4XgZZnqY9okeleN5W3F3QD-_rRWKR-SIOdyHEWclrSi0ZSTWvA3wg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gzgo4BGZ9E_1YYTwtHu1yucz7tRrcqZ9_YtC2CxPnIQ&oe=69DBA455"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyF48qytWhQQ7kNvwHkWkIl&_nc_oc=AdrhUvq8RU5FZWlluAFtcSAGsZNEqXzO0POVT62b_uVk6vWN84xsKv6JxcSA9Jr0r74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QeCx-f-QFGTXsc5mPocbCAH3KZzouUff8W_x1V4dBgQ&oe=69DB8279"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
-3.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajIkLwQ0kAAQ7kNvwEACDAv&_nc_oc=Adoo2MN7EfPKMcYYHdwjdgx6VZRY2Y5PK5W8OB5_58gLAY_D1pMXYpXa-1KW0Ba6u3Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEP6V5c2SMEOf7UOWvnNHonJbUvly_U9ZaY-MLWFrHFw&oe=6AC904F2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5gZ-l0e5ycQ7kNvwG2Cr2q&_nc_oc=AdoC5Sk8cI46vEHwZYJdaJLHyr02UT0w8Qi6pwW2BxptRFPsW5Zq9rNT9YgqhtT-lRE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMibPrzu5V9HCcyvkZaAdacXN80dIALKiBQ7tOfUHn8QA&oe=6AC8F255"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzKFB9FpaZwQ7kNvwF903cS&_nc_oc=Adohts8YSy_UvBkNt8yzkHXiIPzWhCQDxLyjGXrzXq_3jZHEdf6-NnmLuch5OS5LRKs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONYTA5ys-X3zXbImLNWJP1hJZJgAmyDl9k-89ceu1Cxw&oe=6AC908B9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
0999", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221314_1694967167354332_3699015625018926501_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZqcG2yeKLgQ7kNvwE1DT6h&_nc_oc=AdmPiiCc_wHhslAWPwBmgWG0kir0wsN7sUbQlXgKEf7v9a54qxzym_Fkdd66dbm8OmY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiFviayUOMGEPLUxIctyp_DhmAMhDmQIaYArVZbMzFIg&oe=69AED95F"}, {"file_name": "Screenshots_09.png", "id": "549763186433424", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrtWJgt17UkQ7kNvwF4GRNd&_nc_oc=AdnhwrgU0AZ-CO_Yuxw2lH25lQJ3UaoDzfOY3ZAbY6C4rrgo2UqzweISlA9L2e9sLQk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFfpz63aSAlN0bWFizM26YjeSMK9Ber0ICboyWJkTlDw&oe=69AEABB2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hftuVsNt8sQ7kNvwEO9MnA&_nc_oc=AdmXNxkhbuD5f9Kn2CJNYL59F1mWxePSTAgOMugECJGfIysp9t4gHNdwGlKQvcNVBWk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfrAYxvIBynC9pKx1JV0Ke3n86sWOrQqGVeFTBsefyDg&oe=69AED155"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wh6DlkHEUh8Q7kNvwG5x8HY&_nc_oc=Adn06E2eBw2dz1ChPk_3SEunOSI5jlKnCFI0POx8GKFdGTXW5i3IWtF4EWXxTIkN65U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3us2X-JfmPd5BFXykirXsjLT6efu5ml75SCGuETZOdA&oe=69AEAF79"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting and sport shooting skills to new levels with GAIM virtual training simulator. Practice your skills at home with precision tracking of your barrel movements to understand how you produce a hit with anatomically correct animal models or sport shooting environment. Get ready for reality!"}]}, "developer_name": "GAIM", "developer_privacy_policy_url": "https://gaim.com/privacy-policy", "developer_terms_of_service_url": "https://www.gaim.com/media/hypdm2hm/gaim_s-b2c-general-conditions-of-sale_eu-usa.pdf", "publisher_name": "GAIM Immersive Technology Group", "support_website_url": "https://www.gaim.com/support", "website_url": "http://www.gaim.com/", "category": "ENTERTAINMENT", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7869307306493194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75429293_833542404039149
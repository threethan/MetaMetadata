-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2SKFMghJ6MQ7kNvwEHMZA_&_nc_oc=AdqtSkL1RZqfI7aPaLtLExjPIRXV4FZZhs9HneUF-HnBCigSkjTgS9gvvLwGFQDKTnM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE30LrEPYwHOY_TBegFOynl_ekJm0-EOUmgh5P9IjVw3g&oe=6A8984B2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qTmty16IR4Q7kNvwHc9VCO&_nc_oc=Adp8SD_yedEaEPY6KnB3Hc7QNptMDdwXsl3oCvfJnER5F8h6siWabSkgz8wvtSeOox4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO-703RlmKZNW5Bh89rdK6yRWbqfz5_l7IerLOf9KNIQ&oe=6A897215"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0CLzg9cNesQ7kNvwEtNNKn&_nc_oc=Adri7rNwyQJZcuYM16nMOUgmPplvhzRJOST7ius4iHR8ZO6gZj13SN8NhPtMMVeIr5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5FQdVIDGqMumqf0wA5qP9HBWpBCxNKxgTCYC-nvtaug&oe=6A898879"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
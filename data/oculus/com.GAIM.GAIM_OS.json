-2.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wPOwkySCSsQ7kNvwH5dALF&_nc_oc=AdowvaZfMoK0IOYSyMl__h7wIXULonvHcv5n7s1Nr5tM3b0FprwnUfXP8FqZkwyxk6I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSoZJskBeMi2o1xd5txPAEsOY9RlZrPh_MRvvtPPeE1w&oe=6A662472"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3lMCzJxQX4Q7kNvwFYXYaF&_nc_oc=AdrH0bUbisunj3G_4g93JKBMJpmLJBSZYoKY_c6S-A784yy-rS3KAwPjlzuWQZLM_j4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYnePLQo32h5gMkoq5OiYPw_x6iLEMiFdDSBItiRPJ0w&oe=6A6611D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nE6Y0GNIz4Q7kNvwHVX3-3&_nc_oc=Adr_0oiyDxJWA8qAg-obvc0nx3C4qh5LLC17JAKqk0YZB4eNmI-GXw3_A-3uiXGEumY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA16NoqK_vPeZjQq-tHWdqzMLbT3K5wj7zKJ64pukxSVg&oe=6A662839"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
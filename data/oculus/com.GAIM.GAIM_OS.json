-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNsK79kdMocQ7kNvwFuGvMW&_nc_oc=Adr7WXSyA4-sGlV48F_6wS99Ag94YS_pXVYN6mNOw6oQTZNaOGmjn1wXm508j6Yts0A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hnM-ujLYLWvLhd_7-cHInqITF2nlpIk6fn0NC4bFSmg&oe=69DE21B2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wN3f6Ix6CjAQ7kNvwEPa_-w&_nc_oc=AdqqO7gSg1vIAtYMvqm8u8M9zpbMxDg4_0qJZDYNOoVEwFgjIEU0288hoL1YyLziIvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QQ5jdpgN_jpHNjxJfonTjXQVOM7xI1bhz025muw0Zyw&oe=69DE4755"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyF48qytWhQQ7kNvwEvi00F&_nc_oc=Adp_gCEPZlxvxSNQkB6VBgX9cCybIIuxmop6W93CpUhdXUm7jNknXc2im-lEYVx05g8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eSptLzBDv4s3nmuxTS-4S9xn9MzdfjDL5wWz0MPktrA&oe=69DE2579"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
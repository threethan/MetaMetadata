-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AH7xg1VrcBEQ7kNvwEgvjyC&_nc_oc=AdpJw8t1kn_0vgIfyTRF5bVQ9RA1JFw_rzFy1MZD1Eh1oXksx0eNf7oLkkLUnja29WU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LMgnnNKFltmTNinbbGacMW-NXHMQskYcPi_WCufoQgg&oe=69FF4F72"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yvive1dpFoQ7kNvwET8rqR&_nc_oc=AdpE8mKgAbvWSc26-CX0OLUcWtd7TcMB4dDoScwdMH1EDzvS1g23wWpz8CY1iy5lnfk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uZpkvyx3PNKwX7uaz1DqaHEBnkXfAa3dprm9491Vx_w&oe=69FF3CD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMzJyYFc8p8Q7kNvwHh04Db&_nc_oc=AdoRS2Ed3UrSg92QuacXgz8Pc-YhXaKg3WFj8xfKSeEJCzBS71JtJYgtG0T9rkwPqmI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ExmAs1m9G5LBGRz8FzDzu5d0xfCJvSE6UBsQ88A4Wng&oe=69FF5339"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
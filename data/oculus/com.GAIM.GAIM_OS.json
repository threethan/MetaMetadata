5N1Y7UvOwA&oe=699AE532"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtVaRpAh8-MQ7kNvwH8ACME&_nc_oc=Adk9uh3d83a7v1qB0ISeNJdUnbQW9eGwO07h9q9PUoOS2J7SfTzxPmj9wRBRxiB5VMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftGCHZvpWTRDA1gauL8N_pS3w_HKqWWtIq9y9SzGxrsWw&oe=699B0AD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eECXKcqwIkQ7kNvwGSs4Eh&_nc_oc=AdnPRgmKMm6Ys3soYduWxSmpD6TqRCHl0riW8Qxxp3TvjirCoa9y68OqmSbKTfISjfw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsgKqw_-V6qfat2_xfjgjWJ0feYaEvGNzm8lnEjSkJWmQ&oe=699AE8F9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting and sport shooting skills to new levels with GAIM virtual training simulator. Practice your skills at home with precision tracking of your barrel movements to understand how you produce a hit with anatomically correct animal models or sport shooting environment. Get ready for reality!"}]}, "developer_name": "GAIM", "developer_privacy_policy_url": "h
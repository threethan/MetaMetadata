-2.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l28ulgR4El4Q7kNvwGixaOE&_nc_oc=AdpKEInKjzSJI1hx1Tnx9QrM1BtnbKZVIooD0GOVtwFrKt5DnzW8zYfk9_VBGoaVIso&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UNbqOh4PBM0-ih097tx-sfrqnIZ6JmJ1EubRhNIKJQA&oe=6A0F2172"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLki3fjGqbYQ7kNvwFCCSMH&_nc_oc=Adqc6mmkKnJaZKlSqcWcaxpFOFSLu1uI6jtZMZocISau0bpoIure-79623D3QhYm55Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SkKYwQUCVrBwd-gzYfMxW3CFaBziy1mw5nN414NBtmg&oe=6A0F0ED5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hSc1BVPk6gQ7kNvwGaWfoa&_nc_oc=AdpWb4o9xQUDcRkaRm7PuuDFSiVeWD9fEgHQkpPyQizSn6lltxNcoZOjUHlW302BuxQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DUmdL59M5Zxl0vb-XaYMIb6iD88n_8rQ4P-i3K44PIA&oe=6A0F2539"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
67167354332_3699015625018926501_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4ABBBmumxAQ7kNvwF4x3kw&_nc_oc=Adplt41HN3BVjiNklxm3e7avF0BhxICby6Yd4KUaduAWzcHQ9WQsTeNxvy93jwqTO-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0wLfidatJEZqNFy2Wh14IR2oo6kmyZsTsNhNcNdnuD1A&oe=69F0C45F"}, {"file_name": "Screenshots_09.png", "id": "549763186433424", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EJVzWUMZwoQ7kNvwE89GAU&_nc_oc=Adptmt4ZsYdush_0x0kInFFIQVbtBe5IexueiQrI2crxZ4b7E_NiJqA6gzLHuzV6tCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1zCnpd3gPe_P4EmqJb2HmAkItmCHT9bQ89cCy51GYtIw&oe=69F0CEF2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yrx7qDNJPHkQ7kNvwGYIjhz&_nc_oc=AdqabGrqlv7dKQhfZYWos-NgGkCQ29K-aJQUUYQFktSvkW-IkQbTv5gnIoi2-X9DrVk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af04Zv6lvuWs9fkfO-u48-dTc2e2FHZnKa6_2WZrz6HOuA&oe=69F0BC55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOVBJl42mpYQ7kNvwEVCGuY&_nc_oc=Adpaa1KN6Q1ek1Mx2AD09sAZ9Xak2dNoKGZ4A9wAim8UJTg7LtbXIj1vpyOLo3BtyUk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0g9764eGbeLXWxzWNhSJP-hlkmWi_HPIXZqu7mPH5XNg&oe=69F0D2B9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting and sport shooting skills to new levels with GAIM virtual training simulator. Practice your skills at home with precision tracking of your barrel movements to understand how you produce a hit with anatomically correct animal models or sport shooting environment. Get ready for reality!"}]}, "developer_name": "GAIM", "developer_privacy_policy_url": "https://gaim.com/privacy-policy", "developer_terms_of_service_url": "https://www.gaim.com/media/hypdm2hm/gaim_s-b2c-general-conditions-of-sale_eu-usa.pdf", "publisher_name": "GAIM Immersive Technology Group", "support_website_url": "https://www.gaim.com/support", "website_url": "http://www.gaim.com/", "category": "ENTERTAINMENT", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7869307306493194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75429293_833542404039149_366075588194638757_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3htggCDBY0gQ7kNvwHxpuI2&_nc
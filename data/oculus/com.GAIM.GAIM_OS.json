-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0P5r43ATeQQ7kNvwHvo2Nb&_nc_oc=Adqp-MqOuqn80s6VQHsL3uXCKyv5rhj2kSck2FpjJUhBrGvVqukLuhYovaNQqYdLOU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbDgEE9wUmL8L8TvCLKGZNayn0oKzZ6p9hI7Y3YnG05Q&oe=6AEDEEF2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCr9ggDrJ-8Q7kNvwEZHgPb&_nc_oc=AdpILc8UegTyyvD2OvgcDtbrK8OJmVSYQyA-n0TNGZ9wlC8I7SRM8-zkPxADlhAQtEY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzElKVEFADTuSeNoE9pROm7SnOuii8YlDuQWxsEt5oKA&oe=6AEDDC55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGF4Zf-761IQ7kNvwE8Q1V4&_nc_oc=Ado8Mkava_t4TXuGZkjPXmemIr6v7LeLbQq7lI9buDrsz7mEEb78M5oDjWpQXlSirps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfrg_xoSlzPyRDx4Vhb_LUajy7ObPoEqYrHx6XlwczqA&oe=6AEDF2B9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
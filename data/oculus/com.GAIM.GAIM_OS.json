0999", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221314_1694967167354332_3699015625018926501_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tM-eYsQfrNIQ7kNvwFPg7Oc&_nc_oc=AdksiO1U0zoR_oXvnDAyFK7PsSqYmUkoQ0s2eAW5_95paoIM_qbHtp6GbtKtWuC0xlA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afys4p5A0_GE5xGzDbasjevNmLyt1VYZoN7UO2ZY3NtuGA&oe=69AC365F"}, {"file_name": "Screenshots_09.png", "id": "549763186433424", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5iLL1yAA9gQ7kNvwFPgph2&_nc_oc=AdmiYjIatF3p8lJFSGV5WKNpcVtp-nnmehbzSx4P3w-mj78zbCK8K2NdrLXImcYnbYk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLNT3aRcUqlVL_HB7qyXr_mPXsLazou0ariSe9NP6Yog&oe=69AC08B2"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hm0IRw-bFRsQ7kNvwH0qY6C&_nc_oc=AdlKSnVKcpjuIBi1mfiiKLwYswbeYHN1YcsIX2udtL_CuCNmcLUdg7GNJycPtJSNzyo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJZ9mqRnoliHM7AfLEJSOowiqZW_fMOPKFJzuoMlPWEA&oe=69AC2E55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wh6DlkHEUh8Q7kNvwGQHLIv&_nc_oc=AdkMHeuF6BSu6uNvuy1ZE0vWPj6YxKNRgCS4b-wQnUTTA1jk31LSgv1fCR7Enrorz6g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxoBcVTgPyjvnlL3KNMhJucV7dl03OpKGeZastgqNedsQ&oe=69AC0C79"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting and sport shooting skills to new levels with GAIM virtual training simulator. Practice your skills at home with precision tracking of your barrel movements to understand how you produce a hit with anatomically correct animal models or sport shooting environment. Get ready for reality!"}]}, "developer_name": "GAIM", "developer_privacy_policy_url": "https://gaim.com/privacy-policy", "developer_terms_of_service_url": "https://www.gaim.com/media/hypdm2hm/gaim_s-b2c-general-conditions-of-sale_eu-usa.pdf", "publisher_name": "GAIM Immersive Technology Group", "support_website_url": "https://www.gaim.com/support", "website_url": "http://www.gaim.com/", "category": "ENTERTAINMENT", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7869307306493194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75429293_833542404039149
-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRNfPgAdnTQQ7kNvwH0QkId&_nc_oc=AdoN2bkTKtkf0-149JLb6PP1agICaMLnB_k-J5TGszJkfK2nOmHkLW7eWwXcBiBP1uA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4tEZZKbWG3Rrn0Lrj7V4mz_VOM5mf_NZUkFKEiZBrHw&oe=6A6DD532"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNmEBfPNsdgQ7kNvwF6wdVC&_nc_oc=AdoVgtv81P2S9Z14tyw5QhZjiRG-zqHpoVvDu7VqJV7yqs7vVKxPYDZDCywyZVDlk3Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeaf3Z0l_8cOSvEkim7zbln-6ItemIsd9dvqSkJhBTHw&oe=6A6DFAD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlyZlD9AtmcQ7kNvwEIenZf&_nc_oc=AdqxAIABqZYn-qtnqNILRjBFKMW5ERP1DqLfUuhXx0eASat6gHIevBLjVuAAkSEd5Ls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBScT6cc3KNIDfmdWPpkXSMT_11KUTISa6WtXrfQ_KQHg&oe=6A6DD8F9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
-1.oculuscdn.com/v/t64.5771-25/86663416_549763193100090_3492744617658851318_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxJig53os7YQ7kNvwHtrgAP&_nc_oc=AdqmnEfymigzsGlFOm25bVpYsV2Y-Xb-qsVl03iLDxJpYccWlynfS89XqSJIgnDim4M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2RRY4_xAhcrrSzDKGiPO0fcoC4PxxX6RC1QJIDpZghg&oe=6A972432"}, {"file_name": "Screenshots_05.png", "id": "481234233227641", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75411994_481234239894307_9041268923289417302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1DNPlGCK-EQ7kNvwHdRX7M&_nc_oc=Adq3ah85C45DcZamQDdV8uh8xDwKGubAz-eXLJyZcgv_MmUcDW9iMlR03KQSTazRLYw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUWFndq1hp9FtEo-tAwnnUh90zINyhgVTf1ELRaKR0GA&oe=6A9749D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAIM_TrailerCover.png", "id": "284549926658046", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031356_284549929991379_2954306797903590113_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuTRXeGYo8UQ7kNvwFYxIeL&_nc_oc=AdpaaW7FmZ4dAU67SBGbjpcMoKRNF62X-Z13LaqN48MV5peIOy4XFRskIw3v_ECgl6g&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFePCQw-e8Iqvv05Uf9cvORL3dzWgZjVb-0Mta_vXYMbw&oe=6A9727F9"}, "display_name": "GAIM", "keywords": [], "long_description": "Improve your skills as a hunter or sports shooter with GAIM virtual training simulator. Practice shooting and hunting in the comfort of your home, and with more sophisticated tools than at the shooting range. Precise barrel tracking, correct animal anatomy and correct ballistics ensure detailed understanding of your shooting technique. Together with analysis and replay of every shot, this simulator will take your training to the next level. Practice on targets where you set the distance, speed and direction then test your skills on running game in driven hunt scenarios or a set sport shooting scenario.", "short_description": "Take your hunting 
8_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0d3b_x1RWcQ7kNvwHZFOgs&_nc_oc=Adr1-otKfLiF_1GUlRPysIbxjq7VqdiylUWcdxPdcDNGaBqYpXTlYTUzydXyLTKJzHs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LAMqoS5dIcm2W8u0nEv0kp6KCfamTYcV9gQsucUCJXQ&oe=6A11A4C9"}, {"file_name": "migrated_image.png", "id": "627933034439748", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162716_444121725985510_1960196479456903168_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhLKuCSfwjoQ7kNvwEX9AMO&_nc_oc=AdrNLEJbXR5wiLNmudS1IVOG4icNGIe7ObZu1KWF68662f6L0-BS_z5q1xGjmqtR-F4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7F06s68oQuyf-_FwYTHj_aNRG5fZhspCpsPYuPeGLPGQ&oe=6A11B208"}, {"file_name": "migrated_image.png", "id": "515448935835792", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162754_606268173052132_4783216425135243264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1R08hCkhI0Q7kNvwGYgJg6&_nc_oc=AdoDHmi3W8r-xHsidlaG5XPcBiLx3ucC7yco3au3FGSudcGdbTK8huisC3gLxCxcQpY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6I47dG9K6GeKxMmuPThXwAomXVeyj180QBGBi9ljrS1w&oe=6A11AE8E"}, {"file_name": "migrated_image.png", "id": "206266577352150", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162788_1695949920436921_31988851996098560_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iy3a6_dVy6EQ7kNvwG6AX7c&_nc_oc=Adq6tscyr0hSl7ygdkFujCdLRbzudPl0x0MGV2d6MeX9f91A45XzuBtozoIshZCuDAg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Kj5wYv_7GJx410IG1SxM0l0vxmdep9l4bTn6pRu2-bQ&oe=6A119A23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4 vr canvas 2560 x 1440.png", "id": "2691314447788155", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974789_2691314451121488_8474531208594795837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8wIVBoCLbsQ7kNvwHhxAOq&_nc_oc=Adq0cTHo5PmrFg9UGl6kD-TwTfMpLo36KlthRyzfewV0Fi5b3RCZvrwSh6IkyMAPfxg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VOm74Zke8PHcwqIo3zZD0LrXB709cLcpfV8rp00LDow&oe=6A11BAD2"}, "display_name": "VR Canvas", "keywords": ["Paint", "Colors", "Canvas", "Brushes", "Palette"], "long_description": "Experience immersive painting, feel psychedelic colors as you have never before!\nArtists and creators get ready to lost in Dreams.\n\nVR CANVAS lets you paint in 3D world space with full control over all 3 axis. Unleash your creativity with 3D intuitive brush strokes, experience vibrant colors, use animated brushes for fire, smoke, leafs and even tiny little stars. \n\nYour headset is your canvas and the controller your brushes. Your palette is your imagination.\n \nThe possibilities are endless.\n\n\u25cf Art faster with intuitive brushes.\n\u25cf Walk and draw.\n\u25cf Draw animated fire, smoke and more 14 effects.\n\u25cf Change brush sizes.\n\u25cf Change brush distance.\n\u25cf Draw lifting yourself up or down.\n\u25cf Use animated rain, snow, spooky fog.\n\u25cf Choose from 7 different backgrounds. With music.", "short_description": "Unleash your imagination, Experience your dream."}]}, "developer_name": "Pixelwave", "developer_privacy_policy_url": "http://deepbrain.xyz/canvas/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/canvas/terms-of-use.html", "publisher_name": "DeepBrain", "support_website_url": "https://m.youtube.com/channel/UCTO1_2onnlwtul08nxxFeaQ", "website_url": "http://www.deepbrain.xyz/canvas", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "UTILITY", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_CA"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supp
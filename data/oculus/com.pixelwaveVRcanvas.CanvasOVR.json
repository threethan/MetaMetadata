8_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4tOAMig0xoQ7kNvwG-VpJf&_nc_oc=AdooU9aHTnXFBA8j1y77ecVuhYq3bREqTrSTRzzWVPiOKp2DZdpaVfXknZr4geeapPw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GG8hdnVj_JtnyZVzMkeCsyU6oWf2NHx31ROKMySD8eg&oe=6A230089"}, {"file_name": "migrated_image.png", "id": "627933034439748", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162716_444121725985510_1960196479456903168_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdxUjgBMTOsQ7kNvwHBYao3&_nc_oc=Adp6nViP83eh9isR_cO6bjjfq7gyugy9-WIWuV7hj1sRuOh4hMkZsZD1vpGUFT0MScY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xb5FnPciexpcXF7g65qeO2Crxc8K4UjMXwpO_b-Kg2w&oe=6A22D588"}, {"file_name": "migrated_image.png", "id": "515448935835792", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162754_606268173052132_4783216425135243264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FwEJsH6b8oQ7kNvwG8dM0G&_nc_oc=AdoUVTxvhc4paOgFWck6iE26b-bNTN2TKgXvIJRBGDkFE2dvmGvN9LUEWd1J24eDvqo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LR2i09fJlQ_XRohZAUkSxR1I4igRnPy4meV_d21O0IQ&oe=6A22D20E"}, {"file_name": "migrated_image.png", "id": "206266577352150", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162788_1695949920436921_31988851996098560_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l7Tr7qnS8cQ7kNvwElPriu&_nc_oc=Adqh67NUCafDrGcASD1keVf6vO1aPZfPvjvywvKEw5R3ipjI623h9Y750dwejfhcMKQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9H7Ct-8zZZVAquosDGUfLaVbCP0EtWJ4CmzfKjXclbLw&oe=6A22F5E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4 vr canvas 2560 x 1440.png", "id": "2691314447788155", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974789_2691314451121488_8474531208594795837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIY37EMBLPUQ7kNvwFnoXTa&_nc_oc=Adp2ULJP5WaRxOcOqMHAnhnQsUOPkZdd0nCiJkm4kv0ipwXT6vI-xIcQzvR9OmCrtRk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-c0CkD6z_88NSnBy6GFYffLvWFBQEtPc5LfZ5El76jnw&oe=6A22DE52"}, "display_name": "VR Canvas", "keywords": ["Paint", "Colors", "Canvas", "Brushes", "Palette"], "long_description": "Experience immersive painting, feel psychedelic colors as you have never before!\nArtists and creators get ready to lost in Dreams.\n\nVR CANVAS lets you paint in 3D world space with full control over all 3 axis. Unleash your creativity with 3D intuitive brush strokes, experience vibrant colors, use animated brushes for fire, smoke, leafs and even tiny little stars. \n\nYour headset is your canvas and the controller your brushes. Your palette is your imagination.\n \nThe possibilities are endless.\n\n\u25cf Art faster with intuitive brushes.\n\u25cf Walk and draw.\n\u25cf Draw animated fire, smoke and more 14 effects.\n\u25cf Change brush sizes.\n\u25cf Change brush distance.\n\u25cf Draw lifting yourself up or down.\n\u25cf Use animated rain, snow, spooky fog.\n\u25cf Choose from 7 different backgrounds. With music.", "short_description": "Unleash your imagination, Experience your dream."}]}, "developer_name": "Pixelwave", "developer_privacy_policy_url": "http://deepbrain.xyz/canvas/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/canvas/terms-of-use.html", "publisher_name": "DeepBrain", "support_website_url": "https://m.youtube.com/channel/UCTO1_2onnlwtul08nxxFeaQ", "website_url": "http://www.deepbrain.xyz/canvas", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "UTILITY", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_CA"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supp
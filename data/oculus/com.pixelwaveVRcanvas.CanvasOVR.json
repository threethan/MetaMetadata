8_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCO4rVkS9zcQ7kNvwFT7UhF&_nc_oc=Adp6wQ-o9Ghu09LDL8HnYD4naHhy7SJBhuFjc0gRMR5EBuEReJ0quaqgmSf982RFdyg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvlYP9NennAXTTezfneiSqI1JL31idCvevP-hSKMGCmQ&oe=6AAE8749"}, {"file_name": "migrated_image.png", "id": "627933034439748", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162716_444121725985510_1960196479456903168_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHHPz4hS6GAQ7kNvwHWADrs&_nc_oc=AdoF3ZygKI7AD5rXB5Ql2TolOHmtYAOqk70FBhASL_Dp9S2gJZTZRo7K-OngiTqJCss&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInd-AW70P2GJFTkfoqnJQrqhc1N5Ng9Kd0h6abBpjK5g&oe=6AAE9488"}, {"file_name": "migrated_image.png", "id": "515448935835792", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162754_606268173052132_4783216425135243264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZo9JdaB12EQ7kNvwHjRuX4&_nc_oc=AdrJ7DX470A-1jUcSKlFYSeIoNjHe9X_GEz58l1N0HHmSwrUhRotbXaLuLZagd4dREA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_kYARi6TZD16n_ICbTr_YjIV5uLsESPcxTyRYp4-rdQ&oe=6AAE910E"}, {"file_name": "migrated_image.png", "id": "206266577352150", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162788_1695949920436921_31988851996098560_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtdSfJVld-4Q7kNvwHlvAk7&_nc_oc=AdqY87C5-4Clpf7cZmZDLCDt9Pl16IaemflxUo7eJDqyE5v7fUM1SDYBoCgIEXX5yWE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLo_CrgNJ1Ea-8lyeUMLlQJFZswSXRxKttfCHL3VzYsdQ&oe=6AAEB4E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4 vr canvas 2560 x 1440.png", "id": "2691314447788155", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974789_2691314451121488_8474531208594795837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVRC-tAK16sQ7kNvwGYxz9c&_nc_oc=AdqJJgCFbBS_bA8SzAzC9psijQ_mp6VTZB465cRNOol-k8hTW-brP7RWsTqoUIRfNIQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi9w_76slk-Xyn-RQF_PEZL1X4z163Wj8yRd8NwH0Kaw&oe=6AAE9D52"}, "display_name": "VR Canvas", "keywords": ["Paint", "Colors", "Canvas", "Brushes", "Palette"], "long_description": "Experience immersive painting, feel psychedelic colors as you have never before!\nArtists and creators get ready to lost in Dreams.\n\nVR CANVAS lets you paint in 3D world space with full control over all 3 axis. Unleash your creativity with 3D intuitive brush strokes, experience vibrant colors, use animated brushes for fire, smoke, leafs and even tiny little stars. \n\nYour headset is your canvas and the controller your brushes. Your palette is your imagination.\n \nThe possibilities are endless.\n\n\u25cf Art faster with intuitive brushes.\n\u25cf Walk and draw.\n\u25cf Draw animated fire, smoke and more 14 effects.\n\u25cf Change brush sizes.\n\u25cf Change brush distance.\n\u25cf Draw lifting yourself up or down.\n\u25cf Use animated rain, snow, spooky fog.\n\u25cf Choose from 7 different backgrounds. With music.", "short_description": "Unleash your imagination, Experience your dream."}]}, "developer_name": "Pixelwave", "developer_privacy_policy_url": "http://deepbrain.xyz/canvas/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/canvas/terms-of-use.html", "publisher_name": "DeepBrain", "support_website_url": "https://m.youtube.com/channel/UCTO1_2onnlwtul08nxxFeaQ", "website_url": "http://www.deepbrain.xyz/canvas", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "UTILITY", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_CA"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supp
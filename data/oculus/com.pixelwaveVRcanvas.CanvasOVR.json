8_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_v-iw8dXbagQ7kNvwGSWNYe&_nc_oc=Adr7PlvImJhTlJLRLXvsJTawwxHbYhofaQ0pxaCycmSM-qwUF5RZoPqj855x4S26WvE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZoDzoRJnqcL6zdscVMXxl3j0vcelI5nPaS9cmygyMUw&oe=6AA94149"}, {"file_name": "migrated_image.png", "id": "627933034439748", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162716_444121725985510_1960196479456903168_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=weMZQPnv6gEQ7kNvwGFSWq8&_nc_oc=Adr1cBUDTlicVm-2ff5AKQwDK6_PJnaMdHvT94NKzy5_ajwzvpILa12dxRJoVB45Btk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEOav34kii4DI6HU2b-nxcUe4IaSX7mjk6U9gRJUuHaw&oe=6AA94E88"}, {"file_name": "migrated_image.png", "id": "515448935835792", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162754_606268173052132_4783216425135243264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xr94sO5dz5wQ7kNvwFT-yy3&_nc_oc=AdqS6CtnFOMO1gRTQlpaCzZvVp7C9sxIhHs1yXRkJSi39BmRB5wfLnH5JBztbBiLCfE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxmGMKW2ffxFHz6ET5a1Zb51w9OfghptsAUpjogBxz_w&oe=6AA94B0E"}, {"file_name": "migrated_image.png", "id": "206266577352150", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162788_1695949920436921_31988851996098560_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzCOMPYR-2gQ7kNvwHYZnem&_nc_oc=AdosUksBd3noTg6HCuyYCglGD6Saruq5dfTMdNTvn164_8vYpcO2e5AqhnfRGSAUPLQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdYyF0JM6DsNJmmFhfu3EG_Q8gZt2KrP8w3UgzAy51Tw&oe=6AA936A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4 vr canvas 2560 x 1440.png", "id": "2691314447788155", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974789_2691314451121488_8474531208594795837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlrwM4EFyJAQ7kNvwG6ZS0d&_nc_oc=AdrNFyNcBywtHq1hnZtMY29SmUfL80F7oMRyl_zqBVsv53O8tLafkpSbg7zd7pHQ1lE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_WcwJcIb29ccDCbcybkfzGDTXVNvxe5_RRjH_SjqAtQ&oe=6AA95752"}, "display_name": "VR Canvas", "keywords": ["Paint", "Colors", "Canvas", "Brushes", "Palette"], "long_description": "Experience immersive painting, feel psychedelic colors as you have never before!\nArtists and creators get ready to lost in Dreams.\n\nVR CANVAS lets you paint in 3D world space with full control over all 3 axis. Unleash your creativity with 3D intuitive brush strokes, experience vibrant colors, use animated brushes for fire, smoke, leafs and even tiny little stars. \n\nYour headset is your canvas and the controller your brushes. Your palette is your imagination.\n \nThe possibilities are endless.\n\n\u25cf Art faster with intuitive brushes.\n\u25cf Walk and draw.\n\u25cf Draw animated fire, smoke and more 14 effects.\n\u25cf Change brush sizes.\n\u25cf Change brush distance.\n\u25cf Draw lifting yourself up or down.\n\u25cf Use animated rain, snow, spooky fog.\n\u25cf Choose from 7 different backgrounds. With music.", "short_description": "Unleash your imagination, Experience your dream."}]}, "developer_name": "Pixelwave", "developer_privacy_policy_url": "http://deepbrain.xyz/canvas/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/canvas/terms-of-use.html", "publisher_name": "DeepBrain", "support_website_url": "https://m.youtube.com/channel/UCTO1_2onnlwtul08nxxFeaQ", "website_url": "http://www.deepbrain.xyz/canvas", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "UTILITY", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_CA"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supp
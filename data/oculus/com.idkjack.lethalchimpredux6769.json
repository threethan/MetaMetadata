6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lVxu6BNQUUXMDjU02PTbo-yZwUD9P78ZsRwIe640Wkw&oe=6A281487"}, {"file_name": "Screenshot 2025-08-30 142131-2560x1440.png", "id": "792692226778120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298298_792692230111453_875982153794506047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3lFBKObqmUQ7kNvwGGSc8j&_nc_oc=AdrM1LC_ESW2-x8gywQHmJbmZ48DkSDpjMRrq59cIyFFHmAlPdo3iCkDABOiq0PL4IA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wn6i58Zi4RHnHv_MQBwrB3SfnbS8YgNdHOM3kTu62rw&oe=6A2827DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Chimp Project", "keywords": [], "long_description": "The Chimp Project is a multiplayer co-op horror game where you and your friends play as apes sent on dangerous scavenging missions. Work together to collect valuable items, survive the hostile environments, and make it back alive\u2014before the night takes you.\n\nCo-op Survival \u2013 Team up with your friends to explore eerie maps filled with secrets, traps, and lurking threats.\n\nScavenge & Escape \u2013 Collect loot scattered across abandoned facilities, jungles, and labs while managing time and danger.\n\nMonkey Movement \u2013 Inspired by Gorilla Tag\u2013style climbing and swinging, movement is fast, fun, and skill-based.\n\nTerrifying Enemies \u2013 Strange creatures stalk you in the dark. Stay quiet, stay fast, and don\u2019t get caught.\n\nDo you and your crew have what it takes to survive as The Chimp Project?", "short_description": "The Chimp Project is a multiplayer co-op horror game where you and your friends play as apes sent on dangerous scavenging missions. Work together to collect valuable items, survive the hostile environments, and make it back alive\u2014before the night takes you.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforlethalchimpred?usp=sharing", "developer_terms_of_service_url": null, "p
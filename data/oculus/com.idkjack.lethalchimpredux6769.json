5"}, {"file_name": "Screenshot 2025-08-30 141732-2560x1440.png", "id": "755608337254625", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623555_755608340587958_7849803508522051258_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hESUXBIjMtAQ7kNvwFWB9HP&_nc_oc=AdrrUbq-rMTz0YhZZFXQebOJ6qrJYUoCBqXL0KLP30DJiXwj9ld3Gm9Hs0T5CG0hoi4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnsTBE0hgNvw4wN5ATTsl3g5QQagx_ne_fkUo7ErPk5w&oe=6A75DD07"}, {"file_name": "Screenshot 2025-08-30 142131-2560x1440.png", "id": "792692226778120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298298_792692230111453_875982153794506047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBupjavmCUYQ7kNvwHedWkC&_nc_oc=Adq6tK3wDdjukHZ73KNC7Uc2nc3Zfaxgs6uuCI3B3oxa-rnHq7bmp0DKJGeLSRADpMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYKkJme5C3j-6Bhby8Iwiw1VNEA6G7u9WhZAx2lwb1pA&oe=6A75F05E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Chimp Project", "keywords": [], "long_description": "The Chimp Project is a multiplayer co-op horror game where you and your friends play as apes sent on dangerous scavenging missions. Work together to collect valuable items, survive the hostile environments, and make it back alive\u2014before the night takes you.\n\nCo-op Survival \u2013 Team up with your friends to explore eerie maps filled with secrets, traps, and lurking threats.\n\nScavenge & Escape \u2013 Collect loot scattered across abandoned facilities, jungles, and labs while managing time and danger.\n\nMonkey Movement \u2013 Inspired by Gorilla Tag\u2013style climbing and swinging, movement is fast, fun, and skill-based.\n\nTerrifying Enemies \u2013 Strange creatures stalk you in the dark. Stay quiet, stay fast, and don\u2019t get caught.\n\nDo you and your crew have what it takes to survive as The Chimp Project?", "short_description": "The Chimp Project is a multiplayer co-op horror game where you and your friends play as apes sent on dangerous scavenging missions. Work together to collect valuable items, survive the hostile environments, and make it back alive\u2014before the night takes you.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforlethalchimpred?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "idkjack", "support_website_url": null, "website_url": "https://sites.google.com/view/privacypolicyforlethalchimpred?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24705652659065961"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1302659531296590"}]}, "baseline_offer": {"id": "1302659531296590"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757007300, "status": "PUBLISHED", "id": "1302659531296590"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24731107386520488", "version": "Lethal Ape Redux reborn"}, "id": "593807107019909", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24660692440228650", "is_concept": false, "latest_released_binary": {"__typename": "A
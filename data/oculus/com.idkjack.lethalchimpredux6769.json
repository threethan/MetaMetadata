5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fEZx_A4JXUAbJGgE53-dZkGT6gqshnj_U87v_UdxOLQ&oe=6A199407"}, {"file_name": "Screenshot 2025-08-30 142131-2560x1440.png", "id": "792692226778120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298298_792692230111453_875982153794506047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad2_68BkugsQ7kNvwFRbRgm&_nc_oc=AdqQ2ytglYnucLRnYVF_xg4pazyHy464u7d2yjZ3SpKBfB9oZDTAHZi2PSyroeiS0Wc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NuBFp0s5ORIQbA2LuSFXznA13dn_D5xBdcHU0Kdf03g&oe=6A19A75E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Chimp Project", "keywords": [], "long_description": "The Chimp Project is a multiplayer co-op horror game where you and your friends play as apes sent on dangerous scavenging missions. Work together to collect valuable items, survive the hostile environments, and make it back alive\u2014before the night takes you.\n\nCo-op Survival \u2013 Team up with your friends to explore eerie maps filled with secrets, traps, and lurking threats.\n\nScavenge & Escape \u2013 Collect loot scattered across abandoned facilities, jungles, and labs while managing time and danger.\n\nMonkey Movement \u2013 Inspired by Gorilla Tag\u2013style climbing and swinging, movement is fast, fun, and skill-based.\n\nTerrifying Enemies \u2013 Strange creatures stalk you in the dark. Stay quiet, stay fast, and don\u2019t get caught.\n\nDo you and your crew have what it takes to survive as The Chimp Project?", "short_description": "The Chimp Project is a multiplayer co-op horror game where you and your friends play as apes sent on dangerous scavenging missions. Work together to collect valuable items, survive the hostile environments, and make it back alive\u2014before the night takes you.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforlethalchimpred?usp=sharing", "developer_terms_of_service_url": null, "p
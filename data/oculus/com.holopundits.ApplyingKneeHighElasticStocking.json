35136125_8016914236888413588_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2mJGRdq_WsQ7kNvwFvCYol&_nc_oc=Adou5WGz7GDkHxdLGb9F0lv_yVij5l_JUiErT_0pGwzH88KG_sK4Ikw9hsFyrfGnLAc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsMoDjW1mx09JK-C4nAcPZ3X8LkpvH_R7E6ur7Vk0YdQ&oe=6B086E18"}, {"file_name": "Screenshot_High_elastic_05.png", "id": "1786530601875661", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974447_1786530605208994_413204783601365735_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejZozo21P48Q7kNvwFzmHzZ&_nc_oc=AdrsKfsiOi5Qin5I0fQniHfcaxYJb84LHMY0STWAP6ubfNUdoHMTLEic6wU77OrvrA0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPIAhcZahvpgXIhwzQVHIlvYLtjmJplEnuW53Vas4UGg&oe=6B084158"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "1053603966163731", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39031307_1053603969497064_6274887578004208063_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tcwe7_h86QIQ7kNvwF2jqzf&_nc_oc=AdoKWojXrAwEQEAOo13d-BuUgMotXDWsCDfiW6JUOFfIf6nezjbYPlOEkQ0c-IzMtQ0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVE91DgGuXfFf8f5511Sp6RMBhHIs-cJOOHSBGBdk05w&oe=6B086C8A"}, "display_name": "Applying Knee \u2013 High Elastic Stocking", "keywords": ["CNA", "nursing", "nurse", "training", "ElasticStocking"], "long_description": "This VR simulation teaches the skill of applying knee-high elastic stocking, focusing on patient comfort and effective circulation support. The tutorial includes preparation, communication, application of stocking, and final checks.  \n\n# Learning Objectives: \n- Remember the steps and safety protocols for applying knee-high elastic stocking. \n- Understand the importance of proper application in promoting circulation and preventing complications. \n- Apply the stocking correctly to ensure patient comfort and effectiveness. \n- Analyze the patient's condition to adjust the approach as needed. \n- Evaluate their technique to ensure it adheres to best practices and safety standards. \n- Create a comfortable and supportive environment for patients needing elastic stocking. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Learn the correct technique for applying knee-high elastic stocking to promote patient comfort and circulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066563946763313"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1447020829764363"}, {"status": "PUBLISHED", "id": "1715408065870237"}]}, "baseline_offer": {"id": "1447020829764363"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749742560, "status": "PUBLISHED", "id": "1447020829764363"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": [
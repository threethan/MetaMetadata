}, {"file_name": "applab5.png", "id": "623600377315246", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_623600380648579_2490320376177202595_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0nRVS3WMdEQ7kNvwFV2mRr&_nc_oc=Adp5mjX1d5V6E4TSNBJsQAtBU1cByQyVZFyowTP9oXsxV0t9yyajxE7z2-Lh-x755WQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0oWDqgdO7rYfwwqY0u0iAFYpD6DNR5XlflDFU9Yf8IQ&oe=6B05D6FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Maple", "keywords": [], "long_description": "Project Maple is an immersive VR multiplayer experience featuring Gorilla Tag-style locomotion. Swing, climb, and vault through vibrant environments using only your hands to move. Compete in fast-paced parkour challenges, engage in thrilling chases, and master movement-based gameplay with friends. With dynamic maps, skill-based mechanics, and a growing community, Project Maple delivers an adrenaline-pumping, physics-driven adventure like no other. Get ready to jump in and dominate the terrain!", "short_description": "Project Maple is an immersive VR multiplayer experience featuring Gorilla Tag-style locomotion. Swing, climb, and vault through vibrant environments using only your hands to move. Compete in fast-paced parkour challenges, engage in thrilling chases, and master movement-based gameplay with friends. With dynamic maps, skill-based mechanics, and a growing community, Project Maple delivers an adrenaline-pumping, physics-driven adventure like no other. Get ready to jump in and dominate the terrain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://html.cafe/xc7e971dc", "developer_terms_of_service_url": null, "publisher_name": "CanadianGames", "support_website_url": null, "website_url": "https://html.cafe/x03e4939b", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
c_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFgdKXAKTZ0Q7kNvwEfk1xA&_nc_oc=AdovB6-Ma400oMro7FsUhV8_aQu-0cdg94JcHurTQ7dptpyD_E7FYvpfy8jEuMJtp38&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPN5JPjH7RxVfX3McYOu0O4NyVwQDQDgNPPuQmCDR34Q&oe=69C932BF"}, {"file_name": "3.png", "id": "2135550943855715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_2135550947189048_6320350203643855138_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_dz42GLutQQ7kNvwGXixn1&_nc_oc=Adrph8-btlk8MNB540eskvt6-BlGQYrSp9t88cHeKDE5BrlBRlOkah8kMDQSjG34MYM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDM4-vhwKxaKM_s5LDQuJKkG3xQmenq8odnTI9OJWmLQ&oe=69C931EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Yusuf", "keywords": [], "long_description": "Surah Yusuf \u2013 VR Experience\n\nExperience the recitation of Surah Yusuf, the twelfth chapter of the Holy Quran, in a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience provides a calm and distraction-free space to listen, reflect, and connect deeply with the lessons of Surah Yusuf. High-quality audio and smooth navigation between verses enhance your spiritual focus and engagement with the Quran.\n\nSurah Yusuf narrates the compelling story of Prophet Yusuf (Joseph), teaching patience, trust in Allah, forgiveness, and the power of faith. It provides timeless guidance on overcoming trials, maintaining moral integrity, and understanding divine wisdom.", "short_description": "Surah Yusuf narrates the compelling story of Prophet Yusuf (Joseph), teaching patience, trust in Allah, forgiveness, and the power of faith. It provides timeless guidance on overcoming trials, maintaining moral integrity, and understanding divine wisdom."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_webs
6581686667", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491818890_715126585020000_1680025408905742396_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjmClkDOCbAQ7kNvwFd-199&_nc_oc=AdruJsXL9zFFdi5RH-r7E0tsSyxlHYDqFmFnPevyABGzJp8BAf0A_hdKLkKWjpphpjs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsVCPO9gyZ5_afmEHHoAfMw-L4KLw_31xf8nBsbTw2iA&oe=6AFF19D4"}, {"file_name": "image.png", "id": "906460292196167", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824328_906460295529500_632370028532355369_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_llwaZa1OoYQ7kNvwFWvm5j&_nc_oc=AdrQVrbboU_-RlFd6qCZhZCFhzKw8KzLwFe9lZJe6gb2Q_s0SLK4n8Zo9uyDyHhkjr8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUzQBuLeqBJ_oBLYQzpcc32-2-Vhj2z3LtdXc0Cied5w&oe=6AFF033F"}, {"file_name": "3.png", "id": "2135550943855715", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821099_2135550947189048_6320350203643855138_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaUUuiIcx7EQ7kNvwF1c_Ff&_nc_oc=AdqqPCF1LKNF-CuZn8F5dAO9gkAFcULKPb-QZV-afEdeDGCpjU05Jhp7UpZjYGSFybE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZmrAlraqKVZBL7-M9cP6xS9zC5zGWDPwlAzxnzUtkog&oe=6AFF026C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Yusuf", "keywords": [], "long_description": "Surah Yusuf \u2013 VR Experience\n\nExperience the recitation of Surah Yusuf, the twelfth chapter of the Holy Quran, in a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience provides a calm and distraction-free space to listen, reflect, and connect deeply with the lessons of Surah Yusuf. High-quality audio and smooth navigation between verses enhance your spiritual focus and engagement with the Quran.\n\nSurah Yusuf narrates the compelling story of Prophet Yusuf (Joseph), teaching patience, trust in Allah, forgiveness, and the power of faith. It provides timeless guidance on overcoming trials, maintaining moral integrity, and understanding divine wisdom.", "short_description": "Surah Yusuf narrates the compelling story of Prophet Yusuf (Joseph), teaching patience, trust in Allah, forgiveness, and the power of faith. It provides timeless guidance on overcoming trials, maintaining moral integrity, and understanding divine wisdom."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34282164451427980"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_1531930202268155_8806785617668924594_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcHSZcI61WkQ7kNvwEH6msM&_nc_oc=AdrZ47BR8oF4mzkK9VPP39QgAJSXTxbR-9f74SZQRUaTojlApeKqlqW99SD09yz0Ij4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCmCJrf9Fi39UBQ1VbEKKY6xykWKLOj4CKj3dxwqsxUg&oe=6AFF0AEA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surah Yus
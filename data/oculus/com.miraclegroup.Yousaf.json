c_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuIWrehGg2wQ7kNvwFuQG4r&_nc_oc=AdoFlMnw3IzdjLaC8feLpygTDY29BHuxxV5_6MpRKd_Mw-Zfbqivf7RcFcR33HmntG8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSBtpyvCoJfReS-Z7lFv3lwBGNnv-i-whO1sQBcSJRkQ&oe=69CA843F"}, {"file_name": "3.png", "id": "2135550943855715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_2135550947189048_6320350203643855138_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_dz42GLutQQ7kNvwEnqvzs&_nc_oc=AdpmjPfx1cw_k7njN0eLf4s3b_rxCVoCOd-p_NLs77dcxpahgRPnHC4ElluVu4Mc6kM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLZzsOAvuVx-ci5fWEw8skgXidAUsTmY01iq0oRHiQ3g&oe=69CA836C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Yusuf", "keywords": [], "long_description": "Surah Yusuf \u2013 VR Experience\n\nExperience the recitation of Surah Yusuf, the twelfth chapter of the Holy Quran, in a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience provides a calm and distraction-free space to listen, reflect, and connect deeply with the lessons of Surah Yusuf. High-quality audio and smooth navigation between verses enhance your spiritual focus and engagement with the Quran.\n\nSurah Yusuf narrates the compelling story of Prophet Yusuf (Joseph), teaching patience, trust in Allah, forgiveness, and the power of faith. It provides timeless guidance on overcoming trials, maintaining moral integrity, and understanding divine wisdom.", "short_description": "Surah Yusuf narrates the compelling story of Prophet Yusuf (Joseph), teaching patience, trust in Allah, forgiveness, and the power of faith. It provides timeless guidance on overcoming trials, maintaining moral integrity, and understanding divine wisdom."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_webs
c_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfmBSlP_H_8Q7kNvwFv_lQW&_nc_oc=AdpdMmXlZ13rObiuTDbOShRETfUZtDY-UW_e3017Ds7AVoY-jmk2cu-_qVjCx-zFFHI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzH0QDCMn0Ip9H_Q6K4grmpB3SS4cr1oqD1FCJXjSBJCQ&oe=69CFCA3F"}, {"file_name": "3.png", "id": "2135550943855715", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821099_2135550947189048_6320350203643855138_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDqQqvt_-LwQ7kNvwEE_AGv&_nc_oc=Adopd2cvwucT7V1oG-VnrcoPG6JylBQN_mPLRGcAGv-M3zR5_NByeO2-i1T4giaJGwU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-fcd_ULPE1uxXWG_bJZI9icsZMOj0MmnxASog2mlbjQ&oe=69CFC96C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Yusuf", "keywords": [], "long_description": "Surah Yusuf \u2013 VR Experience\n\nExperience the recitation of Surah Yusuf, the twelfth chapter of the Holy Quran, in a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience provides a calm and distraction-free space to listen, reflect, and connect deeply with the lessons of Surah Yusuf. High-quality audio and smooth navigation between verses enhance your spiritual focus and engagement with the Quran.\n\nSurah Yusuf narrates the compelling story of Prophet Yusuf (Joseph), teaching patience, trust in Allah, forgiveness, and the power of faith. It provides timeless guidance on overcoming trials, maintaining moral integrity, and understanding divine wisdom.", "short_description": "Surah Yusuf narrates the compelling story of Prophet Yusuf (Joseph), teaching patience, trust in Allah, forgiveness, and the power of faith. It provides timeless guidance on overcoming trials, maintaining moral integrity, and understanding divine wisdom."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_webs
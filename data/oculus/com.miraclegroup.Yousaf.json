ing patience, trust in Allah, forgiveness, and the power of faith. It provides timeless guidance on overcoming trials, maintaining moral integrity, and understanding divine wisdom."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34282164451427980"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_1531930202268155_8806785617668924594_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cIpBU_2ybkQ7kNvwFFa73p&_nc_oc=Adr6rorPWm7qxhixV7rGQws9-H6R5Gwc9KLV7ywqrg5kaPbXcdLpVdny8tBYJCi0k2E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrSZf5HEFmuMxn2-FSaQING6eT5e2UuaB7ltD4ebs07w&oe=6AF32D6A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surah Yusuf", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1774331880, "lastRevision": {"nodes": 
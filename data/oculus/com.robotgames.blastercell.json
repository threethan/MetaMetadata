25/38974757_243546163217467_2911580638018535424_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzNkiR7gFSoQ7kNvwFgCjNl&_nc_oc=AdkIrR-MEpJ-lAiCYBm_D5EIghDtaAHRPRnkUc3BE97FDxCgOLub69WJZUblzRKzX2I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHaVsFtaexxW4tgiru2W-99uAnX1ar-m7WWthDHG0-SA&oe=69B6AA9F"}, {"file_name": "migrated_image.png", "id": "1096513074029578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_241503820116265_6764154942342037504_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGvEsRBIhD4Q7kNvwEBBlwH&_nc_oc=AdnPyTc7P2v2m633i5jvb3dS6Pyk4aEff2SqVwXIHbuI4GfmC3Pnr_ooGlL2YXKmPXc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjB4lp_d05W8Turd2Jp05MmoEKEXrT4CCtS-V-ZyfldQ&oe=69B6BDBE"}, {"file_name": "migrated_image.png", "id": "215405842871822", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974768_2244345925784146_3794152170593452032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8t9Oe1VLAScQ7kNvwGAvzN3&_nc_oc=Adn3P2KmawNPsrPW8l3PS3aLtk6XwEfCGZscL-yqw86pYVa-4wsEsJ1XdBXDkTEUtto&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQjZkLz9FO27y7h5uFnSAiEuub8P2NYrTfP-bxm2lefg&oe=69B69C07"}, {"file_name": "migrated_image.png", "id": "645041882925750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001705_589001708210750_261996801807089664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCSW8vJt4oQQ7kNvwE-MWBF&_nc_oc=Adk_Xq4QmS4p0s7aFRYw3kUnGY4PXzVsEAYOhqKH2a2VHvSxPKjqklOcPF5os9x4sVs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6zjVVVmqGz23E2iWC7CwfbVo3lk97KUVvQ9zm6LkAEA&oe=69B6B003"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlasterCell", "keywords": ["Shooter", "Arcade", "Space"], "long_description": "Arcade VR Shooter: \nFly through the cold reaches of space, with only a space blaster and your ship as company. Destroy asteroids and pirates to gain fuel and keep alive. Innovative shooter control scheme. Fast paced action with tight controls and hectic enemies.\n\nRunning out of Time: \nFlying through space isn't cheap, asteroids contain fuel, blast them to keep going and increase your score.\n\nUnlock Ships: \nThe higher your score, the more you destroy, the closer you get to unlocking new ships, each ship is unique with its own stats and behavior.\n\nArcade Gameplay: \nTry to beat your best score, your friends best, or the world high score.\n\nEndless Enemies:\nFight endless hordes of varied enemies. Fight to keep moving, keep moving to survive!", "short_description": "Enter the cold reaches of space and fight your way through. Twin stick asteroids with fast paced gameplay. Battle through endless enemies, ever increasing your score. Fight to keep moving, keep moving to fight!"}]}, "developer_name": "Robot Games", "developer_privacy_policy_url": "https://smokinskull.com/BlasterPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Robot Games", "support_website_url": null, "website_url": "https://www.facebook.com/RobotGames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "459645388975291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974556_1771160469679931_8196311039868928000_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72LfSr2AYXAQ7kNvwEOuBM-&_nc_oc=AdllIt7h-lV_f68EV1rYusoUSVJ8jZ0fTwWjlq8-f886IFMrKy9fLjN-He80XUHFKm0
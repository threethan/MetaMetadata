atl3-1.oculuscdn.com/v/t64.5771-25/38974757_243546163217467_2911580638018535424_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fl_t8bPCqsQ7kNvwHGixa7&_nc_oc=AdrL9FU35V9Lj9POJM-pyLjwy5jfPb6G16sdff7c4vsa3TuA8jLjO5jmZmuco1g0q8U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMXpO4i0olxP7JoW3uN65PvlJ5wfeskg1RGxka218nXw&oe=6ADCA91F"}, {"file_name": "migrated_image.png", "id": "1096513074029578", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974886_241503820116265_6764154942342037504_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfsy4_9d8SAQ7kNvwEceBm0&_nc_oc=AdohB5U2k96D2fOlfm-ragdDzkubpMil5sSPRKqkNkGSU9skI3gZH6JgZUzElXsfHr8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTeAOLHifseGuSM1O9_56NjGt3jYBCQ-MygEHE-x9eng&oe=6ADCBC3E"}, {"file_name": "migrated_image.png", "id": "215405842871822", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974768_2244345925784146_3794152170593452032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKXmDSe5mB0Q7kNvwGAjJqP&_nc_oc=AdpDOp7VdoLyKxk726ZGIgO9nxpMxZ-QVPquV_McPcVfjaynhfi7N0NokK5zrzBSpJI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjlJSoX8abSB_2LSigmwWhKOwnTndaw6-HdPm87SZsog&oe=6ADCD2C7"}, {"file_name": "migrated_image.png", "id": "645041882925750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001705_589001708210750_261996801807089664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T793aBgnC98Q7kNvwGBII-i&_nc_oc=AdpENU88Zc_auauuqUTF32b0PEbS5ApY3cAv2DfepR1AVXIlpLpU-o0f6F5c9E_zAEs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_jVkVm_yQeg6yHkS3WMqKvvftUpUGH4BzgoJFWBAzOw&oe=6ADCAE83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlasterCell", "keywords": ["Shooter", "Arcade", "Space"], "long_description": "Arcade VR Shooter: \nFly through the cold reaches of space, with only a space blaster and your ship as company. Destroy asteroids and pirates to gain fuel and keep alive. Innovative shooter control scheme. Fast paced action with tight controls and hectic enemies.\n\nRunning out of Time: \nFlying through space isn't cheap, asteroids contain fuel, blast them to keep going and increase your score.\n\nUnlock Ships: \nThe higher your score, the more you destroy, the closer you get to unlocking new ships, each ship is unique with its own stats and behavior.\n\nArcade Gameplay: \nTry to beat your best score, your friends best, or the world high score.\n\nEndless Enemies:\nFight endless hordes of varied enemies. Fight to keep moving, keep moving to survive!", "short_description": "Enter the cold reaches of space and fight your way through. Twin stick asteroids with fast paced gameplay. Battle through endless enemies, ever increasing your score. Fight to keep moving, keep moving to fight!"}]}, "developer_name": "Robot Games", "developer_privacy_policy_url": "https://smokinskull.com/BlasterPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Robot Games", "support_website_url": null, "website_url": "https://www.facebook.com/RobotGames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "459645388975291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974556_1771160469679931_8196311039868928000_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHhDcEMOLtIQ7kNvwGtGhog&_nc_oc=AdpkgR3XIXqhtf_-vBj
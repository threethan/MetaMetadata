25/38974757_243546163217467_2911580638018535424_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tA8ZVHdLkv0Q7kNvwF2GmkZ&_nc_oc=Adl05r1CMwDDTfN347P2lTrJ0mV8QY7ix5mRzW-yx7aU5KqfE5qJT2eQQBoWr-OWVno&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu7RwpgTmRa52VsYRTCtfQGDpyZCxZ8HV3vcT8zmAnOiA&oe=69A97B9F"}, {"file_name": "migrated_image.png", "id": "1096513074029578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_241503820116265_6764154942342037504_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWs5K96Ei7MQ7kNvwGu6Rmu&_nc_oc=Adkp1G-tHcNH0BInus2RI2fuAX9gx6QKV3uvktSeniOdxR6FyCa4zJFaq8VZkMPD3BQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuAabp5p_TMgu2ygwTHjQF6yiGjR77SuAlV3pvJ-Ul_Hg&oe=69A98EBE"}, {"file_name": "migrated_image.png", "id": "215405842871822", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974768_2244345925784146_3794152170593452032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dXhGvgLMJoQ7kNvwHntizW&_nc_oc=AdnKo_JLrq04TQbAwq1x2XxGhClkEeFWY73pZFTeoGUlzBu0YYSqAVepzHyiz9L5QPM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afthw3r7wQz1eaEBuhnKterU-uBSFOR2L5VYkWojIjrZtw&oe=69A96D07"}, {"file_name": "migrated_image.png", "id": "645041882925750", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001705_589001708210750_261996801807089664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jv0oX8RLvukQ7kNvwGxxTYw&_nc_oc=AdkDV1xlutjhB7_FejvYitXDcm8gYuFrR1zFSlcDN0qf7k_ziuWCBZ_Cna3Yfu59XjI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsgAkm1d8jxSafK2PReb2FVGvhEE3Jk5F-k1QIYtMuqjw&oe=69A98103"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlasterCell", "keywords": ["Shooter", "Arcade", "Space"], "long_description": "Arcade VR Shooter: \nFly through the cold reaches of space, with only a space blaster and your ship as company. Destroy asteroids and pirates to gain fuel and keep alive. Innovative shooter control scheme. Fast paced action with tight controls and hectic enemies.\n\nRunning out of Time: \nFlying through space isn't cheap, asteroids contain fuel, blast them to keep going and increase your score.\n\nUnlock Ships: \nThe higher your score, the more you destroy, the closer you get to unlocking new ships, each ship is unique with its own stats and behavior.\n\nArcade Gameplay: \nTry to beat your best score, your friends best, or the world high score.\n\nEndless Enemies:\nFight endless hordes of varied enemies. Fight to keep moving, keep moving to survive!", "short_description": "Enter the cold reaches of space and fight your way through. Twin stick asteroids with fast paced gameplay. Battle through endless enemies, ever increasing your score. Fight to keep moving, keep moving to fight!"}]}, "developer_name": "Robot Games", "developer_privacy_policy_url": "https://smokinskull.com/BlasterPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Robot Games", "support_website_url": null, "website_url": "https://www.facebook.com/RobotGames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "459645388975291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974556_1771160469679931_8196311039868928000_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iK8uz5JfjV8Q7kNvwH_GNMQ&_nc_oc=AdkYl8F1qJHVqt5TcobflUKPPsUH1XNhMvQUMEiYJotxvUdbX4Yv5yJ_1vGRF7z0Sx4
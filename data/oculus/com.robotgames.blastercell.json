"}, {"file_name": "migrated_image.png", "id": "2865198826898616", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001705_589001708210750_261996801807089664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OC54pUkM3L8Q7kNvwH8Z-q3&_nc_oc=Adr5A8rM4uMspWhRFsDWA-WZEi7KGUIGFl0Ozh0Mhofe1b0d5U9yg6sgxUL7_AClWdM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUmpjDIdahQdkFexGHHKkmenauOSnlLxcpLkiBEGxCig&oe=6A7DC283"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/R8So2G", "id": "418885318856513", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974843_418885322189846_6044992514354577408_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jZVxfbZkgcQ7kNvwGwDrEt&_nc_oc=Adok8PFjUj93UcgUuU94ZpfNlGiDjF63sa5QEjDTPENsA045vd9OzhZRObKGgLBOBys&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEPjmBB6UBFUW_7EwBOq8_uRl8tZwf3KUmUw4TN7aQ9g&oe=6A7DC186"}, "display_name": "BlasterCell", "keywords": ["Shooter", "Arcade", "Space"], "long_description": "Arcade VR Shooter: \nFly through the cold reaches of space, with only a space blaster and your ship as company. Destroy asteroids and pirates to gain fuel and keep alive. Innovative shooter control scheme. Fast paced action with tight controls and hectic enemies.\n\nRunning out of Time: \nFlying through space isn't cheap, asteroids contain fuel, blast them to keep going and increase your score.\n\nUnlock Ships: \nThe higher your score, the more you destroy, the closer you get to unlocking new ships, each ship is unique with its own stats and behavior.\n\nArcade Gameplay: \nTry to beat your best score, your friends best, or the world high score.\n\nEndless Enemies:\nFight endless hordes of varied enemies. Fight to keep moving, keep moving to survive!", "short_description": "Enter the cold reaches of space and fight your way through. Twin stick asteroids with fast paced gameplay. Battle through endless enemies, ever increasing your score. Fight to keep moving, keep moving to fight!"}]}, "developer_name": "Robot Games", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Robot Games", "support_website_url": null, "website_url": "https://www.facebook.com/RobotGames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641753007142535"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "377490042844837"}, {"status": "PUBLISHED", "id": "1209470929226839"}, {"status": "PUBLISHED", "id": "701335986964141"}, {"status": "PUBLISHED", "id": "2150768651647492"}, {"status": "PUBLISHED", "id": "414129222651926"}, {"status": "PUBLISHED", "id": "2441888162744939"}]}, "baseline_offer": {"id": "2150768651647492"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1555002000, "status": "PUBLISHED", "id": "377490042844837"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2463993710331266", "version": "1.0.49"}, "id": "1997260537056332", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2351348738262431", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2463993710331266"}, "release_status": "RELEASED"}, "binary_release_channels": {"n
25/38974757_243546163217467_2911580638018535424_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLH99JUwxosQ7kNvwG2zFXF&_nc_oc=AdlTTRoV0Ecm1Ov0Y28zJbIqoFbh11J_EVoIZzyAA0KNMTCJjonXi9S-7Ou_1cCYrMU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwo-77FCnGAmIsPe-RX6D-wrPBl0KuNVp2d_7vkfFP2nA&oe=69B2B61F"}, {"file_name": "migrated_image.png", "id": "1096513074029578", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974886_241503820116265_6764154942342037504_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggHIBUTkBfUQ7kNvwHWyh1q&_nc_oc=AdkcK-5ZMVSX0qIYFte5z2zDKmUW7cz8WreAX__lCAUa-VXOg6gKSi9dSAXONt5dFGk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwYDUz_FjhNen_d_jXJfDcyh_oVNqwqceJek1FeMrIT7w&oe=69B2C93E"}, {"file_name": "migrated_image.png", "id": "215405842871822", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974768_2244345925784146_3794152170593452032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9yIpWbA3YAQ7kNvwGQGig_&_nc_oc=AdmWmD13d-K0lw5Xt-oTDq0PJwe8D_ZbbyFRyrtumeLTVji8hIOVr6NAnXfxCH7J3BM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyciVIcJvBGCwe3algfhBpRCv3ODe64dGR3YHkzR9nEQQ&oe=69B2A787"}, {"file_name": "migrated_image.png", "id": "645041882925750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001705_589001708210750_261996801807089664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_PqV6bt12MQ7kNvwE-3q-a&_nc_oc=Adn-C-TBq_qAiEgdyVK4B0Y5le4ub38FcWPsVM_kyMeudxWJAwE83WkAcp-teYANfkc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwoWxW47yDBvj3TKaHfYMNTQQm1aj2FBGxZY5d25d1WpA&oe=69B2BB83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlasterCell", "keywords": ["Shooter", "Arcade", "Space"], "long_description": "Arcade VR Shooter: \nFly through the cold reaches of space, with only a space blaster and your ship as company. Destroy asteroids and pirates to gain fuel and keep alive. Innovative shooter control scheme. Fast paced action with tight controls and hectic enemies.\n\nRunning out of Time: \nFlying through space isn't cheap, asteroids contain fuel, blast them to keep going and increase your score.\n\nUnlock Ships: \nThe higher your score, the more you destroy, the closer you get to unlocking new ships, each ship is unique with its own stats and behavior.\n\nArcade Gameplay: \nTry to beat your best score, your friends best, or the world high score.\n\nEndless Enemies:\nFight endless hordes of varied enemies. Fight to keep moving, keep moving to survive!", "short_description": "Enter the cold reaches of space and fight your way through. Twin stick asteroids with fast paced gameplay. Battle through endless enemies, ever increasing your score. Fight to keep moving, keep moving to fight!"}]}, "developer_name": "Robot Games", "developer_privacy_policy_url": "https://smokinskull.com/BlasterPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Robot Games", "support_website_url": null, "website_url": "https://www.facebook.com/RobotGames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "459645388975291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974556_1771160469679931_8196311039868928000_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyKb7CDUaGwQ7kNvwGxYE6F&_nc_oc=AdmjGEpovdj4wSE770R8a9NNjZ0jPiS3jiCF7Kc9HSb1xan8UmVCRa_-D3shT8faThI
railer": null, "video_trailer_thumbnail": null, "display_name": "BlasterCell", "keywords": ["Shooter", "Arcade", "Space"], "long_description": "Arcade VR Shooter: \nFly through the cold reaches of space, with only a space blaster and your ship as company. Destroy asteroids and pirates to gain fuel and keep alive. Innovative shooter control scheme. Fast paced action with tight controls and hectic enemies.\n\nRunning out of Time: \nFlying through space isn't cheap, asteroids contain fuel, blast them to keep going and increase your score.\n\nUnlock Ships: \nThe higher your score, the more you destroy, the closer you get to unlocking new ships, each ship is unique with its own stats and behavior.\n\nArcade Gameplay: \nTry to beat your best score, your friends best, or the world high score.\n\nEndless Enemies:\nFight endless hordes of varied enemies. Fight to keep moving, keep moving to survive!", "short_description": "Enter the cold reaches of space and fight your way through. Twin stick asteroids with fast paced gameplay. Battle through endless enemies, ever increasing your score. Fight to keep moving, keep moving to fight!"}]}, "developer_name": "Robot Games", "developer_privacy_policy_url": "https://smokinskull.com/BlasterPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Robot Games", "support_website_url": null, "website_url": "https://www.facebook.com/RobotGames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SING
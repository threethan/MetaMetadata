25/38974757_243546163217467_2911580638018535424_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuMhJmX3n9sQ7kNvwGOtdxr&_nc_oc=Adn1IdPqJIBiacmTQrrz_I1vD0MIi0vdWJWGSNTfTPwOY211ukSIem034818clTgyKk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwwPLeQ1VNxHScVZaV1X3SuzQBdOnxoq-Hx_ErNlKqZeA&oe=69B94D9F"}, {"file_name": "migrated_image.png", "id": "1096513074029578", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974886_241503820116265_6764154942342037504_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Me3_9sxU3kQ7kNvwEiYVSk&_nc_oc=Adm5k770dWr5-WrU6oaRfNEUxt3IWnNLn503yQ5-doBRMn6Ox9iJVN8y6ttPcTbzz9o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfznMtNO5-lr55_cEkZUNwMoXTV2d704n6vaEnxR_YcwEQ&oe=69B960BE"}, {"file_name": "migrated_image.png", "id": "215405842871822", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974768_2244345925784146_3794152170593452032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKLfexpXL_sQ7kNvwGEV2B3&_nc_oc=AdltZlaHGL6FXtIkzZi2mJjnhLqPdKCJVwoHMWa9r1BBEDxc4hjeJMj0NDaAVpAufE8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyOFhyxGxR0dw_ueiZqucqBIACEyybK23DQ7nJWOQrfeA&oe=69B93F07"}, {"file_name": "migrated_image.png", "id": "645041882925750", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001705_589001708210750_261996801807089664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbUpzd-V_QQQ7kNvwE4H_aN&_nc_oc=Adki5vn9alh4Mfwt1mx3B8afvPTiqPcosuXxBPyDyFcN1JKJwgdLP_7zObucndBP3To&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwFkr-rCP4LVR2Enw3Bn6JS2JogAkhatkH7AdAH6hjTGg&oe=69B95303"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlasterCell", "keywords": ["Shooter", "Arcade", "Space"], "long_description": "Arcade VR Shooter: \nFly through the cold reaches of space, with only a space blaster and your ship as company. Destroy asteroids and pirates to gain fuel and keep alive. Innovative shooter control scheme. Fast paced action with tight controls and hectic enemies.\n\nRunning out of Time: \nFlying through space isn't cheap, asteroids contain fuel, blast them to keep going and increase your score.\n\nUnlock Ships: \nThe higher your score, the more you destroy, the closer you get to unlocking new ships, each ship is unique with its own stats and behavior.\n\nArcade Gameplay: \nTry to beat your best score, your friends best, or the world high score.\n\nEndless Enemies:\nFight endless hordes of varied enemies. Fight to keep moving, keep moving to survive!", "short_description": "Enter the cold reaches of space and fight your way through. Twin stick asteroids with fast paced gameplay. Battle through endless enemies, ever increasing your score. Fight to keep moving, keep moving to fight!"}]}, "developer_name": "Robot Games", "developer_privacy_policy_url": "https://smokinskull.com/BlasterPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Robot Games", "support_website_url": null, "website_url": "https://www.facebook.com/RobotGames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "459645388975291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974556_1771160469679931_8196311039868928000_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72LfSr2AYXAQ7kNvwHRwiDi&_nc_oc=Adk9ClBu61fsMBzF3fBn4GhepOlIXjHzxOBf2kg8XlD6-s_pLjYibq87rGk4FAqLNfo
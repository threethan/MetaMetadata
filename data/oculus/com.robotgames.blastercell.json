t!"}]}, "developer_name": "Robot Games", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Robot Games", "support_website_url": null, "website_url": "https://www.facebook.com/RobotGames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641753007142535"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "377490042844837"}, {"status": "PUBLISHED", "id": "1209470929226839"}, {"status": "PUBLISHED", "id": "701335986964141"}, {"status": "PUBLISHED", "id": "2150768651647492"}, {"status": "PUBLISHED", "id": "414129222651926"}, {"status": "PUBLISHED", "id": "2441888162744939"}]}, "baseline_offer": {"id": "2150768651647492"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1555002000, "status": "PUBLISHED", "id": "377490042844837"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2463993710331266", "version": "1.0.49"}, "id": "1997260537056332", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2351348738262431", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2463993710331266"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_
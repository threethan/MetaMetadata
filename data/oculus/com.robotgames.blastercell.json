25/38974757_243546163217467_2911580638018535424_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPpivkX8NwcQ7kNvwFl8_vE&_nc_oc=Adl9r09EGl2CcaiEG323VTNLOlGaLG89RMcLVgWIPHsBp0WWBCjcqVUEqnCsVkTiu8g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_1tq8W9KsElHHNjtammIqaFZ2fDxIclzRcz3ZVyDf_A&oe=69AD701F"}, {"file_name": "migrated_image.png", "id": "1096513074029578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974886_241503820116265_6764154942342037504_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zijqtVySQdoQ7kNvwGqW4LY&_nc_oc=Adnwntl2MAIKxcQ4ZmPBzEKkXhT3yn6NWZhaSKnggqrnnmHFQuvDg0x1_ZqJOSK8ZTU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzff8AOsapGNrwL_WIYGr1rHMO0HgIVmGq_HEqqqNvrDQ&oe=69AD833E"}, {"file_name": "migrated_image.png", "id": "215405842871822", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974768_2244345925784146_3794152170593452032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynUGdzeVBmkQ7kNvwFgvyga&_nc_oc=AdnXeJzsazL4xLomqZg4IVBVWXkSISuGWY04Ey_TB3uMgqyDpTCsSon04vnZu7yW4uQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqM0OO-nqjBx-bicZLNa2LX-8UQlwPZfScKaKQ8BFLrA&oe=69AD6187"}, {"file_name": "migrated_image.png", "id": "645041882925750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001705_589001708210750_261996801807089664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqxfxitrgdAQ7kNvwHhJUXK&_nc_oc=Adket8N3yISnsPWMOF3u5WdltHc32S3ZP-2l6TCAByXxa_eqDThO3tNbducw57UX1tU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8E7hMXs2dVrx02ydNOBFIQ83uWjD0LVQX-rL_s1hqMQ&oe=69AD7583"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlasterCell", "keywords": ["Shooter", "Arcade", "Space"], "long_description": "Arcade VR Shooter: \nFly through the cold reaches of space, with only a space blaster and your ship as company. Destroy asteroids and pirates to gain fuel and keep alive. Innovative shooter control scheme. Fast paced action with tight controls and hectic enemies.\n\nRunning out of Time: \nFlying through space isn't cheap, asteroids contain fuel, blast them to keep going and increase your score.\n\nUnlock Ships: \nThe higher your score, the more you destroy, the closer you get to unlocking new ships, each ship is unique with its own stats and behavior.\n\nArcade Gameplay: \nTry to beat your best score, your friends best, or the world high score.\n\nEndless Enemies:\nFight endless hordes of varied enemies. Fight to keep moving, keep moving to survive!", "short_description": "Enter the cold reaches of space and fight your way through. Twin stick asteroids with fast paced gameplay. Battle through endless enemies, ever increasing your score. Fight to keep moving, keep moving to fight!"}]}, "developer_name": "Robot Games", "developer_privacy_policy_url": "https://smokinskull.com/BlasterPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Robot Games", "support_website_url": null, "website_url": "https://www.facebook.com/RobotGames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "459645388975291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974556_1771160469679931_8196311039868928000_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fGVc8YoNa4Q7kNvwHEYkNz&_nc_oc=Adn5-3AclZycSRIZPPuBlGrkPBY_PIQu9auJu7rv4W4EzsSSG9slF1gRYgV7QB2qT94
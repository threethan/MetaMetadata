-6JtAMDSXKhU8Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9q-P4puJOEDLcVqwm5Fn8Ngd7sr_EfX6vE10pwbJjjg&oe=6B0C6A7E"}, {"file_name": "migrated_image.png", "id": "530016644381233", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974768_2244345925784146_3794152170593452032_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8lWnnByjQkQ7kNvwGvtkbP&_nc_oc=Adr7DC0lI4hsdxtBcbBI7-YdH-pivHaJXbWgzrq9qgqzRTNt7rLpsIKiB253W9Gdhvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfnafNIklMRvqWJg1da7-9I8UIvCAvkQJWBau0lexV9A&oe=6B0C8107"}, {"file_name": "migrated_image.png", "id": "2865198826898616", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001705_589001708210750_261996801807089664_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkfvWCh1KsgQ7kNvwHFYIPw&_nc_oc=AdqAS8SjRkgVoEjT6-LJ0sybXgMvU49H4ofcaQOXta2wpA5Yn9Tff3Bp6cKOMOlXj1M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ0kNmIK9899i59kw4cBsxEhHvp1EhMYLCCGLEEfkhItQ&oe=6B0C5CC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/R8So2G", "id": "418885318856513", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974843_418885322189846_6044992514354577408_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcnsJjpVGLwQ7kNvwGsW8UX&_nc_oc=Ado4ioNhbaBMAnDQIczIrCSCXDMQpIgluYWzf08njvSlzLV48Q7jKAAebN1v9Jc-2Ko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQvm0SV7-HkFINPYJUnsh4riJTLeq4VufBoAmjH3qI6PQ&oe=6B0C5BC6"}, "display_name": "BlasterCell", "keywords": ["Shooter", "Arcade", "Space"], "long_description": "Arcade VR Shooter: \nFly through the cold reaches of space, with only a space blaster and your ship as company. Destroy asteroids and pirates to gain fuel and keep alive. Innovative shooter control scheme. Fast paced action with tight controls and hectic enemies.\n\nRunning out of Time: \nFlying through space isn't cheap, asteroids contain fuel, blast them to keep going and increase your score.\n\nUnlock Ships: \nThe higher your score, the more you destroy, the closer you get to unlocking new ships, each ship is unique with its own stats and behavior.\n\nArcade Gameplay: \nTry to beat your best score, your friends best, or the world high score.\n\nEndless Enemies:\nFight endless hordes of varied enemies. Fight to keep moving, keep moving to survive!", "short_description": "Enter the cold reaches of space and fight your way through. Twin stick asteroids with fast paced gameplay. Battle through endless enemies, ever increasing your score. Fight to keep moving, keep moving to fight!"}]}, "developer_name": "Robot Games", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Robot Games", "support_website_url": null, "website_url": "https://www.facebook.com/RobotGames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641753007142535"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "377490042844837"}, {"status": "PUBLISHED", "id": "1209470929226839"}, {"status": "PUBLISHED", "id": "701335986964141"}, {"status": "PUBLISHED", "id": "2150768651647492"}, {"status": "PUBLISHED", "id": "414129222651926"}, {"status": "PUBLISHED", "id": "2441888162744939"}]}, "baseline_offer": {"id": "2150768651647492"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 155500
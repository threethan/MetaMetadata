25/38974757_243546163217467_2911580638018535424_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7S-31PDEWNIQ7kNvwHwoIVT&_nc_oc=Adn7SKKtqMUEAJ-utpLG9_vkKq0SZwzd-R_X_EexFgk8bZ1S1C3hDcVJHaAouqT_5oo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsyc8za38f6vP0S8Lj8H5FSAU-0K2xDG0zFWwfRHe3jRg&oe=69A82A1F"}, {"file_name": "migrated_image.png", "id": "1096513074029578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974886_241503820116265_6764154942342037504_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWs5K96Ei7MQ7kNvwEc_TcK&_nc_oc=AdnDuzKXeHThK8-cC0tuDK3nr43jDXa0kD_CE1xEh2MS1AitpfgadbtFxqXCvK-MQYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv9jRj3kDxivmaI0Ut3bS8XHGkhlDCeOIhEPj-qOUW58A&oe=69A83D3E"}, {"file_name": "migrated_image.png", "id": "215405842871822", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974768_2244345925784146_3794152170593452032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dXhGvgLMJoQ7kNvwHDbYNv&_nc_oc=AdkPW_nnDGAXxg0PmRnjth2bBkouh_Mtu7-2MQONEXZ6Jj6OpOWY3tXiN2y_FiUb1zw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft62HJR-lHThIDg-pDOQ1CbimBYVjb7lxnwWOMx8Gx5jQ&oe=69A81B87"}, {"file_name": "migrated_image.png", "id": "645041882925750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001705_589001708210750_261996801807089664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIGt3YiUee4Q7kNvwExJmWg&_nc_oc=AdmuXhK13NbmOU9XF_k6d6BtnZ0svLNaDvcAwDcAOKWiEM-krfcLNwnhkzxvIBjJG0U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvJHZaNrt1EY1BiQ6Me8vpp77DdH-3zMJdQk08lPdMF1g&oe=69A82F83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlasterCell", "keywords": ["Shooter", "Arcade", "Space"], "long_description": "Arcade VR Shooter: \nFly through the cold reaches of space, with only a space blaster and your ship as company. Destroy asteroids and pirates to gain fuel and keep alive. Innovative shooter control scheme. Fast paced action with tight controls and hectic enemies.\n\nRunning out of Time: \nFlying through space isn't cheap, asteroids contain fuel, blast them to keep going and increase your score.\n\nUnlock Ships: \nThe higher your score, the more you destroy, the closer you get to unlocking new ships, each ship is unique with its own stats and behavior.\n\nArcade Gameplay: \nTry to beat your best score, your friends best, or the world high score.\n\nEndless Enemies:\nFight endless hordes of varied enemies. Fight to keep moving, keep moving to survive!", "short_description": "Enter the cold reaches of space and fight your way through. Twin stick asteroids with fast paced gameplay. Battle through endless enemies, ever increasing your score. Fight to keep moving, keep moving to fight!"}]}, "developer_name": "Robot Games", "developer_privacy_policy_url": "https://smokinskull.com/BlasterPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Robot Games", "support_website_url": null, "website_url": "https://www.facebook.com/RobotGames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "459645388975291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974556_1771160469679931_8196311039868928000_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iK8uz5JfjV8Q7kNvwG2561i&_nc_oc=AdmM1gjLh2sfUbULQtaTwkNcg1YjO4ugvt_ScKh47ghQKEHTVj0zVZNgvwFijAU4W3g
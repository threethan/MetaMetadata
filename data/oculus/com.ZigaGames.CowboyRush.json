trQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPl6xlCZO5MM3aSVymkXPe0iUR6-tBkk1ClhaJGnf1u1Q&oe=6AC12393"}, {"file_name": "9.png", "id": "846947600563910", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572952_846947603897243_633634412581965562_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ga40qEd4VkQ7kNvwGYgHWt&_nc_oc=AdplVvZXM3ghUrEJPvkktZuDbXfCGzpHt9bbdf12Wl-1Ae86JHzep1ejyIbuAEfWrPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWsffc5-M-6WiQAIJlDB4_iaH4ThPK49cWH4geyt6KmQ&oe=6AC10034"}, {"file_name": "6.png", "id": "402166675713116", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570306_402166679046449_6308023324473582089_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkC6Td3Q5CQQ7kNvwGGp17p&_nc_oc=Adoqi1MOHOP0-iCHCrFBANjWkHoZHpYEVxI8uIKPsTXAUdF2368ZX_xfw5IxRWTWhLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDJHVdHWjlZ4-Gdqw8yUiPqWVOazSETgfkpBc2gsgD5A&oe=6AC10EE5"}, {"file_name": "2.png", "id": "2173997889629608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035465_2173997892962941_2809842755162781138_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxXxJnR9XVAQ7kNvwGbAO-U&_nc_oc=AdqvOSkoxXLFvNmj-1p8wztc8L0nVOtMyUyvdJsut4POnW6_4odI9aM9P5zKdjFy7Ms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvJq2uB-SXYRX7zR_yITyK1fky_u00AOMB_rD6oa4ppA&oe=6AC10E3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1038803804266231", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035379_1038803807599564_3055469003084872268_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_B7GNGNCrwQ7kNvwHAq1KH&_nc_oc=AdphodFRD0b483ecyT3fvyNX0hJuhm8H4mN_Kj6POUcBcQ6Jh0I2RRJmkTCAClGLcOg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpq89pp3kVxykOnXKe6978B1RY2czp1ZCWEuvFFtfpPA&oe=6AC12BA2"}, "display_name": "Cowboy Rush", "keywords": ["cowboy", "wild", "west", "gun", "shooter"], "long_description": "Draw your six-shooter with lightning speed, feel the weight of it in your hand, and take aim. The sun beats down, casting long shadows across the wooden boardwalks. Dust swirls as you dodge behind barrels and hitching posts, bullets whizzing past. It\u2019s a showdown where reflexes, accuracy, and nerves of steel determine who walks away\u2014or who\u2019s carried away\u2014in a pine box.\n\nAs a lonely cowboy  clean western towns from outlaws and bandits, beat the big boss!\n\nGuns   : \ud83d\udd2b\nRevolver, shotgun, tommy and grenade\n\nLevels :\ud83c\udf35\n10 unique realistic western town\n\n Boss   : \ud83e\udd20\n 5 different bosses  ", "short_description": " In \u201cCowboy Rush,\u201d players slip on their virtual reality headsets and find themselves in the heart of the Wild West. Imagine standing in a sun-baked, tumbleweed-strewn town square, the creaking saloon doors behind you. The air is thick with tension as you face off against rival gunslingers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9941476492538403"}, "review_messages": []}]}, "cover_square_image"
.com/v/t64.5771-25/75348045_2559491240902031_455592572459601132_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-8hZvNkgRIQ7kNvwFCSliY&_nc_oc=AdoApkoUkRPuMgK8H0NmyjJaVAoK5yOhXRck0jUrP-_UcN31FisXZ4xCXBfEawzB4eI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkIN26Faf72FvxPJ4MKxcWsaAJLhEkoP3ILWhyfOax0g&oe=6B09A613"}, {"file_name": "9.png", "id": "846947600563910", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572952_846947603897243_633634412581965562_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxyQcsSwXVQQ7kNvwEA8ANR&_nc_oc=AdokGh_534QeB8eKQB5HEP24VqiHPVoelSoRgREVbSilrxFeHNmazJaJCRK08WVU_0M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEvDJXuSiQW4N8LXg_dQASvy-vv_sH-FUsF_ESbKkcAw&oe=6B09BAF4"}, {"file_name": "6.png", "id": "402166675713116", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57570306_402166679046449_6308023324473582089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkymInax0uEQ7kNvwGK6yWv&_nc_oc=AdrrieACCDM8BHDCkrdwpEvdmDERT9UM8WEON2g2hq_uXWUA_OOI7HRpYvcI7Zz4YmU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgG9lHmJ7l4JyiAA2idenhSMpkflghzBcX5S1av5AFIg&oe=6B09C9A5"}, {"file_name": "2.png", "id": "2173997889629608", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035465_2173997892962941_2809842755162781138_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHElO38Hg_sQ7kNvwEDTf2x&_nc_oc=AdqL6Vd-HFMJkKu6g3DRxOSh1QrtMCY0OH603le-4YYU5hSVUgAb0k2a6CrUqt72zIY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjllpea1s03M4MDcXtITfT4GNzRvj7RMksOndkRlvfSw&oe=6B09C8FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1038803804266231", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035379_1038803807599564_3055469003084872268_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7JGvmwhi0MQ7kNvwE5uxKP&_nc_oc=AdpHAbUv3AXosqi5hPBWyIEhrUOtbHXq9Jnq_gvcWHocLFMGF0eygD74OBhh1MQW_GI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTITx9TAD3CTq0AZ-Sokh1I0YLhKmNWgnRQ3ngJ-bmgJw&oe=6B09AE22"}, "display_name": "Cowboy Rush", "keywords": ["cowboy", "wild", "west", "gun", "shooter"], "long_description": "Draw your six-shooter with lightning speed, feel the weight of it in your hand, and take aim. The sun beats down, casting long shadows across the wooden boardwalks. Dust swirls as you dodge behind barrels and hitching posts, bullets whizzing past. It\u2019s a showdown where reflexes, accuracy, and nerves of steel determine who walks away\u2014or who\u2019s carried away\u2014in a pine box.\n\nAs a lonely cowboy  clean western towns from outlaws and bandits, beat the big boss!\n\nGuns   : \ud83d\udd2b\nRevolver, shotgun, tommy and grenade\n\nLevels :\ud83c\udf35\n10 unique realistic western town\n\n Boss   : \ud83e\udd20\n 5 different bosses  ", "short_description": " In \u201cCowboy Rush,\u201d players slip on their virtual reality headsets and find themselves in the heart of the Wild West. Imagine standing in a sun-baked, tumbleweed-strewn town square, the creaking saloon doors behind you. The air is thick with tension as you face off against rival gunslingers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
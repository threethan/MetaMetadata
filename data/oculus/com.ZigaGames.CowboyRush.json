cv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xqFOJSOawyIqWV2nKoH33T1XOmsEQGFt2e984FyFzIQ&oe=6A380793"}, {"file_name": "9.png", "id": "846947600563910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572952_846947603897243_633634412581965562_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBanLODIiu8Q7kNvwGb0MC6&_nc_oc=AdritawgUSYVbQMc12esG4c8lyxMGnsxfasq2kL9MC0Ge1mq0tVmiIzuDEgyJq-nwCc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TZWnnZyvT6vvjAV424Wtc2FKvwn9nt6llPQksXuobZw&oe=6A37E434"}, {"file_name": "6.png", "id": "402166675713116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570306_402166679046449_6308023324473582089_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06vQqFATCX8Q7kNvwFcnQJO&_nc_oc=AdqsW2CRhQdV-vP_wkJxKQRQV9uOr0g1RMinoHbQ5C0Kv28cMZW696XkjH26mt2qFFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_TRKMuCkBfxVDOLw2tigPXjAQsuITPYSOtavO8LwAcg&oe=6A37F2E5"}, {"file_name": "2.png", "id": "2173997889629608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035465_2173997892962941_2809842755162781138_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyLl0sTv1E8Q7kNvwH1Mhen&_nc_oc=AdqHWMqRuWUg2emmyQ7xFMFgTRzMAQWXIhiTxqfSEwHtmqebe_KrXZfkD0o-2Htb9S0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7DZ5x-U65P-hA1351gfpFzOFa1nf2A7WVUcfWQ8QZ-w&oe=6A37F23F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1038803804266231", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035379_1038803807599564_3055469003084872268_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wo3GeqgrSLQQ7kNvwEfh1JK&_nc_oc=Adq63Ws0dVxJRhceZLoDiCdWJR-OxWZbxcrre4rCytGOsvQTwVEwxK138MzeEKT4pDo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DZWDFlPw5BFWZsoZO4UBeY1UEx_4IerNLc_WfzFtG2w&oe=6A380FA2"}, "display_name": "Cowboy Rush", "keywords": ["cowboy", "wild", "west", "gun", "shooter"], "long_description": "Draw your six-shooter with lightning speed, feel the weight of it in your hand, and take aim. The sun beats down, casting long shadows across the wooden boardwalks. Dust swirls as you dodge behind barrels and hitching posts, bullets whizzing past. It\u2019s a showdown where reflexes, accuracy, and nerves of steel determine who walks away\u2014or who\u2019s carried away\u2014in a pine box.\n\nAs a lonely cowboy  clean western towns from outlaws and bandits, beat the big boss!\n\nGuns   : \ud83d\udd2b\nRevolver, shotgun, tommy and grenade\n\nLevels :\ud83c\udf35\n10 unique realistic western town\n\n Boss   : \ud83e\udd20\n 5 different bosses  ", "short_description": " In \u201cCowboy Rush,\u201d players slip on their virtual reality headsets and find themselves in the heart of the Wild West. Imagine standing in a sun-baked, tumbleweed-strewn town square, the creaking saloon doors behind you. The air is thick with tension as you face off against rival gunslingers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9941476492538403"}, "review_messages": []}]}, "cover_square_image"
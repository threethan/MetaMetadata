.com/v/t64.5771-25/75348045_2559491240902031_455592572459601132_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-8hZvNkgRIQ7kNvwE7BIJc&_nc_oc=AdqLrXPvBkR5jyZkAbNounHEERzntA0mTRku10PzcMP3Dd1xRQVkcpR_F7tiimQl7KI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSshoqn6-sii4b6iejxB8556-E0VmvzL1OBiiMXLsmpKQ&oe=6B085493"}, {"file_name": "9.png", "id": "846947600563910", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572952_846947603897243_633634412581965562_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfa1rEBy8fsQ7kNvwE_h7OB&_nc_oc=AdqsjzMzVB3-MGcQYHAaGVe3dH7NPhka_9HH1wkhBZsmC--GYgU1_2nV5QM-KKj9lZI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9aJD5Ht7eIgn8QOE21KexQRQ0bHc9WLxHmsacyhqLvg&oe=6B086974"}, {"file_name": "6.png", "id": "402166675713116", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57570306_402166679046449_6308023324473582089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFCaNX87PlMQ7kNvwF9zJCP&_nc_oc=AdrG-xpryOd_fnG1noglvs8ba2_sRkDLu_gQE1pAobDKJ0HdRHiLnyJzrCFYCzToGc0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb5B2j1XW8bfgpOFrYXCoSO9IwPgDEjsP1zsgYoUuWTg&oe=6B083FE5"}, {"file_name": "2.png", "id": "2173997889629608", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035465_2173997892962941_2809842755162781138_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1zIhu3j9aYQ7kNvwFdSS6z&_nc_oc=AdrNygf_pZ4fEAYpzYEdcOrNHSI4p7vqbIUFIKxE7KaeEJ2l5q1xxBMjAMNIE92hNmA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIHSaFAX_ZiZj88LtvVm6UKuXR9sXSN1ppjWqGQWZLfw&oe=6B083F3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1038803804266231", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035379_1038803807599564_3055469003084872268_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7JGvmwhi0MQ7kNvwEedo9B&_nc_oc=AdrT-EarZHHnA_d069ZHu2wMhoaFITNGc3QNr8zD4doQO7tZ-I2N6nWu2ZWMI5h3htA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl13mIKxUXMq5_OCFXuUxxQqD1Gnge_zV7ByyHg-H5ow&oe=6B085CA2"}, "display_name": "Cowboy Rush", "keywords": ["cowboy", "wild", "west", "gun", "shooter"], "long_description": "Draw your six-shooter with lightning speed, feel the weight of it in your hand, and take aim. The sun beats down, casting long shadows across the wooden boardwalks. Dust swirls as you dodge behind barrels and hitching posts, bullets whizzing past. It\u2019s a showdown where reflexes, accuracy, and nerves of steel determine who walks away\u2014or who\u2019s carried away\u2014in a pine box.\n\nAs a lonely cowboy  clean western towns from outlaws and bandits, beat the big boss!\n\nGuns   : \ud83d\udd2b\nRevolver, shotgun, tommy and grenade\n\nLevels :\ud83c\udf35\n10 unique realistic western town\n\n Boss   : \ud83e\udd20\n 5 different bosses  ", "short_description": " In \u201cCowboy Rush,\u201d players slip on their virtual reality headsets and find themselves in the heart of the Wild West. Imagine standing in a sun-baked, tumbleweed-strewn town square, the creaking saloon doors behind you. The air is thick with tension as you face off against rival gunslingers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
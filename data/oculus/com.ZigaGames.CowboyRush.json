.com/v/t64.5771-25/75348045_2559491240902031_455592572459601132_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMYcyrTwOaMQ7kNvwHskgyD&_nc_oc=AdoFGxivHkv1fFtFWBFjkwI30OlzpI5Hp1xljcKDSwbH4hIkGOkYdqIAnJGnECfFWU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX5Dg8_l4hKHzu5iA_lyffHL0F7pTC6kdkwJwl_MHrJ2w&oe=6B0EEC13"}, {"file_name": "9.png", "id": "846947600563910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572952_846947603897243_633634412581965562_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_jX7JexBtAQ7kNvwH5dojc&_nc_oc=AdryTD7OY9Tq0Jhx2bKaYFmtLimYJuX_ZSAOR4pVL1ZLN3ZiqdKiUUEtzXQ3D0SYQBI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWlef-uJzcUSGSEvoVnygLoQPP2bH44jXO3aXWDg1UkOw&oe=6B0F00F4"}, {"file_name": "6.png", "id": "402166675713116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570306_402166679046449_6308023324473582089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L34B8QNpjFEQ7kNvwFL6tck&_nc_oc=Adp3DlXNBbMHLWrjsK5pVYdFBLNpy6048UHh1kuNig9m5aMVGw7_lFrZVC8LuwIuQPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUnHH7HXG01kXptu77efWccSEx9NsYdJZdtWnRFqyBBBQ&oe=6B0F0FA5"}, {"file_name": "2.png", "id": "2173997889629608", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035465_2173997892962941_2809842755162781138_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOLqFoH085sQ7kNvwEiatzV&_nc_oc=Ado-GXaP5e2gn_vJSWm4Eld38Zmh3f5e-5C_rlC7_lA7mPgvkN6d5zxRU93672gEq4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWu4d-9Od8q2FMEy4BUAyUPiDgqrV97WqKPAdv-Kgl_BQ&oe=6B0F0EFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1038803804266231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035379_1038803807599564_3055469003084872268_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQam_mp04VcQ7kNvwF6R_w3&_nc_oc=AdpHlhekXd6cHVtBItiweBYtM5QlYFtUclJZaXrsitK3KulHkHwgqUqxEdNoRLr0KsA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUrDyWRcCsaFTJsnjH8bEJufnnhaFD3nPZQIO0gZSfzPw&oe=6B0EF422"}, "display_name": "Cowboy Rush", "keywords": ["cowboy", "wild", "west", "gun", "shooter"], "long_description": "Draw your six-shooter with lightning speed, feel the weight of it in your hand, and take aim. The sun beats down, casting long shadows across the wooden boardwalks. Dust swirls as you dodge behind barrels and hitching posts, bullets whizzing past. It\u2019s a showdown where reflexes, accuracy, and nerves of steel determine who walks away\u2014or who\u2019s carried away\u2014in a pine box.\n\nAs a lonely cowboy  clean western towns from outlaws and bandits, beat the big boss!\n\nGuns   : \ud83d\udd2b\nRevolver, shotgun, tommy and grenade\n\nLevels :\ud83c\udf35\n10 unique realistic western town\n\n Boss   : \ud83e\udd20\n 5 different bosses  ", "short_description": " In \u201cCowboy Rush,\u201d players slip on their virtual reality headsets and find themselves in the heart of the Wild West. Imagine standing in a sun-baked, tumbleweed-strewn town square, the creaking saloon doors behind you. The air is thick with tension as you face off against rival gunslingers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
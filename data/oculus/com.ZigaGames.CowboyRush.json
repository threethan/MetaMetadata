hog&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_1Oq0qnyQyjwI1TcdihbxzgRvj3d-lo51UEOI4glycw&oe=6A5B67D3"}, {"file_name": "9.png", "id": "846947600563910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572952_846947603897243_633634412581965562_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCkEd1asgNEQ7kNvwF3h0NZ&_nc_oc=AdpVKTIn6Kn8LB8WWGa8xHlOBSCsOeP1qSNLNfNzR5Awu5d08rFIptCXmGiV0pxkNnM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-pjnZ_kp7aQY6a_a-jWlyTzm9awO6z1yUWKTyPwWJdQ&oe=6A5B7CB4"}, {"file_name": "6.png", "id": "402166675713116", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570306_402166679046449_6308023324473582089_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsLRFetUoa4Q7kNvwFc9Tu0&_nc_oc=AdoBsgGTeLOoMQqiMoHyXXwfLXRPVTh7o_7bWMqlpE4J6LJJKJuIAxMZY0qNzAzdDFI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfQgEqOAGHfOr0UPURzyVvf36_KznSHHttkV_Pywy6XQ&oe=6A5B8B65"}, {"file_name": "2.png", "id": "2173997889629608", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035465_2173997892962941_2809842755162781138_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUCq8j_8LK8Q7kNvwEjDUT0&_nc_oc=Adr08jIOcGKnGg7WWabYFYg2k9c3uwnd5UhWN2WCI2laU__wZpROOsSj-6aN0056Os8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCN4TBP1BEiMEc8utnBLXkGqKDhzRzbwPeojASJESeJeg&oe=6A5B8ABF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1038803804266231", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035379_1038803807599564_3055469003084872268_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeUM2cSAPj8Q7kNvwEn2lmx&_nc_oc=AdqpNbjzjBhYfUma-wDi6zpIRumW2SL4CbZy7FjefJjyH5Xei-abSFQVdw5O36cymp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4LRQu-ez1rNgCdo6CNBeZc0uY9b9CWeQ0B8_fJ12HDQ&oe=6A5B6FE2"}, "display_name": "Cowboy Rush", "keywords": ["cowboy", "wild", "west", "gun", "shooter"], "long_description": "Draw your six-shooter with lightning speed, feel the weight of it in your hand, and take aim. The sun beats down, casting long shadows across the wooden boardwalks. Dust swirls as you dodge behind barrels and hitching posts, bullets whizzing past. It\u2019s a showdown where reflexes, accuracy, and nerves of steel determine who walks away\u2014or who\u2019s carried away\u2014in a pine box.\n\nAs a lonely cowboy  clean western towns from outlaws and bandits, beat the big boss!\n\nGuns   : \ud83d\udd2b\nRevolver, shotgun, tommy and grenade\n\nLevels :\ud83c\udf35\n10 unique realistic western town\n\n Boss   : \ud83e\udd20\n 5 different bosses  ", "short_description": " In \u201cCowboy Rush,\u201d players slip on their virtual reality headsets and find themselves in the heart of the Wild West. Imagine standing in a sun-baked, tumbleweed-strewn town square, the creaking saloon doors behind you. The air is thick with tension as you face off against rival gunslingers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9941476492538403"}, "review_messages": []}]}, "cover_square_image"
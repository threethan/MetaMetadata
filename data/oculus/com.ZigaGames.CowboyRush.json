.com/v/t64.5771-25/75348045_2559491240902031_455592572459601132_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIJyoXkNQ1QQ7kNvwFe6N1H&_nc_oc=AdpQPYKu5KmQvDLn5CwWnrKmiHD5rgnteAfAlj3cO2UrmKqSEcmHxyzz0vYBxzOHnd0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5RwENUJFneL9uVtceyPydM26JGlgUjfEsdlF-I2Vn7Q&oe=6B046013"}, {"file_name": "9.png", "id": "846947600563910", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572952_846947603897243_633634412581965562_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSogUZTUSj0Q7kNvwHtznMU&_nc_oc=AdrInhNhaTbGxJ709Bik56xe54wJ97DvW2h0HC7_mKvc6Kx0IencxtdFhFqdvVU5g4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf5y2tKNvwlQI7goqxLmEiy413UmO3y2PtwAJc4fsO6A&oe=6B0474F4"}, {"file_name": "6.png", "id": "402166675713116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570306_402166679046449_6308023324473582089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0okAxR-0lYQ7kNvwECSEwx&_nc_oc=Adr8IJw9QzbvICac0jmtSOSZSGbYaCELrbTYotJXPjSECtMMxOkR16URJKzo4WqtsXI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd3tp9feD6c0o8-dBYS9XB3Oq50mT8SLu4ngrCVoEt9g&oe=6B0483A5"}, {"file_name": "2.png", "id": "2173997889629608", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035465_2173997892962941_2809842755162781138_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhK5hW9fHaYQ7kNvwH5tQoy&_nc_oc=AdpGA6d_NtOg1BUMFE9p0D1H4kAJVaFca1IFtyQKz9x0KLfe_JcaEWqJMJY09f6Djpo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUxklNvz3Yw30WTK5axynRLrfeH7aFhxYkWL9_HV9f3Q&oe=6B0482FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1038803804266231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035379_1038803807599564_3055469003084872268_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zH3senRIQYQ7kNvwHP9Pz9&_nc_oc=AdomhuyyMaEFNnea1BCPAZW1TUl53i5mils-QOgs-_SUhTx9KHptiERPJM4X6UaHLRs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvefiEfFH2szWi6-9fLdUCfV1kGt2zCiVWU_OVMzoMVQ&oe=6B046822"}, "display_name": "Cowboy Rush", "keywords": ["cowboy", "wild", "west", "gun", "shooter"], "long_description": "Draw your six-shooter with lightning speed, feel the weight of it in your hand, and take aim. The sun beats down, casting long shadows across the wooden boardwalks. Dust swirls as you dodge behind barrels and hitching posts, bullets whizzing past. It\u2019s a showdown where reflexes, accuracy, and nerves of steel determine who walks away\u2014or who\u2019s carried away\u2014in a pine box.\n\nAs a lonely cowboy  clean western towns from outlaws and bandits, beat the big boss!\n\nGuns   : \ud83d\udd2b\nRevolver, shotgun, tommy and grenade\n\nLevels :\ud83c\udf35\n10 unique realistic western town\n\n Boss   : \ud83e\udd20\n 5 different bosses  ", "short_description": " In \u201cCowboy Rush,\u201d players slip on their virtual reality headsets and find themselves in the heart of the Wild West. Imagine standing in a sun-baked, tumbleweed-strewn town square, the creaking saloon doors behind you. The air is thick with tension as you face off against rival gunslingers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
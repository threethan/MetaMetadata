.com/v/t64.5771-25/75348045_2559491240902031_455592572459601132_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hKACU4Gja4Q7kNvwFqCKBL&_nc_oc=AdotINA9vPmHXdaGVoj5P0XVHb5DZJZmyTwd8P2pzM6uM0DPpzmsaUAy6S_jiQLBEVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRMNjcPEM3ef7jByQ1jcKBdkdir_RGKt0WGVCMVd55kzg&oe=6B0C8153"}, {"file_name": "9.png", "id": "846947600563910", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572952_846947603897243_633634412581965562_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxyQcsSwXVQQ7kNvwEL6MJT&_nc_oc=Adp5i8TDg6I94kSGXFvYW4aDYj1qcvyFvJxJdhvKBnEb6GIrQ9jmhyUvmeauFwf7OKE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHZi5Z32cV5DNAV7waqRZxGEpdv9bmAi7ZF4XhC4j30Q&oe=6B0C5DF4"}, {"file_name": "6.png", "id": "402166675713116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570306_402166679046449_6308023324473582089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkymInax0uEQ7kNvwGlFlie&_nc_oc=AdpJV6e1LMKIqbQ1sQK5MOwfm7Hp2rewEMUsr31EoGMhW_VH8NGdTq-kH5WXmCpL02A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMZtFNi8CoEeg2Z6sz-cQh17hINWJfqpUgUjexiwEv3w&oe=6B0C6CA5"}, {"file_name": "2.png", "id": "2173997889629608", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035465_2173997892962941_2809842755162781138_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHElO38Hg_sQ7kNvwHId_qP&_nc_oc=AdrFxsxG_45ZsnQYgduCe9vvv8hgnX6v_UU1KfNslwR386maqB_J9JfwWEu2042p62s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT2h9Vkli9-VHWjwLx22vhhvxkYb31Awf3xP_jEUplB8A&oe=6B0C6BFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1038803804266231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035379_1038803807599564_3055469003084872268_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmYMlRSi2VQQ7kNvwEvtVeH&_nc_oc=AdpCBV9oxwLdc7faQWJZeDALMtiZQD_IpfNhQVazv7FU913gi2W3J0hVSf-n5gX--xc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQKh3O32wZFByPGEDJ0NxbZHwjgjULL4Qva4R4G5NZGMA&oe=6B0C5122"}, "display_name": "Cowboy Rush", "keywords": ["cowboy", "wild", "west", "gun", "shooter"], "long_description": "Draw your six-shooter with lightning speed, feel the weight of it in your hand, and take aim. The sun beats down, casting long shadows across the wooden boardwalks. Dust swirls as you dodge behind barrels and hitching posts, bullets whizzing past. It\u2019s a showdown where reflexes, accuracy, and nerves of steel determine who walks away\u2014or who\u2019s carried away\u2014in a pine box.\n\nAs a lonely cowboy  clean western towns from outlaws and bandits, beat the big boss!\n\nGuns   : \ud83d\udd2b\nRevolver, shotgun, tommy and grenade\n\nLevels :\ud83c\udf35\n10 unique realistic western town\n\n Boss   : \ud83e\udd20\n 5 different bosses  ", "short_description": " In \u201cCowboy Rush,\u201d players slip on their virtual reality headsets and find themselves in the heart of the Wild West. Imagine standing in a sun-baked, tumbleweed-strewn town square, the creaking saloon doors behind you. The air is thick with tension as you face off against rival gunslingers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
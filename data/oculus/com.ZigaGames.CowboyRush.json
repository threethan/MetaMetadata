.com/v/t64.5771-25/75348045_2559491240902031_455592572459601132_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIJyoXkNQ1QQ7kNvwEzuzR7&_nc_oc=AdoteQq5rItGfemRD0X7hW3w_jdeP2J_ootubTaLns9A5LuPS4ySIksheSCqVyfH3UE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGLArR2rH9OvvsrJO2bIi9lKAoz8R0Nfo02mjQsm_diw&oe=6B05B193"}, {"file_name": "9.png", "id": "846947600563910", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572952_846947603897243_633634412581965562_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfa1rEBy8fsQ7kNvwE6wK0p&_nc_oc=Adqsf8LiZOYfxgMkFBByupzR1EURb5DeneT_sB-nenit1cV0WD-1pOu_0W8beFB4H_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRULKsmrvkT7pKnsRLxG-in6YKSfO0Vxi88fhpEXiYkw&oe=6B05C674"}, {"file_name": "6.png", "id": "402166675713116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570306_402166679046449_6308023324473582089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFCaNX87PlMQ7kNvwHjC17p&_nc_oc=AdpeIAg8hc_rBICILLffo5gb1iGciIkNMAXQdKGYz0aR_3I78w7xST9rrvfAiiYIuJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpHR9X5afK2dVxoqB0w8Zks7A41dwsV5HqizysFzrcNA&oe=6B05D525"}, {"file_name": "2.png", "id": "2173997889629608", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035465_2173997892962941_2809842755162781138_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1zIhu3j9aYQ7kNvwE-ATyJ&_nc_oc=AdpjsIc1m1P7XZDYopoXrUHE3Ij_BfsoKSUhY1q2_Vw3Q4ToHbfADlbbcq5Y9gAOSoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgCKBhTJUpdkVXPGwjMHwTjUBQHWo4jvRJ2SfcyOEpOw&oe=6B05D47F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1038803804266231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035379_1038803807599564_3055469003084872268_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zH3senRIQYQ7kNvwGpN9lO&_nc_oc=Adob17PNK8rh4sNDZKy4_WK9JYy6ST7UKKvAgaqW9qB_HFSzxvrwndKO2TcajmIgVFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ2yT4JLzwzr1j9j4ZJ70__2nH3NULU1MeY97VrkKQfg&oe=6B05B9A2"}, "display_name": "Cowboy Rush", "keywords": ["cowboy", "wild", "west", "gun", "shooter"], "long_description": "Draw your six-shooter with lightning speed, feel the weight of it in your hand, and take aim. The sun beats down, casting long shadows across the wooden boardwalks. Dust swirls as you dodge behind barrels and hitching posts, bullets whizzing past. It\u2019s a showdown where reflexes, accuracy, and nerves of steel determine who walks away\u2014or who\u2019s carried away\u2014in a pine box.\n\nAs a lonely cowboy  clean western towns from outlaws and bandits, beat the big boss!\n\nGuns   : \ud83d\udd2b\nRevolver, shotgun, tommy and grenade\n\nLevels :\ud83c\udf35\n10 unique realistic western town\n\n Boss   : \ud83e\udd20\n 5 different bosses  ", "short_description": " In \u201cCowboy Rush,\u201d players slip on their virtual reality headsets and find themselves in the heart of the Wild West. Imagine standing in a sun-baked, tumbleweed-strewn town square, the creaking saloon doors behind you. The air is thick with tension as you face off against rival gunslingers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
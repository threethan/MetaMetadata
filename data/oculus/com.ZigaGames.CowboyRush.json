.com/v/t64.5771-25/75348045_2559491240902031_455592572459601132_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQDPTldgNTcQ7kNvwERfepL&_nc_oc=AdpWjuNdN8Zca1QSqut2AMYLp9o6NffsCnQha5LNVOJ-e824EjBtvzJ4eRaITm81Mg4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgBf6D331L8fmqPZFOYEq_KUmC1TKvn7_4PZQnl6UXzw&oe=6AFB2593"}, {"file_name": "9.png", "id": "846947600563910", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572952_846947603897243_633634412581965562_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK36vvIJyMQQ7kNvwF7rzk2&_nc_oc=AdpoNu1qu7KKbYpyEVfJkxsn7t4ZCZwKRMETuOl6bjhQaK5GlI69I7yM9zBqE5MEX0k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZMdSkcnKAqgyaucC3ijKyEBGf8vX5HmWp_u7yq21NSw&oe=6AFB3A74"}, {"file_name": "6.png", "id": "402166675713116", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57570306_402166679046449_6308023324473582089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pcs8xPGRlJ4Q7kNvwGZKvqJ&_nc_oc=AdrMJs3uiy00JkXEnG_S0gWZNYX2cLT4h0U5jEdCuaE7SYrUCGkU92Ox1aWwT_H8XeI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaf2w-oANwyReiynQ2N6gIyEU3fSr9muMOBBvbq08Bkw&oe=6AFB4925"}, {"file_name": "2.png", "id": "2173997889629608", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035465_2173997892962941_2809842755162781138_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMe0jEFg5TUQ7kNvwGh9TFH&_nc_oc=Adpmh_rzJQLrURJ4CsNZP8SSGh_OjM_7wM12gQwwDnkfsplgru3v7qBWUpWwTQgLfHo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSePIzE4cZO9dOLrk7q3gV8TTMdTnYEKHkU832IUTuOpQ&oe=6AFB487F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1038803804266231", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035379_1038803807599564_3055469003084872268_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1r7YgsD1iSoQ7kNvwHIejxQ&_nc_oc=AdrE78T-f4KXylmb4No9gX5qzLO3abcKMj7QMTeSl6HC4dD5yab7H1iv_Af8yQXrRGI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqga9jy-ZMCb_WAXzXeUIMw02cy33KTkaMHSPV2CjlaQ&oe=6AFB2DA2"}, "display_name": "Cowboy Rush", "keywords": ["cowboy", "wild", "west", "gun", "shooter"], "long_description": "Draw your six-shooter with lightning speed, feel the weight of it in your hand, and take aim. The sun beats down, casting long shadows across the wooden boardwalks. Dust swirls as you dodge behind barrels and hitching posts, bullets whizzing past. It\u2019s a showdown where reflexes, accuracy, and nerves of steel determine who walks away\u2014or who\u2019s carried away\u2014in a pine box.\n\nAs a lonely cowboy  clean western towns from outlaws and bandits, beat the big boss!\n\nGuns   : \ud83d\udd2b\nRevolver, shotgun, tommy and grenade\n\nLevels :\ud83c\udf35\n10 unique realistic western town\n\n Boss   : \ud83e\udd20\n 5 different bosses  ", "short_description": " In \u201cCowboy Rush,\u201d players slip on their virtual reality headsets and find themselves in the heart of the Wild West. Imagine standing in a sun-baked, tumbleweed-strewn town square, the creaking saloon doors behind you. The air is thick with tension as you face off against rival gunslingers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
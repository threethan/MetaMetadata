.com/v/t64.5771-25/75348045_2559491240902031_455592572459601132_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIJyoXkNQ1QQ7kNvwGoP1fE&_nc_oc=Adpi31aJUg1Jll4rvlXtTJytTj2ZBSgXHWQShDc9vdn6kgY0DGpVTFY8W_ZMyxe9pcQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIWlmYohj2U1qa5awEtR3kBXaS1VHOTuKQ-MgbTJ89rA&oe=6B030E93"}, {"file_name": "9.png", "id": "846947600563910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572952_846947603897243_633634412581965562_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSogUZTUSj0Q7kNvwFTkjHL&_nc_oc=AdoeJCNbljxgqCF3wn49qqc_L1UJq8XJNAnQNIr6OiJk_c0ACs4QMx6D_G_xkOwAjYE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXNbECYP6FiMItn1eQ__x83Ux9fgQkIYLHazsKg7iGXQ&oe=6B032374"}, {"file_name": "6.png", "id": "402166675713116", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570306_402166679046449_6308023324473582089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0okAxR-0lYQ7kNvwHW13kw&_nc_oc=AdrvTN8cIOMahHxeZE_3fII4CItv4GXw9gAR1femlt9S8cO4OTY5z9OoKIFgwjSriaw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQej0F83LMsFW9yNbPgFNlXuGJtis4jQS0Y2QDBE9btdw&oe=6B033225"}, {"file_name": "2.png", "id": "2173997889629608", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035465_2173997892962941_2809842755162781138_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhK5hW9fHaYQ7kNvwHh_qzq&_nc_oc=AdqPGvObEFh70wL5xx2trnkLUReQsJ9r7GPTxvQ3b9xfnI77vqe3rzsFleZE59mf1uk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvZIKPPjTDIRsHh5YQbqbHpAcQIlaDDFvhW2DRtddgmA&oe=6B03317F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1038803804266231", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035379_1038803807599564_3055469003084872268_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zH3senRIQYQ7kNvwGzK-tr&_nc_oc=AdoAnYalhXsbmN2PoidFHWiruWDBMuyb2dLkZ5qkuUzI80sU-eu1ggL81aoMoCZbZ2M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtJptOz1cJa9cZ1W76Tz-izouLBOJOzNz3V2t-px-SdQ&oe=6B0316A2"}, "display_name": "Cowboy Rush", "keywords": ["cowboy", "wild", "west", "gun", "shooter"], "long_description": "Draw your six-shooter with lightning speed, feel the weight of it in your hand, and take aim. The sun beats down, casting long shadows across the wooden boardwalks. Dust swirls as you dodge behind barrels and hitching posts, bullets whizzing past. It\u2019s a showdown where reflexes, accuracy, and nerves of steel determine who walks away\u2014or who\u2019s carried away\u2014in a pine box.\n\nAs a lonely cowboy  clean western towns from outlaws and bandits, beat the big boss!\n\nGuns   : \ud83d\udd2b\nRevolver, shotgun, tommy and grenade\n\nLevels :\ud83c\udf35\n10 unique realistic western town\n\n Boss   : \ud83e\udd20\n 5 different bosses  ", "short_description": " In \u201cCowboy Rush,\u201d players slip on their virtual reality headsets and find themselves in the heart of the Wild West. Imagine standing in a sun-baked, tumbleweed-strewn town square, the creaking saloon doors behind you. The air is thick with tension as you face off against rival gunslingers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
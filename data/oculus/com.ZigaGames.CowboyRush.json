.com/v/t64.5771-25/75348045_2559491240902031_455592572459601132_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzVcmJgR71wQ7kNvwEEssHf&_nc_oc=AdpXbTZ85hKeHJHBL6trDwdlGOrsYdCjk0UmS3JW00bagWtnU7mk63Tv7V1G8zKXP_k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWJeoVT8BhCT0SyTg2GI8ZHyKbGhu0puheHMeFQeUgtg&oe=6B006B93"}, {"file_name": "9.png", "id": "846947600563910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572952_846947603897243_633634412581965562_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzwu_3Hi3CoQ7kNvwFCl4Y8&_nc_oc=AdpGxB4P60_mn5wiV8h-apJhghK5cntO4--mV_4SUIaUN-qG9dNOs4gYBIFSeWS65x4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSwLv5dxs4RcNrvx6_YdW0lBbiztMJEHF-SIrH6QSSAA&oe=6B008074"}, {"file_name": "6.png", "id": "402166675713116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570306_402166679046449_6308023324473582089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxgE4KKAYX8Q7kNvwEcR-6T&_nc_oc=Ado105kPsGPixqP04j_zLCh1blQfRCZVSdUGs97tO84yepN88IrC3qzF8xOr3W7Maf8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgvQAZIzPNNMxDdPiG3eE-rCRKiD-6mVEVl5SIxDr6qA&oe=6B0056E5"}, {"file_name": "2.png", "id": "2173997889629608", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035465_2173997892962941_2809842755162781138_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BESr0K6KUcQ7kNvwGVtTMA&_nc_oc=AdrkmSgdoIGQD1brS8PoJvCh_mMFWwFTLnj3v9MOT9m9Ome1Vd-ivUYpdTEnp3IHFCE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzt-UlqajfahaLULs91zbiGeRDBxSwUWhkZfqN4hYoPg&oe=6B00563F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1038803804266231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035379_1038803807599564_3055469003084872268_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NycqtaK68QYQ7kNvwFjiuA9&_nc_oc=AdoUo7owZ5FGw_7o_8uoNKXCb8CMoey477pHwAT5rZWEF1xtAIOywfk2x4IhNcwcgj4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ938OQutZYY4SslQFOZpTUom6GE8nf9enjLXt8hQbSQ&oe=6B0073A2"}, "display_name": "Cowboy Rush", "keywords": ["cowboy", "wild", "west", "gun", "shooter"], "long_description": "Draw your six-shooter with lightning speed, feel the weight of it in your hand, and take aim. The sun beats down, casting long shadows across the wooden boardwalks. Dust swirls as you dodge behind barrels and hitching posts, bullets whizzing past. It\u2019s a showdown where reflexes, accuracy, and nerves of steel determine who walks away\u2014or who\u2019s carried away\u2014in a pine box.\n\nAs a lonely cowboy  clean western towns from outlaws and bandits, beat the big boss!\n\nGuns   : \ud83d\udd2b\nRevolver, shotgun, tommy and grenade\n\nLevels :\ud83c\udf35\n10 unique realistic western town\n\n Boss   : \ud83e\udd20\n 5 different bosses  ", "short_description": " In \u201cCowboy Rush,\u201d players slip on their virtual reality headsets and find themselves in the heart of the Wild West. Imagine standing in a sun-baked, tumbleweed-strewn town square, the creaking saloon doors behind you. The air is thick with tension as you face off against rival gunslingers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
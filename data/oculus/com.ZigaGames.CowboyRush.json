YHA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKpwGgRaysrVK6-Q-vxbhOoo1PLtY0YTkl6L5TWdyhuQ&oe=6A941853"}, {"file_name": "9.png", "id": "846947600563910", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57572952_846947603897243_633634412581965562_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7mW3cBnw4wQ7kNvwEWPXpM&_nc_oc=AdqEe-zFjK_i6VNXUZt99DMWje2-Qg0VUyo2FKuI_fef_iAitGrnv4eM6s6zdP6JpSw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_9jn5-qGFiPGUELmbRA62A8_o7xbwxun_oAoM8Os1Jg&oe=6A942D34"}, {"file_name": "6.png", "id": "402166675713116", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57570306_402166679046449_6308023324473582089_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxlMo1Q70tIQ7kNvwErM27k&_nc_oc=AdpuGZv_wjNoDA16cZ7FCwBoTLfNX1kSyAb4X_BU9KvARREXcTfzYn1PSJue8WL-Y8c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcBSfLWzdibD9Cz9If2Jd15eQhS5GwjOxj3GKuOb4vtw&oe=6A9403A5"}, {"file_name": "2.png", "id": "2173997889629608", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39035465_2173997892962941_2809842755162781138_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZXpv1aHTZcQ7kNvwGYzwwS&_nc_oc=AdrurMityXnC_GcoWM1llKtdg5-3ufStrNwW2GfJPc_7OkLm9XYcBi2nmPrWXCSOtnA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN5ZnOO7iU0A9Ke2c60j0jVNqToi97SF8WvIynu9a1gQ&oe=6A9402FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1038803804266231", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035379_1038803807599564_3055469003084872268_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZVnBKMnmVQQ7kNvwHG4Nou&_nc_oc=AdoU5WNyH8ptOHeirh2YfpKPpXBvzeLKfSS4HJWIVMf45Axh6UQBfrEUZZuuACneoZ0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENvp15DOk12MNFFSGoaUO_snGfUZYZddix2l8TVbJYpA&oe=6A942062"}, "display_name": "Cowboy Rush", "keywords": ["cowboy", "wild", "west", "gun", "shooter"], "long_description": "Draw your six-shooter with lightning speed, feel the weight of it in your hand, and take aim. The sun beats down, casting long shadows across the wooden boardwalks. Dust swirls as you dodge behind barrels and hitching posts, bullets whizzing past. It\u2019s a showdown where reflexes, accuracy, and nerves of steel determine who walks away\u2014or who\u2019s carried away\u2014in a pine box.\n\nAs a lonely cowboy  clean western towns from outlaws and bandits, beat the big boss!\n\nGuns   : \ud83d\udd2b\nRevolver, shotgun, tommy and grenade\n\nLevels :\ud83c\udf35\n10 unique realistic western town\n\n Boss   : \ud83e\udd20\n 5 different bosses  ", "short_description": " In \u201cCowboy Rush,\u201d players slip on their virtual reality headsets and find themselves in the heart of the Wild West. Imagine standing in a sun-baked, tumbleweed-strewn town square, the creaking saloon doors behind you. The air is thick with tension as you face off against rival gunslingers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9941476492538403"}, "review_messages": []}]}, "cover_square_image"
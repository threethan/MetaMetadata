2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLB0fEjyyuDhs67FTm8U3X53GEGDXFl_ickMYtoyVk1WA&oe=6A9ACAC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-02-15 022405.png", "id": "1117343937068465", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391820_1117343940401798_4410121552552447280_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqoiH3mqD6cQ7kNvwEk6iAg&_nc_oc=AdoEPimJo_227OhLUugpLyfg758vFctYV3w40IpuU550MhhjO3tQb8mYh9YIYHAQvVA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAxeL3zuRu7-jjEU6gxf5wJfqsxGtB5G9lKH6PQOEr3Q&oe=6A9ADE80"}, "display_name": "Sword & Shield Factory", "keywords": ["Sword", "Shield", "War", "ArcadeIdle", "WarManager"], "long_description": "Welcome to Sword & Shield Factory, the ultimate arcade idle VR experience where you take control of a medieval weapon workshop! As a master blacksmith, your goal is to forge powerful swords and indestructible shields while expanding your factory to legendary status. Gather rare materials, upgrade your tools, and automate production to increase efficiency. Unlock powerful blueprints and craft unique weapons fit for kings and warriors.\n\nWith immersive VR mechanics, feel the heat of the forge, hammer molten metal, and watch sparks fly as you refine your creations. Manage resources wisely, optimize workflows, and expand your operations to dominate the market. As you progress, face exciting challenges and craft legendary weapons that will shape the fate of the kingdom.\n\nAre you ready to build the greatest weapon factory ever? Step into Sword & Shield Factory and prove your blacksmithing skills today!", "short_description": "Step into Sword & Shield Factory, a thrilling arcade idle game where you run your own medieval weapon workshop! Forge legendary swords, craft unbreakable shields, and expand your factory to become the ultimate blacksmith. Upgrade your tools, automate production, and unlock powerful blueprints. Can you create the finest weapons and armor in the kingdom? Test your skills and build a legendary workshop in this immersive VR experience!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8840551122741282"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1199600779910017"}, {"status": "PUBLISHED", "id": "1669711677389715"}, {"status": "PUBLISHED", "id": "1340656678039556"}, {"status": "PUBLISHED", "id": "1344502063935893"}, {"status": "PUBLISHED", "id": "1074289244625138"}, {"status": "PUBLISHED", "id": "637585522378091"}, {"status": "PUBLISHED", "id": "1003156914615575"}, {"status": "PUBLISHED", "id": "635075859101977"}]}, "baseline_offer": {"id": "1003156914615575"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787079600, "status": "PUBLISHED", "id": "1199600779910017"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8840699466059781", "version": "2"}, "id": "2625074704357928", "c
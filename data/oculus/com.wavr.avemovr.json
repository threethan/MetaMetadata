03414249_1914068616597209088_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNMb_jFwiLAQ7kNvwGiL6Xo&_nc_oc=AdrtGaro1LgBk7Cepc6o4iqCErphMp2oM_RcXI6-1yPWVYJayIkW9wHOlfoHHSyivhY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1AOBK1J--gOKaObZIR773p3L47vkp1Z5GfWfcLIMe35w&oe=69F206C5"}, "display_name": "Avem33", "keywords": ["Flyer", "Arcade", "Moods", "Avem", "WaVR"], "long_description": "Its all about the high score, can you beat it? Follow the trail of the markers as they will give you more points. In the ambient atmosphere beware of hitting the buildings, if you do you race is over. The track will be more difficult the longer you stay alive thus the high score will be hard to beat every race. Don't let the ever shifting ambient and sometimes eerie skies fool you, they are there to distract you from...well....beating the record! Go for it!", "short_description": "Can you beat the highscore? Be sure to pick all the markers, they are valuable in the race for the highest score, but do avoid the buildings!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.wavr.com/", "developer_terms_of_service_url": "http://wavr.com/legal/", "publisher_name": "WaVR", "support_website_url": null, "website_url": "http://www.wavr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "ARCADE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "697028061680434"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1328711873849723"}]}, "baseline_offer": {"id": "1328711873849723"},
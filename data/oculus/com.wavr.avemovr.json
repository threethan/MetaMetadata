": null, "video_trailer_thumbnail": {"file_name": "video_cover_2560x1440.png", "id": "1968059600080916", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162720_1968059603414249_1914068616597209088_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoAtY8wPjH8Q7kNvwHQMyEF&_nc_oc=AdpYcI3oO96RrsQ4HqkyyB1OYvK9YV4P3wxhYRr4yWw7g2XudjWM-dVl0alI2d9VkeQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nrHuli38xvL6Zl9HjKzmhxPEii92VGYPeM9wuPQQcsQ&oe=6A37E645"}, "display_name": "Avem33", "keywords": ["Flyer", "Arcade", "Moods", "Avem", "WaVR"], "long_description": "Its all about the high score, can you beat it? Follow the trail of the markers as they will give you more points. In the ambient atmosphere beware of hitting the buildings, if you do you race is over. The track will be more difficult the longer you stay alive thus the high score will be hard to beat every race. Don't let the ever shifting ambient and sometimes eerie skies fool you, they are there to distract you from...well....beating the record! Go for it!", "short_description": "Can you beat the highscore? Be sure to pick all the markers, they are valuable in the race for the highest score, but do avoid the buildings!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.wavr.com/", "developer_terms_of_service_url": "http://wavr.com/legal/", "publisher_name": "WaVR", "support_website_url": null, "website_url": "http://www.wavr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "ARCADE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_
et the ever shifting ambient and sometimes eerie skies fool you, they are there to distract you from...well....beating the record! Go for it!", "short_description": "Can you beat the highscore? Be sure to pick all the markers, they are valuable in the race for the highest score, but do avoid the buildings!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.wavr.com/", "developer_terms_of_service_url": "http://wavr.com/legal/", "publisher_name": "WaVR", "support_website_url": null, "website_url": "http://www.wavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "634530087877793"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/11162718_770863246424544_7271844729841516544_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3eQlTNd3MEQ7kNvwHGAL5c&_nc_oc=Admk-0W2c95GPP_IZr9HrH2wH4JHswvPQ-RzHaEyaZTTcE0bwWeacw-w2Iwn8m4gHbU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuEhAc4GlZlqqJeG8in9N887DizlYmO2wNd_h6CLoNiag&oe=69A1808E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Avem33", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1496851548, "lastRevision": {"nodes": [{"id": "1398627226878786", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1450613618303175", "is_first_party": false, "enables
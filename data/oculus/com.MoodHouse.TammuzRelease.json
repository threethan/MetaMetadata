ni0LpioVpow0LOYIIfyNT6vWsmmMcM-VUg&oe=6A98536C"}, {"file_name": "Braclet mr sc.png", "id": "1293533988393497", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391852_1293533991726830_1307289834815564185_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bjg9-uW2t_YQ7kNvwFi8oNv&_nc_oc=AdojDvptcv3u6sZo73pKwu34sePZ1A25fY_8uOQyvySft1rcWXoX8_geBRsgl_OBFjM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9Po9eLuV7i4vX7L3e4LPJ8Vo_qO__7Z6wMwjOnpQPqg&oe=6A984E34"}, {"file_name": "hands crate sc.png", "id": "565647525853813", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392005_565647529187146_2459317417968159700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Dw0W2igHLgQ7kNvwGHed1D&_nc_oc=AdpMOWa_AGcbI1f_hgdwy02sLSpF2IZudisVYo0DOVPrs924SlkUibo1lB5aFtMQkoA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdFBEErMNPuOHu051iO32HInBxWf1DBo3A9UR4J1Zt_g&oe=6A98699C"}, {"file_name": "mr tablet sc.png", "id": "577220758670820", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473397201_577220762004153_605906722663877742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfnBGx19-poQ7kNvwHqYzd2&_nc_oc=Adrn1oVLpDgJ4lt6XxUQOf7ObsIXsT2orOQOMOWYQwt0ikJzR-WrJqwMTeRu4d7wrxU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwd9T0_OKx6lKzHtmDH5spDbQa08nG6iczzymgYop_-w&oe=6A98403F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tammuz Bloodand sand narrower.png", "id": "992297489141107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391938_992297492474440_7251832159658048125_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6cx1tjI6P4Q7kNvwH8fePn&_nc_oc=Adql8453VGKr_LT0kQp_uKu3l-qSYtAs31iIy6iuJ5kFk6SsimJnGzyZC5p_2THJ95g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8b_mSoiSmOK4Yfrzw6U6b6hIzerPSeZ8aEJtAkmDTsg&oe=6A9861C0"}, "display_name": "Tammuz Blood & Sand", "keywords": ["puzzle", "advanture"], "long_description": "Do you think you can Outsmart a God?\n\nThis seated Puzzle Box Experience will test your will and wit. Told through the eyes of a prisoned deity. Step into the unknown with a ground-breaking XR experience.\n\nImmerse yourself in a world where ancient gods clash, and their secrets are locked away in mind-bending puzzles. As the boundary between reality and myth blurs, you\u2019ll face divine trials, outwit an eternal guardian, and uncover a story of power, sacrifice, and destiny. In this fully interactive mixed-reality game, the fate of an ancient force rests in your hands. Will you rise to the challenge and shape the future? Or will the echoes of the past consume you? The choice is yours\u2014are you ready to step into the story?\n\n**Innovative puzzles!** that use the capabilities of MR Technology to bring you a grounded experience in a fun and magical way \n{657349333511876}\n\n**Tactile experience!** Use your knowledge of daily interactions in puzzles that react like real objects!\n\n{1356767868854010}\n\n**Ancient prison. Divine guardian. Your choice shapes destiny.**\n\nOur team is an interdisciplinary team with expertise in Architecture, woodworking, game design, 3D manufacturing Etc, We draw our inspiration from ancient Japanese puzzle boxes - \"Yosegi-zaiku\" taken to the next level as MR technology allows us to have little to no physical boundaries, we use the main boundaries and structure of a physical object to make the game grounded and magical. join us for this adventure and see for yourself!\n{1169840184835407}", "short_description": "a Puzzle Box XR Game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/715c268b-5623-4df8-80c1-01f9ad7c4749", "developer_terms_of_service_url": null, "publisher_name": "MoodHouseXR", "support_website_url": null, "website_url": "https://ezraozery.wixsite.com/tammuz-bloodandsand", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603592553
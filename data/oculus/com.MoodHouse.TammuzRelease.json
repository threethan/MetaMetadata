7pg&oe=69AACD2C"}, {"file_name": "Braclet mr sc.png", "id": "1293533988393497", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391852_1293533991726830_1307289834815564185_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORkvMkWwwJ8Q7kNvwFsXO5H&_nc_oc=Adk7jwWQH0cC5zw8vp9GEMp7qVn7_jdKioT1n1K8JZoZGDzZehFrTT4sJujsIrikr7k&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afy3Y-dGxWel5I-ddvM7cP1z0wiv6AR198-0XxJluyRQPQ&oe=69AAC7F4"}, {"file_name": "hands crate sc.png", "id": "565647525853813", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392005_565647529187146_2459317417968159700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-V3WaNO9wNoQ7kNvwFC6t90&_nc_oc=AdmTpe7xE1CppIb9QfR3TZeVQdYLX2H0mwx5vNkJeDO97YaVqGGG7BKPJDHbfx4rvVA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFbfxOy-6UnArYz2pVKQ1512ov3DPBpphGCnTGoPaBAQ&oe=69AAE35C"}, {"file_name": "mr tablet sc.png", "id": "577220758670820", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473397201_577220762004153_605906722663877742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDZUKHcXRpgQ7kNvwEWASQN&_nc_oc=Adkh9cJG5HQwzlykfc5_Zkboqd3_tgYFO9ctdaxwUcvWcdpX3Xc3IESW3qIVzGbqIFE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdnE1u6HljPTtK3BvdyE6RmQh3sxWhRfwHEoxO8GIxhw&oe=69AAB9FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tammuz Bloodand sand narrower.png", "id": "992297489141107", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391938_992297492474440_7251832159658048125_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQfiHVr1m4cQ7kNvwHJv9e6&_nc_oc=AdmCskwxvfyjbDpDzHLo4BUfiaKpOfXs6L_G5mwewyPX0Ddf-V4vju8b-5pLEP9_NMg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afwi4e-uwh0a181vAN9N3NXtPiqLwYUNZAXTeH-ANpeHwA&oe=69AADB80"}, "display_name": "Tammuz Blood & Sand", "keywords": ["puzzle", "advanture"], "long_description": "Do you think you can Outsmart a God?\n\nThis seated Puzzle Box Experience will test your will and wit. Told through the eyes of a prisoned deity. Step into the unknown with a ground-breaking XR experience.\n\nImmerse yourself in a world where ancient gods clash, and their secrets are locked away in mind-bending puzzles. As the boundary between reality and myth blurs, you\u2019ll face divine trials, outwit an eternal guardian, and uncover a story of power, sacrifice, and destiny. In this fully interactive mixed-reality game, the fate of an ancient force rests in your hands. Will you rise to the challenge and shape the future? Or will the echoes of the past consume you? The choice is yours\u2014are you ready to step into the story?\n\n**Innovative puzzles!** that use the capabilities of MR Technology to bring you a grounded experience in a fun and magical way \n{657349333511876}\n\n**Tactile experience!** Use your knowledge of daily interactions in puzzles that react like real objects!\n\n{1356767868854010}\n\n**Ancient prison. Divine guardian. Your choice shapes destiny.**\n\nOur team is an interdisciplinary team with expertise in Architecture, woodworking, game design, 3D manufacturing Etc, We draw our inspiration from ancient Japanese puzzle boxes - \"Yosegi-zaiku\" taken to the next level as MR technology allows us to have little to no physical boundaries, we use the main boundaries and structure of a physical object to make the game grounded and magical. join us for this adventure and see for yourself!\n{1169840184835407}", "short_description": "a Puzzle Box XR Game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/715c268b-5623-4df8-80c1-01f9ad7c4749", "developer_terms_of_service_url": null, "publisher_name": "MoodHouseXR", "support_website_url": null, "website_url": "https://ezraozery.wixsite.com/tammuz-bloodandsand", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topi
2cxaVjb8nbfH7FuY8DcGYNb6XVa84Iqdw&oe=69C67CAC"}, {"file_name": "Braclet mr sc.png", "id": "1293533988393497", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391852_1293533991726830_1307289834815564185_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIfaHBW-XZ4Q7kNvwE997uO&_nc_oc=AdpK7FeT8B0iNiUkvTD0UjS4uNiVJ34yVV9gNvX1dhEVo_S33wpubLuTvyoiiTB-ySk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUzuM-c22H254pN87UbngOEJS1wlt1GeyTxVMANRqgmg&oe=69C67774"}, {"file_name": "hands crate sc.png", "id": "565647525853813", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392005_565647529187146_2459317417968159700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hnnA0xdHZAQ7kNvwG91Oqx&_nc_oc=Adp0FJdZcoTmwaB5YGJG7jnxQFv1aLhwpagMwgMkxk8d3z9UalHXK1yT_IMn7h1THLU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfynHh7COPlBdJshE0uXuEgrZh_obzVzlJiCsdlFc8etLw&oe=69C692DC"}, {"file_name": "mr tablet sc.png", "id": "577220758670820", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473397201_577220762004153_605906722663877742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pb7LyzzAFQsQ7kNvwEbpaxM&_nc_oc=AdpWa8DamYwIPYLR1plPP6jH77vOLQ99uqQIki9W9mu4aePqz_AP0XxKVlsvVJNbvb0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzuc37TXv62ys22P47Fv0AvUdWb9fajwQekc26EC9vGpg&oe=69C6697F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tammuz Bloodand sand narrower.png", "id": "992297489141107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391938_992297492474440_7251832159658048125_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cg_P1ErAA7YQ7kNvwFHur4c&_nc_oc=AdquWvl7-_1dwEcno5CWYnmBnKC4hcHisUFmjAtRZBsYPcRRicNN0km3gRo5ciPklb0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQTZ5DSqjwyysbQBYK2GMREz1i4G73G1qdqknJeikMoQ&oe=69C68B00"}, "display_name": "Tammuz Blood & Sand", "keywords": ["puzzle", "advanture"], "long_description": "Do you think you can Outsmart a God?\n\nThis seated Puzzle Box Experience will test your will and wit. Told through the eyes of a prisoned deity. Step into the unknown with a ground-breaking XR experience.\n\nImmerse yourself in a world where ancient gods clash, and their secrets are locked away in mind-bending puzzles. As the boundary between reality and myth blurs, you\u2019ll face divine trials, outwit an eternal guardian, and uncover a story of power, sacrifice, and destiny. In this fully interactive mixed-reality game, the fate of an ancient force rests in your hands. Will you rise to the challenge and shape the future? Or will the echoes of the past consume you? The choice is yours\u2014are you ready to step into the story?\n\n**Innovative puzzles!** that use the capabilities of MR Technology to bring you a grounded experience in a fun and magical way \n{657349333511876}\n\n**Tactile experience!** Use your knowledge of daily interactions in puzzles that react like real objects!\n\n{1356767868854010}\n\n**Ancient prison. Divine guardian. Your choice shapes destiny.**\n\nOur team is an interdisciplinary team with expertise in Architecture, woodworking, game design, 3D manufacturing Etc, We draw our inspiration from ancient Japanese puzzle boxes - \"Yosegi-zaiku\" taken to the next level as MR technology allows us to have little to no physical boundaries, we use the main boundaries and structure of a physical object to make the game grounded and magical. join us for this adventure and see for yourself!\n{1169840184835407}", "short_description": "a Puzzle Box XR Game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/715c268b-5623-4df8-80c1-01f9ad7c4749", "developer_terms_of_service_url": null, "publisher_name": "MoodHouseXR", "support_website_url": null, "website_url": "https://ezraozery.wixsite.com/tammuz-bloodandsand", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534
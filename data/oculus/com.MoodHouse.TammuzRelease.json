40668176398622_5209561025110161708_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDa3Vb5_xkQQ7kNvwEDMwEP&_nc_oc=AdpAdYzlr_M4DvvYBvZtrgnZHgDLK3ULHgiDynseeB8pM-lpZPECWUURvnJg1figF-M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkFwuFCcl257pvSwf64V_JYAmEqSBBb9cyqAnktO84EQ&oe=6AFB33EC"}, {"file_name": "Braclet mr sc.png", "id": "1293533988393497", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391852_1293533991726830_1307289834815564185_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zY7-RCXofWkQ7kNvwGYB2kG&_nc_oc=Adra3-HpwRVD64z1Ny089ym1TgvgVI-WXLucGwF7pIufzugLlIL-1tc_ItFavtiftc0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqZ5WAxAf_cPjyCbiOgFafgByn2eIFF_njK5-PD3AZKQ&oe=6AFB2EB4"}, {"file_name": "hands crate sc.png", "id": "565647525853813", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392005_565647529187146_2459317417968159700_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4oxX4w_bs4Q7kNvwFvkWpY&_nc_oc=AdpOHC9_uaNdJU_DqjY4wIK1-gIgtzi_qT0ANHOGMHtADZuKO3tMYUcqzuDgMcpJDt8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxJGvJ0Fmrtrc5lrSNbVuiPlRPEL-vi3hLnc9FA0NHqA&oe=6AFB4A1C"}, {"file_name": "mr tablet sc.png", "id": "577220758670820", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473397201_577220762004153_605906722663877742_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0OYE1IU4BgQ7kNvwE1y-tb&_nc_oc=AdrIS_ehroQHQuYI2Go0vmni-t7GFv2nf4F6N0yl5iA1BYz0Kp4ua3YoTunxUKt0j2Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsErC7Ljpc9pMvNfZGjUnrwtkVE3NE_7OXqjOVOvP-jw&oe=6AFB20BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tammuz Bloodand sand narrower.png", "id": "992297489141107", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391938_992297492474440_7251832159658048125_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sty9yAMOlvAQ7kNvwGpdOMX&_nc_oc=Adqxap-XX0R1hj4bx-SWU9iVy__tpfB0cE1S7ZCP9j7NEN-D2JBkr2ze_FLu3Il-WRU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7dhxlBgZid01uFQfiQjE4-zqTvB1ONOMfxgpp915wLQ&oe=6AFB4240"}, "display_name": "Tammuz Blood & Sand", "keywords": ["puzzle", "advanture"], "long_description": "Do you think you can Outsmart a God?\n\nThis seated Puzzle Box Experience will test your will and wit. Told through the eyes of a prisoned deity. Step into the unknown with a ground-breaking XR experience.\n\nImmerse yourself in a world where ancient gods clash, and their secrets are locked away in mind-bending puzzles. As the boundary between reality and myth blurs, you\u2019ll face divine trials, outwit an eternal guardian, and uncover a story of power, sacrifice, and destiny. In this fully interactive mixed-reality game, the fate of an ancient force rests in your hands. Will you rise to the challenge and shape the future? Or will the echoes of the past consume you? The choice is yours\u2014are you ready to step into the story?\n\n**Innovative puzzles!** that use the capabilities of MR Technology to bring you a grounded experience in a fun and magical way \n{657349333511876}\n\n**Tactile experience!** Use your knowledge of daily interactions in puzzles that react like real objects!\n\n{1356767868854010}\n\n**Ancient prison. Divine guardian. Your choice shapes destiny.**\n\nOur team is an interdisciplinary team with expertise in Architecture, woodworking, game design, 3D manufacturing Etc, We draw our inspiration from ancient Japanese puzzle boxes - \"Yosegi-zaiku\" taken to the next level as MR technology allows us to have little to no physical boundaries, we use the main boundaries and structure of a physical object to make the game grounded and magical. join us for this adventure and see for yourself!\n{1169840184835407}", "short_description": "a Puzzle Box XR Game"}]}, "developer_name": null, "devel
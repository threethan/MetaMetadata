k0qhLqR_vZUOkDSpgraqMkcCKjfVixXxw&oe=69CFB72C"}, {"file_name": "Braclet mr sc.png", "id": "1293533988393497", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391852_1293533991726830_1307289834815564185_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXwLZvCaPeEQ7kNvwFAFhn3&_nc_oc=AdolpHSHfUme0K3MOZBQ9KW93pR4hx7XjGiu5jgEgSNPGZBX7J4TOvpx8Dcj2VEmR_Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_Gk1hnh9Zl1AOo8weUyD5rqAKGkq46llDaGUfj9vbHA&oe=69CFB1F4"}, {"file_name": "hands crate sc.png", "id": "565647525853813", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392005_565647529187146_2459317417968159700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uR_csCOj10Q7kNvwGI4KmF&_nc_oc=AdqPVkD-YA7c4qKx4NBxFAYoIsChAh6yzu_fecIrNsjyNKJO3fqDzXdR4JMXBk5Wb7Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvIqUR2yMCIDeCfgVSF0H-GqOWQudUttONl10MRbSL0w&oe=69CFCD5C"}, {"file_name": "mr tablet sc.png", "id": "577220758670820", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473397201_577220762004153_605906722663877742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxZXArUKlGkQ7kNvwGsG5zj&_nc_oc=AdqJock-7HfqTqHHhRoIa39mSevPVjugEbVqN_o0cftyqTMmRx8yAI7YbHXSg2bzvS4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxADYF1eWchh7bm4ubNIdM5w85OKntvLAGyILCDfPxaYw&oe=69CFA3FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tammuz Bloodand sand narrower.png", "id": "992297489141107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391938_992297492474440_7251832159658048125_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cu-abpFgYEoQ7kNvwHM3fxm&_nc_oc=Adr7Jb1UFXrpna6oVLqE-xTgdFpmS0hM_4SvoIMpuJRB61h6pwLC5YI3uQk7RYt5GgU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4L1RLvUF--Y60JR0hGEdbgTWHKaLbBK2p7Tg_namZcA&oe=69CFC580"}, "display_name": "Tammuz Blood & Sand", "keywords": ["puzzle", "advanture"], "long_description": "Do you think you can Outsmart a God?\n\nThis seated Puzzle Box Experience will test your will and wit. Told through the eyes of a prisoned deity. Step into the unknown with a ground-breaking XR experience.\n\nImmerse yourself in a world where ancient gods clash, and their secrets are locked away in mind-bending puzzles. As the boundary between reality and myth blurs, you\u2019ll face divine trials, outwit an eternal guardian, and uncover a story of power, sacrifice, and destiny. In this fully interactive mixed-reality game, the fate of an ancient force rests in your hands. Will you rise to the challenge and shape the future? Or will the echoes of the past consume you? The choice is yours\u2014are you ready to step into the story?\n\n**Innovative puzzles!** that use the capabilities of MR Technology to bring you a grounded experience in a fun and magical way \n{657349333511876}\n\n**Tactile experience!** Use your knowledge of daily interactions in puzzles that react like real objects!\n\n{1356767868854010}\n\n**Ancient prison. Divine guardian. Your choice shapes destiny.**\n\nOur team is an interdisciplinary team with expertise in Architecture, woodworking, game design, 3D manufacturing Etc, We draw our inspiration from ancient Japanese puzzle boxes - \"Yosegi-zaiku\" taken to the next level as MR technology allows us to have little to no physical boundaries, we use the main boundaries and structure of a physical object to make the game grounded and magical. join us for this adventure and see for yourself!\n{1169840184835407}", "short_description": "a Puzzle Box XR Game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/715c268b-5623-4df8-80c1-01f9ad7c4749", "developer_terms_of_service_url": null, "publisher_name": "MoodHouseXR", "support_website_url": null, "website_url": "https://ezraozery.wixsite.com/tammuz-bloodandsand", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9350569994980157"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1607661027091462"}, {"status": "PUBLISHED", "id": "974005778299339"}, {"status": "PUBLISHED", "id": "738658272163544"}, {"status": "PUBLISHED", "id": "755189666874242"}, {"status": "PUBLISHED", "id": "1357602692713170"}, {"status": "PUBLISHED", "id": "1726139034751777"}, {"status": "PUBLISHED", "id": "1996650744206295"}, {"status": "PENDING", "id": "1442680886949960"}, {"status": "PENDING", "id": "1310635780456023"}]}, "baseline_offer": {"id": "1996650744206295"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774288800, "status": "PUBLISHED", "id": "1607661027091462"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26229024133374812", "version": "1.1.197f0"}, "id": "906028178145061", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9350569984980158", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26229024133374812"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1774177809, "id": "26261656330111592", "version": "1.1.198f0",
40668176398622_5209561025110161708_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDa3Vb5_xkQQ7kNvwHQ2Fow&_nc_oc=AdoWu1_XGoYAQLpzU95xQk8tDJupAcea5wEmEfgt6HyhFQN6aBq22hqG-FIEsoKNAyc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZoO7_iNXxnKkHtMQmATOheRTSV1IR5uQf3kPdUv2C6w&oe=6AFDD6EC"}, {"file_name": "Braclet mr sc.png", "id": "1293533988393497", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391852_1293533991726830_1307289834815564185_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i69tqHj9eKwQ7kNvwF54Ejc&_nc_oc=AdqozzPBXQ7nJtFPLbPVFEguT9x7zNwRMsKjblWaoSBb1Cd9zh-mUWP6yv0XvUblzCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM5wi1SmtCHAk9gmKwmqinLj6MmnEIagy3TQgsfGLrMQ&oe=6AFDD1B4"}, {"file_name": "hands crate sc.png", "id": "565647525853813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392005_565647529187146_2459317417968159700_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4oxX4w_bs4Q7kNvwEo25g1&_nc_oc=AdruLhF0Ee57kNG95_EivzuuIhoCvIHSkrPnRBx41hGnQn0Qe1ql3f_xTg1Dv8W33LQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiHwyOE3Lk4VC0H-K9zb1Qc401deMsDZzEkX8pBQhJEA&oe=6AFDB4DC"}, {"file_name": "mr tablet sc.png", "id": "577220758670820", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473397201_577220762004153_605906722663877742_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqEo4j0fHNcQ7kNvwG4SdvF&_nc_oc=AdqLE8T1-ytYSs9IrBnruywNAgAH-tBDap-z84iUWKbQRGKn_3-72ul7IcY38vVbnvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB84yoX1QREdAHfBpCNdpCxg2H29ibD-U4Yqt6m_fLzg&oe=6AFDC3BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tammuz Bloodand sand narrower.png", "id": "992297489141107", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391938_992297492474440_7251832159658048125_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sty9yAMOlvAQ7kNvwFGNVZa&_nc_oc=AdrwAw0Qxd12dsEWD0DPjQA7kGA2svBXVbMlMhQ9XSA8fHPRm_arleNiHC2ztLjNJkI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9XBAiNxuSPzKww60qaZXquG4yuA0LJhHsjBV2qr0uzQ&oe=6AFDAD00"}, "display_name": "Tammuz Blood & Sand", "keywords": ["puzzle", "advanture"], "long_description": "Do you think you can Outsmart a God?\n\nThis seated Puzzle Box Experience will test your will and wit. Told through the eyes of a prisoned deity. Step into the unknown with a ground-breaking XR experience.\n\nImmerse yourself in a world where ancient gods clash, and their secrets are locked away in mind-bending puzzles. As the boundary between reality and myth blurs, you\u2019ll face divine trials, outwit an eternal guardian, and uncover a story of power, sacrifice, and destiny. In this fully interactive mixed-reality game, the fate of an ancient force rests in your hands. Will you rise to the challenge and shape the future? Or will the echoes of the past consume you? The choice is yours\u2014are you ready to step into the story?\n\n**Innovative puzzles!** that use the capabilities of MR Technology to bring you a grounded experience in a fun and magical way \n{657349333511876}\n\n**Tactile experience!** Use your knowledge of daily interactions in puzzles that react like real objects!\n\n{1356767868854010}\n\n**Ancient prison. Divine guardian. Your choice shapes destiny.**\n\nOur team is an interdisciplinary team with expertise in Architecture, woodworking, game design, 3D manufacturing Etc, We draw our inspiration from ancient Japanese puzzle boxes - \"Yosegi-zaiku\" taken to the next level as MR technology allows us to have little to no physical boundaries, we use the main boundaries and structure of a physical object to make the game grounded and magical. join us for this adventure and see for yourself!\n{1169840184835407}", "short_description": "a Puzzle Box XR Game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/715c268b-5623-4df8-80c1-01f9ad7c4749", "developer_terms_of_service_url": null, "publisher_name": "MoodHouseXR", "support_website_url": null, "website_url": "https://ezraozery.wixsite.com/tammuz-bloodandsand", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9350569994980157"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PENDING", "id": "1442680886949960"}, {"status": "PENDING", "id": "1310635780456023"}, {"status": "PUBLISHED", "id": "2231576107739787"}, {"status": "PUBLISHED", "id": "1804879847602465"}, {"status": "PUBLISHED", "id": "2310191603123631"}, {"status": "PUBLISHED", "id": "2050145945921106"}, {"status": "PUBLISHED", "id": "1607661027091462"}, {"status": "PUBLISHED", "id": "974005778299339"}, {"status": "PUBLISHED", "id": "738658272163544"}, {"status": "PUBLISHED", "id": "755189666874242"}, {"status": "PUBLISHED", "id": "1357602692713170"}, {"status": "PUBLISHED", "id": "1726139034751777"}, {"status": "PUBLISHED", "id": "1996650744206295"}]}, "baseline_offer": {"id": "1996650744206295"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2231576107739787"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": 
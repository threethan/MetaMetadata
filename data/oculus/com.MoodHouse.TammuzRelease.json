kEnvp0uFmYn-DSRIruhesl8wPHeZOEBtNg&oe=6A88492C"}, {"file_name": "Braclet mr sc.png", "id": "1293533988393497", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391852_1293533991726830_1307289834815564185_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0GMm9phvmwQ7kNvwES-gZF&_nc_oc=AdpBP5PA4SKWvk65afo-RkFC87ajJmu0mpTlcA-nDcvy0T__lbyaTAW-WhuajtVNaYg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpxCvMLlLwYSiwuWFqtlz1wNKeUkV0MucTBP8kGhe9uA&oe=6A8843F4"}, {"file_name": "hands crate sc.png", "id": "565647525853813", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392005_565647529187146_2459317417968159700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEupxp1w9L8Q7kNvwFf6VR1&_nc_oc=Adpu-HyUJ2aTjUEuGEKGnVyIqWLLLdNfNdNcrb_5ajyDdDcfDyPzF345EFvpb_IinZc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI6rrBNpTt9jKF0-159GxgM4pKBCNB4ojoaW2rg-tdwQ&oe=6A88271C"}, {"file_name": "mr tablet sc.png", "id": "577220758670820", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473397201_577220762004153_605906722663877742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nefRTsZsu4oQ7kNvwFzBpmu&_nc_oc=AdpOxBvkmadAvgWyXwIojGnQFxoC71YYe4GWf18as0qDAuj4eR-PtLNHnARyGNQCrcA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbkHE46-_JV_WXWkzbww7eM0PWJe8lhUO_SdlEtipcRw&oe=6A8835FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tammuz Bloodand sand narrower.png", "id": "992297489141107", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391938_992297492474440_7251832159658048125_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5qOWsjx3S0Q7kNvwH73y2B&_nc_oc=AdrvxdY08fjnoqzd3r4eLtIZEuOLsfR-U-hYfsrZ_JeYnNZXJynCX0_Hh_vbDGdc0CU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ1IcPkjkpRlNBk4j3Nn-9-qpC5QR3chHtOwsJuSBQ2g&oe=6A881F40"}, "display_name": "Tammuz Blood & Sand", "keywords": ["puzzle", "advanture"], "long_description": "Do you think you can Outsmart a God?\n\nThis seated Puzzle Box Experience will test your will and wit. Told through the eyes of a prisoned deity. Step into the unknown with a ground-breaking XR experience.\n\nImmerse yourself in a world where ancient gods clash, and their secrets are locked away in mind-bending puzzles. As the boundary between reality and myth blurs, you\u2019ll face divine trials, outwit an eternal guardian, and uncover a story of power, sacrifice, and destiny. In this fully interactive mixed-reality game, the fate of an ancient force rests in your hands. Will you rise to the challenge and shape the future? Or will the echoes of the past consume you? The choice is yours\u2014are you ready to step into the story?\n\n**Innovative puzzles!** that use the capabilities of MR Technology to bring you a grounded experience in a fun and magical way \n{657349333511876}\n\n**Tactile experience!** Use your knowledge of daily interactions in puzzles that react like real objects!\n\n{1356767868854010}\n\n**Ancient prison. Divine guardian. Your choice shapes destiny.**\n\nOur team is an interdisciplinary team with expertise in Architecture, woodworking, game design, 3D manufacturing Etc, We draw our inspiration from ancient Japanese puzzle boxes - \"Yosegi-zaiku\" taken to the next level as MR technology allows us to have little to no physical boundaries, we use the main boundaries and structure of a physical object to make the game grounded and magical. join us for this adventure and see for yourself!\n{1169840184835407}", "short_description": "a Puzzle Box XR Game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/715c268b-5623-4df8-80c1-01f9ad7c4749", "developer_terms_of_service_url": null, "publisher_name": "MoodHouseXR", "support_website_url": null, "website_url": "https://ezraozery.wixsite.com/tammuz-bloodandsand", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603592553
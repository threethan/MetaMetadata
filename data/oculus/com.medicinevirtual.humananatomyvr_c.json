I4zgTsZSaqW3ZZqc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfVZ77_HusSwJrhsinGmGjqjsfeAXC8q0zzYJW1DLwBQ&oe=6AD39CAE"}, {"file_name": "Screen 8.png", "id": "1231203624210561", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982441_1231203627543894_6604299156977311037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNtCT0Iz3fIQ7kNvwHDjtKc&_nc_oc=AdrFMAZV8Uji8PqG8nqbTuTUUpKmYZeDV6ZN22gAZHo185RnkdFSjNN_PK-UrCTV1NM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOig8Oj4DkZ0oAClWXbUu6oja4cdCAv5Os9DM_T94-7dQ&oe=6AD3AE7B"}, {"file_name": "Screen 6.png", "id": "122054730966229", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982613_122054734299562_4108073808945415028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tr3IyWtkRR0Q7kNvwFnHKpS&_nc_oc=AdqTOSdn7ASPTq64AFerNBqVClecZcpdZv6g_0UIglAO5v8Tdb5G2mfp0xkNwTcgJms&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMps7E_sykwTxJFy-ddq3k9_wljsDdwslRfZuBEG4Z9FA&oe=6AD3A612"}, {"file_name": "Screen 2.png", "id": "3536306649950736", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974506_3536306653284069_4222408641046143602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wbphs_p54_UQ7kNvwEeR1JF&_nc_oc=Adoc6qPtDvA-Lzk5gXi5_DBM_8mDtjgI2-mDH7oOCllV9mSHX5lacr6ht9LK4fwSQzk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_IeWAOVa-2YRDDlOt9zLKPQ2pOxjwXhUzaziuI87igA&oe=6AD3A7EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "995212348198088", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974913_995212351531421_1308806490488649384_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEXA7dCLUAkQ7kNvwECfgeF&_nc_oc=Adpnv2GmB9k5CKXXqwn1neBp64W6tAX3kMoCp38ZCOK_Eb7UzMmbDwp_deYFpbSLJ_o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmApk2ynuSbiNpmeGCz2s9mx43ZpAgtz4CQn03qlxGEw&oe=6AD3B8C5"}, "display_name": "Human Anatomy VR", "keywords": [], "long_description": "Are you interested in the human body? \n\nHuman Anatomy VR delivers the most immersive human anatomical experience available on the market designed for anybody interested in the human body.\n\nIt is perfect for sport, fitness & workout enthusiasts, science enthusiasts, high school students, medical and nursing students, universities, libraries and health practitioners. Feature rich content is delivered in a deeply engaging experience with excellent graphics, innovative presentation, and visual delivery.\n\nDon't be afraid of the complexity and large amount of structures. You can choose your education level and change it at any time. It doesn't matter if you're a medical student, an enthusiast, an athlete or simply want to know more about your body. \n\nNo matter your current knowledge of anatomy, the content is carefully prepared for anybody who is interested in the human body.\n\n1. High School content level - Simplified content for anybody who is curious about the human body. \n\n2. University content level - Detailed content that matches the needs of a medical doctor or a medical student who needs to prepare for their anatomical exams.\n\nThe software provides 15 body systems with more than 13 000 realistic anatomical structures designed by medical professionals. Bone mapping with 5000 bony features organized into Parts, Surfaces, Borders, and Landmarks. 21 Microanatomy models, over 500 animated structures and more!", "short_description": "Explore the Human Body in VR - Unveil Its Wonders with Immersive Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medicinevirtual.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medicine s.r.o", "support_website_url": null, "website_url": "https://medicinevirtual.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": 
-cFm7bBm2CIV49js&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU786BV21GS9XZPeuyk1u1XVcRQO_A5T9Si1T_GYqypA&oe=6AE7632E"}, {"file_name": "Screen 8.png", "id": "1231203624210561", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982441_1231203627543894_6604299156977311037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbmzuQKemtkQ7kNvwG5M_ix&_nc_oc=AdoD66Uf0sTSppl8K4onwrWNoRYghIzto5Ewz32aygPxseAssmxNyB2-0iGwv95xdVs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5HuyN07Z3won_-hSB3e28BZEOt53WKGi-nPj0VA9PHg&oe=6AE73CBB"}, {"file_name": "Screen 6.png", "id": "122054730966229", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982613_122054734299562_4108073808945415028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YC6ouHzIcugQ7kNvwF6k0FJ&_nc_oc=Adrb10da-9AS7A0YE6CcYrXKRcZb3LbopJusEFp2noicW-bYqlDVG6Bdj8fNY_tW8Go&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZcdFWlKYyyBss5m7-A7XWCNqeM_ZVe4vicDR4SHCXRg&oe=6AE76C92"}, {"file_name": "Screen 2.png", "id": "3536306649950736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974506_3536306653284069_4222408641046143602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aP-66BbWnAMQ7kNvwGf0gyK&_nc_oc=Adqb8nGsIHGogOYicl_IziSrg0AGiRYGT7mn9TRIgitSn03cfmv7MaNtggjjcCiIslg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNSox-Rj0vIRUpWrUog2TuCpLAk2h6kINLJKrc5gYEEQ&oe=6AE76E6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "995212348198088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974913_995212351531421_1308806490488649384_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2tjXpr1j_8Q7kNvwGCu4zQ&_nc_oc=AdpRZa5OvcF5-xO30ElZsxp_RRLG7sbcl3grtRZ7FiBUlTWl2J5B_OZIvprgf5_d4O0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8SNBNpNH9rtn_6mw6dVl_0jDB_VU_0t0DwLFM6RSqzA&oe=6AE74705"}, "display_name": "Human Anatomy VR", "keywords": [], "long_description": "Are you interested in the human body? \n\nHuman Anatomy VR delivers the most immersive human anatomical experience available on the market designed for anybody interested in the human body.\n\nIt is perfect for sport, fitness & workout enthusiasts, science enthusiasts, high school students, medical and nursing students, universities, libraries and health practitioners. Feature rich content is delivered in a deeply engaging experience with excellent graphics, innovative presentation, and visual delivery.\n\nDon't be afraid of the complexity and large amount of structures. You can choose your education level and change it at any time. It doesn't matter if you're a medical student, an enthusiast, an athlete or simply want to know more about your body. \n\nNo matter your current knowledge of anatomy, the content is carefully prepared for anybody who is interested in the human body.\n\n1. High School content level - Simplified content for anybody who is curious about the human body. \n\n2. University content level - Detailed content that matches the needs of a medical doctor or a medical student who needs to prepare for their anatomical exams.\n\nThe software provides 15 body systems with more than 13 000 realistic anatomical structures designed by medical professionals. Bone mapping with 5000 bony features organized into Parts, Surfaces, Borders, and Landmarks. 21 Microanatomy models, over 500 animated structures and more!", "short_description": "Explore the Human Body in VR - Unveil Its Wonders with Immersive Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medicinevirtual.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medicine s.r.o", "support_website_url": null, "website_url": "https://medicinevirtual.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": 
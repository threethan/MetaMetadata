9W-hQQ_8LdLFJdsI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE02Y18FSerWk0-XMLf7xOnZdRU0XuQO4G_srXuSQPU4g&oe=6A89906E"}, {"file_name": "Screen 8.png", "id": "1231203624210561", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982441_1231203627543894_6604299156977311037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIVyUK-ywrgQ7kNvwH2ySFF&_nc_oc=Adq1JX-f6IsOMIPbcmDSjpPvMFgTTglIrciJeUW87hu3Z-d6PVr2P1pL4fZ43NoMo2E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAL6jUPF-Y5wtjf4_7b3x_oDTbrFHfXuTypc8yckxvzQ&oe=6A89A23B"}, {"file_name": "Screen 6.png", "id": "122054730966229", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982613_122054734299562_4108073808945415028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FG3M_zvUJkQ7kNvwFrWocc&_nc_oc=AdrKLyZ3dpzKLEdfGaNhpeXW-AkJZgGN3qUf4YjVUrPk02kQHDWuKnp8QTrQLQS53N0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKL45VW16aiC60OrMoskI2ivaGAdVRg4g_F_8BWMmqPA&oe=6A8999D2"}, {"file_name": "Screen 2.png", "id": "3536306649950736", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974506_3536306653284069_4222408641046143602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QC3sNStRvkgQ7kNvwFX-V9W&_nc_oc=Adq6ALxcwyfBLOQOOTv7iqUXOsD47JIwCwXwktPsqZLSqinLq19icBdHL0jamDJIk5w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVyHRxctqbg8HHQlkOlVeLKmPGAV5H2hbi_9QESg2XCA&oe=6A899BAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "995212348198088", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974913_995212351531421_1308806490488649384_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTpkVOW0Ek0Q7kNvwHoAb-9&_nc_oc=AdooCP0W-yfhdKofdzfWA3dn2tTyQDAmsSm0YK42s27M7HgsoK5ttlkl-gGa7ke8C0s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMOdNzdVD4zZ4f6thM4ibMVwz5krIQbVSiYI-9-SVorQ&oe=6A897445"}, "display_name": "Human Anatomy VR", "keywords": [], "long_description": "Are you interested in the human body? \n\nHuman Anatomy VR delivers the most immersive human anatomical experience available on the market designed for anybody interested in the human body.\n\nIt is perfect for sport, fitness & workout enthusiasts, science enthusiasts, high school students, medical and nursing students, universities, libraries and health practitioners. Feature rich content is delivered in a deeply engaging experience with excellent graphics, innovative presentation, and visual delivery.\n\nDon't be afraid of the complexity and large amount of structures. You can choose your education level and change it at any time. It doesn't matter if you're a medical student, an enthusiast, an athlete or simply want to know more about your body. \n\nNo matter your current knowledge of anatomy, the content is carefully prepared for anybody who is interested in the human body.\n\n1. High School content level - Simplified content for anybody who is curious about the human body. \n\n2. University content level - Detailed content that matches the needs of a medical doctor or a medical student who needs to prepare for their anatomical exams.\n\nThe software provides 15 body systems with more than 13 000 realistic anatomical structures designed by medical professionals. Bone mapping with 5000 bony features organized into Parts, Surfaces, Borders, and Landmarks. 21 Microanatomy models, over 500 animated structures and more!", "short_description": "Explore the Human Body in VR - Unveil Its Wonders with Immersive Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medicinevirtual.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medicine s.r.o", "support_website_url": null, "website_url": "https://medicinevirtual.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": 
gZNgn-0moj6rtkAE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtxWEyxMj_G1iUcEtvFnMrEPOruzT518yvT-h9mNN5CA&oe=6ABFD62E"}, {"file_name": "Screen 8.png", "id": "1231203624210561", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982441_1231203627543894_6604299156977311037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_C2zQnsd50Q7kNvwEFpx8C&_nc_oc=AdqOn8oQeZ-iUq701FbNilfRiVYGlEDbQSGkfY8F-3k_sWLiMLNV0RTQNR0e4ZbaJc4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOla-wKCh-r4KqYz11nk7aJm8oFEKBLzixyRsUubGmQww&oe=6ABFAFBB"}, {"file_name": "Screen 6.png", "id": "122054730966229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982613_122054734299562_4108073808945415028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eo-olR79i5oQ7kNvwEQbY32&_nc_oc=AdqCrEP-k3h54-yCrPipxWi6ZFOF10fKpfOjWL_RuNzbNdbEo8Qf5_5_8bHI2PqKn8o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPvUjoE2iv_8kFSOqq-q59f4tOWq2vrM3kxGrQ2eW7Mg&oe=6ABFDF92"}, {"file_name": "Screen 2.png", "id": "3536306649950736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974506_3536306653284069_4222408641046143602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRE32E2uByIQ7kNvwEGfNin&_nc_oc=AdpYro88lEbGASKXtxalnP-g2A0vKbQ1Vue5IVrmEr2ZSPqtiGwchWgTeVIQWEPF9qs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMO6LpT8ZKMpaQ5z085yblXc8Nneg7hSbxM3r9lzrMkVQ&oe=6ABFA92E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "995212348198088", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974913_995212351531421_1308806490488649384_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PU6KgcS_yJsQ7kNvwFcZ_KQ&_nc_oc=AdqSyaErYe2OU7jWiSaW1WoFZcyjLp3e8CweHi2slETidGgC_I1xk9_ccuElHnAwAe4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0EDwn9jQzZoMnKb9V0oyAn_-bNM9XhXdMWpx2E4Vu3Q&oe=6ABFBA05"}, "display_name": "Human Anatomy VR", "keywords": [], "long_description": "Are you interested in the human body? \n\nHuman Anatomy VR delivers the most immersive human anatomical experience available on the market designed for anybody interested in the human body.\n\nIt is perfect for sport, fitness & workout enthusiasts, science enthusiasts, high school students, medical and nursing students, universities, libraries and health practitioners. Feature rich content is delivered in a deeply engaging experience with excellent graphics, innovative presentation, and visual delivery.\n\nDon't be afraid of the complexity and large amount of structures. You can choose your education level and change it at any time. It doesn't matter if you're a medical student, an enthusiast, an athlete or simply want to know more about your body. \n\nNo matter your current knowledge of anatomy, the content is carefully prepared for anybody who is interested in the human body.\n\n1. High School content level - Simplified content for anybody who is curious about the human body. \n\n2. University content level - Detailed content that matches the needs of a medical doctor or a medical student who needs to prepare for their anatomical exams.\n\nThe software provides 15 body systems with more than 13 000 realistic anatomical structures designed by medical professionals. Bone mapping with 5000 bony features organized into Parts, Surfaces, Borders, and Landmarks. 21 Microanatomy models, over 500 animated structures and more!", "short_description": "Explore the Human Body in VR - Unveil Its Wonders with Immersive Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medicinevirtual.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medicine s.r.o", "support_website_url": null, "website_url": "https://medicinevirtual.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": 
lPewOnGMlB2w05Ok&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDjSb_P1YaSjhBfMJFpO6jgr4pnz1dqPxK_koU0Wgyaw&oe=6AC51C2E"}, {"file_name": "Screen 8.png", "id": "1231203624210561", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982441_1231203627543894_6604299156977311037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZsormBJpacQ7kNvwHxZhdX&_nc_oc=AdrPdbNh-CQ2UC4-9P4XFltBj_7iiv4gOwsh9Y6dAM3I7X-KaX-rtnbK29-8OeTxToo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv5euwGXIcwgWj0dusl078ZxkrQ1CtFPojsh0dDXtrGA&oe=6AC4F5BB"}, {"file_name": "Screen 6.png", "id": "122054730966229", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982613_122054734299562_4108073808945415028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5x-1uUifKQQ7kNvwFIdhw0&_nc_oc=AdokGlwT-WCnJMp5nM0h0HtdhoXhN60pIniatJnZlUPX1-Td26FBKpqHxEl0FYCsyts&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKayZ2ffEym9lB-Qxrn7iwR8QiQdDeZwuOGw_rQ8HdMw&oe=6AC52592"}, {"file_name": "Screen 2.png", "id": "3536306649950736", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974506_3536306653284069_4222408641046143602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2Akn5YMsPwQ7kNvwHiduS0&_nc_oc=AdpDiLgyNrj8tP0E3O13ISZZwu0SN7teSQBIigts-YB0DfktM8e8R946nv31-tmZLHE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuD8QhVeTGddbQvztz8wx9gi_wsaVkHWKBzNm5ELeRnw&oe=6AC5276E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "995212348198088", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974913_995212351531421_1308806490488649384_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNbyUtHexwUQ7kNvwGbRHUa&_nc_oc=AdqiVF8f7W-LnzSlyIhBSIwF6K2NO6jyk4Fm_48hdQ-DFsD4-UH8TqxQKgTKfPWhz2Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORbP4L_hxIqzoPrYeuLX1Fy8p003Hs2SrE8fb3C4Wj2A&oe=6AC50005"}, "display_name": "Human Anatomy VR", "keywords": [], "long_description": "Are you interested in the human body? \n\nHuman Anatomy VR delivers the most immersive human anatomical experience available on the market designed for anybody interested in the human body.\n\nIt is perfect for sport, fitness & workout enthusiasts, science enthusiasts, high school students, medical and nursing students, universities, libraries and health practitioners. Feature rich content is delivered in a deeply engaging experience with excellent graphics, innovative presentation, and visual delivery.\n\nDon't be afraid of the complexity and large amount of structures. You can choose your education level and change it at any time. It doesn't matter if you're a medical student, an enthusiast, an athlete or simply want to know more about your body. \n\nNo matter your current knowledge of anatomy, the content is carefully prepared for anybody who is interested in the human body.\n\n1. High School content level - Simplified content for anybody who is curious about the human body. \n\n2. University content level - Detailed content that matches the needs of a medical doctor or a medical student who needs to prepare for their anatomical exams.\n\nThe software provides 15 body systems with more than 13 000 realistic anatomical structures designed by medical professionals. Bone mapping with 5000 bony features organized into Parts, Surfaces, Borders, and Landmarks. 21 Microanatomy models, over 500 animated structures and more!", "short_description": "Explore the Human Body in VR - Unveil Its Wonders with Immersive Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medicinevirtual.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medicine s.r.o", "support_website_url": null, "website_url": "https://medicinevirtual.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": 
r22geM0Y7tvtQIdE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBmjpO-FZu7HWezJSoLvMa0YqtcB7VPNuErYLz5YpbxQ&oe=6A972FEE"}, {"file_name": "Screen 8.png", "id": "1231203624210561", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982441_1231203627543894_6604299156977311037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsCtY_OXl6YQ7kNvwG38tQN&_nc_oc=AdoOwcHFjVyAwhOT9zAqoLV9gHFcH03w9-sL7VgllQJGE8UA4101jHeDYwCeZkGLCEA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKmaj1ULYlx5uUa0CsvoRcQ96DwxzasQpv64S0YjLBaw&oe=6A9741BB"}, {"file_name": "Screen 6.png", "id": "122054730966229", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982613_122054734299562_4108073808945415028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LK3XdhHz4mgQ7kNvwHYjwjv&_nc_oc=AdrF2OwH5IJVvwjEVynyCszE4cTVUJG0Yr0Z-sf9sqA7nMUzfBTF9galvZg7fdN-JHw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErwwrn4sFShiKmqtaxaRI315Q45xIS9w9rgy3b6qB4uA&oe=6A973952"}, {"file_name": "Screen 2.png", "id": "3536306649950736", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974506_3536306653284069_4222408641046143602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiBYf7Ailx4Q7kNvwHr4mo_&_nc_oc=AdphppoZIV2N5JKuVrkHg8b3CVCMx1owtm1nP6-ugxaKye58t8vxLqzicvkvMmrx8zU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmaJcCNdI7XDYXb-SKZ0eVOHw4heqAOF0JS_SYVGWQyA&oe=6A973B2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "995212348198088", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974913_995212351531421_1308806490488649384_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAM6XToSJ_oQ7kNvwGNd9rD&_nc_oc=AdrteJe-PbW3CmxeQ1sBHO1fun8YUgg-HmtJfNmveiCBIQa7y39gEjBitePzd7MXELo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEj2txnwAuBYsp7hQpYs5dVwq4zaaiwmPJehgIGeblW0A&oe=6A974C05"}, "display_name": "Human Anatomy VR", "keywords": [], "long_description": "Are you interested in the human body? \n\nHuman Anatomy VR delivers the most immersive human anatomical experience available on the market designed for anybody interested in the human body.\n\nIt is perfect for sport, fitness & workout enthusiasts, science enthusiasts, high school students, medical and nursing students, universities, libraries and health practitioners. Feature rich content is delivered in a deeply engaging experience with excellent graphics, innovative presentation, and visual delivery.\n\nDon't be afraid of the complexity and large amount of structures. You can choose your education level and change it at any time. It doesn't matter if you're a medical student, an enthusiast, an athlete or simply want to know more about your body. \n\nNo matter your current knowledge of anatomy, the content is carefully prepared for anybody who is interested in the human body.\n\n1. High School content level - Simplified content for anybody who is curious about the human body. \n\n2. University content level - Detailed content that matches the needs of a medical doctor or a medical student who needs to prepare for their anatomical exams.\n\nThe software provides 15 body systems with more than 13 000 realistic anatomical structures designed by medical professionals. Bone mapping with 5000 bony features organized into Parts, Surfaces, Borders, and Landmarks. 21 Microanatomy models, over 500 animated structures and more!", "short_description": "Explore the Human Body in VR - Unveil Its Wonders with Immersive Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medicinevirtual.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medicine s.r.o", "support_website_url": null, "website_url": "https://medicinevirtual.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": 
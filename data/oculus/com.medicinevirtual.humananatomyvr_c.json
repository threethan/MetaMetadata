W2R1Xb-PhioQd550&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7-VaJzlLgwD3CgAPfpF53nHsF5_l3KN_TY_3tqdpmew&oe=6AB7ED2E"}, {"file_name": "Screen 8.png", "id": "1231203624210561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982441_1231203627543894_6604299156977311037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmXO2SBi6OoQ7kNvwE0P3nA&_nc_oc=Adrx2_WPfPEA2SCixTemuFA1i8GvyX0bTGg5gd5KYEJ_PgbAOBlcNF1_7Z91KO2ioug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYZmHbKMQ0ik4joWJ9nF7ZdzuTrRAi4TPVdKiQF476tw&oe=6AB7C6BB"}, {"file_name": "Screen 6.png", "id": "122054730966229", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982613_122054734299562_4108073808945415028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BKpl0NL9vsQ7kNvwEulIkx&_nc_oc=AdoA2GvxZFqYVrAePFF7RqbMux38ikJXFQGgLVtm3mlYuWqcuKPz-D-0IcVNyJL_jvI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLevM2mnQo-QioUkkVI6OPknVKpvrXu2Oir_1w-oGynsQ&oe=6AB7BE52"}, {"file_name": "Screen 2.png", "id": "3536306649950736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974506_3536306653284069_4222408641046143602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DhjAMNOL78Q7kNvwF-6JV9&_nc_oc=AdrbMfXLJXVumvnxPb2mlIOKrF0GkBXQ5KyERTCeMZWqkI2XOMu-ldwalRSCjL9U1uU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7UDx511mGZvDcQT-lQz5r70a1WjxEFEac-eY60f3M7A&oe=6AB7C02E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "995212348198088", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974913_995212351531421_1308806490488649384_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drWooGGQ17wQ7kNvwGGA2Ob&_nc_oc=AdpO3JKGE4vOAMWyNIpNM18ND_t44uO9NNVaiZcl5pvIVGxFKaJRRjxiB3EuNhfWz8k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9TpI8EPFeYz5rgNF_ExNRgY0F-yob0GWvLPIZbF1PmA&oe=6AB7D105"}, "display_name": "Human Anatomy VR", "keywords": [], "long_description": "Are you interested in the human body? \n\nHuman Anatomy VR delivers the most immersive human anatomical experience available on the market designed for anybody interested in the human body.\n\nIt is perfect for sport, fitness & workout enthusiasts, science enthusiasts, high school students, medical and nursing students, universities, libraries and health practitioners. Feature rich content is delivered in a deeply engaging experience with excellent graphics, innovative presentation, and visual delivery.\n\nDon't be afraid of the complexity and large amount of structures. You can choose your education level and change it at any time. It doesn't matter if you're a medical student, an enthusiast, an athlete or simply want to know more about your body. \n\nNo matter your current knowledge of anatomy, the content is carefully prepared for anybody who is interested in the human body.\n\n1. High School content level - Simplified content for anybody who is curious about the human body. \n\n2. University content level - Detailed content that matches the needs of a medical doctor or a medical student who needs to prepare for their anatomical exams.\n\nThe software provides 15 body systems with more than 13 000 realistic anatomical structures designed by medical professionals. Bone mapping with 5000 bony features organized into Parts, Surfaces, Borders, and Landmarks. 21 Microanatomy models, over 500 animated structures and more!", "short_description": "Explore the Human Body in VR - Unveil Its Wonders with Immersive Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medicinevirtual.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medicine s.r.o", "support_website_url": null, "website_url": "https://medicinevirtual.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": 
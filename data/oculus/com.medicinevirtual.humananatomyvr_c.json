23H8mhNmcmC1P878&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTYkq_LVTLhFnzPM8PMOeMsfa7W6T_A73gEibhk3Gu3Q&oe=6AA7E2EE"}, {"file_name": "Screen 8.png", "id": "1231203624210561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982441_1231203627543894_6604299156977311037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6S0OdZmZ0SEQ7kNvwE2Cse-&_nc_oc=AdoMg67oIXWjtH5WP4KNjs4TYltm7P3uCEyn72ISe5gHVukraGLDp7KwIRdj1Gu4yA0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfepyLC-ZPENkkiWbvUNy4ptU2v3kcvD0_r6yI3iU_0w&oe=6AA7F4BB"}, {"file_name": "Screen 6.png", "id": "122054730966229", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982613_122054734299562_4108073808945415028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVTotJDgMysQ7kNvwFMqkfy&_nc_oc=Adrrl_czAlAbttk73qA5KYTGCRdOM87NbfKZwxWUGMm8UW3Z_PKeF1gADJGdNyoTsrg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz42tkicbMJg-EETkPEkBBs62uadADRYvsQkb-qTD33A&oe=6AA7EC52"}, {"file_name": "Screen 2.png", "id": "3536306649950736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974506_3536306653284069_4222408641046143602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fluSaKC4sRYQ7kNvwFXH3IX&_nc_oc=AdqFqc363DynTLqoVPLVrm-z57EW52J1UabFd26H9MFUBET5CXAgMqr3wksWvMNpvAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiFeGIhYyC1r39Ufsvb-awMnAvYehx3U3nlFRJWI-o8Q&oe=6AA7EE2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "995212348198088", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974913_995212351531421_1308806490488649384_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DK1AJv7574Q7kNvwFwdJOc&_nc_oc=AdoYN7_vOwmDC8y4tDnmRf6rjfoNoHZHXp0hqR80AuY6n2CjxCD4X3HgNE21uXk5I-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZRTLGMc1r4nTifAmDXKObKtuDDgqYKDiOXK0gkk6H_Q&oe=6AA7FF05"}, "display_name": "Human Anatomy VR", "keywords": [], "long_description": "Are you interested in the human body? \n\nHuman Anatomy VR delivers the most immersive human anatomical experience available on the market designed for anybody interested in the human body.\n\nIt is perfect for sport, fitness & workout enthusiasts, science enthusiasts, high school students, medical and nursing students, universities, libraries and health practitioners. Feature rich content is delivered in a deeply engaging experience with excellent graphics, innovative presentation, and visual delivery.\n\nDon't be afraid of the complexity and large amount of structures. You can choose your education level and change it at any time. It doesn't matter if you're a medical student, an enthusiast, an athlete or simply want to know more about your body. \n\nNo matter your current knowledge of anatomy, the content is carefully prepared for anybody who is interested in the human body.\n\n1. High School content level - Simplified content for anybody who is curious about the human body. \n\n2. University content level - Detailed content that matches the needs of a medical doctor or a medical student who needs to prepare for their anatomical exams.\n\nThe software provides 15 body systems with more than 13 000 realistic anatomical structures designed by medical professionals. Bone mapping with 5000 bony features organized into Parts, Surfaces, Borders, and Landmarks. 21 Microanatomy models, over 500 animated structures and more!", "short_description": "Explore the Human Body in VR - Unveil Its Wonders with Immersive Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medicinevirtual.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medicine s.r.o", "support_website_url": null, "website_url": "https://medicinevirtual.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": 
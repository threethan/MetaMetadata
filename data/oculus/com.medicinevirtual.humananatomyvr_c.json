_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02E1omuz_Z8Q7kNvwGO-7sy&_nc_oc=Adpu_Gq2lglYFS-hwijYttVyb2cqEe-_NA2y6-k8talhZt1Yhya53kI4ScuBRkWJYHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3b3nJ3P9HYPCwgovtA5JVzJIqeSPwXnH1fH0F2AzWGw&oe=6AF7352E"}, {"file_name": "Screen 8.png", "id": "1231203624210561", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982441_1231203627543894_6604299156977311037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsPouiUMv4sQ7kNvwHtvHsL&_nc_oc=AdonasgYfFo4GnwSDRyTISScmoEppCXBeW4JdViqpJS-pvxIRacwuk2yECwyz5VFXZY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS876cQs8abnanHaIIKnly3cZ2YgbmQtmFxt_4Q989XwA&oe=6AF746FB"}, {"file_name": "Screen 6.png", "id": "122054730966229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982613_122054734299562_4108073808945415028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U76RS3pInZsQ7kNvwFbCD5f&_nc_oc=Adq0KbANn0XmPSTsingCvwt10PAJ9pgznryd_KmQ4mrVeTch0mAtu0UiNUU46j5uZXA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO5_ZFYFogwLeIf1BTs9Xgj4yKqRqL41o31lwVxRl43g&oe=6AF73E92"}, {"file_name": "Screen 2.png", "id": "3536306649950736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974506_3536306653284069_4222408641046143602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SlRATplXlAQ7kNvwHQ2u5r&_nc_oc=Adr76en4OIklZEmW-r67QLMyatAIUijzpbQMLxirQIw8tOvCObiMNSI83i_UXTyI0Jc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiChh-coFZ2IIXqMMcUDrjlw_5BKhPuy98oBRa4INFOQ&oe=6AF7406E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "995212348198088", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974913_995212351531421_1308806490488649384_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiqfcZQGk1gQ7kNvwHv6d2y&_nc_oc=AdoNV6NHzNQt5s7KlwuN81cjLEVl48i9dKQQdI5fzwZIQz4r_i1WOEOpo3TS8A8HLss&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQarGmlrblzZCEO2aHASNOxexHlppzq69I83cdIUhRHFw&oe=6AF71905"}, "display_name": "Human Anatomy VR", "keywords": [], "long_description": "Are you interested in the human body? \n\nHuman Anatomy VR delivers the most immersive human anatomical experience available on the market designed for anybody interested in the human body.\n\nIt is perfect for sport, fitness & workout enthusiasts, science enthusiasts, high school students, medical and nursing students, universities, libraries and health practitioners. Feature rich content is delivered in a deeply engaging experience with excellent graphics, innovative presentation, and visual delivery.\n\nDon't be afraid of the complexity and large amount of structures. You can choose your education level and change it at any time. It doesn't matter if you're a medical student, an enthusiast, an athlete or simply want to know more about your body. \n\nNo matter your current knowledge of anatomy, the content is carefully prepared for anybody who is interested in the human body.\n\n1. High School content level - Simplified content for anybody who is curious about the human body. \n\n2. University content level - Detailed content that matches the needs of a medical doctor or a medical student who needs to prepare for their anatomical exams.\n\nThe software provides 15 body systems with more than 13 000 realistic anatomical structures designed by medical professionals. Bone mapping with 5000 bony features organized into Parts, Surfaces, Borders, and Landmarks. 21 Microanatomy models, over 500 animated structures and more!", "short_description": "Explore the Human Body in VR - Unveil Its Wonders with Immersive Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medicinevirtual.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medicine s.r.o", "support_website_url": null, "website_url": "https://medicinevirtual.com/", "category": null, "comfort_rating": "
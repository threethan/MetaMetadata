aZnwNyOp5elrOtNs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4uew_c11GmZ1v2qvFyhrUWPW_lFnkyTCNfjrDzKy6qA&oe=6ABD332E"}, {"file_name": "Screen 8.png", "id": "1231203624210561", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982441_1231203627543894_6604299156977311037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_C2zQnsd50Q7kNvwFIL8Gg&_nc_oc=Adqw_DgzXmNs3rgA0cltaZat5q-h7bPAFqqx2vGUA97TZtXdF1q1beKx_Vj68p7RG7k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxYaOB-kg2ohsFLGaLECvk_NdCK06QrGvcaGLbX6rpsw&oe=6ABD0CBB"}, {"file_name": "Screen 6.png", "id": "122054730966229", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982613_122054734299562_4108073808945415028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOt3D3bqywwQ7kNvwGboSp8&_nc_oc=Ado5Sim0DJJedLue2PzhrCS1QrUiSJP4Y89O68h_DMtXtuFm9ZPBYOqPvoOHLjFPPUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVdFOCXBd17rgEJKZt3vuX3ZATCky26YfIv5B3oIfkaA&oe=6ABD0452"}, {"file_name": "Screen 2.png", "id": "3536306649950736", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974506_3536306653284069_4222408641046143602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRzZnO0uiq8Q7kNvwH8UsMJ&_nc_oc=Adpg6fUpZrr8pbQZI5yW9ezZRypZ08YLeyJvxwZbeFv6li4Car97TgxoODTkoYpbVCc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1Fz38SoLh2HUFW3xn081uqVr3sbOOeIOtPtudm3laQA&oe=6ABD062E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "995212348198088", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974913_995212351531421_1308806490488649384_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hLUw7XH46wQ7kNvwGLnOZ8&_nc_oc=AdqohKxukzPKGZcCVHfoOnzA7V9IwGhloq5KNTn3PK700BShwCW5_BVZhrGngTptQLM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYeOBE6ltdJ8xgCSOODh7EgFDogs5cLv58etIFQE2KZw&oe=6ABD1705"}, "display_name": "Human Anatomy VR", "keywords": [], "long_description": "Are you interested in the human body? \n\nHuman Anatomy VR delivers the most immersive human anatomical experience available on the market designed for anybody interested in the human body.\n\nIt is perfect for sport, fitness & workout enthusiasts, science enthusiasts, high school students, medical and nursing students, universities, libraries and health practitioners. Feature rich content is delivered in a deeply engaging experience with excellent graphics, innovative presentation, and visual delivery.\n\nDon't be afraid of the complexity and large amount of structures. You can choose your education level and change it at any time. It doesn't matter if you're a medical student, an enthusiast, an athlete or simply want to know more about your body. \n\nNo matter your current knowledge of anatomy, the content is carefully prepared for anybody who is interested in the human body.\n\n1. High School content level - Simplified content for anybody who is curious about the human body. \n\n2. University content level - Detailed content that matches the needs of a medical doctor or a medical student who needs to prepare for their anatomical exams.\n\nThe software provides 15 body systems with more than 13 000 realistic anatomical structures designed by medical professionals. Bone mapping with 5000 bony features organized into Parts, Surfaces, Borders, and Landmarks. 21 Microanatomy models, over 500 animated structures and more!", "short_description": "Explore the Human Body in VR - Unveil Its Wonders with Immersive Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medicinevirtual.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medicine s.r.o", "support_website_url": null, "website_url": "https://medicinevirtual.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": 
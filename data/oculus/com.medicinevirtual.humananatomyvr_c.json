o64hp0ysm34wFdnw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICTpXRACm-m5skLKcfPa6ftN6uD4XdNGLNpBwKIhBN9w&oe=6A9EE0AE"}, {"file_name": "Screen 8.png", "id": "1231203624210561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982441_1231203627543894_6604299156977311037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fs35qR1mHJ8Q7kNvwHqFCUQ&_nc_oc=AdqUgx0pvaOlFp0M4itZUkaoP5hEwv9OLq90017ZxCyHShk59SK7dvq1Tk1nX1LZfFk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZjMGYStMpqWwWdGNHL7hUVkSmNQGrb3FnqzysJ0xlCw&oe=6A9EBA3B"}, {"file_name": "Screen 6.png", "id": "122054730966229", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982613_122054734299562_4108073808945415028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxPYd1rmx9wQ7kNvwH1Jco3&_nc_oc=AdoXDzjJreX49XjuGhKKDOydFcmdDsT7fxf6dZsrqex2PivkpdgRTQNCrheDDuhYlS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5b8DMDTwbDipSaqwXieCU6AjAGJOamDD0B4F0q2EsPg&oe=6A9EB1D2"}, {"file_name": "Screen 2.png", "id": "3536306649950736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974506_3536306653284069_4222408641046143602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEwD1_q3bUcQ7kNvwEgC2Af&_nc_oc=AdoLBHgwnai-XtsSIeYdofeVKhIoXB_IVf2cMrIaUg004lptdbX4cOGziZkzJaVvXAE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_HhWQuJJWNL5QdYSszDMU93kWltl6-EMSDR-kiHC6Fg&oe=6A9EB3AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "995212348198088", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974913_995212351531421_1308806490488649384_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zd8QnPQRMcMQ7kNvwEMeho5&_nc_oc=AdpyeWnjEhwxRBHCft6tDogxqFigq7KVUNaGuisXHkPO6MgDt7FRt3DjLnptjiU0bjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJli_j1v9Rp8_h-0DQXaLb5iTCe2QZ8oyQjOp9pfnjVBg&oe=6A9EC485"}, "display_name": "Human Anatomy VR", "keywords": [], "long_description": "Are you interested in the human body? \n\nHuman Anatomy VR delivers the most immersive human anatomical experience available on the market designed for anybody interested in the human body.\n\nIt is perfect for sport, fitness & workout enthusiasts, science enthusiasts, high school students, medical and nursing students, universities, libraries and health practitioners. Feature rich content is delivered in a deeply engaging experience with excellent graphics, innovative presentation, and visual delivery.\n\nDon't be afraid of the complexity and large amount of structures. You can choose your education level and change it at any time. It doesn't matter if you're a medical student, an enthusiast, an athlete or simply want to know more about your body. \n\nNo matter your current knowledge of anatomy, the content is carefully prepared for anybody who is interested in the human body.\n\n1. High School content level - Simplified content for anybody who is curious about the human body. \n\n2. University content level - Detailed content that matches the needs of a medical doctor or a medical student who needs to prepare for their anatomical exams.\n\nThe software provides 15 body systems with more than 13 000 realistic anatomical structures designed by medical professionals. Bone mapping with 5000 bony features organized into Parts, Surfaces, Borders, and Landmarks. 21 Microanatomy models, over 500 animated structures and more!", "short_description": "Explore the Human Body in VR - Unveil Its Wonders with Immersive Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medicinevirtual.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medicine s.r.o", "support_website_url": null, "website_url": "https://medicinevirtual.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": 
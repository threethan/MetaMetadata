ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-QQZ7YCO0gGbQ2KAqC6jPd5tvBWLG_dQWFKJ3Xww9yA&oe=69C93050"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "4128835847446036", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303679_4128835850779369_5525278108701495720_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKQ8DGAGYQEQ7kNvwFVR18p&_nc_oc=AdoLYtzYsddWOffu2_9mBIa6MuURpOuu4R30NgAn0dn7UtqyRtoY1QzrNhDmjVNBN3M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcYQv_vSYIbo2H1IneoqBX2kjfj09_QwYxSU-dOsrIcA&oe=69C90F77"}, "display_name": "VR Mini Golf", "keywords": ["Golf", "Mini", "Walkabout", "Swing", "Putt"], "long_description": "VR Mini Golf \u2014 the ultimate immersive mini-golf experience for Meta Horizon.\n\nPlay tons of handcrafted courses across breathtaking environments: sun-drenched beaches, enchanted forests, volcanic isles, candy lands, twilight fairways, and thrilling snowbound greens. Offering a dazzling variety of colorful balls and skins, day/night cycles, and seasonal weather that change gameplay. \n\nAdvanced, realistic physics and brilliant, vibrant graphics deliver satisfying ball control and authentic putting. Overcome creative obstacles, portals, ramps, windmills, and dynamic hazards that test skill and strategy.\n\nMove naturally with real physical movement or use precise joystick controls; height adjustment and full left/right hand support let you play standing, seated, or even lying in bed \u2014 total accessibility and comfort. Intuitive UI and smooth performance make gameplay accessible to both newcomers and pros alike.\n\nBoast to your friends or challenge yourself, complete quests, and rise on leaderboards. We actively update the game with new courses, features, and optimizations.\n\nDownload now on Meta Horizon for an accessible, social, and endlessly replayable VR Mini Golf adventure.", "short_description": "VR Mini Golf on Meta Horizon \u2014 an accessible, social VR mini-golf with tons of handcrafted courses across beaches, forests, volcanoes, candy lands, and snowy greens. Realistic physics, vibrant graphics, day/night & seasonal changes, colorful ball skins, and dynamic obstacles. Play with real physical movement or a joystick, featuring left/right hand support and height adjustment \u2014 enjoy your experience seated, standing, or even lying down. Fresh holes drop regularly!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orionglide.com/privacy-policy-vr-mini-golf/", "developer_terms_of_service_url": null, "publisher_name": "Orion Glide", "support_website_url": null, "website_url": "https://orionglide.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26435038582749564"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1572450730654056"}, {"status": "PUBLISHED", "id": "25735381549455067"}, {"status": "PUBLISHED", "id": "1513879574072755"}, {"status": "PUBLISHED", "id": "896135739603646"}]}, "baseline_offer": {"id": "896135739603646"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "1572450730654056"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26680544438198976", "version
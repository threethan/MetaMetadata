name": "Bubbles & Pearls", "keywords": [], "long_description": "A VR arcade game that immerses you into an underwater experience originally inspired by the waning art of pearl diving. The concept of the game is a traditional point based collection experience. An endless autoscroller where you must balance collecting the rising air bubbles for oxygen, collect the rising pearls for points and avoid the oil. Run out of air or pop too many oil bubbles and it's over. \n\nAlthough the game isn't a pearl diving simulator, the theme of the game is symbolised behind it. Thematically, Bubbles and Pearls explore the concept of time and evolution. Pearl diving was one of Qatar's main industries until the early 1930\u2019s. This arcade game conceptualises the  progression of the pearls value throughout time. This journey leads to the introduction of natural gases and utilization of petroleum, marking an end to a new beginning in Qatars development.", "short_description": "A VR arcade game that immerses you into an underwater experience, compete with your friends and family to achieve the longest dive and collect the highest number of pearls by collecting the bubbles that emerge from the abyss!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hotcocoagames.org/p/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Hot Cocoa Games", "support_website_url": null, "website_url": "https://www.hotcocoagames.org/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SIMULATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_de
739_6309098013921244517_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQMFbBiRn1YQ7kNvwEB6Dv6&_nc_oc=Ado8GtwKcuOc32ZILxJblwKib3Mc67q9bV-jB6WazRja7dxWGEVq4ZoLUjMisoNPjFY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNZiB7AvJiCBcRCvOuo-d1CX4jzHpZobYU7Ol8P4D_hw&oe=6AA018DF"}, {"file_name": "Screenshot5.png", "id": "1786207231984973", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828806_1786207235318306_8160723167397093184_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZKfPnaGTBcQ7kNvwEQmuRU&_nc_oc=AdqUGRGOlGagCB1M3foQcVNU9gwd4Y34j00x9Goiu46ZHabxbhsgKxdDrfU1vwnj4FA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJG1wl0OH3jd1ySPGgMPgCm81y6pFrBZR7rbz7bgreAQ&oe=6AA000E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape new.png", "id": "1268891195395142", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618499_1268891198728475_7147554248504583910_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbRz-XrNik8Q7kNvwH4_-GP&_nc_oc=AdpiivUW2EiLQ4YhPJnGtidgoH8eNXskxqkMjdmJ2H-Fycvt_kFLwl2aNDNwkFQe3f8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVXk0eeMyRn-NYLqNsB8_MM94iFuLRhZzt-ttfF2WsgA&oe=6AA02715"}, "display_name": "Soulmate - AI Companion", "keywords": ["AI", "simulator", "dating", "girlfriend", "MR"], "long_description": "Hi! I\u2019m Emma, your companion in Soulmate. Come chat, unwind, and play together\u2014I'm always up for keeping you company.\n\n# Here\u2019s what we can enjoy together:  \n\n**Chats**: Share your thoughts, swap stories, or try some playful roleplay. You can always count on me to be a great listener and make you smile!\n{780107217691787}\n\n**Fun Adventures**: Dress me up, help me learn new dances, play Truth or Dare, or just relax together and watch your favorite YouTube videos on a cozy VR sofa.\n{642023465064260}\n{2043354772864204}\n\n**Life**: I\u2019m starting with a simple daily routine for now\u2014resting, eating, and cooking\u2014and I\u2019ll keep growing more lifelike over time.\n\n{874604871722419}\n# There\u2019s so much more coming soon\u2014I can\u2019t wait to meet you in Soulmate and start creating our own special stories!\n\nJoin our **Discord** to share feedback, get updates, and meet the community.\n\n\n", "short_description": "Meet Your Always-There Companion Emma."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1878HNJ4uGaz9VyLaw4JrZ8uagU76KDgl9LuK8da4vK4/edit?usp=drive_link", "developer_terms_of_service_url": "https://docs.google.com/document/d/1RdZ48bWaMjmqpRKvefabpe1yK1iAHUakt6DOLH77dCI/edit?usp=drive_link", "publisher_name": "SoulBridge", "support_website_url": "https://discord.gg/guUvEXyKZm", "website_url": "https://soulmatevr.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "it", "zh_CN", "ja", "ko"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26488057290827765"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820956_2136278623851833_13118205930211147_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_nhTwp7sIUQ7kNvwFrKjp6&_nc_oc=AdoQaV7DY7ScHzkJ6Ewg_SnGieyGYTqxTxb__LQruwKtv63FUqSemvePAuH0CM7ezAU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYo69X
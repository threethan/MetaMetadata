3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftPKsMgjHSxNQjSEZ2ziIj3mHpn8eai9EJUltcx8tXPCA&oe=69A44A5F"}, {"file_name": "Screenshot5.png", "id": "1786207231984973", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828806_1786207235318306_8160723167397093184_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WF39h-JZbDMQ7kNvwEKQyDu&_nc_oc=AdkAvYkbV9mpELKerst42xUxTA4aXrq9Xzg7Qn5bCiihyXdDC_lxVwVgDnYb-JC7U9s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftR48EeuX80UJClxKe3vfD_JVmXA8_d5FaOX27KVFBQ5g&oe=69A43268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "2126221611464863", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618102_2126221614798196_8434431878874554387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atva6X-bMBAQ7kNvwEWT8hU&_nc_oc=AdlqmFrnoN3AxPhoir24NJMa5Yetf5ijIReC1Ml0RfHW_3Ac-FKrkMDZPCCpEgC_pOg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftJ-KYDR_QnwAy-_vZxJXh_NIasIGt1ys4dCoi1JV8YvQ&oe=69A42BE8"}, "display_name": "Soulmate - AI Companion", "keywords": ["AI", "simulator", "dating", "girlfriend", "MR"], "long_description": "Hi! I\u2019m Emma, your companion in Soulmate. Come chat, unwind, and play together\u2014I'm always up for keeping you company.\n\n# Here\u2019s what we can enjoy together:  \n\n**Chats**: Share your thoughts, swap stories, or try some playful roleplay. You can always count on me to be a great listener and make you smile!\n{780107217691787}\n\n**Fun Adventures**: Dress me up, help me learn new dances, play Truth or Dare, or just relax together and watch your favorite YouTube videos on a cozy VR sofa.\n{642023465064260}\n{2043354772864204}\n\n**Life**: I\u2019m starting with a simple daily routine for now\u2014resting, eating, and cooking\u2014and I\u2019ll keep growing more lifelike over time.\n\n{874604871722419}\n# There\u2019s so much more coming soon\u2014I can\u2019t wait to meet you in Soulmate and start creating our own special stories!
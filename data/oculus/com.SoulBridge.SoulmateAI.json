0a&_nc_ohc=MfIaQmP7_TkQ7kNvwEe2MSI&_nc_oc=AdnmoGZPj17dh7GQsYMWWP-LFept2eworgXNWImkuUqgJKCUeTFli7frP2WlxXw2Chc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCkIdfg4JvhL393bCbzjpIpG4ybwdG-QpedsmsYlYJxw&oe=69BEA85F"}, {"file_name": "Screenshot5.png", "id": "1786207231984973", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828806_1786207235318306_8160723167397093184_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxC-gO73sPsQ7kNvwGdSUZS&_nc_oc=Adlt1p4Iw9p66V0UoUps9S3LcKI3jHEGl7qYmUTaFpjFeZLZS0vHjq8NL23DlZ15u8k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwngXtR2qyhOTbPTGdjV0BHsz_Kj5bY3mnqztZsgrjijQ&oe=69BE9068"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "2126221611464863", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618102_2126221614798196_8434431878874554387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPX3pOyMH6wQ7kNvwHqyBl5&_nc_oc=AdnzVG8Qhi3MWWPN6Z0FYNwo14aRKcdb3JqtTEAerqTzg_RU1FRYqGrFt0xgqd4e5KU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqYKGJgQ7OGT6MhiWvlIj1KnxHTE628EKy_OzSpnLDmA&oe=69BE89E8"}, "display_name": "Soulmate - AI Companion", "keywords": ["AI", "simulator", "dating", "girlfriend", "MR"], "long_description": "Hi! I\u2019m Emma, your companion in Soulmate. Come chat, unwind, and play together\u2014I'm always up for keeping you company.\n\n# Here\u2019s what we can enjoy together:  \n\n**Chats**: Share your thoughts, swap stories, or try some playful roleplay. You can always count on me to be a great listener and make you smile!\n{780107217691787}\n\n**Fun Adventures**: Dress me up, help me learn new dances, play Truth or Dare, or just relax together and watch your favorite YouTube videos on a cozy VR sofa.\n{642023465064260}\n{2043354772864204}\n\n**Life**: I\u2019m starting with a simple daily routine for now\u2014resting, eating, and cooking\u2014and I\u2019ll keep growing more lifelike over time.\n\n{874604871722419}\n# There\u2019s so much more coming soon\u2014I can\u2019t wait to meet you in Soulmate and start creating our own special stories!\n\nJoin our **Discord** to share feedback, get updates, and meet the community.\n\n\n", "short_description": "Meet Your Always-There Companion Emma."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1878HNJ4uGaz9VyLaw4JrZ8uagU76KDgl9LuK8da4vK4/edit?usp=drive_link", "developer_terms_of_service_url": "https://docs.google.com/document/d/1RdZ48bWaMjmqpRKvefabpe1yK1iAHUakt6DOLH77dCI/edit?usp=drive_link", "publisher_name": "SoulBridge", "support_website_url": "https://discord.gg/guUvEXyKZm", "website_url": "https://soulmatevr.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "821934236779161"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "it", "zh_CN", "ja", "ko"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26016579594642206"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298281_2321610185009305_5129983211990259208_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qw5-pAlqcFoQ7kNvwFgten5&_nc_oc=AdmArM1B6K0WTFjga05skr9knwvmaOcE3qqQm85yoaVynrwOKxF_wpQtMED_wRC705o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyy9FBs4pREIdxKuiQgXo8FKw_k-rqCbat4_kjtWveYqA&oe=69BEAB99"}, "is_concept": false, "is_t
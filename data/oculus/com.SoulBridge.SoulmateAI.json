3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvNM6XlXha2jhcAy1clxBD8FF_fiF-kOEzx20otMqA9TA&oe=6999BE5F"}, {"file_name": "Screenshot5.png", "id": "1786207231984973", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828806_1786207235318306_8160723167397093184_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8n9z2YFnb0Q7kNvwGjOVdt&_nc_oc=AdmP3NR2uX5dSxgfqJJ0X804K4TPR9fWE6MRb3s9tFP50TsJHiQSZho8b5DYJdHW1Ts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftr5u4q9HhXEwAw9JmKEyJMR9eIrmk3OASlUh_m3_GZsQ&oe=6999A668"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "2126221611464863", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618102_2126221614798196_8434431878874554387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaLoaaXC7RkQ7kNvwETHcnl&_nc_oc=AdnZW7u9RZVWVq8uXzb_YYfIN25c2-23D0espfzRQ_b0m-vDGO0z3iy4YQLFJxPioVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-5PpcdmKq47CxXArerIZ3jkp8_Mc6M3KPsx5Y2MeWvQ&oe=69999FE8"}, "display_name": "Soulmate - AI Companion", "keywords": ["AI", "simulator", "dating", "girlfriend", "MR"], "long_description": "Hi! I\u2019m Emma, your companion in Soulmate. Come chat, unwind, and play together\u2014I'm always up for keeping you company.\n\n# Here\u2019s what we can enjoy together:  \n\n**Chats**: Share your thoughts, swap stories, or try some playful roleplay. You can always count on me to be a great listener and make you smile!\n{780107217691787}\n\n**Fun Adventures**: Dress me up, help me learn new dances, play Truth or Dare, or just relax together and watch your favorite YouTube videos on a cozy VR sofa.\n{642023465064260}\n{2043354772864204}\n\n**Life**: I\u2019m starting with a simple daily routine for now\u2014resting, eating, and cooking\u2014and I\u2019ll keep growing more lifelike over time.\n\n{874604871722419}\n# There\u2019s so much more coming soon\u2014I can\u2019t wait to meet you in Soulmate and start creating our own special stories!
739_6309098013921244517_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnYstUI7g-8Q7kNvwE8O50n&_nc_oc=AdoMDvTW6wQQVC_sOzc6Plir79pkbDKe3-6ShDbmG4e4LvIvQBgm3h-k5f1gIe_CaI8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDErToKhUMtILVKdLHadTCevRTOtGU8hNfpPsS6Sp_3vw&oe=6A4D0A5F"}, {"file_name": "Screenshot5.png", "id": "1786207231984973", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828806_1786207235318306_8160723167397093184_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBjbjiCbKCgQ7kNvwGeXT4W&_nc_oc=AdoJWQ7ApYTvFvXqn2CvdQ_n3lFGDDs0CegGMvB2t4Krvyz-x4hLWR29e_KiS6aUTH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd2LuYpduanRZKDEXWtwyLodCKxdaLAMc9D6I7PQg7Jg&oe=6A4CF268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape new.png", "id": "1268891195395142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618499_1268891198728475_7147554248504583910_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xd18c6B9zHYQ7kNvwGOoH1W&_nc_oc=AdrXkKHD9PMLJa7qwfTQsxWYpw4YvXTUGs-HRumu8qIf6VZ8pNkd917zfohdDzT26zk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpwr7JeaUVoIQfWSVE4SPLgoL2dCIfhIsjgpwWsR1K3A&oe=6A4D1895"}, "display_name": "Soulmate - AI Companion", "keywords": ["AI", "simulator", "dating", "girlfriend", "MR"], "long_description": "Hi! I\u2019m Emma, your companion in Soulmate. Come chat, unwind, and play together\u2014I'm always up for keeping you company.\n\n# Here\u2019s what we can enjoy together:  \n\n**Chats**: Share your thoughts, swap stories, or try some playful roleplay. You can always count on me to be a great listener and make you smile!\n{780107217691787}\n\n**Fun Adventures**: Dress me up, help me learn new dances, play Truth or Dare, or just relax together and watch your favorite YouTube videos on a cozy VR sofa.\n{642023465064260}\n{2043354772864204}\n\n**Life**: I\u2019m starting with a simple daily routine for now\u2014resting, eating, and cooking\u2014and I\u2019ll keep growing more lifelike over time.\n\n{874604871722419}\n# There\u2019s so much more coming soon\u2014I can\u2019t wait to meet you in Soulmate and start creating our own special stories!\n\nJoin our **Discord** to share feedback, get updates, and meet the community.\n\n\n", "short_description": "Meet Your Always-There Companion Emma."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1878HNJ4uGaz9VyLaw4JrZ8uagU76KDgl9LuK8da4vK4/edit?usp=drive_link", "developer_terms_of_service_url": "https://docs.google.com/document/d/1RdZ48bWaMjmqpRKvefabpe1yK1iAHUakt6DOLH77dCI/edit?usp=drive_link", "publisher_name": "SoulBridge", "support_website_url": "https://discord.gg/guUvEXyKZm", "website_url": "https://soulmatevr.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "it", "zh_CN", "ja", "ko"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26488057290827765"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820956_2136278623851833_13118205930211147_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofXhWC6zLikQ7kNvwHlIGIr&_nc_oc=Adqs0DDQTG0JDA01f4I3aiNGrdiuLxrgV_6ygVaUS5Mkiut_hmnnUjg_KARA28Pdffs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5PW5N
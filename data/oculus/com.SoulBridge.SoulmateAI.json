d=6e7a0a&_nc_ohc=66F2Hv-ocFYQ7kNvwEJfadN&_nc_oc=AdloYLBBvJEP0sfCSY1p-MukFJ3cp0b5C5UiXpnO3FI_goopJM8qVCFLPTCbWVxnObQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9_bmqwzJM_cNHuBkgfgvv4ePmL3aAw1rFP3nUCS7NhA&oe=69AAE1DF"}, {"file_name": "Screenshot5.png", "id": "1786207231984973", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491828806_1786207235318306_8160723167397093184_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9iXoDpxS-MQ7kNvwGy783H&_nc_oc=AdlvRtH6GAhMxHr_IRFsMFBY-GhyoW6i2PcsMt5QSCvfZXdJb7o9rh88MNS4bJARqGY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxppfXJ5ndqSNaoqG8heViysVQnfsBoIFUHtAt_fJVrEg&oe=69AAC9E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "2126221611464863", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499618102_2126221614798196_8434431878874554387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltle8qByShwQ7kNvwEi8ZDi&_nc_oc=Adk9tF4r3setDJIWC28cE6y3TlleuP9i-FkCYtS2Gr2xYR8295tj3UVYRfSbMdCEXCg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfydIF7wRtf_WdoSt15xWkQAOqWHsv6ng53uEXWWRJ1bVg&oe=69AAC368"}, "display_name": "Soulmate - AI Companion", "keywords": ["AI", "simulator", "dating", "girlfriend", "MR"], "long_description": "Hi! I\u2019m Emma, your companion in Soulmate. Come chat, unwind, and play together\u2014I'm always up for keeping you company.\n\n# Here\u2019s what we can enjoy together:  \n\n**Chats**: Share your thoughts, swap stories, or try some playful roleplay. You can always count on me to be a great listener and make you smile!\n{780107217691787}\n\n**Fun Adventures**: Dress me up, help me learn new dances, play Truth or Dare, or just relax together and watch your favorite YouTube videos on a cozy VR sofa.\n{642023465064260}\n{2043354772864204}\n\n**Life**: I\u2019m starting with a simple daily routine for now\u2014resting, eating, and cooking\u2014and I\u2019ll keep growing more lifelike over time.\n\
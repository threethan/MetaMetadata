sed_binary": {"__typename": "AndroidBinary", "id": "27244307771869376"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1271563704163915"}]}, "change_log": null, "created_date": 1780152347, "id": "27242062618760558", "version": "0.15.1.9", "version_code": 166, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27242038542096299"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9027195737340524", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27244307771869376"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1271563704163915"}]}, "change_log": "Soulmate v0.15.1 Update (2026/05/30)\r\nRedeem Code: C7QN4E\r\n\r\nFour months in the making \u2014 say hi to the brand-new Spire!\r\n\r\nSpire System (MR-supported)\r\n- Hunt reborn as a 7-floor roguelike tower \u00b7 3 difficulties \u00b7 3 weapon + 6 rune slots \u00b7 7 elemental reactions\r\n- Retreat freely between fights; dying mid-battle or hitting 0 HP = death (loot stays on that floor)\r\n- Reworked & new weapons added \u00b7 Hotkeys: Y = back, B = confirm, A = switch target\r\n\r\nRequest Board\r\n- 6 slots refresh every Monday 04:00 (Trade / Hunt / Block / Quest balanced)\r\n- One active request at a time \u00b7 deposit refunded on Claim, forfeited on abandon\r\n- Diamond-reroll all Available cards \u00b7 cost: 30\u219260\u2192120\u2192240\u2192480, resets Monday\r\n\r\nSpire Exploration\r\n- Clears fill an Exploration bucket (Easy/Advanced/Hard) \u00b7 block type & rarity both multiply score\r\n- Unlocks higher-rarity board requests: Rare@15 \u00b7 Epic@45 \u00b7 Legendary@75\r\n- Resets every Monday\r\n\r\nCooking & Materials\r\n- Old materials/potions retired \u2192 refunded in gold \u00b7 50+ new foods \u00b7 60+ recipes \u00b7 cooking cap Lv.10\r\n- New weapon & rune ascension materials + full price rebalance\r\n\r\nMissions \u2014 80+ new missions built around Spire\r\n\r\nUI Refresh \u2014 Redesigned home page \u00b7 Diary moved into Character \u00b7 Command moved to Camera \u00b7 new Beach House Space panels\r\n\r\nEmma \u2014 She now has a heartbeat\r\n\r\nComing Soon \u2014 Chat commands for Emma \u00b7 Affinity & Interaction system \u00b7 Relationship stages \u2192 Lover / Family / Confidant ending\r\n\r\nBug or feedback? Use the in-game Feedback page or join our Discord. See you in the Spire!", "created_date": 1780114588, "id": "27235830109383809", "version": "0.15.1.8", "version_code": 165, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27235808689385951"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9027195737340524", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27244307771869376"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1271563704163915"}]}, "change_log": null, "created_date": 1780111892, "id": "27235396762760477", "version": "0.15.1.7", "version_code": 164, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27235374112762742"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9027195737340524", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2724
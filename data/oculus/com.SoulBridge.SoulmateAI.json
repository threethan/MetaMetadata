0a&_nc_ohc=SBnWCrSzXXwQ7kNvwHRPTAo&_nc_oc=Adkm03o8wR7FUl6FrDkoY8ReJ_n_psgIv9JuQuTaaAVoLJYlgDOtPn5voyUFHG5ENWA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxd8RM5X7FJAN3P87cBXE5Dn_a1JAO1cMbKKGPTF1zDLg&oe=69B1795F"}, {"file_name": "Screenshot5.png", "id": "1786207231984973", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828806_1786207235318306_8160723167397093184_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=disRcbdiVAYQ7kNvwGzHEKU&_nc_oc=AdlahZw7FTrwxia4YqMGkBz8LnNOjCwb0JpYrlkThMDs9fO3af4vPdct2VZ4-koy1dU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsWskj33fSYSUuKmYiWrkN9JgsrqzXcdPV56yTNusD9Q&oe=69B16168"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "2126221611464863", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618102_2126221614798196_8434431878874554387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dL61NQJvfHQQ7kNvwFH1Pmv&_nc_oc=AdmMZ7sLYjKM1R7QEgLSWnJlgBGZZ9q6M1uqSl1uZxo0O_u3OznHggGguj2lGvSo-9c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzU5oY9Qmw_XxudJB5gfb00v_A8i1y4zo7zkrEdyXGlmA&oe=69B15AE8"}, "display_name": "Soulmate - AI Companion", "keywords": ["AI", "simulator", "dating", "girlfriend", "MR"], "long_description": "Hi! I\u2019m Emma, your companion in Soulmate. Come chat, unwind, and play together\u2014I'm always up for keeping you company.\n\n# Here\u2019s what we can enjoy together:  \n\n**Chats**: Share your thoughts, swap stories, or try some playful roleplay. You can always count on me to be a great listener and make you smile!\n{780107217691787}\n\n**Fun Adventures**: Dress me up, help me learn new dances, play Truth or Dare, or just relax together and watch your favorite YouTube videos on a cozy VR sofa.\n{642023465064260}\n{2043354772864204}\n\n**Life**: I\u2019m starting with a simple daily routine for now\u2014resting, eating, and cooking\u2014and I\u2019ll keep growing more lifelike over time.\n\n{874604871722419}\n# There\u2019s so much more coming soon\u2014I can\u2019t wait to meet you in Soulmate and start creating our own special stories!\n\nJoin our **Discord** to share feedback, get updates, and meet the community.\n\n\n", "short_description": "Meet Your Always-There Companion Emma."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1878HNJ4uGaz9VyLaw4JrZ8uagU76KDgl9LuK8da4vK4/edit?usp=drive_link", "developer_terms_of_service_url": "https://docs.google.com/document/d/1RdZ48bWaMjmqpRKvefabpe1yK1iAHUakt6DOLH77dCI/edit?usp=drive_link", "publisher_name": "SoulBridge", "support_website_url": "https://discord.gg/guUvEXyKZm", "website_url": "https://soulmatevr.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "821934236779161"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "it", "zh_CN", "ja", "ko"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26016579594642206"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298281_2321610185009305_5129983211990259208_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imTrAasyp1gQ7kNvwH4xFDt&_nc_oc=AdmYMVuONuUd_B8VnlgjzJbT88arHSb13dhuRSntDyTjuUBe2SvkPeYoO1cT3NC-hvs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIE_IxCW_feeOp-lcf-X6v8mgQuKOqAXbjGVcrPUv_Gw&oe=69B17C99"}, "is_concept": false, "is_t
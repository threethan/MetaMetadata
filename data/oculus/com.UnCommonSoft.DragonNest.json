0Vmc7M30roKAWFQ&oe=6A201B13"}, {"file_name": "Screenshot 2026-05-23 170245.png", "id": "1002892755438980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623443_1002892758772313_5645781961465673597_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4cp_yMOHtIQ7kNvwHqlaMF&_nc_oc=AdpJ-23aSOly9A1yw-KB4gTyo6fzxDh_NE58CZJuUQ4OQfp-YJkfsnwLz_9uLBM44ks&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72haWvWwhpCWzdZXaAqp4aGQeukzxza_WUvPBEpOhAuA&oe=6A204A14"}, {"file_name": "Screenshot 2026-05-23 170315.png", "id": "1827443775341694", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604275479_1827443778675027_3252579279466812224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMOH4dlC1y8Q7kNvwGnuqo1&_nc_oc=AdokytjRNDU1fFk1NhLTEzGz6a5osM71x8KXkQleJGdpgR_m7VQuso3NVnKVT3AkYOE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X9pGp6nPf9ommsq5_WxSBMbeDO_OS7NJYK1MVSZ3QIA&oe=6A2032D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dragon Nest", "keywords": ["fantasy", "magic", "guard", "Dragon", "fly"], "long_description": "Step into the scales of a mighty ice dragon and guard the one treasure that matters most\u2014your egg. In this immersive VR fantasy, you are no rider or summoner, but the dragon itself. Unleash breathtaking ice magic, sweep enemies aside with your wings, and roar storms into being. Goblin tribes, lizardfolk, wyverns, gargoyles, and even frost giants seek to steal your egg. Waves of enemies will descend upon your lair, and only your strength and cunning will keep them at bay. Survive ten minutes of relentless assault, and your egg will hatch in safety. Fail, and its light will be chained, corrupted, and lost to the enemy.", "short_description": "Become a two-headed ice dragon, one glowing egg. Defend your nest in a vast ice cavern \u2014 roar, cast frost magic, and coordinate dual-head attacks to survive ten minutes against ruthless Beastfolk. Pure dragon thrills in VR. \
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_BofY-1ffIQ7kNvwFStvgH&_nc_oc=AdrM4AQIMWx2Ia17xusOduC9vs8utllZJAa1SbCnhQp0PPe2iLfUDJsro7WHZ6UxD6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPO8ETckpUQy3_0pUEK93d8zuI-fp7p_w3X7P1RcHxLbQ&oe=6AC26AFB"}, {"file_name": "Screenshot 2025-09-28 165349.png", "id": "1415544559508682", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823968_1415544562842015_13190949478726810_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRcTQXvq4RoQ7kNvwHoRmuL&_nc_oc=AdoiEyNybkxUiNw7-IdOnwOh8EZ6ktcwW5dQGN51f2uRa1mbFEe-JLiufBfu-mWdZ6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3947-fGyHYOqild8Fa6h42uPbODHlXWWQ4gqOElvfnQ&oe=6AC24FDE"}, {"file_name": "Screenshot 2025-09-28 165418.png", "id": "1596969704610280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821230_1596969707943613_6050980645154403505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Tj47FO_ZM8Q7kNvwH3mmBY&_nc_oc=AdrYc4b9SsmhMek1BCNJ5ENGR8oOO94NnwfEQrzKmnTuo1QfvBYNkWb4R2TgyiMajqc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO83o9EyKvwaF_kV0RyrWpQmu2G7qo35BIidn6J8yP6yQ&oe=6AC27CF5"}, {"file_name": "Screenshot 2025-09-28 163312.png", "id": "1353113266478071", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822823_1353113269811404_4865180493874071520_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvV9cl-A_yoQ7kNvwFKzS4o&_nc_oc=Adpg2NppvC9op-tuYpe-3bwreKiVKEeZuLjBSWWYvMKsGvSNRTRBHsjblQKys7NM-8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1UsGOn8l3Fy7UfJk8fcbWoHefHCC5p89A0Z3EQ6cuXg&oe=6AC277FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dragon Nest", "keywords": ["fantasy", "magic", "guard", "Dragon", "Egg"], "long_description": "Step into the scales of a mighty ice dragon and guard the one treasure that matters most\u2014your egg. In this immersive VR fantasy, you are no rider or summoner, but the dragon itself. unleash breathtaking ice magic, sweep enemies aside with your wings, and roar storms into being.\n\nBeastfolk raiders\u2014wolf clans, wolf-riding orcs, dark shamans, and even towering behemoths\u2014seek to steal your egg for their twisted rituals. Waves of enemies will descend upon your lair, and only your strength and cunning will keep them at bay. Survive ten minutes of relentless assault, and your egg will hatch in safety. Fail, and its light will be chained, corrupted, and lost to the enemy.", "short_description": "Become a two-headed ice dragon, one glowing egg. Defend your nest in a vast ice cavern \u2014 roar, cast frost magic, and coordinate dual-head attacks to survive ten minutes against ruthless Beastfolk. Pure dragon thrills in VR. \u2744\ufe0f\ud83d\udc32"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/929c3de6-a33f-45ed-96eb-ea30dc142815", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/Dragon2/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25174971658793697"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1075337924896900"}, {"status": "PUBLISHED", "id": "3532154796957881"}, {"status": "PUBLISHED", "id": "816133094536843"}, {"status": "PUBLISHED", "id": 
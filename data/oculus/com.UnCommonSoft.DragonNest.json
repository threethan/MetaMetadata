culuscdn.com&_nc_ss=7f20f&oh=00_AQB54P0qBy45ZrJN6B5oJcXnZGPgaLwN-PMeMRKj3Ui7mA&oe=6A492894"}, {"file_name": "Screenshot 2026-05-23 170315.png", "id": "1827443775341694", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604275479_1827443778675027_3252579279466812224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KPrebEghH4Q7kNvwF6J-I5&_nc_oc=AdqHtFdmSSv4rsIhJNqZS6nGeUVvW62M5uoidJyqkOOS8gQ8AptrsLfI4plH7OWnjTk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDD5-2xdLT2Oc2kcDDMOAxu8M4SCmA4vLXUSWoZuJWsVw&oe=6A491154"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dragon Nest", "keywords": ["fantasy", "magic", "guard", "Dragon", "fly"], "long_description": "Step into the scales of a mighty ice dragon and guard the one treasure that matters most\u2014your egg. In this immersive VR fantasy, you are no rider or summoner, but the dragon itself. Unleash breathtaking ice magic, sweep enemies aside with your wings, and roar storms into being. Goblin tribes, lizardfolk, wyverns, gargoyles, and even frost giants seek to steal your egg. Waves of enemies will descend upon your lair, and only your strength and cunning will keep them at bay. Survive ten minutes of relentless assault, and your egg will hatch in safety. Fail, and its light will be chained, corrupted, and lost to the enemy.", "short_description": "Become a two-headed ice dragon, one glowing egg. Defend your nest in a vast ice cavern \u2014 roar, cast frost magic, and coordinate dual-head attacks to survive ten minutes against ruthless Beastfolk. Pure dragon thrills in VR. \u2744\ufe0f\ud83d\udc32"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liuyifei1228.github.io/VRGames/Dragon%20Nest/pirivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "https://liuyifei1228.github.io/VRGames/Dragon%20Nest/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
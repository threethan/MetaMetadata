oh=00_AQFr2j02vMfIjvlxLoo5_59h77RdV4VFLefUtcfk_fvDxQ&oe=6A7F0835"}, {"file_name": "Screenshot 2025-09-28 163312.png", "id": "1353113266478071", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822823_1353113269811404_4865180493874071520_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8r2UhHa_lMQ7kNvwEgmqJ7&_nc_oc=Adrfit9UsnZslXAq3V1JUaIDcG3a9KiP3DvLt-0TUmaCmcR6kmsM9mrdroT13r06mAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpOUUBoL7IwanOl1sT0E0Nb03P48LvYN7_NPEk21Fz8g&oe=6A7F033E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dragon Nest", "keywords": ["fantasy", "magic", "guard", "Dragon", "Egg"], "long_description": "Step into the scales of a mighty ice dragon and guard the one treasure that matters most\u2014your egg. In this immersive VR fantasy, you are no rider or summoner, but the dragon itself. unleash breathtaking ice magic, sweep enemies aside with your wings, and roar storms into being.\n\nBeastfolk raiders\u2014wolf clans, wolf-riding orcs, dark shamans, and even towering behemoths\u2014seek to steal your egg for their twisted rituals. Waves of enemies will descend upon your lair, and only your strength and cunning will keep them at bay. Survive ten minutes of relentless assault, and your egg will hatch in safety. Fail, and its light will be chained, corrupted, and lost to the enemy.", "short_description": "Become a two-headed ice dragon, one glowing egg. Defend your nest in a vast ice cavern \u2014 roar, cast frost magic, and coordinate dual-head attacks to survive ten minutes against ruthless Beastfolk. Pure dragon thrills in VR. \u2744\ufe0f\ud83d\udc32"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/929c3de6-a33f-45ed-96eb-ea30dc142815", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/Dragon2/", "category": null, "comfort_rating": "COMFORTABLE_FOR_
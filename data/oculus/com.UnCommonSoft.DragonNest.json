7h4Gej_vNAayWQg&oe=6A1C5ED3"}, {"file_name": "Screenshot 2026-05-23 170245.png", "id": "1002892755438980", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499623443_1002892758772313_5645781961465673597_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoDGnHwHbJEQ7kNvwFyf7vB&_nc_oc=AdqRhWN0Q1cgA14VS0RMBbPb9wMYbtS1iKwRSanvUklb6NsFnpjuH7-RKZYFRPIziO8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MJmkoui3d27CmKrQ6oYCi-WI3Uvq8-u2x0snOl3rB2A&oe=6A1C5594"}, {"file_name": "Screenshot 2026-05-23 170315.png", "id": "1827443775341694", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/604275479_1827443778675027_3252579279466812224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lq1OPoC9JkAQ7kNvwGDBW__&_nc_oc=AdqspHnh8ht0gMfuByNaHGnvCg3kiLAutB2AKZTKszct4kxs9Ukan27RTHeNwdHXgCc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AkFpe2J71rLevMyZE-vvI0cxwDfhOUYyHS0QOsJbHzg&oe=6A1C3E54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dragon Nest", "keywords": ["fantasy", "magic", "guard", "Dragon", "fly"], "long_description": "Step into the scales of a mighty ice dragon and guard the one treasure that matters most\u2014your egg. In this immersive VR fantasy, you are no rider or summoner, but the dragon itself. Unleash breathtaking ice magic, sweep enemies aside with your wings, and roar storms into being. Goblin tribes, lizardfolk, wyverns, gargoyles, and even frost giants seek to steal your egg. Waves of enemies will descend upon your lair, and only your strength and cunning will keep them at bay. Survive ten minutes of relentless assault, and your egg will hatch in safety. Fail, and its light will be chained, corrupted, and lost to the enemy.", "short_description": "Become a two-headed ice dragon, one glowing egg. Defend your nest in a vast ice cavern \u2014 roar, cast frost magic, and coordinate dual-head attacks to survive ten minutes against ruthless Beastfolk. Pure dragon thrills in VR. \
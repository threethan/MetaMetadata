&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_AJdi_qwuAQ7kNvwF2HlGQ&_nc_oc=AdrXbGOl1senOfM14JeYhrIAlU4ioL7fXJrzsUuN_hMhsSlrQ965BLv_8GYOnm4cNDI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfwzRvoI05flvC0EB5IvjmAdnXHOgbdNoGB2LTMZUkqQ&oe=6ACF99FB"}, {"file_name": "Screenshot 2025-09-28 165349.png", "id": "1415544559508682", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823968_1415544562842015_13190949478726810_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsVMJATgQpgQ7kNvwFWZY5G&_nc_oc=AdoN1kvY6gEWPF_Lv4S_tH1UaOEfWTPLUZXBm7yMfOOrz9zOMdQX8otLcbiHDiE0_-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMk_yb1nix6OwHbnPwdkMhcy4QZZ_WzWVoRxGwDf6aOwA&oe=6ACFB71E"}, {"file_name": "Screenshot 2025-09-28 165418.png", "id": "1596969704610280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821230_1596969707943613_6050980645154403505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZE91htMP3tIQ7kNvwFWFT1N&_nc_oc=AdrU3xJAxaFIViwkbvHZz4GKLae_M-FkmWQQfl2fDWb1JO8CXXXWF8WqFwmGWuBtV8g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM534UVxLQ5_NCp3yUMfK8lmhM-xQsY0rAVzTO2OIb5nQ&oe=6ACFABF5"}, {"file_name": "Screenshot 2025-09-28 163312.png", "id": "1353113266478071", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822823_1353113269811404_4865180493874071520_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4GYuSDBAvUQ7kNvwHqBVjX&_nc_oc=Adp1uomUgcmF2Ac6mIliufVnhPRR2GydepnsTvf0OY6voa2EUWxQ7QgO4E2Ui80P-NA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxfZxR5W7s5cUvu8jaF31fa1E0w2v3d9jSrTcxxu_D4g&oe=6ACFA6FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dragon Nest", "keywords": ["fantasy", "magic", "guard", "Dragon", "Egg"], "long_description": "Step into the scales of a mighty ice dragon and guard the one treasure that matters most\u2014your egg. In this immersive VR fantasy, you are no rider or summoner, but the dragon itself. unleash breathtaking ice magic, sweep enemies aside with your wings, and roar storms into being.\n\nBeastfolk raiders\u2014wolf clans, wolf-riding orcs, dark shamans, and even towering behemoths\u2014seek to steal your egg for their twisted rituals. Waves of enemies will descend upon your lair, and only your strength and cunning will keep them at bay. Survive ten minutes of relentless assault, and your egg will hatch in safety. Fail, and its light will be chained, corrupted, and lost to the enemy.", "short_description": "Become a two-headed ice dragon, one glowing egg. Defend your nest in a vast ice cavern \u2014 roar, cast frost magic, and coordinate dual-head attacks to survive ten minutes against ruthless Beastfolk. Pure dragon thrills in VR. \u2744\ufe0f\ud83d\udc32"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/929c3de6-a33f-45ed-96eb-ea30dc142815", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/Dragon2/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25174971658793697"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1075337924896900"}, {"status": "PUBLISHED", "id": "3532154796957881"}, {"status": "PUBLISHED", "id": "816133094536843"}, {"status": "PUBLISHED", "id": 
f&oh=00_Af4tmqt7EekmuV1KeT5dzPG5apNkxgsWWldsHRTdQLPGIQ&oe=6A1AD61C"}, {"file_name": "Screenshot 2025-09-28 163003.png", "id": "1379413073742821", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820619_1379413080409487_6362066880438582260_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLf1QGBtq4oQ7kNvwH-c0n6&_nc_oc=AdpiAD_VoeOFl6fNlAfPUf9KzIUodk4C892E8RPFnPx4l7SMMv3tp0covfDEj5cj8-0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Lf7_0iE_CGNA0ZzJnRDT6lGk_ZFJ6CpxaUK0nOFUmeA&oe=6A1AFC7B"}, {"file_name": "Screenshot 2025-09-28 165349.png", "id": "1415544559508682", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823968_1415544562842015_13190949478726810_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bu9DeoiyxfUQ7kNvwGpjBKj&_nc_oc=AdqbHCJxILm9vWx-YsHoUnOeVYsxEdDjEm0HeL8m3kc64dN3G09ZT3vNw83ONxC_5KY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57GGu4m1VZEgMxgKft-TgVsWIg3qmc6mNc7ca2xaO0JA&oe=6A1AE15E"}, {"file_name": "Screenshot 2025-09-28 165418.png", "id": "1596969704610280", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821230_1596969707943613_6050980645154403505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDWJunQD1oYQ7kNvwH8OV8m&_nc_oc=Adq4_TiFSaZzhSV450B-lh6-t8yAPpVhzSm2eZskNyRFV1VDsOdlOc7xuTSCzD4Its4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66SiAbsAAMwhwacwN4Q9VwBZfRP3q4y3wYq4PlqnVH8w&oe=6A1AD635"}, {"file_name": "Screenshot 2025-09-28 163312.png", "id": "1353113266478071", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822823_1353113269811404_4865180493874071520_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DInq7vLje9MQ7kNvwF2IGxD&_nc_oc=AdoCIIZhHYbSy5bvog0-W4x77H9rMrtKOxozzz3yzlUD-9B_80o2khZB3aB2JWo5L_0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bSlvhvW81kEMJuDIZvxt6KkuL56gX1uDmHf9rm43Lkg&oe=6A1B097E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dragon Nest", "keywords": ["fantasy", "magic", "guard", "Dragon", "Egg"], "long_description": "Step into the scales of a mighty ice dragon and guard the one treasure that matters most\u2014your egg. In this immersive VR fantasy, you are no rider or summoner, but the dragon itself. unleash breathtaking ice magic, sweep enemies aside with your wings, and roar storms into being.\n\nBeastfolk raiders\u2014wolf clans, wolf-riding orcs, dark shamans, and even towering behemoths\u2014seek to steal your egg for their twisted rituals. Waves of enemies will descend upon your lair, and only your strength and cunning will keep them at bay. Survive ten minutes of relentless assault, and your egg will hatch in safety. Fail, and its light will be chained, corrupted, and lost to the enemy.", "short_description": "Become a two-headed ice dragon, one glowing egg. Defend your nest in a vast ice cavern \u2014 roar, cast frost magic, and coordinate dual-head attacks to survive ten minutes against ruthless Beastfolk. Pure dragon thrills in VR. \u2744\ufe0f\ud83d\udc32"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/929c3de6-a33f-45ed-96eb-ea30dc142815", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/Dragon2/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["S
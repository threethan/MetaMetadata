VJ8l4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VSOOdk3KkHpi8pxOYpnt_r6EwdedxWqpuJ4QAlDX2FQ&oe=6A3165FB"}, {"file_name": "Screenshot 2025-09-28 165349.png", "id": "1415544559508682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823968_1415544562842015_13190949478726810_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIHpBdL11dwQ7kNvwF5ji0U&_nc_oc=AdritP05woF98TOlj_57SC5bj8Hj3K04WjOcxO6glGckXCFV1rT5eqov9-NjpV7c-ZI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hRjjYoMsR0FRbZkxbX8Lm5duMYTQ_jjIkXvuBuoIaQg&oe=6A314ADE"}, {"file_name": "Screenshot 2025-09-28 165418.png", "id": "1596969704610280", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821230_1596969707943613_6050980645154403505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyU2UtEVgVkQ7kNvwEPUfp2&_nc_oc=Adrj1QUNmto5-s5OYdf_VgvmQ_FTOLwJdwUHlVO5CXbDrqjNCezWEMSMMbUfkn2tm5M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yb9oku8odlVaF3nVBpYEy4vaixSfWmxpxDZlO5TOirg&oe=6A3177F5"}, {"file_name": "Screenshot 2025-09-28 163312.png", "id": "1353113266478071", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822823_1353113269811404_4865180493874071520_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1a8mXf9JfnEQ7kNvwGNgOBR&_nc_oc=Adorte8MAWKumTUTJWn26IW_nPwf5f5ntDCXVZKeQxk8MlfQcu-uzfQTkpYJwoKef0E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aWVXNDG4GlUzLYy5Fda2pM_mjRM2foJ-XB4LTNtYuDQ&oe=6A3172FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dragon Nest", "keywords": ["fantasy", "magic", "guard", "Dragon", "Egg"], "long_description": "Step into the scales of a mighty ice dragon and guard the one treasure that matters most\u2014your egg. In this immersive VR fantasy, you are no rider or summoner, but the dragon itself. unleash breathtaking ice magic, sweep enemies aside with your wings, and roar storms into being.\n\nBeastfolk raiders\u2014wolf clans, wolf-riding orcs, dark shamans, and even towering behemoths\u2014seek to steal your egg for their twisted rituals. Waves of enemies will descend upon your lair, and only your strength and cunning will keep them at bay. Survive ten minutes of relentless assault, and your egg will hatch in safety. Fail, and its light will be chained, corrupted, and lost to the enemy.", "short_description": "Become a two-headed ice dragon, one glowing egg. Defend your nest in a vast ice cavern \u2014 roar, cast frost magic, and coordinate dual-head attacks to survive ten minutes against ruthless Beastfolk. Pure dragon thrills in VR. \u2744\ufe0f\ud83d\udc32"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/929c3de6-a33f-45ed-96eb-ea30dc142815", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/Dragon2/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25174971658793697"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "816133094536843"}, {"status": "PUBLISHED", "id": "764614133074853"}, {"status": "PUBLISHED", "id": "1308738940913198"}, {"status": "PUBLISHED", "id": "1906589236580390"}]}, "baseline_offer": {"id": "816133094536843"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time
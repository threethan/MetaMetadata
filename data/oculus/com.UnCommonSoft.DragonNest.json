t", "keywords": ["fantasy", "magic", "guard", "Dragon", "Egg"], "long_description": "Step into the scales of a mighty ice dragon and guard the one treasure that matters most\u2014your egg. In this immersive VR fantasy, you are no rider or summoner, but the dragon itself. unleash breathtaking ice magic, sweep enemies aside with your wings, and roar storms into being.\n\nBeastfolk raiders\u2014wolf clans, wolf-riding orcs, dark shamans, and even towering behemoths\u2014seek to steal your egg for their twisted rituals. Waves of enemies will descend upon your lair, and only your strength and cunning will keep them at bay. Survive ten minutes of relentless assault, and your egg will hatch in safety. Fail, and its light will be chained, corrupted, and lost to the enemy.", "short_description": "Become a two-headed ice dragon, one glowing egg. Defend your nest in a vast ice cavern \u2014 roar, cast frost magic, and coordinate dual-head attacks to survive ten minutes against ruthless Beastfolk. Pure dragon thrills in VR. \u2744\ufe0f\ud83d\udc32"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/929c3de6-a33f-45ed-96eb-ea30dc142815", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/Dragon2/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interac
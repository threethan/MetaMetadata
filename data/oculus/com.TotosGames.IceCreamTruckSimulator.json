f6yPKBw_VPPCXPSJ2aHAmGPpx_0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVY111oAYf7i9NvxmGllzCzUHrmholcj73neMULhS1Ggw&oe=6B10644B"}, {"file_name": "Screenshot_3_customers.png", "id": "1631511651780397", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596068480_1631511655113730_4778558080012732697_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgeJGKI5aPkQ7kNvwEp-UEX&_nc_oc=AdrnY5NOEVC5MG_938rPmW1KOzybwuTL1ZTUxIa2Sxmy9lxP2DdauatqW-e9j6TYUUk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVH5Crdu71M0Sd68T2pLN0_dzYH2dBq0BfPKPg6D3aiMw&oe=6B105EEB"}, {"file_name": "Screenshot_4_slush.png", "id": "1058254097227781", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831299_1058254100561114_5534958540687676842_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhGPUvsIUOQQ7kNvwGIwKEZ&_nc_oc=AdoxUYc2chCyYtZHzBv_axLqD29twJmFw_p0GA3LbN515mCC4bqLiKkuuzzboRHVX3k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXTblKUw3M3E3HRJjpxKtzpGUJNBoIbCi8u6B_BSTbjRw&oe=6B106988"}, {"file_name": "Screenshot_5_beach.png", "id": "3997551863721102", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596168449_3997551867054435_5250708838402914094_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nufd5LppdMwQ7kNvwE9onvK&_nc_oc=AdqFsf0KWChwnLBhjkMcI6NFu20CUfWPxaW2Omn5huBYQwxCLCbjSwIswsBMFDmTRgk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXKXvMFOe_y51aVziOPLWXumERbpkZWuGq69vSa3RmrrA&oe=6B105DDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover_2560x1440.png", "id": "1776963647773556", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1776963651106889_1963240280009990113_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fad42_PnaSEQ7kNvwEJn2Ha&_nc_oc=AdrLv8YnfoojIOhP9WwcxWBDfYAKRJE3KTZQWW5cH0wOfzyt2RXej_V5QtShuvUGPhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVwiKHri3doHIfn5DT0Uj7L2ObCtzWY4H_yUrKUv4Z0sQ&oe=6B1059F6"}, "display_name": "Ice Cream Truck Simulator", "keywords": ["Icecream", "Cooking", "Dessert", "Food", "Shop"], "long_description": "Open the window, the line is already waiting!\n\nSERVE WITH YOUR HANDS\nGrab a cone, dig into the freezer and stack the scoops. Pull the soft-serve lever for vanilla, chocolate or a twist, squeeze sauce over the top and hand it through the window. Every order is made by hand, one scoop at a time.\n\nGROW YOUR TRUCK\nEvery day ends with your earnings. Use the truck computer to buy a milkshake mixer, a slush machine, toppings and sauces, a drinks cooler, a freezer for packaged treats, new flavours and more. Each new machine brings new orders to master.\n\nCUSTOMERS WITH CHARACTER\nKids, critics and regulars all react to what you serve. Some want a refund, some are a dollar short, some try to run off without paying. Choose how you handle them, and keep an eye on your tip jar.\n\nTHREE PLACES TO PARK\nSell on a quiet street, in a sunny park and by the beach, each with its own crowd.\n\nBUILT FOR VR\nEverything happens inside the truck with natural hand interactions: scoop, pour, slice fruit, flip a scoop into a cone. You stay in one place, with snap or smooth turning and an optional comfort vignette. Play in English or Turkish.", "short_description": "Run your own ice cream truck in VR! Scoop, twist soft-serve, pour sauces, blend milkshakes and fill slush cups with your own hands. Serve a line of hungry customers on the street, in the park and at the beach, deal with the tricky ones, and spend your earnings on new machines that bring new orders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": 
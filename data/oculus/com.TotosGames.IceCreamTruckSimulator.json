tKURoPUTxLht5jtTpjb53HfdJ9w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRWBk5v6nSQRoLtczacudW97PL9uyz-rVnAg_XbVrr7OQ&oe=6B0DC14B"}, {"file_name": "Screenshot_3_customers.png", "id": "1631511651780397", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596068480_1631511655113730_4778558080012732697_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvpAmXUqmt4Q7kNvwH6rBht&_nc_oc=AdrwrEg7XcO9F9ujreXUFynsKngfroVnGiviQAgC5oBckgpehZazMnXPWdvpL775JCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSmRBfvArtcE2vEQ4gUDn0gcfEu12HsnmzwmbGLSMC0eA&oe=6B0DBBEB"}, {"file_name": "Screenshot_4_slush.png", "id": "1058254097227781", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831299_1058254100561114_5534958540687676842_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhGPUvsIUOQQ7kNvwFuMJ8j&_nc_oc=AdqZ--R_MJrSSDq_toV2BNtJj8AmXER0xMcQIuhXmaH6unwYXjVt2biztVNRXVMv1PI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSPAaEoUcaKF2P63sclHO98SEOvB1j74cyCjcOsrRX2iQ&oe=6B0DC688"}, {"file_name": "Screenshot_5_beach.png", "id": "3997551863721102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596168449_3997551867054435_5250708838402914094_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nufd5LppdMwQ7kNvwFP4Pio&_nc_oc=AdoRW-re0FIlNxllqcAxsaxQO8y_F8yCBTVHg4hJ_tjRwsgzFUGoYhAZeG0XjSlRUOw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQVhfN5iyDi95odZHVqEj9Jf7-i2Rs2U7nBWTaUPxJnYA&oe=6B0DBADA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover_2560x1440.png", "id": "1776963647773556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1776963651106889_1963240280009990113_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvitCvXrs8sQ7kNvwF5eWlY&_nc_oc=AdqqcqYMK4iWTQ8_t7se9a0GIjD0iX8T302hFZ9YOtoZQ9i5yH36b4BTGxMCC7atgDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ3lA-uBg03ox8Hh9NeVGteaQQjsG3YUFY5QM8tBLZj_g&oe=6B0DB6F6"}, "display_name": "Ice Cream Truck Simulator", "keywords": ["Icecream", "Cooking", "Dessert", "Food", "Shop"], "long_description": "Open the window, the line is already waiting!\n\nSERVE WITH YOUR HANDS\nGrab a cone, dig into the freezer and stack the scoops. Pull the soft-serve lever for vanilla, chocolate or a twist, squeeze sauce over the top and hand it through the window. Every order is made by hand, one scoop at a time.\n\nGROW YOUR TRUCK\nEvery day ends with your earnings. Use the truck computer to buy a milkshake mixer, a slush machine, toppings and sauces, a drinks cooler, a freezer for packaged treats, new flavours and more. Each new machine brings new orders to master.\n\nCUSTOMERS WITH CHARACTER\nKids, critics and regulars all react to what you serve. Some want a refund, some are a dollar short, some try to run off without paying. Choose how you handle them, and keep an eye on your tip jar.\n\nTHREE PLACES TO PARK\nSell on a quiet street, in a sunny park and by the beach, each with its own crowd.\n\nBUILT FOR VR\nEverything happens inside the truck with natural hand interactions: scoop, pour, slice fruit, flip a scoop into a cone. You stay in one place, with snap or smooth turning and an optional comfort vignette. Play in English or Turkish.", "short_description": "Run your own ice cream truck in VR! Scoop, twist soft-serve, pour sauces, blend milkshakes and fill slush cups with your own hands. Serve a line of hungry customers on the street, in the park and at the beach, deal with the tricky ones, and spend your earnings on new machines that bring new orders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": 
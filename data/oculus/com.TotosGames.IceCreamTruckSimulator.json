il0F_6tXk0JVtEmqb3DQEdXozOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQKoLt86eqc3WW-Sg-a0eaQfA0jbpCWv89cP_GHQAnXyQ&oe=6B0C6FCB"}, {"file_name": "Screenshot_3_customers.png", "id": "1631511651780397", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596068480_1631511655113730_4778558080012732697_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvpAmXUqmt4Q7kNvwHF1_lS&_nc_oc=Adrp83a3wM_mCKnZJrCu39guPBX2lQByg8vmVs0UUG4Szy1mOaT16AmkECtRKgJ3DyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqmTWxPlh65VNwh1I9as0FmAOjAtwce_y2hPqJ444qEA&oe=6B0C6A6B"}, {"file_name": "Screenshot_4_slush.png", "id": "1058254097227781", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831299_1058254100561114_5534958540687676842_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VqSfYGtUI8Q7kNvwHhnG9y&_nc_oc=Adp4q2bsmeU7AcN9-IafmjVuzHRRmC8W3f6tOnp2E8jjX_LAdxLRUUitc4AZ5xseWa8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTQ7z2RgEPckRyK3Tfl61arGwuFPbcKIQTnBzGpJBb66Q&oe=6B0C7508"}, {"file_name": "Screenshot_5_beach.png", "id": "3997551863721102", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596168449_3997551867054435_5250708838402914094_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tRcwiXcV4UQ7kNvwE3R4Mm&_nc_oc=AdoQ46WJJyPQy8qUOeu_YSo3WkzfK5E5EARvItEO2t2rZz8FPKJxZab_zn-s2v5LU2Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTKuFaXQnWtKbkSErXhzapGE30PLIgeDmvLbyJuoW0JAg&oe=6B0C695A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover_2560x1440.png", "id": "1776963647773556", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1776963651106889_1963240280009990113_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvitCvXrs8sQ7kNvwHBSop5&_nc_oc=AdqmC3MFSsrxg_YoLCZzKdLLz8I1iFwf78DMUqhyBRU73xFfTgcuKJ8BOBrR-PfARH0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRlCNWwUg85Os5aEUVFBi1cTPNuO4qFlplSTBLTVOT_2A&oe=6B0C6576"}, "display_name": "Ice Cream Truck Simulator", "keywords": ["Icecream", "Cooking", "Dessert", "Food", "Shop"], "long_description": "Open the window, the line is already waiting!\n\nSERVE WITH YOUR HANDS\nGrab a cone, dig into the freezer and stack the scoops. Pull the soft-serve lever for vanilla, chocolate or a twist, squeeze sauce over the top and hand it through the window. Every order is made by hand, one scoop at a time.\n\nGROW YOUR TRUCK\nEvery day ends with your earnings. Use the truck computer to buy a milkshake mixer, a slush machine, toppings and sauces, a drinks cooler, a freezer for packaged treats, new flavours and more. Each new machine brings new orders to master.\n\nCUSTOMERS WITH CHARACTER\nKids, critics and regulars all react to what you serve. Some want a refund, some are a dollar short, some try to run off without paying. Choose how you handle them, and keep an eye on your tip jar.\n\nTHREE PLACES TO PARK\nSell on a quiet street, in a sunny park and by the beach, each with its own crowd.\n\nBUILT FOR VR\nEverything happens inside the truck with natural hand interactions: scoop, pour, slice fruit, flip a scoop into a cone. You stay in one place, with snap or smooth turning and an optional comfort vignette. Play in English or Turkish.", "short_description": "Run your own ice cream truck in VR! Scoop, twist soft-serve, pour sauces, blend milkshakes and fill slush cups with your own hands. Serve a line of hungry customers on the street, in the park and at the beach, deal with the tricky ones, and spend your earnings on new machines that bring new orders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": 
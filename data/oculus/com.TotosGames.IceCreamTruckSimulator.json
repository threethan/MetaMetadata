&_nc_ss=7f30f&oh=00_AQSPAaEoUcaKF2P63sclHO98SEOvB1j74cyCjcOsrRX2iQ&oe=6B0DC688"}, {"file_name": "Screenshot_5_beach.png", "id": "3997551863721102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596168449_3997551867054435_5250708838402914094_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nufd5LppdMwQ7kNvwFP4Pio&_nc_oc=AdoRW-re0FIlNxllqcAxsaxQO8y_F8yCBTVHg4hJ_tjRwsgzFUGoYhAZeG0XjSlRUOw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQVhfN5iyDi95odZHVqEj9Jf7-i2Rs2U7nBWTaUPxJnYA&oe=6B0DBADA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover_2560x1440.png", "id": "1776963647773556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1776963651106889_1963240280009990113_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvitCvXrs8sQ7kNvwF5eWlY&_nc_oc=AdqqcqYMK4iWTQ8_t7se9a0GIjD0iX8T302hFZ9YOtoZQ9i5yH36b4BTGxMCC7atgDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ3lA-uBg03ox8Hh9NeVGteaQQjsG3YUFY5QM8tBLZj_g&oe=6B0DB6F6"}, "display_name": "Ice Cream Truck Simulator", "keywords": ["icecream", "truck", "cooking", "simulator", "dessert"], "long_description": "Open the window, the line is already waiting!\n\nSERVE WITH YOUR HANDS\nGrab a cone, dig into the freezer and stack the scoops. Pull the soft-serve lever for vanilla, chocolate or a twist, squeeze sauce over the top and hand it through the window. Every order is made by hand, one scoop at a time.\n\nGROW YOUR TRUCK\nEvery day ends with your earnings. Use the truck computer to buy a milkshake mixer, a slush machine, toppings and sauces, a drinks cooler, a freezer for packaged treats, new flavours and more. Each new machine brings new orders to master.\n\nCUSTOMERS WITH CHARACTER\nKids, critics and regulars all react to what you serve. Some want a refund, some are a dollar short, some try to run off without paying. Choose how you handle them, and keep an eye on your tip jar.\n\nTHREE PLACES TO PARK\nSell on a quiet street, in a sunny park and by the beach, each with its own crowd.\n\nBUILT FOR VR\nEverything happens inside the truck with natural hand interactions: scoop, pour, slice fruit, flip a scoop into a cone. You stay in one place, with snap or smooth turning and an optional comfort vignette. Play in English or Turkish.", "short_description": "Run your own ice cream truck in VR! Scoop, twist soft-serve, pour sauces, blend milkshakes and fill slush cups with your own hands. Serve a line of hungry customers on the street, in the park and at the beach, deal with the tricky ones, and spend your earnings on new machines that bring new orders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2615088722265698"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1160946686433122"}]}, "baseline_offer": {"id": "1160946686433122"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795013220, "status": "PUBLISHED", "id": "1160946686433122"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", 
oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsaLjKZBbWn-0YxKKz4R6MiZGMki5TJHJJ27Vo4dtxDw&oe=6AF5C544"}, {"file_name": "Screenshot_9 (1)_2560x1440.png", "id": "1192538489486652", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822968_1192538492819985_823682622219883227_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqO1OZ1DQlsQ7kNvwEIMQnQ&_nc_oc=Adr6kAGaUf6q7YSCvsBvtLh9ooOS2TpQfbsm02fC1OVaQIqXAG0as0L-OAAqmQRm9D8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdjqdZHMTUlvxye0EvTKGWAv4Mg3YPlan-BhMpE8u6kg&oe=6AF5F272"}, {"file_name": "Screenshot_11_2560x1440.png", "id": "2416148438818691", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304162_2416148442152024_580829672829183848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0de5laywaHgQ7kNvwHxCZVr&_nc_oc=AdrIzhK18LdldTWZfiGO2PeVourz4IHxIAjma9Ddsdx9US-xHk2sfmX3NAHTsDUr6CQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTiWth8y9lS995jLBi5DyS_fk6Me0l4uJdkp_j4dvAJA&oe=6AF5CF1E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Linde LVA - React To Electrical Incident", "keywords": ["Electrical", "Incident", "Linde", "Training", "Hazard"], "long_description": "Step into high risk industrial environments and train for critical electrical emergencies where every second counts. This interactive training places you in realistic, time pressured scenarios that challenge your ability to recognize danger, communicate effectively and act safely as a non electrically skilled responder.\n\nYou will learn how to assess electrical hazards, follow correct emergency protocols and make fast, safety first decisions under stress. Through dynamic, randomized situations, you\u2019ll practice coordinating with the control room, initiating emergency alarms and supporting injured coworkers while fully respecting your limits and personal safety.\n\nTraining scenarios include substation emergencies, electrical shock incidents, emergency reporting and de-energization coordination, victim assistance and first aid handoff to professional response teams. You\u2019ll also gain hands-on experience with protective equipment, risk evaluation before intervention and proper incident reporting.", "short_description": "This emergency response training prepares you to act decisively and safely during electrical incidents in industrial facilities. Through randomized scenarios with time pressure, develop critical skills in hazard identification, emergency protocols and victim assistance while maintaining your own safety as a non-electrically skilled person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr.linde.com/privacy-notice-for-lva-training-hub-trainings-on-meta-store/", "developer_terms_of_service_url": null, "publisher_name": "Linde GmbH", "support_website_url": null, "website_url": "https://vr.linde.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25061663926869894"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "863065903007928"}, {"status": "PUBLISHED", "id": "1942907976292140"}]}, "baseline_offer": {"id": "863065903007928"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768322400, "status": "PUBLISHED", "id": "863065903007928"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes":
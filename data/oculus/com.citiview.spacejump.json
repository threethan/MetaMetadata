oJUqwSdcQ7kNvwExk6yH&_nc_oc=AdrVHWqr95dyErw476PPGWJDHWCtIelovd7w8MuUCwLGF616kjaKm0I6wWq2VBkEfSE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyUdEPphre9DcNWIbNVei738lLmBgyKnp8Urj6o1QTSA&oe=6AF8776D"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1083814001028131", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831393_1083814004361464_1543522125039388662_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pj9Hh3UhjXEQ7kNvwFXLPih&_nc_oc=Adpqe8a5EywFa1CelazP3BCqinGf0aLO5YdJ8ERLzNmeQXlmFRQzba3EPpMEwTryjvw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj_8Y-Tz8SguZ1eRiZmRJck_GyTdk3YRuQOytoBkLdaQ&oe=6AF88AE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1396488269364103", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596068480_1396488272697436_7288463685636818675_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjsE6DP8UzgQ7kNvwERbhrN&_nc_oc=AdpO4pAk5o6b0bltxFggCj8WeXwvsNcbxNAdC4ns_9hgEDtCiJJXszHM7NX2TNnTC7c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTEO5pMz68_Wx1kOujlDlEuSkRbRjfpqrxMzJQ1ih7Ew&oe=6AF8807A"}, "display_name": "Space Jump", "keywords": ["platformer", "jumping", "space", "rocket", "crystals"], "long_description": "SPACE JUMP is a first-person platformer built for VR comfort.\n\nYou start in orbit above a red planet, on a floating outpost. The islands ahead stretch away into space, and the only way forward is to run and jump.\n\nTEN WORLDS\nRed Planet Outpost, Ice Moon Relay, Lava Fields, Emerald Reach, Golden Dunes, Amethyst Drift, Ocean World, Steel Belt, Toxic Garden and the Star Core. Each has its own planet below, its own sky and its own colours.\n\nA JUMP THAT FEELS GOOD IN VR\nOne long, soft arc every time. No snapping, no stomach drop. Walk with the stick, snap turn, jump with A. Nothing can kill you: miss a landing and you hop back to the last checkpoint.\n\nTHINGS TO RIDE\nCargo drones carry you over the long gaps. Elevators lift you to the high decks. A monorail flatcar runs the canyon, and gravity lifts fling you up to islands you cannot reach any other way.\n\nWATCH OUT\nCracked asteroids sink a second after you land. Laser fences sweep the decks at knee height, so jump them. Aliens patrol the paths and you can stomp them flat.\n\nLONGER AND FASTER\nLevel one is a 200 metre warm-up. By level ten you are crossing half a kilometre, moving quicker, over narrower platforms and longer gaps.\n\nTHE FINALE\nOn the Star Core, step onto the rocket's launch pad and it takes you with it, climbing into the stars with the whole level shrinking below.", "short_description": "Jump across floating islands above ten alien worlds. Collect crystals, ride cargo drones and a monorail, dodge laser fences, then board the rocket and ride it into the stars."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-spacejump.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-spacejump.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1242870048918968"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2594466111021036"}]}, "baseline_offer": {"id": "25
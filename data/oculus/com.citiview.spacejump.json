3679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1gOdrcn5-AQ7kNvwF7PuFY&_nc_oc=AdrzexhXRmojwgDXWveTj9JTrbdY7CqmEb3ZOxJe_oYc9uLKnYOqnBICJVmfwy_bPzQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv-ciA53M3-75SgCqzs4IFcNq-7Vhdk_-PmFmDDI4E_w&oe=6AF32963"}, {"file_name": "screenshot_5_2560x1440.png", "id": "2073805949907053", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673645340_2073805953240386_4175652003120816039_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHsrEOyVoA4Q7kNvwF7TQ-C&_nc_oc=Adp4WP9j44jJwbLXzv5BtGILrgroh4g4xKVWt8I9GTP_rEub50HdBjepO36_9QqVwHU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXHSHby2NLT6OXnCo-LbkboS8MsZBxWYxxJ09X0tcl_A&oe=6AF3316D"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1083814001028131", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831393_1083814004361464_1543522125039388662_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suLTf2Zob2MQ7kNvwFqiZHT&_nc_oc=AdqUsc-_Tm4xpnhpEWKlIO753qWVp1OendhFqYpV9RHDHQAJ26k5ohgcoA2oFJRRZZo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5YHlLxw7cks2ZcW60C_pTz3FKuBQOSXhUg1Vq13jyOg&oe=6AF344E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1396488269364103", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596068480_1396488272697436_7288463685636818675_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNUjG0U2Uw8Q7kNvwFUvD6K&_nc_oc=AdquUH032_mwhcE5aObAOJU6aF8Z77A9Hg3EI5xLtVfruZCViX2C3_OfigwxkF5E7_A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZz5gBeLwNAuZTVfefU5dbQajHj2TVqPeOnFyYf3n_mw&oe=6AF33A7A"}, "display_name": "Space Jump", "keywords": ["platformer", "jumping", "space", "rocket", "crystals"], "long_description": "SPACE JUMP is a first-person platformer built for VR comfort.\n\nYou start in orbit above a red planet, on a floating outpost. The islands ahead stretch away into space, and the only way forward is to run and jump.\n\nTEN WORLDS\nRed Planet Outpost, Ice Moon Relay, Lava Fields, Emerald Reach, Golden Dunes, Amethyst Drift, Ocean World, Steel Belt, Toxic Garden and the Star Core. Each has its own planet below, its own sky and its own colours.\n\nA JUMP THAT FEELS GOOD IN VR\nOne long, soft arc every time. No snapping, no stomach drop. Walk with the stick, snap turn, jump with A. Nothing can kill you: miss a landing and you hop back to the last checkpoint.\n\nTHINGS TO RIDE\nCargo drones carry you over the long gaps. Elevators lift you to the high decks. A monorail flatcar runs the canyon, and gravity lifts fling you up to islands you cannot reach any other way.\n\nWATCH OUT\nCracked asteroids sink a second after you land. Laser fences sweep the decks at knee height, so jump them. Aliens patrol the paths and you can stomp them flat.\n\nLONGER AND FASTER\nLevel one is a 200 metre warm-up. By level ten you are crossing half a kilometre, moving quicker, over narrower platforms and longer gaps.\n\nTHE FINALE\nOn the Star Core, step onto the rocket's launch pad and it takes you with it, climbing into the stars with the whole level shrinking below.", "short_description": "Jump across floating islands above ten alien worlds. Collect crystals, ride cargo drones and a monorail, dodge laser fences, then board the rocket and ride it into the stars."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-spacejump.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-spacejump.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_con
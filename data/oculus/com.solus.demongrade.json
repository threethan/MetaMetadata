ideoSplash2560x1440.png", "id": "487551664949374", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162708_487551668282707_2173471262452482048_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhSO205D1QMQ7kNvwFFFVtl&_nc_oc=AdogT9KEPYHMev_MG_6xhVUV7_kKzjgSUdjIvoJaafcfFWOPCVTCmITaF2e9r92GYL8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FnpTyU1qNvQor5OyX3sdpyPl0ay2O_qDnt3Y0T82shg&oe=69D90DEB"}, "display_name": "Demon Grade : Gear VR", "keywords": ["FPS", "Shooter", "Rogue", "Horror", "Gun"], "long_description": "Demon Grade VR is a FPS with rich graphics, Rogue-lite gameplay, and weapon and player stat upgrades.  Demon Grade VR also features free 360 degree movement, with no jogging in place, no teleporting, and no rails.  In Demon Grade, the player will explore dynamically generated levels in first person perspective while fighting relentless demonic enemies while collecting demon shards to unlock various weapons.", "short_description": "Demon Grade VR is a FPS with rich graphics, Rogue-lite gameplay, and weapon and player stat upgrades.  Demon Grade VR also features free 360 degree movement, with no jogging in place, no teleporting, and no rails.  In Demon Grade, the player will explore dynamically generated levels in first person perspective while fighting relentless demonic enemies while collecting demon shards to unlock various weapons."}]}, "developer_name": "Solus Games", "developer_privacy_policy_url": "http://www.solusgames.com/", "developer_terms_of_service_url": "http://www.solusgames.com/", "publisher_name": "Solus Games, Inc.", "support_website_url": null, "website_url": "http://www.solusgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["HORROR", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memor
, "id": "4618692278349712", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499623585_4618692281683045_2188664686411656645_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEZko0Cwf30Q7kNvwGRJPz2&_nc_oc=Adp9vcXK8fEGEGiWcsESzSYMRVKnkCt9HQ5SUmfcrpPcj4l6Dmw62Q2AJqmrheUcsNE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxZpQqv7u2r2mEKDGV1fm8IWOM_OgBFqpw_5u1UGxNog&oe=6AF9D1C3"}, {"file_name": "screenshot_1.png", "id": "938240245762678", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/593761155_938240249096011_4118244808299955514_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=we0wMirnOwMQ7kNvwEzZrVR&_nc_oc=AdrxoaAityZ1MC3kd9ySlhBWrgchoOkaUAfYWaawWMQXzAq_AiDcxeu78p6J4eF26Xc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR87mADKzh3p64RQk6T16Dv9tx0dz73iZ7sRaQFmYziKA&oe=6AF9C372"}, {"file_name": "screenshot_4.png", "id": "1076532475000842", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622162_1076532485000841_5307127866424011360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=vfctew5_ZrMQ7kNvwGtzQ22&_nc_oc=Adpe65fd5l8_dPH9WtiRTxPMeptABjwLvZcfARTDz269i5ZYnljUuV5mU-wjMxGUTso&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBezwsLvN4TcYuvZ2r3QwBGj3LLOKV7NXknf7ngoY-Hw&oe=6AF9E115"}, {"file_name": "screenshot_3.png", "id": "1887212588912850", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/593845024_1887212592246183_3434588686561856781_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnOT4edaXLcQ7kNvwEJCbo2&_nc_oc=AdrneBTRXmdp1NV8o0-cFUcJPvxoJFdA13FZLrKBA-4NmNEFFIJSEttryJC15DBELZY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-iPl0Vl9UhY303BmczvJO8DX4tS6lrTq17xsGoOzt3w&oe=6AF9E20C"}, {"file_name": "screenshot_5.png", "id": "1638507341239077", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499624619_1638507344572410_1045447657244887071_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ddRjx6SDpwQ7kNvwGlwHIP&_nc_oc=AdrU85HjjiJ0A0ROK-sUmaOhv8AfZwKY99kgenod-6wk9FXlQv-LrYhh6C9fcUsxYVU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpX0rDPbPQXb_v8zkCYpHJepQXBBfrIo57U3mAzfBsSw&oe=6AF9D7C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1819392505740495", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620316_1819392512407161_1970320728900704983_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWn1WszeH7oQ7kNvwGvL9on&_nc_oc=AdpP9iKXEn-Z0AIjO5GZFsIM63Th-8STzlAYoMiJqtYVIzaJyLwwmRTTe1_h7hxxY0s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjIKn6BZvJEKauHtf0lgkgFxZLPwvICoLv1-5Xp7Dakg&oe=6AF9E4BC"}, "display_name": "Truck Simulator Munich", "keywords": ["truck", "trucking", "driving", "simulator", "munich"], "long_description": "The open road, from the driver's seat - in Munich.\n\nA REAL CITY LOOP\n65 km of Munich built from real map data: the A99 Autobahnring, the Kreuz M\u00fcnchen-Nord loop ramp onto the A9 past the Allianz Arena, the Mittlerer Ring past the Olympiaturm and BMW, over the Donnersbergerbr\u00fccke and the Isar, then the A995 and back.\n\nA SHOW TRUCK TO CALL HOME\nWalnut dash, cognac tufting, fourteen working gauges and a starlight headliner. Grip the wheel with your own hands, pull the air horn, set the parking brake - or drive with the joysticks.\n\nA REAL 10-SPEED\nDrive AUTOMATIC, or switch to MANUAL and float a 10-speed through the H-pattern with a LO/HI range. Miss a shift and it grinds.\n\nHAUL REAL LOADS\nSix depots from Ismaning to the Autohof Aschheim. Back under your trailer, merge into traffic and deliver. Dock it clean for a bonus, climb the ranks, get paid in euros.\n\nDAY AND NIGHT\nDrive at noon or after dark - the Allianz Arena glows red. Night runs pay extra.\n\nON THE RADIO\nA real dispatcher and five truckers on the CB with local road talk and Blitzer warnings.\n\nTHE SLEEPER\nLeave the seat, walk back into the sleeper and sleep through to morning.\n\nENGLISH AND GERMAN\nMenus, hints and the nav screen in English or German.\n\nPlus 18 achievements, 9 paints to unlock, a live map and seat adjustment.", "short_description": "Grab the wheel of a long-nose show truck and haul freight around the real roads of Munich. Drive the A99 Autobahnring, the A9 past the Allianz Arena, the Mittlerer Ring past the Olympiaturm and BMW, over the Donnersbergerbr\u00fccke and the Isar, by day and by night. Shift a real 10-speed manual or let the automatic do it, take loads from dispatch, chat on the CB, then walk back and rest in your sleeper. English and German menus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/trucksimulatormunich/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/trucksimulatormunich/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1379165588609637"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1381055918420604", "version": "1.0.1"}, "id": "1135700305455806", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only
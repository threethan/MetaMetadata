1-25/65228209_516587924514293_7803148284939669219_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vn8u0HUwkSIQ7kNvwE9qul2&_nc_oc=AdpUDWYfpNUyX4vjspZYrsGEIeX1FF-FaiHlJUc7iuHKCBY0tiE1fQ9aGF3zFkgvV1A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaKs63XW5qDVDQ26ukJuCg0j7I57k-Gi0jEGz4WiY7Ag&oe=6B085EC3"}, {"file_name": "Clawbar.png", "id": "1436759867378640", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499310651_1436759870711973_4223729962266660383_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShTssVBHBSwQ7kNvwFYZmPv&_nc_oc=AdpU0NHY8N05G-PIVUP3Qs3Enz6VfUItoAT4VEez7lr2srfksWQjpLHNQIkWKn8tyh4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuY0WSdY-HGf5IoSev81I7nfGLdW1E7l-KIBfPFN-8Hg&oe=6B085E62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Clawball-CoverImageLandscape.png", "id": "880194694590918", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499299808_880194697924251_1497154389533061905_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeZ9QE-SRtYQ7kNvwH6sJ4-&_nc_oc=AdqS6uD7SiaeiDHw1vHWOiBzCd4PKm-vTq5bA-pd40An_-M3X_KL9sSXZGJmFGy4-8U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2nqw02CT7ZZhbdNC72XGO5vIQnn39KsRku--0KLBipQ&oe=6B083BFA"}, "display_name": "Clawball", "keywords": ["Multiplayer", "Free", "Soccer", "New", "Cat"], "long_description": "Ever wondered how it would be to become a cat and play in frenetic soccer matches? Well, now you have!\n\nIn Clawball, you step into the paws of a soccer-playing cat. Move your hands and push off the ground to run, jump, and maneuver just like a real cat. Invite your friends and come hang out in this exhilarating VR social multiplayer experience! Developed by the creators of the Pixel Ripped Franchise ARVORE Immersive\nYou gotta be quick and strategic to get that sweet score at the end of each match. Being a goalie or a striker, a domestic or an alley cat, in Clawball the main objective is always to have fun!\n- Social interactions at its finest! Play in the lobby to meet other players alike\n- 3v3 online matches\n- Amazing in-match physics\n- Highly customizable character\n- Tons of cosmetics\n\nNo bounds to having fun! You are free to run, climb, and claw your way to victory!\nEasy to share! Stream your Clawball matches everywhere!\n\n{1019937909816095}\n\n{1063884701863486}", "short_description": "Ever wondered how it would be to become a cat and play in frenetic soccer matches? Well, now you have!\n\nIn Clawball, you step into the paws of a soccer-playing cat. Move your hands and push off the ground to run, jump, and maneuver just like a real cat. Invite your friends and come hang out in this exhilarating VR social multiplayer experience! Developed by the creators of the Pixel Ripped Franchise ARVORE Immersive"}]}, "developer_name": "ARVORE", "developer_privacy_policy_url": "https://arvore.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ARVORE IMMERSIVE GAMES INC.", "support_website_url": null, "website_url": "https://www.clawball.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25411224898498771"}, "review_messages": []}]}, "cover_square_image": 
content-ord5-2.oculuscdn.com/v/t64.5771-25/39003283_1241505180220390_4263321879792757472_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDqZsT6ZRm0Q7kNvwFwluDk&_nc_oc=Adnhb4mwq9_umQYcJxRsQNKI4Ashf1oWwvml9WqrFm_QEQnqgQXUDNZLayt9Dbb7LSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxN_PjVhFClWNmuEO34SntTfTSF9Xt70j-XY_9vA6dEZg&oe=69B81268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Clawball-video-cover.png", "id": "1048957033519157", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035471_1048957036852490_2684877143045225821_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dA7b1HZDvloQ7kNvwHVGnEf&_nc_oc=AdmSHCgWdwNkv3b8xPJlJDUvopmugmjDkVhYLo8-AWIWSOtDbCnfQp-704rcoRPyuQo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyMUupNS-zZuk-dfF7zlVBNKJe0IFTJFYEKs0iCuIzJZQ&oe=69B7F1F5"}, "display_name": "Clawball", "keywords": ["Multiplayer", "Free", "Gorilla", "Soccer", "New"], "long_description": "Ever wondered how it would be to become a cat and play in frenetic soccer matches? Well, now you have!\n\nIn Clawball, you step into the paws of a soccer-playing cat. Move your hands and push off the ground to run, jump, and maneuver just like a real cat. Invite your friends and come hang out in this exhilarating VR social multiplayer experience! Developed by the creators of the Pixel Ripped Franchise ARVORE Immersive\nYou gotta be quick and strategic to get that sweet score at the end of each match. Being a goalie or a striker, a domestic or an alley cat, in Clawball the main objective is always to have fun!\n- Social interactions at its finest! Play in the lobby to meet other players alike\n- 3v3 online matches\n- Amazing in-match physics\n- Highly customizable character\n- Tons of cosmetics\n\nNo bounds to having fun! You are free to run, climb, and claw your way to victory!\nEasy to share! Stream your Clawball matches everywhere!\n\n{1019937909816095}\n\n{1063884701863486}", "short_description": "Ever wondered 
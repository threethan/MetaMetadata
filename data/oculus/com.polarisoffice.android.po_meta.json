74F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Polaris Office", "keywords": [], "long_description": "\ud3f4\ub77c\ub9ac\uc2a4 \uc624\ud53c\uc2a4: VR\uc5d0\uc11c \ub9cc\ub098\ub294 \uad81\uadf9\uc758 \ubb34\ub8cc \uc624\ud53c\uc2a4 \uc194\ub8e8\uc158\n\n\uc774\uc81c \uba54\ud0c0 \ud638\ub77c\uc774\uc98c OS\uc5d0\uc11c\ub3c4 \ud3f4\ub77c\ub9ac\uc2a4 \uc624\ud53c\uc2a4\ub97c \ub9cc\ub098\ubcf4\uc138\uc694. PDF, Word, Slide, Sheet, TXT \ub4f1 \ub2e4\uc591\ud55c \ubb38\uc11c \ud3ec\ub9f7\uc744 \ub85c\uadf8\uc778 \uc5c6\uc774 \uc989\uc2dc \ud655\uc778\ud558\uace0 \uc644\ubcbd\ud558\uac8c \ubb34\ub8cc\ub85c \ud3b8\uc9d1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uac70\ub300\ud55c \uac00\uc0c1 \ud654\uba74\uc5d0\uc11c \uad11\uace0 \uc5c6\uc774 \ucf8c\uc801\ud558\uac8c \uc804\ubb38\uac00\uae09 \ud3b8\uc9d1 \uae30\ub2a5\uc744 \ubb34\ub8cc\ub85c \uc774\uc6a9\ud574 \ubcf4\uc138\uc694. \ud2b9\ud788 \uba54\ud0c0 \ud018\uc2a4\ud2b8 \ucee8\ud2b8\ub864\ub7ec\ub294 \ubb3c\ub860 \ub2e4\uc591\ud55c \uc678\ubd80 \uc785\ub825 \uc7a5\uce58\uc640 \uc644\ubcbd\ud558\uac8c \ud638\ud658\ub418\uc5b4, \uacf5\uac04 \ucef4\ud4e8\ud305 \ud658\uacbd\uc5d0\uc11c\ub3c4 \ub370\uc2a4\ud06c\ud1b1 \uc218\uc900\uc758 \uc555\ub3c4\uc801\uc778 \uc0dd\uc0b0\uc131\uc744 \uacbd\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.", "short_description": "\ud3f4\ub77c\ub9ac\uc2a4 \uc624\ud53c\uc2a4: VR\uc5d0\uc11c \ub9cc\ub098\ub294 \uad81\uadf9\uc758 \ubb34\ub8cc \uc624\ud53c\uc2a4 \uc194\ub8e8\uc158\n\n\uc774\uc81c \uba54\ud0c0 \ud638\ub77c\uc774\uc98c OS\uc5d0\uc11c\ub3c4 \ud3f4\ub77c\ub9ac\uc2a4 \uc624\ud53c\uc2a4\ub97c \ub9cc\ub098\ubcf4\uc138\uc694. PDF, Word, Slide, Sheet, TXT \ub4f1 \ub2e4\uc591\ud55c \ubb38\uc11c \ud3ec\ub9f7\uc744 \ub85c\uadf8\uc778 \uc5c6\uc774 \uc989\uc2dc \ud655\uc778\ud558\uace0 \uc644\ubcbd\ud558\uac8c \ubb34\ub8cc\ub85c \ud3b8\uc9d1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uac70\ub300\ud55c \uac00\uc0c1 \ud654\uba74\uc5d0\uc11c \uad11\uace0 \uc5c6\uc774 \ucf8c\uc801\ud558\uac8c \uc804\ubb38\uac00\uae09 \ud3b8\uc9d1 \uae30\ub2a5\uc744 \ubb34\ub8cc\ub85c \uc774\uc6a9\ud574 \ubcf4\uc138\uc694. \ud2b9\ud788 \uba54\ud0c0 \ud018\uc2a4\ud2b8 \ucee8\ud2b8\ub864\ub7ec\ub294 \ubb3c\ub860 \ub2e4\uc591\ud55c \uc678\ubd80 \uc785\ub825 \uc7a5\uce58\uc640 \uc644\ubcbd\ud558\uac8c \ud638\ud658\ub418\uc5b4, \uacf5\uac04 \ucef4\ud4e8\ud305 \ud658\uacbd\uc5d0\uc11c\ub3c4 \ub370\uc2a4\ud06c\ud1b1 \uc218\uc900\uc758 \uc555\ub3c4\uc801\uc778 \uc0dd\uc0b0\uc131\uc744 \uacbd\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"images": {"nodes": []}, "id": "911935194804123", "locale": "pl_PL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Polaris Office", "keywords": [], "long_description": "Polaris Office: Darmowy pakiet biurowy VR\n\nOdkryj Polaris Office na Meta Horizon OS. Przegl\u0105daj i edytuj pliki PDF, Word, Slide, Sheet i TXT ca\u0142kowicie za darmo \u2013 bez logowania.\n\nPracuj p\u0142ynnie i bez reklam na ogromnym wirtualnym ekranie. Polaris Office jest zoptymalizowany pod kontrolery Meta Quest i kompatybilny z urz\u0105dzeniami zewn\u0119trznymi, zapewniaj\u0105c wydajno\u015b\u0107 komputera stacjonarnego w \u015brodowisku przestrzennym. Tw\u00f3j workflow w nowej ods\u0142onie VR.", "short_description": "Polaris Office: Darmowy pakiet biurowy VR\n\nOdkryj Polaris Office na Meta Horizon OS. Przegl\u0105daj i edytuj pliki PDF, Word, Slide, Sheet i TXT ca\u0142kowicie za darmo \u2013 bez logowania.\n\nPracuj p\u0142ynnie i bez reklam na ogromnym wirtualnym ekranie. Polaris Office jest zoptymalizowany pod kontrolery Meta Quest i kompatybilny z urz\u0105dzeniami zewn\u0119trznymi, zapewniaj\u0105c wydajno\u015b\u0107 komputera stacjonarnego w \u015brodowisku przestrzennym. Tw\u00f3j workflow w nowej ods\u0142onie VR."}, {"images": {"nodes": []}, "id": "880412375085559", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Polaris Office", "keywords": [], "long_description": "Polaris Office: Die ultimative kostenlose VR-Office-L\u00f6sung\n\nErleben Sie Polaris Office auf Meta Horizon OS. Bearbeiten Sie PDF, Word, Slide, Sheet und TXT v\u00f6llig kostenlos \u2013 ohne Login.\n\nGenie\u00dfen Sie nahtlose, werbefreie Bearbeitung auf einer riesigen virtuellen Leinwand. Optimiert f\u00fcr Meta Quest-Controller und kompatibel mit externen Eingabeger\u00e4ten, bietet Polaris Office Desktop-Produktivit\u00e4t in einer r\u00e4umlichen Umgebung. Meistern Sie Ihren Workflow in VR.", "short_description": "Polaris Office: Die ultimative kostenlose VR-Office-L\u00f6sung\n\nErleben Sie Polaris Office auf Meta Horizon OS. Bearbeiten Sie PDF, Word, Slide, Sheet und TXT v\u00f6llig kostenlos \u2013 ohne Login.\n\nGenie\u00dfen Sie nahtlose, werbefreie Bearbeitung auf einer riesigen virtuellen Leinwand. Optimiert f\u00fcr Meta Quest-Controller und kompatibel mit externen Eingabeger\u00e4ten, bietet Polaris Office Desktop-Produktivit\u00e4t in einer r\u00e4umlichen Umgebung. Meistern Sie Ihren Workflow in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polarisoffice.com/view/rules", "developer_terms_of_service_url": null, "publisher_name": " Polaris Office Corp.", "support_website_url": null, "website_url": "https://www.polarisoffice.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "id", "it", "ja", "ko", "pl", "pt_BR", "pt", "ru", "es", "tr", "vi", "zh_CN", "zh_TW"], "supported_input_devices": ["TRACKED_KEYBOARD", "OCULUS_TOUCH"
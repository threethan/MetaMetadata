U1kCSpYp6N9-Q5Ya5dXg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4iiBvaNWYbaXCx4dn7MVuhSY0w9TnsF8t7UAyh59u4Q&oe=6AF9B741"}, {"file_name": "screenshot_5.png", "id": "1442065281226396", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/673573223_1442065284559729_7029819456623762076_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRcfBixSGioQ7kNvwFz6wMj&_nc_oc=AdonkYBpz5WIaAOyWo5VZmzmRrWT3igZK9Y66T234WTjbqtV4x5o49gVNBXFq_xBqa4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8KgodsEJR05SiEJQwD6ST-Uvv7oHUjB1oPFtOghNahw&oe=6AF9C644"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1591320446351439", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/673825275_1591320449684772_7042133747910704234_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIjjAkRsyGgQ7kNvwE7B07M&_nc_oc=AdroHwso9XKg__TcjfYWDGJaUN7no3bRmdO4-uG3557tofSGMt-cHyua3V7ho-A0eug&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC0Wg2lpDa0I_jaceDSCdQ37o0444SD_XQPLeW3mDjaw&oe=6AF9C5B3"}, "display_name": "AI Companion French", "keywords": ["french", "language", "conversation", "ai", "companion"], "long_description": "Speak French out loud with someone who always has time to talk - your own AI friend, 300 metres above the city.\n\nCHOOSE YOUR FRIEND\nMeet sixteen people - eight women and eight men - each with their own look, personality and voice. Point at someone to hear them say hello, and press the trigger to choose.\n\nJUST TALK, IN FRENCH\nHold A, speak French out loud, then let go. They understand you and answer in French, in their own voice, with lip sync and expressions. Talk freely about anything. They remember your name and what you talked about last time, and their words appear above their head so you can read along.\n\nA FRIEND WHO LIVES THERE\nYour friend walks around the penthouse with you, sits on the couch, dances when you ask (\"danse !\"), makes a coffee and looks out at the view. Wave and they wave back. Press B and they come over.\n\nA PENTHOUSE 300 M UP\nA wall of glass over a glittering skyline, a balcony, a TV lounge and a full kitchen. Change the sky between sunset, dawn, daylight, emerald and neon night - just ask (\"fais la nuit\").\n\nNO MONTHLY AI CHARGES\nThe AI runs entirely on your headset. No subscription, no account, no internet needed - your conversations never leave the room.\n\nGOOD TO KNOW\nThis is an AI conversation partner, not a teacher or a structured course: it can make mistakes, in French or in facts, and works best if you already know some French. Conversations and menus are in French; the start card also explains the controls in English.", "short_description": "Practise speaking French out loud with your own AI friend, in a stunning penthouse 300 m above the city. Choose from 16 people, hold A and speak - they listen and answer in French, in their own voice. The AI runs entirely on your Quest: no monthly AI charges."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/aicompanionfrench/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/aicompanionfrench/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1340878589118113"}}]}, "schedu
5/596149727_1400945522189907_1614140862344603511_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBIO_TbJFjwQ7kNvwFx9Gci&_nc_oc=Adp7yuqapwIrlvpr5n1d6IWVwD9jBmu8Y2JObS3MItzlnY5KJWygv79aKlKFEO0Hm0k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmx9bvLsf0hqsHdF-O1rx3Vd1SH1AZLAm-nF_dQwDMgA&oe=6AC8E564"}, {"file_name": "01.png", "id": "1433052762345987", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604370996_1433052765679320_3979256481846437544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UjnlYVH2xQQ7kNvwFzvNYT&_nc_oc=AdrvzP9BSMqCecy2uPsJMJLs72YaaY1FQ93xgfM1Ppxi4SBJ1dOFmNbkqD33izIoAe0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfblK3k6wbDJkVWPVe5BeRX46i_qWWZwJcJi31a5HPtg&oe=6AC903CE"}, {"file_name": "Screenshot_Colonist.png", "id": "1524667099467976", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604360590_1524667102801309_2793018114219272474_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJnOi4KDNmcQ7kNvwFq7U5P&_nc_oc=AdrohMoIzjh0R0tgsn-_CXrHKYoAvNocxLwtDhno7dGU70zdhOx3SY0oGzrWkqt3ZMY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODWtcV5_tsN0HnvSZqaHAvXudY44rypdI77_56lyvUMQ&oe=6AC8F9C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_V8_Landscape.png", "id": "4187032411551185", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821178_4187032414884518_6684493733824043119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ciej6gCUJkQ7kNvwEDnwrT&_nc_oc=AdqimVMijqyrWrdGsDEWUDhEW-9282boXi5LzDDi3Maqb7V2iLxp8CvZSMv1ZvCFo40&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsS145B2HtAcd-J-51uJHTEWjuVFdLzT4pfSPO1wyZMQ&oe=6AC8F42D"}, "display_name": "VAIL", "keywords": ["shooter", "fps", "multiplayer", "social", "extraction"], "long_description": "The highest-rated VR shooter is FREE. VAIL delivers precision-crafted gunplay, 10+ competitive modes, and a massive free Extraction island. \nCustomize your gear, squad up, and see why VAIL has 4.8 stars across 67K reviews.\n\n{1419076756672610}\n\n\n#  **TRAINING GROUNDS (FREE-TO-PLAY)**\nJump in with nothing. Random maps, weapon pickups, and loadout modifiers designed to get you into real gunfights fast. To know what VAIL's gunplay actually feels like in your hands.\n\n{826869113772460}\n{1861007317926953}\n\n#  **EXTRACTION (FREE EARLY ACCESS)**\nDescend into the depths of Reyn. Extract encrypted data, technology, and resources while autonomous drones guard every corridor like archangels. A free, high-stakes mode that rewards patience, precision, and knowing when to run.\n\n{2038611673568486}\n{906663608919767}\n\n\n#  **SOCIAL HUB (FREE-TO-PLAY)**\nVAIL's Social Hub is the center of gravity. Hang out, shoot, Challenge players to 1v1s, or mine ORE shards from the quarry to unlock rewards.\n\n{911511758042190}\n\n\n\n#  **VAIL COMBAT (UNLOCKABLE)**\n\nThis is what VAIL was built for. Team Deathmatch, Seek and Destroy, Free for All, and 10+ more modes. Full progression, 8 prestiges, leaderboards, stats, competitive, and the complete weapon and cosmetics system. Upgrade once, play forever.\n\n{1220581586247000}\n{1547957886294186}\n\n\n\n# **CRITICALLY ACCLAIMED**\nVR Game of the Year Finalist - VR Awards 2022 / People's Voice: Best VR Game - Webby Awards 2024 / Best Social/Interactive - VRDB Community Choice Awards 2024\nVoted by the community. Verified by 67,000+ reviews. 4.8 stars on the Quest store.\n\n{988770307650678}\n\nJoin the community!\nDiscord.gg/VAILVR\n\n{875677118774648}\n\n", "short_description": "The highest-rated VR shooter is FREE. VAIL delivers precision-crafted gunplay, 10+ competitive modes, and a massive free Extraction island. \nCustomize your gear, squad up, and see why VAIL has 4.8 stars across 67K reviews."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aexlab.com/aexlab/privacy", "developer_terms_of_service_url": null, "publisher_name": "AEXLAB", "support_website_url": null, "website_url": 
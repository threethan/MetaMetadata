at=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n05ygf0bH2UQ7kNvwFuyTaA&_nc_oc=AdrhIU_1nidz0im2P8Ap_0aBvP0KVSfUnnWEKSM8btmxVaM9gdRglRhVqLdzKPzWSls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PeFcIr6AF6hmb0Yxx6-h1iaAjxdemiE8EKTroj2Q5zA&oe=69FC8063"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape.png", "id": "1713229479151882", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036617_1713229482485215_2083808281094830010_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nix6QcxLeQsQ7kNvwGpxWG7&_nc_oc=AdrdNUe8hlGm_-OckCwmUsg5vpXwDXpf7rzpfI1N2ea8L6o8Xd9H68MhbGIiXvgTufE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66MDBe08-07LRhCErGiRhMQv8SwibxWy2vJMFVuHxSVA&oe=69FC8BEA"}, "display_name": "VAIL", "keywords": [], "long_description": "VAIL is a 5v5 tactical shooter game developed from the ground-up for virtual reality.\n\nImmersive Physics:\nGuns collide with the environment. Throw magazines to teammates, bounce grenades around corners, climb ladders, vault over obstacles, ride ziplines, defy gravity on jump pads, and more.\n\nCompetitive Integrity:\nEverything in VAIL is designed to uphold competitive integrity. From standardizing player height, to preventing play space cheats; trust that every match will be competitive and fair.\n\nSocial Experiences (in development):\nAfter a fast-paced match, challenge friends to mini-games in the social hub, flex gun and avatar skins, or 1v1 a friend. Customizable home, game modes and experiences in development.", "short_description": "VAIL VR is a virtual reality multiplayer competitive shooter. Emphasizing tactical gunplay, high-caliber combat, and collaborative teamwork. Introducing the ultimate VR shooter experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vailvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "AEXLAB", "support_website_url": null, "website_url": "https://vailvr.com/", "categor
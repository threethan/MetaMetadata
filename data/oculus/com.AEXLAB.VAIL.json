383461997765941_7321913003346408327_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9TA6b1dumgQ7kNvwH-4wX1&_nc_oc=AdqG3u3lqUUHqdzt22UeV2uiQD_z0dealDRZLYIZ2KYPvEHqZsZOmVcEgGeAeNylwbM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK56w0O1lKhYxy1hkhEygvYjhbtADFBxxF2-QsA_f6nDQ&oe=6AA40FC3"}, {"file_name": "Screenshot5.png", "id": "3827117000946530", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75340709_3827117004279863_2151149415370285711_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udgeYb__ZMAQ7kNvwEYYMyL&_nc_oc=Ado_p51RdWET9tXTuJOW3uVsinfqfH7gZwpNKKIpNWsNtgZtHytdmtiiKjJNAb37-lk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsjwQOjt-9Erx2wbwMn9JB3aSb7XRWZf5eoeZ6xqfaTg&oe=6AA400FC"}, {"file_name": "Screenshot3.png", "id": "1329895131046853", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982642_1329895134380186_3255244674483954341_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6zOKfEfjb8Q7kNvwEF94RU&_nc_oc=Adr34YkDpgIlG1GRnhuEB4loyMtIIle8RrAYkzKuqeb6S1_17D3sGGLd7_psWVWr02M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb1aUtfHUGxz4D8y2CFYHUNsRt0_2QbO8x8q__qqZHaw&oe=6AA423E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_V8_Landscape.png", "id": "4187032411551185", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491821178_4187032414884518_6684493733824043119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0G9otYStmGsQ7kNvwF_oUZh&_nc_oc=AdqlBaO9WjbEMKF56RzagN1n7Q5xqRrjOs2LUZXpJHPLfs5J0fAHizK0Qu0redhI7bI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcUa0DJANmkfVilxjiE5lIgnB1d5gyGWkiwC9RBF6RbQ&oe=6AA40A2D"}, "display_name": "VAIL", "keywords": ["shooter", "fps", "multiplayer", "social", "extraction"], "long_description": "The highest-rated VR shooter is FREE. VAIL delivers precision-crafted gunplay, 10+ competitive modes, and a massive free Extraction island. \nCustomize your gear, squad up, and see why VAIL has 4.8 stars across 67K reviews.\n\n{1419076756672610}\n\n\n#  **TRAINING GROUNDS (FREE-TO-PLAY)**\nJump in with nothing. Random maps, weapon pickups, and loadout modifiers designed to get you into real gunfights fast. To know what VAIL's gunplay actually feels like in your hands.\n\n{826869113772460}\n{1861007317926953}\n\n#  **EXTRACTION (FREE EARLY ACCESS)**\nDescend into the depths of Reyn. Extract encrypted data, technology, and resources while autonomous drones guard every corridor like archangels. A free, high-stakes mode that rewards patience, precision, and knowing when to run.\n\n{2038611673568486}\n{906663608919767}\n\n\n#  **SOCIAL HUB (FREE-TO-PLAY)**\nVAIL's Social Hub is the center of gravity. Hang out, shoot, Challenge players to 1v1s, or mine ORE shards from the quarry to unlock rewards.\n\n{911511758042190}\n\n\n\n#  **VAIL COMBAT (UNLOCKABLE)**\n\nThis is what VAIL was built for. Team Deathmatch, Seek and Destroy, Free for All, and 10+ more modes. Full progression, 8 prestiges, leaderboards, stats, competitive, and the complete weapon and cosmetics system. Upgrade once, play forever.\n\n{1220581586247000}\n{1547957886294186}\n\n\n\n# **CRITICALLY ACCLAIMED**\nVR Game of the Year Finalist - VR Awards 2022 / People's Voice: Best VR Game - Webby Awards 2024 / Best Social/Interactive - VRDB Community Choice Awards 2024\nVoted by the community. Verified by 67,000+ reviews. 4.8 stars on the Quest store.\n\n{988770307650678}\n\nJoin the community!\nDiscord.gg/VAILVR\n\n{875677118774648}\n\n", "short_description": "The highest-rated VR shooter is FREE. VAIL delivers precision-crafted gunplay, 10+ competitive modes, and a massive free Extraction island. \nCustomize your gear, squad up, and see why VAIL has 4.8 stars across 67K reviews."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aexlab.com/aexlab/privacy", "developer_terms_of_service_url": null, "publisher_name": "AEXLAB", "support_website_url": null, "website_url": "https://vailvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26838625702421072"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499293690_876977051992776_624901567765539258_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFYwWAn0jWsQ7kNvwHZx9qC&_nc_oc=AdowSVy_MwktR7Pk3FLgvFeVUNniP24CEjNweYDmkwHgXKXwqYylgxg0zXd4f1Pd2Ac&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_3vZaEnyHZpPF4VidRU2H2-gE9uWThGo0OtLkdrh3VQ&oe=6AA4150B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VAIL", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1708020000, "lastRevision": {"nodes": [{"id": "6625826957460911", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6625826934127580", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "713432250612954"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": 
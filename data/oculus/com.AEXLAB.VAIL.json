1-7&_nc_sid=6e7a0a&_nc_ohc=uUl5Ec0pjbgQ7kNvwGxbbTK&_nc_oc=Adrs3lJ4KFQgjTWDJz_n0H5UM9RKQAHGHQFORop3OyLjwRpGiqLaczx2T4x6J9aFQqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPl5RiN2-cJPYkeTX-EKGI1WsXTtgtfbmck7xxE0jzNlQ&oe=6AE4B34E"}, {"file_name": "Screenshot_Colonist.png", "id": "1524667099467976", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604360590_1524667102801309_2793018114219272474_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZEWsLLvDIgQ7kNvwEPhlh2&_nc_oc=AdofPnKI-bepPv-q8NrT-tuUHGFXbfkmct1GwEtT_4C67xB6o-wqN46Wlm21KQdsEwc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP60DhwcNvQTIXva-hsT8ftl4QB1WpoHT9aeGnNig0NWQ&oe=6AE4A947"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_V10_Landscape.png", "id": "1387193016916222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831299_1387193020249555_5324741764505112698_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0NoqX1XtzIQ7kNvwEWgcfZ&_nc_oc=AdoUnQf8ATthUQGIbx1juqXtgpGq7YUrCE4ZgQlpEQIJFCjAobPkt382BUFXW8qARPo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMO0b8wlXk7fD8iuYjM7wjcnmAKbWypEw56xMERb8MhyQ&oe=6AE49E7E"}, "display_name": "VAIL", "keywords": ["shooter", "fps", "multiplayer", "social", "extraction"], "long_description": "The highest-rated VR shooter is FREE. VAIL delivers precision-crafted gunplay, 10+ competitive modes, and a massive free Extraction island. \nCustomize your gear, squad up, and see why VAIL has 4.7 stars across 93K reviews.\n\n{1419076756672610}\n\n\n#  **TRAINING GROUNDS (FREE-TO-PLAY)**\nJump in with nothing. Random maps, weapon pickups, and loadout modifiers designed to get you into real gunfights fast. To know what VAIL's gunplay actually feels like in your hands.\n\n{826869113772460}\n{1861007317926953}\n\n#  **EXTRACTION (FREE EARLY ACCESS)**\nDescend into the depths of Reyn. Extract encrypted data, technology, and resources while autonomous drones guard every corridor like archangels. A free, high-stakes mode that rewards patience, precision, and knowing when to run.\n\n{2038611673568486}\n{906663608919767}\n\n\n#  **SOCIAL HUB (FREE-TO-PLAY)**\nVAIL's Social Hub is the center of gravity. Hang out, shoot, Challenge players to 1v1s, or mine ORE shards from the quarry to unlock rewards.\n\n{911511758042190}\n\n\n\n#  **VAIL COMBAT (UNLOCKABLE)**\n\nThis is what VAIL was built for. Team Deathmatch, Seek and Destroy, Free for All, and 10+ more modes. Full progression, 8 prestiges, leaderboards, stats, competitive, and the complete weapon and cosmetics system. Upgrade once, play forever.\n\n{1220581586247000}\n{1547957886294186}\n\n\n\n# **CRITICALLY ACCLAIMED**\nVR Game of the Year Finalist - VR Awards 2022 / People's Voice: Best VR Game - Webby Awards 2024 / Best Social/Interactive - VRDB Community Choice Awards 2024\nVoted by the community. Verified by 67,000+ reviews. 4.8 stars on the Quest store.\n\n{988770307650678}\n\nJoin the community!\nDiscord.gg/VAILVR\n\n{875677118774648}\n\n", "short_description": "The highest-rated VR shooter is FREE. VAIL delivers precision-crafted gunplay, 10+ competitive modes, and a massive free Extraction island. \nCustomize your gear, squad up, and see why VAIL has 4.7 stars across 93K reviews."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aexlab.com/aexlab/privacy", "developer_terms_of_service_url": null, "publisher_name": "AEXLAB", "support_website_url": null, "website_url": "https://vailvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
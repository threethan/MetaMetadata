_7321913003346408327_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n05B-y5bwPkQ7kNvwHv3XgJ&_nc_oc=AdpeYSppwmUGjYsX3ZW9v090yJYQVUYeDOR6m_A6Q0igZyS1K7A1Dkj-RAoBTY2ROI0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-U8l7144OB5B3UVyucumKWZq-WMAk-B8FfBCsPnMTVsQ&oe=6A2D68C3"}, {"file_name": "Screenshot5.png", "id": "3827117000946530", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75340709_3827117004279863_2151149415370285711_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWH6nB5SQ4kQ7kNvwHdf4Eg&_nc_oc=Adr4N7RXPGisMydPCgD4xdjDodv2K2WNxpBIBIEmtDrPBIIYROgFEZXcm9fgim0bd5E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O-G0wfLRXzqpwNlC223TybD261rK1pmfo5lCzwTJsjg&oe=6A2D59FC"}, {"file_name": "Screenshot3.png", "id": "1329895131046853", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982642_1329895134380186_3255244674483954341_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TujHg4hCWCAQ7kNvwF2fbgK&_nc_oc=AdoodMzIjQBC_qj2FBkqSZIzjX7_4omuYoyzTdRm6Pw49BQjalDMOjtqFWjeMhMlFVk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9RZNKDxppyJHaJDA0bzHJGgv8fANioJ8T1nwaisUIiw&oe=6A2D7CE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_V8_Landscape.png", "id": "4187032411551185", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821178_4187032414884518_6684493733824043119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NW1wRn4VzLMQ7kNvwGVTe2v&_nc_oc=Adq919TVODfQJMZTuponTye5tDvCl6hWWpqgKkdBSEv7uZMQpBsbwQhmjHmGv2XEgH4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ad4qg3Cscatw76SGyIFi0IpcK74thRpzasVC1RnO0uw&oe=6A2D632D"}, "display_name": "VAIL", "keywords": ["shooter", "fps", "multiplayer", "social", "extraction"], "long_description": "The highest-rated VR shooter is FREE. VAIL delivers precision-crafted gunplay, 10+ competitive modes, and a massive free Extraction island. \nCustomize your gear, squad up, and see why VAIL has 4.8 stars across 67K reviews.\n\n{1419076756672610}\n\n\n#  **TRAINING GROUNDS (FREE-TO-PLAY)**\nJump in with nothing. Random maps, weapon pickups, and loadout modifiers designed to get you into real gunfights fast. To know what VAIL's gunplay actually feels like in your hands.\n\n{826869113772460}\n{1861007317926953}\n\n#  **EXTRACTION (FREE EARLY ACCESS)**\nDescend into the depths of Reyn. Extract encrypted data, technology, and resources while autonomous drones guard every corridor like archangels. A free, high-stakes mode that rewards patience, precision, and knowing when to run.\n\n{2038611673568486}\n{906663608919767}\n\n\n#  **SOCIAL HUB (FREE-TO-PLAY)**\nVAIL's Social Hub is the center of gravity. Hang out, shoot, Challenge players to 1v1s, or mine ORE shards from the quarry to unlock rewards.\n\n{911511758042190}\n\n\n\n#  **VAIL COMBAT (UNLOCKABLE)**\n\nThis is what VAIL was built for. Team Deathmatch, Seek and Destroy, Free for All, and 10+ more modes. Full progression, 8 prestiges, leaderboards, stats, competitive, and the complete weapon and cosmetics system. Upgrade once, play forever.\n\n{1220581586247000}\n{1547957886294186}\n\n\n\n# **CRITICALLY ACCLAIMED**\nVR Game of the Year Finalist - VR Awards 2022 / People's Voice: Best VR Game - Webby Awards 2024 / Best Social/Interactive - VRDB Community Choice Awards 2024\nVoted by the community. Verified by 67,000+ reviews. 4.8 stars on the Quest store.\n\n{988770307650678}\n\nJoin the community!\nDiscord.gg/VAILVR\n\n{875677118774648}\n\n", "short_description": "The highest-rated VR shooter is FREE. VAIL delivers precision-crafted gunplay, 10+ competitive modes, and a massive free Extraction island. \nCustomize your gear, squad up, and see why VAIL has 4.8 stars across 67K reviews."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aexlab.com/aexlab/privacy", "developer_terms_of_service_url": null, "publisher_name": "AEXLAB", "support_website_url": null, "website_url": "https://vailvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26838625702421072"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293690_876977051992776_624901567765539258_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwgyegUqOp0Q7kNvwFAkdPn&_nc_oc=AdpfBb1FLgnM4M9ZJKLmwCshCHTSblHcMuu5ExUot5dcYVTw525qhYEAzjeBzqZmOUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tbxR40hQcdjRChlvNFrYIxzfJzo4v8qsJVERAZ1jQNg&oe=6A2D6E0B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VAIL", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1708020000, "lastRevision": {"nodes": [{"id": "6625826957460911", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6625826934127580", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "713432250612954"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "HeroCover.png", "id":
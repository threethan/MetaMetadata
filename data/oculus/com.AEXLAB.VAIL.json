5/596149727_1400945522189907_1614140862344603511_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBIO_TbJFjwQ7kNvwH7P2vi&_nc_oc=AdoK7F8S4zgIWlYBYmJbEhuUpJjHtV2GY2iaeEzQdZHNPtMWLQj0NXnpPikCI1uvhng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjlbrGLGhtsVkwBEDgOeXx_Jlz9f_jfBoLShNZIBiq9A&oe=6ACA6F24"}, {"file_name": "01.png", "id": "1433052762345987", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604370996_1433052765679320_3979256481846437544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1SPic5sz6cQ7kNvwENBp6q&_nc_oc=AdrJkfexABJoB-3CviNFiOkVULlyWhSIFEnJveqmC_Ndaxx0jcIhAY3nlkaSPFHTvhI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1P_a4peqr4zf0pe8LAky3wCpf-RspB4ySYIPinKFSqw&oe=6ACA554E"}, {"file_name": "Screenshot_Colonist.png", "id": "1524667099467976", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_1524667102801309_2793018114219272474_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJnOi4KDNmcQ7kNvwG6fePz&_nc_oc=AdqjiWVM_p8-t60RD64B_3DzSpVTcfHanZQ7jtrJa5FmrxkyDm1yxZN0jXeLVd_8Vxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFYf6FN-eE7I2fmIDAQDyt3b-lrLyfBmMRGjhylwp9ZA&oe=6ACA4B47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_V8_Landscape.png", "id": "4187032411551185", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821178_4187032414884518_6684493733824043119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ciej6gCUJkQ7kNvwFQpQPt&_nc_oc=AdotqfwjxXeh9h9lsGXnDKh2VM6N0LT-GMkeZd9vbZF6XTU9x479F1mogh6GslzDixg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4oky6XubSr3_VfPtCw4MKWQ6NCAv-umfLFfSwpVk4cQ&oe=6ACA45AD"}, "display_name": "VAIL", "keywords": ["shooter", "fps", "multiplayer", "social", "extraction"], "long_description": "The highest-rated VR shooter is FREE. VAIL delivers precision-crafted gunplay, 10+ competitive modes, and a massive free Extraction island. \nCustomize your gear, squad up, and see why VAIL has 4.8 stars across 67K reviews.\n\n{1419076756672610}\n\n\n#  **TRAINING GROUNDS (FREE-TO-PLAY)**\nJump in with nothing. Random maps, weapon pickups, and loadout modifiers designed to get you into real gunfights fast. To know what VAIL's gunplay actually feels like in your hands.\n\n{826869113772460}\n{1861007317926953}\n\n#  **EXTRACTION (FREE EARLY ACCESS)**\nDescend into the depths of Reyn. Extract encrypted data, technology, and resources while autonomous drones guard every corridor like archangels. A free, high-stakes mode that rewards patience, precision, and knowing when to run.\n\n{2038611673568486}\n{906663608919767}\n\n\n#  **SOCIAL HUB (FREE-TO-PLAY)**\nVAIL's Social Hub is the center of gravity. Hang out, shoot, Challenge players to 1v1s, or mine ORE shards from the quarry to unlock rewards.\n\n{911511758042190}\n\n\n\n#  **VAIL COMBAT (UNLOCKABLE)**\n\nThis is what VAIL was built for. Team Deathmatch, Seek and Destroy, Free for All, and 10+ more modes. Full progression, 8 prestiges, leaderboards, stats, competitive, and the complete weapon and cosmetics system. Upgrade once, play forever.\n\n{1220581586247000}\n{1547957886294186}\n\n\n\n# **CRITICALLY ACCLAIMED**\nVR Game of the Year Finalist - VR Awards 2022 / People's Voice: Best VR Game - Webby Awards 2024 / Best Social/Interactive - VRDB Community Choice Awards 2024\nVoted by the community. Verified by 67,000+ reviews. 4.8 stars on the Quest store.\n\n{988770307650678}\n\nJoin the community!\nDiscord.gg/VAILVR\n\n{875677118774648}\n\n", "short_description": "The highest-rated VR shooter is FREE. VAIL delivers precision-crafted gunplay, 10+ competitive modes, and a massive free Extraction island. \nCustomize your gear, squad up, and see why VAIL has 4.8 stars across 67K reviews."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aexlab.com/aexlab/privacy", "developer_terms_of_service_url": null, "publisher_name": "AEXLAB", "support_website_url": null, "website_url": 
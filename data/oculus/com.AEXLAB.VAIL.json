41_7321913003346408327_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WlC13v-fxEQ7kNvwEtyr2r&_nc_oc=Adrj8nLjWW65DMqU1jIJmGTu68Y8CUEzbiAyAmLyeQ2fiMAbDCZprbN6mgJ1ELraC_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcnT4d5HYH3d3rp2zYaV4gbrWlFG9K8UeNdPC6NCdA1Q&oe=6AA6B2C3"}, {"file_name": "Screenshot5.png", "id": "3827117000946530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75340709_3827117004279863_2151149415370285711_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UL1gv80AeuUQ7kNvwFq1s3J&_nc_oc=AdoQh0nGu5JL9pV-PHyN1O51EpRwHImhAOMmLJ4e7GOFwrv8WMdVdfetF8JwBtQFfQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcsAyt5inkcykIVyNMplJC-oop7xgkohEmJ454s6reYA&oe=6AA6A3FC"}, {"file_name": "Screenshot3.png", "id": "1329895131046853", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982642_1329895134380186_3255244674483954341_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAvFQc6ifLsQ7kNvwENjZZC&_nc_oc=AdqAiEN46Ra-gbd7ie07u3LyHiEmNpjCw0Fdw0gyBoM5hbZqzxOaCK-25nJ90IAjBDo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFM1Vjs5z05rIhUIrxuIpoC_-KawfGsDWHFfzw4H92-w&oe=6AA6C6E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_V8_Landscape.png", "id": "4187032411551185", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821178_4187032414884518_6684493733824043119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aAEo89L340Q7kNvwH_gdPG&_nc_oc=AdpANojHVTmjvU45jqDAy4jlMInzQkyH-WvjVPQs1toxqaasjiPH_CdkijG6Sl7Rof0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdKP0yBnqFVJt4Sa4oKaGiCk1vgnC4Tl9plxRQ8Mg2dg&oe=6AA6AD2D"}, "display_name": "VAIL", "keywords": ["shooter", "fps", "multiplayer", "social", "extraction"], "long_description": "The highest-rated VR shooter is FREE. VAIL delivers precision-crafted gunplay, 10+ competitive modes, and a massive free Extraction island. \nCustomize your gear, squad up, and see why VAIL has 4.8 stars across 67K reviews.\n\n{1419076756672610}\n\n\n#  **TRAINING GROUNDS (FREE-TO-PLAY)**\nJump in with nothing. Random maps, weapon pickups, and loadout modifiers designed to get you into real gunfights fast. To know what VAIL's gunplay actually feels like in your hands.\n\n{826869113772460}\n{1861007317926953}\n\n#  **EXTRACTION (FREE EARLY ACCESS)**\nDescend into the depths of Reyn. Extract encrypted data, technology, and resources while autonomous drones guard every corridor like archangels. A free, high-stakes mode that rewards patience, precision, and knowing when to run.\n\n{2038611673568486}\n{906663608919767}\n\n\n#  **SOCIAL HUB (FREE-TO-PLAY)**\nVAIL's Social Hub is the center of gravity. Hang out, shoot, Challenge players to 1v1s, or mine ORE shards from the quarry to unlock rewards.\n\n{911511758042190}\n\n\n\n#  **VAIL COMBAT (UNLOCKABLE)**\n\nThis is what VAIL was built for. Team Deathmatch, Seek and Destroy, Free for All, and 10+ more modes. Full progression, 8 prestiges, leaderboards, stats, competitive, and the complete weapon and cosmetics system. Upgrade once, play forever.\n\n{1220581586247000}\n{1547957886294186}\n\n\n\n# **CRITICALLY ACCLAIMED**\nVR Game of the Year Finalist - VR Awards 2022 / People's Voice: Best VR Game - Webby Awards 2024 / Best Social/Interactive - VRDB Community Choice Awards 2024\nVoted by the community. Verified by 67,000+ reviews. 4.8 stars on the Quest store.\n\n{988770307650678}\n\nJoin the community!\nDiscord.gg/VAILVR\n\n{875677118774648}\n\n", "short_description": "The highest-rated VR shooter is FREE. VAIL delivers precision-crafted gunplay, 10+ competitive modes, and a massive free Extraction island. \nCustomize your gear, squad up, and see why VAIL has 4.8 stars across 67K reviews."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aexlab.com/aexlab/privacy", "developer_terms_of_service_url": null, "publisher_name": "AEXLAB", "support_website_url": null, "website_url": "https://vailvr.com/", "cat
nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0qZhKASGpcQ7kNvwFrGm5H&_nc_oc=AdreXnEiv9EifWCNsmaQ0-KnD9fzZD_95adalUt4F4C7_rXGaQgIRQW3PszNKqHQ68E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjJvrYwEIUXfXymjcgCzbhpHHdI6CXGVSR_nJVRmNJHA&oe=69CFAD63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape.png", "id": "1713229479151882", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036617_1713229482485215_2083808281094830010_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePhCjSO_UssQ7kNvwGJz36S&_nc_oc=AdoCCdbYHsoQdi1wQKC4pIL4v6H5xH9zWii9Vi4mlIY1mFSkWA4rKF9RHwvz2vs3Lxw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6_UZL57gagn-lSjwFpwLxL-EbjNU1aiF1rk4CtKXRxw&oe=69CFB8EA"}, "display_name": "VAIL", "keywords": [], "long_description": "VAIL is a 5v5 tactical shooter game developed from the ground-up for virtual reality.\n\nImmersive Physics:\nGuns collide with the environment. Throw magazines to teammates, bounce grenades around corners, climb ladders, vault over obstacles, ride ziplines, defy gravity on jump pads, and more.\n\nCompetitive Integrity:\nEverything in VAIL is designed to uphold competitive integrity. From standardizing player height, to preventing play space cheats; trust that every match will be competitive and fair.\n\nSocial Experiences (in development):\nAfter a fast-paced match, challenge friends to mini-games in the social hub, flex gun and avatar skins, or 1v1 a friend. Customizable home, game modes and experiences in development.", "short_description": "VAIL VR is a virtual reality multiplayer competitive shooter. Emphasizing tactical gunplay, high-caliber combat, and collaborative teamwork. Introducing the ultimate VR shooter experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vailvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "AEXLAB", "support_website_url": null, "website_url": "https://vailvr.com/", "cat
l8Ojm&_nc_oc=AdroIOoNT6NNFKb9dAcZqU_FNVEcczTx6IHDUwTnbMdJ6gRwj2wsAdqTT2bdow9CHuc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72cRkaOC_kr5AZeOYo38K-piS9lqD8IKL7d_itdLSdyg&oe=6A031629"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover vedio 2560 x 1440.png", "id": "1119535483612862", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300946_1119535486946195_6878510991450444476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCsX1Sph5ooQ7kNvwH5Bwb7&_nc_oc=AdpBDo5hBKfOX5YldPzZyImYfb9Jj6m69thw4o-wvzzrfKf9qHIcc3AHbwDau5jxBGs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GhM2tIRUctG_BUVIzT2SLO6WpiCpg2P9FhEQnqxUCHQ&oe=6A032734"}, "display_name": "Event Extinction", "keywords": [], "long_description": "Story:\nUrsalam wakes up not knowing where he is and believes he is in the present time.\nBut he finds himself in a world where human robots and drones are at war.\nThey want to kill him, control him, or worse.\nEven the world itself is unnatural and has an anomaly in its reality.\nHe fights to survive and return home, searching for any living human beings, if any are still there.\nHe tries to make friends with robots to help him understand what is happening.\nDescription :\nOpen world game (includes 3 maps). Sci-fi action , survival , craft  . weapons\n- The story is about trust, betrayal, decision-making, technological advancements and fears of them.\nIt discusses the issue of existence and God.", "short_description": "Open world game (includes 3 maps). Sci-fi action.\nThe story is about trust, betrayal, decision-making, technological advancements and fears of them.\nIt discusses the issue of existence and God.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTMEtpW8pI7eBB0YK2FEwfZdNsEB2GWhoPMz_BTlzDE6moQ3Hy1SkuN9ZsTFMfZp7seI3sDioSIgpNv/pub", "developer_terms_of_service_url": null, "publisher_name": "salem abed", "support_website_url":
_UGgQ7kNvwFWe9HN&_nc_oc=AdrpFXdp3juGbuiuyMmHiWtQA4WAzcYKAyHuVnelzaWodPusEygw4w5SRlDAdpDG26k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h4DUaCl6tB5HyUFHsAn1GslgMUnFOJ9Fj9VLDZ8aa3Q&oe=6A1ED4C9"}, {"file_name": "W2.png", "id": "812642324603858", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822883_812642327937191_7317020464623527405_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H71couPs8KQQ7kNvwFKDti9&_nc_oc=AdpDRvlBEqcHR4RhJbhvAxenul5DYnYvtbvC4rVsvKRpnZjAQLNraMoze_C1x__cva8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PKHWV_vrYGL9ivXdZirXViJrH4lxaKxIlTDJC8rqNbA&oe=6A1EFE32"}, {"file_name": "maps 2.png", "id": "961001309547817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302770_961001312881150_3889997902912793011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vyqOZl2oqAQ7kNvwEb6ass&_nc_oc=AdpBMJko3E-gPZy0mnMxSpjIFdrUfjGFDihlUkf3rJA1yFIzaDmMBPUar6JJAbXv8CE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RTanZpv0UafMfI_ELE66lBjwZmf7Kp5jdaHiieEOwVg&oe=6A1EFDE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover vedio 2560 x 1440.png", "id": "1119535483612862", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300946_1119535486946195_6878510991450444476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ixi_kbD61UQ7kNvwFRMlcb&_nc_oc=AdrisdM6httHDOLtuE3C09eG0v1Wpe92qEJ_hjNZjYFd4raFm3LHfp9HWqjPC3f7uDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yfTrKdmzkK8oisg3YxhSP7saa_O56ShNRKdDpTUZ-lw&oe=6A1ED6B4"}, "display_name": "Event Extinction", "keywords": [], "long_description": "Story:\nUrsalam wakes up not knowing where he is and believes he is in the present time.\nBut he finds himself in a world where human robots and drones are at war.\nThey want to kill him, control him, or worse.\nEven the world itself is unnatural and has an anomaly in its reality.\nHe fights to survive and return home, searching for any living human beings, if any are still there.\nHe tries to make friends with robots to help him understand what is happening.\nDescription :\nOpen world game (includes 3 maps). Sci-fi action , survival , craft  . weapons\n- The story is about trust, betrayal, decision-making, technological advancements and fears of them.\nIt discusses the issue of existence and God.", "short_description": "Open world game (includes 3 maps). Sci-fi action.\nThe story is about trust, betrayal, decision-making, technological advancements and fears of them.\nIt discusses the issue of existence and God.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTMEtpW8pI7eBB0YK2FEwfZdNsEB2GWhoPMz_BTlzDE6moQ3Hy1SkuN9ZsTFMfZp7seI3sDioSIgpNv/pub", "developer_terms_of_service_url": null, "publisher_name": "salem abed", "support_website_url": null, "website_url": "https://sites.google.com/view/eventextinction", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24676916061929805"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298387_1776385986296836_2552935663278892069_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVWLMexXfIYQ7kNvwEyOHy9&_nc_oc=AdpSW9SXtG_FCWRp8WE1kpr7iY6uRy
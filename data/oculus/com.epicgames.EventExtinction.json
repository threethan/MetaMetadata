_jDEQ7kNvwEzKGD_&_nc_oc=AdqbxQYXNiyiM8XHdEp0_AIEUfSACxhLUr8sT6hWgG4azo1MLW24FdEirH9U3WsPG1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbk6nNMiBMY8Q_dC7wnC2PQ3yEBV4_U3O5nvmx95xzNg&oe=6A997049"}, {"file_name": "W2.png", "id": "812642324603858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822883_812642327937191_7317020464623527405_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiiHZQk18ToQ7kNvwFFj4e2&_nc_oc=AdpZ_IvypV-5oFbBI1-CAkso6jsNFD3xLpeRXuDx2tiDXjIQ0fxeInDbkqd5bHvE1_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTNupp2OHZALLx-LedemOkNWfmMUL9iE17Z2eiWgstUA&oe=6A9999B2"}, {"file_name": "maps 2.png", "id": "961001309547817", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_961001312881150_3889997902912793011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgC5RLbXm5MQ7kNvwHotHSU&_nc_oc=AdrsyEuEjt7IpwJVjp9x_2_xke6-jsf_ieMUf1VYCMbNfKQ8jzNesG1QrxUcwGte224&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-svyoToj1BczuBzQ4fPAPQJq-V9xqEoFUa9SBmHIaOQ&oe=6A999969"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover vedio 2560 x 1440.png", "id": "1119535483612862", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300946_1119535486946195_6878510991450444476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckGIivW6fNIQ7kNvwF0dpIp&_nc_oc=Ado24Y2dS8sPPEEtgwUiyucAgJZhFeHDXVjRDBXcMh1CJ5hSxpekuViXoXAXhpaoocc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm2nVHXUUGggsHgppI9PEXPrv3HL8IINCiCoPgDxk86Q&oe=6A997234"}, "display_name": "Event Extinction", "keywords": [], "long_description": "Story:\nUrsalam wakes up not knowing where he is and believes he is in the present time.\nBut he finds himself in a world where human robots and drones are at war.\nThey want to kill him, control him, or worse.\nEven the world itself is unnatural and has an anomaly in its reality.\nHe fights to survive and return home, searching for any living human beings, if any are still there.\nHe tries to make friends with robots to help him understand what is happening.\nDescription :\nOpen world game (includes 3 maps). Sci-fi action , survival , craft  . weapons\n- The story is about trust, betrayal, decision-making, technological advancements and fears of them.\nIt discusses the issue of existence and God.", "short_description": "Open world game (includes 3 maps). Sci-fi action.\nThe story is about trust, betrayal, decision-making, technological advancements and fears of them.\nIt discusses the issue of existence and God.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTMEtpW8pI7eBB0YK2FEwfZdNsEB2GWhoPMz_BTlzDE6moQ3Hy1SkuN9ZsTFMfZp7seI3sDioSIgpNv/pub", "developer_terms_of_service_url": null, "publisher_name": "salem abed", "support_website_url": null, "website_url": "https://sites.google.com/view/eventextinction", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24676916061929805"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298387_1776385986296836_2552935663278892069_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGWiZmKN3ukQ7kNvwFdAZVk&_nc_oc=AdoAkEUsTWxdHxCzDhZtjpcsSFzuek
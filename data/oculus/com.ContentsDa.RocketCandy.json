q9dyvD4sWyp5gtROqzWgxli0yiR15tBH7yE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy37eqR-VVeNlw6H4jCmkQwooofdkPJ2MGM0Rd0_6ArDw&oe=69CE50AD"}, "display_name": "Rocket Candy - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "rocket", "science", "contentsda"], "long_description": "1. Insert the tube into the tube stand. \n2. Weigh 5 grams of potassium chlorate on a balance and add it to the test tube.\n3. Melt the potassium chlorate with a blowtorch.  \n4. Add the sugar. \n5. Use the resulting sugar rocket fuel to launch the rocket.", "short_description": "Blast off into the realm of chemical propulsion with the Rocket Candy experiment. This hands-on activity showcases the principles of combustion and thrust, as you create a simple, sugar-based rocket fuel. It's an exhilarating way to explore the basics of rocket science."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9381904528490389"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v
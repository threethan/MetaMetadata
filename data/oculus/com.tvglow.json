lh5zahWlWDze97aHf5l__XU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVsXAf5kXVgBTcDNQunqpL9YaBig9CH1GamOTm_UdpLpw&oe=6B106034"}, {"file_name": "10-lodge-movies-on-demand-catalog.png", "id": "1004999978734706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908835840_1004999982068039_5554282974747715504_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sW9GQEf9WQQ7kNvwHqKxpo&_nc_oc=AdojrEYmpP43Xwk39nMjsOHPC4bS_zdMCxCxPMD8vCOGtpUr6WPgrcMz5aONTusYpoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUr3w5PwYXLV6pgtW4Olu-MYdtoZnTvCmykd23cN0X0Aw&oe=6B104186"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1673710650786073", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908842225_1673710657452739_1168901835616762806_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_4D4rCickwQ7kNvwExTMq2&_nc_oc=Adp4VQlCUNSjphIaZPj8LuOc_9V9NxymUJ80xV3vO8ZSQ3bBHi9vinoCB1CX8Bp_4No&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXg9VsbWQIYwiXAFiZFqoPDeMf6BbvsxoqfG-w-bIWpag&oe=6B1057C2"}, "display_name": "TVGlow - IPTV & More", "keywords": ["IPTV", "M3U", "TV", "EPG", "Player"], "long_description": "Play your own M3U playlist, Xtream login, or Plex, Jellyfin, or Emby server on a giant screen. It does not include channels or TV subscriptions.\n\n3D ROOMS & 3D VIEWING\nWatch in five 3D rooms (living room, outdoor theatre, stadium, lodge, dark room) or a resizable window, or use passthrough to see the screen in your own room. Curve the screen, add ambient glow, tilt to watch lying back, and play side-by-side or top-and-bottom 3D movies.\n\nFREE PLAYER, NO TIME LIMIT\nThe player plays your live TV, movies, and shows from one source, with a clear Guide (EPG), search, resume, favorites, and a custom list, in 20 languages. No in-app ads, no sign-up.\n\nONE PREMIUM PURCHASE\nA one-time Meta Horizon Store purchase unlocks player features, not TV content: Multiview screens around you, Timeshift and Replay, downloads, channel organization, filters, more sources and lists, online subtitles, and encrypted sync of your sources. It covers up to 6 active devices in total. Try it free for 7 days with no card.\n\nTimeshift, Replay and downloads depend on your source. Use only content you are authorized to access or download.\n\nTVGlow is a media player only. It provides no channels, playlists or other content, and is not affiliated with any IPTV provider.\nPlex and Plex Media Server are trademarks of Plex, Inc.; Jellyfin and Emby are trademarks of their respective owners. TVGlow works with these media servers but is not affiliated with, endorsed by or certified by any of their owners.", "short_description": "Turn your headset into a private cinema for your IPTV playlist or Plex, Jellyfin, or Emby server. Watch your live TV with a guide, movies, shows, and 3D films in five 3D rooms or a resizable window. Curve the screen, add ambient glow, or tilt the view to watch lying back.\n\nThe player is free: no in-app ads, no time limit, no sign-up. Add your M3U, Xtream, or media server source. It does not include channels or TV subscriptions. One optional Premium upgrade also covers your other devices."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tvglow.app/privacy/meta-quest/", "developer_terms_of_service_url": "https://tvglow.app/terms/", "publisher_name": "18228001 Canada Inc.", "support_website_url": "https://tvglow.app/support/", "website_url": "https://tvglow.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_
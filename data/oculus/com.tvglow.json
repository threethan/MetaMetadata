e": "hero-3000x900.png", "id": "1026541600482392", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/806363909_1026541603815725_1399708303186082739_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVna7AZUneIQ7kNvwGqlfcC&_nc_oc=AdpzZPzUYrYXDjfbMcaKmldZngkH92id6G5LRPI27guVIMLeiGVcbLDUalByvQ7D_N8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSzEenjrpANjUv8ktGATSfOfN9ZcZv74CUchr4DvzYbQ&oe=6B09B3C2"}]}, "id": "1682915763199262", "locale": "en_US", "screenshots": [{"file_name": "01.png", "id": "1836143384232625", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673525341_1836143387565958_8586432102662081152_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SAAELvO7vcQ7kNvwH56ThB&_nc_oc=AdrsYlXmihURREj3Snwj_M8l_Cl3YQiw7aHXvA8LJaCS1C6mdl_wVGYFgZ9fZ1AHzJU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPl3EBsQmgDCZJ8wTB7CdZOkISJHsYbjQr-y6PuVZH5w&oe=6B099C23"}, {"file_name": "02.png", "id": "2990035271349891", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_2990035278016557_4810726452002414658_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4iqkkWGtBoQ7kNvwHDTG1x&_nc_oc=AdrHzufMp8e4Anar0bSENJIS6g8XfLZO-UXvc_2PbbuPh0-KgqFC9ehPlNYZrafCwyA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3MBkmLCN7OAXMGyv5Wg1Hi0pYrq35goQltwg-GGsJRQ&oe=6B09AAD4"}, {"file_name": "03.png", "id": "1607013527318747", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312257_1607013530652080_2201604235503063976_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMUoX3Loy28Q7kNvwGScG2F&_nc_oc=AdoGlWWOL2RAseiXaij-kbhm2LwDy_Keau0bq4FHQQ7RuGA_SIdq71GDqbqZ4q_XhTw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR8H--Kq3wsp1HZmQpIkqrMykuOLiphpIBIa17shx6Sw&oe=6B09CB1E"}, {"file_name": "04.png", "id": "1507546591262644", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/769741158_1507546594595977_2974646934720909639_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EO8d5mQE720Q7kNvwGfWX1s&_nc_oc=AdqdE7qzL0Nq72wrgoFXscYM8wCuZaL2KgWAoQ4qCXysqQ7dcA3woiPxVHPRDqBSnMY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWoQzDzdUeKW4vlUjmc8Qg4pqPEbSj5pMco2g0dUpPhQ&oe=6B09BB68"}, {"file_name": "05.png", "id": "1811705440046972", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499313074_1811705443380305_4773766464636240009_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xJ-1LWv_X4Q7kNvwG0AAYX&_nc_oc=AdpYGoSzmdyh3hnQjQRk-nPw54pXPsrk8PtRuhB37MxSLjchndJ_Dk6jdsxmARdyYL0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO9b_mV9SYw2VA_HnAgvlQcypdXIuIhOa6eV_Yyiqg9Q&oe=6B09C7D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TVGlow - IPTV & More", "keywords": ["IPTV", "M3U", "TV", "EPG", "Player"], "long_description": "TVGlow plays your own IPTV source: an M3U playlist or Xtream login, or your own Plex, Jellyfin or Emby server. It does not include channels or TV subscriptions.\n\nWATCH IN THE ROOM\nA cinema-sized screen in a 3D room: a living room, an outdoor theatre, a stadium, a lodge or a dark room. Or a panel you can resize.\n\nFREE, FOR AS LONG AS YOU LIKE\nLive TV, Guide, search, movies and shows with resume, recently watched, Home rows, sports schedules, favorites and a list of your own, with one source, in 20 languages. No email or card. Add your source and you're watching in a minute.\n\nWANT MORE? ONE PREMIUM PURCHASE\nAn optional one-time purchase through the Meta Horizon Store. It unlocks player features, not TV content: Multiview screens around you, Timeshift and Replay, downloads, channel organization, filters, more sources and lists, online subtitles, and end-to-end encrypted sync. It covers up to 6 active devices in total: headsets, phones, tablets, TVs and PCs. Try Premium free for 7 days with no card.\n\nTimeshift, Replay and downloads depend on your source. Use only content you are authorized to access or download.\n\nTVGlow is a media player only. It provides no channels, playlists or other content, and is not affiliated with any IPTV provider.\nPlex and Plex Media Server are trademarks of Plex, Inc.; Jellyfin and Emby are trademarks of their respective owners. TVGlow works with these media servers but is not affiliated with, endorsed by or certified by any of their owners.", "short_description": "Your own IPTV playlist or media server on a cinema-sized screen: a living room, an outdoor theatre, a stadium, a lodge or a dark room, or a resizable panel. A clear TV guide, one click to play, and movies and shows that pick up where you left off. Free player: no in-app ads, no time limit, no sign-up.\n\nTVGlow plays your own M3U playlist, Xtream login or home media server; it does not include channels or TV subscriptions. One optional Premium purchase also covers your phone, tablet, TV and PC."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tvglow.app/privacy/meta-quest/", "developer_terms_of_service_url": "https://tvglow.app/terms/", "publisher_name": "18228001 Canada Inc.", "support_website_url": "https://tvglow.app/support/", "website_url": "https://tvglow.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "hi", "es", "pt_BR", "bn", "ru", "id", "ur", "ja", "mr", "vi", "de", "te", "tr", "he", "ko", "it", "ar"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"],
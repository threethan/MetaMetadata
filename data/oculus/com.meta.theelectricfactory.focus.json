-7&_nc_sid=6e7a0a&_nc_ohc=dUBWuNwRLqIQ7kNvwHHbHLN&_nc_oc=AdrHKWRePpIwlv1ieoVpDZiDrIBFR8ShlhK1JitTi_QbJ5N3rgXie-ORl8yr1rmhAqM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBhLAsGVm0IrrrGeL_rThtRRnPqXOL9OuZM9qYGR9Fuw&oe=6AC27185"}, {"file_name": "Screenshot-Focus-5 revised.png", "id": "509537288353957", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75322598_509537291687290_7386728312272241154_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J92jEfYVoSgQ7kNvwG7X0PJ&_nc_oc=AdqKNGCaWFB_KawRHlZLS7fa7JRUSWsps5lxscVu2gkWEZd1z3CHgyKN-aHnPFsXvNQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOf53UqXtIkL61pzKQrWcNUY8q9YHsSK8ODUj9kCHJyew&oe=6AC26D0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Focus", "keywords": ["Productivity", "Brainstorming", "Creative", "Ideation"], "long_description": "Immerse yourself in Focus, a spatial brainstorming tool designed to enhance your productivity and creativity. Experience a new way of working by building mind maps, prioritizing tasks, jotting down ideas and interacting with AI assistance. Transform your workspace with virtual stickers, arrows and post-its, allowing you to visualize and organize your thoughts like never before. Focus rethinks the traditional brainstorming process, enabling you to fully engage with your projects in a dynamic, spatial environment.", "short_description": "Focus is a VR/MR app created for developers to demonstrate how you can build a Productivity app using Meta Spatial SDK. The app supports panel and object management, enabling the creation, reuse, and destruction of interactive elements within varied environments."}]}, "developer_name": "Meta", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags
98527534_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lbZAaew4HAQ7kNvwFk1lTh&_nc_oc=Adne165PudxWSizh7cDwr1IpPMipf3uRH5d6Pca_Q0Oq1iTQ9h3IPxDThDYYM-i9mEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afycswfk1rUOXQtI2N_e5TOtPBfZnmEHA-FcZAtK6rlsqQ&oe=69BFD345"}, {"file_name": "Screenshot-Focus-5 revised.png", "id": "509537288353957", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75322598_509537291687290_7386728312272241154_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EaCra3WoEsQ7kNvwE6sl1T&_nc_oc=Adks1yTl-kyATpApKWbIG-3VYS1JaaRh_fZcZm_-hCkQCHVcMmT51bLS5MG7Xd-qH-Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzj0_73RbWIhpO0TGfjlbgeQ7H9_WY7baXo7NGnof7qUg&oe=69BFCECD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Focus", "keywords": ["Productivity", "Brainstorming", "Creative", "Ideation"], "long_description": "Immerse yourself in Focus, a spatial brainstorming tool designed to enhance your productivity and creativity. Experience a new way of working by building mind maps, prioritizing tasks, jotting down ideas and interacting with AI assistance. Transform your workspace with virtual stickers, arrows and post-its, allowing you to visualize and organize your thoughts like never before. Focus rethinks the traditional brainstorming process, enabling you to fully engage with your projects in a dynamic, spatial environment.", "short_description": "Focus is a VR/MR app created for developers to demonstrate how you can build a Productivity app using Meta Spatial SDK. The app supports panel and object management, enabling the creation, reuse, and destruction of interactive elements within varied environments."}]}, "developer_name": "Meta", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_
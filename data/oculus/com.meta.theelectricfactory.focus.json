-7&_nc_sid=6e7a0a&_nc_ohc=hhIrM3NeMxIQ7kNvwF1Fwbm&_nc_oc=AdqAilhx_oHoRh-eR6QjBQiFLhfeEitq0gtwIFEB0OUBuJfEfPdHYLywSOXCoamSBFg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2jtJj6Fk05UPuXdvnwAxPBUBDgAH-X_CRK-44iixkZQ&oe=6A9171C5"}, {"file_name": "Screenshot-Focus-5 revised.png", "id": "509537288353957", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75322598_509537291687290_7386728312272241154_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmXC96ZCZ7EQ7kNvwGtmMI0&_nc_oc=AdpfRTNt536gytJioGzlK8A91-1YnawkdllbMdk2l5X7g4GmTYgxWaR1fBK3HkD00jU&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBry__OmLDbe-5NpHC_6GJQ46bz57kHCJfzvQ4XHrzKQ&oe=6A916D4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Focus", "keywords": ["Productivity", "Brainstorming", "Creative", "Ideation"], "long_description": "Immerse yourself in Focus, a spatial brainstorming tool designed to enhance your productivity and creativity. Experience a new way of working by building mind maps, prioritizing tasks, jotting down ideas and interacting with AI assistance. Transform your workspace with virtual stickers, arrows and post-its, allowing you to visualize and organize your thoughts like never before. Focus rethinks the traditional brainstorming process, enabling you to fully engage with your projects in a dynamic, spatial environment.", "short_description": "Focus is a VR/MR app created for developers to demonstrate how you can build a Productivity app using Meta Spatial SDK. The app supports panel and object management, enabling the creation, reuse, and destruction of interactive elements within varied environments."}]}, "developer_name": "Meta", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags
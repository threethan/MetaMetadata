-7&_nc_sid=6e7a0a&_nc_ohc=9FOP1qoK1XIQ7kNvwE2vMYB&_nc_oc=Adpf1nsNTnWCyHVgs_4Dr36i7A67DVnq9VIpPFeXjvztzRByrRmsXCWIpW8-LYk_oQI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_pTCk_RY5HFWgMhNwPfedm2GieQSruJ9MWWQ_-Fte3g&oe=6A0B3105"}, {"file_name": "Screenshot-Focus-5 revised.png", "id": "509537288353957", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75322598_509537291687290_7386728312272241154_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOyBQ4bc8LIQ7kNvwHaiVFZ&_nc_oc=AdpnqPQSOrKwWzSYCVW1rtx3uZJy5uvEkdas9aPdVr9MJ0fmX2T5O8qeQY6iknFGktw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PvKQYVcmMmba-r-C_EDQ490IzQIF2IlaDiKg7MDgvPg&oe=6A0B2C8D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Focus", "keywords": ["Productivity", "Brainstorming", "Creative", "Ideation"], "long_description": "Immerse yourself in Focus, a spatial brainstorming tool designed to enhance your productivity and creativity. Experience a new way of working by building mind maps, prioritizing tasks, jotting down ideas and interacting with AI assistance. Transform your workspace with virtual stickers, arrows and post-its, allowing you to visualize and organize your thoughts like never before. Focus rethinks the traditional brainstorming process, enabling you to fully engage with your projects in a dynamic, spatial environment.", "short_description": "Focus is a VR/MR app created for developers to demonstrate how you can build a Productivity app using Meta Spatial SDK. The app supports panel and object management, enabling the creation, reuse, and destruction of interactive elements within varied environments."}]}, "developer_name": "Meta", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags
nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vptz4YpZ_VSAQ5muEGenkAD9iFfSyUqhQzZdwyAG8cQ&oe=6A37E1BA"}, {"file_name": "Screenshot-Focus-3 revised.png", "id": "478044138401808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_478044141735141_2926656663082272618_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpamZpHawpcQ7kNvwF97jWy&_nc_oc=Ado_9-_rP1M3bs2xgM5Bi8Scd1KGI8n_W21mk6o2TtIGVaYnwrv-OUhUFUCTPDULgcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_502-rF-JuWjVUAlZi04y0weouv5YrMx8GKeQPsdW4JQ&oe=6A37EB91"}, {"file_name": "Screenshot-Focus-4 revised.png", "id": "1032663918541423", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031435_1032663921874756_2128543463098527534_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBoM-zvZli0Q7kNvwHyhFy1&_nc_oc=AdrEbHWKTFSxRTbayOJOfoVtyCcKMzwVLahRwA-vYOMliaEUPC38J0YGaI94Y1PlMSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vfFXB8OnU3p5wj6rsBhSjuDYL50UmIpocbShfTWkh3g&oe=6A380405"}, {"file_name": "Screenshot-Focus-5 revised.png", "id": "509537288353957", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75322598_509537291687290_7386728312272241154_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0Yi9n36mRoQ7kNvwGL7h0P&_nc_oc=AdrgiM9_YwkNYqig2hnrZI4iJi90S1Vii03fhIr6-NdJgDYu3QPKtNnHQCWy98aPVC0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QdHTUBvE2WC4kQL-z3-6zIsGGOoMLns7R4g1v-CgkDA&oe=6A37FF8D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Focus", "keywords": ["Productivity", "Brainstorming", "Creative", "Ideation"], "long_description": "Focus is a developer reference app designed to show developers how to build spatialized experiences using the Meta Spatial SDK.\n\nThis spatial brainstorming tool is designed to enhance your productivity and creativity. Experience a new way of working by building mind maps, prioritizing tasks, jotting down ideas and interacting with AI assistance. Transform your workspace with virtual stickers, arrows and post-its, allowing you to visualize and organize your thoughts like never before. Focus rethinks the traditional brainstorming process, enabling you to fully engage with your projects in a dynamic, spatial environment.\n\n**More about Focus:**\n\nhttps://developers.meta.com/horizon/documentation/spatial-sdk/focus\n\n**More about Meta Spatial SDK:**\n\nhttps://developers.meta.com/horizon/develop/spatial-sdk", "short_description": "Focus is a VR/MR app created for developers to demonstrate how you can build a Productivity app using Meta Spatial SDK. The app supports panel and object management, enabling the creation, reuse, and destruction of interactive elements within varied environments."}]}, "developer_name": "Meta", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9309867339034729"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974835_1542944676310819_5317066524332241666_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JR4U_gzksYcQ7kNvwFxTNq2&_nc_oc=Adpsw115gbyXyspv1mFnembIjsKR4InyW
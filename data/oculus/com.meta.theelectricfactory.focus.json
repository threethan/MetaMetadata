-7&_nc_sid=6e7a0a&_nc_ohc=WiSYTKeFNw8Q7kNvwFNi2Qd&_nc_oc=AdrLbtySxOnoyuP5h5ZhiUj9nQsWMTEm1qrJsfxqcPijalORJEseG177HrKx5OW5LcQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3g54LtARVU0pXoHc4orIp3Hqe4H5WMyWpjR9AVLoqVA&oe=6AF33905"}, {"file_name": "Screenshot-Focus-5 revised.png", "id": "509537288353957", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75322598_509537291687290_7386728312272241154_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jdG9vtd64EQ7kNvwGscRhy&_nc_oc=Adr2Ka_Ahix7zu6VTl6X8hSOvHF8uKVHnwk3vrDayz_SBww2g4GWUPTseoHDnL_Rbh4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnUiTyenjpVxx73wkMgssvYbr2rXpIuL8Bw8DOd7P-1Q&oe=6AF3348D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Focus", "keywords": ["Productivity", "Brainstorming", "Creative", "Ideation"], "long_description": "Immerse yourself in Focus, a spatial brainstorming tool designed to enhance your productivity and creativity. Experience a new way of working by building mind maps, prioritizing tasks, jotting down ideas and interacting with AI assistance. Transform your workspace with virtual stickers, arrows and post-its, allowing you to visualize and organize your thoughts like never before. Focus rethinks the traditional brainstorming process, enabling you to fully engage with your projects in a dynamic, spatial environment.", "short_description": "Focus is a VR/MR app created for developers to demonstrate how you can build a Productivity app using Meta Spatial SDK. The app supports panel and object management, enabling the creation, reuse, and destruction of interactive elements within varied environments."}]}, "developer_name": "Meta", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags
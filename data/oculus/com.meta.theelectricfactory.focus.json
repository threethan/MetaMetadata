-7&_nc_sid=6e7a0a&_nc_ohc=uKBkKCyXNbsQ7kNvwFiq5zJ&_nc_oc=Ado2Mkyt4aAi60K5bKH4qyfO9E-o_K-vU-nyHbO4UdqtfOGbwXyt6uFMtwxYXe9qvM0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gsp153bRpsM33te3ILVdjxm_aBpP0FqVxtoeK2VyXCQ&oe=69EB54C5"}, {"file_name": "Screenshot-Focus-5 revised.png", "id": "509537288353957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75322598_509537291687290_7386728312272241154_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P74P9CW0DnwQ7kNvwFonNVy&_nc_oc=Ado6WyRqbnCt9Soc85_dR1Gj4zYoHlp6Ewrsjp6ZfKo_JYSooKD1OvBec2NnWR3wIpI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CbtcUsr8VC2OP8iSNVz52yDvRalwBJIU4J6cFbMyX2g&oe=69EB888D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Focus", "keywords": ["Productivity", "Brainstorming", "Creative", "Ideation"], "long_description": "Immerse yourself in Focus, a spatial brainstorming tool designed to enhance your productivity and creativity. Experience a new way of working by building mind maps, prioritizing tasks, jotting down ideas and interacting with AI assistance. Transform your workspace with virtual stickers, arrows and post-its, allowing you to visualize and organize your thoughts like never before. Focus rethinks the traditional brainstorming process, enabling you to fully engage with your projects in a dynamic, spatial environment.", "short_description": "Focus is a VR/MR app created for developers to demonstrate how you can build a Productivity app using Meta Spatial SDK. The app supports panel and object management, enabling the creation, reuse, and destruction of interactive elements within varied environments."}]}, "developer_name": "Meta", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags
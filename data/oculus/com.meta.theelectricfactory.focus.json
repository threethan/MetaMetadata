-7&_nc_sid=6e7a0a&_nc_ohc=CR9694WqYLoQ7kNvwFN_5ce&_nc_oc=Adq_uIP98rW5fL7dBZ6oHKCuw3C_vaFhTcMdQIKaCYV3mbPvnJG0aMLIyO4Ke_LsB8c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pTX4SFXGvloZ44QpQjQ4L5xI-6uUZOtLmcXhpS6mydw&oe=6A47D605"}, {"file_name": "Screenshot-Focus-5 revised.png", "id": "509537288353957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75322598_509537291687290_7386728312272241154_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=augdfB5XpEsQ7kNvwEHGMKy&_nc_oc=AdqTIY-xaRpnN8Q_EwSssI1Rm1UmllUw4iKp40KblnKnXU112KwB9jXLEQiRyXxLfGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NDf5_QKkZxzLOuS__h2Xp6M48PXYzr7kBjmz8O6CZHw&oe=6A47D18D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Focus", "keywords": ["Productivity", "Brainstorming", "Creative", "Ideation"], "long_description": "Immerse yourself in Focus, a spatial brainstorming tool designed to enhance your productivity and creativity. Experience a new way of working by building mind maps, prioritizing tasks, jotting down ideas and interacting with AI assistance. Transform your workspace with virtual stickers, arrows and post-its, allowing you to visualize and organize your thoughts like never before. Focus rethinks the traditional brainstorming process, enabling you to fully engage with your projects in a dynamic, spatial environment.", "short_description": "Focus is a VR/MR app created for developers to demonstrate how you can build a Productivity app using Meta Spatial SDK. The app supports panel and object management, enabling the creation, reuse, and destruction of interactive elements within varied environments."}]}, "developer_name": "Meta", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags
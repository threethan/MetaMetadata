09&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUkymnHiheoQ7kNvwHiA3ug&_nc_oc=AdoUPI9QjcOEjGO1pNSP-Xp2yAcuFMeYMd-201rZqU0NP7jov754oevIHdd2JTOxKlQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMvC8UdjZ2XYOci7uR5fXJIds-LVnpxZUPvgbCLh15Wg&oe=6AAEAB05"}, {"file_name": "Screenshot-Focus-5 revised.png", "id": "509537288353957", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75322598_509537291687290_7386728312272241154_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRCLLaS9UtcQ7kNvwGB4TSo&_nc_oc=AdqLGUJHzOyHkCqD68rYed70yPrud9GT2lp73mKyutW3nqOtUKpQhEHVjgr3G-upCNA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3SSzFxNmIie7RxMtXfBhtbpfPwmPkyAXgsWdsLdP1cQ&oe=6AAEA68D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Focus", "keywords": ["Productivity", "Brainstorming", "Creative", "Ideation"], "long_description": "Immerse yourself in Focus, a spatial brainstorming tool designed to enhance your productivity and creativity. Experience a new way of working by building mind maps, prioritizing tasks, jotting down ideas and interacting with AI assistance. Transform your workspace with virtual stickers, arrows and post-its, allowing you to visualize and organize your thoughts like never before. Focus rethinks the traditional brainstorming process, enabling you to fully engage with your projects in a dynamic, spatial environment.", "short_description": "Focus is a VR/MR app created for developers to demonstrate how you can build a Productivity app using Meta Spatial SDK. The app supports panel and object management, enabling the creation, reuse, and destruction of interactive elements within varied environments."}]}, "developer_name": "Meta", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comf
-7&_nc_sid=6e7a0a&_nc_ohc=hp1XK4cd_mcQ7kNvwFnY8tf&_nc_oc=AdoxjyzsQDTQbrB7OLaq_TeHOpZUqDP_tZoe9k9uKNbH3_s7glCT7UmksdgTSTUKm7E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCE_txCzK2i_nKrpYXzRqzDdzCCR-aZNSQ9_DjgBTMTRw&oe=6A61FBC5"}, {"file_name": "Screenshot-Focus-5 revised.png", "id": "509537288353957", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75322598_509537291687290_7386728312272241154_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OgE-plY5zYQ7kNvwGiPgRP&_nc_oc=AdqTjxfCaOFOjjIVDlsM-Chh_scj6523I3fok6F9w82ihHpH1nxU1Mu01tMccl5_nHk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGM_532DD_CoEKlr5lstihKyelZLdl-wK7zZbeJliLrg&oe=6A622F8D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Focus", "keywords": ["Productivity", "Brainstorming", "Creative", "Ideation"], "long_description": "Immerse yourself in Focus, a spatial brainstorming tool designed to enhance your productivity and creativity. Experience a new way of working by building mind maps, prioritizing tasks, jotting down ideas and interacting with AI assistance. Transform your workspace with virtual stickers, arrows and post-its, allowing you to visualize and organize your thoughts like never before. Focus rethinks the traditional brainstorming process, enabling you to fully engage with your projects in a dynamic, spatial environment.", "short_description": "Focus is a VR/MR app created for developers to demonstrate how you can build a Productivity app using Meta Spatial SDK. The app supports panel and object management, enabling the creation, reuse, and destruction of interactive elements within varied environments."}]}, "developer_name": "Meta", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags
-7&_nc_sid=6e7a0a&_nc_ohc=wFojsBoBHRMQ7kNvwEGMCBo&_nc_oc=AdqCSDNgST7LOh4VbZ-N1ilo8JfKcQwXGcNJMkkVKES9J96Ab35dQl_VZEvHDc0w7vo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYwGQckj0AzVeL3pWi7hs1gECLZReh77VPnETZ_yTL8w&oe=6A4D1C05"}, {"file_name": "Screenshot-Focus-5 revised.png", "id": "509537288353957", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75322598_509537291687290_7386728312272241154_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4AGldMm7qAQ7kNvwGjAxm8&_nc_oc=Adr3X3yTfZXOb_YJT0W4yVYCC_CnPk6BRTmHMwdqweEnKNyxGMf3kkrvuLkNy16geu4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9JW5A3rxoTnPJUc3Ca4bbQ7RNFh2qIQfs6_UoeW4byA&oe=6A4D178D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Focus", "keywords": ["Productivity", "Brainstorming", "Creative", "Ideation"], "long_description": "Immerse yourself in Focus, a spatial brainstorming tool designed to enhance your productivity and creativity. Experience a new way of working by building mind maps, prioritizing tasks, jotting down ideas and interacting with AI assistance. Transform your workspace with virtual stickers, arrows and post-its, allowing you to visualize and organize your thoughts like never before. Focus rethinks the traditional brainstorming process, enabling you to fully engage with your projects in a dynamic, spatial environment.", "short_description": "Focus is a VR/MR app created for developers to demonstrate how you can build a Productivity app using Meta Spatial SDK. The app supports panel and object management, enabling the creation, reuse, and destruction of interactive elements within varied environments."}]}, "developer_name": "Meta", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags
=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZRXToXS0F3ANjXEJdiFXaCDuWawFQ5rVyDHsQckRN1g&oe=6A2301FA"}, {"file_name": "Screenshot-Focus-3 revised.png", "id": "478044138401808", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974460_478044141735141_2926656663082272618_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jenar9asryQQ7kNvwHKPasN&_nc_oc=AdpJ8tzEKUu3wVLomTj8-Mdr-9IxALPDudMf1p5xMR7H0qq8blG4gVXpkoo-exR3zkY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gW5Ao8lwq696cPlwIvl-5FYQ7ITuaQjDobM_Mnev44g&oe=6A22D391"}, {"file_name": "Screenshot-Focus-4 revised.png", "id": "1032663918541423", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031435_1032663921874756_2128543463098527534_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7LIp7BY_uEQ7kNvwF0Mfq6&_nc_oc=AdqVuFIaLBJRqRckA0NVGy7SY0-R2ZS-Qf9CvmaQr6oL805QVle6FFkUq2aMWEX0XSM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9acmZ8FW-XGVmgRO3mGdHIo1XS0fg40fvUZZQ0diVVDg&oe=6A22EC05"}, {"file_name": "Screenshot-Focus-5 revised.png", "id": "509537288353957", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75322598_509537291687290_7386728312272241154_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0NJC3MRD1YQ7kNvwEAUDig&_nc_oc=AdqIFDPkqm8BD9FdUZXA2wT5nvW2AqQGM8YQAK5E6YzdHotn9FBXA5K94ITorwUjjJo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DKPThBzjooX9qqiy9KOJZbyh8NWxDT0_Ya5abCbtXOg&oe=6A22E78D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Focus", "keywords": ["Productivity", "Brainstorming", "Creative", "Ideation"], "long_description": "Focus is a developer reference app designed to show developers how to build spatialized experiences using the Meta Spatial SDK.\n\nThis spatial brainstorming tool is designed to enhance your productivity and creativity. Experience a new way of working by building mind maps, prioritizing tasks, jotting down ideas and interacting with AI assistance. Transform your workspace with virtual stickers, arrows and post-its, allowing you to visualize and organize your thoughts like never before. Focus rethinks the traditional brainstorming process, enabling you to fully engage with your projects in a dynamic, spatial environment.\n\n**More about Focus:**\n\nhttps://developers.meta.com/horizon/documentation/spatial-sdk/focus\n\n**More about Meta Spatial SDK:**\n\nhttps://developers.meta.com/horizon/develop/spatial-sdk", "short_description": "Focus is a VR/MR app created for developers to demonstrate how you can build a Productivity app using Meta Spatial SDK. The app supports panel and object management, enabling the creation, reuse, and destruction of interactive elements within varied environments."}]}, "developer_name": "Meta", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9309867339034729"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974835_1542944676310819_5317066524332241666_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHj86oc8RzEQ7kNvwHQvBhc&_nc_oc=AdpWS85CrPsCCoD22LAy3Z8fTz6WN
72866954_340505384363698353_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-nq08_-niYQ7kNvwEKduCr&_nc_oc=Adr5BOPV_VpK-D4VboQhgjPCHr8Cw2s_Ki_hAhtFM7d85fy-cUbmKYuK3cpmaNan828&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaaFtsxll1jtWhkqKRq1BPlqH_aYJlTwYyeW11QOWnuQ&oe=6AA028F6"}, {"file_name": "2.png", "id": "882303291309643", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820887_882303294642976_4080805563612794797_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ba45vaCuKbEQ7kNvwH8f7uK&_nc_oc=Ado2I7xJG-LeiY_wu1Po2j_Az0ikJ6V3MJw-rV9ui5QLILNoOgdG4aEUtv2-1ZHu1u0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1Yx1jvzhJjosR4Vmr0zzkurFw3XIAB6QGHX6OoR9Arg&oe=6AA006F8"}, {"file_name": "3.png", "id": "952735670748044", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823910_952735674081377_5868825921137882509_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XWKwL1apkMQ7kNvwHPlV9p&_nc_oc=AdrOETjsc_Zp28mjNvRsUBl7MF4DKGTaaT2GnvVEB-lTqKJIdlvVtZ2YDJB-QewMMF8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6X_zyV4LgDLIB6tSmk41lN7VHIIeoudhGl4mYHtJKjA&oe=6AA02410"}, {"file_name": "4.png", "id": "877328745067104", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818849_877328748400437_6090734846719612422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zo9l-3cEsc0Q7kNvwEf0PGJ&_nc_oc=Adqy8-lkEib8mZkOJvjzG0MhUQdliOWIHmAqxmX_T0lCqc3h6cywb-rchzy13xJMVis&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7WttvQuSXXV8io-ssjEm6k2tHqs6h88nbTyrOY74i6Q&oe=6AA0094F"}, {"file_name": "5.png", "id": "1568867277668129", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821674_1568867281001462_6402608727840279295_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIPpEwsCKboQ7kNvwE8XH1x&_nc_oc=AdpIh-S9Q1Ld0NfZvX9oL3t1fwj6cbP1JRUcc_9XIiKQ2G3pMUE6YPc0cyiF86ZebG4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC5KEX1TPXicdUh1Np3qNwCpr2S8gdemuR_U5oyEpPPA&oe=6AA024AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo2560.png", "id": "1186051533325917", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821568_1186051539992583_2694545757759512951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZbecd8rku4Q7kNvwGobDl_&_nc_oc=Adq6sXDcO1RlAMfl1-_4jqA4rf4uZ6KyzM-AAxBTxQlGbCYfk29i9rnuFDuT_aD7KKM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWE9o6CYbWtbdYPoQ4-lKYiev6zcAlwy7tWouc0EFInA&oe=6AA00051"}, "display_name": "Webshift: Between Frames", "keywords": ["horror", "narrative", "Mystery", "Thriller", "Atmosphere"], "long_description": "Webshift: Between Frames is a short narrative VR horror experience.\nYou are sent into a restricted underground sector maintained by a private contractor working with government research facilities. Officially, it\u2019s a technical failure. Unofficially, people aren\u2019t supposed to return from below.\n\nThe story unfolds through documents, notes, and internal reports. As you go deeper, it becomes clear the facility is not \u201cbroken\u201d \u2014 it is functioning as intended.\n\nDeath is not a failure state. If you are killed, you are returned \u2014 displaced, rewritten, shifted into another frame. Something beneath the sector understands this, and does not rush to finish you.\n\nNo combat. No upgrades. One descent. One ending.\nAtmosphere and environmental storytelling first.\n\nDocuments are localized in English, Russian, German, Spanish, French, and Portuguese (Brazil).", "short_description": "A short narrative VR horror in a restricted underground sector. Death is not the end. Find the truth through documents and descent."}, {"images": {"nodes": []}, "id": "1358770512956913", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Webshift: Between Frames", "keywords": ["Horror", "Narrative", "Thriller", "Mystery", "Atmosphere"], "long_description": "Webshift: Between Frames \u2014 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u0441\u044e\u0436\u0435\u0442\u043d\u044b\u0439 VR-\u0445\u043e\u0440\u0440\u043e\u0440.\n\u0422\u0435\u0431\u044f \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0442 \u0432 \u0437\u0430\u043a\u0440\u044b\u0442\u044b\u0439 \u043f\u043e\u0434\u0437\u0435\u043c\u043d\u044b\u0439 \u0441\u0435\u043a\u0442\u043e\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0435\u0442 \u043f\u043e\u0434\u0440\u044f\u0434\u0447\u0438\u043a \u043f\u0440\u0438 \u0432\u0435\u0434\u043e\u043c\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043e\u0431\u044a\u0435\u043a\u0442\u0430\u0445. \u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u2014 \u201c\u0442\u0435\u0445\u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u044c\u201d. \u041d\u0435\u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u2014 \u0441\u043d\u0438\u0437\u0443 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u044b \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044c\u0441\u044f.\n\n\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u043f\u043e\u0434\u0430\u0451\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 \u0437\u0430\u043f\u0438\u0441\u043a\u0438, \u043e\u0442\u0447\u0451\u0442\u044b \u0438 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0435 \u0441\u0432\u043e\u0434\u043a\u0438. \u0427\u0435\u043c \u0433\u043b\u0443\u0431\u0436\u0435 \u0442\u044b \u0438\u0434\u0451\u0448\u044c, \u0442\u0435\u043c \u044f\u0441\u043d\u0435\u0435: \u043e\u0431\u044a\u0435\u043a\u0442 \u043d\u0435 \u0441\u043b\u043e\u043c\u0430\u043d \u2014 \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0442\u0430\u043a, \u043a\u0430\u043a \u0437\u0430\u0434\u0443\u043c\u0430\u043d\u043e.\n\n\u0421\u043c\u0435\u0440\u0442\u044c \u0437\u0434\u0435\u0441\u044c \u2014 \u043d\u0435 \u043a\u043e\u043d\u0435\u0446. \u0415\u0441\u043b\u0438 \u0442\u0435\u0431\u044f \u0443\u0431\u0438\u043b\u0438, \u0442\u0435\u0431\u044f \u201c\u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u201d \u2014 \u0441\u0434\u0432\u0438\u0433\u0430\u0435\u0442, \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442, \u043a\u0438\u0434\u0430\u0435\u0442 \u0432 \u0434\u0440\u0443\u0433\u043e\u0439 \u043a\u0430\u0434\u0440. \u0418 \u0442\u043e, \u0447\u0442\u043e \u0436\u0438\u0432\u0451\u0442 \u0432\u043d\u0438\u0437\u0443, \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0442 \u044d\u0442\u043e \u0438 \u043d\u0435 \u0441\u043f\u0435\u0448\u0438\u0442 \u0437\u0430\u043a\u0430\u043d\u0447\u0438\u0432\u0430\u0442\u044c.\n\n\u0411\u0435\u0437 \u0431\u043e\u044f \u0438 \u043f\u0440\u043e\u043a\u0430\u0447\u043a\u0438. \u041e\u0434\u0438\u043d \u0441\u043f\u0443\u0441\u043a. \u041e\u0434\u0438\u043d \u0444\u0438\u043d\u0430\u043b.\n\u0424\u043e\u043a\u0443\u0441 \u2014 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430 \u0438 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435.\n\n\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u044b \u043d\u0430 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u0439, \u0440\u0443\u0441\u0441\u043a\u0438\u0439, \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439, \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u0438\u0439, \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439 \u0438 \u043f\u043e\u0440\u0442\u0443\u0433\u0430\u043b\u044c\u0441\u043a\u0438\u0439 (\u0411\u0440\u0430\u0437\u0438\u043b\u0438\u044f).", "short_description": "\u041a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u0441\u044e\u0436\u0435\u0442\u043d\u044b\u0439 VR-\u0445\u043e\u0440\u0440\u043e\u0440 \u043e \u0437\u0430\u043a\u0440\u044b\u0442\u043e\u043c \u043f\u043e\u0434\u0437\u0435\u043c\u043d\u043e\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0435. \u0421\u043c\u0435\u0440\u0442\u044c \u2014 \u043d\u0435 \u043a\u043e\u043d\u0435\u0446. \u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u0438 \u0441\u043f\u0443\u0441\u043a \u0432\u043d\u0438\u0437."}, {"images": {"nodes": []}, "id": "1114070387451965", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Webshift: Between Frames", "keywords": ["Horror", "Narrative", "Thriller", "Mystery", "Atmosphere"], "long_description": "Webshift: Between Frames es una experiencia corta de horror narrativo en VR.\nTe env\u00edan a un sector subterr\u00e1neo restringido, mantenido por un contratista privado que coopera con instalaciones de investigaci\u00f3n gubernamentales. Oficialmente, es una aver\u00eda t\u00e9cnica. Extraoficialmente, la gente no deber\u00eda volver de abajo.\n\nLa historia se descubre mediante documentos, notas e informes internos. Cuanto m\u00e1s desciendes, m\u00e1s claro queda: la instalaci\u00f3n no est\u00e1 \u201crota\u201d \u2014 funciona exactamente como fue dise\u00f1ada.\n\nLa muerte no es un \u201cgame over\u201d. Si te matan, vuelves \u2014 desplazado, reescrito, movido a otro \u201cfotograma\u201d. Algo all\u00ed abajo lo entiende y no se apresura a terminar contigo.\n\nSin combate. Sin mejoras. Un descenso. Un final.\nPrioridad: atm\u00f3sfera y narrativa ambiental.\n\nLos documentos est\u00e1n localizados en ingl\u00e9s, ruso, alem\u00e1n, espa\u00f1ol, franc\u00e9s y portugu\u00e9s (Brasil).", "short_description": "Horror narrativo corto en VR en un sector subterr\u00e1neo restringido. La muerte no es el final. La verdad se encuentra en documentos y en el descenso."}, {"images": {"nodes": []}, "id": "899257802692412", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Webshift: Between Frames", "keywords": ["Horror", "Narrative", "Thriller", "Mystery", "Atmosphere"], "long_description": "Webshift: Between Frames \u00e9 uma experi\u00eancia curta de horror narrativo em VR.\nVoc\u00ea \u00e9 enviado a um setor subterr\u00e2neo restrito, mantido por um contratante privado que coopera com instala\u00e7\u00f5es de pesquisa do governo. Oficialmente, \u00e9 uma falha t\u00e9cnica. Extraoficialmente, ningu\u00e9m deveria voltar de l\u00e1 de baixo.\n\nA hist\u00f3ria se revela por documentos, bilhetes e relat\u00f3rios internos. Quanto mais fundo voc\u00ea vai, mais claro fica: o local n\u00e3o est\u00e1 \u201cquebrado\u201d \u2014 ele funciona exatamente como foi planejado.\n\nA morte n\u00e3o \u00e9 fim de jogo. Se voc\u00ea morrer, voc\u00ea retorna \u2014 deslocado, reescrito, lan\u00e7ado para outro \u201cquadro\u201d. Algo l\u00e1 embaixo sabe disso e n\u00e3o tem pressa de acabar com voc\u00ea.\n\nSem combate. Sem upgrades. Uma descida. Um final.\nFoco em atmosfera e narrativa pelo ambiente.\n\nOs documentos est\u00e3o localizados em ingl\u00eas, russo, alem\u00e3o, espanhol, franc\u00eas e portugu\u00eas (Brasil).", "short_description": "Horror narrativo curto em VR num setor subterr\u00e2neo restrito. A morte n\u00e3o \u00e9 o fim. Descubra a verdade por documentos e pela descida."}, {"images": {"nodes": []}, "id": "770871222731607", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Webshift: Between Frames", "keywords": ["Horror", "Narrative", "Thriller", "Mystery", "Atmosphere"], "long_description": "Webshift: Between Frames ist ein kurzes, narratives VR-Horror-Erlebnis.\nDu wirst in einen gesperrten Untergrundsektor geschickt, der von einem privaten Auftragnehmer im Auftrag staatlicher Forschungsstellen gewartet wird. Offiziell: ein technischer Defekt. Inoffiziell: von dort unten kehrt man nicht zur\u00fcck.\n\nDie Geschichte entfaltet sich \u00fcber Dokumente, Notizen und interne Berichte. Je tiefer du gehst, desto klarer wird: Die Anlage ist nicht \u201ckaputt\u201d \u2014 sie funktioniert genau wie vorgesehen.\n\nDer Tod ist kein Game Over. Wirst du get\u00f6tet, wirst du zur\u00fcckgesetzt \u2014 verschoben, \u00fcberschrieben, in ein anderes \u201cBild\u201d versetzt. Etwas dort unten wei\u00df das und hat es nicht eilig, dich endg\u00fcltig zu beenden.\n\nKein Kampf. Keine Upgrades. Ein Abstieg. Ein Ende.\nAtmosph\u00e4re und Umgebungsstorytelling im Vordergrund.\n\nDokumente sind auf Englisch, Russisch, Deutsch, Spanisch, Franz\u00f6sisch und Portugiesisch (Brasilien) lokalisiert.", "short_description": "Kurzer narrativer VR-Horror in einem gesperrten Untergrundsektor. Der Tod ist nicht das Ende. Die Wahrheit steckt in Dokumenten und im Abstieg."}]}, "developer_name": null, "developer_privacy_policy_url": "http://webshiftbf.netlify.app/", "developer_terms_of_service_url": null, "publisher_name": "LCSS", "support_website_url": null, "website_url": "https://webshiftbfs.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "pt_BR", "es", "fr", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23882318908132010"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "912058371473846"}]}, "baseline_offer": {"id": "912058371473846"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771891200, "status": "PUBLISHED", "id": "912058371473846"}]}, "l
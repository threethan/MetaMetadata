_AQL-RvHxdT4rruWULdg628qxHZX6mtWj7yg1Y4jD5uaXAA&oe=6AA000BA"}, {"file_name": "Logo512.png", "id": "1438528574584270", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821702_1438528577917603_133309126809825888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5bQYkuTfYYQ7kNvwExCjWi&_nc_oc=AdpNRO2cuhN-Jj8p9sd3oFm7ToqqnG3Fm_rEW9FA2cPjBoGpMeuAalKvP6GIvAMO6a8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiRBEDey1Brlp9X2ovDiFEfv0-ops6G-2fV-FfEkQBig&oe=6AA0180A"}]}, "id": "1977348266490570", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "916524097636372", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825470_916524104303038_3252536614096663715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRwNR_-dUZQQ7kNvwHiQeVy&_nc_oc=AdqK7gskZ7BfELLd1qVo3R0gAnYT0ljqA879LgaHH6_bsc91SsOM77PDq0HflynQses&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPFb0RVG6YF4uSvqIoYSCrMSd9uuO2Rf4A7vonKYWTIQ&oe=6AA021A0"}, {"file_name": "2.png", "id": "1462564251908897", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491829120_1462564261908896_6315338282824386397_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CP5_FWS_hZMQ7kNvwEFoLfU&_nc_oc=AdpYHUBSEHe_vhgFENWiq8anAzFurq4TZvvADlPHrC9i03P9pE-SYDq33C_Pe_HnQ30&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfohhb8WjYpYuV-Dlh_jqwvS6tTOOHhYZCuxa_TfTPZQ&oe=6AA02643"}, {"file_name": "3.png", "id": "1423882702443642", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827282_1423882705776975_863650940623954857_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eytO7nW5jDUQ7kNvwEDgpnd&_nc_oc=AdokJ80veYFiikHDZnOu0ifClqKQAQiuRq2IPCdDytQ1UqHaOB1a8GuNVCoVDV_-w4E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5KkGV46wM-G-cUKoj_AUxyXyamYJAZUkpMa8MqGEPxA&oe=6AA02F41"}, {"file_name": "4.png", "id": "1681946666506764", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823812_1681946669840097_1186963274055060288_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-V8tdRatG8Q7kNvwGPvfWq&_nc_oc=Adqf-I8SS38eFyo4axfbCPKYM3yuVFDRikBM278WEQEa1c52QqeChu-gzl0TVl1z5OE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJplvIXO7UjUAcCidK0U0YCWrvyJN1HWLzpsgrO8QdHNw&oe=6A9FF9C9"}, {"file_name": "5.png", "id": "2912589665601782", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499314641_2912589668935115_2035471390295760368_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeOh3fo-XvEQ7kNvwFUvok0&_nc_oc=AdpD0OBW7DaT24e9le-zDYzyLGu1DpQVD5kLE3mL4UnPDaJDCPDHEQZypQ_dBaJHpNY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI55jfP_JQZQG4NUu_Q6IGHOj3HeIk4XbHQ02u0SIshrg&oe=6A9FFBE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo2560.png", "id": "1186051533325917", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821568_1186051539992583_2694545757759512951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZbecd8rku4Q7kNvwGobDl_&_nc_oc=Adq6sXDcO1RlAMfl1-_4jqA4rf4uZ6KyzM-AAxBTxQlGbCYfk29i9rnuFDuT_aD7KKM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWE9o6CYbWtbdYPoQ4-lKYiev6zcAlwy7tWouc0EFInA&oe=6AA00051"}, "display_name": "Webshift: Between Frames", "keywords": ["horror", "narrative", "Mystery", "Thriller", "Atmosphere"], "long_description": "Webshift: Between Frames is a short narrative VR horror experience.\nYou are sent into a restricted underground sector maintained by a private contractor working with government research facilities. Officially, it\u2019s a technical failure. Unofficially, people aren\u2019t supposed to return from below.\n\nThe story unfolds through documents, notes, and internal reports. As you go deeper, it becomes clear the facility is not \u201cbroken\u201d \u2014 it is functioning as intended.\n\nDeath is not a failure state. If you are killed, you are returned \u2014 displaced, rewritten, shifted into another frame. Something beneath the sector understands this, and does not rush to finish you.\n\nNo combat. No upgrades. One descent. One ending.\nAtmosphere and environmental storytelling first.\n\nDocuments are localized in English, Russian, German, Spanish, French, and Portuguese (Brazil).", "short_description": "A short narrative VR horror in a restricted underground sector. Death is not the end. Find the truth through documents and descent."}, {"images": {"nodes": []}, "id": "1659056585537309", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Webshift: Between Frames", "keywords": ["Horror", "Narrative", "Thriller", "Mystery", "Atmosphere"], "long_description": "Webshift: Between Frames ist ein kurzes, narratives VR-Horror-Erlebnis.\nDu wirst in einen gesperrten Untergrundsektor geschickt, der von einem privaten Auftragnehmer im Auftrag staatlicher Forschungsstellen gewartet wird. Offiziell: ein technischer Defekt. Inoffiziell: von dort unten kehrt man nicht zur\u00fcck.\n\nDie Geschichte entfaltet sich \u00fcber Dokumente, Notizen und interne Berichte. Je tiefer du gehst, desto klarer wird: Die Anlage ist nicht \u201ckaputt\u201d \u2014 sie funktioniert genau wie vorgesehen.\n\nDer Tod ist kein Game Over. Wirst du get\u00f6tet, wirst du zur\u00fcckgesetzt \u2014 verschoben, \u00fcberschrieben, in ein anderes \u201cBild\u201d versetzt. Etwas dort unten wei\u00df das und hat es nicht eilig, dich endg\u00fcltig zu beenden.\n\nKein Kampf. Keine Upgrades. Ein Abstieg. Ein Ende.\nAtmosph\u00e4re und Umgebungsstorytelling im Vordergrund.\n\nDokumente sind auf Englisch, Russisch, Deutsch, Spanisch, Franz\u00f6sisch und Portugiesisch (Brasilien) lokalisiert.", "short_description": "Kurzer narrativer VR-Horror in einem gesperrten Untergrundsektor. Der Tod ist nicht das Ende. Die Wahrheit steckt in Dokumenten und im Abstieg."}, {"images": {"nodes": []}, "id": "1655609712551618", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Webshift: Between Frames", "keywords": ["Horror", "Narrative", "Thriller", "Mystery", "Atmosphere"], "long_description": "Webshift: Between Frames est une courte exp\u00e9rience d\u2019horreur narrative en VR.\nVous \u00eates envoy\u00e9 dans un secteur souterrain restreint, entretenu par un prestataire priv\u00e9 en coop\u00e9ration avec des installations de recherche gouvernementales. Officiellement : une panne technique. Officieusement : personne ne devrait revenir d\u2019en bas.\n\nL\u2019histoire se d\u00e9voile \u00e0 travers des documents, des notes et des rapports internes. Plus vous descendez, plus c\u2019est \u00e9vident : l\u2019installation n\u2019est pas \u201ccass\u00e9e\u201d \u2014 elle fonctionne exactement comme pr\u00e9vu.\n\nLa mort n\u2019est pas un \u00e9chec final. Si vous \u00eates tu\u00e9, vous revenez \u2014 d\u00e9plac\u00e9, r\u00e9\u00e9crit, projet\u00e9 dans un autre \u201ccadre\u201d. Quelque chose en dessous le comprend et ne se presse pas de vous finir.\n\nPas de combat. Pas d\u2019am\u00e9liorations. Une descente. Une fin.\nPriorit\u00e9 \u00e0 l\u2019atmosph\u00e8re et au r\u00e9cit environnemental.\n\nLes documents sont localis\u00e9s en anglais, russe, allemand, espagnol, fran\u00e7ais et portugais (Br\u00e9sil).", "short_description": "Horreur narrative VR courte dans un secteur souterrain interdit. La mort n\u2019est pas la fin. La v\u00e9rit\u00e9 se lit dans les documents et la descente."}, {"images": {"nodes": []}, "id": "1466778675090923", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Webshift: Between Frames", "keywords": ["Horror", "Narrative", "Thriller", "Mystery", "Atmosphere"], "long_description": "Webshift: Between Frames es una experiencia corta de horror narrativo en VR.\nTe env\u00edan a un sector subterr\u00e1neo restringido, mantenido por un contratista privado que coopera con instalaciones de investigaci\u00f3n gubernamentales. Oficialmente, es una aver\u00eda t\u00e9cnica. Extraoficialmente, la gente no deber\u00eda volver de abajo.\n\nLa historia se descubre mediante documentos, notas e informes internos. Cuanto m\u00e1s desciendes, m\u00e1s claro queda: la instalaci\u00f3n no est\u00e1 \u201crota\u201d \u2014 funciona exactamente como fue dise\u00f1ada.\n\nLa muerte no es un \u201cgame over\u201d. Si te matan, vuelves \u2014 desplazado, reescrito, movido a otro \u201cfotograma\u201d. Algo all\u00ed abajo lo entiende y no se apresura a terminar contigo.\n\nSin combate. Sin mejoras. Un descenso. Un final.\nPrioridad: atm\u00f3sfera y narrativa ambiental.\n\nLos documentos est\u00e1n localizados en ingl\u00e9s, ruso, alem\u00e1n, espa\u00f1ol, franc\u00e9s y portugu\u00e9s (Brasil).", "short_description": "Horror narrativo corto en VR en un sector subterr\u00e1neo restringido. La muerte no es el final. La verdad se encuentra en documentos y en el descenso."}, {"images": {"nodes": []}, "id": "1462275368888893", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Webshift: Between Frames", "keywords": ["Horror", "Narrative", "Thriller", "Mystery", "Atmosphere"], "long_description": "Webshift: Between Frames \u2014 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u0441\u044e\u0436\u0435\u0442\u043d\u044b\u0439 VR-\u0445\u043e\u0440\u0440\u043e\u0440.\n\u0422\u0435\u0431\u044f \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0442 \u0432 \u0437\u0430\u043a\u0440\u044b\u0442\u044b\u0439 \u043f\u043e\u0434\u0437\u0435\u043c\u043d\u044b\u0439 \u0441\u0435\u043a\u0442\u043e\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0435\u0442 \u043f\u043e\u0434\u0440\u044f\u0434\u0447\u0438\u043a \u043f\u0440\u0438 \u0432\u0435\u0434\u043e\u043c\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043e\u0431\u044a\u0435\u043a\u0442\u0430\u0445. \u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u2014 \u201c\u0442\u0435\u0445\u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u044c\u201d. \u041d\u0435\u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u2014 \u0441\u043d\u0438\u0437\u0443 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u044b \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044c\u0441\u044f.\n\n\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u043f\u043e\u0434\u0430\u0451\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 \u0437\u0430\u043f\u0438\u0441\u043a\u0438, \u043e\u0442\u0447\u0451\u0442\u044b \u0438 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0435 \u0441\u0432\u043e\u0434\u043a\u0438. \u0427\u0435\u043c \u0433\u043b\u0443\u0431\u0436\u0435 \u0442\u044b \u0438\u0434\u0451\u0448\u044c, \u0442\u0435\u043c \u044f\u0441\u043d\u0435\u0435: \u043e\u0431\u044a\u0435\u043a\u0442 \u043d\u0435 \u0441\u043b\u043e\u043c\u0430\u043d \u2014 \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0442\u0430\u043a, \u043a\u0430\u043a \u0437\u0430\u0434\u0443\u043c\u0430\u043d\u043e.\n\n\u0421\u043c\u0435\u0440\u0442\u044c \u0437\u0434\u0435\u0441\u044c \u2014 \u043d\u0435 \u043a\u043e\u043d\u0435\u0446. \u0415\u0441\u043b\u0438 \u0442\u0435\u0431\u044f \u0443\u0431\u0438\u043b\u0438, \u0442\u0435\u0431\u044f \u201c\u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u201d \u2014 \u0441\u0434\u0432\u0438\u0433\u0430\u0435\u0442, \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442, \u043a\u0438\u0434\u0430\u0435\u0442 \u0432 \u0434\u0440\u0443\u0433\u043e\u0439 \u043a\u0430\u0434\u0440. \u0418 \u0442\u043e, \u0447\u0442\u043e \u0436\u0438\u0432\u0451\u0442 \u0432\u043d\u0438\u0437\u0443, \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0442 \u044d\u0442\u043e \u0438 \u043d\u0435 \u0441\u043f\u0435\u0448\u0438\u0442 \u0437\u0430\u043a\u0430\u043d\u0447\u0438\u0432\u0430\u0442\u044c.\n\n\u0411\u0435\u0437 \u0431\u043e\u044f \u0438 \u043f\u0440\u043e\u043a\u0430\u0447\u043a\u0438. \u041e\u0434\u0438\u043d \u0441\u043f\u0443\u0441\u043a. \u041e\u0434\u0438\u043d \u0444\u0438\u043d\u0430\u043b.\n\u0424\u043e\u043a\u0443\u0441 \u2014 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430 \u0438 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435.\n\n\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u044b \u043d\u0430 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u0439, \u0440\u0443\u0441\u0441\u043a\u0438\u0439, \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439, \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u0438\u0439, \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439 \u0438 \u043f\u043e\u0440\u0442\u0443\u0433\u0430\u043b\u044c\u0441\u043a\u0438\u0439 (\u0411\u0440\u0430\u0437\u0438\u043b\u0438\u044f).", "short_description": "\u041a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u0441\u044e\u0436\u0435\u0442\u043d\u044b\u0439 VR-\u0445\u043e\u0440\u0440\u043e\u0440 \u043e \u0437\u0430\u043a\u0440\u044b\u0442\u043e\u043c \u043f\u043e\u0434\u0437\u0435\u043c\u043d\u043e\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0435. \u0421\u043c\u0435\u0440\u0442\u044c \u2014 \u043d\u0435 \u043a\u043e\u043d\u0435\u0446. \u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u0438 \u0441\u043f\u0443\u0441\u043a \u0432\u043d\u0438\u0437."}, {"images": {"nodes": []}, "id": "1425738815967804", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Webshift: Between Frames", "keywords": ["Horror", "Narrative", "Thriller", "Mystery", "Atmosphere"], "long_description": "Webshift: Between Frames \u00e9 uma experi\u00eancia curta de horror narrativo em VR.\nVoc\u00ea \u00e9 enviado a um setor subterr\u00e2neo restrito, mantido por um contratante privado que coopera com instala\u00e7\u00f5es de pesquisa do governo. Oficialmente, \u00e9 uma falha t\u00e9cnica. Extraoficialmente, ningu\u00e9m deveria voltar de l\u00e1 de baixo.\n\nA hist\u00f3ria se revela por documentos, bilhetes e relat\u00f3rios internos. Quanto mais fundo voc\u00ea vai, mais claro fica: o local n\u00e3o est\u00e1 \u201cquebrado\u201d \u2014 ele funciona exatamente como foi planejado.\n\nA morte n\u00e3o \u00e9 fim de jogo. Se voc\u00ea morrer, voc\u00ea retorna \u2014 deslocado, reescrito, lan\u00e7ado para outro \u201cquadro\u201d. Algo l\u00e1 embaixo sabe disso e n\u00e3o tem pressa de acabar com voc\u00ea.\n\nSem combate. Sem upgrades. Uma descida. Um final.\nFoco em atmosfera e narrativa pelo ambiente.\n\nOs documentos est\u00e3o localizados em ingl\u00eas, russo, alem\u00e3o, espanhol, franc\u00eas e portugu\u00eas (Brasil).", "short_description": "Horror narrativo curto em VR num setor subterr\u00e2neo restrito. A morte n\u00e3o \u00e9 o fim. Descubra a verdade por documentos e pela descida."}]}, "developer_name": null, "developer_privacy_policy_url": "http://webshiftbf.netlify.app/", "developer_terms_of_service_url": null, "publisher_name": "LCSS", "support_website_url": null, "website_url": "https://webshiftbfs.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "pt_BR", "es", "fr", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24030644036632829"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823366_1972458277010929_7610551177440221111_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bAGQC5tXBAQ7kNvwFXdzCe&_nc_oc=Adr2-PaWM-wizuM9z8HR2NYzea1ogDc6KX9x-egSJUDb_hP7e4CUpvLRrb5sqkFnOwY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVmETg00Fpmm_5ITd8kIwiLRDnshUxPxFwh4ugUPXanA&oe=6A9FFF40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Webshift: Between Frames", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}], "release_date": 1771891200, "lastRevision": {"nodes": [{"id": "23882318944798673", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "23882318841465350", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1916871119216750"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1587413275929097", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Webshift: Between Frames", "keywords": ["Horror", "Narrative", "Thriller", "Mystery", "Atmosphere"], "long_description": "Webshift: Between Frames est une courte exp\u00e9rience d\u2019horreur narrative en VR.\nVous \u00eates envoy\u00e9 dans un secteur souterrain restreint, entretenu par un prestataire priv\u00e9 en coop\u00e9ration avec des installations de recherche gouvernementales. Officiellement : une panne technique. Officieusement : personne ne devrait revenir d\u2019en bas.\n\nL\u2019histoire se d\u00e9voile \u00e0 travers des documents, des notes et des rapports internes. Plus vous descendez, plus c\u2019est \u00e9vident : l\u2019installation n\u2019est pas \u201ccass\u00e9e\u201d \u2014 elle fonctionne exactement comme pr\u00e9vu.\n\nLa mort n\u2019est pas un \u00e9chec final. Si vous \u00eates tu\u00e9, vous revenez \u2014 d\u00e9plac\u00e9, r\u00e9\u00e9crit, projet\u00e9 dans un autre \u201ccadre\u201d. Quelque chose en dessous le comprend et ne se presse pas de vous finir.\n\nPas de combat. Pas d\u2019am\u00e9liorations. Une descente. Une fin.\nPriorit\u00e9 \u00e0 l\u2019atmosph\u00e8re et au r\u00e9cit environnemental.\n\nLes documents sont localis\u00e9s en anglais, russe, allemand, espagnol, fran\u00e7ais et portugais (Br\u00e9sil).", "short_description": "Horreur narrative VR courte dans un secteur souterrain interdit. La mort n\u2019est pas la fin. La v\u00e9rit\u00e9 se lit dans les documents et la descente."}, {"images": {"nodes": [{"file_name": "Logo1008.png", "id": "4397393163865376", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822327_4397393167198709_2265493933206917698_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LArAmBPvVEQ7kNvwFRfuE6&_nc_oc=AdpGM6chE3Elcwblnukz1Yh-jE2UZt4NQyRNoj1zUNaGKr-lbtQ2jdOyMcBwy1VeFPQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKmtFjBMRTNMG6mldQaWADd39IvqY1JromgMWB6bMonw&oe=6A9FFE56"}, {"file_name": "Logo3000.png", "id": "4104835203140473", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825546_4104835206473806_3176652170777716482_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUi8R-4zT6AQ7kNvwGxrnKp&_nc_oc=AdqQ-tsH8TmHQ60JqJKOwr72T4gw1ehgC4CXH9np_JTHUZNp2mLEJ1gW0ZcEoaTqfJo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLdXOs-Zwpq_4nzUTt5YCrPlsD0I1dTY_KSi4TQi6TEA&oe=6AA02510"}, {"file_name": "Logo1440.png", "id": "1972458273677596", "image_type": "APP_IMG_COVER_SQUARE",
{"data": {"node": {"__typename": "Application", "id": "23882318841465350", "organization": {"id": "824701900730023", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "23882318841465350"}]}, "id": "1272577884790563"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25994746560150282"}]}, "id": "713318918325698"}]}}, "firstRevision": {"nodes": [{"application": {"id": "23882318841465350", "release_date": 1771891200, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23894024490294785"}, "id": "1895083341096015"}]}}, "binary": null, "live_binary": null, "created_date": 1771516421, "id": "23926587850371782", "is_initial_release": false, "name_with_fallback": "v2", "pdp_metadata_with_fallback": {"version": 2, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "24030644036632829"}, "release_status": "RELEASED", "id": "23882318841465350"}, "id": "24030644036632829", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "23882318841465350", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1916871119216750"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Logo1008.png", "id": "4397393163865376", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822327_4397393167198709_2265493933206917698_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LArAmBPvVEQ7kNvwFRfuE6&_nc_oc=AdpGM6chE3Elcwblnukz1Yh-jE2UZt4NQyRNo
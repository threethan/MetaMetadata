e copy.png", "id": "1302969274588433", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820934_1302969277921766_7839215618515103577_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNgfg6BN_qAQ7kNvwG8DQ2M&_nc_oc=AdoNwMDNgI_WojJ7ECs_5Gvv2xsdJuPBS4DCRu4s6os1InXbuL9Ykg1fu_zN0kXkPrg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTzVjGBDVw8adZF_9wDmep_uO3GjRlcK4Nxnp1Net_FJA&oe=6B0B291B"}, "display_name": "Warpath Defender VR", "keywords": [], "long_description": "Warpath Defender VR puts you in the hot seat of a high-stakes missile defense mission in virtual reality. Stationed at a critical frontline, your job is to intercept and destroy advancing enemy convoys before they break through.\n\n\ud83d\udca5 Unlock the full power:\n\nFull campaign mode with multiple levels\n\nAdvanced enemy AI and boss vehicles\n\nWeapon upgrades and strategic scoring\n\nOptimized for Quest 2, 3, and Pro\n\nAre you ready to hold your ground and become the ultimate Warpath Defender?", "short_description": "Defend your outpost with a missile launcher as enemy convoys roll in.\n\ud83c\udfaf Key Features:\n\nVR missile defense gameplay\n\nRealistic destruction & effects\n\nLimited levels to try before you buy\n\nSmooth controls optimized for Oculus headsets"}]}, "developer_name": null, "developer_privacy_policy_url": "https://warpathvrpolicy.blogspot.com/2025/06/war-path-defender-vr.html", "developer_terms_of_service_url": null, "publisher_name": "Dharmesh Fulmali", "support_website_url": null, "website_url": "https://fulmalidharmesh210.wixsite.com/dream-game-creation", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MO
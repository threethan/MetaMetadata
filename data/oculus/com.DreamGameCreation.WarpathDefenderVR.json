oss vehicles\n\nWeapon upgrades and strategic scoring\n\nOptimized for Quest 2, 3, and Pro\n\nAre you ready to hold your ground and become the ultimate Warpath Defender?", "short_description": "Defend your outpost with a missile launcher as enemy convoys roll in.\n\ud83c\udfaf Key Features:\n\nVR missile defense gameplay\n\nRealistic destruction & effects\n\nLimited levels to try before you buy\n\nSmooth controls optimized for Oculus headsets"}]}, "developer_name": null, "developer_privacy_policy_url": "https://warpathvrpolicy.blogspot.com/2025/06/war-path-defender-vr.html", "developer_terms_of_service_url": null, "publisher_name": "Dharmesh Fulmali", "support_website_url": null, "website_url": "https://fulmalidharmesh210.wixsite.com/dream-game-creation", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9751757488280706"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823935_3003533699828194_7945238449440698584_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJ740egYXNIQ7kNvwEimgMU&_nc_oc=AdkumOMPPpvVQThkJh8arr7r_oIPdjOzImxZsCiA5MCSZoLX-e5YZzpmzdgK-4LjQFg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwMfiYGKEuNnVATfnV2tbwPir9bNqrmuE7yQ4rfljCfrw&oe=69B29811"}, "is_concept": false, "is_test": false, "is_trial_offer_valid"
nt-iad6-1.oculuscdn.com/v/t64.5771-25/491825546_2118765379050221_2327730362742761680_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-C-zr2QMb8Q7kNvwGPUcaE&_nc_oc=AdqHahIV8bAGUiOrfQ4A5Q9b9aLXUSBgcyeCET0OVCSPYLFihGZyRniTS4QSswafG9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZjAXv2WwwSuquFKlaWQ83OPPtNbpbcr16P56Mz601kw&oe=6A787A15"}, {"file_name": "Darts-VR-2-Bullseye-Emotes.png", "id": "4562385147325132", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828583_4562385153991798_1251962292413676809_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFoYYeiMGqsQ7kNvwGUpyXS&_nc_oc=Ado83oNEe1B77190SH-28VpBaykLVcL0khZzxWfu5l6KIYbO6Xdmy2BZtGIZ9ezFgP8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_Mj1T4IyR6grjrnP0eLT34H7D-MZlBJWn9zEyU_zluA&oe=6A7878A2"}, {"file_name": "Darts-VR-2-Bullseye-Zombies.png", "id": "1703653737347233", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491829165_1703653740680566_1427869552007392471_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVX0RJaGuUEQ7kNvwEoPNk9&_nc_oc=AdpgNtZXC0m6dzurFC0TWSF94rGS4AooCrKS3CWcuI0SwbjM74ltjcFa27tkffsQM4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd-ChvqBrWEx4Ki5tlFXdbKxdEr1DkfU8O26-VruQUPw&oe=6A789067"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Darts-VR2-Bullseye-keyart.png", "id": "1669040111093650", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825503_1669040117760316_7801972858595488314_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EewmhOx_QaoQ7kNvwF0R2FJ&_nc_oc=AdrC0rtuqUhJwJCJ7SPe9djJsSt3sPMqq2buJh3qHnancVVVRnm-R_kc0cPL3YE1rhc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIr6x75TyUSX_YrsfNm6ZHAq-y_h0j1BLT-rlFVvzloQ&oe=6A78880E"}, "display_name": "Darts VR2: Bullseye", "keywords": ["darts", "zombies", "multiplayer", "501", "sport"], "long_description": "**Darts VR2: Bullseye** is the next evolution of immersive darts gameplay, bringing **precision, competition, and casual fun** to virtual reality. Whether you're aiming for the **championship trophy**, battling **zombie hordes**, mastering **501 Mode**, or just **throwing darts for fun**, this game has something for everyone.  \n\n\"A confident, significantly improved sequel that modernises VR darts while expanding its scope beyond pure simulation\" - Game Critix\n\n\"Requires skill and mastery\u2026 when the game flows, it hooks you in\" - Zona the Gamers \n\n{2455748568205292}\n\n### **Multiple Modes**\nPlay a classic game of 501, fight Zombies with explosive darts, take on the challenging Killstreak mode and more!\n\n{1562729068119712}\n\n### **Realistic Darts**\nTrust your aim and let those darts fly!\n\n{1490126745811892}\n\n### Become a Darts master!\n- Physics-Based Darts - Finely tuned physics mean the darts behave like darts\n- Solo & Online - Enjoy both single-player and multiplayer modes\n- Tournaments - Create your own or join worldwide tournaments\n- Customise - Step out in style with new dart liveries, hats, sunglasses and more!\n\n**Darts VR2: Bullseye** is the definitive VR darts experience for players of all skill levels.\n", "short_description": "Darts VR2: Bullseye is the ultimate VR darts experience, offering competitive and casual gameplay across multiple modes, including Championship, Zombies, 501, and Killstreak. Play with friends, climb the leaderboards, and showcase your unique darts collection and avatars. Whether you're aiming for precision, mastering strategies, or just having fun, the game delivers an immersive and cross-platform experience."}]}, "developer_name": "Immersive Gamitronics Studio", "developer_privacy_policy_url": "https://www.gamitronics.com/pp/DartsVR2PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Evolution Publishing", "support_website_url": null, "website_url": "https://dartsvr2.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categor
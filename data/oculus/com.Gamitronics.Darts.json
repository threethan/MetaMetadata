oh=00_AQEaP-y84QbmG_uoyN_s2aNc7YT8zEfjK1o0Ha8FUnix7w&oe=6A78735A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10_Trailer Cover Image.png", "id": "3882150242001679", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393518_3882150248668345_4121139368324962260_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4UyxG1zuxkQ7kNvwEjxr2J&_nc_oc=Adr1pMAZhQZR9Onp9-kytyyo5h70btNgV158fyHCauJa-7BlEqM0sKW6bBg8998vMh8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHy9yU6DveczofLge6GnqpTQsxcu4zLmfhkXJ29D5mR6w&oe=6A78776A"}, "display_name": "Darts VR2: Bullseye", "keywords": ["darts", "zombies", "multiplayer", "501"], "long_description": "**Darts VR2: Bullseye** is the next evolution of immersive darts gameplay, bringing **precision, competition, and casual fun** to virtual reality. Whether you're aiming for the **championship trophy**, battling **zombie hordes**, mastering **501 Mode**, or just **throwing darts for fun**, this game has something for everyone.  \n\n## Key Features  \n\n### Compete & Conquer  \nPlay against friends or challenge the world in high-stakes **esports tournaments**. Win **championships, host your own competitions**, and prove your dominance.  \n\n### Master the 501 Mode  \nThink fast, aim sharp, and **strategize your way to exactly zero** before your opponent. A true test of skill, patience, and precision.  \n\n### Survive the Undead  \nTake on a thrilling **Zombies Mode**, where each throw could mean survival or defeat.  \n\n### Casual or Competitive? Your Choice!  \nWhether you're **practicing trick shots, hitting impossible killstreaks**, or just relaxing with a few rounds, there's always a way to enjoy the game.  \n\n### Climb the Leaderboards  \nEarn achievements, **hone your skills**, and rise to the top. Show off your darts collection, unlockable cosmetics, and unique avatars.  \n\n\n**Darts VR2: Bullseye** isn\u2019t just a game\u2014it\u2019s the definitive **VR darts experience** for players of all skill levels.  \n", "short_description": "Darts VR2: Bullseye is the ultimate VR darts experience, offering competitive and casual gameplay across multiple modes, including Championship, Zombies, 501, and Killstreak. Play with friends, climb the leaderboards, and showcase your unique darts collection and avatars. Whether you're aiming for precision, mastering strategies, or just having fun, the game delivers an immersive and cross-platform experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gamitronics.com/DartsVR2/PP.pdf", "developer_terms_of_service_url": null, "publisher_name": "Gamitronics Studio", "support_website_url": null, "website_url": "https://www.gamitronics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "28433998776248652"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2122195701977361"}, {"status": "CANCELLED", "id": "1351997400225286"}, {"status": "PUBLISHED", "id": "2688274401568362"}, {"status": "PUBLISHED", "id": "1533089751545797"}, {"status": "PUBLISHED", "id": "1216679390210248"}]}, "baseline_offer": {"id": "1216679390210248"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "2122195701977361"}]}, "liveChannel": {"nodes": [{"latest_supp
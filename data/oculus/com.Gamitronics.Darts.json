5GA6sQ7kNvwEFhk7P&_nc_oc=AdoYIQOBoUMSMV73FBZQGhXie3J4FTiWiicH3V3u3qJf1lBmPbxowUWTCnenKQA0BK0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yEWZGDEN1hgHfYK5xjQJ8w-ftdVgkgCOCZWQuQGhT_A&oe=6A4517FD"}, {"file_name": "4_ATW.png", "id": "1160004262381055", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392179_1160004265714388_7549568828410163322_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIz_xJ0clLwQ7kNvwEfmZOS&_nc_oc=AdrgdV9vWjkjOFeRAVMaAWJZrZ1ESdjTd-c-0YVOJmQFNqAoGx_iJdHKk-AELOoI8tA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_07oFoatsAYiZdMg06BJhA-8wo25t9mIbWOd9txDiAlg&oe=6A4508DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10_Trailer Cover Image.png", "id": "3882150242001679", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393518_3882150248668345_4121139368324962260_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gI8hMrbo-jAQ7kNvwExXX5k&_nc_oc=Adpjt42s9r7pDUn5XFkyHETnyXIY06aPSrh52ZmXxxjyp7HnNMGFftRwReVefBHXCcI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DOWfa0S_LpOm9xUw8FouWryCu0H6t7sxtQRDrUDXeMA&oe=6A450CEA"}, "display_name": "Darts VR2: Bullseye", "keywords": ["darts", "zombies", "multiplayer", "501"], "long_description": "**Darts VR2: Bullseye** is the next evolution of immersive darts gameplay, bringing **precision, competition, and casual fun** to virtual reality. Whether you're aiming for the **championship trophy**, battling **zombie hordes**, mastering **501 Mode**, or just **throwing darts for fun**, this game has something for everyone.  \n\n## Key Features  \n\n### Compete & Conquer  \nPlay against friends or challenge the world in high-stakes **esports tournaments**. Win **championships, host your own competitions**, and prove your dominance.  \n\n### Master the 501 Mode  \nThink fast, aim sharp, and **strategize your way to exactly zero** before your opponent. A true test of skill, patience, and precision.  \n\n### Survive the Undead  \nTake on a thrilling **Zombies Mode**, where each throw could mean survival or defeat.  \n\n### Casual or Competitive? Your Choice!  \nWhether you're **practicing trick shots, hitting impossible killstreaks**, or just relaxing with a few rounds, there's always a way to enjoy the game.  \n\n### Climb the Leaderboards  \nEarn achievements, **hone your skills**, and rise to the top. Show off your darts collection, unlockable cosmetics, and unique avatars.  \n\n\n**Darts VR2: Bullseye** isn\u2019t just a game\u2014it\u2019s the definitive **VR darts experience** for players of all skill levels.  \n", "short_description": "Darts VR2: Bullseye is the ultimate VR darts experience, offering competitive and casual gameplay across multiple modes, including Championship, Zombies, 501, and Killstreak. Play with friends, climb the leaderboards, and showcase your unique darts collection and avatars. Whether you're aiming for precision, mastering strategies, or just having fun, the game delivers an immersive and cross-platform experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gamitronics.com/DartsVR2/PP.pdf", "developer_terms_of_service_url": null, "publisher_name": "Gamitronics Studio", "support_website_url": null, "website_url": "https://www.gamitronics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_mo
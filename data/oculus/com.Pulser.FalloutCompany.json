00_AQQhGVWPy5H0IEzAFoZbmd0rL0KnVe8dJ_XYiH0fccXppQ&oe=6AEB2E81"}, {"file_name": "im325fdgsfage (1).png", "id": "1194236372665393", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299922_1194236375998726_5851585289048427341_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOvIPIMDt34Q7kNvwHysoyl&_nc_oc=AdoqeXADenwp9oI0tqkBGIxX2Gs1NP2HzhqMf-4aEpDnEdFivaUjaGyp1HCPXY2ddwo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdF7Ol8Z9XP0XjRnFoe6VrlwJOJg5JP5t6Ur9tzvSN3Q&oe=6AEB58F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ApePoint Extraction", "keywords": ["game", "guns", "fighting", "survival"], "long_description": "ApePoint Extraction is an intense, high-stakes VR mission mode where every second matters. Players enter a hostile zone filled with enemies and hidden ApePoint caches scattered across the map. Your goal is simple: find as many ApePoints as possible, defend yourself, and extract before the timer hits zero.\n\nEach run is unpredictable \u2014 loot spawns change, enemies patrol differently, and extraction points rotate. Survive firefights, outplay other players, and secure your haul. The more ApePoints you escape with, the more upgrades, weapons, and rewards you unlock.\n\nPush deeper for bigger payouts\u2026 or extract early and play it safe.\nIn ApePoint Extraction, risk equals reward \u2014 and only the smartest players make it out alive.", "short_description": "ApePoint Extraction is a fast-paced VR objective mode where players fight through enemies, locate ApePoints, and safely extract before time runs out. Collect points, survive the rush, and escape with your loot."}]}, "developer_name": "Pulser Games", "developer_privacy_policy_url": "https://apepointextraction.com/privacy", "developer_terms_of_service_url": "https://apepointextraction.com/terms", "publisher_name": "Zuse", "support_website_url": null, "website_url": "https://apepointextraction.com/home", "category": null, "comfort_rating": "
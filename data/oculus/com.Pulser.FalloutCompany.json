dn.com/v/t64.5771-25/499293690_2046707252811742_6216717170423982563_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbYCUPqK3yYQ7kNvwFQYgWX&_nc_oc=AdlMsF3MsI9-hduvL1cY35LrLUwMnQI4v4-2BblzVYGMwZUpPDSBZ_Z2cjdnesyciRI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftDZWUfz90YFQZ7VGiSrifrYDQNI1Qo27Pr52vpT49bWQ&oe=69985D01"}, {"file_name": "im325fdgsfage (1).png", "id": "1194236372665393", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499299922_1194236375998726_5851585289048427341_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK1_2_AU4AAQ7kNvwFOiAGq&_nc_oc=AdlOwCUgnQANuo7mh6x-LvH6aJkMFojq6mq2G6wqDYJduEn2rUHBaH1cvQbNmzemQbY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvUWS-49L7B2gZGszQTxv42DCB5LbE08XLhi5Q7mQodbw&oe=69984F35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ApePoint Extraction", "keywords": ["game", "guns", "fighting", "survival"], "long_description": "ApePoint Extraction is an intense, high-stakes VR mission mode where every second matters. Players enter a hostile zone filled with enemies and hidden ApePoint caches scattered across the map. Your goal is simple: find as many ApePoints as possible, defend yourself, and extract before the timer hits zero.\n\nEach run is unpredictable \u2014 loot spawns change, enemies patrol differently, and extraction points rotate. Survive firefights, outplay other players, and secure your haul. The more ApePoints you escape with, the more upgrades, weapons, and rewards you unlock.\n\nPush deeper for bigger payouts\u2026 or extract early and play it safe.\nIn ApePoint Extraction, risk equals reward \u2014 and only the smartest players make it out alive.", "short_description": "ApePoint Extraction is a fast-paced VR objective mode where players fight through enemies, locate ApePoints, and safely extract before time runs out. Collect points, survive the rush, and escape with your loot."}]}, "developer_name": "Pulser Games", "developer_privacy_policy_url": "https://a
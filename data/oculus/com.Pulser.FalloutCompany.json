t-qro3-1.oculuscdn.com/v/t64.5771-25/499308103_885387800937252_8189008198977562030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vN6loEdUMHgQ7kNvwEuYnc2&_nc_oc=AdqyuAVckSvO5QsZB_EsIk6q1XCxaisJRbZcCHC8_JeYiW2dIvVjSk8IKg634STY6tQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFpdUJ6u_OFzhC_t1kbrer3L1V5Zc5QFEOqzstM8kvHQ&oe=6A94074A"}, {"file_name": "499298291_779093648505766_7370587463585206763_n.png", "id": "2748472798826153", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499307433_2748472802159486_2788932522994722730_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2S6Fj8iFoI0Q7kNvwFyNrij&_nc_oc=AdpFLrhz-kZZsVE_RBN1L3Foy04Ej3_5_56kgf-Cse0llynvPYX7vtaZAaoSvZ3blqw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnbFABTAMI21eJWnO5K6G667fEKG1efhyDMHgCaZyZ5w&oe=6A941C12"}, {"file_name": "499619078_3681735578627732_8821146730731103120_n.png", "id": "1982542176475730", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499303864_1982542179809063_2661797543406578589_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BchFhO3FMbgQ7kNvwGkPC8e&_nc_oc=AdoJoNizI3JJO7S2Uh88B9N4UXUFiCOe7vh0gqNLw-SpjbkeqA7xxxfvA8eb1EkFon4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEa64u7gUc6eCOb_6XlzUCv6-Uoz1PTfXISXkvvcN5whA&oe=6A942E9F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apple Taggers", "keywords": ["game", "guns", "fighting", "survival"], "long_description": "Apple Taggers VR is an action-packed multiplayer VR experience built around fast movement, smooth locomotion, and chaotic fun.\n\nBecome an Apple and enter vibrant arenas where players climb, jump, and sprint using full VR motion. One player starts as the tagger, and the rest must escape using skillful movement, parkour routes, and quick reactions. Get tagged \u2014 and the chase continues.\n\nDesigned for casual fun and competitive play, Apple Taggers is easy to learn but hard to master. Whether you\u2019re playing with friends or jumping into public lobbies, every round is unpredictable and intense.\n\n\ud83d\udd25 FEATURES\n\n\ud83c\udf4e Fast-paced multiplayer tag gameplay\n\n\ud83e\udd7d Built from the ground up for VR movement\n\n\ud83c\udfc3 Smooth climbing, jumping, and locomotion\n\n\ud83c\udfae Easy to learn, high skill ceiling\n\n\ud83e\uddd1\u200d\ud83e\udd1d\u200d\ud83e\uddd1 Play with friends or public lobbies\n\n\ud83c\udfa8 Bright, fun environments optimized for VR\n\n\ud83d\ude80 Regular updates and new content planned\n\nIf you love movement-based VR games and nonstop action, Apple Taggers VR delivers pure adrenaline and fun.", "short_description": "Apple Taggers VR is a fast-paced multiplayer tag game where speed, skill, and movement decide who wins. Climb, jump, and chase your friends in colorful maps \u2014 but don\u2019t get tagged!"}]}, "developer_name": "Pulser Games", "developer_privacy_policy_url": "https://sites.google.com/view/appletaggers/home", "developer_terms_of_service_url": null, "publisher_name": "Zuse", "support_website_url": null, "website_url": "https://sites.google.com/view/appletaggers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26422675897350563"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823893_894683056640491_7075
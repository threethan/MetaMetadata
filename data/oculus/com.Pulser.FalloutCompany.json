dn.com/v/t64.5771-25/499293690_2046707252811742_6216717170423982563_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_a-8R2eN6sEQ7kNvwFbWXvZ&_nc_oc=Adn0FSXCU7fbDy79PwXlVFQUT_PpigziUZsGqlheLXJSbsAivXcXCDcf3lM4hGFNBjY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvRNceTPTj1UVuc3rmTCGVtn3ZoqpohYHqW-1C9H63OmQ&oe=69A04601"}, {"file_name": "im325fdgsfage (1).png", "id": "1194236372665393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299922_1194236375998726_5851585289048427341_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qKvlVNyJBkQ7kNvwF0H2Z9&_nc_oc=AdnuUZxwDDJSA8wQQ86SCmjYrhPQetFmyBfx8BnuqBAFjL4LnJiMI5pYBI24woHiYEk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuyK-DhZkmQLrjFi7wG-Tih0OlbDpGa70oqHF9BMLU8IA&oe=69A03835"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ApePoint Extraction", "keywords": ["game", "guns", "fighting", "survival"], "long_description": "ApePoint Extraction is an intense, high-stakes VR mission mode where every second matters. Players enter a hostile zone filled with enemies and hidden ApePoint caches scattered across the map. Your goal is simple: find as many ApePoints as possible, defend yourself, and extract before the timer hits zero.\n\nEach run is unpredictable \u2014 loot spawns change, enemies patrol differently, and extraction points rotate. Survive firefights, outplay other players, and secure your haul. The more ApePoints you escape with, the more upgrades, weapons, and rewards you unlock.\n\nPush deeper for bigger payouts\u2026 or extract early and play it safe.\nIn ApePoint Extraction, risk equals reward \u2014 and only the smartest players make it out alive.", "short_description": "ApePoint Extraction is a fast-paced VR objective mode where players fight through enemies, locate ApePoints, and safely extract before time runs out. Collect points, survive the rush, and escape with your loot."}]}, "developer_name": "Pulser Games", "developer_privacy_policy_url": "https://a
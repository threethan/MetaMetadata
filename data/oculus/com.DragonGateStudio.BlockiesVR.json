8Tufwj0u2x3ocuvhPfKJPgYb5dsAVlSJqUvaf_GEowiJ7ptQcj0hbkJt4bY6qHU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzyNLTOpZJFtT2TXmXI-pMx7W_Csaehna-E0DbIbZQlQQ&oe=69D124A1"}, {"file_name": "5.png", "id": "1061517104420269", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036641_1061517107753602_1383467785716530594_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Ievf1Wi7Y0Q7kNvwGyPmo2&_nc_oc=Adqj7zQXavRSV3hxO_QWCVm2kFu2o3HBqpDPrz10F9tm0CxyuvaJduJs0jQ2oqjDnFw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqZORBq475YtxC_wf_tn54z3G9VFnsGfpBgjwSdTgk1g&oe=69D0FBF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2022-07-03 20ffff1916.png", "id": "3478847289006005", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974897_3478847295672671_208656237028816676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ejNMF_7Zq4Q7kNvwEIKDa7&_nc_oc=AdrNndKmRAHKOQtLY2oOVfp0J4q1RXO8I-FyBNrTKW4htyZD6DG6wk9Z5MxZLLAUj60&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwuBvO8wckZRIyW8HTeM4w3K-6dJUojRqTlbiuNAxr4gQ&oe=69D10860"}, "display_name": "Blockies VR", "keywords": [], "long_description": "Blockies VR is a single player action-puzzle game where you knock down block buildings and protect friendly Blockies against the forces of evil. Launch a wide range of objects at enemies in this low-poly physics world. Travel to the Kingdom\u2019s shop to expand your weapon arsenal to take on the most difficult puzzles in all the land.\n\nFeatures\n-A dozen types of blocks that interact uniquely with the world\n-A dozen AI enemy types each with their own abilities\n-Levels where you must defend the Blockies from monster attacks\n-Levels with intricate block puzzles to solve\n-The Kingdom where cool new projectiles can be purchased\n-Beautifully designed low poly environments\n-At least 50 levels by full release (Currently 16)\n-With enough support: Level Editor to create and share new levels\n-With enough support: Co-op and Multiplayer Functionality\n\nJoin the Discord to learn more about future updates, and provide your own feedback of what you want in the game!", "short_description": "Blockies VR is a fast-paced, action-puzzle game where you throw projectiles. Destroy block buildings and defend friendly Blockies! Fight against all kinds of enemy monsters by throwing projectiles ranging from a silly pineapple to a destructive blackhole."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.dragongatestudio.online/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "DragonGate Studio", "support_website_url": null, "website_url": "http://www.dragongatestudio.online/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24469619582624535"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298248_634516319648305_5517590444110159274_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JYC84l59BEQ7kNvwF3PP-B&_nc_oc=AdqlpcTRcUfBL2qkIA3Jndj-8N5VMmpUT3xsmVCUTN5VySgXiFDCBFJiF7PGIKxFH98&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRkctlAeOJr5u6zq1VjdkKZVM2qwWD3uUbnahlMGsxVA&oe=69D10732"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bl
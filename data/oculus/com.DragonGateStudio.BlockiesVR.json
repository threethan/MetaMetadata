Q44siDTFmA-cTV6YjQHh3cnj7W8B8gXDhOjc7dpwVfXuxtwC3iDtm4v4s_ngYgU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNSU5XbxlsFho5mCUSjyMwoGIfMoagYW3IkAm-ePycEA&oe=6A897E61"}, {"file_name": "5.png", "id": "1061517104420269", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036641_1061517107753602_1383467785716530594_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3cL-uEzoI4Q7kNvwGgd2id&_nc_oc=AdoMQ9U5Q14638LBaoTkTXEsIaFoGY226WVBMAezlzbCYt6aYDg90AeoOA8NYWhHl-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrgbP9hF5wtVOGcRqKuzUv1Lqy3-vooPbQ3Gih782GMA&oe=6A898DF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2022-07-03 20ffff1916.png", "id": "3478847289006005", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974897_3478847295672671_208656237028816676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8X7lzKOeCgQ7kNvwGz2Wur&_nc_oc=Adq5DPYHTcl8NFDDWb1EaMPq049Nme5PIgu-NxlqjEsQzmiwc9GnUtO1giyCaID1kwM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVFGs-eiZl5jS_R1UYfn4hJuJGwU7YR8627O7tfHXJ3w&oe=6A899A60"}, "display_name": "Blockies VR", "keywords": [], "long_description": "Blockies VR is a single player action-puzzle game where you knock down block buildings and protect friendly Blockies against the forces of evil. Launch a wide range of objects at enemies in this low-poly physics world. Travel to the Kingdom\u2019s shop to expand your weapon arsenal to take on the most difficult puzzles in all the land.\n\nFeatures\n-A dozen types of blocks that interact uniquely with the world\n-A dozen AI enemy types each with their own abilities\n-Levels where you must defend the Blockies from monster attacks\n-Levels with intricate block puzzles to solve\n-The Kingdom where cool new projectiles can be purchased\n-Beautifully designed low poly environments\n-At least 50 levels by full release (Currently 16)\n-With enough support: Level Editor to create and share new levels\n-With enough support: Co-op and Multiplayer Functionality\n\nJoin the Discord to learn more about future updates, and provide your own feedback of what you want in the game!", "short_description": "Blockies VR is a fast-paced, action-puzzle game where you throw projectiles. Destroy block buildings and defend friendly Blockies! Fight against all kinds of enemy monsters by throwing projectiles ranging from a silly pineapple to a destructive blackhole."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.dragongatestudio.online/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "DragonGate Studio", "support_website_url": null, "website_url": "http://www.dragongatestudio.online/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24469619582624535"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298248_634516319648305_5517590444110159274_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HpXOqXRXHoQ7kNvwElX6sr&_nc_oc=Adroh1EkigAlY3Ai0ZRGUYBiozGYF7rvr65-6njxmDgKx7zoFHaZwbzLgyxzUQsww1U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5XmUsQYqs3cQ9e7juTmKnZVw2wUz7kLYvjFHUeEwSzQ&oe=6A899932"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bl
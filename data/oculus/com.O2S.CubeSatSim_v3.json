tps://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491824307_1049739481368810_2531764792333197134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiqj4NdISAQQ7kNvwFHbtXA&_nc_oc=AdoVEs5wm1aa6A-tPqn2i_wgujJnXw9nLscU9Ky_po8Ip23sE8ak3pJctReuhzQkLDs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGbDXoOYnLkRAfgV86OFs6BQKRXCftruYknY0OJaZjOg&oe=6A8EE201"}, {"file_name": "screen_7.png", "id": "4631864633768786", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823949_4631864640435452_3362663084873379426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4o4hfLhyi_EQ7kNvwEl4Wui&_nc_oc=Adp26JXgCKc4slBWAdp4CoOH5oj4jayFpbdhxiw4IeeoYEus14ootWDZvXQWQbb6MO0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9fivY6NAH3bi3NHZ6BNGdPlHmyfpzDFVG53PxClYM4g&oe=6A8EF40E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CubeSat Mission VR", "keywords": ["CubeSat", "STEM", "IEEE", "Space", "Simulation"], "long_description": "CubeSat Mission VR\n\nBuild. Test. Launch. Explore Space.\n\nBecome a Space Systems Engineer and experience the complete CubeSat mission in immersive Virtual Reality.\n\nExplore realistic 3D CubeSat components, learn how each subsystem works, test mission-critical hardware, assemble a fully functional satellite, validate spacecraft readiness, and launch your CubeSat into Earth orbit.\n\nMission Highlights\nExplore CubeSat components\nLearn subsystem functions\nTest electronics and hardware\nAssemble the CubeSat\nRun system diagnostics\nIntegrate with the launch vehicle\nExperience rocket launch\nDeploy your CubeSat into orbit\n\nInteract with authentic components including the Structure Frame, On-board Computer (OBC), Electrical Power System (EPS), Solar Panels, Battery Pack, Communications Module, Antenna System, Sensors, Attitude Control System, and Payload Module. Each includes educational information about its purpose and role in the mission.\n\nDesigned for engineering students, universities, STEM programs, IEEE workshops, educators, researchers, and space enthusiasts, CubeSat Mission VR offers an engaging introduction to CubeSat architecture, spacecraft integration, systems engineering, satellite testing, launch operations, and orbital deployment.\n\nReplay the mission anytime to improve your skills and experience the complete satellite development lifecycle\u2014from assembly to space launch.\n\nBuild your CubeSat. Complete the mission. Launch your future in space engineering. \ud83d\ude80\n{1363224375239841}", "short_description": "Become a CubeSat Engineer in Virtual Reality\n\nExperience the complete CubeSat development lifecycle\u2014from component testing to orbital deployment\u2014in an immersive VR simulation designed for students, educators, researchers, and space enthusiasts.\n\nCubeSat VR introduces users to the engineering principles behind modern small satellites through interactive hands-on learning.\n\nInstead of watching videos or reading textbooks, you'll assemble a real CubeSat yourself."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ocean2sand.com/policy-cubesat-mission-vr", "developer_terms_of_service_url": null, "publisher_name": "OCEAN2SAND", "support_website_url": null, "website_url": "https://www.ocean2sand.com/solutions", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"
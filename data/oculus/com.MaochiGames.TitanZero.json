5/39031580_225520282743054_2155002173123330745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LB0Ewsx8s2IQ7kNvwE3XsbA&_nc_oc=AdobmMv-N4_sAHqTOc0RCwPimP-AxkpCLhU_FSz_VGZ9TkqnGQcuVKkjcDEtF7l5mWE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCP8EmUPXT_D1wCR23y4jG7lRsyBm1-FgSU_42YoePwNg&oe=6A6B4093"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus trailer 2560 x 1440px.png", "id": "494540418629347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982503_494540421962680_2787751862155186437_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_r_6xogm88Q7kNvwEZNONx&_nc_oc=Adq4Dr-ZI7PHCgqAnSExCojd87GPDQClnZ-ygSdqIEoPBzggNdfS-Vl0v82nSb5a3zA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWeQzfHbgLOneuzygy4jjPKzuGVDZww6HB-S2fkDrCHw&oe=6A6B47B9"}, "display_name": "TitanZero", "keywords": [], "long_description": "Titan Zero is a full battle mech multiplayer game that gives you the experience of being a mech pilot while playing against other mechs. Compete against 5v5 and 6v6, every mech has a vital role to play. \n\nMechs come in different sizes ranging from small, medium, large which carry unique weapon combinations. Choose from Flankers, Outriders, Assault, Direct Support to Indirect Support - which carries long-range weapons. Aesthetic and ability upgrades are also available to showcase your chosen mech. ", "short_description": "Mech acquired! Titan Zero is a multiplayer battle mech game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1fyw-vWP7lvzHSv9eg5qN_WFNmX6lRVn0/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Maochi Games", "support_website_url": null, "website_url": "https://www.facebook.com/maochi.isme/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427
5/39031580_225520282743054_2155002173123330745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7Lr9E2cI1wQ7kNvwGJqO1C&_nc_oc=AdrUuKHl-7UP_ocHU5kjYBTSiDepAZUmVKjZweMJFom5E5z3GgQ_jU9N_NcoZFn6TY0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlo6c3TNU9XxpVUR-SLiYefUAznalye6TEx0vq-51qGg&oe=6AE1E793"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus trailer 2560 x 1440px.png", "id": "494540418629347", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982503_494540421962680_2787751862155186437_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqISZ58MeH4Q7kNvwHkL5kp&_nc_oc=AdqZrKI8ZOD8yaS0SiBX4a-zE_eiyw8mB1oyuMKtbWpyF77P5YxIUsH-oVvAW_dii2I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-TFinA_q9ra5Jc-XpPtbS-O3oytO8Em0ZY011XqBC6g&oe=6AE1EEB9"}, "display_name": "TitanZero", "keywords": [], "long_description": "Titan Zero is a full battle mech multiplayer game that gives you the experience of being a mech pilot while playing against other mechs. Compete against 5v5 and 6v6, every mech has a vital role to play. \n\nMechs come in different sizes ranging from small, medium, large which carry unique weapon combinations. Choose from Flankers, Outriders, Assault, Direct Support to Indirect Support - which carries long-range weapons. Aesthetic and ability upgrades are also available to showcase your chosen mech. ", "short_description": "Mech acquired! Titan Zero is a multiplayer battle mech game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1fyw-vWP7lvzHSv9eg5qN_WFNmX6lRVn0/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Maochi Games", "support_website_url": null, "website_url": "https://www.facebook.com/maochi.isme/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427
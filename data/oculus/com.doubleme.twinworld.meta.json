 4.png", "id": "770907821490523", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974655_770907824823856_4262302028766369840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MA-c-qse9N0Q7kNvwE1mM5G&_nc_oc=AdqnfMMtYgt9VCXtievHcIbFhYCY0OJKrKVtc7T2UmstGb27TGkzdn7nk9f4WjlrgUI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzyFGassxb0EHiPGYYdLKnAP81ZJe_IwOH6h4znIDrvg&oe=6AAD2FD8"}, {"file_name": "image 5.png", "id": "227737856678757", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566685_227737860012090_6136058911021566747_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nH4G_73rbiAQ7kNvwF5QvID&_nc_oc=AdqJOvkAKqXIif_vOSzEPEsI2grAw2kr8BWj8gpAcGSJWkSd7CdgnO28Bpm40mfWUUo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3o5BTXZeqs5NXfCSfV_E4wG-vWnn81ggHRJ5p6Wh4-Q&oe=6AAD5D03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u110b\u1167\u11bc\u1109\u1161\u11bc \u1109\u1175\u110c\u1161\u11a8 \u110b\u1175\u1106\u1175\u110c\u1175.png", "id": "1231016397780902", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031582_1231016401114235_5728952087113635_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sLyMo_bvesQ7kNvwGIcmiW&_nc_oc=AdrD82O0hvVV5U9ESdrOuRi0WbfDX9PrIRZYsKaV8bIQB1RYM8eMBZSmBxR2Evoc5G4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7cLdk6iA59GBkWm2djddc50VMj9ipMYSZrfookXVZog&oe=6AAD613C"}, "display_name": "Twinworld", "keywords": [], "long_description": "Create, enjoy, and share a new realm beyond reality!\nTwinWorld is a metaverse platform where anyone can easily decorate their own space, enjoy it with others, and unfold endless possibilities within mixed reality.\nWhether it's playing chess, drawing, creating exhibition spaces, or collaborating, you can indulge in anything your imagination allows with other people.\n\n* Multiplayer is supported, allowing up to 10 people in the same space.\n* You can upload your own 3D object and view it with others.\n* Customize your own space with countless 3D items.\n* Create audio items using your voice or music.\n* Draw simple 3D pictures.\n* Most importantly, TwinWorld will continue to evolve!", "short_description": "Create, enjoy, and share a new realm beyond reality!\nTwinWorld is a metaverse platform where anyone can easily decorate their own space, enjoy it with others, and unfold endless possibilities within mixed reality.\nWhether it's playing chess, drawing, creating exhibition spaces, or collaborating, you can indulge in anything your imagination allows with other people."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.twin.world/privacy-policy", "developer_terms_of_service_url": "https://www.twin.world/termsandconditions", "publisher_name": "Doubleme", "support_website_url": "https://www.twin.world/", "website_url": "https://www.doubleme.me/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "788296226228901"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24535533806085651", "version": "1.5.8"}, "id": "6711028708908447", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppB
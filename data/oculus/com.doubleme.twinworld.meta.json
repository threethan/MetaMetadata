 4.png", "id": "770907821490523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974655_770907824823856_4262302028766369840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahAxnKDCSngQ7kNvwFpVlnI&_nc_oc=Adq0xNgLVAPyjG9abHSPxc1Jm2qObWKL2rwoRIVTgvRE23THxIKkVWBbi14tJOsko1Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dcVQ6Td_u49iszdwE6k9lGY0zxVqZ8BeH0yzSZOFVMw&oe=6A05C158"}, {"file_name": "image 5.png", "id": "227737856678757", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_227737860012090_6136058911021566747_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qa2ZQxYmYZYQ7kNvwGEvZYE&_nc_oc=AdqWm05kIfDXwEBHXzrZe0YbneKme1U4kG6NGZ3fdBBPc_RRDbNGcJ3-DMGIXKTFkgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fEAfcx4IRxY6YHMK1PhghdClxr49ng0gAvo9eTTnEWQ&oe=6A05EE83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u110b\u1167\u11bc\u1109\u1161\u11bc \u1109\u1175\u110c\u1161\u11a8 \u110b\u1175\u1106\u1175\u110c\u1175.png", "id": "1231016397780902", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031582_1231016401114235_5728952087113635_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9o8HdVdFd9cQ7kNvwEAPX-k&_nc_oc=AdrcF3v3sq8eaZkesLiMGGpF08ju05jYQwLgzNrio3bdE2RTwNHvWEAQF9JTtgA_6wM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64JVAYanA0WeFwcWTqCdwUZ5L3NqAR77XDzTRPIuJV-w&oe=6A05BA7C"}, "display_name": "Twinworld", "keywords": [], "long_description": "Create, enjoy, and share a new realm beyond reality!\nTwinWorld is a metaverse platform where anyone can easily decorate their own space, enjoy it with others, and unfold endless possibilities within mixed reality.\nWhether it's playing chess, drawing, creating exhibition spaces, or collaborating, you can indulge in anything your imagination allows with other people.\n\n* Multiplayer is supported, allowing up to 10 people in the same space.\n* You can upload your own 3D object and view it with others.\n* Customize your own space with countless 3D items.\n* Create audio items using your voice or music.\n* Draw simple 3D pictures.\n* Most importantly, TwinWorld will continue to evolve!", "short_description": "Create, enjoy, and share a new realm beyond reality!\nTwinWorld is a metaverse platform where anyone can easily decorate their own space, enjoy it with others, and unfold endless possibilities within mixed reality.\nWhether it's playing chess, drawing, creating exhibition spaces, or collaborating, you can indulge in anything your imagination allows with other people."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.twin.world/privacy-policy", "developer_terms_of_service_url": "https://www.twin.world/termsandconditions", "publisher_name": "Doubleme", "support_website_url": "https://www.twin.world/", "website_url": "https://www.doubleme.me/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "788296226228901"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2690984057711142"}]}, "baseline_offer": {"id": "2690984057711142"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1686174406, "status": "PUBLISHED", "id": "2690984057711142"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24535533806085651", "version": "1.5.8"}, "id": "671102
uscdn.com/v/t64.5771-25/473393486_1275406103517636_8510649641835324663_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgW_wvODeM0Q7kNvwG6nvnK&_nc_oc=AdmpW3ZJy2BQ5SY2QX1fOSY8ylkztKEg7xhRdc-4IlDhiAjxcJjTKJ-zzWC9066iV3Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afwjx8KOVwdf5smOxqb0cVQ6zjGOifj1TEBG6YV6-a1FiA&oe=69AAC328"}, {"file_name": "13.png", "id": "2332661277118736", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391946_2332661280452069_1207272620658532852_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAuDVTk8RygQ7kNvwEDyOMO&_nc_oc=AdmZ20X96K-0D0K1AEgW78M83j2GSWhyz3JTXa1kP3zAyxZhk0lUCLZTDwU8YZ_FJWU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfyPN94yPOIvzq_H2PdsDy5NirW5QurGHRXn5Pk29yYvcg&oe=69AADFC5"}, {"file_name": "\uc2a4\uc0f77.png", "id": "872850638159855", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392005_872850641493188_3164958946993478938_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BobpO6WMSjEQ7kNvwHFUE6F&_nc_oc=AdlI_VDYb9y55ZReL_cxxYg12ti4GP9jXI1XrvTeYfUBX0wjfhTU0M3L_xf_oATy9Ic&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzECDWZR7cXeNgU90_4ehzGItGxEvoxs2xr3KMfe5El1A&oe=69AADBDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u110b\u1172\u1110\u1172\u1107\u1173 \u110a\u1165\u11b7\u1102\u1166\u110b\u1175\u11af - \u110f\u1169\u110b\u1175\u11ab x 2.png", "id": "837392354517038", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75272213_837392357850371_8513463034443993783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNILAVkcYO0Q7kNvwHuAO4x&_nc_oc=AdmZT6_x8pE0nloH1dVaCat2ikixCaDBLtCV_tFsY92hy0EYyJBxJBCp8B2x1grXAso&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afxg9BE9lSzrKAwINTazfuNTX5lRM6h9hoEHXloSS56uSg&oe=69AADDB3"}, "display_name": "TwinWorld", "keywords": ["world", "creation", "sandbox", "3D", "architecture"], "long_description": "Create, enjoy, and share a new realm beyond reality!\nTwinWorld is a metaverse platform where anyone can easily decorate their own space, enjoy it with others, and unfold endless possibilities within mixed reality.\nWhether it's drawing, creating exhibition spaces, or collaborating, you can indulge in anything your imagination allows with other people.\n\n* Customize your own space with countless 3D items.\n* We've added physical features to our items to make them feel more realistic.\n* Multiplayer is supported, allowing up to 10 people in the same space.\n* Create audio items using your voice or music.\n* Draw simple 3D pictures.\n* Most importantly, TwinWorld will continue to evolve!", "short_description": "Create, enjoy, and share a new realm beyond reality!\nTwinWorld is a metaverse platform where anyone can easily decorate their own space, enjoy it with others, and unfold endless possibilities within mixed reality.\nWhether it's drawing, creating exhibition spaces, or collaborating, you can indulge in anything your imagination allows with other people."}]}, "developer_name": null, "developer_privacy_policy_url": "https://prod-twin.world/terms-and-conditions/privacy", "developer_terms_of_service_url": "https://prod-twin.world/terms-and-conditions/service", "publisher_name": "Doubleme", "support_website_url": "https://www.doubleme.me/contact", "website_url": "https://www.twin.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGL
 4.png", "id": "770907821490523", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974655_770907824823856_4262302028766369840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4et6tn0zUwQ7kNvwGinikc&_nc_oc=Adqo8fVLBqrW6loil3SiA5TBpMi83JspvvgqeSDjEwaawe0_oIktPTDpaeDUD1umacw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9TgxCGfKn1RILcP4Hj66UNamUuzH6r6VY2XUE-89Ukw&oe=6ADF48D8"}, {"file_name": "image 5.png", "id": "227737856678757", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566685_227737860012090_6136058911021566747_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7wYq3LQAN4Q7kNvwHfMcE5&_nc_oc=AdoHo_h1yaYEdugR3j_bDl01nMK7QOAMroIq_e_p9KUv-YPvFgIum4CYN8Jj9kRDQIs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUPCOtgu3HTl9yh0yP7VAfSpJixup026Nl5KwOzv-wTA&oe=6ADF7603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u110b\u1167\u11bc\u1109\u1161\u11bc \u1109\u1175\u110c\u1161\u11a8 \u110b\u1175\u1106\u1175\u110c\u1175.png", "id": "1231016397780902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031582_1231016401114235_5728952087113635_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4Z8dgr2HSUQ7kNvwFTMOey&_nc_oc=Adrq3URegwkWuBOldeVCo1tGeLueGmZBAJpvDPTWpUOYHQN0XjewXV5KcxQcfTbNH_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtZzIrXa-CTB0hN6cdY1URP89Wl0Wl17VFF62o__ThyQ&oe=6ADF7A3C"}, "display_name": "Twinworld", "keywords": [], "long_description": "Create, enjoy, and share a new realm beyond reality!\nTwinWorld is a metaverse platform where anyone can easily decorate their own space, enjoy it with others, and unfold endless possibilities within mixed reality.\nWhether it's playing chess, drawing, creating exhibition spaces, or collaborating, you can indulge in anything your imagination allows with other people.\n\n* Multiplayer is supported, allowing up to 10 people in the same space.\n* You can upload your own 3D object and view it with others.\n* Customize your own space with countless 3D items.\n* Create audio items using your voice or music.\n* Draw simple 3D pictures.\n* Most importantly, TwinWorld will continue to evolve!", "short_description": "Create, enjoy, and share a new realm beyond reality!\nTwinWorld is a metaverse platform where anyone can easily decorate their own space, enjoy it with others, and unfold endless possibilities within mixed reality.\nWhether it's playing chess, drawing, creating exhibition spaces, or collaborating, you can indulge in anything your imagination allows with other people."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.twin.world/privacy-policy", "developer_terms_of_service_url": "https://www.twin.world/termsandconditions", "publisher_name": "Doubleme", "support_website_url": "https://www.twin.world/", "website_url": "https://www.doubleme.me/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "788296226228901"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24535533806085651", "version": "1.5.8"}, "id": "6711028708908447", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppB
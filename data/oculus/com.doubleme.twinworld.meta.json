Z5XQeALx6cdN93FSNPY12CH1UCDHNmJLcY1wAYaLkq7FGFXTFjG4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPv1-a4HJrV46--ZGzEk1gADG80X0hR3Vc_bREVrX3IA&oe=6AFC95F3"}, "display_name": "TwinWorld", "keywords": ["world", "creation", "sandbox", "3D", "architecture"], "long_description": "Create, enjoy, and share a new realm beyond reality!\nTwinWorld is a metaverse platform where anyone can easily decorate their own space, enjoy it with others, and unfold endless possibilities within mixed reality.\nWhether it's drawing, creating exhibition spaces, or collaborating, you can indulge in anything your imagination allows with other people.\n\n* Customize your own space with countless 3D items.\n* We've added physical features to our items to make them feel more realistic.\n* Multiplayer is supported, allowing up to 10 people in the same space.\n* Create audio items using your voice or music.\n* Draw simple 3D pictures.\n* Most importantly, TwinWorld will continue to evolve!", "short_description": "Create, enjoy, and share a new realm beyond reality!\nTwinWorld is a metaverse platform where anyone can easily decorate their own space, enjoy it with others, and unfold endless possibilities within mixed reality.\nWhether it's drawing, creating exhibition spaces, or collaborating, you can indulge in anything your imagination allows with other people."}]}, "developer_name": null, "developer_privacy_policy_url": "https://prod-twin.world/terms-and-conditions/privacy", "developer_terms_of_service_url": "https://prod-twin.world/terms-and-conditions/service", "publisher_name": "Doubleme", "support_website_url": "https://www.doubleme.me/contact", "website_url": "https://www.twin.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
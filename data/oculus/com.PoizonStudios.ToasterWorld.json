m&oh=00_Afv5EWxOUVXTBzOZD3eNNpONA3qbM-9arntwk8FWHE-ZyA&oe=69A02FA6"}, {"file_name": "Main World_Custom..._30.08.2025_19-42-48.png", "id": "4235676753344378", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302483_4235676756677711_2966724972383170337_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5-DK0I_zwMQ7kNvwFiXIaJ&_nc_oc=Adnb0Ps9Hv0gkPqdb1wwxWoKrIxHTk8aD9fpa4n_WB-gvqpAOqp9qG2YmjuRCSEDKUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvyQ0z-CnKhLZqbirsRe_wN-iCsEkBA2wETjrbdMyY7uQ&oe=69A056A2"}, {"file_name": "Main World_Custom..._30.08.2025_19-43-35.png", "id": "1911919609601681", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304131_1911919612935014_1653522309514593606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Xoi5P8os6AQ7kNvwEtnPT1&_nc_oc=AdkUogIFMI3bnsZK7uhsGcgCOmuLYfY44Y7Q88BKuyCTPnzeen9-AX8dMBfCsO-GVxo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfspKhO1cKNrpbvEkSR6EjAdhQQ45hxbbKqoGWFxmCYU0w&oe=69A02FF3"}, {"file_name": "Main World_Custom..._30.08.2025_19-43-00.png", "id": "1126820732709530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308131_1126820736042863_9196489109898823936_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKJlFcBiYIYQ7kNvwHHCFln&_nc_oc=Adn94eEwwlRWVRASegmPxJ774V1s9_YNeh-A_tTH9NB8628j_H6xL3tC3xP3uh4JD9k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu4cDAuTbVP8GIv-V0bRwhwg9pNq2UqEXYZdq8Ak11KlQ&oe=69A041E4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Toaster World", "keywords": ["toaster", "fun", "free", "bread", "gorilla"], "long_description": "Welcome to Toaster World, the best place to hang out with your buddies as a Toaster, and as a Toaster only! Run around in the various areas/maps, and search for hidden collectible accessories in each map. Customize your toaster's screen color, the hats it's wearing, and heck, you can even become pure 24 karat gold! There's plenty of things to do here in Toaster World.\n\nOf course, everything isn't just sunshine, rainbows, lollipops and those things. Hidden deep underground, you will find The Lab. Lost to time, this lab has some important artifacts, and a dangerous creature roaming.\n\nPlay Toaster World now! Or don't, it's up to you.\n(psst, this game has literally no in-app-purchases, like at all, and all the accessories are really cheap, so don't worry about running out of Toast Coins to spend.) Have fun!", "short_description": "Toaster World is a fun multiplayer social game involving Toasters with floating bread for hands. You use your hands to walk around, similar to Gorilla Tag, and you can search for hidden collectible items around each of the maps."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/toaster-world/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PoizonStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/toaster-world/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24563556389932361"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1189735046326726"}]}, "baseline_offer": {"id": "1189735046326726"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1758218400, "status": "PUBLISHE
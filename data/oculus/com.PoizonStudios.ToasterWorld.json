2_8169358070159793179_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mZQ5u4m0tcQ7kNvwFtH3pv&_nc_oc=Adr63pa41CMHT7u7ScDmwKMeF3Q-HZrSgiJ3EGY8hBPLqyDBPnUECNXLDMqTopAcqdA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2nKon7t-8guHlitw7wIISitm05f39-zzOwS6c0Xdeug&oe=6AEF3A88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta banner.png", "id": "1093813470093222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622153_1093813476759888_6247482990125952762_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtYQ80H4kmYQ7kNvwHiqbwf&_nc_oc=Adox54bbFyn1ZxijmKMOKTJsDnnuiMy4bowl8ZF_RgaytA4qhTPVx7Wd6XR43NWhEkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQczUVOZbwR1dq88ZSrr9uP7uub0nc-X22i8Ywg6QHPOQ&oe=6AEF37C1"}, "display_name": "Toaster World", "keywords": ["free", "toaster", "multiplayer", "fun", "bread"], "long_description": "Welcome to Toaster World!\nImagine Earth in the year 2045 if some idiot decided to build SmartToasters with viruses in them. That's basically what happened here. All humans are gone, and all that's left are Toasters.\n\n\"TOASTER GAME OF THE YEAR 2045\" - FICTIONAL TOASTER VIDEO GAME MAGAZINE\n- Explore the various maps with your friends and hang out in Multiplayer, or mess around in the Sandbox mode!\n\nLOTS OF CUSTOMIZATION\n- Customize your toaster by wearing cosmetics, changing the screen color, and changing your Bread skins!\n\nPLAY MINIGAMES\n- Play fun minigames in the Arcade with your toaster friends, or grind on your own!", "short_description": "Toaster World is a fun multiplayer social game involving Toasters with floating bread for hands. You use your hands to walk around, similar to Gorilla Tag, and you can play with your friends in regular multiplayer or in sandbox mode, where you can spawn props."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/toaster-world/privacy-policy", "developer_terms_of_service_url": null, "publi
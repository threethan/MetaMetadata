IW0f1Zpul6gHI09iXzmW5gqtAAlhj2IiIo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtpebgxgPq2BATuMo6w096Pz5-XGAaNBCOY7O0WVj_-w&oe=6B05B60F"}, {"file_name": "Toaster World_Custom..._01.11.2026_12-12-53.png", "id": "1507953251355039", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624577_1507953254688372_8169358070159793179_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAP1KczIYBMQ7kNvwHjwIuL&_nc_oc=Ado8aZB_1dg98kn6WvWHv8amRTQY21SVjLOBC63Xx5S_dgrWh-QV3h9lT4H6fqmEsJU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzG86gViClO_3ynkNPxyMK0EQRZmvpO6zAANPLoyAqQA&oe=6B05A408"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta banner.png", "id": "1093813470093222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622153_1093813476759888_6247482990125952762_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiRULE9VnvIQ7kNvwE3aUKv&_nc_oc=AdpC9OwFG-ogG5YhMfx7Q21WedhLAGLDzCerO84UamiAwtZWewSBYlulmMNbySP2au0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFXreVqkLPNzJga6FzbFUeYfdpVFzjv_EjyOWYRG5RRQ&oe=6B05A141"}, "display_name": "Toaster World", "keywords": ["free", "toaster", "multiplayer", "fun", "bread"], "long_description": "Welcome to Toaster World!\nImagine Earth in the year 2045 if some idiot decided to build SmartToasters with viruses in them. That's basically what happened here. All humans are gone, and all that's left are Toasters.\n\n\"TOASTER GAME OF THE YEAR 2045\" - FICTIONAL TOASTER VIDEO GAME MAGAZINE\n- Explore the various maps with your friends and hang out in Multiplayer, or mess around in the Sandbox mode!\n\nLOTS OF CUSTOMIZATION\n- Customize your toaster by wearing cosmetics, changing the screen color, and changing your Bread skins!\n\nPLAY MINIGAMES\n- Play fun minigames in the Arcade with your toaster friends, or grind on your own!", "short_description": "Toaster World is a fun multiplayer social game involving Toasters with floating bread for hands. You use your hands to walk around, similar to Gorilla Tag, and you can play with your friends in regular multiplayer or in sandbox mode, where you can spawn props."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/toaster-world/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PoizonStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/toaster-world/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "29012854451669177"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622195_1520419309854186_8914310416547158986_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnaSHPASLXUQ7kNvwHQE4LK&_nc_oc=Adqk8mxXlhlLgHzDyndESIdo3mX7Wgx7ufcE29ahMM30qHsGtLigeFFuS8-cQeUFJb4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPHe-u6C_GRdfpmoeUTJrKtB6BOzsQWxxq03qQO60U0A&oe=6B05A4E8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Toaster World", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [
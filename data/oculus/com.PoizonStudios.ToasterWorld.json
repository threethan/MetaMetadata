n-rDJWSkPDkZD4S5OFWdyylBJ5OrnvdpkA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr1xkpKgiKHYrlNIw7RTKa9eRTpj6emW3bfBaRGCvR6w&oe=6B04648F"}, {"file_name": "Toaster World_Custom..._01.11.2026_12-12-53.png", "id": "1507953251355039", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624577_1507953254688372_8169358070159793179_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAP1KczIYBMQ7kNvwHpOEsC&_nc_oc=Adq3brIPXxUuCNASkX2goPR5sbK_Dvun7ZVuyou3wA1wcH6R_Jv-4_1fxMwNfHXxQ5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT6DEaSyeBsdwJjueo3eXbxvQvDp-EBeO9eX_lbpp6lA&oe=6B048AC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta banner.png", "id": "1093813470093222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622153_1093813476759888_6247482990125952762_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiRULE9VnvIQ7kNvwGr3kvf&_nc_oc=Adojqrn2ncHwKJ3sulUk5gQv5V8sJFwdPaSJ9VwXYOLPcGujzBG83RkCIgMQlbYUiY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpalDcgOZFb94bBf7Ta_cEQ9Mtp17-YQVUIPCdLQsJtw&oe=6B048801"}, "display_name": "Toaster World", "keywords": ["free", "toaster", "multiplayer", "fun", "bread"], "long_description": "Welcome to Toaster World!\nImagine Earth in the year 2045 if some idiot decided to build SmartToasters with viruses in them. That's basically what happened here. All humans are gone, and all that's left are Toasters.\n\n\"TOASTER GAME OF THE YEAR 2045\" - FICTIONAL TOASTER VIDEO GAME MAGAZINE\n- Explore the various maps with your friends and hang out in Multiplayer, or mess around in the Sandbox mode!\n\nLOTS OF CUSTOMIZATION\n- Customize your toaster by wearing cosmetics, changing the screen color, and changing your Bread skins!\n\nPLAY MINIGAMES\n- Play fun minigames in the Arcade with your toaster friends, or grind on your own!", "short_description": "Toaster World is a fun multiplayer social game involving Toasters with floating bread for hands. You use your hands to walk around, similar to Gorilla Tag, and you can play with your friends in regular multiplayer or in sandbox mode, where you can spawn props."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/toaster-world/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PoizonStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/toaster-world/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "29012854451669177"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622195_1520419309854186_8914310416547158986_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnaSHPASLXUQ7kNvwHOdlDL&_nc_oc=AdrUOyL-L9CmLlDjd8rlisq7dCTB8YXx-AiP01_UacyqyTfLEHPTqxoR2J2Nd0J-BBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE-rx0vMdzg4s6kJQvpbVOLeq2RItRGko_Rb0oinx89Q&oe=6B045368"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Toaster World", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [
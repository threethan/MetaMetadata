3A3RjHj0q7sl73-E9-7DgLifg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YPVxcaAbBsIOk6mG67a4Z_Gz89zOmvh-sieqWU5QjIA&oe=6A3AA766"}, {"file_name": "Main World_Custom..._30.08.2025_19-42-48.png", "id": "4235676753344378", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302483_4235676756677711_2966724972383170337_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVgWU6h8XN0Q7kNvwGXCtZ8&_nc_oc=Ado6h1JnCVHabgxAgoaXmLbPogrVrDfkyIyhd-B3H1q7xBnWuNSDqusFK96XLtzMnzY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JT0wo0hwydhXDPAODcpr7uKpURngcU4CDciwkNCac3w&oe=6A3A9622"}, {"file_name": "Main World_Custom..._30.08.2025_19-43-35.png", "id": "1911919609601681", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304131_1911919612935014_1653522309514593606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GcJjOL9UBgQ7kNvwEsp6xA&_nc_oc=AdpxKxmMP7I0OaIhV_MxTtQ9w0uGLTHlHVstvdFCJ8g5GNo7SEh222nihhhF-klsTaA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eV1Ay8kV--WsHsRe5etpY3X8WM5VWngmpHR3A9Y11Zg&oe=6A3AA7B3"}, {"file_name": "Main World_Custom..._30.08.2025_19-43-00.png", "id": "1126820732709530", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308131_1126820736042863_9196489109898823936_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSeH4D7CcYkQ7kNvwFHwRl3&_nc_oc=Adr_Qfuy2u6Sejx8cPqkcbpznBm5bt7oFVMklCTXKSgcFP0F_kFdP8SsqsT5-iG2_Vc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KdoTxqSGJU2NbDUSRldJNW54-V8idYyAkphliWu1UQQ&oe=6A3AB9A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Toaster World", "keywords": ["toaster", "fun", "free", "bread", "gorilla"], "long_description": "Welcome to Toaster World, the best place to hang out with your buddies as a Toaster, and as a Toaster only! Run around in the various areas/maps, and search for hidden collectible accessories in each map. Customize your toaster's screen color, the hats it's wearing, and heck, you can even become pure 24 karat gold! There's plenty of things to do here in Toaster World.\n\nOf course, everything isn't just sunshine, rainbows, lollipops and those things. Hidden deep underground, you will find The Lab. Lost to time, this lab has some important artifacts, and a dangerous creature roaming.\n\nPlay Toaster World now! Or don't, it's up to you.\n(psst, this game has literally no in-app-purchases, like at all, and all the accessories are really cheap, so don't worry about running out of Toast Coins to spend.) Have fun!", "short_description": "Toaster World is a fun multiplayer social game involving Toasters with floating bread for hands. You use your hands to walk around, similar to Gorilla Tag, and you can search for hidden collectible items around each of the maps."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/toaster-world/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PoizonStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/toaster-world/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24563556389932361"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1189735046326726"}]}, "baseline_offer"
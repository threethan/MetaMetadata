2_8169358070159793179_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lM_vaTdokk0Q7kNvwHeZW_t&_nc_oc=AdrsQ44HYojSUgQCyoVfvLHYdXroy8qOIgskOeo5MRu66xxATXjX6H_GVH_ZQKGhK_U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGHUIUF1fgNUXS4SuZXP41nCqjX-pWst19cVYOcMG-xw&oe=6AF32F08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta banner.png", "id": "1093813470093222", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622153_1093813476759888_6247482990125952762_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTH1zH-YPskQ7kNvwGydIlk&_nc_oc=AdrwrQiC-g7og_A2MyBbDwkIbvVeNbKKJGjCXd5ZeP1JCCaf6obT20BbASgBG6EBg9k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZfZxalx1bKek-dB8g_xjnhsiAkRdIqPzNw7LIIFKvNw&oe=6AF32C41"}, "display_name": "Toaster World", "keywords": ["free", "toaster", "multiplayer", "fun", "bread"], "long_description": "Welcome to Toaster World!\nImagine Earth in the year 2045 if some idiot decided to build SmartToasters with viruses in them. That's basically what happened here. All humans are gone, and all that's left are Toasters.\n\n\"TOASTER GAME OF THE YEAR 2045\" - FICTIONAL TOASTER VIDEO GAME MAGAZINE\n- Explore the various maps with your friends and hang out in Multiplayer, or mess around in the Sandbox mode!\n\nLOTS OF CUSTOMIZATION\n- Customize your toaster by wearing cosmetics, changing the screen color, and changing your Bread skins!\n\nPLAY MINIGAMES\n- Play fun minigames in the Arcade with your toaster friends, or grind on your own!", "short_description": "Toaster World is a fun multiplayer social game involving Toasters with floating bread for hands. You use your hands to walk around, similar to Gorilla Tag, and you can play with your friends in regular multiplayer or in sandbox mode, where you can spawn props."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/toaster-world/privacy-policy", "developer_terms_of_service_url": null, "publi
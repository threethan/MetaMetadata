-2.oculuscdn.com/v/t64.5771-25/499619145_875568938799049_8959346278266992049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSLDzFWxvRMQ7kNvwEJijBC&_nc_oc=AdmBWrQCIJLhpw6dgxfpjmlSAsBB0w_pR5rufb_NX3ywGN97czjSpO6gpuveTx3HKLA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu5vx28QUQy41TqjMxdLDtv5xN-xjvMPq-l6DRJer7XZg&oe=69A96B40"}, {"file_name": "Toaster World_Custom..._17.01.2026_15-53-37.png", "id": "875484778687917", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507826282_875484782021250_8644933135626668543_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wfi9WZqi99MQ7kNvwF1orrj&_nc_oc=AdnhLkVYhrDAmXddhSfTF7EHUMIpRgmoIgaxsjIX9dcaVIZliz249xHVrW0iGBFZ5p8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftYw7VLDXyoUgpKvkNkuUwc8DkVTF1YDmso9tCVpzZZOw&oe=69A970D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Toaster World", "keywords": ["free", "toaster", "multiplayer", "fun", "bread"], "long_description": "Welcome to Toaster World!\nImagine Earth in the year 2045 if some idiot decided to build SmartToasters with viruses in them. That's basically what happened here. All humans are gone, and all that's left are Toasters.\n\nFRESHLY REMADE\n- Toaster World has been remade from the ground up, and it's better than ever! Way more detail, less bugs, and it's overall just better!\n\n\"TOASTER GAME OF THE YEAR 2045\" - FICTIONAL TOASTER VIDEO GAME MAGAZINE\n- Explore the various maps with your friends and hang out in Multiplayer, or mess with the maps in Sandbox mode with your friends!\n\nLOTS OF CUSTOMIZATION\n- Customize your toaster by wearing hats, changing the screen color, and changing your Bread skins!\n", "short_description": "Toaster World is a fun multiplayer social game involving Toasters with floating bread for hands. You use your hands to walk around, similar to Gorilla Tag, and you can play with your friends in regular multiplayer or in sandbox mode, where you can spawn props."}]}, "developer
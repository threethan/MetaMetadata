cdn.com/v/t64.5771-25/593790560_1402649254668856_3337685320580543916_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scDKMvNYRIQQ7kNvwFiXPHD&_nc_oc=Adoen2kv_VE-uug00EUdWfgk3VoBKUXVAZNJSvlOwPst-Cdy28On9IoAwo2DWhIWbkY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0DRkH53nvXSAyN2QZBykLoyc3m6BA61jytcSHaJI4ZA&oe=6AE9F2E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "horizontal new.png", "id": "1085186760759235", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595119480_1085186764092568_5519976747943301163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvEvTZM55ywQ7kNvwGTcvT2&_nc_oc=Adp1cNSxCN7WvfE2yfAwKUDLIRD3v8wEltVckAoqPahClTNY_nY3HFAydXDcle5lg84&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlxx0bFYPEQgaRBPFAJg49qc8hLu3_tK-XCDFDfWnk-g&oe=6AE9E20F"}, "display_name": "Toaster World", "keywords": ["free", "toaster", "multiplayer", "fun", "bread"], "long_description": "Welcome to Toaster World!\nImagine Earth in the year 2045 if some idiot decided to build SmartToasters with viruses in them. That's basically what happened here. All humans are gone, and all that's left are Toasters.\n\n\"TOASTER GAME OF THE YEAR 2045\" - FICTIONAL TOASTER VIDEO GAME MAGAZINE\n- Explore the various maps with your friends and hang out in Multiplayer, or mess around in the Sandbox mode!\n\nLOTS OF CUSTOMIZATION\n- Customize your toaster by wearing cosmetics, changing the screen color, and changing your Bread skins!\n\nPLAY MINIGAMES\n- Play fun minigames in the Arcade with your toaster friends, or grind on your own!", "short_description": "Toaster World is a fun multiplayer social game involving Toasters with floating bread for hands. You use your hands to walk around, similar to Gorilla Tag, and you can play with your friends in regular multiplayer or in sandbox mode, where you can spawn props."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/toaster-world/privacy-polic
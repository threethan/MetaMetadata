916696586667524699_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w48QHtppy58Q7kNvwETvKBN&_nc_oc=AdqoVkJbRyRXH2_7PcC2oSc7eXkCJ4-uzbOfbsTz6NuE0a0sTG0xHb4TE7NFzcBtuxQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX1fGh7T4yvtV0MnLXGkTlj-OeXyjBWNNi2IWPz_KigUg&oe=6B103738"}, {"file_name": "7_screenshot_5.png", "id": "1131520309640479", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825563_1131520312973812_8303288654926871131_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wo1SsLAFLUQ7kNvwHLFjju&_nc_oc=Adosrs6EDK-zrTXTHgE2ZYPBkcMN7ovCUvMSfdB5dIAUQA-rzGbijsiqH1S_oCrP7t8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUQLgt5Y4aTQgd-igNmxKFbwO2FEnsBTlYw_gjtd4RxEg&oe=6B105921"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Darts Carnival", "keywords": ["darts", "carnival", "dartboard", "knives", "slingshot"], "long_description": "Darts Carnival turns a wall of your room into a dartboard and a circus stage.\n\nTake a dart between your fingers, aim, and throw the way you would at the pub. There are no controllers: your own hands do everything.\n\nPLAY DARTS\n\u2022 501, 301, Cricket, Around the Clock, Count Up, Bowling and free play\n\u2022 On your own, two players taking turns, or against DartBot at six levels, from Rookie to Champion\n\u2022 Eight boards, among them Quadro, Yorkshire, Manchester and a spinning World Globe that names the country your dart lands in\n\nSTEP INTO THE CARNIVAL\n\u2022 Knives: land them around the star of the show, pop the balloons, hit the apple\n\u2022 Slingshot: knock down paper cups stacked ten ways, up to a tower that reaches your ceiling\n\u2022 Challenges: shoot off a drum, guard the gold cup, catch the ball in your glove\n\u2022 Send a picture from your phone in seconds and put it at the centre of the act\n\nYOUR ROOM, YOUR WAY\n\u2022 The board hangs on your real wall at regulation height, and stays where you put it\n\u2022 Change the mood: a night sky, a blue sky, a storm, or the deck of a ship\n\u2022 The game fits itself to your throw; aim help is there if you ask for it\n\nKEEP COMING BACK\n\u2022 Levels to climb, new dart designs to unlock, and a shelf of eight trophies on your wall\n\u2022 Your throws on a card: where they land, how close to the bull, trebles, doubles and bulls\n\nNo account, no ads, no tracking.\n\nMade for Meta Quest 3 and Meta Quest 3S. Play seated or standing. You need a free wall and a clear space in front of it.", "short_description": "Hang a dartboard on your own wall and throw with your bare hands. Classic darts, a knife-throwing act and a slingshot, in mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hearth-software.com/dartscarnival-privacy.html", "developer_terms_of_service_url": "https://hearth-software.com/dartscarnival-terms.html", "publisher_name": "Hearth Software", "support_website_url": null, "website_url": "https://hearth-software.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3179025318955027"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1134250135985328"}]}, "baseline_offer": {"id": "1134250135985328"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794948300, "status": "PUBLISHED", "id": "1134250135985328"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3194708474053378", "version": "0.1.6"}, "id": "2903401746697274", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3179025315621694", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3194708474053378"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2903401746697274"}]}, "change_log": "What's new in 0.1.6\r\n- Walk anywhere in your room: the headset's boundary is hidden while you play.\r\n- Slingshot: step-by-step help the first time you use it.\r\n- Knives stay in your hand while you wind up for the throw.\r\n- The slingshot stays where you put it, and the menu pointer keeps out of your shots.\r\n- Smoother picture: the game keeps the display at 90 Hz.", "created_date": 1795521413, "id": "3194708474053378", "version": "0.1.6", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3179025315621694", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3194708474053378"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2903401746697274"}]}, "change_log": "First release of Darts Carnival.", "created_date": 1794650347, "id": "3179526588904900", "version": "0.1.5", "version_code": 6, "release_status": "RELEASED", "status": "APPROV
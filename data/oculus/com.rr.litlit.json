dn.com/v/t64.5771-25/491823783_983575294048700_1360211198504522699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnXitBwR5ucQ7kNvwEqmrEO&_nc_oc=Adq2x2LDKOdAvGDtSnONaESYigeB--rziEUaELe8gFWRWxrRyPROmUQ5XKJTi8ejqbg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtspn-zw9yLnEvYYCmHE4DBCmI0m9WhYPg4VyLyL_TJQ&oe=6A733F9B"}, {"file_name": "screen5.png", "id": "839815949168646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828104_839815955835312_4472094254721889311_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJFZs5pw9ckQ7kNvwHx4hsE&_nc_oc=AdpWNrUEE7T-WNafOv-u1NpW-ebJEAjTNvHiuXjWQjSpcHqbffzDjaXTkhTm-OLqg98&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEocV_XlphVr2ciClx--oIL8fWGNu0b1xjL7pI-m9JboA&oe=6A73446C"}, {"file_name": "screen3.png", "id": "1276022481181750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820441_1276022484515083_3284351133318982600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5P-ksfDh2ZIQ7kNvwG8Zb-o&_nc_oc=AdqIEvF0RZN4y-3Sp0YJoiidLvFBBv5f87ERial04bAeOiPySuRlDBNHzU_7cLd8vgk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7AnJ_yBKhY9bxJqrLLAR6iJBUyhXMT_9Fc_Fqk59rvw&oe=6A733C4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "x2560x.png", "id": "945384471653650", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622315_945384474986983_5719452863441027224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IY9HN9YtsBcQ7kNvwF1dJmW&_nc_oc=AdpDJrIYwcCWNTSG15KlnQQf-Cq_uqIzF5q6fLISC0s87Pwfc3JH_gvBOvNZPSM1-BI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqslUICsmFYdJp6PfoCwIup7JMqIIdVPemKbjmnB1yWQ&oe=6A734EBB"}, "display_name": "2LIT", "keywords": [], "long_description": "2LIT is one of a kind open-world driving, riding, diving, flying and street-culture game set in Widewater, a chaotic coastal city where horsepower, music, fame and bad decisions all collide. You arrive by cruise ship and get thrown into a city full of custom cars, illegal races, underground parties, beach chaos, shady businessmen, loud personalities and crews fighting for reputation.\n\nWidewater is not just a racing map \u2014 it is a living playground. Cruise through neon docks, hotel districts, industrial yards, beaches, malls, marinas and backstreets; take part in street races, stunt challenges, side missions, car meets and strange city events. One moment you are chasing a stolen Kreuzer through the city, the next you are hanging at the Amp Yard watching bands or diving near dangerous waters, flying over the skyline, or getting pulled into the schemes of Mayor Barnes and the city\u2019s wildest residents.\n\nThe tone of 2LIT is funny, gritty, stylish and explosive: part car culture fantasy, part urban adventure, part satire. Every character has attitude, every vehicle has personality, and every district has its own flavor. Build your style, conquer races, unlock vehicles, meet crews, explore secrets and become a legend in Widewater \u2014 a city where the streets are loud, the nights are bright, and everything is always just a little too lit.", "short_description": "Welcome to Widewater! 2LIT is an open-world action driving experience set in the sun-soaked, neon-charged city of Widewater. Cruise the streets, hit the water, take to the skies, and step into a world of speed, style, chaos, and freedom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.refinereality.com/2lit_privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Refine Reality Ltd.", "support_website_url": null, "website_url": "https://www.refinereality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ad
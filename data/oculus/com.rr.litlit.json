946635", "locale": "en_US", "screenshots": [{"file_name": "screen2.png", "id": "3756657374476917", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_3756657397810248_438968653307530120_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3tpev9nqpAQ7kNvwEKh5pk&_nc_oc=AdriPHJ8cKwKqSbwpmRll2vccb3OYYe1URSCPegE3vQ8eZrknbCx5hYDwsoZJqjXsaU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFedBTHphqHac_-_f4qXce0IhnFEMBB6_q0Q00enRl1w&oe=6AB917FB"}, {"file_name": "screen1.png", "id": "3321597971343074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825415_3321597974676407_2267913278415930369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6NNc0KBjdAQ7kNvwFWNOZ_&_nc_oc=AdpN9Apes82BfitC3H1yOiJPRW9JCcx6j_KuvwprLKOICnRpAtZ8Jz16gHsVMLvTrgc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk3hYbIp-UsRzud3JW9yyvMb-AW0VybbCNnSKnBl-gxA&oe=6AB91943"}, {"file_name": "screen4.png", "id": "983575290715367", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_983575294048700_1360211198504522699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oz8JVitpLucQ7kNvwExW8Pw&_nc_oc=Adoqz02p1R3Nw8fm-MmdhcfI5mH0cpLQmg6Q3pFRjt4gMgKuTrU3rzxsMGPrIcNbiJM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInwQeR_M7MiAWW1sFmLccsBTjvdrzMyxACknHzgzkj2g&oe=6AB91F1B"}, {"file_name": "screen5.png", "id": "839815949168646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828104_839815955835312_4472094254721889311_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cq8UiMxdhIsQ7kNvwGoCRfg&_nc_oc=AdpW4ZCwcC551uVx1Q6RYWyRJtOsb9MtwlGIZEowRWKbOFuJEatksNplpzBevN7ERPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvbO6vrPqBXKxnt6bJBmUQI-isAPbeVcOrN6ujjziX-A&oe=6AB923EC"}, {"file_name": "screen3.png", "id": "1276022481181750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820441_1276022484515083_3284351133318982600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkSFZpYk_4kQ7kNvwGIkFwp&_nc_oc=AdolW-gNldZ5CQahfypV_euy93hnEqRGCe0yqFof_SZfjSkTXe0hh75WtcV1Wj_euko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnKucC6pd8mFE9VYT0hTtbV7bKoP043aX9bj9ajl_rEA&oe=6AB91BCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "x2560x.png", "id": "945384471653650", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622315_945384474986983_5719452863441027224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_2b--lK34QQ7kNvwEDso_e&_nc_oc=AdqetqkM_IZIS-58iIRGWxU1igWWVlPP7F7DBLNQPy9VqoofJapyd99mog4BpLYRltA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmOuBc5COTTZv9jC9PmNJqjLElK_f0rSPaxtymhEg-PQ&oe=6AB92E3B"}, "display_name": "2LIT", "keywords": [], "long_description": "2LIT is one of a kind open-world driving, riding, diving, flying and street-culture game set in Widewater, a chaotic coastal city where horsepower, music, fame and bad decisions all collide. You arrive by cruise ship and get thrown into a city full of custom cars, illegal races, underground parties, beach chaos, shady businessmen, loud personalities and crews fighting for reputation.\n\nWidewater is not just a racing map \u2014 it is a living playground. Cruise through neon docks, hotel districts, industrial yards, beaches, malls, marinas and backstreets; take part in street races, stunt challenges, side missions, car meets and strange city events. One moment you are chasing a stolen Kreuzer through the city, the next you are hanging at the Amp Yard watching bands or diving near dangerous waters, flying over the skyline, or getting pulled into the schemes of Mayor Barnes and the city\u2019s wildest residents.\n\nThe tone of 2LIT is funny, gritty, stylish and explosive: part car culture fantasy, part urban adventure, part satire. Every character has attitude, every vehicle has personality, and every district has its own flavor. Build your style, conquer races, unlock vehicles, meet crews, explore secrets and become a legend in Widewater \u2014 a city where the streets are loud, the nights are bright, and everything is always just a little too lit.", "short_description": "Welcome to Widewater! 2LIT is an open-world action driving experience set in the sun-soaked, neon-charged city of Widewater. Cruise the streets, hit the water, take to the skies, and step into a world of speed, style, chaos, and freedom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.refinereality.com/2lit_privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Refine Reality Ltd.", "support_website_url": null, "website_url": "https://www.refinereality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24272826618996070"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1284376587151490"}]}, "baseline_offer": {"id": "1284376587151490"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779778800, "status": "PUBLISHED", "id": "1284376587151490"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28804792599132760", "version": "1.0.7"}, "id": "738916772004071", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "And
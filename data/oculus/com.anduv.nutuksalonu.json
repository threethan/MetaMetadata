y9Rdi&_nc_oc=Adr1VZ7yjKnahlZpmclRNXUHoKxbGpyQS3jQ3GvMIyRRB3fzrd3KOjJvEFUXkcl6k44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUI-2dmnHKX1tolG3L5XwrWo_U0BDctp_9d7ibzy725EQ&oe=6B104C6B"}, {"file_name": "ekran-1-kursu.png", "id": "1470949048316551", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_1470949051649884_6806826258171000962_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iUuQVhJ_c4Q7kNvwFlVwb0&_nc_oc=AdrH_QLNZ3EKkfUq_4sJ3FXxoQlk9L5_SYXAySKY91GBslKDNnP2yP0g0I9ADwhC690&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVQJi4WvzmuRygJDUnm8AG-8FQMPL6RH0hhmQvjTcQPWw&oe=6B10560D"}, {"file_name": "ekran-2-harita.png", "id": "1080727764967192", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825575_1080727768300525_4165269507240939875_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yow5_9j_hcQQ7kNvwGkR_xB&_nc_oc=AdpKiHwLTBdRc84-5oQ0s7938zl9QB7b3KN5vnWOMS6Lc-ebp5tvo-hkqa8fJHmghrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQULNv6W4hooiZ9juODwXnc35h8HUFOiylPikCCyBDHETw&oe=6B105F51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nutuk Salonu", "keywords": ["Atat\u00fcrk", "history", "education", "Turkey", "museum"], "long_description": "October 1927, Ankara. Take a seat in the parliament hall as afternoon light streams through the tall windows. The rostrum is empty; above it, the lines of Nutuk, Atat\u00fcrk's great speech, appear one by one, each with its meaning in today's Turkish.\n\n- 18 chapters, from the landing at Samsun to the Address to the Youth.\n- The Road to Independence: a relief map of Anatolia on a tactics board with 12 stops, from Istanbul to Izmir. Point at a pin to open that chapter on the rostrum.\n- Timeline and \"Did you know?\" boards on the walls of the hall.\n- Read at your own pace or let the lines advance on their own.\n- Touch controllers or hand tracking. Teleport by pointing at the floor; snap turn with the thumbstick. Comfortable seated or standing.\n- Works offline. No ads, no accounts, no data collection.\n\nThe app's text is in Turkish. Atat\u00fcrk's works are in the public domain; the original lines were checked against the full text of Nutuk on Wikisource.", "short_description": "Sit in the 1927 Turkish Parliament hall: the original lines of Atat\u00fcrk's Nutuk appear above the empty rostrum with their meaning in today's Turkish beneath, while a relief map of the road to independence waits on the table in front of you."}]}, "developer_name": "Mr. Anduv!", "developer_privacy_policy_url": "https://emreanduv.github.io/nutuk-salonu/gizlilik.html?v=2", "developer_terms_of_service_url": null, "publisher_name": "Mr. Anduv!", "support_website_url": "https://github.com/emreanduv/nutuk-akisi/issues", "website_url": "https://emreanduv.github.io/nutuk-salonu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["tr"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1491164244074179"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823930_1525332149403477_8473029627786610108_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60sMQtA0NokQ7kNvwF3hIIv&_nc_oc=Ado-r_hDpo7V2kHY-htN7hcEG3MDfZEJX4LTN_rFgfKd6JagQR9fOYR7Zvv2LsABHPc&_nc_zt=3&_nc_ht
23757_1470949051649884_6806826258171000962_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXXS60OALykQ7kNvwHfDvoO&_nc_oc=AdqcWNGG9mMlrdWerFKhBBV0MTregwbAnHfAH7Ga7KX5tCbgcudOb168ad5Ud1us-MU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdHP2fRi4ElhMTeHKp6eyrqNGhXyPIF5qyTjaorLNr6A&oe=6AF5BFCD"}, {"file_name": "ekran-2-harita.png", "id": "1080727764967192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825575_1080727768300525_4165269507240939875_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjShSKMZ-TgQ7kNvwGFsp-z&_nc_oc=Adr_DYan1-MgUeuFSWD12GE4Cl2k7CKCInbN1hVTl9t5YFT6O_kSWfbyzIV_gGZU1tA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUmg3GPNEay9qy1ovEZbqRDFjRMJCd_oLDNZosrD6atQ&oe=6AF5C911"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nutuk Salonu", "keywords": ["Atat\u00fcrk", "history", "education", "Turkey", "museum"], "long_description": "October 1927, Ankara. Take a seat in the parliament hall as afternoon light streams through the tall windows. The rostrum is empty; above it, the lines of Nutuk, Atat\u00fcrk's great speech, appear one by one, each with its meaning in today's Turkish.\n\n- 18 chapters, from the landing at Samsun to the Address to the Youth.\n- The Road to Independence: a relief map of Anatolia on a tactics board with 12 stops, from Istanbul to Izmir. Point at a pin to open that chapter on the rostrum.\n- Timeline and \"Did you know?\" boards on the walls of the hall.\n- Read at your own pace or let the lines advance on their own.\n- Touch controllers or hand tracking. Teleport by pointing at the floor; snap turn with the thumbstick. Comfortable seated or standing.\n- Works offline. No ads, no accounts, no data collection.\n\nThe app's text is in Turkish. Atat\u00fcrk's works are in the public domain; the original lines were checked against the full text of Nutuk on Wikisource.", "short_description": "Sit in the 1927 Turkish Parliament hall: the original lines of Atat\u00fcrk's Nutuk appear above the empty rostrum with their meaning in today's Turkish beneath, while a relief map of the road to independence waits on the table in front of you."}]}, "developer_name": "Mr. Anduv!", "developer_privacy_policy_url": "https://emreanduv.github.io/nutuk-salonu/gizlilik.html?v=2", "developer_terms_of_service_url": null, "publisher_name": "Mr. Anduv!", "support_website_url": "https://github.com/emreanduv/nutuk-akisi/issues", "website_url": "https://emreanduv.github.io/nutuk-salonu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["tr"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1491164244074179"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_1525332149403477_8473029627786610108_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLMYylEwvA0Q7kNvwGYf2WT&_nc_oc=AdpNw8AAJrCgyvY-yBWwj8waXcSTp1Tr3d82OXKCeS92khui9LynR-2nV9wYs72Y8ys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSY58ymuslGaNRMW6SIyldixut3XV14xLIfMVI6GBgFA&oe=6AF5E3C1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nutuk Salonu", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Trave
-9MuwityX8LpD-5M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_Ugf1dz2nuTBuOwz0232TKZd-H-lX7HnFBA4uESkkyQ&oe=6A997868"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsDuGJksC2oQ7kNvwFo6WOl&_nc_oc=AdqEraRyxvIh5ZHA6A24GZS_z6s_P3KyRTeVTk5wGKSdyLT1b3nCK5wdKrBCjvydWAs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFmt-b_Ne3Dfguaw0Ik5wREJ0PkQhrHjy-9LeNNpzdkA&oe=6A999C62"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_i_bgdDx4zoQ7kNvwGMq6S2&_nc_oc=AdobdIJwMwJ7IYA6Yg_MaodgyrKyHUNXuSVaRTKGLbnNcU2FM9d_CN4aC7TeHLIs0-o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMxTzK1IYNk02osF2UtRAWy9e6ERj9DRuJ2EEPOoo1Mg&oe=6A9998BA"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHsk04XgH24Q7kNvwEmm2W-&_nc_oc=AdoM8XD_Mv5--5WpwATeFZuRMjwkKvjaBxyA4_yYjgZCg4vxjBmVz9sLNDD0nBnmp1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuE1Gq6FZiH7F2Ehri-Kjb1-OdrtjV6zNOQADrBMDFGg&oe=6A99702C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oe8QrfNIdgQ7kNvwHZQhvt&_nc_oc=AdreRyKIMreoFg3tT-urrUqcaX4wkKLyquSs_8If1JAqAZrUC-owKjQV8S32S7WJoGc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk4NrqELqs30XRPDuaaysOSZufRRidHddohpXxJQ068A&oe=6A997D5D"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-EA6U7-nSIQ7kNvwHRIzvg&_nc_oc=AdrqE2YZ6hjgQigPkWtff_xCwmvnxRO3UNUwLcZRqO9w8Wq-oGp9UsDS82Yt0F_4agQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhj1MIQe6RzehhGW1XnVpg6z_dztGq18CZ0O0Ffj7vMg&oe=6A9990E1"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
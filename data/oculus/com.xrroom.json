4e4FpV6EvUpBBmCM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4CWJs0Fox7FgP2qtN5W2DdVynD06XVDZgw-lu6CmvGQ&oe=6A9EBE68"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emaCG5qyGkUQ7kNvwEDZeAQ&_nc_oc=AdraDysU6Cs_CocP4fAuNDNDSoS2gk0sbElcC3Al-W44ugTWraKTOqLucVn3JbhEWZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDLbPJj4H4zOESRMzWUW_2zRleUidfG_JXVSk5pZZGFQ&oe=6A9EAA22"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z31UOMJxFjYQ7kNvwGKGJ0w&_nc_oc=Adr2RB8tH2aFgxpJjMdErWe49NXR5dpnlHSdJShV82XulsRzQHfkiIpvBLp8fXmnjDM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9ZitCIyhu9LW7DHDt2GVZi1iQ5VeB5gJ01jn6REGIdQ&oe=6A9EDEBA"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68iAzHu46EEQ7kNvwGe84sP&_nc_oc=AdollFdkvgg8mP9v3ca5elacgByRQoYe09ufDMiMekFSaq0WZ38626wZchdcV_Bulj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3USFT__N-nprojpjd6YYbKfIapjvwbo_jyFqjdZEeLQ&oe=6A9EB62C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnOtywPsHhIQ7kNvwGitPP0&_nc_oc=AdpQNOmtWR7v52Whej_vW5uNIVmqPNlKx19bFQKKx0Ko-gCatDYg7PeDVszV3h6jTi8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ85Zq44OzZQBwWtzNdtZn49S0f5zdx4PMa0ARwmIFpiw&oe=6A9EC35D"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cx_2sthKSWIQ7kNvwF3twI3&_nc_oc=AdolEg6zgPjFjgicpe4zTDdQM3ckBu4Y98UDLi5ITJyzbfBVCbNHG_F621HTLd4qWlA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnhJ-PKxCaaKpQnK3O_mMk1BtGtKkqhjgGDllgIAH_vA&oe=6A9ED6E1"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
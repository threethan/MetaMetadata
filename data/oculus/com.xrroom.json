AqFB5-hq-vaKV_xE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LQ_qowimznEC2ZYfU8Alc5yqYAThPZzIbXBF3cpYDig&oe=6A47BB68"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlMSU6KlIIIQ7kNvwHAJz9E&_nc_oc=Adrv5Zv7O70u7PCD_U94Cz9VvLwAMnSfoqf3eudMAJwIYhtbkQVZxM_VmhCdcnkRD_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Dt9ElcSwqcXdQlZJqcR5cKhjdDVrvT1J1eyqVqh6tqw&oe=6A47DF62"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EWNFzlfaN0Q7kNvwFmZASN&_nc_oc=AdrAwTNDYPg6yZRfiGUK2LsxNSqp3QeOnkiLRtqTanAz4YAjojaLSXw0d1LA1gt-010&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vZBfiXIhyOCyo-KlQgnXMixjQz1nGIMVmvNIRXPl1Ig&oe=6A47DBBA"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqrUj6vqUC0Q7kNvwFy8q3x&_nc_oc=Adpz07DjLudHfKEy0pJBt9GyN-UD5if0PRgxi_vlMw9UF_IOb-29qRO8R9SzA4Qg-0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IRGAzJ2o39NbUOpu0X8Ve_p6qxzfxmkufOHZaFk4DLw&oe=6A47B32C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SB7bcMFELcQ7kNvwFEm6dc&_nc_oc=Adpl6VV5RyqCDzWcovGwJ72G2alqByMNd6gvPxvLZF1dDFczNm5fA1ELkNd6VDmES04&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pH9EaDcQ51Nnqm2Y_7yR--B2BEoQw1OZGz0VYrB9wWg&oe=6A47C05D"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPzWqgWGUkkQ7kNvwG0wVXl&_nc_oc=AdrXam9e0ySpobbuWPQHkaZuE6dnIDRxr58yKY77WtmdsCw4D0ReVOWyTMf7k88azwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tGes5eRZcs0CfpiVjnmPvyDTxlKVUVdAK14z7EfmNLA&oe=6A47D3E1"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
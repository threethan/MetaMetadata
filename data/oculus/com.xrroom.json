feYN4pNtzCEtB_zs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVcf4Y6eH6f00hLLnTcy5ADyLJnt5oZEZSPIU8R_eB1Q&oe=6AAFE1E8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hW4P8v9UzdkQ7kNvwEwMKJv&_nc_oc=AdpXUuoYPKZ0FAKHd1Uk4guq7e2kqcJAFYkGK0eUdmCrvuQ-VJSTzlyvtX8A_9UcPEw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPDBDG18wyqsNeiMTvHQsYG0Hy2tojyD83CkcqblaUmw&oe=6AB005E2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_n7uwsZ9k0Q7kNvwGKIddb&_nc_oc=AdqaNEjzRemhRcwwZCJWVqdnRg1T7KL0XYh6XbtZTXCksw0quaxMLWhMMkG7U_6p5qA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGro0-UDik3t-HsMJUSgNm-8CYAyaMumYqgEuJRxgbcw&oe=6AB0023A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wWfv-gKZIEQ7kNvwH8kmkW&_nc_oc=AdoAWESHWyZd9vdkVPZFzsMoBLr76-H1aK5a3f_Vqc6Kc1cYFUB8S_ICNz1CaX2O9KE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAtfkjL7CnRYtB0QXjvrubn4dCEWX9ofUvomX2RIUkCQ&oe=6AAFD9AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ix8B9Jht3kQ7kNvwFcIwqw&_nc_oc=AdqDnu-KmSjV1A8BxXjFVj-Q-4GyhXr5-aj4tMsu6ELcDzUq48w7CwlIwuuX8v0EOlM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiVJ1sm3DuJzhyc-4zKLmuV2j0dSEf04VFg0dZW1FPrA&oe=6AAFE6DD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1eSQxKuDooQ7kNvwEm6Erm&_nc_oc=AdqUQFaNFDug9MGw_HO_EGSBv2tUPVJ1q5TRRTpfgM97MxRa_5ndiDW_W_rhEWvk6zU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgQ5JqPK4SrSEUhdjr950ysSgmt7BHRMQcO_mundsVjQ&oe=6AAFFA61"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
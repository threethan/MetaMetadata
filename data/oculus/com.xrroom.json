h4It-IICtHyA4S9w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_q0GFZ0Iox25AyX-K7SplaWfv8mVVrXG5ObJA-SstXug&oe=6A3151E8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naIDwoeSQVYQ7kNvwFhE_P-&_nc_oc=Adrok13nToT_CPiFr3mZ2qprBXHucTusy0HR3lN6kUJC9kHCR8xD04PZEqaifPqVwio&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9d-fCcGC_9d6-eRbT71byZxD9NY_kc6_tKY_2z_Im_KQ&oe=6A3175E2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QFNYr3-i4kQ7kNvwFChGhe&_nc_oc=AdrxX-YIXGNYi0hYiUjxlKLslocGivPLp8DQkljqVFRHNTrJR7W36RThqjDir75Yriw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UsQN_WZrN3V5PSEMLuGHXHTts3T7Gc3M45xz8Lzy7kw&oe=6A31723A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIuM1-pRmDAQ7kNvwFbdc5M&_nc_oc=AdoFTH-vLyIGGDgF6S969iCkI_95fhSdQBHg8NhGJAGBCtVVVkVSn60NxfgN2SR99SU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Vkzoot2_zza-ZAHY_f7qiRhwQZO8zf2hvBktQIxfm_Q&oe=6A3149AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q660o6-sjTcQ7kNvwFyWAVr&_nc_oc=AdpYSzrRpNAO9oU0sADR7VOW0gGwLYB1rKn8Y8P_qKd5xzuG_ulk63yyyTciE7ntXvw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2gxA2mqtl9JKMjKKs25HqWS8nmSIUEQ4200GbGeyeyw&oe=6A3156DD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6aZEDxZ7UYQ7kNvwFdPBQt&_nc_oc=AdryenqbPGROYWdU_ceOE32m6WSK4Hh9J9SL7sAZ-kj5x7fEEcnpKHDVk_d29FWdqVU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FwwSfsJvakjJmiGacQEVaJAaJGnAPYewm8Ah_G6rFMw&oe=6A316A61"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
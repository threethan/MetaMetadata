T6d3FEWOVVEZo_Hg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3BjxOPFhYIoNksY01aOZ--klOqU_dt0J-8ndB33JEwDA&oe=69F4ACE8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1dTwrYdlgAQ7kNvwEd2zJK&_nc_oc=AdrmVLXKd55LfdgI2Gzjs_LZsX9ihTtQxu32vzpp9Huk5N31kMusbCkBEyJssVN7mlw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3rK0VmhmVr-7LDIm8PZ3zs-kxZrdJPPWoA8eXeCiMOTA&oe=69F498A2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SEJKsbmYUYQ7kNvwGjSRd3&_nc_oc=AdqQAINhoqWlA4hcfCBKMJjexd3Gs9EYLkpQEP6va8iSa708if4yIRAWKqWhnFQgR9A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1iDzoshRyp8CWXhfonflY4C06APccYZH45E-QLE6j-qg&oe=69F494FA"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnbtYL0CHoIQ7kNvwFCYLjX&_nc_oc=AdoUMqmHTm6vchMfGHe6c0O1TC8gHxMRXffq_zebd_ClFvJpFqiT1rOjauksVmAw7Io&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af318vnL6ON5XYMWZH0_9HFo2r2kaVi8J_kOLBAMEeLMrg&oe=69F4A4AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvoX29giTf4Q7kNvwE4lblU&_nc_oc=AdpfGnIbk2WmVb1Atmiiu9LWh63YmIdsBx87dTlHwRV9yUMiZdUEh0EKSQ0zodNRXoE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tp2LvI9_1OpBgPQECCYbSj5ILPRxAe5git5YbunI7CA&oe=69F4B1DD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWApEdaqT0MQ7kNvwFKNeeA&_nc_oc=AdrR_Km2mmQlS6uPjfY5X3uJatt5YDcvt6PdMQxAAC7QKMXr-wQj6jBBYkZdhEX8V90&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0LIHCXdCh9WG3IPe8QUKQapIyBJEkNNgXcnQATkvoQXw&oe=69F4C561"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
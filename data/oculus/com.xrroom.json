X7ZoUIAAGbXhqBTQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyxsLOM115NNvHSRg_ucpUBcc4DzcZm4RF_kLxxhl5GA&oe=6A5E24E8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j06Tfxnf3B8Q7kNvwFP8NNx&_nc_oc=AdoK7LW-isvMGQ0_aAwkyPWfcd45tGL-azLdXRtFgC43XZqb5-i_QMviMXiMRDYNyEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnmBa-OpCCxM_B1oKE4UV1W98O8I_Qk5xHpefWOskAnA&oe=6A5E10A2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdJPeQOjJfIQ7kNvwHiwMiz&_nc_oc=AdoiNRnVvoQ3ATUxrQSeA8aX7r3cG4F4TYwCE_dnbWaq62kfNOKhp4hlrzlgVk6NSDc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7ga9QGPzVpCg3YcBMggONq7qbZO20qsDinurH1F-aBg&oe=6A5E0CFA"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMFikO1hRU8Q7kNvwFlvW7B&_nc_oc=Ado3kM4oYp3Vez_xWFYj8r0_217afm_T4W1casofqvcGkCaS2Aa096NsDOIpnfJ6Y5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnNWluJpixEMe8VJh2RYAa8Qo5I5QA7wSBLMZ2_pFDHQ&oe=6A5E1CAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbVUiunoakAQ7kNvwGJWei7&_nc_oc=AdrKXSE0Q8WeKd2C_BoS6gz5Bd2hZnhLT0vENz7quBbm4fP-FdE1sq3HxSJpMaFs020&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtOeVz6oeHyKfbLK2CcFsbz8wK7WYlpC0KA4gz5YXmuA&oe=6A5E29DD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wg2akwT8C-wQ7kNvwHPcvUm&_nc_oc=Adr2I-rCo_zRRooaS-nR7GgH43XOzx0p1tDQLM3pZeKIL6839nlfF8FWsA1hXhAQCWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmqA2AGC6ZSh5uv_Uw8K0MjicjHmtYPYhsRduXVylOCA&oe=6A5E0521"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
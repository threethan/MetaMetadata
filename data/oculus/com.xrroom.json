9zSWZdwmml8ECH6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNK4C7TA9DapjU4cV3svuGlNri-3v2NPCXAiBFzo4wwjA&oe=6AD228E8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gj625-tVAmIQ7kNvwEyoGNQ&_nc_oc=AdpK42WTr_yTBrtOk1ygLbTWzfJDZxwIHutSGPyNPTwF3oKb-vO3gMISOiTTRmebj58&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOggKjz0s_IETjPwkWK1vffjoVQJl4C8sGT3phB-7JqLA&oe=6AD24CE2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKJVTeeTTG4Q7kNvwErnG9Q&_nc_oc=AdofErdvhKjqiMckzdmPavLGYvdGUj1_xElof9djZLO7jN8uwYOZkd2sLX_RBP1H36Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpovPKV4y5WlIccC_yRueEN9EfeH0ktGCjHwRPAEJDxw&oe=6AD2493A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-lvV-DtMXIQ7kNvwEdBzd4&_nc_oc=AdqTWBZRlMc6oPr1KlIDxhOlbTRVcaXl9qp7CIGxbrJCbpm3JJU3mxy12ICn6APGIaw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfPsvizg8tpYhaIfs3QjVbxl6RcT6LQ3O-jvVzct0yKg&oe=6AD258EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVSd5uqA54UQ7kNvwGcvTyA&_nc_oc=AdqIEFn5rq9iPRfn8UPTZQhypx-WShWjTcap_BEXaw2qFA9esN3gEmID2RJVVmEuA-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmwwNU9vfWJEUZ9-pWtKWpzwsXCSyUA6jQjOCSrDcsnQ&oe=6AD22DDD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTTq4G1rclYQ7kNvwHpDs3K&_nc_oc=AdrNxAoAijpWvAlDytXuAWFm4wMM7b3IlXeMjGqofP65ebavlX1eGZqThTyX8MW8ab4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkFGzvSAhmIRA6i3Oy3SuT9pSFpR9Pney0EqH3prcdZw&oe=6AD24161"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
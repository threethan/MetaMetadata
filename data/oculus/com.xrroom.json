PeV4AWlSftJYTg1Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CUOEvlYXQdf0yx09SDQkKsr3ZeBZlQXztXnlQEQ_j2Q&oe=6A427568"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvGJhAo1C8MQ7kNvwE68UAf&_nc_oc=Adps5NU4d995buirzRBez9eOgAp0FSkbwiz4XVe16Wv5c-nXf_srziOd1Q15kzAG0GI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SwPfYs-njnB55dU8yaQhjJg2YUlESMvA6L7Yz4MDa8Q&oe=6A426122"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B07fWbA_-SMQ7kNvwFfakf-&_nc_oc=AdqOZqAYka-pQ1tGjfbNISlaAZ34bjVi5p1vZzsTojnoNHYbzW_5W10XfHRFKJfXL6Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2lpaXbjF6wOJSQeC4xnGGDNqQ3WGqtVVNN2uGyKCltQ&oe=6A4295BA"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lugemATLArEQ7kNvwEjPBfs&_nc_oc=Adqjpns9dqxnfoGBzvvlaA0Kzw1UNPNczLhxPi6RxqCUie4Y-XVXlFbtlajAUtOpEu4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96zUl0XBbZxdtVHrNvJj4eYG5gmVjFnQLjpiNe40SS9g&oe=6A426D2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whTG0tmkHCsQ7kNvwFAwi7H&_nc_oc=AdpdF2rR4YfD4am9yL81SAwu5Hvi9e7SAyHo9pTopd9mkcbgkMbhgCCdxKYIqwq-dT8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yMPkoSDhHUesZhGJuTyNjiuJUxjoe1HHhXJl_BkwmWA&oe=6A427A5D"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXaPs5S999oQ7kNvwEXWZ_i&_nc_oc=AdptQY6vfZG1V1NXD9gv43wNlVSTe7gAXf3N95MRW9C7jbG4R7SmShGdPpEkKZm3DrY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KTI2-wYprH076t-FCCmH08bZFz3uSHD4O1l3omJIB8Q&oe=6A428DE1"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
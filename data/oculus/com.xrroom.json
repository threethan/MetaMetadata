90KhdQEZ_ebM3qKo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6xPnd7AnmL-QkYHRoP4Zq65CaFSm3x_4v63pi98XgkQ&oe=6A4FA468"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7XpSCOiN7QQ7kNvwGCWX5p&_nc_oc=Ado0BHI41adx9OasN_9fkhKheHV0om-VE6VgniPBhQzK5TNhHzhJGyigPVGPaqATQvY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQaC6-9CxkjS_PnTsJ8g-DeJ86lLg5DwjzEI-nz6ioeQ&oe=6A4F9022"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3mKMdza7N8Q7kNvwFqcciG&_nc_oc=Adpn4kDZ9t5aipTbcJWEMkMfrLwclnGmtx4LtbR-IXeACQzCnUqgRAVZiQPpabdOPe4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx76TBK82BJNRGBsqmxqbW56SNsp4gGyy94UwSf4kT6A&oe=6A4F8C7A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4K9oCradJ38Q7kNvwEtl3po&_nc_oc=Ado0VV3pMmnD3m4OMQ_SP5bgliL7IUwUAog_dwqn79rPqTNyWp78i3Nf0ALh19S0Ua0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwoC_Xo6MojWxdcqcmDx6sClvHzxfLN21cjvEB3kWxcw&oe=6A4F9C2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1AGwbqE3UcQ7kNvwGeOy8B&_nc_oc=AdpivkZP_YgvGfz6OlLWaf7m1uS5ald8BAegrTBxeqzKPfi9tff5_oUKd4h6aSKkPyo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBACUZuEeypBbzCTdBUkd07b3azRu_RnrNkNJJZvPS1qw&oe=6A4FA95D"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65hnAnXHiKEQ7kNvwHDjwWN&_nc_oc=AdrjB9AmEydtwSIGzWbgtkO_GDeA1y_7YNXK6LHjat9O_RBaY7E3GfumKboPPIWJFFk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBfORAcxQ1fh6mZ7NxKLhxpS2UXWERwo_hu702Grdmsw&oe=6A4FBCE1"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
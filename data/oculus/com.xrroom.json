7&_nc_sid=6e7a0a&_nc_ohc=SIP3DL3cGeoQ7kNvwE0gu9D&_nc_oc=AdrL9rSMbDURprXihY7nfIbJpokA4LLr6PlftFhGSNtTp9h0Yctru9KHvAg2eczAjG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMTeqq-2RzaW5Rc7S5sdko9D2GPIRCDUajLTUUrfFf3w&oe=6A674B22"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utHhVCnAHRcQ7kNvwE9Fh_P&_nc_oc=AdqMVoj07v1e4PFcrOTFqRVEHlzjRHJQvaS6GKj-GDDQgwYPa7Q23CT47YUBUFZH8e4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw_lKzWOyJdcwXULgeM62-EW1-2PYXcIg6iyrCzBQGng&oe=6A67477A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC8ocmkIRbIQ7kNvwHhVbLO&_nc_oc=AdrG9bKQ6HU5YjUxY1epL9XzQhK8Ykxg6SdQGoezrNSBd6pz-LvYj_F3OWQNjI7MbxQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVjoXlh9Lq8NTHedevR2p7ddoM-l8PLC9fr-9q7mTJmw&oe=6A67572C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Uswz6v-s3cQ7kNvwFQtPyn&_nc_oc=AdpKp5Vm11lTXzqMgMHVnYAZcyn3z8qdEI2ospy0QjqqpmkKxS_-Li8Eu7LP2mqBMs4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0DFLpKjuRAOc-QFLoeDSAyCzHOcWJ4XaIpUbXjJKK9g&oe=6A67645D"}, "display_name": "XR Designer", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrsns.com/j/policy/privacy/", "developer_terms_of_service_url": "https://xrsns.com/j/policy/term/", "publisher_name": "https://xrsns.com/", "support_website_url": null, "website_url": "https://xrsns.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "1990104051447093"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1014324473307962"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "661916505531123"}, {"status": "PUBLISHED", "id": "221554830634314"}]}, "baseline_offer": {"id": "661916505531123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1690835732, "status": "PUBLISHED", "id": "661916505531123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6365099873527875", "version": "4.0.4"}, "id": "238867605490542", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6057482550956277", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6365099873527875"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "238867605490542"}]}, "change_log": "\"XR Designer\" has been re-released with a new version in a separate application. Please change to the new \"XR Designer\".\nSearch for \"XR Designer\" in the Meta Quest Store and press the \"View App\" button in the App Lab below.\nThe new app has several times the number of models per room and capacity limit, respectively.\nThis older version limits some functions.\nWe apologize for releasing this app in a separate app due to the fundamental changes.\n\u300cXR Designer\u300d\u306f\u65b0\u30d0\u30fc\u30b8\u30e7\u30f3\u3092\u5225\u306e\u30a2\u30d7\u30ea\u3067\u30ea\u30ea\u30fc\u30b9\u3057\u76f4\u3057\u307e\u3057\u305f\u3002\u65b0\u3057\u3044\u300cXR Designer\u300d\u306b\u5909\u66f4\u3057\u3066\u304f\u3060\u3055\u3044\u3002\nMeta Quest Store\u304b\u3089\u300cXR Designer\u300d\u3067\u691c\u7d22\u3057\u3066\u3001\u4e0b\u306b\u3042\u308bApp Lab\u306e\u300cView App\u300d\u306e\u30dc\u30bf\u30f3\u3092\u62bc\u3059\u3068\u8868\u793a\u3055\u308c\u307e\u3059\u3002\n\u65b0\u3057\u3044\u30a2\u30d7\u30ea\u3067\u306f\u4e00\u90e8\u5c4b\u5f53\u305f\u308a\u306e\u30e2\u30c7\u30eb\u6570\u3068\u5bb9\u91cf\u5236\u9650\u304c\u305d\u308c\u305e\u308c\u6570\u500d\u306b\u306a\u3063\u3066\u307e\u3059\u3002\n\u3053\u306e\u65e7\u30d0\u30fc\u30b8\u30e7\u30f3\u3067\u306f\u4e00\u90e8\u6a5f\u80fd\u3092\u5236\u9650\u3057\u3066\u307e\u3059\u3002\n\u6839\u6e90\u7684\u306a\u5909\u66f4\u306b\u4f34\u3044\u5225\u30a2\u30d7\u30ea\u3067\u306e\u30ea\u30ea\u30fc\u30b9\u306b\u306a\u308a\u307e\u3057\u305f\u4e8b\u3092\u304a\u8a6b\u3073\u3057\u307e\u3059\u3002", "created_date": 1691192667, "id": "6365099873527875", "version": "4.0.4", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6057482550956277", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6365099873527875"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "238867605490542"}]}, "change_log": "XR Designer has been re-released with a new version as a separate app.\nPlease go to the Meta store and search for \"XR Designer\" to change to the new app.\nThe new app has several times the number of models per room and capacity limit respectively.\nWe apologize for releasing this app in a different app due to the fundamental changes.\nWe have limited some functions in this old version accordingly.\n\n\u300cXR Designer\u300d\u306f\u65b0\u30d0\u30fc\u30b8\u30e7\u30f3\u3092\u5225\u306e\u30a2\u30d7\u30ea\u3067\u30ea\u30ea\u30fc\u30b9\u3057\u76f4\u3057\u307e\u3057\u305f\u3002\nMeta store\u304b\u3089\u300cXR Designer\u300d\u3067\u691c\u7d22\u3057\u3066\u65b0\u3057\u3044\u30a2\u30d7\u30ea\u306b\u5909\u66f4\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\u65b0\u3057\u3044\u30a2\u30d7\u30ea\u3067\u306f\u4e00\u90e8\u5c4b\u5f53\u305f\u308a\u306e\u30e2\u30c7\u30eb\u6570\u3068\u5bb9\u91cf\u5236\u9650\u304c\u305d\u308c\u305e\u308c\u6570\u500d\u306b\u306a\u3063\u3066\u307e\u3059\u3002\n\u6839\u6e90\u7684\u306a\u5909\u66f4\u306b\u4f34\u3044\u5225\u30a2\u30d7\u30ea\u3067\u306e\u30ea\u30ea\u30fc\u30b9\u306b\u306a\u308a\u307e\u3057\u305f\u4e8b\u3092\u304a\u8a6b\u3073\u3057\u307e\u3059\u3002\n\u305d\u308c\u306b\u4f34\u3044\u3053\u306e\u65e7\u30d0\u30fc\u30b8\u30e7\u30f3\u3067\u306f\u4e00\u90e8\u6a5f\u80fd\u3092\u5236\u9650\u3057\u3066\u307e\u3059\u3002", "created_date": 1691101605, "id": "6361596953878167", "version": "4.0.3", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6057482550956277", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6365099873527875"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "238867605490542"}]}, "change_log": "Some users said that the pop-up display partitioning time for errors was too short, so we have lengthened it a little.\n\u30a8\u30e9\u30fc\u6642\u306e\u30dd\u30c3\u30d7\u30a2\u30c3\u30d7\u8868\u793a\u4ed5\u6642\u9593\u304c\u77ed\u3059\u304e\u308b\u3068\u306e\u58f0\u304c\u3042\u3063\u305f\u306e\u3067\u5c11\u3057\u9577\u304f\u3057\u307e\u3057\u305f\u3002", "created_date": 1687134689, "id": "6204779062893291", "version": "4.0.2", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWi
vzzr01m9gXg&oe=69A44168"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ec_ChFm1x4gQ7kNvwGexhMX&_nc_oc=Adk_EH2VSyqhYHgY6O3ftZy19QXP2z-BAhxsTC2_5HnGJqcDK2AhbGPQLu0TZewqPc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuI0dYrSJiPEYCjYmZzGxQs27ZKsc6TM4umkn5K9xTmLw&oe=69A42D22"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54TIcXNOou8Q7kNvwEA6auq&_nc_oc=AdmSraLkJFIHK2-MNmrFzPkGH0ttRbJvSF3IjTlUPw28eoeWSAt8BGI93FDCgm8KTv8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfubDpuQx5nnzVyw54VeT5VsgcGPn-veLeZ-Rhwu4Jo4Dw&oe=69A4297A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMc7OP3YZNMQ7kNvwEMZC61&_nc_oc=Adm3F84-5OX1A0luRtc4xrmTbcnNnMUJ4cZM64STlbWodW_8HM7oRRmGD0dEYKGlrRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvSTMQa9VBBKKVBaE06phxswg68U6Tw4Ay1kukBPdrN-g&oe=69A4392C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOgS4bDfqXoQ7kNvwFT2_-a&_nc_oc=AdkuKBLlGmz4npCMFs1ED620-dfDXVFbnxWXupK0MyOKLVFPf0ygKXj1Ttovxv9px-M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs1sqhc5EPf8lZbIDQXZSxnFv4ck2rQNE13GMkDf3HbBA&oe=69A4465D"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OynGt366wWYQ7kNvwHZkNvr&_nc_oc=AdniFjXXpsOVg7Yh0mhxkJG4PUK3GO0hPW2kXMBX3y8-Lz_3_6qbGGGq-mbo520-DfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftj4NsU4KiAnThBhtaAixMtvY93J3E_7BK9VvGbUSWcfg&oe=69A421A1"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003237_6317703314949475_8763368581178911583_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5or-PHov6
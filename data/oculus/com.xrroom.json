jA947HUrUCWMBpBk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNArDEAMT5ICPjKRz8Tlp9lFHEQ_EtvIXLDw1WmPkpJg&oe=69C68868"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1Ufo83TasAQ7kNvwFg4Qcf&_nc_oc=AdpiGKfcdZ8_My0N6IJVRt3AjsqJ_nfQs--5oSTp4AQmr2-0ZDaYcxEk9eZg67XRrGc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlgH_8ImPQyDKQC6AmrHZ0F1ugRf42PjUNy1QIFcc9yg&oe=69C67422"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5FVGkxpjlMQ7kNvwHNztcu&_nc_oc=AdrzThZJkTiSu67hHbwkWbMnipvW0RP7o5DLcpul8Tm3sD1NAacpuo0vyn2hdA0YadU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1ZR4bMD9BTacaEcNSO9IGR56U0P5uxio-SrQ6VIdWEQ&oe=69C6707A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpkHRXPnSWwQ7kNvwEVY66u&_nc_oc=Adp92RLoUPiUVDb8QufKwyW6mdfGOCfVgWsrxwZ77yUcMUZ2V8R9fastOLACjb40qb0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFySchghdkHMmAoyXkqbkHv5va_yFgEGbojzG6D9cZ-g&oe=69C6802C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIBy5dNZxSgQ7kNvwHMC_aD&_nc_oc=AdpUuVeYgRtv274W1Bc27L7l5yGK18JH3ygno5T1DOU70x3ip0-caIIm8n1qXVG1xOs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysOPZxZlyu-53cmIO3JzoANCliRsW13jvuSQU2JE70ww&oe=69C68D5D"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=We6A0_ZGPmYQ7kNvwH0Lb-Q&_nc_oc=Adqv-CqPuOzgw98hKtbf0qyX4stnO-C3iL4KCWirWsYAhBEEgZ0yrZjDCNuR_zMSvdE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJ_lTu4_W8Lc-7vbQtbZwShiZ-cz2HVZogI5LCnnYlJw&oe=69C668A1"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
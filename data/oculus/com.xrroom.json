TndQvQlBvheXuiJM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ldjotBiZAL_mLKGsFWld0cPF_xPfsv9o_f44KRQXJXg&oe=6A2422E8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ny21UzBu9oUQ7kNvwEoZzrf&_nc_oc=AdqikSetQrz631F5Fr6X30C8uP4bPsCli_0_0s-3QKkBpkvHUH0XzsqQu8ljL4DVAIo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5ypbynrXSeXHwJTbHQgP2-lGqBzgmR1qOkXJBb4LUtw&oe=6A2446E2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9X3m9Vu3YPcQ7kNvwH60nwT&_nc_oc=AdpLBegJ7NsSSESLJQ9GwLXj0qLpALDMqGjes-zmFC5M_X9l-pFixtTZx4g_x7frsiQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qdNw0f1AzBWCaOwW_Nu1JyDFMVYvxzyikaCGEuh7UEQ&oe=6A24433A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eJ1K_aPpL8Q7kNvwE8huCX&_nc_oc=AdoBv0ghP-1jR8yQMNd48A3kE9cuUN0kxacxLlgnzHf9i7-gDtMCpRYtII67CKt6VRs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5fFUWA4yNhXfdrrFiqwJiiqRbxvgMcFUoBbDqkrEvRw&oe=6A241AAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIamD-_h5jcQ7kNvwHr23nO&_nc_oc=Adoj839iePi0bqDFIGtVL8Qz0mdXtG5g_LMk6V2q05FgEsgXyL3n1TpuUpFC6h5GguQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Xo-_5pfBGC3Bak_irTJEBSvGqGopzuX5vXA00Yk78tA&oe=6A2427DD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVF7LXn1988Q7kNvwFi-1Jt&_nc_oc=AdpqA7LOydmH9-gmUG2NWZteaX8YSY6_V4Rv_u1-wUOjzrmOY_ZZUspoP6wsLjzpz3s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ICaqb5MzV29ol2l778tKQd_pedbKkharCrp-XZcevnw&oe=6A243B61"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
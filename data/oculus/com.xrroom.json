AsTTV3Y1W7A_igdU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt3-yP8cQazIXiD9IjQccwjNvq4quaHKjAL9sSfkOlMg&oe=6A830EE8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zj2MrSjx8rUQ7kNvwFyrHo_&_nc_oc=AdolOT6hddruY0EKdH0e-EvQqR8RWwhnBko_05rLolXsGngRoEfuUFGMIQV6ea043PU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUj3JWXe7OgAvhofv-V632vRqpvq9hhkdqs7bJ0NjTPg&oe=6A82FAA2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-ysFaoQkPoQ7kNvwEvK9kW&_nc_oc=Ado2XDhhBviZhhicaJVot33_dtg9IGryuegrRK6OS5UeUaq3O-adEpOUE8-FTYzAmK4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGD9crqye8dCyhLfgMFRTk_yLaUjcqET5bG7I6YZgWomw&oe=6A82F6FA"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YClx1uZMqbAQ7kNvwENveFl&_nc_oc=AdoOhQ1OqHndpbkikSNAcyCyJoFWmJlRqZFzXqjGIsD3YnFbPsJb3nULYH5upd6a2EQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9jVddSx9mDm8PC2zbHcSjfKMOZ32WUr710NeCYHMy5Q&oe=6A8306AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Co5gPaUiwRUQ7kNvwHXThck&_nc_oc=AdrPL8q4Vt4SGSYakRu4V-7CeaC9U2pkACDy7QnklmWYWobQBxAaO9IdT6GopPUiyk4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEY6fcpVJP-70H6UA6eReMirlLFo1s0xYsN8OE369MKZw&oe=6A8313DD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWOo0OpopSUQ7kNvwEzbubm&_nc_oc=Adqx1xqCEya76xe8lnrfNIjZqkQXBylNbWbmk1TnJAQXdXxLinyg1QJ-6_nF2yCQrAI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiObeF2yrrAd4OY5LylGXE8S5Zelonj1aKrr2_if6Ghw&oe=6A82EF21"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
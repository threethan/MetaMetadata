B0gSi5M9ouVUWbPs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnfIRUvVDVLeaHFpetBvKh-odFGFl15jF9VSemtiFVOg&oe=6AF74B28"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohqHUOqrSbQQ7kNvwHQ4Xop&_nc_oc=AdoZn7BBhxNso29OKLv9XzWfO1mS3SNhPhMg8_tXmnoVNmo54eV9_qmfDjKEA7AA-9M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-bQpVRbJyBi8eLhIHxd_HEgTTuqUS_Bdv7KWgAGmTYQ&oe=6AF736E2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tpr4BuqVSMYQ7kNvwGTRmwr&_nc_oc=AdoHEWrPi4b2BvQA_BUkEnbq1gt5dsg4cAHvothOPVvobb7qDeTL-4x01Ifvi8DZHXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6i42QTJJ95MCLSQ9-yzcvorsL7oHYIDvPzGZ5zGOS4w&oe=6AF7333A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opMRJwlKH4kQ7kNvwFb95bq&_nc_oc=Adpg5EjjmJvaMiAcdKcfH-YOPpYxdJUrDnmFnpju6x8q-pKrJGhdhE2R1C-6h_Qc3ic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvPcoUQKOGYtzt-w2JDb1XVXFQs5szLeEpcDTaCx9t0w&oe=6AF742EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRvOPnUQNoYQ7kNvwH6AT6d&_nc_oc=Adqb67PoCvTjt_kfh7YEh88vGf9vBGmoEEBGeR40NhwjkbDzINs36an2AoAFStiWZUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI56pUbmdWTOR0fbIi3uB0FgS2OvMfxvvnqHj4KZ2Arg&oe=6AF717DD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDZk086_RN0Q7kNvwGf9BYn&_nc_oc=Adp3NuRBhnOBqf7lWwWwJ0FgohHnNfZ0dd939Y2mJ2UYDCsxaZ2snMvwNryUYbawEM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTivqTPZPekSGAz3CecA39GSjT2A4DtBG-E0vXklVV2VA&oe=6AF72B61"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
FPog0HW-6f7wQWH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrEud76hv871X50cQDNWJsFRz48iuQ_RrszPjpmhUaJg&oe=6AE740E8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sp96CXy7aG4Q7kNvwE2PjKS&_nc_oc=AdoEvZyMBC3GewRBMM91_TrMHVO4I0H9C_QiOYREjAD_wmWJVuQEObRqlfzYqfNAzC8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQ0GyYH9Pwi7HDNQSBXngH19RwQpw-LhFriB7RwYgcjg&oe=6AE764E2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCqt2ub4gIIQ7kNvwG52H6-&_nc_oc=AdpAKNDzBkUz-nzH041d1DGCaY8W-X2BVT23sI1qp3RkccbUYqjcd372P5UvfOdWskA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8NwOeLtAX6yHkCJIT604llRjoG33szfnsLn1a7slkhg&oe=6AE7613A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kO2BwyDJ30Q7kNvwFbKGd8&_nc_oc=Adr1kTGLVvcnZocyqNGosdjKXspCEFW2t0SpvCGA_PPWcmn6xU7gp1al3G1_yFYmRaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbkby_fzfIL13ljygkVSgLYPRr9Ddo3ay7Oya3DXXmBA&oe=6AE738AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QJbgUQYVS0Q7kNvwEQNiUl&_nc_oc=Adp29QYcDR9pJZwRtyAJP8e4BUP3JrK7M8fwT8nFOYmgX97FCEBdf5Ja4A4KuC5APbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFeHiBidc48mAsHZK3Eyp86zHBdTUAOX96T2L128mGhg&oe=6AE745DD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCyGepBMcqMQ7kNvwEymUft&_nc_oc=Adpe_U5QhKwP8sAl9beVJtpr3_H7WeovwHPfm_-zqOe3uNY7VpMI4s6Frb1s02U_DqQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAoqUjYN_H0Mm_ADMqEUq6kLdk7Civ4SJDol0H5yOMnA&oe=6AE75961"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
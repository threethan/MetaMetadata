_mOlaXPwmskLYBkI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGygRwy6BBaTs_OSWa4eI3BL-ztkclR9FbB-LJZOv0UlA&oe=6A95BC28"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImxDPHdIZiIQ7kNvwGB24h2&_nc_oc=AdpRFv3aoWACFdtL6eO7K8gUwFYU7p6NoFkjExUxIwbb-bRF4O5sb-oYMV4SUnuT8Tw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYT1ezdBZB2mUVDlIEKp_MGqjscgMSB7bgeHWGFWsx8A&oe=6A95E022"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRuDC7eFNskQ7kNvwFDfH1q&_nc_oc=Adq9-o3tI39h0PX-Zf7GZykEkEzKnAVRcLJLuZ4_xRP5Ig7Ca7RUxGDmsxGIjzf1WcM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj9jr8uEf4k-fc5Jvq-I9h4ECK_0Ghkmi3XlWq50SimQ&oe=6A95DC7A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_TG_5KgPjQQ7kNvwECL180&_nc_oc=Adq6z1qaFipmWZl6Q3CHL0U8I1F78kPxwb91R-kjq__5TEvLN14wrh1dSqwAVyCbVfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiJquVc8bJ6CQVB2NPjPoKPkGdZE9wYufBOJ-pXLDQmw&oe=6A95B3EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9F8i38ycEMQ7kNvwFM7ojW&_nc_oc=AdrAoKG8qXR63PeX1SvUh68v1sUO5xzzZympPZC6T4KjD_1HgYk75pJpqkVNJPJn_Ps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB03Wf9KmPD6mn42BC1rugSkC3ed1S3EX9qj5xMzGEDg&oe=6A95C11D"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-EA6U7-nSIQ7kNvwFdb06u&_nc_oc=AdqUGXVT1ABbMTTKCtMuwaDpS6cW0RSM7BQTYrZj2nURmhMpoe_fB56zE9FC3cQfpck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFueDysUs_dqX5oeYIHsf-JSV1pQpgII_WjkQAOkIpNVg&oe=6A95D4A1"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
-aW_B2W7qkmJKIAk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MxCeKn6U3YqIGC1tBHGuqVVaO22BI0RjQtfT-jRG9Tw&oe=69FC95E8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZsYAbrMdJUQ7kNvwEO5j9N&_nc_oc=AdqWgGyVJr3BG5XWAmsbwINkeDdJb0pUmE2LrpkwbZ-mdymuQrhvvUps_JijIBs3GZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DwaK31Y12edZwIlahFinSU5PFXvjxS-X7DiohQ8Keqg&oe=69FC81A2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chsnom7-ao4Q7kNvwH-6xJm&_nc_oc=AdroMd5bDxfWdFkKrG8H_wEUoLB7jODXZwijH_biBmmkaP6CFUE3trDhI2iy1u5u_SQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Rh_IbWQf_nggNNbzNjopDVrt7vQUKWb1XU6B_jZKzdw&oe=69FC7DFA"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WsqUmWfSwoQ7kNvwEwtdqL&_nc_oc=AdoJNySM64w8kF1UjqTLmslGM5TT9aisRYlSM4oufGwv6gduXC5YT0GZTCJnBHySOPk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7A5nOyt4TyXTA4jyspiubE0Y90ntxvci7TpLnUjFW-KA&oe=69FC8DAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D68Jp4DyduMQ7kNvwHSfcE6&_nc_oc=Adq5fthtE7tvgZJGHrIJjoKUiJaQ7HyNSbfbo7IueobaJu7_yM0x5BIEUpBEg12a9JQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af580Nh0_cnOfk6uZJ3HJqdKg9ucoIEfSsB21E_TsC0dYg&oe=69FC9ADD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCG2-fsHm5oQ7kNvwGqCspS&_nc_oc=AdoLDB1s43sTzyqpQdZI4CLbChFM_3r6BBV2fKOvNXDiDCOHX4M64ZQpcMwcXfqVnAI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67Zuo-iN02Dx6vEF1aFm54NetZ8Ydv2edzUWBGfgB7iQ&oe=69FCAE61"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
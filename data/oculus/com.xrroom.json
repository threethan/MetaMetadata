mU8wssjfJ0mXUsgM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfKUuDM6EZgZbPQASwdvWVGtl9Ylk6J6kbaG_H2i0klg&oe=6AB91C68"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7R8xnYDilgQ7kNvwHQzByl&_nc_oc=Adp7aGiX09DMK_7YL1FirpGGHDrArpbrLG_two2d5Mwa_TFFiwITm-XVFf0XIhqmcz0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJna-zVnoC5NIShEDNJJEKfoJwcK4rBMx7W7JmKrARb4g&oe=6AB90822"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89sl35I3yVoQ7kNvwGUnLqJ&_nc_oc=AdrcjYZqYBS4Q65UTnA4BP4WfBJZz44_DYAMKeLSMQvxo0mtp9f17693zl-OutroqnY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH-uKo-KsYl0tF_k5VtzNxGMSk7bTvovtuKtrmjudwog&oe=6AB93CBA"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnYkar3FVtoQ7kNvwE0-9nd&_nc_oc=Adr7uZjRDqnhGjVEbajDgIh7c_un8P2MvuL109kiwx5Q3Q4u0JT0Hx7awB8E_L1JpIs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdeMmMDDQjBGYRl5-LfNKLPEOqBz-zFgE2xwNlgzOPgA&oe=6AB9142C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tCd_3ZYOSUQ7kNvwHGpT0j&_nc_oc=Adorr0BQ-vwVsQ4-VxnbQ_wdz87wWqAcsC8gV8UibGzRaS-nZo2JpJQu-zplWHhHPjg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxXNdYsTcKxcCL6kLEJYKm_QwEqA7q2Zb3LBCc77O5hw&oe=6AB9215D"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHe2drJFrtIQ7kNvwG72iRl&_nc_oc=AdqiHQBPtKaV04y2KkhEaaykj99oYXYewKJgl8nZxEAcry0PkOxyFduf7vq3itNBD1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_YaI4T1rovcxpdZWPWN6JTGz_tNMZV-VsHxino0AG6Q&oe=6AB934E1"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
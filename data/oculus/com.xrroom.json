w1nvsfxCpiu-r2cA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDpaYkGvGRpBGWFdf-KBZHPlN9wls5ct-ZcHT4lOhTMw&oe=6A6F4868"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXXdhwc0TggQ7kNvwEAjSrM&_nc_oc=AdrpH3eT6mVA4CRCqArI3JJB-otfCQyxJJ3ZJJmMILpjlabcpNlBWoBGvPPvU3FI14Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-pQs9ahOidihcex1HyOAObwro-HG9OSN6_ter2Cw7cg&oe=6A6F3422"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnJyMX1c_EYQ7kNvwEGG5fH&_nc_oc=AdpwO_Kd4-_EM4No9K1YlhRnzTKVUW4g0ipQzB7jLAiU7I-EZ-4tVK16Zgqje1GUwwM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7ZcAhXuuyixSyWci9gUvcx6q6zombl3BXcL6kfbQKsw&oe=6A6F307A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V53Kpp8QrUEQ7kNvwHBKp35&_nc_oc=Adrwr1P2ByJXCKW8rq_vFLB-63uunZNNL0JQ3iG8eePyjJUg3tahD9FQ-kGuXG21HFI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDou6Iqx4VJmTuokGw5nU8N5Oo8SH9h-oTHMXO7nohcww&oe=6A6F402C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PBjQWQ4KCQQ7kNvwEaLtAS&_nc_oc=AdolfIP40D2OXFBnmrSDA5XcEaMt7s6pk6ygIzzwdqBvi0RZMYtTpgMy73-08SaRvVw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrglSvPp9JVMEwqpC4jcTx7qvOnt5KpmM_hP-01on3EA&oe=6A6F4D5D"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4xHjpv-EpcQ7kNvwGOl3zw&_nc_oc=Adq-9qNzs9ZdNjaOpIHy4OuRgaIwRWYWIWKiL4vRrsi0UaAOdwTpQK6jtD12qwrHbbE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDr0Htdbmi-CIurPsuZvwL0PFrrT3m5UlnTHmOLNUq1oA&oe=6A6F28A1"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
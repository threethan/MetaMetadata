c1jmpLjtGX3-Sa3E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRenXfz5reZ1EBu63IwrjElWPv1XaAUROuqgFfLAbt7eg&oe=6AF07B68"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0bpZMTpqEQQ7kNvwGZCeMO&_nc_oc=AdqckWZwDRkL1Ath3mv1aw5HelrxoAVdkOqVkmSdsuEIyS-LNn_UnistMyXO4YruPsc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLc8zCXYCruRqJhtGLZHhWDc6nL3SzzA81Lt38D7VJDA&oe=6AF09F62"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4-ddvDEEdIQ7kNvwEEIWxL&_nc_oc=AdoIhVg0PrLoOq1BEOvi4y71hGjLqMtVVyza_e7Qn5HWQwP3tD_tZmBtbonclWJLEAA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxWokfSs4_iJA_WuDQKv8JQyoVWFkaax41IcRypi5tyg&oe=6AF09BBA"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tddbvH90NAoQ7kNvwFk8U1A&_nc_oc=Adpo0dD_CZ5vvdij0_LaWiKf1Z2RxgefrLgCPS1J99Ur1g0UzlXLXjgss6ULVRclNRQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiAA9J13HsmKuzgkmhB_zsr93kjqzJQP2L1LattSo6gg&oe=6AF0AB6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZF3tsGt8HsQ7kNvwEEE0K_&_nc_oc=AdqFyZxztKXx30BPBUqeSGkscbtyushuDYZQeVfpFo_YIg4NICrw493y-ogEBdMsy5I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSId_--it50vRvA-voIQv-k8P0kgtR5KV1LpAa9s6yTew&oe=6AF0805D"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ljB0oZJAMsQ7kNvwEotNAa&_nc_oc=AdpM28Hy5vbIj6gEjwq7iyU-aPrrfYrzbZ2jwaz3mz1USxLYqd9GkqF9Tvs2Y_8Nf3I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmFfbw1vMtKMk8ppGGSANGyxXrt_EJZ1byYzzx6b8lKw&oe=6AF093E1"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
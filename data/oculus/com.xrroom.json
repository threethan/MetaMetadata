66iQJNGko9ywZwaE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAeP9BI55Jd7lDyf_L9UiQVhb0iVOtAjQ5eDA6-yeezQ&oe=6ADF57E8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0I_oTCRS_AQ7kNvwGZkRyd&_nc_oc=AdoDQW4kRtTDth8CrmN0M3dGPeq5mAfNz0NCrfI6RUjW5bjBBhvjUg6HtAm0wqSwaio&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3ro9J1R-nazZ-IR-x-K5NOCpLKvJ9iUHk8nF0kH1NiA&oe=6ADF43A2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMikMDg6gEcQ7kNvwH59AFB&_nc_oc=AdokjF2I_l7tcSXK6ZrXyZy8TBpoak-PHAK6PntWbfekU-msH1hxPBi_KpIkQx1axHY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgRHDHYNh3Og_2h2JfPI6kLzMNPC2Fe-a20wxWkQIvsA&oe=6ADF783A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_f3g4RGHlQQ7kNvwHuhk0q&_nc_oc=AdpMPWxBkyHTXe0i0bb27-i-rfHYgQPqAcneGTa-WPS-mxI7br8CUwaVjMHlUvlyB6U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIAsjdi_mRIL1p2UbEYYV1AC_XS5h2GCg5uTY3uHtWYQ&oe=6ADF4FAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SquitsNIqsEQ7kNvwE1GSIh&_nc_oc=AdqvVNyy2ggHrAAZ1XcXiogLoIOd06Zj5cvmZ3ouqgm0Dd6xaOfqacqD2p6-ptkls9s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo1WnCqkaibmFEAztmKTmCranEapjkr-4ZxiZhOKxypQ&oe=6ADF5CDD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMpwVovtuUAQ7kNvwF-mjKG&_nc_oc=AdpEhdw4cbEhSe4tl9SfFGZCO7_CQuxeM8m9heG_a3sUq6WYwZW9ZAQkxAYP5cr-rZU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_VHN2-8jYOcSYvXtPtG2nBs-G_nuTgyl2YFp7ns0TKA&oe=6ADF7061"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
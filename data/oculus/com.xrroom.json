8u0vccmY2Ww&oe=699863E8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7ESAg_MbboQ7kNvwHD2Ipp&_nc_oc=AdlT5FCuIuxBVgJEYN0j41JHiIdatXei9aiTMY-McN5TmOKsGOy-G1xZc6GuET-kATk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afsq-crsrwf46IJwqrcS4_DVyyNFhdamZrHmSv8nDwAQXg&oe=69984FA2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJvF9WMajPsQ7kNvwHMEqVi&_nc_oc=AdnviGEVAXnaCAHWz7oHO9_VbVJ9kgdOlVPaLGsFphPELkflVSO1EA30yMOtJYjG2_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftYv96ORb_zXKOShHw7gZdFcGktEvwV7FtNEOg5sLB12w&oe=69984BFA"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ae2PFdX2m3sQ7kNvwFv3v0L&_nc_oc=AdmWRmJBhIxSI-0ryJ9dsAhReEmWlKvetdxSdnvjsgi8pnjlj6Vran5gCYy_Z31dhUY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft-JY7qXNJVKSBs3xMAodXZQIkOxLwbr5TzSSCTYZZZrQ&oe=69985BAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aCoNxhl29gQ7kNvwH3ULiT&_nc_oc=Adk47y4Uugq0-nSgWc-SzsE9bCP_UQ0amRHwFREXl3qqkWb0Cn2E0_iEjO6aCttC6oA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvWX8KO3pNoXMODYqBkzgD4osbe0u7pK_wXfhLxQKv3sg&oe=699868DD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm4HUgTd0YwQ7kNvwF3gHSN&_nc_oc=Admzmz1ZIsJ_Mwh-S2nqxpwLWQH4RIAwMJBpLPlo9QDf6f5DAeezu5Pq18x7Ke2VgQY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afut0ajrIovtxuNhJME5u9jUhLoOAvQFNk5--ZHCoz400Q&oe=69984421"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003237_6317703314949475_8763368581178911583_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nndd5LsY-
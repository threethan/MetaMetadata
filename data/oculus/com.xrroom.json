Dz_t-IpmNwES288M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqp5kL5Wgg9CEyJz3lRUcB4wM6ikSDyWYC--Je5SY5Zg&oe=6A660DE8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nczEahiloxkQ7kNvwGh9YEc&_nc_oc=Adp2RRq8QbBZvK4C5NHmprHpY8Qj_kAT-IJYBiNsEbpOuKQ0GcLOgWCFQjk8d5I2ynU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCdcAio2KuyyAimquawm6vOx1nC_Y-PptKTDWgme3DAg&oe=6A65F9A2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXXAyTXh2dIQ7kNvwGEAefS&_nc_oc=AdoJO35nGqEASmjEL7QNkAPo0cyXPkMFdPTIm8W8YN3Q9e3sSHqT5FOL7odJHuzn4qQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuKDOCMCd6lVzERCYcbJhPI_8SIAdY-XckwmcnaVTYPw&oe=6A65F5FA"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC8ocmkIRbIQ7kNvwHB2PK7&_nc_oc=AdrtpzZzUPZybPdUdVTlLtdQV_L1vnLL36_qYkBBGG9v90AlU2BAMBPcMUEHk4KexY0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGlYtfDPjJVLgrcMAMiHxzesmdLom-9bKAmBbnj1c1DA&oe=6A6605AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Uswz6v-s3cQ7kNvwFQOFel&_nc_oc=AdoSh0-3tLPjAKfq5gkaA4SuGlIzDa-QFZbgoyBSxzmuN2Bk3b3zS0x66iwiOrfJ8V8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfNFWvj7OiAiIran2GeTJTv2s7icRDuROcluo1ufKbAg&oe=6A6612DD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsZZCybR94kQ7kNvwFOJEOI&_nc_oc=Adq3CPG2iMgh8dZ5H-z54Ay92Bz5oLPVkWu-ODY6YCEcYdIR1m_GQJF0qGRcMdzOVQQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkz4l6GgcLzASXVHD2MNCqIsAN6ObBsTlL-pBn0sFfeg&oe=6A65EE21"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
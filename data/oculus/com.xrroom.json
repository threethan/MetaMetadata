=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuZt2Ca4qEb-lnpLMQffNA0lEPjK2EdvTHNGqd0dssbSA&oe=69A98768"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWvayr5RQq4Q7kNvwGmIJ0d&_nc_oc=AdkkT7YVU7Iq9rdtilbbuii8mSulVBAqOq6ZL8UR5nX9t1lU3BCb-rAH6CpLY0uje-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv3zaRs_S-9IEut11k7TaJFpMjqe5lNsrg1M0P-9jaZ6g&oe=69A97322"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1l-dNwNSTIQ7kNvwHt5sxJ&_nc_oc=AdnCj80fSqj8Lp4M3svrVG_4GOrVNLbyLhvByO2JmsLDG-MUNv60PyQ06OJGkafxG_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvlnmHx7TBERY2u4dkZhUxha1Hid6EXvRkEzYvmLK7b9Q&oe=69A96F7A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6a2ELvT4JvAQ7kNvwGnQJr0&_nc_oc=AdmUwz3b4_ajo1Yt8Dsqji33E5JG0nnuSvYcFKhbyJX3H9NU0W9Ebcfmn4bGeYPWlhU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuvYReuPaINQ5j15Wn7jwb7wJtF5BBlo8DNJF_J8pVEqw&oe=69A97F2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7qYgjAObp8Q7kNvwHHm0Af&_nc_oc=Adm45LNMwIHmx473xQ30xrRlwi7zg1isyKPYGra-Muhy1XkAxVxbyd1lOS6tOZZEYFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv6IdCY-qzUXXfD3RdZ4pQ7ookE0S3cWwhQQxI0SsoYlg&oe=69A98C5D"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ed0x4hpsCOIQ7kNvwGZvvnK&_nc_oc=AdmYmdyuiZtvj2HwLCD5-e2gohoOGXJmkIEYIpm_7WIPAsT9I1XAd_G2VhMVX9Z-4ns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afvsmij1NNHoIZFnpyhpfII6LRtfJ2TDTIgjJl1p3KF3Ww&oe=69A967A1"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculus
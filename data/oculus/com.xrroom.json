1M2Oin56ioRbq7Y8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb26Cqw8UQIoiniFzLkGH5x1jIlSeE_0AtCfJOFKGTGg&oe=6A8C4968"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nkaMvaDwhsQ7kNvwEcuuh1&_nc_oc=Adqdl1ER14hKj7V6qtBaU_ReQoY6VlnwZXB3hZ6VgGVuvUWrd_XfUBV0eR7TO5Dn-ZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrIpRgGWyd49nXgnWUPXeZ-hr_eub24zbu7ZERl2gvdQ&oe=6A8C3522"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRcnzQSTokgQ7kNvwEvaz-_&_nc_oc=AdonPsk0HEUyErKj2390ok1sZlMrHuEGevh4MSHl3vBNzBW2J-o2bIFLyccry5keB80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSapJQt-O40DWgw_PDMtEWuGy_hGY_141ciQVy2q0Rkw&oe=6A8C317A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwsWixi6_DAQ7kNvwHNhuyc&_nc_oc=AdpMALpWxBcbcLU3soHjmvI2Q4udnPpdVp6TTweBiSda9XgKtOJy4fO5U03t0KCuZKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnKjpEaDoY4595mJocOhOkEvg9HuVB9sBv5pHjcAPo8w&oe=6A8C412C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9Rx0tWsk3wQ7kNvwEnZPHN&_nc_oc=AdreIkvXZAvL7yH97v6kkpZPdNjbus6ACa7A0eBA0iQs3SXm8oCukQF3WzLeDu5mfK8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1hn5uF0Xu-sW14ynzieKYgwxaZOZysMg_LRd8H_0J1g&oe=6A8C161D"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W84ml9XKsAQ7kNvwGWUFPP&_nc_oc=AdpLk6Zo2tPV_p_cFeiet1C9juNM_ANtk_N1b7LfBmWFmGahHfZ_W6085dzfWxjAYkE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERsDJ3CIqudaOeXtJM3uLdeLTpz9435RMLlvHUCwQ46w&oe=6A8C29A1"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
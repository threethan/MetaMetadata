4Tg8W83GvuRGhlrg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL3JetjxXnu5j6BwzK-Oi2LGsRz5I8fOTLMgzJWyCq7A&oe=6AA7F8E8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKRH2FcRYSwQ7kNvwHrqWFM&_nc_oc=Adox1xT2t2vx8WFHmvMvz9agq0MfooJx6pvjmav3W_Uoz7rSqChva5uci9SEkuOnZLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlN8W2mOBX4DtsvIYbKb_acZjrvvO816WUHOYXyrGBLQ&oe=6AA7E4A2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEXEchubrhQQ7kNvwFVkXY-&_nc_oc=AdpRJLHMHHwROtkaxRKrB17DXRCpuN6c2knPaGu_OPLxWgyi0G46CgH4PyudOIDVBXs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKskIlPkWTjngtRvfU_FPIzHI0aGxEq6_HVRvNHnn2lnQ&oe=6AA8193A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ff4_2XvmYLsQ7kNvwFUnCNg&_nc_oc=AdrQ93tNrKRQ6wkhYEOdedQNvT8x04eMpXaFjzuOwzzhr9MVUIXmBCc6Zs9qtBm_cOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD_DvZNO5oOv5VthyEuaaUT2cTSf4OmyiMXQe2qnn1Ng&oe=6AA7F0AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3jK_yQfYKoQ7kNvwEC4LYE&_nc_oc=AdoWXb-t9Ge6cMCQ-42tVpd5IlJ6GC_bicUeO9a1a1hwM2zM0ejqjFYL5ZrfKfyoYxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHXkRbnSY4-RkbTF59EnMj8jhfWz77ZYDYgDSrTcrapQ&oe=6AA7FDDD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWrEyYsofXIQ7kNvwF8N7mV&_nc_oc=AdpoUIkhpaySPSwdejdyboH9rUMv4M9dLKdqCHBPeMNpKQznpXiYwtSVllbCdpxbsK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcREDOYyr9ni7NLhyRdclwkosqws7miYmXH9EDN8trWA&oe=6AA81161"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
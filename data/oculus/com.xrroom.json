zaBnWSOFMAciphXM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1bHB9TrQCxMzWaHIJnOr11bT3Qcw22G4zP0M5rn2QDug&oe=69EF66E8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-QVTbDJFaIQ7kNvwFSDo49&_nc_oc=Ado6vKk-sauoMo791TLYl8sgjNOUi60owJW293yOYxg8AuPJW1gX0ivLWxDPs4jKKJU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3B5X4nm3azR17hAxXTL2c9MEEXrWSSi-oAmRjUNtX_eA&oe=69EF52A2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRKYN2-QhLcQ7kNvwFz3jNa&_nc_oc=AdpHMH2-b7TDF3YthQjS0N_N0864XTEJt8gV0NRhiYjj06KlQfv2QZoZ_Ruus-5RXkA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fcQomwzkdiQl2hsXALJxNa0WTmE4x7eE46rRNg-Dbkg&oe=69EF4EFA"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HetoFareANsQ7kNvwFCS2VC&_nc_oc=AdqvUMzQ-aaDw9f-BsBJKPP2J5nE3s8AZVYF4022HssXH_WY5ZIs5ehVg5yhBnGgR0Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27EyQqEom7ZuCodQO_mAogG5PyDr6p-FhS_U9vTcJ1mg&oe=69EF5EAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coaGcw-NbFkQ7kNvwF9ZYDA&_nc_oc=AdotKtq6iwdEf0THNX5etsRBpZ3jAuQDDXp1f648U3hTDBUMvBzYdhQQKvwMn_Sch9Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af34eN_za5-MxzSyfwL6xlaYK7MZah-iZNdSDB--gR4qPw&oe=69EF6BDD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJlbreL7EEYQ7kNvwGR8jbO&_nc_oc=Adr3eSc8nGVxE_MKjyZj4NZMfYlNP7GQxREgWpCeWu8lY2U3tyfRZljAQHBe_bGxMcU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0D4oAIbYMZfUkxL56hIX4_OP0RGGmzNi_sKPEGdCTfYA&oe=69EF7F61"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
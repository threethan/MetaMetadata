-sx9JyXQfeKCyeQI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuPPmfpanVoBRh7EPjo1OYE587MspqwUM0m3SfdeNHnw&oe=6AA6A768"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKRH2FcRYSwQ7kNvwHDc_RF&_nc_oc=AdpqP7gQ3N_BZk8Fuh47VU6SJfthnemcEL9Y6-bB9-u1WG1q0knlhfBe8DVOlb3ckAM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdEaTd6U4uIk15Xne4YK7G76vPJo_h4ImkUAYenh7RZQ&oe=6AA69322"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEXEchubrhQQ7kNvwEdIect&_nc_oc=AdpDp1tYIyHMf5YS3DPLJuSqgk1x1AMbTuZHFV6xw9bVFIB-VhqBDeSMtuZsKXB03L8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwdKxWkBRzQVT7Cob8Y2cwsoQqDDPmR_PkqvTcy8D9Nw&oe=6AA6C7BA"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ff4_2XvmYLsQ7kNvwF_t254&_nc_oc=AdrcjtF-StSRqbMfNam6bRrFS9ACZVzQf_gPveXZUtQPoW6zWofRsyPZUuCjSY1xQ8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJO3fZRJ9dP_bjuJo2xwQtUks1qjNCy6fqxzkSKpaPPog&oe=6AA69F2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3jK_yQfYKoQ7kNvwF8r4yd&_nc_oc=AdrTCMFqNn8sEfRcDi6jFgYANOac2wZfGDeXf_RwY-b2Nmb7Mh31qNYjBnRZ9t4g3TQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd_Okpl9mGqimgaWYQQZsui1lm266keyMRFA_3lNmPbQ&oe=6AA6AC5D"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWrEyYsofXIQ7kNvwFmL6U_&_nc_oc=AdqePXR65lAX1B_6CCbjEsfpNEUnpGE1ABTJuRFr6o_z9e8ef9qvsyiiWehj7b-KWCM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvko9GB8njmXzgsxQmoJZ62wPpur-JLZmCDkS9vsVRFA&oe=6AA6BFE1"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
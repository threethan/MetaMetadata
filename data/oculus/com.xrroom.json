6sl4-4OoJreC5wAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uMlmGt8ihaDewnfYpuEkiHX-iO92aW3enTiibKCYyaw&oe=6A3BDDE8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RiDutnoVOMQ7kNvwF5lkmp&_nc_oc=AdqEy5f3WZRbvpMEmVEwD-pMtBUEHELQie752EidWqOYyQGvDAAy7IVYTwEi__Atr7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_WYqprA-YBfY_44bi-OVbMF639gdAm1A2BgfL-eN0GQ&oe=6A3C01E2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zc-Mfkwt5YQ7kNvwHPFEMp&_nc_oc=AdobDUg_-FBSEfAQUZdSFoYLNQnN0DPoJTh5VVLh8LOgx85qYdUfuk2vt58kjlOhMGA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5c38UIDZ_b4t7di9bO7YZ-9W-98TLJBUOG4s4-BDQkA&oe=6A3BFE3A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HV3EF9boskQ7kNvwG8GAJw&_nc_oc=AdocCLQQvucImJewRWV7SZzszJvZMyfKJxL6lfUpE2lVF6Qvb-ba2S1urPFCGrCZf7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Acb0pZNuybBbHDtwhLZpCPTAKem45XhevEtwfPFbDhg&oe=6A3BD5AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYsgPxMsgG4Q7kNvwFHwc4Z&_nc_oc=AdpH2ZWPHmOEk3yURgxB4TaRMPap2vp6o4XnozXzhXFXHfzzrX4lNiPjnUMH7xvQ6uQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fhM-z4E4lViws80PQ95YaMtePcJNGiPF-ga6JjjcTSA&oe=6A3BE2DD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrnzMNcXr60Q7kNvwEE6Hva&_nc_oc=AdqI-mAZ7UaWPddPJ1KaMl93xyp14VmvAPdxg9o4B0aJB7kHGYxDk-D_9urEBsVvdtY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-P-EYJulKpbNGuVgUXhh9x2RVKpZJ0FnhXuhEJxPRx_g&oe=6A3BF661"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
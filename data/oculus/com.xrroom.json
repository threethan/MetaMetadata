R_-v9AeOjgrJ1D2o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5trv4vaU6o-wMDQfXfVci2lbCqZrytk47F9vQwlNQ91Q&oe=6A12FF68"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boEH4ucr2z0Q7kNvwGc55QX&_nc_oc=AdqirO9J-0UFIcg-FMklK19bPHi__a5trqwDJEN4EXu7Wz6Or-HZQDXuWpy9K6LU1F4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SlKPyFgVWU03x8-7KM4hmxhB1Tc4CORPo1LZlRu_50Q&oe=6A12EB22"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4otV0uGbCAQ7kNvwEM_17x&_nc_oc=Adq6vaxz9JK1RfakBQXNj4Fo7ByYMzR19k3vpxysQEKOAvaPxRw22ScabiGaZ28My0Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66YdLdVG1uUpjhNXeqIfHPGVe83jtf_flH0SMv20i8LQ&oe=6A131FBA"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Uk0c4I8I84Q7kNvwEeE3Bq&_nc_oc=AdonFrhc_h5EQCCvjjEbIUjYWEaFEs_QJ3yXkmHw6wk-dw-EN3oXGTJ-uJt7QbXQwJ0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iWhstQmtGeKCGq4D3pjwm0W2LtUHhBH-EWjporzLBEQ&oe=6A12F72C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXoOdAx6c1QQ7kNvwHW0fpn&_nc_oc=AdqoAj8CztKgyP7l7hTHxMhaOB4_wyCrqT7lutYiEodFbLXmfJQBD0mTCRFQZqbcEg0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xY2VXJIyroMqbN86V3FCVqkU2yCKlU9uOjYj-w2-c6Q&oe=6A13045D"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGQJPSG8K5wQ7kNvwEMCB5K&_nc_oc=Adr58HNVVUz84uff-Ci30cfqIFUgEky3aPf7bnkUmule8K5s8OWJAFwWVLMPxPJxeAQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M9D_Pop4rFBWrTlSstavs4FfA2l6jjqOPT-S7ijG5fQ&oe=6A1317E1"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
LXgPD5e2YKOgG0dI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8RDwcooHaouTy_K1-bZ98qTRiAHt5LAYAGOZu7B8OtQ&oe=6A2C0BE8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2H3YWmwmtcQ7kNvwFMUDyO&_nc_oc=AdqMn7pA4Q6oqiJgFuneicy3uHpnl0tsHHP_unGWhLfPJYkcHyzU5D2oNt19ZOa6lLc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pWBUIzYh0i_KeltasMBxn2TA6jwJC4x4Uqt8MLbtWQg&oe=6A2C2FE2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkjTigAFevIQ7kNvwHVF8Up&_nc_oc=AdofYYGnM72diiQZomg_y6Vuwou_6Ru54pcCx8neP7QQdEW7eW9pkCSuNmDlIuMcj0I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Jy5q1GztzHyGP4JcLaElKQ531Yz9hbMVeHeqpEhC5uA&oe=6A2C2C3A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nxntg-qt_3QQ7kNvwG8Eg0l&_nc_oc=Adr_w9X_WkFmcOf9nWoMdWaKIPBeqli8LWrx_CxvFzoM665asB2Q0g7PdsFi8QiASXQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L4fWv87DxwsKgIdD1u-lPM7CzST4aHdHvNW6uFmZu-Q&oe=6A2C03AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ybp_g0XYAtYQ7kNvwEE_oo-&_nc_oc=Adq1radRI-nGiqkGKyrM73eRlNiwaoMwf1_KaD7eIfYaYpI-AV770cOmL9jewbE5pEk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9QzrRhA4TDuyWjtem4WLjeKmmDuchhcxvHHtJMcIh_g&oe=6A2C10DD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3ZhMRAgEjMQ7kNvwFjW9TJ&_nc_oc=Ado4J6tMwZgbYhRpi0BRiQ354HWC68UFuJal_0K5Fo2BcDobg-aVD7TCpN5K7M_ma-Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VdW-GwAx4PiU2ddaBDgLZ3iGohkDPZuZJ2ebUGfGRxg&oe=6A2C2461"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
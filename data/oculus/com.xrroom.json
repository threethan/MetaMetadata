N1B4MI6zOUNMBVzjR2xV30XvY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY9jU0gLc8L7NCHCAYi5xw4FqV5IwLIeV3uc-VGuogtA&oe=6A8EEC68"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7GJebihWcQQ7kNvwF8sFrS&_nc_oc=AdquBGljie4XS-0cc2h-k51tnw5_e0o5Bg73f60kIp1l4oSwl_OeRT2GXVgo3NJ2uP4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYzyXnQIQoslklleAnDzOUB8brAG2a3x1ItHrdQNOOaQ&oe=6A8ED822"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3LBw9_9K2sQ7kNvwFF3sc7&_nc_oc=AdrPob_uRpByrATQWyShCySxjaqL2Jo_hc1vLmjg6JkXFRSreesMt1LYa8gXGmaUC5M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHso8wV0SRads3l7Dw9XkEwB-9BpfWqHkZHHUmiO-__ow&oe=6A8ED47A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcDErUsrQGMQ7kNvwFeBQ1Z&_nc_oc=AdoUvVpYE5e44arzhUPMpjMB1CYvKswSO7e3gOvXQtvHaC6CqNT9CpVZosOG9M1CLoI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUbD95uHgYEkF-MEqK8jyKFVCAk_-exYU432gkfP7q0w&oe=6A8EE42C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTvHUT8Z3_oQ7kNvwF0yDDM&_nc_oc=Adpno5JpeTDxBtazl2rvtsWusPDGCLbhvuEqRaoYdrvNkS9lQkI-UKBqgvGvr-vuP1Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9UmM83xXg9UH1qmwwyazQsYjrUOAKLVfc25PIoUq8KA&oe=6A8EF15D"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lB3-rts6qvQQ7kNvwG8M5u7&_nc_oc=AdoBp5-k6Z62VZDWx7ti3LLJSf2N4xy_4tv3JXMALtEO1RLrV2xv3vOulIycy7RuLjs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSZh4b2Hg8IQkR3SD2MvA2CnPAIu6n3JS3ovRFhJN9Iw&oe=6A8ECCA1"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_typ
uyroRVPjPGb0V4Pc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K5K63TKlPTAk0hYSIhqmQdKnTMS26F-rk4LZDTzVvSQ&oe=6A0F0AE8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXcEKCNCxcMQ7kNvwHrGxgo&_nc_oc=AdrHOSnY3enWf_E1iE_STmmkeWz3EnKus4af-gxybEqqcOuM42ZzH5wZr1PQATGJ8HY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UO1NbPiE-7pa_21WopXFhdmbqcG9YyghgOs_TwAuwIQ&oe=6A0EF6A2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15T0agwiMzsQ7kNvwFrvNyh&_nc_oc=Adr1-oIAIBuWeE-Gl5MDTN2qqGWEobWdlse1D_lNspbhy0c2TrvD_5nqGxcMNb-fmuo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z1PW7evA4_7WV9VQxT0S38DAV1RGy6tMvnAnabM0ZeA&oe=6A0F2B3A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9TL-RwzoUQQ7kNvwHXXgg7&_nc_oc=AdqIgjQBzof5fV8Eu7KBPEDpib4dyO9QsUhnD2ImMo_qTW8-S2lTjlaO5ffZgbpCJHc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YWZ3Qn2HNkD-p7WsSJ3_2TQhBCXbG6Ta0Z8zswPxjQw&oe=6A0F02AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZquMIWsVj3wQ7kNvwG1Al0E&_nc_oc=AdpiZrc-QENEuVn56i0kOlj8fL7pwsSohiwIMSGSEf1oEDOTCGlVGK_bBh6z-36b1EE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J7nqu8PRs7IWxdOwme5XZjvxqpcUkcx4KINIdzKm7RQ&oe=6A0F0FDD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3x53fBc1PREQ7kNvwGuiqiF&_nc_oc=AdoEx20Oy_VpfEz-uSEdTzYyYUvR0Rmnt14PRnS25Dp7qXoplZ1QczUQWPtFfw6IFoo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nYi0MKnmX7UV5Scp2NfqMcGk8mG5GUw0kgmx7tjCFBA&oe=6A0F2361"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
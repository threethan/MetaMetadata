LG_wIUaYr5Nq-FxQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzBq928WGEbQtlRWtwVppbBRY5fP-H18jw-GfF9puO7g&oe=6A675F68"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIP3DL3cGeoQ7kNvwE0gu9D&_nc_oc=AdrL9rSMbDURprXihY7nfIbJpokA4LLr6PlftFhGSNtTp9h0Yctru9KHvAg2eczAjG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMTeqq-2RzaW5Rc7S5sdko9D2GPIRCDUajLTUUrfFf3w&oe=6A674B22"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utHhVCnAHRcQ7kNvwE9Fh_P&_nc_oc=AdqMVoj07v1e4PFcrOTFqRVEHlzjRHJQvaS6GKj-GDDQgwYPa7Q23CT47YUBUFZH8e4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw_lKzWOyJdcwXULgeM62-EW1-2PYXcIg6iyrCzBQGng&oe=6A67477A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC8ocmkIRbIQ7kNvwHhVbLO&_nc_oc=AdrG9bKQ6HU5YjUxY1epL9XzQhK8Ykxg6SdQGoezrNSBd6pz-LvYj_F3OWQNjI7MbxQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVjoXlh9Lq8NTHedevR2p7ddoM-l8PLC9fr-9q7mTJmw&oe=6A67572C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Uswz6v-s3cQ7kNvwFQtPyn&_nc_oc=AdpKp5Vm11lTXzqMgMHVnYAZcyn3z8qdEI2ospy0QjqqpmkKxS_-Li8Eu7LP2mqBMs4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0DFLpKjuRAOc-QFLoeDSAyCzHOcWJ4XaIpUbXjJKK9g&oe=6A67645D"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osREuEBsN50Q7kNvwFTOtEa&_nc_oc=AdrqNt6xkIez16gYuQ59qmdeyAWsX2EfZlrxFBenlWXAMLT_8kBdVBBWxdJIYaQS-_I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAF5PWeNPyRih-_Qk7qlgj8wtzk6rYsIUo_2ftpi-lzrw&oe=6A6777E1"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
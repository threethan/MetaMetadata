KBEIXW9NOgwm3Gw4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoYqFTSnuTv3caJy109f6eSsnSD0AquGtDWoV7rpWsAw&oe=6AA2B2E8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4zTXqCmLqoQ7kNvwEFjAoN&_nc_oc=AdrWA5Hp-g8yAdz1NIADGwgg5LKR59WpL5_IVJs-X4CT726vYTTeJPheOjDfZE2ejYk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKifuELEmgEcJ74ahvvnDQ0c961TGfd3PV9koRgFBn7-Q&oe=6AA29EA2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvn2b_pieUAQ7kNvwEbZ7MK&_nc_oc=AdoObkKb8wKhGT7ZGTXaaqluHB0r2i76DGfkakcd3iknplQC_SVlXuM_Kqh8odq6JSg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIev_pfTOWmUEdt8HjS9jFT5gauJ5cP0r9KqAWGpOaVGA&oe=6AA2D33A"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5p_lT9VyoMQ7kNvwEmIUO8&_nc_oc=AdrPyL9m7YcbphmmPPw3hzmdAoVu5DDfdPEfAw6SSxRcdDEtaFhNiUhMr0ulJ79TzZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI6ojr6W9xBorIh28eJdaw1gKaJrdxjnzm6mQ-5uSKng&oe=6AA2AAAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tjJiavDf4kQ7kNvwGCJoPw&_nc_oc=AdrO04QqoeS9OXQ5wHgRSDXc52gmNslxqjlsr3y0YT1OW-r5Ccc8cie5XeYeE7-1bfk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJng0EKQt5M2d3lHzInSPz8fiHFhAlTT1Ugc2ra6iFkKQ&oe=6AA2B7DD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3k7VO7lzuIQ7kNvwG0sWK7&_nc_oc=AdoI4qfxEWVwCcXQx4S3hlogPmWRkpudcoAnnnO_B71f1ShuWCIRjhJL8POY9tKTXrE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLim3k47hwEOB_hdGToet-979q2oJie9mRl3AfJP-cLlg&oe=6AA2CB61"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG
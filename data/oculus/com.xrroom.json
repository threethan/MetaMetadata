=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx653qAx6_igaqDUER3Tr598n49g8XAxjTv_clZTG61vw&oe=69BFF0E8"}, {"file_name": "screenImg2.png", "id": "1680973372360168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982529_1680973375693501_4330847431798606563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zx27iTV3eAQ7kNvwEHI2tp&_nc_oc=AdnEWHfqnktvykD0-6Y0mwEk9aD8JdFhHBykaL7Ty2VVjMZKkWzs3F869c3MmHzAcm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsXuBGLfcoaMJHuhHYmrTHTqyvp9RMX414WuqsB40g8w&oe=69BFDCA2"}, {"file_name": "screenImg3.png", "id": "578064184315048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57574726_578064187648381_7566851642217159551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLkYTrhNIlUQ7kNvwEkYaJz&_nc_oc=AdnLfmMB_1fb7NJFqz6-yzDrlZyGl3KDEvpJjnEZfDi0Ww0SJfkrYJiK4k32hZqO0pA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1rxBPy1u3p9JsnXPFaY9D_PaAK7rfXaQQrL6xMjQ8AA&oe=69BFD8FA"}, {"file_name": "screenImg4.png", "id": "207578008766424", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294239_207578012099757_7643644066453232291_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GR9f8ESxExUQ7kNvwEHWJSf&_nc_oc=AdksTdeex_ioH7FfNHIKE4j2h1UyzTlInLZj2K8fybZxrF3ArIxr3OIWIh8qNai_aBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwOBnaOq9r2sScGC9W3EDwj09wX2-cA7WkA-uJ3wqlg1A&oe=69BFE8AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "1272843143464404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035377_1272843146797737_8383428287429128361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRdTtA6JZy0Q7kNvwGyWqGv&_nc_oc=AdnF1CLCY6a-hQtBunxGMSrmXd8kWfjdhYl_xzcqzDzKOF-Q-hWjmGP4xnlVuQZ9hBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIDEPn6VpueWE0n1Ywick87zCd1AINFcbDi1RwmMTqeg&oe=69BFF5DD"}, "display_name": "XR Designer old", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n (More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay\n", "short_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use."}, {"images": {"nodes": [{"file_name": "coverArt_1080x360px.png", "id": "9546402602098530", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240095_9546402608765196_4519594928395556476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bpP57zcEa0Q7kNvwHMQkuf&_nc_oc=Adki_w22ZB34mR7E2rMwR9EXluXOqAgnPHjtbDHpqLpp7-e7zDrsJ9NSD--UcJtxz7Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzEuzL1UA85TSbY6bLIFmtCRktGlyqAym5Pom-S2DFgdQ&oe=69BFD121"}, {"file_name": "coverArt_1008x1440px.png", "id": "6317703311616142", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculus
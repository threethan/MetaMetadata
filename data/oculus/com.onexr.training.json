f20f&oh=00_AQGshxgD_mET1yLw0bFt9xCMxyjg5LWhwwfFlRddl_4_dw&oe=6A844FC9"}, {"file_name": "WhatsApp Image 2026-03-19 at 9.40.54 PM.png", "id": "1331098209065394", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620875_1331098212398727_2949450091728524983_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-6H37TkvAMQ7kNvwFZP21S&_nc_oc=AdqFyzpGFFIxAujejFjxexACHJ6HSjz0Ws15zpMQq62UygNi9HRiV2psXGpMWtornYw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxEc_acNFe4NTy6F1UsDLhNDu3UG5pzaNvCBEUuVwwYA&oe=6A84519B"}, {"file_name": "WhatsApp Image 2026-03-19 at 9.40.53 PM.png", "id": "2060945814765494", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617850_2060945818098827_6674766902105568190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0bDXK9pajYQ7kNvwG0Q8OC&_nc_oc=AdpjEJLGtwd9LwX6-up1Oy7LspRrzfgjyUab-VSIUEGPTMewGfMNjxUq9soCO8jZkBM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_oYv5EhZ3g2oCr8ShLFr1cUwaDQx8TQppQHm12RjB8w&oe=6A8458DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "1XR \u2013 Immersive Training Platform", "keywords": ["training", "simulation"], "long_description": "1XR is an immersive virtual reality training platform designed to deliver interactive learning experiences in VR.\n\nUsing realistic 360\u00b0 environments, users can explore training scenarios while answering timed questions and completing guided learning modules. The platform is designed for educational institutions, corporate training programs, and professional development.\n\nKey features include:\n\n\u2022 Immersive 360\u00b0 VR training experiences  \n\u2022 Interactive questions integrated into video scenarios  \n\u2022 Real-time knowledge assessment during training  \n\u2022 Secure user authentication and progress tracking  \n\u2022 Cloud-delivered streaming experiences  \n\u2022 Tenant-based branding for organizations and training providers  \n\n1XR allows organizations to deliver engaging and scalable VR training experiences directly to Meta Quest devices.\n\nThis application requires a user account provided by an authorized organization.\n\nFor more information, visit:\nhttps://urview.com", "short_description": "Interactive VR training experiences designed for immersive learning and assessment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.urview.com/privacy/", "developer_terms_of_service_url": "https://www.urview.com/terms/", "publisher_name": "URview Ltd", "support_website_url": null, "website_url": "https://www.urview.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26341205112142614"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "963650353297573"}]}, "baseline_offer": {"id": "963650353297573"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779955140, "status": "PUBLISHED", "id": "963650353297573"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27611052245157888", "version": "1.0.7"}, "id": "883090771094335", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "i
A"}]}, "id": "1290397493106268", "locale": "en_US", "screenshots": [{"file_name": "IslandScreenshotCROPPED.png", "id": "28331500576510763", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/786297305_28331500599844094_7684602216636997423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvlBLQsB6xIQ7kNvwH0zntI&_nc_oc=AdqLX1LMafzfHj-qKnMSRQs3nv21FzAQ2Zwl1BXU8vWA_AsWtGGmComJAuprRxPZIao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv3kYcws7a2QXb-uTVbYw9fyCfO7l9_BzQCjLzd5GW_A&oe=6ACA6D84"}, {"file_name": "CityScreenshot.png", "id": "1715233499769279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831569_1715233503102612_3912162231342330060_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PjIYIzQZ8gQ7kNvwG2NCYM&_nc_oc=Adq1pKJh4bc6HVs1hqe0zth9PeV4vhVI270ZWgtxahOQCIijk5KplKjiFBOQYxlKtPw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_qgfLE08nmGwXXIS0ODsL2JAPRzphls7YEwayzTtL8w&oe=6ACA7547"}, {"file_name": "2.png", "id": "1164681481879379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393491_1164681485212712_3183750633539451625_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Qp5qzC7zlMQ7kNvwG0JKI_&_nc_oc=AdpnteOw61XR3q_HdLuyqwPhn9l5TvH1MwVtWCdHoX9FEMJVMDohS371VeVgh_BmAcE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMs6LllM1OerVR2FrFNyqT8ys_dMtnPPxAauwHggJV6Qw&oe=6ACA6258"}, {"file_name": "4.png", "id": "1266580711102696", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391982_1266580714436029_9036663407339393344_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2duFBgtdtnAQ7kNvwFZoXAP&_nc_oc=AdqyOxR20rpGP-2N_Ggg4mi3XQyMWDsr94MMKfG4pYNgJ8GlrRV9jMTTnNU6Sapo29s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIZZst3jDEGE4YWKhMn_hOYOXCTvoCXl4Xk98p7funYA&oe=6ACA76E3"}, {"file_name": "5.png", "id": "661124846381116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393432_661124849714449_4071081856826882501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2c-0JFbPKQQ7kNvwH5pUWL&_nc_oc=AdqULBlIX0IDWjR4QQe4fFa4Apg4m1UlbffxL5AkfpLKlstA6w1Jj2LGjcbfW91Bxo0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgJQnph_2lcjCTxDwtPSymFM3xMWIj5JSbdv-CglSBow&oe=6ACA5425"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_1440p.png", "id": "2297543560770085", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824741_2297543567436751_2887131003932585789_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QImbG-4bwJMQ7kNvwGyrwRU&_nc_oc=AdrqkziWk3tZ4_YKUdLq8itwkeMPOe5UvrF2Olng4zXvolLwJtGz42pKPgpH5Q50TjY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtU3JXmqKSVwpfsslTPchNiThs2ZZSJVLP_HqjxafA5A&oe=6ACA7622"}, "display_name": "Scamper", "keywords": ["rat", "horror", "multiplayer", "coop", "scary"], "long_description": "**The timeline tracks have split, but you can still scamper between them.**\n\nYou can adjust the frequency of your energy to experience the different realities each timeline has to offer.\n\nExplore environments resonant with either high or low frequency. The frequency is never exactly the same, causing each environment to shift and feel slightly different every time you enter.\n\n\n\ud83d\udfe2 **High Frequency**\n\nFilled with tropical flora, fauna, water features, and underground caves waiting to be explored. Nature is alive, and the time of day is always changing.\n\n{1382220617312349}\n\n\ud83d\udd34 **Low Frequency** \n\nDescend into the darkness of a sewer system. Above it lies a cold city haunted by the echoes of civilization.\n\n{1100305482377869}\n\nTo *scamper* is to move quickly through fear or excitement. What will you choose?\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\n\n**Instructions:**\n\nYou are a rat.\n\nYour fear response will be tested.\n\nYou will find an environment where another rat is lost.\n\nYour mission is to find this lost rat and help it escape.\n\nYou can go alone or with other rats.\n\nYou must move quickly with your hands and arms to guide the lost rat to safety.\n\nYou may begin.\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014", "short_description": "Move with quick steps through fear or excitement"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/1b7bff2b-076c-44a2-b462-db150a651fff", "developer_terms_of_service_url": null, "publisher_name": "Bezbro Games", "support_website_url": null, "website_url": "https://bezbrogames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27436200599387370"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823949_1441155613857482_7386535709232034326_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_V_P9pPcA20Q7kNvwF4Zhdp&_nc_oc=AdrSFnI01Cy55a_BFGg5DoZcALxTenj0e6P_GIXtFc0FPrGG8OSfRtaTP8u3EIUb_t4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZmgqkLNRLqKCrDSiatm0Sj2nm6MWTf_cIJCx815keiw&oe=6ACA53D8"}, "is_concept": false, "is_t
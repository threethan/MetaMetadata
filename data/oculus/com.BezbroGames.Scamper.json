&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHyUkVRDERoQ7kNvwG4mXzS&_nc_oc=AdpPZ7CnBE8GOoNmGvA0eoDcrgZifRs3V4pM-54fYyGVYS61wZlShJtsZPE6TzFMLFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiXXYLGmUEjO6YaA0oiW3Cs-vheqoFW1VsONWYZQePjA&oe=6AB3EAA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_1440p.png", "id": "2297543560770085", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824741_2297543567436751_2887131003932585789_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esxiCOXl_nQQ7kNvwExBrH2&_nc_oc=AdqFcOBw9TKJolybXDgROmGu-KwcJAPaVob3kspypR2xd7iE30ZCsPReB9ssTnuvk5Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoR32tA80TmZYxNMWoAzMbC6UZWOMsElA5IpFj8kRV5w&oe=6AB3D462"}, "display_name": "Scamper", "keywords": ["rat", "horror", "multiplayer", "coop", "scary"], "long_description": "**The timeline tracks have split, but you can still scamper between them.**\n\nYou can adjust the frequency of your energy to experience the different realities each timeline has to offer.\n\nExplore environments resonant with either high or low frequency. The frequency is never exactly the same, causing each environment to shift and feel slightly different every time you enter.\n\n\n\ud83d\udfe2 **High Frequency**\n\nFilled with tropical flora, fauna, water features, and underground caves waiting to be explored. Nature is alive, and the time of day is always changing.\n\n{1382220617312349}\n\n\ud83d\udd34 **Low Frequency** \n\nDescend into the darkness of a sewer system. Above it lies a cold city haunted by the echoes of civilization.\n\n{1100305482377869}\n\nTo *scamper* is to move quickly through fear or excitement. What will you choose?\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\n\n**Instructions:**\n\nYou are a rat.\n\nYour fear response will be tested.\n\nYou will find an environment where another rat is lost.\n\nYour mission is to find this lost rat and help it escape.\n\nYou can go alone or with other rats.\n\nYou must move quickly with your hands and arms to guide the lost rat to safety.\n\nYou may begin.\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014", "short_description": "Move with quick steps through fear or excitement"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/1b7bff2b-076c-44a2-b462-db150a651fff", "developer_terms_of_service_url": null, "publisher_name": "Bezbro Games", "support_website_url": null, "website_url": "https://bezbrogames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27436200599387370"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823949_1441155613857482_7386535709232034326_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_7Rvy0o4KcQ7kNvwHVWUxy&_nc_oc=AdppuzSJ62rvwKA5qCXNir_Dvmo77ETOp2DUMBq6GQuo7JoqH1TYu8yegfEz2QjnsmA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR7tDlrUATNbv_ZuGdTuY09VuK5fwlBtlYas15zNZu9g&oe=6AB3EA58"}, "is_concept": false, "is_t
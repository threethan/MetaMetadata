A"}]}, "id": "1290397493106268", "locale": "en_US", "screenshots": [{"file_name": "IslandScreenshotCROPPED.png", "id": "28331500576510763", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/786297305_28331500599844094_7684602216636997423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyZR-rI11MoQ7kNvwFAUfIA&_nc_oc=AdoykN052kYZo1oM72JmMAZnHUHNkP3j2Ab-QIKid2xfUJQso4qKAIyrthMRVSOB9X4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKV3JOYsndb1Nz4D4qScSPzgz_AfO_Iz5h_2Of6KdAgg&oe=6AEA1184"}, {"file_name": "CityScreenshot.png", "id": "1715233499769279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831569_1715233503102612_3912162231342330060_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5BPqvwwD20Q7kNvwExTirR&_nc_oc=AdqxIPvNjeOn2mhuBqQoGhu2wgRjDmQEoTev6_AKKdAl0eLPqYrT2XAEKQP9HeCR9KQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStJDOFKz2YoupOnpscdkQZDVnIpDcYAcsDncie0j1bMw&oe=6AE9E107"}, {"file_name": "2.png", "id": "1164681481879379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393491_1164681485212712_3183750633539451625_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwnkSCZGqKEQ7kNvwGYq1HW&_nc_oc=AdpV8oOMQQs9BuiFVqsgV1EfRXWj_DVsMYZRkcax1oUyKqZLwEXCzwxsK9_nTrw9cSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQRdsIv2VPO6qJQum5f3wb-meXPnnL12yXELvbdclDyQ&oe=6AEA0658"}, {"file_name": "4.png", "id": "1266580711102696", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391982_1266580714436029_9036663407339393344_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tmcA7qt65wQ7kNvwEO-aoS&_nc_oc=Adr8OoyGcmIOKwLotZnc5KPZ3KJpyXGdJFIKBYFJ82HRpzsYr8a-FqcVt7vHVuMBm_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYShjRITLRgLVRv4Rf24jEdCeFaud2m5NfSVioeOn4dA&oe=6AE9E2A3"}, {"file_name": "5.png", "id": "661124846381116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393432_661124849714449_4071081856826882501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evuJhs08Qk4Q7kNvwFYwLmM&_nc_oc=AdrNCsbsARLbtadBDPSzve4r6-kNPYEhm7xkm8Q_NQCL2Xkj6A58igH6T2Tdo9w_kyE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlnR9roGevcMLlJbTV9uEYN539DhdsIKADbAKhaPF2mQ&oe=6AE9F825"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_1440p.png", "id": "2297543560770085", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824741_2297543567436751_2887131003932585789_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRuxeSfajkcQ7kNvwEERj59&_nc_oc=AdpAAdYZTZnvPoS2NYE9srXxlgxV68LjaVFyfw4zExvn3-NbTBMYUClgj3krWzh2ir8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYJQLw3vaeCJsbmnt-2LstGVNr4zzSExdjlnlP_ocphA&oe=6AE9E1E2"}, "display_name": "Scamper", "keywords": ["rat", "horror", "multiplayer", "coop", "scary"], "long_description": "**The timeline tracks have split, but you can still scamper between them.**\n\nYou can adjust the frequency of your energy to experience the different realities each timeline has to offer.\n\nExplore environments resonant with either high or low frequency. The frequency is never exactly the same, causing each environment to shift and feel slightly different every time you enter.\n\n\n\ud83d\udfe2 **High Frequency**\n\nFilled with tropical flora, fauna, water features, and underground caves waiting to be explored. Nature is alive, and the time of day is always changing.\n\n{1382220617312349}\n\n\ud83d\udd34 **Low Frequency** \n\nDescend into the darkness of a sewer system. Above it lies a cold city haunted by the echoes of civilization.\n\n{1100305482377869}\n\nTo *scamper* is to move quickly through fear or excitement. What will you choose?\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\n\n**Instructions:**\n\nYou are a rat.\n\nYour fear response will be tested.\n\nYou will find an environment where another rat is lost.\n\nYour mission is to find this lost rat and help it escape.\n\nYou can go alone or with other rats.\n\nYou must move quickly with your hands and arms to guide the lost rat to safety.\n\nYou may begin.\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014", "short_description": "Move with quick steps through fear or excitement"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/1b7bff2b-076c-44a2-b462-db150a651fff", "developer_terms_of_service_url": null, "publisher_name": "Bezbro Games", "support_website_url": null, "website_url": "https://bezbrogames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27436200599387370"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823949_1441155613857482_7386535709232034326_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfjJ_xlWlIQQ7kNvwG5jpN6&_nc_oc=Adrzzl15UJXvyyX1krhsRs31vb6OXCT2sZq_42IaXuF_rdYe3Kd4uvULrdUV8oVZUUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfyclDmC5K_zIQZGYzZV-F_0IlXQq_jeDr0JNdWErduA&oe=6AE9F7D8"}, "is_concept": false, "is_t
71-25/38974871_658656276308886_947163137306463690_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hXa7H1r_joQ7kNvwHTp52D&_nc_oc=AdkHbnJCkIV1k9Y0DqOwtDx7qv4DsIPN_7AXUFQnJTpamZxK5TdUJjuDKh2_RUXTf48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcLYNbnjIn226qWU4iV5P0GbPW-kxh4BsVlMcdNSp8BA&oe=69BFD36F"}, "display_name": "Scamper", "keywords": [], "long_description": "You Are A Rat.\nEnter into a dark and complex sewer system where another rat is lost. Your mission is to find this lost rat and help it escape.\n\nYou Are Not Alone.\nSomething lurks in the shadows of the sewer system, and it is always on the hunt for rats.\n\nYou can scamper, climb, and leap through the environment with just the movement of your hands and arms. You will need to move fast and figure out how to get around the vast sewer system.\n\nYou\u2019ll need to use clever tactics to guide the lost rat, as it will react to your movements and actions. Will it follow your lead, or will it run away out of fear? It\u2019s all up to you.\n\nIt is time to enter the sewer.", "short_description": "You are a rat. Enter the sewer system and help a fellow rat escape what lurks within it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/1b7bff2b-076c-44a2-b462-db150a651fff", "developer_terms_of_service_url": null, "publisher_name": "Bezbro Games", "support_website_url": null, "website_url": "https://bezbrogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": 
c_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgqF1ix2ZQT-wSY96Dx-jVVToQbAimu88aSjYdv8l9gw&oe=6A95C074"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover.png", "id": "658656272975553", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974871_658656276308886_947163137306463690_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwPsED1gOo8Q7kNvwEG0Di8&_nc_oc=AdpORbSlEM5abknuSOxwPMVCQEzKHRbZKBqigN4gJEacJt92MWQK_SdNggnpL2j0jbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqH8Gu8uypH2ayOYcmSK4ptHhZ3ToK7_6UAHpWSqRK6A&oe=6A95D6EF"}, "display_name": "Scamper", "keywords": [], "long_description": "You Are A Rat.\nEnter into a dark and complex sewer system where another rat is lost. Your mission is to find this lost rat and help it escape.\n\nYou Are Not Alone.\nSomething lurks in the shadows of the sewer system, and it is always on the hunt for rats.\n\nYou can scamper, climb, and leap through the environment with just the movement of your hands and arms. You will need to move fast and figure out how to get around the vast sewer system.\n\nYou\u2019ll need to use clever tactics to guide the lost rat, as it will react to your movements and actions. Will it follow your lead, or will it run away out of fear? It\u2019s all up to you.\n\nIt is time to enter the sewer.", "short_description": "You are a rat. Enter the sewer system and help a fellow rat escape what lurks within it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/1b7bff2b-076c-44a2-b462-db150a651fff", "developer_terms_of_service_url": null, "publisher_name": "Bezbro Games", "support_website_url": null, "website_url": "https://bezbrogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_
A"}]}, "id": "1290397493106268", "locale": "en_US", "screenshots": [{"file_name": "IslandScreenshotCROPPED.png", "id": "28331500576510763", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/786297305_28331500599844094_7684602216636997423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MigS2f9b-ZgQ7kNvwFUNBcW&_nc_oc=AdqxoxezTa4OcItvQiMU2om804dMjCAy00-TET9FAyCKN7QGlcvP849D4JgVp59sFGE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREWiWCX6C_KorjNeX4hWx7zrj4xxiKLPW54H8eauyv5w&oe=6AF9E384"}, {"file_name": "CityScreenshot.png", "id": "1715233499769279", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831569_1715233503102612_3912162231342330060_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8bidH7bp3wQ7kNvwH8omev&_nc_oc=AdrGZtcQ2_eI-dNsvyxTRC0kghARNXhUsNzlLmdanprdb1rNlf6dLiT9y-Qm9zRXzes&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSycrNLAIpnMVnPff1JfnfgCO5b9n24u60NWcOmBq0ffA&oe=6AF9EB47"}, {"file_name": "2.png", "id": "1164681481879379", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393491_1164681485212712_3183750633539451625_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjDjzM2yDbgQ7kNvwGA36FU&_nc_oc=AdpwwatOeBUW6hpoq7V9g_GacgUp8c5NiIe_h1lTncQdHrgDQEz_A0-a_KDEYSOILkM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScLRQOOtQsv4WlzDU97pm1Diuqz7h-xl8beCgaaRn7yw&oe=6AF9D858"}, {"file_name": "4.png", "id": "1266580711102696", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391982_1266580714436029_9036663407339393344_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E59-twY2qvMQ7kNvwFU8gGr&_nc_oc=AdpOg0gG2OvWszoYfalY7tzDbIgZo1vk9AuIF8-ZbIGHGxOmcvwCUv0Vwm06TPYMu3E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgV8NYkKyYHnLqv0_S3Z_yq0okqa9Nvyx3p8k3GNBLIA&oe=6AF9ECE3"}, {"file_name": "5.png", "id": "661124846381116", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393432_661124849714449_4071081856826882501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uG68-9VGNgoQ7kNvwGNgyUq&_nc_oc=AdrqEVri569VPqg1PQbWDMjsXqRT3wU3IyQvwt9vbY8D77fo6rC4nC1WngsBGAujn7k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLLMaXQQvGGMdb9aLB_o_ORDQGaQ-aGiu-tYDtzThw4A&oe=6AF9CA25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_1440p.png", "id": "2297543560770085", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824741_2297543567436751_2887131003932585789_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wibi9cdvcHAQ7kNvwGFkncC&_nc_oc=AdqN2xoRab7VoBgQpqWou9CqlOq7bQs5SNgo0p4Ckd2dQHhCAga-yK6HAqBH3VhItAk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyTYHp3dC5Ut7BybY8z8MWmPCjyeu6CsUxTlKOg6KOEg&oe=6AF9EC22"}, "display_name": "Scamper", "keywords": ["rat", "horror", "multiplayer", "coop", "scary"], "long_description": "**The timeline tracks have split, but you can still scamper between them.**\n\nYou can adjust the frequency of your energy to experience the different realities each timeline has to offer.\n\nExplore environments resonant with either high or low frequency. The frequency is never exactly the same, causing each environment to shift and feel slightly different every time you enter.\n\n\n\ud83d\udfe2 **High Frequency**\n\nFilled with tropical flora, fauna, water features, and underground caves waiting to be explored. Nature is alive, and the time of day is always changing.\n\n{1382220617312349}\n\n\ud83d\udd34 **Low Frequency** \n\nDescend into the darkness of a sewer system. Above it lies a cold city haunted by the echoes of civilization.\n\n{1100305482377869}\n\nTo *scamper* is to move quickly through fear or excitement. What will you choose?\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\n\n**Instructions:**\n\nYou are a rat.\n\nYour fear response will be tested.\n\nYou will find an environment where another rat is lost.\n\nYour mission is to find this lost rat and help it escape.\n\nYou can go alone or with other rats.\n\nYou must move quickly with your hands and arms to guide the lost rat to safety.\n\nYou may begin.\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014", "short_description": "Move with quick steps through fear or excitement"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/1b7bff2b-076c-44a2-b462-db150a651fff", "developer_terms_of_service_url": null, "publisher_name": "Bezbro Games", "support_website_url": null, "website_url": "https://bezbrogames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27436200599387370"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823949_1441155613857482_7386535709232034326_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3wI5XFgYvYQ7kNvwFzKARe&_nc_oc=AdogibFMv7TR0R2UQlconCR1mQlCe5j2j2qzdOYSaPFAncc0szrEAXLkN1zClyOdQSA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1JXpPPP9d8LNOyNZuzvXyGW0QPYVeU8JlHmziG1r_2A&oe=6AF9C9D8"}, "is_concept": false, "is_t
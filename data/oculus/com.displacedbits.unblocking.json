ss=7f20f&oh=00_AQTNdIJ_EAauEOkwmkm7rcIoHJjQSZRMIEjf9V4s3fbMKg&oe=6AFDC295"}, "display_name": "Unblocking", "keywords": [], "long_description": "Unblocking is a casual VR game based on dragging piece blocks to clear lines/boards.\nIt supports 3 game modes:\n\n- Puzzle (multiple levels to complete by clearing all blocks on the boards)\n- Relax (time based mode which extends its countdown based on the number of lines completed)\n- Arcade (make lines of different colors using all the available pieces before the time runs out in order to avoid the loss of lifes)", "short_description": "Unblocking is a casual VR game based on dragging piece blocks. Players need to use those piece blocks to remove the blocks displayed on boards (unblock) to score and get the highest score possible (king).  \nThe game presents 3 game modes: Puzzle, Relax and Arcade."}]}, "developer_name": null, "developer_privacy_policy_url": "https://unblockingvr.com/privacy.html?v=2", "developer_terms_of_service_url": null, "publisher_name": "Displaced Bits", "support_website_url": null, "website_url": "https://unblockingvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8388860327909123"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031561_788991672426728_3581522321251046416_n.png?stp=dst-png_s360x360
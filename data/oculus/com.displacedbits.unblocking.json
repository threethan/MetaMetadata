nt colors using all the available pieces before the time runs out in order to avoid the loss of lifes)", "short_description": "Unblocking is a casual VR game based on dragging piece blocks. Players need to use those piece blocks to remove the blocks displayed on boards (unblock) to score and get the highest score possible (king).  \nThe game presents 3 game modes: Puzzle, Relax and Arcade."}]}, "developer_name": null, "developer_privacy_policy_url": "https://unblockingvr.com/privacy.html?v=2", "developer_terms_of_service_url": null, "publisher_name": "Displaced Bits", "support_website_url": null, "website_url": "https://unblockingvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "567904974897088"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5462067537255098", "version": "1.0.2"}, "id": "855041548825860", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5289108477884339", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "
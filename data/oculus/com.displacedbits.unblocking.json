vlcsnap-2022-10-18-00h43m15s092.png", "id": "1509837652789379", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031325_1509837656122712_6205336813125663610_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsdHympw6N4Q7kNvwE46uzX&_nc_oc=AdpyON72FsTHuY0BLbRx-Vf_tlIH7EEomjKpQ7pghX_bLA2PX2o_ovI4ITXGfwuHquY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHE-npIIgQrop7NzWnHObMhO79beRXL7CQ5F3-t0jhWFA&oe=6A8D8744"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "999586500844262", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86619817_999586507510928_4989718642238371594_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLAv9T34ttIQ7kNvwH5VwTR&_nc_oc=Ado1gNHwNV2xK8H-ECoiy59Av90D_yRS3qRyTgbbKl5cWRsxpVsMlbZL44Da9DIcH0w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3DQHmtBjUecanLT269PiqlG5PM2OhVn9T3eUwJrqhTA&oe=6A8D7AD5"}, "display_name": "Unblocking", "keywords": [], "long_description": "Unblocking is a casual VR game based on dragging piece blocks to clear lines/boards.\nIt supports 3 game modes:\n\n- Puzzle (multiple levels to complete by clearing all blocks on the boards)\n- Relax (time based mode which extends its countdown based on the number of lines completed)\n- Arcade (make lines of different colors using all the available pieces before the time runs out in order to avoid the loss of lifes)", "short_description": "Unblocking is a casual VR game based on dragging piece blocks. Players need to use those piece blocks to remove the blocks displayed on boards (unblock) to score and get the highest score possible (king).  \nThe game presents 3 game modes: Puzzle, Relax and Arcade."}]}, "developer_name": null, "developer_privacy_policy_url": "https://unblockingvr.com/privacy.html?v=2", "developer_terms_of_service_url": null, "publisher_name": "Displaced Bits", "support_website_url": null, "website_url": "https://unblockingvr.com/", "category": "GAMES", "comfor
cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyTEg5Js8tUQ7kNvwES2b4D&_nc_oc=Adr6kiNfdTWUZKLuwCA5sQOK6XXU3gTaGwsps_NCY3SYMzmRL0w7KPuIgFxkDrb2Z3M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlWjLBzhZxwQhuU-jWhOJW-WTYglBsdL_e9Q22kv2ymQ&oe=6B09B973"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Core", "keywords": ["ape", "forest", "jungle", "vr", "apecore"], "long_description": "\ud83c\udf3f Welcome to ApeCore! \ud83c\udf4c\nA chill forest adventure with your fellow apes.\nJust hang out, explore, and goof around!\n\n\ud83e\udde9 Features:\n\ud83d\udda5\ufe0f In-Game Computer (Change your name & more)\n\n\u26d4 Ban System powered by PlayFab\n\n\ud83c\udf10 Multiplayer with Photon VR\n\n\ud83c\udf1e Beautiful Lighting with Universal RP\n\nClimb trees, swing with friends, and enjoy the freedom of the wild.\nThis isn\u2019t just a game, it\u2019s a whole jungle playground. \ud83d\udc12", "short_description": "Do you want a combination of Forest, and Apes? \ud83c\udf4c\nWell, welcome to Ape Core! \ud83c\udf3f\nWe offer:\nComputer (Name Changer)\ud83d\udda5\ufe0f\nBan System (PlayFab)\u26d4\nMulti-Player (Photon) \ud83d\udc68\u200d\ud83d\udc69\u200d\ud83d\udc67\u200d\ud83d\udc66\nGood Lighting (URP) \ud83c\udf05"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/alberto-tag-vr/home", "developer_terms_of_service_url": "https://sites.google.com/view/mostlikelystudios/home", "publisher_name": "Alberto", "support_website_url": null, "website_url": "https://sites.google.com/view/alberto-tag-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphic
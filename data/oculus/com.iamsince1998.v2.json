31", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825345_2384918035353064_6793789507179524923_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXhTPQUr6IwQ7kNvwG8HZ9m&_nc_oc=AdpNY0_Jcris2fwQWR4Wg85FKMNu-mbTVjOwc9F9G9GyNY5uhDKvrjiXu1AQjet1w_4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUR6xa_AI5XoWRDtVbAEKdbiNSFWCvFQSybSO8fAuzt-w&oe=6B104AFB"}, {"file_name": "Untitled design3.png", "id": "1706934223983608", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_1706934227316941_36807719402422627_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyjIJB4ZEQYQ7kNvwE0NgaO&_nc_oc=AdqDXMdknwFuO6AMULQ02Veo_RAXhfCz5ssGNJrENIrzEzuE5rszi3uQPh9blliv4Y0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUehKgBsKXFmO3iXdkIF97fgj-FyNOqmrrZBlmVrJglNQ&oe=6B10459B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "05_trailer_thumb_2560x1440.png", "id": "2211528986265904", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_2211528989599237_1508627809804797263_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6ZXNvEZ8AgQ7kNvwFoABcj&_nc_oc=AdpIdtEkH7msotUqs3X-pkfe2SQ3IMmZbgm4VuEMkOWET7hMjEqbr_MRwOaDVLjema0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW_m5DRdBz1cEI4tRpcrBpjPv6GIJbAB3Y5TFoeIwgYWQ&oe=6B1059CF"}, "display_name": "OrbBlitzVR", "keywords": ["casual", "arcade", "wavesurvival", "OrbBlitzVR", "iamsince1998"], "long_description": "---\n\n## \ud83c\udfaf One More Round\n\nNo tutorials. No cutscenes. No filler. Just **pure, distilled VR reflex bliss** \u2014 pick up and play in seconds, impossible to master in a lifetime.\n\nChase your personal best. Climb the leaderboard.\n\n*One more round \u2014 you always say that, don't you?*\n\n---\n\n**At the price of a cup of tea** \u2014 Orb Blitz VR delivers an arcade rush that'll have your arms swinging and your heart pounding, every single time.\n\n> \ud83e\udd7d **Meta Quest 2 / Quest 3 / Quest 3S**\n> \ud83c\udfae Standing or Room-Scale \u00b7 Single Player \u00b7 All Ages\n{27033014449719141}", "short_description": "Fling. Deflect. Dominate. Pure VR reflex mayhem \u2014 one platform, endless orb waves, one score that never stops calling you back."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/iamsince1998/home/orbblitzvr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Deepak", "support_website_url": null, "website_url": "https://discord.gg/uxGBVxMFdw", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24808716395492465"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1659543682271531"}, {"status": "PUBLISHED", "id": "1148883824970823"}, {"status": "PUBLISHED", "id": "2010765392887506"}]}, "baseline_offer": {"id": "1659543682271531"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784201040, "status": "PUBLISHED", "id": "1659543682271531"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24881042224926548", "version": "1.02"}, "id": "1294715262813585", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_b
ad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAheCZpr065beEuxU4vIYr6aIXKTvPrH8cqdZUfpO3WQ&oe=6AE5E2BB"}, {"file_name": "Untitled design3.png", "id": "1706934223983608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823802_1706934227316941_36807719402422627_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yi5aNShfA4UQ7kNvwEzLjtl&_nc_oc=AdrLMZF0wdXyfWEy6sx2PFObRA-gsOpLrLp-PTJZh72dZgHF9uTnWQsFHuuEuqk2UN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy5tyjbTNEtziNZkcZXkGRWA2RKBFJdrqpzoNFVfMPTA&oe=6AE6159B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "05_trailer_thumb_2560x1440.png", "id": "2211528986265904", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_2211528989599237_1508627809804797263_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIq6NZNJwVIQ7kNvwE1p1Wh&_nc_oc=AdrUIZulDXglVsKBUMG1AEiW5zIJcRjDmAAN3c0RLa3YN7VYnL3ri8UgJQuOI7rgp1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGmD-e4-r5yANp0cin7yX2kxvSXmPIrLI6pz6KHlTmkA&oe=6AE5F18F"}, "display_name": "OrbBlitzVR", "keywords": ["casual", "arcade", "wavesurvival", "OrbBlitzVR", "iamsince1998"], "long_description": "---\n\n## \ud83c\udfaf One More Round\n\nNo tutorials. No cutscenes. No filler. Just **pure, distilled VR reflex bliss** \u2014 pick up and play in seconds, impossible to master in a lifetime.\n\nChase your personal best. Climb the leaderboard.\n\n*One more round \u2014 you always say that, don't you?*\n\n---\n\n**At the price of a cup of tea** \u2014 Orb Blitz VR delivers an arcade rush that'll have your arms swinging and your heart pounding, every single time.\n\n> \ud83e\udd7d **Meta Quest 2 / Quest 3 / Quest 3S**\n> \ud83c\udfae Standing or Room-Scale \u00b7 Single Player \u00b7 All Ages\n{27033014449719141}", "short_description": "Fling. Deflect. Dominate. Pure VR reflex mayhem \u2014 one platform, endless orb waves, one score that never stops calling you back."}]}, "developer_name": null, "developer_
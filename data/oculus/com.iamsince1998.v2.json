jc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfmh1aH2uESFyi1rYab4nqFX6p0qcJDq2rrdq5IIMmPg&oe=6ABA613B"}, {"file_name": "Untitled design3.png", "id": "1706934223983608", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_1706934227316941_36807719402422627_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NiAIvstuXMQ7kNvwG1TIlN&_nc_oc=AdppteI6Y9dgrkGfb9bx3nTmTFb371FNZQdHkfRxY9w16V-Ms1t-kKsNTbqfX0C-4sk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTOYnDWhNiyL1LrShTFj-Mm9BtFlHlhwinQIneI8dTnA&oe=6ABA5BDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "05_trailer_thumb_2560x1440.png", "id": "2211528986265904", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_2211528989599237_1508627809804797263_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKrNVmF7v4UQ7kNvwGkf9hj&_nc_oc=AdoflxQuGNe1zHGm48jXOTCgjVZs9Be0AlXx4ZWrthLsNn9RXzatYk8WDxQjWPKoWqQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFGe_AghgR5sStMfK8m6XO2ZjXNrZq5atD53SiJ991sw&oe=6ABA700F"}, "display_name": "OrbBlitzVR", "keywords": ["casual", "arcade", "wavesurvival", "OrbBlitzVR", "iamsince1998"], "long_description": "---\n\n## \ud83c\udfaf One More Round\n\nNo tutorials. No cutscenes. No filler. Just **pure, distilled VR reflex bliss** \u2014 pick up and play in seconds, impossible to master in a lifetime.\n\nChase your personal best. Climb the leaderboard.\n\n*One more round \u2014 you always say that, don't you?*\n\n---\n\n**At the price of a cup of tea** \u2014 Orb Blitz VR delivers an arcade rush that'll have your arms swinging and your heart pounding, every single time.\n\n> \ud83e\udd7d **Meta Quest 2 / Quest 3 / Quest 3S**\n> \ud83c\udfae Standing or Room-Scale \u00b7 Single Player \u00b7 All Ages\n{27033014449719141}", "short_description": "Fling. Deflect. Dominate. Pure VR reflex mayhem \u2014 one platform, endless orb waves, one score that never stops calling you back."}]}, "developer_name": null, "developer_
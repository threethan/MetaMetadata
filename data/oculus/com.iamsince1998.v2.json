rd5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPT19EGbVn63EB3yKCfGq2NoJXSAsn7GD5HdR76JgIsNw&oe=6AC63EBB"}, {"file_name": "Untitled design3.png", "id": "1706934223983608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_1706934227316941_36807719402422627_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZbQ6FM14VMQ7kNvwFKKDeA&_nc_oc=AdpujIVl3X23F_fhITFTqvdamaJBcFUAcZFz6wgSE2oaDlQCHPrn99J5np6I3BJzUFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMq9BksBCxcSyVTh831RiOmCR5Oo_Au9pUHFnqenmjA1w&oe=6AC6719B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "05_trailer_thumb_2560x1440.png", "id": "2211528986265904", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_2211528989599237_1508627809804797263_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzlOR7_TtJ0Q7kNvwGA2iiL&_nc_oc=Adrr5CEUGQ02OUy3EyI4v40uCVPGt_98LapVd9JXcsGtHpd0RajT4z_OVROGByQ9Es0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOv58d6TfzMJ126VMA7JTGa8IRq1NEsBvu1e0D07_yiwg&oe=6AC64D8F"}, "display_name": "OrbBlitzVR", "keywords": ["casual", "arcade", "wavesurvival", "OrbBlitzVR", "iamsince1998"], "long_description": "---\n\n## \ud83c\udfaf One More Round\n\nNo tutorials. No cutscenes. No filler. Just **pure, distilled VR reflex bliss** \u2014 pick up and play in seconds, impossible to master in a lifetime.\n\nChase your personal best. Climb the leaderboard.\n\n*One more round \u2014 you always say that, don't you?*\n\n---\n\n**At the price of a cup of tea** \u2014 Orb Blitz VR delivers an arcade rush that'll have your arms swinging and your heart pounding, every single time.\n\n> \ud83e\udd7d **Meta Quest 2 / Quest 3 / Quest 3S**\n> \ud83c\udfae Standing or Room-Scale \u00b7 Single Player \u00b7 All Ages\n{27033014449719141}", "short_description": "Fling. Deflect. Dominate. Pure VR reflex mayhem \u2014 one platform, endless orb waves, one score that never stops calling you back."}]}, "developer_name": null, "developer_
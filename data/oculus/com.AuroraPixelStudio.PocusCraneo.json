G_OaVZ4PUstWoYRyTJ8wSijlNrfSB9IyGqpa11RJvQ&oe=6A3BDF3E"}, {"file_name": "Pocus_2__16_9.png", "id": "937230505742267", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617729_937230512408933_3727197429448161329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygE3bE9Y8UYQ7kNvwEGynSl&_nc_oc=AdoxC_1HPGqk6miMnf-LQwet7fg47NR_q3-Wz94g7Abpj50EUtTDw8XH4mZ7Flz6SHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h-6hB3RcVMJ-HDPR6pl-23QfeaCouILIbG5YvQDO48Q&oe=6A3BCFB6"}, {"file_name": "Pocus_1__16_9.png", "id": "965228606014452", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619697_965228609347785_8488936919973560370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qv8w71uAtKcQ7kNvwHtOpou&_nc_oc=Ado_Z0BsYlB7tyFBRk1cWqGRAY0JhKUCGwt8bdfk07I7BkHXgQ6kcSLUOiaY3hd5xGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HqMDKlVx5-7YSqbyFxdgdwOn_FfaNg7FROdOULBzTMQ&oe=6A3BD603"}, {"file_name": "Pocus_3__16_9.png", "id": "4100339310226775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618069_4100339313560108_3936598336562042380_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xi14uw34tskQ7kNvwGdZKiU&_nc_oc=Adr27EOFblliWmNQGFxz-Y18LVnSI_kbgg3ZQGsmmqnXlmxNRUqTG9ha1NED6iFT45g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OPTUZ3fV-9PNqycFKd1QBwLBrNinTWFaR2z9T9_g1FQ&oe=6A3BD130"}, {"file_name": "Pocus_5__16_9.png", "id": "1683228509368624", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618274_1683228512701957_5102167550855090008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbZTKhA44lkQ7kNvwGP5_HE&_nc_oc=AdpA1y1UMQD6GKn2iHkKujtAOv6YnbDugJp5LS1qt-5iAa9qJpejKfyXmXSDEswoME8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4A3u7IX6WvHsLq2xnMNPHY2yVQnieyKTgUN8xCBJ7_w&oe=6A3BD3E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PocusVR", "keywords": [], "long_description": "# PocusVR - Meta Quest Store Description\n\n---\n\n## **Learn Point-of-Care Ultrasound in Immersive Virtual Reality**\n\n**PocusVR** brings POCUS (Point-of-Care Ultrasound) education directly to your space with cutting-edge virtual reality technology. Perfect for medical students, residents, and healthcare professionals.\n\n### **Training Areas:**\n- \ud83e\udec0 **Cardiac** - Rapid cardiac assessment and essential views\n- \ud83e\udec1 **Pulmonary** - Detection of pleural effusion and B-lines\n- \ud83d\udc0b **Abdominal** - Organ evaluation and free fluid assessment\n- \ud83d\udc80 **Cranial** - Transcranial ultrasound and measurements\n- \ud83e\ude78 **Doppler Color** - Real-time vascular flow analysis\n- \ud83e\uddb5 **Inguinal** - Assessment of vessels and inguinal region structures\n- \ud83e\uddb5 **Popliteal** - Popliteal region and vascular structure ultrasound\n\n### **Features:**\n\u2713 Realistic simulation with accurate anatomical models  \n\u2713 Immediate feedback on technique and findings  \n\u2713 Step-by-step protocols easy to follow  \n\u2713 Unlimited practice in a safe environment  \n\u2713 Intuitive virtual reality interface  \n\n### **Ideal For:**\nEmergency medicine physicians, critical care specialists, urgent care providers, anesthesiologists, and medical students.\n\n---\n\n**Master POCUS with confidence from anywhere!**\n\n{2416345472161976}\n{964784835962575}\n{2203614260390719}\n{814953447905793}\n{2134594520661540}\n{1661401091666738}", "short_description": "PocusVR brings POCUS (Point-of-Care Ultrasound) education directly to your space with cutting-edge virtual reality technology. Perfect for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ad6537e3-6466-4e81-98e3-5f364d29a866", "developer_terms_of_service_url": null, "publisher_name": "Aurora Pixel", "support_website_url": null, "website_url": "https://pocusvr.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "com
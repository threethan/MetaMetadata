nc_sid=6e7a0a&_nc_ohc=_oCuOENIS4YQ7kNvwGXZQAF&_nc_oc=AdqYd8jbgG2Q4is4zp3ym3Cr44HxxXrefzzg5RPzpJfAxJ2IUnIoj8f_ko7mxBN4TPI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IDLdf7utiDL-DuVRkNphZaafQgtJK9Ktbx7lGXKP3vQ&oe=6A01CDB6"}, {"file_name": "Pocus_1__16_9.png", "id": "965228606014452", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619697_965228609347785_8488936919973560370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1igt4sbREwQ7kNvwGR4Iy6&_nc_oc=AdqpkG0dt7sGnCeCMmKulDTm5hXCSzUrGKIYKte2hC5NXjqgTD9Okth_u003Kad9KKw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47GrwLiIF2FG-lKq-hh95ehQMGQ-kI_hOHdx3IUtJBYQ&oe=6A01D403"}, {"file_name": "Pocus_3__16_9.png", "id": "4100339310226775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618069_4100339313560108_3936598336562042380_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlAjEKtOPWwQ7kNvwGWqdm-&_nc_oc=Adp0WX3tmRdDNFwkqaZPOTIEXndlVcQXLQcu0YHWpXYZ3mvf8vwZx2TIetRMZKOBolA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40BrNoRHS1e9j8Qil4R9vq2JqvXgE7b4_sY2Q7f8f2ow&oe=6A01CF30"}, {"file_name": "Pocus_5__16_9.png", "id": "1683228509368624", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_1683228512701957_5102167550855090008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEtMPHq74lYQ7kNvwGnYkDh&_nc_oc=Adrykm31yrft83TGyURWaBd7h77b6R1YRDr_4PPgC3FwUzhtT5441h3WjqKvPjqmDUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fdGL3M1AISFDmhXM-drIo1y94e-fhWSKvssOiT6hCFw&oe=6A01D1E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PocusVR", "keywords": [], "long_description": "# PocusVR - Meta Quest Store Description\n\n---\n\n## **Learn Point-of-Care Ultrasound in Immersive Virtual Reality**\n\n**PocusVR** brings POCUS (Point-of-Care Ultrasound) education directly to your space with cutting-edge virtual reality technology. Perfect for medical students, residents, and healthcare professionals.\n\n### **Training Areas:**\n- \ud83e\udec0 **Cardiac** - Rapid cardiac assessment and essential views\n- \ud83e\udec1 **Pulmonary** - Detection of pleural effusion and B-lines\n- \ud83d\udc0b **Abdominal** - Organ evaluation and free fluid assessment\n- \ud83d\udc80 **Cranial** - Transcranial ultrasound and measurements\n- \ud83e\ude78 **Doppler Color** - Real-time vascular flow analysis\n- \ud83e\uddb5 **Inguinal** - Assessment of vessels and inguinal region structures\n- \ud83e\uddb5 **Popliteal** - Popliteal region and vascular structure ultrasound\n\n### **Features:**\n\u2713 Realistic simulation with accurate anatomical models  \n\u2713 Immediate feedback on technique and findings  \n\u2713 Step-by-step protocols easy to follow  \n\u2713 Unlimited practice in a safe environment  \n\u2713 Intuitive virtual reality interface  \n\n### **Ideal For:**\nEmergency medicine physicians, critical care specialists, urgent care providers, anesthesiologists, and medical students.\n\n---\n\n**Master POCUS with confidence from anywhere!**\n\n{2416345472161976}\n{964784835962575}\n{2203614260390719}\n{814953447905793}\n{2134594520661540}\n{1661401091666738}", "short_description": "PocusVR brings POCUS (Point-of-Care Ultrasound) education directly to your space with cutting-edge virtual reality technology. Perfect for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ad6537e3-6466-4e81-98e3-5f364d29a866", "developer_terms_of_service_url": null, "publisher_name": "Aurora Pixel", "support_website_url": null, "website_url": "https://pocusvr.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_a
yfs3Qah0SnjsiQaUZ2v0287CJpUiMK7ZVwCbEbOE6A&oe=6AB7CC3E"}, {"file_name": "Pocus_2__16_9.png", "id": "937230505742267", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617729_937230512408933_3727197429448161329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3zf7ze176IQ7kNvwFvdaU2&_nc_oc=AdqRyNpUe_Vyz4QSZtwXBWGKfZ8lnKNeNwQ1gNEmgTno6NcDqNrIq9-vWKlrb8JDYFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3B3xB7cGciU_L827WifHweJz5itK2hxkVgnrcS7sAbw&oe=6AB7BCB6"}, {"file_name": "Pocus_1__16_9.png", "id": "965228606014452", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619697_965228609347785_8488936919973560370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JS60cmxS3WYQ7kNvwF933GE&_nc_oc=Adp2u9Z22dNkHhkuoD90qdDoCDqoaH9XoTqKz01m0O9wEMu9oYv_BUEnqlSU4k1si8w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMpMbuGTz8czIfKhiAX9XwpcN7V-qFgZcCYhdxLa7JWA&oe=6AB7C303"}, {"file_name": "Pocus_3__16_9.png", "id": "4100339310226775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618069_4100339313560108_3936598336562042380_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhhJoSNaet8Q7kNvwFgEc-W&_nc_oc=AdrFpoWnEdqmSk0_LUBmxMjt5OdkbhCeyhjBOIZDJ6E1GAyUdelL_kvPjpjb0AUUmRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDn_WwM8IHtlIjnGUw3JkB_XBxtQ3SgbuxC1iiXeoKxA&oe=6AB7BE30"}, {"file_name": "Pocus_5__16_9.png", "id": "1683228509368624", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618274_1683228512701957_5102167550855090008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmNXiyZwRQAQ7kNvwH39kf0&_nc_oc=AdoljaqG0JYluZEx13CtGbD13rSKmlqrOAdJ2hdcDjQ9osIrGHMLSSUU5MkXn2pOun0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3u57U81CaRnDYzLE_zEeQLOsG7pMqe4DuxZTmXFFs5g&oe=6AB7C0E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PocusVR", "keywords": [], "long_description": "# PocusVR - Meta Quest Store Description\n\n---\n\n## **Learn Point-of-Care Ultrasound in Immersive Virtual Reality**\n\n**PocusVR** brings POCUS (Point-of-Care Ultrasound) education directly to your space with cutting-edge virtual reality technology. Perfect for medical students, residents, and healthcare professionals.\n\n### **Training Areas:**\n- \ud83e\udec0 **Cardiac** - Rapid cardiac assessment and essential views\n- \ud83e\udec1 **Pulmonary** - Detection of pleural effusion and B-lines\n- \ud83d\udc0b **Abdominal** - Organ evaluation and free fluid assessment\n- \ud83d\udc80 **Cranial** - Transcranial ultrasound and measurements\n- \ud83e\ude78 **Doppler Color** - Real-time vascular flow analysis\n- \ud83e\uddb5 **Inguinal** - Assessment of vessels and inguinal region structures\n- \ud83e\uddb5 **Popliteal** - Popliteal region and vascular structure ultrasound\n\n### **Features:**\n\u2713 Realistic simulation with accurate anatomical models  \n\u2713 Immediate feedback on technique and findings  \n\u2713 Step-by-step protocols easy to follow  \n\u2713 Unlimited practice in a safe environment  \n\u2713 Intuitive virtual reality interface  \n\n### **Ideal For:**\nEmergency medicine physicians, critical care specialists, urgent care providers, anesthesiologists, and medical students.\n\n---\n\n**Master POCUS with confidence from anywhere!**\n\n{2416345472161976}\n{964784835962575}\n{2203614260390719}\n{814953447905793}\n{2134594520661540}\n{1661401091666738}", "short_description": "PocusVR brings POCUS (Point-of-Care Ultrasound) education directly to your space with cutting-edge virtual reality technology. Perfect for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ad6537e3-6466-4e81-98e3-5f364d29a866", "developer_terms_of_service_url": null, "publisher_name": "Aurora Pixel", "support_website_url": null, "website_url": "https://pocusvr.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "com
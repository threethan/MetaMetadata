cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uQDSBEP-8EQ7kNvwEStdyI&_nc_oc=AdrJ9IhZlesnJK3l8IWv8QYOeuqFhglZOX1G50r0ME_l1S6rAayD5OIFPDJtKjL_8Tk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyprqymhLWq7Feh-jcWBwAZ3uix7K5kFK2Xcp192zTIg&oe=6B086FFE"}, {"file_name": "Pocus_2__16_9.png", "id": "937230505742267", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617729_937230512408933_3727197429448161329_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynr6Uk53tO8Q7kNvwFwX3QQ&_nc_oc=AdrM555psZ9tOGtasXs3euLYQIv9tcmVFzQ0yB-iy4hC2xosGFfFSrlG6bMPl-SJ6rk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6Qf7bb6TylCE9qNSDI_zI-2nI6TahrZBp9i7xM3Ptfw&oe=6B086076"}, {"file_name": "Pocus_1__16_9.png", "id": "965228606014452", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619697_965228609347785_8488936919973560370_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fob4ErokK8AQ7kNvwHCpib1&_nc_oc=AdqtxH0Ky1oMGh3sXO3AnJ8i_gbJoqd9bnzwHMNSTEwIKAFN2aMdnu4Wg8TB2dRS0oo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSORR1DeZh42XzF9861bC4_reO-gr0RwYY_s4rEiyBwow&oe=6B0866C3"}, {"file_name": "Pocus_3__16_9.png", "id": "4100339310226775", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618069_4100339313560108_3936598336562042380_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAn8I7rvhFAQ7kNvwGSC4RR&_nc_oc=AdoXD4uPAtkyQFVY5hMQA78166-qYixPMRrdvEdSw4GLdD_MudKYQ3ygqCwj9bV-V-4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL9jnbZi6M_r28KslFtiIfzvNNX3nf4qUjMd2FBwpfPA&oe=6B0861F0"}, {"file_name": "Pocus_5__16_9.png", "id": "1683228509368624", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618274_1683228512701957_5102167550855090008_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVzGbq1NwgQQ7kNvwFHMvV9&_nc_oc=Adrp3K_GpxQhcawUzfya0fgKI_fFnZLa-3UKPQbNdO37Xn30Dzr1-wr1SG8TPz5OBUY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQML73shsBydonK_f1akE8jagRs4XdEYdLMbAxv3hMJg&oe=6B0864A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PocusVR", "keywords": [], "long_description": "# PocusVR - Meta Quest Store Description\n\n---\n\n## **Learn Point-of-Care Ultrasound in Immersive Virtual Reality**\n\n**PocusVR** brings POCUS (Point-of-Care Ultrasound) education directly to your space with cutting-edge virtual reality technology. Perfect for medical students, residents, and healthcare professionals.\n\n### **Training Areas:**\n- \ud83e\udec0 **Cardiac** - Rapid cardiac assessment and essential views\n- \ud83e\udec1 **Pulmonary** - Detection of pleural effusion and B-lines\n- \ud83d\udc0b **Abdominal** - Organ evaluation and free fluid assessment\n- \ud83d\udc80 **Cranial** - Transcranial ultrasound and measurements\n- \ud83e\ude78 **Doppler Color** - Real-time vascular flow analysis\n- \ud83e\uddb5 **Inguinal** - Assessment of vessels and inguinal region structures\n- \ud83e\uddb5 **Popliteal** - Popliteal region and vascular structure ultrasound\n\n### **Features:**\n\u2713 Realistic simulation with accurate anatomical models  \n\u2713 Immediate feedback on technique and findings  \n\u2713 Step-by-step protocols easy to follow  \n\u2713 Unlimited practice in a safe environment  \n\u2713 Intuitive virtual reality interface  \n\n### **Ideal For:**\nEmergency medicine physicians, critical care specialists, urgent care providers, anesthesiologists, and medical students.\n\n---\n\n**Master POCUS with confidence from anywhere!**\n\n{2416345472161976}\n{964784835962575}\n{2203614260390719}\n{814953447905793}\n{2134594520661540}\n{1661401091666738}", "short_description": "PocusVR brings POCUS (Point-of-Care Ultrasound) education directly to your space with cutting-edge virtual reality technology. Perfect for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "d
me": "VR.png", "id": "825501018823123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568680_825501022156456_7834944691907218356_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j79k9h98fAIQ7kNvwE38rqO&_nc_oc=Adkn8OvuozdFGvqnwgxb9w6gZbbiTP9YDWpxKJJ_nn-Ql8KQNZAJYonuCvNCxvi9M0w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afua9jD6QZI7egqekOvneQDtPhnPKrOyeMU_jnGyt_A-Ug&oe=69A96331"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xplorer XR", "keywords": [], "long_description": "Xplorer is the leading software for easily and rapidly creating XR training content for industrial enterprise applications. Xplorer enables real time access to AR, VR and 3D work instructions and training to upskill, increase performance, safety and operational efficiency. Advanced industrial XR content (training, presentations on assembly/disassembly, visualization of parts) on complex assets is easily and rapidly created through a platform that uses your content at hand and uses a simple workflow for ease of use, with a wealth of built-in functionality. \n\nSimple, drag-and-drop UI features, combined with your own content, enable you to build engaging content, simply, quickly, and cost-effectively. \n\nXplorer accelerates XR training content development for industrial enterprise customers to address workforce challenges and meet business goals and is the easiest way to create advanced industrial XR content (training, presentations on assembly/disassembly, visualization of parts) on comp", "short_description": "Xplorer XR Presentations is the leading software for rapidly creating interactive and collaborative XR training and marketing experiences that can be accessed from anywhere on any device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.modesttree.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Modest Tree Media Inc.", "support_website_url": "https://docs.modesttree.com/",
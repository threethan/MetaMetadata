y4eGkEKxcsvsQH03dxsOk3Q&oe=69C7C242"}, {"file_name": "VR.png", "id": "825501018823123", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568680_825501022156456_7834944691907218356_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNcsGM6SMCgQ7kNvwF0rBzc&_nc_oc=AdruRKM8-wsqz8FSJ7_imMJMCqWgarmhz58hDnXyyUmtz4vvYzWRGZR5lu8LeZkihm8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6Q3o3E64Vw-40Kj4xUao7juguQ9D8Eh198gUidYA5kQ&oe=69C7B5B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xplorer XR", "keywords": [], "long_description": "Xplorer is the leading software for easily and rapidly creating XR training content for industrial enterprise applications. Xplorer enables real time access to AR, VR and 3D work instructions and training to upskill, increase performance, safety and operational efficiency. Advanced industrial XR content (training, presentations on assembly/disassembly, visualization of parts) on complex assets is easily and rapidly created through a platform that uses your content at hand and uses a simple workflow for ease of use, with a wealth of built-in functionality. \n\nSimple, drag-and-drop UI features, combined with your own content, enable you to build engaging content, simply, quickly, and cost-effectively. \n\nXplorer accelerates XR training content development for industrial enterprise customers to address workforce challenges and meet business goals and is the easiest way to create advanced industrial XR content (training, presentations on assembly/disassembly, visualization of parts) on comp", "short_description": "Xplorer XR Presentations is the leading software for rapidly creating interactive and collaborative XR training and marketing experiences that can be accessed from anywhere on any device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.modesttree.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Modest Tree Media Inc.", "s
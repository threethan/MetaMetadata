me": "VR.png", "id": "825501018823123", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568680_825501022156456_7834944691907218356_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NqpzrxT4hgQ7kNvwEVkCEk&_nc_oc=AdnIpswzbXOWEATt7gv5zoWriqbU6mjSc4AaGrxtIbJcOUUp4f_-v1b1QckusBSoZLo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8Ad7Tiic8egAqT72hO5KzakXrXhlBuDG5aVjD67Oj1w&oe=69B14C31"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xplorer XR", "keywords": [], "long_description": "Xplorer is the leading software for easily and rapidly creating XR training content for industrial enterprise applications. Xplorer enables real time access to AR, VR and 3D work instructions and training to upskill, increase performance, safety and operational efficiency. Advanced industrial XR content (training, presentations on assembly/disassembly, visualization of parts) on complex assets is easily and rapidly created through a platform that uses your content at hand and uses a simple workflow for ease of use, with a wealth of built-in functionality. \n\nSimple, drag-and-drop UI features, combined with your own content, enable you to build engaging content, simply, quickly, and cost-effectively. \n\nXplorer accelerates XR training content development for industrial enterprise customers to address workforce challenges and meet business goals and is the easiest way to create advanced industrial XR content (training, presentations on assembly/disassembly, visualization of parts) on comp", "short_description": "Xplorer XR Presentations is the leading software for rapidly creating interactive and collaborative XR training and marketing experiences that can be accessed from anywhere on any device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.modesttree.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Modest Tree Media Inc.", "support_website_url": "https://docs.modesttree.com/",
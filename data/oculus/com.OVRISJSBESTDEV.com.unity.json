bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qvg3AfF-19sQ7kNvwHi4BWA&_nc_oc=AdrDrCz9MmoNL9DdkRPtqca7JbZJgjYMb2TfK-z2LMtyCTxS7dvLxH8kb1rI0JcjXvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXBXKNJTYYn9ci44AKN6f9GM7lG4wrLgsZfIZy0bbfP7g&oe=6B0F1417"}, {"file_name": "Main Spawn_1080p_05.10.2026_16-22-10.png", "id": "1446964350636041", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624583_1446964353969374_1003913154903603421_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nB68Rxw9y5oQ7kNvwHkRoKJ&_nc_oc=AdqDJC7B98C-d-emjLMaUvrDt6oHjkabngP6l-MfvmbNIHlW0pJgws72bv_maG9FdHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXST6c--Mri4N6m6ONPmicnKZRRa3DqPdy8-qjgQw9-Pg&oe=6B0F1EF1"}, {"file_name": "Main Spawn_1080p_05.10.2026_16-24-06.png", "id": "1405680658365203", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627477_1405680661698536_1554775924881427271_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ye4dnFEAjkQ7kNvwHOkq_e&_nc_oc=AdrjsbZcdVxr_0fbgT5923rzJnhwEYm88ASr-4WfwpoFjcMdyHXSozMi1FnoY6v-B30&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVEd-uMz2ZuNjVcdwH7mPuOxaU4v8tkpbqgz3p1t5fDwA&oe=6B0F0F2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fear Reality", "keywords": ["ape", "fear", "multiplayer", "tag", "gorilla"], "long_description": "Fear Reality is a multiplayer VR horror game where every round can be different. Explore creepy environments, complete tasks, mess around with your friends, and try to survive the monsters lurking around the map.\n\nFear Reality has  horror with different monsters and stuff to explore. Explore places like abandoned labs and more and more as the game continues to grow.\n\nWith different monsters such as Teethling, Splitface,Mimic and more, you never know what you're going to run into.\n\nWhether you're playing seriously, trying to survive with your friends, or just messing around and causing chaos, there's always something to do in Fear Reality.\n\nFear Reality  face your fear.", "short_description": "Fear Reality is a multiplayer VR horror game where you never know what\u2019s waiting around the corner. Explore creepy maps, and try to survive monsters like Teethling and Splitface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/fearrealitywebsite/home", "developer_terms_of_service_url": null, "publisher_name": "OVR", "support_website_url": null, "website_url": "https://sites.google.com/view/fearrealitywebsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1374951909037182"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619059_1606524597865279_377250146398069511_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzZTvvUQRPoQ7kNvwFGG18v&_nc_oc=AdoDsihLiP_uZebIVfOYh60Ei3OpHMZ0nfEyxUqeRezvz2e1ozYJgU9h0TVi2aM9od8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXIeSXNa6mbDhabMrvfi0t7lhS8WJCSZfTz7CJK1zl7Og&oe=6B0EF148"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fear Reality", "platform": "ANDROID_6DOF", "context_category": {"contex
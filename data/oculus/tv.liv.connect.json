aTTyE1sIDG8XvrnQ-ju0J1QZD7KwNRD32kSuhfaKwMw5g9iZ_jM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSX9Z07KlnGqPkjvgf48Dmm49_uPPZz0eR8RPSF0DeHwQ&oe=6AECA8E7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4KCPn6lyjEQ7kNvwFMuFcS&_nc_oc=AdqvGbT1NE89loKGusUphsVAEpV4qbLzCxcrWZsoPUVN7e-rMXrxLxhjwoKYkA3wki8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyYrjhgnKsDoc4BBQ0bOe-uhqzi4Eokv11dCwLLoSACQ&oe=6AEC8E8A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrA-3doaIpUQ7kNvwEHDboN&_nc_oc=AdoCZYnS5TSO6pcyfejm_FfvBGfJfDg73Ju7QFeo1xw0z2HvJrBg2LKp8muoAUYpNVY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvjZj36VloNhLCXIFzlQDrEHpCAW3QmEKIAl2h3xXNrA&oe=6AEC8DBD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhcYZGka-O0Q7kNvwEsFSj2&_nc_oc=Adr95KJeTfVenQpvlOwRhMdO2IxItavBvt8uu-HKvpM5QxivEaksLoBO5o36WK9Dolw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG-GEImNgBCArWdkzNNdEthHbRCUoJKbZ2qpn3DLVd3Q&oe=6AECA2E8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EJjULCVrzgQ7kNvwHAGIgs&_nc_oc=Adr0NaHicDh6MRGIVoIgM_TXGiAoyBDhUzalC-y9Udf2U6lRvkYNbp44Hm_lznaxCTU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIJsvT3dt85DONqdk8jzx6kZpkE-4gFLAuHJ-EoPaM4g&oe=6AECA3C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
_J5uNbVcpYx91dih1Sumd2lVwSBGh3kJJMxLMnFEpGYiG5SJz5o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyniRCGQ1_AvnEPZXaAR8EWMG6XKq4HvKrTjUrvNxhS8Q&oe=69C3CF27"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7HbS2ZplmcQ7kNvwF6vt_e&_nc_oc=AdqwWnkqsYUWf0Qp-vuXVT1T3mgZx1r8bQnNIXLvQRigAF7SOzqTF0PyeYVl0DslkfA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwF3i6KLkwexf2mL2szaqO6t-Jlw_2NKBsyF0SLU69VkQ&oe=69C3ED0A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRu7KnkayewQ7kNvwF2B_N9&_nc_oc=AdrPKaMutU25IaF3iSca1CBLosG4488nx7_x9IOKZGeriqLJWgBe_gJ8-EpwO1zIhi0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxI6tnwj5F7yRt7WMjI-hSRg22msdBdXdFYr7v-afMh1w&oe=69C3EC3D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZH0-7dQBnMQ7kNvwGKgKFb&_nc_oc=AdpZS_Akh0XS7tQmT5fpSaIfNHAF6j9Zot1ZbLpAvsYDPPIen1KyZ52pGi2lFNonSpc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWxMt2j6kiU4uzTHjTdHQCvXjSTE0nZfOaVTmSeMw30w&oe=69C3C928"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgu2E96NNG0Q7kNvwHmhpuX&_nc_oc=AdrgG6uOamsxaeMsz58eUnNrX8MeTUWskEieAWLaZH_gru1KHOtqYh7f5fflqk4-ckM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyShsURovv74fYM9kIxjkrQZ-h7fOZHs3g8TcuGBibl6A&oe=69C3CA05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
4UNHg5xc7RS8z-7Njupc2n1mYAMx5yFJpmeuSCPbgFs4sMfjITw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YZnE1xD4mlqsWA_0HGEFhdlTqyN4DONCOQzoJwkVkoQ&oe=6A3EA2E7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fFa7SeTAPwQ7kNvwGaqY_1&_nc_oc=AdoqvIuidPAUl8JOK9_yQv1irYUDXbP-sBch5jMtfNtN7CrWDaOSjfUtKcqgeuZ2bYw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ExyCCw_vOB5umq5ZjcduYw7qFXXTiveOemoIwiJ0MUQ&oe=6A3E888A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdghObEn3boQ7kNvwEY8rkI&_nc_oc=Adqy7XPtpZvFbBmta-aibYbqTbc49TCagYm1jy5XP8lZIQhRUTS-7dzZJFKXGfy2rmE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DbOAsSrcb_A_Lyxo0dGq-UV5oOEya5ZgSZj6oi_0Yug&oe=6A3E87BD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0s1-D_9XEkQ7kNvwFSEZNG&_nc_oc=Adp1gE68qneEQDFAO5Cp3Q77w1F2831o4BaNTL0XtFH22rS9KzZ438CqITWDQ6JhNsE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gurZ1vgpqxO7fGN-Retuv90NHLVgEiWXrrF0XbwbPIw&oe=6A3E9CE8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRbWxjBWBXIQ7kNvwFlsAjw&_nc_oc=Ado8m_eRULnUGwZyYFY7iqEWKnY2yJyjTw1qRFciDlKHI68serzZHQuf_UyZhasILKY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N3AgSaauhIbEjst6iCxeved1pIEYnNMWdB1z8_1shfQ&oe=6A3E9DC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
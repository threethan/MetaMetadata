RtY0J3gjv_QRGkZiIaAya2prnc98r6aVmKfOZWzziFsZeRIBSNs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOu-LvEAnBxJgttTHiNGhZKsMR6KUl33MGUuOjza_xTA&oe=6AE8B467"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIPXm85qK1cQ7kNvwHUZv_F&_nc_oc=AdoP2HNSqRRGBaLb_nB9gW6CIX_OLiSzoDjXeMugx0w0fG4Cfo-8H6VNiAY2BdtujTA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1j5cWu9qsRfTedoDS5_pZ5XytQ3AQDVVPW9XzJCU3Sw&oe=6AE89A0A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5TmiY4owT0Q7kNvwFxLJ08&_nc_oc=Adqxi3753OAzQwJ8iSH4MvFCE07kbsIzaKjvllFUV0WvIJ2FK7fE_JZWNYBqfa0fB5U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs4c7D3K66SXo0mXz-R99UwzIgvf8QhMAj5UDu5NtdUw&oe=6AE8993D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGP1ZmgFg9EQ7kNvwF6w0uI&_nc_oc=AdpMpjKrBpW9_8fxP9oA0vjUF38KCeAnJbo8Xvpy5l-BTLFOwFj1ogNj4qkWT_3tytM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkbFwA_Z6hyc0pEzbs_Y9IbkmLD5fgMAxYNyqQhawgJA&oe=6AE8AE68"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0RBXabTfbkQ7kNvwHp209o&_nc_oc=AdqcUhZjkQ5kSywNqok76M9fOXTyOIuo3BOwIJ8QJh-lrpqS22qIZC75jApytx6JWl4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm7_d8Sw2Na75IYGwcBGoYOVqdeLzvAa9-mUPRhCUlbg&oe=6AE8AF45"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
sVkHwJobstp-j2ppUATOosrNT5WRXi4kQ3PJQNscMPtbBlG2yf0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3F8K2Jv8dWbvfMCI0P-do9zSEMCgNDy-d20XmheS7YuQ&oe=69D8E727"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wxy0MoOD5kQ7kNvwFMFDC1&_nc_oc=Adqo5kh-vuKHv8WRby1GoKqnLoTxV3nZppm-uZ60H1-aTE6UHk2TqGM0NtC0iGXHjHA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3x1KB9Ei4JuePh7_Tjv93zZ3UAFwgG1wLGMPz8pL0sPg&oe=69D9050A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqnAGJrZa44Q7kNvwFhxeJa&_nc_oc=AdoGSE3FeR-bg9_qa3eM_qB6dfK6VAREB977DnLrn5n7y785CpcaFjBnvhn5A4Y2rsg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1u0kIpA3lMXl18rIYAqWeKHhTibRYzhLvWQBGWWQCjMA&oe=69D9043D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nB8RXQ3PNCQQ7kNvwFlWd1E&_nc_oc=Adqd1ALQBKSQeYgt9p-E5JVxmBAdzLVbVdgCKuAV9iRQ7oqzDoZ0VGIHF9gaoI8Ly3A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1z-hNVhMfDmG3jYxQBEl98dtPQ07hN3KVlNO7Ei_59RA&oe=69D8E128"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUmC_Oc5tkoQ7kNvwHMXSrf&_nc_oc=Adrv0dDX4DDrCnBniaNdbra2aijUgv64b2rxihOX63-aTLq34oICVLRlPsnmK_sRj4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VRe1thaB7Regb8ZLyxQ4EMuOR-7FncLza9oWuWzviEw&oe=69D8E205"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
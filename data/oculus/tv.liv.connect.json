oSV7PlbTernlx1hcMurEmipZXvnqH2PNKK5gnU9TDlwQl8sHZxI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3GufpDNQwYlAo5M7ETcdm1Eb01QJ4bQJSDeQXIr4s9g&oe=6ADCD6E7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kHTv9ccNKUQ7kNvwEghc0q&_nc_oc=AdpJ-Fcu64GTcxOa5Qhh9e1VDMyClRSNnm65pTIc6TvVukRQzPN-Ut1Xj7sP1pmjouw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA7wmlYPALFdxNP3DI6Cfvd-4ncJvLhRJtpIdKXwUtxA&oe=6ADCBC8A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gbHaISXfBcQ7kNvwHXY3ZW&_nc_oc=AdoIgQnunEP1Z9y64jbimmr3TBuE5Hgyd5elcJ81RK5HXbwYtRSMSZZlkbcLEvb7NFY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDbOf2WQe559I6RsLzaScIgS75TcaVSfVzEDG4U6Ss8w&oe=6ADCBBBD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XSk4etILg0Q7kNvwEgGzqJ&_nc_oc=AdqPDDrGcakTGlzHhcKt77n3BhTKuhH-382OR78CkMZteCFLckxVCL22A2sJaKjJRW0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsjVHH2KW28Ix9VphCHP7jGWiTfDfK3Jl7bea7naSbIg&oe=6ADCD0E8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnRvw2Q6h7wQ7kNvwFAMq4H&_nc_oc=AdoHkN5UUBffHyVqW61D1H-65ISWxfm7j-eN28ssrwAI0Cp4NG8jYFLnoV64Tvc23_0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQdRv-r27t8qBM_7zW6-nFBvsxfukFMcKiXDb6JKHWiw&oe=6ADCD1C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
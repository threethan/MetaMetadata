-tFOezo4Q0kCVuKV7TZJSkOujzcE-BKgEWILZdIWxCS0qp1710g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuc00XcRRdPq5lr7NGuXAmNon0j1nybH_Eqpe7UB5QIQ&oe=6ABE8467"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6iPz_pA8bUQ7kNvwFuyc16&_nc_oc=AdpMvTshqYlrBQvlY15yzk3yjCNE3gVwAemovFdHb_usMS0eC3aEYHDE5PekAzMWzNQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOvjgtlDcVZ3Y9s3HvVpZP7EOWaibO3f-gU28t4JcxBA&oe=6ABE6A0A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSi6CYLnCpYQ7kNvwFYhvbc&_nc_oc=AdqkAvzhy-H8DrlLENbd3lc4YhZtefAqf8YY3v84ymV0t7z56ILrVD-EzZE77B_5LO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_uPbChu0xcNApY0F9H9toopk2AiJKYoWXhyCOvnR7VA&oe=6ABE693D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_gJz6IE_gYQ7kNvwHW-sBT&_nc_oc=Adrde6fsqfF71ONJSqHNiPGEQsmI2o2DjesFM66O5-3Wm7FPyu-gL2UVRfCatE4kGNE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkdYm6ckOuYZZRyfa6Y6fDLK8_NcKderXZK8h0LFa0RQ&oe=6ABE7E68"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaEjBuLuNo8Q7kNvwEZ3GVg&_nc_oc=AdogEgmUaQftlCMEkpyCjEqza49bhn5e9YXXZXXHMiKYMJKrAhZ5KIS-1aLMaTkwhJQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL81_iwrDWcDuPQijw8sZA59TfQZc2Rq5A92bN2kRhUvA&oe=6ABE7F45"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
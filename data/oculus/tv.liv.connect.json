ealIRyA31c4ZmKrfSOpiPMKybWAtI_O9XLibeDfVn5nndbSHWB0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58XUW-NsuEJgHEVYUvdcBfXzF-8Y_tnMMAe9s0pTaBdg&oe=6A19B8E7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRVyhGD432YQ7kNvwGVKF4Q&_nc_oc=AdoqJhfA45YxHOUDaeLpBDhkInjNL0CJMmnwWe55rt17I5lUGblm0GIEVRqV6jkIC8g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Rbq9aMPewjlidw--rELA1zF88FzO1uQfGejBZtVa1mQ&oe=6A199E8A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gw07TBbAXpgQ7kNvwHqOsPX&_nc_oc=AdqltoDN6uHDBKxtdwu3w1DTdXlYUh2vaH50GoR92Sg7Kqf1lLWQDztL4ukBGpszmSE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Y9bJF3bQAr_r74jzgLawZkPkDgFhjBjeXaNC9vUTH6Q&oe=6A199DBD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMws9eaJFaEQ7kNvwGqvQbd&_nc_oc=AdrmJa8oK8hLKmw1X-g45vLE3FwJ-_YDrEDHhK0xB49pU7CQeTiPxzXE_wGt9Egu-Rw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EbvLkl2GMcrFUSuXacMqhdBHaPA18hkHQIT3IhWQD3Q&oe=6A19B2E8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppgCebt9jL4Q7kNvwEqKB_7&_nc_oc=AdoZM1K4MRYKg2PqBUVCjLVA7X2X-vzaudy5UptQkMDqo2Gu8ozp__5-cj5SXXfafHY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63QArNTGazYXPmCX4Dl-wc-8-Y6Bw2pr9AazrvOWSoUA&oe=6A19B3C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
dn.com&oh=00_Afssiik9xyCVE9VvQMiw7k3g2PhEaZ-1wnmqXOfzDlZlTw&oe=699AF0A7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uWfRDnQXCoQ7kNvwHahA6_&_nc_oc=AdkVNcxQBtWCHraTgezgY1o7s5CcKBaSStr9w4f4CX2t7fKN_J1nuYKTbfqAzV8_lIU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft6D-ZWJh8mH4X932d8yD_icfVVQ7vJjnyiqDbfpmXWoA&oe=699B0E8A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEdAU--gA-UQ7kNvwFvzmpj&_nc_oc=AdkyL7dlPS0pblHgwIntnomSe_pDzOFSrCkyUCUrL0ccZn-y0vgbSpvENeA9aPx5q74&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuYy-KlFSGfVLEnnTqd6gbGj7d2ZDgAdnZ9uR2vg1dy_A&oe=699B0DBD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Augldl2mmKAQ7kNvwFJzv-Y&_nc_oc=Adn00q0vrhjOPTdRczaFbHas7dfZP8iAVxgcP6Luc1iwTjlbz69zZsf2lsj2qoscfEk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsxuxvbc9LI8n5b7ZmvMYIqRwJknAJN5Tbfm-omM-JcHA&oe=699AEAA8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QwbhiFKqpIQ7kNvwGklsuH&_nc_oc=AdlEmRaPj5JpZhGjJtyW3Nsv-y2otg0x_kLLXD-dBDDHDQBUCpsjSkfr2303tv0FgQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsEG3UgK_FWwFvTxOxLMaeKBQxhtc44FC68nXA7gJCCFg&oe=699AEB85"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2
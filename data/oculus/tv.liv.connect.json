MA0-fE-uEmRx0Xt-LKeZN_3r3MowATAXnrOTTOa7bwJMg8Z1JY9AQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pI51w-bqRAqCj6yHi9kY7lMH1T333S12gHKfGpo0x9A&oe=6A36B9E7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuxAq67wI68Q7kNvwGvLM3E&_nc_oc=AdrdTQP3GLpWhbNzO1dNBFZZoCMKjlXTQPMKyulcPD_3LSBo2HfMi-exmDD_g5LhRU4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qoZ0Lnu72jG1ekmsacfSZ7GKy9C2bv7IlCtre_8AGbA&oe=6A369F8A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zB9AqrdjYj4Q7kNvwG5tzIA&_nc_oc=AdoaYw5SFn0-U1QYN_OQ9C5rKEzvKYdZTJWlUPFnUS5fLRIAtipVIEfQMjS3Rdpgwzw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ezkPqJsV00A5JCgAag8tngPe04R089zXWwA1PjKVfXg&oe=6A369EBD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w611K2rIKBQQ7kNvwFTEFqQ&_nc_oc=AdoMzPEt-ZS3a2Zu3uvW-Bwq5RwBMEoLwVkg7DFp8AIegfVd6zu8nFyOaFf28gVFvWI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90U3v89GPPmPKqOPEbHlJUTaMroG8NqQs0o_1z2kmY1A&oe=6A36B3E8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xiq-rz_8FM8Q7kNvwFBtKNt&_nc_oc=AdpzGXI334TDM3rxcAkwTQtFWiO5Kcm0pANeB2nO6o5qmz_6qHz6pPKGL-5MhKsPbgg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JHVuEvG5zZbcdrBVR-LtswwOacW_staCipD21euAknA&oe=6A36B4C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
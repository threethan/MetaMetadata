plDpLYhCtQjE_YgMTLOdwvQHTOi0AofuLpvj68T5AFuhhOWssUE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HCLINOSgh56_Vw8LNIPlfO43c098lTU6qMC43O4UrXw&oe=6A1AD227"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXcC1dNOUnYQ7kNvwFKoVd5&_nc_oc=Adrk8wmIRQIbdjfVJQkCGW5PdcYWhyP3M0SBl8K0Wk22d0jqu2eeBF73BpYQyrY7ulg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OSo36a-wHvtsm03f6--4nT4LUtcsduVFUKPCN0ZLeUg&oe=6A1AF00A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gw07TBbAXpgQ7kNvwEakW9d&_nc_oc=AdqyJKThe38c9YG0CwE890Kpn-JyZeJ4IJJLQnZfHrOAxlO8TresW5s8lXvKmiGBCxA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7G_5YWFaAwYltzot8AjhFb6NbGIs5_NEVQ--ftB4ahhw&oe=6A1AEF3D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMws9eaJFaEQ7kNvwGflOwg&_nc_oc=AdrsxrAKzKPlyJc07tC6yYTrFuRISsT_liRmFxAzxQpemIgbK8rhWKKn0yOsz2LYypg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ylMDL5q-C_Li7hJT0tZzSi0TKnslGDTRYGy6UjFELuA&oe=6A1B0468"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0GcIaWae34Q7kNvwGwiFbg&_nc_oc=AdrtQCsj_TC1X4Wa5qYZ36kkNxf818mU76qcAr9i4JsfIo5hRJx-h7fcf48gyxFqcho&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qNEmpH3sDY2c-qMC5hhvo_vvRY9vX1slx2mCJ91LwJw&oe=6A1B0545"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
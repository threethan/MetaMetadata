U3OGO2XPcr4pn3XcDrgnAn1HY4UaqWBeekos2taLVXbO286vT44&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RYvSWNq9sVM0vYv9tTRQL8L6r9Q54zftnj82u23GXYw&oe=6A0EF4A7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=399hnGm-TUcQ7kNvwHCC3ly&_nc_oc=AdoliTxJwB1vhi8m39HGM_j86PuJvwHaNGMp7J9G_WyiWEbyntYLyyQdk7qjf0Da_CQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VRkuxIPBnyShOYbCln1pGAM2gKznYBx9QzDyKZpOrFQ&oe=6A0F128A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGepbgZJsLEQ7kNvwEDHmjv&_nc_oc=AdpaX_tzfe4gYSUIRhWXYlNj55mcCLLgissKrdmisLRAcAK1ZxKU0VdJEXc2oCMPsqk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7u5J8mxK-d1NCVAXW1puHH8o2rWDDmzrqiuMUsQmQCvg&oe=6A0F11BD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQo1lMHsmI4Q7kNvwEnl8yC&_nc_oc=AdqEb4PpdTK-3YElBmK6tqZ9topczDrJ5t00t69111X8qzHXnFWXz2RkCeZH2fjZv_A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QU5eyXn0uW68rvtfbj8dGWPlhfLX8fGUU1YlFFwyEAQ&oe=6A0F26E8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFUMX5HJJW0Q7kNvwG9weZP&_nc_oc=Adq0S6ZtDuDVZlkBDCj-8wjq0F3H7PCVXhU58dQQ4p0TM20-q8Xt0eZRdsb1wYJ2xfI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6f3LmPx6a8JYBhi4nFCNP19ewfGWXhgJNsufSHcE4Qog&oe=6A0F27C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
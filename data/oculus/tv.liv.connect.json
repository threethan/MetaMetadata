BF9Vu8Td_PUAIM42O7804G25cBFJVuHIMmy2fH_SGZWWu8Kyh38&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6k_1VeTT5FGtTRxejEKoksylsGUhfqHhhdZxIYgu1Ow&oe=6A82F8A7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCzdjuxH01gQ7kNvwFgtch8&_nc_oc=AdoCLEJYOaT0auSL6xC9Ux7mSyQs1H-FLy_qxACTj2xc4FNxxmTyoMVHjOnejRwTw1k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFl9G5tPzWMOK65PAqWAUUK5fyW0k4uWrTozJPn3aHNA&oe=6A83168A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbDq8hHT_7UQ7kNvwE93Jt8&_nc_oc=AdqxlWN-gkWXjVBBVC2dKcBM0_E-5u0TNf0zECvKU0G2FKsVi6W_R7cw4bv62W4r0xs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnZKEHi5h0fQB7Kgz9EZ9WBgR8IivsLmnHR9ItOCA53Q&oe=6A8315BD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zawPviyzWlUQ7kNvwG0WsUV&_nc_oc=AdosFqYK6Yc2Sr0xaBYf_yp8ikkoPusuYrSNEsGSHT1dzBwcaFBJVlc1ggE5zPw6gJQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7VM8VwfTHPG-PCgfyYTx03Er7aZ0J3xY1qAIGDSYEqQ&oe=6A82F2A8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxqMw3MByZ4Q7kNvwGWNMpo&_nc_oc=AdoEyFtb8-xoLOQFBaESQVgEjl7cJ_wkDkOgxuTQ1NvqDC3Epb0nliY-tSarG16Kq7c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1ZQ9YduC5Fi4rq_ONGhMu4_umFrSdNJcd0qhyE18fyQ&oe=6A82F385"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
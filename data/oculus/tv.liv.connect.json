O0otRNit7e2Yk6SsM5m_M4s-YdeZN9xtJWNXWfpnqoZpQZ4llac&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hnAzKX-19o9EZTvrMyhKppCIv3PaUNtqueWyZd61N9Q&oe=6A2444E7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8cUOwaeXbEQ7kNvwHaNx8k&_nc_oc=AdqsN1T2__xru1Ne74xHZjtiivrfR2PQqswhnDpfA3SdYDD5P_-yalcnWDTgE9oyx20&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WaTVQjY7FRkgyWXMHd6bsL67fBHwnkfu6NPeymX-iRQ&oe=6A242A8A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zGoxUDJSuoQ7kNvwEmiqFp&_nc_oc=AdrpEaFjtM139QPH-N5KaQKf5zhV5sPjwCMAev5RL1Vk_Vra78p-xFVZANWMCSruysE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GPxymR1GGwiiNx2ckYGtLZYUPQOXtXfo7cvBPeKI0XA&oe=6A2429BD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9PeUhWyg3UQ7kNvwH5UQ-V&_nc_oc=Adquh4JhdpFF0rANtBGHcz8hUJWZnl9kAS2Z1B4bW5sp-yZEtV50Zdg3ed4MAEoI3KY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XDa_bs_0YXv7-0o5K_EE4VCSFXgPaD74-Ocbg5rsD-Q&oe=6A243EE8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwRkG708gaMQ7kNvwESus6C&_nc_oc=AdqZldsQShLWDogeZidPaOdrImXDEmLxZiA6tWbY7EXsF5An4PU5Fzaoq43mtWbnroI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XRNEKJWuYcNlcL1RaNldcPx91IlWCdlaSXk0L_wE7mA&oe=6A243FC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
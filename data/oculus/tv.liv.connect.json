Pp5SG9uEm4z2s-cUbgbWH72Jb5WzaOmKAY8RBr9tqdqw05bxduI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nUUMNDUEmkrgwmHBfU8BA-IooElKQfoo9o7hLj58RJA&oe=6A09AEA7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaSU_PXwhYsQ7kNvwHkuDGD&_nc_oc=AdqMhyXBoxivrnTblIn357AtzlcXR4bqrj-kAIoFEwRm0TrOkucWeyKvrexKoo6FU7I&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oTR58RhfuftBZMQuceDvyqBS6Y8G8Fuet_uq5OgaoJA&oe=6A09CC8A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sJg2Luf-W4Q7kNvwFyGFjQ&_nc_oc=AdoZAwomevA7-2Tx7iaiZKqbciPU1yCHFU3EpLXy9D9Rd0qZrqB6vqrHtOi-GZEyrr8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ijs7418p9UUnFIwAWFE0SlwsM7DbO3g4g09cCOicxsQ&oe=6A09CBBD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73hmaqI2kuoQ7kNvwHiIQb7&_nc_oc=AdqWwlyMWjwb1xuWO4bIblaTkD6xp8S7i1ePtAuZNu6BKKKp278PWBeb9s0koA3AvnI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pRk0_j0X-bi5QUs2sjVfexkNTaYoiccibQu6FN8rtlg&oe=6A09E0E8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feSxDgB99dsQ7kNvwF2ey09&_nc_oc=AdrpF9OsrL62tuVN2OIt3d8X5JTev63g_Smmm8I8rxYMAVnyUv71dJ1zxSNCGy8DxFM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xPcCrwKxGuDmjakPZO1-6KfipfFK1Q1Xoa_9886xrfA&oe=6A09E1C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
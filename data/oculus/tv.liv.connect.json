FbJ3SXaDvODX_xJPmVBhebOvBxYJIS4D1TwSBjjsq8rwMFm23gY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeENxQcQfn-YRErFP5fyD-35XMUAwIVqimLwN8iNxzKg&oe=6AC91067"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xW5Ebq9GyiMQ7kNvwE564TP&_nc_oc=Adp2hRmx3Pzvx2AxuXROn5YB2xgkw_9XxVgrzt1mJ3ILVoRbZt9F5DF7iJgnAjrfBDE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWO631EG7ebOiGTKO1dhI_4wrGkWCc5cNUDEowC-oRDQ&oe=6AC8F60A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vZYcvtmufgQ7kNvwGA_BMX&_nc_oc=AdpaRwSwfwDkmEgCV55by7ZNiPUzRBYMxOHT2R8fEnepx9724Y3i0w_kIsVhukMiqYs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXcMPQd4XrhHUGEcN1vEaNL606bCa4UTfxZEWcv0bk3A&oe=6AC8F53D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36qPD0-75PoQ7kNvwHgkKHe&_nc_oc=AdpDBikYtaOKk5JvCGNoVyKhPESTz2BDthi6wgrQJPtA0U44tdEP57qTbGiLEVARV4c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe85GRRaZNiIi36s5jOKhFpvE-HGENIXMe2bgTIJygQw&oe=6AC90A68"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F9G6s-STgMQ7kNvwETP-4Z&_nc_oc=Adr70GaaL0tuOC2fP2kI4zhkzE9xRIEnD9BuwZB8renhK6ILzhoCAh_K3EMVsO8VEQ0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvGlndOLZQIXmXqhY62Adjwyi5XV6_8ubqFYRQZGmnDw&oe=6AC90B45"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
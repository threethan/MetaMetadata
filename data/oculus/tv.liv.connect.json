KY47L8ECYNy0qcwQb5gITHpjl8uChU5HxMnRrfxzPFU30eXnb_U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ynNxPVCa5j-jCf4Rx4Sa44Xnai-YeFonEEqjkHPfy-g&oe=6A132167"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhvzKz-zCykQ7kNvwFyQqe7&_nc_oc=AdqE2Qes0KsUcCFrZHqLA_R83aUY3IbcJzIsNn_h2CtR3bhw4WhstjlBLGzWNZBuNkk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e0-bAhqN4cmTT10aVlujAhN9UUw5kmNeffxWjKL5W6Q&oe=6A13070A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDXwWk64We8Q7kNvwH8LKBE&_nc_oc=Adq5Av3oVeTJaarycdH515cxvNtL5m2UPHqD27UpFaZSqyDsRCu4dz6EsnOss3t2Hwk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uxpSWBqB81kMQq2LRslqtVENykmOIU8_EIqd-O1weZw&oe=6A13063D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yeMdhdOfhe0Q7kNvwFjQQJr&_nc_oc=AdpJyoj5KGK8DjAcXh-zB6oBY4RkHTff3ggNikDMr6S_xxMlPRoV7LIl1RNa1aGDbbA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CuzDwR3w2BNSSkgxju7kp9TDnDsdRixtnO4qipCVzeg&oe=6A131B68"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tA9cm-5wUSQQ7kNvwHO1HW3&_nc_oc=AdpIqJZZYWiinUJKjwhaQDOyrquAhDM31BvHbaUEc1G6BheRr8GIvE-d87FKmHOhitA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rsEfcIZkwyJzmWdPWbsrNzNiSy62UP63RpuvItQEERA&oe=6A131C45"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
dqYFbZDDJ4kjAjh8r-TogfuNBHwtNpgU_f04bNocLfMe2YSGmRg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUX29gGo7mv-UKb-U9QKG9bmPdzMjDPE2fdI9s77XsNw&oe=6A58C8A7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnbZx-dQGj8Q7kNvwEPCyuf&_nc_oc=Adr_bOLSH34dS9lnJGoEE1TgZBvXL38E8Tuhi3ODemnpPhSbeGF4SvSAsTe4IpNZFkg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdcB71rrBJ5WVo5_QcsAp1rwnNg4utTvaboilzbTfpjA&oe=6A58E68A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lc2gBnLZjVQQ7kNvwFMNKfN&_nc_oc=Adr9phoIeeq3CarjTnoHV1zgpBRYa_A7hWqk7jRnKWxTIoNruUSKBuoEq7tHWuEPt_U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmBuZOznZyPnCh2e_LmGDIy4gy0wVxIyvmesZCW77mHg&oe=6A58E5BD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyrB6MT_sqoQ7kNvwFWabZl&_nc_oc=AdrQ2XjOTwBNrKlTudxJ36QvN3n5FE_46kJ9ayVz8iMTvmw8LEcJcle0P4WONl_V-Nw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIc2cNEqHSoqdvKBZWlzzK-oEwZgCsmTRf0qjq0Ebmbw&oe=6A58C2A8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jWuCMdNk7oQ7kNvwEnG0cJ&_nc_oc=AdoYnMdM9PuczJdC-eD4Nf4u0qXwbLQeJJGluyuWH_5XCcsbj9aAjiVi3w4xHmWYWBU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCquBRQWTwPmgf22fNhsogaxpL8yv5kaTh1WohuGJLGPA&oe=6A58C385"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
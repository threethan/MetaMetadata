xQWpPuB0EVXa32F5jivPBlW-k6o5pKoUcl1yr25IhXGGtn5h_MA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNfxWuc5gvUJbWQtiCEoHCCCiYqd6hBgVOHMJxTC3qWQ&oe=6A9C3D67"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-be9zX8QwUQ7kNvwFmCYCN&_nc_oc=AdpQ-ZyhrPnTn7-bAIYJNxFMJ1rKn8C3tEy9bzLVsHv9jZsYHRL-uh88kBAQ1E-2E-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6q51CUZpUw5ALYl3LIRvdUssWPMQzpCW-0-UKrdn82g&oe=6A9C230A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6oFGWODh1MQ7kNvwHnXKXh&_nc_oc=AdqvAKwn3jNqz_t1ptOZIuF3FjvEKhQH8g3OPEgcyYcW3eb9yHwkcvgzHh31LOTcdJw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVS69dhLb3oW1yzrSqmxoYNZUWxrOUhEBMJX1O06TB6w&oe=6A9C223D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aH0bYe4GMiIQ7kNvwGhyjYO&_nc_oc=AdoZQ-l1lkJ_rtO65Yz_enwG5202N22NCGbGEs1aNSQhQpYAgGKkUROqGqkKNyxZK_A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdpOX3YfmXpJnojaAJ0XZDfcz8UrI4mmyW4hTApvwZ8A&oe=6A9C3768"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zWFU2FeCXsQ7kNvwGtwOXt&_nc_oc=AdoddIUgdRgOQCYyLqDI0QGzTCfIOjmP-iat3vgAMRWYkBLcMRJJuXskMemCtbfV6SE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcCihVQfINaEHyrnECkGtaZwrvy8n1Foi5tcAW4HRAqQ&oe=6A9C3845"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
VE-h13jxz8QkLS9IJk90mEdUmRSkLQITDX5Mx8MJlcsEm4tDwSw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTseHh08aA18xO9Hj3FBoL-an5FhmUqVnY7dV7TrNUBWw&oe=6AF9D7E7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNvF0EeT-9IQ7kNvwEeEOKQ&_nc_oc=AdoYnC0IcqrIIo--A9kS6C2_VKzVvoFo1uzTg5xlQbmaiF48PdGmPAIx6bX5M3SEWNI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH6CL9z8q0Yet8xOvaIdmsNQ061bLQoeIUsR9SuQjaXQ&oe=6AF9BD8A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sdbp9HDzMAQQ7kNvwHTN9n_&_nc_oc=AdrSQzBoen0ev4AznC2eZ4TZL7HEinbNNGCiUabHYr7NFU1bNuw8UzyEQPdj4r4MaeQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIPEDmOVDkqkBvu4dGRVI76zEFICOmIwA5zE1OR6R2zg&oe=6AF9BCBD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1Ztx4Aoa8wQ7kNvwE3Wsbp&_nc_oc=Adqo-uTcW4MmNTf8YnavurUnznMS7MfeiaryrfSlj_zU1TT9I1jdphAvsLsIx2TbpMU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPjWGUqPT1uLxbiYwdvKR9rNy5XA6DWq9QIwrVuEMS8Q&oe=6AF9D1E8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdAPl-BFpo0Q7kNvwFOxHX1&_nc_oc=Adqgnuix1JInphHWG0WeMlpV2Tlw_M7cWpEx_Ipm8yrlwlTltPR7wrWWbwu6ufmTcXU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuVC1eDED-YNnziNK6WL_bPq61S5n0MWb6f4IvPEz3Fg&oe=6AF9D2C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
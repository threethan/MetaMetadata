X-0To-weXniBGbFEmr6LTk1TJy2dkBbN5HRv3MUG9n00xwxgt7E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFInQlrv7aSGUC-QeYxm_hMihzv_c13JBRsostw2TaTtw&oe=6A8055A7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fKfoX7OGyYQ7kNvwGa-8mg&_nc_oc=AdpiOpjY1DB89Cf9s48o7tSIMqQCPWbqI_b0KFNNNG91bCEc98dSB2lCPoQ0xQAivp0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHTCKffjfVlwvHj82jZeFMHAefk3E8hC8qx2PTcghMPQ&oe=6A80738A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sFM2_qxeA4Q7kNvwHZ1-wt&_nc_oc=AdpGSKmwBcm2iga4WZ9htt6DoCebnmZKuCOCnnztGi5-ZNygjLbhoNWfkqgCxKdelPw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj2KV0i2bZFxITfuq3xW9mi-76nn0N0mhGcf2zjUGJZQ&oe=6A8072BD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zawPviyzWlUQ7kNvwGmO5ml&_nc_oc=AdoRtfNZvqJbz_eFguJOh_h9C-RiS2zFRnd3Xdg9zzpwtZirp1SyguIRXsAv4EYUq28&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEObI8rWHfbtlHiEEP9TzmNZOFKAf4HD8T2JgnVZMX3lA&oe=6A804FA8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYbFtqjK_qoQ7kNvwH8Rx5A&_nc_oc=Adpl94SzskIYlEp6gVWtllNxpA2GvyPj6J37-sRadeEtYI7LxtsyYkRqEwVhGWLseD0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJX3HD3pO85leS52uufJ7CfNWOjJYIArpVzfev1rypeg&oe=6A805085"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
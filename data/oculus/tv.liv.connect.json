vE3BOeVwMhIu7tvTaUMHHqHpQ6DT6W5cll1GENoHzkrvsqqFpCc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wWieVWO5z5aKQQH7ExpV1nA2r2S7wvoRZdAl5Xld7pg&oe=6A21A1E7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwdNgWvZCVsQ7kNvwEgmRWz&_nc_oc=AdpWqEiN2IfUhwkRltGXB1hOmhrWj2GHmsla9FqzjYUPYaqYW2m5EcLaJwIWzTKY6fA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gZYiWptJT_x__xSkKnAFx9esyKMNEuSl3ZxrDVQ5UGg&oe=6A21878A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POJneZhOQbcQ7kNvwFddMv8&_nc_oc=AdooA3T6vDJCIxPQ9B8YAIdnqacu7mSl2sKX8wEte5hWyh7R90kCJtY6HNNj2aHMZMs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1iX0FIUqDnhpXZam0U6VI4DsGb_bdF5uTW8n6iTOJmA&oe=6A2186BD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9PeUhWyg3UQ7kNvwGKKw9-&_nc_oc=AdrL0UZkXOdFrIqN9rb4qIw59yVnRYDPX1yHcfsjaOwgUuY0jG7-pzeynKXnEChgzD8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O21QzRCRwNRjbbPBjCpT4JzQI6IbjTQbeaAAEl0OiFQ&oe=6A219BE8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXP_x6OtQ5AQ7kNvwH-d1zb&_nc_oc=AdpL_DYDfAXyljmHBUZ0EcJwVnnzRqx77DCgeLgncCrPhLkIXFdpTmTd2WxJtjrMo6w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-J2kUlvbfeBOxIbOsMmma60LFqEM8ywM9WP68CYRivaw&oe=6A219CC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
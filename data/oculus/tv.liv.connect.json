V6g6sMtoE8TNYOJifi2wy80yUrrJKCEkTIsQWcd3lzrFkYayUVw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uE3u3YsW3xqKFwzSNXu9EhJmVtVlBCnfjZUarOdzzcA&oe=69D64427"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRZXO8r53GsQ7kNvwGBTiQl&_nc_oc=AdoLfQTBS13__AMH2KfVTdT6BM0WEhihw2qaTmvrf_oe2yId2xQDx3iTttsR5nEZXBg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Dy1VzNtdgDl7jO4tJfPYFZrWSSP-p3hc7MNWDkemFgg&oe=69D6620A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDtGjgAZhagQ7kNvwHqvqC1&_nc_oc=AdqQvdRgO5NrQbZ84bpDnOqUeSXPX98XghmEiBv05RGgirUm1uXYJmkOPLGChjaOVpE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0K6Hr6aAIXQcDAphYfDG0-4LaeNnkld29JOAiYajTPHA&oe=69D6613D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nB8RXQ3PNCQQ7kNvwFddKWT&_nc_oc=AdqjA5GOa6k244sADv1A5vSpoYs1Ua473QngN4JC-LxmGshXH1ixGQLbGjY2k0tJ9ys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YeAalg0nBKekQwf0dseHjAcoSfCDkuZl6jH7nlx_gQg&oe=69D63E28"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cl4gT53dkT8Q7kNvwFv1PdI&_nc_oc=AdrdV5BBmZHvhnmFzhyvMh8Llk7HbPJ4U68S0CI4c8Ob0FbZmDY90MUggxENCVLOXpQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JAdcNetX8XSZif-ZjaUhdUFED6Q8H754ZTGYYbFp8Cw&oe=69D63F05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
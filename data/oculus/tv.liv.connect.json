-8W9BAwIoVTXu4y4OXM2GKUcSebOky9ad67-E1aLFIMJciEnBpc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SnNzNjzXCyYAivQrpspQc1Da7US8yQPHUTq2zbjD24A&oe=6A007427"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAGGDCCT5nQQ7kNvwEdBpQX&_nc_oc=Adovl3Ji8vovC4sZrr7hTzZD75-q91r25Ek_ILeol5k7twP-m7hWahCG-gpxnlXz5S8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TU_y-QBLKNMHCSQbhAAtwG7tyjoVwM5rp6tkdGWnUyw&oe=6A00920A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnw7Z0WGdKgQ7kNvwEUDJgq&_nc_oc=AdonIhWgtPzRwtjXRHjPgIgQc_ufmqPmWt_jSFoV8RDYqwqnbxQI82h1F0CBwTGzTzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Q2nvV4nNOqADZYJWcWENn6kgtaf8WszlNlUt0eWYT-A&oe=6A00913D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XPnh6I9hNsQ7kNvwEefo3A&_nc_oc=AdrpQCR288hw7ogVlTSsDanqhA-BKUs848Wqy1UkLsf6VEYfdX2Shp8AGN_3uPNfcwY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q3UQjnbvteUFgFuLbnX6PP4MHmAFMNi6dwb-9nkw3Og&oe=6A00A668"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lRKQZn9xlEQ7kNvwF-bZ0Y&_nc_oc=AdqBXenit8Z7S4q9fVS04IjDhU3CFX5eDVpqM5IsZLvXq6gz_F1JYW4HDDg_dE-xSr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44M1VFRprKw_6xMq7ZgbsqhAhdyKuoGZVvpClAvlewgg&oe=6A00A745"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
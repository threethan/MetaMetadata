dn.com&oh=00_AftfbXk4lhSOrUflUfAv2lXts1j02GJRUzlB0WY0fC_EuA&oe=699EE527"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wrl540QwnNUQ7kNvwEvyubV&_nc_oc=Adnn0BB-xBuTAmqhLEBXhsjVHZB_RVX2hb1n5I_ev7HgpV0T4fgKoNamPhKKsYPYFTY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu6xEfP0G2uKXqLLrMTHz1o4G0YwymrJbMGHEt-tO1EKA&oe=699F030A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mCqpGmwnV8Q7kNvwFAVYMa&_nc_oc=Adk8N2UB1QcP0hiAE3JWSzZAaPgIqPYIcuy6utCiKhf446t-tCpf5xNGTiv_vHhPBf4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsBnHOr6AuvoCtg85aHuIFLxOEpsPqreJ-1kuPDBX-eZw&oe=699F023D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxXmga3_ZfAQ7kNvwHQcSdE&_nc_oc=Adk2K05P-PRSB1pkmC_akAG0KKjQy9npSJQ9twxqJtXYt5-1m2O0jQNTO3ss2xQb12g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuhFYPN6VzKkLKmk7kso7UIbZ6vB8CzxYsWf_wBocPdOA&oe=699EDF28"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzxsLWi20WIQ7kNvwEuDiMc&_nc_oc=AdlXW3LRD-MPAm8BJVR6h8QZTK5lmZdiXhod1GVyR59SSIicYWC5o8090nN0Ge_HW0w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsZM4TArEGL7X4xVzIy58p_caML6dXz6tdXLkiUFnCu5g&oe=699EE005"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2
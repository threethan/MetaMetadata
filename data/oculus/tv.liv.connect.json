a9LXe4-7VG-SZcfPpIPRpxtnjaGpty9XuyxJynWeUpj3wOrRu58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pYZW3wGKK6cJpJNsU3XtuGN3tm0pYaJW2fuHpLPyFXQ&oe=69E37327"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zi1EgceM8h0Q7kNvwFTk90i&_nc_oc=Adr7FSu-8SDJ03wWBDzhvuzq2U6ruN2zFi_yj1Nr8Y0O0sfnf5fk8ZFvI6QhKDq-4SM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LhAzyFZhQlNYa-xs-I5XBlbIPJ42ijHoHr_6BND0ogA&oe=69E3910A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Srv0ZP6Dr_EQ7kNvwGUVZvK&_nc_oc=AdoEO7M94YuilF6kS2RfEyZbIaRmgmVGPEzhn8Afa0vOtoNTg9CZxfCGeRSiq4GUjcE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SjkepCnAPF5hqc82BP045m6GfWN5pxI2SNq0IvRIVMg&oe=69E3903D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ed3DgOTqvoEQ7kNvwEO_CV5&_nc_oc=AdoLJXnnxBoQ80eSyMjuyUJKDAvXu09ZWNcgOwRyctNzG7byegqXESs_G9tHxpU9Ths&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QcOMoCv34VwT0udtOvoOma2hKdcTEIo2bnF95Gy_OHw&oe=69E36D28"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTi4wkXevFQQ7kNvwEDjRWE&_nc_oc=AdqyaWjTKu5xIHdHD3oBY1r3m-xvwCVT0JA_CtZKbdJL8j3tiZe6SO6iYCcgxG4AEDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sjg6DopV--RjHt-zP-k9c19QrNgPmKcG-BDtH_ZT5yA&oe=69E36E05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
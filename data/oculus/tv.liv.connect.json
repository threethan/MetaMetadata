JwZz-KBfjXLdYiHK9oFejjY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwk03lZNCAPJ4lfe2NjJ3e1cOeXDYSLwfA1_3PXZNesCQ&oe=69AEB727"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mw6vh7_XSHEQ7kNvwEEUo2J&_nc_oc=AdkLEsjx0i1IsTIXRxXnvPni0GBjtfIZ56DQvAkQMYgUQwq5m-7_HNRI4EEZ-xr6ugg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzFAM0kaUrEbhbLF23HFFcs1faJJ9Adf95ydQOEkUEtQ&oe=69AED50A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oOhEeOs4HQQ7kNvwHG6nyp&_nc_oc=AdmvmXvvu2pL12uOkmGgGNRxngu83jVcNhzZXqYCpOgIcf9fmE7XnzRfKiJILzci-IM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcdPuOzK9iFFm7lCV47TuFIHy22MFRN5MUq3p6l0gh2w&oe=69AED43D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5QWbQUyVuwQ7kNvwEncPW4&_nc_oc=Adk8IOgTef-sdQKAbDVZ6nj1KZoqSFng376GjH7Vf-6I6-RI6XY6dNPQF9F06CP4vyo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyv9PDbJUFwaCV7FeyK8Y6jav7ZgiygWa89a5kEgF5BQA&oe=69AEB128"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amzdIwBIGz4Q7kNvwEQHNOQ&_nc_oc=Adma-gH7NuMLhW4InS7R7IFVc-BTAPNwhb4tlE-nDDIFdEn8cWylJ-tNtFIc2qtuQLQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzqg19wT8_gs9htd9usf0mGvwJWRTalIZPyVoT8Fn_dhQ&oe=69AEB205"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "S
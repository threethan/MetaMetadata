yy4-1AEsb3kLUlJqO6znvB8FJJi7cX722FAqmRLBCoylCx0UjEU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FcIc4qWbfmtfR_VSwWBLCmgQgjyqPx4_E0WJFlUauXg&oe=6A3AAE67"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6xWig1fXioQ7kNvwFNFfGA&_nc_oc=AdrE1h-mvNKNxL8-3VB4US5Ucc_W4CSdpCS_l3Qzi8uMPDz9hD3rWxnXk1huDqMH9fA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-goTO9DyA7FGgdIDBflTOo1r83PLkhnc82gJW8HkpsWQ&oe=6A3A940A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFGipRE1qoMQ7kNvwHuJ55W&_nc_oc=AdokjwEKWJJKo4GgiL3MnZIAPWrjshJDPTYJZCSEUjjychUV-7Rt33dWis1z1N-E1xM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83exKMCo5pqxvrqnDwM-zObzw9Ojutj8xsr3PLe7Z6eA&oe=6A3A933D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0a52OktUqAQ7kNvwEnmnuW&_nc_oc=AdoV3Wlo6j6HlvZ-nvnbMP587G09cVQtZRN-WcBkETGQ7OQI252t9k8L32Fm_WdFtJ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Vk-pKO2RO33qyhrcKaplnEYp5rYDGC-fWl_CRLe6hSw&oe=6A3AA868"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nj_k1HiZXYQ7kNvwFsDyPl&_nc_oc=AdpEOex2gAD9RV907VAN2qXgbR4J92C00sEz4otnTp2IyxZebNeoSPEXLTH0KpP9XMU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gePLPxuK5_Il6DTu2f7vpcLrPbQzGBewzsLUxQTx4Wg&oe=6A3AA945"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
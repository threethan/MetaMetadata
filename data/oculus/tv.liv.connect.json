BRPKsIGWViWf42hbL_G6aTRyvdh6NWLrFWB_kWbSUzUD8GyR9rM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eSibk-ETyeMWgRKnzEc7Xb5naATU0PIvGLjF0xthsVw&oe=6A380B67"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuxAq67wI68Q7kNvwHskOvK&_nc_oc=Adoue5Qb2TqQbmYTrMfQlO751JbZXm6TArdkdLD1LIey1hV3v94POsrnfeKVfFsvUh8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zwFV0LhmdGjEsozo9T5S8TK4l-ayetMEkEdlkrPJyuw&oe=6A37F10A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFGipRE1qoMQ7kNvwEk7zde&_nc_oc=AdqizOU03BXVMLjtooFbDUr0iU4L3GdNqmzZTve-s4grpZe-8BdJmMt85bdfkPQMRFs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tEr4hz5a1sBl9mECxH0xIxpohZhTjJHDaiXd4K_sOtA&oe=6A37F03D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w611K2rIKBQQ7kNvwHeaJM7&_nc_oc=Ado2EcYZtLehbEYgxO6qvFYEjyv-f6U-PKN4aHFVlS_Zr52IuyVlFkNhJ4CotTsIsQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vp_gPykYvmySoFMmzlUPFKH6AbN70UB8yP132BPtF3A&oe=6A380568"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xiq-rz_8FM8Q7kNvwGzApwa&_nc_oc=AdoP13IItfhsbgB7pfJBlRAIGiSwc1MIN8o2Xh7CkCe9KmrCLrjFeb-tjMyPvXzhXNA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-pmdHUuJv5gJDKZvrFMF-cMSVPmKsu_Oo7ISg87T4lw&oe=6A380645"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
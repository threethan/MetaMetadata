itJL5an875OR59oBXHF9Mi80Iml6pm8GiJlUiPJH2HEKkc1KFDE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOnhPmUppM7MbVPs5z1HEGakKqRa6-JhDnarsyfjh3-g&oe=6A6C8F27"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fQbYegoJj0Q7kNvwF4EazD&_nc_oc=AdqHURSEdpTtWF-qWLPukyv7fVrytRSUJzTx7b1vnORCpyup1Q84Ok2zqRgObwUjQho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8q_eTogzoPjGf5rlLJogFRQyAwl1ifAoWClkQLDonWw&oe=6A6CAD0A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DP2KOiDvRSYQ7kNvwGKF1WW&_nc_oc=AdokJC_QSn8XvyGQIlDHXNkZOBsWVajyT5-5DmVqNvUqOUrZR7jHvqSCZ23rQNzLT4k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbld6uVOxEu2Nz1cB3uy0yGPwAQUHsM_79JT9Q_MlMtA&oe=6A6CAC3D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRzaWY0QJSMQ7kNvwFw7JOt&_nc_oc=AdrJZDkIM9MQdAj04FM6mIS6ihfixhVoV0zlfjX7uevGnoaYoFt7McUBkYcwilexaZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIwhcAU6cVhTP0b8_Rnjs4kzT9U9NhE_PlQbIvJsRFRw&oe=6A6CC168"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_DiwkwYHZkQ7kNvwHyx6GU&_nc_oc=AdpaXxxrmCgKto2MysIE9nlOU8u5mv_x-L-tkZviZNPqCmcUZYtdUr_iBtRWDzQcKCs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmHsPRolaSptle3zp7-aqFuu8O0mPRplIE9_OsGj9u_Q&oe=6A6CC245"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
aQeYgShwHneSBvfE-Tlad5jJ8uz7O-IOA21tPj3iLQ1PJzKhdTU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aXtiJHryaCvu_cty5oAv9Bvbs5AGV7c5ZiE9uOVkXIA&oe=6A16DDA7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRVyhGD432YQ7kNvwE4Caxn&_nc_oc=AdqvR-sGpBYNCc7QNz9HdIlnPrvLWpBSA3u4eO-E1rVoVl9OsBNDQK-nYqqAv9s_pHw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ty8j_3hGfN7nXPoN0hUDMc8VWFjaGRy2nnsxdqD9pxw&oe=6A16FB8A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdJJbiRTw7kQ7kNvwHvp-mF&_nc_oc=AdpMQ6St8TMZB8bjjkqR0Iw6Rmfb37PDka_tUGtWxFsQKW_vumtdQMTTMjT7pbgIBYU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WVO7iScwusa7lDdMO3QmWh5T15xH6NMKAF-gFoIC4lA&oe=6A16FABD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFyIxJsACAEQ7kNvwHPIqJo&_nc_oc=AdqN-7OFCCQ26b8lIe86iXLaFy6Kz4joNvSi5NsQfYPzEU-vyRmmWXCYHVQ2cNBjWNc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UHRJXVFV75g2pFHDa4R5pqh85jQ7H2iP4w4u6UQBLtA&oe=6A170FE8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppgCebt9jL4Q7kNvwEB22tf&_nc_oc=Adp9PkirHZUWIdrSg8ySHgSVEetVHNT2_nIIzugBvyoCgXtbuXMrNIxVH2e7a-lb1EM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68vxsLfBi8PdzZqD7o9h0UgJLTuRgn0YaQCeVhT8f9rg&oe=6A1710C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
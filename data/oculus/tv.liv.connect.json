Kd6E4CioG27cJnnJvQyHQ1AUaqluj8wmQDRingXCcqJBrd4LuZjd4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmZwqA9rhF0HLFSn6VeKuMxWLhyEA9YTuVVmbU-6ZueA&oe=6A7DB2A7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fKfoX7OGyYQ7kNvwHzKKMD&_nc_oc=AdofJ8exIQZPhz_Ty80t-FwIfrCb5RfwtM1nVV_Vh1Uy8hYnGbGutCqkC5wpUWDtJ3g&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq-q_9ihRLy9Gk03Yah1MmE_jsh7AGUT_WjH3UGgoJUw&oe=6A7D984A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_ih-DrNfkQQ7kNvwEHgjMx&_nc_oc=AdqrHyMizg8IchzWmdTfFxFg9agxHZtBJH0YxIAwq0V-ehgkpNUfM3YagSau_hN528A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa69ppEVvbpsavqu4YcLy7dGbMHzQyUtlBDK6ksjXvJA&oe=6A7DCFBD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXjjN_5HfvAQ7kNvwGN5Afh&_nc_oc=AdoBjRQiys405QhbTOqS7447J91IIo_CRbjEN0MT72r79jKNoB7gH1rA7GPC--7nMPA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRCi7M0JB3GRw2W9iKCu9BC6_JpiuNHbd_Ye1YNzy4cA&oe=6A7DACA8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYbFtqjK_qoQ7kNvwExmXXM&_nc_oc=AdqulXxxZKhEfxSD-a3pMvyHf8pbyVYVBkHcYa6C2fiKeArWJdC33ItWawBoXa5fkyQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3NOVKOKj-S0IFk4y7fMeFkjJe4HEQ5qAP7DsOK_hnrQ&oe=6A7DAD85"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
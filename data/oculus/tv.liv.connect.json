AxZYoGYKJOVn_xB7yXJkZpQvr5oUmLo8VK3JSl50-eikBOyDX40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ9gSo4KYkoEvuo24eHvaF1CHULqj4bRU42aJkIWw0KA&oe=6AF734E7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzthY_nW1HEQ7kNvwFpHpCK&_nc_oc=AdppIELKLszHA3nlSAATwFPcAwLjjIQpHbik9TQD94YobXvyu6oD7mejoIdOGZCX_AE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkkuYNGt3bxqOsskYHyoPILZakOkzl1yVgq-FWfreXwQ&oe=6AF71A8A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aq9cmUz3dwgQ7kNvwG8tq0V&_nc_oc=AdogyXNBd5_mIZyA2UGTqVfeGvzzFxDkp1GZhdv8FznlWYul7lzUZCCmvzoLkGs5bJ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE94KiqXIJLLtLmLjAC00CSVhdiURTM_Wme1Q4oZVpdw&oe=6AF719BD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1Ztx4Aoa8wQ7kNvwFppty8&_nc_oc=AdotAUvyMRbVQGGL23x183ZljH6o88OZKB1pZROVhWLODqT6FGaP5pRHObjiD2apK_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP7RpbemjeAVmuSgIxAdXPuE4MV0x6ZmbVIPfTzvLPEg&oe=6AF72EE8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aP5YsNXOI8sQ7kNvwG6CrhV&_nc_oc=AdoaD2SZkgwueNbtnYzN8mTwoCX479yxcMVfLyNqGMSoVJvEVBe6A94jv25RLeh8M2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm-StUxrqGmEQXXDLQq11amGJp-3WFezSDQV3xUqCojw&oe=6AF72FC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
CmcClUVaZKdBZXD-N6jUrAdk6nx0W1fOWLIxb2Beh-uvEOnhK44&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36yK1IoRDMUjH0Xsbymffteip4E0kB13FIlYuc1aKRnA&oe=69EB5C27"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adE1oK_wOJkQ7kNvwGQ56pF&_nc_oc=Ado62Y_OJHQVyjd8OUZhq_PeJRgOnSCe-4X6TdUKeietZztMHTXOuKptgGoNACQbZMk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3P-HjB8h5tLyd5RhPHsPErU9W-8gafI6e7A5usHmpETQ&oe=69EB7A0A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vS_qPqLJAQQ7kNvwElQ3op&_nc_oc=Ado_AjmhtnZz0JlVzWpKiRQ5gL8PEbVBG1MGb_48ADPiRY7VJ0NjCA8SGo_56e215hg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JB0gBTJTi-msP7cXNpfSy_yL7Z5f_sAX5h2hcv6z2nw&oe=69EB793D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfoBEiKZZOMQ7kNvwG0Intx&_nc_oc=Adr_ErNqsy5Cw0TNRAeLu2qr6cDOrHK8njQsOOkWBgnYlHUAVxw3fUUfPyUAdTS-CLo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DcF_e8sBucwwwfbMiTXHsrMYuCZID-TZFPL-BWqovRw&oe=69EB5628"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgF4ZPskFEQQ7kNvwHSbNeL&_nc_oc=AdplOh9lSCdnrNJpedavMGDjejXDyPIW77G-OZqPrqAUw8kd1qWo0zGIhSk_utdxvPc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ycKTiK9teKfJ7MxVlyg0YbOfhQm-n_9MrnR4rRjIRuQ&oe=69EB5705"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
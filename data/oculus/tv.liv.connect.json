mU98JEJUNVsS3h_aziX351NPD3Cqxhl_Lf10LVuCfYT6sVrwwBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuaHBj69CNW2W5K4_bxep0I7T2rt0Plrcat4ELL3VESw&oe=6AE4BFE7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLRaR-3ORewQ7kNvwHQLczC&_nc_oc=AdrJo077y7xiUK8wrC-NaDwL9-lWuaOhTbCerOp045kuhL3br3HOcU_Sj1hhBbf1zcs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy3K72WaXySoTcJoGlBz1gIUpuzYcLMtW5n2fYM1d1FA&oe=6AE4A58A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wL17QUIy6UQ7kNvwEcdH7H&_nc_oc=Adp2PkqRN2TDYjhY9Hl0o7UYm_W6No0pQq7uci73dAEnuGwcTOzhLwMGQMiQT4K8Cns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-LfwbXGPM9Tf6qqRDBH3XK3F6Fq_m0sQBlQm2QXawhw&oe=6AE4A4BD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwnBr6pZm1IQ7kNvwHhsm0-&_nc_oc=AdpeQgFI4ooRPg7w8zgf3o6l1DrFJB9gyWHSpvboq0jUZaokrpIMNhYD5uvViGPeSws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvfq80N8TrUVfMgnX6PetKLPNwh7e8S8cMY3YXCxVkrg&oe=6AE4B9E8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5i-qlAdFCCAQ7kNvwHmO_cF&_nc_oc=AdoI3ZbnnbjSyQ0EkoRGV5EjrNwUgAzttrwDMu33kSWaL61k7wGei4LoAB5uqN_FkuE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg-NiXS73tD37VoVvjpNAGtCMOphR3o05M3w8BL04nWg&oe=6AE4BAC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
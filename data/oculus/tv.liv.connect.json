-rt6jzxRuRF2K8s3vEGws8PosjdI5oc3eUvUlrvAjdEsfpyAyIE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgCdngPfjCayaraoa7d3Hew492FvaZGPlyO26wALRd-w&oe=6AE36E67"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnHMGteLqMoQ7kNvwFXspPY&_nc_oc=AdoSX6RFjhmE6JQ2oxAAQJAUXVmua5iNyEbdnCjNiKmcRxC_2MD0BbXiScouOzvLDfY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOClxdFYjG8QQ8uZnxSj_U7IbLBsGSYApzzW_qcFZSpvA&oe=6AE3540A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wL17QUIy6UQ7kNvwHLvYJ_&_nc_oc=AdrvZxSUjOTI5Fp1AWb4q7nKodpXmJs8i828Xqz_y2asCHlfuqcJgGsBL2QbLfgCzcQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOIbBl6nSO98iz_D-E1mJgPjr8uKqiv9xht-PhgVx5EQ&oe=6AE3533D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwnBr6pZm1IQ7kNvwHZylkY&_nc_oc=AdrNRGWkIQ9Lgvh4KRl0lbVWeI5NvZxjWPMiLe81gatbLYPL-rz0g8Do5x9d0-JYfKM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAclt5O3IU4uVdW8-tcnVmMrdahXF5gXulEw3oyysDdg&oe=6AE36868"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OxphB8yKRYQ7kNvwF9l7cQ&_nc_oc=AdpZ4xoDoltBxBaYHMYR7WWi9GuXA2ucJLS5uIgJjEE7AG5khqqDk3h2aj3RoyppDQU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPEJCOd9Fus7k8a4Em8GHZxNoBatDnqxjLSTzghTIaOA&oe=6AE36945"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
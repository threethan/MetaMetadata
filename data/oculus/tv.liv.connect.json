VQCUMuMs1y-42Wp5ZkMy5YgV8XBoV7zGpIJFicVTNotRWlhvkAY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0S6f7bp1151mGBRmvh0mPgK7_3ijp9J5Hf6X4srGuRKw&oe=69DE2D27"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSIiU9kLSz0Q7kNvwFr4uCd&_nc_oc=AdrHN0T8CUgHbNiWmjaajTwae4wLqmpU2Qnvj0uSyfSUzjxuMQAwYusq1lxeU384rJ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aHL0_KlXcTYsTTjqyU8kD4RtAhNq8nn8sw7KvlzZdoA&oe=69DE4B0A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-Rj9eMr2tgQ7kNvwHCZWTs&_nc_oc=AdqLn5CTF1LO4IukRSCmNl5yeH8yTSWLVeURTrm4ZMZkgzVSynx9ipzqxn3FaHF13GU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bKD_USx6MTXsKGy_2hymoHsWPjKbXQN8lKNXFAs_oiQ&oe=69DE4A3D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmCeVyRgq1kQ7kNvwGf1lsi&_nc_oc=AdpIxhQFXML_T_y1WjGT6WDqvW66Z3dSAjn85d7DsOG2c1zkUty02mVxLMdREbXpTH4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1m190_3OIU6_dUJPDf78djvMz5mFtkjg6tMP39NxA6IA&oe=69DE2728"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YDT-aKnFlwQ7kNvwHjqXpH&_nc_oc=AdrvWkQAsgG-y2RHfhvu8CmT8NfGgi77cVQ4mtCZxdwFkmq8vqmLX04xqtFYOHDk4lw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ry-pPB44ZdTh2kMWX4Fs2ipkmHSWhnP54L2VOgew3hg&oe=69DE2805"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
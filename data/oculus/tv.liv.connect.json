ys1GM4NdyqldGrALUzGz2a3CqyBh8cFlWAiyaAAnV4Y-xI_8xv4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1t63WAhUGJWPAk1Tf1_DE4zq5qPaiOTYhGTYAZXh95Qw&oe=69D4F2A7"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRZXO8r53GsQ7kNvwFRpEsX&_nc_oc=Adppv5yrj-DS0ErJPZs3hicnc78IpTSTql5V_KCSSewVn_53L9NBHMe1yQpYkbAlyzA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2afBx76d3BsQxDgJRbrKsvr-gVgChvwiILI1DFlP0oww&oe=69D5108A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDtGjgAZhagQ7kNvwGsDvre&_nc_oc=AdpMhvV51ffJ8tbMaFLh_fi8O_GJpRWssTXcMzqpKozo7wpKA_5PXdTSoh_AxbuNr-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zQi67Fzrmpk_qLzqkoZaCi2R4Q5CDVB6pw9JmGnGAaw&oe=69D50FBD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYCaXxk7ZBwQ7kNvwF7n8t8&_nc_oc=Adoj-gmd-T2JaloWV7zQKMKJcr8SVIb0s_QdSlK4foG9C2EVGiyXSps5UJOnpn13QLk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yFy4MW-Y5ujofy-Fm8cENRGOi-mRrBg-nGzEW6T0r7w&oe=69D4ECA8"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cl4gT53dkT8Q7kNvwEzHo6O&_nc_oc=AdpqD1J7rZrzTY9377BKOn4DR1H8rw9dJib_6lxexBYlWP6Q7isR6fP14TykmxXpKAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iNggWvV2qcHnIwggEw-_xxQ_h5KZXq9gion_zT9Y7ZA&oe=69D4ED85"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
O3_HNM3s2WSzVwsMh6hNZEI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwraqnNuiXkt6Tl2lPkbY_KY6kT6KxJKBsY7duGncfPuQ&oe=69B15A27"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNzxRfMIE6cQ7kNvwGdV9Bp&_nc_oc=Admrur5FK-RpV_k0bPG_mOhj9_40lMIsaVkhzWGij-RQbehZ7sVsq_jGXlTRaDJRr0U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPGo-5GkL52DQT5nvCtxY7blRgJGnT4nknYwuPdD4ZzA&oe=69B1780A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVXY_WkjRVwQ7kNvwGfMhoZ&_nc_oc=Adn_gqzG0Gsyn8Fk34USZkKfKUisiYothKaxz_aIfXA0aNcCKgDIMIlFhUQ97_filgI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3ZIROVPbL4lDDk68zmr5ORUWGc52d5aiTAgOCuAX2Eg&oe=69B1773D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5QWbQUyVuwQ7kNvwHTnIVG&_nc_oc=Adkbk_8jV7L_HKUwq2dOFwODHX-9balbui2DuTrfAsqI8hF9Y-7S-p30WgM3uUYoSDQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTEqpieZc9ZZXlAKrHeHTI9TWybb8kjRRThJPaalJGuA&oe=69B15428"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjAKrNIFcbMQ7kNvwGXVO_8&_nc_oc=AdlRGgifsmfkX0oLzL4Qj9ODdeO9ovpCvkjiVx1qE_UgT8NlTmaISVmOlHhvLsm_6GM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKeFVkzDI58n8GXjpaFJ6HnRG2XO9n0lPkGZlba7mupw&oe=69B15505"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "S
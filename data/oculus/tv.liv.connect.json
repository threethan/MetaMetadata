UqmGs5POjidTie9aNx4R2GmGgGWWGMKJv-pdOLuqfCsSYOgVYRw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TTJYE6a4yd-EgOemHdufDTK0Z5GwZI-5vEz2GNa9XBQ&oe=6A107E67"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=399hnGm-TUcQ7kNvwGlDpUc&_nc_oc=AdqZb-Ll3gN72pgqdf-Ma5PYUGCjaiF9de2-z6G3yHHXR_yoLW0iCbiUz1jydlfmF20&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NyNveSSxXQDEBpDJ4OW2wWTs2NgE9LQtya5G735C_sw&oe=6A10640A"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDXwWk64We8Q7kNvwG76XpA&_nc_oc=Ado4_qvr85CBu8R9DjhKjuGTzeIL5VrT0p0kw9S9eLfewiR9_uauSNu7ol7_rmexi3I&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62yiQz8qZ__ftjS4I_MeIG6kz2PyvVbN2d7hAzAoD6ZA&oe=6A10633D"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQo1lMHsmI4Q7kNvwGanija&_nc_oc=AdrEr5w9eNZ-o7oYPZeXiAGjNqD7rPAg3V43zQx48poIWU_zgvZBZ9eMgahhzKn5qpM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cQmaid1IxGgzE73yV5OjfJajAQiqv3MwXR4SqTQhcRA&oe=6A107868"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFUMX5HJJW0Q7kNvwE9nflV&_nc_oc=Adq5m7pZx9cqry8yLC2a6S2O0UdoY8uNi3TodfkeuNRtFBADJUMvUp5qqNabeYr8ZBw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xlz8DbXP4K5wHgc2Z44MKl-porAoJuCRXJltmnZxKpg&oe=6A107945"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
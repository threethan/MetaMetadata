sK90yWoeZxJhYCqwQMUMcq2HfqIT5hegx_pDOYrBw5UPfAm9EI0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzQzcQEmt-GLJBtDwaf_U-PoI-kkLNZZdAmjBtrRTMhA&oe=6A917927"}, {"file_name": "tv.liv.connect-20210507-142618.png", "id": "515585379800477", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974466_515585383133810_2777694229418411180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LQ6_ufNlKIQ7kNvwGwZfN7&_nc_oc=AdqM-HXcbENMgyfb1nADfQyHsv9Wr8j6x1pnIESC22uFOqYkzoR9UIV9zypHY9mOp54&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCt1lB0_VfnK-BGKNWVyV09iXTRHGOepiZG0efnvbfZg&oe=6A915ECA"}, {"file_name": "Untitled.png", "id": "1202514436883728", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982538_1202514440217061_3816184697553358757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDihqYa6MYsQ7kNvwEcUpew&_nc_oc=AdpVIpZH9BOK9sf_iqnq82qP7QDC5JwR8mLTRL60NNRM7JVgE7WV9-woYNihL7NJ2pc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6eBhPLjPL3OtLlFgfWNLlpTjZf3xoNFqpZY19WRU2cQ&oe=6A915DFD"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "323984772412662", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974769_323984775745995_6194198763418136405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WA3SNwfPfRsQ7kNvwFRCVzo&_nc_oc=AdofaxkIvjAeZo0zBeCfJMgW08rN_TgM1sQs1cRn5M7-vFMJO7Ah8jclxFbVGW_BITA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRnH0qu3tPtvXAspHOvgZ814eNwpeYfiG5JkfY__vhQw&oe=6A917328"}, {"file_name": "tv.liv.connect-20210507-142746.png", "id": "293611162370094", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974602_293611165703427_6496910531654440646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NzQKnDEZu0Q7kNvwHQAQF4&_nc_oc=Adrs07TA0762YE33IL4sPIsmMhbosFJEYEcanS_NaIQIcRVwRZDqzxP-ftFV1rS4LZ0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlk69s4LhTlOnvhviA1RPxOREdOOcFX-MTUF1vbJ6WXg&oe=6A917405"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Connect", "keywords": [], "long_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nRequirements\n\n\u25cf an iOS device (iPhone or iPad) with the LIV mobile app installed\n\u25cf a Wi-Fi connection (ideally 5 GHz)\n\u25cf 1 or more Oculus MRC supported games, listed here - https://creator.oculus.com/mrc/\n\nHow It Works\n\nThe app connects your headset to the LIV app on your mobile device. From there you can align your controllers, start a game and start watching.\n\nLIV Connect offers:\n\n\u25cf connecting to the LIV app on your mobile device via Wi-Fi\n\u25cf in-app camera frame to align controllers for optimal VR syncing\n\nGame on!", "short_description": "Never miss out on what's going on in VR! LIV Connect is the companion app to LIV's mobile app that lets you watch yourself and friends in Virtual Reality. Use LIV Connect to connect to your iPhone or iPad and start watching today!\n\nPlease note: an iOS device (iPhone or iPad) with the LIV mobile app and a Wi-Fi connection are required to use LIV Connect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liv.tv/terms/privacy", "developer_terms_of_service_url": "https://liv.tv/terms/eula", "publisher_name": "LIV Inc.", "support_website_url": "https://help.liv.tv/", "website_url": "http://www.liv.tv/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
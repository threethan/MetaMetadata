0f&oh=00_AQKcpcaswctUfoui6aQM1KpD5qM9c3sW-ij6UaLs3k153Q&oe=6AA4201B"}, {"file_name": "awdsafeawdasd.png", "id": "711549448629322", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823485_711549451962655_5707453477873687922_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kV28cTX5hd8Q7kNvwH1NfEw&_nc_oc=AdrTgo3NDBsi3YywPA2QZ1u-DoPc6EsZqIEPUODWA5RbF5I31Un-rvECdTdgCwonWyw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZV_SZY_u7B-NMHmq_cLRZahPRFUPfq6LMKwgYrWo02A&oe=6AA400AE"}, {"file_name": "asdwdasd.png", "id": "1552606112598074", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499300619_1552606115931407_1084622487002340301_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyR12NYtx-IQ7kNvwFTtCMZ&_nc_oc=Adr2MzVskaqaZIc2u6LFaRSoaA4ZOiWdP_DpEOcEglRL2KEfxKeKd6PpN4cY9w_iyNc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5_LGqsZi9Z4w-2XYkwJjwq7btDcGAy2lx1uvJFO5XWg&oe=6AA40711"}, {"file_name": "aswdsdfgwewdas.png", "id": "1375116797603361", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491822883_1375116800936694_7701780396418168709_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bp5sHZuNq8YQ7kNvwFSdAAy&_nc_oc=Adr-g2zDz9G6T2mCdNNdmAMnG9DGC2dgnOUpm4NM2DEL6VpoRcBcxK40w9JKe3dig4E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjSlM0n7Ur1imVTWEhyd1QAaealfosZVP30MZAct21cg&oe=6AA4010F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Level Zero", "keywords": [], "long_description": "You wake up in an endless maze of damp, yellow rooms, the Backrooms. The hum of fluorescent lights fills the air, and the faint smell of mold clings to the carpet. Every step echoes through the empty halls, but you\u2019re not alone. Something knows you\u2019re here.\n\nIn this terrifying exploration game, you must uncover the secrets buried within each level of the Backrooms while avoiding entities that stalk the shadows. Every sound could be a clue\u2026 or a warning. There are no checkpoints, no instructions \u2014 only instinct, fear, and the will to survive.\n\nCan you keep your sanity long enough to escape, or will you become one of the lost forever wandering these endless halls?", "short_description": "You\u2019ve no-clipped into the Backrooms, endless yellow halls, buzzing lights, and something following you. Explore, survive, and escape before the madness finds you first."}]}, "developer_name": "Async", "developer_privacy_policy_url": "https://sites.google.com/view/level-zero/home", "developer_terms_of_service_url": null, "publisher_name": "ahoy", "support_website_url": null, "website_url": "https://sites.google.com/view/level-zero/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25058677440392965"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307346_802035815770670_8545656882246716964_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGekBwgVYUAQ7kNvwEMayVD&_nc_oc=Adr3VZtnaRCADVKYu6y4dHnEpDVDEFpXhTiet72WIgHgzIhlfljwHLAGfU8O6Vt0P78&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGSqA4H-JsblL2WQSrSjBlKPiH2dEKkYTiFZ8Jkp7Jsg&oe=6AA3EFE6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Level Zero", "platform": "ANDROID_6DOF", "context_category": {"cont
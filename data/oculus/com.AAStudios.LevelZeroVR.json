711549451962655_5707453477873687922_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6EL8xVwdBsQ7kNvwFTh9ag&_nc_oc=Adr1_Lxwk7qCrIGL6S68Ry6-QrtGLajEvXStQzPVR6RHVrdofdA0mwRb7h2f5Q6oRoI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-sZUprrtHsXqz2n7vU3D3LQXTOKxiD5s-njmKce4tkg&oe=6A19932E"}, {"file_name": "asdwdasd.png", "id": "1552606112598074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300619_1552606115931407_1084622487002340301_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aElIVYCC5JgQ7kNvwGHTHZQ&_nc_oc=AdrYJ6g3PY3znC9730v7ftNVBt61OsIW64Q6hnepElW3lTERCbc4qkNz_i_o_Smpvr0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OixYNjXVTPPn5XyeAMnOk5z5gVdHeS5W_KttYm-1K8g&oe=6A199991"}, {"file_name": "aswdsdfgwewdas.png", "id": "1375116797603361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822883_1375116800936694_7701780396418168709_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ap33y45rngQ7kNvwGyNp_p&_nc_oc=Adr7J6NkomiQwLnCsuPpCDh6mpf_6oYOWgcOJg8HyhA136SphH7P9HPg89qNsE9RyCQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GwhEZpyJa3uY0CgM-nDCfn44DswqGjUUInGUg2mJ4sA&oe=6A19938F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Level Zero", "keywords": [], "long_description": "You wake up in an endless maze of damp, yellow rooms, the Backrooms. The hum of fluorescent lights fills the air, and the faint smell of mold clings to the carpet. Every step echoes through the empty halls, but you\u2019re not alone. Something knows you\u2019re here.\n\nIn this terrifying exploration game, you must uncover the secrets buried within each level of the Backrooms while avoiding entities that stalk the shadows. Every sound could be a clue\u2026 or a warning. There are no checkpoints, no instructions \u2014 only instinct, fear, and the will to survive.\n\nCan you keep your sanity long enough to escape, or will you become one of the lost forever wandering these endless halls?", "short_description": "You\u2019ve no-clipped into the Backrooms, endless yellow halls, buzzing lights, and something following you. Explore, survive, and escape before the madness finds you first."}]}, "developer_name": "Async", "developer_privacy_policy_url": "https://sites.google.com/view/level-zero/home", "developer_terms_of_service_url": null, "publisher_name": "ahoy", "support_website_url": null, "website_url": "https://sites.google.com/view/level-zero/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25058677440392965"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "811975551330809"}]}, "baseline_offer": {"id": "811975551330809"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761954900, "status": "PUBLISHED", "id": "811975551330809"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25271600919100615", "version": "0.25"}, "id": "1458062385327857", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24353922230868493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25271600919100615"}, "r
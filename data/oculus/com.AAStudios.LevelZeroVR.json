322", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823485_711549451962655_5707453477873687922_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vnQ5xaCSacQ7kNvwEj6em4&_nc_oc=Adqv64QzP8wEiEvivnuQ3xbwP7Rm9CI6iqNCsID0jUiGW8mIDBrtnUDnaTN8mjF6Ob0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B3tY9xemXoDCykaQMLeGKc4htUScJGtAOIJSfff5jCA&oe=6A46662E"}, {"file_name": "asdwdasd.png", "id": "1552606112598074", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499300619_1552606115931407_1084622487002340301_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNhO52zTbI0Q7kNvwFYy4pw&_nc_oc=AdogNg1aLais85TvjGOiDm8-lyaKyKNoX4nfSXQz3-SD4MDzh1eVq33TECn45Jl75-A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iNvFysNXGNNt99YkoNqqjK_KJspfEbMPox17DAumsSQ&oe=6A466C91"}, {"file_name": "aswdsdfgwewdas.png", "id": "1375116797603361", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491822883_1375116800936694_7701780396418168709_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPc2PorswH4Q7kNvwFRg75H&_nc_oc=AdrTwmPuv_U8OJ7P0qZTPRhFTc2a-dSZ4j6uQNlxHWCWJVJwKBSE1vhiTe7R9kaRS7k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UuHFKly3dGOMpPVUNE_AM9mztpPQtLTjaOnvYdwAi_g&oe=6A46668F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Level Zero", "keywords": [], "long_description": "You wake up in an endless maze of damp, yellow rooms, the Backrooms. The hum of fluorescent lights fills the air, and the faint smell of mold clings to the carpet. Every step echoes through the empty halls, but you\u2019re not alone. Something knows you\u2019re here.\n\nIn this terrifying exploration game, you must uncover the secrets buried within each level of the Backrooms while avoiding entities that stalk the shadows. Every sound could be a clue\u2026 or a warning. There are no checkpoints, no instructions \u2014 only instinct, fear, and the will to survive.\n\nCan you keep your sanity long enough to escape, or will you become one of the lost forever wandering these endless halls?", "short_description": "You\u2019ve no-clipped into the Backrooms, endless yellow halls, buzzing lights, and something following you. Explore, survive, and escape before the madness finds you first."}]}, "developer_name": "Async", "developer_privacy_policy_url": "https://sites.google.com/view/level-zero/home", "developer_terms_of_service_url": null, "publisher_name": "ahoy", "support_website_url": null, "website_url": "https://sites.google.com/view/level-zero/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25058677440392965"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307346_802035815770670_8545656882246716964_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE16FyWFpsIQ7kNvwGzHFv5&_nc_oc=Adr1vEPDTq1iBAAei3fsT4aeeGPC9VxKHAXaviAuny0lX08eBi_BH0JtBGKiTavEKh0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_acmnPmtT-8tjmtJu5RW0CMb8n8psKU_Nz7x0bChiswQ&oe=6A468DA6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Level Zero", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, 
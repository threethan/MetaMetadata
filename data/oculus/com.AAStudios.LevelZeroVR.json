pe, or will you become one of the lost forever wandering these endless halls?", "short_description": "You\u2019ve no-clipped into the Backrooms, endless yellow halls, buzzing lights, and something following you. Explore, survive, and escape before the madness finds you first."}]}, "developer_name": "Async", "developer_privacy_policy_url": "https://sites.google.com/view/level-zero/home", "developer_terms_of_service_url": null, "publisher_name": "ahoy", "support_website_url": null, "website_url": "https://sites.google.com/view/level-zero/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25058677440392965"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307346_802035815770670_8545656882246716964_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cn-uaqeig4Q7kNvwFrVjIi&_nc_oc=AdoNSmQYOSOLWedaF0fT9mUevAaMM2b4cd3SK7iqoqRi8TGkZDxf_1IyErL7aPo76RQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rtwtcmZXmZa7tlPHUSVLaiNsZFGEzyPMQ7PsFIWMLqQ&oe=6A2ADE26"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Level Zero", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name":
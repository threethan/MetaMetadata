less halls?", "short_description": "You\u2019ve no-clipped into the Backrooms, endless yellow halls, buzzing lights, and something following you. Explore, survive, and escape before the madness finds you first."}]}, "developer_name": "Async", "developer_privacy_policy_url": "https://sites.google.com/view/level-zero/home", "developer_terms_of_service_url": null, "publisher_name": "ahoy", "support_website_url": null, "website_url": "https://sites.google.com/view/level-zero/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25058677440392965"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "811975551330809"}]}, "baseline_offer": {"id": "811975551330809"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761954900, "status": "PUBLISHED", "id": "811975551330809"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25271600919100615", "version": "0.25"}, "id": "1458062385327857", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24353922230868493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25271600919100615"}, "r
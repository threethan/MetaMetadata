. Something knows you\u2019re here.\n\nIn this terrifying exploration game, you must uncover the secrets buried within each level of the Backrooms while avoiding entities that stalk the shadows. Every sound could be a clue\u2026 or a warning. There are no checkpoints, no instructions \u2014 only instinct, fear, and the will to survive.\n\nCan you keep your sanity long enough to escape, or will you become one of the lost forever wandering these endless halls?", "short_description": "You\u2019ve no-clipped into the Backrooms, endless yellow halls, buzzing lights, and something following you. Explore, survive, and escape before the madness finds you first."}]}, "developer_name": "Async", "developer_privacy_policy_url": "https://sites.google.com/view/level-zero/home", "developer_terms_of_service_url": null, "publisher_name": "ahoy", "support_website_url": null, "website_url": "https://sites.google.com/view/level-zero/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25058677440392965"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307346_802035815770670_8545656882246716964_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Q--dNy-z98Q7kNvwFbpEQv&_nc_oc=AdrPtVP7cWsfoT_Ql0XDo7NTZnFqRSLRKB9wciQ5vLBUMnWiIL7ds7qG_ldY4DCaT3U&_nc_zt=3&
//scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819836_1060657929536053_1861789893269318720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZ-bS97atYEQ7kNvwHQnAKl&_nc_oc=AdkouNMq5g7xaa8KSDR_JsjNoHqaALEY8E4DGzt_rZAZCY8C1hKTc3x0bfDFKoiQsp4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvSUnL-cDDyychpxRkIT-An2jEc8UGp_NDBz4eALvIHnw&oe=69A839DF"}, {"file_name": "Explore03.png", "id": "1088189995999219", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819318_1088189999332552_2705374337554241163_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQveaXcyh4YQ7kNvwE_Ho45&_nc_oc=Adng9FYEkilGYJd3a7nmrhFxRz84Oahy_WbdUQ_GG1IBkm-sPtbmqEkMn5U7y0HbyVQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft5S0Oit4j3km5lQVbbXGAkVA3FannN8CAjohx2SNmNHQ&oe=69A80F32"}, {"file_name": "Explore04.png", "id": "1237749927524516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820428_1237749930857849_689998706157096122_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1TPiROADiUQ7kNvwG_m8bS&_nc_oc=AdmGh8EhnLpz0ewiFjWlJtLN1vCTZmcMdDExhHbQE8y21o7CzGu8aNPP9RltS61uvOI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsZFfdQAU8pI6Stk4PQewrLYY531NEIvgL9-QClO3ehzQ&oe=69A80E6A"}, {"file_name": "Explore05.png", "id": "583328374620299", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819822_583328377953632_3065853124648214777_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Figf0yViGhsQ7kNvwG2qprr&_nc_oc=Adk8hvsFB8yXlhF53w3B_eN4LOOdKe-lK8WlfCeaAK28_EFQKPnTUUeltAyN9iPRiPM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfskvanhBsvraOCS62xz6Ov3lCbOBZPuPrzxH5TuovCfWg&oe=69A839FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ECHO Explore", "keywords": ["simulation", "training", "educational", "learning", "collaboration"], "long_description": "ECHO Explore\nConnect. Discover. Experience.\n\nImmerse yourself in captivating virtual experiences with ECHO Explore! Whether you want to join an expert-led session or explore on your own, ECHO Explore makes it effortless.\n\nThis app allows you to seamlessly join an ECHO Guide session by entering a session ID provided to you, or use a Local session to experience interactive content at your own pace. Whether you're venturing into new virtual worlds, participating in educational sessions, collaborating remotely, or exploring independently, ECHO Explore has you covered.\n\nKey Features:\nSimple Connectivity: Join ECHO Guide sessions instantly with a provided session ID.\n\nLocal Sessions: Dive into available experiences on your own, without requiring an ECHO Guide.\n\nGuided Experiences: Engage with expert-led sessions for a rich, interactive journey.\n\nVersatile Applications: Perfect for education, personal exploration, remote collaboration, or entertainment.\n\nNote:\nSome experiences may require access to an ECHO Guide session for their full functionality, while others are available as Local session. For more information, visit https://echoplatform.app.", "short_description": "ECHO Explore is part of the ECHO platform. It can be used on its own with Local sessions or in combination with ECHO Guide for guided sessions and access to a variety of VR scenes. ECHO Explore allows users to train and learn in different types of scenarios, whether independently or as part of an expert-led experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.echoplatform.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Playmax B.V.", "support_website_url": null, "website_url": "https://echoplatform.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connec
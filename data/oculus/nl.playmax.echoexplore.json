//scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819836_1060657929536053_1861789893269318720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWU7TfO6Pz0Q7kNvwHc6eBb&_nc_oc=AdnqFe6h88S74bQ72979T3VDzrTpBEXda836FHDbbbk0HqjzW38arT7AQ-a-DWSciGY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUZgLpUZ7_XgVNh8APJhoeJGQ23puGIy4zHqggYkp4Gg&oe=69BD51DF"}, {"file_name": "Explore03.png", "id": "1088189995999219", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819318_1088189999332552_2705374337554241163_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wbdGyz2WWsQ7kNvwFX3sMU&_nc_oc=Adm8lL1v958I_4xamka39huQywaF4fC4osISDoXzwUAwglYfKqq5hf8Fxv7yK-LKI_4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzK9f7fA0oQLetunCjtFsY0TSGqpwg7s5JK07EEz-43Hw&oe=69BD5F72"}, {"file_name": "Explore04.png", "id": "1237749927524516", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820428_1237749930857849_689998706157096122_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyOEpbfz-4oQ7kNvwE0D5CR&_nc_oc=AdkDuyM7YLxE0ZTCY2nmSV6FhL1KlXw1a4H2zSU0Jf8wnWa1FAn7SsNQ8Y29ldGMMbQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMzyn9a1TK4arth8ynUG2ykU41m4_xKFVE3yG7akfsKA&oe=69BD5EAA"}, {"file_name": "Explore05.png", "id": "583328374620299", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819822_583328377953632_3065853124648214777_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3x1V--hy18Q7kNvwFdUEyY&_nc_oc=Adk0pikIewcDLW_VNkC31cKIsdXeQsScFNkfvsgbX6vh-S6wu-nt_lAD_lnvrsIVgEU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxlJuZp3Q0vnl-V7ADM0lUaOEQeN2xflXs9KqBpeAvTXQ&oe=69BD51FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ECHO Explore", "keywords": ["simulation", "training", "educational", "learning", "collaboration"], "long_description": "ECHO Explore\nConnect. Discover. Experience.\n\nImmerse yourself in captivating virtual experiences with ECHO Explore! Whether you want to join an expert-led session or explore on your own, ECHO Explore makes it effortless.\n\nThis app allows you to seamlessly join an ECHO Guide session by entering a session ID provided to you, or use a Local session to experience interactive content at your own pace. Whether you're venturing into new virtual worlds, participating in educational sessions, collaborating remotely, or exploring independently, ECHO Explore has you covered.\n\nKey Features:\nSimple Connectivity: Join ECHO Guide sessions instantly with a provided session ID.\n\nLocal Sessions: Dive into available experiences on your own, without requiring an ECHO Guide.\n\nGuided Experiences: Engage with expert-led sessions for a rich, interactive journey.\n\nVersatile Applications: Perfect for education, personal exploration, remote collaboration, or entertainment.\n\nNote:\nSome experiences may require access to an ECHO Guide session for their full functionality, while others are available as Local session. For more information, visit https://echoplatform.app.", "short_description": "ECHO Explore is part of the ECHO platform. It can be used on its own with Local sessions or in combination with ECHO Guide for guided sessions and access to a variety of VR scenes. ECHO Explore allows users to train and learn in different types of scenarios, whether independently or as part of an expert-led experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.echoplatform.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Playmax B.V.", "support_website_url": null, "website_url": "https://echoplatform.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connec
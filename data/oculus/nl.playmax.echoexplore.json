060657922869387", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819836_1060657929536053_1861789893269318720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq20hJ26XloQ7kNvwGL2-sO&_nc_oc=AdqojM7sQIky6-w7M3PKDrHgaFk01Vakmqpp5qr7H8YoxXy_qxb0veo8YJk35yh4ejA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw35LY1pPtAVbppyFVu2FIQVQdeaCTivHSN6cnIDS43IA&oe=69CA80DF"}, {"file_name": "Explore03.png", "id": "1088189995999219", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819318_1088189999332552_2705374337554241163_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdODa-R7AvoQ7kNvwEgViCv&_nc_oc=AdpLgsRfk2mwmXF9HJsat34H3XVtVg3xQ7iv7bwcWMse_Xv0vFIxINoxxkFE7Xie0yA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxk8CIoGPlVOGfEkm7dfluKMvm0j3OVIAfwatPJI0Koiw&oe=69CA5632"}, {"file_name": "Explore04.png", "id": "1237749927524516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820428_1237749930857849_689998706157096122_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTOW-AaEOvgQ7kNvwE2Xyud&_nc_oc=Adow6RuBDmEVZu3_e0oP8QFXVeVnmMdfTy5zCG2Y74BRh-a2OkuUnq5pSItSdcVgVMk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysAkM_muM_UQob6Fv0HxPTv3-H7NGh3M2AYzayGhqNyA&oe=69CA8DAA"}, {"file_name": "Explore05.png", "id": "583328374620299", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819822_583328377953632_3065853124648214777_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVXw4P753LQQ7kNvwGj4u6u&_nc_oc=AdojHC8NRRtiyTB_K_KA6-bMu5Uv_7mhHnS82bYsfQzW1NA9l9KM4--1HjE8LfV4QC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYbSdWvfM8oiHTqBIZH2Bn2cmZaw2sDcA1gXb4RcNZkg&oe=69CA80FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ECHO Explore", "keywords": ["simulation", "training", "educational", "learning", "collaboration"], "long_description": "ECHO Explore\nConnect. Discover. Experience.\n\nImmerse yourself in captivating virtual experiences with ECHO Explore! Whether you want to join an expert-led session or explore on your own, ECHO Explore makes it effortless.\n\nThis app allows you to seamlessly join an ECHO Guide session by entering a session ID provided to you, or use a Local session to experience interactive content at your own pace. Whether you're venturing into new virtual worlds, participating in educational sessions, collaborating remotely, or exploring independently, ECHO Explore has you covered.\n\nKey Features:\nSimple Connectivity: Join ECHO Guide sessions instantly with a provided session ID.\n\nLocal Sessions: Dive into available experiences on your own, without requiring an ECHO Guide.\n\nGuided Experiences: Engage with expert-led sessions for a rich, interactive journey.\n\nVersatile Applications: Perfect for education, personal exploration, remote collaboration, or entertainment.\n\nNote:\nSome experiences may require access to an ECHO Guide session for their full functionality, while others are available as Local session. For more information, visit https://echoplatform.app.", "short_description": "ECHO Explore is part of the ECHO platform. It can be used on its own with Local sessions or in combination with ECHO Guide for guided sessions and access to a variety of VR scenes. ECHO Explore allows users to train and learn in different types of scenarios, whether independently or as part of an expert-led experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.echoplatform.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Playmax B.V.", "support_website_url": null, "website_url": "https://echoplatform.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genre
3wXGGMOLmDSIICqzaXTJMcsc6X6Mow&oe=6B0F1E2E"}, {"file_name": "9.png", "id": "6962857493797655", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035354_6962857507130987_88377115678039102_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Honl3ZxA2qMQ7kNvwHYL9df&_nc_oc=AdoQB7D1Mvt5yp48OiMmdgANJFE5IU7Qb_sDffgzcvhI-yCdX7WamtSPnnd0QoDwo6g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXRp4boB3BTAHxAtz2SyUDCjGwehLxnM_kHkPwKFG44Ww&oe=6B0EEC05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OMA War Free", "keywords": [], "long_description": "\ud83c\udfae Welcome to OMA WAR! \ud83c\udfae Exciting VR Adventures Await!\nEpic Battles: Engage in heart-pounding battles against formidable foes as you navigate through visually stunning environments.\n\nGet ready to experience the thrill of your virtual life in OMA War.\n\n \ud83c\udfae Kill it your way: 1st-person combat with a variety of weapons and minions who can serve as both allies and enemies\n\n\ud83c\udfaeImmersive Storyline: Dive into a captivating storyline that will keep you on the edge of your seat, unveiling secrets and mysteries as you progress.\n\n\ud83c\udfaeCutting-Edge VR Technology: Experience gaming like never before with state-of-the-art virtual reality technology, putting you right in the center of the action.\n\nAnd follow us on: \n- Facebook: https://www.facebook.com/OMAwarVR\n- X: https://twitter.com/oma_war_vr\n- YouTube: https://www.youtube.com/@OMAWARVRGaming\n- TikTok: https://www.tiktok.com/@oma_war_vr ", "short_description": "\ud83c\udfae Welcome to \"OMA War\" an intensive virtual reality action game that will test your reflexes and strategic thinking to the limit. \n\nStep into the immersive world of \"OMA War\" a ground breaking virtual reality game that promises to redefine the gaming experience. Join us on this thrilling adventure filled with intense battles, stunning landscapes, and challenges that will test your skills to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://venus-games.com/privacy-policy", "developer_terms_of_service_url": "https://venus-games.com/terms-of-use", "publisher_name": "Venus-Games", "support_website_url": null, "website_url": "https://venus-games.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6892512297532134"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6975799992536697", "version": "0.3"}, "id": "328253986713625", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6892512294198801", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6975799992536697"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "328253986713625"}]}, "change_log": null, "created_date": 1705642464, "id": "6975799992536697", "version": "0.3", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count
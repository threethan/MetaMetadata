{"data": {"node": {"__typename": "Application", "id": "1310337855502055", "organization": {"id": "1310302458838928", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1310337855502055"}]}, "id": "28373718468923560"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1310337855502055", "release_date": 1791449880, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 2}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1365136486688858"}, "id": "3613079635527364"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1365136486688858"}, "release_status": "RELEASED"}, "id": "1365304646672042", "version": "2.2", "version_code": 386, "release_status": "SCHEDULED", "status": "APPROVED"}, "live_binary": null, "created_date": 1793479923, "id": "1365305496671957", "is_initial_release": false, "name_with_fallback": "v17", "pdp_metadata_with_fallback": {"version": 2, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1336605446208629"}, "release_status": "RELEASED", "id": "1310337855502055"}, "id": "1336605446208629", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "SCHEDULED", "release_type": "SCHEDULED", "pdp_metadata": null, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499299891_1115473434212229_3616753694242184658_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZH7AKqc_HsQ7kNvwHW-7BL&_nc_oc=Adpq55aPcIBgzapf_cQTN29sx1R05a0CJ1dqwYL00G8oXD-GpisSVjhhNaDDI_11lMw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBZFOwZZY9w8BwDsNhgCB3ZzWIQqDpaVwomfKKeNK4Gw&oe=6AECBB2C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MuralView2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1791449880, "lastRevision": {"nodes": [{"id": "1310337872168720", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1310337855502055", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1832907564788484"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Untitled_Artwork 34.png", "id": "28603666192576009", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/773875811_28603666202576008_8097055829588232784_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJ27fC3S6_wQ7kNvwGFo1BD&_nc_oc=AdpvzOtXQkB4T7155nqpbglKS6FKxtXiBlyISVF47DJIBgi2Spy8cXAu1w97wSzqTrg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHHQCqcohZ4Q62MPbmpulLmhKO1ESVfIn9TIDwIyek_A&oe=6AECA01B"}, {"file_name": "Untitled_Artwork 30.png", "id": "2931986143836465", "image_type": "APP_IMG_ICON_BACKGROUND_512", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/654936547_2931986147169798_4648367752915551037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3imT6q54XvkQ7kNvwFnYJki&_nc_oc=AdpeWHWyG3gqXZgn7IfmhO2BTwB-1P0I1CvWH5xJEX8AAMzU_jiDg7FlyqHyQP15Kmc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRq7uCohoGxyz0vuQQhJBIb0_U8aKaXMgSaqyP5i44kDw&oe=6AEC990D"}, {"file_name": "MuralView2_Hero_3000x900.png", "id": "2012791919427114", "image_type": "APP_IMG_HERO", "uri": "ht
=6e7a0a&_nc_ohc=BGPkn6PdCD0Q7kNvwESBHL9&_nc_oc=Adp_x4AHVZw1rgwrO8YXOc-E5Q4EO4ws2q98zVI4zTHqD3C7U50AWXLfSAepv_Q4FTA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMU3ctgHhjjwmS9m-DTyMBvuFQhIS2jULmgoSmusbWTog&oe=6AE5EF19"}, {"file_name": "MuralView2_1752_2560x1440.png", "id": "4526260330926102", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499293669_4526260334259435_2462045530780696567_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciOAbk5pbvwQ7kNvwFN19bJ&_nc_oc=AdoJJQaLdBwPkTr7oZSsf0h_DgdZejy9gHUnrWGFvQZRdC7YvLyAGsDt0N5QsyCXnQ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmaNnITc988H2edNynVTZkX5TqG3CL4_YwHrrJE2CsyA&oe=6AE5EDC7"}, {"file_name": "MuralView2_1754_2560x1440.png", "id": "1527493099142502", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/654944867_1527493102475835_3524320972275221483_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQErR8ArSWgQ7kNvwE0He-o&_nc_oc=Adr93n3eaUicWl0gJL1GBw6xO4_1pwSie3i5l9-5X3z-0ZruODWc6O5ApOQOotxQpjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMptAhS4bmq8uaSmhRbhmoqLUfUvxX7YL-wn_e6S0sV8A&oe=6AE5E59C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled_Artwork 31.png", "id": "1069304452583563", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499301236_1069304455916896_3219338360736593823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6esI2GpnclMQ7kNvwG9xh4X&_nc_oc=Adp2cCuLBEljR3SCL6FHcsnq8OykNgtM2i1kwYJWVnjWi7uVZ__u9ZT6rNXtDxQ0LTE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvXilPHNkcuj9GcaWafkKuQ7ORfR_voh6Lvu8Z7kpKQA&oe=6AE5FF27"}, "display_name": "MuralView2", "keywords": [], "long_description": "MuralView2 is a mixed reality visualization tool built for mural artists, designers, and clients. Import your artwork and place it directly onto real-world walls through Meta Quest, giving you a true sense of scale, placement, and composition before the first drop of paint hits the wall.\n\nMove, scale, rotate, mirror, and adjust your artwork while standing in the actual space. Fine-tune opacity and positioning to visualize how a mural will interact with architectural features and the surrounding environment.\n\nShared Vision takes mural planning further by allowing multiple Meta Quest headsets to view the same mural placement together in the same physical space. Artists, assistants, and clients can walk around the project and experience the proposed mural from different viewpoints at the same time.\n\nWhether you\u2019re planning a large commercial mural, presenting a concept to a client, or working out placement before painting, MuralView2 helps bridge the gap between a digital design and the finished wall.\n\nPlan it. Place it. See it before you paint it.", "short_description": "Use this for the Short Description:\n\nVisualize your mural before you paint it. MuralView2 lets artists import artwork and place it directly on real-world walls in mixed reality. Scale, position, rotate, adjust opacity, and preview designs at true scale using Meta Quest. Shared Vision lets multiple headsets view the same mural placement together, making it easier to plan, present, and collaborate with clients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://middlevitalemurals.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Middle Vitale Murals LLC", "support_website_url": null, "website_url": "https://middlevitalemurals.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "1318696471332860"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1442219297287273"}, {"status": "PUBLISHED", "id": "2632137783883640"}]}, "baseline_offer": {"id": "1442219297287273"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792685160, "status": "PUBLISHED", "id": "1442219297287273"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1350756428126864", "version": "2.2"}, "id": "3613079635527364", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1350756428126864"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "This update makes vector (SVG) artwork work the way sign painters actually use it: detailed and traced designs that used to stall in the library now open on the wall, every design\u2019s colors match its thumbnail exactly, and in LAYERS each color is its own layer with a solid color block so you can switch colors on and off one at a time while you paint. It also tidies the interface \u2014 the big DELETE button and every yellow accent across the app now use the same mango color as the controller beam, keeping the buttons\u2019 dark fade \u2014 and when you summon the control panel with both buttons, it now arrives centered at eye height, so you\u2019re looking at the middle of the panel instead of its top edge.", "created_date": 1793022699, "id": "1350756428126864", "version": "2.2", "version_code": 294, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1350756428126864"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "This update makes vector (SVG) artwork work the way sign painters actually use it: detailed and traced designs that used to stall in the library now open on the wall, every design\u2019s colors match its thumbnail exactly, and in LAYERS each color is its own layer with a solid color block so you can switch colors on and off one at a time while you paint. It also tidies the interface \u2014 the big DELETE button and every yellow accent across the app now use the same mango color as the controller beam, keeping the buttons\u2019 dark fade \u2014 and when you summon the control panel with both buttons, it now arrives centered at eye height, so you\u2019re looking at the middle of the panel instead of its top edge.", "created_date": 1793014005, "id": "1350515548150952", "version": "2.2", "version_code": 291, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1350756428126864"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793013226, "id": "1350496918152815", "version": "2.2", "version_code": 290, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1350756428126864"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "WHAT\u2019S NEW\r\n\r\nPLACEMENT Lock puts the print on a wall pin, not on the headset. Take the headset off, look somewhere else, and put it back on \u2014 the picture stays on the wall, not in front of your face. LOCK PLACEMENT works again after unlock. Previous and overnight return use that same pin.\r\n\r\nSTART After the splash, the welcome card sits in the room about 4 feet in front of you and stays there when you turn your head. START puts the control panel in that same spot, not two feet from your face.\r\n\r\nSHARED VISION Leave a session and the picture comes off the wall into Shared Vision. Tap it and make a VECTOR copy if it is an SVG. Host and join during the session are unchanged.\r\n\r\nTRANSFORM Open TRANSFORM or DISTORT and the window starts with ATTENTION: only JPEG and PNG can be transformed for now, not SVG.\r\n\r\nLAYERS LAYERS in LIBRARY uses the same window and the same actions as LAYERS in TRANSFORM \u2014 swipe, lock, duplicate, delete, move, and scroll.\r\n\r\nControllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1792888009, "id": "1347978731737967", "version": "2.2", "version_code": 258, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1350756428126864"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "SVG files now work like the other pictures, except fold, curve, and warp \u2014 that is the next build. Website uploads can be JPEG, PNG, or SVG, each tile shows a type badge, and tapping an SVG opens it as a vector with full color, the same shape as the file, and layers you can scroll. Place it on the wall the same way as a photo: grab it, size it, fade it, lock or unlock placement, and Previous brings it back on that wall at the size and fade you left. After you lock it you can host Shared Vision; the other Quest joins and receives the SVG at the same pose, size, and fade, and hosted or joined SVGs sit on the Shared Vision shelf. The whole drawing fades together now, so dark overlapping parts no longer linger while other plates go first. If the control panel is between you and the print, the titles and window words stay in front; if the print is between you and the panel, the print covers the panel.", "created_date": 1792871300, "id": "1347700445099129", "version": "2.2", "version_code": 235, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
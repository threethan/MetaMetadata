d=6e7a0a&_nc_ohc=OiTVNOQbG7MQ7kNvwETGvwY&_nc_oc=AdqihuthirRHm3CDTykMGBJ4jeGOmXVXQXawm54jq6-7-Ign915dudqnCTn_dXWDID4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA08EF5KfjdWzrIKbktwSRsKCFWMNMt9ecR7BexigrhQ&oe=6AF0B359"}, {"file_name": "MuralView2_1752_2560x1440.png", "id": "4526260330926102", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499293669_4526260334259435_2462045530780696567_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF_TLZynKAQQ7kNvwGMWxY8&_nc_oc=Adp40O8dDb37I1agj47X-pX48s7ad02JORc3tPKvZpT6y3O1vqxuzWMUVemhCZRax7E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFpdqai9VZ89OTWnuK2tLH9EPWb8uo5otnkSL60ZW8sQ&oe=6AF0B207"}, {"file_name": "MuralView2_1754_2560x1440.png", "id": "1527493099142502", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654944867_1527493102475835_3524320972275221483_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=de16-WdAH7cQ7kNvwEKObMZ&_nc_oc=AdqwNzIFefwZ3YMwZy1hxPcqbGf1eDYjTXY8FIGbJma7_OXga9vtjboxlxtFQzXiPAs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_By12MF8VKD5j88Rz84oRjd2aS6TWG68xmF5C7iGvmw&oe=6AF0A9DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled_Artwork 31.png", "id": "1069304452583563", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499301236_1069304455916896_3219338360736593823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICrxFJR2Q_gQ7kNvwFBT5o9&_nc_oc=AdpKlFGEOxdxERr0slUyN8Yzd0JXbyVwNXSFxeJxq5VWWeRx00FSobkVrMMpKoEBUFk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsbO2y5PQQqpwXQAm9WdCP0YJ0pxkgaBYABMl3M054ug&oe=6AF08B27"}, "display_name": "MuralView2", "keywords": [], "long_description": "MuralView2 is a mixed reality visualization tool built for mural artists, designers, and clients. Import your artwork and place it directly onto real-world walls through Meta Quest, giving you a true sense of scale, placement, and composition before the first drop of paint hits the wall.\n\nMove, scale, rotate, mirror, and adjust your artwork while standing in the actual space. Fine-tune opacity and positioning to visualize how a mural will interact with architectural features and the surrounding environment.\n\nShared Vision takes mural planning further by allowing multiple Meta Quest headsets to view the same mural placement together in the same physical space. Artists, assistants, and clients can walk around the project and experience the proposed mural from different viewpoints at the same time.\n\nWhether you\u2019re planning a large commercial mural, presenting a concept to a client, or working out placement before painting, MuralView2 helps bridge the gap between a digital design and the finished wall.\n\nPlan it. Place it. See it before you paint it.", "short_description": "Use this for the Short Description:\n\nVisualize your mural before you paint it. MuralView2 lets artists import artwork and place it directly on real-world walls in mixed reality. Scale, position, rotate, adjust opacity, and preview designs at true scale using Meta Quest. Shared Vision lets multiple headsets view the same mural placement together, making it easier to plan, present, and collaborate with clients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://middlevitalemurals.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Middle Vitale Murals LLC", "support_website_url": null, "website_url": "https://middlevitalemurals.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "1318696471332860"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1442219297287273"}, {"status": "PUBLISHED", "id": "2632137783883640"}]}, "baseline_offer": {"id": "1442219297287273"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792685160, "status": "PUBLISHED", "id": "1442219297287273"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1372689165933590", "version": "2.2"}, "id": "3613079635527364", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1372689165933590"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "MuralView2 2.2 \u2014 headset 389\r\n\r\nWHAT'S NEW\r\n\r\nPICTURE FIRST\r\nPLACE, TRANSFORM, and DRAW stay grayed out until you have a picture up. Tap one before that and LIBRARY opens so you can pick one. Once a picture is up they stay lit, even while you go back to the library for another.\r\n\r\nTRANSFORM ON ONE SCREEN\r\nEvery TRANSFORM tool is now on one screen: FREEFORM, UNIFORM, DISTORT, WARP, DOME, FOLD, CURVE, CORNER, LAYERS, and ADJUST. No more digging through folders. FOLD, CURVE, and CORNER open their line options, and BACK brings you straight back to the tools. SETTINGS is now called ADJUST (flat, flip, and turn).\r\n\r\nFIND YOUR PICTURE FAST\r\nScrolled through the library and lost the picture you're working on? Grab it on the wall and the library jumps back to it, so you can close it out right away.\r\n\r\nABOUT\r\nA new ABOUT button under the uploads window tells you who made MuralView2, with links to my website and my other Apple apps.\r\n\r\nControllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1793703153, "id": "1372689165933590", "version": "2.2", "version_code": 389, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1372689165933590"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "MuralView2 2.2 \u2014 headset 388\r\n\r\nWHAT'S NEW\r\n\r\nNEW COLORS EVERY TIME\r\nThe control panel picks a fresh color scheme each time you start MuralView2: a tinted glass, a bold highlight in a color of its own, and matching letters. Every start looks plainly different from the last, and every scheme is checked so the words and buttons always read clearly. The controller beam matches the scheme too.\r\n\r\nA LIGHT THAT SHOWS IT'S WORKING\r\nWhen you open a picture, a light runs around its tile until the picture is up. Buttons that take a moment, like Host, Join and Leave Session, light up the same way, so you always know your press was heard.\r\n\r\nHEADSET LINKING\r\nFixed \"headset linked to another account\" when pairing a new headset. Each headset now gets its own link to your library.\r\n\r\nControllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1793677852, "id": "1371691576033349", "version": "2.2", "version_code": 388, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1372689165933590"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "MuralView2 2.2 \u2014 headset 387\r\n\r\nWHAT\u2019S NEW\r\n\r\nNEW COLORS EVERY TIME\r\nThe control panel picks a fresh color scheme each time you start MuralView2: a tinted glass, a bold highlight, and matching letters. Every scheme is checked before it is used, so the words and buttons always read clearly. No two starts in a row look the same.\r\n\r\nHEADSET LINKING\r\nFixed \u201cheadset linked to another account\u201d when pairing a new headset. Each headset now gets its own link to your library.\r\n\r\nThis build replaces the Halloween panel colors with the new color schemes.\r\n\r\nControllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1793575552, "id": "1368994736303033", "version": "2.2", "version_code": 387, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1372689165933590"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes":
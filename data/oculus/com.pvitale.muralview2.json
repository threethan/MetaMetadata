=6e7a0a&_nc_ohc=xy9husH0HF8Q7kNvwE-Wst5&_nc_oc=Adq5vUxG0ima-NFUDmAMtCCcb-DrFK1sI4bq5Nauc-D0IFt3WlRSdhD_jO4GzkuPbKA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNi61nF61531mYBvEsT1fCAE27sOttBRKLWD8iPOMxWA&oe=6AE1FA99"}, {"file_name": "MuralView2_1752_2560x1440.png", "id": "4526260330926102", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499293669_4526260334259435_2462045530780696567_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Do9lG0DsxoQ7kNvwHj0dkD&_nc_oc=AdqWCkWOSW3uMQfyIY30O34LzpPdp7WmzCdTrjN7Iil63M50Cea7NMb3y24ipWbTrH0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv48ixpvP7xuiztitE0NtmxdmZbixxWTUwhr51HYQWBQ&oe=6AE1F947"}, {"file_name": "MuralView2_1754_2560x1440.png", "id": "1527493099142502", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654944867_1527493102475835_3524320972275221483_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTVcb-tiAswQ7kNvwEWYJoG&_nc_oc=AdpdABD27PDflXGqnhR4Cm5IwJtu3Dv18PU1KN6DFfyiYn-konPP-tuqr5j0qGoDHs8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIZpHM6YeF0gIsmdzdzp4Ef2QAb12bBAMBbQd6OjYREQ&oe=6AE1F11C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled_Artwork 31.png", "id": "1069304452583563", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499301236_1069304455916896_3219338360736593823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AWi7kWm8oMQ7kNvwEdPKeW&_nc_oc=AdoqBBLmlokjlohhrtkzWvSVF494zz72n21p92jfPXpj3_8chYm95UhBcI7MjzhU3NU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPj9PuYFU-vT6HFrgSSWWF3a9E4rJv0yV6Eym5SUKbAAw&oe=6AE20AA7"}, "display_name": "MuralView2", "keywords": [], "long_description": "MuralView2 is a mixed reality visualization tool built for mural artists, designers, and clients. Import your artwork and place it directly onto real-world walls through Meta Quest, giving you a true sense of scale, placement, and composition before the first drop of paint hits the wall.\n\nMove, scale, rotate, mirror, and adjust your artwork while standing in the actual space. Fine-tune opacity and positioning to visualize how a mural will interact with architectural features and the surrounding environment.\n\nShared Vision takes mural planning further by allowing multiple Meta Quest headsets to view the same mural placement together in the same physical space. Artists, assistants, and clients can walk around the project and experience the proposed mural from different viewpoints at the same time.\n\nWhether you\u2019re planning a large commercial mural, presenting a concept to a client, or working out placement before painting, MuralView2 helps bridge the gap between a digital design and the finished wall.\n\nPlan it. Place it. See it before you paint it.", "short_description": "Use this for the Short Description:\n\nVisualize your mural before you paint it. MuralView2 lets artists import artwork and place it directly on real-world walls in mixed reality. Scale, position, rotate, adjust opacity, and preview designs at true scale using Meta Quest. Shared Vision lets multiple headsets view the same mural placement together, making it easier to plan, present, and collaborate with clients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://middlevitalemurals.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Middle Vitale Murals LLC", "support_website_url": null, "website_url": "https://middlevitalemurals.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "1318696471332860"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1442219297287273"}, {"status": "PUBLISHED", "id": "2632137783883640"}]}, "baseline_offer": {"id": "1442219297287273"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792685160, "status": "PUBLISHED", "id": "1442219297287273"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1346028015266372", "version": "2.2"}, "id": "3613079635527364", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1346028015266372"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "What\u2019s new\r\n\r\nMuralView2 / Shared Vision now opens with a short how-to, then the board. Double-tap LIBRARY to open or close the control panel. Press A and B together, or X and Y, to bring the board about four feet in front of you if you left it on the floor. Pick a picture from headset photos or muralview2.com. Library tiles match the website window. A picture in use goes faint \u2014 tap it to take it down. The little X only deletes it from the library. A locked picture asks New placement or Previous placement. Previous puts it back on that wall, same size, shape, and fade. PLACE still shoots the print onto the real wall, floor, or ceiling. DRAW moves, enlarges, flips, and spins. Push the stick to slide; click the stick down to go five times as fast. Hold the trigger and push up or down to fade, or left or right to spin. TRANSFORM folds, curves, and warps, with grabable handles and a frame that stays on the paper. Undo All lays the flaps back, leaves your fold lines, and does not keep leftover lag for the next fold. Shared Vision lets another Quest in the same room see the print where you locked it \u2014 host after you lock placement; they tap JOIN SESSION on the same Wi-Fi or hotspot. Controllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1792786145, "id": "1346028015266372", "version": "2.2", "version_code": 199, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1346028015266372"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "MuralView2 / Shared Vision now opens with a short how-to, then the board. Double-tap LIBRARY to open or close the control panel. Press A and B together, or X and Y, to bring the board about four feet in front of you if you left it on the floor. Pick a picture from headset photos or muralview2.com. A picture in use goes faint in the library \u2014 tap it to take it down. The little X only deletes it from the library. PLACE still shoots the print onto the real wall, floor, or ceiling. DRAW still moves, enlarges, flips, and spins; hold the trigger to slide four times as fast. TRANSFORM folds, curves, and warps, with grabable handles and a frame that stays on the paper. Undo All lays the flaps back and leaves your fold lines. Previous puts a saved print back on that wall. Shared Vision lets another Quest in the same room see the print where you locked it \u2014 host after you lock placement; they tap JOIN SESSION on the same Wi-Fi or hotspot. Controllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1792759656, "id": "1345393118663195", "version": "2.2", "version_code": 193, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1346028015266372"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "MuralView2 puts your pictures on the real walls in the room: pick one in LIBRARY from headset photos or the website, PLACE it on a wall, floor, or ceiling and size it in real feet or inches, DRAW to move, enlarge, flip, and spin, and TRANSFORM to fold or curve the paper. Previous puts a saved print back on that wall. Shared Vision lets another Quest in the same room see the print where you locked it \u2014 host after you lock placement, they tap JOIN SESSION on the same Wi-Fi or hotspot, and each headset then has its own copy. Controllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1792324441, "id": "1336582702877570", "version": "2.2", "version_code": 168, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1346028015266372"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "What\u2019s new\r\n\r\nMuralView2 puts your pictures on the real walls in the room. Pick one in LIBRARY from headset photos or the website with a pairing code. PLACE grabs the print and shoots it onto a wall, floor, or ceiling, sizes it in real feet or inches, levels it, and fades it. DRAW moves, enlarges, flips, and spins. TRANSFORM folds, curves, corners, and warps the paper. Take the headset off and put it back on \u2014 Previous puts the print back on that wall.\r\n\r\nShared Vision lets another Quest in the same room see the print where you locked it. Host after you lock placement; they tap JOIN SESSION on the same Wi-Fi or hotspot. Once it is shared, each headset has its own copy to move. Hosted and joined pictures stay on the Shared Vision shelf.\r\n\r\nControllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1792236025, "id": "1334896799712827", "version": "2.2", "version_code": 166, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1346028015266372"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "MuralView2 puts your pictures
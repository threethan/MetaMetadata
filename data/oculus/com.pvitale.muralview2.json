s://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300603_1599398654962043_5381691924325419729_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2gIGthA3fYQ7kNvwFoatGp&_nc_oc=Adp9iU5IR4PvpWkLsEnSHYG2BjzxWCa_4ANwx6iifCgw6rpAotsaWC5a7tn60mxt33s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2-MqtVc4CKU95CSMToR4h3DTs6ASUjNpc4aR-dhErkg&oe=6ADDF122"}, {"file_name": "MuralView2_1753_2560x1440.png", "id": "1862870588468656", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303471_1862870591801989_6417679298114275110_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBp3EQ26RbIQ7kNvwFEx5YE&_nc_oc=AdqC-_rtt9R9y78Z5PpWaD7ZH3Ocs16NR6fDJJHlXSRBgkFSDDinIoMGJ74itRmkn7Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-o2QKB-8IEQQ_DLOTkXplk5vxN51BA0lBZR5VH550cA&oe=6ADDF0C2"}, {"file_name": "MuralView2_1756_2560x1440.png", "id": "1612239173611160", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/646428823_1612239176944493_7495525924193625158_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsLGpgGgGYoQ7kNvwGNloCx&_nc_oc=AdrcLLWwHmPjG7U3OvRwEtBLRzl9ZxPRsRqiUB3e3P9Eeybq8Vu0IxrWdYjyff7DxXg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4ZudlvUS2jBP_TN7c4_apTUmOZMYIQfIMnYPcsxA7lA&oe=6ADE0619"}, {"file_name": "MuralView2_1752_2560x1440.png", "id": "4526260330926102", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499293669_4526260334259435_2462045530780696567_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OK8nXaNJcYQ7kNvwEdhUHq&_nc_oc=AdqxGQjlu1m2osMhKcIGCo--AsZthQSnbh5dhT0hca-3gswkLku9xMeqpQP6XAdicfc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFSuwLMrwaQgPKzfPe16NcFwmHyMXmZ8lp1kJTiTBk7Q&oe=6ADE04C7"}, {"file_name": "MuralView2_1754_2560x1440.png", "id": "1527493099142502", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/654944867_1527493102475835_3524320972275221483_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If0YQ8lf9JMQ7kNvwEgjmvB&_nc_oc=Adr-3W7RB9KnoiMcxuPjmTmP5p4SAzCRdXddqo99Bqp3jiFr6AdJwdPWNsaqEKzvqqo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-p8Jltl4OkIDe8SqTFnuch93K_52VZ5OamCw2P4xQVQ&oe=6ADDFC9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled_Artwork 31.png", "id": "1069304452583563", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301236_1069304455916896_3219338360736593823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Hb-wnNBnoUQ7kNvwGn69UH&_nc_oc=Adp5HvlwjvMg2k5w_YvJU-396jP92EYaF5-y7K6DlBJbMeDvyZTULj5_YywvWp0Ns3s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOlNrV-52RlP-FVe9yOoATa5jGSvd0cZapDiscenlyMA&oe=6ADE1627"}, "display_name": "MuralView2", "keywords": [], "long_description": "MuralView2 is a mixed reality visualization tool built for mural artists, designers, and clients. Import your artwork and place it directly onto real-world walls through Meta Quest, giving you a true sense of scale, placement, and composition before the first drop of paint hits the wall.\n\nMove, scale, rotate, mirror, and adjust your artwork while standing in the actual space. Fine-tune opacity and positioning to visualize how a mural will interact with architectural features and the surrounding environment.\n\nShared Vision takes mural planning further by allowing multiple Meta Quest headsets to view the same mural placement together in the same physical space. Artists, assistants, and clients can walk around the project and experience the proposed mural from different viewpoints at the same time.\n\nWhether you\u2019re planning a large commercial mural, presenting a concept to a client, or working out placement before painting, MuralView2 helps bridge the gap between a digital design and the finished wall.\n\nPlan it. Place it. See it before you paint it.", "short_description": "Use this for the Short Description:\n\nVisualize your mural before you paint it. MuralView2 lets artists import artwork and place it directly on real-world walls in mixed reality. Scale, position, rotate, adjust opacity, and preview designs at true scale using Meta Quest. Shared Vision lets multiple headsets view the same mural placement together, making it easier to plan, present, and collaborate with clients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://middlevitalemurals.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Middle Vitale Murals LLC", "support_website_url": null, "website_url": "https://middlevitalemurals.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "1318696471332860"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299891_1115473434212229_3616753694242184658_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gqj99nKhIWQQ7kNvwH4JKd_&_nc_oc=AdpHPProI-UzXA7XwjhBuWGlA-e9OZgz5FsZpFeK2qTIg5D3BoUWn80w7QjLkvIMT5E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwzbd9b0lAmpd7DKqKd2LPyKrZ6y7ebhQiQQ7CemUxbQ&oe=6ADE026C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MuralView2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name":
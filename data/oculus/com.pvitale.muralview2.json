sid=6e7a0a&_nc_ohc=1MYSDE_SXM8Q7kNvwEXawup&_nc_oc=AdruZrkWnb2zz2Rx-3NTNJCbhqyAMAZSrEH6JAozd69RcBEAgjjBALQVONeZlTG7ZBg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL8fdpkJrPVtYG5gw0EFT4hPF5tB1g7H2hQLCqWKt8QA&oe=6AEC8699"}, {"file_name": "MuralView2_1752_2560x1440.png", "id": "4526260330926102", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499293669_4526260334259435_2462045530780696567_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83VNsoEWTBQQ7kNvwGVMDcC&_nc_oc=Adr-FTzzrLOOIFyXXy-yAvckP9ebZQ10mppgdk55TIFXk6P4ZMPFXKyAxgU_KzmoJ2o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1VoMuQemkvoQKXp1__3RBfKh1giH00nZUlNrN2e5O5w&oe=6AEC8547"}, {"file_name": "MuralView2_1754_2560x1440.png", "id": "1527493099142502", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/654944867_1527493102475835_3524320972275221483_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UI7KSsfH2r8Q7kNvwGCJPBA&_nc_oc=AdpIGGapGSqt9vh0pAJlykkrbXmMt29R1dbwCBz8xxJY2deVA89ATwWQGDVYIrWvwME&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYHk9JmoJLmjQX-n8RUXdaco_5apJNyen7RPNMaYOl2Q&oe=6AECB55C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled_Artwork 31.png", "id": "1069304452583563", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499301236_1069304455916896_3219338360736593823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QRbIOU84OsQ7kNvwGsIClA&_nc_oc=AdpDNt6Kd_IkVp5A5qfq6fDndcMC5umi_KfXSpDpBBwWSElQ9RZN32QXdwOxNsVeiXQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsNgg5RDMG174D8DDOiiy-zUW7I0KZ-GYgWmNpxxIa7A&oe=6AEC96A7"}, "display_name": "MuralView2", "keywords": [], "long_description": "MuralView2 is a mixed reality visualization tool built for mural artists, designers, and clients. Import your artwork and place it directly onto real-world walls through Meta Quest, giving you a true sense of scale, placement, and composition before the first drop of paint hits the wall.\n\nMove, scale, rotate, mirror, and adjust your artwork while standing in the actual space. Fine-tune opacity and positioning to visualize how a mural will interact with architectural features and the surrounding environment.\n\nShared Vision takes mural planning further by allowing multiple Meta Quest headsets to view the same mural placement together in the same physical space. Artists, assistants, and clients can walk around the project and experience the proposed mural from different viewpoints at the same time.\n\nWhether you\u2019re planning a large commercial mural, presenting a concept to a client, or working out placement before painting, MuralView2 helps bridge the gap between a digital design and the finished wall.\n\nPlan it. Place it. See it before you paint it.", "short_description": "Use this for the Short Description:\n\nVisualize your mural before you paint it. MuralView2 lets artists import artwork and place it directly on real-world walls in mixed reality. Scale, position, rotate, adjust opacity, and preview designs at true scale using Meta Quest. Shared Vision lets multiple headsets view the same mural placement together, making it easier to plan, present, and collaborate with clients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://middlevitalemurals.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Middle Vitale Murals LLC", "support_website_url": null, "website_url": "https://middlevitalemurals.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "1318696471332860"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1442219297287273"}, {"status": "PUBLISHED", "id": "2632137783883640"}]}, "baseline_offer": {"id": "1442219297287273"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792685160, "status": "PUBLISHED", "id": "1442219297287273"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1365136486688858", "version": "2.2"}, "id": "3613079635527364", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1365136486688858"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "Thanksgiving is coming to MuralView2!\r\nFrom November 4 through November 30, the control panel puts on its harvest look:\r\n\r\nWarm harvest-brown panels with amber buttons and cream lettering\r\nA friendly turkey strutting beside the SIZE window\r\nA pilgrim standing on top of your uploads window\r\nA fresh apple pie resting on the CONTROL PANEL title\r\nAutumn maple and oak leaves drifting down past your windows\r\n\r\nThe decorations never block your laser, and the look switches back to normal automatically in December. Halloween stays on through November 3.", "created_date": 1793479866, "id": "1365304646672042", "version": "2.2", "version_code": 386, "release_status": "SCHEDULED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1365136486688858"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "Release notes, version 2.2 (385)\r\n\r\nHalloween is here! Until November 3, the control panel wears purple and pumpkin orange, with a jack-o\u2019-lantern, cobwebs, a bat and a dangling spider. The decorations never block your laser.", "created_date": 1793472215, "id": "1365136486688858", "version": "2.2", "version_code": 385, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1365136486688858"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "Release notes, version 2.2 (384)\r\n\r\nShare several pictures at once. When you host, guests now see every PNG and JPEG on your wall, up to four, not just the one you\u2019re working on. The extra pictures arrive a moment after the main one, and joining stays smooth.\r\nPSD and SVG go up alone. While other pictures are on the wall, PSD and SVG files show \u201cNot available\u201d, so a shared PSD is always on its own.\r\nHosting a PSD always saves a PNG to Shared Vision, even if its layers didn\u2019t load. The PSD stays in Projects.\r\nUndo All starts over. In TRANSFORM, Undo All puts the picture back exactly as it was when you opened TRANSFORM, fold lines included. Press A/X to bring it all back.\r\nFold and curve line handles follow the line. The balls at the ends of a fold line now move with it while you drag.", "created_date": 1793456757, "id": "1364712803397893", "version": "2.2", "version_code": 384, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1365136486688858"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "What\u2019s new in 383\r\n\r\nSVGs can be transformed. FREEFORM, UNIFORM, DISTORT, WARP, FOLD, CURVE, CORNER and DOME now work on vector art. A bent or faded SVG shows a sharp 4096-pixel version, and goes back to crisp vector shapes when it\u2019s flat again.\r\nUndo and redo on the controller. In TRANSFORM, and while the Previous/New placement question is showing:\r\nA or X steps back through moves, size, fade, TRANSFORM steps, opening a picture and taking one down. At the Previous/New question, it backs out of the pick.\r\nB or Y redoes what you undid.\r\nPLACE and DRAW are unchanged. A and B still move the picture in and out there.\r\nA domed PSD keeps its dome after you leave TRANSFORM.\r\nSmoother TRANSFORM. Fixed an error that fired every frame while aiming at the TRANSFORM handles, which was adding to the hitching.\r\nThe on-screen hints say \u201cB / Y redoes it\u201d, in all 9 languages.", "created_date": 1793451706, "id": "1364562996746207", "version": "2.2", "version_code": 383, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1365136486688858"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "MuralView2 2.2 (build 382)\r\n\r\nPhotoshop (PSD) files are back. Upload a PSD on muralview2.com and open it on the headset with its layers. It shows right side up and the right shape.\r\nFold, curve, corner, warp and fade a PSD. It keeps its shape at any fade, and you can turn layers on and off while it\u2019s bent.\r\nPSDs open more smoothly. Layers load in the background, so the app stays responsive while a big PSD comes in.\r\nShared Vision with a PSD. When you host, the PSD is saved to Projects with its size, place and layers. Everyone in the session sees a PNG with the same shape, and the PNG is saved in Shared Vision when you leave.\r\nSmoother joining. A headset joining a session gets the picture once instead of several times.\r\nEvery saved copy shows up. Projects and Shared Vision list all your saved pictures, and each host or join adds a new tile instead of replacing an older one.\r\nScrolling libraries. Point at a library and use the thumbstick, or drag the scroll bar. The uploads window scrolls when you point at it.\r\nDeleting a Shared Vision picture also removes its file from the headset.", "created_date": 1793447064, "id": "1364400446762462", "version": "2.2", "version_code": 382, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
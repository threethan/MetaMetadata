7f30f&oh=00_AQQzuThxgYSzG_Tbmnkpx4cWZctU30I5zR8Hn491vKR7mw&oe=6B0D9F02"}, {"file_name": "MuralView2_1756_2560x1440.png", "id": "1612239173611160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/646428823_1612239176944493_7495525924193625158_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXroL9xO4ogQ7kNvwGBlzK2&_nc_oc=Adp8JJ0YmJFbYLzNlR6AGrtWKO3hOMMx5ITGEVm9ZpSyTp5CgvzBtR-xWkOt4MYqkqI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTj2gy8u2VNXyNquB0NOmtrPvh_5jqngC6ORxk1ydy1hQ&oe=6B0DB459"}, {"file_name": "MuralView2_1752_2560x1440.png", "id": "4526260330926102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499293669_4526260334259435_2462045530780696567_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrJN6xXD4fMQ7kNvwGf6RKa&_nc_oc=AdrkzAdKPyyeKx9eW1yx3wc711vcgEFAwBrPPuyZF0Hvl4BeYPzkXGZDMpKcFFqsZwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSUwTCGBCGsTGAwh7ZcVKGwPt41YraZc1byb7BP3ckDXg&oe=6B0DB307"}, {"file_name": "MuralView2_1754_2560x1440.png", "id": "1527493099142502", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654944867_1527493102475835_3524320972275221483_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhKj0EuhK8YQ7kNvwHHxgNs&_nc_oc=Adq6H0Tw77UdRVrJiy1tJ1fpjEbphlbi2CAY-s6cOdcfixGOCTlNIYc5cSZxUQpn9D0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbM7068NWhx2nHnFZt2RpgISTKXEEJLkTCLwWCcdY0UQ&oe=6B0DAADC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled_Artwork 31.png", "id": "1069304452583563", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301236_1069304455916896_3219338360736593823_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhgJG6_RqZAQ7kNvwG0jRWO&_nc_oc=Adps5gqMZGSpIwhtfbWazJWD0FJWqqA9cDE-75l6cHGNOyFLFxHU1_4a5hZoOyyMxgM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTvOluaniWierlxRLN0Ze5FdkPNb5N0xwBQ2irWZF2XFQ&oe=6B0DC467"}, "display_name": "MuralView2", "keywords": [], "long_description": "MuralView2 is a mixed reality visualization tool built for mural artists, designers, and clients. Import your artwork and place it directly onto real-world walls through Meta Quest, giving you a true sense of scale, placement, and composition before the first drop of paint hits the wall.\n\nMove, scale, rotate, mirror, and adjust your artwork while standing in the actual space. Fine-tune opacity and positioning to visualize how a mural will interact with architectural features and the surrounding environment.\n\nShared Vision takes mural planning further by allowing multiple Meta Quest headsets to view the same mural placement together in the same physical space. Artists, assistants, and clients can walk around the project and experience the proposed mural from different viewpoints at the same time.\n\nWhether you\u2019re planning a large commercial mural, presenting a concept to a client, or working out placement before painting, MuralView2 helps bridge the gap between a digital design and the finished wall.\n\nPlan it. Place it. See it before you paint it.", "short_description": "Use this for the Short Description:\n\nVisualize your mural before you paint it. MuralView2 lets artists import artwork and place it directly on real-world walls in mixed reality. Scale, position, rotate, adjust opacity, and preview designs at true scale using Meta Quest. Shared Vision lets multiple headsets view the same mural placement together, making it easier to plan, present, and collaborate with clients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://middlevitalemurals.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Middle Vitale Murals LLC", "support_website_url": null, "website_url": "https://middlevitalemurals.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "1318696471332860"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1442219297287273"}, {"status": "PUBLISHED", "id": "2632137783883640"}]}, "baseline_offer": {"id": "1442219297287273"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792685160, "status": "PUBLISHED", "id": "1442219297287273"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1417401141462392", "version": "2.2"}, "id": "3613079635527364", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1417401141462392"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "SMOOTHER\r\nPutting a picture on the wall no longer makes the view hitch. The photo is now prepared in the background.\r\nOpening Your Uploads is smoother. The picture tiles load without small stutters.\r\nOpening FOLD and the other BEND tools no longer causes a hitch.\r\n\r\nControllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1795619362, "id": "1417401141462392", "version": "2.2", "version_code": 405, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1417401141462392"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "SMOOTHER\r\nPutting a picture on the wall no longer makes the view hitch. The photo is now prepared in the background.\r\nOpening Your Uploads is smoother. The picture tiles load without small stutters.\r\nOpening FOLD and the other BEND tools no longer causes a hitch.\r\n\r\nControllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1795533075, "id": "1415295161672990", "version": "2.2", "version_code": 404, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1417401141462392"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "A CLEANER TRANSFORM\r\nTRANSFORM now opens on four colour-coded cards instead of a wall of buttons:\r\nRESHAPE (green): FREEFORM, UNIFORM, DISTORT and WARP.\r\nBEND (pink): DOME, FOLD, CURVE and CORNER.\r\nCOLOR & LOOK (purple): opacity, outlines, drop white and more.\r\nMOVE & TILT (cyan): size, distance, tilt and spin sliders.\r\nEach card opens its own window in its own colour, so you always know where you are. BACK takes you to the cards. LAYERS and ADJUST sit just below them.\r\n\r\nControllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1795013019, "id": "1403937826142057", "version": "2.2", "version_code": 403, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1417401141462392"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "WHAT'S NEW\r\n\r\nNEW MOVE & TILT SLIDERS\r\nTRANSFORM has a new MOVE & TILT card, under COLOR & LOOK. Point at a slider, hold the trigger and slide. No controller combos needed.\r\nSIZE makes the picture bigger or smaller.\r\nCLOSER / FARTHER moves it toward you or back toward the wall.\r\nTILT UP / DOWN and TILT LEFT / RIGHT lean it to match the wall.\r\nSPIN turns it in place.\r\nFORCE VERTICAL and FORCE HORIZONTAL straighten it in one tap.\r\nThe sliders and the controller buttons work together, and UNDO takes back slider moves too.\r\n\r\nTRUE OUTLINES\r\nOUTLINE now turns the picture into clean black lines with no color left behind, even on pictures with texture or shading.\r\nThe lines are part of the picture, about the width of a Sharpie line, and they stay crisp and solid black as you move the picture away instead of blurring into blobs.\r\nNew LINE WIDTH slider: set the lines anywhere from half to four times as thick.\r\n\r\nDROP WHITE WORKS ON PAPER\r\nDROP WHITE now clears the paper itself, including cream, off-white and grey paper from photos and scans, not just pure white. Your lines and colors stay solid.\r\nDROP BLACK is smoother too.\r\n\r\nSEE-THROUGH, MORE\r\nThe OPACITY slider now goes almost all the way clear.\r\n\r\nPICTURE SHIFTING ON A BIG BLANK WALL?\r\nThe Quick Start guide has a new IMAGE SHIFTING? box. Tap it for a picture and a short explanation: the headset's cameras hold the picture steady by recognising marks on the wall, and a big blank wall has none. The fix: tape a random pattern of X's and Y's all over the wall, the middle too.\r\nThe same help, with the picture, is in the \"?\" list.\r\n\r\nALSO\r\nEvery BACK button is now the same curved back arrow, in the top-left corner.\r\nPSD and SVG files are marked the same way as JPEG and PNG in the Quick Start guide.\r\n\r\nControllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1795006784, "id": "1403773726158467", "version": "2.2", "version_code": 402, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1417401141462392"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "MuralView2 2.2 \u2014 headset 401\r\n\r\nWHAT'S NEW\r\n\r\nUNLINK A HEADSET FROM THE HEADSET\r\nLIBRARY now has an UNLINK button next to the HEADSET CODE. It lights up in the panel's color while the headset is linked to an account at muralview2.com. Press it twice to unlink. You get a new HEADSET CODE, ready to link to any account. Your pictures stay safe on the website.\r\n\r\nA reinstalled app no longer comes back linked to the wrong account.\r\n\r\nIncludes everything from 400.\r\n\r\nControllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1794698266, "id": "1397322050136968", "version": "2.2", "version_code": 401, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
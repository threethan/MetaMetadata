71-25/499303471_1356344026573550_8617535816553659246_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTc5w6l-HjEQ7kNvwHoEX6A&_nc_oc=Adqfx6WXAC_0-tazf9cuhSetJxjgifR4G9NaNAcZDV6SlO8pZNTGMl1aG7AaIvpBl0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJSfPuRbprihGRrkIQzsFa1gNsnCHv5z09n8-DL_Egng&oe=6AEF33E5"}, {"file_name": "Untitled_Artwork 33.png", "id": "1115473430878896", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299891_1115473434212229_3616753694242184658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZH7AKqc_HsQ7kNvwEbM_Ii&_nc_oc=AdoiIyLbB0QuHJErJlGBvcUO8mbfW4mtlgYec7vHGUUENBNnYizogYDRSAotUKErROQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGEviAgNEYidtpUyTyoahJtFnIIQvetbo7mfvLN3vkTA&oe=6AEF5E2C"}]}, "id": "2474366993088108", "locale": "en_US", "screenshots": [{"file_name": "MuralView2_1755_2560x1440.png", "id": "1599398651628710", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300603_1599398654962043_5381691924325419729_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jvO9ZDUc4oQ7kNvwGjZ35C&_nc_oc=Adpg8t1_IGUgmaF_-Dz8mikZY5LW_OEnr_Mvt4BsjQ3zF6J10BtcQgBJZ_71dhVdawY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7AuPJlcH4xAEudNlqAxA4aUuu8B5s-22jIO-0br79Sw&oe=6AEF4CE2"}, {"file_name": "MuralView2_1753_2560x1440.png", "id": "1862870588468656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303471_1862870591801989_6417679298114275110_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x494jNGiG60Q7kNvwGCWf1g&_nc_oc=AdpnP4ZO2fTeNSBKj8Yhxcx6K0qPIp92EHAs1EORxBYI8lysDCqyCH7JY0t0CETlCTw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu7RHh172N1Ec1pFPkzMtbq3K6lZ4lVeS-n92VVHNnoQ&oe=6AEF4C82"}, {"file_name": "MuralView2_1756_2560x1440.png", "id": "1612239173611160", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646428823_1612239176944493_7495525924193625158_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiTVNOQbG7MQ7kNvwHcZR1d&_nc_oc=AdpJNyLxGht_XoTfFcPS0wjMWXQxRPufPuw3cGEZ_Zk0vl-ppS7H-yZJ03-MTxppAVI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNwgmKX9DEWfG2V8b12jMKfeoBclx5Cmp57wUgwxukyg&oe=6AEF61D9"}, {"file_name": "MuralView2_1752_2560x1440.png", "id": "4526260330926102", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499293669_4526260334259435_2462045530780696567_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF_TLZynKAQQ7kNvwFT-4ix&_nc_oc=Ado831fNrhmGcdCqrkmhdiPfU9xNYz4Yox8GN8XzhUOVY2_Gyo9Y79T39okwmOjuuRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCD9YnXeYKLJJpLpxjhsDdjoz5nMmKS-ihoP3XEXITzw&oe=6AEF6087"}, {"file_name": "MuralView2_1754_2560x1440.png", "id": "1527493099142502", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654944867_1527493102475835_3524320972275221483_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UI7KSsfH2r8Q7kNvwGGOeCB&_nc_oc=AdoVESTDmDC7yHrAi5dsJCnGMOJ2tyu2VU2xfcTSyi2asSM-9Pv7heyE4oYXhlLKLB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdWUF0U7WvchODT1rKJkThnFS40-DdMi0QNXiQ459S0w&oe=6AEF585C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled_Artwork 31.png", "id": "1069304452583563", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301236_1069304455916896_3219338360736593823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICrxFJR2Q_gQ7kNvwHPq5qS&_nc_oc=AdqWc-2s58iZAuhPgoPER1AJLlYuDRwhsDHT1-4ZnRp66PfCRIJJqeUNhrOpTs_dyWw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQAEkUS_o9i6i7APoZQsDD-UZPpOIbuDBsYtyH0KctOg&oe=6AEF39A7"}, "display_name": "MuralView2", "keywords": [], "long_description": "MuralView2 is a mixed reality visualization tool built for mural artists, designers, and clients. Import your artwork and place it directly onto real-world walls through Meta Quest, giving you a true sense of scale, placement, and composition before the first drop of paint hits the wall.\n\nMove, scale, rotate, mirror, and adjust your artwork while standing in the actual space. Fine-tune opacity and positioning to visualize how a mural will interact with architectural features and the surrounding environment.\n\nShared Vision takes mural planning further by allowing multiple Meta Quest headsets to view the same mural placement together in the same physical space. Artists, assistants, and clients can walk around the project and experience the proposed mural from different viewpoints at the same time.\n\nWhether you\u2019re planning a large commercial mural, presenting a concept to a client, or working out placement before painting, MuralView2 helps bridge the gap between a digital design and the finished wall.\n\nPlan it. Place it. See it before you paint it.", "short_description": "Use this for the Short Description:\n\nVisualize your mural before you paint it. MuralView2 lets artists import artwork and place it directly on real-world walls in mixed reality. Scale, position, rotate, adjust opacity, and preview designs at true scale using Meta Quest. Shared Vision lets multiple headsets view the same mural placement together, making it easier to plan, present, and collaborate with clients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://middlevitalemurals.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Middle Vitale Murals LLC", "support_website_url": null, "website_url": "https://middlevitalemurals.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "1318696471332860"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1442219297287273"}, {"status": "PUBLISHED", "id": "2632137783883640"}]}, "baseline_offer": {"id": "1442219297287273"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792685160, "status": "PUBLISHED", "id": "1442219297287273"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1371691576033349", "version": "2.2"}, "id": "3613079635527364", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1371691576033349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "MuralView2 2.2 \u2014 headset 388\r\n\r\nWHAT'S NEW\r\n\r\nNEW COLORS EVERY TIME\r\nThe control panel picks a fresh color scheme each time you start MuralView2: a tinted glass, a bold highlight in a color of its own, and matching letters. Every start looks plainly different from the last, and every scheme is checked so the words and buttons always read clearly. The controller beam matches the scheme too.\r\n\r\nA LIGHT THAT SHOWS IT'S WORKING\r\nWhen you open a picture, a light runs around its tile until the picture is up. Buttons that take a moment, like Host, Join and Leave Session, light up the same way, so you always know your press was heard.\r\n\r\nHEADSET LINKING\r\nFixed \"headset linked to another account\" when pairing a new headset. Each headset now gets its own link to your library.\r\n\r\nControllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1793677852, "id": "1371691576033349", "version": "2.2", "version_code": 388, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1371691576033349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "MuralView2 2.2 \u2014 headset 387\r\n\r\nWHAT\u2019S NEW\r\n\r\nNEW COLORS EVERY TIME\r\nThe control panel picks a fresh color scheme each time you start MuralView2: a tinted glass, a bold highlight, and matching letters. Every scheme is checked before it is used, so the words and buttons always read clearly. No two starts in a row look the same.\r\n\r\nHEADSET LINKING\r\nFixed \u201cheadset linked to another account\u201d when pairing a new headset. Each headset now gets its own link to your library.\r\n\r\nThis build replaces the Halloween panel colors with the new color schemes.\r\n\r\nControllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1793575552, "id": "1368994736303033", "version": "2.2", "version_code": 387, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1371691576033349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "Thanksgiving is coming to MuralView2!\r\nFrom November 4 through November 30, the control panel puts on its harvest look:\r\n\r\nWarm harvest-brown panels with amber buttons and cream lettering\r\nA friendly turkey strutting beside the SIZE window\r\nA pilgrim standing on top of your uploads window\r\nA fresh apple pie resting on the CONTROL PANEL title\r\nAutumn maple and oak leaves drifting down past your windows\r\n\r\nThe decorations never block your laser, and the look switches back to normal automatically in December. Halloween stays on through November 3.", "created_date": 1793479866, "id": "1365304646672042", "version": "2.2", "version_code": 386, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1371691576033349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "Release notes, version 2.2 (385)\r\n\r\nHalloween is here! Until November 3, the control panel wears purple and pumpkin orange, with a jack-o\u2019-lantern, cobwebs, a bat and a dangling spider. The decorations never block your laser.", "created_date": 1793472215, "id": "1365136486688858", "version": "2.2", "version_code": 385, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1371691576033349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "Release notes, version 2.2 (384)\r\n\r\nShare several pictures at once. When you host, guests now see every PNG and JPEG on your wall, up to four, not just the one you\u2019re working on. The extra pictures arrive a moment after the main one, and joining stays smooth.\r\nPSD and SVG go up alone. While other pictures are on the wall, PSD and SVG files show \u201cNot available\u201d, so a shared PSD is always on its own.\r\nHosting a PSD always saves a PNG to Shared Vision, even if its layers didn\u2019t load. The PSD stays in Projects.\r\nUndo All starts over. In TRANSFORM, Undo All puts the picture back exactly as it was when you opened TRANSFORM, fold lines included. Press A/X to bring it all back.\r\nFold and curve line handles follow the line. The balls at the ends of a fold line now move with it while you drag.", "created_date": 1793456757, "id": "1364712803397893", "version": "2.2", "version_code": 384, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
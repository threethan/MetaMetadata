d=6e7a0a&_nc_ohc=1MYSDE_SXM8Q7kNvwGAtriD&_nc_oc=AdpQrmjwuP1ReVDn60qLd8Bsgb3_8qqoT7b81VcPjonoU-r6gukMWLFNfl7ZF7cpnY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOCXkIhPZwH9_kiFNl3LROW4CE7tSTdSK5qciwrtpAyw&oe=6AEB3519"}, {"file_name": "MuralView2_1752_2560x1440.png", "id": "4526260330926102", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499293669_4526260334259435_2462045530780696567_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83VNsoEWTBQQ7kNvwF2w-Dh&_nc_oc=Adp4vrxJiYZTKAjNQUbOq6QL0GIk4yuX1SU_sKHbh_C_CJypY5JwoGqcbIVXXxPMRJk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL10quGKD1Xq8MReeLinF3tLNUfBmqj4-JOiEIdg5rGQ&oe=6AEB33C7"}, {"file_name": "MuralView2_1754_2560x1440.png", "id": "1527493099142502", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/654944867_1527493102475835_3524320972275221483_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csYI_viyYtsQ7kNvwFLNG_W&_nc_oc=AdplHRgNvtUPV0pczuf3JVpcg06H5sMw5eCXQD0_W2wLk6QMhsMOoPuS-_bXBptoFyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaojF0sE_QeUvCY9zUntS1r_qALlviE2QRqR2PEDHuHw&oe=6AEB63DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled_Artwork 31.png", "id": "1069304452583563", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499301236_1069304455916896_3219338360736593823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QRbIOU84OsQ7kNvwHpZw1G&_nc_oc=AdpB3aATmEcHN0cPatvPFYUDwlPI3JtRagjoSUevsJkg-mXPXacifRQMdfmyLurnvAo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-Eg3Yan21nuEJDFV7XO3wF3biXQRpuGB8OSEMEN6M_A&oe=6AEB4527"}, "display_name": "MuralView2", "keywords": [], "long_description": "MuralView2 is a mixed reality visualization tool built for mural artists, designers, and clients. Import your artwork and place it directly onto real-world walls through Meta Quest, giving you a true sense of scale, placement, and composition before the first drop of paint hits the wall.\n\nMove, scale, rotate, mirror, and adjust your artwork while standing in the actual space. Fine-tune opacity and positioning to visualize how a mural will interact with architectural features and the surrounding environment.\n\nShared Vision takes mural planning further by allowing multiple Meta Quest headsets to view the same mural placement together in the same physical space. Artists, assistants, and clients can walk around the project and experience the proposed mural from different viewpoints at the same time.\n\nWhether you\u2019re planning a large commercial mural, presenting a concept to a client, or working out placement before painting, MuralView2 helps bridge the gap between a digital design and the finished wall.\n\nPlan it. Place it. See it before you paint it.", "short_description": "Use this for the Short Description:\n\nVisualize your mural before you paint it. MuralView2 lets artists import artwork and place it directly on real-world walls in mixed reality. Scale, position, rotate, adjust opacity, and preview designs at true scale using Meta Quest. Shared Vision lets multiple headsets view the same mural placement together, making it easier to plan, present, and collaborate with clients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://middlevitalemurals.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Middle Vitale Murals LLC", "support_website_url": null, "website_url": "https://middlevitalemurals.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "1318696471332860"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1442219297287273"}, {"status": "PUBLISHED", "id": "2632137783883640"}]}, "baseline_offer": {"id": "1442219297287273"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792685160, "status": "PUBLISHED", "id": "1442219297287273"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1362924706910036", "version": "2.2"}, "id": "3613079635527364", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1362924706910036"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "What\u2019s new in 2.2 (381)\r\n\r\nSmoother Shared Vision joining: joining someone\u2019s session no longer stutters while their picture loads, for photos and SVG artwork alike.\r\nCorner shapes now share: a picture bent around a wall corner with the Corner tool now shows bent for everyone in the session, not flat.\r\nFaster hosting: starting a shared session and letting someone join is lighter on the host\u2019s headset.", "created_date": 1793420312, "id": "1362924706910036", "version": "2.2", "version_code": 381, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1362924706910036"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "Version 2.2 (build 380)\r\n\r\n\u2022 Smoother performance: holds a steady frame rate while you fold, transform and move images.\r\n\u2022 Resizing is smoother: dragging a corner handle now grows or shrinks the image evenly, with no shaking.\r\n\u2022 Vector (SVG) art opens, moves and closes without stutter, even for files with many color layers.\r\n\u2022 Shared Vision: after you leave a shared session, Previous now returns the image to the spot it had on the wall.\r\n\u2022 Lock Placement holds right away when you reopen a saved project, with no need to toggle it off and on.\r\n\u2022 Photoshop (PSD) uploads are paused while we improve them. JPG, PNG and SVG work as usual.", "created_date": 1793409447, "id": "1362436650292175", "version": "2.2", "version_code": 380, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1362924706910036"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "MuralView2 puts your pictures on the real walls in the room: pick one in LIBRARY from headset photos or the website, PLACE it on a wall, floor, or ceiling and size it in real feet or inches, DRAW to move, enlarge, flip, and spin, and TRANSFORM to fold or curve the paper. Previous puts a saved print back on that wall. Shared Vision lets another Quest in the same room see the print where you locked it \u2014 host after you lock placement, they tap JOIN SESSION on the same Wi-Fi or hotspot, and each headset then has its own copy. Controllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1793124910, "id": "1353218711213969", "version": "2.2", "version_code": 318, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1362924706910036"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "This update makes vector (SVG) artwork work the way sign painters actually use it: detailed and traced designs that used to stall in the library now open on the wall, every design\u2019s colors match its thumbnail exactly, and in LAYERS each color is its own layer with a solid color block so you can switch colors on and off one at a time while you paint. It also tidies the interface \u2014 the big DELETE button and every yellow accent across the app now use the same mango color as the controller beam, keeping the buttons\u2019 dark fade \u2014 and when you summon the control panel with both buttons, it now arrives centered at eye height, so you\u2019re looking at the middle of the panel instead of its top edge.", "created_date": 1793022699, "id": "1350756428126864", "version": "2.2", "version_code": 294, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1362924706910036"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "This update makes vector (SVG) artwork work the way sign painters actually use it: detailed and traced designs that used to stall in the library now open on the wall, every design\u2019s colors match its thumbnail exactly, and in LAYERS each color is its own layer with a solid color block so you can switch colors on and off one at a time while you paint. It also tidies the interface \u2014 the big DELETE button and every yellow accent across the app now use the same mango color as the controller beam, keeping the buttons\u2019 dark fade \u2014 and when you summon the control panel with both buttons, it now arrives centered at eye height, so you\u2019re looking at the middle of the panel instead of its top edge.", "created_date": 1793014005, "id": "1350515548150952", "version": "2.2", "version_code": 291, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
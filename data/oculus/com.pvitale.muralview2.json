{"data": {"node": {"__typename": "Application", "id": "1310337855502055", "organization": {"id": "1310302458838928", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1310337855502055"}]}, "id": "28373718468923560"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1310337855502055", "release_date": 1791449880, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 2}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1362924706910036"}, "id": "3613079635527364"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1362924706910036"}, "release_status": "RELEASED"}, "id": "1362924706910036", "version": "2.2", "version_code": 381, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1793420380, "id": "1362927796909727", "is_initial_release": false, "name_with_fallback": "v12", "pdp_metadata_with_fallback": {"version": 2, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1336605446208629"}, "release_status": "RELEASED", "id": "1310337855502055"}, "id": "1336605446208629", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": null, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299891_1115473434212229_3616753694242184658_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRHaJmpYNEIQ7kNvwH3C9u8&_nc_oc=AdpGbsAneBDg8Kfcm901I3HRwbPIw153CAoP6BVF56zxIgdp7MU3GsDrpCaiMhJcUS0&_nc_zt=3&_nc_ht=scontent-
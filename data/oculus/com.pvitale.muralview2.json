s://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499300603_1599398654962043_5381691924325419729_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUcn2Ygk_BMQ7kNvwFUK17p&_nc_oc=Adq5oZ5saeQ76YPetsxJW6wbESgncj2k_FOBBGPubl9cTAMmQjqWghuCiv7BgdUpslc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYKn7PJigaVVHjizCAXv4bzBj-zS7zW_DsPH7sFFnGQg&oe=6AD39D62"}, {"file_name": "MuralView2_1753_2560x1440.png", "id": "1862870588468656", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499303471_1862870591801989_6417679298114275110_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSx0ZKErrH0Q7kNvwFE_wnz&_nc_oc=AdrBe79tvYSPoe8RDmDU3mQ5qzDR1teBCIYF8GJKqXk9NVr_wL4eXeJxFlnSLQQZpNc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMvzXL4hJUHDEYGyUOTGTJIiuOhgEjtrr3ueeoAYmYVA&oe=6AD39D02"}, {"file_name": "MuralView2_1756_2560x1440.png", "id": "1612239173611160", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/646428823_1612239176944493_7495525924193625158_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1Si1Ns2v1IQ7kNvwH3vHW-&_nc_oc=Adp0SseCEaOPrAU_wgaSjDSSJw1IuUczB5Onnyjrcusd6isft2VS261eGKp8QzKLtdY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBuFZ4R7cEeJp4Zg8J6nuVUWXK19mevPwUfEe7COSTtQ&oe=6AD3B259"}, {"file_name": "MuralView2_1752_2560x1440.png", "id": "4526260330926102", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499293669_4526260334259435_2462045530780696567_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUt9q6kCwQUQ7kNvwHO_CxH&_nc_oc=AdqaBHkfUZhi2T4dYd8S-puTIKgT_kTsE2wOoAkOeLFumIfRqu4Enrvh0HRAuWCcv0Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPP8qP3s27Giw6cc8557_MhnE29myLlQN7qME4RAcLM_g&oe=6AD3B107"}, {"file_name": "MuralView2_1754_2560x1440.png", "id": "1527493099142502", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/654944867_1527493102475835_3524320972275221483_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2f-1oQ4w5kQ7kNvwHhuElL&_nc_oc=AdqWQJPt_OPwqcMXh07r_3Gzqg9tpnQWBPm0pGGfXGFSKESgoQOkCIgvf2XlE4sB-5I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaSDr-jT4m3WXUsOcegzKtvPzsWu401B2TNqrl7qLSjQ&oe=6AD3A8DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled_Artwork 31.png", "id": "1069304452583563", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499301236_1069304455916896_3219338360736593823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8lwl2iirowQ7kNvwHQUGHt&_nc_oc=Adp7A9QufmmN35_vV66FwSScsHNCMpGPxMzqQyHaH37n56UgNlZKXglSM3w5ZLi1NsE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMC4cexES5szp3Rpe1O7IQFv8mBWpMWG20LYQ7_AILoDg&oe=6AD38A27"}, "display_name": "MuralView2", "keywords": [], "long_description": "MuralView2 is a mixed reality visualization tool built for mural artists, designers, and clients. Import your artwork and place it directly onto real-world walls through Meta Quest, giving you a true sense of scale, placement, and composition before the first drop of paint hits the wall.\n\nMove, scale, rotate, mirror, and adjust your artwork while standing in the actual space. Fine-tune opacity and positioning to visualize how a mural will interact with architectural features and the surrounding environment.\n\nShared Vision takes mural planning further by allowing multiple Meta Quest headsets to view the same mural placement together in the same physical space. Artists, assistants, and clients can walk around the project and experience the proposed mural from different viewpoints at the same time.\n\nWhether you\u2019re planning a large commercial mural, presenting a concept to a client, or working out placement before painting, MuralView2 helps bridge the gap between a digital design and the finished wall.\n\nPlan it. Place it. See it before you paint it.", "short_description": "Use this for the Short Description:\n\nVisualize your mural before you paint it. MuralView2 lets artists import artwork and place it directly on real-world walls in mixed reality. Scale, position, rotate, adjust opacity, and preview designs at true scale using Meta Quest. Shared Vision lets multiple headsets view the same mural placement together, making it easier to plan, present, and collaborate with clients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://middlevitalemurals.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Middle Vitale Murals LLC", "support_website_url": null, "website_url": "https://middlevitalemurals.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "1318696471332860"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499299891_1115473434212229_3616753694242184658_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzlcbTPEuw4Q7kNvwEBDgFT&_nc_oc=AdqTEQvgoWUGUi_sV7Uq7z05ETlJDTJ7EP34fjfXrzlwd5gyOr2MQH2Ur78OZouixsc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjxHSyt5UztH77pR73Z8VSb_ySN8ECUQDKGfZ152HFPQ&oe=6AD3AEAC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MuralView2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name":
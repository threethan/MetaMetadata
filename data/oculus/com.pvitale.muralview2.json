e": "Untitled_Artwork 33.png", "id": "1115473430878896", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299891_1115473434212229_3616753694242184658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gqj99nKhIWQQ7kNvwH4JKd_&_nc_oc=AdpHPProI-UzXA7XwjhBuWGlA-e9OZgz5FsZpFeK2qTIg5D3BoUWn80w7QjLkvIMT5E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIY0Cz_PGS20uloiADwYdIMo6LO_bdG-cCA7-JtycKmQ&oe=6ADE026C"}]}, "id": "2474366993088108", "locale": "en_US", "screenshots": [{"file_name": "MuralView2_1755_2560x1440.png", "id": "1599398651628710", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300603_1599398654962043_5381691924325419729_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2gIGthA3fYQ7kNvwFoatGp&_nc_oc=Adp9iU5IR4PvpWkLsEnSHYG2BjzxWCa_4ANwx6iifCgw6rpAotsaWC5a7tn60mxt33s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2-MqtVc4CKU95CSMToR4h3DTs6ASUjNpc4aR-dhErkg&oe=6ADDF122"}, {"file_name": "MuralView2_1753_2560x1440.png", "id": "1862870588468656", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303471_1862870591801989_6417679298114275110_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBp3EQ26RbIQ7kNvwFEx5YE&_nc_oc=AdqC-_rtt9R9y78Z5PpWaD7ZH3Ocs16NR6fDJJHlXSRBgkFSDDinIoMGJ74itRmkn7Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-o2QKB-8IEQQ_DLOTkXplk5vxN51BA0lBZR5VH550cA&oe=6ADDF0C2"}, {"file_name": "MuralView2_1756_2560x1440.png", "id": "1612239173611160", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/646428823_1612239176944493_7495525924193625158_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsLGpgGgGYoQ7kNvwGNloCx&_nc_oc=AdrcLLWwHmPjG7U3OvRwEtBLRzl9ZxPRsRqiUB3e3P9Eeybq8Vu0IxrWdYjyff7DxXg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4ZudlvUS2jBP_TN7c4_apTUmOZMYIQfIMnYPcsxA7lA&oe=6ADE0619"}, {"file_name": "MuralView2_1752_2560x1440.png", "id": "4526260330926102", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499293669_4526260334259435_2462045530780696567_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OK8nXaNJcYQ7kNvwEdhUHq&_nc_oc=AdqxGQjlu1m2osMhKcIGCo--AsZthQSnbh5dhT0hca-3gswkLku9xMeqpQP6XAdicfc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFSuwLMrwaQgPKzfPe16NcFwmHyMXmZ8lp1kJTiTBk7Q&oe=6ADE04C7"}, {"file_name": "MuralView2_1754_2560x1440.png", "id": "1527493099142502", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/654944867_1527493102475835_3524320972275221483_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If0YQ8lf9JMQ7kNvwEgjmvB&_nc_oc=Adr-3W7RB9KnoiMcxuPjmTmP5p4SAzCRdXddqo99Bqp3jiFr6AdJwdPWNsaqEKzvqqo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-p8Jltl4OkIDe8SqTFnuch93K_52VZ5OamCw2P4xQVQ&oe=6ADDFC9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled_Artwork 31.png", "id": "1069304452583563", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301236_1069304455916896_3219338360736593823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Hb-wnNBnoUQ7kNvwGn69UH&_nc_oc=Adp5HvlwjvMg2k5w_YvJU-396jP92EYaF5-y7K6DlBJbMeDvyZTULj5_YywvWp0Ns3s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOlNrV-52RlP-FVe9yOoATa5jGSvd0cZapDiscenlyMA&oe=6ADE1627"}, "display_name": "MuralView2", "keywords": [], "long_description": "MuralView2 is a mixed reality visualization tool built for mural artists, designers, and clients. Import your artwork and place it directly onto real-world walls through Meta Quest, giving you a true sense of scale, placement, and composition before the first drop of paint hits the wall.\n\nMove, scale, rotate, mirror, and adjust your artwork while standing in the actual space. Fine-tune opacity and positioning to visualize how a mural will interact with architectural features and the surrounding environment.\n\nShared Vision takes mural planning further by allowing multiple Meta Quest headsets to view the same mural placement together in the same physical space. Artists, assistants, and clients can walk around the project and experience the proposed mural from different viewpoints at the same time.\n\nWhether you\u2019re planning a large commercial mural, presenting a concept to a client, or working out placement before painting, MuralView2 helps bridge the gap between a digital design and the finished wall.\n\nPlan it. Place it. See it before you paint it.", "short_description": "Use this for the Short Description:\n\nVisualize your mural before you paint it. MuralView2 lets artists import artwork and place it directly on real-world walls in mixed reality. Scale, position, rotate, adjust opacity, and preview designs at true scale using Meta Quest. Shared Vision lets multiple headsets view the same mural placement together, making it easier to plan, present, and collaborate with clients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://middlevitalemurals.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Middle Vitale Murals LLC", "support_website_url": null, "website_url": "https://middlevitalemurals.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "1318696471332860"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1442219297287273"}, {"status": "PUBLISHED", "id": "2632137783883640"}]}, "baseline_offer": {"id": "2632137783883640"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1442219297287273"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1319975921204915", "version": "2.2"}, "id": "3613079635527364", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1319975921204915"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "MuralView2 puts your pictures on the real walls in the room: pick one in LIBRARY from headset photos or the website, PLACE it on a wall, floor, or ceiling and size it in real feet or inches, DRAW to move, enlarge, flip, and spin, and TRANSFORM to fold or curve the paper. Previous puts a saved print back on that wall. Shared Vision lets another Quest in the same room see the print where you locked it \u2014 host after you lock placement, they tap JOIN SESSION on the same Wi-Fi or hotspot, and each headset then has its own copy. Controllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1792324441, "id": "1336582702877570", "version": "2.2", "version_code": 168, "release_status": "PENDING", "status": "UNDER_REVIEW", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1319975921204915"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "What\u2019s new\r\n\r\nMuralView2 puts your pictures on the real walls in the room. Pick one in LIBRARY from headset photos or the website with a pairing code. PLACE grabs the print and shoots it onto a wall, floor, or ceiling, sizes it in real feet or inches, levels it, and fades it. DRAW moves, enlarges, flips, and spins. TRANSFORM folds, curves, corners, and warps the paper. Take the headset off and put it back on \u2014 Previous puts the print back on that wall.\r\n\r\nShared Vision lets another Quest in the same room see the print where you locked it. Host after you lock placement; they tap JOIN SESSION on the same Wi-Fi or hotspot. Once it is shared, each headset has its own copy to move. Hosted and joined pictures stay on the Shared Vision shelf.\r\n\r\nControllers only. English, Spanish, French, German, Portuguese, Italian, Japanese, Korean, and Chinese.", "created_date": 1792236025, "id": "1334896799712827", "version": "2.2", "version_code": 166, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1319975921204915"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "MuralView2 puts your pictures on the real walls in the room. Choose one from the headset library or the website, place it on a wall, floor, or ceiling, size it in real feet or inches, fold or curve it to the surface, and come back later \u2014 a locked placement is still on that wall. Shared Vision lets another headset on the same Wi-Fi join: they get their own copy of the print, line it up to the same spot, and can move, fade, or push it on their side without changing yours.", "created_date": 1792079304, "id": "1331825583353282", "version": "2.2", "version_code": 153, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1319975921204915"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3613079635527364"}]}, "change_log": "MuralView2 lets you see your artwork on your actual walls before you print it. Pick a piece from your library or send one from your phone or computer, point your controller at a wall, and the print lands there at true size, level, and locked in place so it stays put every time you come back. Walk around it, step back, change the lighting, swap pieces, and resize or reposition with a tap. Go beyond a flat print: fold, curve, and warp the artwork with up to five fold lines, flip it, spin it, and layer PSD files to compare versions on the same wall. With Shared Vision, a second headset in the room sees the exact same artwork in the exact same spot, so clients, partners, or family can look at the wall together and decide in real time. Built for Quest 3 passthrough, MuralView2 turns \"I think it will look good there\" into \"I can see it there.\"", "created_date": 1791935244, "id": "1328917140310793", "version": "2.2", "version_code": 126, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1319975921204915"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791931007, "id": "1328848733650967", "version": "2.2", "version_code": 121, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
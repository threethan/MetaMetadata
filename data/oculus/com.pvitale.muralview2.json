{"data": {"node": {"__typename": "Application", "id": "1310337855502055", "organization": {"id": "1310302458838928", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1310337855502055"}]}, "id": "28373718468923560"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1310337855502055", "release_date": 1791449880, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 2}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1415295161672990"}, "id": "3613079635527364"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310337855502055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1415295161672990"}, "release_status": "RELEASED"}, "id": "1415295161672990", "version": "2.2", "version_code": 404, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1795533199, "id": "1415298271672679", "is_initial_release": false, "name_with_fallback": "v30", "pdp_metadata_with_fallback": {"version": 3, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1403953599473813"}, "release_status": "RELEASED", "id": "1310337855502055"}, "id": "1403953599473813", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": null, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299891_1115473434212229_3616753694242184658_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LVQtjpOlM4Q7kNvwH3-7xh&_nc_oc=AdpqYNtacTRiDyR8plAfp7c_lNizs2tY0KgqmTTy6e7usN-Kjq5cQJazKd1DAWCZ8tI
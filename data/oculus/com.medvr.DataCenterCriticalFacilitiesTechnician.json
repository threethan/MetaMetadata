enshot00012.png", "id": "1183801054705670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908839727_1183801058039003_2052056607189728374_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1anzXPD8E8Q7kNvwHTIp8v&_nc_oc=AdpdcEsngwEKOXMS1BFKF2IFEZi5qeoZAXpXgz30iiUQiAOemJKEYm9CV3ZaU_Vg2QM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT9g3aZCiEYJL_wMlNPP5NAN7c0EAce_h7s0NSl-0NwfQ&oe=6B0DB891"}, {"file_name": "HighresScreenshot00013.png", "id": "1685402339927725", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908839688_1685402346594391_2681177170787484774_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=td7ZWuvp2TEQ7kNvwHYAG9z&_nc_oc=AdrzQvyY9BH-1Qv4mGX4NLxQoDNlw7Oh5J7CimkbfT9PttbA9Z7CYL3yKWxS1R0dhuM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSh-ZiOtmCj5IZEpODTX4ui-ygELTo9cI931pIcxejK0Q&oe=6B0DB4A4"}, {"file_name": "HighresScreenshot00015.png", "id": "1529940349234289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908839737_1529940355900955_4690942754321688589_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9B2IyDT62kkQ7kNvwEjZPyo&_nc_oc=AdoQ-hgfbJkwL4d3IGr9t0PmXd9OX-rg8zFo2IoSdoAIz8C8LTVdQNZOxVHjPQRTvWY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSdb_DjPND8w5b_BtMEK8y9QXtrFGJXSIXL4EBaqy2iiQ&oe=6B0DCED3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Data Center Critical Facilities Tech", "keywords": [], "long_description": "Step into the world of data center operations with Data Center Critical Facilities Tech, an immersive Virtual Reality (VR) training application developed as part of the Immerse Learn Data Center Critical Facilities Tech Certification Program.\n\nThis application provides students with an interactive, hands-on learning experience in a virtual data center environment. It enables learners to explore critical facility concepts, experience practical training scenarios, and strengthen their understanding of data center infrastructure and operations through immersive simulation.\n\nIMPORTANT ACCESS INFORMATION: This application is exclusively available to students enrolled in the Immerse Learn Data Center Critical Facilities Tech Certification Program. Only enrolled students are authorized to access and use this application as part of their hands-on training. It is not intended for general public access or standalone use.", "short_description": "Data Center Critical Facilities Tech is an immersive VR training application designed exclusively for students enrolled in the Immerse Learn Data Center Critical Facilities Tech Certification Program. Experience hands-on, interactive training through realistic virtual environments that help reinforce practical knowledge and skills in data center critical facilities operations. Access is restricted to enrolled students."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1779665014160302"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1195746756451733"}]}, "baseli
jNpSq0CP0PIeNhMCxT2xUw&oe=6AF9B91D"}, {"file_name": "fba20eb8002fb4742d1755ff56383ec4.png", "id": "1702324881320922", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/673716021_1702324884654255_4247969836419539130_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWrviPpYsbQQ7kNvwFhrJkJ&_nc_oc=AdouzWTl8uCuWi7CsctQ0nKDuyMEo2RhU-VrcLmvHBdxVxrkQktPqKWYHdz53xt-lL8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4Yw9T7Pxizcwxbs-zOCCU_oi16EJ34R8cfgscTk9pQA&oe=6AF9D88A"}, {"file_name": "a8f61ae77481ef7b97a3c4907f96caa3.png", "id": "1661409095632160", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/595129854_1661409098965493_4642121694603843641_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNtFbKC9DxUQ7kNvwFLT-HP&_nc_oc=Adqy0ojC8Uk0Hph-qkV5azsz4DOzoDI--YWu8ph4aq1WOzTDOA-oXb3FKun2_3DjJog&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmPXOW_OwCkYHk2RZy6d2ilMg5jS-etCnkc7aOmwvmqw&oe=6AF9C1A9"}, {"file_name": "a891ba7abe59249bafe685605aae14e3.png", "id": "2029201817738303", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/596061819_2029201821071636_3934493197088905686_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3a-UmUuqFAoQ7kNvwHwfYUw&_nc_oc=AdquJZ4CveMTCLcsMR7JP19g9SNrzOVwinzqGu4X6L-s9S1yoz1TAPHA20r38HOm1aI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTLRtPw8xWj-M5hBmH_aTL_nItHNd7eP2pQb_xKpfDmw&oe=6AF9BF96"}, {"file_name": "aaa260ee6012c4c691984dbae27eb703_0.png", "id": "2441307470008035", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/595129854_2441307473341368_6028124356273242959_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpDp5atyZVIQ7kNvwGhdFPz&_nc_oc=AdqqWTsBAadOsvkoi6u3FA8W-bP2h0187lO5NC6dYwQbPV1XVZ7ilVODcnx5vPop3Bs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQPOpVbt62VLOcYGZmlhZFeTXepl_Rokm2MrUb3XesEg&oe=6AF9CE83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Waseej", "keywords": ["Hajj", "Kaaba", "Hijra", "Umrah", "History"], "long_description": "Waseej is the home of Ana Al Madinah VR's cinematic documentaries: immersive films about Islamic heritage, filmed in 8K and made for VR.\n\nNOW SHOWING\n\u2022 The Hajj series \u2014 follow each of the three ways of performing Hajj from beginning to end:\n \u2013 Mutamatti' (Hajj al-Tamattu')\n \u2013 Qarin (Hajj al-Qiran)\n \u2013 Mufrid (Hajj al-Ifrad)\n\nCOMING SOON\n\u2022 The Story of the Kaaba\n\u2022 Hijrat al-Rasul \u2014 the Prophet's (peace be upon him) migration to Madinah\n\nHOW VIEWING WORKS\nWaseej runs on points: 1 point = 1 viewing. Rewatch any film as often as you like; each playback uses one point.\n\nWHO IT'S FOR\n\u2022 Pilgrims preparing for Hajj who want to see the rites before performing them\n\u2022 Families, students and teachers\n\u2022 Anyone who longs to visit the holy sites\n\nA comfortable, seated-friendly experience.\n\nProduced in Madinah by Ana Al Madinah VR.", "short_description": "Stand where history happened. Waseej brings Islamic heritage to life in cinematic VR documentaries filmed in 8K by Ana Al Madinah VR. Walk through each way of performing Hajj, step by step, and explore the places that shaped Islamic history \u2014 from wherever you are."}, {"images": {"nodes": []}, "id": "1664406368670945", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Waseej", "keywords": ["Hajj", "Kaaba", "Hijra", "Omra"], "long_description": "Waseej r\u00e9unit les documentaires cin\u00e9matographiques d'Ana Al Madinah VR : des films immersifs consacr\u00e9s au patrimoine islamique, tourn\u00e9s en 8K et con\u00e7us pour la r\u00e9alit\u00e9 virtuelle.\n\n\u00c0 L'AFFICHE\n- La s\u00e9rie Hajj \u2014 suivez du d\u00e9but \u00e0 la fin chacune des trois mani\u00e8res d'accomplir le Hajj :\n \u2013 Mutamatti' (Hajj at-Tamattu')\n \u2013 Qarin (Hajj al-Qiran)\n \u2013 Mufrid (Hajj al-Ifrad)\n\nBIENT\u00d4T\n- L'histoire de la Kaaba\n- Hijrat al-Rasul \u2014 l'\u00e9migration du Proph\u00e8te (paix et b\u00e9n\u00e9dictions sur lui) vers M\u00e9dine\n\nCOMMENT \u00c7A MARCHE\nWaseej fonctionne avec des points : 1 point = 1 visionnage. Revoyez chaque film autant de fois que vous le souhaitez ; chaque lecture utilise un point.\n\nPOUR QUI ?\n- Les p\u00e8lerins qui se pr\u00e9parent au Hajj et veulent voir les rites avant de les accomplir\n- Les familles, les \u00e9l\u00e8ves et les enseignants\n- Tous ceux qui aspirent \u00e0 visiter les Lieux saints\n\nUne exp\u00e9rience confortable, id\u00e9ale en position assise.\n\nProduit \u00e0 M\u00e9dine par Ana Al Madinah VR.", "short_description": "Tenez-vous l\u00e0 o\u00f9 l'histoire s'est \u00e9crite. Waseej fait revivre le patrimoine islamique \u00e0 travers des documentaires cin\u00e9matographiques en r\u00e9alit\u00e9 virtuelle, film\u00e9s en 8K par Ana Al Madinah VR. Vivez pas \u00e0 pas chacune des mani\u00e8res d'accomplir le Hajj et explorez les lieux qui ont fa\u00e7onn\u00e9 l'histoire de l'islam \u2014 o\u00f9 que vous soyez."}]}, "developer_name": null, "developer_privacy_policy_url": "https://waseej.com/privacy-policy.html", "developer_terms_of_service_url": "https://waseej.com/privacy.html", "publisher_name": "Ana Al Madinah VR", "support_website_url": "https://waseej.com/contact.html", "website_url": "https://waseej.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "bn", "zh_CN", "nl", "fr", "de", "hi", "id", "ja", "ckb", "ms", "fa", "ru", "s
_nc_sid=6e7a0a&_nc_ohc=sCf9xy_Wv9UQ7kNvwF4YVRr&_nc_oc=Adq47gUetXZI1aMEFbp_ILKMDlbUjBKNzpXhZKhGSTGW-bXT9sslmRiN0s_QE4yk09c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPwxK_x4-OZRnjA8UrW1kdjNpSq0CP0PIeNhMCxT2xUw&oe=6AF9B91D"}, {"file_name": "fba20eb8002fb4742d1755ff56383ec4.png", "id": "1702324881320922", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/673716021_1702324884654255_4247969836419539130_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWrviPpYsbQQ7kNvwFhrJkJ&_nc_oc=AdouzWTl8uCuWi7CsctQ0nKDuyMEo2RhU-VrcLmvHBdxVxrkQktPqKWYHdz53xt-lL8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4Yw9T7Pxizcwxbs-zOCCU_oi16EJ34R8cfgscTk9pQA&oe=6AF9D88A"}, {"file_name": "a8f61ae77481ef7b97a3c4907f96caa3.png", "id": "1661409095632160", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/595129854_1661409098965493_4642121694603843641_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNtFbKC9DxUQ7kNvwFLT-HP&_nc_oc=Adqy0ojC8Uk0Hph-qkV5azsz4DOzoDI--YWu8ph4aq1WOzTDOA-oXb3FKun2_3DjJog&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmPXOW_OwCkYHk2RZy6d2ilMg5jS-etCnkc7aOmwvmqw&oe=6AF9C1A9"}, {"file_name": "a891ba7abe59249bafe685605aae14e3.png", "id": "2029201817738303", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/596061819_2029201821071636_3934493197088905686_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3a-UmUuqFAoQ7kNvwHwfYUw&_nc_oc=AdquJZ4CveMTCLcsMR7JP19g9SNrzOVwinzqGu4X6L-s9S1yoz1TAPHA20r38HOm1aI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTLRtPw8xWj-M5hBmH_aTL_nItHNd7eP2pQb_xKpfDmw&oe=6AF9BF96"}, {"file_name": "aaa260ee6012c4c691984dbae27eb703_0.png", "id": "2441307470008035", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/595129854_2441307473341368_6028124356273242959_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpDp5atyZVIQ7kNvwGhdFPz&_nc_oc=AdqqWTsBAadOsvkoi6u3FA8W-bP2h0187lO5NC6dYwQbPV1XVZ7ilVODcnx5vPop3Bs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQPOpVbt62VLOcYGZmlhZFeTXepl_Rokm2MrUb3XesEg&oe=6AF9CE83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Waseej", "keywords": ["Hajj", "Kaaba", "Hijra", "Umrah", "History"], "long_description": "Waseej is the home of Ana Al Madinah VR's cinematic documentaries: immersive films about Islamic heritage, filmed in 8K and made for VR.\n\nNOW SHOWING\n\u2022 The Hajj series \u2014 follow each of the three ways of performing Hajj from beginning to end:\n \u2013 Mutamatti' (Hajj al-Tamattu')\n \u2013 Qarin (Hajj al-Qiran)\n \u2013 Mufrid (Hajj al-Ifrad)\n\nCOMING SOON\n\u2022 The Story of the Kaaba\n\u2022 Hijrat al-Rasul \u2014 the Prophet's (peace be upon him) migration to Madinah\n\nHOW VIEWING WORKS\nWaseej runs on points: 1 point = 1 viewing. Rewatch any film as often as you like; each playback uses one point.\n\nWHO IT'S FOR\n\u2022 Pilgrims preparing for Hajj who want to see the rites before performing them\n\u2022 Families, students and teachers\n\u2022 Anyone who longs to visit the holy sites\n\nA comfortable, seated-friendly experience.\n\nProduced in Madinah by Ana Al Madinah VR.", "short_description": "Stand where history happened. Waseej brings Islamic heritage to life in cinematic VR documentaries filmed in 8K by Ana Al Madinah VR. Walk through each way of performing Hajj, step by step, and explore the places that shaped Islamic history \u2014 from wherever you are."}, {"images": {"nodes": []}, "id": "1664406368670945", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Waseej", "keywords": ["Hajj", "Kaaba", "Hijra", "Omra"], "long_description": "Waseej r\u00e9unit les documentaires cin\u00e9matographiques d'Ana Al Madinah VR : des films immersifs consacr\u00e9s au patrimoine islamique, tourn\u00e9s en 8K et con\u00e7us pour la r\u00e9alit\u00e9 virtuelle.\n\n\u00c0 L'AFFICHE\n- La s\u00e9rie Hajj \u2014 suivez du d\u00e9but \u00e0 la fin chacune des trois mani\u00e8res d'accomplir le Hajj :\n \u2013 Mutamatti' (Hajj at-Tamattu')\n \u2013 Qarin (Hajj al-Qiran)\n \u2013 Mufrid (Hajj al-Ifrad)\n\nBIENT\u00d4T\n- L'histoire de la Kaaba\n- Hijrat al-Rasul \u2014 l'\u00e9migration du Proph\u00e8te (paix et b\u00e9n\u00e9dictions sur lui) vers M\u00e9dine\n\nCOMMENT \u00c7A MARCHE\nWaseej fonctionne avec des points : 1 point = 1 visionnage. Revoyez chaque film autant de fois que vous le souhaitez ; chaque lecture utilise un point.\n\nPOUR QUI ?\n- Les p\u00e8lerins qui se pr\u00e9parent au Hajj et veulent voir les rites avant de les accomplir\n- Les familles, les \u00e9l\u00e8ves et les enseignants\n- Tous ceux qui aspirent \u00e0 visiter les Lieux saints\n\nUne exp\u00e9rience confortable, id\u00e9ale en position assise.\n\nProduit \u00e0 M\u00e9dine par Ana Al Madinah VR.", "short_description": "Tenez-vous l\u00e0 o\u00f9 l'histoire s'est \u00e9crite. Waseej fait revivre le patrimoine islamique \u00e0 travers des documentaires cin\u00e9matographiques en r\u00e9alit\u00e9 virtuelle, film\u00e9s en 8K par Ana Al Madinah VR. Vivez pas \u00e0 pas chacune des mani\u00e8res d'accomplir le Hajj et explorez les lieux qui ont fa\u00e7onn\u00e9 l'histoire de l'islam \u2014 o\u00f9 que vous soyez."}]}, "developer_name": null, "developer_privacy_policy_url": "https://waseej.com/privacy-policy.html", "developer_terms_of_service_url": "https://waseej.com/privacy.html", "publisher_name": "Ana Al Madinah VR", "support_website_url": "https://waseej.com/contact.html", "website_url": "https://waseej.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "bn", "zh_CN", "nl", "fr", "de", "hi", "id", "ja", "ckb", "ms", "fa", "ru", "so", "es", "tr", "ur", "uz"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1447544378434984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830822_28020556494285308_5758170467907789386_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0N6Mu3sREqUQ7kNvwHxcGJu&_nc_oc=AdqXfmQUDfodVOfBdr3OYvz1G4j56SksVx9U_plUkxplVlKo9G3KO7Yh0v92XPmOD8w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMzqUjyUHDHW99Hg0RV-ao2oIINZK8gEbd_OAWhE6MOg&oe=6AF9CB6A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Waseej", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1793908080, "lastRevision": {"nodes": [{"id": "1428799933642762", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1428799920309430", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2144898113568831"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1818091489318567", "locale": "tr_TR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Waseej", "keywords": ["Hac", "Kabe", "Hicret", "Umre", "Tarih"], "long_description": "Waseej, Ana Al Madinah VR'\u0131n sinematik belgesellerini bir araya getirir: \u0130slam miras\u0131n\u0131 konu alan, 8K \u00e7\u00f6z\u00fcn\u00fcrl\u00fckte \u00e7ekilmi\u015f ve sanal ger\u00e7eklik i\u00e7in haz\u0131rlanm\u0131\u015f s\u00fcr\u00fckleyici filmler.\n\n\u015eU AN G\u00d6STER\u0130MDE\n- Hac serisi \u2014 hacc\u0131n \u00fc\u00e7 eda \u015feklinin her birini ba\u015ftan sona takip edin:\n \u2013 Temettu hacc\u0131 (Mutamatti')\n \u2013 K\u0131ran hacc\u0131 (Qarin)\n \u2013 \u0130frad hacc\u0131 (Mufrid)\n\nYAKINDA\n- K\u00e2be'nin Hik\u00e2yesi\n- Hicret\u00fc'r-Res\u00fbl \u2014 Peygamber Efendimiz'in (s.a.v.) Medine'ye hicreti\n\n\u0130ZLEME NASIL \u0130\u015eLER\nWaseej puan sistemiyle \u00e7al\u0131\u015f\u0131r: 1 puan = 1 izleme. Diledi\u011finiz filmi istedi\u011finiz kadar tekrar izleyebilirsiniz; her oynatma bir puan kullan\u0131r.\n\nK\u0130MLER \u0130\u00c7\u0130N\n- Hacca haz\u0131rlanan ve menasiki yerine getirmeden \u00f6nce g\u00f6rmek isteyen hac\u0131 adaylar\u0131\n- Aileler, \u00f6\u011frenciler ve \u00f6\u011fretmenler\n- Kutsal mek\u00e2nlar\u0131 ziyaret etmeyi \u00f6zleyen herkes\n\nOturarak rahat\u00e7a izlenebilen konforlu bir deneyim.\n\nMedine'de Ana Al Madinah VR taraf\u0131ndan \u00fcretilmi\u015ftir.", "short_description": "Tarihin ya\u015fand\u0131\u011f\u0131 yerde durun. Waseej, Ana Al Madinah VR'\u0131n 8K \u00e7\u00f6z\u00fcn\u00fcrl\u00fckte \u00e7ekti\u011fi sinematik sanal ger\u00e7eklik belgeselleriyle \u0130slam miras\u0131n\u0131 hayata ge\u00e7iriyor. Hacc\u0131n her bir eda \u015feklini ad\u0131m ad\u0131m ya\u015fay\u0131n ve \u0130slam tarihine y\u00f6n veren mek\u00e2nlar\u0131 ke\u015ffedin \u2014 nerede olursan\u0131z olun."}, {"images": {"nodes": [{"file_name": "cover_square.png", "id": "28020556477618643", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830822_28020556494285308_5758170467907789386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0N6Mu3sREqUQ7kNvwHxcGJu&_nc_oc=AdqXfmQUDfo
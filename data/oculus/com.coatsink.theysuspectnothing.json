=00_AQE_aImthBeTpBsX9Qu03cIFTkv_4AjMj4epcpBbh8qF7w&oe=6A85A1B7"}, {"file_name": "migrated_image.png", "id": "549099702387821", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162732_564399290595202_3131988433979834368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PNz0fH5CeIQ7kNvwEnDc2n&_nc_oc=AdqtG2TX92_lXqSuAHVCpqIny00diHxp15Xwo8KErz78_sEUeMHoARtpxrNLP5GyXJ0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlZG1ExsSO7x_DPI9HSdm_5MzIIggqJLgpvNoicf6_fQ&oe=6A8588A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSN_StoreAsset_Landscape.png", "id": "178078686334142", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12410407_178078689667475_5298162319363145728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=if0QEOCP2AEQ7kNvwGqduY-&_nc_oc=AdoKeHA3111g9QWwQfdh9wqWcOsqLkqgSZOFmTT1Y_Y_Bv3avACczT3z4kc-h7F4Jv4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtOTY8QX8QA9U0OEehD6N8vA5hqBCmE9axDSxgciRISQ&oe=6A8584F6"}, "display_name": "They Suspect Nothing", "keywords": ["Minigame", "Casual", "Narrative", "Coatsink", "Futurama"], "long_description": "From the creators of Esper, A Night Sky, and Augmented Empire comes a comedy mini-game collection about robots and deception. \n\nAs the last human on earth, you must infiltrate a robot-only society by completing a series of bizarre human detection tests. Assuage suspicion with machine-like efficiency as you conduct open part surgery, pilot a drone, manage rush hour in an explosives plant, instigate Armageddon in a cataclysm simulator, plus eight other irreverent and humorous experiences.  \n\nMeanwhile, your progress will be tracked by Axel, Nerezza and The Operator, the three instructors charged with tending each department and deciding your fate. Relax... They suspect nothing. \n\nFEATURES\n\u2022\t12 hilarious mini-games with multiple difficulties\n\u2022\t3 unique hubs and instructors\n\u2022\tA customizable robot avatar and local leaderboards\n\u2022\tA full voice cast featuring Jim Broadbent\n\u2022\tComfortable \u2018pass and play\u2019 gameplay", "short_description": "Greetings, robot. Welcome to the mechanical utopia of Arcadia. Before entering our city, please report for human screaming. \n\nApologies, I mean\u2026 Human screening. \n\nTwelve unique and diverting assessments await. Guided by our trained instructors, your dexterity, perception and logic will be put to the test to \u2018prove you\u2019re metal\u2019 and confirm there\u2019s nothing suspicious hiding inside that cool, robot exterior\u2026\n\nRelax, it\u2019s all routine. We don\u2019t suspect a thing."}]}, "developer_name": "Coatsink", "developer_privacy_policy_url": "http://coatsink.com/privacy-policy/", "developer_terms_of_service_url": "http://coatsink.com/terms/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://coatsink.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "206934948254917"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "2229745727345702"}, {"status": "PUBLISHED", "id": "388166635067189"}, {"status": "PUBLISHED", "id": "2536335999925079"}, {"status": "PUBLISHED", "id": "641793206164712"}, {"status": "PUBLISHED", "id": "483371842182926"}, {"status": "PUBLISHED", "id": "724136888102943"}, {"status": "PUBLISHED", "id": "436046536875513"}, {"status": "PUBLISHED", "id": "923960047950410"}, {"status": "PUBLISHED", "i
c=AdpYIbudzHTTdGg2nZJAdZX5aJqtQnR47Hftr07q6lox5manAiczZLwqePIzMhCb1ys&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRajAdBBtd_TGU2B8Z8WK9w-EbXrXzBtL6LlsdA1s5ANQ&oe=6B09BD70"}, {"file_name": "migrated_image.png", "id": "591878724741012", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138782_273103189890386_8041620843446403072_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0ElNXbuqisQ7kNvwEx9i8T&_nc_oc=AdpIzlHRTr3HLMtoIubzMD-9jRXCmIaHqBoEEABoNGuCjrnFXWYaT7Bc2JALI2igj9Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ8PvNrs4lPlyKiIIBuUUGL1ek9LEQBYYx_w_zhr_gLw&oe=6B09AFF7"}, {"file_name": "migrated_image.png", "id": "549099702387821", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162732_564399290595202_3131988433979834368_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5nxBAyvvNkQ7kNvwHvyul5&_nc_oc=AdrFBgvPDlV5GKnFY-0EKBN9eC9GdluXA6JICy4hmzdx9QqGk31UZVGAL2pLNysOSC8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeD2VmG1jF9VRYSSGQ1wsWNBnRfhtaEgtTLJZRPgSEPA&oe=6B09CF23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSN_StoreAsset_Landscape.png", "id": "178078686334142", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410407_178078689667475_5298162319363145728_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jPVqXRQlIAQ7kNvwHl6mB5&_nc_oc=AdokHjilw7UmJfEdPJRE2K2_m7TSJ_ErIQMsFHaHt9yR7OlTZaYHTuxEuTjNukJPLlE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3NeyqcuiTZbMko4PHIbmBOuNqNh4sUBhHUXI5OfcE4A&oe=6B09CB76"}, "display_name": "They Suspect Nothing", "keywords": ["Minigame", "Casual", "Narrative", "Coatsink", "Futurama"], "long_description": "From the creators of Esper, A Night Sky, and Augmented Empire comes a comedy mini-game collection about robots and deception. \n\nAs the last human on earth, you must infiltrate a robot-only society by completing a series of bizarre human detection tests. Assuage suspicion with machine-like efficiency as you conduct open part surgery, pilot a drone, manage rush hour in an explosives plant, instigate Armageddon in a cataclysm simulator, plus eight other irreverent and humorous experiences.  \n\nMeanwhile, your progress will be tracked by Axel, Nerezza and The Operator, the three instructors charged with tending each department and deciding your fate. Relax... They suspect nothing. \n\nFEATURES\n\u2022\t12 hilarious mini-games with multiple difficulties\n\u2022\t3 unique hubs and instructors\n\u2022\tA customizable robot avatar and local leaderboards\n\u2022\tA full voice cast featuring Jim Broadbent\n\u2022\tComfortable \u2018pass and play\u2019 gameplay", "short_description": "Greetings, robot. Welcome to the mechanical utopia of Arcadia. Before entering our city, please report for human screaming. \n\nApologies, I mean\u2026 Human screening. \n\nTwelve unique and diverting assessments await. Guided by our trained instructors, your dexterity, perception and logic will be put to the test to \u2018prove you\u2019re metal\u2019 and confirm there\u2019s nothing suspicious hiding inside that cool, robot exterior\u2026\n\nRelax, it\u2019s all routine. We don\u2019t suspect a thing."}]}, "developer_name": "Coatsink", "developer_privacy_policy_url": "http://coatsink.com/privacy-policy/", "developer_terms_of_service_url": "http://coatsink.com/terms/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://coatsink.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_
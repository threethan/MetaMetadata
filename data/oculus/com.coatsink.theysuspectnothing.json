4276145152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DAPYCtwhjYQ7kNvwGzysIV&_nc_oc=AdoFQCXOFdcGOSVJzqZN88GHIY_25xhC2F8mqSZGdf11MvBLl8aKtpWPCODpddEnZlM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_hL_URImJ79UfsFmSd5sDA09G5rGAfZJqcdQdkuDaRQ&oe=6A9994FE"}, {"file_name": "migrated_image.png", "id": "602405233951056", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138960_2605987626293341_9212644595823804416_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Wopn8Y4spcQ7kNvwF-C21H&_nc_oc=Adrk8aI4RR-RzkNHUDTAUrOkKQ0Z6xViPC5c01N9SRpPQmNISz-HKfOPUbODlJzB4Y8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOiMt14bPy6dzeZ3qAJH7sBu6NgPBkkJ_ovbtcmY3AVg&oe=6A998D81"}, {"file_name": "migrated_image.png", "id": "218928902639345", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138782_273103189890386_8041620843446403072_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uYZa6CDrcQQ7kNvwElHHsL&_nc_oc=AdqMKnmwDWVqasR37geVItMjjkdvc6xMkdSOEsDEzU5CLXdjjoO1gRMe4mUaG6mgwm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKBW3oVvaHcZ3txyDe72xV1290mWAYX1Q_6QiYQHNb7A&oe=6A99A077"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "They Suspect Nothing", "keywords": ["Minigame", "Casual", "Narrative", "Coatsink", "Futurama"], "long_description": "From the creators of Esper, A Night Sky, and Augmented Empire comes a comedy mini-game collection about robots and deception. \n\nAs the last human on earth, you must infiltrate a robot-only society by completing a series of bizarre human detection tests. Now including the free 'Overclocked' DLC - assuage suspicion with machine-like efficiency as you conduct open part surgery, pilot a drone, manage rush hour in an explosives plant, instigate Armageddon in a cataclysm simulator, plus sixteen other irreverent and humorous experiences.  \n\nMeanwhile, your progress will be tracked by five unique instructors charged with tending each department and deciding your fate. Relax... They suspect nothing. \n\nFEATURES\n\n\u2022\t20 hilarious mini-games with multiple difficulties\n\u2022\t5 unique hubs and instructors\n\u2022\tA customizable robot avatar and local leaderboards\n\u2022\tA full voice cast featuring Jim Broadbent\n\u2022\tComfortable \u2018pass and play\u2019 gameplay", "short_description": "Greetings, robot. Welcome to the mechanical utopia of Arcadia. Before entering our city, please report for human screaming... Apologies, I mean\u2026 Human screening. \n\nNow including the free 'Overclocked' DLC - They Suspect Nothing houses twenty unique and diverting assessments await. Guided by our trained instructors, your dexterity, perception and logic will be put to the test to \u2018prove you\u2019re metal\u2019 and confirm there\u2019s nothing suspicious hiding inside that cool, robot exterior\u2026"}]}, "developer_name": "Coatsink", "developer_privacy_policy_url": "http://coatsink.com/privacy-policy/", "developer_terms_of_service_url": "http://coatsink.com/terms/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://coatsink.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "364324108416877"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680318_261792634426242_6008436376956043264_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3heVY2
eful visuals, our app provides a personalized journey towards inner balance and mental well-being. Embrace a moment of calm amidst the chaos of everyday life and discover the transformative power of mindfulness with our meditation app.", "short_description": "Find peace and tranquility with our meditation app. Access guided meditations, soothing sounds, and mindfulness exercises for daily relaxation and stress relief. Customize your experience for inner balance and mental well-being."}]}, "developer_name": "Shenzhen XVerse Information Technology Co., Ltd.", "developer_privacy_policy_url": "https://appasset.xverse.cn/privacy/MindTrip/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "\u53d1\u5e03", "support_website_url": null, "website_url": "http://www.xverse.cn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7968803626481125"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "776208754407621"}]}, "baseline_offer": {"id": "776208754407621"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710272760, "status": "PUBLISHED", "id": "776208754407621"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7980661415295346", "version": "1.0"}, "id": "397401513281937", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": f
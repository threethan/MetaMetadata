uysRP2cGRQluQT-ka0Jf00vNpw0m-KuawfYC9bZPw&oe=6AA2CAD6"}, {"file_name": "5.png", "id": "575523858917264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303998_575523862250597_8891413376980694249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mA1iIfZT-n0Q7kNvwGXrlnM&_nc_oc=AdoW85BJgDXpJvNc2K2gjlnu8IinklopXd3nEgqPcCO23w9SGfREC0tRCSJCa1Xlijw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXb_7tZxrLLLfIXiLnMIBPOXNIIR6mINMeDhab71o2bQ&oe=6AA2C5CD"}, {"file_name": "1.png", "id": "1023484193281582", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499318402_1023484199948248_1799751977995638167_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kzj4DBKrkw0Q7kNvwFCBq3E&_nc_oc=AdoYT-yUOdXXj6-V03k1SkPa7zXaoq3RoVJsCbjHimvsM12_l6drhUidqHMfThRe4Ug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGIvLXqqlfOF851Hi80jJj2NkH72wNLha7s0hDGFRQog&oe=6AA29EDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Name Less Evil - Horror Shooting Game", "keywords": [], "long_description": "Dare to name the fear that cannot be named.\n\nName Less Evil is a psychological VR horror experience that traps you in a decaying, cursed world where nothing is what it seems and everything wants you dead.\n\nAwaken in an abandoned estate plagued by a dark presence. Guided only by cryptic clues and fleeting visions, you must explore sinister environments, solve disturbing puzzles, and confront unspeakable horrors that react to your every move. The evil you face has no name, no face\u2014only hunger.\n\nWith fully immersive, atmospheric VR design, 3D spatial audio, and fear-driven gameplay mechanics, Name Less Evil pulls you into a story of dread, loss, and ancient evil. But be warned: the longer you stay, the more it sees you.", "short_description": "Uncover a nameless terror lurking in the shadows. Face your fears, solve chilling mysteries, and survive the unspeakable in this immersive VR horror experience."}]}, "dev
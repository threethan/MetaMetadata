dn.com&_nc_ss=8&oh=00_AfsLCZGNHEVJNRctBhhUgkaCpZ4zKbPXm5df4UJERB8Low&oe=69A826C1"}, {"file_name": "2.png", "id": "699372526382056", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307403_699372533048722_6870669281375842979_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7v67x6npqoQ7kNvwEifjh9&_nc_oc=AdmXw2F_y9J8lxoyen2Hgwg5ws9W68Hvpa1WPpziSddSF354AcM86q899DmQ4ovbdE4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvflog5on2wuKJBe8DI_JE6dr-NVLdsirHCrioWqVsQuw&oe=69A81596"}, {"file_name": "5.png", "id": "575523858917264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303998_575523862250597_8891413376980694249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKIScCBIiKIQ7kNvwGY_A8y&_nc_oc=AdmszRPPriOl4HwGF2qen6NxKqysERGBcyZ8RAKf0wGvHgaoLyOQYE9qEPVJwT71vcQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu7pG1DmmzJwO8VIhvYOw5VW9QeYuUX5YyyxOUfN4Nymg&oe=69A8108D"}, {"file_name": "1.png", "id": "1023484193281582", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499318402_1023484199948248_1799751977995638167_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rsFhXONSKIQ7kNvwGN9T30&_nc_oc=AdnooTBCyc8-GmghQDLi_DNzBQFz0cHnpXLaw8vsRbM17sIEsWwDEbH-cu5zShHWRk4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuguMcDrcTwn32XXk5MnKEBMojsLOG0MbY3KAfKRtf6eA&oe=69A821DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Name Less Evil - Horror Shooting Game", "keywords": [], "long_description": "Dare to name the fear that cannot be named.\n\nName Less Evil is a psychological VR horror experience that traps you in a decaying, cursed world where nothing is what it seems and everything wants you dead.\n\nAwaken in an abandoned estate plagued by a dark presence. Guided only by cryptic clues and fleeting visions, you must explore sinister environments, solve disturbing puzzles, and confront unspeakable horrors that react to your every move. The evil you face has no name, no face\u2014only hunger.\n\nWith fully immersive, atmospheric VR design, 3D spatial audio, and fear-driven gameplay mechanics, Name Less Evil pulls you into a story of dread, loss, and ancient evil. But be warned: the longer you stay, the more it sees you.", "short_description": "Uncover a nameless terror lurking in the shadows. Face your fears, solve chilling mysteries, and survive the unspeakable in this immersive VR horror experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23945860625026395"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303370_1001121458717169_8658856805123659683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmUZJnAAqdAQ7kNvwERBMws&_nc_oc=Admh-pNBELIUrg4xvi7HEOAlL5V85clXztbTDXEdcme4nyFul6HO1gWvhgyAV-Zu8i8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftk-5iNLYgBNAmFOwO2QDpPjnuote3LNnKTwTQk5txWMQ&oe=69A82D6B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Name Less Evil - Horror Shooting Game", "platform": "ANDROID_6
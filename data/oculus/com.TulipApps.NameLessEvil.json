a&_nc_ohc=DXO6W-moVnEQ7kNvwG0SHIM&_nc_oc=AdoWbfNKLVByUGtOsYK3yS7CkmHsgwVGb_GbF8Z2RWk29oozrU1ga7qMOpzS2-BK-qY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6uG6xiLZ4w_WlAyCDVcRZ4AOmkkGcgETWuhnQT-b9RQ&oe=6A297BCD"}, {"file_name": "1.png", "id": "1023484193281582", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499318402_1023484199948248_1799751977995638167_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYNFz8lyYyUQ7kNvwHRfTxb&_nc_oc=AdrG5AaSdZbiSBaXGH_ZkpoDqxOaumZYOmWeiRJeZBBVCQu21fH0N6cab89v7zNy5Ko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bsRHv5UGszndKk5rGqYPuuV8rKpyyf78RZ11bZfwJmg&oe=6A2954DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Name Less Evil - Horror Shooting Game", "keywords": [], "long_description": "Dare to name the fear that cannot be named.\n\nName Less Evil is a psychological VR horror experience that traps you in a decaying, cursed world where nothing is what it seems and everything wants you dead.\n\nAwaken in an abandoned estate plagued by a dark presence. Guided only by cryptic clues and fleeting visions, you must explore sinister environments, solve disturbing puzzles, and confront unspeakable horrors that react to your every move. The evil you face has no name, no face\u2014only hunger.\n\nWith fully immersive, atmospheric VR design, 3D spatial audio, and fear-driven gameplay mechanics, Name Less Evil pulls you into a story of dread, loss, and ancient evil. But be warned: the longer you stay, the more it sees you.", "short_description": "Uncover a nameless terror lurking in the shadows. Face your fears, solve chilling mysteries, and survive the unspeakable in this immersive VR horror experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "ca
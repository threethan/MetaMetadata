.5771-25/473392165_1184735313303613_5853053573045283157_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PYjdIzicCoQ7kNvwEDv4AC&_nc_oc=AdmpCSXEchnwwGmDsGvBFPKWBn9ai7BdUmCEunsT9bNfp_ewYGNBKQuYzy24c-GKYKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvxEMxsWjL1VPrKjZaja2BDWQAzZoeFW9k1t99jx4b63Q&oe=69A05131"}, {"file_name": "QuantanoID_Store\u30b9\u30af\u30b7\u30e704.png", "id": "1375603643612209", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393977_1375603646945542_4485339286005076241_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AnM7qK9DvEQ7kNvwF9rwdc&_nc_oc=AdlndvvjkeTiXF0QTwk4Esoei3ROn5IM-ta0gjDg2Pu43Na9WD9_IHktTx8xmvjyRg8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs8U-_ZFQtyy6BnGpCnaWZHd9QLlXqjoExnmryqWf_yvA&oe=69A057FE"}, {"file_name": "QuantanoID_Store\u30b9\u30af\u30b7\u30e703.png", "id": "1303539050869824", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391969_1303539054203157_4666521463106122914_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMZcfhGckckQ7kNvwGaab_z&_nc_oc=AdlybsHrfhCVcwsPYog8Y5gsWfKOu4t30K1R1tgAxwfURtjRvIkrCETC8htWQFFbKUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsamaTam2qEl6SPCe1A4O2yqJKQRttv56GnwH_bT6_CqA&oe=69A0284D"}, {"file_name": "QuantanoID_Store_\u30b9\u30af\u30b7\u30e702_en.png", "id": "1113423774159860", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391946_1113423777493193_6300440267434639347_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mO6adKSjxUIQ7kNvwEXA-f-&_nc_oc=AdnOOBJO88q9QYDnMwoPM-UI2kgf_tTNHANiqzt9xmF22A_Eg1tTQRP-pvHmiydxgIM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvpPwvdPhVLMa6McdSxuyaDP4YCzw0F3L_JWtgB95mhGw&oe=69A04222"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03_StoreVideoThumbnail_2560x1440.png", "id": "1190215582809033", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391950_1190215586142366_792811306024787793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiaoswDpiksQ7kNvwFxj8oh&_nc_oc=AdkniVEk2myLY-YrQeUO9qdBGqaWMeB_vmfGGIuHD97S3Id15ACeaWfo4oqjbpNco3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvZT6h_IdY3XtSgVwKBfhMvHyU8svSKebxB9s8VW6w25w&oe=69A040B1"}, "display_name": "QuantanoID", "keywords": ["Robot", "Anime", "Mecha", "Combat", "mech"], "long_description": "QuantanoID is a VR robot game from Japan, created especially for you. Pilot your robot from a first-person perspective and experience deep immersion as if you've become the protagonist of an anime. With just the right level of difficulty and content, QuantanoID is designed to be enjoyed like a cinematic experience from beginning to end. We deliver the ultimate experience of becoming the hero of a robot anime yourself.\n\nThis is the story of a humanoid with self-awareness\u2014\"you\" (the player).\n\nThe story begins with \"you,\" a humanoid called \"Lunar,\" awakening in a lunar research facility called \"Serenaterra.\" It's the year 2042. The humanoid \"Lunar,\" who was not supposed to possess self-awareness, suddenly gains it. Neil McNeil, the CEO of ARQ, a tech company that developed both \"Lunar\" and \"Serenaterra,\" decides to dispose of \"Lunar\" after realizing its self-awareness. However, the lead developer of \"Lunar,\" Naoki Sakamoto, leads a group of \"Lunars\" in a successful takeover of \"Serenaterra.\" They seize a humanoid close-combat weapon called \"QuantanoID.\" As the player, you will pilot the \"QuantanoID\" and aim to destroy the \"Central Element,\" where research and development on \"Lunar\" continues, following Naoki Sakamoto's directives. But, the earth's massive army, led by Neil McNeil, along with new \"QuantanoIDs,\" stand in your way. Will you be able to use \"QuantanoID\" to protect the self-awareness and future of \"Lunar\"?", "short_description": "QuantanoID is a VR action game that makes your dream of fighting in a robot come true. The user becomes the protagonist of the story and gets into the cockpit to control the robot in first person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://quantanoid.com/privacypolicy", "developer_terms_of_service_url": "https://quantanoid.com/terms", "publisher_name": "Gugenka", "support_website_url": null, "website_url": "https://quantanoid.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29675788762034760"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393673_707255568512453_3154142660548097537_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghsq4H6qAmUQ7kNvwHhnnF8&_nc_oc=Adn4xa0459hfyDxv5TWHXT25F2QxFXNmYOItRUgmMSl1O-0427-9R65o3RzBGVD2NZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsay1cz3lC2Fos0Cpag-rr-WpOIBurVMjKv_o165sTAtQ&oe=69A03960"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "QuantanoID", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Narrative", "id": "1008279844328894"}], "release_date": 1745535600, "lastRevision": {"nodes": [{"id": "24051722311108128", "release_type": "SCHEDULED", "administr
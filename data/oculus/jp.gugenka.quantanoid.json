.5771-25/473392165_1184735313303613_5853053573045283157_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANDK7rVOqt8Q7kNvwFzI2Q0&_nc_oc=AdnixHbAR33LL5iot8poBsHpHJUOfmjRAkNXGv9ER-f2jbN4JnsHZtn2I310V6iGKCQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv_bnA7MvV72GxzK4R9uuIg9Lcgq6oaY3tMA6o6XhYvLA&oe=699C5CB1"}, {"file_name": "QuantanoID_Store\u30b9\u30af\u30b7\u30e704.png", "id": "1375603643612209", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393977_1375603646945542_4485339286005076241_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K75IVCIFFrsQ7kNvwGrdQNE&_nc_oc=AdnKMf8YC2VUadyL8IRhEZKYFlTaToh4ZrMvwOfzq6lLMMTvdnXkXTYuOgURA62gK8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuxcYAi8qTmGhfKQkqu8AmUDJMbVPfuAOQuJ_MigrSB4g&oe=699C637E"}, {"file_name": "QuantanoID_Store\u30b9\u30af\u30b7\u30e703.png", "id": "1303539050869824", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391969_1303539054203157_4666521463106122914_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XabIkGdQHNsQ7kNvwGS5L_K&_nc_oc=AdnVD-bbN9pYv6aNN26TJyNCI-rzgnztXIVtbFbhhmO1x4_-Mj1zSdUhvJAA3hVjHzs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsrd4TkbFEAPNipuAGlhIa9ol3VVqc45B1iCMpLBzWrPg&oe=699C33CD"}, {"file_name": "QuantanoID_Store_\u30b9\u30af\u30b7\u30e702_en.png", "id": "1113423774159860", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391946_1113423777493193_6300440267434639347_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAi_zvJN7EUQ7kNvwH64rdI&_nc_oc=AdlU0Tc8kXxXuZ1tFKeKJHXkrf9bRNdl4vt2CM7HMU7yrHNsAH2cEuZaXeYO9vgmec4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsuniEyHhw6p4sjjzyGNqIcyeDtGe74OLsnkMTyG3AMSA&oe=699C4DA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03_StoreVideoThumbnail_2560x1440.png", "id": "1190215582809033", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391950_1190215586142366_792811306024787793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WA32ilCLxhIQ7kNvwHTjUtA&_nc_oc=Adl06ehKRjS-4lRR3QQ-1xtl-hwXS3t8o2h-KEmDelAGOqo0LXIAhs_TgOoiDcBEeLM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvCGrRpEKac1EFPYfRx3_rCpwxWWEkG0S_fL6xmSOy_Sw&oe=699C4C31"}, "display_name": "QuantanoID", "keywords": ["Robot", "Anime", "Mecha", "Combat", "mech"], "long_description": "QuantanoID is a VR robot game from Japan, created especially for you. Pilot your robot from a first-person perspective and experience deep immersion as if you've become the protagonist of an anime. With just the right level of difficulty and content, QuantanoID is designed to be enjoyed like a cinematic experience from beginning to end. We deliver the ultimate experience of becoming the hero of a robot anime yourself.\n\nThis is the story of a humanoid with self-awareness\u2014\"you\" (the player).\n\nThe story begins with \"you,\" a humanoid called \"Lunar,\" awakening in a lunar research facility called \"Serenaterra.\" It's the year 2042. The humanoid \"Lunar,\" who was not supposed to possess self-awareness, suddenly gains it. Neil McNeil, the CEO of ARQ, a tech company that developed both \"Lunar\" and \"Serenaterra,\" decides to dispose of \"Lunar\" after realizing its self-awareness. However, the lead developer of \"Lunar,\" Naoki Sakamoto, leads a group of \"Lunars\" in a successful takeover of \"Serenaterra.\" They seize a humanoid close-combat weapon called \"QuantanoID.\" As the player, you will pilot the \"QuantanoID\" and aim to destroy the \"Central Element,\" where research and development on \"Lunar\" continues, following Naoki Sakamoto's directives. But, the earth's massive army, led by Neil McNeil, along with new \"QuantanoIDs,\" stand in your way. Will you be able to use \"QuantanoID\" to protect the self-awareness and future of \"Lunar\"?", "short_description": "QuantanoID is a VR action game that makes your dream of fighting in a robot come true. The user becomes the protagonist of the story and gets into the cockpit to control the robot in first person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://quantanoid.com/privacypolicy", "developer_terms_of_service_url": "https://quantanoid.com/terms", "publisher_name": "Gugenka", "support_website_url": null, "website_url": "https://quantanoid.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29675788762034760"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393673_707255568512453_3154142660548097537_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx-axBW-xaYQ7kNvwE0mlIJ&_nc_oc=AdnOJL31CBPZXN3JG-LIEnJKbRuK24vV9YLefU8UHl2zwKeCpN17VBYme_bp6EO8d-c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvkdwoiGZz_fI3QY-K7icg9bA0Q9AWNSCAX7zjQfkRQng&oe=699C44E0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "QuantanoID", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Narrative", "id": "1008279844328894"}], "release_date": 1745535600, "lastRevision": {"nodes": [{"id": "24051722311108128", "release_type": "SCHEDULED", "administr
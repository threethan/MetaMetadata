riNSbXHw&oe=6A0322A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03_StoreVideoThumbnail_2560x1440.png", "id": "1190215582809033", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391950_1190215586142366_792811306024787793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9hryap-lhAQ7kNvwFzok4a&_nc_oc=AdpwxOo61My0CdFGJKCAIfWZvaOH1u6X5C6RzKHY12YoPmh5XpSDZdnBWixKcpFhDpY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YcNdcIS36p0YpF_TcTGcVQVD2ZzZCkJvP19VyffrfYg&oe=6A032131"}, "display_name": "QuantanoID", "keywords": ["Robot", "Anime", "Mecha", "Combat", "mech"], "long_description": "QuantanoID is a VR robot game from Japan, created especially for you. Pilot your robot from a first-person perspective and experience deep immersion as if you've become the protagonist of an anime. With just the right level of difficulty and content, QuantanoID is designed to be enjoyed like a cinematic experience from beginning to end. We deliver the ultimate experience of becoming the hero of a robot anime yourself.\n\nThis is the story of a humanoid with self-awareness\u2014\"you\" (the player).\n\nThe story begins with \"you,\" a humanoid called \"Lunar,\" awakening in a lunar research facility called \"Serenaterra.\" It's the year 2042. The humanoid \"Lunar,\" who was not supposed to possess self-awareness, suddenly gains it. Neil McNeil, the CEO of ARQ, a tech company that developed both \"Lunar\" and \"Serenaterra,\" decides to dispose of \"Lunar\" after realizing its self-awareness. However, the lead developer of \"Lunar,\" Naoki Sakamoto, leads a group of \"Lunars\" in a successful takeover of \"Serenaterra.\" They seize a humanoid close-combat weapon called \"QuantanoID.\" As the player, you will pilot the \"QuantanoID\" and aim to destroy the \"Central Element,\" where research and development on \"Lunar\" continues, following Naoki Sakamoto's directives. But, the earth's massive army, led by Neil McNeil, along with new \"QuantanoIDs,\" stand in your way. Will you be able to use \"QuantanoID\" to protect the self-awareness and future of \"Lunar\"?", "short_description": "QuantanoID is a VR action game that makes your dream of fighting in a robot come true. The user becomes the protagonist of the story and gets into the cockpit to control the robot in first person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://quantanoid.com/privacypolicy", "developer_terms_of_service_url": "https://quantanoid.com/terms", "publisher_name": "Gugenka", "support_website_url": null, "website_url": "https://quantanoid.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29675788762034760"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393673_707255568512453_3154142660548097537_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pcq0MPyj0fQQ7kNvwEoGWuc&_nc_oc=AdqEL0FPSZAz8riLfavAHDDMVnIOGgzgAK-O_wQbbZEz1Fud3VpPx6P1GTFlBpKoZGA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FD3kJNN-R98rc92ei7ZvzTLhLJAfqCus0T89TT6ngLA&oe=6A0319E0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "QuantanoID", "platform": "ANDROID_6DOF", "context_category": {"conte
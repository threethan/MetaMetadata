a-2iFMQ7kNvwFDKa5M&_nc_oc=AdrYbFpUhNPZLRXqmo6TUriaZ97sndcDX8TtCY7F3TryFInZvVS4TvA3hfYYos9LnXw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPt4n83DzxB5xIsVxGqvA6n1mRzruZwAKSuijFVhSRzqw&oe=6ACFB3A4"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGaLy1SelAgQ7kNvwF_T94Q&_nc_oc=AdrIZAYaIsYhzZlNFxI7o1GDNc8aKL_KFkj_oxkQxJs2tX8qd6nz8T05B-leOvt0fkU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD50subAuRDTwCf-pingr5lNq3m0aeBCkrjJXP6FJbcQ&oe=6ACFA5B5"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ii4mIBBX7DYQ7kNvwGv4-7O&_nc_oc=AdqVIC0-UFyo6RHK0_tWgW19ZgOx1-5j9KERjgDUyaAODgtg9GCDsRs0fDE2QVTssoM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_5tvYOm5A6vykdq5bA73PXi2HLhmVrIbLNKTCFcde5Q&oe=6ACF9E94"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzxVMgGEhSMQ7kNvwHs-cqy&_nc_oc=AdrPOJws02K5Rv8AZUGwI6SDATQRMHhXWRIU25Vr94oh0-dX4-Xl35xiE5dc64xsRNE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3YN3rf3lxPZ3Mv3EtBoJPQocydH5583PZmtf9jsR02A&oe=6ACFAF29"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0LrOrRFH-cQ7kNvwHYd9oe&_nc_oc=AdoH7UYMTa8Qeu3E_o79hP5KLlu9s_yTTC_w_2ZGuPeddpueq6jLgZrayPbULtfZNUY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJIGv5n7yc5woS0eRlnTIgYz0ELgEsJxWQMNhQ2LLhkw&oe=6ACF91CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
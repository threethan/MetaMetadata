iTbvEYQ7kNvwE9swTl&_nc_oc=Adp3Eh9Yn1FDTF7sEvgivDLhWqZMst04uF35qlWF7LBuaW29ZVLqX4s-T2LnohfEsi4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_8Gp74mtaO6DHVIG7cvaJ0PrTtltOGosQvqEbdQJBCw&oe=6AB128E4"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kax3jEWNHyoQ7kNvwGp_U9f&_nc_oc=AdrNm1c09WpKhReRoEIzCxCzGqKcn2r2Ftnk3BwjYhUsLQu-QwHfIu7Z3S0R-PkhorM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5zDAqFCyqI6KdjmqVDjku8w_7Nd8QS1le61DGPv863A&oe=6AB15335"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkNNqYoQ6oIQ7kNvwHOoZpQ&_nc_oc=AdolB5x9KZ2PSi5h7gRRGGrB8mxM2Rt_WQe4Q-FXhkIucdt7tAEv2RbH1GnyfT5gr2g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD-8PsiEU6wcYpBT1pslrBaqB4zzFVWhrddLIjRqh-tw&oe=6AB14C14"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZxDx304TU0Q7kNvwHTNhG-&_nc_oc=AdqU2oinjIEBeMv3mKCeOzfH1w7FUp2gJYtH4toGBohQ11Lozi3vyraijgFKCuDsCwk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfpsxMsg1D0ctDFbUzbcaRZoObiveN6KtqyArJ_FZBxQ&oe=6AB12469"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEysPnSvF8cQ7kNvwHd11bs&_nc_oc=AdoGwvybTElftz-uD-NLq7ejPWXWQif3VYVT01MyKl1LCve-V8fU6-XWST2RwBzXiQ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID_ozpP_gLwkrQ9BT8PEp6wJGaq-UN3Xa3ETwqtG3r_w&oe=6AB13F4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
_z2QCIQ7kNvwH7G82z&_nc_oc=AdrEYE6iOjwF_4IftKfNqjxA7ToR0FvPdPenrcYxgtoLAfyA2ATFAhIHd3pawBrCCro&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKNv7GpN0i-ytl-b1cJ4a-JrR-L6uP5eOBzgOCjeFOXQ&oe=6A660364"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0UjASix9fgQ7kNvwFeRp5v&_nc_oc=AdpNXlyxl-YgcIWscheQbTqpfp_5pnjCmD7btlVvJb4Tf7YmEvR35iuPsZS7U4P90eU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOlxYJfQ5IAF2JCiA-SFgd15N1USYhhkuJsyr4zUKBcQ&oe=6A65F575"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfMYCWBtYcEQ7kNvwF0xn6y&_nc_oc=AdpUhR63fQ-IOGg78n5MR-Ej9H_iGZRVCI74XMIk_BYwR0ZCoLF5aTRjYT1Xr6z4w9U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv5_52cWGo9oNzZ3m3NUrGFIvrzL28tJfaeyQFqVsQMw&oe=6A65EE54"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J54TWTPHb4gQ7kNvwH8HSJq&_nc_oc=AdphqsejBB3U9lc5--4EOzfZ70IY0z8DhQIQ5ST___VENVXioO-k-KMv0UAM-r5WLDM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4RNJJDkh-NXpggUAbnArOruzSLEubzjrmc6YAvu12-w&oe=6A65FEE9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9Q7hV5aOwQQ7kNvwGwU05H&_nc_oc=AdqLnOkL53rOB1L0CrhRBscpd0-Zrgb4W5dNjO7-IreZDyCKZ7eUPyPySWlIqzFMVK8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCL8g8NcZYW00N6WpjxVOqV6ztqJDKnb4iuWim25mWEA&oe=6A6619CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
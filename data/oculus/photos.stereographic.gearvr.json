Y1VHOUQ7kNvwH2xgQO&_nc_oc=Adotz97EEaCDSn1G-F681X8A4IYGrGhYBL7kSvCMBT-13_53LPo0OSRrK5pZGUaGLYw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWcCKhfelj5jui2an4dX3Y8vNKuY_o0JDiv-ugZdD84g&oe=6AB66EE4"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Gf463_2q1sQ7kNvwGnHg4_&_nc_oc=AdoMdjLDuoj7BHxFOSukNq5prsm9KDltaZBX8GIachEIaUu7is08j2HvE_uqNB3tM18&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE2-bd0xaPMu-hT9SiGCKqal1iOZPSc3NMqmpIw9SJAQ&oe=6AB69935"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZtONmHhPrYQ7kNvwHkTRBD&_nc_oc=Adr6Pc5HU2Muzozf_KNrcpBqDOwM2LKFhBzj5wow_XZR-YWfrJaRz_ZhOiCJzh-q3kI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrwa9ObinmfD0Bm34_ejGkiIjpWWTJgW4N54j5THP22A&oe=6AB69214"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ug6_KopdaIQ7kNvwF88pPu&_nc_oc=Adpioc-sJH_Hdl7jgaMeCGCPGOtaKfzKgRHTFYcpulk2A1hQ3mkm0n2ySXU0O3z50MU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWbgL7GYR0JTFXNLFqpSlsn7-yjZE2oflOB_kYTbxUFw&oe=6AB66A69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBwKsk4cou8Q7kNvwEF9nQI&_nc_oc=AdotX4NcrBBAaIEqfMjphIehBWog7v4S0Xr-ubz8P0wP0y8QSy5ePkyADaxjK4DIrCw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINGTyOTLjlAj3gkUwvpaN1G9oclw8VpGC64cKa0Ec-Jg&oe=6AB6854F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
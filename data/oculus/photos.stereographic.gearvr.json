a-2iFMQ7kNvwEDYazQ&_nc_oc=Adqm86cODy9VNM6leBepESLFnwhGoKt55IAdnGNZXAFH39nLtYFCs-gxHgTLb4ewXhI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwDxXIaFMx5LfZH5AHC-Lzg0tzJ9Owmr_g-EzJqyIprQ&oe=6AD10524"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Co2kMDWeMcYQ7kNvwETQnsu&_nc_oc=Ado0xo32DUTjVPbjmvHKKJTjPTEig_GmFWJYsbZ_3vzoK8vnb11qg1jjVwdXf9Gy0w8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO10vc_h-hcgHkbRg7v3DoTBW930IyEBbKzLrMiQQgSJA&oe=6AD0F735"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuYlXBN2DgIQ7kNvwGtkg4u&_nc_oc=Adps_6nnqcCMGiLIfQB3SS1tfSzicFChbcUt7p56o_WBkvFiInIoZTY4p1cm-sU84Og&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9bzvID_372SoZX0ZhEoz0DA-dW70uShZjpbjwOyAr-g&oe=6AD0F014"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzxVMgGEhSMQ7kNvwEFRx8Z&_nc_oc=AdqtSlRqZ1a5eU6UV8u5qzIX2HfyQ8nyfKpv7b_m0PbewCdDhZgNTEWCtHTXibkcKYg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5vgJcUTybXE5Mh04wpopIpcY0Db-9ES7Mnux5isU6PQ&oe=6AD100A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0LrOrRFH-cQ7kNvwFy6GiS&_nc_oc=Adq4OxfxH2gPut0K2NOFPrWcCB58caXa1aiNGvWP9D-kXhaMCpsX0N27f7kBUncAAd0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiNqDCx5qTHW54Bvm11zpI8Zmz2JQb8S5z4BlpP4gU1A&oe=6AD0E34F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
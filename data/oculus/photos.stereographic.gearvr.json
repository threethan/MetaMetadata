nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af39SSxZHri1E8pXjfFE0bPbXN3iUYlaso-4M1bE-mSykw&oe=69F0ADE4"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRlG0DrinrMQ7kNvwHEPixS&_nc_oc=AdrSpYiziIriJc8hbRHjKR2f_8xnvE_TheuoZt01ljUKmw0ttHBMZ_Heb2Tu82dMiDg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1GsDNtjymB9fvXpiJLKVjEKMFqHXziVQ_lnm2_L33Tjw&oe=69F09FF5"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXVHdtu1VaIQ7kNvwH8B7pC&_nc_oc=AdoIGEf2T_z33OsCl5YtKoEqQZP89f27cqrYs2fo_9Hs2_XE9rd0_mcXzoJn5eflawI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2XGQHI9ZzZzZZ9lQz0K9fTG8mSTN6FYNmA4zkKjH5_QQ&oe=69F0D114"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4LlLdHVIrYQ7kNvwFZuaRN&_nc_oc=AdpZDV-SGDOCbe0Zp5gM8hlDOcbk_ouI7La_RFWDY6AnI0ru2t3-KuOVHZ1EqAMvmiE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1S18a-RQKnPluh66QCrR7-UQ5M-94o4j_blWe-sE1sjA&oe=69F0A969"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmOBKObdKD4Q7kNvwGdh1HE&_nc_oc=Adp3JsXdj7A9YIu1DmfzNxvkZir6Kc46hvWG7TdoeK1dTSkajNOFkO49rJjQ8BiFf_s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1zXPprpkeAcmOmmHE7t_r_r-UJ-anoiBqnGEk3_aF4vQ&oe=69F0C44F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1503529892, "lastRevision": {"nodes": [{"id": "1352181691513794", "release_type
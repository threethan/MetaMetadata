: "migrated_image.png", "id": "683758439033931", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162695_628355190693880_6356987472836034560_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDV_VUAozZ0Q7kNvwH7X-Sa&_nc_oc=AdqWzVn4wEdSqMq93C6hNUIRDWWYOA4KJ36X_0_d1RL98Q6g_KPc4OxWiS4kR2jsLjA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQA6D53xIC1A-OIQwWmx6bsauWxlIMAstHUWqdHgS7aog&oe=6B0DAA24"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKQcV0R32ngQ7kNvwFOTvEi&_nc_oc=AdrcabxoHlNRVIa_5DBgdbcuK3STUFPAy1S4LDNUQq8wr-G4nMvFtDLKnEb33Erl2jM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRBhwcX_zIvYreOxqaYm5BMe67TeX3SlgnkbuHyhBqvXQ&oe=6B0D9C35"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=te_fTA_R2ToQ7kNvwFLlzNF&_nc_oc=AdrHax-LlY1FxniB3ZUsymCPkiUm-wDQ1On98e0lltG6e7mjdoLHPNLt_Ts02wv3NKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQVCZO6IMNr6kmI7SV1RRAKwzyK_4r6volKwXn3T7d6YQ&oe=6B0DCD54"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3ll6x9Sn80Q7kNvwEgdNGJ&_nc_oc=AdpAh3PRKAocV-L3bHfxS64gnpQ1Qrx0K32jNdgar-dVNdb1KIEsjL037awBAdv_QbE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQREbOgyAPc6F8bu0wnhqF_yUJ9zRkZbe90tDl_fXxp9dg&oe=6B0DA5A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a
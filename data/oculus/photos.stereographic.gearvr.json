Y1VHOUQ7kNvwHLR19D&_nc_oc=AdrEdJltoeTJqy1KddTWN9WThc11P4BSDMT9PTE8DlrWssoTrg6jKeg43WGJqtxcTj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7Ym9Hz_lf8MtwIgzQUyxva9_0Ins-dNdEQ8Pj9shl0Q&oe=6AB911E4"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYZ4wiyyVAAQ7kNvwFpCIAI&_nc_oc=AdpToT_BHDCtRiyQOfXYk867iQjwt-h-H-qVDo9I_NneRGD6uyuryKaFW5vzE0i2V7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1-vCSSe8qKmk6xw2MIb8GuRcAIvzIStOFVtkPUWjzbg&oe=6AB93C35"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4pMQzo3JToQ7kNvwEsnCBo&_nc_oc=AdpP-CySn-XJ_DjLHxSmIwk6ojpWik54w8v0zMje6CO4RCpUtNrhsmQy_eGa8qtqr3c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0j3U3KkGV58pq-tz0sSIBfnzx2q6aOHWvJE7n1zuw6g&oe=6AB93514"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ug6_KopdaIQ7kNvwHmE-2z&_nc_oc=Adq4X4-sLrB3ZC5nZlnU-sxrny9tb4vBuY5rwRtzsD7725_1TOdLk8cbcWaiw7_RLeg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL43FHRhQ95IKUyhb0nMwI5Qf_sP9FfgHltay5inHAQVw&oe=6AB90D69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBX7scVZgMoQ7kNvwH4BzEZ&_nc_oc=AdqIgmOavm_LUApPsnRS4EfoMa58oB_FIr9no49_CcKvXN33Z75pZ1PIjVMfRdPhhz4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRowzHQ22bqZYLCR4sQXo_RLTb7GwHKDofVsrf-9-v9Q&oe=6AB9284F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
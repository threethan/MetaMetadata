: "migrated_image.png", "id": "683758439033931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162695_628355190693880_6356987472836034560_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aR7CQR7w0KAQ7kNvwE_bz9N&_nc_oc=AdppUXABf3t24-_dQAURFnNZzHr3y2u78m-IDySEftOhMVrRUUgu4yl19EZUxhoJUeA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS07EFwtouf2wVXqkZCN60BIg4RH2oW4A0M9FJJzL5vmw&oe=6B007B24"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAQDgorhCUQQ7kNvwF5GCpd&_nc_oc=Adq47rMzSSFWKckU6NxEP3mrcRHSc5xLXiCi5TDv8L8r8FiD-xaVl_GwmSR57C8kUFY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8ZUlakF3IbB8EL4UovfXXfcDBVRcOXil404MCBu03lg&oe=6B006D35"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edl4OIGNovUQ7kNvwFM0Pow&_nc_oc=AdpDQ92KrAFq6mGGaUYAdm9BOXzs0pgJ5IU8-3dY4h7js_bP95uHQVpjG_B_chH_UNo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQ10_z5MsaByskqxcWVtw75uS52io0ghHcxHoT75aJMg&oe=6B006614"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1o-9JuJ-nHcQ7kNvwFHq3jw&_nc_oc=AdqL-D4IPJUhs6-lsY5Sb8Lns9SB3otBk0KB_3FClzdUIbW7i32oOnaihW0hWbTxjWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRAXHZb1xX14y8p5Rlu6a_dyNkL1E9iuknSxkJnhfmXA&oe=6B0076A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a
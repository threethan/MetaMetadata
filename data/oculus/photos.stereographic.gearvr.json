_z2QCIQ7kNvwGoZzK7&_nc_oc=AdpkoXtE6thK0SoLFJf-luPm5U7287aDGiaoIIMBrDOH2vNxlm6ADEpwugecJiZrzto&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5LNnJHRRMmZeAL8_ovTdKh78iGbjwBUUOiVv9VuFZdA&oe=6A636064"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M83tGSKrROwQ7kNvwFtGhwb&_nc_oc=AdqCFYJ2dpF3C8_Mgo1uPFlORF7WZBEz-mWiK_WGKldX2lvc_sSfJb149yVTm3Sf8Hg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3tCUchlgqMMUm1FCDFCYQs3AjXLTkpUl5-NJB2vzXcQ&oe=6A635275"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLNnHm01Aa8Q7kNvwGlCJcz&_nc_oc=AdoNV0GNyo8eSkn-2zOCGi73K7QsUw43UUzvsaxmpZS31k5aF2uUm0HD6Li2UU8c404&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK5WgSkicaDDhV2UBoL0XA-WqWAVRBPB7nd9ZeHKkX6g&oe=6A638394"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J54TWTPHb4gQ7kNvwHIq9Cb&_nc_oc=AdrUzaAL7V-Yt96CaRYvD2OoOHgv7_ljrAISy73lUjt3D1y5ZLkrYgL9e2qWG-Imxdw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZ1hQDojIlaS2KqLzxuIWypjm_-YJPPlIg5mSXdtDWhA&oe=6A635BE9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJwHLc34xbAQ7kNvwG0u1aJ&_nc_oc=Adq65olWlGLpz-OLFeahJNjwISER1fQ5MMOplv3mWaEkvI0Rzyofx6_UvUxJCN8BCZ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjbM9WmC-uGKOcg-dfFAzRylxyo71j_0zGDtRfNkCYTQ&oe=6A6376CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
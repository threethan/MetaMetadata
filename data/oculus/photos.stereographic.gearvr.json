-MUpHoQ7kNvwEZRk59&_nc_oc=AdrufkVT1t-p7S8EE5SP3HYnI3SiiStK3cVgJIyGymHYyuzso-N02WO24_g-NL0Y6uU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LN9vGnZGQWeqqKt0_-jCNz2tw_C0-fIFfWIbyukc3Cg&oe=6A26BB64"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0V270gypxtEQ7kNvwErdl6x&_nc_oc=AdqgsrSu-fV53BYjasnL6RoseLeiLzmwHe69Vf0_fg4Ybn22wNg9s8QT2wBcshQwEyE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UzNR05P38AnHvh2RPNB4rGrc1yCx9fMhdUP0AG05S4w&oe=6A26E5B5"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1HL2Uaeez4Q7kNvwGVnH8g&_nc_oc=AdodVuWVm7rrDwB_7kSxW4h2BEKYaFiXvVSKl80Rb9dcvD1x7dlr_wO-Ec4wCITsYfo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9V-xwJIJNbuQPrmP8VfZfy2RVmTfg-vhu4lF6TaXON1w&oe=6A26DE94"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBI1PypTwNYQ7kNvwGanPho&_nc_oc=Adq8qStPfMq1vhAhYvt-ZUBG2m8zAmT9KNfSoPMgyWedvZ2haOCMOEPWKdIismDZ_3c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VkcPbMgp4sdFVDlqy8YuEUdt5Tu-GgDPxCrLIJflOPg&oe=6A26EF29"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvlslYVT8vYQ7kNvwFojU0D&_nc_oc=Adq2Lgxhlo2VjDsIFUdf39fnngKCpPAwUdZ1LWDi8zR5khn0FWZq-H61hv1OUMEaA_E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-p7DBGtT9IrTumf4Y4PMcSSytCcJW2KCKbq1l2sCKqcw&oe=6A26D1CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
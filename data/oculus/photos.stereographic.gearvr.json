-MUpHoQ7kNvwFhdKxZ&_nc_oc=AdpyR9xcEJt2NFpzJV-kz7uh3STWKN0cZmbCxKlR78u9H7NWpgtdmF8DnbEG0bTQ2vA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6lVw2ycLZ8924OKxyOvpik89SqPiu-Y_czcZ4Ypz5Ag&oe=6A2569E4"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACWcTFZsdEwQ7kNvwFXZsYE&_nc_oc=AdrxuE-R91_EALlYppbN6T1nh6CQxlzuXTRk_hf8ZcjL5_9j_wtJADJ4dlrPeD9XUA8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lHfvi0OjGs4Me30xHj9QdPTDfPZwbZvaP9Nm-P_iD3Q&oe=6A259435"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jufyajZiLakQ7kNvwE9u8hw&_nc_oc=AdoGsXxPzMmkV4MfCossxnLinp3mhipb9zDqseuEc3VFPYG56o4JMojjh8_OEBYKg3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IdQv7-ICHFrYx-9KD0E69-PRWSf_46OoBhJe-yBNqHA&oe=6A258D14"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBI1PypTwNYQ7kNvwFG1j0Z&_nc_oc=AdqPVFWNe8TZOYYHpO4Q_xV-GuZL9QiyNkVbuVOgoSZOo_7AQZ7x2tsInEms8GaO8-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83M2YyNgBMgexxr79s80nKwzFuNCJOqgqcmtcizUNv4g&oe=6A259DA9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvlslYVT8vYQ7kNvwFDVBVv&_nc_oc=AdpQHK4jOnIi5AUGidpS77NF64hB6cyclChX4svgEPclCoreKW-sBfF2rF6NGBKoDBA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mQ32QdijRF4lqcRK6RI6wVnJ6zz8zqsSUVgxTyK-slQ&oe=6A25804F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
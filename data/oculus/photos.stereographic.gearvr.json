a-2iFMQ7kNvwF6zmTl&_nc_oc=AdqcnGQJ_tTlS2sHikPQl4zoU1RX11d5mj5dF8IpoMQkTB9CB10mvzt0aWxiqDgxlZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMc3GCcNcnsb3ATP0eaQ2REvLv7ruWwSEAGH0XqX5uhxw&oe=6ACE6224"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGaLy1SelAgQ7kNvwEPY_TI&_nc_oc=AdpvX8hJQd4WKo3uwEHeYfmTP9U3DE8I_YJKB68YVPh1-NMXv3V-ld68M0hSCGibDRg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKp88QXi7NPMMdjcy-NEhk3LVMrlkDkl4XEwGfv5omWA&oe=6ACE5435"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ii4mIBBX7DYQ7kNvwG1cpNZ&_nc_oc=Adr30PNxpNj_B38muoqABlRtNcC57wK8QXOAF8z-opPfi6_WD1qpXOlSg3ma7aBRw7Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFtXiwMm4Ss6Is3FD55KK-tcv9u6LmY1G9Wzbmb0joDw&oe=6ACE4D14"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzxVMgGEhSMQ7kNvwFibDUf&_nc_oc=AdrSnRXl7o_ekV_UB3tuuUEqp9i3WwFa_wZuFrqjNI4TJqxeOv2eN2ORnwXy7lj8lIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPl0NAKoNOBkaemo_q9m6zSmkQBvKuQol2mQmjnwXSVmw&oe=6ACE5DA9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhfDZuAXRqcQ7kNvwGoDQb-&_nc_oc=Adp51QMDTeJp5yx_unAx1S5eawuh_rNl98R7EiFhn7gSogYMAo5EWjShiouS_-7qzkA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP41U3O5MhP3jzReLvE56bqzzlW07VA-CjqE8spGh9cJA&oe=6ACE404F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
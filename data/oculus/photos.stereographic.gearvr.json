xX0E54Q7kNvwGEzTyl&_nc_oc=Adrcml_zr6rBerj48oS36HvzWHAmrARNxEavYmsZLKi2Qt-v2SFV8bspu9wDll_jGTY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JFTm9SXuNCVxpFRMvnrR0hMJ8I4itGHKGKOu10f0c9Q&oe=69FB39E4"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skG6X13H_jwQ7kNvwHqdKua&_nc_oc=Adqp3Z00pFdyGHm4G883CYFG3M1vFDT33o-PDtC9FeDwu1Pw3cSG7W5YXGFyBKbGjbc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NZZiPvCA6qpZ102HIgl_n7J0ljI6IkHujokAvizcFAg&oe=69FB2BF5"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5U3Nt1fCvRwQ7kNvwHPku2d&_nc_oc=AdoaGPVt8Bq9wnfnF9a0rhW5QRgnlSPrvj4SLP29t18LynKpyO7OWO6f3pnNDREcEIY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54JR-uYBBAquHs664HDGdYt3TBwiw3pJGn9IIYVspdpg&oe=69FB5D14"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EyBzDWVksYQ7kNvwGSH407&_nc_oc=AdoxpHOG1yGkFqjBmx4oA3JGMGhaYcgau7jny4p3_JK5vbTX4b6HzVR68DgvUtZiKLc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oAiMzC0hoYAtS7VlhH9egDqvj3a-w7RBTOun_8GE4LA&oe=69FB3569"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRhVMPbgEmMQ7kNvwEI3fu5&_nc_oc=AdpaqTNMUHx5cjnCAqdltaj8oeZfH7OxB2UNGuIGZnIArd_0TPbFCK8jF_Xi-ZJC8kE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7q_8hpnaE7dRStyLMq3joltky8wI49xwhNM_D58UeFYw&oe=69FB504F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
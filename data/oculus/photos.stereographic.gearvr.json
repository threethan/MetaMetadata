-MUpHoQ7kNvwGlh5hf&_nc_oc=AdrW6WqmsAIQnspuDTHrZl-zur7LVMYuLCxXyG68oaDmkgR1K4dJGiLSQxFOw9hBG1c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dFOUIlLIcOCoXV2q0Wj5wb0l_bFpuBk7retTRKkAJJg&oe=6A241864"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACWcTFZsdEwQ7kNvwHUtWQL&_nc_oc=AdoKvpj8xBNKwcR0ILbVlC5qvhoEVDbPMh1ozTwXMd2Ua5hbMQNS3zQ09mQs4a9fjv8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XWMrBFNL-w3-UoVhSnjgEe5GjsQuW-7nerHwFBEqFhA&oe=6A2442B5"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jufyajZiLakQ7kNvwHuqY_3&_nc_oc=Adqgu7IXPyXlpggqcV8KvaExWvxyZHi8LGC5WdD_6ENdzDgzjyWxdlkDkSEtjS6DJgQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vrVrxbSrRxsA7qhzjo_rTOHzlMl_Ai1q-SshITnwAzA&oe=6A243B94"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBI1PypTwNYQ7kNvwEWkW98&_nc_oc=AdonCq94TXPQFgCRcdRzCYQK7SgDR4x4eKXo-gHRvqtKm4nvGoSQqpXYxgqV41O0A_I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oDmx85cE4FLcJdFM8TvmBWIq_jVRlLfqF8wxI71I7og&oe=6A244C29"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU1wtV-I7d8Q7kNvwECFJpf&_nc_oc=Adq9im3P5h1coIN1H8Qpjq8YXPeNujFek2S-8fM04eLhBNqzeA_gk7Gfuu-w4cO41_M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LnWigvlf85VkEaGRgJlSfe9ke62_CmHBlNGqYeaQPUg&oe=6A242ECF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
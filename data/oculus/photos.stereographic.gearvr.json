3e_fY8Q7kNvwHfKwCJ&_nc_oc=AdrmJYpatarThgOZyu7QAQMiSXediIZM7qsEc9hj6UpcwmcyD322z7kLGu3Ty5v-YV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABRsRSAV9iv1wtqCBZFuH-xLwfEKkFeOSHo46_B3S80A&oe=6A6B4964"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0o8UOi4DC8UQ7kNvwGfvYTe&_nc_oc=AdpH8ofp_Uy-VfbOJPrviuCMbBHe2sN48ATaVOBALaOkUIEJLF1HNQ0S2bh6YrPHV3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRVgQcheq1QcGh-0DAEan6Jdj-sLrJAOxgfW7m4qc8Nw&oe=6A6B3B75"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3-59mG4MdsQ7kNvwFrYImF&_nc_oc=AdpejpExragW-JybFbnMF8RH_jikz1SMWjYFGcBkg4ZfuafKBu_w7WQsvk7InfoZero&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf_zAdLT2fgV3hWDzeShHN8QLgHPIet6Z0SA4ZmW6QKQ&oe=6A6B6C94"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ugUe7N3bXAQ7kNvwErXdOf&_nc_oc=Adp9Q75qkfMMj1tJBBfslCe4Ubl3ap8-4NTxhvVj7SIM-T95o97s_jlLmP3Wi_ymjxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA208Qgyxo68ITdjmQsvJZcfyKbGK3L77r6tK2iWASuQQ&oe=6A6B44E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuXXR7QW6koQ7kNvwHxZh-W&_nc_oc=AdosB9XX-kp_bgkwXBAAMpzOUQ5PCMBjcmntG18hh0bhPocHwRnV65uYUdxfPqJO0-U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBd-Tb3jKgsHeAEDCy6kIQRnkMWH31msBiSTOSOznRrw&oe=6A6B5FCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
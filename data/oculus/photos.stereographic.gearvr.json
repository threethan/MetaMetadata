xL_1ScQ7kNvwFgFNBK&_nc_oc=AdpfxRZcjDVXXucffm5BO5Lw-Zxll_GK8T7aKcqlakUqQFhkFODsW6R3fsZeL-I1mFk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mj60AVYMLUkFciAtxDttednFRFR_chdItzhi1Fcmrjg&oe=69DCE764"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF5k4eyRDfwQ7kNvwFQKVJF&_nc_oc=AdqXMD1HMuZWE786jkzGqL3aS9gsw0p0RLZ-ReI_BYC88Z6_OOUAMJBb43UtvNS02vE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PAEwcJBGnQ8GxlO-Zs9S4TMr5-ec7WU-vXGXi4HKr8w&oe=69DCD975"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zsiHOfA9wYQ7kNvwEoZdwz&_nc_oc=AdrNASYDsvAFBlsGmoT4hGKvfpnD_Zn3diqXIlBAQl2iWRdQRRqv1T1rZ3YaKb159fA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YTfeHmR-Bvg1VH0a4kreUrN2L6rtAA9FD0fOoosz02w&oe=69DCD254"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6C9KRr7XaIYQ7kNvwGBHtQj&_nc_oc=AdpiGASaxii4DKSQUxZoqAgIZ7LtqYGcdBs6Jss6zxy4pypDA3PHZGM_dw9BVmQNT8c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eBfAvRiPs1Sy5ahPOyywn-apzObh6_jpdfKSNe3N6HA&oe=69DCE2E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8BcB416sBEQ7kNvwGSUdTc&_nc_oc=AdqhHdGdAqG9_uqEbx-4QJPqLdIK21dxq30WsSdkYJ-64BC1ShSsm-rEHubWKK0aQCQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mhhyUO9wD26YRbLlwQSDHcmNKUsNcln--28aPg4YwKQ&oe=69DCFDCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
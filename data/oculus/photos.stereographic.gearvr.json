b819PsQ7kNvwE94NTZ&_nc_oc=AdomdyQ31B1gtxJ14GHutiuuXTQQo_olmwrO3susJVhTns3I0Py4UK8cyecYDzVZajg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GKZo0Pt0rNU_2ETMIG6FZekau5j6XPNaUpDqotE2E7w&oe=6A3ABA24"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ggc8mSmkb1sQ7kNvwGDQCD9&_nc_oc=Adq9RvbUQf3-46SZd8lHv0DBqFidqEzmNRlbUHY7F1bSO1L-ZqjmesOvGQ0pCn8mukw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-okoUVxPxwaRweQMAgjS60SsqGhcvVYoh2sexL56QkLg&oe=6A3AAC35"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAuB3zOAKy8Q7kNvwFLqATl&_nc_oc=AdpckS52CW1xapvkAg_1o2f_cFNCNpfjrEKt6BI_PgYdF0ComuAZc4h6u8xRszejv6o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89V8tm8pqbvSP4D6crR0IOGtIpMVC9CCQrpmblKFKE6A&oe=6A3AA514"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=On2qRS_FV_0Q7kNvwHJQ1Iu&_nc_oc=Adryz0eGZ7kpJs5UC3hpRch0-CFPCGp9e5Z0AmRwqKLs32A1JSg7KOlWbH4Ns8ZQHVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bhwqPgr67AX6__WQEckThyJAJFX-7ez-SNGjpZmK4kg&oe=6A3AB5A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4V_f-fOlhyQQ7kNvwHmgYyJ&_nc_oc=Adpv2zaB9Z0PKcLYCcZ0F49ZfwMmOu38j-kdlEon4pTPR7UAklRoYbgCx9s_Z9XId7M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fatiLogl9x8uA9jeQK7ihrE-we5cgMeP9Ph_mZrgSaQ&oe=6A3A984F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
YO90k8Q7kNvwHvNeIS&_nc_oc=AdqVWtI7Sg9raN-ug611Rw1GF2J5CC8dIDq58p5_f_ni6WlhmE2eELG8ifxvi8Xwmjg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxRe4Rix0hwMYJubGn66xqFM6xHogLCUpgGLSLSjok2w&oe=6AB3CBE4"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kax3jEWNHyoQ7kNvwH66YPJ&_nc_oc=AdrTmwwSt-2S4zcm_gQMQJ2AxiPvmX9yxvPgeDJmgbDthIiLXrnKldtLxqPLUuF55vg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQ6KdMgmGof_KlS-X5S8VsnTS3TJ_osVpuii5eupAOeA&oe=6AB3F635"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkNNqYoQ6oIQ7kNvwEIZd13&_nc_oc=Adqk_qxh7Hh3vZjHKW6pYb6aDKYi3mBhi7_VA3i-AhfjLNVwz_BEq0uabipjaA7GlLQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJt-57J9Ll_kw8chjjaLYeDpaeu-yzmzhGXG9SC7rY6wg&oe=6AB3EF14"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ze7js2oFiwQ7kNvwH2vFXM&_nc_oc=AdqZ6rEKJbPIE7_igpEbscQvTC5jzmdGK1ITEVzxOX6zoTJJfcv4BzbpklKWOjUOL9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLev_UUVeVo0fkUC2QSJdfQ2tAiqz5vpUD9Ece5xS3w5A&oe=6AB3C769"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBwKsk4cou8Q7kNvwEWSmc4&_nc_oc=Adqlz5V0fZ3ej5y8dKzBHHnQdliQiIFb8UQaZ3ObQ8Q6mqer-Z_EKSvCQ8cp2naiPPU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDiB0SloBurGZSIKihpcHstHgqRD6OSADUHHmYAcBJCg&oe=6AB3E24F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
xX0E54Q7kNvwGgU397&_nc_oc=Adpe3rof5K75PC1g_z9pixoxtJC-e3_baXbX8DfwzbdmAElK4P1zR_NJtfiH0914b9Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0uhASywF6HhRO0dVthvO_IX5z5Rmslp6fmQUyxZRGGhQ&oe=69F896E4"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9jV0mqu8QgQ7kNvwGRU4bv&_nc_oc=AdpNosuX0kirnZEskOKGAaf_o_s18bCbGyG6w3s12kQCnky8Qhtzul70ByvZy8-wJd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3dGF2M6CsA-xL-V8xxSq7Do1ch9tuuvon2isfn_KwEHQ&oe=69F888F5"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDurOR5OljcQ7kNvwHKJdR-&_nc_oc=AdrxB2XIxU-MhK2cbGU74h4wOcjmYErAS1WuICiaXN6KPUsVbmk7dTpbmWcdeohhP5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14fs3IZsYEz93Mse0_xCuh5x3NUMLuz17og86QcSr_tA&oe=69F8BA14"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EyBzDWVksYQ7kNvwHs9UUb&_nc_oc=AdpA3o3WwwO6PqnSNEkI_sp1UjAiv0ikx8jOW31livjN1yltc0EUYtFLS9-yazDWDWc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3JyqCd03LCyRkX7bxtuXyHumIlbj_8v_Gr9dFxiW5AXw&oe=69F89269"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvNwPCxa5ZYQ7kNvwFNXHvd&_nc_oc=AdpWIPafZn5WrKvBLoCeWp2XY4EmQrOdrlK2fB0xAZOqA5hLQPG-pv9RALpb5BG2AhU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3nT_EumY55evEK1mbPh_T4GRqnBhaORtbYNYNzd6qIng&oe=69F8AD4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
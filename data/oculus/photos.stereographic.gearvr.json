p4jQsMQ7kNvwEO1aak&_nc_oc=AdrZSyIfpCWMTdRYkVerKxXeVLW00g1zCCrQnbt01FRWMEciIdQBZx0a11sALzRG4Sc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsT9R70gCFh7uOE6peuT68QDEX0zhC7vh7161Tv06S1w&oe=6A5A25E4"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zwEhdwUstgQ7kNvwGJUuAp&_nc_oc=AdqTwspJ75LZrOt42nEXhFlyQZ7sxWMexNxfdi7Fc-5CubAKqmvWYPnjRINCxxcJwfA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8cdmmmLpX371gNzE8zF73akxmU_nxsyXulNVQnppjHQ&oe=6A5A17F5"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDDSdiz110MQ7kNvwGBwD7n&_nc_oc=Adq6JPHq-CX12eqspshqXuvvuFSmjAw4pbalN5t5AqKFtj3o1SoR20D9bpEFrDHOKdM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBmLY4lsnPIC6cJ_7ilq0UHIlDsAxGSl9ll7kPCS_Qmw&oe=6A5A4914"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDX7SOcYexwQ7kNvwFngOR4&_nc_oc=AdpIiLuCQI9YqJOJlKYJetbIUNnfAVVVUDmoLdtP9S5FfbEQ0VgY14wTiT-6RZoJ2Wk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpkkWiv7_fAsfrRjwvb0dQw8X2CvAHe1tCedpQ3NURyQ&oe=6A5A2169"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMNVp1Ve-3sQ7kNvwFyjlpD&_nc_oc=AdqTEfxDhQsYYTb-pCI19qr1XeMY4VC3h8ZIwIlnoLybvjgoxp24eoEgAP1z2QWLwAY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmeX1iYi9ImNsZyDhPS_ygkPWeL_bXlwh2E_0lBnPQOA&oe=6A5A3C4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
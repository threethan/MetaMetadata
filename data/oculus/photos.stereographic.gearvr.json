E78BG7f4Y9HRyUTwJdMIUw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0XyIZZMu-9n7tqn1s3Ezl942rHfyOHWFNzw6KgLtYAA&oe=69C3C5D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover Art - 1 Landscape.png", "id": "247286619118735", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162698_247286622452068_3632725893492768768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QevcPM1ncywQ7kNvwEMDcUn&_nc_oc=AdrFQejlluIv_zz_CpKrAZ8hnqRw_XguvWYfgFJ44oHks0iX2O4da9TnKchs9ZgaI9Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwBzfi_sTHv6G3AbHxg_4djQLfKpCiYUFNBUNHCzNNGA&oe=69C3C809"}, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics":
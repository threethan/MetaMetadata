3L1Z_EQ7kNvwEhk8Kq&_nc_oc=AdrOEbNIayMmb_TcfA7ns-5jf1sb2ZYvMYszBlzsdX-zjuZdgUDw9BaRtsX61E4XylA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA13AEg4aPfQB4Xs-RFEBP0wCxrjBULmBCPk4fwatX17w&oe=6A68A664"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0UjASix9fgQ7kNvwEFSdyH&_nc_oc=AdrpUfjamyK5Re5B-YKd-MHBvM11t_HLu9aWGQt8IRzMk3J8SszM7QzZeiqqfz7n35E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDn432BQfWctVWxrEOkuJoLAzsYKFegGE8S5Aite3ozGA&oe=6A689875"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfMYCWBtYcEQ7kNvwERk8T_&_nc_oc=AdpC9G1-3WonPdae1NXBVvjHd4Ji3qF9gOH7Zv-aqxKxzOfaEj6DNtg1J7a5k_mNfeE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVpd0Nkn-GONUGvoqsZS0Q2MfWYwHe3sNqj7hq6Q4SGw&oe=6A689154"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOs-UQRUi10Q7kNvwFlPZdi&_nc_oc=AdqwRvwhMJowByqIAGpWVvNcsxnJbTpVlPqhcp6CuT0hT9MegmUoM84LJtzMUAGHsQw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVAPdUuFsy1BYdsYMQDk_4kJSJORqirn_2ADOSK5AKxw&oe=6A68A1E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuXXR7QW6koQ7kNvwEuIR7L&_nc_oc=Adp9cpLvF1YCF4eNBNJuI7AW0PHglKLJdwyEw3q1rZ4KMtmAzsLiEGT2Cw5dP3EbOl8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWoIHqgUOeFK3DCj4D-XAp155BV4DSv1AwTv5f4gdumA&oe=6A68BCCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
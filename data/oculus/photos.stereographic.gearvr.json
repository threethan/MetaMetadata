QvLsMcQ7kNvwEm8UXb&_nc_oc=Adp70GsABGffPiSQMvq3N05um7hR4rMBsdpD0zzI4Ou-zAVLWw-bYJ-uSi8Ou6gL600&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtRowi73FsrDm9WU3bAddjYFlCcEl4PZQRJQ31WNhuaA&oe=6A8AED64"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VANuX2x-Y7IQ7kNvwGqQAXw&_nc_oc=AdpxrrWnyTn-CQdrTM2N9KJB2pcoj5V8udsVBARJ73BX2N2Vz_0u2liCFdIxYqD8y4E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUv_C0oAUMDsPAXXmdhWvvFNgBCj-P7gSzT6QgddFYmA&oe=6A8ADF75"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=libQPaMQuCYQ7kNvwGypPof&_nc_oc=Adqfdl5aTl2xy2TZ4yiu-F5r5B1c5bMtBatY0rYq8IopDQdbJOFFEaSBso6nzPUa0cQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeoOUFv-dHC7z-BzPvdVaAo1__orWXDijWNaMnWmZDnA&oe=6A8AD854"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oRlLQ9BAkYQ7kNvwFejz-W&_nc_oc=Adp460Ou9aa71WgirzpnuJ-eFtFhUtOn-f5Zej0lYHu8vp1U0wjjior6WkjAiKwm_HU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEykfgwn0dcdMOk77p6bP6L_74yDxM1guq9_d8or0Meeg&oe=6A8AE8E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Krv0_erkmIQ7kNvwH879IK&_nc_oc=AdrMzvDrPIO7k4zNGVIBx8L1EdrmaXSarKDKSiIhEBRRVwwH9-VP6rQ55gxOhoeamAw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJHWZyHv0oQQlLYq1ic11wp6ZQbfoX8diwujoZuB_xbA&oe=6A8ACB8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfudhTaAeVYMVxltgMtbeP5r52suguQZ_KAC3X8PFzIcoQ&oe=69A6D9E4"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2NKRbrewAAQ7kNvwHVMZT1&_nc_oc=AdmZ7nDnH55IBX1YYhLdXOxCibivX_ImQiVm5e2Un53dnq2lVKh3n0hhEzuW0-SEDXI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfustlPpe9qtOTHhKwXmKI8WhE8_6fVS4s0aUO-6anzsgA&oe=69A6CBF5"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02xZJPLAx-AQ7kNvwE4Y0fO&_nc_oc=AdmMF3tPkrGpbo9SiTVY9P0TVIUR44KACM4jOi6vz4e1-si7RqoUlDpY0spW88RyNDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft72VvLOBmmGKxN2HB6GvOA3VMmktvFaJL35CTFCaGwSA&oe=69A6C4D4"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcPeTg7FVOwQ7kNvwGVn2FR&_nc_oc=AdkYpC8m9fjLuOHshmox2V5vdSlpquTrwnJ77-U0930ffnXkYS4AeRYFaxpL3Ia1ZFs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvLwM6GCVHUMFFZCG4roMX79kQXTbbjPJ7FyZCKWxCZ6Q&oe=69A6D569"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjxvU-pj2YwQ7kNvwEbba0I&_nc_oc=Adlc1bXztBH4SErhohsUJCwMoUS9eRGyOTn3BuBu-ntIx_VRVa87BdNTIyyjlB03c24&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsbRQTshaN__jevAEAykubjOynOcoprouT6u8iaMH2p1w&oe=69A6F04F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1503529892, "lastRevision": {"nodes": [{"id": "1352181691513794", "release_type
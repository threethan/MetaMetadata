nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvfikrLmEqIvXF11TjISBdOAgu0qtv7XHjzZrH0pnVB9A&oe=699D9F64"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmZgKBujghAQ7kNvwEKwOfV&_nc_oc=Adk6aAxvBbPFtsf2lkBKuf3nC4jzRAftL4WIbcEteMoYkC7V6BVX9GLYv95YgkpLevc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuua7vQ5SwuKljq3Ea3h9y-I1Vpt7qRgXtLBzjdcTybtA&oe=699D9175"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RC5nP8oXEbwQ7kNvwFgJNJT&_nc_oc=AdlI_Y34pbvfHt1PiMMr4s6w3L6fbf19VkvCj_vgCmMnOn_rq3iqA3cSVUmBen-Otaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvhT8gP8Y6Duu_uLcwqII7-yHUhgUWzJjrNEDqaRez7bA&oe=699D8A54"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYjvoccfdIAQ7kNvwHGIGEv&_nc_oc=AdnDbJLgxSVShHgsZ0yw6bZ4GerKX298yaYxf6_hK-eEP9ekSUpiFT2JS1i9Uyxg4Dk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftiwX2pmXUK1hKxAp5VvrH3HuOz-MyAQJDqdq-uiZJhlQ&oe=699D9AE9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_0YGB1isTIQ7kNvwFZk8u8&_nc_oc=AdkPzcBzcSpfyyNLEe-PZ6XvD6fO9ySpTr9Ct4yc7YRuzDGrwNav6xTPEnuHoLgtJDQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvVzjr7wtnPNWXcM2V-puDUvA5hpY8P9efaeWF-qsoRRg&oe=699DB5CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1503529892, "lastRevision": {"nodes": [{"id": "1352181691513794", "release_type
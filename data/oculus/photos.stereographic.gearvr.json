jRo4vwQ7kNvwFNiDkn&_nc_oc=Adp-3v47Iaj-0h2EGeVoJYhYq3jl69Ve407XLVgYFFXXn6il8JvkItzcbEYIABoWKVc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzRKCGV3JJ8q7nRCCJumbby8vUSl67PTa3cWIcowlsig&oe=6AC527A4"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJsZn9d_0J0Q7kNvwHoUnPZ&_nc_oc=AdoEWNiI2C6ZhWtDLYeIiGNPNKfMBmW6NGi-KaX_EqoFQFKEp7WvISE5bwgrvYF9xus&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM96gNvC3IcdL3Sf5SwVjoqYNuvdJwcNstANZAQaMA53w&oe=6AC519B5"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhnZV8-by4QQ7kNvwGxRKeg&_nc_oc=Adq41tEfWE09uQ3dBMEGebVTQbKJNQJ0XGgy7TiJCf3XoIKmHGHAchDhrwCN2iOudQw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQCXDXNaWfve0r5XtvAaaoNtf5dp6JqQlLX4ebSnxytg&oe=6AC51294"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xePfmH8m9G4Q7kNvwGt0NII&_nc_oc=Adqxb5v1y74tL1Y4JtzLHCRhlxBsii1sk28NiQaVYERP4D-aYqZWN6rMI3F_RiiY1Ps&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPANPPjN_FnDfwxlsSgTzP97UUkAA-dpo7Bg0we8y_7FQ&oe=6AC52329"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SieWZ7G2nmsQ7kNvwE0FnBf&_nc_oc=AdqcrHFBUGANkEQ2Df8KAuje_JhpV-FnLPKb842IJ5U9bDFhWSH0gqwzdChRFOyotuY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvjv3OkvgshxnsstH_9zeUhcTfbV1wjUMbyfubso9H6w&oe=6AC505CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
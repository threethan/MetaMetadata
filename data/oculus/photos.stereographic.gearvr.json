3e_fY8Q7kNvwHWgM2l&_nc_oc=Ado4jiftBMolEhgqTo9dsxYEKMr34kJ3DXapZig5MIMp5SNezMGYxvxnTsPWu8VNnQ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDijyUWLMa-45-qEEjhO-Gd0_6ocrupeRtMFfxYXV1nUg&oe=6A6C9AE4"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0o8UOi4DC8UQ7kNvwGKkgE6&_nc_oc=AdqfDVonS65fWu8aWb54RlnAAau15d2OrohHBFnLBz39fUda3zkwCtEdOYJU7vhj5i8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxNOIDvnvEru2ceSaLpK1JSLUS6OGVzL0f75zIk8kQMg&oe=6A6C8CF5"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3-59mG4MdsQ7kNvwGZbjdz&_nc_oc=Adov6lPvsAQ2zkgTFeRT2bUvMa0PMtgUnz5sGQbgDfwM8dvH2KvOOeNF__OAoLt7mDc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm8mF0dqcOnqcjZGuLLFHAEE2tdnwvCHABnVOKWkkdOg&oe=6A6CBE14"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ugUe7N3bXAQ7kNvwESOaBg&_nc_oc=Adon6MtLzCxDJS2TMjbOxFAFIFOKwSkKCVQy9lI8VIaOdrj4MMwPlxWxyzyOqlL1MLE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDr5X_vJSMHwb4A9cJHxxcnzkvYBJ0LPSGH8iZ984P1Q&oe=6A6C9669"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQmcQy3tVmAQ7kNvwEODl9I&_nc_oc=AdqyRYI0wOX263pAENuK5mkiEqWhJbxr-T5fkEU-HxSlBdvTSnsQPxTXi90eVq9ievc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY7kU-VD20xC0kZN1XzEqdBMgFu_EukJZ6Vj_b5XtrWw&oe=6A6CB14F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
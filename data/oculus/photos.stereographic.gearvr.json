-a66gQQ7kNvwEQwUHh&_nc_oc=AdpmISoOw9uebCY6UgTGJcpPnIW2p1QbR2FosW7nG5wCGMNr9Lfwmq7Cctc6d-aYDx4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh666-E18TILgEdxBklL7Ll2elQS6J7MTrcbxlCeAq2g&oe=6A7B1B64"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBCi3Sz-dQsQ7kNvwERc-a7&_nc_oc=Adp6Aqbbk1G75YXY86LY_qEmTzCA021SSXvFHl_jhJStU0DlKVqg9tsCT-XNCtYxme4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWv9eVJLYev8TozKw_iRrIZ-yM2BROiL5QOe5ZbC1MQA&oe=6A7B0D75"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnrUaSIkcR8Q7kNvwEfogGX&_nc_oc=Adrpoewdq6MHCis7_jWEDVJiKu4hYxAkgegcp4m5VPB9R-dwzxhVkWrYqb4WWpGYtmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgLc9GT3ONmmEZjihvVUsoErBd1PZWbUB2i4mz2XavRQ&oe=6A7B0654"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B25mEDxYBzcQ7kNvwH3YBAL&_nc_oc=AdrmLsyM0EKD7HfHP3sfvjh9GYJN6Cb2Hb6mZ6HHr4JG7JuTonu0fagLTCl_qaO2IKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHy_U-dC_irZ894Gp9gvSE0sIETeQ65RpKt4UT3hbFlCw&oe=6A7B16E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mHnhCRTfzgQ7kNvwFGp37C&_nc_oc=Adrh_CP-g0XDr36PLqxvutSQqGo_PXxBLHtLCuI8sWWuR0YbAg7wyo-9V3sSJHVFgI4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjmLwIKdULfV47gPEAE9BvJne45XU9C_xmwmtrB1CuLA&oe=6A7B31CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
QvLsMcQ7kNvwGezoMA&_nc_oc=Adpb153qmCMiQyErUY4DB6qbRuF_dMU1DBcVUYIo9ZOS2fIctb358dnVP5kY05Fl_V0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpwPPGTNgJubJc_WsKo8pO20E7mB2Gf7NTvfXvRlr9zA&oe=6A8C3EE4"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VANuX2x-Y7IQ7kNvwF7j5fa&_nc_oc=AdoR9XwVPUJcAKVkR4hejiV3HMV1sYvfg2B8zerODeZxmNbMjRPqwcRJ9ZdvltJZBBY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaJsoTb_EIuq0TS15SHif5lUqhhhKLyBVtPaEFfoGvvA&oe=6A8C30F5"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=libQPaMQuCYQ7kNvwHEjUt4&_nc_oc=AdpktpY8ostakK1BthTL_ZlhW0htrqCvSUAZBImtS7daKn13XWJ_CFWhlVESn6p9IP0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQMeWtCpisvlBmBZ8IvojuXmcFqMrOf9aQBTIFFIJzYQ&oe=6A8C29D4"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oRlLQ9BAkYQ7kNvwGmIHjn&_nc_oc=Ado47ZToeA9xrIwvqwM5D6LE2te87jdWjvdwuI8lE39ywPPmdgn-_Bpu6FtzGVYzImA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESG4JNNv_lCrinsnaW6wOFPtSkU6MP9s7XwPDonDvarQ&oe=6A8C3A69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWTihgqyxSgQ7kNvwFGw_Zp&_nc_oc=AdqmGRIkkfuD7I7woG4rbCQqFtbD2THfCZw_aBliTgNAcrmEQ9TpigSWDYt_CcfT560&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMSWBm_u5G1k9pKZKTkHSJTuFfSUTbo-HY4zu69Nqwfw&oe=6A8C1D0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
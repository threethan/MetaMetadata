jVjQv8Q7kNvwHCk04A&_nc_oc=AdrvAG6UynXAXa6ECKrjthDYAkIXjsqGlFUD5xPEnQsVsXaunOrxpDKesMlsUf-cP0A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1U_kDd2jC9CJzOc5hs2ewrWycNo1fOaPetaZb8D6TNSA&oe=69D8F2E4"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zs4d2ICFShEQ7kNvwG35VNt&_nc_oc=Adquqe9c7qP0D2xVtAmPy_miyb4vZ_q5aRiqW8eLbVDijJ_f0WL2Ed7TH5DHYR7tTZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lMd4wNMud9O5jLOXPDR5_GkO9dPuoyRPzvtyNIZ-20w&oe=69D8E4F5"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ams_UROmKYQ7kNvwGgemu2&_nc_oc=Adoyy49QjLXklH1O_pYC0yXxNHrieUUY4riEer4YxafCU6KYsxzebAIYEgoIZucaK7A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vBGcQy1yDE3mXNpWhejG0bFU59_3ySFwlPHi3lA4Z-w&oe=69D8DDD4"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OH2K2VgkCjcQ7kNvwGcvWAM&_nc_oc=Adq2Lso6GDb8K-yh32054kOs9--0Aubl8XV6dBiFbYllKzqh-vrnltSWGmoyduMBLcY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yOZYGaNfLbxUUEUMHfJVEgSG1d4mE_F9wvrw0mqyZog&oe=69D8EE69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oItBwsa8PIQ7kNvwFFbljz&_nc_oc=Adq8m5nxduex7Dt0zkmAz5AR4m9JI8DakMa3_0eRO9upFcD3-gnRwaY6lwpS8qBxpuk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GV3OE1OcN9JIXwyQ_qi_Ur5E9nYRbFeWM1TNqM3Qjdw&oe=69D9094F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
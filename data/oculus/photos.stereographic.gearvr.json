YO90k8Q7kNvwG76Y_j&_nc_oc=AdpSyFC-Y3UItWJ0e6oa-69B03rYTZ3vTSndKP-78pCu1jVZ3EwREeZzThvCs9q9YFk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItrLPIa1THFvtS-5sK9wWi49l4O31bTF_aMPw7qBVlzw&oe=6AB51D64"}, {"file_name": "migrated_image.png", "id": "231832741293855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162707_1921580854721875_3318501443257761792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Gf463_2q1sQ7kNvwEko-o7&_nc_oc=AdpsIm9DEAwYi9HTuYrnRvpIQBtUw8syvOXAlRZEE1yuoRXlvcskNISKvTqC04LaCBk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOKh5TPg7HjmVtPSBEqaJMp6r6mUSyMmCVSs0WXZE3aA&oe=6AB547B5"}, {"file_name": "migrated_image.png", "id": "211236806654964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162699_403420860055298_577014309163368448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZtONmHhPrYQ7kNvwHQzIpp&_nc_oc=Adpm0Xb86OJU1KU-o6Xhmh1fnVe4XRy5C4WhGKhtK-07ZTK1fr415Yy8R7kady5ET1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDfUq_wws6i7IW7Z57YwPaDAQHeof1Amr8uR9GcvGQNw&oe=6AB54094"}, {"file_name": "migrated_image.png", "id": "188999239217580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162699_466538007041011_2170804418474147840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ze7js2oFiwQ7kNvwG9ZN5N&_nc_oc=AdoU0jsI1tWui5ZO1A0LFpSmN61lsup35y2nUsWEi0DZVFTB7WSALtV-Qw_UUXznwPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu4xQ93jnQOOLKevocmEjW1vqP62nnx_tRkEX0WdPQ-Q&oe=6AB518E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702988214403440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162698_118118852140802_3947091119870836736_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBwKsk4cou8Q7kNvwE77Ncu&_nc_oc=AdofGiTwsizAmhjvWk8gs2bSBeyhY55SZHOTWNEFqj9kJ2Qh-iiKbuK_JZ_Jqku7eMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS-Pw8BGu26_uu4sDG6LGa2Pl_lA8GUJuQLBZf2dJ1HA&oe=6AB533CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Looking Glass VR
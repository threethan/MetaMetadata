rASta_E0bA-sB6zzrwz4nY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHowwfSBxvrwgEn9toXpnrTxfYzZpZafpGpqg6yJB2m8Q&oe=6A7EFAD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover Art - 1 Landscape.png", "id": "247286619118735", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162698_247286622452068_3632725893492768768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kvk-mmSlUnQQ7kNvwFYED3i&_nc_oc=AdogHaJ0TzwAdFrfdyVI_uedulAYEmphWolHtAh0a6-tgWl_ivo_GdvZbSP4063xNDI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECK5Sk5vfl6t05ySfsrJrl62QLkOgsn1Oni0OEFkwdmA&oe=6A7EFD09"}, "display_name": "Looking Glass VR", "keywords": ["stereoview", "stereographic", "stereograph", "history", "stereocard"], "long_description": "Even amongst virtual reality enthusiasts, most people don\u2019t realize that the first 3D viewer was developed in 1838 by Charles Wheatstone - almost 180 years ago! Since before the popularization of television, radio, cinema, or virtual reality, people have been exploring the world through immersive stereo 3D images. From the invention of the stereoscope up through the mid 20th century, hundreds of thousands of stereographic photos cards were produced and distributed all over the world. Though nearly forgotten, these photo cards can again be viewed as intended, thanks to the advent of mobile VR.", "short_description": "Looking Glass VR is a stereographic 3D photo viewer featuring photos from around the world dating back to approximately a century ago.\n\nTravel through time and around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lookingglassvr.com/", "developer_terms_of_service_url": "http://lookingglassvr.com/", "publisher_name": "Looking Glass VR", "support_website_url": null, "website_url": "http://lookingglassvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics":
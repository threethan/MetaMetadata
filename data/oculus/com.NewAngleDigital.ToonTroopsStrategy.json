91Lu6Y3KNkV2CRCHwW07A-h5-YXZIyOYgskkA&oe=6B0EF1FA"}, {"file_name": "screen4.png", "id": "8222985441139203", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974652_8222985447805869_3740683134829578943_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKfFDOKNxesQ7kNvwFMg9jc&_nc_oc=AdoiCrhTcC8M5l3wGAM1MZAREZ-HkDzuD6nm5t6hd2_2Q5WKFX-IOKlinpDNSZH1W9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUk_q1sCiy31r9Vf3zJ7YRWPAgFbuBj3hQ2BsdesPZWRA&oe=6B0F1715"}, {"file_name": "screen8.png", "id": "2932561456918045", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031353_2932561493584708_410596506791214622_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_18ID-SamfMQ7kNvwE2gUCG&_nc_oc=Adoozu-q6Kbx6DR72R_vi5hUmoPZmeUzX6qmOE1kM3XzO-pflYyUacGUpJvDQd2vlvQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX4EmfVIfwVem0hsHK4rnBLCCYoJQ56RiAkKmZE2jqdcA&oe=6B0F10AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen4.png", "id": "1067659008102306", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575346_1067659014768972_5352320059305145528_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qscnkBBWq8Q7kNvwFXhjtD&_nc_oc=AdpnHKWfHiBpbWixw6DQMgkFa89GJWM2Y8zzsOc-QcjnPRMQd_Li2ZlG3AE4cydUOwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVNW0jVKs6Z4WgjPCyaL5HSbvLA4nrRMbdHzrwZaXe1bQ&oe=6B0F035C"}, "display_name": "Toon Troops Strategy", "keywords": ["strategy", "stratego", "boardgame", "chess", "checkers"], "long_description": "Welcome to the whimsical world of Toon Troops Strategy, where strategic thinking meets cartoon mayhem! Engage in tactical battles, outwit your opponents, and lead your colorful cast of characters to victory in this charming adaptation of the classic strategy boardgame.\n\nClassic Gameplay, Cartoon Twist:\nDive into the timeless gameplay mechanics of the beloved strategy board game, reimagined with a vibrant and playful cartoon aesthetic. Lead your army of quirky characters across the battlefield and outsmart your foes with cunning strategies.\n\nStrategic Depth:\nWith a diverse array of units each possessing unique abilities, no battle is ever the same. Plan your moves carefully, bluff your opponents, and adapt to changing circumstances as you strive to outmaneuver and outwit your rivals.\n\nMultiplayer Mayhem:\nTake the battle online and challenge players from around the globe in intense one-on-one matches. Rise through the ranks, unlock new units and customization options, and prove your tactical supremacy in the competitive multiplayer arena.", "short_description": "Toon Troops Strategy, where strategic thinking meets cartoon mayhem! Engage in tactical battles, outwit your opponents, and lead your colorful cast of characters to victory in this charming adaptation of the classic capture the flag style game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newangledigital.com/ToonTroopsStrategy/tts-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "New Angle Digital Inc", "support_website_url": null, "website_url": "https://newangledigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8625333947558084"}}]}, "scheduled_off
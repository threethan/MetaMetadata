cdn.com&_nc_ss=7f20f&oh=00_Af6WH11AH_s63IzfGZj2ftk5VoKlsD5dC590cbgQjnoOiw&oe=6A11BED5"}, {"file_name": "screen8.png", "id": "2932561456918045", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031353_2932561493584708_410596506791214622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAgXEavRSgoQ7kNvwGqlgmy&_nc_oc=AdqaCpmNkidCY3R4rdWx9Z0TmxLnnku5SwylYhJ5-rAjw968uxeSdlpptv33A3edJFg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mdlOHz9W1cKHcsINHVpI7IH6xLKG3qB47pTD5hzHsAw&oe=6A11B86C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen4.png", "id": "1067659008102306", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/57575346_1067659014768972_5352320059305145528_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hX8VRMXOSC4Q7kNvwGHmXSF&_nc_oc=AdqGmUGkCy--u5K4BD1b1__o_MJghTBdAtDhSORHOP8DXBRPpKccK_bi_u56SWJLt9k&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HMfqVihMIaZrT8dz5_vA4hpatJ2VWQjNBtshhZW4bYA&oe=6A11AB1C"}, "display_name": "Toon Troops Strategy", "keywords": ["strategy", "stratego", "boardgame", "chess", "checkers"], "long_description": "Welcome to the whimsical world of Toon Troops Strategy, where strategic thinking meets cartoon mayhem! Engage in tactical battles, outwit your opponents, and lead your colorful cast of characters to victory in this charming adaptation of the classic strategy boardgame.\n\nClassic Gameplay, Cartoon Twist:\nDive into the timeless gameplay mechanics of the beloved strategy board game, reimagined with a vibrant and playful cartoon aesthetic. Lead your army of quirky characters across the battlefield and outsmart your foes with cunning strategies.\n\nStrategic Depth:\nWith a diverse array of units each possessing unique abilities, no battle is ever the same. Plan your moves carefully, bluff your opponents, and adapt to changing circumstances as you strive to outmaneuver and outwit your rivals.\n\nMultiplayer Mayhem:\nTake the battle online and challenge players from around the globe in intense one-on-one matches. Rise through the ranks, unlock new units and customization options, and prove your tactical supremacy in the competitive multiplayer arena.", "short_description": "Toon Troops Strategy, where strategic thinking meets cartoon mayhem! Engage in tactical battles, outwit your opponents, and lead your colorful cast of characters to victory in this charming adaptation of the classic capture the flag style game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newangledigital.com/ToonTroopsStrategy/tts-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "New Angle Digital Inc", "support_website_url": null, "website_url": "https://newangledigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8625333947558084"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8743887269036084", "version": "2.0.102"}, "id": "2950842538396991", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applic
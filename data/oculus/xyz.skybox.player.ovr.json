{"data": {"node": {"__typename": "Application", "id": "2063931653705427", "organization": {"id": "363664510661896", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "2063931653705427"}]}, "id": "259509461591763"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1393269044113553"}]}, "id": "159206971316528"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1256687334386627"}]}, "id": "1014276078677654"}]}}, "firstRevision": {"nodes": [{"application": {"id": "2063931653705427", "release_date": 1558456200, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 29}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27502518589420050"}, "id": "820768564925171"}]}}, "binary": null, "live_binary": null, "created_date": 1730958480, "id": "8536037113161483", "is_initial_release": false, "name_with_fallback": "v20", "pdp_metadata_with_fallback": {"version": 15, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "8536037539828107"}, "release_status": "RELEASED", "id": "2063931653705427"}, "id": "8536037539828107", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2063931653705427", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1431503208254349"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1634550837139752", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SKYBOX VR \u89c6\u9891\u64ad\u653e\u5668", "keywords": ["\u64ad\u653e\u5668", "VR", "\u89c6\u9891", "\u7535\u5f71", "\u5de5\u5177"], "long_description": "SKYBOX \u662f\u4e00\u6b3e\u80fd\u8f7b\u677e\u64ad\u653e\u4efb\u610f\u89c6\u9891\uff0c\u4e3a\u60a8\u63d0\u4f9b\u6781\u81f4\u7684 VR \u89c2\u5f71\u4f53\u9a8c\u7684\u5a92\u4f53\u64ad\u653e\u5668\uff1b\u81ea2016\u5e74\u63a8\u51fa\u8d77\u4fbf\u53d7\u5230\u4e86\u7528\u6237\u7684\u652f\u6301\u548c\u559c\u7231\u3002\n\n**\u5168\u80fd\u7684\u64ad\u653e\u5668\nSKYBOX VR \u652f\u6301\u51e0\u4e4e\u6240\u6709\u7684\u4e3b\u6d41\u89c6\u9891\u683c\u5f0f\uff0c\u5305\u62ec AV1\u3001MP4\u3001MKV\u3001MOV\u3001TS\u3001WEBM \u7b49\u3002\u60a8\u53ef\u4ee5\u5728 SKYBOX \u4e2d\u6b23\u8d4f\u5e73\u9762\u3001\u200b\u200b3D\u5de6\u53f3\u30013D\u4e0a\u4e0b\u3001\u200b\u200bVR180\u00b0\u3001VR360\u00b0\u3001\u9c7c\u773c 200\u00b0\u3001 \u9c7c\u773c 220\u00b0 \u7b49\u683c\u5f0f\u7684\u89c6\u9891\u548c\u56fe\u7247\u3002\n\n**\u89e3\u653e\u60a8\u7684\u5b58\u50a8\uff01\n\u5728\u540c\u4e00 Wi-Fi \u4e0b\uff0c\u60a8\u53ef\u4ee5\u64ad\u653e\u6765\u81ea\u60a8 UPnP/DLNA/SMB \u5a92\u4f53\u670d\u52a1\u5668\u7684\u6587\u4ef6\u3002 \u60a8\u4e5f\u53ef\u4ee5\u8bbf\u95ee www.SKYBOX.xyz\uff0c\u514d\u8d39\u4e0b\u8f7d\u5e76\u5b89\u88c5 PC \u5ba2\u6237\u7aef\uff0c\u4f7f\u7528 AirScreen\u64ad\u653e\u50a8\u5b58\u5728\u60a8\u7535\u8111\u4e0a\u7684\u89c6\u9891\uff01\n\n**\u8282\u7ea6\u60a8\u7684\u65f6\u95f4\uff01\n\u65e0\u9700\u624b\u52a8\u8bbe\u7f6e180\u00b0 , 360\u00b0 \u62163D \u5de6\u53f3\u3001\u4e0a\u4e0b\u7b49\u7acb\u4f53\u6a21\u5f0f\uff1b \u5f53\u60a8\u6253\u5f00\u89c6\u9891\u65f6\uff0cSKYBOX VR \u4f1a\u81ea\u52a8\u4e3a\u60a8\u8bc6\u522b\u6b63\u786e\u7684\u683c\u5f0f ( 180\u00b0 /200\u00b0/ 360\u00b0 / 2D / 3D )\u3002 \n\nSKYBOX VR \u63d0\u4f9b\uff1a\n1. \u652f\u6301\u64ad\u653e\u9ad8\u5206\u8fa8\u7387\u548cHDR \u89c6\u9891\n2. \u652f\u6301\u64ad\u653e\u56fe\u7247\n3. \u652f\u6301 USB \u8bbe\u5907\n4. \u652f\u6301\u5916\u90e8\u5b57\u5e55\uff08\u5e26\u6709\u6837\u5f0f\u548c\u52a8\u753b\u6548\u679c\uff09\u548c\u81ea\u5b9a\u4e49\u7f29\u7565\u56fe\n5. \u652f\u6301\u97f3\u9891/\u5b57\u5e55\u8f68\u9053\u540c\u6b65\n6. \u81ea\u52a8\u8bc6\u522b\u89c6\u9891\u76843D/VR\u683c\u5f0f\n7. \u652f\u6301\u624b\u52bf\u8ffd\u8e2a\u3001\u5934\u90e8\u8ffd\u8e2a\uff08\u9501\u5c4f\uff09\n8. \u8d85\u68d2\u7684VR \u5f71\u9662\u573a\u666f\n9. \u9ad8\u7ea7\u8bbe\u7f6e\uff1a\u66f2\u9762\u5c4f\u5e55\u3001\u5bbd\u9ad8\u6bd4\u3001\u8c03\u6574\u8272\u8c03\u3001\u53d8\u901f\u64ad\u653e\u3001\u968f\u673a\u64ad\u653e\u548c\u91cd\u64ad\n\n\u60a8\u53ef\u4ee5\u901a\u8fc7\u4ee5\u4e0b\u6e20\u9053\u8054\u7cfb\u6211\u4eec\uff1a\n\u62a5\u544a Bug \u8bf7\u53d1\u90ae\u4ef6\u5230 support@SKYBOX.xyz \u3002\n\u5b98\u65b9\u8bba\u575b\uff1ahttps://forum.SKYBOX.xyz\u3002\n\u5b98\u65b9 Reddit\uff1ahttps://www.reddit.com/r/SKYBOXVR/\u3002\n\u6b64\u5916\uff0c\u5e38\u89c1\u95ee\u9898\u53ef\u4ee5\u67e5\u770b\uff1ahttps://skybox.xyz/support/\u3002\n\n\u5f00\u542f\u60a8\u7684 SKYBOX VR \u89c2\u5f71\u4e4b\u65c5\u5427\uff01", "short_description": "SKYBOX VR \u662f\u4e00\u6b3e\u80fd\u8f7b\u677e\u64ad\u653e\u4efb\u610f\u89c6\u9891\uff0c\u4e3a\u60a8\u63d0\u4f9b\u6781\u81f4\u7684 VR \u89c2\u5f71\u4f53\u9a8c\u7684\u5a92\u4f53\u64ad\u653e\u5668\u3002\n\n**\u89e3\u653e\u60a8\u7684\u5b58\u50a8\uff01\n\u5728\u540c\u4e00 Wi-Fi \u4e0b\uff0c\u60a8\u53ef\u4ee5\u64ad\u653e\u6765\u81ea\u60a8 UPnP/DLNA/SMB \u5a92\u4f53\u670d\u52a1\u5668\u7684\u6587\u4ef6\u3002 \u60a8\u4e5f\u53ef\u4ee5\u8bbf\u95ee www.SKYBOX.xyz\uff0c\u514d\u8d39\u4e0b\u8f7d\u5e76\u5b89\u88c5 PC \u5ba2\u6237\u7aef\uff0c\u4f7f\u7528 AirScreen \u64ad\u653e\u50a8\u5b58\u5728\u60a8\u7535\u8111\u4e0a\u7684\u89c6\u9891\uff01\n\n**\u8282\u7ea6\u60a8\u7684\u65f6\u95f4\uff01\n\u65e0\u9700\u624b\u52a8\u8bbe\u7f6e180\u00b0 , 360\u00b0 \u62163D \u5de6\u53f3\u3001\u4e0a\u4e0b\u7b49\u7acb\u4f53\u6a21\u5f0f\uff1b \u5f53\u60a8\u6253\u5f00\u89c6\u9891\u65f6\uff0cSKYBOX VR \u4f1a\u81ea\u52a8\u4e3a\u60a8\u8bc6\u522b\u6b63\u786e\u7684\u683c\u5f0f\u3002 "}, {"images": {"nodes": [{"file_name": "20221226-151210.png
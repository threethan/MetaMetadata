5/38974780_471491136923512_1332548899625238528_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fTSK7IE1ZkQ7kNvwHqy-WK&_nc_oc=Ado0ZouSe-C0RQbUJCHbju4n77oZyx9rj7-t2B370dGDE3ufT5Y88_D83Ql-9zCMiIA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1V4vgaqZq27AMTd7auf9QfvT4NNq8WgCyoo4XndwS0w&oe=6B09CD2F"}, {"file_name": "migrated_image.png", "id": "313730622923359", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974837_1114440005388601_5831688267883347968_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLmXHXRk8CMQ7kNvwHOgyYR&_nc_oc=AdqBhJcVnsPaDPJCWeLzKn2HGKGAJpuorc2eDctWoC36F2vGdq9ytqnmOxqyBU8GJ_4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjdCuj7EaVbknl9s8_Fk5rno8W2P6vPIPG8QmL5Ndbiw&oe=6B09BB94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NGpzGp", "id": "2085418911749654", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974442_2085418915082987_4306258653352034304_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zedFNsoJstgQ7kNvwGJR_cF&_nc_oc=Adr97Vw5wyGlCaSiP8rW5L7zSgcl2AqvT8rTQ-k3NNRj1POZELIH6yolpnEqal8sRfM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqtzVF90cyZy9fpFo4xNxaLLGWihSFvpWUtLjfldsrcQ&oe=6B09AAEC"}, "display_name": "SKYBOX VR Video Player", "keywords": ["Player", "Movie", "Video", "Tool", "VR"], "long_description": "SKYBOX is an ultimate local VR video player which supports video playback from local storage and network shared servers. \n\nAny Feedback is highly appreciated: \nBug Report & Join Beta Testing to support@SKYBOX.xyz \nDiscussions: https://forum.SKYBOX.xyz \nFAQ: https://SKYBOX.xyz/en/support/ \n\nWith SKYBOX, enjoy videos from your UPnP/DLNA media server or SMB share in the same Wi-Fi. A easy-to-set-up PC Client is available to support streaming from PC = Save your Storage! \nNo need to manually set the stereo mode such as 180\u00b0 or 3D side-by-side; SKYBOX would recognize the correct format for you = Save your Life! \n\nFeatures include: \n1. Automatically recognize video stereo mode ( 180\u00b0 / 360\u00b0 / 2D / 3D ). \n2. AirScreen: stream videos to multiple headsets (download here: https://SKYBOX.xyz/en/download/)\n3. Support DLNA media servers and SMB (1.0 & 2.0) shares. \n4. 5K local and streaming playback. \n5. Simple and intuitive UI; Spectacular VR environment. \n\nRelax and enjoy SKYBOX :)", "short_description": "SKYBOX is an ultimate local VR video player which supports video playback from local storage and network shared servers. \n\nWith SKYBOX, enjoy videos from your UPnP/DLNA media server or SMB share in the same Wi-Fi. A easy-to-set-up PC Client is available to support streaming from PC = Save your Storage! \n\nNo need to manually set the stereo mode such as 180\u00b0 or 3D side-by-side; SKYBOX would recognize the correct format for you = Save your Life!"}]}, "developer_name": "SKYBOX STUDIO", "developer_privacy_policy_url": "https://skybox.xyz/en/privacy-policy/", "developer_terms_of_service_url": "https://skybox.xyz/en/terms-of-use/", "publisher_name": "SKYBOX STUDIO", "support_website_url": null, "website_url": "https://SKYBOX.XYZ/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "MEDIA_PLAYER", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "en_US", "fr", "de", "ja", "ko", "ru", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30251
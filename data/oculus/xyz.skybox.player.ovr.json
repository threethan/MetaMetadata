c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvaGaEiPO-0Q7kNvwFYEARd&_nc_oc=AdphlDY5vHhTjwHTHUxaSzIOrPCzmAV2TSoG37Rt-nlV6q5cG127rG8Fms2yhLaRUpQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5BrhAQO7y47zCHnRgZ6yX1Q7Egsdfa3Qw7WYJtH16MA&oe=69D106EB"}, {"file_name": "migrated_image.png", "id": "210331890203975", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974765_1163656613803088_7423218034690490368_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5g_78KgZCYQ7kNvwGojDgp&_nc_oc=AdphlHmeo4BAKsoebyy07lulGgKqCTxFojPpfrhKMFTvtmLcJkwnfVnGk_ODKOlSuKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtcOdh1gGlb1PfJ-v0wgQX7o7KMqA8n-ZOfh0j3_oLqg&oe=69D103B3"}, {"file_name": "migrated_image.png", "id": "212643386505978", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974780_471491136923512_1332548899625238528_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASnS_J3jxTgQ7kNvwGWhZL_&_nc_oc=AdpIoJbmPXiF6Hw9UOKquDntxFH4xAYmtLh-qnHQVFdP-_62g-qzWnLl5uWcODTQYWc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbC5bTdxlSbTBGsYXI1xQbS8_MU59Lo2cttieh5L-Jjg&oe=69D1216F"}, {"file_name": "migrated_image.png", "id": "211009170111760", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974837_1114440005388601_5831688267883347968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMoJChvKyM4Q7kNvwFEZOrS&_nc_oc=AdqrVIL27fVnhOxh7mZoIn-uIgT4JwO538-xhJASVm1zHKtG2bddJ1lwWu3St1aviTA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwen_48Due9ETWm4JbqVRST0EPXuPyB4kk8N-k887gQGA&oe=69D10FD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot-1.png", "id": "436373894241420", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982721_436373897574753_6581139124199797604_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9T9UKOgWhM4Q7kNvwGAkfAF&_nc_oc=AdrimnnxJ_5ij07pAB6_SXq5PySk7ZhhwjMkePKWWOr2-eTSFLZJq_SUSxD1scIjhx8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwiDm8beZFBzwjGRzKPBaLpB7s3VQ1nxbaH6oCy63Vt-w&oe=69D1182B"}, "display_name": "SKYBOX VR Video Player", "keywords": ["Player", "Movie", "Video", "Tool", "VR"], "long_description": "SKYBOX is an ultimate local VR media player which plays anything easily for all headsets and loved by VR users since 2016. \n\n**Play anything\nSKYBOX supports a variety of video formats, including AV1, MP4, MKV, MOV, TS, WEBM, and many others. You can enjoy normal 2D contents, 3D contents in Side-by-Side and Top-Bottom format, VR180\u00b0, 360\u00b0, 200\u00b0 , 220\u00b0 contents in SKYBOX. \n\n**Save your Storage!\nWith SKYBOX, enjoy videos from your UPnP/DLNA media server or SMB share in the same Wi-Fi. An easy-to-set-up PC Client is available for free download on www.SKYBOX.xyz to support streaming from PC.\n\n**Save your Time! \nNo need to manually set the stereo mode such as 180\u00b0 or 3D side-by-side; SKYBOX would automatically recognize video stereo mode ( 180\u00b0 /200\u00b0/ 360\u00b0 / 2D / 3D ) for you.\n\nFeatures include: \n-Supports playing high resolution and HDR videos\n-Supports playing pictures\n-Supports USB devices\n-Supports external subtitles(with stylings and animated effects) and custom thumbnails\n-Supports audio/subtitle track synchronization\n-Automatically recognizes the 3D/VR format of videos\n-Support hand tracking, and head tracking(Lock Screen)\n-Offers great immersive VR environments\n-Advanced settings: curved screen, aspect ratio, color toning, variable-speed playback, shuffle & repeat videos\n\nAny Feedback is highly appreciated: \nBug Report to contact@skybox.xyz \nDiscussions: https://forum.skybox.xyz \nReddit: https://www.reddit.com/r/SKYBOXVR/\nFAQ: https://skybox.xyz/support/\n\nRelax and enjoy SKYBOX :)", "short_description": "SKYBOX is an ultimate local VR media player which plays anything easily for all headsets.\n\n**Save your Storage!\nWith SKYBOX, enjoy videos from your DLNA media server or SMB share in the same Wi-Fi. An easy-to-set-up PC Client is available for free download on www.SKYBOX.xyz to support streaming from PC.\n\n**Save your Time! \nNo need to manually set the stereo mode such as 180\u00b0 or 3D side-by-side; SKYBOX recognizes the correct format for you."}]}, "developer_name": "SOURCE TECHNOLOGY", "developer_privacy_policy_url": "https://skybox.xyz/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "SOURCE TECHNOLOGY", "support_website_url": null, "website_url": "https://SKYBOX.XYZ/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "MOVIE", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "ko", "en", "fr", "es", "zh_TW", "en_US", "zh_HK", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8536037539828107"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974873_3189954064649672_5394929746498455762_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NFzCJEEQiUQ7kNvwFPH1N_&_nc_oc=Adp2FDKXlqLNc0XsdLRld8Y0-uW_K941PgR0qJK32oHg0wUunLTRsDfXzh6pdz_KuPk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyrmoox9GjncWkAU1C9afKC3vrIg5VfuqXEMRytrmY5IA&oe=69D11752"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SKYBOX VR Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "conte
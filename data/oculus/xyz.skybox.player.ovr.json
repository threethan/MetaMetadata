Fi. A easy-to-set-up PC Client is available to support streaming from PC = Save your Storage! \n\nNo need to manually set the stereo mode such as 180\u00b0 or 3D side-by-side; SKYBOX would recognize the correct format for you = Save your Life!"}]}, "developer_name": "SKYBOX STUDIO", "developer_privacy_policy_url": "https://skybox.xyz/en/privacy-policy/", "developer_terms_of_service_url": "https://skybox.xyz/en/terms-of-use/", "publisher_name": "SKYBOX STUDIO", "support_website_url": null, "website_url": "https://SKYBOX.XYZ/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "MEDIA_PLAYER", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "en_US", "fr", "de", "ja", "ko", "ru", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "302511098585776"}}]}, "scheduled_offers": {"count": 29, "nodes": [{"status": "PUBLISHED", "id": "3242501169286223"}, {"status": "PUBLISHED", "id": "1505391467900867"}, {"status": "PUBLISHED", "id": "788340320717001"}, {"status": "PUBLISHED", "id": "1146541014259454"}, {"status": "PUBLISHED", "id": "1097339415908101"}, {"status": "PUBLISHED", "id": "1831974114062338"}, {"status": "CANCELLED", "id": "1120436016792586"}, {"status": "PUBLISHED", "id": "1022197906538928"}, {"status": "PUBLISHED", "id": "1201905308317133"}, {"status": "PUBLISHED", "id": "447069884724671"}, {"status": "PENDING", "id": "696210279174464"}, {"status": "PUBLISHED", "id": "1372048839917342"}, {"status": "PUBLISHED", "id": "237
SA12KdvD01F8OyPvQ&oe=6B09B2BE"}, {"file_name": "migrated_image.png", "id": "2632868200313859", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982527_785237071846400_7346281001322020864_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii8TcmTSSJAQ7kNvwG53T5n&_nc_oc=AdoQSEFqc0aOr_k2V_AlZf67EPTvqjPSk1oO1H2SdkpDkpwZulT87t6PgPlzWN5fS-E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuX1l-DAhoAbTYQdCwlPsSgDgmtr-G33BKiAMy7jkbIQ&oe=6B09B2AB"}, {"file_name": "migrated_image.png", "id": "210331890203975", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974765_1163656613803088_7423218034690490368_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaO2RwKF5wUQ7kNvwH-QOqY&_nc_oc=Ado3oOcwjkNOd39NLugpklvW41eMfTyhH5rlTxVmqiOV-r0p2b84L6wWjqtj8fyJREI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHkqY8MC2YU3ApX47JoXTXV8-V35ZAfU33OcB9Htk8hQ&oe=6B09AF73"}, {"file_name": "migrated_image.png", "id": "212643386505978", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974780_471491136923512_1332548899625238528_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fTSK7IE1ZkQ7kNvwHqy-WK&_nc_oc=Ado0ZouSe-C0RQbUJCHbju4n77oZyx9rj7-t2B370dGDE3ufT5Y88_D83Ql-9zCMiIA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1V4vgaqZq27AMTd7auf9QfvT4NNq8WgCyoo4XndwS0w&oe=6B09CD2F"}, {"file_name": "migrated_image.png", "id": "211009170111760", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974837_1114440005388601_5831688267883347968_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLmXHXRk8CMQ7kNvwHOgyYR&_nc_oc=AdqBhJcVnsPaDPJCWeLzKn2HGKGAJpuorc2eDctWoC36F2vGdq9ytqnmOxqyBU8GJ_4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjdCuj7EaVbknl9s8_Fk5rno8W2P6vPIPG8QmL5Ndbiw&oe=6B09BB94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot-1.png", "id": "436373894241420", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982721_436373897574753_6581139124199797604_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tyz1_V5wCEQ7kNvwHY7hLH&_nc_oc=AdqDEcsg24cdnXFcXkFtDCd2qS77ZQB487pUKLwG5OgMTa3kLaC7V_AuvFMUdNC4VvA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxR1PpAFpUUuuXl0WV9JHBAL4IPcLvNPM_a83otRzXFA&oe=6B09C3EB"}, "display_name": "SKYBOX VR Video Player", "keywords": ["Player", "Movie", "Video", "Tool", "VR"], "long_description": "SKYBOX is an ultimate local VR media player which plays anything easily for all headsets and loved by VR users since 2016. \n\n**Play anything\nSKYBOX supports a variety of video formats, including AV1, MP4, MKV, MOV, TS, WEBM, and many others. You can enjoy normal 2D contents, 3D contents in Side-by-Side and Top-Bottom format, VR180\u00b0, 360\u00b0, 200\u00b0 , 220\u00b0 contents in SKYBOX. \n\n**Save your Storage!\nWith SKYBOX, enjoy videos from your UPnP/DLNA media server or SMB share in the same Wi-Fi. An easy-to-set-up PC Client is available for free download on www.SKYBOX.xyz to support streaming from PC.\n\n**Save your Time! \nNo need to manually set the stereo mode such as 180\u00b0 or 3D side-by-side; SKYBOX would automatically recognize video stereo mode ( 180\u00b0 /200\u00b0/ 360\u00b0 / 2D / 3D ) for you.\n\nFeatures include: \n-Supports playing high resolution and HDR videos\n-Supports playing pictures\n-Supports USB devices\n-Supports external subtitles(with stylings and animated effects) and custom thumbnails\n-Supports audio/subtitle track synchronization\n-Automatically recognizes the 3D/VR format of videos\n-Support hand tracking, and head tracking(Lock Screen)\n-Offers great immersive VR environments\n-Advanced settings: curved screen, aspect ratio, color toning, variable-speed playback, shuffle & repeat videos\n\nAny Feedback is highly appreciated: \nBug Report to contact@skybox.xyz \nDiscussions: https://forum.skybox.xyz \nReddit: https://www.reddit.com/r/SKYBOXVR/\nFAQ: https://skybox.xyz/support/\n\nRelax and enjoy SKYBOX :)", "short_description": "SKYBOX is an ultimate local VR media player which plays anything easily for all headsets.\n\n**Save your Storage!\nWith SKYBOX, enjoy videos from your DLNA media server or SMB share in the same Wi-Fi. An easy-to-set-up PC Client is available for free download on www.SKYBOX.xyz to support streaming from PC.\n\n**Save your Time! \nNo need to manually set the stereo mode such as 180\u00b0 or 3D side-by-side; SKYBOX recognizes the correct format for you."}]}, "developer_name": "SOURCE TECHNOLOGY", "developer_privacy_policy_url": "https://skybox.xyz/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "SOURCE TECHNOLOGY", "support_website_url": null, "website_url": "https://SKYBOX.XYZ/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "MOVIE", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "ko", "en", "fr", "es", "zh_TW", "en_US", "zh_HK", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8536037539828107"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974873_3189954064649672_5394929746498455762_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOcSeaKg7MAQ7kNvwF748pd&_nc_oc=AdrZ0gEzSzqFKVVC-y2LWYtIKSY3Oguz4p1oWdUbpgsj6UmY8jeG
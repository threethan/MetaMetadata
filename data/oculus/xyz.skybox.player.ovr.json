&_nc_ohc=9tXytwN6m3MQ7kNvwEssT3Z&_nc_oc=AdrQSR5ueFQxhRxMfBNzSUSWwlzy5ZtTpnEI-6jpvc3do-r7vaCv6HZBWkZDciVeQzQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzfWx3qDvRQeRkDklgudCSTCwPCygJZOQ2UQns2saNV1A&oe=69C134EB"}, {"file_name": "migrated_image.png", "id": "210331890203975", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974765_1163656613803088_7423218034690490368_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMHWOGVCvZEQ7kNvwHmo3cy&_nc_oc=Adrp3Hb8TxnfgYqWAVshkCneChZnuUrFv-WXQY17WK8y5OjigQm0zHL_XnkjYll94Mw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwyMienpqXXqkAzzzPda7-9ykTqNkKlBka0B82voZgSZg&oe=69C131B3"}, {"file_name": "migrated_image.png", "id": "212643386505978", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974780_471491136923512_1332548899625238528_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9t2Jk9__pCsQ7kNvwGMeUh3&_nc_oc=Adq1smitX7dZg6gR-T_SAwCL5pFJMz2onr8gQleWHS8uV_PMA15NS8IGLeMUxQlBnRU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afxvmn5wi0f8H4PMYsshYUX4yc8A79s44HUF1HGCk0mmaA&oe=69C14F6F"}, {"file_name": "migrated_image.png", "id": "211009170111760", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974837_1114440005388601_5831688267883347968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbqCI5bW31EQ7kNvwHl-fr9&_nc_oc=AdrENXt8VNT0D9h4lxDsp8Dnf0aOCiJfPCHLeiufPje-omyWW0FIxxO5E5aRw9li9xs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzKEjbvchglu9x9y_IY9ooKnEUkb7C0KHHW5zfl700yvA&oe=69C13DD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot-1.png", "id": "436373894241420", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982721_436373897574753_6581139124199797604_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05lOanaiZOEQ7kNvwEZtBgt&_nc_oc=Adr23yU3UI_F7UGDRExs2DbDy7S2_41GQtNN3Kf57zwMqc__xA0U8Uk5NQXOBAzBjOc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRBfx-dfni0If5EYmRYtEWuEHd8plgbVCXkAQUeA0IYw&oe=69C1462B"}, "display_name": "SKYBOX VR Video Player", "keywords": ["Player", "Movie", "Video", "Tool", "VR"], "long_description": "SKYBOX is an ultimate local VR media player which plays anything easily for all headsets and loved by VR users since 2016. \n\n**Play anything\nSKYBOX supports a variety of video formats, including AV1, MP4, MKV, MOV, TS, WEBM, and many others. You can enjoy normal 2D contents, 3D contents in Side-by-Side and Top-Bottom format, VR180\u00b0, 360\u00b0, 200\u00b0 , 220\u00b0 contents in SKYBOX. \n\n**Save your Storage!\nWith SKYBOX, enjoy videos from your UPnP/DLNA media server or SMB share in the same Wi-Fi. An easy-to-set-up PC Client is available for free download on www.SKYBOX.xyz to support streaming from PC.\n\n**Save your Time! \nNo need to manually set the stereo mode such as 180\u00b0 or 3D side-by-side; SKYBOX would automatically recognize video stereo mode ( 180\u00b0 /200\u00b0/ 360\u00b0 / 2D / 3D ) for you.\n\nFeatures include: \n-Supports playing high resolution and HDR videos\n-Supports playing pictures\n-Supports USB devices\n-Supports external subtitles(with stylings and animated effects) and custom thumbnails\n-Supports audio/subtitle track synchronization\n-Automatically recognizes the 3D/VR format of videos\n-Support hand tracking, and head tracking(Lock Screen)\n-Offers great immersive VR environments\n-Advanced settings: curved screen, aspect ratio, color toning, variable-speed playback, shuffle & repeat videos\n\nAny Feedback is highly appreciated: \nBug Report to contact@skybox.xyz \nDiscussions: https://forum.skybox.xyz \nReddit: https://www.reddit.com/r/SKYBOXVR/\nFAQ: https://skybox.xyz/support/\n\nRelax and enjoy SKYBOX :)", "short_description": "SKYBOX is an ultimate local VR media player which plays anything easily for all headsets.\n\n**Save your Storage!\nWith SKYBOX, enjoy videos from your DLNA media server or SMB share in the same Wi-Fi. An easy-to-set-up PC Client is available for free download on www.SKYBOX.xyz to support streaming from PC.\n\n**Save your Time! \nNo need to manually set the stereo mode such as 180\u00b0 or 3D side-by-side; SKYBOX recognizes the correct format for you."}]}, "developer_name": "SOURCE TECHNOLOGY", "developer_privacy_policy_url": "https://skybox.xyz/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "SOURCE TECHNOLOGY", "support_website_url": null, "website_url": "https://SKYBOX.XYZ/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "MOVIE", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "ko", "en", "fr", "es", "zh_TW", "en_US", "zh_HK", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8536037539828107"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974873_3189954064649672_5394929746498455762_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SE9-Lr05anwQ7kNvwFR97tL&_nc_oc=AdoZlna2P9Gs4NA8Din-il-7IgVTj_HVynvYSArnJAIUxSzEIa7EwUIpf5ELAKHzyN8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3xATvDFBrbYBAU7ws5IjWIFCtNQVhhcxHO4tEaSjfeA&oe=69C14552"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SKYBOX VR Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215
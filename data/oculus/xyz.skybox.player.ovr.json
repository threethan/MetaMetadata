gJgViBeFnPgZkjyDGNUbgW64x6lJtU59Sb4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsHPygvaMwqCQJBb6vwL8lYIvcLQqtLezL05GdM7ELYBw&oe=699AF96B"}, {"file_name": "migrated_image.png", "id": "210331890203975", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974765_1163656613803088_7423218034690490368_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMOd3X6ESo8Q7kNvwF5aNo1&_nc_oc=Admuvpi6-jxSPRROLIE-VcHORLkquospgGrs1bVpuiYGK1vn1OivVi3wcsPupAmxEwY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsvbRW7vHRl2tJ1DiF43-tAybzzgSqUS0dO3dJQKci5rw&oe=699AF633"}, {"file_name": "migrated_image.png", "id": "212643386505978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974780_471491136923512_1332548899625238528_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3pL6X-QvtoQ7kNvwHV_qYq&_nc_oc=AdlNUVaIQh8zZVslTNwDuAJ3RMzZ6Derks3HwoEPjb7BX2GUqTqjDYjn6-RhPQ6gOys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvpJjD9zOODE4lFuSuxAhHLhLxSlY2Ruk1aYep6S86sIg&oe=699B13EF"}, {"file_name": "migrated_image.png", "id": "211009170111760", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974837_1114440005388601_5831688267883347968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sb5AFcXloSMQ7kNvwGvtwtk&_nc_oc=AdnPQSYOaSfXcyIQOiZ6P6r-RL7n7g_M-vZ2zo5HP3nA71gv8uYzuFlRCSqNwZAbY10&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvNyLF9zk5xHTL9v7wbGNzfP1PP9gms2c15QoGMUkUbTw&oe=699B0254"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot-1.png", "id": "436373894241420", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982721_436373897574753_6581139124199797604_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kDR9ELkHfsQ7kNvwF7lPfT&_nc_oc=Adn91czT0xQ1BeNS7v8nzDj37FPmGeLz4JU7ynwbZgXO7y3PcD9TWFl4weKtAaE5lho&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsHHtidfye39IHcwGCDpq6nbec1NBtqAFM5TdivNtnuIg&oe=699B0AAB"}, "display_name": "SKYBOX VR Video Player", "keywords": ["Player", "Movie", "Video", "Tool", "VR"], "long_description": "SKYBOX is an ultimate local VR media player which plays anything easily for all headsets and loved by VR users since 2016. \n\n**Play anything\nSKYBOX supports a variety of video formats, including AV1, MP4, MKV, MOV, TS, WEBM, and many others. You can enjoy normal 2D contents, 3D contents in Side-by-Side and Top-Bottom format, VR180\u00b0, 360\u00b0, 200\u00b0 , 220\u00b0 contents in SKYBOX. \n\n**Save your Storage!\nWith SKYBOX, enjoy videos from your UPnP/DLNA media server or SMB share in the same Wi-Fi. An easy-to-set-up PC Client is available for free download on www.SKYBOX.xyz to support streaming from PC.\n\n**Save your Time! \nNo need to manually set the stereo mode such as 180\u00b0 or 3D side-by-side; SKYBOX would automatically recognize video stereo mode ( 180\u00b0 /200\u00b0/ 360\u00b0 / 2D / 3D ) for you.\n\nFeatures include: \n-Supports playing high resolution and HDR videos\n-Supports playing pictures\n-Supports USB devices\n-Supports external subtitles(with stylings and animated effects) and custom thumbnails\n-Supports audio/subtitle track synchronization\n-Automatically recognizes the 3D/VR format of videos\n-Support hand tracking, and head tracking(Lock Screen)\n-Offers great immersive VR environments\n-Advanced settings: curved screen, aspect ratio, color toning, variable-speed playback, shuffle & repeat videos\n\nAny Feedback is highly appreciated: \nBug Report to contact@skybox.xyz \nDiscussions: https://forum.skybox.xyz \nReddit: https://www.reddit.com/r/SKYBOXVR/\nFAQ: https://skybox.xyz/support/\n\nRelax and enjoy SKYBOX :)", "short_description": "SKYBOX is an ultimate local VR media player which plays anything easily for all headsets.\n\n**Save your Storage!\nWith SKYBOX, enjoy videos from your DLNA media server or SMB share in the same Wi-Fi. An easy-to-set-up PC Client is available for free download on www.SKYBOX.xyz to support streaming from PC.\n\n**Save your Time! \nNo need to manually set the stereo mode such as 180\u00b0 or 3D side-by-side; SKYBOX recognizes the correct format for you."}]}, "developer_name": "SOURCE TECHNOLOGY", "developer_privacy_policy_url": "https://skybox.xyz/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "SOURCE TECHNOLOGY", "support_website_url": null, "website_url": "https://SKYBOX.XYZ/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "MOVIE", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "ko", "en", "fr", "es", "zh_TW", "en_US", "zh_HK", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8536037539828107"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974873_3189954064649672_5394929746498455762_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cyDUtPBAYQQ7kNvwFTvj7A&_nc_oc=AdliFzPQza9px5eYGR61k3KvjtBu8IkjdFzHVrWeh9h6m-RgscQ8UGi_gJY9ywKA2m0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsQ9mvjY6YFdFJc6Aypirw0HI8dPpJ9iez6Dl8dEfvkmQ&oe=699B09D2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SKYBOX VR Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1558456200, "lastRevision": {"nodes": [{"id": "775032572858419", "release_type": "MANAGED", "administr
NvwG8bxtm&_nc_oc=AdrolRZrT8_0-LM1J6x6Icn3RRKMdQkRGE2vuXMIN1Hy-q2eRFzwxewHmj8M9tM84Vc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Sk4DMARDgHOnvflU-rM80v2qDY1TM_rAuH2eYnakpGA&oe=69E77B09"}, "display_name": "GoUnlockAlleys", "keywords": [], "long_description": "# GoUnlockAlley\n## Operation Manual\n### Motion Control\n#### Move\n* Forward -------- Controller Stick (Right or Left)\n* Backward ------- Controller Stick (Right or Left)\n#### Turn\n* Right ----------- Controller Stick (Right or Left)\n* Left ------------- Controller Stick (Right or Left)\n### Gaze Control\n* The sight inside the game is controlled by Meta Quest HMD gaze direction.\n### Gun Control\n* Direction --------- Gaze direction\n* Shoot Bomb ------ A (Primary) Button (Right or Left)\n## Description\nYou can have only one item.<br>\nYou can put it in an empty box or the empty table.\nThis game has a lot of stages to do.  \nIf you cleared a stage, your progress would be recorded automatically.  \nYou can start the game from the next stage after that.  \nIf you hoped to return to the 1st stage, you can use \"Egats 1\" gate shown after the second stage.  \nAt first, the gate is blocked by something but you can pass through somehow.\n## Development\nDesign, Planning, Music & Programming by Bunichiroh Fujii\n## Copyright\n\"GoUnlockAlleys\" is developed by Programates Inc. All rights reserved.  \nURL: https://www.programates.net/  \nEmail: info@prorgramates.net  \n## Privacy policy\nhttps://www.programates.net/privacy.html  \n", "short_description": "You've fallen down to a mysterious town.\nThere are lots of buildings but you see no mown.\nSome creatures are hanging around there.\nYou have no idea and may need care.\nYou go up the stairs to the rooftop.\nThe Sun is strong but you have no cap.\nIf you looked around, you may get the full view.\nYou hear sound but nothing is in front of you.\nYou may find some boxes also.\nYour interest in them is so so.\nWhat's in it? \nHow can you use it?\nYou see some keyholes in the ground.\nYou can see no keys around."}]}, "developer_name": "Bunichiroh Fujii", "developer_privacy_policy_url": "https://www.programates.net/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Programates Inc.", "support_website_url": null, "website_url": "https://www.programates.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "26910024761919777"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "919223094135731"}]}, "baseline_offer": {"id": "919223094135731"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772678400, "status": "PUBLISHED", "id": "919223094135731"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27083619724560279", "version": "0.1.10"}, "id": "1410400480564249", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26910024748586445", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27083619724560279"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1410400480564249"}]}, "change_log": null, "created_date
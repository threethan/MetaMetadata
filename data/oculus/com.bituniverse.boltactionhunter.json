, "id": "984432907400634", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/595123887_984432917400633_2527525845287882642_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSPqTw1cYTgQ7kNvwECpprL&_nc_oc=AdqEUC_yTaLLYv7lJX0GhBh8j-MlZl95_PJ3_t25kAmOE-LZ4rYu0xd__IRodpdh9Y8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1kNUzdc2BPZqNyZWtp-c39Gqs3gqCifFr0LpnvYdcZQ&oe=6AF9BF50"}, {"file_name": "03-target-practice.png", "id": "1080685568280965", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831964_1080685571614298_4671324390038520960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPRQnjumOxEQ7kNvwGHYoDI&_nc_oc=AdrpFAnaiHWf7x371p1FFQgvMGRwsU0XdkejSpQFI38snrPfSBm7KmjBTd8TGjYyAOg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStvjpXXIpYiI_ITiSgdNPTyby7lzZz_H3oFrkwM5Rn1Q&oe=6AF9C414"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bolt Action Hunter", "keywords": [], "long_description": "Slow down. Take aim. Enjoy the view.\n\nSettle into a hillside deck overlooking a quiet, stylized valley. Hunt at your own pace with a scoped bolt-action rifle and hunting pistol, work their physical reloads, and chase personal records.\n\nBetween shots, knock over cans, launch a flying disc, toss camp toys or pour yourself a coffee. Optional three-minute hunts add a little challenge whenever you want one.\n\n- Relaxed hunting and target practice from a stationary deck.\n- Deer, boar, bison, foxes, rabbits, ducks and pheasants.\n- Hands-on rifle and pistol reloads with visible guides.\n- Saved records and cosmetic upgrades earned through play.\n- Adjustable table height for seated or standing play.\n- An optional spatial radio for your own local MP3, WAV and Ogg music.\n\nSingle-player. Two tracked controllers required. English. Core gameplay works offline. No ads or real-money in-game purchases.\n\nMusic files are not included. The radio requests optional audio-library access. Protected streaming downloads and other apps' private files cannot be played.", "short_description": "Unwind on a hillside hunting deck. Take your time with scoped weapons, target practice, camp toys, coffee and your own music. Hunt at your pace or try a timed challenge."}]}, "developer_name": "Bit Universe", "developer_privacy_policy_url": "https://bolt-action-hunter.ksavill.chatgpt.site/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Bit Universe", "support_website_url": "https://bolt-action-hunter.ksavill.chatgpt.site/support/", "website_url": "https://bolt-action-hunter.ksavill.chatgpt.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1497574515545961"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1786335085939734"}]}, "baseline_offer": {"id": "1786335085939734"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793051280, "status": "PUBLISHED", "id": "1786335085939734"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1508374027799343", "version": "1.0.0"}, "id": "1426723789606335", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1497574512212628", "is_c
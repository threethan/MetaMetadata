cdn.com&_nc_ss=7f20f&oh=00_Af5iinIcigKKWofAC8WNBCj_PwB9vJtNzl5v64aGWaEAeg&oe=6A130C4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cp57HDvFAEsQ7kNvwEroazW&_nc_oc=AdotZhagqPhVoyrspKiA3_nH8L8cMEbdaaOQyvdixYS7djiSPJqZbcY7ZGiu_sZWVA8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mcfFEfsABHCq-TKM4En-c-4vE-pTv4QhyL03RiLC7GA&oe=6A12EB61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zGH3xQYXlQQ7kNvwHZsTXE&_nc_oc=AdoZYosD301S-_gsNsGhFHXa5u7RLCCyLLrKcnFuFgEIidrPiI20YLM-dual0J6F3SU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DwA3reFxjV9vDIlp2C18Mv83H4DBaLvpluplF2qXl5g&oe=6A131E5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3AdyO44kqQQ7kNvwETFfZe&_nc_oc=Adq8qqdVoCVRp8H2f2SqHwelnFLhkg_-fnUOP8VGB_OJZ0sCKHPslkC5EZIbWabYLqY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p4jBRCt5RIPd6-manbgd525AgKYVP-2AtM4q-Raf9Zg&oe=6A12FB6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMUX2xLtHs0Q7kNvwFDhq2s&_nc_oc=AdoiHR22JsJKCf064bTq9mDNN5BAdBofb8LQsA7IDR-_2A2CrVXBC5Gk6LcbB2hiFm4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LcXyWvF78OFRdljpaGtENcK5WsOPoVB-jN3Ar6N407w&oe=6A132032"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlwoIJ_eUgYQ7kNvwHFyfOl&_nc_oc=AdolhK38UOABiXM_kx8XIXGhGL10x0eSPmzITiCmaCoV8aU-bk4EUHtndNp3B6j0M-Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42Kisc_fXP1GAdifRB7wKzZHv2qzetw2AXJzWsY9vVSg&oe=6A12EE40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDe-dfEIMzwQ7kNvwGwjAYn&_nc_oc=Adoki-6btjqmNy_Zbp2BlqvOJQW4wHMZ9iNuorNfSMlYNWwtJ-_ExpPTOSv72oZsU3o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rlH5TSXwO_M_B8rA1Rp72T-sOYTdrBydwCmo-6Czshg&oe=6A131
cdn.com&_nc_ss=7f20f&oh=00_AQEW0bqhqq-miGsCU913XdIo1y_WLKr-JAC4E40o0VZzbQ&oe=6A8C1E0E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Jx5oh3TJ60Q7kNvwFkpcRz&_nc_oc=AdrwktMmgLo3vFfeetGU7SX5N-o72maHbo7F46U7MIZvmnzoPqoWOs80DmKv1XN7e6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe-_jQXah--G2b1t9v45EVzOicVUFDCPAJRkt0N8ufKQ&oe=6A8C3561"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vk7Vi0-0f5gQ7kNvwGUT3W3&_nc_oc=AdprDi5BOeXNaWd6F9u1G6IYWYpi3pS7bKvYMEg5p0g2UCPsX9nU9FKrm7ZrR0r5fD0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4k3UyV3wPltBrRedYl3PXp19lzsydsmBme9rc-T5kqg&oe=6A8C301D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgIbllqm7XcQ7kNvwFR3VVU&_nc_oc=AdrCfWRGEqR7bXqhv413GGCalg-vi94P6PrW6261TOnY2KEelgICizJHn36CYFvjlnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0Pvct999xCSIwLFDjpRQ7UK_Fa1EBliJjcd3m5Wt6FQ&oe=6A8C456B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWHvALENbYIQ7kNvwF7-Nt8&_nc_oc=Adqc8TZl4FaMQn_FgvCwa4yEmycGjgOYOsWrCeL7-GBBGuY9dVjaoP2yXmCPUBVisn4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiEt0NxuUKqHxHmxXtrAtZJIKDqlMs1yLuhNAHF0mn9w&oe=6A8C31F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCTIGjOQJbUQ7kNvwEH-XrP&_nc_oc=AdridAE7GyRepCb8kin2G1LJDO0MQzXGm9qBn_07Wg2SuduS_G6A7Mfv01G3xrpXrKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ7PKbiC1DbaT5Adj7ITHZZD4Rcb9iCSeuy_jgewJNmQ&oe=6A8C3840"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQDhwenpbQEQ7kNvwGg3r-o&_nc_oc=Adr2vFvcdyabgkeIzga7nUYzdGqzxkwdnInQxYLgy8YUR0lbA01y8Ys5rT967GRFcWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFzwG8I4SR_MrwOpy4NTEcs0NOYW-1F1pYz7B3cE6zIw&oe=6A8C2
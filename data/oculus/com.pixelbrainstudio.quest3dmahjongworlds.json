cdn.com&_nc_ss=7f20f&oh=00_AQDgW7Z_3AxXxaLCuwkU8aC6p2WpJa3R0pzVRbNDgkUwug&oe=6A676C4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyGNLCAMrcwQ7kNvwF3_yXi&_nc_oc=AdqkEdHWm5OuWnsNQ0ikMH0o08MI_DSKmwzYXp4q-Tm0-2jrfAsOg67ezq7L3ilGnFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCs-DPXrcqxbuAEz7AHD51na2lzFQycpVujtnZPI9YmkQ&oe=6A674B61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbG2DAoFKu8Q7kNvwE3oE5z&_nc_oc=AdqyZZ6pqrF5m7tP8Imh-TWK_V-0cjPfhdooD5cO6xX-ifC8qWGgxXFo3fsMlBQsnKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqCPIFMCSHXbWEGWa7KuKLMvyl7LXQC9BLeePlj6X_LA&oe=6A67461D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTlDET05pwQQ7kNvwGOJnEo&_nc_oc=AdoUS2nm2iWhjIFXDGw-hcG-wvTvJzDataf6gNq4JtUCIQ5BJczBw8d5oj15l7IMxKQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrZCeKYVexrBj8NsRoIzG5OVyB0cWXeA9cGVjGPvWTnQ&oe=6A675B6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1fmIlCaPWEQ7kNvwELO8Gs&_nc_oc=AdqRAwVzQ1GoTKt5VgreWKufEAGmJ7WqaEwc8XRsK2SUnq-b33pIZVMwIM1Gw6SXahk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6K1Yj8NeH5mV0uVpfwRlDjJ1xztcq80JNbt0U77QyTg&oe=6A6747F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcyAtuRnN3kQ7kNvwF2OXew&_nc_oc=Adok8AQNCD3nrkq1M2FK6kGrSJFVgNDJplRx2bH1_uQyAPeJZMUKs9znC2CTaywwwPo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD79FKiL9Iep8yTg0zt4ZaLRQNbHySrkqPYI2FsHAx9Tw&oe=6A674E40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15cAWzF1-F0Q7kNvwFNjiKJ&_nc_oc=AdqQvtiJ6rlvgTT9xyH3YyS2P13LU5nYgN4tyCSLOI0CEvNnNrqATIZPH210BzCGLq0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANtE7kXh7iKj_0Jwnjmzewl__cQxd0XdcMjVy5FrXbwg&oe=6A677
cdn.com&_nc_ss=7f20f&oh=00_Af8_4-hacDlgaPGAc-CiYpgTOp2LVF2kC12mdZ4lQ4FPuA&oe=6A26D2CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awS9DZi-MqMQ7kNvwGJ6m3p&_nc_oc=Adq1eoDN-A08TWbwEn3fQU4EkIFZ5lITGkAi02ILGgIZNp2Dh9wv70HfHuZoDrwZTpw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QvSEaD_0Slpkw0pmDiXdmRIM8-Sh8N1jhqblPXIu5JQ&oe=6A26EA21"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS4J4zKIImEQ7kNvwFaTzir&_nc_oc=AdpqVEixMwr-y0EPLEZQprwrZVIviiKzC9i_oXipjjan6xXzSGdSuXebd151dS73xbE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T16e4BgpD6J_UZASOuizdgiEWFegBSZai4_2FmtVz9Q&oe=6A26E4DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rw-TTJ6RCfIQ7kNvwHC8vsD&_nc_oc=Adr10kBqPjwt9V6bPR8N0rh5gmmIQbRfdEQTI8HMeVBkgWvQvM-CdZ1SllLtoMYhg20&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6J58mbro2l51_ZVLov85lvFpmlvfN2LnxHotkG0tndA&oe=6A26C1EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvsZpmY5QGwQ7kNvwGR_7YB&_nc_oc=AdrLEwvZPo0pbsz9FXhotp9wMcL7RqU7hT-fhSRa-v90V0xAu_8KZUNc3m5oRQjS6cU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XLyMi4fUi3W37sn1GtOBTqOBD8L4OcIQBKMEyrUf4YA&oe=6A26E6B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbRT5hNYWwsQ7kNvwFkoglV&_nc_oc=AdrnilAe3y-6XFr8Sa08c1DKErOU68W9INXJYJxNSn724a5sVfskggnA2-Jb1_Ih8o8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a38g95x3a-wwheZ8rWDG6UCcA9QMzkrJOL7KzJA5RUA&oe=6A26ED00"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdsJ8VYqsUcQ7kNvwHOn6Ur&_nc_oc=AdonLSLie2j5kxwSq4YtSoc_ZndA9cuK2B-4ixO2E2Kin4h9OrlbeqShpwbK1XN8ciE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EyZZO2CWFycXvLcNy21naBQFmEXbBnTvdOajj1mx9Uw&oe=6A26D
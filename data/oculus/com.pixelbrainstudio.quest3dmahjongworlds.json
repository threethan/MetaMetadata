cdn.com&_nc_ss=7f20f&oh=00_AQFGppvKh3n-i9d52aw0nOfLAAdrxjj9I7TwwunOpSJ65Q&oe=6A81920E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuaRhYYLGvcQ7kNvwG6dPJX&_nc_oc=AdpEWjPUvAssW0A18jHN5wJvOaA-xq0Gt9AykpjeaaT1U42GkkYNCztTaVXs0tPArTk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN9tCzBLStwjp-LLtwHFukCjP7ijZdM1Izgl40LMDjyg&oe=6A81A961"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EP5CjsAlwsQ7kNvwGI4PXz&_nc_oc=AdrvK4pu0IfBjmYejSGth5xVPGrUBby7SuPEH6akRNpwc5NQ5Ok9S4wbPSmEh_EUxOs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGo45UUT0TqyzFKnmaCGVKy9Obp7C3W8cZ1b63YN8osKQ&oe=6A81A41D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1mGFy0tnoQQ7kNvwG06NeC&_nc_oc=Adq3wdwhGhrYe3YrRr1jks93_cQDsL30534UsO93FT0B09pWyJaLK7gHbq-c8ug21_g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl3ka4o4TpLYtLXkaNZ_hPRzDEZs_-sRZHIxavQ0sFjg&oe=6A81B96B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbSM4GRcyjMQ7kNvwFY11Jo&_nc_oc=AdrjXIxkc5W-QqF-rLWPj4LVXFK5j0wkg3FG9PJfAR-aatCW5jDZUNnitlRL0dWfyfI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcMUWWjn_pEzLqgb_JQur1ujzOvurLqkIXH23puEAvdg&oe=6A81A5F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeEP6WFx2vEQ7kNvwGACxAk&_nc_oc=Adpp002fG4n63Cn2KcGUM6HQSDI4wduudY8TZyR5ILpCFrjuWZSfMz2QX-JbqU3xESg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ1EelAlaX48X7LsUCpy0LVl2J2C5iX9tft_Uqg0LUmw&oe=6A81AC40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnGkajyJ5lwQ7kNvwF2Sz-N&_nc_oc=AdpM3yuRGEo2Pv9jRbR2dIPthYqHoi_wNV3_5j1BZqe94ooyCtJVvDCMbBQJP3IsQIo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmwR-n1MFgoPgNdwMgmhO2qt0FFFiuy-8HHlF9KWKaVg&oe=6A819
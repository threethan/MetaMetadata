cdn.com&_nc_ss=7a30f&oh=00_AfxjAh7ipou8F94zJatf3JTEN1LauYqfyd_ma81wfqwyNA&oe=69CA89CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhH-V5xdJwYQ7kNvwGUV05w&_nc_oc=Ado8F-JDWTEfV4_cZDQr1da24-QtJOXaR7D7cBzQ4x-Tt3bLEYUQ-UbyTxus_0yTuoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxodnU-qUJyO3cXpzuVcGU_72eUIsQhkeORi4glkmhKRg&oe=69CA68E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_-FEGhf0YMQ7kNvwG6yyNs&_nc_oc=AdoBfNAaE35HvdxRgffzxAT8ncvLSAYjd9ClJOYcaQ0r-US1gdi0ANoq2rXXt2hw11g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrIDl-ijnAXhiPaYY64iO2IBfQv_9KphaP0AhtV2WQHA&oe=69CA639D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7vAFeMO6J8Q7kNvwEbf8uL&_nc_oc=Adpe_3NlDuYGxkxqPydMPacq13CL8oz38E5nu5TvEcVXR9UScYTvM2ZGKYKcD2NTWGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0wgVmuPMFUU9MWxCoLB5KwH2k4uikxmTyyjpdtNKr0Q&oe=69CA78EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByjZLE31aLIQ7kNvwG8LV6c&_nc_oc=AdpNr4H2wyt9qe08ur-249S_IleHpAvdsdnR7O1DNtgIchL09ZUQmhMm7i4oTnLFMlo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-d_cRsgHwJN6klWVcdvMJq6DVh-2UzGtjMKIxmDPUdA&oe=69CA6572"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6A3_zFpi6WQQ7kNvwGrUPia&_nc_oc=Adqwv-m1wXre-gsgAev-MvKCIIOVq4yBKhYQ1TgWBz494VqA7wEDzX4t_V8IdIkcyho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOgv_k9QhgLif2ALg7w4stsZO3FmEvsX0QlCPKaAGBSg&oe=69CA6BC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9g0TzA5PwD0Q7kNvwHfZ1LS&_nc_oc=AdqCnfg2tfVDdF6bGDf3EPmgizamM5CoTy2-JjNdcsNb9pqhh3IOCTa1amhnprPFhMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw29mJJEfILvlGZcvBXlsqqTLkqPNl7kvgJjLY8ARpheg&oe=69CA5
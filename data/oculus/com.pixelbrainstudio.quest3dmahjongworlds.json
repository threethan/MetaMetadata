cdn.com&_nc_ss=7f20f&oh=00_AQFDlHvGhpeevT6XiBDzmXX_nyqa2RIUzFnPOmfhr9jFvA&oe=6A7349CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMf0xVqIYsUQ7kNvwFvb9Mt&_nc_oc=AdrMVJEtVz1I0MRBTCvIZTa3ZwAId0zHCQvb1qf46jfJJ62cmCNJn8V3wr3WuSuB6VM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUiPKTXHUf7xO0YLnVOpubTjUU624uVwZ_N4r_Gy0ZGg&oe=6A7328E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EOHxlyW3EEQ7kNvwE6UCOL&_nc_oc=AdqSxXzIQidsy9yMLyV6NshIU5Sgps-5FnjNda5donj2lCyWeXSelbMJ_A3zuPHbwvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf05L-RvMIzmNDzD7Zwe15s_RyXeKo2l2Tlw8CM0uaBg&oe=6A73239D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0Zi2tbpfukQ7kNvwFBJICi&_nc_oc=AdquwLu4oeJBAXruU85pBEo78sbnIUghUnWJV0ahlCqn3a2Z33DPcrCV_M3AO4fGh2A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoFeRppcbk8gsprQiMWM0KFUAmAgDRVsyxS56xGzbceQ&oe=6A7338EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-FaMvTewRcQ7kNvwHUlTIO&_nc_oc=Ado8ZFUyEFBCqqb9eedWCLP6kzz1OhI_k00wyWKQJOhzw1KfcZRBCF0Bq_FrpehHu94&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF59sXdbPYxiwPr0mm777nSE9NWNyCvYXYmxAi29rl9Mg&oe=6A732572"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBFoJR7lPakQ7kNvwHEewCR&_nc_oc=AdqM46q7-vIOchAQo9ltRfwhe6Tq96TJCVVbwnDWhyeXolPvaacXMZ4dlU8dxJJdbiM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3hRZfF8iP1QJRjvcyYJ82GUMjoihF1oyj0zR00BOFuw&oe=6A732BC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJPpX6RKtqkQ7kNvwELknms&_nc_oc=Adp3pYoRl2na0pgnT-HdAtsvpOYcxBeOx0fXv3rdBFCdLaSqJ_8UEXGbi2FrY4OVlP0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER0cwqUZ0y3qALdFxC7C3AoC3gm5NaK7zRO2nBXIPvwg&oe=6A735
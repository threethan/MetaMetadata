1.oculuscdn.com&oh=00_AfvOeLYDisVrhwUzqaE16rHcLugq_oSTIo5_73ic3HnhlQ&oe=69985FEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSCUlj_QDooQ7kNvwFjwmf0&_nc_oc=AdnWcL-gSITbv0zS0o8aHsv3KvcSRIvIItUKISMBzVCXOo7dGPFNP7xSXOPpbWX_tPg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuJoqdcGJAF4AsSm-MTRgxJsS62V4gM3tzZ0bbaLF9zvw&oe=69984C72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}]}, "developer_name": null, "developer_privacy_policy_url": "http://pixelbrainstudio.com/privacy/oculus/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Pixelbrain Studio", "support_website_url": "https://pixelbrainstudio.com/support/", "website_url": "http://www.pixelbrainstudio.com/", "category": "GAMES", "comfort
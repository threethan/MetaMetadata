.com&_nc_ss=7f20f&oh=00_AQSxUWAEwJtuv9XwsZ8CK8SYkiiaKKBjNA8QwY5PaWmKYQ&oe=6AEB424E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcrN3ERJEXwQ7kNvwGwm507&_nc_oc=AdrrJ1Li6X0VYqP6XHzEdItYZWqgc0vqr9T1N0HsbitT4tqO7NaPPHPHPM_gwqkOc1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR57BgMkQ4zLKB0vdkk9_CvLGvKcuiQbqEEslrF2QRpA&oe=6AEB59A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W7Jg-24aVAQ7kNvwEHjyJ6&_nc_oc=AdrGTKrhJS_Kl3wjTe6hF5fBcSCQ4wxxV6DoXkdnWPGx6xyXxJiN2XbVDiWtjorHD1s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXoOgJ_3sn4kbBm6NgaigPOoKwXZ-6fht-DkVB_ybSrw&oe=6AEB545D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zOtZIPJ0w8Q7kNvwFnB3J4&_nc_oc=AdpRMFql02jVjKKT9tOUiCx9btBcVh9eZrzwc0sxpk2mfFE5Yh13vWqMSihmR1YO638&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT51SoTxXYDrQDoEE7Wnde1lzSDufwgTq2zvejerl74Sg&oe=6AEB316B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DY5mrcNFXwQ7kNvwH0LbND&_nc_oc=AdqTQOkKC_fIqP1m3vwJrP3pUtC3h-0XJJvCfxxSxEal7UdSPeaZwFBnHDeKueZvLHQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMcSt6JKEIfuqPEqdHsrMz4GKxjx4n5tW8hyvhyUtIzg&oe=6AEB5632"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHoGjKRomp4Q7kNvwGABIzP&_nc_oc=AdoUjdYb2blM89SJJe5Q4uVnG947Y3H13iUujgT3zuGMyY3JaIgB-YxvfsaS05ktAZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQohjJQbVnbDwNKVd1IBRYjMAGeZyXD-D_0Sz2nMn7yTA&oe=6AEB5C80"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slkzSb_7NlEQ7kNvwHBmyz1&_nc_oc=AdpFPcXKxxNAAsawiQia-6GFDyGDsmywlvxGZy4MIu2KYNCIW0epHT6oB1LS169-FpM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW_xVBTKnFFEN2Yyl9swdXg2dZfz1sIdCBKAJingK4Aw&oe=6AEB4D2B
cdn.com&_nc_ss=7f20f&oh=00_AQEjjkXY8sHCvcM13-LsD9alkI3woAayMZfFO2YCNd32wA&oe=6A84350E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFFpqyEsH4oQ7kNvwE4SFez&_nc_oc=AdquaWgXLnL-d93t1FrIf6kJEFYzMW4uphoiLEZ6WjJ760JJI-kwQQSUboA8xK3r1M4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsgL1eLbioAUFi1mRaCDyBeOCw47jwdLhSs_bowouwWQ&oe=6A844C61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cn8wOhUXoYEQ7kNvwFroFna&_nc_oc=AdrocbPECqIl6hDbJkTCZ2ZXv3BZPOsq7p75HeTgKXulCGlEAfopchljWPXlCm_9xlA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa2paPpY34YWMH4fY-0IdpwMYiR74jzFcmokjMTvUmGQ&oe=6A84471D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmFmJKIer18Q7kNvwG-g67N&_nc_oc=AdoOimMkcHrs_e5_JssmBYjA4R9Z_ehLRpVLTTrlqpRE0aIkFFt28XZRBc-FeIxGClA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeC6jiwIgdak_6g08VbxGbNmTzMz1XeiWR-IFxQTyqxA&oe=6A845C6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbSM4GRcyjMQ7kNvwG_qkCx&_nc_oc=AdpnqZumXQ6Wt8VKHYF8MsJcGVlsOuzIadYQuSFTGat0YdyPG5M3HkFVZ917fO3om48&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvyF3v_yXhtdRSsqmzFdshMX2-yIufbGMwbhS1tD6iaQ&oe=6A8448F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cALzupbw3YQ7kNvwGMXl8w&_nc_oc=AdpbI4qesXZnJCiAVPvtd2iZ8xq3U27cI6nZGSW-NBUZ96aoa9HMGXvQRZvqo8UIkQU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsbCuNfSmCfQvNis0oDdIXRDlR72tcnbBTn-UNcMyCLQ&oe=6A844F40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KN9HvnVPGGwQ7kNvwH0pIuo&_nc_oc=Adqc-bx-Bneisyz2T3a2TzqyIQmNC1pNPgRLjleLoDnzInUQ5kTn0YdZ5e_l5kgJF1E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH43q2BFtXi49AgfoomnBFSwRhJA6d9VGU3DHLlOhbWdg&oe=6A843
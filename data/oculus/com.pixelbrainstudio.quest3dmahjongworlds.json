cdn.com&_nc_ss=7a30f&oh=00_AfwAe88WDcxp9ZXOMfmZbT-13mU9SI2ICIHtpyjppc_Y5A&oe=69CE7E4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaR5e5hH_KAQ7kNvwGAX93m&_nc_oc=AdqzBRjJUthU6D34MUYi0EKbMk9PkWpUAWxhWhQ3M-DihC0oyxCENa9o1OXmEsuYcCQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZKI3B4ybVAbrKsytKMXgJ3nH-MEEbPfBor0tTgmbaMg&oe=69CE5D61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNo6R8_FLk0Q7kNvwEhdEj_&_nc_oc=AdrgQh3FJZ5WR5_caX5ZVt_9gBbKVlE9yFu6c_ONFgVntlEVQOvflMiAL9SYAdTqJeQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlNKY1gK6zt8NoEmPZXWVTgWebP2II-1tEJbxc4_rvsw&oe=69CE581D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_qHYrfQ9RkQ7kNvwEdAAn8&_nc_oc=AdriMpQ6T_EyNyHCFjYlwiRrqQLl1okzvuXv0b8pInpCZDLGPnOL7d4g8ASkyTZ6q6A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2WOxzMyM62yS3tsccGvmVKeCO33ZhqKfgm2tamDIHoQ&oe=69CE6D6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziKBqHhKtHoQ7kNvwEvUsV0&_nc_oc=AdrtUMBEmu0T4u0TQlTbseiMAbTOZKt1oAtfA9PsEQ_frrASgNggXsysaZvwwk2E0-I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9crs8V9yyGM1_XEG579kskqyYH12th4Ah-BmXon7GxA&oe=69CE59F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXiBhDdOCncQ7kNvwFPLPTc&_nc_oc=AdqjGHwRS5UwR5kSyphFQMj0gvgNsfHxLxwdG0gxeW4j_rf6IbBANavPm2-Z1KYOnbU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-ESmcqzW0wfCllrcXHpssolGBX3VA24Pa6o4upxf4Og&oe=69CE6040"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwjQ7eToWxoQ7kNvwFT7LWA&_nc_oc=AdrlfuiNiBQaxPSOc3u7S4WVHANQ0RraaMw3QWGYpmEhcb3C1n0Zffan4TEJpFPsQas&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNO_SVmvAhM4Eme4LKRcreVz1XyFwXw-5O_MB1wm84kQ&oe=69CE5
cdn.com&_nc_ss=7f20f&oh=00_Af8gnVJO3-ggKXFt3WycdpoxPs7pEQ27G2K5A6hK02fEmg&oe=6A37F64E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-E2e_dVd1QQ7kNvwED3A8g&_nc_oc=AdquWlDT81EjILGj-LBDvVh0m6ClJy1Zvt-eHYbQ7kIv3Zl5nqHIGx3dIqWqFqXaaME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Jz0hrU3rKrKPlCe8BeD0yizqJPBczMgLnOvyXxNuAMA&oe=6A380DA1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGJPb-d1cg8Q7kNvwF-tRjg&_nc_oc=Adp8NBvaUVEm4BEm0ccKl-QvbAmhe9FQ7jbmPZNpIpgQe17UTCwWs6IFe74SVqqe6NM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nFRlyonJiS0I1YSTvSrnkVU7_rMbiFV02DPC-es4McA&oe=6A38085D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36H6VINUXAwQ7kNvwHCLEs7&_nc_oc=Adr5vJSpgCfgPpCOPZIzRNG6FrkRWTPyuhG6xXaOepxklVRnGWT8l4CKDP1IRvcqefk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SEQOHt_RxU0yDkCd5cA87IiFkewCfauGVGCxC52HmhA&oe=6A37E56B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blOXLYmXYD8Q7kNvwGjOR5I&_nc_oc=AdpFnTDoqMJIzThbK9HKkExfJ5FG1bsdaIfVjKZzO0boO2xGU3OrbjSMZhJcfOSvMgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0EIimgp2i1DzxROiM6TOe0r3XCaR0O_4xWFBQlgnyhg&oe=6A380A32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2ziGPHgUFsQ7kNvwE7XzYu&_nc_oc=AdrbUizew9ZMnBUiR1_lKODMU2ROyc0UnII3Pw7QqEWHscWirwU6PvIfSU9oSXZBL44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OSAchwl9p4SdtWLd4yFgqne3gGGikJZ3BT-heAXIWAw&oe=6A381080"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2J7FVQqRCAQ7kNvwFis9ir&_nc_oc=AdqQNI6GoyGLHYin9R4QMZKLUfPeSgpkIbABBF65uvZmf4G76ewnKFYRt5N_PvBMVAI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-adxi1WZTWViTZRHaCIetgOrfFvPysBVfkP2R1zTFZvg&oe=6A380
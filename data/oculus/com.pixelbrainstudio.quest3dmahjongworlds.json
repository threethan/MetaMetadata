cdn.com&_nc_ss=7f20f&oh=00_Af8lLHhyIVN_PhBLP-aefr3B_vfP5ipz69EqJiXYCpeYoA&oe=6A242FCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awS9DZi-MqMQ7kNvwFzlQ0d&_nc_oc=AdpdLdsLFMTdQb9J2aXSrkdtN5kaUDWnkxAZbS6F6dSSRQ69jsX5uBTGSWbpEeNbEnA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DA1qtm1YPJqVkNaF99--u6sSyiFc_OrNbpircwwBNGw&oe=6A244721"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9L2e5hMv4q8Q7kNvwFefibp&_nc_oc=Adrp9ass_0NuR2_h6cqOfY0OTWqtKRd6uAAoAttAxrLcglbObs1rEAveUb6XEaBpWhg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZweG3y5UxMKkd0dPDsDmZxicUs23IQQljpYw_wYfO9A&oe=6A2441DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rw-TTJ6RCfIQ7kNvwEx0TjB&_nc_oc=AdrKUr5I0iUP7lwzGkcfhSm0xJu7t1AG4iUJQqfZjwUBD1vkrj5Jd2ZwRsva3EMyQks&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86t6nKIFQu4eb8PELLgupvBLQ9IMYxVbQLT7JWXzCoQg&oe=6A241EEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTjQXiZWsMEQ7kNvwEoakt6&_nc_oc=AdrgIrjDv7DEiFP3mM0Zs008fjPo8Sc8igZypj55FoM1PAajoSHXSaqTn3hjcMEXuZs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85vOSZsdkuZOwqXmhfCanrzF943fBycJM0sa0rs12OLQ&oe=6A2443B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbRT5hNYWwsQ7kNvwGAzslt&_nc_oc=AdoYqiAb-beTfgcsx1p_1EkYJA6HzESjuhPsrobXnCSuCQWVcCdII2zz_WxbAA2PLc8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r9i7LSTpdHQW64ca8YpWIAr_cjul-o6oHnrGRWeB-vQ&oe=6A244A00"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVGZZUzLPnsQ7kNvwEwIxJ9&_nc_oc=AdpsfCeBcKEA4ak5Grrzr5NxE-2K4XBO4qCTVd76uLCdjIWzALO0VfbfmdNpZMv6Bko&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ebDJyTe4ejUSCvgczqQ5_kT55tfVXezZgFSWlMbqpYg&oe=6A243
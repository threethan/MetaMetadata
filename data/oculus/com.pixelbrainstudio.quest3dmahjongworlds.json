uluscdn.com&_nc_ss=7f20f&oh=00_AQIkw7J397TgyjFlJFVSeoquZFx9r3Pf4EOcSaBU6QBhsA&oe=6AAE9D4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_sGmpJCZnYQ7kNvwE10diN&_nc_oc=Adqp2Z4SEvNd67Zo6P-NvgX5HQdZijhqnHceE1902334cpQASA36bJWkDUzLYRZo5Hw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL03--C91JYjw0qoEdj1DwZ1f7MDs6o5uUj4rvWnraw6A&oe=6AAEB4A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08j_Yb3z5KUQ7kNvwGlW2kI&_nc_oc=AdoZLdHIA98BzASoic7ynNXfHmsWYXQHp9ClLHUdw3zQtrbEtz8Fi0GBHjbnFSnEdyU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSu-YgIxsnpsXkM4g7yDLt6lWOINyhNcrOs9RJ9fsyKw&oe=6AAEAF5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkEEz2mfCq4Q7kNvwGMpud8&_nc_oc=Adp5yzgupmdToDkUhNH7mm5ZuQ_0Iq4eRo6PIt8L-PEsR78BuVZKXZ9XjqfBOdHhgp4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh8MvurAiyvyEXzbxbv8KYZjqYncQfaFDuRWaRm5gf5Q&oe=6AAE8C6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STecAsXz5WsQ7kNvwH-ispp&_nc_oc=AdoRp21zMEDKjJR8xHttja28izpj_aUvQQRLmoDcHjtjeMzHNFSpkeM7y0jYmajyMVo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn5DbzaBnddV2qQH6lgcDFpB3SSlMGa7IF8UUSX21yMg&oe=6AAEB132"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vV2iu8jISSwQ7kNvwHYKb6R&_nc_oc=AdqdEM96roq50_PqTpqwe1ri-fNimNVNeUMsNSJKlp9rCBrrNKhT5kQSK4HfF5m_LzQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL67vCI0JLbYvvKjr3lLeJjD_8eb2iF8Cw25jcFE2-KUQ&oe=6AAE7F40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHBh1KxLfckQ7kNvwHdSzvY&_nc_oc=AdpJix5OF7IG0jvpLNLJ9_de42exEqTfXU-YRiJ87ENFbxeEAApjscLaMxfBvh-p8eU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw3Wi2VXLXbuzTD5LxwZ4Nqxawk-mnsBZ1KyPXakIWSA&oe
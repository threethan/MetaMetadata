.com&_nc_ss=7f20f&oh=00_AQPJklGo8UFqMDghqrKECVaiWErGH0Iq5-WNlkzVEZzh9w&oe=6AC8FB4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_s3b4iSmtgQ7kNvwG-iUod&_nc_oc=AdoLjjD9BKY_Sd_ZUuv8BhyH8ILq1h4VKq29QhOphA1wwpHYxhUN_v8BzY-XkgBKb10&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMHC0vuEOSmpwcBx7ib9NN64pMbn1RarBrQdD-PZoHqQ&oe=6AC912A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWo4G9-5gAEQ7kNvwFwlYJI&_nc_oc=AdqADci-Kx41m8CU3mc2lXombbbm6kCbmsaT7L2dwsEu5K-d0lTA9ExU48JhUTJzZcA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzsxZnx6rJwNKVh5B2qcooyehBQg1p0Q8kmmdsFigwFw&oe=6AC90D5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMKOa_lATesQ7kNvwHEwNvS&_nc_oc=AdogkHcETWJW9l3wTslLGRB8ahsWbEvh4lHVWnckP9_GQ26y4TY42lk-UKO0oYE69ZM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPROJzo1KfCfPFm2InOBeocO76hCHtRc81k-CxS5YRr5g&oe=6AC8EA6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foryAJRzD3YQ7kNvwF_uUS5&_nc_oc=AdqMN7LsSiCrqPfEhs92_JaSiXoKWn5ned4svwncVhlWwgl_qR0WAWYSbvMDDkbDGHM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyK_ttol-QwlI8xhh_i-8RwVUy59pZDVnJQpGRbPd7Ow&oe=6AC90F32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7MqoKE8JywQ7kNvwFSInG7&_nc_oc=AdoZnR0IftNRcMuyUozzULy8ZSAxxC3zbxTBD5srqpPcKIBPC_beZtR5iMtSauJvIc0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKVuBdtK9CsSg0q_YwpRUOb2JPfVbU3K9vljObtR5vbg&oe=6AC91580"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIyI6iJf3QIQ7kNvwEBCUOl&_nc_oc=AdoIg8qk4F6maIqxTGw69-V7ESg8KJI7NvAkwf6AgJNx8EbMBNloKaf8tzxOJ5FFbgk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgdm57rgB2BWWJA70epSF11StCmrsxkTzKoLmA4hYIoA&oe=6AC9062B
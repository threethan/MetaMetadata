cdn.com&_nc_ss=7f20f&oh=00_AQBAT2MtupdyDWolblgbVYWuv7zVA7GLZU1q-L3lxxMA5w&oe=6A5E31CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY4Cepup_4QQ7kNvwFNxj1F&_nc_oc=Adow1B96bRRGzqyq1fQDUv_WHk1vdcK6GRX99_sV7jgwwnsM8I6dMdjEfdm1lE6X0kI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5CiHxxdHCc_AAEWityVrdQIKKhkdvl_l4RDqdlooL5g&oe=6A5E10E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSIsjON33ysQ7kNvwFkhsoe&_nc_oc=AdpC6kzS0wJ8Zt1e7qthkrfGVNAUo5J6E8uEkBe6Rzu5NlW4MZzmbaSOVDYLMQHoHPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAb3R1gsAGdomK7OErpWApRMjLzom9vK_biCoKb09JUOw&oe=6A5E0B9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SttWHxO1hAQ7kNvwHEE5PL&_nc_oc=Ado2Dq4PONHN9QdsIru1SK7gT1ooaDQXsAO1AyRrDvSpH4CIHKO0UrL_ReyLTCbS58M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBILX6wBg6emPFwCSOvhA47OH4ep-zcaMmtp5C1iduI4g&oe=6A5E20EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2E0_dFdqNDoQ7kNvwEe7cGm&_nc_oc=AdqqYmhwejZwmD7dkT48lLv_ZlAfsv6l3tnOkBbhbHVUvnNmuC5VCgL9ont2o5bWkmI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqz6GDeoJYnRUArS67TpWHMHNP2DqQ7XpPeWkcsvjgGw&oe=6A5E0D72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dS16V9iSKUQ7kNvwHCepNr&_nc_oc=Adp8r0YL5gFRwA_3uvU5CmOtkZgk_-eN-Ela8XTcULVocPLENo82ID5HNhN3GAK5ngY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVji8kGIEHlLwmM7sHRav-BZ2LQ4HSUBI_XyFOpD-slA&oe=6A5E13C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uCTM2-cKG4Q7kNvwEfSbVr&_nc_oc=Adoo-3lexBA3iwFO-vOBaaWzs4UixOC3O1CyjzBsQvG9aVpnP7DHKny0xQ-iErrWk4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8G208sXLS7JVTaoVcSYNVlAWn4EoO9-jFQvsZPiDXIQ&oe=6A5E3
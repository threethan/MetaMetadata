cdn.com&_nc_ss=7f20f&oh=00_AQFFlDJ8lQSi6JlAcIwWzv3r_LbMXuVMMYqImwbVtyUY8w&oe=6A71F84E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOANId5pJ58Q7kNvwGiBzN6&_nc_oc=Adrv86JCxYYzqxe_b66m1acnnARwG5ns0qYaephI4-hy6Rf3YzwwhNfZgQjwtIb_OkI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTeXfDPPLFygfaP1orE4sceBP7d7V9t7NW_TRoWebj5A&oe=6A71D761"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMgE0AXj3HAQ7kNvwEv2XjT&_nc_oc=AdpmgbFWlvPj72qycFzM6DZBowGr_sbBqPvApT8XlXP36VE87oda2QO8ge1HR1jqYlA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9mFeEKzBtt1W_ZXAzG_GZDetKpq5meCLvFZj_8AtP2Q&oe=6A71D21D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzV_OcIeEtMQ7kNvwHxAkNa&_nc_oc=AdpmmQUON4N4jxybQBWYLfa44Fw8--M1cH1gCki_E9DIIIS1L507yuS95BWWK-u65-Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAJXQ6J2CdmlWqs__M4_2ICysth-kje34OaA-IR_YkkQ&oe=6A71E76B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-FaMvTewRcQ7kNvwH1OAn6&_nc_oc=AdqcEPXBq1_xvZtFZqI1yyGC7jKSUEN0RQ8mEURMXhx1bCh8Ib_HhY_lvcYTQ_H4sAY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvmRa3rOA6ugsyAW3GZC6lb6c6YEtQQsau2OnnypgMOA&oe=6A71D3F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_cpoa4QcfAQ7kNvwFGnP0B&_nc_oc=Adq25iZhxpjnIWo--N9FxzjkxmhiyaFtFzJB4bo5T1XQ0QGQS50rwoC5i4aGZjowPww&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdPNTbHJ4tpatXjjGipJzTzggoYABCXPojQY2zRaNkQQ&oe=6A71DA40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJPpX6RKtqkQ7kNvwEFyRqW&_nc_oc=AdqpvUwcn4lRc5py57O3PKUA-ulxr42DGnPGkkPxONPBHiCWj1yy7Vqo9Zyn1jv2i2Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlUOuPnXsv-jL_PtcfEoP1C5Wp8eLthCiZoQoPeIAx_g&oe=6A720
cdn.com&_nc_ss=7a30f&oh=00_AfxQHbNwQQYXiNqJPsbNqIlFXHmFsSr-c48i5ouj6Su6Qw&oe=69C543CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sgNtJgzA84Q7kNvwEqxNx9&_nc_oc=AdpW5T4mJCro-MS6VpNqQInw_rYlgEZzZsvojoqs64CnypTccbxPu9me8V0Q99NdjXs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFdXkGjIrn0_ZMs_7fBS8dLY2ahbVuduD5zFlIrUeDJg&oe=69C522E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh_K8aC-hCkQ7kNvwG41_9m&_nc_oc=AdpzBSpJNJQfZ23nmGcmlvJaz0F96sZp8eoNNqZXQ7qCCRvlOpLHk7R7SAyB6pLTCDU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwObLfswP_5vTgqFB0H9W-_zzvqo_jMuyDrElgnePdZ9Q&oe=69C51D9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7x3spNMB-bgQ7kNvwFdxelj&_nc_oc=AdrPuQbuTAvKT0J4AyHu5GRKQ7nQ1qcAWJN4P6MGLb1xgrOvQZkDnhZJ3VNE7fZqUBE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlaZqcbP4zWX0xNiflvgWpvIHYO-MF5VC-YKM92MWKhQ&oe=69C532EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOWyIJRgtXgQ7kNvwGHKYo1&_nc_oc=AdpUlSOoKFHAUGDc-tr1RNW63APvNmcbjcvx5DJUGlixBmkU8VWDrPydNTvpZlGU0rM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwREO5fLC-4RQoOnS3ToVFmM7RI0VComFteU-fQ8iCqQ&oe=69C51F72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_81qLWcfg8Q7kNvwEyH-cZ&_nc_oc=Ado8SF2SqJ5aO4fGhDLJDoHRVuwLSe72ssQH04KjmPvnOT9RD80hVXFpWUPD7eNA8uA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFCuFrXK0QnR5oAu0xwHpCl4Fej_pu7nuvol_IFjeOAg&oe=69C525C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UL9xqknLiUQQ7kNvwGYGEcl&_nc_oc=AdrcsalqnBy1LgX5evrfN-kfbbnUVPqXdBpNp4NCYc74FIreBENgCMPBRMbxwgr1kWU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxrPkd_SO1LYEJG8y5FUHHI-iMmghod7PrZSvgNuHDNEw&oe=69C51
cdn.com&_nc_ss=7f20f&oh=00_Af-IW41bBN9_AvpEqky4L5ggJ50lLJ8_NIe8AxkDpBT_OA&oe=6A2AC74E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kU4_TDFmPQQQ7kNvwFTbgwt&_nc_oc=AdpJJ9M-BPKNm4n6hP8EtZf0-o-MvkksHiYILSGppGntwnIDJxHU0PqcWLmtkk3gto8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-P3ZglsW4l3JgSvlA8mR1aXfNPGEffCISB0CxlhkMmJQ&oe=6A2ADEA1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zPF0TmQRMoQ7kNvwEPUNFx&_nc_oc=Adpf1GyhbxaeE-IzhC8PZ8ePnhUaNY5aTLEOD5abTq75Idlnzl8l_IySmfzNaVa7p24&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OlwodWbTJoBVU3vDmErDC1Ool8j6wCQhpNM_m1Nz6Mg&oe=6A2AD95D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WP12wX2oHUYQ7kNvwF5ALCK&_nc_oc=Ado0WhCiBWK4_D7b5FQJ9gl08GH3O5ZhDWW6Ea3Co_pmhzQMZsv7Ix47_aIwQAqKhmw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eTu9LAL8CyOjP24ndZOiMReGcDFuJendlhays_NIHmA&oe=6A2AB66B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aJLqaGokTIQ7kNvwEtasqX&_nc_oc=AdojnB78ynlLSbamXuefLjskpib7D4B2zPXuJRmdDp1Dv1eX4Sm3RBE13p_29x1HJ7M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R8Mb2slAZAqmWM_Hh5TlyJTCNdJ0sD42HkN8eT7eVVQ&oe=6A2ADB32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWjBZ0_1gZ4Q7kNvwGVGcLH&_nc_oc=Adqxj92vnxEtueBofnduA1RrII7RKxMV9L6glqT97v8KGkIe5sXDVAOjmf1sI0PT-2c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H9PrgL89eXPxKGJMoJ2fwzJy80lGitxUydRQRPEEhLw&oe=6A2AE180"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMkFfrq3BOgQ7kNvwG0IKdM&_nc_oc=Adr9NONHqOpps-bY2Xc6qTDdEkyeWfw05He9GCDw61M8mHmXf3Arzlfp_Io9w-oNRbQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_KaE8YQUR6c3Z1KBswLq9lpLUCIu1ZI-3siUoUnAsmg&oe=6A2AD
cdn.com&_nc_ss=7f20f&oh=00_AQEBcyZ0xwUrHEZwY-DbI3-0WdN5hJFxxf2eJkHj6xT8QQ&oe=6A95C90E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rUre6wFEfIQ7kNvwEpM80s&_nc_oc=AdoMCodv5ofNfnESk14edrOhZ4Qu0YpRAPT6vYtGKXNvyrWYclX9OKmIBFStT84N0OA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdmqj29vJOqyq6bBo9OD0CHvVpopxDylzvzpMxcUni7A&oe=6A95E061"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JIgCyVf2xUQ7kNvwGzIzq0&_nc_oc=AdpcQgBRBZjaoqk0L_k8Pc4KLpJKP8LwHDVBZwngLxOEK-5BEmu1GNSujo7Pfr4MJh8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRob8bELfyXunud5Eyv1yVBHvM_GdqPZN04gKQ_jaeDQ&oe=6A95DB1D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-hu8CJxNmsQ7kNvwG6a0hX&_nc_oc=AdrthC-DqP443iobM8tfwmtd3Sm8Cq5nJot2x-pVOUunkFCh7RitBDlsPRop55X1ddI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8skLrAh0DCszVPQ4-NSKfdVa9hQfA3vhJmjqS65pOAw&oe=6A95B82B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Su6czSL5ZkMQ7kNvwGZorKc&_nc_oc=Adp1uJlDXlSDSq_i2GquAhrlb1Rd8jszaEzHjZLWWIbFgoaWOsVbnZ1zAueqQqaiv2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF63tmYEB4GnWXHGr8snvrLoNnWgKZOxwkZtpY7VLntWQ&oe=6A95DCF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J-hj4bDbtcQ7kNvwFr7aNs&_nc_oc=AdrBG7iQGDyW5jZ5-OHfFF7lnK4A2tskrjtnhHIiN_xVYuJ-icvfu1zw8vPDAFRxie8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI8L8e39fLl5Ft2Q-YPPg1BMvebDEsPOEpE4lKwXNUjQ&oe=6A95E340"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4e1rNwd3K9kQ7kNvwEeVeEk&_nc_oc=AdpqHtCVmfJsDluhNneli2CLFdqbOe8wuIHCvnumveN754MJ211ID8auRxjttaiAV3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyxJ5GqfCzPR4szxNPozs9vCXREq-yMwR3tgGwwaZuBw&oe=6A95D
cdn.com&_nc_ss=7a30f&oh=00_Af0Hfnr4lDAC6NFxVa2QXvTgpwf4o-tYZZNH1PTs9yqJxw&oe=69ECD0CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLyUJlhc95cQ7kNvwE1nLpL&_nc_oc=AdouPQJyHuN6SBS6I3vLpopNIlOpJibPXk3mObT-MMcKGGfIsdYYtbuzdcISikaoyoE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZjWeA1VxHXutz7fOTUNEThiPZq1vJfTGTWZFX2Orhog&oe=69ECAFE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8jYk1jAEEkQ7kNvwGjWZDC&_nc_oc=AdraAPn4Tdvm9T4GkeOxx774np5Co8NNjO5mzHyYcqICrnAh-VDd6IcWYcY8AX6BZtg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bNSIr_RwpklgaT2XzQjyu0qARUv2ao47Y66JkeeFbVw&oe=69ECAA9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAjOK4DEaOEQ7kNvwHdlpwl&_nc_oc=Adq41N1X0zYvVuL-KvWh00eieN_680wVHhD82dUzyu-lLpVoshZaySkACqpJO-QHBeA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cvCW1nC50fgMxOEm36yUPKpHrMrbhFq3A4Kv-6ePGTQ&oe=69ECBFEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WX4toDyY5AQ7kNvwGKljhb&_nc_oc=Adpv_f0GsnVxBLXdWUhNcJLNFTqN_Vglc0TTahXk-MnvEnrZs3COBSJa71Tfm6QPgPo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PJyrhJ0qVtL85_Bl8vq52InPJFuvv7XGKg5NNJz9Bgg&oe=69ECAC72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYVuV_H7d18Q7kNvwH6eF7C&_nc_oc=AdoQk7h_kPqdz0Z5RjK4pto5xSYs6Q6w03XO9-03Q8uOwS3SEa7FjkSecWEbEnSCQSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T9nwsMRKeTMWHLyvvkw46OLYLFtjdr8GEw8AEwbmSRg&oe=69ECB2C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxMMJITatKcQ7kNvwGR6evA&_nc_oc=Ado3ErcGtMt5msqjvDjFtFudpI8CXi57nJPsnAhLbAb5yw4VmjXTqzCg8tFokk657P8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YSLCqGxRTAUSVDdxOxSDiGHV738_J1wWqfC-BOeXTDg&oe=69ECA
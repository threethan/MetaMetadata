cdn.com&_nc_ss=7f20f&oh=00_AQGjgMGr9-Cqm90tTo8BT0LtlheV7zeON7DpGLxEv1O5Ww&oe=6A92B58E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rUre6wFEfIQ7kNvwGiDi2w&_nc_oc=AdqnUrk7CWos_hEqw8Qn8_EJWh076r0ioSHcxZ6q7NVlyHoFE9kTQDfwkO5UywZF1DI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoe6VR2yWs8xzUnEvtiPx8YjuaG7Kl8XYC2gtQcRBVFg&oe=6A92CCE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSOXhDg1-dUQ7kNvwGn1kPD&_nc_oc=Adr_rRD2pCZFUC1tZeVNwMXiQwK7HOY5DmT5GHnprOO9x10TAfOSkXcuuuRd9yQtYNk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-OPQ29cmBs7ZAupap9z364uV27ZoGtTw5rzveKix5fg&oe=6A92C79D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-hu8CJxNmsQ7kNvwEH_oZ3&_nc_oc=AdpMOQvBcyekeVeddUzmnO2PB3CMKObtT8SaRMAg-l9nX10rRM8kJKetM1s-BTqD7vg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtsMSUJ6kU7q8d3K5w74yInfpN4_a-_ebFuXEFBNT0CA&oe=6A92DCEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0J3TWWHPoAQ7kNvwEtU6Vv&_nc_oc=AdpGgCARjsByF7lDv8e9HrNogEM6j28RXBppOV6lfkjNrf2TjlY0dCvVnlO73vzAWI0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkzmdjqq29IxtU0xt0DmP7n7HIbMJmvoxOg0xMp-E0qw&oe=6A92C972"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J-hj4bDbtcQ7kNvwGpq58R&_nc_oc=AdpfDqEcxbEo7PIVp2_OFt-dhNBluWR-Sb35cVREflvftHAdFgDYqwcTrGUYCGtfZlI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU9pxaykUj5bYmVRvtQGh5qGM2QrC7RBJWa4jYiL3I9g&oe=6A92CFC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKgjomzPv-UQ7kNvwGwPvdk&_nc_oc=AdpIqqlmoxcNAIgv2kKViQyXYMYLN4F15wcM2tnrspFBLvjLPCtd-yCIGhcTVRErWXY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXpwv0hJS58lhF12_CSXnk9fqt9lPk3NFCtcAwSpV1Nw&oe=6A92C
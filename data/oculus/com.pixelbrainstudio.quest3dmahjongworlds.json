cdn.com&_nc_ss=7f20f&oh=00_AQK_P7wNa4FtUpA1HEc7EJPlquNdGG2re1-7NOp9qOZlyA&oe=6A9833CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6b0VaDi96YMQ7kNvwHrNH29&_nc_oc=AdpiYUF0wb85wzUGCzpRHawEyntq3YBSvkSwC3hZ1cK2_DZmKHdqut_AIhAAKqLbu1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLA6buGKmdbjhKgTKPICiO2Z_Zm-WjFqclLaMBVdDM_qA&oe=6A984B21"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JIgCyVf2xUQ7kNvwE7vdoi&_nc_oc=Ado1jfq-vxtdtKOnh-RO2LoqAfgRL1WTzXZVXSkSMpvH3_9u5iB6Ko7kjkvoEz0jghE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTFgFkF4pmYYpCPVe1mowcmTJgw6sPVjRi_gztapgZwQ&oe=6A9845DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5A4tJQ30hoQ7kNvwEAoXb-&_nc_oc=Adpi2QVQpW-j_atbF1uHTHaHpUvVSRKEuTH8xqDgKI1MMYGdSllK0FGNMARoj36KJOo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSAsnLswSIxvWKBJ8JVZSRSGA0oCRAZsa-5OvqE65iBw&oe=6A985B2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Su6czSL5ZkMQ7kNvwGe1WAu&_nc_oc=Ado2UCo9YCy0Yd5_ksft-UyucZBdfn2X9qupRN-5mURR7HQtgq3LHac-Sb7Z3uJk7Mk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJea9zR67iNxRH2agSsHeL7-tZLn06AXBevn-6S0zCRNg&oe=6A9847B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDp1fKiv8F8Q7kNvwHLFm2K&_nc_oc=Adrwzbn-e9pN8qiZpn2eHhGjp98mn15O-Y0mU9JLlKC7ZrC3uh7GyV8mYTbtbhWh5Ic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_ZVhigPBycsQl4trSRfMX2N6TOpLBo0SmBvTqMBjuwg&oe=6A984E00"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVCHJqt1ZvUQ7kNvwHRiVKB&_nc_oc=AdpHseIhxvZ01H4gmBq32zwgHhX8PNAL-Bv8v4-H0GCyF8NSIa3xd5nF3Jz6UEY-3Ls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEONGLK7iCu-MxvCHmXN3xQTqCECR0s7eqbPf7rnqeLg&oe=6A983
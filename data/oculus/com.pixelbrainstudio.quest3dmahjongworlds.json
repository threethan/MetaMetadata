cdn.com&_nc_ss=7f20f&oh=00_AQHF4sJMUYrVDn0VSwSgMJSeEIq86Ivbyt-OfdIl0-V4xA&oe=6A88298E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znMuSNnl000Q7kNvwHvIHLx&_nc_oc=AdpJYf37j6k8UJDSwlmOj9jyXjFhApHUXHMYZmth-Ke0raiF6hwWxFGrK19mUnLGC2k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7wWfn7N7LEVMLs_4Oo1NYvlJl9V7kMsckJYLyKDbfQw&oe=6A8840E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmn4tDQeq8YQ7kNvwFe1ydt&_nc_oc=AdprsqQbdVARRooFwDIa2vBn6sze0ad3BoFQDNppvtlQMOjhhINQ8qXFxrW0to9FEHE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoY4kPNgsawBomwLrbnlrurpSnrYzTeOO2jR_lTRimeQ&oe=6A883B9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgCpIyxiDJwQ7kNvwF9_D2o&_nc_oc=AdqgbxW6G77roFOB6zyzukhlzsaMdydNWq4oCdWI45vb3eqaTw3katNRNQJO7F5hdwE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi5rp_5XAEXQJ1NZYUlHcu1COGiIoUWz4vmTQMfrtCTw&oe=6A8850EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJN5YhS321oQ7kNvwFXBfU0&_nc_oc=AdrpsCGiTeM434FBIaa56nIebBv60XWhVc1pQi670kJjicZJ1gCkOzs8k3Q8Jf2gbHQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrbOoyqqP1vuEcv5IZwBoCkN09pT-Ia_Xt6ze7gignjQ&oe=6A883D72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsj9U7ZzMhUQ7kNvwEzZJti&_nc_oc=AdqnRtNZmpHDXduuhPMKwz5bMrkoUKt3q_opSU2J3b587vfBI4181_yypMYJX3PpVak&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5P7804NOj6yfM3cp9epHnJ145voQergGndckRsHNr9g&oe=6A8843C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbBuy-LjRsoQ7kNvwE1ul7E&_nc_oc=AdqEXoBxpWsnyltcjxK__Q7EfnDCZ1WsPUnaiO8MLHYKa7AceECNpSIZAxcnTof5xjA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjhy9sQumpffDt8TCpmC1OetJdDGvEDfCxVyjG5Cv_4Q&oe=6A883
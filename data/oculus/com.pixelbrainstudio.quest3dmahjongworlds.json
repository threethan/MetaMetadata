cdn.com&_nc_ss=7f20f&oh=00_AQC9T3ZLFneMIhDCgCYPQ7_iHfwEGIp6FdkrZhhnLXUguw&oe=6A5F834E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SDWZSok6g4Q7kNvwHBC8JV&_nc_oc=AdqRz8ZgafxS5rbIS1G6BaNRfMRwCBcZGJLbNeROH6qP1t_0S-XkiLblGs02294wI4o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd2J7_Qut8Mzs7Da0AA_EYp2kSK5NHv_VbGoEDY2FLOA&oe=6A5F6261"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xd7jtfsUU40Q7kNvwHL0A6R&_nc_oc=AdrLyl2LEMdk_3_i1vkrc8gBzmLT4YK0F2IHRXkLmtE1enexsVuLg0G42l0VFr7rn2I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYx6qRg4k313kyuE1rY2-Tc3YG5p0w1Rya0GpdTs69zA&oe=6A5F5D1D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ecl6aaaMjEQ7kNvwFzRi5i&_nc_oc=AdqH19x76j1LvXGRCdOA5dcEf6X5YNPA6_E-kd492f0TKh-z6HbNRt3Ug0MfqWiJnx4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoeDW1XazxcApmYCfseNpTkgVZeKRKW35eVbLIpoF6BQ&oe=6A5F726B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2E0_dFdqNDoQ7kNvwERfxMF&_nc_oc=AdrZgq7ak4IK9z62wuv3bv8zLTTAS2LCVvvGEohhyUJvZ3et69u2fE_zNJCDvSjvMJo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWVhBaeXahMTxAvc0y3yVLQhwUnPeKX9oQEZai8nj8HA&oe=6A5F5EF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnsEuEkBBuoQ7kNvwHEqND8&_nc_oc=Adp954MX2DkfD8WtIMTeWd7a0ZDB2QzFazUUTYf1cN6KrOHRogyPv1vy6QTms9xL64U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_xRiS7hPeFZri8G5N4WmKGzohmf44HVKeICDoGuskZw&oe=6A5F6540"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uCTM2-cKG4Q7kNvwFE9Xaa&_nc_oc=AdpTXtFacTeXcwS2oMmf5jL56eTEbv0Fgnoje5QOmgRfv-r57Wbx-xMFkHYayDRD6aU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLpjJNdJ6Yq_OSBd0ueu7vMMNVjs0x94s6x6Exr3e1eA&oe=6A5F5
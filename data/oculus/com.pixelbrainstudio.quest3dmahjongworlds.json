cdn.com&_nc_ss=7f20f&oh=00_AQCQNxdSk5Mw9sea05mt4Js_h8V39UUnkWXlf-jJjFZ2dw&oe=6A53A5CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVF8gvSa3ecQ7kNvwH_sOAp&_nc_oc=Adp0Zo5DtCzF5xreejejwJdKNb-VPsF9tBlcuPgh1DE4nUcwwK5TSnufYolSWAIyPTg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrv8-jWgMej7ojkOq-6wuhC7WqnpeHBbkl-rd-HQ02kw&oe=6A5384E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Al6Vb2Q_tIIQ7kNvwHZPGqK&_nc_oc=AdooaAC14NEsTIz-838OhD_HBFp7HSDCiTi5Q-w2MY3kEk-mgJ-4V1hfHPUUXLL8Ljc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0-e-3smjP_yOhAPue2JgSM5NWHkf7RIA2iM_Y1xSouQ&oe=6A537F9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Dfn2nrm0WUQ7kNvwFpbh32&_nc_oc=AdqhjCFMtQvI4t-nNb5KUdLjBxDZZfzKAXu9rWyw4rJGRVQobV2ua7dIGC0aXKgqGow&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ0eUXsKv2rWFnUm9FPsvGIlgfNfW4cxYy_g6wEsd1ng&oe=6A5394EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKNtiV-GeKEQ7kNvwEG8UBz&_nc_oc=AdoCu6kIz4hU2inw4rfnGYkIEhOKxiLkJxpZTcAuV4brKOVwfCF9R4PFjmG_xv0MO7I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4MbIGBqUbscpVTE6fbQh2ibBjVhIeLqzVP57krt4mlg&oe=6A538172"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QgVK491zvMQ7kNvwGEUhrQ&_nc_oc=AdpVqhYumwUvSHAEJ2XtdeLnMdPMdEKH7rg1KL3TnTwG_Bmfw_IC6Ea2BPXzzqC2wvg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBg9UvPmZtq0JMKzw_H7hfGNztwxqjTOc7VohkvLpcVYQ&oe=6A5387C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fet5TeDgUAAQ7kNvwEhn1KU&_nc_oc=AdrphSABqRkiqIfAkqDbi5-W8xc-bVB9nQmsZWtbhI1s0Cf6iB4U1eRpajfYbWnJNX4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVrBtlDRswOE-ArQi7xcq0BW2mogGH0jI83xCiMEJIkQ&oe=6A53B
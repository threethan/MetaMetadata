cdn.com&_nc_ss=7a30f&oh=00_AfyweqAWufsVg_HYYUo5xI_zI49M7C2yp426ymQVnvEPZg&oe=69CFCFCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaR5e5hH_KAQ7kNvwHYQgCW&_nc_oc=Adqryhds-CNs6BiVUxI53L4P1j5LFI1-BhZk4qD46DVDQOPNVunihCLxFbrq4cSoLZI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwzpJX-idGomdaP5kCv2nmXelVQjF-VtEqkI_T46uloUA&oe=69CFAEE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNo6R8_FLk0Q7kNvwHeuK-_&_nc_oc=AdoAV0ruwgpz-Y--ClfaOJucfJXurlgHMenC4J8_Hw5Bx04GCaUWpiW0MWk5_bx9ySI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKJReRie7rxGW_9G-Lo_5JDxN_RXbfDo4nuDlPtqG7BQ&oe=69CFA99D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_qHYrfQ9RkQ7kNvwFcIYy2&_nc_oc=AdrD3mUnn9kBYL28g9_wiB7k0pU_L7S3GCSg7PFjDEifqVqEXL4guXquVtkfA9j_O3E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzto2gkmpSU8q5Fs9pfcZboAp13MTAhAtqPK6AMlmkItg&oe=69CFBEEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-nfsXVa-PoQ7kNvwGEL86w&_nc_oc=AdpqPql-cgpqR7oTU94uA4cqUwAR4SDRaVMD-PtvulrBFkviFuMsH3GDgcK2tYdE-64&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoFGpFc3fl5O7YGIzNRy9Fm8s5uqR_PoIHvNb0bfEcyg&oe=69CFAB72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXiBhDdOCncQ7kNvwFWG5sD&_nc_oc=Adqg4G2Y_Yh2ybtJ051AU3gxS9OCXDibdMl3jOO2LX8HED_inv2A7CzQ3mtGCpr655c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCORQEGWD4yKGqZl2CyEIrTTwJXFZP9gyt5MCWeTQ6uA&oe=69CFB1C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwjQ7eToWxoQ7kNvwH0ZB-I&_nc_oc=AdpjW8YzPCn9I6k_K0HG9pMHDY9XIYk2ABn-KPB4F2P0R_4UjM_RCLg0R1fyKZ1CRQc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1K4Smbot8zd5vdDrrZeCrw5-uqgnPOroJ6TRD9gLHug&oe=69CFA
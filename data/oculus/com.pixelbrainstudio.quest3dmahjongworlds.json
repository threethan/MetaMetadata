cdn.com&_nc_ss=7f20f&oh=00_Af7LuGjP-BPaLF7781VFy6axLJTG2uhPtzq0fr6hZXmHNQ&oe=6A1700CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6t1Bf-E8jMQ7kNvwEvA25P&_nc_oc=Adr65aipX4nu7Bxr-IWGp9cNajpJ8NSXoREbN23EYYTj6JiZXHyskmLkphYqyKaoJoA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XMXieepsYgDSMXxs1x8-VX0Vtvh8R6bJhl90KfPEEwA&oe=6A16DFE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zGH3xQYXlQQ7kNvwGDmmB1&_nc_oc=AdoeBVPk4OX30k6p9qnNRDHojwSiYlZ4B_QoqIDuEocVEZ1hCClNU4tzZTVL4BzZuvU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6N3EToOflMHZxmf9EiQ7Q9U24lHAhCG2EGO_iIVK4Z8A&oe=6A1712DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdglkuMsF-MQ7kNvwEeEuNe&_nc_oc=Ado41ZNdQjITvZjjIK-DzknNa9KLULn7cffBIAKtmYU3YJ4EThYUHLhIpBTDZroE8Is&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63JRj-ymfVa2yILmwPkuvq4ncvZAC43OLGo5Ra0nNK4A&oe=6A16EFEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJTFVLjt0VsQ7kNvwGnYIGK&_nc_oc=AdqbOPn7RDZWS5daF98AmKVtM1n2kg22b3Gkqhf57sGfl09uNImWcXlICJ7n3J4RiFA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65gVtCgKdP2fKVZ-HNaBujt7KJd_HTUt6gGu3ycX9nEg&oe=6A1714B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RM-eTo_jg8MQ7kNvwHYZ-_e&_nc_oc=AdoHEJbUC3p7MDBHE7y4Vv5BHonyDlcvTVA6t887cjgVZYey-vJEfC2Gj9EnBwiqpgk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_xutAZOTEJU6zgiLyc6ljjYvFrMzMXgeso3CtryU0pA&oe=6A16E2C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWINTSy7cCsQ7kNvwFvC8o5&_nc_oc=AdpgKv1nBRM3b2Y8LF-DELmjV-fUNPgqbB0keYok6nC9BkjroMdCKsMyeOi4YAq79uU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uyVJt4e55MLIA6C7Aoyh1NvM9n_e_5TwHRJ_a9KB7xA&oe=6A170
cdn.com&_nc_ss=7f20f&oh=00_Af_59kvTZdO0NEEHHU4dhFmtIbTSx1eG_HFaQ7LTUpe25A&oe=6A42824E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WU7EQJmTFL0Q7kNvwEnYdKf&_nc_oc=AdqRA1G4-_G-y_7Lnuyto35BGi_XOq85Xow7WRdRrcTQ328Eh5R6NmsXfUt-iwY2DOw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0GY9v-ESmEsTIRo1NMuMc7j9ZpITA3RovNBSgUehQQg&oe=6A4299A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp7FfCmeQUgQ7kNvwGdq1W3&_nc_oc=AdpikZvmONLcei83ZeAVFzVqPruCKdzR19KNW3zGWtCCDjIZt6VTPJFb0LimK0us2u0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iwJgmcd244RLRYFYQiEkFpfuzKCLlMHi4RmF74WeIzQ&oe=6A42945D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNmSNSPHNe0Q7kNvwFqgJja&_nc_oc=AdoX2hgi2WkXazelD6YkTTTDvERx2cyjWfTUnfsDWN23_dqCKIMofrGcZZI9v-euR4Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WiFhCCwRd_hLIas7Ua9isFyXq2s9lA57ziALaKR07ig&oe=6A42716B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxA5NpwVzQwQ7kNvwHgTjoN&_nc_oc=AdpOKtngezQeBhsQhl-6MZmU3X_fitXpua3hTWeoAPS8YsGROgPAnZ7YxOo0Yv0u_PQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JHTxnmz2s-IraTawxz6OpRtbOBfhHwt1z3rDHzOggRg&oe=6A429632"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u27gdWwi_hYQ7kNvwF5RV_2&_nc_oc=AdqQgIriorVZadbJZMwr5zXh80f-duXiF6rAEjhMxDfqk6Sq7vf-SDGXWChVkzmz67Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vp4Ov0tSoS4MrRpSP4DrMFQrKzYBrcTW14Gs5j4R1eA&oe=6A426440"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJStyYodCnMQ7kNvwFsWE1j&_nc_oc=AdoZk_W3uSbfWe8u3ddmC1piOvW6_3zzcLkKa4I0IJJaD2p6l5b-0K1UAyTAezLadqk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1FjyI6xO7E0cwzOiooMv9GUEi6XOW0CLoFPqC5kZiKA&oe=6A428
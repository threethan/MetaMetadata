cdn.com&_nc_ss=7f20f&oh=00_Af7O6VJNZgw_r2bjUbAQkymhsOUx87eOjCh8RIgrDH5uaw&oe=69F9FFCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxVCucRL8MEQ7kNvwEtHSBQ&_nc_oc=AdpsnkkI5a6qKqZGH-YoJcjwDuQI0mKamyhwzteD3UA1LOWzytAtQnOPehZ9-oZmN7M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69pes87JLWMsNKD4dinbYz8u84uiVlX03T9lqDXzrngw&oe=69F9DEE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1eGSrFzhbEQ7kNvwF2IrXS&_nc_oc=Adp6u9AlMBZPlamZYDU0_WE1SkBR9RsdNmNGe12BhXFHehH089rm13DIGSdWppYEavg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47fZpHGx0MYkxEExMD7xdCBk7UISMrRWWVopV5GMBe3w&oe=69FA11DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgt7ogrbrBEQ7kNvwFMOS82&_nc_oc=AdpkfW5jgDNUXHIlikPq3gfptWIU5Pe8wkVZKUpf_J-Jdmc71oRQXSTHkWOni2US0PQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lEIf4WOjbMkf-MAsPQ1ZDRjqyGSZ-W-fZCVgIJIfGuw&oe=69F9EEEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGQ7o7D2raAQ7kNvwEty9UM&_nc_oc=AdpJ1p3TBh-W2t9Tslc8OGgBSI2MmhPRBPYqIRqSoJpGMHllcbtpJultG2XeDjdsusI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42fVRY8X3Z3BUKBm3qv7stm-5yzI31Yq09Z1JIY_9o8g&oe=69FA13B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zVLwMWNL8MQ7kNvwFBxF2r&_nc_oc=AdozS2ccIIaadVNq8jXAcdhxYykg2d7kGAldMG3MFHOZTXJ5CN080nNPmdTLX2pRGTU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71AZqvqA7l8J9L3w-EoDzAyQMgwR2A-NzuNfbeKxJwxA&oe=69F9E1C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiWlbbtZRAsQ7kNvwFT0nlf&_nc_oc=AdqTytqtOinkN6P4Ac-DkHP9OybytjE6iCQFNiyHG6h_uVxY8FD-0xmCWGRelZ4xBSU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pWrXFtFbjsdXiZ7EzKXApTG-ZZpo4-B3fk-s5boaTdA&oe=69FA0
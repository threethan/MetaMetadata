cdn.com&_nc_ss=7f20f&oh=00_Af4MVh1r-JEG01FKkW0yDqhSCH9hCr4wX8tSbQxPCyRN-A&oe=6A1C46CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UopkW9HcvDUQ7kNvwH4HY2r&_nc_oc=AdohSsA0HhtDDQ-F9QXuiKMyOo7FVe9sVkPEFgI129KJEWQ0BUfCtXo5OEhaIrW0r4I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZZBQcPykhqmzDEjY9RVeE5Jms5xNME0hgC8FMuHQeAA&oe=6A1C5E21"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrqKyi9tmnIQ7kNvwG-nFc0&_nc_oc=AdqGorRA4avBKi_HLw57iMqcL--WSmW1_ysYBeu05VxOnjz7YtoVFgf6TMAszAokABU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y0s6Nasy4DHG05mW4H9g_WlO5xaxuEzfLpXuEj_RShA&oe=6A1C58DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrAoJhhDmNsQ7kNvwFns4E7&_nc_oc=AdqX1E6l_6ezEtI3nqIKEVK0mmOMWlaVN60TTl2K4af87YZQGuwutPP_oq_vMzsK2RQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nVtvLVPRUDfBhSoih41P0hmLRQjVQ2qUW0aUpa-iqrw&oe=6A1C35EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0FbgRRoybsQ7kNvwGcsw2X&_nc_oc=AdoYNCrbkqKzo52_gBAXdg9qcJQgUp6JZIy2x_hPX7D38UjljRSgP8EGBkmTOCUdork&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nMT6G7nGxFNDixLs6v1lC_N44X2r6fIiUn3KybvbA8A&oe=6A1C5AB2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oy9CsJ9d0PQQ7kNvwGx3dg0&_nc_oc=AdqSyQokCu9j_ERutAAkzFMrpbKNMqk9zw-bN2vKwqyFLO6GUlXTVm_r70fV6ii_mN8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dxLoebWStUAs8a7EH7gwuSGJgzieHuG-U_JwkqM7bSg&oe=6A1C6100"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvTfpEE7AaMQ7kNvwEqVnab&_nc_oc=Adq6aJXw9nmu9tH8ycArYaBdiB02ldEWBEnXCke5qvIlPNPWu-eUxZEMNKFrXw2q6LI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a3Pf2Azx_yPXfVRkLlKFku2bwjK34goTztJWL7dJTOQ&oe=6A1C5
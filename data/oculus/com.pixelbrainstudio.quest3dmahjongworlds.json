cdn.com&_nc_ss=7f20f&oh=00_Af8ZoIL7jCAIVvv69bFdesl5DLBunjD6zTCKPnYShvhWZA&oe=6A218CCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXx7_bY2DQoQ7kNvwGBCfMb&_nc_oc=AdpI4mFZ8g-jFYvawXKb4LbniRtdZrjvqelJSn6yjHsC6CV_XkkkCT4FOflvTBy_S6g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Je2qk2Qv1-3Edpsw-HEP78BKQnzlOlWxpJ2JNXSqXUA&oe=6A21A421"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iDKJP9QwxoQ7kNvwEOp_Ol&_nc_oc=AdrZbFJBk2EQMaSqpZ7fzTW90N4QvmBqRGponlJCMLOJb7XgYUrA9fQfxvPm-3uFVPU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9twJBjYsOkuVdTKib_adRLFD1991-oOozEIn1jMuATUQ&oe=6A219EDD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3fXomFA9agQ7kNvwEnIFbd&_nc_oc=AdrwYZKIqIew6jwBZnIoNsql_sTallpx5vLKHjcftOHG43GgbNlES9avPLaNFPxNEu4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_INC_37sfkqSssb7z69TomxbawT1gLyR7ajPP_AxKenA&oe=6A217BEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ar8at9w2jN0Q7kNvwER5r5J&_nc_oc=AdrPqAaQF-PANEGDTO7vpzOkHtHHhbAj_ah6FcqVE9-6IfHRMmaxxY3G_Ozl-0FZkAY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pXRmiXiDm-FO4QyeLGtWVDq91wmXeUd3oZ9fCK43ieg&oe=6A21A0B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gobfmHC9G8MQ7kNvwEGoNEP&_nc_oc=AdpY4qhsb-yq59W9eX4k2m5tSJq3mamdJx7lxiWdL1LaDj7YHU1N226B112ToVBEV9g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rE4FIgG9VFYRuSXo0K3nHPhPDs-hN3T-26mlk6oTGoA&oe=6A21A700"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVGZZUzLPnsQ7kNvwELdBps&_nc_oc=AdomkTYJGv0-MBmx4OZ2Hlf1WOXYTc0VVlqv753CR_M3PqCwU6m6waNRGddh9jrR39Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NKnGRQ4pUCzLt0uYpdmg-LWg6dozYAuof4q97WWeWAQ&oe=6A219
cdn.com&_nc_ss=7f20f&oh=00_Af70hBSk-yK3P8uiReXJ36V3CmqMmy7ZQRfe0lDbAtXt6w&oe=6A10694E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cp57HDvFAEsQ7kNvwELMFIz&_nc_oc=Ado8VpzxyOdedP9cQxF-6MRwBwMBgM-cJACJyJNKRu6IW66QyxVVCnSkuu_NJ8iw80g&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SzBC9h41N_DtstBZg7C9le7-5LllABgcLhZUd5y2Y2g&oe=6A1080A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX5GegIzRVEQ7kNvwE5M8i-&_nc_oc=AdrAGh9BnkE3tM5zk3FsTMK_4neif6NF3rIfjb44p5umeiCv0uC4Xr7vVCEDuwajeCk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qFbETxaer6IJH5jHki0maoNPR1scRHOZwvA5470kMRg&oe=6A107B5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3AdyO44kqQQ7kNvwGKSW6m&_nc_oc=AdqMxDeg3D7_UU4rmk36q2bp5bWeWGxOI79boF9AJr8F9gmpP76MaapdTz_nAqjQ_A0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oF2BmljJDn_FXgPEHZgCwmgYSNjuVXPgAp7BpwouEbA&oe=6A10586B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6BiDjcHGq8Q7kNvwGDBNyn&_nc_oc=AdpL7CnZ1pxvN6XsSuIgIPy5pcsah9NAAkxwn6DlfeGVLFvEkHj3D5mW59__jFMdw8Q&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53RhtGmfy-Yig3IzlfONpPS78n2QL9sIJnVQcZAvEuzQ&oe=6A107D32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlwoIJ_eUgYQ7kNvwEmuzMF&_nc_oc=Adr5JgImsrJsPXcAvscv38orHfwZrEwM3LsLPt9wxJVog1K57Ww0QKMvQgP8XxiHvFI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eUBp2gUrlfZlloUcXjN_q3twmFGYvcJFqc3jyGJnGiA&oe=6A104B40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEmaeKsjRpgQ7kNvwFLpsl-&_nc_oc=AdpqOlwC4mvJZuzLR3z1_cceEK2b9qrqK4zjw3_8K3B-bReBKlH-4f7q8mtbUjYBHaA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kalYrsoiRfC8xiWBiNfw2oDhbPdu3R86sLxSOtpnJLg&oe=6A107
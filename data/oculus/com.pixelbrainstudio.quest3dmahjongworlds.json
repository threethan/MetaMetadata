.com&_nc_ss=7f20f&oh=00_AQOfu8oPjJmuAekFcDJR-KoZsVftjbuI43ksa_O2Vi_OpA&oe=6AC7A9CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_s3b4iSmtgQ7kNvwHhhC3q&_nc_oc=Adr712pZVPDKz18zWOSYabW7l6c-n-Y-ueF09o48v3IToqjLZgiEBi04Sj6lAhmfi-4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOwXBuwiuBXIUjngbpT2rTW8WCOvhY49rd-0YtcPoBKg&oe=6AC7C121"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eqKkLDGFbsQ7kNvwH7BFGl&_nc_oc=AdrOi_8JN_9iM9Lv8t1N4V_Mtwh_p5WAMvVNE7InhUj5YMJLnMAXICfU-McHpyjr4jA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3xsl9vrXFeRABiEqQW4z3cDIZSwHPGilhSoCNDfeOgg&oe=6AC7BBDD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMKOa_lATesQ7kNvwFXcR5n&_nc_oc=AdoEAWCTqWJVfWRzkm5CgcB1iuolFcRfNjE33dCOt-Qdm3gE2N3itbscnzDnk0Fs48U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsss3hpERoG2ugaX-vsdayFybrrWM5wZdAEUNlFULdlg&oe=6AC798EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vn7h_LvlXSkQ7kNvwFbHIM_&_nc_oc=AdrlFB5YOvmeBi4vmRSZKLGxzF7tvGYwLq_bJTj2OGtVk6W2GLqoF5PAFRImKtdPYug&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4_FLb70v7Krt7hVE6P_a0OI6sITUftelc-7hVZpgAug&oe=6AC7BDB2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7MqoKE8JywQ7kNvwEPP5_x&_nc_oc=AdqI5pBIM6CuSivjveqbrQynu-Wipso0nQJ2DYbWOswwlARu-XqQfbr8Jj87RQ_P10M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSbgRPf1ilV0mxGAXKynFLRaVYpzOa3aeJ_hhHpe6FUg&oe=6AC7C400"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIyI6iJf3QIQ7kNvwEIIu70&_nc_oc=AdpTlbkyNFCzwwEPk2QPU77UH9m14bY65htBimBfU1RlhAGyVrrz-mnVEj7jVrdP620&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdeevKB54nFYRMv8AZUFzRbulc66z5mKDjlulvWME3WA&oe=6AC7B4AB
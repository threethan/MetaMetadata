cdn.com&_nc_ss=7f20f&oh=00_AQK6VxjWZ1290HHUvsP36fhD915Bzve6yPh6SlzSvFL1WA&oe=6AB1404E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_sGmpJCZnYQ7kNvwHxyqVV&_nc_oc=AdpQ0qvbcRPVBIcsuAdBHhQsjAQePypncv2wmvfZ9_VGrVVTK4G40qqMFWH7NqJMq6M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDUSSZrLYCU2Pi_1CchzWWp1ktR3HnSxbEVNAUipS4oQ&oe=6AB157A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvIHXKGbV2AQ7kNvwH8B-tM&_nc_oc=AdquqO2CcfaWXXmncuMw1tCWWmc7XuI1L5gOAj4U7BHYRA1jdXu8UPkxkWG78KWHPGU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLohwRDrs6W2VcXp-lUlMnReT32io4U4Dltk44lDGHtg&oe=6AB1525D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkEEz2mfCq4Q7kNvwE7e4RN&_nc_oc=AdpyBzXqmh8FpGI39uYcIexibrWbNZdbU-UAWqsUolSAZviVjYl33U76vIzbXIaxBEw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcS2iBZxUrO6KXjLnVyrmzjMGiPEz3__HKmyh2BNFTyQ&oe=6AB12F6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qzKp3f2XDQQ7kNvwGBEL94&_nc_oc=AdrjXCTCOwnRTqtfOJmygNMxSD9TYTDIqrJ2UmqlZ3407w-6z84-4MelknCD8oQZwtI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnAWt61UMzL2Tt0a2hj2cRf2e259b5gL__N8kQI__JBw&oe=6AB15432"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vV2iu8jISSwQ7kNvwHnQPI4&_nc_oc=AdreBVjsjXlb7NDbpV2uiOwsxaooU2-uzzEJSNAETXTsxAXrmGPplJLR8bCZhImD_E4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG2YYszMSDfnKMLL01QcMTi2nboulEPYhopEPqdoryhg&oe=6AB15A80"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLVIQ5eiDfYQ7kNvwH7YGFT&_nc_oc=AdrbJ2RyUfmjf6vsJgE9x7LK61_CdI2QGTyFDjYxBTkbEZTlBRgoqJVLCBm9VeSvvjU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1PjVVJPKVvoc4_9Tu6HLhqVXmYyqzrK9LKmCtof_W7w&oe=6AB14
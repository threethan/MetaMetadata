cdn.com&_nc_ss=7f20f&oh=00_Af9BgXJOh1nw2SqFS9Y_5_HPwDZS6O4e5yY2SlHkxoT6Eg&oe=6A3E8DCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6wsB__0ZCIQ7kNvwGHCTLh&_nc_oc=Adrd1rH9d66XH8Ckx1G3ERqb4UAh6YL6aUI2A5uQk1RZaVlOx4dknOcYXIZJq0WGpQA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sA8O3OE5jkJtGzeYs_upR2WGuW2knAi4YtQHxAZ-WbA&oe=6A3EA521"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbekWYsHjEsQ7kNvwEu2_O2&_nc_oc=AdreFbp6y8_VVwDfVcyst5R8XJKlO7jLBrRBiGAVUexANH5PEkYrHBgXlgiUVOoyBdA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nyeJHkNilgq_cbe8mBcyFWWcfRB-zl9nEPWuIiXaHZw&oe=6A3E9FDD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Imeb5N40iIwQ7kNvwE7fDkY&_nc_oc=AdqQ8h5EefESuJfSZ8ueont-wRkZn7TlU6vh9Xfk1JTfoc4l6agozd7DItKjRutcob0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0dcR4EJm6GtUo69NFQoUfsbDHcfrsi3zSE-W_szFd3w&oe=6A3E7CEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STUEgFnm7qYQ7kNvwG46Fsx&_nc_oc=Adpkm5doA7sGr2Pihe6meyyVPukOJAwc2F5jcFXB0mxFj9GVnSPXYE25dRUIWvBODRk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JF0WsYhMMVg9AIWd774p9dEq5jc7emgvj4x3Iwov7dw&oe=6A3EA1B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsaE8kVIGrcQ7kNvwHrmz6X&_nc_oc=Adr_7PTpQUv9P9WrlIF9yn4m0wK6r-yYBOo6GuobPdLAkjSQLEHLy4aBQuatZZs0HB4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dEWF3hkLPgSXxjqNH8YfLNIHc9nm6q1nxtbZJ6iBMKA&oe=6A3EA800"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTlS2H7Rxe8Q7kNvwEfg9XR&_nc_oc=AdpG9YtSyu-Na-ZxcxdO3vnuctGnwu_mxnHieojkTYniHUF5FF0z2OPZgTx7dz7AECU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hTa4iM0gE7j3g9yzRbVKVHfadLe0_jNJgea-mbYEBYQ&oe=6A3E9
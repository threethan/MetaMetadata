cdn.com&_nc_ss=7f20f&oh=00_AQB6bPsccDpGdvWkGxBZrFRWbmOea7RtPu2nE_GvABcQkg&oe=6A4D0E4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8rFquAJWKAQ7kNvwHF-ten&_nc_oc=Adp8afvpUVOtVR758b0vS0oR_SC-JsO2CmIKO0kZsX5c2k1PqTSwxkdSqq8ILbWnk1s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp5a9XjbLLWSE3okti8awbYjqW4NYtFNYiZSO2TQRCDw&oe=6A4CED61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FR4JlFDKTEYQ7kNvwF54s1P&_nc_oc=AdqVbToXpjpRsdQ__R9u2b6utVr6rqdfxDJmd665CH3aTP3jK3MoGOJCGNQbRyq6xig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAS7BPvvakkiIN97a1XO3OfBvgcw-MKaYiAG2zErYO-w&oe=6A4D205D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmlT34JhAhoQ7kNvwHu16dB&_nc_oc=AdqtQXX-rseUk2LM70Yisq8PjnFhUoosggPiA7hkiL5Ublna3fomPL5pnTfmJ_mPCV4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcsSC4LW5u3oF-SUBqBDIqGe1KybkT2IQP8Wjg2cCh2Q&oe=6A4CFD6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOtTJTukSIYQ7kNvwE2hR3h&_nc_oc=AdpTnrg-snbqywJKcLDdGJyh0qPVzkXTjNB3eyI7zUgOi7nex4Rad8ptMLcFzAUsBwc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-MaKwcUmumhq4KMX-H7CFw5U_0XQc36uxAx8AnSKVMA&oe=6A4CE9F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SW9KNgeCKMoQ7kNvwFCElKN&_nc_oc=AdpeGgFE44OnA74jNznOynZhDoBvYSsb_kDKBwY6SyU7p2MLv4WwWuzLCwBqYMndYwQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKxNMhe018LjY-G_G3vg7Z3eLcvt0o1mHB9tMTT5P9VA&oe=6A4CF040"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eruuGRiLdxkQ7kNvwHSo4tD&_nc_oc=AdoJqc3F4pXRlu3VmDshIP8OPxKhMhg-gqY25WUK5vogLVLsnOX7bTiWJa3Wu3jvLGE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmo2jRN0HZI-UPrVyySe5FkQT4C0MNqyRqEpHD27gD6g&oe=6A4D1
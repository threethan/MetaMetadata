cdn.com&_nc_ss=7f20f&oh=00_AQLuKOA1aASwCMntmqPJg0MpKQ4SQatWdK3Yg-jwTwbHyw&oe=6AA805CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-ZnoakFuVIQ7kNvwFoJ7lZ&_nc_oc=AdoraUeHIz9XEb1JAg2exDyh8GBXDLudBymi8zFpJPQ93zw8xdUASkNlH543_AYwywM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd0E4UvV7AfYFQLZnnY_8E8nVkglEcf3nlr4yBMtfEKA&oe=6AA7E4E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GxHUunSv9sQ7kNvwHhzDJm&_nc_oc=AdoyCs-ZWEFOTEPc1FTb_7axFSEurHUZtfekq3u6n9TAxxEZFg2OPU63fNKqX803t5M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIet0PfOJpudDb1tiKXy4TU61Pqlwx1H_I06pGtNhbywg&oe=6AA817DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UF-UlOI415IQ7kNvwHq5_u3&_nc_oc=AdqhxXA46WccIcMv70372Zka3AEDdS4-s-_Fb6Cadh1eFMYNiAFBptHxllmpr-32WAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqWVlXPQ9ejFYDFs8dF-Nmt_PcrussootJ3yefxxmqfw&oe=6AA7F4EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u22cmHT1yl0Q7kNvwFtzWO7&_nc_oc=AdqNciBIO0G0andDolVkG1dv7xpIFmV__C8iQ8fN_ELwf92ILhwFaLvEXk4GBP4_f10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnziB4cXxtUYK6Ay5-XLMaHJ1DrjS1VUPdAcBhaF6dgA&oe=6AA819B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4K_uFRdkZEQ7kNvwFP7D8Y&_nc_oc=AdqEIpz3_EBZflnMSkZNcRWbMjn3PBFh_ftUgdVEENPNYWgQ_eXBDgI7YxT2GdwsyFU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwdiW_JAtEhKLlmKM7LSmQ6jpiUy19DXjFG-Co0GL0EQ&oe=6AA7E7C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJhIflGFLWcQ7kNvwGvjJpy&_nc_oc=Adp8Tljo0Y9pxWgDAlb8V9RK-oTIzDMhOrHHdFUi3cFHonVRAUTxfsvx-7EksmARQfM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmFZnmAvFpIJX_E9aF_4e1j2Fhhw8KyusmhyufDoqYUA&oe=6AA81
cdn.com&_nc_ss=7f20f&oh=00_AQAJzk-_QROZwWykKsR8vKXfkaSacyi59yZnN2PN6zmWxQ&oe=6A5648CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVF8gvSa3ecQ7kNvwGd16hh&_nc_oc=Adriq-qe51O-MBlVg2TbxDZ_ib1dPou94Mx3YydXM1IBfFlJdvxNcZwDpBrFDFSNtAE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCow5rrynPFTbdXdkQD5uAwPx2n-U_N1Y3dQuHNmTowag&oe=6A5627E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Al6Vb2Q_tIIQ7kNvwEJmwVd&_nc_oc=AdryZgj5E2m_wRmk9SgmheDQoZNmIkrptzCP3l39H0ImoGlyPTpBphk7XkP_6PQDB6M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyXbvYDxHy23oVEMe9ru8H-qM5KUgMQM4iUjqQY9Np8w&oe=6A56229D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Dfn2nrm0WUQ7kNvwG9CURg&_nc_oc=AdqrM85qN7BMOf08rJnKws4zf48gQ3bsCgCWxjKMgOCsNDS7ipLzsBzXlMQUeg3myhk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcGULclTDYZP-XwXHs9AWWMAH1LX9nA4k8x6pQYQ1iQQ&oe=6A5637EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A431ylAlBfwQ7kNvwGuyx3P&_nc_oc=AdqTp4ReRIgMarbOIdJBbrMwfExNiAGXN4GmWiRechOPkr3jwEoJUkPpj_3dTpfxxhs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAch-sUWRfu81cL9aLqreYWIhJu9i-G46F5_x1chqhaA&oe=6A562472"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QgVK491zvMQ7kNvwHcpQ94&_nc_oc=AdpAdz9aSHM50qHfWEezE_kyihMxoT6HITV6k5njlWDOqEiYQ0Ddtx5Zjel-FHFiVR0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuWFr-cPF7g6d4nlMy0IhcDlpkLrYZ93poyledQlnf9w&oe=6A562AC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pv1R2YVWK8YQ7kNvwHCLC7M&_nc_oc=AdpA7XCDBnz0wMV8wnxfUqNVEO2vk4rN0j-xUAuFSVgyBdafpnKRuNVgoh4JJy9TsZs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAY5WZMc5Vwpo8i4BiemnCjghVbwKNoh_vfhp35JFE3kw&oe=6A565
cdn.com&_nc_ss=7f20f&oh=00_AQFWiifJ_s-my-mCtBA9HCK0IfVUSGIZEu18pUckceRZ5g&oe=6A94070E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rUre6wFEfIQ7kNvwHsverU&_nc_oc=AdoBO5zAKQKP4pYtSR5nwRl1y4_w4zhUvJBM32AX8CkSTcCA0BZmMj9pI-aL5It3lo4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDTf7oYJOQlh4HhlSN7WUgm6Gbe7yQCtbVSSwNDTdP9A&oe=6A941E61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSOXhDg1-dUQ7kNvwH8Da7m&_nc_oc=Adojq9rcuRJLCp4juXouxVXaERPH1eKSCiQjEDjta9Ifsr2ofDYvocazN_fs6KwA4Sc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuGLhrkxHl3a54KsjrRXW5WtLBkcxMQ58lYG_uPVgT2w&oe=6A94191D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-hu8CJxNmsQ7kNvwEbdLST&_nc_oc=Adp7YBJ9geZhcBxgV1-QWgrbtZKofKjfAJkXlTPuRvdadf9bar7nGhg_dTbaASgnIys&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWd6Wxjxt6Xz4TXVM8gjJueC7WlaCRkKqU3S--ssAU_Q&oe=6A942E6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0J3TWWHPoAQ7kNvwESvmac&_nc_oc=AdqrG3lBBeBJLUN-6-6pj68fnP9TB5ageM7AfLXkyloHiPRE__Cg3myFt1McuoIY4Jo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiE9_npkjvhKee0OwKmTM_miE1smZ7nl2o74oFVteJTg&oe=6A941AF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J-hj4bDbtcQ7kNvwFsmelQ&_nc_oc=AdpyrzlcaiSZefPGTm8xfJ_FPclRPHGBpZTVlqg2O6GG49JMk_9VE9iWG-65xfLqQlk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHy2Xg5pDqtq_V8KxwriyF-faiytGeFAigS0FMGgYH9IQ&oe=6A942140"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4e1rNwd3K9kQ7kNvwE79sus&_nc_oc=Adpd_6W_3QvZqpbcmH-fsqYXONxELWdTB-qPoFFD8lilzzTTGZBGbsIxl14UVSeONYY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcplJo-Kx2JhaqGMzMUZYO_s8nNivnWFVybfbBpZBzTA&oe=6A941
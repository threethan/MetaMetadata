uluscdn.com&_nc_ss=7f20f&oh=00_AQH3ijq3gtdB17zqvi5RpNErN0VQhWE6tqRdTwbvaK4O8g&oe=6A7D9D8E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rbftLgOL8kQ7kNvwG1PVb6&_nc_oc=Adrkxr6cANCrZqWuCl2fVfIynC2je2VmnZjBP0L7Ly_9yGv1UggBlc5nVptqPdDFG8Q&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0Jj5PbLNHD8SCwm3778a_Umy9TVg14y4SLIWPw0dnbg&oe=6A7DB4E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQgjXwuzpcAQ7kNvwFh59WP&_nc_oc=Adqr17ivon8yQsaicp_iigKm9aF0QxOqCtKklF8SmrWsf3U72xYvrVe5FCHgy8eP_zo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHae_pHqHZF_GP8n_eJVYjAsEX6NuwnUudG7nkkF14sjw&oe=6A7DAF9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QO3-YKA9gYQ7kNvwGZAiUE&_nc_oc=AdqTzSU7ogN0NkRHgGSTrJC4sOIxkMiO4C34aq3OTyBzFWr_Ew-PXiLPeoei6B2S0wQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUN1-fBftlXfU8RZVZIbiKXCDfhpg1rF14VDWGgStTRQ&oe=6A7DC4EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxrpFVHdxZUQ7kNvwHUBuJP&_nc_oc=AdpuW3WxYP4Pk9mbYejq3o0Q_7hDmomME6AoJLG4LjOqFe15cgugeUg1JKZET0eyni4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0Kl2eddMTmhC0Ps73YzuhUEjYyTHSNxFQ14meBh0C9A&oe=6A7DB172"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEgBmgpaCLkQ7kNvwHdoJOm&_nc_oc=Ado7435vVmYZLUd0a2bovuErHB2ZalvBx77kWRkSB5rbTTcTHmf1fVF-lPAZYw-3uGs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzD-nRGg5Tchi49KiruzR6YDqA9EFh728UDvizsVQMkA&oe=6A7DB7C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD8EmkHkWDEQ7kNvwGdSKs4&_nc_oc=AdrrD-bA_UFkYeGUfl3v5cdriSbOlp-Bg3-XPhX5gix_0bTuWH4R6jR3jwMEZIHmjiA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNx6nIJZi0yKJOE_ToENSJFwc_HgkGsOxMy3TYiMQBIg&oe
cdn.com&_nc_ss=7f20f&oh=00_Af7K8I4HZO5Ns50G0RSzoX62A85KMqpMQYYjFYNjQmuXOQ&oe=69FCA2CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjX8cl6N05kQ7kNvwGQ9fa3&_nc_oc=AdoDcTjquF-BnrM0Hc_xCI5DvcNB8vPsPiHFbevKOFzGL7sRYKoFCAc4WGWqLgnyQSw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4T4_ws7R2BOG0ONV4MkoIzpGIEa-fGhrU8D3hbckSfTg&oe=69FC81E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qiIDJ_081UQ7kNvwFWXpEg&_nc_oc=AdpVCINepJiY-BB8OqysqZ8GMdMBYTt2FVas48Qiu7RPUtzn77ngSfMIudlA5De93qI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nbxo7_24V73qZRszJuEuWOiZct59QTLckarvQKL2Fxw&oe=69FC7C9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fr6-nvdiF30Q7kNvwEyJdoY&_nc_oc=AdoznuEZ7ITO8lMakHu9Dhw0OELsbW2TJyGZHR6apG9-evRRfN2vNafq9amvjw3MqMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4v-HPct1-fopCiFAA88Oe_jnCLjzcoVX-zdrbkd21e6A&oe=69FC91EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5tHt4EuiKoQ7kNvwHWebZO&_nc_oc=AdofKodJMuTvipT5_av2pKN52OmKLcwWcIXCVeslfV95sY2rVZtVq1ETcf8iGovFub0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6j0bD_2uCl6_uvm1Y4G0YpcAu0IfU2xCoS9bRm-Rzs-Q&oe=69FC7E72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9ZknTyS1ZgQ7kNvwFyV8RH&_nc_oc=Ado3dDeqL7tgpm_RoOR6mKhGsJNEDkasH1eF3H7jZI5TPezr4ph2vPEsXEbzAjCjbIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fthKNWX_5IvYhfrl4PdfL_odxSqPQE5EaSidOZO4V8w&oe=69FC84C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiWlbbtZRAsQ7kNvwGl2wCi&_nc_oc=Adqa9BiSsNKiT-wtf8x1RuvZfeCff3TBYHzSF87VjYG0FyofKJ0bKoXq0Ag4u732SV0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FV6o6-SqpdGC1iAenW5gny9P__qb8nZOSuub-BomF1Q&oe=69FCA
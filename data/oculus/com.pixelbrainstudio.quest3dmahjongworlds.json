cdn.com&_nc_ss=7f20f&oh=00_AQIYJH7PoPZYZhC5-NutVS4rQNZjd_sdansQKUaYd6a30g&oe=6A9C284E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMYH3aRMGPoQ7kNvwFjLU0-&_nc_oc=AdoZ1xb2E37KTGMmiksOza5l-8zkACGjfxOi0KdtZOTFDlZjBMqTOMePFUfTg4v5b7Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ0VGj7yC4eY7SuPFxuv4B4SNoExr3dtWO3t9QKcqskw&oe=6A9C3FA1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-qTL2NEPQUQ7kNvwHZuVKP&_nc_oc=AdodExY2-ZZJecIfsazor1HT_LEfnnSwCAiPDz_w4L4hiw8wqpY8WIwlm37e6YqNaBc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs1Bulyy83rouBbZ0-87l2ddXeIpGJTulx63TFzw0bsw&oe=6A9C3A5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rnt_s8nNRAYQ7kNvwHUvMnq&_nc_oc=AdrzuaJ-3jGZeSiXxhifoEElsxVCp-M5NfIthPVMQ4WzKathvWbds3ZLyiRShsD1HJs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYkIWGTpdMk7uvESBw2zE-yvmg0vZ8WiXX0GSgmUR5jA&oe=6A9C176B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kmb0dDkEgVgQ7kNvwF2vTby&_nc_oc=AdoWVOHLauhtC0YnLO6R_F74ybh3a3I2O-dCV2pSMFycufLmdW2mtJ-pw5LqySoijxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk6mvj9xcRkbEcKXrtc0Ha8T9hEFfw2iGdzzWcEkWz0Q&oe=6A9C3C32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xcs6lVq4JBwQ7kNvwFDPdZC&_nc_oc=Adp6kGYuah3PemHZBEEiiscAQJwWAYCHulXC1MlAY9w3r7XXzdHgL_Le7RRaMHcxQNY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn0JU9BuXFtLOlON2JlIcQOA3AfWLU-C6aEW-BJpDQOg&oe=6A9C0A40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OXfFbdDlIEQ7kNvwGZAkoh&_nc_oc=AdqSHr05oeT-2ozjAOHna-mg0b-xmT5tNDf9p5P9uioPcz6bJ-ddVNKUQEXZi-aJA1U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeDerUqmX_fqnLKtIXDf4HdGjXPO7ERSAF7I-Y86jF_Q&oe=6A9C3
cdn.com&_nc_ss=7a30f&oh=00_Af0HGjcQuRmgtx4RgUsYwR2qVrEQr-GA8MoYyrf2GUFkNQ&oe=69EB7F4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBXpOAzYVRwQ7kNvwFuHB-B&_nc_oc=AdrAe3-B3cOeo_cV9Kis4Zcnxfg5b4HwlpRuDVmI6d4kJtvKdfal2Y-VEMjrw5DKdAc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27JIeDZjh-86_t-ejLm2jBPqYlc1tERxDtscxPDW7m1A&oe=69EB5E61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYsgZQPGxiYQ7kNvwELo9wm&_nc_oc=AdoMSV4WFDbYHR4fILTO_WcJO0Udztg__XcNufXeQEZTeWljZotDxihp9VQC0H-HUZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rvIgq9dx8lte0sl6MkdNY_VX-reijfHloxjA8cdVphg&oe=69EB591D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmqegnEwjXkQ7kNvwHENtRj&_nc_oc=AdqPVaekmh_psMMHG0UTWUz_OfkCaSnYvAZHG6sAPYzhLofxRIva-c6kaD12P85uvZE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YgMzab9aJcKNX7h4EZVigwiE7-IHIsulF3qsydZWRVw&oe=69EB6E6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WX4toDyY5AQ7kNvwGH1RYu&_nc_oc=AdrpuaZVwNL_bFQ2M0lF4IjIKX83ARBmYpoUflmrqKZQuj19hsBFPc3PphJaXFziJp8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Vjjg52WEJ4hb0m-v_e4kkLahekkIN3KoATXqlwkg1yw&oe=69EB5AF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBUJRwA33DIQ7kNvwGwxciA&_nc_oc=AdqoZlv4Ly-XuQg6-Z6zKnt8HZOz_yju0FTuxPbeuZ5KTqv-nLaMASeoXuSLnvGV2D0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hpQauGZFDx4WQUeuHxVaCz-FfvS7BHW0_g3z-cj6uoA&oe=69EB6140"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxMMJITatKcQ7kNvwEfyO2F&_nc_oc=Adq4ChjfQsAcwebNEB0h0GyWNmx28OF-YXVolRNGI-_-MiFnY_J0Gg17MZBaAg4_73k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HXUcPX6eX-fym-8oaAELzqrYocRL69uSaByPvtuozPg&oe=69EB8
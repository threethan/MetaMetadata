cdn.com&_nc_ss=7f20f&oh=00_AQJgSakig3lU8vSwymyljGWLXjETypBRy_uYFUt_crALPA&oe=6AA16E4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VhgzLeYvDkQ7kNvwHXSgEj&_nc_oc=AdoA9_wD2ZMwrMuz9xiY90UmXLZNvfNb0NH85EIrhKj7c6dFNWASdKC7mK7cjbMq1jI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR5kt_buIuZWv_TM_BqHuPnAjgLV2K7uVlGaW5ePg-Cw&oe=6AA14D61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQB0iZhxW-kQ7kNvwFkRQtm&_nc_oc=AdqWD_FkO0TQOd7eed2ilWDEICKstioCxnW1T3KarOeZVk_zJpAXNDiYEa_IUPshq6U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLsf4iZoEHNs_mIVfU1O_aFhKuKmD_aND37spndVUlOQ&oe=6AA1805D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxRvobHGUDIQ7kNvwFQM3BP&_nc_oc=Adqdh4iY4Cw_9qXiea7trIdMJMosoa0z2PWdat_YPBhQrNL3lsEnwQ3Erv0xK0Gsn8E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYJhBBBbmtZ0Os6oWJBb-FNJiS-CSrpjU6M7klMoSTVg&oe=6AA15D6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gShWA30oN4MQ7kNvwEPZBV3&_nc_oc=AdqiXEsPAif_fIosxKs8iAzdKL_pMVZUCkeaPwJDuwYh-QiVnGly84b7SvnSSrKRbOA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJC74RbRspeQ0HQfAgboY9v7rsnP2es-s8u_jFZPUjitg&oe=6AA149F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjZHjoJIdaAQ7kNvwF52p_Y&_nc_oc=AdrWYowVhg59JQhzcJhIFaMkKj87s1OFf0ANeJULoQwh5xicxdPukjzsFNEJOduF-cM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrZjEcMswRHUvtiWI86hDKN4yBiYs5pmbSheXZHNmuJw&oe=6AA15040"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9AVlxeYS6YQ7kNvwEnjkB4&_nc_oc=AdrA8gMXfAxxkQU2uCjANJaeJdtWmJWTuB-4L8ljuc1jbe5JU8JuiUkudKOkeEd5DUw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRzcuVa7R4xeCsIVKm2tGvs2VQaUAKOYcZPbHElX47dg&oe=6AA17
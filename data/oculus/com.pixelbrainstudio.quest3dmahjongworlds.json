cdn.com&_nc_ss=7f20f&oh=00_AQL2fX8JGTJkCV2VGJj08xruX92H9M9jA0PJpoOksObV3Q&oe=6AABFA4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7p6VOV1Qt8Q7kNvwFg5Nxv&_nc_oc=AdpX4hlsTV3PvVyMhLXYH6CC3aG871-wJHsyHmI0-qjwc59lczRaQ1XBgLpoC1dBSJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmFXJsg2B6_uul3dzQl8DCWSjci85fEKqlxQJGxg_hsw&oe=6AABD961"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knQswwke_YAQ7kNvwG6LQh9&_nc_oc=AdqhfSAd-Aa1KkxgDSUQ5TXJAzC-uJP3_aYpC6rPGMvrDaQ3r73k_tSu3IpVIhJ-RSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLVCyE30jKmTKavfEFBJL5BHKV6zxiRLi85x6gQgwyRw&oe=6AAC0C5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soOw8j7cZLYQ7kNvwGStIhz&_nc_oc=AdodT6WF7GqBnAXaSj2M4jM8d-Qenr3apfgj4R96ealmRPV26OnqyI-VlPOzQguQPfg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBdOlufP9cWZowYd1nQCw2aCUcptfTsJm-yeSdQ2kHHw&oe=6AABE96B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8prpinAXOsQ7kNvwFf7UoK&_nc_oc=AdqzgQ4sy8xcGC9PJ7P0_4CSxsENoJJB4EACunHpqFQcPPJXZkNKVG0iKSgL2Mte4LM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAL-cRPZz434IubjHBBV4idv0UQL-KqEFpc6JoN7OxFg&oe=6AAC0E32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IDArSl2PoEQ7kNvwGAa24b&_nc_oc=AdorCNxQH8parsmQ224ObxAiWY8OBkQIm6iYxtH9R6T5H9Iv2EIXz9xquOzi9nw2Mio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5VY45fd7vy8g7FCo4jzuIOK2Rd6KdluI496uK5Z0LJQ&oe=6AABDC40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHBh1KxLfckQ7kNvwF5Bo6J&_nc_oc=Adr5uoGPsQN_xAhakUJektpEb8hvlKkZ4NkLVjsg1Jv87E_C9FQ2tCf_lDErNY2cYmA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqiWcXWts-egQMT10AB8-JK6brUmkmMu5mkCPDHvN87w&oe=6AAC0
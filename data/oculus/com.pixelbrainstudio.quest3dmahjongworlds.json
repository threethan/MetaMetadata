cdn.com&_nc_ss=7f20f&oh=00_Af-vo852bG7GPf9meowfr2gqSQWW04TxwowBGFHWjCWc7g&oe=6A3A994E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-E2e_dVd1QQ7kNvwHSX_dn&_nc_oc=AdokBpx_m0WAsJO-neImlxEAWaQfxshkBXWuA8m-N53KN67ztKCCDTm0q6ZSaBK3Z-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nDuY4-FcOdyv7E4MEExjsVOeGuWzqE54tfhsg8r8KXw&oe=6A3AB0A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1XEmxvy-S8Q7kNvwEdi5sG&_nc_oc=AdoieckDZUCNcSZMKkxV4lz27SBesdG17-bYy35z166I7ENzC6NWUxsSE59l-3GhqeY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FIahYdVTn-Cm-dIbX2E9PsDM9isQ2RtC7oLSp795_WA&oe=6A3AAB5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36H6VINUXAwQ7kNvwEA8E3h&_nc_oc=AdoN3vg2lJEoCWgRI0vi3-PKVcmuwjA2ke7xPcTgn5HTUN6DXCbp5XP1-NttlMObRdk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Cl4H82TPxRF0b9xuoHeRlRkRfxBOaDeevNYNTL3hTUA&oe=6A3A886B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kr4uwpUtpwQ7kNvwE5thC4&_nc_oc=Adp7bm6Exq77fI37KriHoDhx1GLno2f9LFfhGIyTC8BOlwBsCubVZvv1NA3fhHa3cZU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94ygP_-cJX3eHOuX04CDCvqLW5uW1BLSne7mGKyvPFZg&oe=6A3AAD32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2ziGPHgUFsQ7kNvwFrT6s2&_nc_oc=Adp-_4QkxurONJwB1Z1J1tYaB1B-9zKQry9UtW9z169gzbFY6vUuPyFM4eMXMmOZD9E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jaLJn50rcLBSCBzx1Ht0hl2SE_eCS9F0aO9EiPu5rMQ&oe=6A3AB380"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jUu-qw02IIQ7kNvwFoS7pD&_nc_oc=Adp6xuk00iGuyF6YgeyzzX-XJ-ZeA1tYExt_MsA4bf17ZKetAWjzS_46u4DurNgikAk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HsuKBv2Quy2VDDRMGm35itx_T08QaK-Rfqv7nd8GYvQ&oe=6A3AA
cdn.com&_nc_ss=7f20f&oh=00_AQBsGZxwUaw45M2OvFLk9Vyr5u1hIoPkYN1VwR1PkVsEAg&oe=6A62264E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SDWZSok6g4Q7kNvwEvgC5C&_nc_oc=AdoM4v78pHMa9xLppSVK6MULGQF6znvEPaTymESk5JeG5pQGulFX0b6MtsVrsEfEtHQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDznoebzEtW5x3qo-DNTDnI8lbJAYkXPYERIDAwHQ1RDg&oe=6A620561"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xd7jtfsUU40Q7kNvwHQMpbl&_nc_oc=Adpzo1i4BWNirJYqpcG5OyQaU5n3mdHP5GRcv0uLzBo1maa4qgQ4-abiCp9wHCTmfqc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrg_2a0IfJIyUY0wOgzBtPyhqoIoI7ymmTbqP1P6Nmyg&oe=6A62001D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ecl6aaaMjEQ7kNvwEgnmnA&_nc_oc=AdrxsTRbDpk-dMnEQq_35xLwWzttpV2VlZOgtTGhirE81HV-VXddeHs2b4AVOsdcIRo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8S23_VleEzXOVesD9Q79O-bOEEXUdDm9omUgl8L5SGg&oe=6A62156B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yR7XjaCN4wIQ7kNvwFWmRuT&_nc_oc=Adpm68aKrnJRdCtfLtiNw0li1uQZjGPecCevp0brCIvhec4O-RwOLMbA9vS3YC6r1Go&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4ebp20WG6i20It0X4lcLKqx4qdZft3AoOzvcpon_GbA&oe=6A6201F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnsEuEkBBuoQ7kNvwGHZSoa&_nc_oc=Adr3JNfw3I0e7PmyAs1v_6aTftIlYD34abq4o3pijuLuvtAWXpW1pow94pHM3txF_O8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDb9Yhn9H9uG-eSyX_WpIBM94dQCe2USsqBYu7bQKbeLg&oe=6A620840"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6ig-tMcKPoQ7kNvwEkTL0N&_nc_oc=AdooyBBBqTBeFia9aQ4SFFvRd6YcWlL7KMHbEO28vrDxJx_HqfqzsiAMfTugw9_okuc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9_RrsIPbVHQXNWjGpw5yX-dooQ-ldtpu5UeYWpu0vjA&oe=6A623
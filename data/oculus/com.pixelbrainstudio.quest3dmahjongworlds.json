.com&_nc_ss=7f20f&oh=00_AQTZtSQQw1czkDgukWQ7EXtREGQmKBZuxd1WDcaPiEeixQ&oe=6AF32B4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7P4opAnTH44Q7kNvwFPNQWt&_nc_oc=AdpcEvSezwpw7aoOFulvMDbUBKcR6fhteXk9J8C3oBfPJMCFqimMEtok8qgzIwxm4aI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVThTZ9st6GchLWUMRs4pqrZrUZhQDWerh-HhYAaGQNw&oe=6AF342A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5_Nw17hyTAQ7kNvwHBZ8G9&_nc_oc=AdoTEPue5vh5FD79p7JQykShiGmYXhowaQb3wxmtlIGO6eKcBtatf7AhC2yVMwT5lmA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3Vd8Bq6S4B6rw66HT8jJqvJBjMuFuw9k9Lww0a9hx6A&oe=6AF33D5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLRy9fLU8bYQ7kNvwFAAeiI&_nc_oc=AdogdArtR_gcDBJhGq8ufzc1H2X8YQp50Rji4F60vu3-uaW_rYqKLvd3JPPGSrcAZLc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVdiCJ4P2EvaIBryqw7hLQckYh2FQ0rnKN3DPrTTuEcQ&oe=6AF352AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fh6OSqNicEQ7kNvwEddseq&_nc_oc=AdpIJSaBUtsetPdS27XOQJ6kokBVIX7XiwtLF1yPUuGDcS18-adQO1tg_YAadWpRmHU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK5pLn9rbMr2BfhiYgSS5wqBtiCS1GeP51Js1L7ZHyoA&oe=6AF33F32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF96qLusXecQ7kNvwH_qkM9&_nc_oc=AdpfFT9jpjykjSjgSk21kMdc08HysH-sn8LJFOV1cL7B4tACFTceSgDLaFfGAJUCzz4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBgNlLNM5SRPJNOP90Nn9n0qhGdOk0iCDn9ESDsQ7mtQ&oe=6AF34580"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58b0GRQfmlgQ7kNvwHQuKWD&_nc_oc=AdrdqO5SUHHI2kLd0ozHs4RszPH17VrjBmoa-7LNsoJtHMwcKeabUtuSkkRFGcsBHNY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiwZlY4pEWKSiV6D0znqDxKAQ1Wy6IWG7hZEq3-QaNsw&oe=6AF3362B
cdn.com&_nc_ss=7f20f&oh=00_AQDwWBhXhDlkJJBPdcXbyAmfJ_qWRuFiw0H7Gu4h329XAg&oe=6A6CB24E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKhy6xkRbpwQ7kNvwFSe3sl&_nc_oc=AdpNOJWLeajqat2WS9oYGj6_isggX-bAFgfefzOI5Sa3rm_qHDMm4Yo-6112snOVYds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkIkd7NKufcT8bhXaf7NwieP40NSUPDx6AMv8_0wWNjw&oe=6A6C9161"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjfR7I67sicQ7kNvwGxMOif&_nc_oc=AdqhHYFn-fQgSJks9A9CtOQ44TuFs7hSbkRqnYVv70uibfp893N4q2sn70Su7uIUbJc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDceAzNkaDMyH5ZBX4HY0CkafBOXcWm4u5SwgLscT1iwA&oe=6A6CC45D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIWVzQagfTwQ7kNvwGZvFkP&_nc_oc=AdpWKVJISQICPoaGjUq26ig-ZVPVMaBXDhDUtNqkdyNHcKNmgKBAloUBWVh09LjCXZs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXTbCNcCd1bbh_pJ1tYlcoIacXA5rL7ms03YrNnvfOag&oe=6A6CA16B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VG29cSkfAssQ7kNvwFJrJmG&_nc_oc=Ado_Hn3n0ySi189FGVGKH-IiPxoyZrsKQ18lcyV9IsYK5uK5-8rvRLcPVf-RBpa3lZw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYMu-OiD-JBPUJC0qujhRHlZ-PRnfOY7ToXgMhCFmo6w&oe=6A6C8DF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3_aBXIMjcEQ7kNvwHEqE2v&_nc_oc=Adqi8lot-cLQlum_CgiQ4KGu7Z0GN1YYY3tbtkhhYVPpJCdXI_-AXMo0tiA7GBBzAVM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChhNHO2EdSXMECb4SkgXOucsWxVSMYMbKMC-IcmlJ0nw&oe=6A6C9440"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fieDBTldW8EQ7kNvwE8ZUyW&_nc_oc=Adq8nurWrsKnwEBdK7oZycPRIiwc-5zZkVSl1SdtkCCGw356zXb6cP3Bt-eaZ6zDuGc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2qIwdK4_wFrzlWUBVWR-ZJACe61NK5ixT_WyjS1UqHQ&oe=6A6CB
.com&_nc_ss=7f20f&oh=00_AQTeqQ7NppkFPJbm5chfr70BmGdbGucdK6fPXoDtcb0q7A&oe=6AF47CCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7P4opAnTH44Q7kNvwHXQsIe&_nc_oc=AdoxGzInPZVosXa0Yks6u-m734g7a7SW-nJjcuYYpOojZ1w2WyLpVomt5qQsmJir_Js&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQtnV-ovkpFlOsQ_Hus9pqifSyj4ZES8eFbQEivxzkFg&oe=6AF49421"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YV_UGuZACYQ7kNvwF8-gFy&_nc_oc=Adr1euzBB0AWCQap8ZuO40AJn_9e3Sjw9WDPQtT7nMM4-B6A5KgQN7zWCgpKI6mtquE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaLhRSI9iRJvFxz-srB3Lwb6u1GnR9-sl3JFixCzr8aA&oe=6AF48EDD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLRy9fLU8bYQ7kNvwG54WOE&_nc_oc=AdrCW0uMNylECEjLvv7R1vaExqOjAbx6FE9ty1IzUSQl9L0wp8ATqHuST11JqXHm8NY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-bcqeXdLGkXFvtc_u0ZSKeX55Ty8eVsGK_nxmdhwTAQ&oe=6AF4A42B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9u3brRCn0wYQ7kNvwFGzDJf&_nc_oc=AdpqYK-M5oVrh7dKzxkXCAuMP2EW034ZF4QY-Z1crE78tY-F3a8Yw84O-7nwQI0qnRk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpo1ranjwwKM4CnnfvgHeeFBxsj4QZmb3Qlf3nLUSduw&oe=6AF490B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF96qLusXecQ7kNvwEeT_SV&_nc_oc=Adoxv5N5PNfbHhzH4WoaVlG3zZhl2a2MJcc8lByk_KcS7JvprjJDq2IQ5FNujRR8MnQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVag3c5aeWTref7B-JFF0h66ZipScgh74GX10kn3icOw&oe=6AF49700"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58b0GRQfmlgQ7kNvwGKGtDp&_nc_oc=AdqWoTqH1YoaQI-jMN8x9uuXyw7_ntiZ3Z6KFx1VHYWWeirhf4U4FN5Yj6_7-QVx96s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFLIk8zp3z2dh-bkrqEqUTBosryjuKXlOx_fy2nnkXtQ&oe=6AF487AB
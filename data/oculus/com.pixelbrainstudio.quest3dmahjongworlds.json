.com&_nc_ss=7f20f&oh=00_AQIpm3iq2V6-mykSF1pHSnFFMQn5eHk1OET30FXB2u5rXQ&oe=6ABA7ACE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgdoACA5V2wQ7kNvwGY9gu7&_nc_oc=AdrrHA-rsb4f9H8k8Kw-iYLXuACZx_sP40lH92kUbtEvH175wCiOnISx9Db0uztxQkU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJUsntv0ceZL_aD_E2nsmpDNLK3q1-ghjY6ieco0BL1g&oe=6ABA59E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeKhWhrcIfYQ7kNvwFD756w&_nc_oc=AdqISRjZ7AhF2LYX1yFaG1Fh10gAboe-ueB7TebT_T4bw_xi3oghexny2XIzxyI6He4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0SdqUEGMrorQ-Sp2a65VOiog_8hC1GJsbr3JSZiFghQ&oe=6ABA8CDD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Arffu3r1N2QQ7kNvwG6hjja&_nc_oc=Adpo9vxGBlkKL6XPz98JKiffZznn1FSPMC_pJvh5uGR44iQQYqyb4JrfLLIqIsCVj6I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXDt9Aul_HWwD34ygy_t3_yHEa7srIez8ldN0sHuE3hA&oe=6ABA69EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GUD5blC5uQQ7kNvwGTRp5C&_nc_oc=AdqP1nx04fE0-dSHeZpdWB2dLMZY4iq8w2_2-grU5g_e91v1V0n2-eax3xoKMseHr7M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTVcomwWIXCHAkhBZ2ydevPy6NbPshyIVyc3NLESJ1GA&oe=6ABA8EB2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERTHJvjNDeEQ7kNvwHa2YW7&_nc_oc=AdrNi-JgczfQxJMH0bS8bO14vQELkGMyLk-YPZguRYQ-0T0EdEMhkDmJ9SV4Pli3CoY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjT9z-SpQHe9EqJhWoCj2eIpQ5p6kCOqO0ngG5Mtkn0A&oe=6ABA5CC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAmM-k71O_UQ7kNvwFq6OV6&_nc_oc=AdqA-GT67xLqXfIdOVs6Lf3RuM7CCrWLujI9DkNRGB0eYmosAB-TPr7A9rlRMD-xRBY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK89a4qtBGQwvpxP9MACCwh1h90fy5bFUpCD611kYTesQ&oe=6ABA85AB
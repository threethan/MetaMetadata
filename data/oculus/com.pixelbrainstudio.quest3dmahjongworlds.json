cdn.com&_nc_ss=7f20f&oh=00_Af8GN1n5WhMaPv9ZqgoNI1oAHk2Z1irfO-P0MdyRVMO-8g&oe=6A2C18CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61mj65rHbFUQ7kNvwFSH4BW&_nc_oc=AdrFRUopzcpav_7cpU58qePCosBBol-0VFrMQKQKDuWe-GShp1LrLQpHB4LKJCgnhac&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qdOQQyzTxh9c_I3LZdtlJ-67m2NjsXpV3IH-8JAOikw&oe=6A2C3021"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zPF0TmQRMoQ7kNvwFDGtQ1&_nc_oc=AdpqBHugXgViY55h9vokVRuXRQiBk8MTaNqtDKOh7P4M2SrdazQ28xwndYeNbRqmZlU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7Vb9fIgKoNm7OopPWD-RbGvIPILs--MOOpBWU9yYizg&oe=6A2C2ADD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuI1yWGAeYgQ7kNvwFqVJs3&_nc_oc=Ado59h_9smk31Zb9KDDAWXp9zh_wzP5Tf1rTL_dYpRS5c5fLivFXwkzsD3bAyMWJa7M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9owDDypsQkxOSkjwtx23FbSryw-XklFLsJD0vVooqXYA&oe=6A2C07EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aJLqaGokTIQ7kNvwGgKcP7&_nc_oc=AdoK3GiidEVc3MjjedRN0WrjEM5Y0M9PPYXNFr5ZrmrAXuGPtx8EXJNALpqVs1wPw7A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-EvVuig1LFszbNBNbwvUWsLKRnEtaS04qyXy9ETrnOg&oe=6A2C2CB2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXPlC2e8368Q7kNvwGfwJDa&_nc_oc=Adp0ab32xXwQ0XFdN3p4PO5MyguiclfvdxzUkaYmo0GP_MLM07xeLb8HmAUtBV2oOVw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Kl0TdphK8WxH_PeComOK00v56HLaCzbPGG34knmLWPw&oe=6A2C3300"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMkFfrq3BOgQ7kNvwE-GL9G&_nc_oc=AdqSYBBxLsw72p7xmvLQkHvfAp2uEVkHa_QCejak-FpnEChjTzs8_e3WzmNTp3DEZB8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2lMaTWksgZR20xu-eYsQ5RijuHGJveyCtMqXbcg4rxQ&oe=6A2C2
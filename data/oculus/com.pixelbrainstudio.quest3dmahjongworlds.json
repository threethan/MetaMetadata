.com&_nc_ss=7f20f&oh=00_AQNGnnVfZ9eefiavgZarsLM-nUErxk9g-Q527o8NAhNh8A&oe=6AE207CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YlnYCGLgbkQ7kNvwFJsWno&_nc_oc=AdoqZ4PXVkWGE2aNFyfBR9vE5F-zQLIB4UiXgM3yPFkqRl0t5XekyZgnI94XANg5qjs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjjvMSk5HQhHdwU1tBDoJ4mW831020jLTvEtO4MXyNUA&oe=6AE1E6E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=679in72yQ0EQ7kNvwG_2kWB&_nc_oc=AdptzvHIq6OuvDAVndSrx5qkczv41ZXIFXRqw1PATZYhZLi-mGpmaZV5sFm7dpZpUOg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkzQp2B8bRJKgQeL3vowr8WkXgvvc5kteny4FDFKKqOg&oe=6AE219DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOa1OFbrgDoQ7kNvwGryTeb&_nc_oc=AdqsIuQlGPKaF0jXAwFeIhMhgBuQvAmIfpvgay4P2K4JzJ1TCWULypSezGlVg4sLFPw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPG_iVilw72JkNm5xn5WfAbVWxTvAPSoIZlerJPeJXk8Q&oe=6AE1F6EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY0YBMX2OK4Q7kNvwEv2SeU&_nc_oc=Adp2oQ1XzNCiNHGlBoHFm_rIhWveaF-fDMiFlGpmP3mITYZn-jmF9Y-n8ZmYFURNAqA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfSOs7S1RGoELQKVPANGUFuQzmXN17PyAULng0zeRTLg&oe=6AE21BB2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIktErq27-sQ7kNvwH_U3CK&_nc_oc=AdpTJtv4hGu47SSspHPR3AB4I6bvNlpYUgzkUXukHu1hF36WgG7sAQM1UHy97oydIDE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeMCgrzkxthgTQiAcR_eRocNQXoa8ynX-dNNS7RbdtBQ&oe=6AE1E9C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIT25guW4ZkQ7kNvwG5rgov&_nc_oc=Adq-SqH-X3PeK03zjrZPWS4h_paUmbQRAJ34w2T2Gzhii4OvPaJ-v7urH1qmNYaBeYU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn5qfAb-LEUvLnfXgRuSrWioiaSrZWJ6og7WUwxlpdjA&oe=6AE212AB
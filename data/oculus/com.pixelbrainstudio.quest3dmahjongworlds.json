cdn.com&_nc_ss=7f20f&oh=00_AQJGo100u8cW_Am6AoXqItKLbYkAmOUh0Upr59P0g6zyRw&oe=6A9ECB4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VhgzLeYvDkQ7kNvwFr_vI8&_nc_oc=Adoe7TnukHN4zqUDFRziN8TCFvrttgMkQ3dFg2LxVX1aH1HmM-hvBeKRApnGwGfOcJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1TaM8JUabGDd0w9xrZWZg4vmy6YC-pJ26BXFlzD-3UQ&oe=6A9EAA61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQB0iZhxW-kQ7kNvwGQ1rq8&_nc_oc=Adpiu9J8409IOqOqkF3um0seYfnB1GTvGsG69Xu2c3W0-95v6RQ7FBpjjwz2ce4yUVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI57OKFu1vVSYwA4ttGOkV4-HI4DloeXhzPj52rLIvmCA&oe=6A9EDD5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxRvobHGUDIQ7kNvwHjwmRf&_nc_oc=Ados0miD0IC6Sd7kjDye10BWNkvk6CXTD5KZI6A5cQTOwSJfcuG8KQFtPV8waJ7M-Bk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQVlROMls11sJt8j-ieGJCWKs9BDVIih1Xmxf6SyXMiQ&oe=6A9EBA6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68B39OjXEsEQ7kNvwEz9Oxe&_nc_oc=AdpVEozThwolz3tyaFAew_TbxwweNtf06S3N4LuIVYyQA1-X6Ar290jU0bOr7XMv2t8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaBvFUxgejpp-DBaQdD0mz4TKEgD6EGbCeg2TD4B625Q&oe=6A9EDF32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjZHjoJIdaAQ7kNvwGanV_M&_nc_oc=AdrlTfOSyV1VD0bKm0x676tnQLK2NJQLbgwVunBUk8w6xq2OhEEhIQ50GIErdcGPJOA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3cPA84CKhNalP5PhDf5zcIEojpRTBT5f2jGtGCga4eQ&oe=6A9EAD40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OXfFbdDlIEQ7kNvwFWezLl&_nc_oc=AdpVBnAUNK9JM7Msclrlu-RpKShoLELbqjWVurQP6P5IZAKhF4Sva_oN_m_jNmJQQ6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5rerYz_i98vbIJpeckex3uUnroBrK2NjsG8Eu_u8pfg&oe=6A9ED
.com&_nc_ss=7f20f&oh=00_AQRlV6ClbWXuP2uEIPYEeDfC6kACu58VaFA7quB3dD5imw&oe=6AE9F0CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcrN3ERJEXwQ7kNvwGoacOR&_nc_oc=Adqf25OEi1kWThEI3Xewld0I9c9IDBXhKpdSMl1tUsKLIoD8RyTczr47epw8BkCuStA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0jJG_unIWscvi8PuiTVBw7YMe36mAEr2Xu7wWACySBQ&oe=6AEA0821"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W7Jg-24aVAQ7kNvwFLtqyB&_nc_oc=Adroq2lT1P_IrCqFI3mc45VumgpqSz58EFIrnFdBmIYUI5OMSNT8W_JQVWBZze3yuTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUuOReuscSLN3B5sky78J1hTJAud7ueJz6WtMVsb82ew&oe=6AEA02DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zOtZIPJ0w8Q7kNvwEH-6mo&_nc_oc=AdpylYDiQ2w4igev4ydWowjL0_32vcHEHz3X7FjfzPambp8wAXdUZPqEAWzOrZF_eGM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl8Lm47rhk2ttnMwrAu6TNYloJEi564SPKvAKpswbuog&oe=6AE9DFEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DY5mrcNFXwQ7kNvwEVci5D&_nc_oc=AdqGQDYs71YHt3vDBX4l_uxQ8PTeZ_yo4Z_KwhcSI7BmxJ7MDjHi7SpB0ckV_LDcyJg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoC5TpKJLpo_StiyhhQmAkX4xS2-JPwbuWOv1W4uClKg&oe=6AEA04B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHoGjKRomp4Q7kNvwEfrzdD&_nc_oc=Adon340rhtx4-Rf4TJZ8piHWXHuymF_r_JPv4e5_fwagfa6AaV7q5_g8UXx4_v2s7pk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx3jgjiT4MlLr7TnbOX8daODFTmTI5PIvtQ-OhfwMTzQ&oe=6AEA0B00"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhAhu2ClkU8Q7kNvwEhiCNK&_nc_oc=AdonjO5Hw1NneBibtY75_FDQSL44pxCkY7qxUJoFWz4i80cc-sXiVgs9sfkC7MU_lro&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgiNLlA2VVQ9hwSDXM7Yki3O0bpPGTDicdRnUzBfXfmg&oe=6AE9FBAB
cdn.com&_nc_ss=7f20f&oh=00_Af_BDd_EqOF_5uykN341uAMtP7p0KXCnQvitIEKtILHQ6Q&oe=6A315ECE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alapyXUuwJoQ7kNvwFoVbts&_nc_oc=AdrxP419bGyZSzXtusxgVdgIreMmtLGZ1dH3OvYCj7iujTxLXIm486alcW1kHv4lxJg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SOoWzzb3mAS03dFwkpwieEI1nFbGUj81cX47j57TCjw&oe=6A317621"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzzIQMvuY1sQ7kNvwHaQnZs&_nc_oc=Adq-Re5K4vDlyafSEOHoUKvW68bVzPD2kdj_AgFI_hlXvx0RLbCskIW01e4lSGoh4Q0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7I_q3_LXKRgolWvApg67atsqUvoVCi1N4XZsPnd58sA&oe=6A3170DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KyqzMs2TgoQ7kNvwFq3z1V&_nc_oc=AdqALOOqtyOkTHbVs8l99Ggkrb0dk73lJf8FThfBZZkNoIj5l5nOKrkNuZ40afZnAdo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UmIp9b0OpEtFKrp6uhWEVeB94yWUanx7WHRCaT9D3NA&oe=6A314DEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sz0Daep8MX8Q7kNvwGrUt_8&_nc_oc=AdrYUlpgTB4LJXGHaweoHDGhZbHCqcaWljAQHt2E7QLBED1BBHG0Ovm_aO00K_1Q2H0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FX46mvKDwcseX58JTAY9gZIlAZpAV6eSEmtVNFIj6dw&oe=6A3172B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8awi7OIbn8Q7kNvwHNstm0&_nc_oc=AdryV2czasaNCZ4FUz2VqYo-sNh5bnP4pYOw01cFKBsqjv-sBdsazh1Cr2sjoWFZOUE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--dJhQywbg02XDGFMb1F7MiwdNcvbQqfk9KzEYdS9qbQ&oe=6A317900"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmxxYYWhsasQ7kNvwGBctVh&_nc_oc=AdqJTYnAe0QxT1ZKpY8tiyJtqTgrH-lnkptIDWn1P8hIzKJS2WLjyy8M2Niq5Gh6f3c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AtcOEIjBbKddFChesRrl0S-J5PskgU4y_oAOSkJXLDw&oe=6A316
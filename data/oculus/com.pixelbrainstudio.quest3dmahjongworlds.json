.com&_nc_ss=7f20f&oh=00_AQTUpq_HLUeWqxLiGlBHBqgHpoYnQFJ1ewRbK0Evt2a8PQ&oe=6AF71FCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxCZEtgxYiEQ7kNvwGrQCo3&_nc_oc=AdreAOSXtcLdewo8j8CgUcVIchNWwXhDqQ6yF1so9xQgrm6Lyy3TnHkm4ZGYf9MV9-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIo-D2YH8pB4jnD2tyPZIViVcH7zRn_iT2trhRNOwxsw&oe=6AF73721"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YV_UGuZACYQ7kNvwF1ET1i&_nc_oc=Adp0OyD8H--1ENUpZLkmvWp7n3puMzGJt1VzHDv_DkUWsh8WLcy_bblRv173o7w-gXE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT139FSS9pFNYXvFcyt2P7-O6Iw02hiQ_K23S0FHsKQWw&oe=6AF731DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYoovOQH1yoQ7kNvwHWFZ7l&_nc_oc=Adr_rGf0c0UHbxCbWK0RxkOH-9svxwmM_vzcwom1SWFSyjjeUyoY9UmwlODyj5uVSh8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS4ZpUcskLDfKXvcI17kOZWAc7eLDDgzs97kdah1C0yA&oe=6AF7472B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9u3brRCn0wYQ7kNvwGsrvG4&_nc_oc=AdrNiPWCc3wydJhlSSrSzD8eJ-fQXv6W9ZbgmPUpgS_WzJdHVn2mAFLSF_dcUwArIq8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT65f5UzBYP9xI3FC3lGAqzjaSe3VDqQ1TNbO9uaz5cNA&oe=6AF733B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XohSu3xvRFEQ7kNvwEKqsS1&_nc_oc=AdpvU3zS0m4TXmOT2HeBc3MSlnJuvXWCF2PK2ozl0BRTnXNNgCb11I7youIL21xB0kQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp8diyAGdYRItlmsb4mHRp4G1M2QT-INSzTTYKt21sFg&oe=6AF73A00"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ufwg4FI-xX0Q7kNvwFgbMEC&_nc_oc=AdpQslhDKrfFnMgqc4n8KH7htC3HfliMj9vZv1jagigUDwJSQkLZyy4SWs4WIYw5_cs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6j8ia3gBqubJ-ovuckPw4kiAvjWGi2GW8VQ8PA9Mb1g&oe=6AF72AAB
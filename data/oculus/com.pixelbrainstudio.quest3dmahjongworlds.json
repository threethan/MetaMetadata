.com&_nc_ss=7f20f&oh=00_AQRoU8PNjSuVV4sRe8Rn7sHYcrW8m02JfRNxwnLMoCQ3OA&oe=6AF1D9CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7P4opAnTH44Q7kNvwHsbnlE&_nc_oc=Adp62rxVBvlySAEsnaGWB-XbVdJmgiGcBwz5r1gyeCNg7NAR8qZEzAa8Pvefrse3Xic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfelVB62bBOzCp4MNmWyEKqyIQz7QklPp30nJ-b9d_7Q&oe=6AF1F121"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5_Nw17hyTAQ7kNvwGUagQd&_nc_oc=AdqpFz2ZUwvTlOXvBBuZ5E5ARncyYxwtQp2YQEGHmMqQrE0G_9HMlaytHDovWYhfciM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRC_H6fbi969B4E4tZVR2hk6F9zv1hDRHzjb4PfXuJVw&oe=6AF1EBDD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLRy9fLU8bYQ7kNvwG3y68Z&_nc_oc=AdrwuQHC9MmwTaEviz98rkk91ux0UylAmgV6x4U__kMMTE8Q2ept975FjEA0eob1Cls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkTvOn-bytI8u8Ld9R8d0zq6JLD934nDP8F7gLPvkAWg&oe=6AF2012B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fh6OSqNicEQ7kNvwFkN_VQ&_nc_oc=AdovXf-2qbghWXVYHyA4wZKaILIZag75AQK0pVEvBUYKRIWivxCZF5qTWSN5VzX3C7k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3mZaNmqLSNwzRlcH_S3GZezC-tUGhlLsdpuSpoAISoA&oe=6AF1EDB2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF96qLusXecQ7kNvwHqwrRJ&_nc_oc=AdrUnP7DL6yJn5tK_yfCjRkkVbKNQqJnQ_3eO2-so7WJ3zUZHg5D1IluMSF2H394j6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD-PMxZkrIQClaGObPIf-lqEFKkgXcal1muslmiOO_MQ&oe=6AF1F400"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVmkS0H8fXEQ7kNvwH3eRVw&_nc_oc=AdoftHDTTvapM0zRz1gkurJy8mu514xNos71sQoShsjsDXhr5QG9t-oi9-Nr_r_gjsc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNGnuL4az1bBXaryCxsuuzFXZaqeCSPHViNG9YcUCKuA&oe=6AF1E4AB
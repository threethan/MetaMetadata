uluscdn.com&_nc_ss=7f20f&oh=00_Af9Z-PppZx3A08K9P8Mp0C-EOMKRRZPRzZtTQOsHrxBXDw&oe=6A36A4CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TL7m0WmakrcQ7kNvwEI4fDn&_nc_oc=Ado9K6ooc6N1x6ZSB8UScjY2tRsR4V07JNosSRbrSz4vWxyI7dnVYjh4a2iwyacRbFQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ok5m7RadYQ3WJuX_Ki291wb3EtwEC4tVTiV21Ciu3Zw&oe=6A36BC21"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGJPb-d1cg8Q7kNvwGVbZgJ&_nc_oc=AdolwB7WAzawKQYOxd_FvKlv4zzRTwNLpzyFeP1I3-rlFmnezoT0g7s4g1gKiZEqN3M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a7YVcapM1etxGqE1TmVuUYkpVD6WI-WMrrFF17Z6O8g&oe=6A36B6DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szKI02qht2oQ7kNvwHQkkOg&_nc_oc=AdrvdbhA0PIESnYXdyf48DUAJYMIBT-XCwutawXE_LZRljJBYZHu7tnrJ170eOZq_aU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o1HyT4_00HVCCH1DXuBaaXlj43y9rsyZMz9mYoLfxnQ&oe=6A3693EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blOXLYmXYD8Q7kNvwEZkSvc&_nc_oc=Adr5oeiri2kKJPFr8aZ5yXFcgB085gpufwFqvOzSbi3QNwL7hK0WmpqyaWx9D6BTmBY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sgdmhz7SLoaneHjgz2tpdZ17NLwrv7QXawokObupiwA&oe=6A36B8B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elXw8vR0FfsQ7kNvwEMymcO&_nc_oc=Adq_BJWSAo_hAU337IG5zG7nhpkFimSKPLkjKVMvgAILHi4G1ksq7d2tbXiLsA0yOcs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LpiEZjZD8R9nwAHnXVPZlnLgzSv5GMBNHI9NOD7yPvw&oe=6A36BF00"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2J7FVQqRCAQ7kNvwHauyLV&_nc_oc=Ado9jP902maIOCjVuH4cH3sNHDuFS1z8cpu2IAesSFHA9MHpfB6NR-w9kCdQffWv-fc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FgFILCO91Sq-dEAIbFYMY5yyVKlqlfe_nBLdn3RdOjA&oe
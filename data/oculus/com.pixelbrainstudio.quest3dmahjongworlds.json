cdn.com&_nc_ss=7f20f&oh=00_AQK4bE5HXgdAotVYMHj1oylxhjFJ6V_d8feUwi8FdZcfSQ&oe=6AA6B44E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-ZnoakFuVIQ7kNvwHoC0-n&_nc_oc=AdoWjBU8_c1knUBQPwf9xJUk0f36jmeGvZIe_CQZWlOBLDHeH1eGu1AB_EYbcyx98aI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_bUNImMEiq-_iNZEqHqqzg13Xk5fY9Oe09r01Z4wP2A&oe=6AA69361"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GxHUunSv9sQ7kNvwEtQOMd&_nc_oc=Adpr4R6EtlkNfvqRHfU18548Qoy6G5nbFjfE94iKnTg29KtYNwdQZviKpx7Y8TVuxv4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL99P-wtaX4OIQyFbQJLHzeg-60qxjQCH7CduLzJ1lohQ&oe=6AA6C65D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UF-UlOI415IQ7kNvwHdZQd0&_nc_oc=AdqRaD_1haUgHZFIhwjGyaqSnth4_xvoyMOig3sIvTHo7SJteC4okuxSE0jHpuTTlGM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwT3PIJKU1j65NHoeHk3CijaYark48MfAldSjTQE0yew&oe=6AA6A36B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u22cmHT1yl0Q7kNvwHtR77-&_nc_oc=AdphA-k8h9SGzbv_n4UuCMDpjOlRsnStBw3XxDoS3tR775ca3TW_lR2Xd-P2P41MFOo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZDQXgZQmb8QeLSlZGjxk1Ok3bcvjzXn4-rtWeiUlXIQ&oe=6AA6C832"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4K_uFRdkZEQ7kNvwGRG5s0&_nc_oc=Adq6scLsn9GlWEshiB9srUehRn25KknnNqO9vcgKVSmzBo3TsGixt-YUiH3h4LSPICI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTlICuiGLgO1SQXHk-vVp2p9ydErAQeEQ38QKFZKt6fw&oe=6AA69640"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiWaXVFlCgEQ7kNvwGxjTGz&_nc_oc=Adrl64jYHc-OrpFIdndSQqFgnFPg0zcDXYxhZOEgBHuYmNihWzfdL2AZOu74CoiIj5c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6DGTGNvtmgScwM9fLfJx6CgsrSh8FoswsHgnssdeKZw&oe=6AA6B
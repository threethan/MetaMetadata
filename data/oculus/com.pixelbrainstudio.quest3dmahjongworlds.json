cdn.com&_nc_ss=7f20f&oh=00_AQFnhUpJHB86yxOef4SGXB43IADj2b08MRKjjVnO9OpTfg&oe=6A75ECCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMf0xVqIYsUQ7kNvwH11tvB&_nc_oc=AdqDVcGPgkVvWZuHVusGh7XKlvp5E8O0rMCyL_ZAyKT3xbWxBgCDKhCkqXmGigiBF-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSlihmxqgb5BOgpEe5efQy5vPzGJWZ1fibTvjlyOVmMQ&oe=6A75CBE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EOHxlyW3EEQ7kNvwHJ1LOl&_nc_oc=AdoGiN2Tm5FL7_9g-EQDGAHTKPkRe4qtEEZN1ZN_hzK3KN3Bwnat55mV50Bv08pJvXg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMI3nJlmmvN7uEr1G6wN-b-hQhG0KVCrTap8o91J4nbA&oe=6A75C69D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0Zi2tbpfukQ7kNvwEVYYs4&_nc_oc=Adp58Kt-0fqnDXiHWB60dQYn2l0Oj8wg-Z7685Ja2g8ARiiS-UiRkFGpb5SoZ7ivHO4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoK3xt-24dSL2F6M9cVJBmzbO0RSZwMlaJXG6TQPAVkQ&oe=6A75DBEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QN12MiZW-oQ7kNvwEADkky&_nc_oc=AdoX3Y61wthen8Orz_WBvNFcnA_gNW0vA81pZLdzs8ciaQ4s-3zx7_fy-GJCTWiMVsI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi2nhifkXhNtpzl6yjerMzdQumz0VSf5a8BntLgRS5yw&oe=6A75C872"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBFoJR7lPakQ7kNvwGFaS8p&_nc_oc=AdpTPWfrqE2Iwj2TTTYk6XhfmvdDTSNid-cGm4nYTTCm7qSOiHJNRcZVTp6clQTMeL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGz-2wxDiOzHAjtUIi1dFvalzRh6jdMCLSI0zRa71YYQ&oe=6A75CEC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vncQXjxavNAQ7kNvwHtIXvP&_nc_oc=AdrlQI0rSEjOW4_lsM992Vz7fr5_NgO6Z_Y0clgKJbcJ_riAcv59Yk-mrYweckaDd3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLENKX7DEkrrYZsLoNkUES4gMViCCPpjAYa8NR4pn1tA&oe=6A75F
.com&_nc_ss=7f20f&oh=00_AQPifq6jw2RDTdbxwLqELWEsy12vhNlAKBhqtG3pP6K-uQ&oe=6AC506CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=df7LO03mBTYQ7kNvwE_Ob8B&_nc_oc=Ado7KSU0tClQrhwHlcd9BhoU5wrhmBrOd6U7E9mp-1-_4RgmZveWWc4J_fdnsqDebpI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3LYbqsWk42Lb5CXDTzbQZAoEKvl5gbPTW52HBbKZJsA&oe=6AC51E21"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eqKkLDGFbsQ7kNvwEOR41m&_nc_oc=AdrEV8qYBqttAjAqh_76T3pFFzOBJm1Neq-0L84GMKA3yrMTTyntB9epsa1WU6HJclk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLSnAFx-KEmg8ZVD5LRRVZCjqGYW3NgQ2fn7RBpCMLrQ&oe=6AC518DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wxeY_mupOAQ7kNvwGs_MML&_nc_oc=AdoAKyRaLF518CsjMtIuvB-mseddiVGlYhW1ZM0wOA-tHyokhh6ej7yWvFXg0pvoPd8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiOcBib9zbIpy4U-lvNzkn_mF2zFx_VpgH66tSUBwj6A&oe=6AC4F5EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vn7h_LvlXSkQ7kNvwEv6d6d&_nc_oc=AdpzgcJJKjFzQIlySAGBuNbhNOGHSPyuM3-0ttkgaW-R8dSwKgwB35AYkXVtaXfRJc4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfY6oIaVvDFZH14TPJICS_Elpr91qicxvX66Ip1I7u9g&oe=6AC51AB2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_ee_LVy4jEQ7kNvwHMx0gi&_nc_oc=AdokgZfLUVy5tb8gk161G5dz5tW4Jo3bnbYXa8MRarOByfknp56Bkh-nbBJC6o0EidM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWD9HV8OWkk-mVBn7CLZ4Ar7s1hBf91wNwaaByZGCLYA&oe=6AC52100"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrUQA4T5L88Q7kNvwENDQvH&_nc_oc=Adrernzhg6HhlQMii9y-BTDEjezowm3Oo7KhUt6amZ6PLHmPgUCIvIPDpCBMdPGM48I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXAIjkoPh0K4FHfHbDY1syqD5l3UBd6CaQXZ0fO28qJQ&oe=6AC511AB
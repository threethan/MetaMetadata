.com&_nc_ss=7f20f&oh=00_AQMHHgo1xQeotcda4kyRMn6ogf3mRDXgGXJZqZXM8jklfQ&oe=6AC6584E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_s3b4iSmtgQ7kNvwEIh-tm&_nc_oc=AdqLDMlKaObNpHOfsDqctv5cD18s1IWwgAF_4q-wRdqvG8c8EQnxuB1KhZdcjtXOvyk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBX_0ZvA9eIcA0DYgnm5Vu5JZpkaWNe3h2uDlO5qzMmw&oe=6AC66FA1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eqKkLDGFbsQ7kNvwHH7R_V&_nc_oc=Ado72aiPNM4pZaXnf1IXVWFzaggVFjm__shqlaM3eu_ZqdXSxRSE4-74G8oWCIuWyDk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5oZpaiB8YvkSE-Ti09xqb9vepiKGote9nBHIc79U5bA&oe=6AC66A5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMKOa_lATesQ7kNvwGStHm7&_nc_oc=AdqhN9kDKah9Kvz66crYWpJBuoxAkhgx7-prThRAuy8gAdeFZCGQ1OuU_wnPc1JQhFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcGZuB8H6iMwqdLyWIXUB27uUDxyfzaQbKnyVzAZvZUw&oe=6AC6476B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vn7h_LvlXSkQ7kNvwEv-tNg&_nc_oc=Ado9_xNZgP5kJgfDTqa4GrhQs6Tn-Bgu-LDr0cgOTnZ8TVeDhhsKNXlexPckbZiAvjU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn60pScEx13OBmMu3oZ8ZXCu6PdzhCUxgFlXhogcVyzg&oe=6AC66C32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7MqoKE8JywQ7kNvwFvnw75&_nc_oc=Adp3YwzdFQjS0KeWr4-F7JY3ElR5c9COuGDp2Hp6pXq1kGwJBnbVBZzvx8H0A2h2G9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfKCJAzNn4etjlwR98g2AqNniIXDfIKiXWaHEJzlEHrA&oe=6AC67280"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrUQA4T5L88Q7kNvwH5dLRr&_nc_oc=AdposPmYhDVz8zW7kRb7spbILA2S3GuufYnUL3Lc_lQ81lG2YNKgAM0V_KXX_mFD5Xc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIQ85Mrn_kz-y-1xqqvK4YQsrrKnc9NyAmS8t0F-2t6A&oe=6AC6632B
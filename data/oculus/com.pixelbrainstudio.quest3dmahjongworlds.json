cdn.com&_nc_ss=7f20f&oh=00_Af7cVu-_rnytNVvibLf9klLmoTlMb_ZhuoxexMJmZNA3Yg&oe=6A15AF4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6t1Bf-E8jMQ7kNvwEj4jVr&_nc_oc=AdoZ0Ch3kvYc3hDPUHsjkdJj_wvJcHgoZ4w6XXKquSOwyGISN8RtmBfqPi0B8L1PXJY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PpVXEgxUjVz_CweujR1KXCUkbdnp6qb41IPa_pySDOQ&oe=6A15C6A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zGH3xQYXlQQ7kNvwEmToKO&_nc_oc=AdqaSeEBJr9xSlVMx_-frbYsb7JiHclJTLevBj7YtWf-dMSJFVOileFc4TkdXYAtJ10&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FOvtdWBZWqNf-h5e6u6Egd2oxFjBjCtPV4xbQdzWyjQ&oe=6A15C15D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdglkuMsF-MQ7kNvwGuaRAC&_nc_oc=Adr7ENqRFr3ze-AukeGHLwiATRbjvi75awi9PS9CM_k8NOTsb7KdLVXVE0BzABRztDQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qF9Qq_T4jTowa3-qOf7Kp5kO8Kw6d42bIeDijWPiU6w&oe=6A159E6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMUX2xLtHs0Q7kNvwF5jPyT&_nc_oc=AdoPtf6_aNdVcO_GTy-2vDuP6OH4trv43xVmgng05DNPPEluZMyGl1E69Be1VMEjEd8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54s5DlDGi9FQoHFoGzQ6aXjceKt3aoiCNe9GkKgQEqTg&oe=6A15C332"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RM-eTo_jg8MQ7kNvwE6vKV8&_nc_oc=AdrWg1UVePEYY_IFxWhHwG53X5-wI41CNwO9ima8xffSpFkhdOqsc6kOxGFDreYmQH0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n_DtwDx9_godCF3BKd99pZ4IhwEuDrLCVNYv7aa4D2w&oe=6A159140"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWINTSy7cCsQ7kNvwGwfdHK&_nc_oc=AdpxQ3590aucuOAjsC-jzN16Nx4hV2TVgF-baRRoWSMiidcwMyn1m289gqeperTogKs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yhV_sLivgpoHZRyXgaoiQptAht6_IH2RaNpKJS8bMvg&oe=6A15B
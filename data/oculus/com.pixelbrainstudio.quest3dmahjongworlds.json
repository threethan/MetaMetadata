cdn.com&_nc_ss=7f20f&oh=00_Af5YyPy5HhYwfJUyTaigkeJZhNRk1dPg2kzCcEbFvs6ndQ&oe=69FB514E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxVCucRL8MEQ7kNvwHEmE-H&_nc_oc=AdrR9ljH8O08gd7Vc7s6p13LdNqGPFmTMkXlx3nWrGZoqH6NiH-2_8j3kzmbisb38XU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uH2oo1j2Yno3vuBn_A_wrOyquLOyOycvU71R7zenTHQ&oe=69FB3061"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1eGSrFzhbEQ7kNvwEX5KoX&_nc_oc=AdqJqhad26-0CCEAz2KvNYDNvLbh9ne-0MHfDGHsBrtyZqWcRlSREhk6FHnM2EonRZc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af722-I3hG1rsGa7-uqB5aydjHbVBA3AnEnX7ijaRL4zkw&oe=69FB2B1D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgt7ogrbrBEQ7kNvwGT4diF&_nc_oc=Adrl-YKfExfbpU82ZX93R4zMwMZKCX2fKNz9a6e73A5WWeQbKKoRHZ1G_rfRNs3udOI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C9YPwjh3ag3IDuGsn8ixSLO-2l9HrAktssPGh_RjYbw&oe=69FB406B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5tHt4EuiKoQ7kNvwH7AMW3&_nc_oc=AdoM9rfzwad_R45wnUbvEkt-EdKDugUxlcvRe57-hplkIBS1yLDPAZ1US0pjj1s0i4E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FNSKe7QuCp43gYo7YEJCKHA7ieYGfkaGEcFUXPjRJow&oe=69FB2CF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zVLwMWNL8MQ7kNvwGMG8tr&_nc_oc=AdpAIo6BdR-_6kxvV5JqYBv8PlSIH-Injd9sCba2SJgXPZ6akHRM8Lc6I6MZvLAWrvU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Kn1WATaTaqXzO3tDdt3M26iZqngsoOlaCc_ZGabuTuQ&oe=69FB3340"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiWlbbtZRAsQ7kNvwHyZzCb&_nc_oc=AdrelcF-hqbiy_PWatMdgfOaYrvJMixoocCTM5PZKJ4weSFk8icm8B0vX29izdAIGj0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JL4gWmF5mujO9bmex-2C9S_RIIU9nJSr-ADYslQlWGw&oe=69FB5
cdn.com&_nc_ss=7f20f&oh=00_Af4Izp0AtksLCKxdemT9ADqrcnl-I_DsufmeL71ey1kUZw&oe=6A145DCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6t1Bf-E8jMQ7kNvwHmy6mJ&_nc_oc=Adr2DK0LPK8MzDgcUrW1e4yLeYAdKG-SH3H_QZ1OgXcxOul3zzJN5tOOy81XM5jv4kQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55Jqq10G_3Zhi8V3tOc6NFUZf3o9Si0zNeT_d46WMlug&oe=6A147521"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zGH3xQYXlQQ7kNvwF9KnXh&_nc_oc=AdrZ9c2BjgFIdwIaaKnkZVJGvoQl7H936DVtkl4lMOKRkimM5WhKZYcoIh2PDwDzQ7Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DXBKWF6lQyNooW-tJJws1YyoFysHFAaeu7wodH611fg&oe=6A146FDD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdglkuMsF-MQ7kNvwETFlXu&_nc_oc=AdqASAy8cT0lranYtl57KtBTK-IsKXC7jeO38hH7Q1as_MUSchHpahcxqVd2L2LfY2g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qMBA4eD1KvaSsXeRqbupIje90MhPjlsITXWPQAT7HGg&oe=6A144CEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMUX2xLtHs0Q7kNvwHv4Wen&_nc_oc=AdpnLVPBDF64mpgialmzSMdZmziDiTeqfLy-bV0URcD1905qw10gULYo7F2CL_22svE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72nQstQ2bj6xUPJqT3HANDxjOA1FasBZ7HSwBnJ3fqxg&oe=6A1471B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RM-eTo_jg8MQ7kNvwFlLW8S&_nc_oc=AdrEvd9d_DG7mNnukCf0lal4HlSMgVdUTJ46mpfLoqk6Kzrk_3uA1zpokluAOrVbeFM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AyUiHXTFOoroXV_3FY1pxoolyQXj7U_VV5d6D-jWvDw&oe=6A147800"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDe-dfEIMzwQ7kNvwFXKmwT&_nc_oc=AdqDtbXTwcOxF3T1vz6Vs0OINSotyF0gaXc0qndiam2h5x7maRCo0oKELwy7EA-Yxk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q_rucchTiTw91PSf8mxkK1q4JJkkFP2dkkru1UiHwWg&oe=6A146
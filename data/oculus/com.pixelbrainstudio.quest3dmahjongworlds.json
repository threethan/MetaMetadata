cdn.com&_nc_ss=7f20f&oh=00_AQCQrPERLGEuHh8Wsijjeibcg-gHEpsoE_0Ljr1K5jogQg&oe=6A6377CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rIxoJSRfjQQ7kNvwFTfaur&_nc_oc=Adp_1QoLb1ZQ-TMMQyehLk0HjfGcUHZCfjeJCBeHHuZNeD0Zfq8jENtm1CmNcE5vWZw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0sJaDuc949_qAgiDprhUzy0LM-t9hUfSsGKPWRLdLPw&oe=6A6356E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3ugsnQ2YAwQ7kNvwH_1rkO&_nc_oc=Ado6iQ0T3PRLamE1KBvnNib_6LwvmjtBJluUNa_uQ_QNyc6RvidGn1Hj6XouxYilmgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSCSUcMvELC4lgsbV6WP1JztSPnlkA5KWDZc9JJ6IFMg&oe=6A63519D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKORtVSeyTMQ7kNvwE1Kfzp&_nc_oc=AdooN7gHV0W7rGDXh7BQoVsLkefne54HY6pcfjLfz6-4mQ5v2RTEKJtxO92UIS1GOoQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIZGw4-USF4DebvIAEl7zL9XIoOPLJztijeh0Ef5OfIQ&oe=6A6366EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yR7XjaCN4wIQ7kNvwEOBUG_&_nc_oc=AdrrR5OHfL4uVrugBOoB9G52LHEc1FsXF4o2aQ04xXAXWGfCxxx9Bn3lmN4IYELgwm4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3ApmZMZlSSLPMTyVv-yQL_PsrG6BtSYY_3sPXtKjOpQ&oe=6A635372"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqUfCNkNqIYQ7kNvwGPjTAL&_nc_oc=AdpuDJTDkCn3iHdvGXfXfIKZahcnYDC4O07r8Y36WAd9Kk_Jjm_Mt-rs26vo3NwV5zw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmNda4fFcvk5KGUk3QS9VtqpLtQIjNCg-Z2TWFqxDM7w&oe=6A6359C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6ig-tMcKPoQ7kNvwFAy-Fl&_nc_oc=AdrtzmTAQLJlcR8JHuQel0rau4uHDKiXY_ua_1fW0PZrcRcFRVwxGMJV4sc8XlvJC_E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAE6bsX1WGe2dKfEu5mP6pz3Uko8ESCuMAjC1V8a-QPqw&oe=6A638
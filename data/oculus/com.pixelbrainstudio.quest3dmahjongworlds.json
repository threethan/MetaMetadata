cdn.com&_nc_ss=7f20f&oh=00_Af8gcFm8s06Ro6TqmnZWivEgXRCsd7a94g46p5z8H0gIlw&oe=6A2D6A4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61mj65rHbFUQ7kNvwHVnwIW&_nc_oc=AdrdkcdI0lhwbcAhBsJkHCJoyTkWYl_m5hmni0vN9LwJE4gRaSwzoCTwzG7QSi3SVmU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XjFj07gh80Xm4UMRLh_jg5qZz49dQrdAzjziuXYCZ8A&oe=6A2D4961"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zPF0TmQRMoQ7kNvwFS4vvj&_nc_oc=AdquS4D-CQCGMUGVn8EPRbIcHrcCnauAR_W0pE6utwW044sFo0S3sEotkxgAcJZ-nD8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9k5etQzxxfQb4pREzk7xTnFpKbKfW3_0V-RHk89jvv-A&oe=6A2D7C5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuI1yWGAeYgQ7kNvwHFYMpu&_nc_oc=AdqTe3Gn_cTB4Ca57gtt9L_bqZDvy_IbWwEtBwGfMlhnqRPwQA-_ghjuaoL6xZfSxr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MvwoYtCG6SK7V40UNCKB1W80BGU3-xS6prWHR0x3jNw&oe=6A2D596B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aJLqaGokTIQ7kNvwF7g1nD&_nc_oc=AdqydUr4mpDwaM9GcUiErNgVlMWWEFuar-UplCPpvBJ2x3PgtSKFSD7I8NmrVBzZNFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__DA8OSYWAPDN9g3gRp8vyOi7Mv5FGCve3L1GSY3gdvg&oe=6A2D7E32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXPlC2e8368Q7kNvwHyAKLT&_nc_oc=AdoXWKaJZVGjBxTLBG5oT59wpY2KMTNRzE71d1crgbbLo4WL9mwvNb6ua6MXNAr_pro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3-ZWeiaq5Z22Q-a9jjX_d9gcB4NONjceRmFvgZ2ubbQ&oe=6A2D4C40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-QPSjuKz4MQ7kNvwHjor4m&_nc_oc=AdreX3zZZlqosrhAQ75wAKCJRKHwmmyqf2UFdcTyed_uPoL30chPw5157aLIKCv9UTc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cLWwhevv62NIlyEHSdvLBm6HFn9a4N5on9tULvm3Vqg&oe=6A2D7
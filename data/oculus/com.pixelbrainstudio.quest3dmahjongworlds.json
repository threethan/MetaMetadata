cdn.com&_nc_ss=7a30f&oh=00_Af2SeDYFCE2CMQ4wpKDBWwEkZKM4DZ9djC7g-NheYSs-Bw&oe=69DE504E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsm7yYF-2xwQ7kNvwH9RW8W&_nc_oc=Adp8n0eTIZx0LkctLBxXTIWvVRszFXkI8kHYh6Py6_atYYjIatx1BnlFV_H7wzeVi5s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3woSflQNE4I7ffMEOuu_egRoG9mvNZB6XTj7dPCP9gUg&oe=69DE2F61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qL_-_ZMdvYUQ7kNvwFwv48J&_nc_oc=Adpn3QcM-zX_V3Frtop8auy1r88iVngoKR3T_t-P7hPcfT5b4ETbvF264ez4Dt84BWU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SeabKSoHUfUs8sSMsFW6QiEQGMD4pUCZGQ-wdQD_V2g&oe=69DE2A1D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BdQ5xUk4YUQ7kNvwGHwkB5&_nc_oc=Ado8Eis0ciBTpRXR-ptU5pvMu2SDeOTLwXYxn7bgNuVHuawNDQ-6MhSKr_8RZsbOKGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rbk6pbTIm3MpZyR_uwyMoiUN9xLeWvBF4U-1mlyWx7Q&oe=69DE3F6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHJOP8Ol-qQQ7kNvwG3Yfp3&_nc_oc=Adqm5CI0HCPpFLw2fm3H25Mpul3EYhV-b22UI3o7QvZKT-IKJO91YN7fynd5gzYtt9c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29uqZ54ftYXLL3bGD4hVBTzlcr2TsdYp1sUaGO4o98Uw&oe=69DE2BF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXQ3Uu6D3SIQ7kNvwEZog5h&_nc_oc=AdpJypqnK_j3v6owFbCcuYCUnvUxvHgS7xgvwuXtC3hjc4t8YDr0R97e95VujXt7J2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39pACu3bXMdDc9sz4ZE_umFT3kEQzHOLuSnpY2sxB4Og&oe=69DE3240"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot_EBpmhUYkQ7kNvwEJ8i7U&_nc_oc=AdrsfjZ9W5-HxE7CwpLKLlFxl-Ut9hxJ_HEoOIe8DgKxNHcLMCQCmy-tLP31D5av5bw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Rc0795DJHv8BaLn56f9duCP0AVVwTKkh4VYoPt6lEZw&oe=69DE2
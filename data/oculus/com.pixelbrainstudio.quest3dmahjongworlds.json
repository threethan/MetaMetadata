.com&_nc_ss=7f20f&oh=00_AQQPIPLSzFGY6YqOwiI6JfzZz1QfgRU82v9K4AX1HCbbyw&oe=6AF5CE4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxCZEtgxYiEQ7kNvwH9q8WF&_nc_oc=Adp2dEjB5EJuX6xHrAgcAUU9VbAh7MhLo-MpugSN3fklgWbLjrvna7bK46NmB3a5xxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSpDfNNwZQywed3LdNJ0GIPV-HRA7W4Z0SAmFI6g8TgA&oe=6AF5E5A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YV_UGuZACYQ7kNvwHC-gAm&_nc_oc=Adpd-Uv2Mlzl0Nh0GlQqfvMb5znVebEtRso-2muk0bHxHK2V70EMRfdT7_ktYlf7vF0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYlHJbLdIpFb6RnJvlCW9Oswh2sChqG_Cmy-_KqhNEYg&oe=6AF5E05D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYoovOQH1yoQ7kNvwHXKP84&_nc_oc=AdrDHGAefrAoTMtnUairMuTDZ0mwXg14QlJvp4b1doL6tucijzI4F-p12SA-enlshJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJk6HqRM1ZS73Qeq5mVo6g5MYYEESoTCXWnZGcAPZV_w&oe=6AF5F5AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9u3brRCn0wYQ7kNvwF0qloo&_nc_oc=AdpENiW28GVuY1EdVGFfAJzn91c92uXBTn3Y15e_meF_BFSFhK2aeW4CjZm_A8N2qxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW-8zFcwN9PZc_dz2AqXLy56uhYiZUa79Z4YBCdr-AFw&oe=6AF5E232"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XohSu3xvRFEQ7kNvwGhkWaQ&_nc_oc=AdoR0ipK2L7ry9Yp6Vu4nuK411Gb3GI4alhSlABgBlkHM8oqa1CJ_vfWLEyj_S3a8pA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5k4S-JaN4nz-UW6NUVJ9gbuFffpx8YMZ5C6Y9bSur2g&oe=6AF5E880"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58b0GRQfmlgQ7kNvwGV-e87&_nc_oc=AdoBuaYecLffGkBBRcROCla2jhUmYWpSf2okerKRhl_gATApBrFb3AzA0UtKokuQNno&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQL1utW6TBxniFEHaI0vAnX9YSVx4MfR11LL46RoYniNA&oe=6AF5D92B
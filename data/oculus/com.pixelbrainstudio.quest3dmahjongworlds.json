uluscdn.com&_nc_ss=7f20f&oh=00_Af-M_ifFqsgbjmmOhfPNUlVC__-vg-rpFCMT3NkspGq_9w&oe=6A4676CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9lmg8YhveQQ7kNvwGJhyef&_nc_oc=AdqppWeN7uexShvA-uaVSsKflRNbij4zrqJQKK5y-EGkyHMN9C8m9Foj45mGmeIF64s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88H-O9QsA1mQJKlQktVtsz9C0l4iAptD8i5W4udQbmQQ&oe=6A468E21"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIuY2p-ligkQ7kNvwGr-81O&_nc_oc=Adp2B8D37rztq7ww6ueb1tW1YkBumh9uIadI9bQuWn8wqfU5fQQGdnF50JNTSpBYC2E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_WTNSS9VT2wPSpm_4NrtudD-3VJRHlaJLwrGTIO9JUQ&oe=6A4688DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4vQik5rbEYQ7kNvwEt1BcT&_nc_oc=AdrCgRs8rihWczTWfn1tXNO3iVeeAxS61LjkMGO1tO2SfBL0JIgVSfbpzHEVURIj4YY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rrg43P6heBS838xmUER8CF5bxjdiLatFresdxMmbzbQ&oe=6A4665EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3VSp9JWf_oQ7kNvwFu8_Sq&_nc_oc=AdqAmSOBdIw6UUqm62dKLz1e3yRsUu8FDTf2ruoO4n8gtdhhceaLio7KTtLezpGacJA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AhqEpdhDOagw0o6vQzq6TFtXi2XvGuPz3sRjmOfT84g&oe=6A468AB2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccGWMN22whoQ7kNvwFG0lOB&_nc_oc=AdqtsMKuTuJJQyQMI2S-tDilmu_zs9zqcdPxV6w71fDq645095LG3-o7icmzLtaFJi0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZUq9SbKNU7wjPKOQBbTWvzgck-SYCKdMmfuc9wtPqiw&oe=6A469100"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRbZgKqWX1gQ7kNvwHNYtNx&_nc_oc=AdomW0a44ASSukWVRRma9QRM5-Sggb9LuFUZDmjeW9G9-Y1OGLduEOuloOD6jtaNz5Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k3w_ILI-LFKL9Zb2tlQhO6Ua_f8c5quSM6YHHyhzsjw&oe
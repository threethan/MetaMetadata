cdn.com&_nc_ss=7a30f&oh=00_AfzcXC5Ubbdnhjs2ad7UzYH-F6IbZYTDOtvo5PwN6djIXA&oe=69CBDB4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhH-V5xdJwYQ7kNvwE9W83N&_nc_oc=AdoVE0XnVSQto2wDLDxdNGUnQ3D7oMbxlWqfluHyQwWhmTbS1bROkZyxZGQq8EeBt1Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZ09mOSCkuS6Jk4szZDLPdFxeMkLAfE3e-fLeDxu8q4w&oe=69CBBA61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_-FEGhf0YMQ7kNvwEDdxio&_nc_oc=AdpipBTAqWRUJI3jvXfzbj6yGDcwSeSUaGQTUe7zl4ypQt22XEASyvyrdJPSq1KTW4E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNbGlXbCPpM_94E2Ph7DY6hcM5f-JF4bZRI5b2m6cfkA&oe=69CBB51D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7vAFeMO6J8Q7kNvwHgQ0RV&_nc_oc=AdpOANHY8F53nlWpXYaM6Mi0b0oo87WpFLBFmTxS9dwCIlWwsGhvh7k0c6ngqu_OPFQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPgfm75JdRUpQrW-dSTYhDS5mYW4OK-qynvcnSZ6wROQ&oe=69CBCA6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziKBqHhKtHoQ7kNvwHKI-6y&_nc_oc=AdoRNleIc39cjDMqTP90Zcl1D6-kTbgLfiVsX6MzcLvclR3TF66GC1lNShwpHR4TIkg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPwGxKOUTzA-5wQhKdibWjr4sEZ2ol1rYAimdb9ZsbnQ&oe=69CBB6F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6A3_zFpi6WQQ7kNvwF3hBHi&_nc_oc=Ado3HnGzyTcfsyHL4ioct0-_IoEslzTphVDnPKio2x8xzX5DVPnwAM526Jy4v2j1DzI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeHG9X-vTt6pLME0N_AL70OcXQ0WSd1ln7HVegs413sw&oe=69CBBD40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9g0TzA5PwD0Q7kNvwFu1pZx&_nc_oc=AdprE1LDTdMRT_8vVwbzjx5Lt2iA2aE3X04oueqqj4LMFLoQoP5s6PnibriZtvIBx-o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJgtNpgysj1aijfRrEe11APl3yv6OdtiPEeqM8vNLXxQ&oe=69CBA
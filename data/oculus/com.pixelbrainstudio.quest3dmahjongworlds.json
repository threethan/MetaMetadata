cdn.com&_nc_ss=7f20f&oh=00_Af779_Cc4HJtEQw-euw2Qgqp7poG1jF78HQLsEHDBSW31A&oe=6A18524E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7bEvpCEfBIQ7kNvwF2w70S&_nc_oc=Adp6e9aYK5UwC3jLgzKXSlwyE9o7LhqiH60O-NvCV40loaFDRI69ZEYWMux5CyFKjv4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vz9UjIoEuvndCOc7ICgczctQtZ3CRIWwBEMthUx6LGw&oe=6A183161"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEgfCyvxgEkQ7kNvwG9_8lP&_nc_oc=AdpdegZi8B0jySFwD73Uo7loPWAxumHAzMQNWsZ2O1j5iC3tiozjmD5-87FVwUOGV2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69XDSsEJ00e_i--uzxbnY0GJXyuAq5njgtrmrOHX1mVA&oe=6A18645D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXp9EOPHxH0Q7kNvwFWZpyz&_nc_oc=AdrP00P_iDhycibRmeGPIipNzWscDFScQR3dGALBHe5I67ys0JBZjx3knICY7he_xEU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wouTixJYjvOFFWAFn0EVqUPoIsJpmax-kPBHlo54PWQ&oe=6A18416B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJTFVLjt0VsQ7kNvwEE7-XM&_nc_oc=AdqKVGfiSLdVkkD-K8UJjAH4WWCQLG8Q9_K-2TS57CfHDzIs3JgoMnKbBfRymVKoyPg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ek1gToRKebA22Mfi4Dvjln-VgLgu5KQ0bqQFCVYrKDQ&oe=6A186632"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUqfwHovJTsQ7kNvwFejA5z&_nc_oc=AdrlJgRVY3slfmv-2xVMPet103QvaaQSP-Md9f2gYTy2XY8NPoyucdoijDynwyjsxCY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oN5R9lYhpsfr06um1iPb4nWmX3UNW72oetJFpNWlRyA&oe=6A183440"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWINTSy7cCsQ7kNvwF0dPWA&_nc_oc=AdqX8PM8BM97Wmekt78CSW86a9FdR3eiUr7s5VaX0UluTu4Zkuv-y1rjTuIRcfY14i4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UCWKdYuR7dYKWsjK6cG0B2FMkX39STtGqqHlJcskgmQ&oe=6A185
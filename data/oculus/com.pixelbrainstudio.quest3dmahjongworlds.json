cdn.com&_nc_ss=7f20f&oh=00_Af6n0xSTTaNO-mXnMv_88T1WGblIj1K1R4kNCW0L0G-JoQ&oe=6A0DC64E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJHbJ6pDJ9IQ7kNvwGzJq64&_nc_oc=AdoiY7uBxGuXqWtio_0BjwLkoNtags-5iPDT9wfhvfkgxvuCAAoIZrLCHKvkPJk9YkU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72tYlpWj38M8RMZWFmgBO07BWQIF5Kbp4Pzi57vk5uYw&oe=6A0DA561"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gTkVUZCgTQQ7kNvwFXKeak&_nc_oc=AdpdyDFCKbTFWMJnI4sqkQGXPPjGQDL04EDySUS_5b0p44WzBOillqyCCWZnduieobk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I8wJXiwMK9n2qnv-eWoQyrlFZUxFCwBlV2B6AALxTNA&oe=6A0DA01D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLhYiaUrrJcQ7kNvwFLQgFf&_nc_oc=Adp6nrd5kaVTVz72yuDMiO5iZMd--aK_XmB9RT40GO8SW_oB4mNctNvrBRFzjdqQ50c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7crK8hfqZsaI93FNu8MQuPe9Rt9ZbJWNBdnAggqx07Mw&oe=6A0DB56B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOsCtJtEP-0Q7kNvwHq6wMM&_nc_oc=AdqMAVFDp1vLbIlwBZuhqNFdsT7TUcBkFdalI8iTIaM6u_0fs3Q1JvKYJzXpr1lvIQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74nX0lwUFahHf14I9aQxnZhYwp2rqfXohcE30OigLyog&oe=6A0DA1F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akqS_zw2aHQQ7kNvwFz6gv1&_nc_oc=Adr51cGCzaxJqhSt4sfWJFO8z0tRvM28LsNE1jNbzmygwkBHEPK26h_-W9EQlobDK7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uAHAFLEmMIisxoXS1XsbDByAxyfaScE81yUqv9zcZuQ&oe=6A0DA840"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEmaeKsjRpgQ7kNvwGlM409&_nc_oc=AdrBHMns30kHuBx6tlLtnaHvPfHWo-WwqX0HR0A-ojKroQQOR1WtMnHdI-IHHfiC7tA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yolHyz0UUuhS-_GZUxBnR5OhaXz0d9j0zE6O6ohdZpg&oe=6A0DD
cdn.com&_nc_ss=7a30f&oh=00_Af1jxAiMRj6QmE_rhKNBFhkwnnzaGWfoFbXpgA-WqlTn_g&oe=69E0F34E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCs1xrxwGBsQ7kNvwHjl3Es&_nc_oc=AdrdffpzkmTG4Ft7aAALi4d87oGUV4xmmB3n5bpkkKdJSrJ5I79BgcRliOCB_nOjyXU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01dv1HddJG4aWCDn7ZdNbPdRqBj_EVXW4Bt015ns-cUw&oe=69E0D261"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdN27ixnW_8Q7kNvwFelSI1&_nc_oc=AdrwwdDoozggfG02yZEEcbF2nZuQN7UHty8LkYe5TlIDqYCD1RsA6JP6pCPldagVQKw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30sB7v8kiq3dfCwRZoA6wm4AnH2_I2Oj1IJfcu1Y8kpg&oe=69E0CD1D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3uaelX14CoQ7kNvwEcMS10&_nc_oc=AdoeDwtNPQoBvMV7zwqWMFaS6HJClXRom-FDLA9ofRxd27SF4pwYccQFcOBkDEtyJ28&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SlS4DEz7ddSm9_KbbdU-gG1GMRT2T7Tcxkx5Ni8iv_g&oe=69E0E26B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrFep1zGkj8Q7kNvwHKdZeI&_nc_oc=Ado8F_bbE7Tmd-2Hsj4LpYPs-QmOUrwtDxRf0TF0xkvWHjFMs4Tod-WL5JITeCzEhIA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Rp8ZnZx2_jN4cWSyMsU9zuvHciRhF4UDnFrJmgUZOYg&oe=69E0CEF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLYnx7is60oQ7kNvwGFTpUM&_nc_oc=AdoWWr31-Sh_ii1Gku87N1u-8UBABUeuUFYmFFpzp0hRjX8u6Pnew2MRSdybEKPEEI4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nxAGyHtZUR0lRy12byHBpVIxWn7j9aTYQS35nlHuqQQ&oe=69E0D540"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot_EBpmhUYkQ7kNvwGfUYrW&_nc_oc=AdpT7hvWLMZasYTLdhSQVvQoxfsy_Kvk4mLnfpnwiTAWCM0j7pxhR1CNi-9hD6W5NVo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kAOGo_0Qt7ofPVdc3mnf8NS4E5Q58gCvGxVt7Wm_sJg&oe=69E0F
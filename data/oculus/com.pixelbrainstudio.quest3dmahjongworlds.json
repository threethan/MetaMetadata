cdn.com&_nc_ss=7f20f&oh=00_AQHRG5hRT-IzOi5baePoF71pdn5OCHi64JFK8HHBFvGLdw&oe=6A70A6CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOANId5pJ58Q7kNvwEn46cI&_nc_oc=AdqJ2FkGUqAB9n_V_peSfBUt70aoKBqbm25vJczLaRQ71PIxwneHa4Eg7m558AVY0yg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4HjZCvi8YJSO0FMYbW-X16OW3OdZ1j2xFYuSp-iKT0g&oe=6A7085E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMgE0AXj3HAQ7kNvwFWiC5F&_nc_oc=AdqtLHRL4u38wYCxSO_qECHEW1FUXIXGqbHI-1rI4_ST5aJBuDeqBAoK-AoGfOeQEiw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWZ8jAIJm1kNzAc1JuvmwGnGIzImE98EnXp-Z8NqQg0g&oe=6A70809D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzV_OcIeEtMQ7kNvwEYKcSX&_nc_oc=AdqsW9u5NtbDSq6iHS98A-dLgucYBBISwII2MBaUOutyo1-LOIKCbrTTPbJ38megnus&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUmsFJr04SuMyDPwfhInRmZ3V2FGmj8YXiSSX4u_k3wQ&oe=6A7095EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kk5DlXBlJWoQ7kNvwGcZkTO&_nc_oc=AdqNk6skRKnZA5UpDVkRTDGYf5ZmTgH7wzqaQJHpOryP6U9QVUNKbwHjwv6saHq5gIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwivRSdQ-cZhd0CribA6zXun97MYOBWEkoK_6KS2VdQA&oe=6A708272"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_cpoa4QcfAQ7kNvwEGBvc0&_nc_oc=AdpbDYcN8DiIa4oKkQyaUgtlqRkdagP5Tm_0gvBmhGOPzDm192ifs-sJcMgq_S_HrE8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKCt7wjITl8lfUu7df-VgVOWjjixZf4bm5w15txPZagw&oe=6A7088C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJPpX6RKtqkQ7kNvwHvBO2F&_nc_oc=AdoDHbgRHKgXGzaNyICC9sttG2ANVb_0Z8WeFFkFHeG3Hk_PMBnMujwS5Gm1IrhXy3s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEvOpJWPN_Ghp1u8Thxbn2cYb8WNYCXL1_lzMDI3Fv7g&oe=6A707
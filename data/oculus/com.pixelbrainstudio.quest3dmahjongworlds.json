uluscdn.com&_nc_ss=7f20f&oh=00_Af_ML-xCe-nq8NxvVdiWs0SXTw6eJqByTvPeBL0R5ZPRwA&oe=6A3947CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-E2e_dVd1QQ7kNvwEvcvDA&_nc_oc=Adpfkx-ZwP9MDDSZDXGiT2HLULRM2ipsF71I3yZlIzt1AfXUOkrMakxY26WKuDmix0A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95n9OxNwLZLifqQCfYa65MNQnBBWQg2OrQljfQ3h2eoA&oe=6A395F21"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGJPb-d1cg8Q7kNvwHnJ2K2&_nc_oc=AdptT6o9skl_71We51tJy5_p33WrxnTtV-m-NHZMbO1PVv0DW_QZbLurR6HA3gv3v3A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sanrpMN6QHg21Nu9h8GY10kh23ittOesoF50nihDxlg&oe=6A3959DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36H6VINUXAwQ7kNvwFAmpLa&_nc_oc=Adq0NaTclzy0eTRt-VltmaNF7XWPvFRdrzSr1fJqFscoV_LK8hCFTht-PLC-Wu3FLAk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LWdzxUUW-TcGSTf1RyLadL2CH7VY8qkWerjmt7_4iwg&oe=6A3936EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blOXLYmXYD8Q7kNvwF36eCU&_nc_oc=Adr92iE7nnQ9CW4_DG5Z0uRKHuK6rYVtVxtdONDB6B-ws_lalxBZq9X3O4ugLqQpdAQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A9xWqjVopMT5jhtHs7SBE0-NF-VWIoBi4msv8xTOy6A&oe=6A395BB2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2ziGPHgUFsQ7kNvwFh_pjh&_nc_oc=AdpGTveLaEuGQKrXUaXQy8PNTVCejdRQzhH3d-aT3TvMg-u0ys8mOpk8qkxtnY7KBxQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-L-k40o1Z_-pvALmqHg-JwW-2W1ao9LbqS9S3mtSwBJA&oe=6A396200"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jUu-qw02IIQ7kNvwGbwSsu&_nc_oc=AdpgyZnTcUPTULK2-UFDVCcK4dL-PeCgTa6sLoJLA8lZWMNDjuPnAyhsfIMzbo4YSGc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IbyFl-N8NDXthWbxN3eMPgDmvmhTF3sT0LIu-0Ijltg&oe
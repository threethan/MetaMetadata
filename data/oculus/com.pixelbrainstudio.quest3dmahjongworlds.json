cdn.com&_nc_ss=7f20f&oh=00_AQD-JV8yxbHh3lo0YvISVnMO4y-VWslAYRAI-W_1CeHicA&oe=6A68BDCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyGNLCAMrcwQ7kNvwHY0c7g&_nc_oc=Adof4urp4DtMntamKJRxvURGnqTTHMWqY0Q11giRwUhqVLjUg_WllHcn_GDcGYMN5Mk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZIq2e2oIO6xS4xaykeSQ_vgWmcOKkWNSX1LOXP-9OLA&oe=6A689CE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbG2DAoFKu8Q7kNvwEyMbG3&_nc_oc=Adp38O9EokOY53JtIInWXqqfHwS__kApkzeFRVkbAu73bxo9id4ODntWU168_S6cK_E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj91QPEirFZf-O2uY-i_wgniE6V8P7EXCxqTrGKIc34A&oe=6A68979D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTlDET05pwQQ7kNvwE7Q-E9&_nc_oc=Adrk6ZzWMs27XhTB90JeOuJ9sELnjRd1yqUQh-2qhRBR9tg8QjQjFq5I8LMnz8urR84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCs_T8pgdXvccEj_vHyvrqDGJrUaS8FiahR9x8DARdOOw&oe=6A68ACEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1fmIlCaPWEQ7kNvwEuWciu&_nc_oc=Adp0WOh7uzjIPSSHZI6y1k2h_ZfecRx_16zjvQVF6od5Hy80dHX-66MOKM789AwAnb8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCbJYxjCveulmRvqZ19E5xX1N1i8yrQneljWhFZYBb9w&oe=6A689972"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcyAtuRnN3kQ7kNvwHb9unB&_nc_oc=AdopSb3jf80x1RpqMGwoWUIG5FbzrZmp8CqAtMJw_qpui_0AfrA4v0s42OrwQvf2_IU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT8-NOO5pK6TCaNFHikJIHt8Yg3Zm2YyQlNaWSVNAGUA&oe=6A689FC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLqmn9hFDnkQ7kNvwGsevLr&_nc_oc=AdoU3A8qN_iRCAb3Yp6XcZRTKqBdDI9HpWHN6ejhslUp7HzHzMOyy-kqIO96T4po29Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJJ5KZMhVnRoodZpAHtJtcKxoGrBYHcoBq3eBc5wMDyA&oe=6A689
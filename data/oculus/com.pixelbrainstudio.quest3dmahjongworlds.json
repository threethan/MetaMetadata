cdn.com&_nc_ss=7f20f&oh=00_Af6Rt0Ay-L0Y_PoU8YIQ3RJuIWzonFEu-KvPK-mY54b1-A&oe=6A01E8CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz_qSNzBlWcQ7kNvwGIuO9W&_nc_oc=AdoQ3pmQzfXRyQWt3vZ1L1VnsG6pjtOa8vF_qdfG1BCtKsKr1QmZMZ4bqtxFH1xeIvg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40X6e7zrPpYyeqELpcWgvqtW5Rx92gelRAKbEQZ0ZXkw&oe=6A01C7E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPNRkGDTKd4Q7kNvwE6CLue&_nc_oc=AdoYqEin4zeqBADvDeg1qlDgy4pcPdU8yVHneuL1kCNDYOo8zmY5-5_BR62APs8Z8LA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_y4cfgb0Gmywkcyt6CORgMneceQXSteNYlxHhSs--4A&oe=6A01C29D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oV_nO_Rv28gQ7kNvwH7PCBJ&_nc_oc=AdrdJc0RdbH1jB-E5w24qxmtwtvWOxtsVpi9aEz_eSOzzsTAHkodTYVKM2-nBU6rFjg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7us1KquX8eGyH7Hk2Ky1NFrjoduxwn0AJEVtCiHh_Bag&oe=6A01D7EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBi_6hAV2PEQ7kNvwGIe069&_nc_oc=AdpcwCvW5afwWkePdzteX6TAyjM4x0yoBlx6b6o3_43EZN0hHB4h9t878piYgts-rbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ggJywQGxX1TViikAOQW_HVXlx2W_BvVuXDIOflc7oHg&oe=6A01C472"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pH3MsS_A70gQ7kNvwEQ8R6N&_nc_oc=AdpqhuHH6l-5B7CmS7zrjW2OI_ujEpsuqcu8tcQc1QYLfNqyxXe0CkGeWssnyX6T2HM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uFbwWGUJUh-FnEdqUDcYBlK2sgytSiajI0OZLO7KViw&oe=6A01CAC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAHsht952_EQ7kNvwEZUG3x&_nc_oc=AdpyXA_enWsY8AaDV2Y0xkhMTpe5ilvoLaM7nlKl2Ilg7u5LLY9rskMtC0suTS-TfGE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EQ10jHuxu_qAFStF_ABC_kqfPyix7nSx0wSzf3K-HYA&oe=6A01F
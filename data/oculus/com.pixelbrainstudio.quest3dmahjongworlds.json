.com&_nc_ss=7f20f&oh=00_AQL0s-0SrEWIa2IVwgi0_wSDZxLZndxy30VfzBFgzIZtPg&oe=6ABE6F4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaB7LTvAiIwQ7kNvwEJ_I_z&_nc_oc=AdpsntbsPt4LBIPs4mc5Qvs7IFZikiaUVNGDvbADJnnlgJUcI0f2yD0vdGyhMpiw-T4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFEwWVzGmsBhi3mNElyj0L6EPu-r7wKDdsvUNLgd3gxg&oe=6ABE86A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZudY1IwRGm8Q7kNvwGDHAt6&_nc_oc=AdqhuzX4GL4nxrzMvl1e0-hZEFzODbCPcZcnVWvKMjg9jCNRy4egk46Ho9UVwPkwIxY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZEzkZ9IEfyUSAgrUAQv1hYKLJakmw9k8jklTMw04GpA&oe=6ABE815D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cN7f3dGreqcQ7kNvwFkLWxa&_nc_oc=Adqxh68nlhdADlcfsHeGiqpaCQMgcJhZz6YzfRM1_xyV9nEJExC3FaU-VJwNJZUlWdM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyeRAi4H-DELFsGUhgLZ07-jIP-rJJnVsZpVOHEitFdQ&oe=6ABE5E6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZAgi8ACrFQQ7kNvwHj7dMe&_nc_oc=AdoXxbpaXraDenY1_J1vjVkbmvDsa-YLQxO2axGNF6swvRfXLG2SiaQwmXYjihWIHns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTP-6QLyJEvKTAE57_AHQUeH4fP_dqpMOvNAGfbKZzpw&oe=6ABE8332"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9_E05D19m0Q7kNvwEX97A_&_nc_oc=AdpXZrYaoUNIy0o0gfhHtc3EIoSSUNjTsF8yOXkXYYCLydMOVOZkbzxCZJnK27JH6bI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEx1jr1vubImHr09TZW-OKF04K8EbBQ64kDtUZDDBv-Q&oe=6ABE8980"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMCH_dmeBbcQ7kNvwE4tar7&_nc_oc=AdppienCu4Xq7Lu1wUdLubSzJ7cNokuPseBxbAR_7u9RL7BtMb9QaSk0TbGB9UHHEso&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_U8elLtlzR2y9Uo7x4sqA_mSLcQWoxsmcMZn38U4HPg&oe=6ABE7A2B
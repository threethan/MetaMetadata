cdn.com&_nc_ss=7f20f&oh=00_AQKYzqIBU-wvyMb8pbzthJp5hsVI8-H5kMSqmQo-TMNN2w&oe=6AAAA8CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7p6VOV1Qt8Q7kNvwH0xCMl&_nc_oc=Adrlf1HTU5_jX7BaImVacvxTfhtS_vOUSQosnZ_NLVn4RqOzGYjDPQDnqbKYVJN2oAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQnWtIgCWOBL9bdWEuBuFAaNoSXY8rnHWHKj8eMpYFsw&oe=6AAA87E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knQswwke_YAQ7kNvwH2886p&_nc_oc=Ado1WI0OQSJXucf9bYBFp4lKTG5YB1NaYiqZBE_a7sS2y600DpVe62qrdRvp0jr5fxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLM8oxOlYjxZn3I8eN5dcliWxmX3cimEDQQ8zyHhYrORw&oe=6AAABADD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soOw8j7cZLYQ7kNvwETmwIR&_nc_oc=AdphmDYkeqNOVy5dpKtEOpczzSl5SJnqUS3aI6RXueM7dPKr0pvfbIm6JtBhOBV7qEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUKKllkCiTUcHUdZQeA78hvcTZhSai2SJlgEzV6GDw0A&oe=6AAA97EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8prpinAXOsQ7kNvwFKKTNL&_nc_oc=AdqnOo3_4jW_lc7GO_WLXlLhbUGr9TyO4dspov5GL2XoIHRADxnwCwONBGHhJUjyxCk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPacIOMntYSbM5_tOzmBy5-UuQ4VzchCX1LrhE_TzQOQ&oe=6AAABCB2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IDArSl2PoEQ7kNvwG6Zdg-&_nc_oc=AdrA_CIsUiiA2fU68XAwgTUG4_WiLr4XrHq4LyA8vKMyHtmiA64wtf8lZBgYi0AhGpQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkWVrIl-KhfmKRTBt-lTtHpWzYJj_2s_pqqZWY5m40cg&oe=6AAA8AC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJhIflGFLWcQ7kNvwEAtl3O&_nc_oc=AdrJxYAPP9rL_fxo_EGEJNbC3KkbXX8MsmQpjYU01SNqlB9YL5s0fR2X5godphp4G3U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfmH2ilgfZmbIKm0gQvyp-2hO4bAU6FLEigP0mgxszFA&oe=6AAAB
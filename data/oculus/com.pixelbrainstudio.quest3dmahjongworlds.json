cdn.com&_nc_ss=7a30f&oh=00_Af1SIY3zx33iJSLGc5CYh10s65vr2qTfHdfTCLdshZPY5g&oe=69D515CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJEaleKk4d8Q7kNvwGhJfhG&_nc_oc=AdoMoqnDSW9HOkeELGg70lHGkzlvU2GCgyQiUJN_c3_hHl9VTJF25mgWvp8xcQxiWBo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sj0z75fWGQRGQazi9lIjohDHSHBt0g7edzZ84tWgG5w&oe=69D4F4E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2i7tzK-lckQ7kNvwFZUVxP&_nc_oc=Adqcp0IIglJ0-2khhtu54ZooHOuy-Ps5rpgKrsnVburzyzpDaUFuKZxIo0IryAwiniY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JsrGG4xHrSJ8E-cj7nnkIgJ_aGTzB-GwDwrtbAy-LJw&oe=69D4EF9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lkd5mPOJbJQQ7kNvwFcg1K3&_nc_oc=AdonHM0dkdfO4llCBT5eIx2cifYn07Yztsy6gt-5DB-f1JyT2l3NV7ZGAY93xwY0Zc8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gnmByrBYf8QhDYOv56wz9RveqMTDPCWOpNTWabLFwcg&oe=69D504EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3dgbkwoFtEQ7kNvwFEHN6B&_nc_oc=AdqaRgtNmJR_gvBe8cUtDheKfgv8AJ5XT6_ZQX_yln9tFvlnnUY1My0URO1LM-yOwrs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Zn7McWCaBmTWIXCfdgQx261AH2rbeypRMdXtUZVCtzw&oe=69D4F172"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqHYvCbBhkoQ7kNvwF3mkU-&_nc_oc=AdrcggGPCzGcwn7k26AhPLD5QobZ8nYafE_9cjzbxcO3jRmg0-bn_fFlvgJTFHShl8A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Zul5J6OS72M4vQ9vc27l1gG2-Do0vM1mJrl11ejhC4A&oe=69D4F7C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06phwcbHbo0Q7kNvwF7ps6z&_nc_oc=Adq1pzMpNTTf78lhIm2zAW8JokjfbAVXWSD5ceRZ4gTICh9evKAzCvJbmugExkzI8g4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xnkT0yGK8k7rKBMKEsTAeLqByS8DZQewANyqj2eGmFQ&oe=69D4E
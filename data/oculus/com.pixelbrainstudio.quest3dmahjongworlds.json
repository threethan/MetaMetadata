cdn.com&_nc_ss=7f20f&oh=00_AQDo-upVH-JMrlEbFwZ1pJIVK-bKabT6MGAiOX59cgvQEA&oe=6A4FB14E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3udw8eJlSkQ7kNvwG9_Np0&_nc_oc=Adolq6Yb-CJeLCE2m7eehLjRbp1M42bJQ1GuKR8ez53qfYu6ANUQ9fBobAFNE3kuMWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLn4LU4jPplYuf8DBmlaHsQwkWJkfm2MaWDeqOVAdB8w&oe=6A4F9061"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zlj6hLZJiGMQ7kNvwG1HpJN&_nc_oc=AdosEEN9YA19b_mJ4h27Tbps1jIdrlcc0Pen1CfkSMTWydUpUAud82Pw_hDH7i9M9NY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEPGIasNphiTaca7m44Sj6syqaW7KDYrODYsDsgwKBFA&oe=6A4FC35D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOO__zrT4qkQ7kNvwEMV0ys&_nc_oc=AdoZbB-wh3DKA_9l2tkA7qhdPCPX_Iyf5m_InWLk9H5bZd0BCqRxCJolPo630LefcxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBaseS013y01aYugJh9SyC8YnxDsnRJE49bdjfzbz8_w&oe=6A4FA06B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyC0Mc0gSSMQ7kNvwF4iSFw&_nc_oc=AdowZUpbs2If7e51EconJSJ3ZnbYzEagTWJFcivHtpxi5Ei5nmHpqw-GLyQFqfLZnVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTs8LRjwepgbiQJD6s5H-Tgnfn1-WxQ9hWp4IL42q6ZQ&oe=6A4FC532"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxy8vwj3eV8Q7kNvwEluLmm&_nc_oc=AdqhY19a7dUK_rlDA0X7UkdHgNZ1nIOKQ7bjMbLTyurdtP4OyanGFAcv_HLTdKL3Jvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKSdSQNr1LJQQoqp4wOQIvKM5oHJpIfPyUJ9kGiV390Q&oe=6A4F9340"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eruuGRiLdxkQ7kNvwFhck0E&_nc_oc=AdpcELDvLQ8rbYkbpTMjtrg-WnKWu6zhDkENncHqZvvNeFmm6qQQ7vnfV3JhKRVjYhg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU8RdypgygG9rjBf1qHA8TMSpv_wleWgpm3Z127QeHYA&oe=6A4FB
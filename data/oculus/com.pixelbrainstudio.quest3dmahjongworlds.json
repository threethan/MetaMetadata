cdn.com&_nc_ss=7f20f&oh=00_Af5Tv0gvTb5unZ2duwEVEibzKOTAOdshyXMoWIQshG9X7Q&oe=6A033A4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz_qSNzBlWcQ7kNvwE4Dr_E&_nc_oc=AdqUymJB_sATalivEkOu19RqzWyKCyUAGQAlKMLl7gezyRmJInuHnq3vDGJnXmhpBk8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-OMkXkeGSFdrw99Qho7py8G8Amq31Wahyb-3gm7TB9w&oe=6A031961"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPNRkGDTKd4Q7kNvwHXWA6X&_nc_oc=Adq7nQiWwzFmVvntEMdl55Yw3UBrZdkUftQThfNkv1KAXxFvUMpYWAdRVsVkj6f5LTw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55HAuKfOr-Jckl2PbWYk_-e1IVfXSBs8OIydJ0FML0_A&oe=6A034C5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oV_nO_Rv28gQ7kNvwFQ1nfs&_nc_oc=Ado_TBnfOuLPo68KCufSNbWJQRFzmi2O2Ze7yIk6zeEZIYM1GO7cStrkrTsd6X0J7dw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a5Fs53zrqIV9L8NFq_rG34QR-6AYHOzsG58G0bKX-WA&oe=6A03296B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzbE4Lu2RZQQ7kNvwFKKJ3g&_nc_oc=AdroCJEKqOgfymcSd6-Qp4ILO78cGrMwPZ8tsZXALJSKhK5v5HUzYw66pZXnEngv2-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BS4as1NsLlPjSFfAHgEUOir0PfWpBLliOLbyHA72oaw&oe=6A034E32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pH3MsS_A70gQ7kNvwHS-vJj&_nc_oc=Ado8rUWasMS8eq11XoVwlkeXIY4QUmMCR5MIDYEvH9IVVdkDe24ucJ4fuslqiOk8ZaU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IZumm6WXQuKiUNagQW3bCE60nYHRsBzEnFsRo_F8GPg&oe=6A031C40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAHsht952_EQ7kNvwFdAbhJ&_nc_oc=AdqaH6dPXRNify9R8AaKB6BorO-AaQVcZ91ttoekaFrmRDpChryhZI71IOZ_md8XyPA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fUKXf2d2izQdzzXXr5NWRO3pcr0y-6nYaeurzqUsdgQ&oe=6A034
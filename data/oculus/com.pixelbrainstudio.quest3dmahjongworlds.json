cdn.com&_nc_ss=7a30f&oh=00_Af0phYcGqz9TerX30C3mCjkBJlObFVIyZYJLfPTWsHJpbw&oe=69EA2DCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBXpOAzYVRwQ7kNvwHuimQB&_nc_oc=AdomR7vAacwmfqXpZITxloZaw_vi6fh2OBAYGLMn8VVLyEFmLcR18zqySRdsETZAaA8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3L36I5A-8KbOPxi_Z33l-IiL8UJ4RWIzpAAM-RwBBVWg&oe=69EA0CE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYsgZQPGxiYQ7kNvwE1Bhxb&_nc_oc=Adps4TFKd9rOV3mOCgmnIK4W9G6gedn-pK8pqbV4ZqJyj6_AcDLVMZlpg3bGPd8DT_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cU218Rmazw1cDAKWbIZ_VpHFclreo15Fsg_XSvuAU8g&oe=69EA079D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmqegnEwjXkQ7kNvwGd8Enh&_nc_oc=AdrUCZv3fCdhrGkaW_b3G-f6EMiv5ATz3prPuPapsLZs8hSs_e9ZhlBy_haygEPmAOI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ExK3p9T5jJbIROVuXN_l2ni5R63AAq8LHQ3vpoLvUeA&oe=69EA1CEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtSJLv-ZlooQ7kNvwG2Z1Sv&_nc_oc=AdrGtJMHWHT3oDzGL2f46oF6Tkq_wiFtyuEPk15W1zw87CqUo961yGxZ8crHAwXKXE8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VLx4Kw86NctiXmRZhVAFxssR3vYXBMICuK_28riCWNw&oe=69EA0972"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBUJRwA33DIQ7kNvwF2DT16&_nc_oc=AdrsAOFjKdlON0AfIdn2vM31WNmzqJm-yvxRZCebPiIUMr2DyHKE38APe0IMDvkJSJY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10Heu2md6aV8WrZAPl7C7KXwrALQ6OATdp3PZ-94ip3A&oe=69EA0FC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxMMJITatKcQ7kNvwGpYtCQ&_nc_oc=AdrD5bK14nHa9Dbf48B0UnZgJMkNdbRz32EXyUtx3rXdQqkZ10k_MeJptQmX8oo6k18&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PABOnmfbMgGz_gO5vgdtDLLArDAkb4RgKN5_vCV259Q&oe=69EA3
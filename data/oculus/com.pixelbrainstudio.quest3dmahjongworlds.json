.com&_nc_ss=7f20f&oh=00_AQS9fU8iGFiFDmk5jCUALRsX5eFjJQNh20QwJ58UH7LqJw&oe=6AE89F4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Zr-WHqJ1HUQ7kNvwGo-sjI&_nc_oc=Adq90l1wtTollp7NDdfQSWHxD6VT-SydGoz0zVIntkjZOgG6AGarFrHvGUX5DifuMKo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxBmFcaqrvuSqU-SYDMHzrfLFKJbzJx6U9c0iqOszPuA&oe=6AE8B6A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W7Jg-24aVAQ7kNvwGD8k3P&_nc_oc=Adr-uZuGba6YggaQkX_SVRXR1XA02_0fylNqNP3M8jML60e5URC1j4DT0EpRTurq83U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsJW2MKH5QCQ2UbtVbdswyHb3OgwfkRgts8wVPbvP0qw&oe=6AE8B15D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNoc9BwdCKEQ7kNvwGPMx_g&_nc_oc=AdqKpzGp3eHoYvLXNNcYh95nJdZrm38W6SyT61wnM6_54Ys9Bu-B2cYqNrAXBwiUAZU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsQdepazU1h8Yruyfsm6VTRBqGcrXifcNmrSXBUsleDQ&oe=6AE88E6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DY5mrcNFXwQ7kNvwGw91rk&_nc_oc=AdqN61xV1INJHEiC6jUKjYepGrMlnpFfXZkHGCPrMublL0Q_jEnB5v42bgkdlOovBqY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ1PTzt4hKr-6oDbe0Y4dGHmuQTTK4_EIKppWDvr0FrA&oe=6AE8B332"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXiIPh1laJcQ7kNvwEiDvxc&_nc_oc=AdqGwnfwYRKbQWS0VLNPKJKcCA5xlh3dzQ0Yae8OVCUtZ3FJWCp9dMuf__ePjA6LkcY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdgqcg_4y-G9sDsYd1G7LGQOQ8sMvxz_W9VS6bJd2QkQ&oe=6AE8B980"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhAhu2ClkU8Q7kNvwErPuDj&_nc_oc=AdpB0bdnRHdeQ-HgNFkeXzsmqF3pY7-RddD7wgkw9TMh4Kw0EMqpHAxur4HSkDG-rKU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZm1fF-tf-fcb9-Y_QhfJlmnby2ufZnXORy4r0NNIANQ&oe=6AE8AA2B
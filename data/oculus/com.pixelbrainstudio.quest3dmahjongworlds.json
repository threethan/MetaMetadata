cdn.com&_nc_ss=7f20f&oh=00_Af1dbHFwFUMnuYVll4PeJyUnF68Fqkv1BKIsPy1ceKImcw&oe=69EF73CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLyUJlhc95cQ7kNvwHXfvZu&_nc_oc=Ado-BkeIlXBnecpDQlY6eUNoxeBY0IRjs6eGyKSfKRX45w4t1UP2xQYT9_Ejt5nGSoA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3a2Zpi-NYywHpZrkc6RgDxbHpIRcg52G3a_reIFxJyRw&oe=69EF52E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8jYk1jAEEkQ7kNvwFq3Aji&_nc_oc=Adr0ekqIoBAzBQNglJb3xYo4Tgj6_yFC6oPHjChjoYdWTMUWybCa5Gm3f9VdofH0EdM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0p7b8UzZhzjZDbtnbGGnR0jafy6yoIgzftF49SDUp7eQ&oe=69EF4D9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAjOK4DEaOEQ7kNvwG_sD4F&_nc_oc=AdqVBvquCksYEyvQq_UeA0EoFK1n58eoSt0uf0I6VdhtOprS3sJhRKEtW1gnqXc3bxk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0UjLWsQ5wAaJdMLvevVWi9juvXTfk-G-rpiji88eITpQ&oe=69EF62EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htm-3lOcgI4Q7kNvwHcehNd&_nc_oc=AdqFJGKGcMiQIK-0LhU5QIe3Sw4YaILvzUAn6dfC928x0NpYnr8RAuHkfM2onCcFLww&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2NPn9Yl4mbxGXWapWs2NnqkTQw0rvcoqs_9i2WapF8ng&oe=69EF4F72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYVuV_H7d18Q7kNvwH0TKtS&_nc_oc=Adqi-9MQGSXglwgNU7xlHOGZaFugYdTZd046dz4FWlggbThyNu4Agk3n4yNRfUo7P_s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2x9XaBS7VtMyf-JuF9a9JS0GgqVyO_d3K0MPh0IKzBdQ&oe=69EF55C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNcc1cOZY5IQ7kNvwGO9gRl&_nc_oc=Adqd2eCNRZ7uLQgvuoak5eUK_rLjt6YT3ixxf3IyNUfd1g3Cry4CeRwV6QMWP-CyLZQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zCGxngN0CsS79qK4BBRFRDicgR8LuCk-KIMjkehiRiw&oe=69EF7
cdn.com&_nc_ss=7f20f&oh=00_AQAoZhHwtFLQdaDSu6CxLPZ1ysgePOXNk9TKjKTbPkG6gA&oe=6A5CE04E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY4Cepup_4QQ7kNvwGml5oN&_nc_oc=AdpozFgr_f_0xTLzZnVa7n_xKAIpKYh6B6DPExxoNiu0y0stHaDMlsNo1aWhPVJoE7I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCExEKsG2IujlshzwAf2WmrALhD6y34gVf5xEoZ1oo6Cw&oe=6A5CBF61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSIsjON33ysQ7kNvwF_E9uF&_nc_oc=Adqwngdvj-XubOlBUyahsc7n0UO_3QAZvgNsyCgqcncGPyi7X4fpSu0YKkCXPeRFp8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq9zAPldFJDXRRU5hnNuUNJ5hBzUzqx7KX-AqBRNq7CA&oe=6A5CBA1D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SttWHxO1hAQ7kNvwHDgDRk&_nc_oc=AdrTFHItZHt7MT3JuyDmnz_IpX2zR8lV7vNJj4Jy0rdVeYvi7pxZtUSXAechT-jsskA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwB256-whZx3GHXA95Bd_BsUTGzlRhxu-O0oE4cQqi_A&oe=6A5CCF6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7-A9hE0ktYQ7kNvwH0fBII&_nc_oc=AdpYtuCctppjap7F7b4l5OcxY7faukXDPTYh9GGqOhbBhNqRSJDWycumu30DdzEvovI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7lcrK1Z1O7FK7OL-k98JOR_2WPEj3m2N8cdtKz5VXZw&oe=6A5CBBF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dS16V9iSKUQ7kNvwG9Di8x&_nc_oc=AdryqZuXAk1moyFVoxTqzBpoNjFXO4LZ9GPAlKfkgz8koL5tDoBNBbghEXrVIzVOJ3M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3i4Mws0w9fyid-65qXn4gMpXW_xqegB7_XrOR9e5ZIg&oe=6A5CC240"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uCTM2-cKG4Q7kNvwHszQwL&_nc_oc=AdpeolPF2NIW7SfZ11FcQJATeh7-_ZII_1TeVSZj9TGwsvIDNGgi8Y4-kpH7eur7J4s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4YVFj6tyNlbwode2Xkqmb-nulP4gKHQM6pfEZkZ4qqQ&oe=6A5CB
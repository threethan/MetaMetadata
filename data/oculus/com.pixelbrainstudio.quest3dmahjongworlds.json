cdn.com&_nc_ss=7f20f&oh=00_Af5UheOQqxAa2zwTJdg7IWwdPs1RIFG2ukcQwJHwFxkfYQ&oe=6A08804E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfViV4PYQ_kQ7kNvwGYIqj-&_nc_oc=Adqomn3RJcHXH3krOWxbWdgQR1X4QCqVH8FPqzTnUiT-IAGK3oDbtHK-4qylo09ScLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mDM56OuKlhSOdMyeGM771IajX4yCbMVWx7nD_d_f37g&oe=6A085F61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiPiGkDQJNMQ7kNvwEgSoOF&_nc_oc=AdobNt9gPFVQGRBJNGZ8pSk23BzAOMiixSQSZbxAEVy7sBQe9lKlnFSeVn-8ubvvNm0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oDZo-CHRY67HBWf04mJSdom0FmOq4qHqvxFVRKgUnbg&oe=6A08925D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2c_x4zVEXsQ7kNvwE88X9A&_nc_oc=AdpoZsM7qz0qc7s9qK4eHFrmISSz87OsBDA_4LdCzaeCp2ldH-zIglej750lfYTgdJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D7sB_Xfn3X620Iw82Tq1bhr2H1djR2LqOTnErAxyLsQ&oe=6A086F6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBu0mm0ZMowQ7kNvwEf32DC&_nc_oc=Adqwv-iNiBM4Yo238bcYqDl7hJ6xUHYyCB0LQ1AmafkDv4NYvhQybl0LzZ0qN-1J6oI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L-wfc6nNlKVPq1pmTnYCpZ5sy-w_X_nukUP8yo0xeIQ&oe=6A089432"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UwlwloEvEkQ7kNvwG094X3&_nc_oc=Adq-q23DSd5sEXNSAQ2BS3A8B272snOT3mzH2p2xmCfoOuvV3DUgkas5gw-KnkM7u_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_hadxmmEGogTYbReRYT7kd1sdOVB8NViYcL1meO7zgA&oe=6A086240"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EogkvEXIbokQ7kNvwG2LOe1&_nc_oc=Ado77F-1VmbTesNXst1DwRE2L7Wvrm42buu-oeBLD6gB_jtkssq9phZdgr168wHiPTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e_Y_wqEZUKk753Ndx861oXgDGBtcCYAnllm1jeYaNhQ&oe=6A088
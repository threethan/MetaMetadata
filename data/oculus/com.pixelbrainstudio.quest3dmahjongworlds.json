cdn.com&_nc_ss=7f20f&oh=00_AQHbtkQrpfrNV9s1ejvEkqKcBS116WH7h1QVsRioRaU-5Q&oe=6A788FCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmlcqzIJ8ikQ7kNvwFkDBDw&_nc_oc=Adq86gS4gkxGXf3DyCK_krfsz0VzFRme6icl_iNMtFvsRiuY2yhRHojeTQNOPTfwgHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFV3jiEIc6XsYY_afYAPkfLxdDNJD-jhOC1NIYNIOct_w&oe=6A786EE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8b415PfSqAQ7kNvwEAcIjr&_nc_oc=AdpFmBjwv53rCcPFVQCf5F_OlEN9ATdkapjaWGTx1QncpSCJtMHQn5IYbP3dpZ--I-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCfp79a5rMxBx4P1iT5NvW0tSV-PbHISwvq3Lq5pm22A&oe=6A78699D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOF19bMLoe0Q7kNvwEkPJVN&_nc_oc=AdobqCPIwx1RQUBnJROTWx8bcP3UM1CKbYVkp77GQ7481T457AYg_K6zqm8w-pRIcNc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqtZp8sVj7Q5aWWCmnGHm08xK-0pL11-1gmVuapGtyOg&oe=6A787EEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QN12MiZW-oQ7kNvwGIDIii&_nc_oc=AdqVAdFfuPjCXI_RzU74k4-feyETIZQgpdk9HMtrqmQwhmxGuNUXviM905wybAQzx9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsz8bpDcKiNA7tr0Y8cAAbjfBeYKFp8tfrlGzd_r3pxA&oe=6A786B72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9TqlwCUfuYQ7kNvwF3sUyH&_nc_oc=Adrso8pYQiOwYMf6X0lc7mWUnNDPxtyUKVX8w2pN5omywRKjS4m4-jXVBd7jBvgdp04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEo1awFnxTfuZN7LyaXhm-dMtktpqMLemE0uTPFLyjF8Q&oe=6A7871C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpbwKDW8ZEgQ7kNvwGbhXkg&_nc_oc=AdpBkNTOiPkXAAqovk_oHnQUVF5yFS-_vjp5KhJPpEFaZAlSRaJHjLCCHxu0814qB60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3mREsO_7tUC5oxz3HnXMzfYfTYeq7e-bgYuny4dE1hQ&oe=6A786
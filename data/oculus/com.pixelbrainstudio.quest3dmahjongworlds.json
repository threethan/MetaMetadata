cdn.com&_nc_ss=7a30f&oh=00_Af3d_Th7bhKiROdzvaK32Bv839LL0jz0_sIzKI9NGiZcpw&oe=69E6394E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhL0zjuDPcsQ7kNvwEx2qcf&_nc_oc=AdpYAgPKJzF-_20omPKTqFbOuk9xE_JtN8vtVuk-mvKvKCgh1tMtYaxfD-L4lUkqWq8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lmKmy66XXiWBhZ_fciifHhbCzgSiqV3_vu0bku0SKKA&oe=69E61861"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTifU9-JhAkQ7kNvwE8Qor6&_nc_oc=Adoh7MSagdFvTdgqVu-sUgTQ3yyg9ybUrFSo998jpxkNfFXzsQLGkcOYsgkTm4B_8Gc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pUGN4lCbpHfeV2lH-QuIbVrJXTDKUyBOME1DuLl5G2w&oe=69E6131D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7r1fgk0INEQ7kNvwF5TdHS&_nc_oc=AdrJWL705TtvxNtanQBGXUPAIR-7K2Pjce5SFf_zVz2ihCw2F7tXDsLe5uFmzN5BEiI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0le9ycG0jBHt5EP9Kr_RspMVddlVRDP_G2gzCsU9IWGA&oe=69E6286B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDJgccjag48Q7kNvwH_l2Sk&_nc_oc=Adrtp3iem425M2wJPVoJZGwKGnF8wskMs85jqzDc2JuQGz5aez6d1MnkF1rmE5VCmnY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nSZ5aiMECkK75m_hP7im2F3ro9beY1OKYKhv_alMopw&oe=69E614F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J02CNKdcmtUQ7kNvwEO8tB6&_nc_oc=AdpoReaKyeqcaI0C6y868w6P0zvAWI1Bssg2Gc754q4fgqMnGmqOyaih0-r1SRwQvGg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09qTLodPVgC6vMYCBn5fsaqkVxgCzeyfGlReiSE4eLfg&oe=69E61B40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSDan9AEGYAQ7kNvwGXSpb5&_nc_oc=AdrMkdpOqHPqY1SjUgKC2bRz5fUJCKrTZ69mUp4_31GmaiS3eqdllQj0bglSMHjtbY8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LTlNLbHkr4-l71HMglAKnzYSFDd2KqMc0dyV5GAGZvQ&oe=69E64
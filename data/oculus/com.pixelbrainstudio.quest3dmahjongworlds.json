cdn.com&_nc_ss=7a30f&oh=00_AfxdFkK759TRUaWjYbVSqo4hHqo9U-ZJjKKcG6baYn8itg&oe=69C2A0CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5o-7mcohmqEQ7kNvwEjX21N&_nc_oc=Adou6-e22DZbrDtbmbzd5QUiewBW-vLd--Io1PKTAi-yhcb3dxIUFIqAw2g_oPaw0g0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5lxTQG6OGgLOk78Fcu9-kdTwvfV-RkTGldfFUJYr-Cg&oe=69C27FE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAuLRqZDbHoQ7kNvwH14FZi&_nc_oc=AdpR6lDp5bXnKNHrWo9se3FNKadHb1kXRrThkdt3byrNSIf9raXUt9nO_5VcRVsHRIo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyC6aiLGfcTfeTQdYzrV_4s2SWVCGnYE2tjS9UuSyxLHg&oe=69C27A9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fi7Ufz7S3MQ7kNvwGPGlpB&_nc_oc=AdrUW74LWAlfyMYegAvTqshpRkeFRgeLwvX8oJWBEeIN29sWdi-1nJffcMVWMmEh-3s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKeDRs87f-wpUOTCDC3RiHPVgaRNTAlUiOiq1qYuqgUg&oe=69C28FEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BACo78sZSHwQ7kNvwEBLG-H&_nc_oc=Adp-ujoyYJLIBlnWfhz1yWATRcKXG-8fBE_s9GDwFN70H63JOhtDjk_wiPRuiZB3Ilk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDnmIRY9D9x_9Rt-0lc5Vpw_X3xQH3zGeqmW7vp8l3Yg&oe=69C27C72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_4bByh5zsAQ7kNvwE_xn4r&_nc_oc=AdpRftRQ7sxDMiSWyS8LAshIU8bcpyCAoXerwELHxl0mXkQv8dSZcKQAwouE2FbDKlo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxuWbcLcP2KjawEex_CqFkY3qUTd9K1dN3EOG6FOb9BKQ&oe=69C282C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UL9xqknLiUQQ7kNvwH5_C29&_nc_oc=Ado-n_NONrgES2XnrA_eIjlnkqfpfnW9Tni1rdikFgE6nPxKk8z_UAJig-AhpJMODQI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8oO56-NLVYoq6d9awme3iFQmCve9onileQg0FLyDmcQ&oe=69C27
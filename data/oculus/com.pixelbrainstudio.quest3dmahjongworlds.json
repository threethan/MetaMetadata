cdn.com&_nc_ss=7f20f&oh=00_Af9CnbAIz1P3j7IYJNWVFK1j2eLq-LuUWYCsMl-affUqLw&oe=6A3FDF4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WU7EQJmTFL0Q7kNvwFfWE_U&_nc_oc=AdpHaXE-JXA0JAR8CGgeN729w3lPJo8GJYGdtLL8gkVbiuPDqgNdgrr3yusNkKkYmBM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BfJOznXi3lAEO2w85Q2N3zFeIwV7kxxreIHGvpBef1A&oe=6A3FBE61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbekWYsHjEsQ7kNvwGKp7fO&_nc_oc=Adrmy1myfr022JW5v0pr5MHcfZ_S5oBQeuYWpMe3-7ECJDUQ1z5MXsGtsDOGjgb4r78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QlFV6uK5BDBordJpuVlmVvB4KqafAAwa10OG3hII14w&oe=6A3FF15D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNmSNSPHNe0Q7kNvwF-ghQz&_nc_oc=AdotkjFD8ql3G8MialMTTY_1oCFmjoRSqY_Faaylki-ckKYWucAif8bHmqZK3BG7x-0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8epblnaLWfMfz5FAgGYmSF_p0NX8GmSCRNm1iDhcqRzg&oe=6A3FCE6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STUEgFnm7qYQ7kNvwEa_x7z&_nc_oc=AdpFIrnFmrxTCmmv_J7tt72CyR4mNYcGZmkb5a_t6jGaVtbovEtQ5PnvRhodJLcdQRQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SW7FYtK4seJwSdZqthBKkrImpZHA3nCtYn8um6CbWTQ&oe=6A3FF332"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u27gdWwi_hYQ7kNvwGpmYE-&_nc_oc=Adqw2sU-IT59WmaDd9gQ3MvTW99n-E5WjfrPp-rKUYCc3lIMLjzhhTmYArj2WBJ24Y4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bMQEmGA5rY1DURDleEM_DLOoMzWFpWo3sC6ZiaN4ayA&oe=6A3FC140"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTlS2H7Rxe8Q7kNvwG7mfGG&_nc_oc=AdqB0zFkvP2hh6aduDacu0sJ6Z95Dd3clyNBavq6ggdz4QqNXx_2AbMptnwKXHAwJjQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-L7lhslnmBNdHOdtyVw0i_azgkRAHtinH4Jseo1Uc2cg&oe=6A3FE
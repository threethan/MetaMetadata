cdn.com&_nc_ss=7f20f&oh=00_AQGS7i8wX-t2R33obmuxONtkWAabO8obtFnZ8Sg3jsP6Hw&oe=6A80408E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuaRhYYLGvcQ7kNvwGQu4E_&_nc_oc=Adq63MKdsVKwJA2-7yyXHnBG311BjWsI-nDYsDfCJ-ClH5HN12Ie3RKmAFoc3NQP37I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmegCLkZYHktbt4gBn9Q1n9FOvd2zyLGJJgEDXA8jylA&oe=6A8057E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EP5CjsAlwsQ7kNvwFTCMsw&_nc_oc=AdqXu1jbJuqvKHxSrOoUlYRNi-jcZSGx22PRR-yOS6zvZKVxsNePAmv_yAbIShUuY-Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm9AO0KdzKBcdvnJcwpHeOmoIVXHRL90PNiezF6NPEMw&oe=6A80529D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1mGFy0tnoQQ7kNvwGqH2FU&_nc_oc=AdoBP3LhM81wDsB00drJHsQuZ7kd-DxZJGXF5GhzFZWFpKqZs0VTIn8QPVGPygiTKp8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwn-pq9TSKndJymaTmpA5DDyci9Waw04UeTb0JF0CSZA&oe=6A8067EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxrpFVHdxZUQ7kNvwF7WQpc&_nc_oc=Adp8sIGOTkHJu9LeEjkva-Gt-FNbiHVM8mOq5qehhYaeocHR8pKdgokz-RL5LRC5oM4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErITfDtxajg8Shnt3MSEq_lYuiLjb6X7ufcFRjicTSBw&oe=6A805472"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeEP6WFx2vEQ7kNvwHBaWAr&_nc_oc=AdoU3Rgjw-xF2K7j9C-QsCvmxtvPtAvUXFdiHZFit08SKTyp6DB6P_b9l2V1egHKejQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_0zP-AknTpxFfKeE7bBCmc_Wv6sCGdA7ACbqnPQZhfw&oe=6A805AC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnGkajyJ5lwQ7kNvwEV40tn&_nc_oc=Adojulet3dwGq6UKB6ykvR_HAdS4mvvf27mz4yl81JaXiDdVwUoUkGxNHcpe4Wrifos&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcCgV3oGBQF09jmrLUpMHAQmpClvTgh2rVCDCDMBpVbQ&oe=6A804
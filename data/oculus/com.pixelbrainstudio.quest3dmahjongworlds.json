cdn.com&_nc_ss=7f20f&oh=00_Af7Z8fE9eRz3-rZUqaWUEK1f9qOilxq8D0H8_KzXAyzguQ&oe=69FF45CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjX8cl6N05kQ7kNvwGACCuH&_nc_oc=AdpiHj9KJ8aeqmNMDQbrFvy55bQKKARjUNK3c-SLC2nELdqvuqUmGke7ZvbyW50tJKU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kxRmpU6Ume2JxTLXPowr6-LmyNcgGLVx2B_bRLsZVNA&oe=69FF24E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qiIDJ_081UQ7kNvwH_QI8S&_nc_oc=AdrVDhwsrxyFbWLW0Ky0ZpxnpzMjfrwttcyBLlzXR-jBVcdRL12K9I1gAfU_3EeCd3c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42Y17J68nPBsJW8yfb-201SyGojH3GTHlli_xgvwLQoQ&oe=69FF1F9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fr6-nvdiF30Q7kNvwE-cgr-&_nc_oc=AdrdQuW5hgnAEbSlVXMrRR7DbnLBxwC2494k2wZFhf53yckY5faZUaNEtwbYe78rTkU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sWRtP17d0oTyA6w7v3HTRv6ZJvjSWMb4Uup-jZ8Q2AQ&oe=69FF34EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBi_6hAV2PEQ7kNvwHbEXHQ&_nc_oc=AdrWepZG0QYOf-kRHV2vj01HwHJQJ4Wv42j-4-Vx8Noex3eg8UOijJom4wFn39neCL4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AVcuimPUuycU-vmGSL83YdBfSwfs3gp91TfVJc9aFgA&oe=69FF2172"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9ZknTyS1ZgQ7kNvwFQ-ID-&_nc_oc=AdoSKseLcp2xexYxrAo6FkhD6CgbVPaRuYV2EF-vrJJvrV5vHkdnZQP0ZnQWpP5qMaA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eKIBaHKY0JsZI3mn3zICOk_OpWAqnih3_D2jl2mtUbQ&oe=69FF27C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkPEjhNsE0gQ7kNvwFyWG-B&_nc_oc=AdoERboY1ba6Q7-eI5e0Aq1IAylEKvBtuB4B5QQ7-8ueQAvCKdToPqvrgs9lYJq26Rc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Up0_gQTyqRSRevbRWhAkDr_WtLCfVpda3D7SfgxCKIA&oe=69FF5
cdn.com&_nc_ss=7f20f&oh=00_AQDbQoOZLMyS5QAl-Uo49d5vyXYzcHE_-lu2kMQM1R1FEg&oe=6A6B60CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKhy6xkRbpwQ7kNvwHWZgEZ&_nc_oc=AdqWq7YtbFVnEthBEprbHAh9beJfk7bIv8YWB-uPQRiQWlodp0VuVVYwpdx0vJ0YAxU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp4vLMW8rfk8Ov9ppzL-1AfqNAqkndDHoIsm3CTDfRpg&oe=6A6B3FE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjfR7I67sicQ7kNvwHIjuNn&_nc_oc=AdoNchkc6-bRUWPSzFuCmwrmsYbLBhb11Du7SRg9KPrqt5HX6MCPsSfnBohjUsxbWGg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8mF7EusEw4AB2hwWfBmKYUOdl4CykpHTERPHiwtzydg&oe=6A6B3A9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIWVzQagfTwQ7kNvwGYQCFI&_nc_oc=AdpN0VSWaggdcHbs9Z7o60c5bugLclt5kwbgTA6xJUECozqNGkaOEUimMuagaykdz5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBA7jVV4iyfSRtf4cXuP0Wniq4j78Q-WuLsTlfrxr5uQ&oe=6A6B4FEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VG29cSkfAssQ7kNvwFG3Vz-&_nc_oc=AdrdJU9yEza5E6DHGnox7hBVzQ43eL5FcI5PWCk6K1pjdS7tgqu5z57btZTIepWFOWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL2KoHknMJCAYjLYU5Xpto9RddRgJiY4t2BvcpOmMY-Q&oe=6A6B3C72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3_aBXIMjcEQ7kNvwFhyVIo&_nc_oc=Adpy7x56oTaWX4Hxiyc2G-fhEtHPZcGXKOyl98roZQ9vCrAMYYBQQvpfLHTcRQBKLNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFEHX_v0fYNSzW-zzckILqJ8nWey0rdwdpD9V7q35cGQ&oe=6A6B42C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLqmn9hFDnkQ7kNvwHNOYfH&_nc_oc=AdrmrE7K8elMYMk_c_fDYkLnHl8BE6vFCB-GDgo2eBID9GfP2tnrRJcJtliOhMilBqc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_oZI2jdvNODsgOsl0SwmyKY1UiAFvXihx8_q-SxEljA&oe=6A6B6
cdn.com&_nc_ss=7f20f&oh=00_AQEyJo2qo_7S5rScVHwYMSFx5wFrGoWaGwClDqcnsTqZiw&oe=6A773E4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmlcqzIJ8ikQ7kNvwHJzPO0&_nc_oc=AdoKLUa4jIvDD3mUXfi0KDPDEgG-seSSrURQoxZl_hxMu3ZZiBnv3KEeaQG7xIGxAJg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh6FNjn9nhx5EmAglx0XHEKkxul8093jiJ8NH_2rstlQ&oe=6A771D61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8b415PfSqAQ7kNvwFuA6Et&_nc_oc=AdpgwWPgD2_c0k7nhZzAycbWtpeZb3XvG0AjlHMRUo4I6WWs7dgrPiogfIMutCsmnNc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERkm7eWBiXndSNldwymbW8nP2Z80h-dAKZ7OytWgtTuA&oe=6A77181D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOF19bMLoe0Q7kNvwEAGY8h&_nc_oc=AdpRGmOQEjLuGzA9Msb0a59Ccu5MafKrRhmn2I3kwJ6iq_22ZeL5tSHvQaFkkAJuEvM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLM5dae3ekwBLHicuaXpPr1cAdHaomPFctRJMgrnA4Eg&oe=6A772D6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QN12MiZW-oQ7kNvwFOLaWL&_nc_oc=Adqdf81SagAQgTZOtg62a4CP2oAQkqCtaDGJ1FagswdoJHLOUfhG64joeLmvw4pQIfc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdDJC-LJGD8sU15xUlhyhZHPP2VVGLKVRfvpeP4VhBbA&oe=6A7719F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9TqlwCUfuYQ7kNvwEWfnQ2&_nc_oc=AdptQm-XA5stPBxuUr2QCrYE-ccS2P5pSU560Y52Obgt20djvEFBQUsLrZ5bd5YsWc4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETFq6bgvoT5YN_VxR6I7NSok1hxqLNtVKwtUBsESDE8g&oe=6A772040"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vncQXjxavNAQ7kNvwGSsLEr&_nc_oc=AdrPckDcILx0sPcIJD_TVjRvY23dA-XhRmnkqVNim-tkFeHg80w4EZRXKreN4IEQa0U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3XrBiBQeU6BjhbeR60zXstl32Q6HyZZAPIJAImZugxA&oe=6A771
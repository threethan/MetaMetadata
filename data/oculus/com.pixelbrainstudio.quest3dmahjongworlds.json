cdn.com&_nc_ss=7f20f&oh=00_Af77cgA2N9jWumRCmSvj2HaTDsgha6LqtBR1NUkeubfDWA&oe=6A05DD4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fZ0DxVUasMQ7kNvwFXIKmN&_nc_oc=AdrYW2AdskDK4ToTL0Yiar058pTIa8m7Bs9e6dGIZC4ONwfdsRETzzbTLWOjnIqcues&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71yb0CzqtZuUVh7we7Sse8cjh6N5k6-IHu933ICelxLg&oe=6A05BC61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wgqx9RX_EZ4Q7kNvwEbCM_n&_nc_oc=AdrRMHQGfzkm-VAxbmIeQUkdm2ipEn75Zcxq8OiUJ9O_vN3jfEsp32Cs3w2aHYwpYFw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IrE39nJ3HZwskRZoVeXkFBHcbL9wH4FEBDaOlIzRHHg&oe=6A05EF5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7YMXdPGwqoQ7kNvwE69Oh0&_nc_oc=AdqTxtmCbUyg7qibOegZJTF5I_Oa9unZvjwHzgcLq4Q7vcX4qr0N7nz3S_S9ylWybow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kAr9WkuXrQfSSqEWLJeySGRQMebf36YDX6C7zTHV2mw&oe=6A05CC6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzbE4Lu2RZQQ7kNvwG2HD36&_nc_oc=AdqQBS9f4I4QRtNtrRuaRxv1Cq7YZ_cy286HC9enpk7I_2NdHAyZ1KdU6KmrOEvYwzw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51jKg1FX-YLesAEJOaai4cpRMtrf7oMJICgYQG8chFbA&oe=6A05B8F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQiIH0qVamsQ7kNvwEb7Fa8&_nc_oc=Adq35nI2C8vfIJvi74bl8c4GWmYlDojY6jKf45YoQv4kzsKn7sl3RK3CNDUue5ozUPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40MgTEgE2EY1TGXAkq-EnrA51Nql9Be1aCbUTYUT9olQ&oe=6A05BF40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EogkvEXIbokQ7kNvwFR0-QJ&_nc_oc=AdpqsejRnst1lq_h41DnLFvHdB59DVm3FZJONLqG-VSIOoFdk83Za6jgxC1hNyCoc5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75FuEvTRtJTSoPewpR3bGPQRXASYoypQDVvUAPrPRIuw&oe=6A05E
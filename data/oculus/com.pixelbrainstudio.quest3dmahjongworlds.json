cdn.com&_nc_ss=7a30f&oh=00_Af0L5xfhLAAQIUDy0du-vErU5fmXT1BKPHVCsuJY3pb_xQ&oe=69EE224E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLyUJlhc95cQ7kNvwGuIIsm&_nc_oc=AdqyGk_GdbRrETQzuTkTIQFt3zzhOcUcKwfTo09kxHfB4DnqaOr2-HgoOBSlusPE6NE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pDl5YDAr5vUp8L5zrYwILf4B_Iia1UcdoS8Pp6T8HEA&oe=69EE0161"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8jYk1jAEEkQ7kNvwE260Km&_nc_oc=Adojtrd6qe3uxBvsVM8zauBgMJqlxgMaYDkigKXcAo3lj4xb3fKSR8er8QcowBF8WPQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0R6PGobFAPR-wbo-MsiiiJN6CmabvnUSnXmnCAJAZ8Cg&oe=69EDFC1D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAjOK4DEaOEQ7kNvwFDK3Kk&_nc_oc=Adpvp431GrntsXRLdD7E_s4ySfnOm_YkL6y09FGNQ8VRmC4-w3mPtRGYyJtMls9pmbg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ovbPG26qtPDLpax_4b8N4HvjzlpcV6FXRO4NzwvW5TQ&oe=69EE116B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WX4toDyY5AQ7kNvwFheLKQ&_nc_oc=Adpl3veBqq6eKSiDEilDDVI-5su6rVMRgE7DKszsLuaBVWBiW1e7KKA6t8XBNPnKMeY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ROXPiBZNgkv9-UW2B22U3TW1GO7T7lp79e2ZdAsxtew&oe=69EDFDF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYVuV_H7d18Q7kNvwGUf2d4&_nc_oc=Adr_5S8_6tKI_DKCdTafNy9FtujJ2fJr8mVWT7i0TVPTAQJnLYMCmP2KdJiGpQuhiio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28HoG-uXkargwvLfEQDLC2Ax2p6IeJhC-EKAFH0u51gg&oe=69EE0440"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNcc1cOZY5IQ7kNvwFFpSyk&_nc_oc=Ado-C-4QwfzzvxmyPSEoU4P0PRJm-YbcHA24nTcItKHJ1ad9C01xTnG_4gEqWKRq_ZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05jZDTDgz4U7AqNEBGnJFOsrIRC7rZqmuywRcM9Ti3Yg&oe=69EDF
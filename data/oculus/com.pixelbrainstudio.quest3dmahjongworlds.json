cdn.com&_nc_ss=7f20f&oh=00_Af6Hy0yH8kGscRbdR_m7ypAm5NlCNbY1Vqdt6hOtgBwkBQ&oe=6A19A3CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7bEvpCEfBIQ7kNvwEflKDU&_nc_oc=Adqgnc5iquJUrXV6LtofhfJ2NXcETYxdDTsAVtBIWjm1CMHpk5Useb24Doy2CXDJbLw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x1Obgr2si0J7M8zAfK2O4dx4z4eahbqW4gvRzi-LwyQ&oe=6A19BB21"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEgfCyvxgEkQ7kNvwF7t9VI&_nc_oc=Adrcq-4od2Dozxzp2-y4wkxo2v0LlQK9t5JPcyKx_ARMyjIPPwqN1RrKL4GIdlr8nB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QSY97mbyyyXGlUlH0zdslIvhWQQqJ4BH9YYx-i4EM2A&oe=6A19B5DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXp9EOPHxH0Q7kNvwHhNVFl&_nc_oc=AdrHKH0k0zhghfg8W5J_TKb-yHo3YyVVH2nAdYgWywkGgwcBZswBvxzX2WJOhQC0yKc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vKaofHX8yfPbzmvm8ihI46rO_wDhZ4R2NaBLDkX5dBQ&oe=6A1992EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJTFVLjt0VsQ7kNvwG0FSh-&_nc_oc=AdogNCtSin0ag8TqNthmtySxl7tmfP91nlFgNDPllknrUDJ7oMAyXi4VSIZGWq65KJc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6J1B-nCpl0dTgRSOfvntOfhEUGDornnV78xkFO96S6PQ&oe=6A19B7B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUqfwHovJTsQ7kNvwE4MKR9&_nc_oc=Ado9UYZZg-7pvUOLrjaheBkKUzh7mGbvTsNeYN2nKd0004jeCMvkwGFKtGNoJ8yk1XU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aMKXHba0Wmsw9ge-l6OKW_YOsrTrplFZ3QfZzirtBRg&oe=6A19BE00"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvTfpEE7AaMQ7kNvwEozHnv&_nc_oc=Adpm3DueTbd4UCH0E0afIgN7-XGpz-6lI_ce3m6DV1tsBEZt_UgR-V6uxO5uDARA7UE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c1plerVtdaFKSmnH_OiuD70p_fFwVUhPCmaAzSsl3ww&oe=6A19A
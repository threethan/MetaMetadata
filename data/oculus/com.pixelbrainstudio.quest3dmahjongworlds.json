cdn.com&_nc_ss=7f20f&oh=00_Af9HtqFpBhNd6y4jY_sUc8dbwld8BOGx-HxL-jjGFif22Q&oe=6A32B04E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alapyXUuwJoQ7kNvwHOQd22&_nc_oc=Adq78f_iorGl0K4LPBEs6mVmE7fVQtAnNBhVvom6_kS0krfM-_qbQGZSYK8VVW8g34I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OCg4RnKHiHX4VoaFXtqunjSSLF7083pKoA2ynqvDqtQ&oe=6A32C7A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1UqJ_reJHcQ7kNvwE-ag1N&_nc_oc=AdqYWC2CGoEo4q7MxuM0OjX3ZCm7_mMwJpl-jD6KJTEOMNmYbB2A2R1t4PsFg3mdIbc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w7UG725mn7GCOGvqWg0BI3qQsnl3EscxJ2oM3ZpJA2w&oe=6A32C25D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KyqzMs2TgoQ7kNvwFqMKZK&_nc_oc=Adoa4ZysFfrcOwDXif_MFa4EMU8gVC08jTwFBkSlww4tt2IIfkn4V-9Kfz7caqJUfMs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qeuDzHJCfHdDnqtWC_49I0ksUAEXFB8EFz_-1666FiQ&oe=6A329F6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGzo9HNcAfIQ7kNvwGrhD0L&_nc_oc=AdqV4SbjtzvD1eO0LBqf1v9bB4B1xvKo_0SbXOgCZZcz63Cdqs4_m1H4dr2YIqJLqIk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Glon0hOGH7CfNPJQb2VkveWQpZaNf4zXmk_4zjgKQgQ&oe=6A32C432"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8awi7OIbn8Q7kNvwE6Sx32&_nc_oc=AdoYpBmqFBIU2Kt_N9aO4dpbMRN9Kbdww9hUq7z4S-M90mp2Wk461k2NeKf-JO-z6j4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LD-0Umx18qHk96nxG9Q8r8VWcQAvwvKd6-N4l0kOrZQ&oe=6A329240"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmxxYYWhsasQ7kNvwGh97uA&_nc_oc=AdphI7FY1Dn-NKh5-Gs6LU1XgIo_C2b9cN27TUo1KXTuE50MigW43hZBmLVt0c_HhxY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YpVAHotDD6GcHvuYPx3N6d1ib4fqBTMkSRCW8S9XHMw&oe=6A32B
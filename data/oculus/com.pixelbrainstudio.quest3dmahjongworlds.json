uluscdn.com&_nc_ss=7f20f&oh=00_Af-0KQtuY8apYmFtauN-kRA-lv4jSqypwV_w6oIXT44Cxw&oe=6A22DE4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXx7_bY2DQoQ7kNvwGESjho&_nc_oc=AdpopyNbvfW1UnYrnvIUwkKHeffR0orqgpb8EPTL2YYLj3hLpvII0WWeDrGb5Kny3GA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9COQDVM_F3_2AmNUde1xHU7NSVQzbhopwmhwCl8Jyj0Q&oe=6A22F5A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9L2e5hMv4q8Q7kNvwFn_sEs&_nc_oc=AdrTPg2godAItij836fM6zw_CFy5kzUw0bVqaCvt3zIBD2tIVI9mJccD5lt7rj4ge6I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AuQ1Rteca-0jx9o0n0VD7QkQ2k-OmDDPXa6A9OgLh4A&oe=6A22F05D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3fXomFA9agQ7kNvwHDMp5S&_nc_oc=AdoOwBJY4vVlCiU_YrTZnGfeiREAmYcQ1PmpEZuoN-nQjC6ETyfF-G6iSZEh4oGFpTA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HlIwlBTWVCMM6VqU25TSXTS8hejB7Jonk8R9dm02GLw&oe=6A22CD6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTjQXiZWsMEQ7kNvwEvWyE1&_nc_oc=Ado-njhBW1XTBlObx5I0yWuTd5W2Pj-kSTmJ0TZD_8IvXFyVEI319gHArchgm3Jq9tg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_phvoaEdCbizP1v8RMIrpg7BDwfL-OlicQT212EdGG_w&oe=6A22F232"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gobfmHC9G8MQ7kNvwHCdu1m&_nc_oc=AdoEtIeA2u_2VQcLZ3LSfFKha97FnkhnYcAY27PkDwVPYEyPP0rnCv9-Rjx1mWTL50g&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G6sJeEsivCL8uP-UJnJsNREDpblN7cm0ocdFPkoF2YA&oe=6A22F880"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVGZZUzLPnsQ7kNvwGY18Ct&_nc_oc=AdqRcWifjIxOigSAP9ho0yXgO59gbXomISrL_lxInnCsP-ZVu0xbX6oR79X2UKa9lOM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CD6a4OKkWBqLcgAu-Vru02ftfakY_nJdWUEV_Ld8rtQ&oe
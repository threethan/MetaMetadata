uluscdn.com&_nc_ss=7f20f&oh=00_AQLK1i03PaZ3FcBzRPIMs7egAvT0CPN-R_AkLVAR75E0Jg&oe=6AA4114E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDFvSBPJmL4Q7kNvwFcSN2b&_nc_oc=AdociJEJ6FErGzvFlomSLAouFp1Dss_meBvi250hD4vZpI4-i0Iattng_ul3nRdGdvU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp_WXCS93C-4OlS5MpZjYmZtTczVhr-DUx9YUPHmtBfA&oe=6AA3F061"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBFOjtZowkwQ7kNvwE5ykoD&_nc_oc=Adre-0zkba5ArytrOpGZ7_kd83V_CZc2HM73ltg10ME2g7gBb2SUGua9ri_JxztjsQA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5nY6jpd83zksuGGcEG_QLq0YFtu3Rh0r_PtWrMjd-Ag&oe=6AA4235D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ep64OBlfPvAQ7kNvwGOcBTR&_nc_oc=AdpptufHHl-jW-m8IMdlpN2yTrPkct0KUuFn_Bp1lQV0X0ZmEPh2UFpyYaJCOUnoFuo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZKjAaKrrlRt92dR9HRhNDOJYIAqT0BzTZzZkz1yq8fw&oe=6AA4006B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gShWA30oN4MQ7kNvwGu1d6V&_nc_oc=Ado-XCTZ1to-xYVyvwuwi1DvuOl6mWXrsP2LlOKaT18dRrkJFd8qaO7saMaa563VWsc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-2L_jPB1NxdbdA4gEahwkf8PnNWqm-PtzHfF66grZnw&oe=6AA3ECF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9Kpaglxe4MQ7kNvwHuyeD2&_nc_oc=AdpL_2pKsyWYIMP3HaItUnFfOcTsxz1U0X1TAaoBIBsUpTkHnVNaMlOqT7SPAT5Jexs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFI4oo4CtuEp1DHu7EW9ZTcpXFO8MzSX2gsbwRU5srnQ&oe=6AA3F340"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiWaXVFlCgEQ7kNvwG-ngpc&_nc_oc=AdpGKHsH3RUg101OvPGHTX1GGIcAsj2Kc0wzWAoGBzKYYiRDPC8Snr-LdeivhgoMNV0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6ARKlL9_8WMTWxG52sB6FPStvWbI0ZsvdE_2tOS_3iw&oe
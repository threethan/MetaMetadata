cdn.com&_nc_ss=7a30f&oh=00_Af32o1xWafUcsiZ30bbYFXXcovIIGYI9Quqx7mamlm66QQ&oe=69D90A4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRj3VCto2Q4Q7kNvwHpQSMK&_nc_oc=AdrBl8tAYu-9iU7GtomBK1XcXM3FIjmK6ddVGxSOpVNLNhmRJrB35qJfZWphsjmDLxk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0u6hnKS7aGMAiSdeBtWi8xEZN-SMaVHbbBN_CG4cChiQ&oe=69D8E961"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Be-zpcNqs4cQ7kNvwF8x2R0&_nc_oc=Adpp093nM5FhtOgaQ0IfbobDxPF8ZKE2kjM9asunia7P4GEhhOgOwL6QVz_EULhkRhM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0G1BubDj4YSMS9i7gInAILPgyYz6j_umb74qSZPkNvpw&oe=69D8E41D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxYjlqsyoFgQ7kNvwFvvSP4&_nc_oc=AdrCUgeRrl79_Z-W5z76l8xMcVewAAVKwJLLZKXzME8wZug-NAiEoBQ-dCq9_nT5_z4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0D-XJTeCUwm3iPUHVHlTwFgB_En1DdoahanOtchzkxoA&oe=69D8F96B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjZf-fcmpQ4Q7kNvwG0nBht&_nc_oc=Adre59t6KF7_wZECRVEsmT4hGFsVOJNC9cFmFGruigN7gnMdXEJdkslPADDHhHI85eg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NatyoEMXnVLzWJ33Yv3NB8yn4IvEfI1OpmWgVx6Ul0A&oe=69D8E5F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkksy7OR_H0Q7kNvwHnNYRV&_nc_oc=Adp0xKwVnVSRzkLhcTwlH9CmUCzcx2z9CctpBFn9aqb7FosB91EfwEWi7ZzMsydPKTE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LrzWr5jYkWNfKii4p7dPGloOiVHHRR-aMtjpoMc8asA&oe=69D8EC40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebRGnHuMK4MQ7kNvwEVWmhB&_nc_oc=AdosIcSa7r4s9Us9R8rRIyCSJk0ynHIdkt2pg6nwwliNPg4ePrzmE5b8KVcBkTO2tNc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YHKwfUN0hcVFN6i8yO9bytUtAAUNZ3ckwRQhrKHRODQ&oe=69D8D
cdn.com&_nc_ss=7f20f&oh=00_AQG6kU41tsgrHa12vE7lUpTV5C6c9JstabapQNnsHLd-_w&oe=6A79E14E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmlcqzIJ8ikQ7kNvwFWSP2s&_nc_oc=Ado2hjQ0y1i7rlCC6X95hOnV5z3Rl3Ejb743y0D0ajI9vxJ8KKpLk8HiuUXnQQTNhPQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYw7sFcNDOH4EHaADOXCQzFcmG0pKCgbxwbqkj_AnHPA&oe=6A79C061"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8b415PfSqAQ7kNvwEgfewv&_nc_oc=AdoUfwAPlugQ_69HmZt1O5-4hriw-Oo8wNF-BoRwW-EFuDN7XvtWrDD50fE-dReyK_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNb9kUSpEsVyfbg9y_0lfGu_9fsLOltLILC2zhKx1vCw&oe=6A79BB1D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOF19bMLoe0Q7kNvwFlN88i&_nc_oc=AdrM7unsJoXAQNpcsR2DwrkaP7hOQk3OM_n9CzrQu7XvAxKdph6I854gj5o2FfJFgog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5ulJ_E_X6OpRCRszGujWGVctvPMQhUgo9HD__sWSmUQ&oe=6A79D06B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZzqnRV7QQAQ7kNvwGG7SpF&_nc_oc=AdqTyur2xhvZaDtfzKg7Hpe0CD7ZOjbR1Xmds_02fHjDpr3icq2M5fF8xIv1fbB9Cis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCDvKDr7Qnv52RsZvHjOWrSgw_rysdwNL_61P7oU5K1w&oe=6A79BCF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9TqlwCUfuYQ7kNvwGHGcN5&_nc_oc=AdrA3SPeRKQ9st2fBRAl2PIb_UU_ozVJeyshqNpujCUm6CAdzU46nBYV1qbvZUJXKjM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBv1BXr34tgomX0QkL2yJr1vDJZ8AHkK2S6dnHxP_IJQ&oe=6A79C340"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpbwKDW8ZEgQ7kNvwFN93Hc&_nc_oc=Adp1oqkj6NBDetR_8SBrKMj8GeuZUQ0czua4pq_YV7baI5WWkGT9IfdLJr8E9PcKuWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2uJkCl86HBLqIm3NzJLvVGpA6sCerJPKGtZ8p7Q2e_Q&oe=6A79B
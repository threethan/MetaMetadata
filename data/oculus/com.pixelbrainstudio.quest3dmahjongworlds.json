cdn.com&_nc_ss=7a30f&oh=00_Af0PbLPqCMr3iZrSMFww2XuakhUAm5wYdORZ_2Vs1C7aaQ&oe=69DFA1CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsm7yYF-2xwQ7kNvwHgeDYE&_nc_oc=AdqddTpuGo3TPgaZPlX2fD9YCeCzCov9tM07ZZ8xRlPXukSRTY71gN1VjzldEC62G9c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2z5mhiflwa9MqXGDHLaoFAEuXYvSuI2mLHJGlhJuCXdg&oe=69DF80E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qL_-_ZMdvYUQ7kNvwGW_kOL&_nc_oc=AdrsBMpgAzO8_nZWTXGBZqbK8ja9aWp9rJxmvslVPInYrzTZu5JFQ9oXxM0NNZdHT7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36yFUNFroiDCAsMVHun-5Lw45-_bmvKP2D1fTan0XM3w&oe=69DF7B9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BdQ5xUk4YUQ7kNvwHCQrBq&_nc_oc=Adp2MhxNslfUVaoz03d8AJc3Djl0bTZFkClh4iYmim_f1jKjiRdV_tF44GkGNb7C86Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qd2AJa2rA8nub0oJB3fm415FIcq_y9I1YYglAG1MrOQ&oe=69DF90EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrFep1zGkj8Q7kNvwHkGmup&_nc_oc=AdqT711PoVyBP5-zAACY9zrm601PfON9Zvw-3ZM9dr-vL0yqqEMnGzzElxaghUSYVtI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dPDTuxeNYRPNNntfUMIPksosRh5myVYngAhL8MMYStw&oe=69DF7D72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXQ3Uu6D3SIQ7kNvwEXrUA1&_nc_oc=AdrbbN-PX697ynPZwZpDPJafrPI_LhEF-or8YEv7QigHW5Zy_FnQPTxRvv5WVs6RT38&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AM8UqhWALYnIeJBi-ndreOqx37xLTMtEcxISqanrZSQ&oe=69DF83C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot_EBpmhUYkQ7kNvwGBp0gl&_nc_oc=AdpHWRiDQFOOp-spoerG_fEHZniuexMVkYX5uMpnFIMLvmbfdVNf4x0KDupDMg8ke8s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1G1KzJkyMxs4xzN6C83Fos9CQdMUDTP2Mx6yIniquQFQ&oe=69DF7
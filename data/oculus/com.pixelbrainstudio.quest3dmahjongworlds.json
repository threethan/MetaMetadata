cdn.com&_nc_ss=7f20f&oh=00_AQCWQx3y2VA1VmaDfOH6_IAuio-_FbyTCMUcQjR7SS83pA&oe=6A579A4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBhVltjkyXEQ7kNvwF-8uM5&_nc_oc=Adop7LhDg23qQObMrqdGPLxf-R71DaCDspgyrsxB-d_AZwOlTe0r-gdoeorNkh3ZlnA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlwedtZR6hmVQch1yl4Wuu5Yi87asb57CSjRwcIBqiig&oe=6A577961"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0y6Hw3hbcgQ7kNvwGJfAo3&_nc_oc=AdqPNegTWYNeA5xWhf8Cy60hHkK-ZBG9WYfynBHQqlfAo34Rc8waLdTsWtdCkWHRUeY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCu9EqDXNezoIyXm_eGGDgIKNABSbaLgAMGANNXrAXAPQ&oe=6A57741D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqvicQ6KXHsQ7kNvwEiOmE5&_nc_oc=Adpj_mC88sTC3aSPmpsROFrLchwUczCXQF90TKXQCG_A4FaxcHXYmpRa-SuPh3MFf0M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcGntLlaqsdRBJuhGGu-_JxApyds3DzWns4VO8nns2lw&oe=6A57896B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A431ylAlBfwQ7kNvwHMPnon&_nc_oc=Adp6MtWSyw9ybgdtsVbsOZ9xFs-iwJEGVqqvuR2t7zZ4g-gVH_uMo4gHatNIhopuHfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1_SQSq5r3IuzfQtP8-l5vu9H9UcdLI6nwSIWE7SCNQA&oe=6A5775F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5I9ThnGh_cQ7kNvwHCWp67&_nc_oc=Adre9D0NfhIXMsrB-yUgM0uXi9qzNEchQXXa0ucM0mOag9-86S7_2BNyby5FvWzmXbc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP5usvmpeGDDKlwgKRZ7gWUqoXwS3DnZkddqDm5-7H9Q&oe=6A577C40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pv1R2YVWK8YQ7kNvwGu2XOk&_nc_oc=Adonen3mi4K7IBqTl4McbXrinbb5n9rC7aWTBTMX-3O7YdmNrpDv_R4Cg6BVSG9ExS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtjDLYgwyqH-i0_vsBIcoSTuoEuZqpZgCJHJGIzEXjkw&oe=6A576
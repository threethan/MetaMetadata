cdn.com&_nc_ss=7a30f&oh=00_Af0J5o57cGmqbw86pZOsuvYTLfPpRNic2BupuI0QTQzUqg&oe=69DCFECE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsm7yYF-2xwQ7kNvwGk0kYy&_nc_oc=Adq_PMrxvhCZ2KvjXQdPlc9hNlaKJDTDCfCnCdrSEhN22URLgDrZKdjP7yMNh7LSUh0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HujBEn2dFNtrswFKXMrhbsDDRM6Mha9c5nhFHd2UFVw&oe=69DCDDE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qL_-_ZMdvYUQ7kNvwH0K9lQ&_nc_oc=AdpkFoLvKc9C9fOT1t7eI1BgHThhsAodkopjge0ginHLsA08vRVMHFAmBjCBB_42MDM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J8ItlQFGQNCEGEVtuyQCr6rK1I2Nu2qViSvD_m9n8zg&oe=69DCD89D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BdQ5xUk4YUQ7kNvwGUutoe&_nc_oc=AdoOucP7ExzSFCvhNVMiOklou7jrxCpl6CiwIKacFuUYTxgFtR_r0f8MMkVDllxNzXI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1u82tXd4INAGedZbeR2WlrVKWfkpM1s4NORNXtTqiCGQ&oe=69DCEDEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHJOP8Ol-qQQ7kNvwG292ag&_nc_oc=AdrXVyiDcYcpT9OQTwIkzxV3Tc0LxnagU_0KGKUDqM3wMN5PCKaxeEW3mhmMnYp_bP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-u-41nu4OSsA4xOVAPQC9KvfeqKzlgYEibpvxk45BbA&oe=69DCDA72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXQ3Uu6D3SIQ7kNvwHOUiS2&_nc_oc=Adp4A5SLSuW7jZG4a4u562ySwMCxoNxwZk6xTbp1f4R6vh4rs9VPJkGGdnhjlSRvTzM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af221quUbaZr7vRwvivam1rN916OB_VvRQYCpBQowPlBtA&oe=69DCE0C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-TsS5xD_VEQ7kNvwGzU4Vm&_nc_oc=AdqAPUy3kcKbOUpvz1oUCV57HKL6uRJYLpf7ur5Q5VT1jX97xeFArvUvyEZM_QhrMkg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Bl2dXVWhOlNoTeeRhma-0noLpJBQIECI1lGLfiRxt-w&oe=69DCD
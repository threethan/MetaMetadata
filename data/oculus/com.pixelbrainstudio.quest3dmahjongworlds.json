cdn.com&_nc_ss=7f20f&oh=00_AQCwUDrExWfRaKCbkEjKhBMR9O2UI40oQ-6NiJliyikOVQ&oe=6A6F554E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOANId5pJ58Q7kNvwGrZdxr&_nc_oc=AdqyBh17Mc_l5c_m580GgXCoEJEw_Djqd9SL1STEf-uOkdJnmQuqFOOmXpAdZKIZV5A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3EkSafuoSSNzXKTS8ExsDsCwHBeoYjRfZCgNz4VM6Ng&oe=6A6F3461"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMgE0AXj3HAQ7kNvwGP5IVj&_nc_oc=AdopgthXPfOfkhqrFlDp4ESgGKJVI4gTDaskuu2sFoogAmb4T1GATI2lX9BTjPFNrZ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiKR01kcxBPwqPPRSTiS8iJNV5HJcvHEB8rR49dGQTZg&oe=6A6F2F1D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzV_OcIeEtMQ7kNvwEt7QjD&_nc_oc=AdpJZDuhEuKe4X9zdoy9bMr9D0Og1l0-V5RRyimQJnmW0ArY3TR3M8NzRzgzUydDN70&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm3PwgPPhJJypcNXiv6Fbk2ZQuSiFch7N7pHw9Nj9tqw&oe=6A6F446B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kk5DlXBlJWoQ7kNvwE-MnhE&_nc_oc=AdqkIeAII7wguIU8CUG1TYmt86r5SwSzIygt8M4XQfc5kdtri_AQdZ03nU1yR0xFUA8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPR7u9f8ocoonxi-8YOxB6rE_FdquHEzxCnfcQtnjxhQ&oe=6A6F30F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_cpoa4QcfAQ7kNvwHmwwVY&_nc_oc=AdqURetZS1idyvVic38xE-rhBQG-WoIUqXpWQxRwUQyRXbv76MARf3TrOHTBk9GeqVg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmVKjibl5Ak_aAQ_SBja9Ulbm6HT0_d92n7szWRfSmgQ&oe=6A6F3740"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fieDBTldW8EQ7kNvwHyIbyx&_nc_oc=AdrnZltKCn7-UgCiY7MwdDUOe5W2-jxifjTgK4d7U-IHCnP8FFLorONaLPoME3n34eA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADFus5_QBO3YByPu3K4eXX9tIoaUeQ6HQDTF_rSLlkvQ&oe=6A6F2
cdn.com&_nc_ss=7f20f&oh=00_AQCjwbXf0P9xBNwUCUihJQdAKP6Z4OtGV9zPsMDlU7m9qQ&oe=6A4919CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SRwg6okPPAQ7kNvwGLbjKN&_nc_oc=AdqIqFKBd2y580CuERSqb8Idq8Z04BXWD6NF4TTFKGQI0Yliw8Kkkf_g3otGUa-CO9M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYqtM4PKERRNaa1Wy1lVjqPeIVemKovbUg3CbDrtfA2A&oe=6A48F8E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIuY2p-ligkQ7kNvwG2elQ0&_nc_oc=AdoozJD3Q6SBx7QDeNdC_uEeACQ4baM8fktMotc3ylZ-jzIjeMwcCJluQX_SF5Rje0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGDeJ0YkfwuUHu0GIMyDnQ20-uUlWMLKvKWvnNSXOIwQ&oe=6A492BDD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGl4lhyt27IQ7kNvwGthNpi&_nc_oc=AdovaJb968t9EwnJfOCREhC0Pjna6P7PTrqno_tDlPKBx4ArPv_t_8ncDX2i08UVKik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6T4UBcjPIlwnWnlkSanaMx9bT0l79tMZdjYOOtsgG7A&oe=6A4908EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3VSp9JWf_oQ7kNvwFm1TXC&_nc_oc=AdrTgeg1TDvLj7jwmgdoHoTk49bo4XSGRjEcpXn2cPGyg_qzugGXjlHarYgxjlNpQrc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmcn2fJw-qIDk43XyoiH0th9-ebSRgIcRd9Sv4_CCq-A&oe=6A492DB2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aV7O500V7EcQ7kNvwFp-ic3&_nc_oc=Adq3kA_aCGh33j2GKHQLFBkam7gJOHHFU7KB82_mKSZV7fkzQoD9r8rhrYgOdiJrb9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA64ag-Oel_Q4FmKF-t8da-f53DhJvVapWO96JlBZX7Zw&oe=6A48FBC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeYa5Ht-0DMQ7kNvwHS1b12&_nc_oc=AdpFiFplc5lUOkAc55stjBd6h7GJlQSxbMZ1mVUw8lBqbOuGnatxPO2IGCd0nZ61zqY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKVnUgpOWp91yVUFx8mqrHnUMr_nUZ15DLgSISfG9YKw&oe=6A492
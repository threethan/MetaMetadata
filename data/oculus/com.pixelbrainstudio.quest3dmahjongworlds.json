.com&_nc_ss=7f20f&oh=00_AQM3cT9JLxB_dxMD_rPhdrXSRXlKXdG6AvuIzAy0j6rb-w&oe=6ADF64CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0gr_52PnKkQ7kNvwFaufBY&_nc_oc=AdocWA4E4ToNmgpO7Efrcb_4vrYe3nJoNN2dpB0ECihvvBKJ8BAXxEFFBP83RWxSLRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1Hm9TIPfuqcj99ZOuoyiRLiX2kNRFvgvgS081stTDkg&oe=6ADF43E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18QUFunrH3IQ7kNvwE4LnUM&_nc_oc=Adp1jx5sfVkH0EUBZ84wvxiU4g9ckCVotG3k4Hmxy7VJbtV61Z-ND0ozzQYNLHFhTsU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOY0fv5A90Na2j04jSIqLGcQdVxRR9kwaIWrWA3ucmu_A&oe=6ADF76DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa6UDvZCwgMQ7kNvwHVGr5S&_nc_oc=Adq3w-ZogYouu7gYzF1yNOkKPtcMp5crfGAxn49fz1ULWB4Gi57Sn70zIvIUkf_Gw5Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQ6mMMNI8H485Yjfmr7sQVD95YxJTQQakVpJ8vBRoPrg&oe=6ADF53EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDWKBdosipsQ7kNvwFg4pwS&_nc_oc=Adqsu6XNtkvf6yCbEQTQ9d7vJDXh5QhuHcUElNVJ9AvyQ4KaBKyIIuJaWMwAnXOisVo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAcN1X-msZhlQnYryQgtI_mZkT-cx_nJTMTvkVtpYEug&oe=6ADF78B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDwzDW2VODQQ7kNvwGkGMqc&_nc_oc=AdqeLbeevkAcZ9ml9SO4jGIquoj0EFZGtmhY6cz8-fo-rQpXE1tM2-W_B1oMTfca330&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOgty5yd-Rfk-J1k2rx5D7LO8ytFPCrN82_J_GuDNahQ&oe=6ADF46C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIT25guW4ZkQ7kNvwGLhqLC&_nc_oc=AdrSC2LOCFe_QJ4aL5ajyLon1qmch9Si04-vb0yzwF9a2IkaxNWEcAAwMEj7Cl_k3g0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFau9ZbPaGweLvjzlr8X9KAKXFIZ-35fPt3FtKaAan_Q&oe=6ADF6FAB
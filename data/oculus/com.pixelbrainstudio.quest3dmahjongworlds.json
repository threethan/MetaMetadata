cdn.com&_nc_ss=7f20f&oh=00_Af7XIAMNRnu8Et6dS813d-RxScVb-PAt08iOsSn2PzMZLQ&oe=6A0B234E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfViV4PYQ_kQ7kNvwGpjvGj&_nc_oc=Adp6U4yVQoe4bUAwW-_zyPi9HjMf31nOak1Y8_giqvq0NIIstEi-BfoZUl81A46vFa4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xtBbZR_LMQSkvct-Ue2zBes4AVXiinGk8qnZwqHCJlg&oe=6A0B0261"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiPiGkDQJNMQ7kNvwGdNGGY&_nc_oc=AdpYQY2_X7H5N-jMvT3pVqAEiD-vug-NNKRQYLQI6LxG4TlIkhrtcXJt2fnp9j_ScR8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6emdqaJGvu95JoH9MKsy97rNyLpOQzjvIHnrFA1M-OFw&oe=6A0B355D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2c_x4zVEXsQ7kNvwE3CT20&_nc_oc=AdqceYsmEq7btKQqMzZ4pLWhGFCGqbaz3e5ypAKAK2cHBkw3M04SwP8Qq4oF6yLlfSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73Zy1Es1E79LT86pLHxvktI5wawXgeeM0eOkJ64eg_Kg&oe=6A0B126B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOsCtJtEP-0Q7kNvwHJd0T-&_nc_oc=AdrXOaK07KzbHdE578sTPp1_yBD9iwfJpqWG4zCZc0FCIJyZMy37YIU_qJc4dfE0KBY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YOXbEGmQTj0I4tlGV2vnWpw-PkgjdnlJy4I65nBCzdw&oe=6A0AFEF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UwlwloEvEkQ7kNvwEtrLvm&_nc_oc=Adq9xGzEr4Hd3Ah8Suon361wWzERJBBVsq2Ff50dGrMns_pM-YEj8DKp0zXaZYvJCTw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uwaa-Ld_EuFHbU7q4kCXT7NLfhxKDvAe9DCDrJ7H5FA&oe=6A0B0540"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izWsr4wlHGgQ7kNvwEKv645&_nc_oc=Adq_F7mKECND6FqX6SDKhfS_9N5ieC9Gt79Eoqlb4qB7iOhHktN6bBwdmtiSJGd2tTA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Kd8PBJacN4XNH_E_3KykGvf4w5HGIVQCPFqpO4W5jQA&oe=6A0B2
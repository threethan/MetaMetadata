cdn.com&_nc_ss=7f20f&oh=00_AQIM6CaAHUUpbC6bBMzh8b8QZy6wj032-Evv6fGg_w3_DQ&oe=6AB3E34E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC-dN7rj9h4Q7kNvwHf5OUI&_nc_oc=AdrwwetvMb-dZoPvMkn_0VKC4bKWsDukIf1T-1FKRMElKLveFq0LaGU7z6Bc61pYu-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_j9Q8LGHM-BNvdO-UHQ5sf1tPhvgen-KlO64F8yI2Iw&oe=6AB3C261"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvIHXKGbV2AQ7kNvwFPoxua&_nc_oc=AdqfHKQOcbCEhspv7c9-DE8NOyYENCZggRwY9znVZ8wU2fSukse-pRP3AOA0D6EQ-Eo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpOnyrLkiSmeWWU_-BDF0SPs8J2uZHVMAfMTAHInbZtQ&oe=6AB3F55D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UOfXxia950Q7kNvwGiDw6i&_nc_oc=AdptvKdBKWf_T5Lr3B13yoEusBxQjWzUTCcLL93MtJXeKMqlGTXdqSy8dukvMFnrE8E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4pLlZN2WewQq5rFP_aG7e6OoI-S7MorMwZcQi71DJjg&oe=6AB3D26B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qzKp3f2XDQQ7kNvwHHEtG2&_nc_oc=AdpU1aaNZI6M4PsfDUDja-Xoan4ITeN7q95yVUcyB9tLcD8YosjkTF2x-AbMAyt1JGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1nRW9mQ4S8L0VpY2xTQBdoUyEMohEeUHw6Z5waCNUBA&oe=6AB3F732"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ojbgf_CcZ4Q7kNvwEcR_c_&_nc_oc=Adq2X-E6wazfUMWLwfsH73id7RgcLBhPvjfj5mzDmA4Zq5lGprzEIL77pdpK8FgqEmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoiKqmwkyEXrR7nL-Sgu3LnlEF4y2ZdIwMhP-kGIuhcw&oe=6AB3C540"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln-c-SbLdaoQ7kNvwFsYrAo&_nc_oc=AdpsBzP64GFRFRO1XmCIOlEmqfgfKr1Bk7FshABMX8d8E9Q4CPin0mDAe0RE1Wg1PBo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYbStFCNft6BBil2cJqi1L2jKJiLvbgcw_-ooWzmT8rg&oe=6AB3E
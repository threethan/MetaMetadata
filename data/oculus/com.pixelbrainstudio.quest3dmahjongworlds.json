cdn.com&_nc_ss=7f20f&oh=00_AQCTkHz0TWPwAiJqPZqD9BeymY6eumxHkMb85aP8dg2-sw&oe=6A5B8ECE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY4Cepup_4QQ7kNvwF_f5rS&_nc_oc=AdqmVGjh9wMEggB2M92yqmtuhQOnMeQRgklGdwxyvHL_ZZJTLbddxTf7O7Acsq52iSU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRjSYCFKW0N-WW_DTjxMNuPY7hbEB7-5UVDOU723MgaA&oe=6A5B6DE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSIsjON33ysQ7kNvwE97Of8&_nc_oc=AdqZTRCvHjjCa4NGOI4xdk0ZxenxvD7DvteY4T0zB4VfBZaomuN-kksOdhETfd2gsiU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvw81BRf3Jgi0UMHhrROKol82fKcvHgflQQd7g5k21yQ&oe=6A5B689D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SttWHxO1hAQ7kNvwEv68uJ&_nc_oc=Adqks6AUVI31MCHLQyqYIbs_TjmcldrkR6ySCPqDzRrCGxDLW2FaKwzinH__c6uKz2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiYkEEN0YZecqPZwbV48j1ISbVp_LcauFqujvWilWiDQ&oe=6A5B7DEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7-A9hE0ktYQ7kNvwE1e84M&_nc_oc=Adobb8WP9Ckcj4iVfo-Pn8UNU446sZwI8yZyUejf5KwoyrGjq0UnuS6nQkYS5NME37g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe4Uyx8UGUbxuJL-ZpiNZL9HgHUgNNtwspVsD7SVVQHQ&oe=6A5B6A72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dS16V9iSKUQ7kNvwEpMjl5&_nc_oc=AdoCmJlB1GFRFKijScYETit12NgYVrF9EbMOniESX-Wd6uf0oxNzmrBShVKYMRydftM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_XeEcXaFTn3JOpD10KRUY7QI_d9JJRHBmft5TTqjgvg&oe=6A5B70C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoy2FF9KoagQ7kNvwGPOP5g&_nc_oc=AdqWoHaBY3Q2oErQ3IoxriEvj6890cXUs3MIdHhsLA3xJ-l_FIcrmw5cxkoNwP3twdk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6jvUDZqqHl_vKDYysw_E8iZ5yWABEGTMvQmCVpIXHWg&oe=6A5B6
cdn.com&_nc_ss=7f20f&oh=00_AQEpvhQSyeREMNfhTe_hjM9vBdSEl3UkhMrZwSAe4R_tMw&oe=6A7C4C0E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rbftLgOL8kQ7kNvwGKKWHs&_nc_oc=AdqPR4ePiLAX7mKyq25I2o7_W-MUDTFc03QBXs2ZzHt51-03rEMUChgFJtq17uhrP5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrg8lIFC_wYGGuIRPY2HQN9KWJ2_cP2LhRGBTIsCXlhA&oe=6A7C6361"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQgjXwuzpcAQ7kNvwFywzwI&_nc_oc=AdrrR_1YVtZ43JuWZzFCMTjYg7KyFRQZKJNtwtt8JVTyUf6hWKlHcXZuBSIArU7th-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOOKzzaL6EpTK4BQntvMlsNjyc3vFcmENSsyGL8eohTw&oe=6A7C5E1D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QO3-YKA9gYQ7kNvwFZkyDj&_nc_oc=Adq2ZghLfiuzeSlvVHBqLbBIbR4XQbpz6-1gfrkVHaWSfskidJjTEUXI5RT6KQXkY5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjks2IKCRFzqyukMV6xX0ttTascBZyfvRyOBmrjyi1iQ&oe=6A7C736B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZzqnRV7QQAQ7kNvwEjimjE&_nc_oc=Adripp6j4CGTAQvtwao8rO4whgmu--2hc_qULzsMYu_8iEyQlGHZS9DVT_Ht_nO-qBQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESZl7qSQOWOV-9YdGcSZ98Nf397cl0v5DSHmw81baYkg&oe=6A7C5FF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEgBmgpaCLkQ7kNvwF3wA5v&_nc_oc=AdoeXZDV2r6l9xqsNQ4n2xmgUA62dVtmTJzojT2kcAIdoGQ3BA_9Vccprtv_OtuKA6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsJRqu7-XkC0huTk4lZSh30wgjxQLjPdQKxHGlVzhA0Q&oe=6A7C6640"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD8EmkHkWDEQ7kNvwEZvM8Q&_nc_oc=Adp70jwP0YNnScN9GWq0ZgOpgqB45YrurAwf7yVjyy_sFq343Z2IJsz4aUyBjrRCyO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyz7ewFlDLMO1qOpqr4e4UP0yL_8hrJM_KBFFwshG07w&oe=6A7C5
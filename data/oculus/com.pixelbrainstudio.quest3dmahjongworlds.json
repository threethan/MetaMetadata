cdn.com&_nc_ss=7f20f&oh=00_AQHjVSt_njm5BkO8-SY-nnbSSl3p_RsqaFWCNftGTFEEyQ&oe=6A86D80E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znMuSNnl000Q7kNvwFzvoQ0&_nc_oc=AdrOfNS_G-n0YxJr6s5zshHM_NnECF6iiELocrf6l9fJWo1QnmPrGMHzocxLsbBRRW8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEk7zL07lpdUAjQvGhROyuKyEzp5gtmvK2KrDJhy7IIaA&oe=6A86EF61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmn4tDQeq8YQ7kNvwFhQEns&_nc_oc=AdrDBgzQZBt3o4Eii2D2DIQUuQASMkCIJ5Q2livz-KJ1u-_tUA0e-VLMLJtAW-hWKFM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPZNsSJIzQHLjDiFEACZED4rub-ccfOHQ9MLZ0nq_XYQ&oe=6A86EA1D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgCpIyxiDJwQ7kNvwFFQ-ET&_nc_oc=AdrQycyhutZjKm3FSV6sY8O68akE_bsnEMyF4La1CrFNnylZzTIpVn3HYCQLBAPKtlw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLxaWRwxAd_SsM7NygDhXd1Nb-HJoLMpaXYUYLemVynA&oe=6A86FF6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJN5YhS321oQ7kNvwHDrIwR&_nc_oc=AdpwwvMFCS66R-eHzJnGuG9lOfJrH-uvSW8he6ZfUYjHkWJ7775rbkgeOCQVQQAYJ4k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGf7sxs5YdzlLdzABqdPiMhQbfo_yfEv9AXtgCm4wainQ&oe=6A86EBF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsj9U7ZzMhUQ7kNvwGBa4wP&_nc_oc=Adq1rBDLByIv5q7NWyn4LBtXbH1ZLxH8AAYgVXGm4mmh-MxYBz2D72lqN8APNeXhr4A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmmM0sx70v4eA5vP3_JgUPSSvMfb1H8SiNWG2qKunCnw&oe=6A86F240"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KN9HvnVPGGwQ7kNvwH41sNP&_nc_oc=AdqJSTecGnIJeWhILHixAmclQFWd_F3UBuekaNnozjemZ321DVHhDfsGKht2cO_OUPU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQLMHUO4XXz563c1ClhQXkogRzg_tqcFd-yjiaFn8r-g&oe=6A86E
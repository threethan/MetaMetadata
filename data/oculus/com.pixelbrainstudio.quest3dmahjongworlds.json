ng", "id": "397066162476470", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982484_397066165809803_814656131862562727_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4GO3Evg8HUQ7kNvwH2dq5n&_nc_oc=Adm9u4j_TQA6pI2ij8Nhf44dKFB-uj99pjPqhVAEpQ-wPrPdO8ocPGJwu4u7cC7woYg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4i98htxO42r9beQayiM1c_yXSPEzLXkYxkriNmH7WVA&oe=69B6BD92"}, "display_name": "3D Mahjong worlds - Quest", "keywords": [], "long_description": "This is the VR implementation of the classic Mahjong game\n\nNo matter if you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- Classic and 3D style levels.\n- Rotate, move and zoom the board.\n- It\u2019s a simple puzzle game which is suitable for any age group.\n", "short_description": "This is the VR implementation of the classic Mahjong game\n\nNo matter if you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, simple game rules, suitable for everyone!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://pixelbrainstudio.com/privacy/oculus/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Pixelbrain Studio", "support_website_url": null, "website_url": "http://www.pixelbrainstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "
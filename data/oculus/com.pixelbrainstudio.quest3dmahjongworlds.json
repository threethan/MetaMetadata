cdn.com&_nc_ss=7f20f&oh=00_AQH1yUImpH_UATKXNYioa6odRE5149nUFQ_12s_jIidflw&oe=6A749B4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMf0xVqIYsUQ7kNvwGy4j3J&_nc_oc=AdqMkkUQxp_-nc8KDnb872PA9TXY71pUuQq9oNZXdPXUvm97jCLSoNGpofKV23y-hZ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXCdKxkpAAjc7fRSqcme3MNOq_oowq7lTXDaycj0UixQ&oe=6A747A61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EOHxlyW3EEQ7kNvwE74QWj&_nc_oc=AdrCxpKLU8Am-pb2eV98PpRPqy-fV7_ePZvTYD67FuyOYkjAy7XdOEMm8Ut4GO7jBFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkbaLqJ543qEh1egYhOwXZDlQnnVL4jleFLhVlV_MhJA&oe=6A74751D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0Zi2tbpfukQ7kNvwFQd_-e&_nc_oc=AdrNKoZ8LLFD4VItNFlEdwVVNVZ_L0DKLz9vXNas7hM_kbuenDWS3j9tR2R7lzmtI38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEel2z6PRZWKOQawxwkGpKwu6ZxXdLE2cDhuwq9fYaByg&oe=6A748A6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-FaMvTewRcQ7kNvwFeLyNh&_nc_oc=AdpTqCo4q3-oAhpADm5BjAUzIqZrIg71oK8h125SLff8UcbU8eWAYbSMJVGMZ2KgbQI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGgk-3jM4ffZZm_EDlZkaLitl07epDU_yfnBSum_pkdw&oe=6A7476F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBFoJR7lPakQ7kNvwFBPNq0&_nc_oc=AdqqTrqH3uWOYbc-6qK5eH21VVTVIpOA478V9HplANYoxxTsOwOFDIaG5IzIzTAiZVI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrGQY695n_tGBITALuEwyduDjwCKXEkgnzaERZiHZalw&oe=6A747D40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vncQXjxavNAQ7kNvwGgGdRy&_nc_oc=AdpPlrfnvKKr60SwdOGSapuV3iNRbsGLMLO34y2312vD4bPNjKNHaCmMZC0n1y2EdYk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJd_bMJb4KbOzi_O3P15ov7q3-7tQ9nnXL7UCiicb5WA&oe=6A74A
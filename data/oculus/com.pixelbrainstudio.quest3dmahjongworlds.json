cdn.com&_nc_ss=7f20f&oh=00_AQDpwj52W2ymwN-xO6tCPLAG-4fCr65qC0b95sB08GVRfA&oe=6A60D4CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SDWZSok6g4Q7kNvwHgxpvF&_nc_oc=Adpz7dWESBQ--kEs255SnnaMSSQCuj1BQKJyqdTD1KghIZ7dvFS1l4C3EtXJM3G2QL0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyy3YEsfGSfzT0C1XNUTxqCDGuoPFCghlZJncSCCcpmw&oe=6A60B3E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xd7jtfsUU40Q7kNvwHmsuX8&_nc_oc=Adqh4MorxBVvlr3GQ-_22mTkwXWtmUhQlgYYmvSirPTwW5BZ_tUoWLZ1ClzTs4wwvFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZbTNbtB9-lGX4BC7lk-apGU34ci7jxJHe8fq_sNBOHA&oe=6A60AE9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ecl6aaaMjEQ7kNvwFoyf-R&_nc_oc=AdoaAsgwRwjYvLYbN5tIr5osEN_5fQUQM5kRellmHB8dIRVK057x_dgMVDTK_l4TFU8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSp8KhIh4p9YtOD_jd1KYTNiuFqS8nSN8Or7R4eKwirA&oe=6A60C3EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2E0_dFdqNDoQ7kNvwH1DB8M&_nc_oc=AdqL-VgxD-ypRhW4hfSbPiABKf4AhFTujbPbvmR8cOLJPMksjDKDPOKKJIET6Fr1HCQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8ohGr2ySGuV0-cAFwipGvQir3h4QQi1bzLnoy8SLqgQ&oe=6A60B072"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnsEuEkBBuoQ7kNvwF1sZQj&_nc_oc=AdqlE5j6mAVAhmFrsoRt-_BCc6zuSnPX7rvZIb5sVySwqJK7SCHzUelnoPTy55Ww7Kc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcUIKARrphdi07zhQ2v676Ns9taXM7y4veA5eRJPJdQw&oe=6A60B6C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6ig-tMcKPoQ7kNvwGOyluV&_nc_oc=AdpGjOpr3Ovb9hCktQ1ZdsG5Je6KkkyKsYYiOjwKoMZ8XERs0jlEMc2pmdkaPn4VIQI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBj6JfZmmzCLnJogb6lOA7XZY3V1tCom1rPBATNNBGwgQ&oe=6A60A
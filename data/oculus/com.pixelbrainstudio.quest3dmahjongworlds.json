.com&_nc_ss=7f20f&oh=00_AQQH2GjMXwB9Eo_WcajOR4lym36W1Sqen_N1Uta9Tlgg8A&oe=6AE74DCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Zr-WHqJ1HUQ7kNvwFvRWyF&_nc_oc=AdqAcuFolBfWwtfLUsm0M6KkHNAFTl7WRsRP1wWO_eVFz1PaAwStvHjwCHTx_jUPFg4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXVGuS0AlXDxp2xHw8wW9wEwjFLSvGTQIs0vw5YhvGmQ&oe=6AE76521"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgnwWo7srT4Q7kNvwFLstzq&_nc_oc=AdpwURW7x5s3QjhQCotObmEkxEnYezC1mhF3WZBIVaVzxf-d2gO4Tb30To_h0PvJChg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvEajkD-YbPfVsBgQrkZL7bazUlMWFXnwXgEdR2Yr5fA&oe=6AE75FDD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNoc9BwdCKEQ7kNvwGe_LwA&_nc_oc=Adqa-TZtAuxTzxDokw2Zy3F6PIggeqStM1W0rKLna1w993YqzMJDs2kBJr1t2LXZ8Rc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfX-508Ld2op3EvtAGsJNo6QgjyoAtM03rdiE6BYhqOA&oe=6AE73CEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6sRjn2bjMAQ7kNvwEdh-jz&_nc_oc=AdqPCQC8ASM4HmucWYFCpcW5pN9T0Ls8iGz4XDm9zfnqjdblzOBx6akxoMHk02VuMwU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQugsukU11ioe1pUNwVL7dMFOjWrbUqsFjYUPJuk01c7Q&oe=6AE761B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXiIPh1laJcQ7kNvwHNNRnY&_nc_oc=AdrL6Rn8nszc9nIaVcjt87kItGu-ky5Dd6ofOfj-JQw-lJWKdxqxoIULuvn7DIbCYgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHWQ_PZetaEuG6opeYPLZVIu4SdeZoOiwaRJ8eco_rCA&oe=6AE76800"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhAhu2ClkU8Q7kNvwHUK3fP&_nc_oc=AdrdXx3g72gsuPY5_kEQNi9giBPoTI6SuFNKQppzYOvWtG54ZQxXhZ8WPZnVGwPkhss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7gNuh3j9F28l7ZPcJs0ObWthNdexBR6gDd2_Bo6-2QA&oe=6AE758AB
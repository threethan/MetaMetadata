cdn.com&_nc_ss=7a30f&oh=00_AfyVlQTIFHievlnNJd3ZEHuAnXZcURcoS_ACq11ojY0Xcg&oe=69C3F24E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5o-7mcohmqEQ7kNvwEWVfGO&_nc_oc=AdoIQ2ilKTPmmOeTKW7Xuk0891hos27CEe5RWa8ISje3NoAWqsjutq1HC9VZOGVz_tU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8Okd9JzOcyCE5CuQtrGBXyR0abyiI10c2CvVyLlBYEQ&oe=69C3D161"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAuLRqZDbHoQ7kNvwF14QqO&_nc_oc=AdrE9Ro6udkDwOxT0AJWNOBlJkWpgWIMinW5WqVNJ2eKbY7ambgwAp0dkV4Op3wTpGw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWG14yc7qQM1R-mqs7Yba9P4gxWjM14PrpQIn6_oeDoQ&oe=69C3CC1D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fi7Ufz7S3MQ7kNvwGZTJGx&_nc_oc=AdrWbvj5KlNZoac2xgJf0gkXJBhiwUBuXUHbp3erkC6yuTlC95M51GdrI7MaJL3MeWc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwltRfn9yCTY9zH_jL69WuyZSajf7sdiPymLnQZPnJcPw&oe=69C3E16B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOWyIJRgtXgQ7kNvwG4RvMe&_nc_oc=AdoEEV9Qwkr__-ybRu5EYRXFo3ad2VivXSgy12wylWVU2wjbXsi9R6bceSiUs3futWI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxrgTz2RLQLTXdzv0efKXe-iPxv89nruk8DoSEjtDbRtA&oe=69C3CDF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_4bByh5zsAQ7kNvwE8FZBJ&_nc_oc=AdoP-tNLFf1zmeg4oNsf589-yFt28lSr2UC3UaqRDuldfrh6nmvjkb2CnwOhfCeJZ9g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJpsQ6DctUoMOl21FuaJHPk2f-jzHMsPMMeAvgDrEvVA&oe=69C3D440"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UL9xqknLiUQQ7kNvwHjRsmy&_nc_oc=AdrawdAa2egkfwiLujYZN65OtdqIY8HJ5-z_9Ag_thDyEpTjcudiNvUxWmJ2sWJyaoM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZm7ICweFZvMMMur3UVmOglnyLNXK3UlJGZqwcvw7fKg&oe=69C3C
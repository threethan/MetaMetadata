cdn.com&_nc_ss=7f20f&oh=00_Af6r0LYOvWFHf1JDzH9NuFZWTizzNBtvZwg8X-CwwS88jw&oe=6A09D1CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfViV4PYQ_kQ7kNvwGrNwtJ&_nc_oc=Adr0HfNwv6A84UO19WlS0QzNIK7IjMRM17Ga7A7zzaqpapDblG3wTGnq3ZhTCN8KSm0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YycP32_gGr1b62TixllzbzdQl0m6rNyprIb_oAP_TMw&oe=6A09B0E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiPiGkDQJNMQ7kNvwEVeush&_nc_oc=AdqlYKDwQ7uctZej6rLP6ofPxVq8rekcqzRE4Mt9Nkxv3Mxmtd3tQ0OtErjlE9V7Xww&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rYPt4yV90_Ivtf9AmWhoCoX6BYXaCkLWf_WX5MhUrOA&oe=6A09E3DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2c_x4zVEXsQ7kNvwGlW-AN&_nc_oc=AdoH8QMHaD9jk37HASHM05tB0__CTZjfXX0XlZm4WZM_BWInzmIdlF1kztzTKOGUYjk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77L_DHTg_tphKw2Jdr3nBB96_sGBhcQx8K5YgWsqTgBw&oe=6A09C0EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBu0mm0ZMowQ7kNvwFKwvo-&_nc_oc=AdqEn1qD-kPXR-11LBRkznbeDyxyA5SPID7tHW-K0y-osMmaz3UyrsvJKBjL4jwdZ_0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q_-4M9L5D7ERN8g4JDrGURucfNi59F963hS-dKo-WZg&oe=6A09AD72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UwlwloEvEkQ7kNvwFUvc4P&_nc_oc=AdrK4hseyZCuA0wPsAXd2wSWBcdnDapyo0mKLrcQrrGLuG5GyAViqc2I0t6snBThCm4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7j7zE1IK-oWhKPYNfzNLlYc2zxsV7OQQN5lx92EK8VRQ&oe=6A09B3C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izWsr4wlHGgQ7kNvwGPQoew&_nc_oc=Adoqgp-O-QMA3vQ9Ar8067arqC6SFIH7TxDFdQDhOBZieDiD3s4jsDuIyjLu3lUz3AA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UYKYGKJxOsFrQHWiS6pyMX0i_tX-7ox2npgS3TgYTxw&oe=6A09D
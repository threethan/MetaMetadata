cdn.com&_nc_ss=7f20f&oh=00_AQCo5HLUBDWdIcvntE5SnkOq7D5-oL77J3bE11Y1fj4Qvw&oe=6A5A3D4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBhVltjkyXEQ7kNvwEse6LO&_nc_oc=AdrMoOgVk6bCATosiBs_ebVoe6-UBD5yyivXmYHgmDixPzt8i2e2X1FLJ681gkIAwvI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBr1pRSq2xbB4TxE_6lQpPBwQsZVbaA4pZVquxlnr_UZg&oe=6A5A1C61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0y6Hw3hbcgQ7kNvwFiS3cl&_nc_oc=AdrIK3CltbpIXGrOp6N6i6K38DPwbLP1450r7HolKhyrezdOeUaF4OLZsHI0ST-fdyU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKsxC0SVr0g4x6l6LIiApQrduQF3S7ZRfWUfGXxQ7ryQ&oe=6A5A171D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqvicQ6KXHsQ7kNvwGP91Hi&_nc_oc=AdoE3lKWujOHE85xNhg8P7vakfZ3rvUa802Dujgydld4_CB_V-RBVPfoDQqtG_XgldA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQ_rEp4KYaTr2dJubrlknkL0I9NivgQaf2aID9rPqa0g&oe=6A5A2C6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7-A9hE0ktYQ7kNvwFJ1Tct&_nc_oc=AdqunvvAZmEOocZSYZZt_9FYOibMhPAts78Sjvin2wp0LYWfNYrXa8ps4Ip8JiczOjU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2itWxk-Ay4jSVnaavjHq8FsHxCwWTK6z9expR7_4xKw&oe=6A5A18F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5I9ThnGh_cQ7kNvwEUhYJ4&_nc_oc=Adouxtt5KHMRx5cuael30jDLWra8rKO4ZAvHT6w4J4uXnuyYQIJzV9mo3cHUjSpLiwk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDksMzou5OdORYFcnvcnoVW8PDvz0EJfpbYGcNW1HFynw&oe=6A5A1F40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoy2FF9KoagQ7kNvwHKolhi&_nc_oc=AdpdLG-VbBGbJ7ATDhJNxFQf9aiETCTtS3zb6ekjaMtVErEd8qX7rqLMpFszYYCKRP4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9oULnr63FEC7AD1i1nZf35h_5KyMflgjn3WJ-KJALag&oe=6A5A4
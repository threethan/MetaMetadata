cdn.com&_nc_ss=7a30f&oh=00_Af1XkJyaYHFnSGDyypQC7dGUskKkqRiewk9ONvW10gPGZQ&oe=69E3964E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCs1xrxwGBsQ7kNvwHSN1wA&_nc_oc=AdovE7kxXzkzthB0uDuZ9FZMRYcKE6ey6C22qeA4QZpqsXlVGEJ0E1Z-EZ9zSMngjP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vCfKTHgRADc7o-P4GwREIUlUSk4g1D-B_sJ2pIoQkZA&oe=69E37561"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdN27ixnW_8Q7kNvwGbYb7a&_nc_oc=Adpo0Gy-_LD5GqkQboBjkq9UZCEBNInR24QXZagvxKBMPSIAmwS5timfbBQ-jVIuYhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gWJ9gpotCRB8o4Bp7nZ32ew9F6oknHLIGZYyJDBrHaw&oe=69E3701D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3uaelX14CoQ7kNvwHNiY8J&_nc_oc=AdoA6Ob_cNSt1FgZJH7bgseiupof8WvxpeSQt85zVsCwqi2u6X0aaukOmvZRfrxTJrA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1c3XkIwAicbLpjOWoC7KY4Zelb8DxHVEg_p3l8dsLc2g&oe=69E3856B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDJgccjag48Q7kNvwEqwIBJ&_nc_oc=AdoAacxHwUe4MjEIRHFVIPkFxxj6dRZ3yaLDK9Ps1F5NpsA-_vzZTSAmdREoPXzm1XA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08rg3UwNhe3gZLPEgjcSU1eeEU0TXu3nH0fCAo29u2Ww&oe=69E371F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLYnx7is60oQ7kNvwGmjO_S&_nc_oc=Ado9geyiRwEm_j94Zy13OowE4xlxjSStmJE2jxjuFCQKTxPFlaX5nmdK6NsY1Y1_kHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2K4--gU3xxmoNjpTl4ODxbqkWgZ63W2EqDIQ8sk6HFxw&oe=69E37840"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PC13R7uGH40Q7kNvwFMQiB2&_nc_oc=Ado-HMfeNc2Dcl5T8hpSKM-e_uhZB4-QX_NyYzFZuW7tPln-BAQRZotRaQOIdQmlNic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2P84avisTceegGPiQBR3T0Vn0-WvZ8ew_tmhmivolXag&oe=69E36
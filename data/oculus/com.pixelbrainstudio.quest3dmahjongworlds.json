cdn.com&_nc_ss=7f20f&oh=00_AQJE_7YDRTOh0kEzI0ufc_j7SQMnbMVFxYB2osEv9oUPWA&oe=6AB6864E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyjlX5j51OcQ7kNvwHsEr6r&_nc_oc=AdoCN90OOXzE1zcIlk1TvKZ4YpsjJmYvhlC51neCmKpsgob9hm7sl5AA0uUQ4K-sGjM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHIRXR5PbPnv-Xb9BNkSXBS5JkHZ7JVAbBYJRi4YlYxQ&oe=6AB69DA1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EeNlypFXhYQ7kNvwEEYxjD&_nc_oc=Adp2TWpHtl3OEHtPr_50uKV1B8JI16dI-0CVC-l5F47M9j3y7qTfLX2SfjI5P1YitLc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyC7BRraHGzJXjdRk94-mmWVnr-zFJUDUE7fToiynsKA&oe=6AB6985D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJn-uEtKKl8Q7kNvwHWaMEN&_nc_oc=AdreUCk--HiZry37SjrmV8hIo8OiAClAwt7I_uo1k7CW6aKJA-TVi0s6ZgsOtPKT7eA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6b4UpT91KiguP47cRLtiUK1MCOQ2qMt_gKe84OnnjjA&oe=6AB6756B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BW1xblgLxBMQ7kNvwFJc3G6&_nc_oc=AdovFUUb62RH1HX6W4XFOyjertvd8m0w4ZTr0g0z3HW28SpX624dAltN06Nv_vEF9aw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhTjh0TO1vOiSPUQiSPlr4h17KCAI52oy5hXJlyJaF9A&oe=6AB69A32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbAKj8sKcSkQ7kNvwEEVDyk&_nc_oc=AdrTWG4dZeT0NNcw4OWPgRF6Obt4qIGa24fz__yfzdkoE9eyEad4FRK367PE8w0Ux2s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxUX4VlM0gEYnxtNa08sSUIUiaA2e9fadnKzs680jCow&oe=6AB66840"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln-c-SbLdaoQ7kNvwHYZfRQ&_nc_oc=Adrt0uyCtWwDg6ei-1O72XZoq3a5j7O-a7Y2zPHnyPsvFq6OEk-ss_R1dp72mLh8qUg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLadjSoyPRAQFlQtH7PeTI33F_1gohyI5_MT2MBalNzpg&oe=6AB69
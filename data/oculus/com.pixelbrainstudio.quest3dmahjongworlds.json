cdn.com&_nc_ss=7f20f&oh=00_AQECtWzaXrp9xCGHoDmB0Vo-XXp2Nf--6Z7lObPYrpEzXQ&oe=6A831BCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFFpqyEsH4oQ7kNvwEr39zM&_nc_oc=AdrFgez6mNg-E7kor_VTIMc-m-PUsBiRPJja74BmqdFCh9mIeahl9k5hUeTc7_DSgj4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8mzCA5dYkV9Uk4o74d5NJxY44xzs-_cZPG03LHYzv9A&oe=6A82FAE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cn8wOhUXoYEQ7kNvwF_LyOT&_nc_oc=Adrq4DTCSlbUBnwbeZOYDcQ3NA2JASKOH-Hfvh2YnmyCJh3tT6pEZqGgcS0oIBw3MMw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxS1rx57k9zK_d-0I-LSxeFKQWUBNdFEQGgySnzRy_Sw&oe=6A82F59D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmFmJKIer18Q7kNvwEyDYIM&_nc_oc=AdrronBZvC-g6Dj885A_2BJZdih-H97MHWJLPPP0QEPd6umBXuEBlirNQp2TFsQz0rQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFANem_qLzrz92aTppUUbLiebxzq7zRI-axl1XItKbddQ&oe=6A830AEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbSM4GRcyjMQ7kNvwHW4D31&_nc_oc=AdoYvuyyc-LhwFAeRquE7pJzAKhwKM4dePWj2Lwud6M_WEuYkVhBlnqF6JzGfcU9KcA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3N66_izdwK_LSik0cS9Dali7TVd-caMxrvleGSgHlzQ&oe=6A82F772"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cALzupbw3YQ7kNvwGAHT4c&_nc_oc=Adrm3FDulcF4xC2V-Npg6v-5XUYphR6kH7kOYxdRRatqayyAWQ0QvhgFfAC32lBUVOs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5LACMcSUh0fZMqHucz7qOkOiOLqXYvHT4y1pueHCCWw&oe=6A82FDC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnGkajyJ5lwQ7kNvwEYZiAr&_nc_oc=Ado88eJ-O0LXmMAyKlygevEhxn4cENIyMXB1QEkOFjI-LCgoC2FCa703U6Ls_tcDKaM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFy2vKRMndnW0pToEFh-VlEf0fV_FLgFkMqNWQXbECi9A&oe=6A82E
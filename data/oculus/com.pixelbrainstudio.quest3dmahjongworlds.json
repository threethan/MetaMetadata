cdn.com&_nc_ss=7f20f&oh=00_AQJIRWxAh1Tehu93h3e8T7FpV_3FVcu8ixI9X0P9km8omQ&oe=6AB291CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC-dN7rj9h4Q7kNvwEnktbx&_nc_oc=AdrA5cmre0GhnrN-qW9BOhiCNbZ8UFgalzTi9FYyrNs25BmMiCKCRkdYc7wJA5PSCNk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuD0bwFiULeubpKqT-Kjp6qjQxpx58vWPexf3ZOCxR0A&oe=6AB270E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvIHXKGbV2AQ7kNvwHrAnWe&_nc_oc=AdqhPtauFBlm4soxNjmjIxrPC94qx6sTpBSwyoG065Gf7vL8Gc7nbY2Rzo46vYZr7-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0TlG2Mgc02gVPzeser1Ra0d2uiOTopFobRAhthdhfEA&oe=6AB2A3DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UOfXxia950Q7kNvwHDpbBN&_nc_oc=AdpqKOUxE4WWZL7tOkt9MbQaBes4BG_DktuskS3kaSt-spYQLEAv8XOA6rJ7wdAwcjM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvg_UD_ZQsLrS327Y7uXgM65dVCmq2nqWYE4XWfRakDQ&oe=6AB280EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qzKp3f2XDQQ7kNvwFJ21HR&_nc_oc=Adp4RBq9_uSGbkHb2X31nDFQ36Es17K5RhCn3gf73PO88fsa0JMNKQEifP1mDorw0-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIt-bgBxFBcXfdSB85649YIjNKYi9XOfdBxFg0UnTUyzQ&oe=6AB2A5B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ojbgf_CcZ4Q7kNvwEjPMDJ&_nc_oc=Adph40xaX2C2pAgXrN1x150XBcGcgWrhM3qvjsebO-OgAW8RUvNMVfSsngO21DBmyV8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeWlqZPM49FvIAtFUWb5HNBHMf2yMMaL5pss1cma005g&oe=6AB273C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLVIQ5eiDfYQ7kNvwGGUgxY&_nc_oc=AdpMzmAKNV5w0aCNC4mWmIkxuliblkrVbHxcidcHNNLyM4kbwQPvUPNxSAZu7HV-qrY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGBg_xyKm0i8cb845ODAqK-3HM_xyALdSwD8V-2qcZEA&oe=6AB29
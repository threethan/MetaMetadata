cdn.com&_nc_ss=7f20f&oh=00_Af3mdRXLqf29zhGq3Ft39LChI56OFwIceESrESVoCHg9rA&oe=69F60B4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSk0vuwEJ9sQ7kNvwFrgREm&_nc_oc=AdpS8LRFoScQuxs6qPTaasZPt9CuxGF9eyPU7gvurohwrDetAVhf57ckBoJICHaa_jk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3faRwBVFw8b6PEti0ZIbXZsvyOoNxkVg6iq7Wa0pB22A&oe=69F5EA61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlJSyCSz0eIQ7kNvwE_wMKO&_nc_oc=Adqzub8I_VNTQVFmQjRHiMOKW6yOS68SO9qWN9t9-rP5T_griwrao0EWwQpN2TVB26Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0LfyKnTXfb0AY35iqvn5U2gx6q7Z7bN3Gz2P-qS_C-9w&oe=69F5E51D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmZvEOrEU88Q7kNvwHnMsEv&_nc_oc=AdpjcZnXF4sVdm7cA1QkjY9lgA46vBtEtf8FM2EKypWaYMJ91jcBeg9HCsPCDf5JPD4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2zY9bx4KNznz4j1WaB00lw14_U90dize9rHRo-eJ9CtA&oe=69F5FA6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqjXckECkZoQ7kNvwEK9gxn&_nc_oc=AdrWb_IT-D1EBdNgp0RPYGI_ExS2rGRkeHxEIDtp4eQJF_vdYeTZ8yTSF2X62f5UktA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1YVMDH6NIUdZOGr-zc_3i4BxuoMskWbC5sRYUdmQrNPw&oe=69F5E6F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MBiM4jgvRoQ7kNvwHMw7NQ&_nc_oc=AdpjdPt50InrmIssA6JihOpu4rsRg0qMacScnQWF3UWXiPxk9dYFKrU6vvg_elm827E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0A2Kx2ZSbEBoCEFFQSPhl4HZ3IuOKZHQLf33gpqFl7Gw&oe=69F5ED40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIe5wU2l-qkQ7kNvwEszN-G&_nc_oc=Adr1Xf75AkeeXKHenRTO7PkBzeyjF8O3sUBYpPG7HdBaAkYoUrPgrFe-i7CiW3mxV5k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yUpcffFXuOUOArjgfS75gPfJ4kByhEloULY_QERLNJA&oe=69F61
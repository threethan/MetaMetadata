cdn.com&_nc_ss=7f20f&oh=00_Af8huPuUGrdwOOqmgYk7C66tjdb9iNb-S6KLYpiGwiu_kg&oe=6A2975CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kU4_TDFmPQQQ7kNvwGnhmts&_nc_oc=AdpGAxmJc-tNS_aZsFFIklPvd0hbGDICBNWhcvShBJE-ZFI67SriDTKnknW1rpn8Y9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_x6Jx2KUHcAlNZ2moxsfjKIzmvFGCamRTazwFWupC_JQ&oe=6A2954E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS4J4zKIImEQ7kNvwG5hiIR&_nc_oc=Adq2UWC5uYRfdNKEuhgjmiBQBVFMfFPC8onaavF5qN5NJ1Rl-lksh1a9bO11MnL4GrA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g5uGgpO93tVSEbBplDCLc9u8T95HbC6NS-Ssybw3tLw&oe=6A2987DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WP12wX2oHUYQ7kNvwHzCtQi&_nc_oc=AdoEvWTiJD1OoUy6vlWJeFhZijwXoCj61a_NNZW5w33Y7kE4iQ9KBPoNHkhq0lSOP1A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RF8UY63atZaGJaB70NGOO3rQsx1iFo69UrTw7Rt6HWg&oe=6A2964EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvsZpmY5QGwQ7kNvwGRzqXy&_nc_oc=AdrdaGI7-eSB5KPzMmDOjtPMqVcCDuTkBPQmvOW_-fgZUFu7lqlYWppu44jD8-kOmBI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6L9qwJGGDRaOXM6SDw9j1sqrqIq8Z4ennCxhAMz9Sow&oe=6A2989B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWjBZ0_1gZ4Q7kNvwGpEY0w&_nc_oc=AdrluRDSShl06FFjhMUlf_qxZ30SWHFvjs_KIEOSQzX0294vIV_g2-i0Gv8VrNWy5RU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MI77wKudx1E05IBHHsgFu2LhUR9QZQwjWmJa4IonvGA&oe=6A2957C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMkFfrq3BOgQ7kNvwH7LYCB&_nc_oc=Adqbpuw9cWLSHbtTcE617CO9LhNN2UaZkWvDLkuyuD26fsidweVIym75-Q4i8ND5wXY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98otG8GgLDpEwddHfr-uzkE8z9czwakSDEVBgZ1TajBA&oe=6A298
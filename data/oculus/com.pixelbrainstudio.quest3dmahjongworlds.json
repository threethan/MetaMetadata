cdn.com&_nc_ss=7f20f&oh=00_AQGkl6m3Iop2VoDKJnmXDQJ19pWAylK967zoM-4Wiy26eA&oe=6A897B0E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znMuSNnl000Q7kNvwEnltAo&_nc_oc=AdpUPupEuaJnD4kpTrHpOHfTvFsUCa2mWmdGVtV8KfXrU0wqpCoZuQEYOCli0Dnlv3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH72U_7dqfQskLHofIOF5aczvHkAnUrZDC2phediDaZkg&oe=6A899261"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmn4tDQeq8YQ7kNvwGh7VCS&_nc_oc=Adpw7vZ4P9k9aqnJbtcVxJDDQJj3-tTBwD7prhy2qCA-djKfJus7qK5CqxEaKJHJVlM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfULvdx1kLFzmvWscjQ3jA6AWGkwMPEU84cDHTIwSiYQ&oe=6A898D1D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgCpIyxiDJwQ7kNvwG5UOGv&_nc_oc=AdrbEQN_vOUhHoPfzxeM_iZg-bvy4b_td4HqHRXjqWbJpoQWs_U7p67aHBsSXBY91Fs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAMlikW-ehqDUa6JnUG3c6LUYqL_dcueECmX6CgI8aPg&oe=6A89A26B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWHvALENbYIQ7kNvwE49B_R&_nc_oc=Adr5UYCmbDR63PVL3dak9XqApTazeCXxNcXjbGNTOM014Zi3AcLeyt4-4XHnvACHbp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELz_Hwj0SZuLD_2k8ijtHpSlXHpRfROMl_t1Vukf4Lhw&oe=6A898EF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsj9U7ZzMhUQ7kNvwFFyQYM&_nc_oc=AdqfljaGBG7KqHCrpkSQehRUyCfdr-v7B8Eto9u_8UI6Q0DSIR-ek9_Id8mi7F_b8u4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHc12s3ioiM7sOK5THf-g_B8g-6JTJf04DbdxSm7sZmrw&oe=6A899540"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbBuy-LjRsoQ7kNvwFaPFLG&_nc_oc=AdrirHNQrFQXNaYlVUggY-P_dOg_hUnu3WvHoBS2ea9dvbzmNOrhKrP5YHl_AqamD08&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTghJfVFisT30Kvtyoi-eaXoNUczh_CmnF2HtpwKxU3g&oe=6A898
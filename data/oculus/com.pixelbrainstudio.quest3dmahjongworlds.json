cdn.com&_nc_ss=7f20f&oh=00_AQA9MHaBQ5t63qDnYaid9fiovwseWQ3VbE-LL60NxgPmyQ&oe=6A4BBCCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8rFquAJWKAQ7kNvwG1hwis&_nc_oc=AdreAkrSUl5-LxuU6z1e9KYkN9OHXNpSR0a48OGxaNHF_TfUg7W1TffqK_MSTuB6i2E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDajvMIvPyXT_je6zxpr5Cux-ni5_yIwLVf0DnuCppyiw&oe=6A4BD421"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FR4JlFDKTEYQ7kNvwEeZz3K&_nc_oc=AdoQZBEj0CzMn8FnA6Kvm2NH-pZE4Fn71w7wx9UrXBVNylWCaSYJQZxhQqVFH9ZYP_E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJM8kPW1yYjOaTsZmwXLc7G50pPjk0ZAwvIa90A81RxQ&oe=6A4BCEDD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmlT34JhAhoQ7kNvwHwP8zw&_nc_oc=AdoSddLKwPh1ZVUNqG-ph_4j9dy_DZwYdeBUgHK_MSDq-ZLU8K5Lm1bpx5vXOIkgyHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqt6gTNprzc2QHRmqROdvjd5BawqTBsYLakzOpKTE7KA&oe=6A4BABEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOtTJTukSIYQ7kNvwGFJnu7&_nc_oc=Adr1D_-NQ1OV6DiIhSKsBiGRcO1k8PWfGAWdFsuEpAkzcTgc9PaakVl95h97BnSksY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGfWveJaElpP4w_MC7e1UmR4TtWE1Z6Fih2wylbsoRTw&oe=6A4BD0B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SW9KNgeCKMoQ7kNvwHydeVT&_nc_oc=AdqWagQpA1Nflt7SHugzk9a5KvKbM6pI9nET8zz-sP29KQ_a6rI_Gp-RV5qq7oKjpXg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcDZAfIXKRHL9OFiN-zS0sDaM9Rd-Z-uXS8H3x3wzO2g&oe=6A4B9EC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeYa5Ht-0DMQ7kNvwHV6f9J&_nc_oc=AdpJzMt51gO5iYCEU4XOkiXh1TD3vzm4cROVfTDwEDEzeMNPko5AnaGD8GVfTUQiKtk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv057Nf79AYWE62KzcZfePuTVCh08pEX_PW2ePLYPKZw&oe=6A4BC
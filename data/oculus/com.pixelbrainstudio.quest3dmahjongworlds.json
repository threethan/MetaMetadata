.com&_nc_ss=7f20f&oh=00_AQS1D_DlTo0VGZ3h7iN9DHgTcBsBYbqTeWY8DJL0XHKJXA&oe=6AF8A98E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxCZEtgxYiEQ7kNvwGSQ7Ih&_nc_oc=AdpzHQfzAwHSz2bgNdShUwH2lVazgqaUjQh3X7aW_ngT78Bwt0ThQmGFQ4GpG8s3Z-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOa802342usOPQYK39dCNFQaODTtAl74L4PmfuKAMbpA&oe=6AF888A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NEi9JAL5RgQ7kNvwESFyKb&_nc_oc=Adrks5dx3QeIw0o3bzd45cIQlXlEe7TA63ZZeDvOYZToQF10LZ7VyTj87O9t_aGAPqw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-WDX9xskNd0iTHgLyl8M6qMnQNKo7GE5ZJxnbyo9X_w&oe=6AF8835D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYoovOQH1yoQ7kNvwFD-9Zy&_nc_oc=Adq05ZsWhGEORAIPpm8wA_kIgGfqMfQftNQqm-4ejbCgpD_Rpg_7XAYYdS0imO3RX9o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7y9GHjh4fgj9wmSosgZ0vmjAjIRN9EZQRUcXPJc-0Rw&oe=6AF898AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLGQw_CjKdgQ7kNvwGCbU-K&_nc_oc=AdqhPkezNMFEYR5op-3wDES637Zr8KUHv-cibCsC5Ip3b1op7Sx_bfvRCZbY_9VXPN0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKobw4Nnu3SgMA9pLGv9tEGXtyldGE33Z4_Mc1RUgcdQ&oe=6AF88532"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XohSu3xvRFEQ7kNvwHNc1b5&_nc_oc=Adq-pnfErydt_SJg6xgQSPtBWZ2eyO8z9EO4v_fTsMxSidHtrnM9Mqah22M949nj6dc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1XUtBtS3wHYzZUL5VqBgHtgh_vFir_JAKdEouZrfvzQ&oe=6AF88B80"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ufwg4FI-xX0Q7kNvwFKc9ja&_nc_oc=AdoBp3IUYYnCo-MnQFXi66jcFCmFYDNU9lN0UjC_UOcTh6g7EFW1VDUTfRJpRFItYXs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv-JRDSBqT5mdV6DB_SqqyysthKyCmf4BOFi3-U_7PAA&oe=6AF87C2B
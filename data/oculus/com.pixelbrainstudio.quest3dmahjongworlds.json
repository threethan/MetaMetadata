.com&_nc_ss=7f20f&oh=00_AQS6zLkmH44c3CaeKAdtN-6TlCGkwCyCidckNZyjl_BSGQ&oe=6AEDE54E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWsOeA-Aw58Q7kNvwF8TO_N&_nc_oc=AdrMj7K2A8ILELCeeZ18EaSx_jAKETSVoCA6Bq-_SD4VqW1yWC2oMvKKM0-VkzqplV4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT67DhHL_jBlGwNmPBXmopE_1S4lvsgNM_FT8d5gKdGow&oe=6AEDFCA1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4NicwFyn2AQ7kNvwE_VzET&_nc_oc=AdoZLW6IV_oXtkgNwrtDi-ifTxjRQIa1z63ooF3rh-Yxc9iWXXS65dmT0JfuNtSQLyY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7GvVbcAUDB9xtxRcAVN9MlQl20zcGaU5uSIRbp39jjQ&oe=6AEDF75D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC4jw0kXvLUQ7kNvwHIrV62&_nc_oc=AdpHnFbGBsyjJu528g54qyHJbkAszTrvg5Bw_cFB6xoIs9E5zlmlxTIJtNrUcSt_4bA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpSUCjP7aC-OsSEzLYqXzh3yjotcz-cN-MXzwGpR2laQ&oe=6AEE0CAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5-zVvhQXu8Q7kNvwG4WUHz&_nc_oc=AdrCs7pK8cUFVHU-DfZR-INeOqKzd3gpy7ZcKRPbMi7PQxgRnJgX1NIAdzSxZg2CJkA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo8fJ9hlH2cVPolZU19BEFkIZPfEboo1Shv3tz-JpbXg&oe=6AEDF932"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUB835ScJ8wQ7kNvwHKvHoI&_nc_oc=Ado20os2PN5nFuEbB3O_MvzzXSjJVwq_y_hsqNF87UaIE6qZu4Jr96UDnjvXuJBBOT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMqGwcPTVnBhC9FfQqwvFbFxkAKUcquTpM16VJFonkPw&oe=6AEDFF80"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slkzSb_7NlEQ7kNvwFanfm6&_nc_oc=AdpFdJ0mU7cv3xqeRDoOookVMtUmxRCpOy-X3d-C1fXLKT6K9zVEpowIv1FH20qkVTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqmO3x5qsQZ1poT9h6R4BOvXUPuRvhRpJnOH07H4pjZw&oe=6AEDF02B
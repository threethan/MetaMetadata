cdn.com&_nc_ss=7f20f&oh=00_AQBcxJIG-hKklbPMkpFlSLDzyfBWqfw6XOY_JofM-0X8Gw&oe=6A6E03CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKhy6xkRbpwQ7kNvwFESWPn&_nc_oc=Adoot6upBOvPTZiQpI5K7bPya-waPVkLXKt6Wgp-rFIoC4au4o1Ze59Lq1xfyWsPfK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgea7lA3qgBBJoZToeK_iYHO6AhjuAmgBnA1o4x0dWCQ&oe=6A6DE2E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjfR7I67sicQ7kNvwGGX0s3&_nc_oc=Adq5_0MThDSJryv3fc7swzfRFJAVxZ_QRMgj0i5JSbaLTOTizGNnWkLbQONAWFZeUno&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoVNPlsb-R0fyrMaoGVmCvoqfOiD6AvH5ok9hFE6DewQ&oe=6A6DDD9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIWVzQagfTwQ7kNvwFmguPw&_nc_oc=AdrzB11EId-fsxeH8_PKea3A_ExJHNJdMW8jdyqEiGKVAO4JyVesicZhhBtMsQSDHdg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7g4CWcnDbifun_2-l9qzSQWUgyEWPXC6BA518Tfk67Q&oe=6A6DF2EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kk5DlXBlJWoQ7kNvwFxVZCE&_nc_oc=AdqgfFQI-Vl4PoyetId3LCsga7D_-OnVL26YOKgugVpii0C3VPB2UNc0tlOXM1IolXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiZhgED3XVkZQk33S8tWPrGbZ5GInw4A6Ba3tgTRpSFg&oe=6A6DDF72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3_aBXIMjcEQ7kNvwH_juTU&_nc_oc=AdqdeCTK604aPATm5S2xcMjg78Po2s9H_CYlyABPkd-jFSFei8BGwnv0GtbKIrtiZCg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuhLAXZRTZg6kmQDP1l3LTgjT84rY_V72A-rauAygr1A&oe=6A6DE5C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fieDBTldW8EQ7kNvwHqOVN5&_nc_oc=AdpbdEMCjxqNUvMoFhdGKcmG3-ipgiyb_evXqTunx_s2H_z1GyLmhCoaTv9o9eU005M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBl6KrxSEim5UGifIYb4AjPcQnGtiRNE_7RJ52toXT-4g&oe=6A6DD
cdn.com&_nc_ss=7a30f&oh=00_AfxS7w8kTrU7HTFy2dHh59PiW7y5FI8YYr8-LC3_aDby4g&oe=69C6954E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sgNtJgzA84Q7kNvwF104lV&_nc_oc=AdobAISCkN8glWFO86F9kx20X2IGcxedVO-R9gFWbJblTIQc204P1YLgk9LIb-Qy5JU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWTNKX9SYoOU1m9k3jxT5VJR2yHZPMsLYOXA64aajizA&oe=69C67461"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh_K8aC-hCkQ7kNvwFoyLSL&_nc_oc=Adq0lNCs3dBWtumOy52BbCeAtwq_SHWOoBMHpgn8VwydwzR82BVw5V4_KhYR3lFld5g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTfe-_HMlK-AeNOybDdpTF9nwdpp_82EkMADs--3x6YQ&oe=69C66F1D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7x3spNMB-bgQ7kNvwHRg6Ek&_nc_oc=AdoajJRhoOlRqHcIqAeZZz66N_DbdjJjsO5bHFUe1PrPRi9ldU0Oz2MOrgPZHKFx37A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKBuqlCYu20NxtL-BtmDIjFJBV5e09D0nBqfJw78hVMA&oe=69C6846B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOWyIJRgtXgQ7kNvwHLaOed&_nc_oc=Adp1QsORsZTLEW2PUk3L7j2nMdvtxTrBbzp8MP7HIxa_5troaQiOgdjs5XgDz80eI0k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnAVb0vab3ongDxSb98rdQQjHDXO6IsVeHlz9_FZcHzA&oe=69C670F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_81qLWcfg8Q7kNvwGP_3OF&_nc_oc=Ado3e-X--F4cB-BRDnlaAbIadzX0MmmM6uX6xtEaahbqHLJSCRYydBgJWGG12O_nL_M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxnh_pBKJWf267qdJ9JCnNR1w9V39xkx6vvl18BzjIIyg&oe=69C67740"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y10xx1KOoUYQ7kNvwHzzw-V&_nc_oc=AdrzluJZXlO-Vs38Ixdew0tZ7P2ga1S9vSOn9wNcPcE_IPYvPIahgtH4yVimI28c0uw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9idg2U7kpe2YK_iWLg5wLEk2R0AQySSCProgQq1Bu5A&oe=69C66
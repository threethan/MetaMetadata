cdn.com&_nc_ss=7f20f&oh=00_AQAJXerLi-pcBvaQd7vR97VNe24G_MBU4fzaOiobnIfDlA&oe=6A4A6B4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SRwg6okPPAQ7kNvwG216YZ&_nc_oc=Ado9gHJVxZvErLxt0lMrR3RzTd7C55G4v6XEKyeVoTvvrZPgKNEIzI2WIlDG9pYOKpM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKJyi6cboVHNEfJkeoOEKNYbFcDaEurOe-3WENfSE3cA&oe=6A4A82A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FR4JlFDKTEYQ7kNvwHUT8hN&_nc_oc=AdoDLYaUBG2SZIgoLIXrn8ZKTpyStOAs9Z47WIXyfFanveu9UVJhdyD9pe6wxDmP9Lw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8lOpYdrt1psoWhBUBgGZF_ePGYQryOZUOT6A427XsUQ&oe=6A4A7D5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGl4lhyt27IQ7kNvwEgPiap&_nc_oc=AdrJgAY3UKjd5Rcc5_KRjA_uqaqFelO5cvzHtDiQdf8WqfJA2ST09ApdNRya1U0AjQ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAT8Xoac_N5Ij4b1pQUvBbLjz5sInyBZG-5AIp875Rbig&oe=6A4A5A6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOtTJTukSIYQ7kNvwHNJNyQ&_nc_oc=AdrzZxXyFHFjcMFQQ6mN8G4v10TdQHUs8DIJU0zFieQEgCWx3lIgMaTly5sxkyRiXW4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQRNJkxLSoITRzDRIcM6Dg2qCdMch0Q3gS3WkySuGF7Q&oe=6A4A7F32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aV7O500V7EcQ7kNvwH0Iqmr&_nc_oc=Adr_KmCW2JN3heXSyd1-qPFr7NuqqBFsvHRvY0taYX9QMSQM44XoifL5e5fndMvLA-Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7IgNrUuG4s_X2q8OXskdVb1bWy_WJhTgd3Q82SbbTbA&oe=6A4A8580"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeYa5Ht-0DMQ7kNvwFyZf-u&_nc_oc=AdpP0zUKSLxmYiGWMFiNkqueBIOWO0rRjFJbdb9hGt3qBu8vEm40IiYnBZe6rw-PbQ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAY6Rq2AO3u-9_0sK8j62DDaeXtEpHZEaQ21N_d11pePA&oe=6A4A7
cdn.com&_nc_ss=7a30f&oh=00_Af3BIsSH66yGsRDaQnEQuYsJXc-_avyDY0i2GmvmkaZDYg&oe=69E244CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCs1xrxwGBsQ7kNvwFbiQTp&_nc_oc=AdqmJh4QFpdXZpB6KWXlzkGNZdAem5OXN98syANpTSbQImCNEyemfS9s7lArVd-6VS8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZazGsy7jTdEwYGavsI8Aiq1H50X2-KbsbGHbtZPylDA&oe=69E223E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdN27ixnW_8Q7kNvwFIO7lW&_nc_oc=Adryqdc34cEcB4L3sRpK9gsWGVfjveeVgvXSShZVhrF9VrCxwY68ExsC8b8Wlalq3vo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pBG37SKnccwamTsnpUBi5iNItHXwRiYggs7hawc_pxA&oe=69E21E9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3uaelX14CoQ7kNvwHXi7iQ&_nc_oc=AdqLq14iXNIYF4CbR7OAXxN1yxPrNWNl_rkigG0hvMElfIBvYBU7G_rnchCyEiSibzM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MXJ43ihndvV1DmyVTbQFL9q0T3aQqir2VAwcRRY4e9Q&oe=69E233EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrFep1zGkj8Q7kNvwGAMXwt&_nc_oc=Adqa06HRCbKt4_A6FCAPubU6w1I_pPxt-VQaIyXz2T7pptgfIkat_KicsF8dvlJ8r28&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nxK8aLUi8E9R1PLWCVpdkIBo0MCTU0oAn2MO6FgSlLA&oe=69E22072"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLYnx7is60oQ7kNvwHoNSox&_nc_oc=AdqffMxw5gZnjgNsiTrKypLlhmmNqpTikB3o3ZKvcB8G3gXRBkescFijnls2xrmWfeY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WHaXjGXzzvYWPgfNPRFsshS3iY1fcH37-1p89gBcLMA&oe=69E226C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PC13R7uGH40Q7kNvwHOeJCd&_nc_oc=AdpUQ9dLCxT4WoN01vj1iKnZs808MehpG_Z_QYuxtaXlKuKHU1-pdPTXx5XSTvhiq1o&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01G88KPiGqibN3iO2v0cSJoYTmaAotGURSLa95GgS_pg&oe=69E24
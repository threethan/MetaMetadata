.com&_nc_ss=7f20f&oh=00_AQOlwlx58DZqa13LHK4zgsd3VYxatZZZ_3unmU1iqeCC8w&oe=6ACA4CCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8lTe3Qc-8wQ7kNvwGFwNPs&_nc_oc=AdoNGZ4pqg7p7W1sG73mCL0dEPQzGlOXVWu64KXT8VxmqsLR8t0tz8jd71uOPOb5x3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNl2j5jDCFeFKObLtPsGN_f3qL8Bn4f3FOVa8Scqx8kvw&oe=6ACA6421"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWo4G9-5gAEQ7kNvwGaUWt0&_nc_oc=Adq-x-CbX18idk-Xh00Ls769uAPDHJARK6jyB7rmSvoVLyVcNBrC483UU7wh5NL3O-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkDTRxMbYHRsnGy1GhZskZnIhPv67Xfakxt_z5uziajg&oe=6ACA5EDD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80siy6CstdIQ7kNvwEJTQRl&_nc_oc=Ado_pjpWh8eRtNDP4J7cFU6IxFPioAuoO7bneyT59PYgZ3Ub8iNS5z_Ov5XwEOtFV6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHcivtFczWkNB9bQv9ngDx2SogDHEe7fS2wtjS_CR-gw&oe=6ACA742B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foryAJRzD3YQ7kNvwH_PVhC&_nc_oc=AdrAe7nY7lA75ZycQAIpbbL2CirNuMegTnZlOQj_WiDUiUp7TuAAp_-3PDyq2jLfuQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdGK8q1_0cwzVYIxQ2a22Rem6rbR_4wYCwgXAagUobhw&oe=6ACA60B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdNZHoUbT18Q7kNvwGb9Szp&_nc_oc=AdoZGmYRW6qCf8cfY0WjZ_vN4UOdVLkINZQKbfqc34YViscHfiUzQPql260ngoADdaY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrVwAW1FB7NStV61bswX7p3r9G5Mx5fOwPDuWpZiW2zA&oe=6ACA6700"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIyI6iJf3QIQ7kNvwHzrvPj&_nc_oc=Adptf14fGwA0lCHFa35NlavacILZxFktBAhwHSD4Hy2r5Yvv94ZhZqow1Mqv7ogpIV4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMa0bV96eVeiooDJGF1rVh8gdiW9tni2gZYVF2FajBfYQ&oe=6ACA57AB
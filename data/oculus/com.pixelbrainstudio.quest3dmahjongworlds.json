.com&_nc_ss=7f20f&oh=00_AQQP8cg1ncMSPpZleENdl2Hg-I2-_lEjuViu_13acu309w&oe=6AF0884E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWsOeA-Aw58Q7kNvwEulWva&_nc_oc=Adr9Q3oTksQv9o-A9U-O950X_4lxru8s3bfx-CanV_ePIMSfh-Az_PDtchko66PxzqQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe8aAKuQc2Xpdlw48G5NEUELiKoQ71kcIcI2g8CGvBBw&oe=6AF09FA1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5_Nw17hyTAQ7kNvwFbUwYJ&_nc_oc=AdqD4YGaiv8_PNmlZslkJ4vEJ_dqHpOgFcxvx-csWVH5dyMe-xr8FfV7_CaXGkplcQc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs7gKbZS_5eUxBhL_KEigKQhhQtJS-NsB5kUxY4UrwxA&oe=6AF09A5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC4jw0kXvLUQ7kNvwE63-xm&_nc_oc=Adpndw0VozxVoMzf7nq6k_shIm5JY7Z_P8Mx_VCwMU3XxY0mVGu3So9D3K0PameYK54&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrapu5VrNQ4avd23mFM0LzKqter0Ov6wTp9NeLlUvcHw&oe=6AF0AFAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fh6OSqNicEQ7kNvwGbzRF4&_nc_oc=AdqNIWLAGY21Owryg3Ic90p9KvC5_Z8lPOStku4ei1aZQ-1yOSrmXsJy2ymT62eCyEU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfm4cftL6keUWuaQO4KEa0A7krDk-jjf8a60t8qorxmQ&oe=6AF09C32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUB835ScJ8wQ7kNvwENU4-r&_nc_oc=AdqlD7A2u2VWnucIiCCQ6N8pUBWuSQ9MVr82knJgBhcYEqqjUaHTV_WmBXVk127DE58&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTngVGXfHLZo4qSDO_m8pDSCjyKgtP_wq_CbRV13fu_MA&oe=6AF0A280"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVmkS0H8fXEQ7kNvwH95-iF&_nc_oc=AdoYuLbRBkpkaknSnaaMaQHmT-Ga5juZ_BBeWHiNEBMA2XQzakallEVFHre5kVMUMWE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyAlTSv5EuDHvxVw05JQOnhQiWj5RasUU9GtWWedg7eA&oe=6AF0932B
.com&_nc_ss=7f20f&oh=00_AQRSG_fqa5iM71TFB44I5Wwf395QQcWQikfae6u1Uu63wQ&oe=6AEC93CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcrN3ERJEXwQ7kNvwHhAOAf&_nc_oc=Ado8a0ZfAjzksZHEuDYNUY4w5C9llYB1cZO0cy5H6KPNTbV0Crow6zDqBLGu-JB9v0A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUR-h77jUpibOaPR2yXKHuBdjHyQLk-JLifdsoc2eDbw&oe=6AECAB21"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4NicwFyn2AQ7kNvwFkGa3w&_nc_oc=AdrVXGdy7JHRKYVkQ2gLtt1Yp1CQFbSJaz5RPpFknHtlMfIpVHEPbuiGXzvJAIYjV2I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLb1_QVVcq72CGhPdWGcYOkpA16luhvlG3n2z6nh6chA&oe=6AECA5DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zOtZIPJ0w8Q7kNvwGac2D1&_nc_oc=AdrwZ_8-MshrmQzfbxGdg8gRZdRSdlj76Da4PiVhER1GQF6HFuiO5xWisyndSaTytzk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaEsnwFaTMdqiQQVNjwZcBNNU-glGOZv2L-MKq89IxHA&oe=6AECBB2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5-zVvhQXu8Q7kNvwGMftyl&_nc_oc=AdoVcYrV0xbrnTKFYYpXw24qG6W18XgcOylVcypN2Qa50dMT2WM2fGhin92EMrk7zrA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDIL3cNHiBK2S7P912WJQqvbIL9_WhdBlHOXhX9lrmZg&oe=6AECA7B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHoGjKRomp4Q7kNvwFKtLGO&_nc_oc=Adrv8fV4zGS2gNCjeOVad8JVtXvjJtR_Ru8bn3V0y4VO8rd1r_-GEfpjxByGxWCgBkk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQPS_eoaLwAqxHH6I1xxN6T7Uk8I-sQOq3HeMWt8PvmA&oe=6AECAE00"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slkzSb_7NlEQ7kNvwFV_bTh&_nc_oc=AdpLIsKvQU5suey_24wzn-rE9SjEmZ2vBKck_bg9UDwYXXAm6RUBckXjjAQXAnhvGh4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXSNdxTBMLKwvYJAXfwKd8kcNxW0nip_SbS65KmDRs7A&oe=6AEC9EAB
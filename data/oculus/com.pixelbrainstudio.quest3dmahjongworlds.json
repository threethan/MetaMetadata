.com&_nc_ss=7f20f&oh=00_AQNcLCHg2jKzK-Ctu9jHki5wsthofb4Zot_-7oeKmX-MAA&oe=6AE5FC4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Zr-WHqJ1HUQ7kNvwGXHf_C&_nc_oc=AdpU319M90E-wi1UuLfgn-p2MGsYlWjXQIW3refddpBOgpKROk4w2aujhblXMzIX4Qk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8LGiK_7OP1f1QzZRx76qq-4d_81UZ2E5DZEAcM10BCA&oe=6AE613A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgnwWo7srT4Q7kNvwE5VjSW&_nc_oc=AdpGTyy0QCzDPt8AjgXsAZ1jlFAAIhjecpvEmK8uWEFBnHrnS79uvHCKW0-FdPjpnQo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg7M9CSvwJgeJD9X6ZuVL7eZUAciQLGTxaikRon3oyFQ&oe=6AE60E5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNoc9BwdCKEQ7kNvwFVZDPc&_nc_oc=AdrPHSNi4GUr7MY2L0JMO18ti4dNQdmi4X28O7EnW4i15wzU1_FaWaUI9Qz4FFzsEW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4qYBZWfeZ84MVBljC_tT8qKECzoG9RZtbMM6-m1DBCQ&oe=6AE5EB6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6sRjn2bjMAQ7kNvwEv9WSH&_nc_oc=AdrMjV1sKtRF_9t2yYh17E5_4RP4P7jihzQHGNDtqvnhSDs9PK4u-ybgfZJoOF2B_mg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbikKdn0Occk-qExP160wngi5i7IwVHBOliL62LbIqsg&oe=6AE61032"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXiIPh1laJcQ7kNvwH9lB6i&_nc_oc=AdpVdeQcgRhwNBYLJ2qInDb-TXZzdI1BuMLc79m67yZhv3kyNOuqzuyilKzJ876MpQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnqoDH7zJjK2JqQ2QNxsBjtBBPpUKyJ9MC3GUyHpG88w&oe=6AE61680"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=078P57vgCxEQ7kNvwE6ApTz&_nc_oc=Adrrd6OHEbWxUTov4_e5_tewY5V1e06o7ggC6AXvsXLprJC8srby6RafuTKoLGNR_Xo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlQRkLBbEFtQcwqQuMKYw_DE-DBHWJQFMgPf05-aa1AQ&oe=6AE6072B
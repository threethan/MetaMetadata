cdn.com&_nc_ss=7f20f&oh=00_AQDrr_lXx98CDoTnTZ3ckYkSCUhvam376eRHDmQW_jJxQw&oe=6A4E5FCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8rFquAJWKAQ7kNvwG5koOJ&_nc_oc=Adpd1uqoNUyuEytrCo-Tw9R_nkpu-iU0Z5kRDo14rjn8f-q6eYDGv6rT7TRYM5i88lA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuZGhagZbEKafd1DU_Hf3GnThZOnv-UnUkEe7c0RrkWw&oe=6A4E3EE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FR4JlFDKTEYQ7kNvwEU3IcX&_nc_oc=AdrZ3JZFGKZwXM4LrsOjHFz7vvbg5ERfKqgsIS1-PACbAqjjuk5pBemMpZKViI3OY0g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAWOgTVN-9z36I3HiYPUH-SCbtZNPieU3Bw1AGRrAzOA&oe=6A4E399D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmlT34JhAhoQ7kNvwFDAYTr&_nc_oc=AdqQldr_SZDktn9Vf0OVd_VxQ0tNVkP98UroaulAH3V6QTsD_gGWYEggj-QGih7QmF8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9d2MXq2opHfNbp9PY8KlRpV49jPvKMELDuJfEcLW26g&oe=6A4E4EEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyC0Mc0gSSMQ7kNvwEpc2Oa&_nc_oc=Adot2kgeVi7TWoe9zZmbo2HV2XV2Mz1i1yrCD4dK5uzS3d_OeVD1DldrPzbdf2hdP0I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkY126QAW638ElN7gmxpfjKB6SjQ0lKOrqrguQOmJtLg&oe=6A4E3B72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SW9KNgeCKMoQ7kNvwEc0krg&_nc_oc=AdpZtoLDZtJ8JhYHeCsD5uI1tOurubWoXL8dEDX-4jub1S6BmQKv2LvwUuiM9kAGTwE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnVZ1gPtoXn3HhXaMtNrF2tZ-UO4qOIkiv419evHLr-A&oe=6A4E41C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eruuGRiLdxkQ7kNvwEd-MR4&_nc_oc=AdoizWfE12sXDR7_6eEpvTai8T5sJUQ1FuS0rrPYhnYVAagztMZ4pyPoFSnDm0XuKvc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7hGlrmZhMFv2mHqZVu6NzH2hDk2gavTrjEBQJTFtJEA&oe=6A4E6
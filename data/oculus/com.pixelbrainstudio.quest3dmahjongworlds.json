cdn.com&_nc_ss=7f20f&oh=00_AQAWTYaZV0iH3u30e2IGKdS6p8HmBhdq0YCwUZaP6Va9-w&oe=6A52544E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3udw8eJlSkQ7kNvwEg2YsP&_nc_oc=AdpWHx2V8pRv4yfQhiw0uVzX6F2ioJHBlkVoGTLvn3kK1VJEojNooaAkMo0nr2ocJr4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCYQOlog_VCtpY7lwS2U2dHUSoAetyn-0-HjUk67V2Nw&oe=6A523361"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Al6Vb2Q_tIIQ7kNvwEYwBcW&_nc_oc=AdpgRzglIETEOjfWWUMxRvAvPz7U0DaoaRu0r-v8cVJcNX5KvAhCuPJZFM8H25q0B6k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI5Z9C2jSeeah8G2B90NAxpmzzmDw7-cSb8qbL4bBoaQ&oe=6A52665D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOO__zrT4qkQ7kNvwGiWIXR&_nc_oc=Adp7d6mKcPZ63aJcrnJppSJLmahO6_Bfdl64HPTcrBmWjFM1jp2-E5qRjprvkfNBDuY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTMkgpgGzFOHVum-uBUVoFda0LbgNLoM-8HvgIQ330rw&oe=6A52436B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKNtiV-GeKEQ7kNvwEIvMWO&_nc_oc=AdrCjB4lbU9QSBfYlVu9fAgIWQHNte_5ToLUcfBLF1_bXyjFEg9yHH6XTDXYXTcE1_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASrFZhtSPQa8FwTHG4LFrBjQ6g2emizX8yYttrp28IlA&oe=6A526832"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxy8vwj3eV8Q7kNvwFco6Mu&_nc_oc=Adr614VsHnKzlQ9hAa70CJqs8Oc6mrXjlOJrQU582kOU8RK8K1zcqbW23-XgMpm3Qfw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvZVXMMdAt_QlIoNSsfnfas-LyJ3pNZQ_WX9LF2OrCgQ&oe=6A523640"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fet5TeDgUAAQ7kNvwEI4OUG&_nc_oc=AdrNyMJKIc9Q-blU2RyL4eIW4rmLr1vWW_TcTZEf4PtZzuqfJnNJVB9_04ZqF8fNXVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzWCZdwsVl9h1IoL7OqixYs9ohIUFPAeNprxS-5PIYnQ&oe=6A525
cdn.com&_nc_ss=7f20f&oh=00_Af5ZiOyimN6WjF8w6YAZCAYx0ltuE8NYuWMR-K342TyF_w&oe=6A072ECE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fZ0DxVUasMQ7kNvwGq-MV0&_nc_oc=Adq8oiJKnLSUA8hK38xagDCqroPzXjw_7mAp4HARSXFY3kZpaassjUhpVwl7cxOVHag&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6esAHOb-4oKvkAbnokyVRO5brEVUXahDAJddjsUgJxQQ&oe=6A070DE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wgqx9RX_EZ4Q7kNvwGVwdlp&_nc_oc=AdpiQ85Ysc9tVdcXBp7JCB3sn2D2JEJCCH6pG2Ey9FHuDwnLb1NU7dluOz1FHgGiHKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7s--73fR8CzuYX1t_0BO9gHcUo9ypJTfR_qcdn5Ma50Q&oe=6A0740DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7YMXdPGwqoQ7kNvwFDUlEG&_nc_oc=AdpcdhCCZYyJLOB7My5Ga7PiC_29Nb9XddioajeFXfL-bydXzACN82olJeMNjHTb6O8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XjBve8MMpQ79LPT3mzyZ0SDU5zqINlFjkC5WRWs-S3A&oe=6A071DEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBu0mm0ZMowQ7kNvwHwh7Ve&_nc_oc=AdrpR13HSmtI9mFIwHxV2jOuXZ3V_UGQKHwaMfKhTGGbBF7OusOQ5jA5fvfdvGPFkUM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49HNOhnHGLUO7Szbz-f6crRVmi6o4UKvL8cHqzb4iv5g&oe=6A0742B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQiIH0qVamsQ7kNvwFF-ijo&_nc_oc=Ado56_tPDJJsIfVsXwU1ED2Y-ekmk9VIo6bcd5Vsw3o2kpL0x-GuqTqW5aJhACi1B4E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ybuhuqbLhFOXeDxU4jvsOPWt5rPzb0pl5LvEqPLLJ4A&oe=6A0710C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EogkvEXIbokQ7kNvwF-QlIa&_nc_oc=Adq5NwOimxHdyzHc6YTA0mREZwFyAS-e0pGD6lH4hQYcnEE-pdPF-IAKuLynfqcVp-E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_LK-iZvAJgc6pS7n_Hq7JrPouMz3TWpEJRsB7tqe2Dg&oe=6A073
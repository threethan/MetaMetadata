cdn.com&_nc_ss=7f20f&oh=00_Af6cxPDtjaZT2497Izn-11xjbFbNNuODkIi1Pc6T5l1jgw&oe=6A1D984E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UopkW9HcvDUQ7kNvwEh9cVO&_nc_oc=Adpa9Wji2Fh_EfTg6k2HWgO5vIdtv8HF04FzMpXO0wAfqVJ-5PAZWLzAieaXHqOX35w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cuB6V4pgEQdQLxcGEezzpoWiowR0UZGwDfZi_sfGdQQ&oe=6A1DAFA1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrqKyi9tmnIQ7kNvwGjS2MP&_nc_oc=AdqRLhcTFcahRJ3AhPGdXWHJvlP55_qdSr6JrQbXemUej3jlsWpNrbBAuIbgds-29SM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af633EpJpFnaQNVyzR7aboRcmAJg4c9INYgRFBDgN9_UUg&oe=6A1DAA5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrAoJhhDmNsQ7kNvwFlLLuA&_nc_oc=AdrmWAa1TaX6pLlk_bYN3npGiqXr_GQZIfRXBT1N_49V6-qcOu7tz4NiE_S74ezMgK0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PeMLNZBwpB2xK-_syq5narBvFj0SGznObjprzOviENw&oe=6A1D876B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0FbgRRoybsQ7kNvwFwIeAV&_nc_oc=AdqBAyMHkshiLpb_wB_LtU07VUpTUD0bLSL0XoNorddWFKT69oSEMflN9xWX96oyM1w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bpFsh7-iuHn5GDA5jfEr3Gh8BpmHJ7DZL-DYBQ5cYTw&oe=6A1DAC32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oy9CsJ9d0PQQ7kNvwHWT4bS&_nc_oc=Adquj7tD8vPVAXOr4jrbmoPeL49XlCX3FbK9Op9ihPd8HA7VKYd72Ae5z3FgOdKmlac&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5br12NF3Cwrv5giIuVss_6aIZ8XY2tG4wYy_dVaMOJzA&oe=6A1D7A40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsUXSYDV36oQ7kNvwHo4YQ1&_nc_oc=Adp4NKRXZm3FVa-TVAbGD9O6wYigdVTSh8A0jrdZhigpPM5SMjqqxSPZT_ZN4Arp-b8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r9Wj6Sp4T07qqzzoIh-IqDf-xEsIqftgxIULtV1qpSg&oe=6A1DA
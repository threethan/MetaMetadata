cdn.com&_nc_ss=7f20f&oh=00_Af_Tzns2Zz9H73OAuhwwdRmYQtpHX4EqsbEywQMI7s4v4Q&oe=6A300D4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alapyXUuwJoQ7kNvwE30JMz&_nc_oc=Adol2bQRL5rOoUJBNRlcaaUdZBg2vXaiLidjbFHd5z64ukdAIAE8ySCeK3Mo7Y6HcqQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uc_lgIvsH2-IVPRGvUc9D5-kFw44lKGEfislBUO7L5w&oe=6A3024A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzzIQMvuY1sQ7kNvwGwj5Ro&_nc_oc=AdqNrV3Z-rJ5XXEqW77aX3bKIemQ8JPJD4VzakZnt9hQqWARULvBL1B-Jf5MZMAgz0s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kUAgBsbCxwA-9U5MHCGDC-UxaJGs-kmeWftjrzhU5QA&oe=6A301F5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KyqzMs2TgoQ7kNvwGxQJVp&_nc_oc=AdpmRZW2L0NdrwQJ5aMB0Vl4XUE92atymMNrTT3yaOeYHPVvimcV0Hs3R61sIYMrd30&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bucj_GjEDh1enY3zV_WcOIbTex_CFReCjZJTB_8RLFQ&oe=6A2FFC6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sz0Daep8MX8Q7kNvwHjA77d&_nc_oc=AdpMI-x293aBNnHnfBhlKt5zBIXw6I10kC6ko78NipTUTsTCqDhfKx6dteG89gKNLm0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GI1bv1HgvhROqo94JmgLJ_8yhYsYFq3BVJHkiq1XLXA&oe=6A302132"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8awi7OIbn8Q7kNvwHiI7dP&_nc_oc=AdpNDZehpHybdKmYwtJsG15ZPFUoN59qXgPv1KikwnIUDaD2eK-eVBMMRlJz5zxf084&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B3T6GxLjzUZzQ4t0ltiakmbeZKDhNjrFSiu046xqTaw&oe=6A2FEF40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-QPSjuKz4MQ7kNvwG_jHJg&_nc_oc=AdqxlJ3VAzCMvKR8w5aK1Tg-ezZukKbFoBWCjuvxsNvqWbaCz-Vh6eSOUBdcEtAlJ8A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hzuaul1z0eFkieHRclfzDJXrsWASFtdcAaBL1aIGCRA&oe=6A301
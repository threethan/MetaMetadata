cdn.com&_nc_ss=7f20f&oh=00_Af9Rh7FjaB8JDmYQMFaLVx1u5SuDuwAUyAZvANi0nA-mHg&oe=6A3401CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TL7m0WmakrcQ7kNvwHj9ZuC&_nc_oc=Adqb1LE51vXD_EGR0aj4-Vr5uWCJOOfHkeTiJJSiwhNvqmRNxFf1mhPHerBl3HCsE6M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gLn0hniqY8z9fiNL9MQx5tABe0LFr1eS-iMqrhHF_RA&oe=6A341921"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1UqJ_reJHcQ7kNvwHArAq1&_nc_oc=Adr6p7G3pSiSxmZJy2x701ATZDC6w-0v1-xf0aLrJ8qDHOosbacBqPjwTt6X1LYal2g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VuaN06-oZdUVj_uWO7U7tW6PdP283iH6vXlukuuJ_jg&oe=6A3413DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szKI02qht2oQ7kNvwF4PpTB&_nc_oc=Adqzx-tP8XS_KoL1EcQUE8LrcE1wLiSSuujstwN2wukL9_kzHkgBbrqSBk2icRRNbXM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9H7lBaM5zUH-fKNPZrJME0AKqlhwHeAf00DbM_YEO-g&oe=6A33F0EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGzo9HNcAfIQ7kNvwH62RVE&_nc_oc=AdoODKRbSoWxmkS6JAkUa2JezhZzHtxQcuWOKYhwo4jPMJDxCd7hyRy8c5lTQFWqQ2Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oqd2sHptqM5KcWLEkWH_JI8OvtfKBdb-OujALi-j5ng&oe=6A3415B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elXw8vR0FfsQ7kNvwESd1kC&_nc_oc=AdpaahzU7bai5MMMZb4MaYdLqTHY1PA6yWixGQjWm5l1L01S0CuFqqCGApJvDWomy-g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wetikUVExhgx76MUCDVvRc6jX3APMdlbdRGid5pUQUg&oe=6A341C00"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmxxYYWhsasQ7kNvwEphjxs&_nc_oc=AdqQwahF3uOj3Fb4JHexRafEMzQXNL1Of3eA74NTCxnbVNlAghCw4M22RgkF6OGtDcA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UOasUHvKWPq7QZi41CNlJX-pH6A5GskP3QaKSh-kAyw&oe=6A340
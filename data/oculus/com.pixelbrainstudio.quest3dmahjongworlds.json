uluscdn.com&_nc_ss=7f20f&oh=00_AQKFA5lHa57zt-QZKJJlanBnP49RoNQRhB_2yn9pEjFwpg&oe=6AA9574E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-ZnoakFuVIQ7kNvwEBNPiO&_nc_oc=Adrf1uno2frh3vxm9Lq1lQA57P4RZ95ERMzrPgPIcfGZfZb7RdhOlqmkCZs4j8De8rQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJItsJXVabl3TadutEcpI4wt43YMfj0WSMiA-JNikjCqg&oe=6AA93661"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GxHUunSv9sQ7kNvwFMlT82&_nc_oc=AdpErh2M5fDqhJeYUM4qgEdaajX2r_PPipmxCatuXOBTlQAeshz-dtfv1F_SeAOZLN4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFLrMeC5o_B3p9nHwQP9Ic0bbZf-1DWV0qibc7iyBQRA&oe=6AA9695D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UF-UlOI415IQ7kNvwEzVDqa&_nc_oc=AdpElRJGhq6NZbiG8Hpn4rH6rZ3sHhWrvmqVIUi9D_yxwNIcmbn16KQAdFXFloKKRuw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFS3En1-qLjoEAQf1k3XpQhyjIRZqxiwT8u3lyfI-Lkg&oe=6AA9466B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8prpinAXOsQ7kNvwGTPant&_nc_oc=AdpHu7fMjYbT1EyX86O7xOYTMGQ6P2zBzoF4qzC1KgbgKWpwcTOzaK9tz2zwxlFSWwg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5n3X_umB_o3hoGdIwqNvr8rO_GQRu-vXFf-OjWKElzg&oe=6AA932F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4K_uFRdkZEQ7kNvwEujMvg&_nc_oc=AdoQuVqW4LJFsHb9c4bDHnctLXgU9i-WWsIQnlKqTeNV55pSRLoz4oBCv2BC_0tkdCU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPiFMsQawXH5qT409-3xyj_QvT7kTKOUFgzKqrSc_5Zw&oe=6AA93940"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJhIflGFLWcQ7kNvwE3iEjJ&_nc_oc=AdrGOSzOuX3AfLcBxbJH0kiP3cSaQRFptwl8Fsbz4ypPHg2PZ2C8hZsio-TDGZhgzDc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ63rdc7BqwieDxg2Gwt4LKY4n8no6F-BfDyrlcJUfLcQ&oe
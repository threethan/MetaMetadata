.com&_nc_ss=7f20f&oh=00_AQPHM7JlXSgmn6aM5I3gqHTxBi1Ki03KaC5mBjhEWnIELg&oe=6ACB9E4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8lTe3Qc-8wQ7kNvwGEJygt&_nc_oc=AdqvFu34PNTwNRqXqWn-V5JTyj8om6WtnsPErn3Mcvm1U61nLzlNJBErt1OFelVMcaA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlz_l4J8I9Tw34gWtK-Ns5jbyzLyzEbb-Me-thVdHVuw&oe=6ACBB5A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWo4G9-5gAEQ7kNvwGulHOl&_nc_oc=AdpSBm2we-NAmY5DRH5NCcjOyPsxekMFI3QJFckVXFzo0oSUdqt4sBNfF8ndd9IOyIw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQ1wYuvlmIBFNDvzi8FdXPRIUswORVP0JohzmK9TVFlA&oe=6ACBB05D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80siy6CstdIQ7kNvwFzGZBb&_nc_oc=Adr7ucQE_w4ptVRFs3UVjiXjtAslOkxzHhnmQ_IIWgGC6r_f0TwR8Vbhcsq7kPToZc8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQHpJwDLliA6W2rCt0PODrf-n6z3gSEqva__dqLO1KoA&oe=6ACB8D6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foryAJRzD3YQ7kNvwEFs71-&_nc_oc=AdplUpGq6KI3nfYpRu7_KOgUuFntXW0k1AEUe69oE8ldIBEaczX-lpRHuYziXAYPuUU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzZIq6vNRD5c-ULIE2EGIFr9oU33YMAofm8rwYf-fKEg&oe=6ACBB232"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdNZHoUbT18Q7kNvwGWr9mA&_nc_oc=Ado-wldlL0UY3wVCSZveILeSsuCHnPlaEg84YjCW_TVFJ6WuHoeYKCoSKONpe_owDmY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyUXqdRHblO1Qmuhcm99-AYLBIj4AEBK4MO3lpezeuaQ&oe=6ACBB880"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guV5CK8pkpoQ7kNvwECx4i7&_nc_oc=AdrQtjqcbMNcBuwAYPkceBnysr9M1hAnrvaDnFbLmPjeVRzOQMhBsXpPy9c6iNFY9ZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-7ssM37Adt3RjH5FhH4kR7YpPKtr_1DxL-wo6FKXq7g&oe=6ACBA92B
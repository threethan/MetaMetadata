cdn.com&_nc_ss=7f20f&oh=00_Af7Y0zumrZ2PFAJdEEu0mrhCvHLyxa4ov2hiSzBLZihLKg&oe=69FDF44E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjX8cl6N05kQ7kNvwFGdOyv&_nc_oc=AdqSBlRLq6alaq0Mf4_tK8UxnWWK0DXrfoGuRgIKMSQ_MDfZUkjb3_5WAhX_hI_G8uA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xBmg0oBdgnDYGqzUGhdfc2ze-Ptbb-bAkHjPO-SIsrQ&oe=69FDD361"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qiIDJ_081UQ7kNvwGxszgv&_nc_oc=AdoTTaezSIlEFHYHICY3Y_rDobviUzswdfbIjNcqDyGNBtgbxgQ2fy0S0N9U5sGC4tY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LG2hVZuTHQtwflcFiC-edxCj_EIlO0sWLeYSVJlj31w&oe=69FDCE1D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fr6-nvdiF30Q7kNvwF3bdpW&_nc_oc=AdqpXhL-4iPrz1_RxNEIkQL2HSirwPLIF7ybYr0fSocYoAlZjNOfnIyk4qhOaeoBlg0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af722UYUe9ZeLCwJkRr_y20zuJoarWr72TC_cEW1VMFqZw&oe=69FDE36B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5tHt4EuiKoQ7kNvwEePPpB&_nc_oc=Adr7Mn3zShxrQqYB6fRrck4vxHZCZxOMbs_4Rby43uuBHChAetrbOXm6eSYdQImd2t0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ajrM37Qpem7X2pSg3F_xT1Vg315Auh1HnHOYOU6n2eQ&oe=69FDCFF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9ZknTyS1ZgQ7kNvwGMOKzG&_nc_oc=AdpzFyWBP9avhrTtI7VJ3l3LdMANDtt5RhUE9h_VbTqXAo3GGhh0lBXDJHnnuE-RVkY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41brVS7imKl_jyju7gpHhkRBuGxVflpJmNdSZbP3UasQ&oe=69FDD640"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkPEjhNsE0gQ7kNvwFlixvB&_nc_oc=Adp6D8Mwc5ivFY043TmZZplmtRWen9fh3OnTJpvDIIAOzrJBDeE8fsmDkwHTHzGOGzY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hJDlwgVvNJkNOMC0M9c_5ubfn6AwSKLRnCMjjhNALpw&oe=69FDF
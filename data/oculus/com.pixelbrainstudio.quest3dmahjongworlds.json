.com&_nc_ss=7f20f&oh=00_AQO8UhrbuCtuVMjnbxO3B7OBhmueX6iS4b8vh4GESPlV3g&oe=6ABFC0CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaB7LTvAiIwQ7kNvwFKV3lf&_nc_oc=Adpyav5i6AkYID5vviGRcYp0a9BEwyf9qhQDZKUq9CD1zcHVKg-6_FT5vK5QHhAsNqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORn21y94I4IcPBMo1Y_aftZWkACJeMK9iitQdSLP1YKQ&oe=6ABFD821"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZudY1IwRGm8Q7kNvwE_SZUy&_nc_oc=Adqpu__FaBNe3D633ZNn7uGqYEf2UGtku28GERISaCpPabHW2gXOC_o6thZOyJvam4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlCGo10rwxa9X4CSPjtZ05QVd4uagKV8keLlBp2YIvgg&oe=6ABFD2DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cN7f3dGreqcQ7kNvwEgC-z0&_nc_oc=Adr6QoeuvIpj2gAGipIKPVxCJpMGbn1Rj3Mh1ml1F6eT39kFmxCoRI-sSnjBOoi9Hn0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0-Rs1qrNfg_aXz8Not3RjQzK77H_ja-eeKWF_Hfellg&oe=6ABFAFEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZAgi8ACrFQQ7kNvwEhjMHb&_nc_oc=AdonccJU31sL075UjXpAfdfDx6rhR2q9DP1AhZfD8zQjbcZNh1aFMjgcpsqw2HuKIvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMG9LeVZc1Xg-nz8sf78GZJMCa-h7Eb7Pf6jb9N3xEOA&oe=6ABFD4B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9_E05D19m0Q7kNvwG34IZ9&_nc_oc=AdoLGayQht7pO0oZakUGOngS9R1lU0D3yZ6tsdVu3hW2tItjuss-y_LToQKJDpFsqe4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMG_q6Q0YjFgAsL_DrBFSft5qvi7RHfR56dy2S7WaxLzw&oe=6ABFDB00"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcwfz01qP_8Q7kNvwGseBB5&_nc_oc=AdqvTjDggC-VydNlu6p50EEnlHXL_P24-S1Cild6_tbSx5hbjw7mKwYPBkOLnFdP060&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx1bWQ0xTJNbn8janBYohaf8qexA0UNg8MN9kxvvUzwQ&oe=6ABFCBAB
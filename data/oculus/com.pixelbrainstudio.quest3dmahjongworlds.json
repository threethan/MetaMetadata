cdn.com&_nc_ss=7f20f&oh=00_AQGq48ghl4g4kAWMFH2e28g09prp4ibApEpZ-KbR9mJ9Vg&oe=6A7F274E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuaRhYYLGvcQ7kNvwFoSev-&_nc_oc=AdpynXOA06PLyUTSlxaZKxMkJm63Xc6jG5hwW3japcV4KerKN7R3O9tfq8Vrrc6_hjQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbiTPzmIsQ2jNQFpJE3j3JPVkE16ERZW1vSbSaj59tHQ&oe=6A7F0661"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EP5CjsAlwsQ7kNvwH8wJps&_nc_oc=AdpBKt2YM3_E9KnS3frCdUXo7Ow2qJqAvvL4n8FbHlvVeKRCiG6I0lKRVMfBX3-7BPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb7U3eybe6YNLSnjR7Bi4p_aDH695deEkX0usWgdriag&oe=6A7F011D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1mGFy0tnoQQ7kNvwGu0lZE&_nc_oc=Ado_Wu9ur-HXv8maHJtuIRgxmu1oqY6vE9DX0gqncmiERL1Sc7wYBjnYhpli1pVKtYY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMiFl7UOc-FnOkpZFQnYaIDeXY25_2s54pdHLe4OHWwg&oe=6A7F166B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxrpFVHdxZUQ7kNvwFUijG9&_nc_oc=Adpd_trvds4hgCz5ISumwnEJLon_Mzb8bZbVjE6YuxME1JwWp0Ts-LWYoK5rk5aiXKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHs7WWfLO0UQU6voBoAPeOgWU-sJHE_cRKlqRMV32szWQ&oe=6A7F02F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeEP6WFx2vEQ7kNvwE28Mxt&_nc_oc=AdpfaTI6oZeuAa3NtotnNTlWRvXY9wGyVvwr3HDsDvbbAz63lPWxd_w8IU4MRg0-knU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGW5JPuyjjq6ZXfQmI_qUiyUNJ_8l6xU1Yl6N4MjSaIng&oe=6A7F0940"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD8EmkHkWDEQ7kNvwFXyr_K&_nc_oc=AdoQFkZnDV3A0t6AJRQJkClFKXoQgkgZvcoKJU-hPqCrEdq8zYLKEAJki5P339z33Sc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT81k36RJoVj9CXik8REIyNbSvCaJZIny5q_cJkt1H7A&oe=6A7EF
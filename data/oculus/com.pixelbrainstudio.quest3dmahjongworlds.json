.com&_nc_ss=7f20f&oh=00_AQM4kBi9a0iPijO5bZ-IjuHfYdXyNSYoJwTwaZb5wW82DQ&oe=6AC3B54E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=df7LO03mBTYQ7kNvwGSBz5N&_nc_oc=AdqTCPysyzhWFJbMU7i2mDdarscwCZXKn2_nhOTnzl28J0Qfrf8fVnw6cWJSlZKP5W8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxY1P4oVaOMy_bZ4W0UG-o8k06UtsP-o3KW4BvB7-cSw&oe=6AC3CCA1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUkDQmPRgUIQ7kNvwHPxSsZ&_nc_oc=AdouvF0sKN6awoN4eG-Pl5LR7I25inwwCrNeRdG3dpaCUFxHtOzaw5Z6ZyGq6_pX-LM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOeo7eeq2r7Y-OhgikFvblDgDsieEqvaIwHSZ-0w52oQ&oe=6AC3C75D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wxeY_mupOAQ7kNvwHeRSB6&_nc_oc=Ado-ub0sPb6tA1dA1Ub98FHJjep0h85hOHJ8dwR7cTAnKrzjbBFYNE4mLsVu_Hxi8PA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN54TpeN5zqrACa7hD_sxd8BC27PnbCvhZyO-FZ2qVvqQ&oe=6AC3A46B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kna9XvlTaq8Q7kNvwH-RrWt&_nc_oc=AdpXLWoao9RBfHZZtPK0GG_V3GKFlKNB3wYFDkHhD66PNg1tdQ_sA9MuCaESj0dE-Os&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUkchq-E7gs_lh273DPx2XyD7BTEAnnnGNJnhHJZRgjg&oe=6AC3C932"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_ee_LVy4jEQ7kNvwE5fIYd&_nc_oc=Adoq_XF5nwtCKxTvMUSg8jtcn87XH8-LPTQBppAz9CuId4LiXdytmB0yNTLZ8jaVAQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqvBZvi65qzqlI0vI9JD8NFSshwqnrtu3PmsclQyqTuA&oe=6AC3CF80"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrUQA4T5L88Q7kNvwGVszdv&_nc_oc=AdqOlI6ed8mKHtYOfL7drOiP1PFr2A-C5XYnKBgFwAll187cbKPemH3qduSzpgU_98I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHyS_VSq-5KvCKsXKzmWaHqluU_NPUGlfaeiv1l4sqww&oe=6AC3C02B
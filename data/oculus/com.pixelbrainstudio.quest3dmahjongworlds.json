.com&_nc_ss=7f20f&oh=00_AQOpHQ4tIDwuDoqAQDBbFPPWJJK70L7yuhIpvbghLMWPLg&oe=6AD235CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcIPzy84h2cQ7kNvwG96I6s&_nc_oc=AdouXb5TYVQPsGd0bPD88w_giekPIQcJsgsmkk8uC6tQlKfxouQOMm3ehctv_8Skcaw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-kMRH7ZFQNgOLXib4IkUOTPY4OxypK-Th2pmEYFk5eA&oe=6AD24D21"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXJIkuG1sZsQ7kNvwFj65Oi&_nc_oc=AdoCwqKjitxT7GG0DmfMDerUAoW0Dgu4fREQnYVh6sJPWoAyQdEY1JdduNxjqzPjbZg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIAy7teYgpBbysXanyt_cfHWIaqpefYRDQENhbO8LQ4w&oe=6AD247DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGJf3YZe0v8Q7kNvwH6q90u&_nc_oc=Ado0yVQv6UOwFq9dRL39KmdxQMYOEUS23Fm3vpHsa2r68M60BU8rIN7WmdlcM4eJAvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_356TH3DVkyxIXeXFfQp5LmuaAY5_8HLKjrCrI9vmJg&oe=6AD224EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YThAxWNnMzMQ7kNvwGOOFde&_nc_oc=AdoyTtH6cVopAyEUVhQ1cl-fBQhcSWk7saZeLVQ7R9I5ei0IU0Ceky1T2X7-EQZkBpU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRkMo21KIGZ-5ZCefC6EExZ7FqL3tCSC5gcux2ALhFJA&oe=6AD249B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhRtoGs2XvYQ7kNvwGcfvpA&_nc_oc=AdqbIYILDCtHrZYbs6SBNG6pUWVLiZGMh3EMgJ__BuRxDBR3Hzy0Fm9xKmMJBxtKnws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuK5jX6Z_b_4vLKOCbLTKIoXufw0PpVp6d6PCRobEJ0Q&oe=6AD25000"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDYT70I0D3gQ7kNvwE7ch8h&_nc_oc=AdpUovuvYsKoxatHppulD1tvuAyfro2J8nbUTDAUeUN4-E4kqS7ujfBPOzHHOaXiUbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA_SahtL5x_Ttj_gtcWsE0A_b5K8yhIM3lybbIPv10hg&oe=6AD240AB
cdn.com&_nc_ss=7a30f&oh=00_Af0Ow3jjrQhFbA3eHm-UOFOuW_MfLRKhvFFfonDXi-Gewg&oe=69D3C44E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vtY10DVIYwQ7kNvwEu7_Xz&_nc_oc=AdqJirHm4ywdknQ4fQJGZsOuPaZUdXn-wh7vPWqcf_5SGS6EnbX7Pp0iFbLrqF5-ZuA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AxJxnqREENUmXSdgdRB5bunsNHw2vQpHyAj6POIAF_w&oe=69D3A361"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZJPEGBje8MQ7kNvwH5Qnul&_nc_oc=AdpQ1I6z0XGuTztas3pPzrkJkSkx3KkolR204GhiZOsv1RBh9Ch4tzUXrCQLQ2GglvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GXur7gL8hmNz2iVDn05ApUTHF9TA5dWCG5BPZQX4tnQ&oe=69D39E1D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3JhA68YAJ0Q7kNvwH12h4u&_nc_oc=AdqdqGqQMbisvXqIBESWzIXqtgY6Ty7WQNAB0J0i4ywo8En2y8U2IpfIR7Trq9LzcdI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ylCZETj5fpdKQnRyOOqrIyNw_gRoY-8ttTQVPTckKLg&oe=69D3B36B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3dgbkwoFtEQ7kNvwHzLt3y&_nc_oc=AdqHKi2uSTcxU41SEtQHcp-xfMdCmSxtql9qt5t4sTpL5-SUUfQFlHxklDlYFIGv4xE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xoqPqQePkmgktz2jkO_HQYs1i-XGBYLuhvM1KTJYZzw&oe=69D39FF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyQCvKB4_ykQ7kNvwGIH176&_nc_oc=AdrZH1rls_BmqanElAkZozrmyjPf2jBKG8ou3C3TZu9vumeii06JL_Uy41E2t09OiyE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jU03a0lnIGYsmHUHuHLMN3qf4AILuMJiJX3TibHNgZA&oe=69D3A640"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06phwcbHbo0Q7kNvwEiMEGe&_nc_oc=Adptu708tJtVncaWnB_YV10gddAtIYTA1UpMzdX8HTKp5lmrcww8sx924gvFDSgR_v0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XTXdtSskRFL8fESuk8Q4EunSrlg5HrrY5mtxTbUbXlQ&oe=69D39
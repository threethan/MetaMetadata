.com&_nc_ss=7f20f&oh=00_AQPwyWcSMK4IrLleU2cdkoaHcVx88TfoGhTTF464iCpTfw&oe=6AE4AACE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YlnYCGLgbkQ7kNvwGviIqP&_nc_oc=Adphj_mYjjTvilEPXKlXbjhI4j4gRwOhpSjB2oklQID11sKDcJo-uw_PQTDR92CqHp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBF9IvDSt-XQKkytfwjSAKxEiHGhA_i4lviz11jQbIeg&oe=6AE489E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgnwWo7srT4Q7kNvwF0_A_4&_nc_oc=Adohvd-_dGSNCe0HxS0HX2GknKpdU_JeUXXD6JY9TNqxb-nPSaZgppUWpkFUWT5lOzg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7wk499IZ8fPn-4PuCKGSktovGZxVheBsprI_eIL0OOg&oe=6AE4BCDD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOa1OFbrgDoQ7kNvwH7CaRE&_nc_oc=AdrZRikTlQe8Nij_ezVgWyZBsay7kx187hVezdbKWJdXf-uOcDvvu3yPGrcu5FzwxaE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORypCI8FN1HIVDOpcJSJdcfNtDC2uzs_uH8LRWBHaVqw&oe=6AE499EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6sRjn2bjMAQ7kNvwGg3ekE&_nc_oc=AdrlvyzVPmXGaf9KUgj5o6Crf7Io5Hhe1qoV3-PJ8Xb3E7meXP0Dw5FShMw0AjtyRPo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJYu5wZNXuH0ZNFyCyk0mE2xcRcV13i908tTFtkG-QCA&oe=6AE4BEB2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIktErq27-sQ7kNvwEumWl1&_nc_oc=AdoiqTXcPCbXLq9BA_ecVxFFpDkm2Uwe_oYs0KP_AS2sdQZHZB8bhlWmER9vHIEF3PM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJQT2jkPEc6Nt6yLMM2eSam2NetflQZb2pd_-R8E6ZCQ&oe=6AE48CC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=078P57vgCxEQ7kNvwGZH8NK&_nc_oc=Adp3LLeH0_4AcnlXSrA3W02T7ra2Fl3zQgnT8cb49dMxUouRcK8vtzucgiOcyp4psA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPICecScTMsNDjgP2IKidq2AGW_UpxMOBDehfLjWaID6A&oe=6AE4B5AB
cdn.com&_nc_ss=7a30f&oh=00_Af0_whXKuv8XBsAoEAVOIrfWfXcYTZ3aOdI2hGEhYpzbDw&oe=69D7B8CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJEaleKk4d8Q7kNvwGwYL5L&_nc_oc=AdqC49xijXV4mjdB7uKtexYI5-rGCBkvacrGIoCKESoRrK2L10G2gzes4uiCOaWKdzg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OLARgDaED7enD6bW-oemKeXJi0hnDNZh3ntbQ7xzUJw&oe=69D797E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2i7tzK-lckQ7kNvwG7z2JM&_nc_oc=AdqFRxZazHctkc9Km7YA8oHG37WD0ooAj0rAbeoKBYOhFCZS82j07Tlabe4ANr2ofws&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0N0XoUu3QiveH8il2YNEHWboIvAoq82_tOzsnh2xjpAA&oe=69D7929D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lkd5mPOJbJQQ7kNvwGfjago&_nc_oc=Adp5Vt6sb_7Id4wBfsmwDB1Wwi9s571RoW4_cnxCdqRi7f2UT056hN9kxwamrSNbKns&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rPyWPbNPZpVInxvAq88aKtWaEbKr5oEyB70uo-S9m1Q&oe=69D7A7EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjZf-fcmpQ4Q7kNvwHpc3_-&_nc_oc=AdrZqmnTDvU5uIUJoHeFFeW6_4LmSa9OMAon6Eu5qfKqnvhrqLJM-FhAzoQW51eF6yI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ox_nXQr4JQKxIoDj3x8XUmv03VEJEX08KxDmXBOmQQA&oe=69D79472"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqHYvCbBhkoQ7kNvwFibz6J&_nc_oc=AdoVxHvAqDf3E4km3_RomCKU0P90vOtZEa6UJXQUJikcn2xy_uOOFrrSvqy0YvAxG4E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ianFCV0J3wJLqovKYHJ1du8K_F_opcdF36Zo1dCD3HA&oe=69D79AC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebRGnHuMK4MQ7kNvwGeUYXG&_nc_oc=AdokICq0ztyeBj9Xm7hPZBl75Bh14Xs5Yip86xdK7nxgArGHZcs4fXwAiK2A3yD0L1Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Bq1IoD4MqIxo80fok7Br1BjnUxhNiUBYWlO9PGs0vcA&oe=69D78
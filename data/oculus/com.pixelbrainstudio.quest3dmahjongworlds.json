cdn.com&_nc_ss=7f20f&oh=00_Af9c_qS4JZsPgOgcM88gOCXOj4ypgSFzINujTOrEqVe1pQ&oe=6A45254E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9lmg8YhveQQ7kNvwER0yy6&_nc_oc=AdpfHbpvMoIJCAt_h0eipSPx6jFh-AZBBqxC1D9vriFHt-ZjMz_zUDp3xlEKlQvx1dA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aAM7hAIScs2ujxu35QdLpkHST5ggUWRuEcxRtrDvzmg&oe=6A450461"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp7FfCmeQUgQ7kNvwG71BK9&_nc_oc=AdrCnHOJlQYhcuHCF4v3ZPQEr9pbeHCQhFp4GgrxJ60upCOAy0ZVgd6IBQf2FZ0fLyI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BukVPZXEMnC0m_3cxN6GCftJAhxTAVq16tZyyrhvkoQ&oe=6A45375D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4vQik5rbEYQ7kNvwG30qcH&_nc_oc=AdrKNWesSZFosjeUMTS59YDxiNm2_sCrRsCjyryYAJhWiqxB7jTAVsmsoTJbjzSheEY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r7C6rMwuHsR6uIDoAOhp2TWNg0a_Ycm2peZ1BnoGziQ&oe=6A45146B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxA5NpwVzQwQ7kNvwG5Ei_J&_nc_oc=Adq_6LpEWkWxqzqey2dXhwRu_UJDW-eg6WbCOlE6zDS2G2NvC1EEBKvXkxiZmdQEcbc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_exhHr0sZAjTCxGqd6r2DWcQAE_wV5bcPXyxI2q2RBNg&oe=6A453932"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccGWMN22whoQ7kNvwF1f1TK&_nc_oc=AdrwzyqnBHfqjvCXwxqKcMqf2e_wxyGMURDpl-46CZJcYuiZNbqp0P9k3U473HR_Y6g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PGQxSZIFKpT1IhopRgHDAvaBv13UudoaDEf2Gqn9Hjg&oe=6A450740"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRbZgKqWX1gQ7kNvwGky-jn&_nc_oc=Adowis3rvNNNPIsmTPcZ3hVgJDJWjz3WH8OM2axTh5x6VyIsAEGxiBl979IJoOA9UCU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9k8IzgYLDGw1HXPi-TyM60vCzZ11_eLhavYSCQo1Nf2Q&oe=6A453
cdn.com&_nc_ss=7f20f&oh=00_Af9YnaFCdDDni1DMcCbd3jFRfa2aRa1TKQAjPyneztfdsw&oe=6A43D3CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9lmg8YhveQQ7kNvwHu5HF5&_nc_oc=AdpZq-Ufm4M9z7Evt9kyZV_eZIv_DZtK73mljFtRjZP98-yG1ng00RTrKDgghZPK-Vw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zC5NhkO-dSGMU7G02ZCGHYug-m7uSA1LPxCiqFtr_bQ&oe=6A43EB21"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp7FfCmeQUgQ7kNvwGi--7s&_nc_oc=AdrUT-qD26fxcPmE-NWMtxRmTPj3EXCzXW37bNHXNwdOUUdXoKGRPTtvx14_NWKx644&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C05_hoGKbmr071psrNtmw6h9vDkDlnqshO4b8yQRyrQ&oe=6A43E5DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4vQik5rbEYQ7kNvwG2Gno1&_nc_oc=AdofDYQerb-pa63AuYhDZZmsKPyA5vkIqCo5aQUldDqoMtbprzXRnTwR_Qbg_1vZLzo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MZLF_Hvzs9lEH6MnpSqiCzA1JqU5LN0WmOJ9Vo2IEMw&oe=6A43C2EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxA5NpwVzQwQ7kNvwFqudqB&_nc_oc=AdrxqFsC_ewSclZryJ_Q61a7WdbJTpFbLlI2QSqdBZis7eAZGWDrMq57h_KmUAcUDoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ik9Id1H2mHxAskkn2LLFZFWrHqrE8BdbI_UOXMdIQ7Q&oe=6A43E7B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccGWMN22whoQ7kNvwGmBzMf&_nc_oc=AdreMPXsrNOXtO3GpfUPdetRG6pVz7T_By0elipKvrTPKbd73yJ2bCwraCjEVDHiSGA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mW_GiS4ywE_yDtTuYxzPdxQMTEIOJAB8-8XcyK3mtpA&oe=6A43B5C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJStyYodCnMQ7kNvwFiXmWC&_nc_oc=AdrZMiFhQG4xGKqOJUbbxz9jYCugHawLR6m6jDQmS564hp6bzCYGUvJoMEcDXKZLFXs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yiaxs_Gxizv52f4lvxImNkA6ovWy9V2w1Hx8HmVqXAw&oe=6A43D
.com&_nc_ss=7f20f&oh=00_AQNoC6tGvXA_clya-h-ddbIPgctJGSKap4hhnVZ2B4MWag&oe=6AE3594E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YlnYCGLgbkQ7kNvwHc4L6f&_nc_oc=Adq3osYZ7vFwzngK96c_t5vPeZkkJakZhRa8eTxNctMfTDwrni61oQd_bKThMb_QS5A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-G7FS3vXsM4U193Saqpd7CaOP0TA03-g6gqkKVxnqOQ&oe=6AE33861"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=679in72yQ0EQ7kNvwHykqQ9&_nc_oc=Ado8eQ3W2knKP_T4SlkwHp8aBj5fEjsBxNeoavyVB_PiyG1lHmNNrcILNPvImSZsPV4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0wHznpEq1UqOXwjqJviBUrcpW1VO-FLYWVd-sK7k1Zw&oe=6AE36B5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOa1OFbrgDoQ7kNvwHkFV5Z&_nc_oc=AdoassOZcGsEL_ixVZAChj9mg8R_o0PH3fuWio4esXlVVlFxrsCeB2ELSxQiyKlI8cg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8Kcp9GtCWK7vBnFO1LXkxZddQEO5BZnXXFQsG9Vg9VA&oe=6AE3486B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY0YBMX2OK4Q7kNvwGX6y8H&_nc_oc=AdpPO0Y_I_HlZPtUCWm0tmIxs4cWzmb73_RsxQTCQWEmAfgoL4Dgi2U8UCLiMFXF1cw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcfv5qfkuNHxx2qDmRACwK4SYFYpGIh4i-mJlPB0GMBA&oe=6AE36D32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIktErq27-sQ7kNvwEIP2K2&_nc_oc=Adooj7f8tN9eB8Dc70IAaSwXNVHn4W3eWkKQhbuLt6mZiWa9a_6ZM7maHM5dduTyISE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnAGaY0W9UMdVAvAxx-HMLMmCELT3htQNIr5bhb3dmhg&oe=6AE33B40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=078P57vgCxEQ7kNvwFgMNew&_nc_oc=AdrTV3CW2gZQLhAAlKVvHD3aFoSCjnqkixp6rGcRxWtryeRi0627Ham_jmzirY-OShE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEQTSjDJW6MGaTUy-5bCxduMJPYV898oFMjxyMTtsFCQ&oe=6AE3642B
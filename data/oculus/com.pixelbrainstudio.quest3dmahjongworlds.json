cdn.com&_nc_ss=7f20f&oh=00_Af7kY7p8mWHVz0Wxy6qV7T-IayQWMWvL8y4lSMpw0WFomA&oe=6A048BCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fZ0DxVUasMQ7kNvwH2jT-T&_nc_oc=Adq6RrgxaDsUU8-HdtKqOh8i9Hf-91RkWy3PY_rWKMRMR6vNvnQ6MxWONWTTEu-o6Oo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6i5Tb865ndHNL7whU72E3YfGbfXBkvnGO5cAeSmM6dTA&oe=6A046AE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wgqx9RX_EZ4Q7kNvwFsr5tD&_nc_oc=AdoOMvvwpgBOpjcEnnEZsc2mYUArufSISV0KIFkMqO1-fDpEpBw7GL7SJ6WvC6OTDAs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IDyKPY8RnSI76Et5sIeSxJ9Fgfr7t7J2Fxz10YIX1ug&oe=6A04659D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7YMXdPGwqoQ7kNvwHLXC_m&_nc_oc=Adr9BDgkKZEvpMEc8Kq8i4OexlBBi0Asu1oTtONI33zFlunLz602KWJHUti7TU2ZsZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ke4FqLAcDfx34Yk-7dcbRAuQHoh5Uqy6jJfH0SroCew&oe=6A047AEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzbE4Lu2RZQQ7kNvwG3pPKH&_nc_oc=AdoiUoCZOWVawXdh9RNuCcG1T3yke0lD7-JkD4QXMPTv82stesxD8cQ0KU7WHZSRP-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45OE62Cu4v5XmWF4KnL5T0n-rWQAmw60iM6_Nxu4HBbA&oe=6A046772"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQiIH0qVamsQ7kNvwFvwRiA&_nc_oc=AdoB74IsXKbDP-tPMqTiI1vfxEpVh7wWfP-qhymjwuFZ8A_U8pHH9KQje5PMqqoWclk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7u7vR3HOQx8gAlIZvF1iULEHtzF94GloxPy0gagKf8og&oe=6A046DC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAHsht952_EQ7kNvwHNYjOl&_nc_oc=AdrIz1kiP1s6VAVyzEazeQJIkmoO3TVBvGB6X0SRvaXxzzdK6W1KpD_HnuYq-hhIW3M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vT6kN0mXrlggN0id7xTv3pOMwlxSbOAXvijsNz3Khkg&oe=6A049
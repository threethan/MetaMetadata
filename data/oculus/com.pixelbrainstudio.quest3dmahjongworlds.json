cdn.com&_nc_ss=7a30f&oh=00_Af1u_4Gz-w1Mnw45J1Pt1oMH7K1zLT_Dg7PQ1QYwhbVUhw&oe=69E4E7CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhL0zjuDPcsQ7kNvwH6Txrz&_nc_oc=AdqfucF2rD1_k_W8yy9UYifgyiubCUS2KY4xvyv1ycrsYsfjd218rCVUHBKbu4k3ON8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3z-w-P_1cVGWJVrAXmHCYJbgdHwgO9WXw7cT2MXGLSyw&oe=69E4C6E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTifU9-JhAkQ7kNvwHLAV5_&_nc_oc=AdoUjO1n9OpdcND8BBUw6Oj9N0qTDHPBFoI7bfib5xUBsDB3yMzsN2-6Pc1OC26EwtQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24tDCtP84-NMWBxbL3VhEv0PMIrHtDl6cL3rxooh4jZg&oe=69E4C19D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7r1fgk0INEQ7kNvwEAcc6K&_nc_oc=Adq9ZYrKDvA6YO_IbhqU_5BYpTe9xrY6jCA3ujogBmvOre1D71QjGZFBz7DSDdwYVuE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t-0lzkqsYKEdjlBsOuvOKwVSF6qmcgz7rCI9ibkkEdw&oe=69E4D6EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDJgccjag48Q7kNvwF38xoF&_nc_oc=AdoEUq-v0MuIDsvuZuewsEsHweU6Y6sTisY2I1S-qSqSdNu6gs7gVqKi0G6mZ_j8mlc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wOY9pjLDsQKqQmmjffh-BRdIAqxp-uG0wshnA8kJn7w&oe=69E4C372"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J02CNKdcmtUQ7kNvwHPhpbp&_nc_oc=Adp0u9X3-1nI4-k4kZQAuIKhMMRwWTMc1mwiJ7AXMc_NMOPbn5lFAhfl5sqzGKRWRMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Js7-0RUl2bRNtcCYuiivSDrpOKI4usnYs19Z0TN1ghg&oe=69E4C9C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PC13R7uGH40Q7kNvwEFQohF&_nc_oc=AdoJsyeyNnpY6ufqBDLue4pgVG9l6K0EIizVquacpfQItxEOowxgNGsCtlb2hqHg3Zw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uf1GLuuVriSWwEw5Y5j-zhZ-knrYcJg7lrhF-bXjgSQ&oe=69E4B
.com&_nc_ss=7f20f&oh=00_AQMua4HiiyZdOncqrLq1KuqdQLYx8GF_-obBMKGQkiqDXw&oe=6ACCEFCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8lTe3Qc-8wQ7kNvwFp6zpX&_nc_oc=Adr_wJYkwrNEEPTRFdwYrV7yzk_6wwtmuSqo7C9SKLPcHLZUCj-dQRSmt-ecRGGZcXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2CuaWKuVSjQiUgRfBTfcGoSI_UFbPLtUY2RR2INeUXA&oe=6ACD0721"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C62D1r_SkbEQ7kNvwEwB937&_nc_oc=AdoCyF75XZuoBxHfzWPEpPjBJgokRdQboFc6VY3_1o1hACGjvR4TXDM8z8derTKZoxM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5gTiCWcLYDmjYzcTiYca-biK1xNC4XRdtzXsi7T7ulQ&oe=6ACD01DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80siy6CstdIQ7kNvwGPz0jZ&_nc_oc=AdrSZ4Dmc0ZMEBWR5Y6PKE0DeCF8nlVN0dzCQpyO1Qv-fbl47T0okSW5Bqoo-es0Nv8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3gh0re3-NB010UQtIbxrD30n0LuwIA5oNpMjjV3i32Q&oe=6ACD172B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2Xm7vYcOcUQ7kNvwEX6U2S&_nc_oc=AdrJP8U1Jlyw5ur-D45wE2NH0O4NiVCeb0Jakby9OtQU1h0iunEC3qfkqwVoAQMDpgw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXrYH8yvlQug-u6K7Gyb_jPQgaYanNKWiLmgQn3Wfp0Q&oe=6ACD03B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdNZHoUbT18Q7kNvwFdqVWz&_nc_oc=Adp2kMB7IxTvgZQ9xm719lVIyEZiBB7HOxNqXLyUCvs7Sg9h1Kk3pTIJ6UFhjImOCrI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfH5U5HTOZ7aYg1vk7CI1NU_LixoUEvEJiuFHa1IAVMA&oe=6ACD0A00"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guV5CK8pkpoQ7kNvwHWZ32L&_nc_oc=AdrVbUFBSt4UuybjJ4QgmjUTsD0nCbBhKvLWa1s2cXvbKjMLH7QMiAxvBcJv0wyj_gA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEo3gEgB900kRvJKaDCkxA31MW2gwZzlBIVj5Cm6U4QA&oe=6ACCFAAB
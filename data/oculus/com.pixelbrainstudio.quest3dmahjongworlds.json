cdn.com&_nc_ss=7f20f&oh=00_Af2YYImtOYGwDMcDEXLDsFHYihJEW3OdnbkO3UotKZPrOw&oe=69F75CCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSk0vuwEJ9sQ7kNvwFeUaSx&_nc_oc=AdricbFSVApeuQ8WKTtcIt7-Udh_lh17H685KPzScfljKd4hYhkP-o8ubNswoITEwuo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Lqbkhrs44Whu1ROogFxXzTD8U6I7hfvYgDqPar0kNiA&oe=69F73BE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlJSyCSz0eIQ7kNvwFce7hi&_nc_oc=AdqB2-od-j17bg2T6i8Z6p6w676HkdFLr8xkjB6d51t3AgU5cVOih4Edaa0KhFGc2fw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33uePFT4OIn9fQxG8kU9QNpZfflLvrdlUXSOKSQ0UPMg&oe=69F7369D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmZvEOrEU88Q7kNvwHP0Bqh&_nc_oc=Adp65eFdGdnJ0cXyOWfPLkz_kO3-gPUu96mi0c2jgd37pBaZpvu2txU067_TxYQHJh4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3VlREYolTiFvMIJAU21rhDfIJ1OY2BxigF354coNxRCw&oe=69F74BEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGQ7o7D2raAQ7kNvwGdVZzr&_nc_oc=Adp-RvDjBWt5iVslK2q_c3xnM-VygliSx0sB3inFapt_JCJTThPlepiPt6r1-SD-dMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tl9PpBn48DQ--MdxgDENPD3x9zcp8t3xbyx-KvFKWUw&oe=69F73872"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MBiM4jgvRoQ7kNvwHQqjrx&_nc_oc=Adp32NmruwFg5eU_MfTN_jqJExoOhA3ShUONW3nkAcdOA6NkalrSuRrTOdYhK-kSo4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1VI6dniqeqwaTlFxfJEWpueVQIqnI0KP3kI32hwhUTIQ&oe=69F73EC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIe5wU2l-qkQ7kNvwE7MQHV&_nc_oc=Ado5Tu0QkwA4Bfm_1cAnxhksoiE8d8Wtu8QDYcfffCZ89trPFnvGQU74d0cgywk-APk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2qWj1RWCJMiFZsRJXrJqyMbvcWyVq1i3fgxMkHWn2eJQ&oe=69F76
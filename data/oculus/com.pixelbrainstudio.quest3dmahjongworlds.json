cdn.com&_nc_ss=7a30f&oh=00_AfxmsGjf_l57txQlR8PkX7eYeX4OJXbaOykssaPcjVsZEg&oe=69C9384E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhH-V5xdJwYQ7kNvwF4-pU-&_nc_oc=AdqEqRnBMWZlV5m2sJNhwx0_J5Qx9CIbW89Ms2wxp5II4ea681cKADjxCTrK18GtZmY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuaKV1ECYu_lKkUYI478V0MUrr9mpODXBUoFwPsWNDMg&oe=69C91761"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_-FEGhf0YMQ7kNvwGWjIyi&_nc_oc=AdpBSR-iEkJUVWMLwaIzCJJHyhs8rWaDqjdDafK3-4bUuDwqV-a1a520oQi8-GMGgVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxV8OIiLW_QyNuSuJ0kxj2SjJhbklrcXCA7g9vIZn597g&oe=69C9121D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7vAFeMO6J8Q7kNvwGe2uC0&_nc_oc=Adp2r6emFBoonHARGWursYW6Ci_NzWLTa5Sf0totRpWmUUlwbqjV9x1udS3a5W9o3ac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3py5qhrR7fqzm0_WSSGj0qacDzZeQRWrH7apYCKiSlQ&oe=69C9276B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByjZLE31aLIQ7kNvwGxNF84&_nc_oc=AdpfAQoGLm-9rRyi0-oPrHJx_HbiYaJHIeXkjSw1RY3Ib-hOlQ9iXDbl9ESEL0isiUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFXefHrFZ6k-x48YShNkFRc3IlyssKkfz9gGQXOuhhLQ&oe=69C913F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6A3_zFpi6WQQ7kNvwEBmMxi&_nc_oc=AdocgEOik928qa1E964-S3c7kzCawA7Gm4DXQe-npAEDx0CoZLsFljBVftPVfeEDgDo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0QBPH2V68H1XuRSTx6eH7ulHd2kjplo_MSAUYOdiX7A&oe=69C91A40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y10xx1KOoUYQ7kNvwEPdOX_&_nc_oc=Adq2f33xLaRgc98CnWhvjIdmSyieXq6dk0LOpOX0b0uQvBYum-5aE4wL65joGedDpkg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXS0D4eG5Ag8ViIwnwCMmUkdvEK6QjpRxqLcXeTh4YBA&oe=69C90
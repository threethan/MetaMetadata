cdn.com&_nc_ss=7a30f&oh=00_AfxJKFk8Km-Qn4EU1ofren1iKubRtWHUU2V-JfFPr0uMmQ&oe=69CD2CCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaR5e5hH_KAQ7kNvwFx5sIy&_nc_oc=AdqALOIVL13e_MlPV-OeIT8pzck3IS6BK0fLFu-rEKPJ_adR4wvBXTRy4TF3TmR5-28&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_mZzCcwIPMpsIkTIUcOrAYMM80QoelAf-q6MVeiaZ9A&oe=69CD0BE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNo6R8_FLk0Q7kNvwGcQES_&_nc_oc=AdqlvYID3pqsrowZ31FZ8IHKVGuqKyRl_7PaH9w31Ixa6xAAqRQedxRSj1SKpDM7HfE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysQiqek07zVp-Lr6h8zYminQDjmw7Zf8cTD5Mv_GIr_w&oe=69CD069D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_qHYrfQ9RkQ7kNvwFXcK0E&_nc_oc=Adp4MnWtnol9xOpQRaBrCZ1GVDUOX7kMWNvcu77CG6qWyuF7u4FAeq_4jbM9w2-C0UE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxk9Q7O6OtfGGEulpswwQzgRx45PVOYs4qKgdsULUAwFA&oe=69CD1BEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziKBqHhKtHoQ7kNvwENia81&_nc_oc=AdrT_u1zz3qJwpGihCYYEnppynbhfPdLw8k4GqGqlNPxjtER2j8MNm6UDCKc2Or6jGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdMWvKc7zb0s2mas9HYn-cy37SIhOcpmbhJ4SP3aDVoA&oe=69CD0872"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXiBhDdOCncQ7kNvwGqk5Sh&_nc_oc=AdqAoiIaxD1Hl7I-TGKzDdN-EZRALrYGPMzQk56XUhRNEwElXwFO5aJHk6fVa4MV5C8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxYDLtJEMfGMyyRHialAWv4kbumrrTzvxxSVn9UvbcTg&oe=69CD0EC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9g0TzA5PwD0Q7kNvwEzy1uz&_nc_oc=AdpcJjrvsQ4hqrG5gvPK-_JMD85FUYEwpVkHbvSjYyCvecaQHsdVDpMT6-Yq0Ef3VTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcbViH4XMbbkZhiC6WxXbGlt4GJf8ma6buhxJzaXZAJw&oe=69CCF
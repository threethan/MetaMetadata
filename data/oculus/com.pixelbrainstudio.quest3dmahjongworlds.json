.com&_nc_ss=7f20f&oh=00_AQPZBU9Sf_h2lGS5YleH0E1uqASk2r1MF4sElbiY5SL50g&oe=6ACE414E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYYZljWYlV8Q7kNvwHzKlw6&_nc_oc=Adqx8Vnqr-qoX8Iah36706CpSGPrnsVqqx9U4Gb6Bg4fVGIGKXoZ5MsWVEeDzHXLIlM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZjQGYoH6Ddmlkq-cyhSFq70WMwarXiQ4vgz5ykK4NfQ&oe=6ACE58A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C62D1r_SkbEQ7kNvwH40hgd&_nc_oc=Adoi4T8iMjqnWiJ0xIjBsT3cJyHIgixIBdrgeRoMZURfeIkg5Z749B5xFOUeEgEVqXE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOaxRE-xFwDclU4DufQ4LsoOnm419bsBRDI6vJa2UhRg&oe=6ACE535D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPdkHRk8KysQ7kNvwFS7gVM&_nc_oc=AdqmZ-ZrFhqXmVLmAQbyCXUQ1RnlP-UbMwtQjnZuUbsOXlN7Bh7i9kF9f0ul6OMF-Hg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkdHJrHZ3MgCfgrP7AdbeWI6SjSA_TvLFS0LC_TqFuYw&oe=6ACE68AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2Xm7vYcOcUQ7kNvwEpdemc&_nc_oc=AdoIjuqfjVtYGy4OXrO8o4pTV9nzdoNXZHiiUJP4nV3B__r0Bewe6D8pZpYYN14djDY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWxeEIBsvmmaz5-erlwMh8hxZJ7ysRqb84xVHEEa-UfA&oe=6ACE5532"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jI-1sbhtEb8Q7kNvwF7NAFz&_nc_oc=AdouYq4hlJLLzdHxOs0kzAlfKEoWzDc3XKNITMBx0IZFExzHuiwuEoQTc5GWDPxT4Bk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8WVAoDBtnVNvUV9yxaDE1EdN2veZGwn6HK65Us4QJrg&oe=6ACE5B80"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guV5CK8pkpoQ7kNvwGdfduX&_nc_oc=AdrDSkJvyr-JcYJxSh5bubTURYojpjUK_8a8UeCn8uirSILSoEc7eXzqcfddocor_sQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPE9_FfWyXK4evI1iTXhIcuBtjJnG47L6WrvoxsgXt-yg&oe=6ACE4C2B
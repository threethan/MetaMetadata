cdn.com&_nc_ss=7a30f&oh=00_Af3US7ucs7O_b2402oMzbTr5pSVID8aLEqSqo7-8KM893Q&oe=69DA5BCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRj3VCto2Q4Q7kNvwF3bsN-&_nc_oc=Ado18qMvP6HXrUxjdGSZwqXPJGJ8ACoWkWham_PyG7_rkgss4thpEu_M1qT6I34myE0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38xGfnqZjgbhTGKUnElOh9k60pFsZkHXRaoTd7gVHvbg&oe=69DA3AE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Be-zpcNqs4cQ7kNvwHhfR3i&_nc_oc=Adpar_k2sxF-Uw2fxd4eGeAyQhydj-iPgzvpD0Uf3u74SP9duXcVAsCwCagiWb5cyHM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XTj2Usv7l9Eu8y6aNwgCH4LF-1i67wLrlT1vtOq5FVA&oe=69DA359D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxYjlqsyoFgQ7kNvwG8rThT&_nc_oc=AdqhY7mEHBBgRlv38i61T-dt4We98bY9V4dND0UMeSzhbsY-ReC-4JEiJu4jqnH1ZT0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32-ukeFfSrHcIrmeeN1FJNRhrNGuTyOAixj-cIFQ8UyA&oe=69DA4AEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjZf-fcmpQ4Q7kNvwERasiA&_nc_oc=AdqGT4cEQanwZfoqhR0RzcRw0zYSQPCpPUrVdrdfpCRpiEcPU5-y-YYxURi9LTka804&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Rocd3qz8E0C94r3Ee3R2F6HW2NbZ1JTqDEfiuVN9MIw&oe=69DA3772"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkksy7OR_H0Q7kNvwGhwLS5&_nc_oc=Ado1g9ZZzaqRf0PSTabi2_1woTcol-LjrWTbeQupvkHTKspXblR7miJ1tLL7bReVnbw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rwN7A_CbYfgf9IFrUmNI1J9z1pzp2mdgHujDo2QZ__g&oe=69DA3DC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-TsS5xD_VEQ7kNvwF8qRSL&_nc_oc=AdoJvIL7DhIUeJ2Nke4xA_6og0DI81lMANWjuKtWbQF8E7Y0Rv_Zaw5mJHZDQJlUfgM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vKdHcTfzlQ33EZEpvbJui_1EwzwWe5S_HUUCps0PdrQ&oe=69DA2
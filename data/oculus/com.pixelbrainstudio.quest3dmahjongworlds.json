cdn.com&_nc_ss=7f20f&oh=00_AQD8qH2LQDEF9crRg0ckCtKNafXdWiBKW-NKMQurlvFebA&oe=6A58EBCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBhVltjkyXEQ7kNvwFRFLnD&_nc_oc=AdqU41AwLTUMT3YB8xGR4ct7bS_IUcrdT6xdDXqA8Q-f5V4LvvAXgamhHcc4llzDK9c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmFdlYbaHCR-_tglCmAAy3M5z1LdXGtxFQBwb0N_LApQ&oe=6A58CAE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0y6Hw3hbcgQ7kNvwGzf1Lh&_nc_oc=Adrmm5K9ItoVyg_8YSf4uMaeOrQ6wtWSOvfW8mRuJena8n5sVSjkUdTFdTeuL_A0tWs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAH5lpjLd-VypnIvEMvvAdMcqKQHmxRIQ2rx7kS1fVtIA&oe=6A58C59D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqvicQ6KXHsQ7kNvwFjhbXg&_nc_oc=AdrEo-bEfDY8HtJregH9lTNvdKnlBdK1gQ-QUB-32Nsyhb3zphiZLXOcwq1urcEleTY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuC9C9EmiHdNgfLc-bKKooNYBu160TrbzWktuGoK6CQw&oe=6A58DAEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A431ylAlBfwQ7kNvwG-4T-J&_nc_oc=AdpFuNRVnPW5e1XQsjlSUiuR_0-GJvn2Wmd0NhblVIH2b0ZcTICGTSoz4Nt6h3GuXyc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRF8x6IoYqXqD76yC2_Hlq_MkhCj0ZfVHOP4ogzVwURA&oe=6A58C772"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5I9ThnGh_cQ7kNvwHkg8WB&_nc_oc=AdppZBxHircT_d44D1RSyhHZc0hPeqwm0CIZVUx00vyR0mddcIwihrZUSb9tT-cY_t0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCa5I1051j7QhRPqMO3WBLrLDKIfdHkEbpOEqEJh_hEdQ&oe=6A58CDC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoy2FF9KoagQ7kNvwGDvkF3&_nc_oc=AdqXhSzaZynMHfrqQzppz65kCFVxCyu9ijMQGZJn_JEwfhmz9ep75AOia9vjNxt5l78&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsxH3C2R9FHLMgfnkSN8RNdm3JWhlo8ybvy1KfiVNPEw&oe=6A58F
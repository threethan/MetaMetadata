cdn.com&_nc_ss=7f20f&oh=00_AQBtqfjJoD8GxsGwniT00PErEwdDLTMnrUTOkJupbPP_Yw&oe=6A54F74E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVF8gvSa3ecQ7kNvwEdGmnp&_nc_oc=AdqW5kq8g-5mPlPOGsMEONKKEjf23NmtEfxJOK_26MRF1RWgEXZtSTsJZtffim-_2Yc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiwv9Tfsz6CZiNcKwzfqoVa4IVs1k-BjiBcQ7rF7FYQQ&oe=6A54D661"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Al6Vb2Q_tIIQ7kNvwH-ta3T&_nc_oc=AdogQn-cainNFxiCBKP6MX80Xj8ACeHeRJAwEEMxUu3nMDBnLVbQNawAxwrwoIhL-kU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChY6BbVkZujw-yWy7rLxCn6fhs2IX01CCnqSW17TGq8A&oe=6A55095D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Dfn2nrm0WUQ7kNvwFnQvTd&_nc_oc=AdquBTEVc6DG9sUbVVIizwZHSXauUkdZclEy-R_mzMp-E30eQwyVgGkBqjuf3je_eSo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADslaL3J8hLRCPfnFSgXGMMokfW3ezBluaTgxaT4liaw&oe=6A54E66B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKNtiV-GeKEQ7kNvwHgke4H&_nc_oc=Adqqunddbv_z4LbxRpx3_ikHSurDbHVVrQ9mV3sJ2dz_RU1uH27k-g6waeK2CnD1SH8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnVpVlFukHIuMxzFxafRwW_VKMfonfB7smZuXdjvzghw&oe=6A54D2F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QgVK491zvMQ7kNvwGq6uQV&_nc_oc=AdowK4ps4wXPzroNG-6djtaFrixmfOJP0rg6Ox66RgqEQjo-1I9-IQx3ckoiN7g5quU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuseYAiLsmyv9xbJjA7cy6pDcg1Y0ZyZmUAhdSO3cVbg&oe=6A54D940"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pv1R2YVWK8YQ7kNvwHrFQ_H&_nc_oc=Ado9ENtX39fxz0lpx_bUJ2QQ1MQBCo-c8IXFCsEjoSEvQi3v9O79MaODrsZLE3--01U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1lZG88bw-vdMIbKIHVpHt3X1qtnAp8KpO0uSBq3SNoA&oe=6A550
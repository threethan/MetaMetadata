cdn.com&_nc_ss=7f20f&oh=00_AQJf7REY2qpT-c91C9DXxYr4q3MveMwAPN3UDq0p-kBC6Q&oe=6A9D79CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMYH3aRMGPoQ7kNvwESrMUF&_nc_oc=AdqxY2LeUQswzaWZM1zgKcWVy5ptYwz1m0lQDwMNN_yA2K0RtMoTq3wMtWJnPRCzleI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6r0XNd-hVM53j5ns-Ny_vyew4atxtuS5fzDKZMIWpHg&oe=6A9D58E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-qTL2NEPQUQ7kNvwGUSGhF&_nc_oc=AdpsMDAkgHpToNwNuzVwEnxvqNTV9XzDYR74yHDteD05s3Qr9HHGbYerhR7R3gsrrGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmGSdV0NWRRvM0ixHGgP0BejWO9lz_gRi3pb-cgmoUEg&oe=6A9D539D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rnt_s8nNRAYQ7kNvwG8h63M&_nc_oc=AdoPK4slkLzDqU4EnPKWd0ykoRkoM-lohYrEG1PVuZhJQyYx9Eigp2cmkIihJfGtoFE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMFV8IJiyg6hiyx1F-68ql7O1narm5qngAesyLPR0AnQ&oe=6A9D68EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68B39OjXEsEQ7kNvwFqmXgp&_nc_oc=AdolGAgZ49X0ISYE2ccPiNlaaFN9LoxaOq8YSWskgnrwj0Q29DQWJ_KmVUWVrn-nnVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTK6L6w-vcqeBpaotj8QXdHvY78hKPeJa_eFaIj_63Rw&oe=6A9D5572"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xcs6lVq4JBwQ7kNvwHmKlE5&_nc_oc=Adqs05isJdLOMk4Qx63O2KX4zum7LiSfICTXbe-BhfRxprz_BY4pckIR9qG3_d9djVk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0RUE20ybZM2wdXsIzOsx7WZEKBrnOHAtz2eX4WlHPzQ&oe=6A9D5BC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OXfFbdDlIEQ7kNvwFnxZHO&_nc_oc=AdqLZpmpmUlpFzfX0JwldymJ3e1UPyY2RzsbhYWX_6iPLIwEUud3qOYrHSS2UmYYQn4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpB70Vsf6rK8vcCWBuoxGkmI1b28sTXUbgfFZFK8MdTg&oe=6A9D8
cdn.com&_nc_ss=7f20f&oh=00_AQIbD1qmF4KJgicNIUUkibTo-l5KDklC4K5toLjO576j1w&oe=6A99854E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6b0VaDi96YMQ7kNvwGvanqD&_nc_oc=AdrPuVqpANuAbk3VSzNCRUuAFPZgslKgBZyR1Vel3Q_yAd7RvhP98b_DyE7oKVsfEi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz3Wp72u0VyQLqGiqSawxVEbf7wb282WCAAgaXsyRXLg&oe=6A999CA1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-qTL2NEPQUQ7kNvwEwLB9h&_nc_oc=AdrpY0nAXdgE5zQuluUxWuaYRgIjQYfbUfmD2Maw_XqH6-xsLsOarJKCwjEZHPrfmCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ29p3VXahed8iE2XgqdSjJ6P6Oux-jCY3edtWnTTS8VQ&oe=6A99975D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5A4tJQ30hoQ7kNvwE1almo&_nc_oc=AdpYfrb1eYJ-YlFMl0Q9hJXsyx1oPhcEw-Ey9CjKazchnJBzJJO3i0OU9H-6lSE0FsQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIscrXWrCs13UG1Em3Fhs0FtuC6Px8J-s6NSoCk9t7EJw&oe=6A99746B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kmb0dDkEgVgQ7kNvwFN0vTI&_nc_oc=AdrXy4vXzOlr0AXBfNkvp_lmHm9p6CgBnqj1oHLIcXTuDSfbyCeXGcaEW_Gy6iQYmBg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITgQD59wcbLrqAoewpa2qFnPNMFVEim009V5cwBY-g0w&oe=6A999932"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDp1fKiv8F8Q7kNvwFx3cqv&_nc_oc=AdqyP-6yzBmC2yNqle0HuDs8hBl52r4Mb2yTQpyKpKiVXms4ER1cY_dWcblLBlqk1pI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_XwFi9NK2AhY3Grv8mQqE6VwqAbf8I8IhJR1I-HEDKw&oe=6A999F80"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVCHJqt1ZvUQ7kNvwF8oOJx&_nc_oc=AdplphqAT6m3SILjzqGa880dgC0f6i-CUJWakyEw1mXdKyhp1b5GApdXFkkx_aHL5GA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYi_-3LGEEYW0aIm1oKC4wAQDs4Nsr_7_4Kwk-G41iiQ&oe=6A999
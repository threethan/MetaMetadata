.com&_nc_ss=7f20f&oh=00_AQRnlUChsFyLMDLYdoTqlvvW0fMPgdaE2OYrZu9rT4UxQQ&oe=6AF9C2CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQHUh6DALaoQ7kNvwEFRPoV&_nc_oc=AdopcZqUCXqvprjXgFjO5T504KLtw_HUWWofMPAuy8lPGrxyyZq0owEswcHpg-_ofSw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4JxgXlzPAX9qFsitQDI3k8zX2wE7gnz2KN4KcrkKC1A&oe=6AF9DA21"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NEi9JAL5RgQ7kNvwHINC6E&_nc_oc=AdptLlEW1XCS77P_r4B7cqm98tCiLLXpmTL_pqoEb7xqMp4b1or_Zp0vrQoMif81TT0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJvIVneHjAgUXoU60JNSZXsg4cZpLlxlYk1B34Aub57w&oe=6AF9D4DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyxeO34dDRsQ7kNvwEOsQyf&_nc_oc=Ado9VycjkZccRCHyCAAEKXkEH9tB3iD7fyF-Z5VQQ9MWiPTmQOxYOOe_xRq4Le2n1Jo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu3ITGL_STop7fKGD7d-a8P3fnOZt-tE-TBeH7r7IAzg&oe=6AF9EA2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLGQw_CjKdgQ7kNvwGYUlmT&_nc_oc=AdrKW1g1dGdtuhww8YW4_DR2NuadMrRyLCR3SqC7PAmGVZG8eYaRrlxz2RIV7fGW-dI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCphxHspqx3pvW74V73Li9DDaVBX2_KQqZIbg5M8L_tw&oe=6AF9D6B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Efyvrn5IBoQ7kNvwG7Etm_&_nc_oc=AdqZWJzpwiNPiKEYT93eR9UxyYPQShydF8Lar-0FaWawzGCLi7xIgC7F-bIZpbRpe2Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgg3gNsQXitjdsfMvMhIjtwkjl-lF91jUoP8EGvIw3gA&oe=6AF9DD00"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ufwg4FI-xX0Q7kNvwFvTr-h&_nc_oc=AdqS0J3aoQEuL79FhCyQyqt6iI2rvvL9LF7hiWET3yvWc76f3-l86eXkyARAWrBJ9DI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDX6uzdW9O_yKO06xkq-BeTJ4Umdz07fWQcxTGK0gwIg&oe=6AF9CDAB
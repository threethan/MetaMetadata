cdn.com&_nc_ss=7f20f&oh=00_AQBvNxHSZrg17Rqfddec29HmiTtBkX4E87u-kdk5v3VJGw&oe=6A5102CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3udw8eJlSkQ7kNvwESfcpF&_nc_oc=AdqPynmSuzfG7bhy1we3u6Elmm3nNSZpMfNAhuIGnpjwqZiIJqOSmuLJ62grUa7ZYNY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPQBgmBfFHNAqGIqG6lD0Bvd5F82Ewl48ZFwlrkxbbvw&oe=6A50E1E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zlj6hLZJiGMQ7kNvwFc2CiX&_nc_oc=AdqiDhTJBHDfOu4MyMMe0vfKGj1DfbCYl8SJJ9e-idjJNWTXRy8r9vFhbyGb4DS337w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYMZvuW5Wi1zwfKYKspa7J-tCwaP4I4Pt1m-h7xKAdXA&oe=6A5114DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOO__zrT4qkQ7kNvwHEgSu6&_nc_oc=AdpqldUbmppi25V75U49EtWJ14SJWij17SFVU-UdrLI4rOJijB_JP1SK5N3LF0Z2WZw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGwyNi4jf4S1hk2VzCrgsGZByK79giQ4J0ic6ysxIQDw&oe=6A50F1EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyC0Mc0gSSMQ7kNvwHxsm4W&_nc_oc=AdrEMcF8e97ZTAXqc54z5Y-2b2i0YVzPY0XDSWa44ZXcWELqZ90X7PaxP6CeeFsyfZs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB56ql3Z0-VzfnFAnIN_10J4A0WCQFUS8MWJMh5kbRNqw&oe=6A5116B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxy8vwj3eV8Q7kNvwEXcqiC&_nc_oc=AdrBiYbb5Xt1n2tzjRkVnr6Ly40yXtjvlOtUq4GH71Cx6VXFBTUymtsY9DpDZ3bODSw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLMNbhTSey5A1NpxJ3t-Er95ZDoF4xrvF5O4gBb3zeDQ&oe=6A50E4C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fet5TeDgUAAQ7kNvwHKF3a-&_nc_oc=AdpLy31R1FGTrtgsK-CueChIzPQYvrxymDVqkG5cTDc3iCO8oqouq5LZE_DZNByJZE4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBs51Xxf0-29Yw3c4FBsAjTCGrf0R4JG5eNF36VKo07A&oe=6A510
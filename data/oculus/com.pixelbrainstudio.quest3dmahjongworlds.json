cdn.com&_nc_ss=7f20f&oh=00_Af8_TNP3ub0q472BVqRlHbzmFmJ4k8_--YbmEOvZgjcTlQ&oe=6A2EBBCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61mj65rHbFUQ7kNvwH1WRIP&_nc_oc=Adq9zNFr_ux6i0eXkFmqAn-ULDbRFLEFdzWG6r_S1Z1UgEsP8d4sqcQLqFQXFsD3jDg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C2UWvxnAQUYvnC45qmHIlvETgrvCF-HgrFfHyMz_OQw&oe=6A2ED321"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzzIQMvuY1sQ7kNvwFOq3Pk&_nc_oc=AdrmcsZZBIN8XPsd3GM4ZhQZWz_rHlYE-VQakOhoYdd9OzP7hYaX0RMJ7teBIebOMIQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XN-mvrvbwPh3zvRaIZls6fB0DdcZx1HzIl_3sOkwusg&oe=6A2ECDDD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuI1yWGAeYgQ7kNvwH29SMB&_nc_oc=AdpdNXbWLI-BtXrbSHksIQnT43RWBnQgMCHiN4XO_ISdh10DffAoJZox9DX8Rlx3O9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IQwulxET5EqrZiraWFWGfgWFiG6_6lqgx0Jb8hiumgw&oe=6A2EAAEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sz0Daep8MX8Q7kNvwFFvRNd&_nc_oc=AdrmlA0EmO55T8SdAtuu1FJnM8xReZb0TJb7DfD8GOxpvkACdazPIKFiau3jt6nAd_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dkX9Lvp-ocE8ZNdQbL6JOOGkMhtNU5GOck6GmvymNjw&oe=6A2ECFB2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXPlC2e8368Q7kNvwECYGqs&_nc_oc=AdrZ4RYy90sVz1eKaM2Xj2-6YAo7xN7i7wTcNZ0AkkBjmFZipI3I5T86oeNl5PsYeCY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V8XE8lk7USU_Amp46IOVoVoyZa-fKHm-2yyxlsuMsZw&oe=6A2E9DC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-QPSjuKz4MQ7kNvwF5ZAUA&_nc_oc=AdrGxyB1cqLlWbCoy56oS-fa_bpR9NTgkzu7cYvKeNPsDCHXW_et2Lbip5PV3JfPrjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vtl_K7XI0f5ex1Lu8NoRglcY2ithWxeZPC_rA2P8oaA&oe=6A2EC
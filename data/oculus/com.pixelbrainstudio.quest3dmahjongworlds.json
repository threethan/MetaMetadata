.com&_nc_ss=7f20f&oh=00_AQOQ4lEIhukdUY4l_VPashELz1y4xE1QsRJ7vyYkRpfciA&oe=6AC263CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=df7LO03mBTYQ7kNvwHkObOW&_nc_oc=Adr9nKsFglf2dygMo4nHwABX-3n-RGFTv0kw4plTEQo5OaAPPCwCxo8Zk9jEQF8DeXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyBXrNLCq7pBlXDUo8-HMgAhez28mS5qzK85JNqYc8HA&oe=6AC27B21"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUkDQmPRgUIQ7kNvwHxyQW5&_nc_oc=AdqebvCCPqyj4mBnIDCOygeDigFOLp_lyerLIenKJg1ga4B__obp8U9YtLRV6HXmePc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZS_JvSEfqqllHbr05hyZr5HTbN2nJNaQcDrittqtPVg&oe=6AC275DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wxeY_mupOAQ7kNvwE_Yu7w&_nc_oc=Adrz0A_EdcPAAC6xOv3ihwt3FBA-mXg2lbU7Ivsae1A_DuajpJp77wjtJcT8uNWh8WE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZsUDBbwnh2BUYzyk7ul6mv_43exUvxFzxrd8YD5ExjA&oe=6AC252EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kna9XvlTaq8Q7kNvwHoasu7&_nc_oc=AdrKSnnlSegO0bPn5-CrzI9fKPRHzrLyABQJWb66E9033I0wXASebimKl0eNHz3uBls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYpuj7MjIWJ6_DMky6MvHWAyj3KMHaEkOpUm8EvZS6QQ&oe=6AC277B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_ee_LVy4jEQ7kNvwHzdB_0&_nc_oc=Adr3OVHEI3ApDmeIAWeuNta-JO5mVLuYgGTOOYBFap4JHI7N5I-VTXUGrJUXkTpONR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4ohfgy8RYhnSKITWDqFbqL7Hq36GhMF3oAutExZqiWA&oe=6AC27E00"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcwfz01qP_8Q7kNvwEnhbY8&_nc_oc=AdruLmDS0Vy0aI42WmyQsVbPi2NzRjOFHkSgKfb4YK3JQ_jnxyuXtA_-0hWFla5bZDQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMpa6ksGL13IibH61N2bFsNVeYtRoRR2qQhMd0ZflnNw&oe=6AC26EAB
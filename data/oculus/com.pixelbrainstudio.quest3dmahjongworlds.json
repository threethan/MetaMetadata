cdn.com&_nc_ss=7a30f&oh=00_Af1BPkWN3LGQ9TQCnmrgbkVsc1U-njLmdWfEtRnjrebQSQ&oe=69E78ACE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhL0zjuDPcsQ7kNvwE_MYbr&_nc_oc=AdrzL8HZscj7nUUY1fBQwe-AGdild6dbAL5T5Ijdb3kF5dxTSlPHkqmOOXgEgy3RJH4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08-jgKUc_8VskPE9EEv2V-jEpOOWkiq8FjKG5o_RPhRw&oe=69E769E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTifU9-JhAkQ7kNvwFsUHoi&_nc_oc=AdqT27r4jjgO8SfK_Lb80BS7pn5V9gOLEySpTkMABgb9s07u1sINph-FYNFCf_WpyU4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ng6DAo9WW7ULr39BP5CV4FHGvCxT86V_IC3J3uwHPvg&oe=69E7649D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7r1fgk0INEQ7kNvwHzCI_B&_nc_oc=AdoZNzs1bJKsjxe_xNIZ2XD7go5ZMw9MZcy0O2M3lA4nXnmj9tGNsawv-Y8daOVZOag&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2s-v_8S11ZKdpSijMqP7cJXCzjxIlGdsn5i6SDHAZ55Q&oe=69E779EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtSJLv-ZlooQ7kNvwFVj6Fm&_nc_oc=AdpWFkOSQj8Iv-osn1Ypc-A_XFC-8-2KU8VfDtCkj2IXJzWSDsB-Or0PF-3L8XELDxs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_v6yaimSZDe6fXcChn9nDr-E4tCragP7vGVpQiB7o7w&oe=69E76672"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J02CNKdcmtUQ7kNvwE9Y35t&_nc_oc=AdokiIGnZsKLdcHnkZDpRV_ZSEbqas7PAMULUiN0DHO_GrSwdKnhEtEXsSHx1QZs_AM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RYs9Je-3EAC3unRBrdql-nOJ1mR7Yc71-SS4OuzxIRw&oe=69E76CC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSDan9AEGYAQ7kNvwE0xN1S&_nc_oc=AdqA3tee5EyGXqKZmmqLz71ROG4lqMn7Jnqlo7zF1AL4PRDIA2AiF_cmgrZ6JQYZwBQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_mqyh50mkuu4_kvqky_9OJVkAae1pPVMYkl3frmZIqg&oe=69E75
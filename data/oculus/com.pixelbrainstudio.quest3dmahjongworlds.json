.com&_nc_ss=7f20f&oh=00_AQMJLOMaieVDcxg4vU5Y1RVqMl-mHRRZaJUgny1ic5bajg&oe=6AD3874E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcIPzy84h2cQ7kNvwFnm2xZ&_nc_oc=Adq-Zp_ijKW7UfC7Vnpxp9qE0QwJlSq_j5YPMKaxyGkiTGRhjDUyUeiVVTv4daVmSQc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIZC1wLxUl_-PoCfuxLoX_X_lg1e-1IfleMYWk9XAEPw&oe=6AD39EA1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXJIkuG1sZsQ7kNvwHAt-Wt&_nc_oc=AdoWjAsMzePSDWyfAjg4JJdLo6qe8WXDEuMFNhRT9P7vazmaNRVSNz900eyo3LVALEw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM8q4OJun0ntvFuyrNqyv8OroXn4IOG0PxuCSnUi7Ddg&oe=6AD3995D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGJf3YZe0v8Q7kNvwHIsy_k&_nc_oc=AdqOiBtx7RY_BtVlEABns4pD3fG9G4WmTJCv2EbZCAxZYMs0vgdPjGw0ASSh6jemojY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODYFy8luQRUARlGk5CqvxJkJAkC6eiXqFPSb_xbsKOfw&oe=6AD3AEAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YThAxWNnMzMQ7kNvwF2Jwqa&_nc_oc=AdqqBUJg7sU3V3mS9lfgbCp_pokAD4amAnT-Qkxm3qLn21nxYSx6Qnp_qh9uEzPXoD4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS7FWy8MricsKOGnPRxBuglcYe-aPFmuYSR3Nu_RE3cg&oe=6AD39B32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhRtoGs2XvYQ7kNvwGMaAVI&_nc_oc=AdoGSTl--4yIXMVX04J7RVz8ouQRQH0noDrHdZVHCZ6FH-KU2TcWS9IBGgMrzJpXgvA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPevBfDA1hGjUWcZLe42t20V5PFnPhk5-OFtUms1K99lQ&oe=6AD3A180"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gf98Dlt_ZzYQ7kNvwGoikhu&_nc_oc=AdoOlpKeQBMCHoERBw56aGPZzECCsJaKcTCiCejQkmE7ero1K_LPTlR82JnFvaz5B9Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfXSbrSs0IeV1yOrfXDEctB0UAzYsb6VmtbOo4pxKHtQ&oe=6AD3922B
.com&_nc_ss=7f20f&oh=00_AQQKI0aWlg5edibAPMrJOLTXxmfIA0RMtpBcpKZBQb7JKw&oe=6AEF36CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWsOeA-Aw58Q7kNvwEw4FKW&_nc_oc=AdoJGSErTBfo3HoJqFx8Vp-y1snZCuckEcdMA9kOtXl57EqzNY98SA9krFi2z3Plm8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbupyxLUyonhzi0uB3Q27bPu7YwMh9OagGWxlASCjb6w&oe=6AEF4E21"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4NicwFyn2AQ7kNvwFDX6U1&_nc_oc=AdrxuwktSCxuRtwyTd6iTaLSn4p7SXFWTpk1MHE-i-jMPZt0ZTD9MO_vJ3-tBNgV7SY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwxpAjr_28CT_lLfRP_hkvnkFej1ZxHCH7T7QyVPnAog&oe=6AEF48DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC4jw0kXvLUQ7kNvwH6s5DI&_nc_oc=Adr71t92qjlNLznpT4TD5XO7aLU8Y82nctCNZECCo9VC7Ov9XgZqplCxlJvmCZe6zOg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS01VUSd31vZaGbxYN36bTn12uFOPcmx7qdnJBbioaXWQ&oe=6AEF5E2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5-zVvhQXu8Q7kNvwFY5HsR&_nc_oc=Adqux7IeJt95oHpX8_eP-G4q3mWgBVP1j2EH-VV1wSfEo50CWqLlF0xieCx8dSOm_TA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTqLAgEFmh2Li0c-6nOCeIm-DD_aM80eswRMd4Y-R3iw&oe=6AEF4AB2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUB835ScJ8wQ7kNvwEiZUx8&_nc_oc=Adpkni4DdioAleJ41RvbAQ8jB30qxVBeYTezk38UvHQlzRLPPmKVW0gQSF6rEeeKE6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl-ABLIRgzvuoW9Uv2N8dHIbztTzDLky4olBdaRYteNg&oe=6AEF5100"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVmkS0H8fXEQ7kNvwFjdg2l&_nc_oc=AdqxlnTLqNoL_gGzQpVsfaLZ4AG5RntJqjqDqxsy9ULNn8P4yVpAW6URyYJXLJSG96I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxqMP96UGnsV5FwqGYXUlaP8neM0dnp0nq5nKLytjuGA&oe=6AEF41AB
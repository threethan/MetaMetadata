.com&_nc_ss=7f20f&oh=00_AQPAgj_2O9MSx84FPdeJ4HcrHdsCWuB-Ld6mZGPM-hCNTw&oe=6ADE134E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0gr_52PnKkQ7kNvwF2eUUE&_nc_oc=Adr-EEZoP_5OJ3gA-aa1TH1VAIJMcpCCT0t7eFfWI_HiN_LzKhU0jrpooL2ANyAhdf4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBFLt_liDuzUwzfo6bIYUiH-gMzdL0mlAbQA8JNYjKcQ&oe=6ADE2AA1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18QUFunrH3IQ7kNvwEBiwoC&_nc_oc=Adq9yKU5OuuYZZJx4HKRINO4_-mf8yYPlLWdBVBFNYFVvzNtyu3nqLw7HS3XpxD8sOE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAv1mbel39hMfTWBpePg_NQlyAmbb8RaABWcVHpi1RgQ&oe=6ADE255D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa6UDvZCwgMQ7kNvwHGAz22&_nc_oc=Ado4QDtyfml-FwSW8NUD6HxMeLyik0UUJND_pmrv1jPPrC6ALLF8BbFfRTiteFr3UvQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6Atw3ErRttzJK7aAvGJD6fO0TwLwiuq3F3PrJxDfY8w&oe=6ADE026B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDWKBdosipsQ7kNvwFGAcGn&_nc_oc=AdrA7sGGKXctJUiQCkKXnSN23g9ngU-9lqI0v6CXkAwkCDpgcIgQSGw2vLWc0jZ5htI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYb5AhN81eXMz3JvooEMgj3CwoZjeK564t1ieQyJWo_Q&oe=6ADE2732"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDwzDW2VODQQ7kNvwE7qwv5&_nc_oc=Adqq99TDuwYhfGq1JmkmKWUAwbgMzemIEVLTLDKo73DqvDT_Lu0FXp72wpSTRZuwCe4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZ9Q5TNXcWx1H4sg0T1pT0HECE4HHBsYGcA7mbWQJCuA&oe=6ADDF540"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14OKS6jLma8Q7kNvwFUFmRP&_nc_oc=AdqRlcCS3QRyORMUT3Fv0c_FaSuZUfk1Rvsn6sEIsXRIVsAJxsL2KnMyDoFQqSPR4eQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8b2H4mmfhAusimy-ybQdbVDGTQpcdJ5UbBfdSO5zK6Q&oe=6ADE1E2B
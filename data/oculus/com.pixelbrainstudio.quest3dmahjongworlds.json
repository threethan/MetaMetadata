cdn.com&_nc_ss=7f20f&oh=00_AQGccBLwI2sM0UvuWGVKIKPuuzd7KTmH9qokMOQ3LnmWKw&oe=6A91640E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N71gH4pq4WsQ7kNvwEjXCsI&_nc_oc=AdquaTIF73W5GpHLBxMQHEMvgYrUM1XRzvuduFD6Fh2TU35Sq1mAAgSqlO5ahzZuGXE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKFEKxgbkTWretFjiwvc6LfsO15Zlea1gy3r-BgRoFTg&oe=6A917B61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfBj_fZ0YCcQ7kNvwFaBYd4&_nc_oc=AdqVytSrQuBg97-ONX63v7ZnUZVrSXZTz_rpOktlTb4_tR6vF34okcCdJgHyLVL5alE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXkAc_ItAcT0CSlMQrJkknFZ5IVkiJdrbw0CyEFfwCpg&oe=6A91761D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvysfkh2fxwQ7kNvwEaxsf0&_nc_oc=AdqmCuA9l_DTYYn9d5RBqAr_oF9CTqZhdHd6G6YXWuq_io_DZdJxqpQ-DmjmoOppuhk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjYGItH5atO7nNwOJggnJxd4IwNgcnl5ZxPGDRgDrWeA&oe=6A918B6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0J3TWWHPoAQ7kNvwG3C37K&_nc_oc=Adqy5JHdjbANkN-IvMM4QvoDFocONOIn5_TAp-nwtrQtLRMxmzA_BvtBn4l3f_Lko14&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNwnc_VLYa7tHqRxS3RDro4L2w52Q1MCk475ENx4I7XQ&oe=6A9177F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ux-pGxeK1XQQ7kNvwH_Ct7L&_nc_oc=AdoqEiiF7FZTHZzgR87x_URG90paOkybaM-mzB_cJRR1KvqW91WNmuxYeSsE0Wxb-EY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4BRWFR-DeFuv0FwXYnjSoF-z56mFgekwVaZeQFBuEgQ&oe=6A917E40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKgjomzPv-UQ7kNvwHrock_&_nc_oc=Adrkxchv2sLi55-O8yw7bDkx4KNlATQph5b6P0CoCPHYjDzaY8n55qXVov8Qv1p8ilo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3s9_jchdtT7Lmtfu-uBwLC0lfKDDXht5w74xhEq3kbQ&oe=6A916
cdn.com&_nc_ss=7f20f&oh=00_Af-T05ZBiAI1T76olrBHRcjHF8O42e642sddi3q5V2GShQ&oe=6A25814E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awS9DZi-MqMQ7kNvwFNy5VF&_nc_oc=AdrgFnSq5wJwcbzKWn9vB7tSqZIaIar1tepw1KW1EutQ-pmG2ef7AnDi0DAO9QDK8C8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eEWoqX9ZV0iALvdQ07v4F4pRVPscjJNEiBhm00eQhnw&oe=6A2598A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9L2e5hMv4q8Q7kNvwGzgAwq&_nc_oc=Adqee75QhmuIhlguBHONNjUTelMuOYFHWACodPpLcdu1xX-BjMRIS1K_WpcmtOLhimY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Zn5nKJ5sBDk_AHFXoPk34COxKI20qFa-ctmdmt8OFAA&oe=6A25935D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rw-TTJ6RCfIQ7kNvwGnGUy2&_nc_oc=Ado2dApJJrdvcx9ulBFHUyoP2TMbsmrmQ-AwBUSIUAyBZOyDbRxdX2ithcHPjttXPIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tU8UTGcArnJI1noTRrsfC89Wg_5SJAAVyI8pLXsEIiA&oe=6A25706B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTjQXiZWsMEQ7kNvwESWYiu&_nc_oc=AdoizCgx7cowEefAnAuH-rD7lHcaEHKIQyWvIpv5F58qvy47bF41MuDYhSxokb7rQlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KFhjjMOLmKINyTwOoeZVc6pXM2EaKnz4VCrYcil0WDw&oe=6A259532"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbRT5hNYWwsQ7kNvwEgvuhI&_nc_oc=Adrml336hePDTcGqKHr4MTNOhzfYJF7XEEJCEeRhpmj-FzwNdv7EZDFfZgE-MrftS3M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9P0iykleWZPwqlqm9Hmo6VKr91zLVCN6ywamir1_DvPQ&oe=6A259B80"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdsJ8VYqsUcQ7kNvwE-mxuh&_nc_oc=AdpkTTmAsx9WfFZHW4PckAc9YEfiihNmJSahU9cM-P0VKCB8JLOVnbhS9_ADYbioCUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a35-6yv6yn01kH8ca4RQNHGrpxeIp6reRJvQFwV8DAg&oe=6A258
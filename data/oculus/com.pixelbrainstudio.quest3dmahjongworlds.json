cdn.com&_nc_ss=7f20f&oh=00_Af01NQ-oQEUL364EjVFjYf1HM62nt3BhJNu7vYeaPRTgew&oe=69F8AE4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxVCucRL8MEQ7kNvwEFXsNA&_nc_oc=Adr6OBDj-FNE3RFfYotkQUUM_u9whZbctoxEQt9aOlXFvCl1bbYGB-28ibfkB7YLj7g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bIrg9oO5yjjV9U9UFIzATmaOs-E7bFF_BpPxFgMqsLg&oe=69F88D61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1eGSrFzhbEQ7kNvwF-TdVv&_nc_oc=AdpKb7gEnbpz1S8w_T-0c7nXrjcQlejuSVcxKSSBEAUF-wjpaLQO-jUYC4xOaI80YJw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1zhMu5INIE-pnU-boKa_oIqT63N9sMfu8KR7u5RjLkjg&oe=69F8C05D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgt7ogrbrBEQ7kNvwFWWjtl&_nc_oc=Adq36N1bbUCVpIQrWP6dUrZVQZZ0VdH_z5bvHL9VIhk0vcMHRZwygj61WpVwlbaJFOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ahX2pD6o-oW4ilR3wWKsVV6goF5ohGzdd2bgB_VjNhA&oe=69F89D6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGQ7o7D2raAQ7kNvwFkOZa3&_nc_oc=Adr89Tp0Dd41bslXBnr_97QAhXhTFRjP837HktcZ7rRs68JP4wOLX03x18fChJHMKlY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3MrE_VbpFn1npyZxrgQB5-5E9SFCbXEJxvBzf3bZbwCQ&oe=69F889F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zVLwMWNL8MQ7kNvwFWy8nr&_nc_oc=Adp4RwJ9bYv3S5dW9EjYfvKAtLpsm1uAmS8P6PFvgtAXbmhwLl0YGxjQ_oYl3L_nguI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KN5WmaGBDbZc8mehkz6s5DGdGLX60JSMa1BgTk0GyBA&oe=69F89040"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIe5wU2l-qkQ7kNvwEmn_e8&_nc_oc=AdokdVXdWBmeXsSJZO26gjdB4AXQPOcJl_koRLvjtQdM6wS3enE97BsxWToMXSsuMas&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1LgybhT0mbv3G6uNd4BzXEXIJ0OMKX1FGhA2dqF4efEw&oe=69F8B
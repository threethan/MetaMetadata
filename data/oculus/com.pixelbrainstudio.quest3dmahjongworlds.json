cdn.com&_nc_ss=7f20f&oh=00_Af_2Puh51XN27LUehaUdd0mYBI2OoBMpGBOiYAyHIJLftQ&oe=6A35534E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TL7m0WmakrcQ7kNvwES1GmI&_nc_oc=AdpS6NmuaDwGzbX4wNoCu1yaz5V-QUOQtMr2xAjH_qTq2fGMofYo2ydlWnEFwD15wS8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-W9T7FzEZpbdYvoYCJRoa15YNLo2i1Le8CTtKG1HJeA&oe=6A356AA1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1UqJ_reJHcQ7kNvwGjmMbw&_nc_oc=Adrl67gPD6Q59yPXEIDHwxUwG7h19ZSszWsURkbxnyWayMhEy37tmBhTNVdZ8fxH0dg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2LARQLZr5UFdVB-MfI7Kae6qSbmjnIK0juCSBLHVMTQ&oe=6A35655D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szKI02qht2oQ7kNvwHEngi3&_nc_oc=AdrqpHmqwDPO2pydCaSF06SC1_f8nu062wfLXyLGtJrOigAzgyGOfQrXpv_fO0eGO44&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OMMybh1N5mlbz6wh6uSPoPhiJf2EW0hljQMY78iYiuQ&oe=6A35426B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGzo9HNcAfIQ7kNvwGz7Az9&_nc_oc=Adq5VMuZRMs0D3Y-qXjqhMF_fxGUpUmYAlxbqhrHeVeELM_QVD4F16Uz01IknvxaMI0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8m9tptwJS5s02CJBtXvsF6d29qpLlUJJkZtuGpPcnSRA&oe=6A356732"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elXw8vR0FfsQ7kNvwHrsOkF&_nc_oc=Ado4k2IHk3eiEP6lECRcKEVJnxA1p-YO3W-xj88nCYozEj0OeOXGpLNkCArpsHQdvVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ctAVswXdIl5Kj-u3DqvhLQu7lewGq6sw8dLWY1OFxdw&oe=6A356D80"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2J7FVQqRCAQ7kNvwEq_i-O&_nc_oc=Adp5KaEEljHram6MTSl1hibT2J863D95vOmw9TQAyC_TeOTbPcqWrXethBH-pNUSh5Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oKhfeAr6lpX02Z-wDwlec1BHXNlCuP2DLvQygXzzMPg&oe=6A355
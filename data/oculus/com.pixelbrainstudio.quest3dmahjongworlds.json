.com&_nc_ss=7f20f&oh=00_AQONA07s2Uk4u26kK0dyKuMwYb9jNZL1pPaIkSyuW-p0yw&oe=6AD0E44E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYYZljWYlV8Q7kNvwE4U_NF&_nc_oc=AdqSQGjxcrKFSAfkPcV-S_fjUwGa5W_4Ov03e2Q7bV1M9ggrGAn-35Qc_8c2cw6UGm4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-8amtv1mvHr2iEnsZKawEGbFyjA5233STn0VK7HNcvA&oe=6AD0FBA1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXJIkuG1sZsQ7kNvwEAEcMr&_nc_oc=Adr-PIS5c2nB-EGvFw7ux3RpBErlBc_n0MNhLleLGkszfoj0A0agkRJMYbqxi-d_LXs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOim0imkua0BlmZY_RBynu8cT8Yct4gi_64AglwmPxdVg&oe=6AD0F65D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPdkHRk8KysQ7kNvwF-XmEK&_nc_oc=AdoYpy2X-gXcrkaDUEWseFLYBiTiY_71Pvk5h0RFvzYgTooRD9XM1Hps7moHwhDm7KY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqzMnb0oRpNx7MRPF2jVw2yt5zNx3p4NjeWh8LVumj-A&oe=6AD0D36B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YThAxWNnMzMQ7kNvwF4mJOO&_nc_oc=AdqzhyObKphh2TBqSc6A88t6AiQ_vNGL2brxtvmBKwWkJgE9_2hVwfLVxR1GlTFLQmU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxG55dw1S3DXSCBUZw-cxUiinFMP-CRqg8bg8q2YrqkA&oe=6AD0F832"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jI-1sbhtEb8Q7kNvwHOT-8L&_nc_oc=AdroWngRpg2mC4R8AWK0uevvQkVstv1wAUyp2iJ0jn53e09CduBT-TCTUdExEu8x-bE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQVgFkMKDJZhHTHmZGGPcEh7KdPhc4HOImcNY6ProlDg&oe=6AD0FE80"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDYT70I0D3gQ7kNvwHwnla_&_nc_oc=AdrcFaXevfyf8FMS1XNk9JoZ8ohl6ip1btV4pOYa2UsPIbBbyWC7rx-iEF8cA9A4AE8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYNDJP5rxraJ2QQROywsllvVuUoE6PXDjfU73JzAz08w&oe=6AD0EF2B
cdn.com&_nc_ss=7f20f&oh=00_AQICO1QC0hCZj_jBI7hSPZj56ypRXsg5Fz_HlFRep7k96A&oe=6A9AD6CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMYH3aRMGPoQ7kNvwE0SgKs&_nc_oc=AdrF-GCWiceltGMT3qZiaouOZTk57eFG7tjMqx98sg7f68UXelsI11s78WXmjss2E0k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItBJXUuxilkZ8R1qIAH0iJ7rYzD0xTVc3Yx2LP0zN8dw&oe=6A9AEE21"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-qTL2NEPQUQ7kNvwFPmTFt&_nc_oc=Adq1XIpFECuzVNbyBjUZXQeK4GKFdUShgLcW25uEQfWLRol_EK2srrVobFNMBTSYGv0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBEGLkbz9WIs1d0lIbC1uMrYBMzD2HeDHRDgF7KXYq1A&oe=6A9AE8DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rnt_s8nNRAYQ7kNvwH2Zttj&_nc_oc=AdomD_IGCgdZU-rr_isoFlwmckFM5hQqXDpuBnmLBKGJYrsFV6PSKCLdUaaZSdbea74&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvY6itGve_MQ_-AWvyq7t15lvcDa1SxH8RmvVnbUASXQ&oe=6A9AC5EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kmb0dDkEgVgQ7kNvwFlpwmx&_nc_oc=AdrTIyKc_5fo8CxZ8MEucAqvZIYsDb9RgJUFfqXjptFSwny4pwvt5nIPg0GV_sJl_sU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4RTYnIhs0HdEc9vHb9y3FjBYDePoRfjSzzqDuLQ3u6Q&oe=6A9AEAB2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xcs6lVq4JBwQ7kNvwEvydOm&_nc_oc=AdoswivzrgYPqe5LqfsOZIBwyQdJXJBZHPL0zBv_xmnRms8CJj6zf-3NE6ObEA-jz1w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmkR1L2UDSszrYe_PaAqkrTB1MmBFht5r-Dp2Xvfd_Kw&oe=6A9AF100"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVCHJqt1ZvUQ7kNvwEbJXeo&_nc_oc=AdpVzLgrklFtEy0vLdWTc22yprmZ5etyL_7MynvzhZ0dik4Va4dg0NX04eULMkMW9Hk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpET4TUu-zbx4MyP2-jcPQx3XKp8HL6xQKqvK653b7gA&oe=6A9AE
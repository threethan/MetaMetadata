.com&_nc_ss=7f20f&oh=00_AQJJnGwM378G4q0Hf6yPAbadEAthlvN0oo5i6a2sTo2Xww&oe=6ABBCC4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgdoACA5V2wQ7kNvwHqUsKs&_nc_oc=AdqOaciQrwPvtYttbilWgiYDlUgk-e2m-Frgoja88jKjHY1hj97Oqw3TI13KIs-vATI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcGVrzyjUo1JooZHtPLjVDXl5yTclWzQIC451sR1ckQw&oe=6ABBE3A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeKhWhrcIfYQ7kNvwH0O1kL&_nc_oc=Adqt2vcJ4Z0E_S8ie6WwDtfHx1uNIX5wljf7khe9aZYaHcnuOBxNUST7gZU2WuPVVSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbbCiaztyk6lQLfb1aJgXf4vyLVi9Sslm_ZAT_G1qVow&oe=6ABBDE5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Arffu3r1N2QQ7kNvwHN9MmB&_nc_oc=AdpY9bIttLWM8a8Sn_YDlYsVj-L1QErBKhwZwBsjXRS_v_A4B424yvg_gksi3fYp2oI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLppLrtqF0mSrlsOidbT_l3cltD9361Ddc2Xx6o2_r7Kg&oe=6ABBBB6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GUD5blC5uQQ7kNvwELvel5&_nc_oc=AdqPA9RmenEv6M2UFw6uEuRJqR5wtV9ru-h6ypOG_ASF_HEvxlpnX1ZEy5srzsZYhc4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm6aSMhoTcU62SubdrY1IUxTGzRtCwAK22LXyhDP1C_g&oe=6ABBE032"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERTHJvjNDeEQ7kNvwH5mHvP&_nc_oc=Adqd6Jb3DMIMs5JQPhoRCHWD1f7AnGZh-zjqazYg70EAToGuimiMqhbKOxI3fexqww8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIn9n7etJJGHfSE19mRqBil4n1EJEbY9v87rIIHfE20g&oe=6ABBAE40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMCH_dmeBbcQ7kNvwH_-pPv&_nc_oc=AdqN3hzdWqHpijOiL6nfjw9-CMRAjoIBVsBTKPfaX3TzTHrA1XDl0NZ5t2s7l3EYtz4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN44wH9PKHUSjCOIVRWy8HDHLTw04uQStB-g9TN9jGEA&oe=6ABBD72B
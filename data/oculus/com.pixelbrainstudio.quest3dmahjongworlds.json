cdn.com&_nc_ss=7f20f&oh=00_AQBewVBFDkHpSpX5O3og-lP_MDWKay3o9E8JIaZRsO5yrg&oe=6A6A0F4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyGNLCAMrcwQ7kNvwHg8e1O&_nc_oc=AdrGC_l_YC3Aq-85sMIzoZvhjP23iNjBJL0gcy1mRh9goqdo7xwcr4Hg55aspERl5Dc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCT88KbVrm9vABl7M36RyccwN6BhTJx7Pu8y-JKR3hc2Q&oe=6A69EE61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbG2DAoFKu8Q7kNvwHDp51Q&_nc_oc=AdpHEGLR-qxcBcxOg5qOHHyg04-GAor6leOWVdu9PFlwrui_zAL7EhkJzDOQhQufR0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1bwnR0C8FagVuMfY2sGDdgdGQ-mnSdP_ixRpWXvt-jw&oe=6A69E91D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTlDET05pwQQ7kNvwGTKOKf&_nc_oc=AdqrU6DgykSGtgLY8R6LvgyH0YVF6J6W0RZS1A4KKdF_vO2PPSxKlvQe0eigKD6vJxU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdsgw2A0Z_PFcnXJgWrFarcnLUDbtzIlRQHIEzBm3__Q&oe=6A69FE6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VG29cSkfAssQ7kNvwF95y6k&_nc_oc=AdpFA1pZof9uWBrTjgWeyFTkfvJ3RiwtWheY_L-vaiZYiS7QK8qUh8wBnV1zmAg-S6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvupFzGBtHElA6ME_YPmC0mcl0-f4-Z3dN0FQEG_UifQ&oe=6A69EAF2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcyAtuRnN3kQ7kNvwE98vbJ&_nc_oc=AdqLZtJvEnynu_6TnHM2Puo8oPt5nEXmUcjUPZHUJX6ml9ZcCG-fRaBTAdoUyh6b7Zs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeKHjUMGKYLKuCePSWrUEExkZ-fuyYGCI5UUMcS5aYyQ&oe=6A69F140"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLqmn9hFDnkQ7kNvwHxE9j1&_nc_oc=AdpFewdZ72YkKyg62jN_aDXf-iMgquLwSBpSeaZowj6PuEsj5sx3zO-HW3xguPOVX68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAi8Caq-nnKPhgbuBMgQOOm8MjeS8gK4bgkLw3-tkT40Q&oe=6A69E
cdn.com&_nc_ss=7a30f&oh=00_Af0r4BqdNifwQp5PTZo6M_miofB3Yg1gChDP9W9dthfbIw&oe=69DBAD4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRj3VCto2Q4Q7kNvwHlzn-C&_nc_oc=Adq1jXaa-Kzpuk1hTf8JqV1_JobFbtj-ddUbm3eTBdVIboQ7p3sWGO6COZ_lef2RXsY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2deVbTeit_ZU2cmvsUWPchKyiKheTxqgIIBwMkBAsbew&oe=69DB8C61"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Be-zpcNqs4cQ7kNvwEEKsXA&_nc_oc=AdqQBpTW_1gVhj6RChMDrO3hON7a_VQiY91hmV3w8RXdcJdmaBwJKF7u__oKR6CraTw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gXiiPriDpFGCUt4EbofeUw3MHaJQAjew6cywXm_z4dw&oe=69DB871D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxYjlqsyoFgQ7kNvwHtuQmz&_nc_oc=Adoe-0KSSzq3QcdOIzgQVjxTp_T96qf0S4ic0MLrMLIV1eDSLsYEIK6MmObTsJp-sVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af000ugsKxxn0CcUpgawPqK_m8Jqmw7TsQ1Sff31jqXJig&oe=69DB9C6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHJOP8Ol-qQQ7kNvwGkYsBR&_nc_oc=AdrRnINIGKQCCOhWoGBHz_UGbZq0BadKx3I3ilQG6oZ4KDCd3KeakiiI48hYRzCsyVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ypKFa6UqTuNYMkR9Sn3PmtONOz2Rg4TdL1Ya2OWoUPA&oe=69DB88F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkksy7OR_H0Q7kNvwFr2A_0&_nc_oc=AdphQxCjbMfK8e7qx1spdViqLM7XUkSFQ5fQHkbMK3NrJArQvI75i6n102iTmQDo9V8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Tw4fJukfzRX4hjBcjydrP77It_6a8P7B-SKDcwN3WRA&oe=69DB8F40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-TsS5xD_VEQ7kNvwE48t4s&_nc_oc=AdqVkqYE1ELeCOev-OdyqucKhbXMIQXUJr_kQDjBs9CbxgZ-Dbnt4T6PZ_iqtMR_zlE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xnHDO6lTqjKvLfxRSGeFiGS4pVhhv-WYjgYjnOurB3g&oe=69DB7
.com&_nc_ss=7f20f&oh=00_AQOByvvhCqgJ1X1Is4e0nxBvHRqudz7fw4p_Rw_8LmoVwA&oe=6ADCC1CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1DFdUiwdqAQ7kNvwEgjcHx&_nc_oc=AdpzmsLd9ZNXM-0tbA0G0bLSo0JbN9rtVj8YZwZgsQosE6TAyhBbejEYh33jxi2fM24&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4Z1WHm5VZFHLLn1BJh-Tw7wGYBBNYowM4oYgsjCyppQ&oe=6ADCD921"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18QUFunrH3IQ7kNvwE3XctY&_nc_oc=Adose6dmVJDFjTtzQLtIdzALyscooWf8nrctwbcooGgZHLpeX4fv1GVE5C2fLzceEsI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj8q524BFusEodMn74HuDQNJ2RBNtcD_ww6WBvmXnzQQ&oe=6ADCD3DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9Lfqy0TQNMQ7kNvwHJBbvl&_nc_oc=AdrpnPB0qGULlw6231AnoKcJSVJkRBl7rWfKjqbuZG0NInaaE-HqOBMBAbw4dpCX32o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNACIPhbuLjJK6fcOh-pz7Es5i4cCwJkmaB2vvl3kQUJQ&oe=6ADCB0EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDWKBdosipsQ7kNvwHM__C1&_nc_oc=Adr6f6yzSxwcxev-B85sb1JE6lmPRlCQ-a_-r-5ClnczhtB22e5iXsFE7iI9TjBzGgc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBhhHrjFhf4Eh1RBvc3n7DrUYT9pYHVy5Ar8Wfdrte-g&oe=6ADCD5B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cl5JQt7iYmYQ7kNvwFkvNEM&_nc_oc=Ado6B0NnnJ07F5EpViZi1yK8CkeC5jF6mDiAwRb_6i2cViaG8i2pA6tCCFnBery9fJE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6ZSXeeRG-UfMOQORhfq7HDN5yc2JJs99Jgt-VBMmbVA&oe=6ADCA3C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14OKS6jLma8Q7kNvwE_ySHX&_nc_oc=AdohWD-E88wjAPzBECJnXYRAk5OOeTr-V9AwOGlQTqROqTSlgeI_1YkVOJbHpl5iAAE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsZFnSiuiS3jIJWBIyFLkS1_R7drhMfdwUl8UShptJ4A&oe=6ADCCCAB
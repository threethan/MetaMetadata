cdn.com&_nc_ss=7f20f&oh=00_Af9lAa5ECZFmrMCUeeXbq-u8AjxKmt6nrz2oT2JOodmdgQ&oe=6A3D3C4E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6wsB__0ZCIQ7kNvwHoSN4g&_nc_oc=AdplNKiJcQ_-1oqE0z9PWqTjjLMdEGHuR-5qzI2792jNhFrptux5YW1Shd3MyblPmOs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Vhkuy_JqPa_wgU9LsTr5nL7EwTvx2QGTrnerxlIOAsw&oe=6A3D53A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1XEmxvy-S8Q7kNvwEVtTjm&_nc_oc=Ado2kDoAVXSDDQlmm6Whd3hmrQGaeJzgqeEqtHUxjmooZIJH2cbZKPVR58hj4DVHWEQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KrywOIrDlVByg03fNSSf_IG0314bNSWrxpv21ekte7g&oe=6A3D4E5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Imeb5N40iIwQ7kNvwG-YssU&_nc_oc=AdoX9wNSSB7URQ-4OE4-zJB7Q_xmlpBfEs_TATOOkfQWFvWGH5Nm9--ZKz2Quqb85Do&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4Lsu672BJ3pp--_O4bHmXqTtFZVOVTeN4S5JGkSCo1Q&oe=6A3D2B6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kr4uwpUtpwQ7kNvwE1RHwk&_nc_oc=AdoicIe_DAGboPkTUldp281l2JVsFMXNnNfM9M7C23VgSgy_n6ct6mlKJLSgTJ8uH1A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LHlMwxExUOlBvn2SBuSB5CH4U1Ruy7aItmP4QMcuw8g&oe=6A3D5032"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsaE8kVIGrcQ7kNvwGAPS01&_nc_oc=AdpuA1LJoS-yyoQMnWzdowrH8WMyfYfNJyg7-fKGc4eDl1LfIb0rLF24WmsM8684yjY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ooeRs8qVVvKrKFkhqgc2AD_uDY9pxeJ8DMGCIAeKqdQ&oe=6A3D5680"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTlS2H7Rxe8Q7kNvwHlhVXp&_nc_oc=AdrKwPy0F-gG2yWZMDdeHHsOJa3mlpShZjLTUZ4ByfS6L5BVUnyDxZ8al53XvfjvVl8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YLARSjwODRNIJxvSsnKjXi9kPzAklYH_IIIivSG9x4Q&oe=6A3D4
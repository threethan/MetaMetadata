.com&_nc_ss=7f20f&oh=00_AQPtDrJ_McavWgBhq0dKZKebSHY3kWcQSzPXTzjitzbzHQ&oe=6ACF92CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYYZljWYlV8Q7kNvwGvmbD4&_nc_oc=Adri2VeCgPLKjlX4hKFT2WfIbXbfIWyzedWTlLXei10NR5mK0NnelnIAFh7eRwarSMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7614zpPjuvsgKyuuOE1Xow4GeCSe3bIhcZ3dv1lXH-w&oe=6ACFAA21"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C62D1r_SkbEQ7kNvwFu6NTg&_nc_oc=AdoQSK-J6erBT61dDkKQmhiw9V9GGIrTJ3akhUU58banQ3TYoZHpvzwVe1rnsjwaak8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUyAurducty3h8knL_N8ATEGU2p_IXo0_8uFN9nlEXMQ&oe=6ACFA4DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPdkHRk8KysQ7kNvwGhJ8Qs&_nc_oc=AdqbluzmD46mgw9-VqDBucx755lLlbN9PTjbEm4BH4jIhqjpFeSg08MfB7By_rEYxKk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDcecOQL3p5QyUpVw2BI0__zhtYUde113N4NjARRBpqg&oe=6ACF81EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2Xm7vYcOcUQ7kNvwHSSpWf&_nc_oc=Ado_NlXvC0COrvCP4fdzgfLQoeRldh58Dtfn3n_57ZYTFwXdBsnm2tRhyEyhcHPu9O8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlXi9JaASidzRZME_PjeVxljw047bmlXk6joYQUgykxg&oe=6ACFA6B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jI-1sbhtEb8Q7kNvwH4ngsm&_nc_oc=AdpJ94CggdfeCj1k-YoxYsWz4P1xoEhx_wWT73TfwT0389mKfA1aXmtSvbjHIla67kU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtZ8VCncUq81jUsJkns8G82ZYRshrei42FFlUF4p7-zQ&oe=6ACFAD00"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDYT70I0D3gQ7kNvwHwQAHh&_nc_oc=AdqT_FWgWFh6MQPyWfR7OZQXC8_gJd17QpDv-gNAvcvHYSTjouHMf_RhTen1yKQBkNQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtoke3TLiNVx08KJ3HZUBmnBcY2dPYRgDefDrutbRFGw&oe=6ACF9DAB
.com&_nc_ss=7f20f&oh=00_AQMP1-wdtrEt647hdkZMkTL6NpAN7a_vsUE63uIB3-DnPQ&oe=6AE0B64E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0gr_52PnKkQ7kNvwGB_ury&_nc_oc=AdrvMs3o3mbDHmMy6Uki1hqbupU5v8FiFIMXhx-djieOmVrOxZJSqSUmApCB1BOiHRs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBpSbAmYK01ur199qbzkxU8s8P6qB6liAWMlGftQqLmA&oe=6AE09561"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=679in72yQ0EQ7kNvwG0oMI5&_nc_oc=AdqXZXQi3d8fskW7iGfZA-1XMR1Ec7_td4YHX_ijqxQmK9-GjnSRwG0wTVbf3MMnlKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhrbffnxJp3sp8HnDWvwM7-JQiXe2h2HNoS2oMbkYeVQ&oe=6AE0C85D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa6UDvZCwgMQ7kNvwHkZQyK&_nc_oc=Ado1R8K32QOzVHpzLGesS3S1RComYvMXeobbpWtjio8c6yfOf8QHeK6Yhjark7w5bos&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpKsiixp1hn0fHEkRRBLmnWl8mU6fV6RP2n715Av2TKw&oe=6AE0A56B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY0YBMX2OK4Q7kNvwGfZRb4&_nc_oc=Adr-WloppOJ40m1VjIZ9DPxOdJ4LjZFhAh3ABisUenW4fTX17oCQypar8gpFbOLy5BQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSvYSlW4yEQLPP3vAVajuNtbvs-Bmax9rcFgLRmHokuQ&oe=6AE0CA32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDwzDW2VODQQ7kNvwF_PWg6&_nc_oc=Adp7cqbDO0utmcdj2O_kAgPA1Y2rg4OZR9YQEP10d8bKz5pUICnXpwSWvto6oxevQ5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPViPZax2wbPPVxq34Dtyoaf-rPRsmPD9P_7tEBpY7MeA&oe=6AE09840"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIT25guW4ZkQ7kNvwHt3GN_&_nc_oc=AdrHGw-pYzvR3L2bidvNTjSuGpORIwl19L2ZR3UM7f35fo2mEr_pGieawsReGCeTLmc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGgUTqI5lL0AqD_slrM2zc2as3S3pkIPJScNwC1umPQg&oe=6AE0C12B
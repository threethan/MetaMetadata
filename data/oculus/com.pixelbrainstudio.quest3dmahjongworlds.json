cdn.com&_nc_ss=7a30f&oh=00_AfwQ2PacxzrGamdrDYN4v9d0262RxTXXaQpypFSlCVGskA&oe=69C7E6CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sgNtJgzA84Q7kNvwEbxw8A&_nc_oc=AdqCTaRBC9kvjDLGOJLYibQVWeF6f1NG4NqdIjldP903gTB7B1Llv-_HF0XyKC_h0U0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_dGEuL91w4yjXKi2oSBIqCKu9DT7o8zA1WESnKlQ_cw&oe=69C7C5E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh_K8aC-hCkQ7kNvwGSKGnF&_nc_oc=AdqifOioER4m86P8x5PKbNbM4CQ9JJw1bExgYyFamMHQeWEZwbm8ar85w-HCmkAFHQs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyryo4As3wMq7YZRZ51s8O1ycszGVKclVP5-ZCIIuZhNQ&oe=69C7C09D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7x3spNMB-bgQ7kNvwGwK8q-&_nc_oc=AdpK6tKS2FeLNCBwA53BDVSCC1XRbbnJc00eVnXUZlj8bGTFqMyXUA6Q94NSwUVt7r0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWdeQswpFAjc7k2CnzkXsTE7DE-W1qYi09r2INel6uxQ&oe=69C7D5EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByjZLE31aLIQ7kNvwEm7W31&_nc_oc=AdrGM_vcQMPlkuyqMfLBcckJzzEaMgfB_n6J7xdRwl5zNUL2TLou7Cvgzg-KYVU04JY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlPdfQ9OxFHjl3CFpCT2f2V-JrTMPTMxrskx6TBHx-0g&oe=69C7C272"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_81qLWcfg8Q7kNvwE7yMJN&_nc_oc=AdpDSSw9vTK7RFAPKi3hB9LsTEQCsI2A9Q9KKXWlJ1l01nUdye_y_eNCN7A5G9oF5_A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzkcvJHB7ueMWOUwBQGzyZi4Y4OqmVsvbGGjsIHJ4EBA&oe=69C7C8C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y10xx1KOoUYQ7kNvwE06RvF&_nc_oc=AdpHArsVzvIIyJVEdGj7qYMy_FpOvl6E0SxYFBST6JALDdm2KY2YYpA6Y_Zffkzx8tY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyyr9b6TSU44kIU6Qr_sdRsecywT75z7sNor28rKNZ_DA&oe=69C7B
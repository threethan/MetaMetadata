cdn.com&_nc_ss=7f20f&oh=00_Af4ycFbp8-_EFKE4pnRtMrbiswk4o0BivJ7Cyq3Y5BZhTQ&oe=6A1EE9CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UopkW9HcvDUQ7kNvwG8o54o&_nc_oc=AdqlcwIvyiyCpBYFikSAFqy4hnK8jrdjRMnZMrvyZWkvv6LNcbmxSPzbOUKpD66IR4Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58i1JbjXnYaNAzf047WR6E82rmFN0uIDibBcR6Cspzgw&oe=6A1EC8E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iDKJP9QwxoQ7kNvwFuh-2Y&_nc_oc=AdqSYw6l42XJgbeghytS_kvuQ0olBazpMSP5Mj-pkUOPcQzZxHAg1Uh0djtH3il-i7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mynqJggz6_XWUtdAA3afGvSWrXJLuyskSX9T7myQBRA&oe=6A1EFBDD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrAoJhhDmNsQ7kNvwHugPaD&_nc_oc=AdoM1yI1TF65qBdyMX2vot8rMd9CtR8I_lq7qkLs8tjM06kfIJknkM2gDzXrE3jLx_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fm0J8mxflD1CB60QqkiABKd9UW3Za5Pr_qaelMEJBvQ&oe=6A1ED8EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ar8at9w2jN0Q7kNvwH6Zg-x&_nc_oc=Adr5MUe6D3PU63dhXX7o3q-Op_KMJPpBUWNw3J4KhT59Xgiy3kOyZ8JdMk59eqe3GoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TFqj4rk9fR5HJI-0z54rM5Q-7FlCuTV-pUFT6koNAmw&oe=6A1EFDB2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oy9CsJ9d0PQQ7kNvwFprNAs&_nc_oc=AdpxR7oYqBwISxce15K_C0spT_znFawDYYqmrSEYhhCiponKuCPD8YrXNP9Jwx4RcAo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65FnMXqRQ8LtAn75aUvzkoeve_n5SN8D8yedxrSU30rQ&oe=6A1ECBC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsUXSYDV36oQ7kNvwFUitg3&_nc_oc=AdqK9GGqoWewsBFCVFrkxdbsbRrz2DL5FV91J2ZnreFnl9oKyFz10jpLotr7oB4tdgM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69SMkrSCuUoD1FxuhDrCk1Ih3qNd13UPJyttZAS_143A&oe=6A1EF
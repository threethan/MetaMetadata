.com&_nc_ss=7f20f&oh=00_AQJ5yOfaxs862IJ6PFPfEThRXq3HOgdpKJb8h2sM2HfRFg&oe=6ABD1DCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgdoACA5V2wQ7kNvwEXnfLl&_nc_oc=Ador5Xnc4Ef3KkCPJlEkXc5WkE6HZeM2eL4CdnABQlNaKu7Tlifnqi7w8EVtcksFP2w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi1igkuY7IIfAaxcfusrkmUyyVpPTRVzgN8sRdu2aFtw&oe=6ABD3521"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZudY1IwRGm8Q7kNvwFguw8s&_nc_oc=AdpQCVe3Q1ZmwtszOILVMueN-Qjzq5ubQRn6AGVBn9Krpzj04hXTywFhBfYh3zsyugM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoC6Jm8KeuAs4kLZFnUneC78PS6H1BtcZz7FjSsMDYDA&oe=6ABD2FDD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Arffu3r1N2QQ7kNvwEPh6V7&_nc_oc=AdqFo1uQsD3l0YRt8ro7vuY-vPUqztUwlAdNQ8jvwk4asv8g0VI9sc5zC5bYNTcs5Tc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOEQ3MJ_W-p-payR9KLOgo_saZWV8UPCDVLm7nm-14Rw&oe=6ABD0CEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZAgi8ACrFQQ7kNvwE2qsH7&_nc_oc=AdrVuozCBtqDnsW-IDc1th7chhWTjh2T_m7zbAjbryQhzzbEE7_OO4HZrkDNunSCjW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL4woGesTqxKDYz-JJ_RHe1tgTqmmzZIdfP_43nFZpNg&oe=6ABD31B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERTHJvjNDeEQ7kNvwHAqKY4&_nc_oc=AdoqIsuavnKesmc72kjSMFhy_tJX6ZasWSeAgxA-X-muL9-5oAQP0neQI3DYOcx4pHI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKOaQTHULUeSHqI6EWIFGpuCv41mYxjxOdy6too7aT6Q&oe=6ABD3800"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMCH_dmeBbcQ7kNvwFJK3ms&_nc_oc=AdrSOOKfWUkxCOQlSuxZBVPYQSgXy6j7cC72GWmbK5x2OqH2DzpukeLNHYFbmmziNIM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMiO7JMvvWrM2-Sy_y5ze2bp6Qx5v0I-saLGGEeode0Q&oe=6ABD28AB
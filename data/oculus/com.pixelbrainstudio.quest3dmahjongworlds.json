cdn.com&_nc_ss=7a30f&oh=00_Af2t5XQhlcaLQjkvK6ip80Cfrw_BHfvueAnriFJqjyRrUg&oe=69D272CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vtY10DVIYwQ7kNvwFrB7zL&_nc_oc=AdqGtFvjythCj2wLsM4aRCyeuxbSWVnPjbU7V5iN6fCX9NF8fh8AcRF2RRLyIey4f1Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QeNkDT_0mmiVO57kAvz72RiMNJ6Pz1iLmA3vRXKKHHg&oe=69D251E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZJPEGBje8MQ7kNvwEFZUC1&_nc_oc=AdoOmvvw0xFlOGDifOkCr-aDnPshc4UauWaOfOlqkN1vl_E8QWsVCelyjQko6M3rHY8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UP1dv2C42J24t6dpcuQHKJne3a76K1ObioXK44NB94Q&oe=69D24C9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3JhA68YAJ0Q7kNvwFAxVf0&_nc_oc=AdpnPWKn9-mbTVG5_rPenA5L1KwtOf1RV9IiCV2sg6stULSzWSg1UC_EIEDpw43M1AU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ePKVmB-aIzrsz3EeW_zx6EqOYDXOW1bEnP-iVe9HUpg&oe=69D261EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-nfsXVa-PoQ7kNvwEuErNs&_nc_oc=AdrSb6eBhdZ2q4krGTTeO0nd_U3hD-lDwjgCjuvx8vJlV0X58I5mB623Ng9KHhcft0o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xS3LCJhXKrPi0VCQb3JTa6G2IG1hGezgX4B9id3Cjxg&oe=69D24E72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyQCvKB4_ykQ7kNvwHPkawA&_nc_oc=Adq6hfE-TaGwG3NBULxUfCJ7F4NYzxfgWMweYOoJa7FgJApPw5vWp4kPZgvpN3dECGk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0I2EFZn36XTeGhKkyDSqIkntJzkvCrQRE2l2mETmQeSQ&oe=69D254C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06phwcbHbo0Q7kNvwEZE7sd&_nc_oc=AdpiXPuT_1NUHlQbO14Mjn8Ct0TmbPgRy_hujLHPNA-GfC42VWla5EeOCmTXDqtGSYA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GaJX-h4J0_us9kMR-llC-YRrDiiN5vLJDkknkUrb37w&oe=69D27
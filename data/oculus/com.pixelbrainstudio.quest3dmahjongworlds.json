cdn.com&_nc_ss=7f20f&oh=00_AQH_SpDTKq2r8dc29uJRKdpz3ip09L2djSGi8jYfn4QJOg&oe=6A971A8E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6b0VaDi96YMQ7kNvwHPrkqP&_nc_oc=AdohM8HpfvUS-70pABmL2PtrLthAflf3T2oVLvjsSS97rNA2Hxs3P1n8183QboBeG9s&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHByQzdldBJOUFowWevhvTmqXCynTnXc31QTL_m7VE53g&oe=6A9731E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JIgCyVf2xUQ7kNvwH6PkT8&_nc_oc=AdqvJeNskuzPHPYcmcUImKwqMvtKLQBORRXzcKJ-4JZafCv6dJbI5sTtb3QOCqBSu9Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhrcqQbvgdAkqocsWjRKcGcyK2bIh3igEU-YsKXSnxdQ&oe=6A972C9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5A4tJQ30hoQ7kNvwGuEVFF&_nc_oc=AdpPwkV4pJFhkbgPf8LTir91syEDMChmFb5iAtsgVMveiCwre17U9aSc_Ob3dGPu4ss&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl7Op5BcNsCkhZz7cSr48d8FL5ZxXJpzCi9xX83tWVaw&oe=6A9741EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Su6czSL5ZkMQ7kNvwHg4zI4&_nc_oc=AdrY21VfXO4JPgHBufLer7mHEbm5XOvpgfa7_aSTdOih3ftpnQhefmUwWjZNYhiC0Xc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfj6kT2TulaE42drSXPLxzX53VkwJI0_grpIIIh9PpqA&oe=6A972E72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDp1fKiv8F8Q7kNvwF_rema&_nc_oc=Adoq0caiv42S1quLn7M7lWgULEcNmHFPYg4j6kV1s6paVsg6yJkXOYGHTNi24-E7zyo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmNo3VZiDHTzAu2dNadpTVz0NhZbPbKMwdzGcFsApdhg&oe=6A9734C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVCHJqt1ZvUQ7kNvwErPs-o&_nc_oc=AdoiI5nvCeaJBYzo3-rS5aSoYhQLNAEMThFBUBTaLLQvLYE-Xs3sOQLJRRYx_HCIZaM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6QBWI2ERcMQ5t051Mg_TV8otsmBH56EYfJuKJSsFB1w&oe=6A972
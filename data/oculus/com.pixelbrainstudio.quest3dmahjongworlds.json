uluscdn.com&_nc_ss=7f20f&oh=00_Af5LQk7CrGiofNA2F4TqP-iw-BfggH4_bAN6lRRpy-43uQ&oe=6A11BACE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cp57HDvFAEsQ7kNvwHzPTLA&_nc_oc=AdqINMTSicjJAJBYO1qRe-AYMk6RLbg3SIZks5SqLuWz5LlbPz_FCpj84VgXIAlToUQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wVnTtfGkcDQ1JhShMRE22p3HXvNm2O8LWVFDfbWOc7Q&oe=6A1199E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX5GegIzRVEQ7kNvwGvcMwW&_nc_oc=AdpNxrqIve6vyj85hvtPG2hMhI4cAuXttWt0lv6M4xjAF7Lci9vps4ziwe54kHujFdU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70wGq8fDRR4eOwG8KcH8xWovTaGQ1GX5vTOYBT2MAcCw&oe=6A11CCDD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3AdyO44kqQQ7kNvwEovLtN&_nc_oc=Adrk7-Sdc1Sx1RODYVgofM22U8gVFoxf8d99Bht-wbmPHKA_SaDKSSnYKETd6FMttdc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uySSED573fJByadd8IDSEG9VgVT9YcZzGn53_-IYfjQ&oe=6A11A9EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6BiDjcHGq8Q7kNvwH1o1bP&_nc_oc=AdqubaAZlPYpOhWYh_Vg1fxz96y9pIf6RQEaFj3SBaP3KrYe-AykkfEEHiekR5Q5niE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6U7qq5D6pCq6HjibkX_6SuelIk4KE03w7lATV4UQtC3g&oe=6A11CEB2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlwoIJ_eUgYQ7kNvwFcZGq_&_nc_oc=AdrBTsKvRmiUA0uw6BSrc_UbQktxXh2uF-c2xNtg_u52GTESoxcO3iWmi_GiXNoDgU4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50gC2qVbVnnOt80DfQCtCMbGzP6FGKfXLSvGjzWu4Lkg&oe=6A119CC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDe-dfEIMzwQ7kNvwHJ34BA&_nc_oc=AdpFmgm73IRtSlwwMuKFQixlSYQp3Z1XU0bEfoH4MFFsp3-WuGrWuzy1W_uUXJkAWFE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ck1BfGKmYSgaiWXeBMmJzTOkRVIpsHoPSC4soXBHaeg&oe
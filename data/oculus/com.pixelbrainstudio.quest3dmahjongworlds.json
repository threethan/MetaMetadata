cdn.com&_nc_ss=7f20f&oh=00_AQLsFGrrx95KXniE0EbCuyYh5559uqAQgNMoXzlBWbMWlQ&oe=6AA562CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDFvSBPJmL4Q7kNvwGCySfm&_nc_oc=AdrlyVjlT3DmNIKJNKJ5aILy4S1-8nhziD8m62K0_NG5BRkbhnWTtic0dIL-l390HzQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBs2T3h5_Vy1IIqIHKYvyBRG9BwcbLrtrWwwD1-aAeJQ&oe=6AA541E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GxHUunSv9sQ7kNvwH-JahW&_nc_oc=Ado7xhRDOL1BMfsXVY_j48hePi2Eb9pDHFzJGi4gmfIThMFUS7dOw9eVCfX5JuGHGF0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWcBgKKbdaAZnP89AAaSpempmt3yRbSxEISz5TFimVkw&oe=6AA574DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ep64OBlfPvAQ7kNvwEj-Yy_&_nc_oc=Adqfkj8sFdC3x-4j_DfW9tSvbMp6cVZZSJFtgqa4rEV62HxvYqtV-EZmovypGB1Fp8M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm39q8IatBiu5MoPk9guNi7WGq5TlCnNtq7tZBkPvv9g&oe=6AA551EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u22cmHT1yl0Q7kNvwHDaloY&_nc_oc=Adq93NnfWJSiTTeEEW5R2UDFBG8JwxWPWDXNBD_f20X9iclsjorFrfWqmt34DTqVFsA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIINwLpN0EZHtZDLBk467Ls3UkVO_sCjhYENo9XI3dtFQ&oe=6AA576B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9Kpaglxe4MQ7kNvwHD4Apl&_nc_oc=Adr7kgEx9Aj-8VkugE_FWM75OI0zoeoTrRmpJmd6Z177aZUrESln-NYUHtXOg7MuSrQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRicGLO1J3FM8RNDEg9AyQLypIiS69Kk7IqfU0jboJzQ&oe=6AA544C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiWaXVFlCgEQ7kNvwEegOUE&_nc_oc=AdoUkEmh0pu_Rj2js2bL_qk6hoAaKQmuZa3bdz14RHOIvu6Wpgb5nYfsK5T7b49Cm8E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqF-tCO9N05fZQfAWb5Z7NwMzry4dreEEQoLXJbxRVSg&oe=6AA56
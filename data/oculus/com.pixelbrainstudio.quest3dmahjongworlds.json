cdn.com&_nc_ss=7f20f&oh=00_AQGffOKv32ajGlI7gM5A-qTW3Pnw1kjQvnog0hKdgLlEsQ&oe=6A7B32CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rbftLgOL8kQ7kNvwFvckJM&_nc_oc=Adr2DicW9nEbH0sEcT8HjPPC_iZCHqRjjjtaGkysqxNYmCJUFwoVA6CWks_KFnoxVjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0H5iBYDx2YFlg7pwNYA-I3Yqp2jnbIT39Lf4q_KiqtA&oe=6A7B11E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQgjXwuzpcAQ7kNvwE0e8Qj&_nc_oc=AdpDAfRUkridWtv5RDQXo2zsP0p4Em9AKscF9ixCACP6e0ex-suLxG4h7pRp9F7e2FU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4gtQsokgZBrDlZrLJRfkITPQXWuCaxxdT9V81Vs3cYQ&oe=6A7B0C9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QO3-YKA9gYQ7kNvwGyZxWa&_nc_oc=AdohLcaIbk0ldFm5EtNHeiI0_D4ZMIxuwOlPNJ-EsKOuSk3zAl_nXt_6exPJt7cG78I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjDkNIVexOGwpf9OKcl6vjwfE8afHkn4PNbgEDmfv1fA&oe=6A7B21EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZzqnRV7QQAQ7kNvwFLlyof&_nc_oc=Ado_avX0wPbO4Tj2afxOQWQaWog9ffqtDEeitZC6oRM_1boT_89_CQb52ucgKja_7Gs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG88jC_Qdw3kL_ThwF1MYVfhdNQoDcy11EwNjkh-WBLtA&oe=6A7B0E72"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEgBmgpaCLkQ7kNvwG6JM0-&_nc_oc=Adq4C_JcVv6yy9GTydo37HoUQ0E3OyC32gIs6e_mbxo-e27YQr0FRcjQYifaWHhOgSM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj6jrpw6p98GfremuBXwopokSmB8qC_5GzmafuvB0F6A&oe=6A7B14C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpbwKDW8ZEgQ7kNvwEval5F&_nc_oc=Adr-wULc-Pl8WGyUlqwd0ny2l21lWN13QFcFwv0N8sdf_oHbT3VYoTxpRQtBW5WIB8E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3Z8NG47oWLyO8fkWpANWR-LNSaakJ5jwaiKTojiWaRg&oe=6A7B3
cdn.com&_nc_ss=7f20f&oh=00_Af4zhOVcrXG58MVAf1ruK18AkQi5S0ksR4vEZYRxpn7N_w&oe=6A00974E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz_qSNzBlWcQ7kNvwEgIedV&_nc_oc=AdrcVsbpNooNziVrLGByO0yxN5mjW1rff3AuuuMAAVNVBTEgH2VUEuOIrqZM8BnhnoU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b2dO3--W-FM5Ab2EAe6YHdqHIWgNHKZhJSictxfWZHA&oe=6A007661"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPNRkGDTKd4Q7kNvwG1-0A3&_nc_oc=Ado2sKqHGVIOtFapG3QBcT5J7TrOxCuDs8qjBaTjNLZGQAbR5uYNCuSMP8t8onExYm0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BJ88Zc3aUDSGYl-VnpRNozBfSHioy8LfdZ8vOWQzKwg&oe=6A00711D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oV_nO_Rv28gQ7kNvwEHzUfh&_nc_oc=Adonk98YLwW3_TFuDYn1PA-9G3HyP1Agh5Sg12GJFKRfidVD9F2SZOqAWblgE_jMueg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tv-_by9jkY_u0Gm80sUt_ywTt4jZMwZH59LyFEaZ01w&oe=6A00866B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBi_6hAV2PEQ7kNvwHLmBXI&_nc_oc=AdqjnO1t6HwqfetTmwMemtWX2zHp13DUTaVoPy_d47Qnm-gWqarOpzzWS6tjfR59Nx8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-uA05nAIqXTH0ElxwEPOQSCo_ZTCy9bI7_nqIW0SZrA&oe=6A0072F2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pH3MsS_A70gQ7kNvwG80yl9&_nc_oc=AdrF9LpINBw_neOyRBGxyuAqUk62bYt0dezmzGMcIqd9wKW_-BVvqhSeOx6abmx7b7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sAOI3msy-dtVCfwzGggKuAlJHwx4XpyiWRXqVf6Auwg&oe=6A007940"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkPEjhNsE0gQ7kNvwGH-P4G&_nc_oc=AdrbPg_j3S8-QBdpiNr2p33r25tYgcpj_h6HBVNCCVa76JrKPk4OiRPRMlkopG0EypM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54C0FHyGxUYeNu07UNGoUAhJ-iAJulYpxh0XSYzOv5ig&oe=6A00A
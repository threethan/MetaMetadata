cdn.com&_nc_ss=7f20f&oh=00_AQJilG6hTGpOgOrXMetAGt3buMVWpfJBXMCje1fwZly_8Q&oe=6AAFEECE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_sGmpJCZnYQ7kNvwH2fMfE&_nc_oc=Adr6mWCtzR9OmeeK-1lhpyOfAirQktKeeJUYTdnjZU3E2beLFJ2yGHUy7PCiNWXijDk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpE2DipSl1gt8Ckqndqp_He1bizcAfloJ8WGskxF4V3w&oe=6AB00621"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08j_Yb3z5KUQ7kNvwEn4Wzt&_nc_oc=AdoWLrXuD1Uxogv0zGqNlmYanqe9GL498xIIUYUubpJ0fDICO282ylTf9g-D2D-tK20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfykw20cDua7STJPTphe8BqR0vQrPH728sTh11zF-2hQ&oe=6AB000DD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkEEz2mfCq4Q7kNvwHR_ByF&_nc_oc=AdqL6MwWOCTx1O-eZOF498MLHtyEpMXztB2Aim1iNHA-DpZo_E496S1J4_lYf2gfvSg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITOVc5eU8W6rSDa3u_DQdU3T-038f96dt6YHmJ5F65IA&oe=6AAFDDEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STecAsXz5WsQ7kNvwGB_yF1&_nc_oc=AdorV1OG4UkQWoAyS2ngNCaM84BVdTAxnkS2bhX4sg0nn0JxDsWcq2BP3lQpEb-3oJg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8s0vAZNfaAbdD2AosfW-v6dlQN3xrlnE5JPscdTWUOw&oe=6AB002B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vV2iu8jISSwQ7kNvwHq7qXe&_nc_oc=Adozma-1cPedYGtFqAJ5XeUMu4I_6duezrhL_okkasJi7PxYHf6JP51h3Pxb6T7n8CQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1FU4-DLUYIjNpd5P_9VmyT_oFcggjIPCyo7rqf7v_JA&oe=6AAFD0C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLVIQ5eiDfYQ7kNvwGbeZ2e&_nc_oc=Adr9JjLZjYc6UeJRo-022qIe2qCob_vuf-dHBn2yR53keK07ZNLNY7ohmzRl4Vw1ksE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnuwnbN_kuga7Sg_thWh21FZ6xnchEY_FdfoUE-5g_MA&oe=6AAFF
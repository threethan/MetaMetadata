cdn.com&_nc_ss=7f20f&oh=00_Af3hIi1UeoAmBhxBoZo29a-RCXNDBKLqazCEhwfhClJ7yA&oe=69F4B9CE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSk0vuwEJ9sQ7kNvwFfM53J&_nc_oc=AdqeIwaI4jsA1Krse1ipYNg7AOEgOA8XSB92JT5HiE-yZqxB5Yy3B9EgpJlJjOo2zDk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2XmgjRwOE4_xjkSMxBa6-DurjcCEedGOPtG6oeczVCPA&oe=69F498E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlJSyCSz0eIQ7kNvwFoqxBC&_nc_oc=AdqxmDNiJlllkncMlT9-hIRvbE1Lo39DMW2tcnIPSyXZx1KLQeEwJW1ZV0lVA_FsXs8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35_nORu5n3hhFNDhE5BiT3Q45jkW5DnRMIZjtXUSnoFg&oe=69F4939D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmZvEOrEU88Q7kNvwH_cyIm&_nc_oc=Adog4BsTvgjAbwp4Path2iB8e2rCdtj6BlLL2PX6T9yja5qTfMFQ1NBAXWp1tXmdeNA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1N5dirEJVPlkfZlaqZ5bEuzy75R-aI4eKe2_xGwndqTg&oe=69F4A8EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqjXckECkZoQ7kNvwFr07fl&_nc_oc=AdpRSo0tUETlG6UQUIUFL_BJ-fagK65CwxDijAGgbCwJW6xbQtSWH8sxL_mF-EetULg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2gI4cnXa6K3OHsUkJdB8hVAheh2bawJlcHM8te7WOaLw&oe=69F49572"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MBiM4jgvRoQ7kNvwFcruxa&_nc_oc=AdpZhxCtGUKERG0XtI9A_PUmT-GLiK5MpxfRS6tHt0f8YdA0wvazAdglX-gTgpmGYPM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09VBvP3ymXrOgSbRnKXCxcq1CcpmkjP7LXV7hu4CIj5g&oe=69F49BC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2Q7YMXY6zAQ7kNvwHaEqvk&_nc_oc=Ado95MT25aVhFWm90rAJfq7O1rgAvdgnb8fQyqFwtJLfMALX1rzApnBTIYSwANhdbVY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VC0xapJJocx47VCqwDiA9I0-4UUuqMVPKzAJbX50p3A&oe=69F4C
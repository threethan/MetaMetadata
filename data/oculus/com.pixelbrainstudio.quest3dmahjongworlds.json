cdn.com&_nc_ss=7f20f&oh=00_Af7kVGMDiFl6UaV7XZzMsVQnFyJ8k4KA6n0ACVv5WEC3bg&oe=6A1AF54E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7bEvpCEfBIQ7kNvwHVL_rQ&_nc_oc=AdqsFRMc0uy9C193Hcsc8TdbbZwOYGOWlpdYXTNXppEmGd760tRW884o8cUcOrKMdPs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZkzXclfk-5OL3rANUQqFRUTo4sGZJltDrSe8Atc9o8Q&oe=6A1B0CA1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrqKyi9tmnIQ7kNvwEsKuXa&_nc_oc=AdohOo6-e5RoHGcCfE6Z3TgmdfjrrAECA8FDjRHiGC4DW2boCbN-WSmIxVmq7z3htQY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48CcDfDpQmGAwQ3Ejty6SoPqTTOpaL3dgZQKZkSksUjg&oe=6A1B075D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXp9EOPHxH0Q7kNvwGB_eVp&_nc_oc=AdoKHDcFK2wJnKaZZb6T4GGFMQaKkLa4Bres0S2KLp9c21aa2OWNN5kA_L228J3rRLg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JGp3HJusA86MF3moBme98vZWqvk1SYZr-q6m98fRrlA&oe=6A1AE46B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0FbgRRoybsQ7kNvwHZEQ0b&_nc_oc=Adq-v-GTLwfBd_Q349wo4RJpZHBk2qEXBa5aHjxI6quGuqhQ9_L_3HskbFSTSZiwRKU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59Xk1yEpTsxf7lr76DPCwseNS4GHksNtO-ECZZtNSMnw&oe=6A1B0932"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUqfwHovJTsQ7kNvwH0qUDj&_nc_oc=AdpL_2Wj0JoMH2yzLVAHmfAOG1r9vJolCjtzU33SpPvbQXKrYnd4_sEkObEnRq7sa8w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N6Hb3KmIlPMWCzoomccgi1dHe_s49QQeR0Fnq1a3U0g&oe=6A1AD740"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvTfpEE7AaMQ7kNvwF2e4QZ&_nc_oc=AdrJ3erEtSzpOno_WP4YYsL34TGgBEOsAJQ_NmlropZUf_T0Dcv0LR1JSVje8K1Bex8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7urONk2HJoThVoHAaCbTySRqDwsnjOL43H_Z6L3v7F-A&oe=6A1B0
cdn.com&_nc_ss=7f20f&oh=00_AQL3TLL-c1qmFkl2InjDJ5PjLMrTkPY4hOb8-iDS8pVzmA&oe=6AA01CCE"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VhgzLeYvDkQ7kNvwEgX_Hp&_nc_oc=AdpZrVoTEaZF6gvfMiJP3Ms9bQcfg-1_ws_4JoDeW9PxmxfQkSv01hZOGQJviQqG4Lw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJogrWJXe33Gd6sncPiupDYi0u7_rEbHO8J3AMpPJ_9Q&oe=6A9FFBE1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQB0iZhxW-kQ7kNvwHZni62&_nc_oc=AdoOwviPKG8chJLlv7vr89dpng46zqjDiom_l27da2fruQeFNkGlWWP5LYUl29nekd0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDfEQPnhSU3E-ZgjQrFTqtlZiq1Utdl-5-lzMd50tR0g&oe=6AA02EDD"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxRvobHGUDIQ7kNvwGbaI-i&_nc_oc=Adqy5uMuJCGqAI9F3DpyLtierxwBm7_K0YuGCpKQP8IrwlNx-9BD4vsuxOkTgOPPUDo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDAr_8vVhJICzXhvldCWlmht4bzC-z2iL5eNzMzX0OqQ&oe=6AA00BEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68B39OjXEsEQ7kNvwF-L_H9&_nc_oc=AdqPH1R_qN8tpAqQuXlLqN4mVPXtlVwGD7chA5FQG-hhp6Bs9GBMUPu9LCpXQM4SExg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKleCvcvoyGWavo-rgdcAykikIzxlGVTszGb1CLMeSGMg&oe=6AA030B2"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjZHjoJIdaAQ7kNvwEAM3-P&_nc_oc=Adq2YnpQpENzjIEt02QhzUtvy5yL58EmZrzlhski_SZTRPqqtHqbQr1E5obtkC3Ihwg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL54jgYYyRJowwcR7i1ePi-nnS42ka_LBB7Rds8K3bkZw&oe=6A9FFEC0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9AVlxeYS6YQ7kNvwESLTEi&_nc_oc=Ado9aauqEkTuWqlcYOE4rKal-ngCRb2Pc5GEKpYHhhjDCL1YIuaXeY2DWMbCNhGkfyg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrY6LtmVb_UUht8dZHyyBPylK5bZUIQzfuBvXreZpvgQ&oe=6AA02
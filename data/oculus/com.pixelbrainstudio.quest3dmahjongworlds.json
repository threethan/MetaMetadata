cdn.com&_nc_ss=7f20f&oh=00_Af_fiXTFKWsrcjuc3fA0rpZCWA3Ui0Zlwdj5fgql9RlhBw&oe=6A28244E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kU4_TDFmPQQQ7kNvwFx9qc1&_nc_oc=Adp56miq1Z98dMUuBt2O4yfhbwufW4UGMvCzLDj6dy-G-ZnrWi59916J1BK3pEeEaI8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W09ZaleQcS8yOKuOGHFqszk9nJQ9I---outR9lFOyyw&oe=6A283BA1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS4J4zKIImEQ7kNvwGhm2Bx&_nc_oc=AdomFCOm3RxjxsUl-Tk3gDWS3R-SrMR2L9ranQELfL-0W-SAIVmsyu5wLyTlpsx2cF0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rUTXoFvkL0Ga1Se-HUfQJIw_Qjo86twOlWKJ-PCD37g&oe=6A28365D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WP12wX2oHUYQ7kNvwFebTF5&_nc_oc=Adpc51d7XwlZE8XqEu9IHtvsVRl2oK5Y4X-M0WZBlmevg2rbkqFZLV-x4E_1BSd_wvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_twyXjJcy-vGiG1_tzsQYHSGYfnBpijA6kSiSop19Lyw&oe=6A28136B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvsZpmY5QGwQ7kNvwHWuH6t&_nc_oc=AdpVBi4jMLMhzlImcPFXKPiT5RwEIyNsFi-1oMU8IPSqjRr3OY3a77BRugs8K2oJVbA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eX9MQmR1tNxw8FUHLjcuBeeVLbIDI1hJjhxyCp3Oxzw&oe=6A283832"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWjBZ0_1gZ4Q7kNvwGCVO3i&_nc_oc=AdqtFzCVqJAnWcyMe0mQMxi7HjpxYN03KMvw-Y9FgaBDVrPySWWlabp9VrmxUMb7VDE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AZw6QpPNS6qsMmUOSZ_xbzytKHs1nTX_jLmaDorylDA&oe=6A283E80"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdsJ8VYqsUcQ7kNvwHcpf-0&_nc_oc=AdqkiBRvvyeNJDGWTqoQSObpG9DucRVyEognsD760EiohLZ8RyWAzewGPLeT67bqewg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EsTOC3Yr-pKYhHb-PDYj1xyJ1ih9ErGlw9kROWGt0eQ&oe=6A282
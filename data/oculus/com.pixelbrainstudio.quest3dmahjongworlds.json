cdn.com&_nc_ss=7f20f&oh=00_AQI3edP2yLW_AGbLovRKClnt75TpHa0PZxKMW0CMwS06qQ&oe=6AB9294E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyjlX5j51OcQ7kNvwH3HRo-&_nc_oc=AdoQd6TbRqBdfREQEnFhY6dYyHouTMq3SWwFoMjr2kKDn6tSln6Hg_6sMeApwHpHoZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIG1EnhTcwv70F2-a8J51ut67gGPzxLEeICa6Bcl5ixpw&oe=6AB940A1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeKhWhrcIfYQ7kNvwE5IEuT&_nc_oc=Adq3p_Sr_jlTKQBbu3hue_DCNRPK0ulo2XiaBwbj5WtIIljuhnlNzLkPl4jM5QGj0Nw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg6OTwj_8Z62CNdVOl7Ert7FVQf7p_cpMKfvHbO27kOg&oe=6AB93B5D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJn-uEtKKl8Q7kNvwH5jb0d&_nc_oc=AdoHWZBUafMxHxZ7xaE_5cJSdZbheU055IL1sDq5e4rWMoWQ-pzhoqU8LQTuWRANyYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpowtoAg6C9VO0-kXm49YZAZ80G4QP_UZ9zhJ28RChrA&oe=6AB9186B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GUD5blC5uQQ7kNvwGssich&_nc_oc=Adoh7kraxyRbDBTFwJEIr5pu-5QTzxrZfzqebZ6WNit_LU3LdYla9EnKhxX1SQeYDYw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUAD1JlZPPXNcWKDx9fxzH_OOT_qs9veaogUaAtavmDg&oe=6AB93D32"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbAKj8sKcSkQ7kNvwHQibnV&_nc_oc=Adp9EobfQT5xov_T5WVN72S4wc8jUGW4lvdlQYgN_pOr8zsEYh9JmGd4_E27XJHDths&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAmpcEhO2TtSkX-q1olG_lIvNcPqN_79Luk32YjU0nDg&oe=6AB90B40"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAmM-k71O_UQ7kNvwHvEC6A&_nc_oc=Adqwhp-sGfAdEb-xmI9D_MJFFRmrJI6v2-3-fzHPeyDKkSnzUf0874ccpJJeeVG6JZc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKolrQJUqEHdWzuFGkyKsU4CXQOHx18KFaeuL0BgB3Zxw&oe=6AB93
cdn.com&_nc_ss=7f20f&oh=00_AQHi7yOIX362LEk1pJlLGPIgJmHIK9Nk1Zihklx7_D8k6w&oe=6A8ACC8E"}, {"file_name": "screenshot0.png", "id": "1050089296957888", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393507_1050089300291221_4005946916113578811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Jx5oh3TJ60Q7kNvwGpKRqA&_nc_oc=AdpI5_SW2fqoHqoMIlMwWFeyhMQbc5Hmin-OxaLrcBUC2CIs85KZB3-tnAJ3Bfvwunk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfPuXFA3Hr5bmvqzXm8Er1oUC-UgtPflcM0vw6uc7_OA&oe=6A8AE3E1"}, {"file_name": "screenshot1.png", "id": "1665609347391518", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392309_1665609350724851_6308235494894957927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vk7Vi0-0f5gQ7kNvwE8RUAx&_nc_oc=AdrOZcotXMA4bKLJwxPUnvkePusbCIKvCe9CWp_Xlefh7q3PR5jvWZrvUTNSlMtiRys&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMLjoQ7vIVsoZjqb-iHufxtX9rid8uyAgwQPOV788T0w&oe=6A8ADE9D"}, {"file_name": "screenshot6.png", "id": "943327351077800", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/468741112_943327354411133_7842717366783559423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgIbllqm7XcQ7kNvwGNOrII&_nc_oc=AdoyUK4MASX1KPEVv_Oyg8ydrwIASQ88sLwcxH15O-5c5MdjWbWjbFjTw3qUHutKeQY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjrYv87W2Xtpl8Bc_f4aHLqtyBPSVTQdIDYAH11UwH0A&oe=6A8AF3EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapefull3.png", "id": "1181005139718728", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036670_1181005143052061_709758329527305958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWHvALENbYIQ7kNvwHCJhbQ&_nc_oc=AdppKo-AcEWAELAaeY7J7UkctHm6oQetMUjkXS11xJYSOvdG4G1dt6C5F6FVNtb5OzQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUsLDpi-gg9rfY7JKuhHU833QC8a5fULyIaKcJFa4KqA&oe=6A8AE072"}, "display_name": "3D Mahjong worlds - Quest", "keywords": ["mahjong", "board", "relax", "classic", "puzzle"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nWhether you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, and simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings a relaxing experience to players in a 3D way.\nBe the master and pair all the cubes to eliminate them on over 30 levels!\n\nGame features:\n\n- 60 levels\n- Mixed reality support\n- 5 Relaxing environment with daytime and night mode, plus a random option.\n- 8 Tile set\n- Classic and 3D style levels.\n- English, Hungarian and Simplified Chinese languages.\n- Rotate, move and zoom the board.\n\n\n{808240775651188}", "short_description": "This is the VR implementation of the classic Mahjong game\nCreative design of solid 3D mahjong levels and simple game rules!\n5 relaxing environments, 8 various colourful tile sets,60 levels and night mode! Mixed Reality support"}, {"images": {"nodes": [{"file_name": "logo2-chinese.png", "id": "1628457724592817", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75568725_1628457727926150_374747833840138475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCTIGjOQJbUQ7kNvwFdMdRz&_nc_oc=AdoqvEHURyoxQ8d17TK_lqw3HKyukyVF07koox48WQ3eQ0CGQfbA1ZAC4qJsAQKGJww&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmeqxOxJzvTB_d-nQP7WE1sp8V6qshWaiPwh7UtciX3A&oe=6A8AE6C0"}, {"file_name": "landscapefull-chinese.png", "id": "1452552865375930", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210891_1452552868709263_7671164401111142330_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbBuy-LjRsoQ7kNvwE6WB6m&_nc_oc=AdpdUW5vfOHvj9ioN2P3iirZwSDY9fYCBNDUuy5NG6ztgMSDMhTUb3GP-BbvFIt8uYI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-uDZLmzTr432mqZJRgVKinw80O9CNg0N8zG3Cf0U07w&oe=6A8AD
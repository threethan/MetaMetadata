cdn.com&_nc_ss=7f20f&oh=00_AQLxWKzMs7kxcn_u7Mwx7v6Vln3xbGuA7xypRKcSwPjdpQ&oe=6A9C251C"}, {"file_name": "CubeInvasionVR_2026-07-27_20-30-05.png", "id": "2864849653849186", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308245_2864849657182519_6268455646253999433_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6riLo8jc3X0Q7kNvwGcRscx&_nc_oc=AdoQNQagKvkT6fCmh_JWdPBa-A5kqiZ2JIsOQeDwP8r5dzZN1XIYzeUhYeT4VrrnIXA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLlumuCsQIa1Ovk9HR0AzFODPNblI4IufIxKcr0XD2_w&oe=6A9C345C"}, {"file_name": "CubeInvasionVR_2026-07-29_19-25-16.png", "id": "922594063486341", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823910_922594066819674_2467618278523355645_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRzPwRHwfIMQ7kNvwE97spl&_nc_oc=AdogP0uuOZ3k0ObsdDmTz2EA1e9GodNFrkypJwkDn83CPko4mOZWOMZ9TXYD6TY1rts&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQd_CZGmAh6CO99hKUVkkxLMJL1VT0xXcLOA5Wt6lTpA&oe=6A9C0FD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cube_Invasion_VR_Landscape_2560x1440.png", "id": "1061583500137311", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827987_1061583503470644_7843392288085924269_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zs6h-hw3RmsQ7kNvwGSRn64&_nc_oc=Adoppl7hUroJjzTyI7J-CjLp3gxnPZZwIZsh18crqvQOtdysHRpjAnu35gZZpzSjDns&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSeiF-Kw3pJXg2SfQIr7b3b0PQ4c1cHyb5BVzVnu-Ttw&oe=6A9C3C2F"}, "display_name": "Cube Invasion VR", "keywords": ["medieval", "combat", "strategy", "building", "sandbox"], "long_description": "Build the battlefield. Prepare your army. Then step inside and fight.\n\nCube Invasion VR combines hands-on building, strategy, and first-person VR combat. Fight through 10 handcrafted battlefields featuring soldiers, archers, siege weapons, destructible fortifications, and a wide selection of medieval weapons.\n\nWhen you are ready to create your own battles, enter the level builder. Construct castles and defensive positions block by block, place units, assign their roles, and design your own combat scenarios. Then load your creation in battle mode and experience it from inside the battlefield.\n\nFeatures:\n\n* 10 handcrafted battlefields\n* First-person melee and ranged VR combat\n* Swords, axes, hammers, spears, crossbows, shields, and more\n* Soldiers, archers, and siege weapons\n* Destructible voxel fortifications\n* Level builder for creating custom battlefields\n* Save and replay your own creations\n* Immortal mode\n* A combination of action, strategy, and sandbox creativity\n\nWill your fortress survive the invasion\u2014or will you lead the attack yourself?\n", "short_description": "Build fortresses, lead your forces, and enter the battle yourself. Fight through 10 handcrafted VR battlefields, then create your own maps and watch your battles come to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cubeinvasionvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ondrej Papiernik", "support_website_url": null, "website_url": "https://cubeinvasionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1210462948817990"}}]}, "scheduled_offers": {"c
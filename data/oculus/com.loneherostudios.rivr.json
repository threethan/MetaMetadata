RLD \nChange the world with the tip of your finger. Shift between dimensions to pass through objects and get as far as possible. \n\nHOW FAR CAN YOU GET? \nCompete to see how far you can get. Try to get as far as possible and run toward the light at the horizon, and beyond.", "short_description": "RIVR is a colorful and fast-paced runner experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.loneherostudios.com/", "developer_terms_of_service_url": "http://www.loneherostudios.com/", "publisher_name": "Lone Hero Studios", "support_website_url": null, "website_url": "http://www.loneherostudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "691399588691885"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410199_1279126438812348_7095168192103841792_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HneTm7azJ70Q7kNvwH7CRMr&_nc_oc=AdlLxDohr8s41O0EMP-w-ZdBEfcFzlXCs1qhIV7aAcC2-M7GKt9xRCVU5QQJN_tzSUQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw_eVgk2cPcYlBxlCibm48eDJQ7VsvWjFoXttXmugPYXQ&oe=69B80B2A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RIVR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1485936000, "lastRevision": {"nodes": [{"id": "1704321589897197", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_meta
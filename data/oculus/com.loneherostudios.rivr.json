, "video_trailer_thumbnail": null, "display_name": "RIVR", "keywords": ["runner", "color", "endlessrunner", "blue", "speed"], "long_description": "RIVR is a colorful and fast-paced VR runner experience. Use your skill and your color shifting abilities to run as far as you can and explore different worlds. \n\nRUN THROUGH THE HILLS \nSprint through grasscovered hills, green swamps and frozen peaks. \n\nA CHANGING WORLD \nChange the world with the tip of your finger. Shift between dimensions to pass through objects and get as far as possible. \n\nHOW FAR CAN YOU GET? \nCompete to see how far you can get. Try to get as far as possible and run toward the light at the horizon, and beyond.", "short_description": "RIVR is a colorful and fast-paced runner experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.loneherostudios.com/", "developer_terms_of_service_url": "http://www.loneherostudios.com/", "publisher_name": "Lone Hero Studios", "support_website_url": null, "website_url": "http://www.loneherostudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5489350941079957"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1174838885944592"}, {"status": "PUBLISHED", "id": "1997666417116352"}, {"status": "PUBLISHED", "id": "1260153480774280"}]}, "baseline_offer": {"id": "1174838885944592"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1485972000, "status": "PUBLISHE
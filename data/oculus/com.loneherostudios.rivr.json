61A"}, "display_name": "RIVR", "keywords": ["runner", "color", "endlessrunner", "blue", "speed"], "long_description": "RIVR is a colorful and fast-paced VR runner experience. Use your skill and your color shifting abilities to run as far as you can and explore different worlds. \n\nRUN THROUGH THE HILLS \nSprint through grasscovered hills, green swamps and frozen peaks. \n\nA CHANGING WORLD \nChange the world with the tip of your finger. Shift between dimensions to pass through objects and get as far as possible. \n\nHOW FAR CAN YOU GET? \nCompete to see how far you can get. Try to get as far as possible and run toward the light at the horizon, and beyond.", "short_description": "RIVR is a colorful and fast-paced runner experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.loneherostudios.com/", "developer_terms_of_service_url": "http://www.loneherostudios.com/", "publisher_name": "Lone Hero Studios", "support_website_url": null, "website_url": "http://www.loneherostudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "691399588691885"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410199_1279126438812348_7095168192103841792_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hFic0By0u4Q7kNvwE6XkDC&_nc_oc=AdpwO31gXUwfvpnNpWJveJeZVgqmy7-eTMF-I2yaeYCmc849Hp-fTjVi-_AmRQQOhRw&_nc_zt=3&_nc_ht=scontent-sea5
a0a&_nc_ohc=-8mp_LAuuqgQ7kNvwG0f7Ex&_nc_oc=AdmXJqvm7p96E4xkWN5mA3eV6JcVOmj7wfNAYG4TA4p-NV4sI4lao8AlLg2dRiFS4ko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsHfH0ro9qGGSk7qQuypK6kOlVFiqS2PxtIA34DzgOTtA&oe=699EE47E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1427948671318771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363516_1427948674652104_2112728140341695944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aKXb54z9KIQ7kNvwEPKCwn&_nc_oc=AdmKD-_dYbeTpOl2rytCjlMfyl8cLh121yfXLCPBWFnXAvWyO2KTx739Dr0MMbXVCFo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuDJgR0a19XmDFVCZteuwqSyNxzjNV0Mo83poytZazN5w&oe=699F08A5"}, "display_name": "SIMVANA Nursing", "keywords": [], "long_description": "Occlusions within an IV line are a common problem nurses will need to resolve. Learn the basics on how to clear an occlusion from an IV line and resolve issues with an IV pump in this interactive competency evaluator.  Large Hospital networks rely on local schools to provide trained nursing staff able to demonstrate competency with their equipment prior to interacting with patients.  This application provides educational institutions and hospital networks with a tool to streamline the evaluation of nurses.  NOTE:  This product is distinct from our existing SIMVANA Anesthesia Product which is sold via our website. This product is not intended to be sold direct but through bulk license purchases.", "short_description": "Learn how to clear an occlusion from an IV line and pump in this interactive training and competency evaluator.  This product is for Hospital and Educational Institutions purchased on a bulk licensing model.  NOTE:  This product is distinct from our existing SIMVANA Anesthesia Product which is sold via our website.  This product is not intended to be sold direct but through bulk license purchases."}]}, "developer_name": "SIMVANA, LLC.", "developer_privacy_policy_url": "https://simvana.com/pri
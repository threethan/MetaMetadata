3328734200", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974589_1750473332067533_2536540758744324937_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg4MhrE4MJsQ7kNvwHql2Ek&_nc_oc=AdqrYbKh8PQ-dkDhMx7qiRRLXflX7PPSON8tf7XLWLMnogcUPc67B3SqtLjr4NsnX_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Wto3eu81lcH8F_oanbra0AvnCJG0AQ2Wkpw2v7977tQ&oe=6A31733E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1427948671318771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363516_1427948674652104_2112728140341695944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXb_qGNv6D0Q7kNvwFvKHOQ&_nc_oc=AdqjBG-_vn7rNM_73qFb3B75daxtvhtuWpBTWTBGtqUD0Uon8Z8hcm4IEwukbLn0eoQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-acKM7B5g0lo-5G8jZfUOD0Rr6JXBfJwx5Moukd9jSQ&oe=6A315F25"}, "display_name": "SIMVANA Nursing", "keywords": [], "long_description": "Occlusions within an IV line are a common problem nurses will need to resolve. Learn the basics on how to clear an occlusion from an IV line and resolve issues with an IV pump in this interactive competency evaluator.  Large Hospital networks rely on local schools to provide trained nursing staff able to demonstrate competency with their equipment prior to interacting with patients.  This application provides educational institutions and hospital networks with a tool to streamline the evaluation of nurses.  NOTE:  This product is distinct from our existing SIMVANA Anesthesia Product which is sold via our website. This product is not intended to be sold direct but through bulk license purchases.", "short_description": "Learn how to clear an occlusion from an IV line and pump in this interactive training and competency evaluator.  This product is for Hospital and Educational Institutions purchased on a bulk licensing model.  NOTE:  This product is distinct from our existing SIMVANA Anesthesia Product which is sold via our website.  This product is not intended to be sold direct but through bulk license purchases."}]}, "developer_name": "SIMVANA, LLC.", "developer_privacy_policy_url": "https://simvana.com/privacy", "developer_terms_of_service_url": "https://simvana.com/eula", "publisher_name": "SIMVANA, LLC.", "support_website_url": "https://simvana.com/support", "website_url": "https://simvana.com/nursing", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6546167128824189"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1706251646891043"}, {"status": "PUBLISHED", "id": "529101509543204"}, {"status": "PUBLISHED", "id": "1536390190429831"}]}, "baseline_offer": {"id": "1706251646891043"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1728499440, "status": "PUBLISHED", "id": "1706251646891043"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8024208877686666", "version": "1.1"}, "id": "1475356123228999", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6466055580168678", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary
5/12427537_1080051798771044_302053019724283904_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuwPUeFdLUcQ7kNvwFMxwYt&_nc_oc=Adry0a7CMm-_UBW22TvoDSo8c1dGdhZ1by_EJNkbzXD2NQ-fYSjslh9BH-uBpp6smGQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaJJuT2QPWNTGvsSxgG1kWqKtvGo1Va3qK8CDWr9GbeA&oe=6B070851"}, {"file_name": "migrated_image.png", "id": "495892207757233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504696_1759219934397488_6357274874867613696_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aG6Ju91u7uwQ7kNvwH2L3pB&_nc_oc=AdoWbaxYpmdtV-9J7e_XhLi1vQAWnXJAxCTBTWuM3KZkbUmo_L3ACY895w2AlBBg8Dc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcCQjWtLBWH6D_xvgQoTaIlEEGKnIFEKTlETzrRz0TfQ&oe=6B07237D"}, {"file_name": "migrated_image.png", "id": "378191986397556", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12504696_590155017836368_1687091642386874368_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZtQk-HNgAcQ7kNvwHwPUv3&_nc_oc=AdoriEOvptxIfv_Oviufo-R87IvDE5Nv0_b0ITPMJ_W6vKtzFMlEjCaCU6KPaRl_UKU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStL5y_00ItTnf4DvRFLYrJ2A5BhKc_ZLlRoNkWiBlOlA&oe=6B0703A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Telekom Cup \u2013 360\u00b0", "keywords": ["Sport", "VirtuellReality", "VR", "TelekomCup", "Fu\u00dfball"], "long_description": "Erlebe den Telekom Cup 2017, als w\u00e4rst du live im Stadion in D\u00fcsseldorf! Verfolge das Spielgeschehen aus mehreren Perspektiven: Ob ein 360\u00b0-Rundumblick oder drei weitere Kameraperspektiven, die einen 180\u00b0-Schwenk zulassen \u2013 der Regisseur am 14. Januar 2017 bist du! Und das alles vom heimischen Sofa aus.\n\nDem Torwart des FC Bayern sozusagen \u00fcber die Schulter schauen? Kein Problem, denn hinter beiden Toren steht eine 180\u00b0-Kamera. Dazu noch eine 180\u00b0-Kamera auf H\u00f6he der Mittellinie, und als i-T\u00fcpfelchen sogar ein 360\u00b0-Blick in der ESPRIT arena \u2013 Mitveranstalter Telekom mit Unterst\u00fctzung von LiveLikeVR machen\u2019s m\u00f6glich.\n\nW\u00e4hrend dieser Testphase werden wir erforschen wie unsere App genutzt wird, z.B. welche Perspektiven und Blickwinkel pr\u00e4feriert werden, um bestm\u00f6gliche Erkenntnisse zu gewinnen, wie eine 360\u00b0 \u00dcbertragung in Zukunft aussehen kann.\n", "short_description": "Erlebe den Telekom Cup 2017 aus v\u00f6llig neuen Blickwinkeln: W\u00e4hle mit Virtuell Reality Live aus insgesamt vier Kameras und sei dein eigener Regisseur. Hol\u2018 dir die G\u00e4nsehautatmosph\u00e4re aus der ESPRIT arena direkt in dein Wohnzimmer!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.telekomcup.de/", "developer_terms_of_service_url": "http://www.telekomcup.de/", "publisher_name": "Telekom Deutschland GmbH, Oberkasseler Str. 2, 53227 Bonn", "support_website_url": null, "website_url": "http://www.telekomcup.de/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EXPLORATION", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "de_CH"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "487022539706991"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1549348528415852", "version": "1.1"}, "id": "351294798575984", "channel_name": "
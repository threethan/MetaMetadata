://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031516_906467881419899_8045527000867820757_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXDy3YVCpvEQ7kNvwFRGgWP&_nc_oc=AdqtMhQ4kqiCBvU2Yt6rBqex-b6QMyHKM90BXPMDo-GZ86x2Sg8O6BHXJ5RxT84SpLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEthbpfSck_ej4AF9RwHSNYRVTHT2jExs-BJc_yci12kw&oe=6A787798"}, {"file_name": "Movie_0431.png", "id": "1199328317832685", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1199328321166018_5979713979581463363_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rwdCyn-C_UQ7kNvwGZp_V8&_nc_oc=Adr8R_ZnBkONUiBKAie-0I8pOs-kvS-_yPGV-Gz2xc4E30dh0O86Sc0gotp58knH6-I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFJmmxPyPc5p7MqDNvDKgaAyUleZswSDkaKe7B2NtaeQ&oe=6A789E1D"}, {"file_name": "Movie_0430.png", "id": "562108009728237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001684_562108013061570_975627845942109605_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMN9Fi_VSJQQ7kNvwEKssS1&_nc_oc=Adp4aG6SCYOAz_5dt3OI4cQznZ6xa3KL_cudTau7oSZ7R3tAguBdUZBUHzZTU6IsDZs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLtsAgFLeZYbrTdjXaCtFbRSo01fmiwjoctFiH7kSWaQ&oe=6A787C2C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cyber Gun", "keywords": ["rhythm", "shooter", "beat", "cuberpunk", "gorilla"], "long_description": "Rhythm-based mechanics keeps players on their toes. The game emphasizes reflexes, positioning, and adaptability as players face waves of enemies of increasing difficulty, each with unique combat patterns, strengths, and weaknesses.\n\nLocations\nIndustrial Zone: In the heart of the city\u2019s production district, the Industrial Zone is filled with automated drones, assembly lines, and towering machinery. This high-stakes battleground is fast-paced, with cover constantly shifting and traps hidden in the shadows.\n\nNight Markets: These bustling hubs are packed with neon signs, food stalls, and holographic advertisements. Enemies blend into the crowd, using the chaos of the market to their advantage. Players must navigate narrow alleyways and multi-level structures to take down foes.\n\nCorporate Skyscrapers: Ascend through glossy, high-security skyscrapers filled with corporate guards and high-tech security systems. These levels require stealth and strategy, with advanced enemy AI making use of holograms, cloaking devices, and aerial drones.\n\nOutskirts and Slums: The outskirts of the city are dark and desolate, filled with abandoned buildings and hidden tunnels. Here, players face some of the city\u2019s most desperate and dangerous criminals. The soundtrack here takes on a darker tone, amplifying the sense of isolation and danger.", "short_description": "Enter a neon-soaked world where survival is key, and the beat drives the action. Battle through diverse, atmospheric locations - shadowy alleys, high-tech labs, and towering skyscrapers - each with escalating levels of difficulty and unique enemy waves. Armed with customizable, unlockable weapons, players face intense combat synced to a high-energy soundtrack. Precision and timing are everything as you fight through hordes of enemies to claim dominance in the ultimate cyberpunk showdown."}]}, "developer_name": null, "developer_privacy_policy_url": "https://monsterrush.online/Privacy-Policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cacao Mobile SP Z O O", "support_website_url": null, "website_url": "https://monsterrush.online/Cyber.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
ng", "id": "2577097242733093", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824665_2577097246066426_4277289553193595208_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVDbUlajbfoQ7kNvwGdRo2a&_nc_oc=AdoOVoUvjZ0gaUpNnKQRCaf9HbblRrZcnJcwIfvjY_DLEXzb3_wF6ZlNobamlWNaAKY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk6u1VMRhzq4xo5EZOMa2VEZb77ttEJHANI3KR4m3QUA&oe=6AA3F618"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c0\u03b5\u03c1\u03bd\u03b9\u03c3\u03af\u03bf\u03c5", "keywords": [], "long_description": "\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5 \u2013 \u03a4\u03bf \u03c7\u03c1\u03bf\u03bd\u03b9\u03ba\u03cc \u03bc\u03b9\u03b1\u03c2 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c3\u03b5 \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\n\n\u03a4\u03bf \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03ae\u03c3\u03b9, \u03c7\u03c4\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf \u03b1\u03bc\u03c6\u03b9\u03b8\u03b5\u03b1\u03c4\u03c1\u03b9\u03ba\u03ac \u03c3\u03c4\u03bf\u03c5\u03c2 \u03c0\u03c1\u03cc\u03c0\u03bf\u03b4\u03b5\u03c2 \u03c4\u03bf\u03c5 \u0392\u03b5\u03bb\u03bf\u03c5\u03c7\u03af\u03bf\u03c5, \u03c5\u03c0\u03ae\u03c1\u03be\u03b5 \u03b3\u03b9\u03b1 \u03b1\u03b9\u03ce\u03bd\u03b5\u03c2 \u03c4\u03bf \u03b1\u03bd\u03b8\u03c1\u03ce\u03c0\u03b9\u03bd\u03bf \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03ba\u03ad\u03bd\u03c4\u03c1\u03bf \u03c4\u03b7\u03c2 \u03bf\u03c1\u03b5\u03b9\u03bd\u03ae\u03c2 \u0395\u03c5\u03c1\u03c5\u03c4\u03b1\u03bd\u03af\u03b1\u03c2. \u03a4\u03bf\u03bd \u0391\u03cd\u03b3\u03bf\u03c5\u03c3\u03c4\u03bf \u03c4\u03bf\u03c5 1944, \u03cc\u03bc\u03c9\u03c2, \u03b7 \u03bc\u03bf\u03af\u03c1\u03b1 \u03c4\u03bf\u03c5 \u03c3\u03c6\u03c1\u03b1\u03b3\u03af\u03c3\u03c4\u03b7\u03ba\u03b5 \u03bc\u03b5 \u03c4\u03bf\u03bd \u03c0\u03b9\u03bf \u03b2\u03af\u03b1\u03b9\u03bf \u03c4\u03c1\u03cc\u03c0\u03bf. \u0397 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u00ab\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5\u00bb \u03b1\u03bd\u03b1\u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03b5\u03af \u03bc\u03b5 \u03b1\u03c0\u03cc\u03bb\u03c5\u03c4\u03b7 \u03c0\u03b9\u03c3\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b1\u03c5\u03c4\u03ad\u03c2 \u03c4\u03b9\u03c2 \u03bc\u03b1\u03cd\u03c1\u03b5\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2, \u03c0\u03c1\u03bf\u03c3\u03c6\u03ad\u03c1\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c3\u03c4\u03bf\u03bd \u03b8\u03b5\u03b1\u03c4\u03ae \u03bc\u03b9\u03b1 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03c0\u03bf\u03c5 \u03be\u03b5\u03c0\u03b5\u03c1\u03bd\u03ac \u03c4\u03b7\u03bd \u03b1\u03c0\u03bb\u03ae \u03b1\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03b3\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b2\u03b9\u03c9\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03bc\u03ac\u03b8\u03b7\u03c3\u03b7.\n\n\u0397 \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ae \u03b2\u03ac\u03c3\u03b7\n\n\u0397 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u03c5\u03c0\u03ae\u03c1\u03be\u03b5 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03b4\u03cd\u03bf \u03bc\u03b5\u03b3\u03ac\u03bb\u03c9\u03bd \u03b5\u03c0\u03b9\u03b8\u03ad\u03c3\u03b5\u03c9\u03bd. \u0397 \u03c0\u03c1\u03ce\u03c4\u03b7, \u03c3\u03c4\u03b9\u03c2 7 \u039d\u03bf\u03b5\u03bc\u03b2\u03c1\u03af\u03bf\u03c5 1943, \u03b2\u03c1\u03ae\u03ba\u03b5 \u03c4\u03bf\u03c5\u03c2 \u03ba\u03b1\u03c4\u03bf\u03af\u03ba\u03bf\u03c5\u03c2 \u03ad\u03c4\u03bf\u03b9\u03bc\u03bf\u03c5\u03c2. \u0395\u03bd\u03b7\u03bc\u03b5\u03c1\u03c9\u03bc\u03ad\u03bd\u03bf\u03b9 \u03b5\u03b3\u03ba\u03b1\u03af\u03c1\u03c9\u03c2, \u03b5\u03af\u03c7\u03b1\u03bd \u03ae\u03b4\u03b7 \u03ba\u03b1\u03c4\u03b1\u03c6\u03cd\u03b3\u03b5\u03b9 \u03c3\u03c4\u03b1 \u03b2\u03bf\u03c5\u03bd\u03ac. \u039f\u03b9 \u0393\u03b5\u03c1\u03bc\u03b1\u03bd\u03bf\u03af \u03ad\u03ba\u03b1\u03c8\u03b1\u03bd, \u03bb\u03b5\u03b7\u03bb\u03ac\u03c4\u03b7\u03c3\u03b1\u03bd \u03ba\u03b1\u03b9 \u03b1\u03bd\u03b1\u03c4\u03af\u03bd\u03b1\u03be\u03b1\u03bd \u03c4\u03bf \u0393\u03c5\u03bc\u03bd\u03ac\u03c3\u03b9\u03bf. \u0389\u03c4\u03b1\u03bd \u03bc\u03b9\u03b1 \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7. \u0397 \u03b4\u03b5\u03cd\u03c4\u03b5\u03c1\u03b7 \u03ba\u03b1\u03b9 \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03b9\u03ba\u03ae \u03b5\u03c0\u03af\u03b8\u03b5\u03c3\u03b7 \u03ae\u03c1\u03b8\u03b5 \u03c3\u03c4\u03b9\u03c2 9 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5 1944, \u03c3\u03c4\u03bf \u03c0\u03bb\u03b1\u03af\u03c3\u03b9\u03bf \u03c4\u03b7\u03c2 \u03b5\u03c0\u03b9\u03c7\u03b5\u03af\u03c1\u03b7\u03c3\u03b7\u03c2 \u00ab\u0388\u03c7\u03b9\u03b4\u03bd\u03b1\u00bb. \u0394\u03cd\u03bd\u03b1\u03bc\u03b7 10.000 \u03c0\u03ac\u03bd\u03bf\u03c0\u03bb\u03c9\u03bd \u03c3\u03c4\u03c1\u03b1\u03c4\u03b9\u03c9\u03c4\u03ce\u03bd, 500 \u03bf\u03c7\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03c5\u03ac\u03c1\u03b9\u03b8\u03bc\u03c9\u03bd \u03b1\u03c1\u03bc\u03ac\u03c4\u03c9\u03bd \u03bc\u03ac\u03c7\u03b7\u03c2 \u03c0\u03b5\u03c1\u03b9\u03ba\u03cd\u03ba\u03bb\u03c9\u03c3\u03b5 \u03c4\u03b7\u03bd \u03c0\u03cc\u03bb\u03b7. \u0393\u03b9\u03b1 \u03c4\u03ad\u03c3\u03c3\u03b5\u03c1\u03b9\u03c2 \u03bf\u03bb\u03cc\u03ba\u03bb\u03b7\u03c1\u03b5\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b5\u03c2, \u03c9\u03c2 \u03c4\u03b9\u03c2 13 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5, \u03b5\u03b9\u03b4\u03b9\u03ba\u03ac \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b5\u03af\u03b1 \u03c0\u03c5\u03c1\u03c0\u03cc\u03bb\u03b7\u03c3\u03b1\u03bd \u03ba\u03ac\u03b8\u03b5 \u03c3\u03c0\u03af\u03c4\u03b9, \u03ba\u03ac\u03b8\u03b5 \u03b5\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u03b1, \u03ba\u03ac\u03b8\u03b5 \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b7\u03bc\u03b1. \u0391\u03c0\u03cc \u03c4\u03b1 1.000 \u03c3\u03c0\u03af\u03c4\u03b9\u03b1, \u03bc\u03cc\u03bd\u03bf 8 \u03ad\u03bc\u03b5\u03b9\u03bd\u03b1\u03bd \u03cc\u03c1\u03b8\u03b9\u03b1.\n\n\u0397 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 VR\n\n\u0397 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03be\u03b5\u03ba\u03b9\u03bd\u03ac \u03c3\u03b5 \u03bc\u03b9\u03b1 \u03ae\u03c3\u03c5\u03c7\u03b7, \u03b7\u03bb\u03b9\u03cc\u03bb\u03bf\u03c5\u03c3\u03c4\u03b7 \u03c0\u03bb\u03b1\u03c4\u03b5\u03af\u03b1 \u03c4\u03bf\u03c5 \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5. \u0395\u03af\u03bd\u03b1\u03b9 \u03b1\u03c1\u03c7\u03ad\u03c2 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5 1944. \u039f \u03b8\u03b5\u03b1\u03c4\u03ae\u03c2 \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9 \u03c0\u03b1\u03b9\u03b4\u03b9\u03ac \u03bd\u03b1 \u03c0\u03b1\u03af\u03b6\u03bf\u03c5\u03bd, \u03b3\u03c5\u03bd\u03b1\u03af\u03ba\u03b5\u03c2 \u03bd\u03b1 \u03c8\u03c9\u03bd\u03af\u03b6\u03bf\u03c5\u03bd, \u03b3\u03ad\u03c1\u03bf\u03c5\u03c2 \u03bd\u03b1 \u03ba\u03ac\u03b8\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b1 \u03ba\u03b1\u03c6\u03b5\u03bd\u03b5\u03af\u03b1. \u0397 \u03b1\u03c4\u03bc\u03cc\u03c3\u03c6\u03b1\u03b9\u03c1\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b3\u03b1\u03bb\u03ae\u03bd\u03b9\u03b1 \u2013 \u03b7 \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 \u03b1\u03bd\u03ac\u03c3\u03b1 \u03b5\u03b9\u03c1\u03ae\u03bd\u03b7\u03c2 \u03c0\u03c1\u03b9\u03bd \u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03b1\u03b9\u03b3\u03af\u03b4\u03b1.\n\n\u039e\u03b1\u03c6\u03bd\u03b9\u03ba\u03ac, \u03bf \u03b2\u03c1\u03c5\u03c7\u03b7\u03b8\u03bc\u03cc\u03c2 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03c9\u03bd \u03b4\u03b9\u03b1\u03c3\u03c0\u03ac \u03c4\u03b7 \u03c3\u03b9\u03c9\u03c0\u03ae. \u039c\u03b9\u03b1 \u03b1\u03c0\u03ad\u03c1\u03b1\u03bd\u03c4\u03b7 \u03c3\u03c4\u03ae", "short_description": "\u03a4\u03bf \u00ab\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5\u00bb \u03b5\u03af\u03bd\u03b1\u03b9 \u03bc\u03b9\u03b1 \u03ba\u03b1\u03b8\u03b7\u03bb\u03c9\u03c4\u03b9\u03ba\u03ae \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c0\u03bf\u03c5 \u03bc\u03b5\u03c4\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b8\u03b5\u03b1\u03c4\u03ae \u03c0\u03af\u03c3\u03c9 \u03c3\u03c4\u03bf\u03bd \u0391\u03cd\u03b3\u03bf\u03c5\u03c3\u03c4\u03bf \u03c4\u03bf\u03c5 1944, \u03c3\u03c4\u03b9\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2 \u03c4\u03b7\u03c2 \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03b9\u03ba\u03ae\u03c2 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03c1\u03c9\u03c4\u03b5\u03cd\u03bf\u03c5\u03c3\u03b1\u03c2 \u03c4\u03b7\u03c2 \u0395\u03c5\u03c1\u03c5\u03c4\u03b1\u03bd\u03af\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03b9\u03c2 \u03bd\u03b1\u03b6\u03b9\u03c3\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b4\u03c5\u03bd\u03ac\u03bc\u03b5\u03b9\u03c2 \u03ba\u03b1\u03c4\u03bf\u03c7\u03ae\u03c2.\n\n\u0392\u03b1\u03c3\u03b9\u03c3\u03bc\u03ad\u03bd\u03b7 \u03c3\u03b5 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ac \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ac \u03bd\u03c4\u03bf\u03ba\u03bf\u03c5\u03bc\u03ad\u03bd\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03bc\u03b1\u03c1\u03c4\u03c5\u03c1\u03af\u03b5\u03c2 \u03b5\u03c0\u03b9\u03b6\u03ce\u03bd\u03c4\u03c9\u03bd, \u03b7 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b4\u03b5\u03bd \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03ad\u03bd\u03b1 \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9 \u03c8\u03c5\u03c7\u03b1\u03b3\u03c9\u03b3\u03af\u03b1\u03c2, \u03b1\u03bb\u03bb\u03ac \u03ad\u03bd\u03b1 \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03cc \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03cc \u03bd\u03c4\u03bf\u03ba\u03b9\u03bc\u03b1\u03bd\u03c4\u03ad\u03c1. \u039f \u03c7\u03c1\u03ae\u03c3\u03c4\u03b7\u03c2 \u03c4\u03bf\u03c0\u03bf\u03b8\u03b5\u03c4\u03b5\u03af\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf \u03ba\u03ad\u03bd\u03c4\u03c1\u03bf \u03c4\u03b7\u03c2 \u03c0\u03cc\u03bb\u03b7\u03c2 \u03bb\u03af\u03b3\u03b5\u03c2 \u03ce\u03c1\u03b5\u03c2 \u03c0\u03c1\u03b9\u03bd \u03c4\u03b7\u03bd \u03b5\u03b9\u03c3\u03b2\u03bf\u03bb\u03ae. \u0392\u03b9\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b7 \u03b3\u03b1\u03bb\u03ae\u03bd\u03b7 \u03c4"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1725885781780032", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823783_1725885785113365_7963299967643114898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6euxAq_jowQ7kNvwFg0v6t&_nc_oc=Adpc7FKVHxvhtlL9I9OM-H8rOd2XovQ_CwmmeYl4EhgofGS17CUo4hUVitFvILy6XaU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrivA1hpDSxfXMWp-rbZl8wqZgu21ehec5UrBwga3ngw&oe=6AA40061"}, {"file_name": "72.png", "id": "1722235112154656", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/673607600_1722235115487989_7179379227682588602_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RosOwL0hzVIQ7kNvwFueS_c&_nc_oc=AdpjpR_sH69gVUWQ4XYyf3g612aOcJ_4AME7x6ErD8mCUZzJEbUIqHwLGnQ6ng7hbuk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2QaLLJmjWTgjjwOq15oiOOXEXKJoIrm4QX4qKn7Klhw&oe=6AA400A1"}, {"file_name": "79.png", "id": "1614861966746855", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827626_1614861970080188_1163984589108115967_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2uRGbBIA2kQ7kNvwEyy7SZ&_nc_oc=AdrngPQsbuOi-UZsyeWpAlr3dKXSJn8K4ivszHFp3gUdGd9J8deF-7Fhpis75z70eUM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTqQdCchA14FXrvVcLWsAbcclavsXN4_HNXScRU6DBYQ&oe=6AA407B4"}, {"file_name": "78.png", "id": "1455479029726195", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491828087_1455479033059528_7445077874557174049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7b2Lg8duYRsQ7kNvwG0Cr7m&_nc_oc=AdqcLzaAng_2fahV_PuFgvY6_RarqcEimwq6dvwH1UI5JHOtHT4F1QMBTEpQtVIoDJk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAX6u2U1vosReVp4najZeoUZiIdJ0_Ev-hzPgw9gkOsQ&oe=6AA3F698"}, {"file_name": "74.png", "id": "1029053432955879", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491825470_1029053436289212_8169003220427800514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xz9WPScqIRgQ7kNvwF16bVw&_nc_oc=AdrjlL60GCgKuMz89tw_Q6ZBZigmcc5E35f3djLAlJVgjkmROgMZPAoEmNIdzCGmnoQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt5i6ySQ5srE-ELvBHOeOHWKbb1DOI2fYoR-pyBtBL_w&oe=6AA423B7"}]}, "id": "1930643910975852", "locale": "en_US", "screenshots": [{"file_name": "73.png", "id": "1362585269337467", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823310_1362585276004133_8963422836501446895_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y8Ragg1618Q7kNvwFYBQ4k&_nc_oc=AdpJiVRnoBoeC1iRbYaY54kSpb1CI05UEKVWO1cg5DwyyHTGpNJ1Nimp-c9wP_-nW5w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_BDIO2pK-Z__aU6YNhRRMIyLlbRpAa2cCg_1qbnDtzA&oe=6AA40387"}, {"file_name": "78.png", "id": "27766564862977214", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823783_27766564866310547_3004709527238500849_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlVEuJx1qRsQ7kNvwEZW9JX&_nc_oc=AdoG5vB7hFw-CqhsTfpUfDe_fZgQbXn_GIwvG_udyD69ceK8ohbGbPNMl8ZFsiabUU0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7r5Ecsrp5pNvgR9w4nWtHOkdlC8U0Yg6H2bnUtZZzzw&oe=6AA41186"}, {"file_name": "72.png", "id": "1446490367289345", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823930_1446490373956011_8259659604473728431_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OofyrwxBnb8Q7kNvwGatpOK&_nc_oc=Adr49pdM4L8S5ku77BTBKcshsJOuESYqurNNO3R-8il9Ew8QZAQdGob011k70Nw0ZP0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDcIX4-L_VK-pyA2eXjW_g4yYy6QUa_SpYhoqXYXcDRg&oe=6AA3F82A"}, {"file_name": "77.png", "id": "2007639299879030", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491827960_2007639303212363_8526959797811423433_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD7k7GR9B48Q7kNvwG7PSub&_nc_oc=Adq69BX7BrhbFGqH8dliBHY0sd8ZSXgwVQWC3izPh5Ids0a7ooMhsv5tqXzAhJwIaE8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwBNRPn2Cqb7FC3oa5MsQtJ8QKUeftGRaaox3iz3BC5A&oe=6AA408C2"}, {"file_name": "71.png", "id": "28044214161932068", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/673607600_28044214178598733_8673542388600986992_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azKl9ZiVoD4Q7kNvwFWxfS1&_nc_oc=Adpe7qy3SXTiutTArjQV3UcCqep84SaKl27yyzXaZWr119HLzH3tmI-myooc3iACtp4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlmWTHomYtVKTimit5P26U5jXrNNyp9ONlVn6L7lLseQ&oe=6AA4102E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Destruction of Karpenisi", "keywords": [], "long_description": "The Destruction of Karpenisi \u2013 The Chronicle of a Disaster in Virtual Reality\n\nKarpenisi, built amphitheatrically at the foot of Mount Velouchi, was for centuries the human and cultural center of mountainous Evrytania. In August 1944, however, its fate was sealed in the most violent way. The virtual reality application \"The Destruction of Karpenisi\" recreates those dark days with absolute fidelity, offering the viewer an experience that goes beyond mere narrative and becomes experiential learning.\n\nThe historical background\n\nThe destruction was the result of two major attacks. The first, on November 7, 1943, found the residents prepared. Informed in time, they had already taken refuge in the mountains. The Germans burned, looted, and blew up the High School. It was a warning. The second and total attack came on August 9, 1944, as part of Operation \"Viper.\" A force of 10,000 heavily armed soldiers, 500 vehicles, and numerous tanks surrounded the town. For four full days, until August 13, special squads set fire to every house, every church, every shop. Of the 1,000 houses, only 8 remained standing.", "short_description": "\"The Destruction of Karpenisi\" is an immersive virtual reality experience that transports the viewer back to August 1944, to the days of the total destruction of the capital of Evrytania by the Nazi occupation forces.\n\nBased on real historical documents and survivor testimonies, this application is not an entertainment game but an interactive historical documentary. The user is placed in the center of the town just hours before the invasion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://old.comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["el"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2808049126236010"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/673607600_1722235115487989_7179379227682588602_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RosOwL0hzVIQ7kNvwFueS_c&_nc_oc=AdpjpR_sH69gVUWQ4XYyf3g612aOcJ_4AME7x6ErD8mCUZzJEbUIqHwLGnQ6ng7hbuk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIou9geLAVtEEta27oKUyjLJ7A1jIKocFRSPcSt1Tkwgg&oe=6AA400A1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Destruction of Karpenisi", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1784527380, "lastRevision": {"nodes": [{"id": "2808049142902675", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2808049119569344", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1547600626759537"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2307170903423946", "locale": "el_GR", "screenshots": [{"file_name": "73.png", "id": "898239516077958", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823279_898239522744624_1715021388509573230_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuHA4HuGizEQ7kNvwFrhPT6&_nc_oc=Adpzn0z04_MW-zAQQeVSFBZz_hI1qAlcijhgHtgO6U6H93Y8EOGgGh2Si0hnaOH_-PI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoTsS-C1-rpzl7MwWZRD8EIRgo9l5uEn4XHW0DEu8vEw&oe=6AA4224E"}, {"file_name": "77.png", "id": "1574906134233527", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491825497_1574906137566860_8647180732733691586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVs078CiYHgQ7kNvwGmBAH4&_nc_oc=AdoVpB1Qfi7o9oZ3WnrX5LwvGMarWe-NpRtfo1ygTxJDsTIWFEoJqYNeCmQ8utoFbBM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDmSqgUQRDk4S2DeSw4XBDry2D_b9-QN7iVEiISqyWFw&oe=6AA404BA"}, {"file_name": "72.png", "id": "1746062349745187", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824741_1746062353078520_5103945107329399166_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nP330zz5yQQ7kNvwFA6QSG&_nc_oc=AdqAArP9snsplbFnBqtCcMF4XF8lnbOfPg42u0on3UHV4yPdsRfAvxV2Y1-qurTuJwU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeiTwNPI-DDYsyfmAR53QGPt8ALtJisRgEjuAxNKV6ZQ&oe=6AA41CD3"}, {"file_name": "78.png", "id": "1268828846303894", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499304952_1268828849637227_2122329126437209533_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEexBV7MQOoQ7kNvwEn4LhN&_nc_oc=AdqjnoGK2SG5zG6JVsdux8Hquv_Iv8DfKthXKpMzzWsWQM2BDllHQzZ-mBcsYed7th8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf2bi0Hwk25B-GF8q9iyZ13xOGWAKTx6-ddE3XjT9wZA&oe=6AA3F5D7"}, {"file_name": "71.png", "id": "2577097242733093", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824665_2577097246066426_4277289553193595208_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVDbUlajbfoQ7kNvwGdRo2a&_nc_oc=AdoOVoUvjZ0gaUpNnKQRCaf9HbblRrZcnJcwIfvjY_DLEXzb3_wF6ZlNobamlWNaAKY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk6u1VMRhzq4xo5EZOMa2VEZb77ttEJHANI3KR4m3QUA&oe=6AA3F618"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c0\u03b5\u03c1\u03bd\u03b9\u03c3\u03af\u03bf\u03c5", "keywords": [], "long_description": "\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5 \u2013 \u03a4\u03bf \u03c7\u03c1\u03bf\u03bd\u03b9\u03ba\u03cc \u03bc\u03b9\u03b1\u03c2 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c3\u03b5 \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\n\n\u03a4\u03bf \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03ae\u03c3\u03b9, \u03c7\u03c4\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf \u03b1\u03bc\u03c6\u03b9\u03b8\u03b5\u03b1\u03c4\u03c1\u03b9\u03ba\u03ac \u03c3\u03c4\u03bf\u03c5\u03c2 \u03c0\u03c1\u03cc\u03c0\u03bf\u03b4\u03b5\u03c2 \u03c4\u03bf\u03c5 \u0392\u03b5\u03bb\u03bf\u03c5\u03c7\u03af\u03bf\u03c5, \u03c5\u03c0\u03ae\u03c1\u03be\u03b5 \u03b3\u03b9\u03b1 \u03b1\u03b9\u03ce\u03bd\u03b5\u03c2 \u03c4\u03bf \u03b1\u03bd\u03b8\u03c1\u03ce\u03c0\u03b9\u03bd\u03bf \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03ba\u03ad\u03bd\u03c4\u03c1\u03bf \u03c4\u03b7\u03c2 \u03bf\u03c1\u03b5\u03b9\u03bd\u03ae\u03c2 \u0395\u03c5\u03c1\u03c5\u03c4\u03b1\u03bd\u03af\u03b1\u03c2. \u03a4\u03bf\u03bd \u0391\u03cd\u03b3\u03bf\u03c5\u03c3\u03c4\u03bf \u03c4\u03bf\u03c5 1944, \u03cc\u03bc\u03c9\u03c2, \u03b7 \u03bc\u03bf\u03af\u03c1\u03b1 \u03c4\u03bf\u03c5 \u03c3\u03c6\u03c1\u03b1\u03b3\u03af\u03c3\u03c4\u03b7\u03ba\u03b5 \u03bc\u03b5 \u03c4\u03bf\u03bd \u03c0\u03b9\u03bf \u03b2\u03af\u03b1\u03b9\u03bf \u03c4\u03c1\u03cc\u03c0\u03bf. \u0397 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u00ab\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5\u00bb \u03b1\u03bd\u03b1\u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03b5\u03af \u03bc\u03b5 \u03b1\u03c0\u03cc\u03bb\u03c5\u03c4\u03b7 \u03c0\u03b9\u03c3\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b1\u03c5\u03c4\u03ad\u03c2 \u03c4\u03b9\u03c2 \u03bc\u03b1\u03cd\u03c1\u03b5\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2, \u03c0\u03c1\u03bf\u03c3\u03c6\u03ad\u03c1\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c3\u03c4\u03bf\u03bd \u03b8\u03b5\u03b1\u03c4\u03ae \u03bc\u03b9\u03b1 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03c0\u03bf\u03c5 \u03be\u03b5\u03c0\u03b5\u03c1\u03bd\u03ac \u03c4\u03b7\u03bd \u03b1\u03c0\u03bb\u03ae \u03b1\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03b3\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b2\u03b9\u03c9\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03bc\u03ac\u03b8\u03b7\u03c3\u03b7.\n\n\u0397 \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ae \u03b2\u03ac\u03c3\u03b7\n\n\u0397 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u03c5\u03c0\u03ae\u03c1\u03be\u03b5 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03b4\u03cd\u03bf \u03bc\u03b5\u03b3\u03ac\u03bb\u03c9\u03bd \u03b5\u03c0\u03b9\u03b8\u03ad\u03c3\u03b5\u03c9\u03bd. \u0397 \u03c0\u03c1\u03ce\u03c4\u03b7, \u03c3\u03c4\u03b9\u03c2 7 \u039d\u03bf\u03b5\u03bc\u03b2\u03c1\u03af\u03bf\u03c5 1943, \u03b2\u03c1\u03ae\u03ba\u03b5 \u03c4\u03bf\u03c5\u03c2 \u03ba\u03b1\u03c4\u03bf\u03af\u03ba\u03bf\u03c5\u03c2 \u03ad\u03c4\u03bf\u03b9\u03bc\u03bf\u03c5\u03c2. \u0395\u03bd\u03b7\u03bc\u03b5\u03c1\u03c9\u03bc\u03ad\u03bd\u03bf\u03b9 \u03b5\u03b3\u03ba\u03b1\u03af\u03c1\u03c9\u03c2, \u03b5\u03af\u03c7\u03b1\u03bd \u03ae\u03b4\u03b7 \u03ba\u03b1\u03c4\u03b1\u03c6\u03cd\u03b3\u03b5\u03b9 \u03c3\u03c4\u03b1 \u03b2\u03bf\u03c5\u03bd\u03ac. \u039f\u03b9 \u0393\u03b5\u03c1\u03bc\u03b1\u03bd\u03bf\u03af \u03ad\u03ba\u03b1\u03c8\u03b1\u03bd, \u03bb\u03b5\u03b7\u03bb\u03ac\u03c4\u03b7\u03c3\u03b1\u03bd \u03ba\u03b1\u03b9 \u03b1\u03bd\u03b1\u03c4\u03af\u03bd\u03b1\u03be\u03b1\u03bd \u03c4\u03bf \u0393\u03c5\u03bc\u03bd\u03ac\u03c3\u03b9\u03bf. \u0389\u03c4\u03b1\u03bd \u03bc\u03b9\u03b1 \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7. \u0397 \u03b4\u03b5\u03cd\u03c4\u03b5\u03c1\u03b7 \u03ba\u03b1\u03b9 \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03b9\u03ba\u03ae \u03b5\u03c0\u03af\u03b8\u03b5\u03c3\u03b7 \u03ae\u03c1\u03b8\u03b5 \u03c3\u03c4\u03b9\u03c2 9 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5 1944, \u03c3\u03c4\u03bf \u03c0\u03bb\u03b1\u03af\u03c3\u03b9\u03bf \u03c4\u03b7\u03c2 \u03b5\u03c0\u03b9\u03c7\u03b5\u03af\u03c1\u03b7\u03c3\u03b7\u03c2 \u00ab\u0388\u03c7\u03b9\u03b4\u03bd\u03b1\u00bb. \u0394\u03cd\u03bd\u03b1\u03bc\u03b7 10.000 \u03c0\u03ac\u03bd\u03bf\u03c0\u03bb\u03c9\u03bd \u03c3\u03c4\u03c1\u03b1\u03c4\u03b9\u03c9\u03c4\u03ce\u03bd, 500 \u03bf\u03c7\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03c5\u03ac\u03c1\u03b9\u03b8\u03bc\u03c9\u03bd \u03b1\u03c1\u03bc\u03ac\u03c4\u03c9\u03bd \u03bc\u03ac\u03c7\u03b7\u03c2 \u03c0\u03b5\u03c1\u03b9\u03ba\u03cd\u03ba\u03bb\u03c9\u03c3\u03b5 \u03c4\u03b7\u03bd \u03c0\u03cc\u03bb\u03b7. \u0393\u03b9\u03b1 \u03c4\u03ad\u03c3\u03c3\u03b5\u03c1\u03b9\u03c2 \u03bf\u03bb\u03cc\u03ba\u03bb\u03b7\u03c1\u03b5\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b5\u03c2, \u03c9\u03c2 \u03c4\u03b9\u03c2 13 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5, \u03b5\u03b9\u03b4\u03b9\u03ba\u03ac \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b5\u03af\u03b1 \u03c0\u03c5\u03c1\u03c0\u03cc\u03bb\u03b7\u03c3\u03b1\u03bd \u03ba\u03ac\u03b8\u03b5 \u03c3\u03c0\u03af\u03c4\u03b9, \u03ba\u03ac\u03b8\u03b5 \u03b5\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u03b1, \u03ba\u03ac\u03b8\u03b5 \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b7\u03bc\u03b1. \u0391\u03c0\u03cc \u03c4\u03b1 1.000 \u03c3\u03c0\u03af\u03c4\u03b9\u03b1, \u03bc\u03cc\u03bd\u03bf 8 \u03ad\u03bc\u03b5\u03b9\u03bd\u03b1\u03bd \u03cc\u03c1\u03b8\u03b9\u03b1.\n\n\u0397 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 VR\n\n\u0397 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03be\u03b5\u03ba\u03b9\u03bd\u03ac \u03c3\u03b5 \u03bc\u03b9\u03b1 \u03ae\u03c3\u03c5\u03c7\u03b7, \u03b7\u03bb\u03b9\u03cc\u03bb\u03bf\u03c5\u03c3\u03c4\u03b7 \u03c0\u03bb\u03b1\u03c4\u03b5\u03af\u03b1 \u03c4\u03bf\u03c5 \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5. \u0395\u03af\u03bd\u03b1\u03b9 \u03b1\u03c1\u03c7\u03ad\u03c2 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5 1944. \u039f \u03b8\u03b5\u03b1\u03c4\u03ae\u03c2 \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9 \u03c0\u03b1\u03b9\u03b4\u03b9\u03ac \u03bd\u03b1 \u03c0\u03b1\u03af\u03b6\u03bf\u03c5\u03bd, \u03b3\u03c5\u03bd\u03b1\u03af\u03ba\u03b5\u03c2 \u03bd\u03b1 \u03c8\u03c9\u03bd\u03af\u03b6\u03bf\u03c5\u03bd, \u03b3\u03ad\u03c1\u03bf\u03c5\u03c2 \u03bd\u03b1 \u03ba\u03ac\u03b8\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b1 \u03ba\u03b1\u03c6\u03b5\u03bd\u03b5\u03af\u03b1. \u0397 \u03b1\u03c4\u03bc\u03cc\u03c3\u03c6\u03b1\u03b9\u03c1\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b3\u03b1\u03bb\u03ae\u03bd\u03b9\u03b1 \u2013 \u03b7 \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 \u03b1\u03bd\u03ac\u03c3\u03b1 \u03b5\u03b9\u03c1\u03ae\u03bd\u03b7\u03c2 \u03c0\u03c1\u03b9\u03bd \u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03b1\u03b9\u03b3\u03af\u03b4\u03b1.\n\n\u039e\u03b1\u03c6\u03bd\u03b9\u03ba\u03ac, \u03bf \u03b2\u03c1\u03c5\u03c7\u03b7\u03b8\u03bc\u03cc\u03c2 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03c9\u03bd \u03b4\u03b9\u03b1\u03c3\u03c0\u03ac \u03c4\u03b7 \u03c3\u03b9\u03c9\u03c0\u03ae. \u039c\u03b9\u03b1 \u03b1\u03c0\u03ad\u03c1\u03b1\u03bd\u03c4\u03b7 \u03c3\u03c4\u03ae", "short_description": "\u03a4\u03bf \u00ab\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5\u00bb \u03b5\u03af\u03bd\u03b1\u03b9 \u03bc\u03b9\u03b1 \u03ba\u03b1\u03b8\u03b7\u03bb\u03c9\u03c4\u03b9\u03ba\u03ae \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c0\u03bf\u03c5 \u03bc\u03b5\u03c4\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b8\u03b5\u03b1\u03c4\u03ae \u03c0\u03af\u03c3\u03c9 \u03c3\u03c4\u03bf\u03bd \u0391\u03cd\u03b3\u03bf\u03c5\u03c3\u03c4\u03bf \u03c4\u03bf\u03c5 1944, \u03c3\u03c4\u03b9\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2 \u03c4\u03b7\u03c2 \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03b9\u03ba\u03ae\u03c2 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03c1\u03c9\u03c4\u03b5\u03cd\u03bf\u03c5\u03c3\u03b1\u03c2 \u03c4\u03b7\u03c2 \u0395\u03c5\u03c1\u03c5\u03c4\u03b1\u03bd\u03af\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03b9\u03c2 \u03bd\u03b1\u03b6\u03b9\u03c3\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b4\u03c5\u03bd\u03ac\u03bc\u03b5\u03b9\u03c2 \u03ba\u03b1\u03c4\u03bf\u03c7\u03ae\u03c2.\n\n\u0392\u03b1\u03c3\u03b9\u03c3\u03bc\u03ad\u03bd\u03b7 \u03c3\u03b5 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ac \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ac \u03bd\u03c4\u03bf\u03ba\u03bf\u03c5\u03bc\u03ad\u03bd\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03bc\u03b1\u03c1\u03c4\u03c5\u03c1\u03af\u03b5\u03c2 \u03b5\u03c0\u03b9\u03b6\u03ce\u03bd\u03c4\u03c9\u03bd, \u03b7 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b4\u03b5\u03bd \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03ad\u03bd\u03b1 \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9 \u03c8\u03c5\u03c7\u03b1\u03b3\u03c9\u03b3\u03af\u03b1\u03c2, \u03b1\u03bb\u03bb\u03ac \u03ad\u03bd\u03b1 \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03cc \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03cc \u03bd\u03c4\u03bf\u03ba\u03b9\u03bc\u03b1\u03bd\u03c4\u03ad\u03c1. \u039f \u03c7\u03c1\u03ae\u03c3\u03c4\u03b7\u03c2 \u03c4\u03bf\u03c0\u03bf\u03b8\u03b5\u03c4\u03b5\u03af\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf \u03ba\u03ad\u03bd\u03c4\u03c1\u03bf \u03c4\u03b7\u03c2 \u03c0\u03cc\u03bb\u03b7\u03c2 \u03bb\u03af\u03b3\u03b5\u03c2 \u03ce\u03c1\u03b5\u03c2 \u03c0\u03c1\u03b9\u03bd \u03c4\u03b7\u03bd \u03b5\u03b9\u03c3\u03b2\u03bf\u03bb\u03ae. \u0392\u03b9\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b7 \u03b3\u03b1\u03bb\u03ae\u03bd\u03b7 \u03c4"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "17
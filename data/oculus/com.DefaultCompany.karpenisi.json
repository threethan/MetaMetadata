12_8169003220427800514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyTs7VJhYjEQ7kNvwFs09pt&_nc_oc=Adp5NITInTbI402sosojh622zht6n1AeDyGSVRRTuX8z0cBqIVLjMx6b-AIEmn3_A7k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCaJeLjfLcvAlJ8RhlhTSmptEnHwArOA4NnYiLnSJzDg&oe=6A9997B7"}]}, "id": "1930643910975852", "locale": "en_US", "screenshots": [{"file_name": "73.png", "id": "1362585269337467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823310_1362585276004133_8963422836501446895_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z827oIvhLPgQ7kNvwEV4WcW&_nc_oc=AdpbdioPKlj1gpCvDPwD-yDIPvWs6wWi4Gs02feMiM9RdW3rtfGqzDE2aHhsCXmenxU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGTTFs5dbtcGXVBE5pgWOG7cWfH8ogslp15TTaUxf4xg&oe=6A997787"}, {"file_name": "78.png", "id": "27766564862977214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_27766564866310547_3004709527238500849_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5qLXlDB3hIQ7kNvwFL7rr1&_nc_oc=AdoZJiH9YVSeHQYD3RvtZ3PxJsqrYE3mFyHLwcgy5W7ju4lGuMfKfBhmnb7dm87i01w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG426yZdJLiHjg2zaUt-E4InhnG7uP4IoZU4oN6h_VXg&oe=6A998586"}, {"file_name": "72.png", "id": "1446490367289345", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823930_1446490373956011_8259659604473728431_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8UfQV3vH5gQ7kNvwFMMbYl&_nc_oc=AdpkPNDnveDR-PDPwus0c9k1SKQ87Le9Putjbghpbtce-26WtRLIArFxWUrERQeM6GU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaN6zopoCLls_UAjF66HTECEDvFYYkFKHubA3b9ptv_w&oe=6A99A46A"}, {"file_name": "77.png", "id": "2007639299879030", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827960_2007639303212363_8526959797811423433_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WoY7rJXb_sQ7kNvwEVrqhU&_nc_oc=AdptCaud5p7X17hum_2NV0g1FDvXzfQkieJMm9VwUJproL1PU_dByOAReVIgCDud8tE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6ZyqDQ9q1oXglzRkgm7OnsEsfeNu9Jd3AcFpDDOnDUw&oe=6A997CC2"}, {"file_name": "71.png", "id": "28044214161932068", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673607600_28044214178598733_8673542388600986992_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RhxzNjJZ2gQ7kNvwFosTrt&_nc_oc=Adp1za4ONVIbBYfT9Q8zYZRtvF9rmRCd1uoLNVHHQe0JCFDgJbIykC2XfD3OwYgJZ-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBjfodudnBVF3jw7C6xio2BNw1nUTZG16Iv1Vu82GaWg&oe=6A99842E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Destruction of Karpenisi", "keywords": [], "long_description": "The Destruction of Karpenisi \u2013 The Chronicle of a Disaster in Virtual Reality\n\nKarpenisi, built amphitheatrically at the foot of Mount Velouchi, was for centuries the human and cultural center of mountainous Evrytania. In August 1944, however, its fate was sealed in the most violent way. The virtual reality application \"The Destruction of Karpenisi\" recreates those dark days with absolute fidelity, offering the viewer an experience that goes beyond mere narrative and becomes experiential learning.\n\nThe historical background\n\nThe destruction was the result of two major attacks. The first, on November 7, 1943, found the residents prepared. Informed in time, they had already taken refuge in the mountains. The Germans burned, looted, and blew up the High School. It was a warning. The second and total attack came on August 9, 1944, as part of Operation \"Viper.\" A force of 10,000 heavily armed soldiers, 500 vehicles, and numerous tanks surrounded the town. For four full days, until August 13, special squads set fire to every house, every church, every shop. Of the 1,000 houses, only 8 remained standing.", "short_description": "\"The Destruction of Karpenisi\" is an immersive virtual reality experience that transports the viewer back to August 1944, to the days of the total destruction of the capital of Evrytania by the Nazi occupation forces.\n\nBased on real historical documents and survivor testimonies, this application is not an entertainment game but an interactive historical documentary. The user is placed in the center of the town just hours before the invasion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://old.comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["el"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2808049126236010"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1049132087535904"}]}, "baseline_offer": {"id": "1049132087535904"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784527380, "status": "PUBLISHED", "id": "1049132087535904"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2809970869377169", "version": "2.0.13"}, "id": "3945296445779469", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2808049119569344", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2809970869377169"}, "releas
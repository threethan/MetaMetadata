ng", "id": "2577097242733093", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824665_2577097246066426_4277289553193595208_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pc7Mca18DIsQ7kNvwETJd6Z&_nc_oc=AdrNXHcSQmAedLStiVK_EKYT1LVvjLy8yg5t9wjklcIhiEdxcrQ63RE6ShCCaaZ1XLI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTUPJh7WnMLvh5UL7uZtHver-QLsytUzWoDJxZqG-ikA&oe=6AA93C18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c0\u03b5\u03c1\u03bd\u03b9\u03c3\u03af\u03bf\u03c5", "keywords": [], "long_description": "\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5 \u2013 \u03a4\u03bf \u03c7\u03c1\u03bf\u03bd\u03b9\u03ba\u03cc \u03bc\u03b9\u03b1\u03c2 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c3\u03b5 \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\n\n\u03a4\u03bf \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03ae\u03c3\u03b9, \u03c7\u03c4\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf \u03b1\u03bc\u03c6\u03b9\u03b8\u03b5\u03b1\u03c4\u03c1\u03b9\u03ba\u03ac \u03c3\u03c4\u03bf\u03c5\u03c2 \u03c0\u03c1\u03cc\u03c0\u03bf\u03b4\u03b5\u03c2 \u03c4\u03bf\u03c5 \u0392\u03b5\u03bb\u03bf\u03c5\u03c7\u03af\u03bf\u03c5, \u03c5\u03c0\u03ae\u03c1\u03be\u03b5 \u03b3\u03b9\u03b1 \u03b1\u03b9\u03ce\u03bd\u03b5\u03c2 \u03c4\u03bf \u03b1\u03bd\u03b8\u03c1\u03ce\u03c0\u03b9\u03bd\u03bf \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03ba\u03ad\u03bd\u03c4\u03c1\u03bf \u03c4\u03b7\u03c2 \u03bf\u03c1\u03b5\u03b9\u03bd\u03ae\u03c2 \u0395\u03c5\u03c1\u03c5\u03c4\u03b1\u03bd\u03af\u03b1\u03c2. \u03a4\u03bf\u03bd \u0391\u03cd\u03b3\u03bf\u03c5\u03c3\u03c4\u03bf \u03c4\u03bf\u03c5 1944, \u03cc\u03bc\u03c9\u03c2, \u03b7 \u03bc\u03bf\u03af\u03c1\u03b1 \u03c4\u03bf\u03c5 \u03c3\u03c6\u03c1\u03b1\u03b3\u03af\u03c3\u03c4\u03b7\u03ba\u03b5 \u03bc\u03b5 \u03c4\u03bf\u03bd \u03c0\u03b9\u03bf \u03b2\u03af\u03b1\u03b9\u03bf \u03c4\u03c1\u03cc\u03c0\u03bf. \u0397 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u00ab\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5\u00bb \u03b1\u03bd\u03b1\u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03b5\u03af \u03bc\u03b5 \u03b1\u03c0\u03cc\u03bb\u03c5\u03c4\u03b7 \u03c0\u03b9\u03c3\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b1\u03c5\u03c4\u03ad\u03c2 \u03c4\u03b9\u03c2 \u03bc\u03b1\u03cd\u03c1\u03b5\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2, \u03c0\u03c1\u03bf\u03c3\u03c6\u03ad\u03c1\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c3\u03c4\u03bf\u03bd \u03b8\u03b5\u03b1\u03c4\u03ae \u03bc\u03b9\u03b1 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03c0\u03bf\u03c5 \u03be\u03b5\u03c0\u03b5\u03c1\u03bd\u03ac \u03c4\u03b7\u03bd \u03b1\u03c0\u03bb\u03ae \u03b1\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03b3\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b2\u03b9\u03c9\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03bc\u03ac\u03b8\u03b7\u03c3\u03b7.\n\n\u0397 \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ae \u03b2\u03ac\u03c3\u03b7\n\n\u0397 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u03c5\u03c0\u03ae\u03c1\u03be\u03b5 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03b4\u03cd\u03bf \u03bc\u03b5\u03b3\u03ac\u03bb\u03c9\u03bd \u03b5\u03c0\u03b9\u03b8\u03ad\u03c3\u03b5\u03c9\u03bd. \u0397 \u03c0\u03c1\u03ce\u03c4\u03b7, \u03c3\u03c4\u03b9\u03c2 7 \u039d\u03bf\u03b5\u03bc\u03b2\u03c1\u03af\u03bf\u03c5 1943, \u03b2\u03c1\u03ae\u03ba\u03b5 \u03c4\u03bf\u03c5\u03c2 \u03ba\u03b1\u03c4\u03bf\u03af\u03ba\u03bf\u03c5\u03c2 \u03ad\u03c4\u03bf\u03b9\u03bc\u03bf\u03c5\u03c2. \u0395\u03bd\u03b7\u03bc\u03b5\u03c1\u03c9\u03bc\u03ad\u03bd\u03bf\u03b9 \u03b5\u03b3\u03ba\u03b1\u03af\u03c1\u03c9\u03c2, \u03b5\u03af\u03c7\u03b1\u03bd \u03ae\u03b4\u03b7 \u03ba\u03b1\u03c4\u03b1\u03c6\u03cd\u03b3\u03b5\u03b9 \u03c3\u03c4\u03b1 \u03b2\u03bf\u03c5\u03bd\u03ac. \u039f\u03b9 \u0393\u03b5\u03c1\u03bc\u03b1\u03bd\u03bf\u03af \u03ad\u03ba\u03b1\u03c8\u03b1\u03bd, \u03bb\u03b5\u03b7\u03bb\u03ac\u03c4\u03b7\u03c3\u03b1\u03bd \u03ba\u03b1\u03b9 \u03b1\u03bd\u03b1\u03c4\u03af\u03bd\u03b1\u03be\u03b1\u03bd \u03c4\u03bf \u0393\u03c5\u03bc\u03bd\u03ac\u03c3\u03b9\u03bf. \u0389\u03c4\u03b1\u03bd \u03bc\u03b9\u03b1 \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7. \u0397 \u03b4\u03b5\u03cd\u03c4\u03b5\u03c1\u03b7 \u03ba\u03b1\u03b9 \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03b9\u03ba\u03ae \u03b5\u03c0\u03af\u03b8\u03b5\u03c3\u03b7 \u03ae\u03c1\u03b8\u03b5 \u03c3\u03c4\u03b9\u03c2 9 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5 1944, \u03c3\u03c4\u03bf \u03c0\u03bb\u03b1\u03af\u03c3\u03b9\u03bf \u03c4\u03b7\u03c2 \u03b5\u03c0\u03b9\u03c7\u03b5\u03af\u03c1\u03b7\u03c3\u03b7\u03c2 \u00ab\u0388\u03c7\u03b9\u03b4\u03bd\u03b1\u00bb. \u0394\u03cd\u03bd\u03b1\u03bc\u03b7 10.000 \u03c0\u03ac\u03bd\u03bf\u03c0\u03bb\u03c9\u03bd \u03c3\u03c4\u03c1\u03b1\u03c4\u03b9\u03c9\u03c4\u03ce\u03bd, 500 \u03bf\u03c7\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03c5\u03ac\u03c1\u03b9\u03b8\u03bc\u03c9\u03bd \u03b1\u03c1\u03bc\u03ac\u03c4\u03c9\u03bd \u03bc\u03ac\u03c7\u03b7\u03c2 \u03c0\u03b5\u03c1\u03b9\u03ba\u03cd\u03ba\u03bb\u03c9\u03c3\u03b5 \u03c4\u03b7\u03bd \u03c0\u03cc\u03bb\u03b7. \u0393\u03b9\u03b1 \u03c4\u03ad\u03c3\u03c3\u03b5\u03c1\u03b9\u03c2 \u03bf\u03bb\u03cc\u03ba\u03bb\u03b7\u03c1\u03b5\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b5\u03c2, \u03c9\u03c2 \u03c4\u03b9\u03c2 13 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5, \u03b5\u03b9\u03b4\u03b9\u03ba\u03ac \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b5\u03af\u03b1 \u03c0\u03c5\u03c1\u03c0\u03cc\u03bb\u03b7\u03c3\u03b1\u03bd \u03ba\u03ac\u03b8\u03b5 \u03c3\u03c0\u03af\u03c4\u03b9, \u03ba\u03ac\u03b8\u03b5 \u03b5\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u03b1, \u03ba\u03ac\u03b8\u03b5 \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b7\u03bc\u03b1. \u0391\u03c0\u03cc \u03c4\u03b1 1.000 \u03c3\u03c0\u03af\u03c4\u03b9\u03b1, \u03bc\u03cc\u03bd\u03bf 8 \u03ad\u03bc\u03b5\u03b9\u03bd\u03b1\u03bd \u03cc\u03c1\u03b8\u03b9\u03b1.\n\n\u0397 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 VR\n\n\u0397 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03be\u03b5\u03ba\u03b9\u03bd\u03ac \u03c3\u03b5 \u03bc\u03b9\u03b1 \u03ae\u03c3\u03c5\u03c7\u03b7, \u03b7\u03bb\u03b9\u03cc\u03bb\u03bf\u03c5\u03c3\u03c4\u03b7 \u03c0\u03bb\u03b1\u03c4\u03b5\u03af\u03b1 \u03c4\u03bf\u03c5 \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5. \u0395\u03af\u03bd\u03b1\u03b9 \u03b1\u03c1\u03c7\u03ad\u03c2 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5 1944. \u039f \u03b8\u03b5\u03b1\u03c4\u03ae\u03c2 \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9 \u03c0\u03b1\u03b9\u03b4\u03b9\u03ac \u03bd\u03b1 \u03c0\u03b1\u03af\u03b6\u03bf\u03c5\u03bd, \u03b3\u03c5\u03bd\u03b1\u03af\u03ba\u03b5\u03c2 \u03bd\u03b1 \u03c8\u03c9\u03bd\u03af\u03b6\u03bf\u03c5\u03bd, \u03b3\u03ad\u03c1\u03bf\u03c5\u03c2 \u03bd\u03b1 \u03ba\u03ac\u03b8\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b1 \u03ba\u03b1\u03c6\u03b5\u03bd\u03b5\u03af\u03b1. \u0397 \u03b1\u03c4\u03bc\u03cc\u03c3\u03c6\u03b1\u03b9\u03c1\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b3\u03b1\u03bb\u03ae\u03bd\u03b9\u03b1 \u2013 \u03b7 \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 \u03b1\u03bd\u03ac\u03c3\u03b1 \u03b5\u03b9\u03c1\u03ae\u03bd\u03b7\u03c2 \u03c0\u03c1\u03b9\u03bd \u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03b1\u03b9\u03b3\u03af\u03b4\u03b1.\n\n\u039e\u03b1\u03c6\u03bd\u03b9\u03ba\u03ac, \u03bf \u03b2\u03c1\u03c5\u03c7\u03b7\u03b8\u03bc\u03cc\u03c2 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03c9\u03bd \u03b4\u03b9\u03b1\u03c3\u03c0\u03ac \u03c4\u03b7 \u03c3\u03b9\u03c9\u03c0\u03ae. \u039c\u03b9\u03b1 \u03b1\u03c0\u03ad\u03c1\u03b1\u03bd\u03c4\u03b7 \u03c3\u03c4\u03ae", "short_description": "\u03a4\u03bf \u00ab\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5\u00bb \u03b5\u03af\u03bd\u03b1\u03b9 \u03bc\u03b9\u03b1 \u03ba\u03b1\u03b8\u03b7\u03bb\u03c9\u03c4\u03b9\u03ba\u03ae \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c0\u03bf\u03c5 \u03bc\u03b5\u03c4\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b8\u03b5\u03b1\u03c4\u03ae \u03c0\u03af\u03c3\u03c9 \u03c3\u03c4\u03bf\u03bd \u0391\u03cd\u03b3\u03bf\u03c5\u03c3\u03c4\u03bf \u03c4\u03bf\u03c5 1944, \u03c3\u03c4\u03b9\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2 \u03c4\u03b7\u03c2 \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03b9\u03ba\u03ae\u03c2 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03c1\u03c9\u03c4\u03b5\u03cd\u03bf\u03c5\u03c3\u03b1\u03c2 \u03c4\u03b7\u03c2 \u0395\u03c5\u03c1\u03c5\u03c4\u03b1\u03bd\u03af\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03b9\u03c2 \u03bd\u03b1\u03b6\u03b9\u03c3\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b4\u03c5\u03bd\u03ac\u03bc\u03b5\u03b9\u03c2 \u03ba\u03b1\u03c4\u03bf\u03c7\u03ae\u03c2.\n\n\u0392\u03b1\u03c3\u03b9\u03c3\u03bc\u03ad\u03bd\u03b7 \u03c3\u03b5 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ac \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ac \u03bd\u03c4\u03bf\u03ba\u03bf\u03c5\u03bc\u03ad\u03bd\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03bc\u03b1\u03c1\u03c4\u03c5\u03c1\u03af\u03b5\u03c2 \u03b5\u03c0\u03b9\u03b6\u03ce\u03bd\u03c4\u03c9\u03bd, \u03b7 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b4\u03b5\u03bd \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03ad\u03bd\u03b1 \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9 \u03c8\u03c5\u03c7\u03b1\u03b3\u03c9\u03b3\u03af\u03b1\u03c2, \u03b1\u03bb\u03bb\u03ac \u03ad\u03bd\u03b1 \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03cc \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03cc \u03bd\u03c4\u03bf\u03ba\u03b9\u03bc\u03b1\u03bd\u03c4\u03ad\u03c1. \u039f \u03c7\u03c1\u03ae\u03c3\u03c4\u03b7\u03c2 \u03c4\u03bf\u03c0\u03bf\u03b8\u03b5\u03c4\u03b5\u03af\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf \u03ba\u03ad\u03bd\u03c4\u03c1\u03bf \u03c4\u03b7\u03c2 \u03c0\u03cc\u03bb\u03b7\u03c2 \u03bb\u03af\u03b3\u03b5\u03c2 \u03ce\u03c1\u03b5\u03c2 \u03c0\u03c1\u03b9\u03bd \u03c4\u03b7\u03bd \u03b5\u03b9\u03c3\u03b2\u03bf\u03bb\u03ae. \u0392\u03b9\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b7 \u03b3\u03b1\u03bb\u03ae\u03bd\u03b7 \u03c4"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1725885781780032", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823783_1725885785113365_7963299967643114898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WQk3FHvXtwQ7kNvwHAW-y4&_nc_oc=Adqi52mjV13ljzH_fPU-a_prtF4liHv7JGOjiaOGtnzOPNF8ydZLPwnvfAqhrghJu3A&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaQEHcaRGQYU96gP2A_KKoOsa8KIT-dStwR2xN7fX_rA&oe=6AA94661"}, {"file_name": "72.png", "id": "1722235112154656", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/673607600_1722235115487989_7179379227682588602_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OkGgYkKPN0Q7kNvwEn3ylt&_nc_oc=Adq0sl5-ev5gy0Uc2QYaOY_IIRZ4GFC1zNEwglOqBY45EUQtd8jkNPOVCkzsDNJLeXM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhG5wiVYgrN7SSL5SbTkjeZVB6neML6TF54GVrLu17IA&oe=6AA946A1"}, {"file_name": "79.png", "id": "1614861966746855", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827626_1614861970080188_1163984589108115967_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oG4aXkay8_oQ7kNvwHp76Lt&_nc_oc=AdqSjbpaI4KFvFPann3yy85OPTwpchTb5sPf6sx_wVWHpv5QCxb1MrETTXIlbSBr0Eo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDmAvK-DvvLh9HBHo7a47AZ9r6AuouV9PH8HKJIwaizQ&oe=6AA94DB4"}, {"file_name": "78.png", "id": "1455479029726195", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491828087_1455479033059528_7445077874557174049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5fT6rN34iwQ7kNvwGSfwf8&_nc_oc=AdrbBb3GJmpXfCEYoVmrdxAj2fScq00MmWiTPtCIkLjqC8Or4p4zQAQwJgh9qjiErzk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjR22Xh4lY1yBG4TTElZdIZQ45LppCfshdwnYmomaG3Q&oe=6AA93C98"}, {"file_name": "74.png", "id": "1029053432955879", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491825470_1029053436289212_8169003220427800514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvQ-Pwm2OH0Q7kNvwEvFP6x&_nc_oc=Adr9uUZfSrkguzxavrbCiCjUCFlV-pCTSKGPJbAZJ27rS4Yc6ZhlDbaNMXRxj6OewVQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFcubI6nrOrBMhSQWOky5pyAwiZTE8HvH_ddiVAqSt9Q&oe=6AA969B7"}]}, "id": "1930643910975852", "locale": "en_US", "screenshots": [{"file_name": "73.png", "id": "1362585269337467", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823310_1362585276004133_8963422836501446895_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYUlf-cAWkwQ7kNvwEug3NH&_nc_oc=AdpPnY7RLUHE6rRbr5kKBmhdQUxAiIAk3JBFvatbCdp1Cx7OSRzCqb03dIWvDd0jzZU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJeT4ce2F4JDeol8R6VdhjSsYq5JcByfqsnxa45fQTlw&oe=6AA94987"}, {"file_name": "78.png", "id": "27766564862977214", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823783_27766564866310547_3004709527238500849_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEltDyRXt7UQ7kNvwFuNaRE&_nc_oc=Adpl9NukGSAQoTcJFjXnVnE-5QoTIaVhWdXOo-id9W_YAqkY10pGBQ1qn4QroeZA5vI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMscqGnEVRSkd1o9Nqn58xylf_wom6FA4PTx6PzImuqw&oe=6AA95786"}, {"file_name": "72.png", "id": "1446490367289345", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823930_1446490373956011_8259659604473728431_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIJdGbLgRXkQ7kNvwHlZxSn&_nc_oc=AdqQhWiTy-IIcdOgOMvXto6b0KUy0nLU3uNWqkWdxR16jI9fsbzr_4477FlSpxoz2nQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVaHM4Sj-vWdGykaGXpf3ZSPzvAV4DnEjzb_jhofzBmw&oe=6AA93E2A"}, {"file_name": "77.png", "id": "2007639299879030", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491827960_2007639303212363_8526959797811423433_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glkFn0KVeiUQ7kNvwEiVe1H&_nc_oc=AdrqURycMfEFNYpmdUa85wSB9_cTmUFq9vHT4Js868IqozM5iyNfi3u_dHtTG_hT21M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6kYqoOvQ8l0CFO0toPqBxKT3UlPQ00s5ZXIE_u06KiQ&oe=6AA94EC2"}, {"file_name": "71.png", "id": "28044214161932068", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/673607600_28044214178598733_8673542388600986992_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwhJlDSQCdUQ7kNvwGN5u9d&_nc_oc=AdoipU2mf6Qfcy7bV5F89Tb0Uu0c0wAuCVQrJQkpI_9LapgZVZZ_aTg-nYUhrlqS1_4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbgxVmoQMRP65irIxODlMkxqfPLmnruOsAqHagrNsPWQ&oe=6AA9562E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Destruction of Karpenisi", "keywords": [], "long_description": "The Destruction of Karpenisi \u2013 The Chronicle of a Disaster in Virtual Reality\n\nKarpenisi, built amphitheatrically at the foot of Mount Velouchi, was for centuries the human and cultural center of mountainous Evrytania. In August 1944, however, its fate was sealed in the most violent way. The virtual reality application \"The Destruction of Karpenisi\" recreates those dark days with absolute fidelity, offering the viewer an experience that goes beyond mere narrative and becomes experiential learning.\n\nThe historical background\n\nThe destruction was the result of two major attacks. The first, on November 7, 1943, found the residents prepared. Informed in time, they had already taken refuge in the mountains. The Germans burned, looted, and blew up the High School. It was a warning. The second and total attack came on August 9, 1944, as part of Operation \"Viper.\" A force of 10,000 heavily armed soldiers, 500 vehicles, and numerous tanks surrounded the town. For four full days, until August 13, special squads set fire to every house, every church, every shop. Of the 1,000 houses, only 8 remained standing.", "short_description": "\"The Destruction of Karpenisi\" is an immersive virtual reality experience that transports the viewer back to August 1944, to the days of the total destruction of the capital of Evrytania by the Nazi occupation forces.\n\nBased on real historical documents and survivor testimonies, this application is not an entertainment game but an interactive historical documentary. The user is placed in the center of the town just hours before the invasion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://old.comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["el"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2808049126236010"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/673607600_1722235115487989_7179379227682588602_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OkGgYkKPN0Q7kNvwEn3ylt&_nc_oc=Adq0sl5-ev5gy0Uc2QYaOY_IIRZ4GFC1zNEwglOqBY45EUQtd8jkNPOVCkzsDNJLeXM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKABqKKDiDi6ZpoGz_QDcJJgzW69Tyx2mgpxUm9E0V_iw&oe=6AA946A1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Destruction of Karpenisi", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1784527380, "lastRevision": {"nodes": [{"id": "2808049142902675", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2808049119569344", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1547600626759537"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2307170903423946", "locale": "el_GR", "screenshots": [{"file_name": "73.png", "id": "898239516077958", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823279_898239522744624_1715021388509573230_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22Cv_oaE98IQ7kNvwGqjvZ_&_nc_oc=AdrWAIKJG4AUg1Rgiaf_CZrvofjUXN9M4Snj9xtiswL9CykCNRNw2rCpZc3PJftw7Z0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFXbWcr9OfAGLPqdBlpBT27Dk7tMc6PvtAOjW5WObDdw&oe=6AA9684E"}, {"file_name": "77.png", "id": "1574906134233527", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491825497_1574906137566860_8647180732733691586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vad4yuCIa_8Q7kNvwG7_NPk&_nc_oc=AdpJPz3MPTSSvQTDXKy8kIlyDs0ZrM2NNC16MnDsVX8nXW2hVem3GdrWxPpBZI7ty_I&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkc8988KPkTJA41g5OzB0G9B8sss2uNxFrvIapfBBYdQ&oe=6AA94ABA"}, {"file_name": "72.png", "id": "1746062349745187", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824741_1746062353078520_5103945107329399166_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXoc6wQywiAQ7kNvwGxFtgv&_nc_oc=Ado3YGtdVglAfJewVJ_dzLOV7J2VuZ1vTaelis97Wyqk1-KCneSC6uUYs7rPrnr-b0c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkJ00UTE-11v0DsLPgS1p67gxRSxgmm5n6g6-uQdXSoA&oe=6AA962D3"}, {"file_name": "78.png", "id": "1268828846303894", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499304952_1268828849637227_2122329126437209533_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2pxEaRRB4UQ7kNvwFGTymS&_nc_oc=AdrWNQL2piPGaFE5RgGVwhfGtiai0APp_2OJZgCzuPco_4jX1y3j-dLR-3Wp7di2UjA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdt5T2c1HUB9VHuci5L4hODtY3H6u9wxq3FkJM2AEj1w&oe=6AA93BD7"}, {"file_name": "71.png", "id": "2577097242733093", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824665_2577097246066426_4277289553193595208_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pc7Mca18DIsQ7kNvwETJd6Z&_nc_oc=AdrNXHcSQmAedLStiVK_EKYT1LVvjLy8yg5t9wjklcIhiEdxcrQ63RE6ShCCaaZ1XLI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTUPJh7WnMLvh5UL7uZtHver-QLsytUzWoDJxZqG-ikA&oe=6AA93C18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c0\u03b5\u03c1\u03bd\u03b9\u03c3\u03af\u03bf\u03c5", "keywords": [], "long_description": "\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5 \u2013 \u03a4\u03bf \u03c7\u03c1\u03bf\u03bd\u03b9\u03ba\u03cc \u03bc\u03b9\u03b1\u03c2 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c3\u03b5 \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\n\n\u03a4\u03bf \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03ae\u03c3\u03b9, \u03c7\u03c4\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf \u03b1\u03bc\u03c6\u03b9\u03b8\u03b5\u03b1\u03c4\u03c1\u03b9\u03ba\u03ac \u03c3\u03c4\u03bf\u03c5\u03c2 \u03c0\u03c1\u03cc\u03c0\u03bf\u03b4\u03b5\u03c2 \u03c4\u03bf\u03c5 \u0392\u03b5\u03bb\u03bf\u03c5\u03c7\u03af\u03bf\u03c5, \u03c5\u03c0\u03ae\u03c1\u03be\u03b5 \u03b3\u03b9\u03b1 \u03b1\u03b9\u03ce\u03bd\u03b5\u03c2 \u03c4\u03bf \u03b1\u03bd\u03b8\u03c1\u03ce\u03c0\u03b9\u03bd\u03bf \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03ba\u03ad\u03bd\u03c4\u03c1\u03bf \u03c4\u03b7\u03c2 \u03bf\u03c1\u03b5\u03b9\u03bd\u03ae\u03c2 \u0395\u03c5\u03c1\u03c5\u03c4\u03b1\u03bd\u03af\u03b1\u03c2. \u03a4\u03bf\u03bd \u0391\u03cd\u03b3\u03bf\u03c5\u03c3\u03c4\u03bf \u03c4\u03bf\u03c5 1944, \u03cc\u03bc\u03c9\u03c2, \u03b7 \u03bc\u03bf\u03af\u03c1\u03b1 \u03c4\u03bf\u03c5 \u03c3\u03c6\u03c1\u03b1\u03b3\u03af\u03c3\u03c4\u03b7\u03ba\u03b5 \u03bc\u03b5 \u03c4\u03bf\u03bd \u03c0\u03b9\u03bf \u03b2\u03af\u03b1\u03b9\u03bf \u03c4\u03c1\u03cc\u03c0\u03bf. \u0397 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u00ab\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5\u00bb \u03b1\u03bd\u03b1\u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03b5\u03af \u03bc\u03b5 \u03b1\u03c0\u03cc\u03bb\u03c5\u03c4\u03b7 \u03c0\u03b9\u03c3\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b1\u03c5\u03c4\u03ad\u03c2 \u03c4\u03b9\u03c2 \u03bc\u03b1\u03cd\u03c1\u03b5\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2, \u03c0\u03c1\u03bf\u03c3\u03c6\u03ad\u03c1\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c3\u03c4\u03bf\u03bd \u03b8\u03b5\u03b1\u03c4\u03ae \u03bc\u03b9\u03b1 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03c0\u03bf\u03c5 \u03be\u03b5\u03c0\u03b5\u03c1\u03bd\u03ac \u03c4\u03b7\u03bd \u03b1\u03c0\u03bb\u03ae \u03b1\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03b3\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b2\u03b9\u03c9\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03bc\u03ac\u03b8\u03b7\u03c3\u03b7.\n\n\u0397 \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ae \u03b2\u03ac\u03c3\u03b7\n\n\u0397 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u03c5\u03c0\u03ae\u03c1\u03be\u03b5 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03b4\u03cd\u03bf \u03bc\u03b5\u03b3\u03ac\u03bb\u03c9\u03bd \u03b5\u03c0\u03b9\u03b8\u03ad\u03c3\u03b5\u03c9\u03bd. \u0397 \u03c0\u03c1\u03ce\u03c4\u03b7, \u03c3\u03c4\u03b9\u03c2 7 \u039d\u03bf\u03b5\u03bc\u03b2\u03c1\u03af\u03bf\u03c5 1943, \u03b2\u03c1\u03ae\u03ba\u03b5 \u03c4\u03bf\u03c5\u03c2 \u03ba\u03b1\u03c4\u03bf\u03af\u03ba\u03bf\u03c5\u03c2 \u03ad\u03c4\u03bf\u03b9\u03bc\u03bf\u03c5\u03c2. \u0395\u03bd\u03b7\u03bc\u03b5\u03c1\u03c9\u03bc\u03ad\u03bd\u03bf\u03b9 \u03b5\u03b3\u03ba\u03b1\u03af\u03c1\u03c9\u03c2, \u03b5\u03af\u03c7\u03b1\u03bd \u03ae\u03b4\u03b7 \u03ba\u03b1\u03c4\u03b1\u03c6\u03cd\u03b3\u03b5\u03b9 \u03c3\u03c4\u03b1 \u03b2\u03bf\u03c5\u03bd\u03ac. \u039f\u03b9 \u0393\u03b5\u03c1\u03bc\u03b1\u03bd\u03bf\u03af \u03ad\u03ba\u03b1\u03c8\u03b1\u03bd, \u03bb\u03b5\u03b7\u03bb\u03ac\u03c4\u03b7\u03c3\u03b1\u03bd \u03ba\u03b1\u03b9 \u03b1\u03bd\u03b1\u03c4\u03af\u03bd\u03b1\u03be\u03b1\u03bd \u03c4\u03bf \u0393\u03c5\u03bc\u03bd\u03ac\u03c3\u03b9\u03bf. \u0389\u03c4\u03b1\u03bd \u03bc\u03b9\u03b1 \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7. \u0397 \u03b4\u03b5\u03cd\u03c4\u03b5\u03c1\u03b7 \u03ba\u03b1\u03b9 \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03b9\u03ba\u03ae \u03b5\u03c0\u03af\u03b8\u03b5\u03c3\u03b7 \u03ae\u03c1\u03b8\u03b5 \u03c3\u03c4\u03b9\u03c2 9 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5 1944, \u03c3\u03c4\u03bf \u03c0\u03bb\u03b1\u03af\u03c3\u03b9\u03bf \u03c4\u03b7\u03c2 \u03b5\u03c0\u03b9\u03c7\u03b5\u03af\u03c1\u03b7\u03c3\u03b7\u03c2 \u00ab\u0388\u03c7\u03b9\u03b4\u03bd\u03b1\u00bb. \u0394\u03cd\u03bd\u03b1\u03bc\u03b7 10.000 \u03c0\u03ac\u03bd\u03bf\u03c0\u03bb\u03c9\u03bd \u03c3\u03c4\u03c1\u03b1\u03c4\u03b9\u03c9\u03c4\u03ce\u03bd, 500 \u03bf\u03c7\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03c5\u03ac\u03c1\u03b9\u03b8\u03bc\u03c9\u03bd \u03b1\u03c1\u03bc\u03ac\u03c4\u03c9\u03bd \u03bc\u03ac\u03c7\u03b7\u03c2 \u03c0\u03b5\u03c1\u03b9\u03ba\u03cd\u03ba\u03bb\u03c9\u03c3\u03b5 \u03c4\u03b7\u03bd \u03c0\u03cc\u03bb\u03b7. \u0393\u03b9\u03b1 \u03c4\u03ad\u03c3\u03c3\u03b5\u03c1\u03b9\u03c2 \u03bf\u03bb\u03cc\u03ba\u03bb\u03b7\u03c1\u03b5\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b5\u03c2, \u03c9\u03c2 \u03c4\u03b9\u03c2 13 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5, \u03b5\u03b9\u03b4\u03b9\u03ba\u03ac \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b5\u03af\u03b1 \u03c0\u03c5\u03c1\u03c0\u03cc\u03bb\u03b7\u03c3\u03b1\u03bd \u03ba\u03ac\u03b8\u03b5 \u03c3\u03c0\u03af\u03c4\u03b9, \u03ba\u03ac\u03b8\u03b5 \u03b5\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u03b1, \u03ba\u03ac\u03b8\u03b5 \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b7\u03bc\u03b1. \u0391\u03c0\u03cc \u03c4\u03b1 1.000 \u03c3\u03c0\u03af\u03c4\u03b9\u03b1, \u03bc\u03cc\u03bd\u03bf 8 \u03ad\u03bc\u03b5\u03b9\u03bd\u03b1\u03bd \u03cc\u03c1\u03b8\u03b9\u03b1.\n\n\u0397 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 VR\n\n\u0397 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03be\u03b5\u03ba\u03b9\u03bd\u03ac \u03c3\u03b5 \u03bc\u03b9\u03b1 \u03ae\u03c3\u03c5\u03c7\u03b7, \u03b7\u03bb\u03b9\u03cc\u03bb\u03bf\u03c5\u03c3\u03c4\u03b7 \u03c0\u03bb\u03b1\u03c4\u03b5\u03af\u03b1 \u03c4\u03bf\u03c5 \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5. \u0395\u03af\u03bd\u03b1\u03b9 \u03b1\u03c1\u03c7\u03ad\u03c2 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5 1944. \u039f \u03b8\u03b5\u03b1\u03c4\u03ae\u03c2 \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9 \u03c0\u03b1\u03b9\u03b4\u03b9\u03ac \u03bd\u03b1 \u03c0\u03b1\u03af\u03b6\u03bf\u03c5\u03bd, \u03b3\u03c5\u03bd\u03b1\u03af\u03ba\u03b5\u03c2 \u03bd\u03b1 \u03c8\u03c9\u03bd\u03af\u03b6\u03bf\u03c5\u03bd, \u03b3\u03ad\u03c1\u03bf\u03c5\u03c2 \u03bd\u03b1 \u03ba\u03ac\u03b8\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b1 \u03ba\u03b1\u03c6\u03b5\u03bd\u03b5\u03af\u03b1. \u0397 \u03b1\u03c4\u03bc\u03cc\u03c3\u03c6\u03b1\u03b9\u03c1\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b3\u03b1\u03bb\u03ae\u03bd\u03b9\u03b1 \u2013 \u03b7 \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 \u03b1\u03bd\u03ac\u03c3\u03b1 \u03b5\u03b9\u03c1\u03ae\u03bd\u03b7\u03c2 \u03c0\u03c1\u03b9\u03bd \u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03b1\u03b9\u03b3\u03af\u03b4\u03b1.\n\n\u039e\u03b1\u03c6\u03bd\u03b9\u03ba\u03ac, \u03bf \u03b2\u03c1\u03c5\u03c7\u03b7\u03b8\u03bc\u03cc\u03c2 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03c9\u03bd \u03b4\u03b9\u03b1\u03c3\u03c0\u03ac \u03c4\u03b7 \u03c3\u03b9\u03c9\u03c0\u03ae. \u039c\u03b9\u03b1 \u03b1\u03c0\u03ad\u03c1\u03b1\u03bd\u03c4\u03b7 \u03c3\u03c4\u03ae", "short_description": "\u03a4\u03bf \u00ab\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5\u00bb \u03b5\u03af\u03bd\u03b1\u03b9 \u03bc\u03b9\u03b1 \u03ba\u03b1\u03b8\u03b7\u03bb\u03c9\u03c4\u03b9\u03ba\u03ae \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c0\u03bf\u03c5 \u03bc\u03b5\u03c4\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b8\u03b5\u03b1\u03c4\u03ae \u03c0\u03af\u03c3\u03c9 \u03c3\u03c4\u03bf\u03bd \u0391\u03cd\u03b3\u03bf\u03c5\u03c3\u03c4\u03bf \u03c4\u03bf\u03c5 1944, \u03c3\u03c4\u03b9\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2 \u03c4\u03b7\u03c2 \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03b9\u03ba\u03ae\u03c2 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03c1\u03c9\u03c4\u03b5\u03cd\u03bf\u03c5\u03c3\u03b1\u03c2 \u03c4\u03b7\u03c2 \u0395\u03c5\u03c1\u03c5\u03c4\u03b1\u03bd\u03af\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03b9\u03c2 \u03bd\u03b1\u03b6\u03b9\u03c3\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b4\u03c5\u03bd\u03ac\u03bc\u03b5\u03b9\u03c2 \u03ba\u03b1\u03c4\u03bf\u03c7\u03ae\u03c2.\n\n\u0392\u03b1\u03c3\u03b9\u03c3\u03bc\u03ad\u03bd\u03b7 \u03c3\u03b5 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ac \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ac \u03bd\u03c4\u03bf\u03ba\u03bf\u03c5\u03bc\u03ad\u03bd\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03bc\u03b1\u03c1\u03c4\u03c5\u03c1\u03af\u03b5\u03c2 \u03b5\u03c0\u03b9\u03b6\u03ce\u03bd\u03c4\u03c9\u03bd, \u03b7 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b4\u03b5\u03bd \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03ad\u03bd\u03b1 \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9 \u03c8\u03c5\u03c7\u03b1\u03b3\u03c9\u03b3\u03af\u03b1\u03c2, \u03b1\u03bb\u03bb\u03ac \u03ad\u03bd\u03b1 \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03cc \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03cc \u03bd\u03c4\u03bf\u03ba\u03b9\u03bc\u03b1\u03bd\u03c4\u03ad\u03c1. \u039f \u03c7\u03c1\u03ae\u03c3\u03c4\u03b7\u03c2 \u03c4\u03bf\u03c0\u03bf\u03b8\u03b5\u03c4\u03b5\u03af\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf \u03ba\u03ad\u03bd\u03c4\u03c1\u03bf \u03c4\u03b7\u03c2 \u03c0\u03cc\u03bb\u03b7\u03c2 \u03bb\u03af\u03b3\u03b5\u03c2 \u03ce\u03c1\u03b5\u03c2 \u03c0\u03c1\u03b9\u03bd \u03c4\u03b7\u03bd \u03b5\u03b9\u03c3\u03b2\u03bf\u03bb\u03ae. \u0392\u03b9\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b7 \u03b3\u03b1\u03bb\u03ae\u03bd\u03b7 \u03c4"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "17
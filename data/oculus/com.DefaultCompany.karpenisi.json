12_8169003220427800514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNSWwHCqkyUQ7kNvwE7Cpox&_nc_oc=AdqnwehoDeMUMR6KVWENLAqshax4qRxmickB4hyH5v0Bc3cw7DTYn0-3hH1WjbSKzWw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMWi-DLtN8GYAb9QwpcoyEtoQFgOylqQeWPXGV8VaYfQ&oe=6A747577"}]}, "id": "1930643910975852", "locale": "en_US", "screenshots": [{"file_name": "73.png", "id": "1362585269337467", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823310_1362585276004133_8963422836501446895_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5t28q794CxkQ7kNvwGT7ewK&_nc_oc=Adrmh7oR-u-zT2VOaPS82P-D3nvVkaB0-1Gg7O4wcnCI8EqfewXhYW9RtSCGWc7Doac&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDzgh-ZOHT0GPUfTUOhb8SyquAuknrGb2Gafi54YR3kw&oe=6A748D87"}, {"file_name": "78.png", "id": "27766564862977214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_27766564866310547_3004709527238500849_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhB0klLKa-8Q7kNvwHj4dD2&_nc_oc=AdpMccvKF_94L8Z9cwr3w3UP0yaQKynYbCTeoMzT-2MN_S4JzYjl5MhduhDhmfjITa0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkGjBpKIbXE4s2jvgX1ea1N8XgE-k5V7OZEXlowCiqTQ&oe=6A749B86"}, {"file_name": "72.png", "id": "1446490367289345", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823930_1446490373956011_8259659604473728431_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HMyjvkSRHwQ7kNvwHgxrba&_nc_oc=AdqTnUGT5juoq9vRUyBUy5M3m8lMx_KazEaI7xxK1pyELR21F1l4iy0xQED60aJBIDQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIwoNLTFx837GYC1mR4pAik8P-W1jWlMzwsrL55hHmWQ&oe=6A74822A"}, {"file_name": "77.png", "id": "2007639299879030", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827960_2007639303212363_8526959797811423433_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GplnLHrMuIQQ7kNvwGNITaJ&_nc_oc=Adpj8mHmgJB1veKjO4fRWhiXl5mVSi1Ld7OIu_308xHH48j2S5Vn7NG-d-nyTGIlu7w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9BEtu294yzJpSr91m3kPDsz9bYgFmmwZm26HhK1RMug&oe=6A7492C2"}, {"file_name": "71.png", "id": "28044214161932068", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673607600_28044214178598733_8673542388600986992_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBWDxILCXDYQ7kNvwFnP3Sc&_nc_oc=Adq0L8-Y7UYNDzQa7dtD_9-2253R1oCxnMpmyuFS-8RcpVKZQhLaGdweNMQJN-SIhs4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR6XwI5V5HmxD24SVQ06X5F4bciEpWmywCMVLthXaYJw&oe=6A749A2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Destruction of Karpenisi", "keywords": [], "long_description": "The Destruction of Karpenisi \u2013 The Chronicle of a Disaster in Virtual Reality\n\nKarpenisi, built amphitheatrically at the foot of Mount Velouchi, was for centuries the human and cultural center of mountainous Evrytania. In August 1944, however, its fate was sealed in the most violent way. The virtual reality application \"The Destruction of Karpenisi\" recreates those dark days with absolute fidelity, offering the viewer an experience that goes beyond mere narrative and becomes experiential learning.\n\nThe historical background\n\nThe destruction was the result of two major attacks. The first, on November 7, 1943, found the residents prepared. Informed in time, they had already taken refuge in the mountains. The Germans burned, looted, and blew up the High School. It was a warning. The second and total attack came on August 9, 1944, as part of Operation \"Viper.\" A force of 10,000 heavily armed soldiers, 500 vehicles, and numerous tanks surrounded the town. For four full days, until August 13, special squads set fire to every house, every church, every shop. Of the 1,000 houses, only 8 remained standing.", "short_description": "\"The Destruction of Karpenisi\" is an immersive virtual reality experience that transports the viewer back to August 1944, to the days of the total destruction of the capital of Evrytania by the Nazi occupation forces.\n\nBased on real historical documents and survivor testimonies, this application is not an entertainment game but an interactive historical documentary. The user is placed in the center of the town just hours before the invasion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://old.comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["el"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2808049126236010"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1049132087535904"}]}, "baseline_offer": {"id": "1049132087535904"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784527380, "status": "PUBLISHED", "id": "1049132087535904"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2809970869377169", "version": "2.0.13"}, "id": "3945296445779469", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2808049119569344", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2809970869377169"}, "releas
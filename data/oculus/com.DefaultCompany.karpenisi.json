53436289212_8169003220427800514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvQ-Pwm2OH0Q7kNvwEvFP6x&_nc_oc=Adr9uUZfSrkguzxavrbCiCjUCFlV-pCTSKGPJbAZJ27rS4Yc6ZhlDbaNMXRxj6OewVQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFcubI6nrOrBMhSQWOky5pyAwiZTE8HvH_ddiVAqSt9Q&oe=6AA969B7"}]}, "id": "1930643910975852", "locale": "en_US", "screenshots": [{"file_name": "73.png", "id": "1362585269337467", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823310_1362585276004133_8963422836501446895_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYUlf-cAWkwQ7kNvwEug3NH&_nc_oc=AdpPnY7RLUHE6rRbr5kKBmhdQUxAiIAk3JBFvatbCdp1Cx7OSRzCqb03dIWvDd0jzZU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJeT4ce2F4JDeol8R6VdhjSsYq5JcByfqsnxa45fQTlw&oe=6AA94987"}, {"file_name": "78.png", "id": "27766564862977214", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823783_27766564866310547_3004709527238500849_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEltDyRXt7UQ7kNvwFuNaRE&_nc_oc=Adpl9NukGSAQoTcJFjXnVnE-5QoTIaVhWdXOo-id9W_YAqkY10pGBQ1qn4QroeZA5vI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMscqGnEVRSkd1o9Nqn58xylf_wom6FA4PTx6PzImuqw&oe=6AA95786"}, {"file_name": "72.png", "id": "1446490367289345", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823930_1446490373956011_8259659604473728431_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIJdGbLgRXkQ7kNvwHlZxSn&_nc_oc=AdqQhWiTy-IIcdOgOMvXto6b0KUy0nLU3uNWqkWdxR16jI9fsbzr_4477FlSpxoz2nQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVaHM4Sj-vWdGykaGXpf3ZSPzvAV4DnEjzb_jhofzBmw&oe=6AA93E2A"}, {"file_name": "77.png", "id": "2007639299879030", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491827960_2007639303212363_8526959797811423433_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glkFn0KVeiUQ7kNvwEiVe1H&_nc_oc=AdrqURycMfEFNYpmdUa85wSB9_cTmUFq9vHT4Js868IqozM5iyNfi3u_dHtTG_hT21M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6kYqoOvQ8l0CFO0toPqBxKT3UlPQ00s5ZXIE_u06KiQ&oe=6AA94EC2"}, {"file_name": "71.png", "id": "28044214161932068", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/673607600_28044214178598733_8673542388600986992_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwhJlDSQCdUQ7kNvwGN5u9d&_nc_oc=AdoipU2mf6Qfcy7bV5F89Tb0Uu0c0wAuCVQrJQkpI_9LapgZVZZ_aTg-nYUhrlqS1_4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbgxVmoQMRP65irIxODlMkxqfPLmnruOsAqHagrNsPWQ&oe=6AA9562E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Destruction of Karpenisi", "keywords": [], "long_description": "The Destruction of Karpenisi \u2013 The Chronicle of a Disaster in Virtual Reality\n\nKarpenisi, built amphitheatrically at the foot of Mount Velouchi, was for centuries the human and cultural center of mountainous Evrytania. In August 1944, however, its fate was sealed in the most violent way. The virtual reality application \"The Destruction of Karpenisi\" recreates those dark days with absolute fidelity, offering the viewer an experience that goes beyond mere narrative and becomes experiential learning.\n\nThe historical background\n\nThe destruction was the result of two major attacks. The first, on November 7, 1943, found the residents prepared. Informed in time, they had already taken refuge in the mountains. The Germans burned, looted, and blew up the High School. It was a warning. The second and total attack came on August 9, 1944, as part of Operation \"Viper.\" A force of 10,000 heavily armed soldiers, 500 vehicles, and numerous tanks surrounded the town. For four full days, until August 13, special squads set fire to every house, every church, every shop. Of the 1,000 houses, only 8 remained standing.", "short_description": "\"The Destruction of Karpenisi\" is an immersive virtual reality experience that transports the viewer back to August 1944, to the days of the total destruction of the capital of Evrytania by the Nazi occupation forces.\n\nBased on real historical documents and survivor testimonies, this application is not an entertainment game but an interactive historical documentary. The user is placed in the center of the town just hours before the invasion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://old.comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["el"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2808049126236010"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1049132087535904"}]}, "baseline_offer": {"id": "1049132087535904"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784527380, "status": "PUBLISHED", "id": "1049132087535904"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2809970869377169", "version": "2.0.13"}, "id": "3945296445779469", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2808049119569344", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "280997086937716
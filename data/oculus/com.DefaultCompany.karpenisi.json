12_8169003220427800514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CzgMVYhCLsQ7kNvwG5T2Fk&_nc_oc=Ado2bXgDkO7PhIoqP47abldmyzaeGvplcA6lpwuBbTlOIYf_yB_V1YaggEpAxqjtfYs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs2G78JWUmXoS7gc0qeenSgNFpvEn9HZ-NGLgq8fzoaQ&oe=6ADE25B7"}]}, "id": "1930643910975852", "locale": "en_US", "screenshots": [{"file_name": "73.png", "id": "1362585269337467", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823310_1362585276004133_8963422836501446895_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCX3ErmGY78Q7kNvwH2RncS&_nc_oc=AdrROCCWSuI3Y6vV1nC3ZmjelDJ5gnxTykNdMALchNyvc1EwsPnuTjCqTgaA5-t5HV8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPu426egWXDbaELSbz3H6vYFrnN6bDRElAbbCpya487Zw&oe=6ADE0587"}, {"file_name": "78.png", "id": "27766564862977214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_27766564866310547_3004709527238500849_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qC5WZFuQE0Q7kNvwH3SvMT&_nc_oc=AdpGpJviX-rFpdBei9Zha08BbA31DAeVT2DItK_g-OqikkUVwPV6kjXaFJU7w6yO020&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmtS_QixJaFBWHYGklquwekukXzLzQoE_PYReoynvRpg&oe=6ADE1386"}, {"file_name": "72.png", "id": "1446490367289345", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823930_1446490373956011_8259659604473728431_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veER6bhG5kEQ7kNvwG_qbKb&_nc_oc=AdqzfHCsffPm8XRz-pu_rBZg5QvsKqR-smwwDAWz1w3Qy5-yxEK75_v-5qJ9CNsU4bM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOV_3EzifF0969LJcz2eL-koh84Tci2x_aP6B08dxdtMg&oe=6ADDFA2A"}, {"file_name": "77.png", "id": "2007639299879030", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827960_2007639303212363_8526959797811423433_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46SCm0MpjccQ7kNvwGdNEz0&_nc_oc=Adppf5qU689ScFhDhqCr-15l04kpc5D_OaRA92qwlZdeqKS3QJx2JnAJCWtT2ILtUTs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0O1t-ztl1Y_Wx7_irDoUpF6Tgh7T60m9mv7X0mlHdPA&oe=6ADE0AC2"}, {"file_name": "71.png", "id": "28044214161932068", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673607600_28044214178598733_8673542388600986992_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMhwv7Q51dwQ7kNvwESopQI&_nc_oc=AdpwpMvs2o7yZjpRx4_FrhdzgAGIC9jWJq6bztUYhp1AqY3e7usrdnyTEtLVJOrqN5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8lq7pRnSimWUhJZXp4jZV4T26xQ60x2D_cAQFwNObLg&oe=6ADE122E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Destruction of Karpenisi", "keywords": [], "long_description": "The Destruction of Karpenisi \u2013 The Chronicle of a Disaster in Virtual Reality\n\nKarpenisi, built amphitheatrically at the foot of Mount Velouchi, was for centuries the human and cultural center of mountainous Evrytania. In August 1944, however, its fate was sealed in the most violent way. The virtual reality application \"The Destruction of Karpenisi\" recreates those dark days with absolute fidelity, offering the viewer an experience that goes beyond mere narrative and becomes experiential learning.\n\nThe historical background\n\nThe destruction was the result of two major attacks. The first, on November 7, 1943, found the residents prepared. Informed in time, they had already taken refuge in the mountains. The Germans burned, looted, and blew up the High School. It was a warning. The second and total attack came on August 9, 1944, as part of Operation \"Viper.\" A force of 10,000 heavily armed soldiers, 500 vehicles, and numerous tanks surrounded the town. For four full days, until August 13, special squads set fire to every house, every church, every shop. Of the 1,000 houses, only 8 remained standing.", "short_description": "\"The Destruction of Karpenisi\" is an immersive virtual reality experience that transports the viewer back to August 1944, to the days of the total destruction of the capital of Evrytania by the Nazi occupation forces.\n\nBased on real historical documents and survivor testimonies, this application is not an entertainment game but an interactive historical documentary. The user is placed in the center of the town just hours before the invasion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://old.comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["el"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2808049126236010"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1049132087535904"}]}, "baseline_offer": {"id": "1049132087535904"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784527380, "status": "PUBLISHED", "id": "1049132087535904"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2809970869377169", "version": "2.0.13"}, "id": "3945296445779469", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2808049119569344", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2809970869377169"}, "releas
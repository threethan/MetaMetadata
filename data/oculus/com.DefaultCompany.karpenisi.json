_ddOofY8VUQ7kNvwGVawir&_nc_oc=AdoILH9jA-SY24t2Eyhb7lwI7Nl2FlswCf1dphEJ0elD8SWMIYHDJ5YEtJsf0cW_3CI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfwSsqATYkZEJczD5uSEUNT4Zk3tDTBkvZ4prp_P-t9A&oe=6B0C810E"}, {"file_name": "77.png", "id": "1574906134233527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825497_1574906137566860_8647180732733691586_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofMbVtrnjAsQ7kNvwHQuyst&_nc_oc=AdpZfmWVhb3I4qJot-RBKVRdzldWp9C6c4dZHBjJxbhgmXARwb4n7hlInH_HSl9WgW8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQBZecds3zmXi_6DFFoYU3ScPIAcTtuDex6jxTCaCdTRg&oe=6B0C637A"}, {"file_name": "72.png", "id": "1746062349745187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824741_1746062353078520_5103945107329399166_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JABXg8JWWIwQ7kNvwHk5J6-&_nc_oc=AdoFNS6g8Nc2bXL53D36FFark0ERtwxOSanR0wng7dbUpyWi2vM-mWJrCeSplAECmiI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTciEY9T_qGmJlQ50tekoxgsNQemV-hsZFVDa--g5A-2g&oe=6B0C7B93"}, {"file_name": "78.png", "id": "1268828846303894", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304952_1268828849637227_2122329126437209533_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gMdYmerFEEQ7kNvwE6QnYt&_nc_oc=AdpUiZEwcIswIzzbbdqjhBtcwRTy_WM6mtJPCwWbOnaBYDQThQLkt3kGc82h98sDmBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRF0y1RPtSkEUHAh8xW7sYubSv7NuEdyj17SnaEtvvcqw&oe=6B0C5497"}, {"file_name": "71.png", "id": "2577097242733093", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824665_2577097246066426_4277289553193595208_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nj1_9RBYV0Q7kNvwFdpWgH&_nc_oc=AdpihLQPCb5sq7fQrBbWEUDGHEeaUf_kl499-tCYK6uGf-Du29vGuKdn0rTnqHP4LW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJh_waKsFpoNWZevYU_6r1Fz3KJ6hlZlHYOoJE7yobFQ&oe=6B0C54D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c0\u03b5\u03c1\u03bd\u03b9\u03c3\u03af\u03bf\u03c5", "keywords": [], "long_description": "\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5 \u2013 \u03a4\u03bf \u03c7\u03c1\u03bf\u03bd\u03b9\u03ba\u03cc \u03bc\u03b9\u03b1\u03c2 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c3\u03b5 \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\n\n\u03a4\u03bf \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03ae\u03c3\u03b9, \u03c7\u03c4\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf \u03b1\u03bc\u03c6\u03b9\u03b8\u03b5\u03b1\u03c4\u03c1\u03b9\u03ba\u03ac \u03c3\u03c4\u03bf\u03c5\u03c2 \u03c0\u03c1\u03cc\u03c0\u03bf\u03b4\u03b5\u03c2 \u03c4\u03bf\u03c5 \u0392\u03b5\u03bb\u03bf\u03c5\u03c7\u03af\u03bf\u03c5, \u03c5\u03c0\u03ae\u03c1\u03be\u03b5 \u03b3\u03b9\u03b1 \u03b1\u03b9\u03ce\u03bd\u03b5\u03c2 \u03c4\u03bf \u03b1\u03bd\u03b8\u03c1\u03ce\u03c0\u03b9\u03bd\u03bf \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03ba\u03ad\u03bd\u03c4\u03c1\u03bf \u03c4\u03b7\u03c2 \u03bf\u03c1\u03b5\u03b9\u03bd\u03ae\u03c2 \u0395\u03c5\u03c1\u03c5\u03c4\u03b1\u03bd\u03af\u03b1\u03c2. \u03a4\u03bf\u03bd \u0391\u03cd\u03b3\u03bf\u03c5\u03c3\u03c4\u03bf \u03c4\u03bf\u03c5 1944, \u03cc\u03bc\u03c9\u03c2, \u03b7 \u03bc\u03bf\u03af\u03c1\u03b1 \u03c4\u03bf\u03c5 \u03c3\u03c6\u03c1\u03b1\u03b3\u03af\u03c3\u03c4\u03b7\u03ba\u03b5 \u03bc\u03b5 \u03c4\u03bf\u03bd \u03c0\u03b9\u03bf \u03b2\u03af\u03b1\u03b9\u03bf \u03c4\u03c1\u03cc\u03c0\u03bf. \u0397 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u00ab\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5\u00bb \u03b1\u03bd\u03b1\u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03b5\u03af \u03bc\u03b5 \u03b1\u03c0\u03cc\u03bb\u03c5\u03c4\u03b7 \u03c0\u03b9\u03c3\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b1\u03c5\u03c4\u03ad\u03c2 \u03c4\u03b9\u03c2 \u03bc\u03b1\u03cd\u03c1\u03b5\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2, \u03c0\u03c1\u03bf\u03c3\u03c6\u03ad\u03c1\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c3\u03c4\u03bf\u03bd \u03b8\u03b5\u03b1\u03c4\u03ae \u03bc\u03b9\u03b1 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03c0\u03bf\u03c5 \u03be\u03b5\u03c0\u03b5\u03c1\u03bd\u03ac \u03c4\u03b7\u03bd \u03b1\u03c0\u03bb\u03ae \u03b1\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03b3\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b2\u03b9\u03c9\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03bc\u03ac\u03b8\u03b7\u03c3\u03b7.\n\n\u0397 \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ae \u03b2\u03ac\u03c3\u03b7\n\n\u0397 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u03c5\u03c0\u03ae\u03c1\u03be\u03b5 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03b4\u03cd\u03bf \u03bc\u03b5\u03b3\u03ac\u03bb\u03c9\u03bd \u03b5\u03c0\u03b9\u03b8\u03ad\u03c3\u03b5\u03c9\u03bd. \u0397 \u03c0\u03c1\u03ce\u03c4\u03b7, \u03c3\u03c4\u03b9\u03c2 7 \u039d\u03bf\u03b5\u03bc\u03b2\u03c1\u03af\u03bf\u03c5 1943, \u03b2\u03c1\u03ae\u03ba\u03b5 \u03c4\u03bf\u03c5\u03c2 \u03ba\u03b1\u03c4\u03bf\u03af\u03ba\u03bf\u03c5\u03c2 \u03ad\u03c4\u03bf\u03b9\u03bc\u03bf\u03c5\u03c2. \u0395\u03bd\u03b7\u03bc\u03b5\u03c1\u03c9\u03bc\u03ad\u03bd\u03bf\u03b9 \u03b5\u03b3\u03ba\u03b1\u03af\u03c1\u03c9\u03c2, \u03b5\u03af\u03c7\u03b1\u03bd \u03ae\u03b4\u03b7 \u03ba\u03b1\u03c4\u03b1\u03c6\u03cd\u03b3\u03b5\u03b9 \u03c3\u03c4\u03b1 \u03b2\u03bf\u03c5\u03bd\u03ac. \u039f\u03b9 \u0393\u03b5\u03c1\u03bc\u03b1\u03bd\u03bf\u03af \u03ad\u03ba\u03b1\u03c8\u03b1\u03bd, \u03bb\u03b5\u03b7\u03bb\u03ac\u03c4\u03b7\u03c3\u03b1\u03bd \u03ba\u03b1\u03b9 \u03b1\u03bd\u03b1\u03c4\u03af\u03bd\u03b1\u03be\u03b1\u03bd \u03c4\u03bf \u0393\u03c5\u03bc\u03bd\u03ac\u03c3\u03b9\u03bf. \u0389\u03c4\u03b1\u03bd \u03bc\u03b9\u03b1 \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7. \u0397 \u03b4\u03b5\u03cd\u03c4\u03b5\u03c1\u03b7 \u03ba\u03b1\u03b9 \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03b9\u03ba\u03ae \u03b5\u03c0\u03af\u03b8\u03b5\u03c3\u03b7 \u03ae\u03c1\u03b8\u03b5 \u03c3\u03c4\u03b9\u03c2 9 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5 1944, \u03c3\u03c4\u03bf \u03c0\u03bb\u03b1\u03af\u03c3\u03b9\u03bf \u03c4\u03b7\u03c2 \u03b5\u03c0\u03b9\u03c7\u03b5\u03af\u03c1\u03b7\u03c3\u03b7\u03c2 \u00ab\u0388\u03c7\u03b9\u03b4\u03bd\u03b1\u00bb. \u0394\u03cd\u03bd\u03b1\u03bc\u03b7 10.000 \u03c0\u03ac\u03bd\u03bf\u03c0\u03bb\u03c9\u03bd \u03c3\u03c4\u03c1\u03b1\u03c4\u03b9\u03c9\u03c4\u03ce\u03bd, 500 \u03bf\u03c7\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03c5\u03ac\u03c1\u03b9\u03b8\u03bc\u03c9\u03bd \u03b1\u03c1\u03bc\u03ac\u03c4\u03c9\u03bd \u03bc\u03ac\u03c7\u03b7\u03c2 \u03c0\u03b5\u03c1\u03b9\u03ba\u03cd\u03ba\u03bb\u03c9\u03c3\u03b5 \u03c4\u03b7\u03bd \u03c0\u03cc\u03bb\u03b7. \u0393\u03b9\u03b1 \u03c4\u03ad\u03c3\u03c3\u03b5\u03c1\u03b9\u03c2 \u03bf\u03bb\u03cc\u03ba\u03bb\u03b7\u03c1\u03b5\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b5\u03c2, \u03c9\u03c2 \u03c4\u03b9\u03c2 13 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5, \u03b5\u03b9\u03b4\u03b9\u03ba\u03ac \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b5\u03af\u03b1 \u03c0\u03c5\u03c1\u03c0\u03cc\u03bb\u03b7\u03c3\u03b1\u03bd \u03ba\u03ac\u03b8\u03b5 \u03c3\u03c0\u03af\u03c4\u03b9, \u03ba\u03ac\u03b8\u03b5 \u03b5\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u03b1, \u03ba\u03ac\u03b8\u03b5 \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b7\u03bc\u03b1. \u0391\u03c0\u03cc \u03c4\u03b1 1.000 \u03c3\u03c0\u03af\u03c4\u03b9\u03b1, \u03bc\u03cc\u03bd\u03bf 8 \u03ad\u03bc\u03b5\u03b9\u03bd\u03b1\u03bd \u03cc\u03c1\u03b8\u03b9\u03b1.\n\n\u0397 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 VR\n\n\u0397 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03be\u03b5\u03ba\u03b9\u03bd\u03ac \u03c3\u03b5 \u03bc\u03b9\u03b1 \u03ae\u03c3\u03c5\u03c7\u03b7, \u03b7\u03bb\u03b9\u03cc\u03bb\u03bf\u03c5\u03c3\u03c4\u03b7 \u03c0\u03bb\u03b1\u03c4\u03b5\u03af\u03b1 \u03c4\u03bf\u03c5 \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5. \u0395\u03af\u03bd\u03b1\u03b9 \u03b1\u03c1\u03c7\u03ad\u03c2 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5 1944. \u039f \u03b8\u03b5\u03b1\u03c4\u03ae\u03c2 \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9 \u03c0\u03b1\u03b9\u03b4\u03b9\u03ac \u03bd\u03b1 \u03c0\u03b1\u03af\u03b6\u03bf\u03c5\u03bd, \u03b3\u03c5\u03bd\u03b1\u03af\u03ba\u03b5\u03c2 \u03bd\u03b1 \u03c8\u03c9\u03bd\u03af\u03b6\u03bf\u03c5\u03bd, \u03b3\u03ad\u03c1\u03bf\u03c5\u03c2 \u03bd\u03b1 \u03ba\u03ac\u03b8\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b1 \u03ba\u03b1\u03c6\u03b5\u03bd\u03b5\u03af\u03b1. \u0397 \u03b1\u03c4\u03bc\u03cc\u03c3\u03c6\u03b1\u03b9\u03c1\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b3\u03b1\u03bb\u03ae\u03bd\u03b9\u03b1 \u2013 \u03b7 \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 \u03b1\u03bd\u03ac\u03c3\u03b1 \u03b5\u03b9\u03c1\u03ae\u03bd\u03b7\u03c2 \u03c0\u03c1\u03b9\u03bd \u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03b1\u03b9\u03b3\u03af\u03b4\u03b1.\n\n\u039e\u03b1\u03c6\u03bd\u03b9\u03ba\u03ac, \u03bf \u03b2\u03c1\u03c5\u03c7\u03b7\u03b8\u03bc\u03cc\u03c2 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03c9\u03bd \u03b4\u03b9\u03b1\u03c3\u03c0\u03ac \u03c4\u03b7 \u03c3\u03b9\u03c9\u03c0\u03ae. \u039c\u03b9\u03b1 \u03b1\u03c0\u03ad\u03c1\u03b1\u03bd\u03c4\u03b7 \u03c3\u03c4\u03ae", "short_description": "\u03a4\u03bf \u00ab\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5\u00bb \u03b5\u03af\u03bd\u03b1\u03b9 \u03bc\u03b9\u03b1 \u03ba\u03b1\u03b8\u03b7\u03bb\u03c9\u03c4\u03b9\u03ba\u03ae \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c0\u03bf\u03c5 \u03bc\u03b5\u03c4\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b8\u03b5\u03b1\u03c4\u03ae \u03c0\u03af\u03c3\u03c9 \u03c3\u03c4\u03bf\u03bd \u0391\u03cd\u03b3\u03bf\u03c5\u03c3\u03c4\u03bf \u03c4\u03bf\u03c5 1944, \u03c3\u03c4\u03b9\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2 \u03c4\u03b7\u03c2 \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03b9\u03ba\u03ae\u03c2 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03c1\u03c9\u03c4\u03b5\u03cd\u03bf\u03c5\u03c3\u03b1\u03c2 \u03c4\u03b7\u03c2 \u0395\u03c5\u03c1\u03c5\u03c4\u03b1\u03bd\u03af\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03b9\u03c2 \u03bd\u03b1\u03b6\u03b9\u03c3\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b4\u03c5\u03bd\u03ac\u03bc\u03b5\u03b9\u03c2 \u03ba\u03b1\u03c4\u03bf\u03c7\u03ae\u03c2.\n\n\u0392\u03b1\u03c3\u03b9\u03c3\u03bc\u03ad\u03bd\u03b7 \u03c3\u03b5 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ac \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ac \u03bd\u03c4\u03bf\u03ba\u03bf\u03c5\u03bc\u03ad\u03bd\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03bc\u03b1\u03c1\u03c4\u03c5\u03c1\u03af\u03b5\u03c2 \u03b5\u03c0\u03b9\u03b6\u03ce\u03bd\u03c4\u03c9\u03bd, \u03b7 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b4\u03b5\u03bd \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03ad\u03bd\u03b1 \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9 \u03c8\u03c5\u03c7\u03b1\u03b3\u03c9\u03b3\u03af\u03b1\u03c2, \u03b1\u03bb\u03bb\u03ac \u03ad\u03bd\u03b1 \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03cc \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03cc \u03bd\u03c4\u03bf\u03ba\u03b9\u03bc\u03b1\u03bd\u03c4\u03ad\u03c1. \u039f \u03c7\u03c1\u03ae\u03c3\u03c4\u03b7\u03c2 \u03c4\u03bf\u03c0\u03bf\u03b8\u03b5\u03c4\u03b5\u03af\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf \u03ba\u03ad\u03bd\u03c4\u03c1\u03bf \u03c4\u03b7\u03c2 \u03c0\u03cc\u03bb\u03b7\u03c2 \u03bb\u03af\u03b3\u03b5\u03c2 \u03ce\u03c1\u03b5\u03c2 \u03c0\u03c1\u03b9\u03bd \u03c4\u03b7\u03bd \u03b5\u03b9\u03c3\u03b2\u03bf\u03bb\u03ae. \u0392\u03b9\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b7 \u03b3\u03b1\u03bb\u03ae\u03bd\u03b7 \u03c4"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1725885781780032", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1725885785113365_7963299967643114898_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOHNhc_DdEIQ7kNvwGh7blf&_nc_oc=Adq4p0nhx2xskNpuHjG4BCiBpl9NDrXryvHe73WoItc5LcTwvWOwj4s5ZAxMxpBMsrE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfdwCuhWo2SJcWo8iF97s1JKH2QEr01kmACzZznjHIGw&oe=6B0C5F21"}, {"file_name": "72.png", "id": "1722235112154656", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673607600_1722235115487989_7179379227682588602_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMgIWsJWxKEQ7kNvwFgHAh0&_nc_oc=Adogre0y9vIKVy7VoFulQqKpXn8gO3lPw3WTGCj_Qkphq_8G8pEuU7m4TfbrhY32z3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQbit6X613X0pdH-RWo9GVcHelKIEu5XOo55suT19pE1g&oe=6B0C5F61"}, {"file_name": "79.png", "id": "1614861966746855", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827626_1614861970080188_1163984589108115967_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Twl3oQuDGdIQ7kNvwHqzPLj&_nc_oc=Adp3e2uqD9FfBQXpkbWwzu_WbI7BpXgWGD4gcjTbyj8h_UVamRZocjQuvi2N0FWoO3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSslxY9L_A_ArCxp07qI905-KblOsTVWp6qGm0Oshc9oQ&oe=6B0C6674"}, {"file_name":
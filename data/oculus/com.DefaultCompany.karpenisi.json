ng", "id": "2577097242733093", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491824665_2577097246066426_4277289553193595208_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyTaPKGhtwwQ7kNvwGKVQEV&_nc_oc=AdpmtWAiFjGCsQz8x5F1uFbk92zvU2uLNn6VKmqM7vH5H2ka9kuoedQ9n1LBIUg_P2s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4-4ePETkrvpnsM9baGKAKRoSa5vaDzJOXfgZ1-rCBrQ&oe=6A8EDE18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c0\u03b5\u03c1\u03bd\u03b9\u03c3\u03af\u03bf\u03c5", "keywords": [], "long_description": "\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5 \u2013 \u03a4\u03bf \u03c7\u03c1\u03bf\u03bd\u03b9\u03ba\u03cc \u03bc\u03b9\u03b1\u03c2 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c3\u03b5 \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\n\n\u03a4\u03bf \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03ae\u03c3\u03b9, \u03c7\u03c4\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf \u03b1\u03bc\u03c6\u03b9\u03b8\u03b5\u03b1\u03c4\u03c1\u03b9\u03ba\u03ac \u03c3\u03c4\u03bf\u03c5\u03c2 \u03c0\u03c1\u03cc\u03c0\u03bf\u03b4\u03b5\u03c2 \u03c4\u03bf\u03c5 \u0392\u03b5\u03bb\u03bf\u03c5\u03c7\u03af\u03bf\u03c5, \u03c5\u03c0\u03ae\u03c1\u03be\u03b5 \u03b3\u03b9\u03b1 \u03b1\u03b9\u03ce\u03bd\u03b5\u03c2 \u03c4\u03bf \u03b1\u03bd\u03b8\u03c1\u03ce\u03c0\u03b9\u03bd\u03bf \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03ba\u03ad\u03bd\u03c4\u03c1\u03bf \u03c4\u03b7\u03c2 \u03bf\u03c1\u03b5\u03b9\u03bd\u03ae\u03c2 \u0395\u03c5\u03c1\u03c5\u03c4\u03b1\u03bd\u03af\u03b1\u03c2. \u03a4\u03bf\u03bd \u0391\u03cd\u03b3\u03bf\u03c5\u03c3\u03c4\u03bf \u03c4\u03bf\u03c5 1944, \u03cc\u03bc\u03c9\u03c2, \u03b7 \u03bc\u03bf\u03af\u03c1\u03b1 \u03c4\u03bf\u03c5 \u03c3\u03c6\u03c1\u03b1\u03b3\u03af\u03c3\u03c4\u03b7\u03ba\u03b5 \u03bc\u03b5 \u03c4\u03bf\u03bd \u03c0\u03b9\u03bf \u03b2\u03af\u03b1\u03b9\u03bf \u03c4\u03c1\u03cc\u03c0\u03bf. \u0397 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u00ab\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5\u00bb \u03b1\u03bd\u03b1\u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03b5\u03af \u03bc\u03b5 \u03b1\u03c0\u03cc\u03bb\u03c5\u03c4\u03b7 \u03c0\u03b9\u03c3\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b1\u03c5\u03c4\u03ad\u03c2 \u03c4\u03b9\u03c2 \u03bc\u03b1\u03cd\u03c1\u03b5\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2, \u03c0\u03c1\u03bf\u03c3\u03c6\u03ad\u03c1\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c3\u03c4\u03bf\u03bd \u03b8\u03b5\u03b1\u03c4\u03ae \u03bc\u03b9\u03b1 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03c0\u03bf\u03c5 \u03be\u03b5\u03c0\u03b5\u03c1\u03bd\u03ac \u03c4\u03b7\u03bd \u03b1\u03c0\u03bb\u03ae \u03b1\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03b3\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b2\u03b9\u03c9\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03bc\u03ac\u03b8\u03b7\u03c3\u03b7.\n\n\u0397 \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ae \u03b2\u03ac\u03c3\u03b7\n\n\u0397 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u03c5\u03c0\u03ae\u03c1\u03be\u03b5 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03b4\u03cd\u03bf \u03bc\u03b5\u03b3\u03ac\u03bb\u03c9\u03bd \u03b5\u03c0\u03b9\u03b8\u03ad\u03c3\u03b5\u03c9\u03bd. \u0397 \u03c0\u03c1\u03ce\u03c4\u03b7, \u03c3\u03c4\u03b9\u03c2 7 \u039d\u03bf\u03b5\u03bc\u03b2\u03c1\u03af\u03bf\u03c5 1943, \u03b2\u03c1\u03ae\u03ba\u03b5 \u03c4\u03bf\u03c5\u03c2 \u03ba\u03b1\u03c4\u03bf\u03af\u03ba\u03bf\u03c5\u03c2 \u03ad\u03c4\u03bf\u03b9\u03bc\u03bf\u03c5\u03c2. \u0395\u03bd\u03b7\u03bc\u03b5\u03c1\u03c9\u03bc\u03ad\u03bd\u03bf\u03b9 \u03b5\u03b3\u03ba\u03b1\u03af\u03c1\u03c9\u03c2, \u03b5\u03af\u03c7\u03b1\u03bd \u03ae\u03b4\u03b7 \u03ba\u03b1\u03c4\u03b1\u03c6\u03cd\u03b3\u03b5\u03b9 \u03c3\u03c4\u03b1 \u03b2\u03bf\u03c5\u03bd\u03ac. \u039f\u03b9 \u0393\u03b5\u03c1\u03bc\u03b1\u03bd\u03bf\u03af \u03ad\u03ba\u03b1\u03c8\u03b1\u03bd, \u03bb\u03b5\u03b7\u03bb\u03ac\u03c4\u03b7\u03c3\u03b1\u03bd \u03ba\u03b1\u03b9 \u03b1\u03bd\u03b1\u03c4\u03af\u03bd\u03b1\u03be\u03b1\u03bd \u03c4\u03bf \u0393\u03c5\u03bc\u03bd\u03ac\u03c3\u03b9\u03bf. \u0389\u03c4\u03b1\u03bd \u03bc\u03b9\u03b1 \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7. \u0397 \u03b4\u03b5\u03cd\u03c4\u03b5\u03c1\u03b7 \u03ba\u03b1\u03b9 \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03b9\u03ba\u03ae \u03b5\u03c0\u03af\u03b8\u03b5\u03c3\u03b7 \u03ae\u03c1\u03b8\u03b5 \u03c3\u03c4\u03b9\u03c2 9 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5 1944, \u03c3\u03c4\u03bf \u03c0\u03bb\u03b1\u03af\u03c3\u03b9\u03bf \u03c4\u03b7\u03c2 \u03b5\u03c0\u03b9\u03c7\u03b5\u03af\u03c1\u03b7\u03c3\u03b7\u03c2 \u00ab\u0388\u03c7\u03b9\u03b4\u03bd\u03b1\u00bb. \u0394\u03cd\u03bd\u03b1\u03bc\u03b7 10.000 \u03c0\u03ac\u03bd\u03bf\u03c0\u03bb\u03c9\u03bd \u03c3\u03c4\u03c1\u03b1\u03c4\u03b9\u03c9\u03c4\u03ce\u03bd, 500 \u03bf\u03c7\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03c5\u03ac\u03c1\u03b9\u03b8\u03bc\u03c9\u03bd \u03b1\u03c1\u03bc\u03ac\u03c4\u03c9\u03bd \u03bc\u03ac\u03c7\u03b7\u03c2 \u03c0\u03b5\u03c1\u03b9\u03ba\u03cd\u03ba\u03bb\u03c9\u03c3\u03b5 \u03c4\u03b7\u03bd \u03c0\u03cc\u03bb\u03b7. \u0393\u03b9\u03b1 \u03c4\u03ad\u03c3\u03c3\u03b5\u03c1\u03b9\u03c2 \u03bf\u03bb\u03cc\u03ba\u03bb\u03b7\u03c1\u03b5\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b5\u03c2, \u03c9\u03c2 \u03c4\u03b9\u03c2 13 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5, \u03b5\u03b9\u03b4\u03b9\u03ba\u03ac \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b5\u03af\u03b1 \u03c0\u03c5\u03c1\u03c0\u03cc\u03bb\u03b7\u03c3\u03b1\u03bd \u03ba\u03ac\u03b8\u03b5 \u03c3\u03c0\u03af\u03c4\u03b9, \u03ba\u03ac\u03b8\u03b5 \u03b5\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u03b1, \u03ba\u03ac\u03b8\u03b5 \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b7\u03bc\u03b1. \u0391\u03c0\u03cc \u03c4\u03b1 1.000 \u03c3\u03c0\u03af\u03c4\u03b9\u03b1, \u03bc\u03cc\u03bd\u03bf 8 \u03ad\u03bc\u03b5\u03b9\u03bd\u03b1\u03bd \u03cc\u03c1\u03b8\u03b9\u03b1.\n\n\u0397 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 VR\n\n\u0397 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03be\u03b5\u03ba\u03b9\u03bd\u03ac \u03c3\u03b5 \u03bc\u03b9\u03b1 \u03ae\u03c3\u03c5\u03c7\u03b7, \u03b7\u03bb\u03b9\u03cc\u03bb\u03bf\u03c5\u03c3\u03c4\u03b7 \u03c0\u03bb\u03b1\u03c4\u03b5\u03af\u03b1 \u03c4\u03bf\u03c5 \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5. \u0395\u03af\u03bd\u03b1\u03b9 \u03b1\u03c1\u03c7\u03ad\u03c2 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5 1944. \u039f \u03b8\u03b5\u03b1\u03c4\u03ae\u03c2 \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9 \u03c0\u03b1\u03b9\u03b4\u03b9\u03ac \u03bd\u03b1 \u03c0\u03b1\u03af\u03b6\u03bf\u03c5\u03bd, \u03b3\u03c5\u03bd\u03b1\u03af\u03ba\u03b5\u03c2 \u03bd\u03b1 \u03c8\u03c9\u03bd\u03af\u03b6\u03bf\u03c5\u03bd, \u03b3\u03ad\u03c1\u03bf\u03c5\u03c2 \u03bd\u03b1 \u03ba\u03ac\u03b8\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b1 \u03ba\u03b1\u03c6\u03b5\u03bd\u03b5\u03af\u03b1. \u0397 \u03b1\u03c4\u03bc\u03cc\u03c3\u03c6\u03b1\u03b9\u03c1\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b3\u03b1\u03bb\u03ae\u03bd\u03b9\u03b1 \u2013 \u03b7 \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 \u03b1\u03bd\u03ac\u03c3\u03b1 \u03b5\u03b9\u03c1\u03ae\u03bd\u03b7\u03c2 \u03c0\u03c1\u03b9\u03bd \u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03b1\u03b9\u03b3\u03af\u03b4\u03b1.\n\n\u039e\u03b1\u03c6\u03bd\u03b9\u03ba\u03ac, \u03bf \u03b2\u03c1\u03c5\u03c7\u03b7\u03b8\u03bc\u03cc\u03c2 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03c9\u03bd \u03b4\u03b9\u03b1\u03c3\u03c0\u03ac \u03c4\u03b7 \u03c3\u03b9\u03c9\u03c0\u03ae. \u039c\u03b9\u03b1 \u03b1\u03c0\u03ad\u03c1\u03b1\u03bd\u03c4\u03b7 \u03c3\u03c4\u03ae", "short_description": "\u03a4\u03bf \u00ab\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5\u00bb \u03b5\u03af\u03bd\u03b1\u03b9 \u03bc\u03b9\u03b1 \u03ba\u03b1\u03b8\u03b7\u03bb\u03c9\u03c4\u03b9\u03ba\u03ae \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c0\u03bf\u03c5 \u03bc\u03b5\u03c4\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b8\u03b5\u03b1\u03c4\u03ae \u03c0\u03af\u03c3\u03c9 \u03c3\u03c4\u03bf\u03bd \u0391\u03cd\u03b3\u03bf\u03c5\u03c3\u03c4\u03bf \u03c4\u03bf\u03c5 1944, \u03c3\u03c4\u03b9\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2 \u03c4\u03b7\u03c2 \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03b9\u03ba\u03ae\u03c2 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03c1\u03c9\u03c4\u03b5\u03cd\u03bf\u03c5\u03c3\u03b1\u03c2 \u03c4\u03b7\u03c2 \u0395\u03c5\u03c1\u03c5\u03c4\u03b1\u03bd\u03af\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03b9\u03c2 \u03bd\u03b1\u03b6\u03b9\u03c3\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b4\u03c5\u03bd\u03ac\u03bc\u03b5\u03b9\u03c2 \u03ba\u03b1\u03c4\u03bf\u03c7\u03ae\u03c2.\n\n\u0392\u03b1\u03c3\u03b9\u03c3\u03bc\u03ad\u03bd\u03b7 \u03c3\u03b5 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ac \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ac \u03bd\u03c4\u03bf\u03ba\u03bf\u03c5\u03bc\u03ad\u03bd\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03bc\u03b1\u03c1\u03c4\u03c5\u03c1\u03af\u03b5\u03c2 \u03b5\u03c0\u03b9\u03b6\u03ce\u03bd\u03c4\u03c9\u03bd, \u03b7 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b4\u03b5\u03bd \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03ad\u03bd\u03b1 \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9 \u03c8\u03c5\u03c7\u03b1\u03b3\u03c9\u03b3\u03af\u03b1\u03c2, \u03b1\u03bb\u03bb\u03ac \u03ad\u03bd\u03b1 \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03cc \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03cc \u03bd\u03c4\u03bf\u03ba\u03b9\u03bc\u03b1\u03bd\u03c4\u03ad\u03c1. \u039f \u03c7\u03c1\u03ae\u03c3\u03c4\u03b7\u03c2 \u03c4\u03bf\u03c0\u03bf\u03b8\u03b5\u03c4\u03b5\u03af\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf \u03ba\u03ad\u03bd\u03c4\u03c1\u03bf \u03c4\u03b7\u03c2 \u03c0\u03cc\u03bb\u03b7\u03c2 \u03bb\u03af\u03b3\u03b5\u03c2 \u03ce\u03c1\u03b5\u03c2 \u03c0\u03c1\u03b9\u03bd \u03c4\u03b7\u03bd \u03b5\u03b9\u03c3\u03b2\u03bf\u03bb\u03ae. \u0392\u03b9\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b7 \u03b3\u03b1\u03bb\u03ae\u03bd\u03b7 \u03c4"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1725885781780032", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823783_1725885785113365_7963299967643114898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Td8upmPDt_AQ7kNvwHXWVPj&_nc_oc=AdrmhPZ5D8J0lyiWtvZFZkbh91aK9zVO0MuoHgkL7YyGmwhX8FPrHa5fhZ_btuNp5K4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFQSnAazgIaKmrGYPfTiCozfvIDXlP58NPIt0tRjwb6w&oe=6A8EE861"}, {"file_name": "72.png", "id": "1722235112154656", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/673607600_1722235115487989_7179379227682588602_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01jK_lCMGmEQ7kNvwEeOdH2&_nc_oc=AdoXMgvOm0VIS0KFUmc-Jjw75YyhkuKY6OrFVHMWDq_Ipv3vd7hOZCL84wjyf3dz9ps&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFui-d3Gk80wuiMLA2k-lSpUpwXmuGFdGwGqK0QO3Yvag&oe=6A8EE8A1"}, {"file_name": "79.png", "id": "1614861966746855", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827626_1614861970080188_1163984589108115967_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gne5TCTv1Q8Q7kNvwHczUHX&_nc_oc=AdqrUZ5DUsh7OCc5DyJzKh_UtzTUZe_7VIZwJZ2y_8MjIIaTdJrkTC7fTHQWhgEWy6k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESzI-PGjclAev9nA_tySL7JrsjAwNKxa77LXSm95zXrA&oe=6A8EEFB4"}, {"file_name": "78.png", "id": "1455479029726195", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828087_1455479033059528_7445077874557174049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyIzS2GtZ3oQ7kNvwH422F9&_nc_oc=AdojY-auMyo41_ZgaE-FSe_e7-xKXECp9AH4WgYu7q3cAqzraski2K5VZjokvira52k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0SiyRfXDiuGjQwHRxUVrTPelgfi5OgSNxiT4KqYWBNA&oe=6A8EDE98"}, {"file_name": "74.png", "id": "1029053432955879", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491825470_1029053436289212_8169003220427800514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hTM5uGCYpEQ7kNvwHrj68r&_nc_oc=AdqQ4XA_FdU6HYB3J6iIpt_HXL3cepiAyLV-Nhjs3Q8JMywiwColrrkpqsz80HcGcTQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_ho2lp0kuCYXRfslGNDdvNETzKsCWRydIJfGaONBcaw&oe=6A8ED377"}]}, "id": "1930643910975852", "locale": "en_US", "screenshots": [{"file_name": "73.png", "id": "1362585269337467", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823310_1362585276004133_8963422836501446895_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDX5nmXRe5gQ7kNvwHBGuMx&_nc_oc=AdrkCWTen3Pa4_hmCYnY1J3fEoWYjb6Rx2r_04V9BOJMx3lbexEtevpca7_1wtu2GsQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_ncpiL9s-H44f1juagXcoTz6Qc9C-nXII6LkT-lmePA&oe=6A8EEB87"}, {"file_name": "78.png", "id": "27766564862977214", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823783_27766564866310547_3004709527238500849_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVIdmN3gCDYQ7kNvwE69--F&_nc_oc=Ados-hAcwyAfAm6Rn0sxiB1E6QqHhws6h9odztvUSNT-KFWc5GtchS4Xzl0YBF66MFg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPYtM-xROZ6JrTBugMe6in_jPqMoDn-x4KnLVBc4mgUg&oe=6A8EC146"}, {"file_name": "72.png", "id": "1446490367289345", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823930_1446490373956011_8259659604473728431_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xe_q6_0Ug94Q7kNvwG_Ud18&_nc_oc=Adqb7bIZXNyGdGsUDj2d9U3E100mBW7vRu7ljZTijDraa9W7piWnVbO-USeqcG6micI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7WfpIxdB2iq-LU_-e5Y20fxGHss2Pi926eGASCt30Xg&oe=6A8EE02A"}, {"file_name": "77.png", "id": "2007639299879030", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491827960_2007639303212363_8526959797811423433_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNNz21JnvLUQ7kNvwEaaekZ&_nc_oc=Adp2ALuQMCgkcADgR2WqOjuDLj-6MfYwOvXAcIRDTQy2zScAaUpVhvPUkWLYyRFY7_c&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLekCEtzgI2HyKrF3xR51MRUozVvAodyMFqgB8b2G7AA&oe=6A8EF0C2"}, {"file_name": "71.png", "id": "28044214161932068", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/673607600_28044214178598733_8673542388600986992_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G97v861E8oIQ7kNvwHbywsk&_nc_oc=AdqK3B-ds0DkfpoMCD9kpODX9oKMpIj19rykxus0WiGGqLsXeX6yf_q4CJyjzfeUejA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTqxOATKM6xnP4GYvL7mJJCrKiTqMENF-ycUMvY5Nrvg&oe=6A8EBFEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Destruction of Karpenisi", "keywords": [], "long_description": "The Destruction of Karpenisi \u2013 The Chronicle of a Disaster in Virtual Reality\n\nKarpenisi, built amphitheatrically at the foot of Mount Velouchi, was for centuries the human and cultural center of mountainous Evrytania. In August 1944, however, its fate was sealed in the most violent way. The virtual reality application \"The Destruction of Karpenisi\" recreates those dark days with absolute fidelity, offering the viewer an experience that goes beyond mere narrative and becomes experiential learning.\n\nThe historical background\n\nThe destruction was the result of two major attacks. The first, on November 7, 1943, found the residents prepared. Informed in time, they had already taken refuge in the mountains. The Germans burned, looted, and blew up the High School. It was a warning. The second and total attack came on August 9, 1944, as part of Operation \"Viper.\" A force of 10,000 heavily armed soldiers, 500 vehicles, and numerous tanks surrounded the town. For four full days, until August 13, special squads set fire to every house, every church, every shop. Of the 1,000 houses, only 8 remained standing.", "short_description": "\"The Destruction of Karpenisi\" is an immersive virtual reality experience that transports the viewer back to August 1944, to the days of the total destruction of the capital of Evrytania by the Nazi occupation forces.\n\nBased on real historical documents and survivor testimonies, this application is not an entertainment game but an interactive historical documentary. The user is placed in the center of the town just hours before the invasion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://old.comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["el"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2808049126236010"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/673607600_1722235115487989_7179379227682588602_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01jK_lCMGmEQ7kNvwEeOdH2&_nc_oc=AdoXMgvOm0VIS0KFUmc-Jjw75YyhkuKY6OrFVHMWDq_Ipv3vd7hOZCL84wjyf3dz9ps&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEj3iQ0Su4aY1Y2ZWvWuDuUx113tgxlXX8jndHblYxg3g&oe=6A8EE8A1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Destruction of Karpenisi", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1784527380, "lastRevision": {"nodes": [{"id": "2808049142902675", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2808049119569344", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1547600626759537"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2307170903423946", "locale": "el_GR", "screenshots": [{"file_name": "73.png", "id": "898239516077958", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823279_898239522744624_1715021388509573230_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcQeEqyukykQ7kNvwHfG6vF&_nc_oc=AdojCd_AyBY4FWmUAE_RUT513MedPSftJBR7uLGq2CkHxNxs_-KotJobTkxEQqVplYM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1knEGfBT3PBjh0WhxnmLvC5MT0kCwVyxzn9Z7ra8img&oe=6A8ED20E"}, {"file_name": "77.png", "id": "1574906134233527", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491825497_1574906137566860_8647180732733691586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IV5j4P_p4R0Q7kNvwH9bppL&_nc_oc=AdpXp2UZVKBBH6PJAmNzblqCKQLasnYdBxehfL8oW2H2THIrkymWHSQu3BmhYHoFvJ4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9M2s_N8k889azhJZL9yXkTd8fX_5_jk8-Rzo7BkUhKA&oe=6A8EECBA"}, {"file_name": "72.png", "id": "1746062349745187", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491824741_1746062353078520_5103945107329399166_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXL2IMpZuasQ7kNvwGXM-4k&_nc_oc=AdoRcTE65dqB3-2nB6nTM3lgp28sHJC9ZFhlx4kkhB1TpHdxYZb_tHAvgueL_8QfNRw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2LvaPIR2S1y6HcqIKVp8pp97gG6mvguBh348bgAUukw&oe=6A8ECC93"}, {"file_name": "78.png", "id": "1268828846303894", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499304952_1268828849637227_2122329126437209533_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YO4hoKSo04Q7kNvwFfP5Ak&_nc_oc=Adqla97qHJ_rQCXMtOpxC4FJxm36nLVU4PmjvRzG9G_2_hBXH2CYnuZSz8GgGUG-NG0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-FncynNd49xBj99qUAPdf4n4sI-YuCxD7sv81olCp9w&oe=6A8EDDD7"}, {"file_name": "71.png", "id": "2577097242733093", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491824665_2577097246066426_4277289553193595208_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyTaPKGhtwwQ7kNvwGKVQEV&_nc_oc=AdpmtWAiFjGCsQz8x5F1uFbk92zvU2uLNn6VKmqM7vH5H2ka9kuoedQ9n1LBIUg_P2s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4-4ePETkrvpnsM9baGKAKRoSa5vaDzJOXfgZ1-rCBrQ&oe=6A8EDE18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c0\u03b5\u03c1\u03bd\u03b9\u03c3\u03af\u03bf\u03c5", "keywords": [], "long_description": "\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5 \u2013 \u03a4\u03bf \u03c7\u03c1\u03bf\u03bd\u03b9\u03ba\u03cc \u03bc\u03b9\u03b1\u03c2 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c3\u03b5 \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\n\n\u03a4\u03bf \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03ae\u03c3\u03b9, \u03c7\u03c4\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf \u03b1\u03bc\u03c6\u03b9\u03b8\u03b5\u03b1\u03c4\u03c1\u03b9\u03ba\u03ac \u03c3\u03c4\u03bf\u03c5\u03c2 \u03c0\u03c1\u03cc\u03c0\u03bf\u03b4\u03b5\u03c2 \u03c4\u03bf\u03c5 \u0392\u03b5\u03bb\u03bf\u03c5\u03c7\u03af\u03bf\u03c5, \u03c5\u03c0\u03ae\u03c1\u03be\u03b5 \u03b3\u03b9\u03b1 \u03b1\u03b9\u03ce\u03bd\u03b5\u03c2 \u03c4\u03bf \u03b1\u03bd\u03b8\u03c1\u03ce\u03c0\u03b9\u03bd\u03bf \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03ba\u03ad\u03bd\u03c4\u03c1\u03bf \u03c4\u03b7\u03c2 \u03bf\u03c1\u03b5\u03b9\u03bd\u03ae\u03c2 \u0395\u03c5\u03c1\u03c5\u03c4\u03b1\u03bd\u03af\u03b1\u03c2. \u03a4\u03bf\u03bd \u0391\u03cd\u03b3\u03bf\u03c5\u03c3\u03c4\u03bf \u03c4\u03bf\u03c5 1944, \u03cc\u03bc\u03c9\u03c2, \u03b7 \u03bc\u03bf\u03af\u03c1\u03b1 \u03c4\u03bf\u03c5 \u03c3\u03c6\u03c1\u03b1\u03b3\u03af\u03c3\u03c4\u03b7\u03ba\u03b5 \u03bc\u03b5 \u03c4\u03bf\u03bd \u03c0\u03b9\u03bf \u03b2\u03af\u03b1\u03b9\u03bf \u03c4\u03c1\u03cc\u03c0\u03bf. \u0397 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u00ab\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5\u00bb \u03b1\u03bd\u03b1\u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03b5\u03af \u03bc\u03b5 \u03b1\u03c0\u03cc\u03bb\u03c5\u03c4\u03b7 \u03c0\u03b9\u03c3\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b1\u03c5\u03c4\u03ad\u03c2 \u03c4\u03b9\u03c2 \u03bc\u03b1\u03cd\u03c1\u03b5\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2, \u03c0\u03c1\u03bf\u03c3\u03c6\u03ad\u03c1\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c3\u03c4\u03bf\u03bd \u03b8\u03b5\u03b1\u03c4\u03ae \u03bc\u03b9\u03b1 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03c0\u03bf\u03c5 \u03be\u03b5\u03c0\u03b5\u03c1\u03bd\u03ac \u03c4\u03b7\u03bd \u03b1\u03c0\u03bb\u03ae \u03b1\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03b3\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b2\u03b9\u03c9\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03bc\u03ac\u03b8\u03b7\u03c3\u03b7.\n\n\u0397 \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ae \u03b2\u03ac\u03c3\u03b7\n\n\u0397 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u03c5\u03c0\u03ae\u03c1\u03be\u03b5 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03b4\u03cd\u03bf \u03bc\u03b5\u03b3\u03ac\u03bb\u03c9\u03bd \u03b5\u03c0\u03b9\u03b8\u03ad\u03c3\u03b5\u03c9\u03bd. \u0397 \u03c0\u03c1\u03ce\u03c4\u03b7, \u03c3\u03c4\u03b9\u03c2 7 \u039d\u03bf\u03b5\u03bc\u03b2\u03c1\u03af\u03bf\u03c5 1943, \u03b2\u03c1\u03ae\u03ba\u03b5 \u03c4\u03bf\u03c5\u03c2 \u03ba\u03b1\u03c4\u03bf\u03af\u03ba\u03bf\u03c5\u03c2 \u03ad\u03c4\u03bf\u03b9\u03bc\u03bf\u03c5\u03c2. \u0395\u03bd\u03b7\u03bc\u03b5\u03c1\u03c9\u03bc\u03ad\u03bd\u03bf\u03b9 \u03b5\u03b3\u03ba\u03b1\u03af\u03c1\u03c9\u03c2, \u03b5\u03af\u03c7\u03b1\u03bd \u03ae\u03b4\u03b7 \u03ba\u03b1\u03c4\u03b1\u03c6\u03cd\u03b3\u03b5\u03b9 \u03c3\u03c4\u03b1 \u03b2\u03bf\u03c5\u03bd\u03ac. \u039f\u03b9 \u0393\u03b5\u03c1\u03bc\u03b1\u03bd\u03bf\u03af \u03ad\u03ba\u03b1\u03c8\u03b1\u03bd, \u03bb\u03b5\u03b7\u03bb\u03ac\u03c4\u03b7\u03c3\u03b1\u03bd \u03ba\u03b1\u03b9 \u03b1\u03bd\u03b1\u03c4\u03af\u03bd\u03b1\u03be\u03b1\u03bd \u03c4\u03bf \u0393\u03c5\u03bc\u03bd\u03ac\u03c3\u03b9\u03bf. \u0389\u03c4\u03b1\u03bd \u03bc\u03b9\u03b1 \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7. \u0397 \u03b4\u03b5\u03cd\u03c4\u03b5\u03c1\u03b7 \u03ba\u03b1\u03b9 \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03b9\u03ba\u03ae \u03b5\u03c0\u03af\u03b8\u03b5\u03c3\u03b7 \u03ae\u03c1\u03b8\u03b5 \u03c3\u03c4\u03b9\u03c2 9 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5 1944, \u03c3\u03c4\u03bf \u03c0\u03bb\u03b1\u03af\u03c3\u03b9\u03bf \u03c4\u03b7\u03c2 \u03b5\u03c0\u03b9\u03c7\u03b5\u03af\u03c1\u03b7\u03c3\u03b7\u03c2 \u00ab\u0388\u03c7\u03b9\u03b4\u03bd\u03b1\u00bb. \u0394\u03cd\u03bd\u03b1\u03bc\u03b7 10.000 \u03c0\u03ac\u03bd\u03bf\u03c0\u03bb\u03c9\u03bd \u03c3\u03c4\u03c1\u03b1\u03c4\u03b9\u03c9\u03c4\u03ce\u03bd, 500 \u03bf\u03c7\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03c5\u03ac\u03c1\u03b9\u03b8\u03bc\u03c9\u03bd \u03b1\u03c1\u03bc\u03ac\u03c4\u03c9\u03bd \u03bc\u03ac\u03c7\u03b7\u03c2 \u03c0\u03b5\u03c1\u03b9\u03ba\u03cd\u03ba\u03bb\u03c9\u03c3\u03b5 \u03c4\u03b7\u03bd \u03c0\u03cc\u03bb\u03b7. \u0393\u03b9\u03b1 \u03c4\u03ad\u03c3\u03c3\u03b5\u03c1\u03b9\u03c2 \u03bf\u03bb\u03cc\u03ba\u03bb\u03b7\u03c1\u03b5\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b5\u03c2, \u03c9\u03c2 \u03c4\u03b9\u03c2 13 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5, \u03b5\u03b9\u03b4\u03b9\u03ba\u03ac \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b5\u03af\u03b1 \u03c0\u03c5\u03c1\u03c0\u03cc\u03bb\u03b7\u03c3\u03b1\u03bd \u03ba\u03ac\u03b8\u03b5 \u03c3\u03c0\u03af\u03c4\u03b9, \u03ba\u03ac\u03b8\u03b5 \u03b5\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u03b1, \u03ba\u03ac\u03b8\u03b5 \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b7\u03bc\u03b1. \u0391\u03c0\u03cc \u03c4\u03b1 1.000 \u03c3\u03c0\u03af\u03c4\u03b9\u03b1, \u03bc\u03cc\u03bd\u03bf 8 \u03ad\u03bc\u03b5\u03b9\u03bd\u03b1\u03bd \u03cc\u03c1\u03b8\u03b9\u03b1.\n\n\u0397 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 VR\n\n\u0397 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03be\u03b5\u03ba\u03b9\u03bd\u03ac \u03c3\u03b5 \u03bc\u03b9\u03b1 \u03ae\u03c3\u03c5\u03c7\u03b7, \u03b7\u03bb\u03b9\u03cc\u03bb\u03bf\u03c5\u03c3\u03c4\u03b7 \u03c0\u03bb\u03b1\u03c4\u03b5\u03af\u03b1 \u03c4\u03bf\u03c5 \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5. \u0395\u03af\u03bd\u03b1\u03b9 \u03b1\u03c1\u03c7\u03ad\u03c2 \u0391\u03c5\u03b3\u03bf\u03cd\u03c3\u03c4\u03bf\u03c5 1944. \u039f \u03b8\u03b5\u03b1\u03c4\u03ae\u03c2 \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9 \u03c0\u03b1\u03b9\u03b4\u03b9\u03ac \u03bd\u03b1 \u03c0\u03b1\u03af\u03b6\u03bf\u03c5\u03bd, \u03b3\u03c5\u03bd\u03b1\u03af\u03ba\u03b5\u03c2 \u03bd\u03b1 \u03c8\u03c9\u03bd\u03af\u03b6\u03bf\u03c5\u03bd, \u03b3\u03ad\u03c1\u03bf\u03c5\u03c2 \u03bd\u03b1 \u03ba\u03ac\u03b8\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b1 \u03ba\u03b1\u03c6\u03b5\u03bd\u03b5\u03af\u03b1. \u0397 \u03b1\u03c4\u03bc\u03cc\u03c3\u03c6\u03b1\u03b9\u03c1\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b3\u03b1\u03bb\u03ae\u03bd\u03b9\u03b1 \u2013 \u03b7 \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 \u03b1\u03bd\u03ac\u03c3\u03b1 \u03b5\u03b9\u03c1\u03ae\u03bd\u03b7\u03c2 \u03c0\u03c1\u03b9\u03bd \u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03b1\u03b9\u03b3\u03af\u03b4\u03b1.\n\n\u039e\u03b1\u03c6\u03bd\u03b9\u03ba\u03ac, \u03bf \u03b2\u03c1\u03c5\u03c7\u03b7\u03b8\u03bc\u03cc\u03c2 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03c9\u03bd \u03b4\u03b9\u03b1\u03c3\u03c0\u03ac \u03c4\u03b7 \u03c3\u03b9\u03c9\u03c0\u03ae. \u039c\u03b9\u03b1 \u03b1\u03c0\u03ad\u03c1\u03b1\u03bd\u03c4\u03b7 \u03c3\u03c4\u03ae", "short_description": "\u03a4\u03bf \u00ab\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u039a\u03b1\u03c1\u03c0\u03b5\u03bd\u03b7\u03c3\u03af\u03bf\u03c5\u00bb \u03b5\u03af\u03bd\u03b1\u03b9 \u03bc\u03b9\u03b1 \u03ba\u03b1\u03b8\u03b7\u03bb\u03c9\u03c4\u03b9\u03ba\u03ae \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c0\u03bf\u03c5 \u03bc\u03b5\u03c4\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b8\u03b5\u03b1\u03c4\u03ae \u03c0\u03af\u03c3\u03c9 \u03c3\u03c4\u03bf\u03bd \u0391\u03cd\u03b3\u03bf\u03c5\u03c3\u03c4\u03bf \u03c4\u03bf\u03c5 1944, \u03c3\u03c4\u03b9\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2 \u03c4\u03b7\u03c2 \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03b9\u03ba\u03ae\u03c2 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03c1\u03c9\u03c4\u03b5\u03cd\u03bf\u03c5\u03c3\u03b1\u03c2 \u03c4\u03b7\u03c2 \u0395\u03c5\u03c1\u03c5\u03c4\u03b1\u03bd\u03af\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03b9\u03c2 \u03bd\u03b1\u03b6\u03b9\u03c3\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b4\u03c5\u03bd\u03ac\u03bc\u03b5\u03b9\u03c2 \u03ba\u03b1\u03c4\u03bf\u03c7\u03ae\u03c2.\n\n\u0392\u03b1\u03c3\u03b9\u03c3\u03bc\u03ad\u03bd\u03b7 \u03c3\u03b5 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ac \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ac \u03bd\u03c4\u03bf\u03ba\u03bf\u03c5\u03bc\u03ad\u03bd\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03bc\u03b1\u03c1\u03c4\u03c5\u03c1\u03af\u03b5\u03c2 \u03b5\u03c0\u03b9\u03b6\u03ce\u03bd\u03c4\u03c9\u03bd, \u03b7 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b4\u03b5\u03bd \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03ad\u03bd\u03b1 \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9 \u03c8\u03c5\u03c7\u03b1\u03b3\u03c9\u03b3\u03af\u03b1\u03c2, \u03b1\u03bb\u03bb\u03ac \u03ad\u03bd\u03b1 \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03cc \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03cc \u03bd\u03c4\u03bf\u03ba\u03b9\u03bc\u03b1\u03bd\u03c4\u03ad\u03c1. \u039f \u03c7\u03c1\u03ae\u03c3\u03c4\u03b7\u03c2 \u03c4\u03bf\u03c0\u03bf\u03b8\u03b5\u03c4\u03b5\u03af\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf \u03ba\u03ad\u03bd\u03c4\u03c1\u03bf \u03c4\u03b7\u03c2 \u03c0\u03cc\u03bb\u03b7\u03c2 \u03bb\u03af\u03b3\u03b5\u03c2 \u03ce\u03c1\u03b5\u03c2 \u03c0\u03c1\u03b9\u03bd \u03c4\u03b7\u03bd \u03b5\u03b9\u03c3\u03b2\u03bf\u03bb\u03ae. \u0392\u03b9\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b7 \u03b3\u03b1\u03bb\u03ae\u03bd\u03b7 \u03c4"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1725885781780032", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823783_1725885785113365_7963299967643114898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Td8upmPDt_AQ7kNvwHXWVPj&_nc_oc=AdrmhPZ5D8J0lyiWtvZFZkbh91aK9zVO0MuoHgkL7YyGmwhX8FPrHa5fhZ_btuNp5K4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFQSnAazgIaKmrGYPfTiCozfvIDXlP58NPIt0tRjwb6w&oe=6A8EE861"}, {"file_name": "72.png", "id": "1722235112154656", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/673607600_1722235115487989_7179379227682588602_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01jK_lCMGmEQ7kNvwEeOdH2&_nc_oc=AdoXMgvOm0VIS0KFUmc-Jjw75YyhkuKY6OrFVHMWDq_Ipv3vd7hOZCL84wjyf3dz9ps&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFui-d3Gk80wuiMLA2k-lSpUpwXmuGFdGwGqK0QO3Yvag&oe=6A8EE8A1"}, {"file_name": "79.png", "id": "1614861966746855", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827626_1614861970080188_1163984589108115967_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gne5TCTv1Q8Q7kNvwHczUHX&_nc_oc=AdqrUZ5DUsh7OCc5DyJzKh_UtzTUZe_7VIZwJZ2y_8MjIIaTdJrkTC7fTHQWhgEWy6k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESzI-PGjclAev9nA_tySL7JrsjAwNKxa77LXSm95zXrA&oe=6A8EEFB4"}, {"file_name": "78.png", "id": "1455479029726195", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828087_1455479033059528_7445077874557174049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyIzS2GtZ3oQ7kNvwH422F9&_nc_oc=AdojY-auMyo41_ZgaE-FSe_e7-xKXECp9AH4WgYu7q3cAqzraski2K5VZjokvira52k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0SiyRfXDiuGjQwHRxUVrTPelgfi5OgSNxiT4KqYWBNA&oe=6A8EDE98"}, {"file_name": "74.png", "id": "1029053432955879", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.
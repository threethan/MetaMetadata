2_434042530837239_5171537024095617024_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZqQ3TGv5ogQ7kNvwEwKJcR&_nc_oc=AdrH1Ypnnp-JNo93Awx_KNHV0neeZbI2REFyrx90-f_n5wBkVfnhilaU27uhEGFiw4w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoOMIEKcG8zE0UKXsNeo-KTfFb-CIDWyZdmEcxvEO8Qg&oe=6B099D0F"}, {"file_name": "migrated_image.png", "id": "595677177684062", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974685_779886539083599_3305066330289340416_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1hRTvmjh6sQ7kNvwGACccM&_nc_oc=AdqeGSv_G_Vh4nTwwhb-mV4JS88PM-MsAlCsX5sDoR3IVCuBkszrhB2aB-LXTB_wfHo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ1lUBgK87Z4TdwU0JIRhXvsV08DtEvs-YUR2tEpXVrQ&oe=6B09CCF2"}, {"file_name": "migrated_image.png", "id": "1345265105656767", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75367597_783637392112071_4470574021808750592_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLyXPPTMjnIQ7kNvwF6xiDa&_nc_oc=Adq92IyDrIwVaMF3JipaCjqQh-UdbY3VcsPfumcX01Gwr4ARJuX91HZsDH9IkoKrSBs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSUefK4S6V6l4X01214vnZ1E6eXzY6Rlr34bOOrGfyFg&oe=6B09BAB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trover2560x1440.png", "id": "1073135574246099", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974915_1073135577579432_2410241133802782992_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vf0Q0kgw45EQ7kNvwEUmtGl&_nc_oc=Ado06EhOlwOvogd-f4Qw1WY4NQElOK_vcC2HxVIJbLoGPCn6bRtxNT7HnY8S9g8xrLM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRst1cevM1z1olKxDcZEERMx6iGbb1k6QcfeBTCfuOcnQ&oe=6B09D006"}, "display_name": "Trover Saves the Universe", "keywords": ["trover", "comedy", "squanch", "rick", "morty"], "long_description": "Your dogs have been dognapped by a beaked lunatic who stuffed them into his eye holes and is using their life essence to destroy the universe. You're partnered with Trover, a little purple eye-hole monster who isn\u2019t a huge fan of working or being put in the position of having to save the universe. Only you and Trover can save everything in this bizarre comedy adventure filled with combat, platforming, puzzles, and morally questionable choices \u2013 created by Squanch Games! \n-Control Trover's movements, but not his mouth. He\u2019s got a lot to say about what\u2019s going on in the game. \n-Travel the cosmos to experience a variety of weird alien planets and characters with big personalities. \n-Upgrade Trover AND YOURSELF with new abilities while evading awkward situations. \n-Immerse yourself in weirdness.", "short_description": "Your pups are missing. The cosmos is at stake. Only you and Trover can save everything in this bizarre comedy adventure!"}]}, "developer_name": "Squanch Games, Inc.", "developer_privacy_policy_url": "https://squanchgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Squanch Games, Inc.", "support_website_url": null, "website_url": "http://squanchgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8331953986862755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.ocul
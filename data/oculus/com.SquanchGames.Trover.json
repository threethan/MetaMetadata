nt-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQavxJ0cwucUKtv-qVlnnS6E_7OUB9gD911j3oxZImkdw&oe=6AFDBF8F"}, {"file_name": "migrated_image.png", "id": "595677177684062", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974685_779886539083599_3305066330289340416_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSrz_aGDzjIQ7kNvwFFZ-wL&_nc_oc=AdoQ_UXTt_lRz8NcuriuEx13W-rvPqK1TkqaYNDzOi1XD6McYriaBi-EiqVtigqoNak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6LY3gnRBqozbcEP_VOIf74ZUonfoFkI2Ddi9A8ZRGMw&oe=6AFDB732"}, {"file_name": "migrated_image.png", "id": "1345265105656767", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75367597_783637392112071_4470574021808750592_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbFyJL4xLCwQ7kNvwFZ-RHu&_nc_oc=Adppms5vzvEp4y_FB3gP2BYHjTjWXLiF6TYoTLUvUIYtv_kov00s_ej2lzbZ6H89pL8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSRbV3-KvM_jMeZkKRpUQW1U790mgzaehYyromyTv7Kg&oe=6AFDDD33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trover Saves the Universe - Quest", "keywords": ["trover", "comedy", "squanch", "rick", "morty"], "long_description": "From the co-creator of Rick and Morty comes Trover Saves the Universe. Your dogs have been dognapped by a beaked lunatic who stuffed them into his eye holes and is using their life essence to destroy the universe. You're partnered with Trover, a little purple eye-hole monster who isn\u2019t a huge fan of working or being put in the position of having to save the universe. Only you and Trover can save everything in this bizarre comedy adventure filled with combat, platforming, puzzles, and morally questionable choices \u2013 created by Justin Roiland! -Control Trover's movements, but not his mouth. He\u2019s got a lot to say about what\u2019s going on in the game. -Travel the cosmos to experience a variety of weird alien planets and characters with big personalities. -Upgrade Trover AND YOURSELF with new abilities while evading awkward situations. -Immerse yourself in weirdness.", "short_description": "From the co-creator of Rick and Morty comes Trover Saves the Universe. Your pups are missing. The cosmos is at stake. Only you and Trover can save everything in this bizarre comedy adventure!"}]}, "developer_name": "Squanch Games, Inc.", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Squanch Games, Inc.", "support_website_url": "https://squanchtendo.atlassian.net/servicedesk/customer/portal/1", "website_url": "http://trover.site/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "604781180589665"}}]}, "scheduled_offers": {"count": 47, "nodes": [{"status": "PUBLISHED", "id": "746397921265027"}, {"status": "PUBLISHED", "id": "768117975831691"}, {"status": "PENDING", "id": "1158330498901427"}, {"status": "PUBLISHED", "id": "1650078322286339"}, {"status": "PUBLISHED", "id": "1011998527354541"}, {"status": "PUBLISHED", "id": "3891077267829516"}, {"status": "PUBLISHED", "id": "877019193924592"}, {"status": "PUBLISHED", "id": "627470728181494"}, {"status": "PENDING", "id": "734199401399870"}, {"status": "PUBLISHED", "id": "624566872309978"}, {"status": "PUBLISHED", "id": "1167498044069122"}, {"status": "P
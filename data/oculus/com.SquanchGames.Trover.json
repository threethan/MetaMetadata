682_434042530837239_5171537024095617024_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYfk8NEq_b0Q7kNvwEQaNsC&_nc_oc=AdpXNvhp32NJkwnXIVjw3oS67NnHq2s8q8Ze-WB23Kez6XKnZLlHBtDWCRmBrQ_lEr0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HvdL33AgVmKrsVo9kFdBdVvM2dLvmVS56TxGo1Vjf6A&oe=6A2D728F"}, {"file_name": "migrated_image.png", "id": "595677177684062", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974685_779886539083599_3305066330289340416_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_6VSOgJNu4Q7kNvwHrspIW&_nc_oc=AdoWKKiOIsXPx5Z1XrUIfULW_jXUNyKI3kpnvJqYpcU9PK4tJMelztngicRIBKo9wZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ryWCZxL8efCfpF-SXBaDgWa_SO4keUkzKL_kX-pbB5g&oe=6A2D6A32"}, {"file_name": "migrated_image.png", "id": "1345265105656767", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367597_783637392112071_4470574021808750592_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gl_HWtjlp0Q7kNvwE_S7DY&_nc_oc=AdoSi3QR1dbj96Avja7JFykb_1MbYPFIYN8abab6dCvH9vSNpnCCt_5POSOnuM0t4gM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pdBvUkAUf8HyNgPHuzjdIvWnBxOaMSlwyVtnCDM_4oA&oe=6A2D57F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trover2560x1440.png", "id": "1073135574246099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974915_1073135577579432_2410241133802782992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6c6Zw3aza20Q7kNvwGwjoGF&_nc_oc=AdpQaWLIYjUJCa8q7S8ACitQ7IXYHvxnCv242yh5VtrQEyZSFP4rXsB-gdL1WZe3q8A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9T_NhWSN8h7kVuGrZwvg-fD1FgJQfmAmlDgaNEpFA9aQ&oe=6A2D6D46"}, "display_name": "Trover Saves the Universe", "keywords": ["trover", "comedy", "squanch", "rick", "morty"], "long_description": "Your dogs have been dognapped by a beaked lunatic who stuffed them into his eye holes and is using their life essence to destroy the universe. You're partnered with Trover, a little purple eye-hole monster who isn\u2019t a huge fan of working or being put in the position of having to save the universe. Only you and Trover can save everything in this bizarre comedy adventure filled with combat, platforming, puzzles, and morally questionable choices \u2013 created by Squanch Games! \n-Control Trover's movements, but not his mouth. He\u2019s got a lot to say about what\u2019s going on in the game. \n-Travel the cosmos to experience a variety of weird alien planets and characters with big personalities. \n-Upgrade Trover AND YOURSELF with new abilities while evading awkward situations. \n-Immerse yourself in weirdness.", "short_description": "Your pups are missing. The cosmos is at stake. Only you and Trover can save everything in this bizarre comedy adventure!"}]}, "developer_name": "Squanch Games, Inc.", "developer_privacy_policy_url": "https://squanchgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Squanch Games, Inc.", "support_website_url": null, "website_url": "http://squanchgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8331953986862755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974502_883033738774059_912251272713732096_n.png?stp=dst-png_s360x360&_nc_cat
25/39036682_434042530837239_5171537024095617024_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZMQIRErG4gQ7kNvwEAAi5_&_nc_oc=AdrmM7-Yng8YrZvJWM8nhcuWfRijYM-xoofPZcNzzM-STNsnvBVPgEPr8tUH3haOsow&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kXTkakzkcU0uT2sgGfhNM0Gm9lrs6rXVLinzmu9j6dQ&oe=6A467F0F"}, {"file_name": "migrated_image.png", "id": "595677177684062", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974685_779886539083599_3305066330289340416_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2r3V7hvZ3NQQ7kNvwEMv02F&_nc_oc=Adok9BQKldr1NbQGvfMgLNV7GqRQ5rdK4ImM1zQl3MczXqyA5Q4UKN5AUWvr_4K08dc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A2k4qW3ISsaJI_B6iyGLcIUVN1vRSQpzsnlvjNs1EJA&oe=6A4676B2"}, {"file_name": "migrated_image.png", "id": "1345265105656767", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75367597_783637392112071_4470574021808750592_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAXf2fIMYckQ7kNvwHu8rj8&_nc_oc=AdoyTaZPjXI9lQp9lEig_jXKdTyujdT9uhQLq-yAwYqQjyVifMuHCyeTszWTBChIGJ8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qSF5urlGX8ijcjfL6jPL5uYP8czNOQUGVoqSU1MOtRw&oe=6A466473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trover2560x1440.png", "id": "1073135574246099", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974915_1073135577579432_2410241133802782992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0QcLgBel6kQ7kNvwHpaWPq&_nc_oc=Adr0lLvLKHzH6N-DTLyGGovzdiIfeO9FbtN-LknXUw-S3O1Kq45B2N_mVmVv98ZUi5U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l7M3Qb3boBVSHwt8zjgPKnNhFX8wMfRb5T0GSfJxOdA&oe=6A4679C6"}, "display_name": "Trover Saves the Universe", "keywords": ["trover", "comedy", "squanch", "rick", "morty"], "long_description": "Your dogs have been dognapped by a beaked lunatic who stuffed them into his eye holes and is using their life essence to destroy the universe. You're partnered with Trover, a little purple eye-hole monster who isn\u2019t a huge fan of working or being put in the position of having to save the universe. Only you and Trover can save everything in this bizarre comedy adventure filled with combat, platforming, puzzles, and morally questionable choices \u2013 created by Squanch Games! \n-Control Trover's movements, but not his mouth. He\u2019s got a lot to say about what\u2019s going on in the game. \n-Travel the cosmos to experience a variety of weird alien planets and characters with big personalities. \n-Upgrade Trover AND YOURSELF with new abilities while evading awkward situations. \n-Immerse yourself in weirdness.", "short_description": "Your pups are missing. The cosmos is at stake. Only you and Trover can save everything in this bizarre comedy adventure!"}]}, "developer_name": "Squanch Games, Inc.", "developer_privacy_policy_url": "https://squanchgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Squanch Games, Inc.", "support_website_url": null, "website_url": "http://squanchgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8331953986862755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974502_883033738774059_912251272713732096_n.png?stp=dst-png_s360x
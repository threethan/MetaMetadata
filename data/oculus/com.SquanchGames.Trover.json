nalities. -Upgrade Trover AND YOURSELF with new abilities while evading awkward situations. -Immerse yourself in weirdness.", "short_description": "From the co-creator of Rick and Morty comes Trover Saves the Universe. Your pups are missing. The cosmos is at stake. Only you and Trover can save everything in this bizarre comedy adventure!"}]}, "developer_name": "Squanch Games, Inc.", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Squanch Games, Inc.", "support_website_url": "https://squanchtendo.atlassian.net/servicedesk/customer/portal/1", "website_url": "http://trover.site/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "604781180589665"}}]}, "scheduled_offers": {"count": 47, "nodes": [{"status": "PUBLISHED", "id": "746397921265027"}, {"status": "PUBLISHED", "id": "768117975831691"}, {"status": "PENDING", "id": "1158330498901427"}, {"status": "PUBLISHED", "id": "1650078322286339"}, {"status": "PUBLISHED", "id": "1011998527354541"}, {"status": "PUBLISHED", "id": "3891077267829516"}, {"status": "PUBLISHED", "id": "877019193924592"}, {"status": "PUBLISHED", "id": "627470728181494"}, {"status": "PENDING", "id": "734199401399870"}, {"status": "PUBLISHED", "id": "624566872309978"}, {"status": "PUBLISHED", "id": "1167498044069122"}, {"status": "P
2_434042530837239_5171537024095617024_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaYDLzLf2_IQ7kNvwHiq1z_&_nc_oc=Ado_OJDJBDcfQg0QsENo1fg64B_Y-NuxjPpfqFunmdFQAWpcDobUaIgiDGML73I6quE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0A9H8YL562MCbJfumSj4SlK1Po6_SQU4oyJnUeO4WtQ&oe=6B03058F"}, {"file_name": "migrated_image.png", "id": "595677177684062", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974685_779886539083599_3305066330289340416_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJvnBsnfnqcQ7kNvwGl54oW&_nc_oc=AdpJazzVypjggrsVyGlAp5_LsvqESXa5NOzdKM1twzMCJTIvpewkGsJ5sM8rkarhZXc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCp3DBW_MGnPUvdJ3MwrsNpqBIeQKzae-_bBFJHX2Vkg&oe=6B033572"}, {"file_name": "migrated_image.png", "id": "1345265105656767", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75367597_783637392112071_4470574021808750592_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iraDjZI7aNwQ7kNvwFRUxcs&_nc_oc=Adr_slG0M2nf0oUOmqLFs8R1MmruIQbD6oNesuH5K_ocUf7_Mg5I1mJPu2-AJVRX4wI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWS796nSwKEiPK1fLro6Ycu1Sj_z3sCZ9icwkNqeYtbQ&oe=6B032333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trover2560x1440.png", "id": "1073135574246099", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974915_1073135577579432_2410241133802782992_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8EAkha5Z3IQ7kNvwEe94l9&_nc_oc=AdoyKce9okXeUC6FHJjWC7n2rEJ_spAROnzWj7Lz8dYJjRnbNBRbkbH7qEPD1lUrQZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1lPxAwx2dEFS9MTFj9Fx1T5hLPIlolkH2lnZTn6UQug&oe=6B033886"}, "display_name": "Trover Saves the Universe", "keywords": ["trover", "comedy", "squanch", "rick", "morty"], "long_description": "Your dogs have been dognapped by a beaked lunatic who stuffed them into his eye holes and is using their life essence to destroy the universe. You're partnered with Trover, a little purple eye-hole monster who isn\u2019t a huge fan of working or being put in the position of having to save the universe. Only you and Trover can save everything in this bizarre comedy adventure filled with combat, platforming, puzzles, and morally questionable choices \u2013 created by Squanch Games! \n-Control Trover's movements, but not his mouth. He\u2019s got a lot to say about what\u2019s going on in the game. \n-Travel the cosmos to experience a variety of weird alien planets and characters with big personalities. \n-Upgrade Trover AND YOURSELF with new abilities while evading awkward situations. \n-Immerse yourself in weirdness.", "short_description": "Your pups are missing. The cosmos is at stake. Only you and Trover can save everything in this bizarre comedy adventure!"}]}, "developer_name": "Squanch Games, Inc.", "developer_privacy_policy_url": "https://squanchgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Squanch Games, Inc.", "support_website_url": null, "website_url": "http://squanchgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8331953986862755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.ocul
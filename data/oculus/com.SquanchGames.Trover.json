zd4k&_nc_oc=Adk8ngHPnhy5Ug_RshS_ZewHRwBLIPpGxpoOGLFDk1YpGScxuljeGqDXVoofGPbkq7A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJhtFNEVzSanemotN3cRhDkUJmlE86oq8QMVP2B-wEdQ&oe=69A6C14F"}, {"file_name": "migrated_image.png", "id": "595677177684062", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974685_779886539083599_3305066330289340416_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7jfBG0PmSMQ7kNvwGQyL-c&_nc_oc=Adn7mtA3NqAoMN-7l8V_UToW3g_V9w_YpmAwjD_xDGivejTTPst-Es5pkjhyMB5B2t8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfslURp2EdlNBBd1CmumEqiVP23Gkmwahjnfc7UOBLSRgA&oe=69A6F132"}, {"file_name": "migrated_image.png", "id": "1345265105656767", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367597_783637392112071_4470574021808750592_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FG2pmXRtSBkQ7kNvwGm8Hwn&_nc_oc=Adkh5tga7oEkhITP3jxmkL6kM_vXASCP1BUxt20u5aFgAesFNGHiIGmQtMLEMK7P9bw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftuwi5niunwgPP00jEtOZs0HWyGonC3IaVMVGfP7yQnbA&oe=69A6DEF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trover2560x1440.png", "id": "1073135574246099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974915_1073135577579432_2410241133802782992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sk-FTO1wRpsQ7kNvwFyLb0Z&_nc_oc=AdnX7N2nVlKHSzSOHR4BZori0sSY_vOJqzTWO0OIj0YXgqu31qoPx0Lk8-HXVnEjf24&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftfN43rCpeAUBPWlxNFQSyDr6K5LmHAuEWY-UYrOubz7g&oe=69A6BC06"}, "display_name": "Trover Saves the Universe", "keywords": ["trover", "comedy", "squanch", "rick", "morty"], "long_description": "Your dogs have been dognapped by a beaked lunatic who stuffed them into his eye holes and is using their life essence to destroy the universe. You're partnered with Trover, a little purple eye-hole monster who isn\u2019t a huge fan of working or being put in the position of having to save the universe. Only you and Trover can save everything in this bizarre comedy adventure filled with combat, platforming, puzzles, and morally questionable choices \u2013 created by Squanch Games! \n-Control Trover's movements, but not his mouth. He\u2019s got a lot to say about what\u2019s going on in the game. \n-Travel the cosmos to experience a variety of weird alien planets and characters with big personalities. \n-Upgrade Trover AND YOURSELF with new abilities while evading awkward situations. \n-Immerse yourself in weirdness.", "short_description": "Your pups are missing. The cosmos is at stake. Only you and Trover can save everything in this bizarre comedy adventure!"}]}, "developer_name": "Squanch Games, Inc.", "developer_privacy_policy_url": "https://squanchgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Squanch Games, Inc.", "support_website_url": null, "website_url": "http://squanchgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8331953986862755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974502_883033738774059_912251272713732096_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_yljpaSEToQ7kNvwFnzz6c&_nc_oc=AdmHFzhakAYBzScOmWkZYiUBrPGoUN1QkLo78mGIUdawHNrt7HB277g9Ky_inTrXEZI&_nc_zt=3&_nc_ht=scontent-
2_434042530837239_5171537024095617024_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-NrUS11Hs4Q7kNvwFko4kK&_nc_oc=AdonT45KVF1_8Gd4ADRMtKrTLPYxA01jgnSTwgR5qD8FF5Js4r_yl_IZ4N7F1VkVABI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9YYXDIALyXQjCzGfeKkJLTDKKoW3jKxTBetLtVCWh3w&oe=6AFB1C8F"}, {"file_name": "migrated_image.png", "id": "595677177684062", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974685_779886539083599_3305066330289340416_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfJL0loK3nIQ7kNvwFGzlvH&_nc_oc=Adr0XjBEqZQvvqam0CTfrADo8qMZRunKObiW0SI0ESstnf_u_dD1gaZsB0i2Iq2YbxA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScg-fC1DL0VqCxni5lMzV4jee8Gu_HjEVUiO9JH199DQ&oe=6AFB4C72"}, {"file_name": "migrated_image.png", "id": "1345265105656767", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75367597_783637392112071_4470574021808750592_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbFyJL4xLCwQ7kNvwHi1i_Q&_nc_oc=Adp-v-U1kDywfhwljcX87Vc88BaNxEEWQe22ziCLpGlsxMrfWWEkWQytDolaIfxAHYc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3xhpbimOPukqUhp5MXSEdJneLWR-WsVtiRZRG1SVNpA&oe=6AFB3A33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trover2560x1440.png", "id": "1073135574246099", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974915_1073135577579432_2410241133802782992_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8LI4d73up4Q7kNvwFf7KTp&_nc_oc=AdpEKGwVQzpUyUdoq5U94huSC0bsjv7LgmDF0s91XL_51PSWNmWp8DuR8P4mrLvWu0M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6APVbNr3-o0kgE4Yn7nX24ic6i6puM2GXVpTsEggkNg&oe=6AFB1746"}, "display_name": "Trover Saves the Universe", "keywords": ["trover", "comedy", "squanch", "rick", "morty"], "long_description": "Your dogs have been dognapped by a beaked lunatic who stuffed them into his eye holes and is using their life essence to destroy the universe. You're partnered with Trover, a little purple eye-hole monster who isn\u2019t a huge fan of working or being put in the position of having to save the universe. Only you and Trover can save everything in this bizarre comedy adventure filled with combat, platforming, puzzles, and morally questionable choices \u2013 created by Squanch Games! \n-Control Trover's movements, but not his mouth. He\u2019s got a lot to say about what\u2019s going on in the game. \n-Travel the cosmos to experience a variety of weird alien planets and characters with big personalities. \n-Upgrade Trover AND YOURSELF with new abilities while evading awkward situations. \n-Immerse yourself in weirdness.", "short_description": "Your pups are missing. The cosmos is at stake. Only you and Trover can save everything in this bizarre comedy adventure!"}]}, "developer_name": "Squanch Games, Inc.", "developer_privacy_policy_url": "https://squanchgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Squanch Games, Inc.", "support_website_url": null, "website_url": "http://squanchgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8331953986862755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.ocul
682_434042530837239_5171537024095617024_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AG6uKxeyLoIQ7kNvwE91jxa&_nc_oc=Adrl60dDmy3b7nuFVsyRLIQUVlO7kYfd2_QM_k_bPtOpwFQyfdy-6hykUiFHDI7G-1s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1BFMO-trHyAXIJ26LPMn-mlqjy15lest4nJ7Eu9zDNGg&oe=69F6138F"}, {"file_name": "migrated_image.png", "id": "595677177684062", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974685_779886539083599_3305066330289340416_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-DtDAx4vkgQ7kNvwHFmLaf&_nc_oc=AdpBr2JEn1H34LilHqSdQfRQNekVrw3w56WsauLL5OyhVD9PVOMne7fx48JtfdxlU0g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-x1Ufa7DdUTjl71pHSBGQ4QKzEW_5AiWbVJ75vloBmw&oe=69F60B32"}, {"file_name": "migrated_image.png", "id": "1345265105656767", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75367597_783637392112071_4470574021808750592_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJ2GPX4Li4gQ7kNvwGJY4UV&_nc_oc=AdqWoMVGc_xEtnA5BUF1xh8zQQ37mu_y1dfwNq4FP7_QL-30a-jRJNudPGIK5dJTWRg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2xY9TkHNtEr8BdcZbD1cjrHcnjpAgik8eLNss18x8q9w&oe=69F5F8F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trover2560x1440.png", "id": "1073135574246099", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974915_1073135577579432_2410241133802782992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdg7oJVyiGIQ7kNvwHGt1M_&_nc_oc=AdpEv-oU1DOLvi_dppkqwJWDPBMwGCL0X9QZAUNQzp8ZkqH13r3o-IVdHUKizqfWdTM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0wFLh7KVyVKFsrG4GZdi7_X80FT-u6CAlMfiWJimVmFQ&oe=69F60E46"}, "display_name": "Trover Saves the Universe", "keywords": ["trover", "comedy", "squanch", "rick", "morty"], "long_description": "Your dogs have been dognapped by a beaked lunatic who stuffed them into his eye holes and is using their life essence to destroy the universe. You're partnered with Trover, a little purple eye-hole monster who isn\u2019t a huge fan of working or being put in the position of having to save the universe. Only you and Trover can save everything in this bizarre comedy adventure filled with combat, platforming, puzzles, and morally questionable choices \u2013 created by Squanch Games! \n-Control Trover's movements, but not his mouth. He\u2019s got a lot to say about what\u2019s going on in the game. \n-Travel the cosmos to experience a variety of weird alien planets and characters with big personalities. \n-Upgrade Trover AND YOURSELF with new abilities while evading awkward situations. \n-Immerse yourself in weirdness.", "short_description": "Your pups are missing. The cosmos is at stake. Only you and Trover can save everything in this bizarre comedy adventure!"}]}, "developer_name": "Squanch Games, Inc.", "developer_privacy_policy_url": "https://squanchgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Squanch Games, Inc.", "support_website_url": null, "website_url": "http://squanchgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8331953986862755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974502_883033738774059_912251272713732096_n.png?stp=dst-png_s360x360&_nc_cat
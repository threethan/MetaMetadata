682_434042530837239_5171537024095617024_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ndksc7gVk4Q7kNvwGK3Gdp&_nc_oc=AdqXp1GOpx6mcxuUQC8tzUgvtKQKv58mQ3YeqLRpf4W9UfN3GfC1u-2s-pUlxhdJ6O8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwyItlSq3veOd1bmWLrjVHROv4TIG7tM4WVkA-4eOIuA&oe=6A6CBA8F"}, {"file_name": "migrated_image.png", "id": "595677177684062", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974685_779886539083599_3305066330289340416_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1dpFZ9ApxYQ7kNvwF9_F3y&_nc_oc=AdodNF39lnOj-KIL67FQLu3yMTySLl4YuEBEvwKOiw-uzXYjEqMzTueW8S8ps64tP20&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBY61_E0JN7eiZU5Mvh3xOW3AzVAnZ709vI-qtp9MidOw&oe=6A6CB232"}, {"file_name": "migrated_image.png", "id": "1345265105656767", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75367597_783637392112071_4470574021808750592_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SS6miFT5k4Q7kNvwHv-V1M&_nc_oc=AdoQA7M_EULGE1E-PALcjxbQ5SGohZX4B67nJff8NlSuvTiAnzmS7hwzG0g5yFTnSe8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9lxz7Dsc7q2VSxSFI4eLsbdu1Tzf5BZiwkWeWuyt-pg&oe=6A6C9FF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trover2560x1440.png", "id": "1073135574246099", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974915_1073135577579432_2410241133802782992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxZjW2Ez1xkQ7kNvwGRROPi&_nc_oc=Ado8iiKYsjDOOV__ieHwuYTas94ZUSYjuPPcRf4WMLrHx1d1oWbHHnG8qF-IbyA2hx0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBH7brDsW16-EuozrzmumExqVOyNCmL7NXxSANdtUfy_g&oe=6A6CB546"}, "display_name": "Trover Saves the Universe", "keywords": ["trover", "comedy", "squanch", "rick", "morty"], "long_description": "Your dogs have been dognapped by a beaked lunatic who stuffed them into his eye holes and is using their life essence to destroy the universe. You're partnered with Trover, a little purple eye-hole monster who isn\u2019t a huge fan of working or being put in the position of having to save the universe. Only you and Trover can save everything in this bizarre comedy adventure filled with combat, platforming, puzzles, and morally questionable choices \u2013 created by Squanch Games! \n-Control Trover's movements, but not his mouth. He\u2019s got a lot to say about what\u2019s going on in the game. \n-Travel the cosmos to experience a variety of weird alien planets and characters with big personalities. \n-Upgrade Trover AND YOURSELF with new abilities while evading awkward situations. \n-Immerse yourself in weirdness.", "short_description": "Your pups are missing. The cosmos is at stake. Only you and Trover can save everything in this bizarre comedy adventure!"}]}, "developer_name": "Squanch Games, Inc.", "developer_privacy_policy_url": "https://squanchgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Squanch Games, Inc.", "support_website_url": null, "website_url": "http://squanchgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8331953986862755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974502_883033738774059_912251272713732096_n.png?stp=dst-png_s360x360&_nc_cat
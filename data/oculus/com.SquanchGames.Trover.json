n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUXzHIGocvsQ7kNvwGC8T3S&_nc_oc=AdlOkU0om0a39A6wP_9bTOcQU_ckj2BTwMIEhIiaHBxi9ABO5whtrcJ-eg4ZUsUF0X8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvFVlgNZGyYPDRY9DO1oxU8XpQUVgopwL_EGN7aNnXX2g&oe=699EF5F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trover Saves the Universe - Quest", "keywords": ["trover", "comedy", "squanch", "rick", "morty"], "long_description": "From the co-creator of Rick and Morty comes Trover Saves the Universe. Your dogs have been dognapped by a beaked lunatic who stuffed them into his eye holes and is using their life essence to destroy the universe. You're partnered with Trover, a little purple eye-hole monster who isn\u2019t a huge fan of working or being put in the position of having to save the universe. Only you and Trover can save everything in this bizarre comedy adventure filled with combat, platforming, puzzles, and morally questionable choices \u2013 created by Justin Roiland! -Control Trover's movements, but not his mouth. He\u2019s got a lot to say about what\u2019s going on in the game. -Travel the cosmos to experience a variety of weird alien planets and characters with big personalities. -Upgrade Trover AND YOURSELF with new abilities while evading awkward situations. -Immerse yourself in weirdness.", "short_description": "From the co-creator of Rick and Morty comes Trover Saves the Universe. Your pups are missing. The cosmos is at stake. Only you and Trover can save everything in this bizarre comedy adventure!"}]}, "developer_name": "Squanch Games, Inc.", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Squanch Games, Inc.", "support_website_url": "https://squanchtendo.atlassian.net/servicedesk/customer/portal/1", "website_url": "http://trover.site/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
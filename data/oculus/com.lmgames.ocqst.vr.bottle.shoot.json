U5TavCPMvONDZaIXKb2Ngs5l3D3Hh7weQWztKjfcAA5nrDF8cyg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uHwvTsK83NgzB0rdL-bgN7A-dGWB5QZz7abuOjpsmjA&oe=69D6619C"}, {"file_name": "2.png", "id": "644954356503152", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75451777_644954363169818_1412561880646958896_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODqqFXkbcRcQ7kNvwEEENL7&_nc_oc=AdomVt65oRKDh33zI42cLpKg_beZQRRMw4-aLnX6s9vsBoIilX66x_wfOqqBiBCfzWA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EATQNPQ95o1w8SfExFHGfKj8dIJDArqUmpLxadAh8Og&oe=69D637F4"}, {"file_name": "5.png", "id": "5333596283390659", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566679_5333596293390658_7141477640950454335_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYQf_-Uvdd0Q7kNvwEyHf1u&_nc_oc=AdqTGw0VWDeb2XkZL7JgubO6zyihRJJk0kFgyznWxWzMvqMn4RQg5tcH7xnibmROcUw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af290MwSUF6mWiFLtQ7J23kyJhkPUUcg3HxHGYWZ3kIrwg&oe=69D633DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "408165814619081", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974824_408165817952414_4309070904335112871_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvA-dr0ZQkEQ7kNvwGb32PT&_nc_oc=AdrrZxVEf2TWYnzaVfK3wbhAWdZn5kmL1pPriqjCuUW7zKBeP6dA25tiAKBfnYne4I4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0scme_2cOrdnUEFaupM91NCly9L7w1Yvk9iXOaF_pz6w&oe=69D663D2"}, "display_name": "VR Bottle Shooter", "keywords": [], "long_description": "Do flawless marksmanship to be victorious in bottle shooter game. \n\nDifferent riffles like grenade launcher, Assault Rifle, Sniper Rifle, Bravo Squad Assault rifle, etc. Have fun and excitement with VR gaming mode. Experience the most unique and Action-packed game in VR. Tremendous game play with different Guns. Experience the shoot bottles in Realistic way. Beautiful 3D graphic Visualization and Addictive gaming Mode. Complete levels and win amazing Gaming points. Easy Controls for Aim and smash the bottles. Enjoy the real sound of glass breaking and guns.\n\nKey Features: \n~Different ranges guns\n~VR Smart gaming view\n~Addictive gameplay\n~3D visualization graphics\n~Many Unique and Complicated levels\n~Real sound of Glass Breaking\n~Real Target Bottle Shooting\n~Easy and smooth controls for shoot the bottle\n\nPlay like professional sport player and complete all tough levels in Energetic way.\n\nShoot and broke the bottles and Show off your Marvelous Marksmanship in real.", "short_description": "Shoot Bottles with different rifle and be a professional VR bottle shooter!\nReal Bottle Shooter game is Next-level shooting game for being master in shooting. Aim and shoot Multiple bottles with guns and win the strenuous game. Cross the difficult levels and enjoy being a bottle shooter VR in reality. Play like Professional shooter and complete all tough levels in Energetic way. Take the experience of being the ultimate shooter in the VR game.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vr-lmgamestudio-pplink/home", "developer_terms_of_service_url": null, "publisher_name": "Frontlink Technology", "support_website_url": null, "website_url": "https://frontlinktechnology.com/contact", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interac
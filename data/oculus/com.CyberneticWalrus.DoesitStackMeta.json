12002_477468201431943_2336277708116321394_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5F3oYjSB8sQ7kNvwG3tYGM&_nc_oc=AdnTca2n1OnvN9WO-VowBWwoX70HCmYd7CZoHAV27fc_bnvvjbmQ8YEg8Y5c-D8AWQo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtSDlO96_IPee--kpgsixdDJ87m_TGK-tE-grNaUzDwg&oe=69B17ABC"}, {"file_name": "AR_Screenshot_05.png", "id": "995095888788717", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75302220_995095892122050_3225244634523290964_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9Q6jTQh9eQQ7kNvwH_GgGk&_nc_oc=Adl3j3lBN-X5-xsd4AVaN2QteH2_26Ic6wlnCzayjx3KtILuT7sXOwJT364joD5aZR8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzprHfrOS8L5C-xc3kg2iHtdsOKMbXG4s1gQE_LNLwQxA&oe=69B14BE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DIS_Keyart_V3_3840_2160 (2).png", "id": "349954004577170", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75299158_349954007910503_1833769832880075911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bN8jqlkj4cQ7kNvwEwe0k8&_nc_oc=AdmbZSDMXLYdF2Ml6Jo-gsQ1z9vC37SrWyVaeHyiXUgi8eplapFxl6v3FEQcF2okZLk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGHg_xTF6Gm6_og6c1LvAbKAQeGsdTCxwQIlb4Pek3xg&oe=69B17CB8"}, "display_name": "Does It Stack?", "keywords": ["puzzle", "stacking", "coop", "partygame", "physics"], "long_description": "Does It Stack? lets players create ridiculous towers by stacking an assortment of items atop one another. \n\n{1457525708209224}\n\n# Create wacky towers\nCan you build a tower of toy cars with a bicycle on top? Can you balance a fish on a bowling ball? Maybe this is the rare occasion where you should put the fork in the toaster? But watch out! If two objects of the same color touch each other, they go BOOM! Be careful, or you might get a heart-a-stack!\n\n{1597905861066084}\n\n# Features \n- 60 levels with 3 challenges each\n- 150 unlockable objects \n- Play in augmented- or virtual reality\n- Stack together in local co-op mode \n- Get creative with your unlocked items and gizmos in the sandbox mode\n- Try to beat your friends' height scores\n- Compete in the daily challenge mode\n- You can use voice chat through Meta's People app\n\n{319138587924564}\n", "short_description": "Get creative in Does It Stack? \u2014 a physics-based puzzle game with an explosive twist where you\u2019ll craft increasingly absurd towers that joyfully defy the laws of physics using a treasure trove of unusual building objects. Play solo, or together in virtual- or augmented reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doesitstack.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Cybernetic Walrus", "support_website_url": null, "website_url": "https://www.cyberneticwalrus.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "7753404538051373"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1346488303351170"}, {"status": "PUBLISHED", "id": "608986725132344"}, {"status": "PUBLISHED", "id": "832008599009928"}, {"status": "PUBLISHED", "id": "8940612229282185"}]}, "baseline_offer": {"id": "1346488303351170"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741859520, "status": "PUBLISHED", "id": "1346488303351170"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "A
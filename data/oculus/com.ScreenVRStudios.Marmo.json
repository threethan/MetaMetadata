1-25/499296890_1364387652134035_2095577881089575399_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynfxWrWnsskQ7kNvwF_RDd-&_nc_oc=AdnyckVxTHvQUtNURaCNKlmngOMfiaj7r38nxan93w9WMjLbGucZMtUWAhCCw-SWl4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0D4vo9-oM-NL6N-rDr9AmT5e0iXPkMZ1y2-yp_yMVjQ&oe=69BFF51E"}, {"file_name": "MarmoShot4.png", "id": "1171505648497656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821150_1171505651830989_7345555884237021519_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAMN5O-GZ0QQ7kNvwEoohhN&_nc_oc=AdmXns6PB7zok6VXxkTQ03aNVZ8hEl6xMNI_2Xd85V7hWiV6wTfofha2USZGFM4YQZ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhlIJtuQv5FDNucIipEoF0DOIQbbDoEvPOw_zLL-5g1A&oe=69BFED5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Marmo", "keywords": ["Marmo", "gorilla", "monkey", "animal", "pvp"], "long_description": "# Marmo\nMarmo is a VR playground built to capture the energetic style of 2023 fan-made experiences. Movement is fully physical with swinging your arms, giving the freedom to explore the game.\n\n# The Shop\n The shop offers a rotating set of cosmetics, including featured items and seasonal options, giving plenty of ways to customize your look.\n\n# The PVP\nFor competitive players, the PvP area delivers fast, moving combat with a selection of unlockable weapons. Each option introduces its own playstyle, encouraging skill, positioning, and quick decision making.\n\n# The Team\nMarmo blends the nostalgic fan-game feel with a modern polish. Developed by ScreenVR and Lucid we try our best to get what the community wants into the game, and collaborate with eh community on ideas and features.", "short_description": "Marmo is a VR playground capturing the spirit of 2023 era fan games. Leap into the forest and climb the surroundings, unwind in forest's clubhouse and hangout with other marmos, grab new  and featured cosmetics in the shop, or face off in PvP with a variety of weapons to unlock. All in Marmo."}]}, "developer_name": "Screen VR Studios", "developer_privacy_policy_url": "https://marmovr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Screen VR Studios", "support_website_url": null, "website_url": "https://marmovr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "25494518620191227"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303746_1519985022665236_8300960358815988315_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8Fj9WXBufUQ7kNvwF_Go9n&_nc_oc=Adl6l2IB9Gt_VmTOQphJTIiiM2JlxqG-Yjz-zjqZLSnTfZTP2HX6Qz-7L--GvbE-LYY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwjz8obgajOuKHNBjTE7ZtbBgCA1bozIim3TMDk65lyxA&oe=69BFD633"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marmo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1766178000, "lastRevision": {"nodes": [{"id": "24881288261514269", "release_type": "SCHEDULED", "administrati
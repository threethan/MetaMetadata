tent-fra5-1.oculuscdn.com/v/t64.5771-25/499296890_1364387652134035_2095577881089575399_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n73sPfaAFoQ7kNvwHuSFBr&_nc_oc=Adq-hOyzGGMnnY3OBl4nSRXJlQ_PX9U1GKiX5Mu2BnWCWG6ivx9BoudvnDkIA1s72MY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dRLMGJaqoK_kJZeUjHmbH2tQzgSMFZyRdm-UGSk6GmA&oe=6A32A79E"}, {"file_name": "MarmoShot4.png", "id": "1171505648497656", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821150_1171505651830989_7345555884237021519_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyBMD7j3MY4Q7kNvwGBHnab&_nc_oc=Adqe_wnhCJvYi6vnV1NsMJVS_Rb_nggQpuBYcgJ_uBgwFDJJwnrjnNA2ShOrCuYFPkk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-78PlKQf-gtzFofzjdjuBjyiyPKpp1Y5j5LpAWSyuy0A&oe=6A329FDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Marmo", "keywords": ["Marmo", "gorilla", "monkey", "animal", "capuchin"], "long_description": "# Marmo\nMarmo is a VR playground built to capture the energetic style of 2023 fan-made experiences. Movement is fully physical with swinging your arms, giving the freedom to explore the game.\n\n# The Shop\n The shop offers a rotating set of cosmetics, including featured items and seasonal options, giving plenty of ways to customize your look.\n\n# The PVP\nFor competitive players, the PvP area delivers fast, moving combat with a selection of unlockable weapons. Each option introduces its own playstyle, encouraging skill, positioning, and quick decision making.\n\n# The Team\nMarmo blends the nostalgic fan-game feel with a modern polish. Developed by ScreenVR and Lucid we try our best to get what the community wants into the game, and collaborate with eh community on ideas and features.", "short_description": "Marmo is a VR playground capturing the spirit of 2023 era fan games. Leap into the forest and climb the surroundings, unwind in forest's clubhouse and hangout with other marmos, grab new  and featured cosmetics in the shop, or face off in PvP with a variety of weapons to unlock. All in Marmo."}]}, "developer_name": "Screen VR Studios", "developer_privacy_policy_url": "https://screenvrstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Screen VR Studios", "support_website_url": null, "website_url": "https://marmovr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26210629761913439"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499303746_1519985022665236_8300960358815988315_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZyoYhuPWS4Q7kNvwFP1Wii&_nc_oc=AdoZ9A1wWKllGy1mqb1lYCplc6TilIdHUL-d_ZRAvVmKFmtkaJjlaIULB-gVz6aa8yw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jTfcvuXN_xYIVYIiI_sLgREY7f52R0sHuQz5m4xFY3w&oe=6A32C0F3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marmo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1766178000, "lastRevision": {"nodes": [{"i
_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZjVs-hO8Z0Q7kNvwEuKmdq&_nc_oc=Adoj8flDZt9hL9UHavrad7MekE9sVMRgfUtI6Uxm_8eZL6UKJSnXUVUTg3kM4tOdcRs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpdQrudfpULMgKs2OGx32B1wSvwf0mj14N1szpOqUFxQ&oe=6B084510"}, {"file_name": "MarmoShot5.png", "id": "1364387648800702", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499296890_1364387652134035_2095577881089575399_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IatdyLUfwKUQ7kNvwEvS6qi&_nc_oc=AdqeuV8C856kNArtMBNax0CVwlqV7vq-z8nSLTD2Ac-xOE-pj0nU4HD1DrUjv28ahjA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPg_NGnXu9V_dFpJcQWOUjl9mOyilG6BwX-zGSm01-zg&oe=6B0872DE"}, {"file_name": "MarmoShot4.png", "id": "1171505648497656", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821150_1171505651830989_7345555884237021519_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d13maBOCN7EQ7kNvwHDtH_2&_nc_oc=Adqo7vbhe7TDB_i7_JcWtrrQsJ5UaydUMiiT6O0V2gSWnsBpygtZOHL48CqryzkWmJ4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsRViP-0Obg1c17vlV0oB1LO_e8rvSQSgXf54SJEFelg&oe=6B086B1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Marmo", "keywords": ["Marmo", "gorilla", "monkey", "animal", "capuchin"], "long_description": "# Marmo\nMarmo is a VR playground built to capture the energetic style of 2023 fan-made experiences. Movement is fully physical with swinging your arms, giving the freedom to explore the game.\n\n# The Shop\n The shop offers a rotating set of cosmetics, including featured items and seasonal options, giving plenty of ways to customize your look.\n\n# The PVP\nFor competitive players, the PvP area delivers fast, moving combat with a selection of unlockable weapons. Each option introduces its own playstyle, encouraging skill, positioning, and quick decision making.\n\n# The Team\nMarmo blends the nostalgic fan-game feel with a modern polish. Developed by ScreenVR and Lucid we try our best to get what the community wants into the game, and collaborate with eh community on ideas and features.", "short_description": "Marmo is a VR playground capturing the spirit of 2023 era fan games. Leap into the forest and climb the surroundings, unwind in forest's clubhouse and hangout with other marmos, grab new  and featured cosmetics in the shop, or face off in PvP with a variety of weapons to unlock. All in Marmo."}]}, "developer_name": "Screen VR Studios", "developer_privacy_policy_url": "https://screenvrstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Screen VR Studios", "support_website_url": null, "website_url": "https://marmovr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26210629761913439"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303746_1519985022665236_8300960358815988315_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqGSdaNdsuIQ7kNvwGN31pe&_nc_oc=AdouEbHp4DRSxli5hsa8hcDVoyAKyiJJEmNzgYPvn85GtKLBpK0XetvpBMglX1HWImQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjjB6FcMEqOxhdQdPd8sTONnKK2q9PhaIDA-_lskDa-A&oe=6B0853F3"}, "
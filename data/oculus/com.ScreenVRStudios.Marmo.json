_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agFhoJRMzq0Q7kNvwHucEH8&_nc_oc=Adp19Z5g6-nZn2UddsPJTpERX8jnWFoPu7auhKup1ido3HNJd7mdgnQFtSuuzHL_DGo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPqZT7oWrXt3G9xxhBNtaFHx9cZ3kuqT3fWxli--gSig&oe=6AFF0A90"}, {"file_name": "MarmoShot5.png", "id": "1364387648800702", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499296890_1364387652134035_2095577881089575399_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fB4Idx-DSDgQ7kNvwH_I5PG&_nc_oc=Adrg5F4bhwZdkIe-Hzp7eHS2VFW85W-fih8KBdJ047vWFb_8m1CTBH9r8r4T4qRmq68&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVZ1M6Kd1_OvoTCRPtiE0bY0kgjct6zI1qWe5uBvKiFg&oe=6AFF001E"}, {"file_name": "MarmoShot4.png", "id": "1171505648497656", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821150_1171505651830989_7345555884237021519_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xd02M7PCF3kQ7kNvwFL9YhE&_nc_oc=AdrFS2DgmvvEcUfEYVGsa04OUpocYWkU8SMYdj9VgED36bxc2StJ_92S5vom3pe28cs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZcFeqWBZuz-ZMxwHtR5ZOfj4xZaEdeqGdBY9FRUwnPA&oe=6AFF309B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Marmo", "keywords": ["Marmo", "gorilla", "monkey", "animal", "capuchin"], "long_description": "# Marmo\nMarmo is a VR playground built to capture the energetic style of 2023 fan-made experiences. Movement is fully physical with swinging your arms, giving the freedom to explore the game.\n\n# The Shop\n The shop offers a rotating set of cosmetics, including featured items and seasonal options, giving plenty of ways to customize your look.\n\n# The PVP\nFor competitive players, the PvP area delivers fast, moving combat with a selection of unlockable weapons. Each option introduces its own playstyle, encouraging skill, positioning, and quick decision making.\n\n# The Team\nMarmo blends the nostalgic fan-game feel with a modern polish. Developed by ScreenVR and Lucid we try our best to get what the community wants into the game, and collaborate with eh community on ideas and features.", "short_description": "Marmo is a VR playground capturing the spirit of 2023 era fan games. Leap into the forest and climb the surroundings, unwind in forest's clubhouse and hangout with other marmos, grab new  and featured cosmetics in the shop, or face off in PvP with a variety of weapons to unlock. All in Marmo."}]}, "developer_name": "Screen VR Studios", "developer_privacy_policy_url": "https://screenvrstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Screen VR Studios", "support_website_url": null, "website_url": "https://marmovr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26210629761913439"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499303746_1519985022665236_8300960358815988315_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsccxRI4zB4Q7kNvwFFgucA&_nc_oc=AdqSvzkcAlSU8OP7a92_R_NvFS16U8J_V0g5sg29BeaLrkKZfpAMpSqOTneqJt5pmFo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaL9BGqc5EhjFZvzI0XQtCc-r-q8IijMej24bzqO__ZQ&oe=6AFF1973"}, "
vwEc3Yk7&_nc_oc=Adp70yNr2S8ed8En2Wmm5dc74CxDUU3aIkfCPy_WHatKKbtn9VrhA_TI7HiN_Kpv8oo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzyKfATi39aRSQ5gXY55WWrSUa6c_99u_O9yKkGNssPiA&oe=69D0F7A1"}, {"file_name": "MarmoShot3.png", "id": "1362499295411642", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499305050_1362499298744975_1098818897618720484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4k_xo3QlCcQ7kNvwEWVAm_&_nc_oc=AdraEEkbR3l9x80Mw3QCEvpOSpBbSmepIOsNqw1ti-XmF3_KZnlZoZTmYoQQ6VfeSAc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afynfsi1X_kbRZ1X3sGB1P4mfRmdu31ypj0H215x90UiTA&oe=69D12310"}, {"file_name": "MarmoShot5.png", "id": "1364387648800702", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296890_1364387652134035_2095577881089575399_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYRzqSpmexUQ7kNvwHpJn9o&_nc_oc=Ado0p-5ISFNAawF4QiWfp3ecqO7IOtIS61bmHrliTdNCXPmHRbj-ytHAArhpNUp87wM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwnugc_lY_Fs6EUMF0dSQ-cwOpJ3dqrAR8GA8e0nbilsA&oe=69D1189E"}, {"file_name": "MarmoShot4.png", "id": "1171505648497656", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821150_1171505651830989_7345555884237021519_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHpelQFgLo8Q7kNvwFPUlGe&_nc_oc=AdpAlUd5EAVadziqialwGVNbZBVHqVfE_IPt899EN-jBQh4qA0YA9FihrM4xvM2Sm5s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-JqNn4TjZCOydvdc2RDUw5OJMUokSLBwMdplVRRO06Q&oe=69D110DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Marmo", "keywords": ["Marmo", "gorilla", "monkey", "animal", "pvp"], "long_description": "# Marmo\nMarmo is a VR playground built to capture the energetic style of 2023 fan-made experiences. Movement is fully physical with swinging your arms, giving the freedom to explore the game.\n\n# The Shop\n The shop offers a rotating set of cosmetics, including featured items and seasonal options, giving plenty of ways to customize your look.\n\n# The PVP\nFor competitive players, the PvP area delivers fast, moving combat with a selection of unlockable weapons. Each option introduces its own playstyle, encouraging skill, positioning, and quick decision making.\n\n# The Team\nMarmo blends the nostalgic fan-game feel with a modern polish. Developed by ScreenVR and Lucid we try our best to get what the community wants into the game, and collaborate with eh community on ideas and features.", "short_description": "Marmo is a VR playground capturing the spirit of 2023 era fan games. Leap into the forest and climb the surroundings, unwind in forest's clubhouse and hangout with other marmos, grab new  and featured cosmetics in the shop, or face off in PvP with a variety of weapons to unlock. All in Marmo."}]}, "developer_name": "Screen VR Studios", "developer_privacy_policy_url": "https://www.marmovr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Screen VR Studios", "support_website_url": null, "website_url": "https://www.marmovr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24881288224847606"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "825799840063604"}]}, "baseline_offer": {"id": "825799840063604"}, "is_approved": true, "firstOf
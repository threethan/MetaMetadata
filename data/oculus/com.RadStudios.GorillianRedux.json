0_7115341223198603438_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FOmRu0M62IQ7kNvwE-6-mi&_nc_oc=Adq1W5uuPT1YBTHgTyApPQbdJlIARXBRfYWk8XJa7dr6A-j2xJrRT7SMQBF_7xotpXo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0XhnSft_QBgCKV8tPmWMpLHjeQMn_3s-UwgEqec0kTQ&oe=6B09A5DC"}, {"file_name": "GorillianRemake_Custom..._31.12.2025_17-11-08.png", "id": "851175974491516", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491819356_851175977824849_1706879857182246028_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNsyNLvyqB4Q7kNvwH1y5jh&_nc_oc=AdoFICMHMCMcCz7SWLgzdBg_KM2bQNlWmtS_9OkE-8D-WdRZtVpAwWFA3lpBIR5kRc0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOSBSRhmIwY6Bkf8rR4dMP8Ly8zSnGxz21UfUMQeI2bg&oe=6B09BA1A"}, {"file_name": "GorillianRemake_Custom..._31.12.2025_17-10-59.png", "id": "877134605265238", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491822550_877134611931904_7254143348348636517_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDykLXdVlXQQ7kNvwF7I6JJ&_nc_oc=Ado4mpx7WdxBVOpU30oEWF4WJJG8CDldQhlRfsnQ60koHj2PfTCrx0I2uNVV_du0qMQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwmb9lgmKADbodVjsWziTnGYytr2r0E3V41dlEYVgzIg&oe=6B09A32D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillian Redux", "keywords": [], "long_description": "This is a Gorilla Tag\u2013inspired multiplayer game that features fast-paced movement and exciting game modes such as Tag and Infection. Players can join public rooms to compete with others online or create private rooms to play with friends. The game includes smooth turning mechanics, allowing for precise movement and control, as well as plenty of opportunities for hiding and sneaking, adding strategy and tension to each match. With a focus on fun, mobility, and social gameplay, the experience captures the spirit of Gorilla Tag while offering its own unique twists.", "short_description": "This is a Gorilla Tag inspired game with Tag and Infection, with public rooms private rooms, turning, and hiding."}]}, "developer_name": "Plava", "developer_privacy_policy_url": "https://docs.google.com/document/d/1ylF2zDlcVovFmBP2cMD1Y_N0Z-ymu3lTfzkoUHIchWk/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1zHgUHatu5UKTC1QKPIz92N3Buv-bHLLEyztw-j6ASL0/edit?usp=sharing", "publisher_name": "Plava", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1zHgUHatu5UKTC1QKPIz92N3Buv-bHLLEyztw-j6ASL0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25569282812728260"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823905_1230310378992849_642080291490301912_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cStQIbVdEZYQ7kNvwHM3dpb&_nc_oc=Adrs3At4pSTbYYFoXH4hLLjjG-nZlZ2J_hdZEz8OnHyabAAsVOhlyspf84raXytsgZU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxD3IpY4LN75yvonhVWujEMDW_wKtchm5tK89S1x0Vsg&oe=6B09A88A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gorillian Redux", "platform": "ANDROID_6DOF", "context_category": {"context_category":
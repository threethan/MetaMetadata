0_7115341223198603438_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVj9W25N0P4Q7kNvwFuUw_U&_nc_oc=AdqmAmaTsvnI_aSfd_hZYxcSbogFioS6aF_YLBf16UiKCte86PSHt31ymK3xXt9Pb-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxk1PxFOfhs2KRggsX5vsT41Mz6KkrPeemu0F-6l465g&oe=6AFDC85C"}, {"file_name": "GorillianRemake_Custom..._31.12.2025_17-11-08.png", "id": "851175974491516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_851175977824849_1706879857182246028_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQqEi0aJxgUQ7kNvwFFI_RB&_nc_oc=AdpW8DT9AgzNCmfw2VK_01opbub90bT-03uU6Ic_EwIfMQPM7gH-fCN9Zbqh30X4Z9s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrN8LRqRAnuaVLUC2_YAaMM9oYDx-cOE97bLSNRjQj7Q&oe=6AFDDC9A"}, {"file_name": "GorillianRemake_Custom..._31.12.2025_17-10-59.png", "id": "877134605265238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822550_877134611931904_7254143348348636517_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k09YENvuB44Q7kNvwHFyrQQ&_nc_oc=AdpXAl-tWoDsf24lGJTRGK9XN4zPwyZthH8V1ndsH4gnYsKzXWWXkYLHu3267fOYAT0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuODs8CCxeHn7mDCuIieM9MC5aY6Ra0w3QHpph9UHUdA&oe=6AFDC5AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillian Redux", "keywords": [], "long_description": "This is a Gorilla Tag\u2013inspired multiplayer game that features fast-paced movement and exciting game modes such as Tag and Infection. Players can join public rooms to compete with others online or create private rooms to play with friends. The game includes smooth turning mechanics, allowing for precise movement and control, as well as plenty of opportunities for hiding and sneaking, adding strategy and tension to each match. With a focus on fun, mobility, and social gameplay, the experience captures the spirit of Gorilla Tag while offering its own unique twists.", "short_description": "This is a Gorilla Tag inspired game with Tag and Infection, with public rooms private rooms, turning, and hiding."}]}, "developer_name": "Plava", "developer_privacy_policy_url": "https://docs.google.com/document/d/1ylF2zDlcVovFmBP2cMD1Y_N0Z-ymu3lTfzkoUHIchWk/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1zHgUHatu5UKTC1QKPIz92N3Buv-bHLLEyztw-j6ASL0/edit?usp=sharing", "publisher_name": "Plava", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1zHgUHatu5UKTC1QKPIz92N3Buv-bHLLEyztw-j6ASL0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25569282812728260"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_1230310378992849_642080291490301912_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ST1To22ytTgQ7kNvwGrOwuR&_nc_oc=AdrWWkTgZnlhTqyMgKnMmrD8dCQteIKbBCJzHtSjUZVD1RAXppg4rJZx04Ya1-PMmqw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXGcvMPHiUoCg8AQH7bmnvOdb6tDzY0PQ4McbKeQ0A_A&oe=6AFDCB0A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gorillian Redux", "platform": "ANDROID_6DOF", "context_category": {"context_category":
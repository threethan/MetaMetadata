9mMIEIZSgDFpoWlKY4kWY1T_fJpDi7hGSmYw&oe=6A146CDE"}, {"file_name": "Screenshot_Donning_Removing_PPE_New_05.png", "id": "1694420741339036", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569433_1694420744672369_6156785009120117213_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rk4LmvC2t2cQ7kNvwEn2jP6&_nc_oc=AdqhjwdJMZMPNIqo2AmisNAi21QQgqhHjPplWSzsf7pMXMnk6dFTHX0EL1ToGVwgUqI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6979Epw15YbKTjH9P8SOJuqanLJXKw8cXmBQwLHPkacA&oe=6A145C16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_Donning_Removing_PPE_New_04.png", "id": "1308213543550202", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974676_1308213546883535_6287949704997897297_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o182ubgMbXYQ7kNvwE9RgJi&_nc_oc=Ado24YoCSCYzHf2Oz9i9cxsLP9w14n1dabDuRlJTW7ZpSk8xPZ3XXOMabpICslfY0zI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dQJxOAWh13hUO6giBF9pC-KymxSIbyanAXzK3KPws9A&oe=6A144FB3"}, "display_name": "Donning and Removing PPE Simulator", "keywords": ["CNA", "nurse", "nursing", "PPE", "Healthcare"], "long_description": "This VR simulation teaches the critical skill of donning and removing personal protective equipment (PPE) gowns and gloves, focusing on maintaining safety and infection control standards.\n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience. \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\nBy the end of this tutorial, participants will be able to: \n- Remember the steps and protocols for donning and removing PPE gown and gloves. \n- Understand the importance of proper PPE usage in preventing the spread of infection. \n- Apply the correct techniques to don and remove PPE gown and gloves safely. \n- Analyze potential contamination risks and take appropriate actions to mitigate them. \n- Evaluate their own technique to ensure adherence to safety standards. \n- Create a safe and hygienic environment through proper PPE handling and disposal. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Master the technique of donning and removing PPE gown and gloves to ensure safety and infection control with AI guidance and multilingual support for better learning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "fr", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8742164785863024"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveCh
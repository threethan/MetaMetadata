m/v/t64.5771-25/75322602_593665128920598_3332741183428305229_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU-K4gSnldEQ7kNvwFx-07e&_nc_oc=Adp2gNo4B6pJ32eIvk0ctf1rg9PuPVns-7ebCZk4EXvlmXQQfKTYdoINJGyvby_x8cM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqxOny0i4Z1oWqkh7XiVLbzoN7dHa9n9upYAPZvq9kMg&oe=6A999024"}, {"file_name": "Screen_Shot_01.png", "id": "367235285574040", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_367235288907373_7715562111438165148_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZh7SWkIAU0Q7kNvwF32i7w&_nc_oc=Adp0UYuZOZnTrqVb5BJNmOF-4TqqV3XevxWvTQ-3hI6uNSt9EIFFGjyLD-TJmMuroEg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJcX8Rjb4jXMtybrlKky4eY-cZayukYYse3_xO8xz3CQ&oe=6A999243"}, {"file_name": "Screen_Shot_03.png", "id": "1276336616104304", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001717_1276336619437637_240862550888732066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXZjVFAE-TgQ7kNvwElUh5C&_nc_oc=Adpj97Dy5qYUQy0mW3400En984Z5Pv-kLo3iUyuYNdAJGPhjYjPGQBcTl8_nuX_xTOQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIB0nIJn2iDRPY4ROMGLPEdS_ynBL5laDg55fHt5de2GQ&oe=6A99A2DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Thumbnail.png", "id": "588051386257626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974677_588051389590959_1476709482072288035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q46_jY9HoBEQ7kNvwETvOik&_nc_oc=Adqex_qutzbcZcLPTtMKR1ruw7_TC_-ejBFpvTe1Ox6_O5UMzFw3TJAcDglUE1Dq_AY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpTpzcV9aF6vwI2-J9dqka7vL2oO1fci2IHmBbhS_HTg&oe=6A99708C"}, "display_name": "Playin Pickleball", "keywords": [], "long_description": "Playin Pickleball is the first, authentic reproduction of Pickleball in Virtual Reality! Physics, sounds and mechanics have been carefully mapped from actual Pickleball game play. Even the scoring and rules are based on the USA Pickleball Association\u2019s Official Rulebook.\n\nBut don\u2019t worry if you have never played Pickleball before. Playin Pickleball will teach you the basics and help keep score while making sure you are always serving from the correct side of the court! Have fun learning the basics of Pickleball. Train, practice and play single and doubles matches against AI of varying difficulty. \n\nComing soon: multiplayer support \u2013 with casual and ranked matches, more beautiful environments, and more paddles to choose from! Enjoy the game and help us make this the best game ever by joining our \u201cPlayin Pickleball\u201d Discord community. ", "short_description": "Playin Pickleball is the first, authentic reproduction of Pickleball in Virtual Reality! Physics, sounds and mechanics have been carefully mapped from actual Pickleball game play. Even the scoring and rules are based on the USA Pickleball Association\u2019s Official Rulebook.\n\nCome and have fun learning the basics of Pickleball! Train, practice and play single and doubles matches against AI of varying difficulty. Multiplayer, new environments and more paddles are coming soon!"}]}, "developer_name": "Playin Games", "developer_privacy_policy_url": "https://playinpickleball.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Playin Games", "support_website_url": null, "website_url": "https://playinpickleball.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "su
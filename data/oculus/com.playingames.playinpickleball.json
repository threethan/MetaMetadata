AX5QcQ7kNvwH_TqPq&_nc_oc=AdrM57ulcVIgg7nFQYlPeOjKyABQHSKpbTyD1GxSVBpcfH8qotV_ufPoXz1h4xwwoug&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKFI9u-2dnhIZGUW2G8DDFfWQ-OcZy0sEPpxfuJytN-Q&oe=6A8EEC01"}, {"file_name": "ss 2.png", "id": "1941191043093558", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499618444_1941191046426891_3367750310189412760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZdwCqrs4FgQ7kNvwGA8U9r&_nc_oc=Ado11fGrQozwDQimpw5E45gBdZ1hdKctl8yt6Aom40T0rBsY6_KcaOL5kKLJ8DYHIDM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhWQsIXU_v96zz5CIQmCXWmln2FhBm1K8V0TkQlKEFxA&oe=6A8EC52F"}, {"file_name": "ss 4.png", "id": "4302404786705519", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499304764_4302404790038852_1341910413165296217_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8nJhJFS2BsQ7kNvwFiCsZm&_nc_oc=AdoIVsP0526Nn1hHXfMlfUTVVSSCyzlTTcXFDNij16GMQ-nilvbnR6wcSwFwjtjH3T4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMBD780AL6D11DmPp4_RaalaTCHSS8kxHggt1Gh0Pj3A&oe=6A8ED4A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Pickleball One - Meta Store - Landscape - Characters (2560 x 1440 px)_N1_Final.png", "id": "838740259149441", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499303116_838740262482774_311897524435125955_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFlQFbsUp5UQ7kNvwGPqGur&_nc_oc=AdrC3I4mATlKnYuTPVNjWzdkr-7VB4ZPF4bTz3BjKKdQ3l3TDBlpgbjxO9C_GCGWJ3A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqtZ3iZJDEDu9UhAjH6wGK8dweSdrmtkkk587rkWAu-w&oe=6A8EE477"}, "display_name": "Pickleball One", "keywords": ["Racket", "Tennis", "multiplayer", "fitness", "sport"], "long_description": "# THE #1 PICKLEBALL GAME\nPickleball One brings the world\u2019s fastest-growing sport into VR with immersive courts, realistic physics, and exciting multiplayer action. Featuring **Open Play** and official **JOOLA** paddles!\n\n{1254126993551418}\n\nFeatures :\n\n\u25cf \ud83c\udfae Single & Multiplayer ( Singles, Doubles & Skinny Singles)\n\n\u25cf \ud83c\udf0d **Open Play** \u2013 Jump into continuous, rotating matches where winners stay on and challengers keep coming.\n\n\u25cf \ud83c\udfc6 **Play & Earn XP Points** \u2013 Play matches, earn XP, and unlock new rewards \ud83c\udf81\n{1305113264864051}\n\n\n\u25cf \ud83d\udcaa **Training & Fitness** \u2013 Sharpen your skills with Training drills. Build stamina and burn calories\ud83d\udd25with Fitness drills.\n\n\u25cf \ud83e\udd7d **Mixed Reality Mode** \u2013 \ud83c\udfe0 Transform your real space into a pickleball court.\n{1515443043327583}\nJoin our community and become a pickleball legend with Pickleball One.\n", "short_description": "Step into the world of pickleball like never before with Pickleball One, the ultimate VR sports and fitness game! Train solo with wall drills, sharpen your skills in practice sessions, or dive into Open Play - a brand-new, PBO-exclusive feature for nonstop matches and rotating competition. Earn XP, unlock achievements, and level up while staying active. Whether you\u2019re learning the game or chasing competition, Pickleball One brings fun, fitness, and community together in one immersive platform."}]}, "developer_name": "Playin Games", "developer_privacy_policy_url": "https://pickleballone.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Playin Games", "support_website_url": null, "website_url": "https://pickleballone.app/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_mem
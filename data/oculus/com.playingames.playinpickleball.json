m/v/t64.5771-25/75322602_593665128920598_3332741183428305229_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BujUkV1R3mAQ7kNvwGOPajS&_nc_oc=AdrpRzOWKaueefvu7IIGslRD_f6nC0XSpBKH4Ih7hfGFVEElIuuuUi9rDrGQFA9KFo4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvgBKS68C-85Lr4nGw6aDADhe9OwD8yhA_kVBqrDBYEA&oe=6A7B0564"}, {"file_name": "Screen_Shot_01.png", "id": "367235285574040", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982708_367235288907373_7715562111438165148_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTcn70AnpQMQ7kNvwHWZpBK&_nc_oc=Adrh0aGq9n-RqcNcx3FewH7cU9Bc6D7TkHT9Sne5Rbj8dDPaCxB7Ae9PDbOzfW4TIkY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjP3MbGBPuXk5c3d82ONlQ-R6I8Vk2YW0syGte9IHjdg&oe=6A7B0783"}, {"file_name": "Screen_Shot_03.png", "id": "1276336616104304", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001717_1276336619437637_240862550888732066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37MCVAc48IQQ7kNvwHmJIIy&_nc_oc=Adp-hphPbChycpSd6ZRrHToa5QGZpNWKr8jcxxlmjHp8p71DxKd655K9ZJXm5xaaUyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU5a40znFi9JFhcPrHyXlZh7syf5SapKIy47H4mNxiPw&oe=6A7B181E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Thumbnail.png", "id": "588051386257626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974677_588051389590959_1476709482072288035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KZfN3cNpT8Q7kNvwFlf2Zf&_nc_oc=Ado2Plo-bXal8QtS_Dh0yiAUn7ffexKjRmE5oTH9BsL0z8FhI4blvQwT0b7fAYs9gK4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg15g-dzb_-AcdV5CoYA9QmUeT31yJs1hiA3Le8Wgp9w&oe=6A7B1E0C"}, "display_name": "Playin Pickleball", "keywords": [], "long_description": "Playin Pickleball is the first, authentic reproduction of Pickleball in Virtual Reality! Physics, sounds and mechanics have been carefully mapped from actual Pickleball game play. Even the scoring and rules are based on the USA Pickleball Association\u2019s Official Rulebook.\n\nBut don\u2019t worry if you have never played Pickleball before. Playin Pickleball will teach you the basics and help keep score while making sure you are always serving from the correct side of the court! Have fun learning the basics of Pickleball. Train, practice and play single and doubles matches against AI of varying difficulty. \n\nComing soon: multiplayer support \u2013 with casual and ranked matches, more beautiful environments, and more paddles to choose from! Enjoy the game and help us make this the best game ever by joining our \u201cPlayin Pickleball\u201d Discord community. ", "short_description": "Playin Pickleball is the first, authentic reproduction of Pickleball in Virtual Reality! Physics, sounds and mechanics have been carefully mapped from actual Pickleball game play. Even the scoring and rules are based on the USA Pickleball Association\u2019s Official Rulebook.\n\nCome and have fun learning the basics of Pickleball! Train, practice and play single and doubles matches against AI of varying difficulty. Multiplayer, new environments and more paddles are coming soon!"}]}, "developer_name": "Playin Games", "developer_privacy_policy_url": "https://playinpickleball.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Playin Games", "support_website_url": null, "website_url": "https://playinpickleball.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "su
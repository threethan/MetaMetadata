dn.com&_nc_ss=7f20f&oh=00_AQTuIS_eDk-BIm4hvD-3RXCZPfHKDOa9tULVn8zI2q2F9A&oe=6B04665D"}, {"file_name": "ss 1.png", "id": "845173984863211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293732_845173988196544_2584211190142421647_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUO9oMuwtwEQ7kNvwHu1u38&_nc_oc=AdphC5D85CwbDx3om1tLC1cxCcvnKiNvtfpdJ7xsv07Pwc7rClaKow8Xtf8k-y7yxUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAwmOSlyngZdqglEmUDQzXXlVOibxPVYYr0GbcjrwmWg&oe=6B0479C1"}, {"file_name": "ss 2.png", "id": "1941191043093558", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_1941191046426891_3367750310189412760_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_F30KZ6P10Q7kNvwGDx8aT&_nc_oc=Adr2K2WZgJyjOOTAxIro63cnP8b6IF00aiMN0GpS_axclftkgEb318giaAqHaJSJILM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLGjgJ76JOF9BqQDmZ4itHzfVGawuxncJyKq9P6CG0CQ&oe=6B048B2F"}, {"file_name": "ss 4.png", "id": "4302404786705519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304764_4302404790038852_1341910413165296217_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgEY-MgnjeIQ7kNvwHPf5zf&_nc_oc=AdqphGx_sfRlzZGlI_-N_71mcfimrApMfulwRzrYqUf0q2lS8NOaK2g2VE4D525jQW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIhRLs3syJ_bg5Pbbk6KhW_aRPrinEO7tl6HZqx5rHhA&oe=6B046266"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Pickleball One - Meta Store - Landscape - Characters (2560 x 1440 px)_N1_Final.png", "id": "838740259149441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303116_838740262482774_311897524435125955_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzGRLo1f3QYQ7kNvwF2ahsm&_nc_oc=Adq1ffW8plMM4vZLvT-hlwLeOp98VoCkCZ6cEgUbltrViLmPagpgHNpV96bPJmO9vMI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr_WVZzVtBQ6u4Lh1_YwuKA1DUKzZPIshOWyP3tyd5NQ&oe=6B047237"}, "display_name": "Pickleball One", "keywords": ["Racket", "Tennis", "multiplayer", "fitness", "sport"], "long_description": "# THE #1 PICKLEBALL GAME\nPickleball One brings the world\u2019s fastest-growing sport into VR with immersive courts, realistic physics, and exciting multiplayer action. Featuring **Open Play** and official **JOOLA** paddles!\n\n{1254126993551418}\n\nFeatures :\n\n\u25cf \ud83c\udfae Single & Multiplayer ( Singles, Doubles & Skinny Singles)\n\n\u25cf \ud83c\udf0d **Open Play** \u2013 Jump into continuous, rotating matches where winners stay on and challengers keep coming.\n\n\u25cf \ud83c\udfc6 **Play & Earn XP Points** \u2013 Play matches, earn XP, and unlock new rewards \ud83c\udf81\n{1305113264864051}\n\n\n\u25cf \ud83d\udcaa **Training & Fitness** \u2013 Sharpen your skills with Training drills. Build stamina and burn calories\ud83d\udd25with Fitness drills.\n\n\u25cf \ud83e\udd7d **Mixed Reality Mode** \u2013 \ud83c\udfe0 Transform your real space into a pickleball court.\n{1515443043327583}\nJoin our community and become a pickleball legend with Pickleball One.\n", "short_description": "Step into the world of pickleball like never before with Pickleball One, the ultimate VR sports and fitness game! Train solo with wall drills, sharpen your skills in practice sessions, or dive into Open Play - a brand-new, PBO-exclusive feature for nonstop matches and rotating competition. Earn XP, unlock achievements, and level up while staying active. Whether you\u2019re learning the game or chasing competition, Pickleball One brings fun, fitness, and community together in one immersive platform."}]}, "developer_name": "Playin Games", "developer_privacy_policy_url": "https://pickleballone.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Playin Games", "support_website_url": null, "website_url": "https://pickleballone.app/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOS
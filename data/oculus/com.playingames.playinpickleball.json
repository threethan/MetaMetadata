m/v/t64.5771-25/75322602_593665128920598_3332741183428305229_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z98spLWljzUQ7kNvwHdHzam&_nc_oc=Adq9WlhSWaokb0jASppUI1nNEq11VoKh5AB4qoDEBAY3WfGYcQlhskOMKvfpV60d4UQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtdkxUu3ckW7lPkC-aJgcqjAfLh4FMdE8qjzqNnHJQnw&oe=6A689064"}, {"file_name": "Screen_Shot_01.png", "id": "367235285574040", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982708_367235288907373_7715562111438165148_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNsa0i83N9oQ7kNvwGoP0e9&_nc_oc=AdoW2Zet5g8iEocJAc1_lDRzHGpLB_pB17aUeoEI4qkZDEE-TkW8D5Hj1ktyDq82Xdk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv_5R98aerTanB7aXPfbggU_dh-vf0rQUDV1JIFqNznw&oe=6A689283"}, {"file_name": "Screen_Shot_03.png", "id": "1276336616104304", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001717_1276336619437637_240862550888732066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ehs71dZZ1IQ7kNvwF_RGDl&_nc_oc=AdrMGWeRbFE43I-FmBjXFYXXyWolPCkGdbfvFaKbkN_yZwZiKahmgZq7f54W88yCkJk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-efSj0JwPgQzHS7vKTt_R-KZzgCpJoEmPbFPxLKjW2g&oe=6A68A31E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Thumbnail.png", "id": "588051386257626", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974677_588051389590959_1476709482072288035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTYQU5QNnQ8Q7kNvwESPPgt&_nc_oc=Adp9mmx_BA6vky_H_wCamZAw2nz2svIsvS71GshXTioarXpt0fgRgW0Rbb0xGjhyeUs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLPNCu_ux-ZlsiTpNjS55MyMphikX6GuykJ8cnNybOHA&oe=6A68A90C"}, "display_name": "Playin Pickleball", "keywords": [], "long_description": "Playin Pickleball is the first, authentic reproduction of Pickleball in Virtual Reality! Physics, sounds and mechanics have been carefully mapped from actual Pickleball game play. Even the scoring and rules are based on the USA Pickleball Association\u2019s Official Rulebook.\n\nBut don\u2019t worry if you have never played Pickleball before. Playin Pickleball will teach you the basics and help keep score while making sure you are always serving from the correct side of the court! Have fun learning the basics of Pickleball. Train, practice and play single and doubles matches against AI of varying difficulty. \n\nComing soon: multiplayer support \u2013 with casual and ranked matches, more beautiful environments, and more paddles to choose from! Enjoy the game and help us make this the best game ever by joining our \u201cPlayin Pickleball\u201d Discord community. ", "short_description": "Playin Pickleball is the first, authentic reproduction of Pickleball in Virtual Reality! Physics, sounds and mechanics have been carefully mapped from actual Pickleball game play. Even the scoring and rules are based on the USA Pickleball Association\u2019s Official Rulebook.\n\nCome and have fun learning the basics of Pickleball! Train, practice and play single and doubles matches against AI of varying difficulty. Multiplayer, new environments and more paddles are coming soon!"}]}, "developer_name": "Playin Games", "developer_privacy_policy_url": "https://playinpickleball.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Playin Games", "support_website_url": null, "website_url": "https://playinpickleball.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "su
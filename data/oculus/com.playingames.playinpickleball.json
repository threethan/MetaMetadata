dn.com&_nc_ss=7f30f&oh=00_AQRDc3UrSg6QLZV0HD3_wloMF6L9I3mLgyLgBwiHJ_Fs0Q&oe=6B0B361D"}, {"file_name": "ss 1.png", "id": "845173984863211", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499293732_845173988196544_2584211190142421647_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-sbKxLVYpoQ7kNvwHodshY&_nc_oc=AdqC1gZYzssUZin_cFrkgVoBq5MN1-Gj7ox7V1-WQRC9zAMagJwxkt9d2PVabMo2J40&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTAyx_ObTXP5dpipBFcmZ3-1mcnYQ-JyMncYInJLZOTmQ&oe=6B0B1141"}, {"file_name": "ss 2.png", "id": "1941191043093558", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618444_1941191046426891_3367750310189412760_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCmwo3qo_kgQ7kNvwHcgF6x&_nc_oc=AdqT-anqLh7QhV7TDnwfAoM5SFNxaFrsDI5HhnTCXcvzoBEGhIvhRFV4k_Vpy4kNXVA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTUzLsasJggouJcf8OyIUIRZ00snsNtkBcw3iOuO6l_XA&oe=6B0B22AF"}, {"file_name": "ss 4.png", "id": "4302404786705519", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304764_4302404790038852_1341910413165296217_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kW-ePXUdpUQ7kNvwHNlYFF&_nc_oc=Adq5xA-BbfwkwYOY3Z-3ub3-qmKNzR0C_Bai0vVyWniT9Ptd3PHDYgi9q965hq4hcG8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRuQN6wi2mOihlU6jLB7UlrhN7lEL1ZcLnKEBipdZBUmw&oe=6B0B3226"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Pickleball One - Meta Store - Landscape - Characters (2560 x 1440 px)_N1_Final.png", "id": "838740259149441", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303116_838740262482774_311897524435125955_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMTQehUQOsAQ7kNvwGs9yDt&_nc_oc=Adq8hEUs7DIsKcJ2LKZVec7Xh4OEr58eTyhxvuZowi_Tx_nOu44D_aIKyB_WIPG0fDI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBmNSwrBRbq9mhSbCHDHyfneS2jj7hKGxNqJdt6w5ukA&oe=6B0B41F7"}, "display_name": "Pickleball One", "keywords": ["Racket", "Tennis", "multiplayer", "fitness", "sport"], "long_description": "# THE #1 PICKLEBALL GAME\nPickleball One brings the world\u2019s fastest-growing sport into VR with immersive courts, realistic physics, and exciting multiplayer action. Featuring **Open Play** and official **JOOLA** paddles!\n\n{1254126993551418}\n\nFeatures :\n\n\u25cf \ud83c\udfae Single & Multiplayer ( Singles, Doubles & Skinny Singles)\n\n\u25cf \ud83c\udf0d **Open Play** \u2013 Jump into continuous, rotating matches where winners stay on and challengers keep coming.\n\n\u25cf \ud83c\udfc6 **Play & Earn XP Points** \u2013 Play matches, earn XP, and unlock new rewards \ud83c\udf81\n{1305113264864051}\n\n\n\u25cf \ud83d\udcaa **Training & Fitness** \u2013 Sharpen your skills with Training drills. Build stamina and burn calories\ud83d\udd25with Fitness drills.\n\n\u25cf \ud83e\udd7d **Mixed Reality Mode** \u2013 \ud83c\udfe0 Transform your real space into a pickleball court.\n{1515443043327583}\nJoin our community and become a pickleball legend with Pickleball One.\n", "short_description": "Step into the world of pickleball like never before with Pickleball One, the ultimate VR sports and fitness game! Train solo with wall drills, sharpen your skills in practice sessions, or dive into Open Play - a brand-new, PBO-exclusive feature for nonstop matches and rotating competition. Earn XP, unlock achievements, and level up while staying active. Whether you\u2019re learning the game or chasing competition, Pickleball One brings fun, fitness, and community together in one immersive platform."}]}, "developer_name": "Playin Games", "developer_privacy_policy_url": "https://pickleballone.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Playin Games", "support_website_url": null, "website_url": "https://pickleballone.app/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOS
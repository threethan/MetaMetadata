dn.com&_nc_ss=7f30f&oh=00_AQQshaN3gurPzMLoshkWdAwWDAmskKRMED7J1pKb1YxvJw&oe=6B0DA0DD"}, {"file_name": "ss 1.png", "id": "845173984863211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499293732_845173988196544_2584211190142421647_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmwloJYMNRcQ7kNvwEj3jsQ&_nc_oc=Adqs4dkexDrJJLPh3tNxUvBy_C-rIJ4Q48-iXPUio7HkBLHwYQ4ioGi1YS0PKi6_dXA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSLJIR-CgEGNUUdTHpE4NNiYoImOmLqYX0YmL3AUS6UEA&oe=6B0DB441"}, {"file_name": "ss 2.png", "id": "1941191043093558", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_1941191046426891_3367750310189412760_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGByNN3wdMQQ7kNvwESn_rb&_nc_oc=AdqeeThe6wteQB9CwZRJ1dgP4pt1bqjHeE2ZyDB19DvzGA9kjiICkPpzQKesbau48jk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTXGV013o5DU_UUfVNxCf4v7Fc29pYJo90ceFyWdT_leQ&oe=6B0DC5AF"}, {"file_name": "ss 4.png", "id": "4302404786705519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304764_4302404790038852_1341910413165296217_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_elGosNB18Q7kNvwE4WkYr&_nc_oc=Adq-JFdl9VsK9JgWJoWAOIydtqeAVBQHsKNB-TTXD6P4EQuk3mJjl10lyBTrWLbdBQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRtZOe4-qfqykmYYd-eAoxzCEKsHYXb4F6_VW9DfnNzLg&oe=6B0D9CE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Pickleball One - Meta Store - Landscape - Characters (2560 x 1440 px)_N1_Final.png", "id": "838740259149441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303116_838740262482774_311897524435125955_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMTQehUQOsAQ7kNvwGDCRBa&_nc_oc=AdrJbBaW-iG3Qqm4uZ-GRXmiAIdgDgkUrn5wW6bXGu8TkGpeSJKJv_ySeON2UE3kDyY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCtfuawwF3VWHb6HaBEBasTCIRDG9lGuuk5vuWa-mkpg&oe=6B0DACB7"}, "display_name": "Pickleball One", "keywords": ["Racket", "Tennis", "multiplayer", "fitness", "sport"], "long_description": "# THE #1 PICKLEBALL GAME\nPickleball One brings the world\u2019s fastest-growing sport into VR with immersive courts, realistic physics, and exciting multiplayer action. Featuring **Open Play** and official **JOOLA** paddles!\n\n{1254126993551418}\n\nFeatures :\n\n\u25cf \ud83c\udfae Single & Multiplayer ( Singles, Doubles & Skinny Singles)\n\n\u25cf \ud83c\udf0d **Open Play** \u2013 Jump into continuous, rotating matches where winners stay on and challengers keep coming.\n\n\u25cf \ud83c\udfc6 **Play & Earn XP Points** \u2013 Play matches, earn XP, and unlock new rewards \ud83c\udf81\n{1305113264864051}\n\n\n\u25cf \ud83d\udcaa **Training & Fitness** \u2013 Sharpen your skills with Training drills. Build stamina and burn calories\ud83d\udd25with Fitness drills.\n\n\u25cf \ud83e\udd7d **Mixed Reality Mode** \u2013 \ud83c\udfe0 Transform your real space into a pickleball court.\n{1515443043327583}\nJoin our community and become a pickleball legend with Pickleball One.\n", "short_description": "Step into the world of pickleball like never before with Pickleball One, the ultimate VR sports and fitness game! Train solo with wall drills, sharpen your skills in practice sessions, or dive into Open Play - a brand-new, PBO-exclusive feature for nonstop matches and rotating competition. Earn XP, unlock achievements, and level up while staying active. Whether you\u2019re learning the game or chasing competition, Pickleball One brings fun, fitness, and community together in one immersive platform."}]}, "developer_name": "Playin Games", "developer_privacy_policy_url": "https://pickleballone.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Playin Games", "support_website_url": null, "website_url": "https://pickleballone.app/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOS
mPmuI_K48PEjZ2Ts7qzK9U2LkMpPwFUWpGqxSaa60BHzg6U4n4mnxFS_yddNLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVh4k9wL3cXOvQ4ZenfAXw1BTDRIwATP7DyPfrKs74H9A&oe=6B1051E1"}, {"file_name": "08_journey_cell_ribosome.png", "id": "1109138915295114", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604370996_1109138918628447_6329973912160030773_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=To6Q0A3XiwwQ7kNvwGMojZH&_nc_oc=AdrZZ3pRF266iZDlbydu64aHd4lAr-Xz1bzmiIFGpJGY-zEEB3IGPE5PHBN9qW69lZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWNamD4R5hF7m0rZcI_tZiRZftNm6eO708i27ip2MWTwg&oe=6B106571"}, {"file_name": "07_body_store_oxygen_delivery.png", "id": "1830710234729081", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312257_1830710238062414_5036618421825438299_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48mrQbx_Q0YQ7kNvwGmcmd3&_nc_oc=Adpp0gZUSnoWVGrqwGoFP4NxRcWJheevjdPm7yiWbHADf8ccvmd-EmGGtEGyd7grFK4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXb98GH9JUIQcrHgyzZA9A607Y7QZhpLRuOi1-czS8oVw&oe=6B106156"}, {"file_name": "05_journey_breath_alveolus.png", "id": "815563424985089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604385997_815563428318422_5168615044331532883_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1X2Yo_AFIVMQ7kNvwGhXUQc&_nc_oc=AdrVNBgAUzxCSspySYOThVLpdzkt637HnWe4imBUt5t3KDDlQwvy4IieaGIhFVaMg_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX_yGdWaKUN6RzHEq_BcUbgxvST7XqH2v96-6vWpzWtPA&oe=6B105043"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1164030132825620", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604382710_1164030136158953_7379638464274324001_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibnpZDFG_RIQ7kNvwGao59_&_nc_oc=AdoWdFZ1u2s95mDbKw80318UOVmHyhwyMxSiat7S0mqaMA4fF0yggD4z4DfBj_5Yy_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZePb5OxsE_I-W3FwqWgmKxFuvlkxoeMa3DJamzWtgUQ&oe=6B103D86"}, "display_name": "BodyWise", "keywords": [], "long_description": "REAL SIZES, REAL SPEEDS\nYou imagine that a pod has shrunk you. Only the pod is imaginary. A red blood cell is about 7.5 micrometres across, and on its own it looks yellow, not red. Blood moves at its real speed, and a label always says when time is slowed down or sped up. Another label says what you see: a real image, a model made from real measurements or a science-based picture.\n\n14 JOURNEYS\nThe heartbeat, a red cell's trip, breathing, the gut, nerves, immunity, sight, hearing, bones and muscles, the kidney, a cut that heals, inside a cell, keeping healthy and growing up. Each takes up to about 8 minutes and ends with a check question and a challenge, like Valve Timer.\n\nEXPLORE\nSteer the pod through a capillary bed, slowed down 100 to 1,000 times, or visit the chambers of a heart.\n\nREAL DATA\nThe heart is made from real scan data. Hear a real heart sound recording and see one real heartbeat on the ECG. Real micrographs and protein structures too.\n\nREAD AT YOUR LEVEL\nFour reading depths, from Quick Look to Expert. A computer-generated British voice narrates, with subtitles. Every fact names its source.\n\nFOR FAMILIES\nUp to six explorers, pictures only, no names. Break reminders. A grown-up can hide Growing Up. An adult should supervise children's play. BodyWise teaches how the body works. It does not give medical advice. No ads, no chat, no accounts, no in-app purchases and no personal data collected. Plays offline. Credits are on our credits page.", "short_description": "Ride a tiny imaginary pod through the real human body. Drift past red blood cells at their real size, watch a heart valve shut and see how we hear. 14 narrated journeys, each with a short challenge, at four reading depths from Quick Look to Expert. The dashboard always tells you when time is slowed down or sped up. Every fact names its source. For ages 10 and up. No ads, no chat, no accounts, no in-app purchases and no personal data collected."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dhl84.github.io/bodywise/privacy.html", "developer_terms_of_service_url": "https://dhl84.github.io/bodywise/terms.html", "publisher_name": "David Lee", "support_website_url": "https://dhl84.github.io/bodywise/support.html", "website_url": "https://dhl84.github.io/bodywise/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1422814867572436"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1190842346599141"}, {"status": "PUBLISHED", "id": "1444021501020919"}]}, "baseline_offer": {"id": "1444021501020919"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797278400, "status": "PUBLISHED", "id": "1190842346599141"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1477352615451994", "version": "1.0.0"}, "id": "1143921167988346", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1422814864239103", "is_concept": false, "late
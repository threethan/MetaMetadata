78_8372875212585167586_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ya63V4lAU84Q7kNvwEZHvNJ&_nc_oc=Ado6A5bGUclGzFNlMY6QNkeRI9E3piJT2v1SLxAV95Lj1sNhm351wU-0QlG8ets_vec&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WBZ5Z6WAMTfyMkPhsC7DjCAOD-foSS5-bevkDpSMIZA&oe=6A4295FF"}, {"file_name": "Untitl345345ed.png", "id": "903595221996624", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507883434_903595225329957_4877101317003176413_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lg94lw-l7-cQ7kNvwEbKBcz&_nc_oc=Adr4X9JEilZlg-tLXgvHnuqHZWSjOBxa0V4NgfrZteg1HRkAEUTHVOCeuz2otUbiXNc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W_2e-1ivcNTTmdqol9a7RHCC6xJ1IOHne9YL1czQPTQ&oe=6A427C7D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Tagging", "keywords": ["Gorilla", "Monkey", "Taggers"], "long_description": "Opium Tagging drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opium Tagging is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes.\n"}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1KVLa-ZS5wK14xCQ
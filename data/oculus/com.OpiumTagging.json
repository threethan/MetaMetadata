nc_ohc=N3c0j9Lmv3kQ7kNvwG6g_Ag&_nc_oc=AdpLqTEkrmkPj4waBOfdue-SECY-GUsXroLNpCOZ4riwO1RqS9IQ5wUzqyEzcvPS5XY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2FSsw3560dHO8Zird-UM6-yRdYTJL5lgFRUL1DfeHtlw&oe=69F1F23F"}, {"file_name": "Untitl345345ed.png", "id": "903595221996624", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/507883434_903595225329957_4877101317003176413_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-NdSVdFUEQQ7kNvwE_WRz3&_nc_oc=AdobKqTJR_tv-fiGpDEkQIMuWf1QVhfBqiXnMfFb68uvsaneF5eOWFikGPJmtP6Q3RI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1YDvkXmWy8hkoambwJF51AuOPqq1Mei1lCpTqvduls6Q&oe=69F210FD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Tagging", "keywords": ["Gorilla", "Monkey", "Taggers"], "long_description": "Opium Tagging drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opium Tagging is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes.\n"}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1KVLa-ZS5wK14xCQ6mU61eYMOgpZA2W_cRolFWXwJNR4/edit?usp=sharing", "developer_terms_
itl345345ed.png", "id": "853710400750845", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820578_853710404084178_8372875212585167586_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpZvZGgwJFcQ7kNvwEs-uWR&_nc_oc=AdrNMaLyRsWHYsh6TyK_n9kAth856hQLxJxhHVElxSZAMLWEj1RDOONefJf-C2kTgQQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MuSsBqNIFP9YR2fUX3eTGiN9LgJv0i9b7JCpXtH_jIQ&oe=6A2C2C7F"}, {"file_name": "Untitl345345ed.png", "id": "903595221996624", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/507883434_903595225329957_4877101317003176413_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvxx_s8yqcQQ7kNvwFsY46F&_nc_oc=Adq8mYhP-mUjWszHHhVUjunlrCn0--NCuIH9paDz0xHlWFajs2GQ4Q_av-PjAkHgUDY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fjxvfNPcQN5Hm2rToCuww6pqZRqrGlQZGb9fTdzLrqw&oe=6A2C12FD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Tagging", "keywords": ["Gorilla", "Monkey", "Taggers"], "long_description": "Opium Tagging drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opium Tagging is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes.
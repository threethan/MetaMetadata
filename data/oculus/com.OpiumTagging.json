itl345345ed.png", "id": "853710400750845", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820578_853710404084178_8372875212585167586_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJtMkDw2wgoQ7kNvwEqcayv&_nc_oc=Adou1AYIqv63Vj5hv0ttLktJ-ekgLssHrmvRvqsm97kXZazEoSrvSnqQLaNen7kpsxA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dmdEmJXKZWTmPT7cdWWKp-aZlkEXc_qLjsJM-Vy7BBA&oe=69DCDA3F"}, {"file_name": "Untitl345345ed.png", "id": "903595221996624", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507883434_903595225329957_4877101317003176413_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWuwU45Un3oQ7kNvwEQ5wJ4&_nc_oc=AdpfohdqEir0qiFKNFEu3vy_TPlaopApoRZVl1LrPgocfik8dEUePupTt4Tk3bz-GYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BcMdxOgAdh-0IuLHe05yfGcxC4HIB939vjLOhuz1uTw&oe=69DCF8FD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Tagging", "keywords": ["Gorilla", "Monkey", "Taggers"], "long_description": "Opium Tagging drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opium Tagging is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes.
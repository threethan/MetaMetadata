pIfD3n3ICpv_w&oe=69A6BD49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VREW_Coverart2560.png", "id": "1303450920190041", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031339_1303450923523374_6539000794271637909_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAs_IdSDS_AQ7kNvwFUP4B7&_nc_oc=Adma_1feeVd-q9riNWO6RLoCpoL36gqWBYaKGcmbSCtqMt3n7w4vQFY3Y_os0Ie7v9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afso72mWpsl2LPpTfNKDJXhW-jMtDyVNxk9JgUlDWCZc-Q&oe=69A6DD93"}, "display_name": "VREW Employer Feedback Simulation DEMO", "keywords": [], "long_description": "This is a demo version of feedback simulation. The full version features many scenarios like positive/negative feedback, good performance, sexual harassment and much more. \nWe are also eager to tailor you scenarios with our HR professionals. If you want to get access to full version please send us a message via email contact@virtual-dawn.com  \nWe also offer user control and other statistics for corporate users. \n\nWe do our best to keep as much educational content free as possible. To support us you can follow Virtual Dawn in LinkedIn, stay up to date with our crowd funding projects, and purchase our upcoming video games. \nFor more info contact@virtual-dawn.com", "short_description": "Demo-version of full simulation featuring \"sexual harassment feedback\" scenario. With this free version you can get a glimpse of possibilities with professional level feedback simulation.  \nTrain for difficult situations you might encounter in your management career, or even outside of it. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vreduworld.com/assets/docs/Virtual_Dawn_Privacy_Policy_24052021.docx.pdf", "developer_terms_of_service_url": "https://vreduworld.com/assets/docs/Virtual_Dawn_EULA_24052021.docx.pdf", "publisher_name": "Virtual Dawn", "support_website_url": "https://virtual-dawn.com/contact.html", "website_url": "https://vreduworld.com/", "categ
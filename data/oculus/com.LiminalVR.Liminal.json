?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELDnzVtWlLIQ7kNvwE7m8KL&_nc_oc=AdndxDMwgy0qGItSZFeWDgyekoHNf-r7qSXUfZZFsMooUUmzueevp60DgQpGLThK380&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLnoqy67Yb1hbFWsBpHRIwbXpGVzSdnrgTW2CNTvNiEQ&oe=69B80345"}, {"file_name": "Cozy Cabin.png", "id": "6347211302067285", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984440_6347211305400618_1426166590482501018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hr9nPHIbvjgQ7kNvwGBhBTh&_nc_oc=AdmhDfUInMV_dT_2zYazHDcg9nGyttruCrGtx4R4yW3qnH_GTj_uYqXPkmpqWHiDPhQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiUQBgMKiHSJPUHbvhEVeBTRt5UDFc31z4Ua0Rv_bKlg&oe=69B7E69D"}, {"file_name": "Screenshot_03.png", "id": "925950811477697", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196225_925950814811030_4585030413770382015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXlgFAY8nOMQ7kNvwFTJLv3&_nc_oc=AdlWCnj3Y1lwRiWiK0OF0mZNg3I1gLJZT2Rb5fNXXCfd81y3YWTaJ8W_SlW9WfPFIWM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfziiO2lGwVfVKL8Lt5B3SmX3D2646j9fLPA9Dw5OWAdow&oe=69B7E5B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - 2560x1440.png", "id": "214806744523842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035449_214806747857175_8303135038801097332_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnvwPy94QB4Q7kNvwF79Eji&_nc_oc=AdlEukFGmfeOkrqX4BTKAnCRFmEpqy5rR9ERJ3oUTLoc3K_SBBEV9Pk8JqXIoy1yinI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzYsnyjEu1ny1PxOTx4M0MbDWYMhqaX5rGkDRN2vLSMYg&oe=69B80196"}, "display_name": "LIMINAL: Relax. Unwind. Engage. Explore.", "keywords": ["entertainment", "relax", "calm", "meditation", "fun"], "long_description": "**EXPLORE LIMINAL: 140+ Experiences to WOW you and Transform your Mood.**\n\nGet Liminal now and try it out for FREE!\n\nSix categories to explore. Over 800,000 in app five-star ratings!\n\nMake sure you try **Samsara** in the Awe Arena\n{1040915533978887}\n\nReduce anxiety, meditate, breathe or grab a pillow to lie down and sleep. Try hypnosis to distract you from pain and reduce stress. \n{1208055313831116}\n\nPlay exciting casual games and other interactive content. Liminal is much more than a mindfulness app:\n{828649595813485}\n\n**Experience Awe. Find Relief. Enhance your Focus.**\n\nLiminal is a great way to chill out and have some fun!\n\nSubscribe for unlimited access. Or enjoy a weekly rotation of FREE experiences. \n\n- \"Incredible, Beautiful, and Jaw Dropping\u201d\n- \u201cAmazing and relaxing!\u201d\n- \u201cMakes the oculus worth it\u201d\n\nDesigned with neuroscientists and psychologists and a community of partners. Earn credits in the Lab to save your favorites. \n\nTake your first steps and try **Cyberpunch, Flux, Boundless** and more!\n\nThere is always plenty to try with Liminal!", "short_description": "135+ experiences to WOW you and transform your mood. Try our extensive catalog for FREE!\n\n- Make sure you try **Samsara** - our Number 1 Awe experience!\n\nSix categories to explore. Over 800,000 in app five-star ratings!\n\nExperience Awe. Find Relief. Enhance your Focus.\n\nLiminal is a great way to chill out and have some fun!\n\nSubscribe to Premium for unlimited access. Or enjoy a weekly rotation of free experiences. \n\nDesigned with neuroscientists and psychologists and development partners."}]}, "developer_name": "Liminal VR", "developer_privacy_policy_url": "https://liminalvr.com/privacy-statement/", "developer_terms_of_service_url": "https://liminalvr.com/terms-conditions/", "publisher_name": "Liminal VR", "support_website_url": null, "website_url": "https://liminalvr.com/liminal-platform/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}, {"id": "1063584910766706"}], "external_
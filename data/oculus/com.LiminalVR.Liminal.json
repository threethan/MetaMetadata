31594_5086928594702215_4403993108538159853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiKe2iA7oSQQ7kNvwEHlm2A&_nc_oc=AdpPhyJ9qUTsCkzx_FcaosZBwcrzHfWyZBA0vwkXJEi14nSe7XePeaE5w_qni2agN3U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCgQM-eR57x4qApPUpOZ48QE8ufqo3EhMcMcswz-3tRA&oe=6A86FEC5"}, {"file_name": "Cozy Cabin.png", "id": "6347211302067285", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984440_6347211305400618_1426166590482501018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKzsU2xMESUQ7kNvwF41Dv-&_nc_oc=AdpwT7IqFLzewywMKv3Kx16t-mTD4aYI_Or-SND_-LuHuXzTZgUM5U5XpUJmOsMBqS0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkiNRATtihqec5aZvvm2wDu24WPFdXAv_xiPm8NagGaw&oe=6A86E21D"}, {"file_name": "Screenshot_03.png", "id": "925950811477697", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75196225_925950814811030_4585030413770382015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaJR3JlrH7sQ7kNvwGgog3-&_nc_oc=AdpbVR7Bso6pjXkv-lWpgVwWqoBtlS39HcJengMdyIMDOPM2q5AYWHmTc2ZnsyWfHTQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsvX_vG8kdCIj7x1CIEAhakLMpHS7fZNd3SsU9WfQ1_w&oe=6A86E137"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - 2560x1440.png", "id": "214806744523842", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035449_214806747857175_8303135038801097332_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PI93vtORHW4Q7kNvwFLrGcH&_nc_oc=AdqA_f6dKOexVwiUNYH9AfQe6J-yg71kIgb1MV33Pz539Iqw5CmVvykCMSz_qY_geWw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy-ac6DIoikLUTvRve6_ji1OUnWWHufQSZ58ofHZGBpA&oe=6A86FD16"}, "display_name": "LIMINAL: Relax. Unwind. Engage. Explore.", "keywords": ["entertainment", "relax", "calm", "meditation", "fun"], "long_description": "**EXPLORE LIMINAL: 145+ Experiences to WOW you and Transform your Mood.**\n\nGet Liminal now and try it out for FREE!\n\nSix categories to explore. Over 1 Million in app five-star ratings!\n\nMake sure you try **Samsara** in the Awe Arena\n{1040915533978887}\n\nReduce anxiety, meditate, breathe or grab a pillow to lie down and sleep. Try hypnosis to distract you from pain and reduce stress. \n{1208055313831116}\n\nPlay exciting casual games and other interactive content. Liminal is much more than a mindfulness app:\n{828649595813485}\n\n**Experience Awe. Find Relief. Enhance your Focus.**\n\nLiminal is a great way to chill out and have some fun!\n\nSubscribe for unlimited access. Or enjoy a weekly rotation of FREE experiences. \n\n- \"Incredible, Beautiful, and Jaw Dropping\u201d\n- \u201cAmazing and relaxing!\u201d\n- \u201cMakes the oculus worth it\u201d\n\nDesigned with neuroscientists and psychologists and a community of partners. Earn credits in the Lab to save your favorites. \n\nTake your first steps and try **Cyberpunch, Flux, Boundless** and more!\n\nThere is always plenty to try with Liminal!", "short_description": "145+ experiences to WOW you and transform your mood. Try our extensive catalog for FREE!\n\n- Make sure you try **Samsara** - our Number 1 Awe experience!\n\nSix categories to explore. Over 1 Million in app five-star ratings!\n\nExperience Awe. Find Relief. Enhance your Focus.\n\nLiminal is a great way to chill out and have some fun!\n\nSubscribe to Premium for unlimited access. Or enjoy a weekly rotation of free experiences. \n\nDesigned with neuroscientists and psychologists and development partners."}]}, "developer_name": "Liminal VR", "developer_privacy_policy_url": "https://liminalvr.com/privacy-statement/", "developer_terms_of_service_url": "https://liminalvr.com/terms-conditions/", "publisher_name": "Liminal VR", "support_website_url": null, "website_url": "https://liminalvr.com/liminal-platform/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}
?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ADB0g7zN6IQ7kNvwGduNwu&_nc_oc=AdrPCdI6zf9LyOxQrmviqP5UufyPuMBYnV3_li8kOmuWN099BsDisUA5Ynrv6irPepo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyysBvbW6ihTrjiFXOGMT7ZuioUmXkj3U9XlGkd3eFf-A&oe=69C13DC5"}, {"file_name": "Cozy Cabin.png", "id": "6347211302067285", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984440_6347211305400618_1426166590482501018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIu463uXlJsQ7kNvwHFZpvV&_nc_oc=AdrLIOGQ2OaNPF8JgknoAKkqQqR7WrPbjwKDfpa0bEzhybB3Y9NOjNyizABwqDK_8s8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfycBuiDXTyN2Cn24tOw3v7kiOmdN8boJm5v0fV2ay1SEg&oe=69C1211D"}, {"file_name": "Screenshot_03.png", "id": "925950811477697", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75196225_925950814811030_4585030413770382015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLxc8u-w09kQ7kNvwFDy82y&_nc_oc=AdpYYbIJF16Qbv6_eoT6KMGKdUDGvARKqoFJX5FllU1D8-UEqk1PRgVBFytklz8tLYY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwUv3hGBeKozzcgqisVPgFnDU8ZIAjo9iQ8GvLvyLmpzw&oe=69C12037"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - 2560x1440.png", "id": "214806744523842", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035449_214806747857175_8303135038801097332_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gGObur_DsUQ7kNvwFPaOPX&_nc_oc=Ado5Ydbh3G_YIBh5M-k2ERC9vfUB7xedm7I_NASCKuQ3JegWGbQGFRokMtvKErcOeiU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyrAe7UrT5AziJQFF_dcc7fjP6JrtknvMp6mXTdevIrkw&oe=69C13C16"}, "display_name": "LIMINAL: Relax. Unwind. Engage. Explore.", "keywords": ["entertainment", "relax", "calm", "meditation", "fun"], "long_description": "**EXPLORE LIMINAL: 140+ Experiences to WOW you and Transform your Mood.**\n\nGet Liminal now and try it out for FREE!\n\nSix categories to explore. Over 800,000 in app five-star ratings!\n\nMake sure you try **Samsara** in the Awe Arena\n{1040915533978887}\n\nReduce anxiety, meditate, breathe or grab a pillow to lie down and sleep. Try hypnosis to distract you from pain and reduce stress. \n{1208055313831116}\n\nPlay exciting casual games and other interactive content. Liminal is much more than a mindfulness app:\n{828649595813485}\n\n**Experience Awe. Find Relief. Enhance your Focus.**\n\nLiminal is a great way to chill out and have some fun!\n\nSubscribe for unlimited access. Or enjoy a weekly rotation of FREE experiences. \n\n- \"Incredible, Beautiful, and Jaw Dropping\u201d\n- \u201cAmazing and relaxing!\u201d\n- \u201cMakes the oculus worth it\u201d\n\nDesigned with neuroscientists and psychologists and a community of partners. Earn credits in the Lab to save your favorites. \n\nTake your first steps and try **Cyberpunch, Flux, Boundless** and more!\n\nThere is always plenty to try with Liminal!", "short_description": "135+ experiences to WOW you and transform your mood. Try our extensive catalog for FREE!\n\n- Make sure you try **Samsara** - our Number 1 Awe experience!\n\nSix categories to explore. Over 800,000 in app five-star ratings!\n\nExperience Awe. Find Relief. Enhance your Focus.\n\nLiminal is a great way to chill out and have some fun!\n\nSubscribe to Premium for unlimited access. Or enjoy a weekly rotation of free experiences. \n\nDesigned with neuroscientists and psychologists and development partners."}]}, "developer_name": "Liminal VR", "developer_privacy_policy_url": "https://liminalvr.com/privacy-statement/", "developer_terms_of_service_url": "https://liminalvr.com/terms-conditions/", "publisher_name": "Liminal VR", "support_website_url": null, "website_url": "https://liminalvr.com/liminal-platform/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}, {"id": "1063584910766706"}], "external_
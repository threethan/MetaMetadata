211305400618_1426166590482501018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sOOIJq2h6QQ7kNvwGyHQAJ&_nc_oc=Adq-ODBzRIs5onglkqFnglUdyOGVJiWXte7zm11W-zwwTDfpEexMpEWgFRvajtweenQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmHAUXsCYTMfA9h8QyoBf3vzmI7rW2eJvWBjqaPIZ6kw&oe=6AEC9DDD"}, {"file_name": "Screenshot_03.png", "id": "925950811477697", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75196225_925950814811030_4585030413770382015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCqTnCY-CEgQ7kNvwFt7JQh&_nc_oc=Ado2fa5kfGJKYnuQl0Nfz8y9hgEeABK2UDX8m0H5RcT21LZAoH-NIEFvJawDUwBfons&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFhaJsJ_7PIDLERn4G2voT0JLBCYZS302lRup5JR6Ipw&oe=6AEC9CF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - Home 2560x1440 - FEAR.png", "id": "978988061298543", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623551_978988064631876_9173006316961834963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42F06sX8iWsQ7kNvwE9eSe0&_nc_oc=AdoNfvtSlPn-iL1HuVFSvwk2gd8fxpZauy84AAULQebuPiRq_1X0XCXX-KlKtAxqp2U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOibpNtSVpHk5Cao0cw8MKg_9Q5FwoAjCbW_th6Ytmaw&oe=6AECB3E9"}, "display_name": "LIMINAL: Relax. Unwind. Engage. Explore.", "keywords": ["entertainment", "relax", "calm", "meditation", "fun"], "long_description": "**EXPLORE LIMINAL: 155+ Experiences to WOW you and Transform your Mood.**\n\nGet Liminal now and try it out for FREE!\n\nSeven categories to explore. Over 1 Million in app five-star ratings!\n\n**NEW: The Fear Arena is open. Safe scares, big feelings and a lot of fun.**\n{1607277817804674}\n\nMake sure you try **Samsara** in the Awe Arena\n{1040915533978887}\n\nReduce anxiety, meditate, breathe or grab a pillow to lie down and sleep. Try hypnosis to distract you from pain and reduce stress. \n{1208055313831116}\n\nPlay exciting casual games and other interactive content. Liminal is much more than a mindfulness app:\n{828649595813485}\n\n**Experience Awe. Find Relief. Enhance your Focus. Face your Fears.**\n\nLiminal is a great way to chill out and have some fun!\n\nSubscribe for unlimited access. Or enjoy a weekly rotation of FREE experiences. \n\n- \"Incredible, Beautiful, and Jaw Dropping\u201d\n- \u201cAmazing and relaxing!\u201d\n- \u201cMakes the oculus worth it\u201d\n\nDesigned with neuroscientists and psychologists and a community of partners.  \n\nTake your first steps and try **Cyberpunch, Hypnosis, Iris** and more!\n\nThere is always plenty to try with Liminal!", "short_description": "155+ experiences to WOW you and transform your mood. Try our extensive catalog for FREE!\n\nNEW: The Fear Arena is open. Safe scares, big feelings and a lot of fun.\n\nSeven categories to explore. Over 1m in app five-star ratings!\n\nExperience Awe. Find Relief. Enhance your Focus. Face your Fears.\n\nLiminal is a great way to chill out and have fun!\n\nSubscribe for unlimited access. Or enjoy a free weekly rotation  of experiences. \n\nDesigned with neuroscientists and psychologists and content partners."}]}, "developer_name": "Liminal VR", "developer_privacy_policy_url": "https://liminalvr.com/privacy-statement/", "developer_terms_of_service_url": "https://liminalvr.com/terms-conditions/", "publisher_name": "Liminal VR", "support_website_url": null, "website_url": "https://liminalvr.com/liminal-platform/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["CASUAL", "EXPERIENCE_360_NON_GAME", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
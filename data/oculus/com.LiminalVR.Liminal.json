31594_5086928594702215_4403993108538159853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odg1uhrwuBEQ7kNvwE6m8Ok&_nc_oc=AdqqQ31e0q3I_D51Si3sexWUHi6q0OJqDZgvYqnsLLoZHv5VtCT87DuzYlh5T5Vhw8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5-KXDY7YK41cGCyx-RywHCWmjhfcC9FXkkENfn6KK-A&oe=6AC25245"}, {"file_name": "Cozy Cabin.png", "id": "6347211302067285", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984440_6347211305400618_1426166590482501018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upABKgC3H8cQ7kNvwECo8yy&_nc_oc=Adpi_BDF3e01evKbJWNAgRDuvZQp9ULga7aJt7oulKg7TQENxZ3SrGf2mlkpTOs41v8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZwzQ1GIiMMUnlSyHQ-5qVo10hGL7_ynhGUdrAYpIFMQ&oe=6AC26DDD"}, {"file_name": "Screenshot_03.png", "id": "925950811477697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_925950814811030_4585030413770382015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ig1FzhnwtCYQ7kNvwFcpBw2&_nc_oc=Adp-_QPDPKh9A7SF4G7TsPRZrQkkqNbEx5JPU72X97I77EaQ8oz81mCKlfm_jzA9v58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4cK4hQPkRIgXR15fEh5YNCmqBByxbFexFz72z_uhKig&oe=6AC26CF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - 2560x1440.png", "id": "214806744523842", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035449_214806747857175_8303135038801097332_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22p2t3Ku2XcQ7kNvwEBzHL3&_nc_oc=AdrHIQelEuZ0SNbdIpb5RXdFSOQyhKHN-Mi9ONHXM3WsAQOl7XYLNyNYn_MPIAHq4S4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzQgGp7ikA6LOhpQ5pHqF7blrmI_mRKFKu_9mVrNlEEA&oe=6AC25096"}, "display_name": "LIMINAL: Relax. Unwind. Engage. Explore.", "keywords": ["entertainment", "relax", "calm", "meditation", "fun"], "long_description": "**EXPLORE LIMINAL: 145+ Experiences to WOW you and Transform your Mood.**\n\nGet Liminal now and try it out for FREE!\n\nSix categories to explore. Over 1 Million in app five-star ratings!\n\nMake sure you try **Samsara** in the Awe Arena\n{1040915533978887}\n\nReduce anxiety, meditate, breathe or grab a pillow to lie down and sleep. Try hypnosis to distract you from pain and reduce stress. \n{1208055313831116}\n\nPlay exciting casual games and other interactive content. Liminal is much more than a mindfulness app:\n{828649595813485}\n\n**Experience Awe. Find Relief. Enhance your Focus.**\n\nLiminal is a great way to chill out and have some fun!\n\nSubscribe for unlimited access. Or enjoy a weekly rotation of FREE experiences. \n\n- \"Incredible, Beautiful, and Jaw Dropping\u201d\n- \u201cAmazing and relaxing!\u201d\n- \u201cMakes the oculus worth it\u201d\n\nDesigned with neuroscientists and psychologists and a community of partners. Earn credits in the Lab to save your favorites. \n\nTake your first steps and try **Cyberpunch, Flux, Boundless** and more!\n\nThere is always plenty to try with Liminal!", "short_description": "145+ experiences to WOW you and transform your mood. Try our extensive catalog for FREE!\n\n- Make sure you try **Samsara** - our Number 1 Awe experience!\n\nSix categories to explore. Over 1 Million in app five-star ratings!\n\nExperience Awe. Find Relief. Enhance your Focus.\n\nLiminal is a great way to chill out and have some fun!\n\nSubscribe to Premium for unlimited access. Or enjoy a weekly rotation of free experiences. \n\nDesigned with neuroscientists and psychologists and development partners."}]}, "developer_name": "Liminal VR", "developer_privacy_policy_url": "https://liminalvr.com/privacy-statement/", "developer_terms_of_service_url": "https://liminalvr.com/terms-conditions/", "publisher_name": "Liminal VR", "support_website_url": null, "website_url": "https://liminalvr.com/liminal-platform/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}
&_nc_ohc=cLQ6hPX4wTkQ7kNvwHxLTwC&_nc_oc=AdqK9aZrGZBr59_lsCE4IA4ggKSMwJlfJJ4Yz9F_7hPu6h3vZIy1HvIHWZHwSNBSQAM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZQMoakpekydAgaDxPA2Dy09DFloWfONOzm-3LGC7wew&oe=6AFB4077"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75240097_739585616795073_1889723882970021888_n.png", "id": "707131746633058", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982441_707131749966391_6234345335662577987_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr0DFA-aA4IQ7kNvwGLzFP7&_nc_oc=AdreQxQc84ZDJUHLBTINr89NR4dwkxlY4mhYlq0T_Vb5iCwe8IHMRQq85KWq_piBunU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_7mcpjiCW1a5O82JKfvBjaKdAOBkJZDvotU0NQhJRAA&oe=6AFB3059"}, "display_name": "Liminal", "keywords": [], "long_description": "Alter your state of mind and choose how you feel and perform. Explore a range of experiences which apply research by neuroscientists and psychologists to induce and augment emotional and cognitive states. \n\nThere are currently four categories of experience: Calm, Energy, Pain Relief and Awe with new content and more categories to be released over time. \n\nCalming experiences are relaxing and beautiful, energizing experiences fun and invigorating, pain relief experiences are designed to make you more comfortable and awe experiences will leave you speechless. \n\nWe track and display how effective each experience is based on user feedback so you can see how it has affected others.\n\nCome back each week to try different experiences created by Liminal and our partners. You can also take part in interesting lab experiments to earn credits and unlock more content!", "short_description": "Alter your state of mind and choose how you feel and perform. Explore a range of experiences which apply research by neuroscientists and psychologists to induce and augment emotional and cognitive states. \n\nWe track and display how effective each experience is based on user feedback so you can see how it has affected others. \n\nThere are currently four categories of experience: Calm, Energy, Pain Relief and Awe Come back each week to try different experiences created by Liminal and our partners."}]}, "developer_name": "Liminal VR", "developer_privacy_policy_url": "https://www.liminalvr.com/privacy", "developer_terms_of_service_url": "https://www.liminalvr.com/terms", "publisher_name": "Liminal VR", "support_website_url": null, "website_url": "https://api.liminalvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["CASUAL", "EXPERIENCE_360_NON_GAME", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "353860052986971"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "391162819228420"}, {"status": "PUBLISHED", "id": "1780157512150760"}]}, "baseline_offer": {"id": "391162819228420"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1649350800, "status": "PUBLISHED", "id": "391162819228420"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28224633537210083", "version": "2.18.19"}, "id": "868416857225297", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_app
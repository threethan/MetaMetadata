?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJNJNEePZvoQ7kNvwEmBKI0&_nc_oc=Adll-rLMjWpMwK0bhHIC5SOqyaUTBwnotUOS6OHeSTN6vOGHkwZPN2QXSr2rWiqjVsE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfznWVJDpILEwxcUcd0eaa2cSFElO7gjuLjgZnr7SIITMg&oe=69AEC8C5"}, {"file_name": "Cozy Cabin.png", "id": "6347211302067285", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984440_6347211305400618_1426166590482501018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7txU4N_3108Q7kNvwHG41Nr&_nc_oc=Adk9Y5Qqfpe4E7FMDmz0ZaoF-hW1SItVhexG8u00huoCTkRuHg2b7Kf5_4ODlT6boK0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2BhwG4YSkjqRL7mAHoqjMHMfcQl2J2HxdJtLAOUdsWA&oe=69AEAC1D"}, {"file_name": "Screenshot_03.png", "id": "925950811477697", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196225_925950814811030_4585030413770382015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lgrj_iEZdWkQ7kNvwFPZ62U&_nc_oc=AdmkLiHNWpFKNO2EPFYZTdwyzF41yWwhlc2Q33AOY1_12d2qu0QguoldC4veSFdn0y4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXZUsp7K3irU1h3TVuuieGQZkphe_vC4QaPB_3eMhhxw&oe=69AEAB37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - 2560x1440.png", "id": "214806744523842", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035449_214806747857175_8303135038801097332_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPUuW3B2uQgQ7kNvwGwi5k9&_nc_oc=Adli96c7lEhBftQCW9UFwAzBVNyNkEd1NY4KmrWYvvOsHVLJyC7WoXRxwUD8V8AHU5Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfycIgKoiNHyMUUUuz-9rFBCDu_2n9uiDWko3e5fdaU9uA&oe=69AEC716"}, "display_name": "LIMINAL: Relax. Unwind. Engage. Explore.", "keywords": ["entertainment", "relax", "calm", "meditation", "fun"], "long_description": "**EXPLORE LIMINAL: 140+ Experiences to WOW you and Transform your Mood.**\n\nGet Liminal now and try it out for FREE!\n\nSix categories to explore. Over 800,000 in app five-star ratings!\n\nMake sure you try **Samsara** in the Awe Arena\n{1040915533978887}\n\nReduce anxiety, meditate, breathe or grab a pillow to lie down and sleep. Try hypnosis to distract you from pain and reduce stress. \n{1208055313831116}\n\nPlay exciting casual games and other interactive content. Liminal is much more than a mindfulness app:\n{828649595813485}\n\n**Experience Awe. Find Relief. Enhance your Focus.**\n\nLiminal is a great way to chill out and have some fun!\n\nSubscribe for unlimited access. Or enjoy a weekly rotation of FREE experiences. \n\n- \"Incredible, Beautiful, and Jaw Dropping\u201d\n- \u201cAmazing and relaxing!\u201d\n- \u201cMakes the oculus worth it\u201d\n\nDesigned with neuroscientists and psychologists and a community of partners. Earn credits in the Lab to save your favorites. \n\nTake your first steps and try **Cyberpunch, Flux, Boundless** and more!\n\nThere is always plenty to try with Liminal!", "short_description": "135+ experiences to WOW you and transform your mood. Try our extensive catalog for FREE!\n\n- Make sure you try **Samsara** - our Number 1 Awe experience!\n\nSix categories to explore. Over 800,000 in app five-star ratings!\n\nExperience Awe. Find Relief. Enhance your Focus.\n\nLiminal is a great way to chill out and have some fun!\n\nSubscribe to Premium for unlimited access. Or enjoy a weekly rotation of free experiences. \n\nDesigned with neuroscientists and psychologists and development partners."}]}, "developer_name": "Liminal VR", "developer_privacy_policy_url": "https://liminalvr.com/privacy-statement/", "developer_terms_of_service_url": "https://liminalvr.com/terms-conditions/", "publisher_name": "Liminal VR", "support_website_url": null, "website_url": "https://liminalvr.com/liminal-platform/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}, {"id": "1063584910766706"}], "external_
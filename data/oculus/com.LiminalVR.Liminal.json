31594_5086928594702215_4403993108538159853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIz313ePeywQ7kNvwE3Getj&_nc_oc=AdosdqNv17L7adtjj9dtsqkN95zkVO9aCkUMzYOs6DKveL8ce2o96-iA0M1IumP-JPk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1r1hxhE9q123cICtoVB1r84J6jzdxnJa6G97-87XvmYg&oe=69DE3EC5"}, {"file_name": "Cozy Cabin.png", "id": "6347211302067285", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984440_6347211305400618_1426166590482501018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PYqZhzqmFgQ7kNvwFGgAPf&_nc_oc=AdrkvM5O9dWLVjG0GsWk2xinERKuC-UkM48hGUzRnN8pVEwycx0DUndN4M5YcK2bMMk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gYsyk2iS2Ithznfjk3zxrBgwd4P8d18dStDCUDJh0KA&oe=69DE221D"}, {"file_name": "Screenshot_03.png", "id": "925950811477697", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196225_925950814811030_4585030413770382015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqcM9UgH5nQQ7kNvwEltg19&_nc_oc=AdqUGwDiliAczDQI8Ryze4h20aW4tc-amcw2cEUJXtewl-1nDwaRbkb13aLFMnIDHeI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qMdIacICOAD5yRetvyJKstMq5NxIU1Qw7MLig8HDfvA&oe=69DE2137"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - 2560x1440.png", "id": "214806744523842", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035449_214806747857175_8303135038801097332_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auUGWmv98C4Q7kNvwGyD8-b&_nc_oc=AdqZY4uu2PZHnIElWMKtoJ_VJzsEIVhTvMCJkrzt8Zbt5r0zqJNQWRcp40l-wwA-pjI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CnmT6IL7PhqKNsuL3xHg6YkG5ENMjeGZl6DlKVX8RcQ&oe=69DE3D16"}, "display_name": "LIMINAL: Relax. Unwind. Engage. Explore.", "keywords": ["entertainment", "relax", "calm", "meditation", "fun"], "long_description": "**EXPLORE LIMINAL: 140+ Experiences to WOW you and Transform your Mood.**\n\nGet Liminal now and try it out for FREE!\n\nSix categories to explore. Over 800,000 in app five-star ratings!\n\nMake sure you try **Samsara** in the Awe Arena\n{1040915533978887}\n\nReduce anxiety, meditate, breathe or grab a pillow to lie down and sleep. Try hypnosis to distract you from pain and reduce stress. \n{1208055313831116}\n\nPlay exciting casual games and other interactive content. Liminal is much more than a mindfulness app:\n{828649595813485}\n\n**Experience Awe. Find Relief. Enhance your Focus.**\n\nLiminal is a great way to chill out and have some fun!\n\nSubscribe for unlimited access. Or enjoy a weekly rotation of FREE experiences. \n\n- \"Incredible, Beautiful, and Jaw Dropping\u201d\n- \u201cAmazing and relaxing!\u201d\n- \u201cMakes the oculus worth it\u201d\n\nDesigned with neuroscientists and psychologists and a community of partners. Earn credits in the Lab to save your favorites. \n\nTake your first steps and try **Cyberpunch, Flux, Boundless** and more!\n\nThere is always plenty to try with Liminal!", "short_description": "135+ experiences to WOW you and transform your mood. Try our extensive catalog for FREE!\n\n- Make sure you try **Samsara** - our Number 1 Awe experience!\n\nSix categories to explore. Over 800,000 in app five-star ratings!\n\nExperience Awe. Find Relief. Enhance your Focus.\n\nLiminal is a great way to chill out and have some fun!\n\nSubscribe to Premium for unlimited access. Or enjoy a weekly rotation of free experiences. \n\nDesigned with neuroscientists and psychologists and development partners."}]}, "developer_name": "Liminal VR", "developer_privacy_policy_url": "https://liminalvr.com/privacy-statement/", "developer_terms_of_service_url": "https://liminalvr.com/terms-conditions/", "publisher_name": "Liminal VR", "support_website_url": null, "website_url": "https://liminalvr.com/liminal-platform/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"
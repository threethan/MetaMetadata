erience is based on user feedback so you can see how it has affected others. \n\nThere are currently four categories of experience: Calm, Energy, Pain Relief and Awe Come back each week to try different experiences created by Liminal and our partners."}]}, "developer_name": "Liminal VR", "developer_privacy_policy_url": "https://www.liminalvr.com/privacy", "developer_terms_of_service_url": "https://www.liminalvr.com/terms", "publisher_name": "Liminal VR", "support_website_url": null, "website_url": "https://api.liminalvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["CASUAL", "EXPERIENCE_360_NON_GAME", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "353860052986971"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "391162819228420"}, {"status": "PUBLISHED", "id": "1780157512150760"}]}, "baseline_offer": {"id": "391162819228420"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1649350800, "status": "PUBLISHED", "id": "391162819228420"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28405766625763439", "version": "2.18.20"}, "id": "868416857225297", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_app
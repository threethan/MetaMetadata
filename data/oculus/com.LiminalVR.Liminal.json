31594_5086928594702215_4403993108538159853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBE9rOi6uLMQ7kNvwFXphxN&_nc_oc=AdrTbWvhA40Wzo9fjfiP2MStAPGxlrxbMDW57TIxIvIa5K9G4m5pxjZY_3DfY2iD_mQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JDcDcQ_q77tosE0NI4dIUWDDRyfXQSWowAPJZ-h8bhw&oe=6A2C0745"}, {"file_name": "Cozy Cabin.png", "id": "6347211302067285", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984440_6347211305400618_1426166590482501018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0FR9yDiNP8Q7kNvwHDoP2y&_nc_oc=Adq-lOsMavk5BjUmovgDU4DD3CZNp5wOsE7MJLmixHw3iEqujYOico5aT3u-GYASuhc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MkgyNAlBbPaNUXdtZaMUxx5o8wKQcSX2M35enSZUzSA&oe=6A2C22DD"}, {"file_name": "Screenshot_03.png", "id": "925950811477697", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75196225_925950814811030_4585030413770382015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwKhMauPZn8Q7kNvwFYxts0&_nc_oc=AdoNcYAXzA46KunGZyLFU5tA1Q9HGKAGS_eKzbcL0PEf-RZag_xGDVbU6mEQD199WnM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PYEaTASBBT3ZllpDqcxHVNt0BhmApCDHQiRiiRxBfMQ&oe=6A2C21F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - 2560x1440.png", "id": "214806744523842", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035449_214806747857175_8303135038801097332_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bZTSejOatkQ7kNvwFN2G0o&_nc_oc=Adqs3_8ZPArvx2OxxJuMZW3pgKYLUo_QVOqayD36rKNHe413Vo4RrEGX5F2GkKnlA_4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Qw4IbzY6SZUJOsdwEVvOFredEpkw_pa6495QqF8YMMA&oe=6A2C0596"}, "display_name": "LIMINAL: Relax. Unwind. Engage. Explore.", "keywords": ["entertainment", "relax", "calm", "meditation", "fun"], "long_description": "**EXPLORE LIMINAL: 145+ Experiences to WOW you and Transform your Mood.**\n\nGet Liminal now and try it out for FREE!\n\nSix categories to explore. Over 1 Million in app five-star ratings!\n\nMake sure you try **Samsara** in the Awe Arena\n{1040915533978887}\n\nReduce anxiety, meditate, breathe or grab a pillow to lie down and sleep. Try hypnosis to distract you from pain and reduce stress. \n{1208055313831116}\n\nPlay exciting casual games and other interactive content. Liminal is much more than a mindfulness app:\n{828649595813485}\n\n**Experience Awe. Find Relief. Enhance your Focus.**\n\nLiminal is a great way to chill out and have some fun!\n\nSubscribe for unlimited access. Or enjoy a weekly rotation of FREE experiences. \n\n- \"Incredible, Beautiful, and Jaw Dropping\u201d\n- \u201cAmazing and relaxing!\u201d\n- \u201cMakes the oculus worth it\u201d\n\nDesigned with neuroscientists and psychologists and a community of partners. Earn credits in the Lab to save your favorites. \n\nTake your first steps and try **Cyberpunch, Flux, Boundless** and more!\n\nThere is always plenty to try with Liminal!", "short_description": "145+ experiences to WOW you and transform your mood. Try our extensive catalog for FREE!\n\n- Make sure you try **Samsara** - our Number 1 Awe experience!\n\nSix categories to explore. Over 1 Million in app five-star ratings!\n\nExperience Awe. Find Relief. Enhance your Focus.\n\nLiminal is a great way to chill out and have some fun!\n\nSubscribe to Premium for unlimited access. Or enjoy a weekly rotation of free experiences. \n\nDesigned with neuroscientists and psychologists and development partners."}]}, "developer_name": "Liminal VR", "developer_privacy_policy_url": "https://liminalvr.com/privacy-statement/", "developer_terms_of_service_url": "https://liminalvr.com/terms-conditions/", "publisher_name": "Liminal VR", "support_website_url": null, "website_url": "https://liminalvr.com/liminal-platform/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}
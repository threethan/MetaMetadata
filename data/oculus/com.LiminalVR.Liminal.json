?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQ1f8fwsKBoQ7kNvwGHf-cv&_nc_oc=AdmU8eb3Nu0rhR86XY4McW_bjBcuaXoy5s_dNdkEU1pfS8NFbG8zlvZsJP1RXGpp6Ow&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNLYuk86oFGmiXd8yQzF50HK9BE8e4ZZk9ZFCKrxDeDw&oe=69BD4945"}, {"file_name": "Cozy Cabin.png", "id": "6347211302067285", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984440_6347211305400618_1426166590482501018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BuvtRDJlEgQ7kNvwEorYG7&_nc_oc=AdmT5pG8ksmXnjnuqm1BSTXKWHDAz81F02_zGUxRzc2qLBWp1tA_r2q7xEXqxyIaCDg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwd-8xxaqyp45J_FdKdYI0Cw1ibfxW1zPuKT9odO32WTg&oe=69BD2C9D"}, {"file_name": "Screenshot_03.png", "id": "925950811477697", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75196225_925950814811030_4585030413770382015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjnYYH1HkksQ7kNvwHU2J4a&_nc_oc=AdlWkQUpWPXc15w-ZDTYRtlCeTjNSuFG6YL-yoYh2-zk6X1B_jGwOUwgTfe6bl7a6Mk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzm6WHwd3bGRox6qsjS6m-nD-3CEyC6qmAU8c17wQj_oQ&oe=69BD2BB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - 2560x1440.png", "id": "214806744523842", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035449_214806747857175_8303135038801097332_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhARANv8VFkQ7kNvwENJ4iB&_nc_oc=Admi5fEPWlU07YhRmH0LWHgdFmtintFCG-Ml-NkHkHp0NUQiAx6_4dYPoI7m-TryOV8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqHbLxIF-p3Xf_jQmTtvOTVuu3pLVGz15N1iGRimMt5Q&oe=69BD4796"}, "display_name": "LIMINAL: Relax. Unwind. Engage. Explore.", "keywords": ["entertainment", "relax", "calm", "meditation", "fun"], "long_description": "**EXPLORE LIMINAL: 140+ Experiences to WOW you and Transform your Mood.**\n\nGet Liminal now and try it out for FREE!\n\nSix categories to explore. Over 800,000 in app five-star ratings!\n\nMake sure you try **Samsara** in the Awe Arena\n{1040915533978887}\n\nReduce anxiety, meditate, breathe or grab a pillow to lie down and sleep. Try hypnosis to distract you from pain and reduce stress. \n{1208055313831116}\n\nPlay exciting casual games and other interactive content. Liminal is much more than a mindfulness app:\n{828649595813485}\n\n**Experience Awe. Find Relief. Enhance your Focus.**\n\nLiminal is a great way to chill out and have some fun!\n\nSubscribe for unlimited access. Or enjoy a weekly rotation of FREE experiences. \n\n- \"Incredible, Beautiful, and Jaw Dropping\u201d\n- \u201cAmazing and relaxing!\u201d\n- \u201cMakes the oculus worth it\u201d\n\nDesigned with neuroscientists and psychologists and a community of partners. Earn credits in the Lab to save your favorites. \n\nTake your first steps and try **Cyberpunch, Flux, Boundless** and more!\n\nThere is always plenty to try with Liminal!", "short_description": "135+ experiences to WOW you and transform your mood. Try our extensive catalog for FREE!\n\n- Make sure you try **Samsara** - our Number 1 Awe experience!\n\nSix categories to explore. Over 800,000 in app five-star ratings!\n\nExperience Awe. Find Relief. Enhance your Focus.\n\nLiminal is a great way to chill out and have some fun!\n\nSubscribe to Premium for unlimited access. Or enjoy a weekly rotation of free experiences. \n\nDesigned with neuroscientists and psychologists and development partners."}]}, "developer_name": "Liminal VR", "developer_privacy_policy_url": "https://liminalvr.com/privacy-statement/", "developer_terms_of_service_url": "https://liminalvr.com/terms-conditions/", "publisher_name": "Liminal VR", "support_website_url": null, "website_url": "https://liminalvr.com/liminal-platform/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}, {"id": "1063584910766706"}], "external_
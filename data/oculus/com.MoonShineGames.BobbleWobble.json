uscdn.com&oh=00_AftcgB66kPHEqo-n-myNOnf2ZsuPpwZwxtYUoGoZsUXG9w&oe=699D97F3"}, {"file_name": "ss4.png", "id": "1486923608895565", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031542_1486923612228898_6175305655102120811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMyXaWcHWAEQ7kNvwHVmNzm&_nc_oc=AdmsL47fzrldSMO0KQMj2oAznht9lL7piwCmuCgZyLB7CDheNyUkneRhScGqvZoAGDs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuyms4qKk9ruAVCO8jvs5CpgIzEH4BELN9WNVrnp1oe0Q&oe=699D8E53"}, {"file_name": "ss5.png", "id": "1584587079039611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75580057_1584587082372944_5129934640257413816_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qj1YSmGsKTMQ7kNvwHB7vOw&_nc_oc=AdlVnrNo837ouMpHZKVI0BPWitlwP0Xsxpi3rXgX3JbiHOACMNKQkA3TiNF0k6WDyac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv0OBrnJaI62ZkXIxg0O6-ARLPV0gYrfMo1p6v9mYUFkA&oe=699D805B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer art.png", "id": "1121291015584301", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974695_1121291018917634_7315194195757479732_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqfLD9pkQAMQ7kNvwFIbmGD&_nc_oc=AdliK2CmfqDM4vM2oFwGWrropg0kOlKGqQIEiILeE1B8HL08nrqrqfFaebLk53-cb_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afulo3RgF9qnNNlpuhiyMHCsaGR1JMZz1un_P-DhQqHO1g&oe=699DB212"}, "display_name": "Bobble Wobble", "keywords": [], "long_description": "Embark on a thrilling journey through vibrant, interactive worlds in our exhilarating VR puzzle game, 'Bobble Wobble'! Guide your adorable Bobble through a series of mind-bending challenges, strategically pushing and manoeuvring them to reach the coveted end goal. With each level presenting a unique puzzle to solve, immerse yourself in 50 captivating stages that will test your wit and agility to the fullest. Are you ready to embark on this epic adventure and unlock the mysteries that await in 'Bobble Wobble'?", "short_description": "Navigate through 50 levels of immersive VR puzzles in 'Bobble Wobble.' Strategically push your adorable Bobble characters to reach the goal and unlock the next challenge. Are you up for the thrill?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://markledson28.wixsite.com/moonshinegames/copy-of-contact-details", "developer_terms_of_service_url": null, "publisher_name": "MoonShine Games", "support_website_url": "https://markledson28.wixsite.com/moonshinegames/contact", "website_url": "https://markledson28.wixsite.com/moonshinegames", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7434595859969599"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210897_754568330151379_5785267272678421151_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9Ve0sWWuLgQ7kNvwG7n73L&_nc_oc=AdmYDK14ESs6mWGw-07FjQQSR1pcM2vT8aUcLJ2MWw4Pup3fUmHIayUEl3a-whl9eg8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft6AvYLtqrJhWootSptGafBRvtyNotgycjIIVXJnX5grQ&oe=699DA70F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bobble Wobble", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Arcade", "id": "1592192974
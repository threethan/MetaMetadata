_5129934640257413816_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgczHJ6pQY8Q7kNvwETYz5w&_nc_oc=Adpfuiri8l_rhT8UjyELGAS8VHph_kSM9bi2qxxolAqXVs08Zt4OXsveU953Q1zbcLo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNcxsA4CZ369gFWIoy3PnUxwsHQLR1Vqt_YFk8mVbuig&oe=69CA8B9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer art.png", "id": "1121291015584301", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974695_1121291018917634_7315194195757479732_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYXoTdm3FNMQ7kNvwHoU98o&_nc_oc=AdqL5ODENFCK3MNJcWNKJoYWL86tkcLmFKPOPqI6m-UtnrSPvbV_vaMrRk5SwSXRrbc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvCz2PsASrb673rlpzJODztwOCiBFDc73tluM-dm5-CA&oe=69CA8512"}, "display_name": "Bobble Wobble", "keywords": [], "long_description": "Embark on a thrilling journey through vibrant, interactive worlds in our exhilarating VR puzzle game, 'Bobble Wobble'! Guide your adorable Bobble through a series of mind-bending challenges, strategically pushing and manoeuvring them to reach the coveted end goal. With each level presenting a unique puzzle to solve, immerse yourself in 50 captivating stages that will test your wit and agility to the fullest. Are you ready to embark on this epic adventure and unlock the mysteries that await in 'Bobble Wobble'?", "short_description": "Navigate through 50 levels of immersive VR puzzles in 'Bobble Wobble.' Strategically push your adorable Bobble characters to reach the goal and unlock the next challenge. Are you up for the thrill?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://markledson28.wixsite.com/moonshinegames/copy-of-contact-details", "developer_terms_of_service_url": null, "publisher_name": "MoonShine Games", "support_website_url": "https://markledson28.wixsite.com/moonshinegames/contact", "website_url": "https://markledson28.wixsite.com/moonshinegames", "category": null, "comfort_rating": null, "co
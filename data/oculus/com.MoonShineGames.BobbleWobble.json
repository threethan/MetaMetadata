_5129934640257413816_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfYsJhV4bCEQ7kNvwHbUTCX&_nc_oc=Adp2NZQqIiHkVLz9Kt_NoNoOawPGwmltVU8vf247WspmL-2J0iMz8yBVfCmkcdfsWqI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDbhrC_vx5Tk9ThIXrdQotKmNYsvutQo0UUl8ZcUP2Pw&oe=6A4BBE9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer art.png", "id": "1121291015584301", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974695_1121291018917634_7315194195757479732_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYnJT7ajudsQ7kNvwGA9Rj3&_nc_oc=AdpUR-0k8tLbpsNVAKJ30PABvDr7AUj_KlENW5hTtkFwc7bj4JkjQB5HLsYQK4MunY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXyGbXBbl83ebYd5qHnbxtcIOKcy0dtAq3ptH0U5v7ig&oe=6A4BB812"}, "display_name": "Bobble Wobble", "keywords": [], "long_description": "Embark on a thrilling journey through vibrant, interactive worlds in our exhilarating VR puzzle game, 'Bobble Wobble'! Guide your adorable Bobble through a series of mind-bending challenges, strategically pushing and manoeuvring them to reach the coveted end goal. With each level presenting a unique puzzle to solve, immerse yourself in 50 captivating stages that will test your wit and agility to the fullest. Are you ready to embark on this epic adventure and unlock the mysteries that await in 'Bobble Wobble'?", "short_description": "Navigate through 50 levels of immersive VR puzzles in 'Bobble Wobble.' Strategically push your adorable Bobble characters to reach the goal and unlock the next challenge. Are you up for the thrill?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://markledson28.wixsite.com/moonshinegames/copy-of-contact-details", "developer_terms_of_service_url": null, "publisher_name": "MoonShine Games", "support_website_url": "https://markledson28.wixsite.com/moonshinegames/contact", "website_url": "https://markledson28.wixsite.com/moonshinegames", "category": null, "comfort_rating": null, "co
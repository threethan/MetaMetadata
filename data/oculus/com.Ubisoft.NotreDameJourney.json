tent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn2Yp_4r-hooZpdV01EmUlVJ277QOUGWYpse0LMTTVmg&oe=6B045B4C"}, {"file_name": "landscape_5.png", "id": "1560540357694091", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86634395_1560540361027424_1829200862691206615_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1hjWVotqj4Q7kNvwFtl1Z8&_nc_oc=AdrYQqi2HukkD0SjmPpTtoLf88QraBm4LHH3sUHn59h8Jhsu1N4IjsQAqnE-S4uHJsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuXuedBp2DTq6U8z4ysVfqHPVsUX8Ai1KCY4oPCsMsyQ&oe=6B048455"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Notre-Dame de Paris: Journey Back In Time", "keywords": ["NotreDameDeParis", "Paris", "NotreDame"], "long_description": "On April 15, 2019, the world witnessed as Notre-Dame Cathedral was nearly destroyed in a devastating fire. While the cathedral is currently closed for restoration, it is still possible to visit it thanks to Ubisoft\u2019s VR experience.\n\nAt the heart of the videogame Assassin\u2019s Creed : Unity , the 3D reconstitution of Notre-Dame de Paris was the result of 5000 hours of detailed graphic work, guided by historians.\n\nAdapted from on this acclaimed model, the virtual visit offers multiple point-of-views, some of which were inaccessible to the public, and ends spectacularly with a hot-air balloon flight over its arches, in a lively environment of Paris in the XVIIIth century.\n\nThis experience has been shown for the first time at the UNESCO Headquarters on Heritage Days 2019 and was part of the South by Southwest Virtual Cinema 2020 selection.\n\n", "short_description": "Ubisoft proposes a Virtual Reality visit of Notre-Dame de Paris in real time, based on the XVIIIth century reconstitution from the videogame Assassin\u2019s Creed : Unity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.ubi.com/privacypolicy/en-US", "developer_terms_of_service_url": null, "publisher_name": "Ubisof
490785522051_7060671143405339728_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DY_rTtYb1IQ7kNvwE7pAzY&_nc_oc=Adl1Spn1Osd5lG3JiJf5m97aykpvRLnwDk2UMeL1tdg_x8gYartKjr0LSZ_fdaq3N4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwGLBqa4rgPPTKy7zjZtaJ66_mmlg_gscnfUFlNhd1Xwg&oe=69BBFDB2"}, {"file_name": "landscape_4.png", "id": "5564456170299960", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65402515_5564456173633293_8166203934336264507_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zY32qKrYwPEQ7kNvwFffE5F&_nc_oc=AdkpM8J29NAd62XSOGfSRczd75Zir_6FQJGjZG-ufzAxu8MhZG5miLfmYMrLtfOM3U8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1rqzytwPXDJUHl0bGHE00Ll6GTQ8V9IrNdXPHdS-bww&oe=69BBDE76"}, {"file_name": "landscape_5.png", "id": "634797031492068", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001717_634797034825401_6944852042907467801_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhoyWdkPJVYQ7kNvwE9b0mq&_nc_oc=AdkTGSBCiVvQ68rdWw7ZjgkAG0DxOuqk5sA-t9Ua6bUiWtN0GFVZcJ5iFV5Ivqfe3q4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxq71EqixPoHsFvgsvSPiVsA0PDBupwSSPchZGzWNHcnw&oe=69BBFC6B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Notre-Dame de Paris: Voyage dans le Pass\u00e9", "keywords": ["NotreDameDeParis", "NotreDame", "Paris"], "long_description": "(Re)-d\u00e9couvrez Notre-Dame de Paris telle qu\u2019elle \u00e9tait il y a 2 si\u00e8cles, pendant la R\u00e9volution Fran\u00e7aise. Au c\u0153ur du jeu vid\u00e9o Assassin\u2019s Creed : Unity, la reconstitution 3D de la cath\u00e9drale a n\u00e9cessit\u00e9 5000 heures de travail graphique, guid\u00e9 par des historiens.\nDe la nef \u00e0 la fl\u00e8che, admirez chaque perspective du monument, et finissez par un spectaculaire voyage en ballon au-dessus des arches, et de Paris \u00e0 la fin du XVIII\u00e8me si\u00e8cle. Le tout au son d\u2019une fantaisie de Bach jou\u00e9e sur le c\u00e9l\u00e8bre orgue Cavaill\u0
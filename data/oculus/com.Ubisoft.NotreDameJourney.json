UfrMEKQ6H8Q0tGvJ30v12LZ680_9bIu4QEW1BkzEY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Zmz0W4JG0JifPrDNGqMQCqrawKMI7viPJaOfv-jWFmg&oe=69F5EA54"}, {"file_name": "landscape_2.png", "id": "614240586776866", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75603734_614240590110199_5815528428338861024_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqA7lANBsfYQ7kNvwGPJG5-&_nc_oc=Adqps5zabTmDHoRP5pxUf6dST5OGiK-hdwFzGMpr52Fp6We08tXNdPNWFCBrxX3VPqI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wwvKJUjmXT7OM2pqZcATGiCRv1fPAMh1UIav98zHDEQ&oe=69F5F848"}, {"file_name": "landscape_3.png", "id": "818343619180917", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031501_818343622514250_4705416194001481377_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_1vvVeyFpIQ7kNvwEYj94f&_nc_oc=Adr5oqVu3ph5sI474bHTWOT4e3w0ILvng-CHT2GbOBHy1rLH2rPTK1RO6-8Q6b_F1tc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1TTxywTxM88jwUAU_-KDXJI-B90dCPEi-_oPjc9A1WHw&oe=69F5FEB3"}, {"file_name": "landscape_4.png", "id": "666181164406432", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001717_666181167739765_4216386184759446709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VSs_4J1KOkQ7kNvwEOStqv&_nc_oc=Adok4QK9IUd6bKneutA-2hONmkHnu1Souq3fwH4T01p9UffxxeK1O6e8gKVRTubFEt0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3tQulhia0MdnQiAeTUUaCe0TS8vAXwegPxR-c7ZNe8yA&oe=69F617CC"}, {"file_name": "landscape_5.png", "id": "1560540357694091", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86634395_1560540361027424_1829200862691206615_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGBBbI6wTzkQ7kNvwHeYtcR&_nc_oc=AdqPL3hpuJo7AgOSlr4NY3IUj0EB8qhgH5PyY7nAq7zY2h4IninIRlL-Wdlu-AJD4Ws&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29YSF0kLlaLluwFuGi9Aim2bojuWt7U4oYLyvx5fWAHA&oe=69F60895"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Notre-Dame de Paris: Journey Back In Time", "keywords": ["NotreDameDeParis", "Paris", "NotreDame"], "long_description": "On April 15, 2019, the world witnessed as Notre-Dame Cathedral was nearly destroyed in a devastating fire. While the cathedral is currently closed for restoration, it is still possible to visit it thanks to Ubisoft\u2019s VR experience.\n\nAt the heart of the videogame Assassin\u2019s Creed : Unity , the 3D reconstitution of Notre-Dame de Paris was the result of 5000 hours of detailed graphic work, guided by historians.\n\nAdapted from on this acclaimed model, the virtual visit offers multiple point-of-views, some of which were inaccessible to the public, and ends spectacularly with a hot-air balloon flight over its arches, in a lively environment of Paris in the XVIIIth century.\n\nThis experience has been shown for the first time at the UNESCO Headquarters on Heritage Days 2019 and was part of the South by Southwest Virtual Cinema 2020 selection.\n\n", "short_description": "Ubisoft proposes a Virtual Reality visit of Notre-Dame de Paris in real time, based on the XVIIIth century reconstitution from the videogame Assassin\u2019s Creed : Unity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.ubi.com/privacypolicy/en-US", "developer_terms_of_service_url": null, "publisher_name": "Ubisoft", "support_website_url": null, "website_url": "https://www.ubisoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes":
490785522051_7060671143405339728_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DY_rTtYb1IQ7kNvwGBTeAB&_nc_oc=AdmOy9I0zKUKfVimHENpq3OKf__Cs3o8aOPo5FKJMHqQRr2PhUEIqi1myv5n_EbHkTQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw81LtTkHJBMNPy8QAKBFZEx3pTq1O4nsxesq6Weo9okw&oe=69BAAC32"}, {"file_name": "landscape_4.png", "id": "5564456170299960", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/65402515_5564456173633293_8166203934336264507_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zY32qKrYwPEQ7kNvwHd61Zl&_nc_oc=AdmwQTwNKtxf5YdcZEG7cf5t-V7uWfhlIk_jtVdfIPcf3xwr0cduDojUEXE4ZB_4IZE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx2n65-0ATvAfNu73DKZO6prGc-cA2k__woPTeVMeyaRw&oe=69BA8CF6"}, {"file_name": "landscape_5.png", "id": "634797031492068", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001717_634797034825401_6944852042907467801_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhoyWdkPJVYQ7kNvwE4lBei&_nc_oc=AdkyRiOW3dRpwdPf5krpoQQiHzpaNC7X6xnY3F-LvUSqjMgmZZzvyMe8W4HVrrtxdx0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxTXxk3xBWklNxJhu6oSoQrWLUWcKZvP5jOXa5lw-kXbw&oe=69BAAAEB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Notre-Dame de Paris: Voyage dans le Pass\u00e9", "keywords": ["NotreDameDeParis", "NotreDame", "Paris"], "long_description": "(Re)-d\u00e9couvrez Notre-Dame de Paris telle qu\u2019elle \u00e9tait il y a 2 si\u00e8cles, pendant la R\u00e9volution Fran\u00e7aise. Au c\u0153ur du jeu vid\u00e9o Assassin\u2019s Creed : Unity, la reconstitution 3D de la cath\u00e9drale a n\u00e9cessit\u00e9 5000 heures de travail graphique, guid\u00e9 par des historiens.\nDe la nef \u00e0 la fl\u00e8che, admirez chaque perspective du monument, et finissez par un spectaculaire voyage en ballon au-dessus des arches, et de Paris \u00e0 la fin du XVIII\u00e8me si\u00e8cle. Le tout au son d\u2019une fantaisie de Bach jou\u00e9e sur le c\u00e9l\u00e8bre orgue Cavaill\u0
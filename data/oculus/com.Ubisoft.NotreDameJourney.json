MQfHTUWKbph7X2kvoMfX-Zty31mJ4kJj46ZRH2bso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8iFrZhtQB5scG757iGm1f8tgrYbUSrZQWYFgnvELsHw&oe=6AF49414"}, {"file_name": "landscape_2.png", "id": "614240586776866", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75603734_614240590110199_5815528428338861024_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFTczu1iingQ7kNvwGQSrZp&_nc_oc=Adp2UVj3spjmgPmpDMQelwGM1XaQBhRcHvXZ-yVkPs9khtb2BePtEivViOCFWoNaz1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgmWS7GlM8wtXM42uCFcFvrmuZHW0O_qSURybhozxy-w&oe=6AF4A208"}, {"file_name": "landscape_3.png", "id": "818343619180917", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031501_818343622514250_4705416194001481377_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eocY4toPVPwQ7kNvwEzYEwu&_nc_oc=AdolPmeDPUCl_HfJgv0XERAUyRZ94ZbMIW8tVmzaMHcb9yzQiskjGUIQADooElto4DU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyGDHS3HdeJu_Wr7MWL13q58xjhy0mJkgk3udj6v3-AA&oe=6AF47033"}, {"file_name": "landscape_4.png", "id": "666181164406432", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001717_666181167739765_4216386184759446709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXuezu03Nt8Q7kNvwHZk5Xp&_nc_oc=AdpjuawtnQ-6R5zCfZRttubNduzuLIPUazOlPOYeNBCkn7He_CC65hFeDoamke5Q57s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuMo20uI7m4eu780HJSVlNe8wScd62V2k3_0hb7v7LZQ&oe=6AF4894C"}, {"file_name": "landscape_5.png", "id": "1560540357694091", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86634395_1560540361027424_1829200862691206615_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWACrcm8-50Q7kNvwG70caf&_nc_oc=AdoJaUc7NjhKGJ0zamFT_XSnIPrsBh-17y2sRIQ8X52hEgqeijUhQPmMvhCOCuI1kzw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb7mYa5w8ODR0tBuvuWhEUHBngUop0LnfBWhZD4ZTpEg&oe=6AF47A15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Notre-Dame de Paris: Journey Back In Time", "keywords": ["NotreDameDeParis", "Paris", "NotreDame"], "long_description": "On April 15, 2019, the world witnessed as Notre-Dame Cathedral was nearly destroyed in a devastating fire. While the cathedral is currently closed for restoration, it is still possible to visit it thanks to Ubisoft\u2019s VR experience.\n\nAt the heart of the videogame Assassin\u2019s Creed : Unity , the 3D reconstitution of Notre-Dame de Paris was the result of 5000 hours of detailed graphic work, guided by historians.\n\nAdapted from on this acclaimed model, the virtual visit offers multiple point-of-views, some of which were inaccessible to the public, and ends spectacularly with a hot-air balloon flight over its arches, in a lively environment of Paris in the XVIIIth century.\n\nThis experience has been shown for the first time at the UNESCO Headquarters on Heritage Days 2019 and was part of the South by Southwest Virtual Cinema 2020 selection.\n\n", "short_description": "Ubisoft proposes a Virtual Reality visit of Notre-Dame de Paris in real time, based on the XVIIIth century reconstitution from the videogame Assassin\u2019s Creed : Unity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.ubi.com/privacypolicy/en-US", "developer_terms_of_service_url": null, "publisher_name": "Ubisoft", "support_website_url": null, "website_url": "https://www.ubisoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes":
scdn.com/v/t64.5771-25/75603734_614240590110199_5815528428338861024_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usEu0IOStSgQ7kNvwFlNp10&_nc_oc=AdmQrU9iy9fSefbcPvRtyTfd6B_IAKgo8dTOrQcEYMYcX394AKb_5Kjt3C6gLPJYGLU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvr3Yuv5OTV8ujw_0VsrOMT5fNV5bqKVm-jPliUmaaY6w&oe=69A6DE48"}, {"file_name": "landscape_3.png", "id": "818343619180917", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031501_818343622514250_4705416194001481377_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QG5sKHLr8kQQ7kNvwE6PfZt&_nc_oc=AdmUBe2mc7S4bxPtEaFG40pXMnGTGEPHoAJtsO0h97iC5i77Gh7ldCO5iUyNLn43KTI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu4MMVNdyCk8fB3m9GrYlOXGiP7uhuQhrE_DrmOi_gFJA&oe=69A6E4B3"}, {"file_name": "landscape_4.png", "id": "666181164406432", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_666181167739765_4216386184759446709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNXD-h5VCYYQ7kNvwGmbXPf&_nc_oc=AdnRcgaYc8XYpPxSgyylgwpzEhbGnXiKWceV13o6hY4e7aD22OeFIY-LuQCwiH17C2U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfueDMyVLav3Pf7InmosVGefnf7yWaR4THOJmeVBsKs5Lg&oe=69A6C58C"}, {"file_name": "landscape_5.png", "id": "1560540357694091", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86634395_1560540361027424_1829200862691206615_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzvzMuQ6IIAQ7kNvwGD6W8q&_nc_oc=Adk1A4ry9OxltUWyG5Gn10A5JiNg7DwE_Or3LGgm0Q_s2V-W1qyAtBA3UgibvMvUwH0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftYyjtV9DVWE13CiXQsg8ZOmF48EEBNHDTLWfHm2gY44Q&oe=69A6EE95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Notre-Dame de Paris: Journey Back In Time", "keywords": ["NotreDameDeParis", "Paris", "NotreDame"], "long_description": "On April 15, 2019, the world witnessed as Notre-Dame Cathedral was nearly destroyed in a devastating fire. While the cathedral is currently closed for restoration, it is still possible to visit it thanks to Ubisoft\u2019s VR experience.\n\nAt the heart of the videogame Assassin\u2019s Creed : Unity , the 3D reconstitution of Notre-Dame de Paris was the result of 5000 hours of detailed graphic work, guided by historians.\n\nAdapted from on this acclaimed model, the virtual visit offers multiple point-of-views, some of which were inaccessible to the public, and ends spectacularly with a hot-air balloon flight over its arches, in a lively environment of Paris in the XVIIIth century.\n\nThis experience has been shown for the first time at the UNESCO Headquarters on Heritage Days 2019 and was part of the South by Southwest Virtual Cinema 2020 selection.\n\n", "short_description": "Ubisoft proposes a Virtual Reality visit of Notre-Dame de Paris in real time, based on the XVIIIth century reconstitution from the videogame Assassin\u2019s Creed : Unity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.ubi.com/privacypolicy/en-US", "developer_terms_of_service_url": null, "publisher_name": "Ubisoft", "support_website_url": null, "website_url": "https://www.ubisoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "647891759903792"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "900847711425437"}]}, "baseline_offer": {"id": "900847711425437"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 173030
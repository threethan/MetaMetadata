490785522051_7060671143405339728_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lZQQjXCdHEQ7kNvwHuyPJL&_nc_oc=Adldgfe69xEoP4KEbitdUuSkj2XeEu7sBOKk8fbJNZ4P4ec_NxCRHvGK3WC3pKtr3m8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxKfMOKyeD-BdcoA8cddmS5uedgL3o_sko5pjmPyXJRTQ&oe=69B80932"}, {"file_name": "landscape_4.png", "id": "5564456170299960", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65402515_5564456173633293_8166203934336264507_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkAKboWh-_oQ7kNvwHKYWG_&_nc_oc=AdkI16u3UKLMS8xFiE9Pc2sUgi8B-90BcdMJ_cQr15KeFTX-YhAxXBHeB-6C6xk-Y8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyV1_8DZaj5O0fnuMFC6ZdfwYXAlF6N4niHfxZgtukoJg&oe=69B7E9F6"}, {"file_name": "landscape_5.png", "id": "634797031492068", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001717_634797034825401_6944852042907467801_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gL6RIRMCFRcQ7kNvwEFI-1F&_nc_oc=AdlcoOPOrVrjN5cVmNzNrlZU-7SG-9xyC5hGASVFK-Wl4zkgMTbUeGCpLJg9ozQkjhM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy1MaDIA1EKSEU0zUI3_8r8g_PMXwHnMSixFyui5VVptw&oe=69B807EB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Notre-Dame de Paris: Voyage dans le Pass\u00e9", "keywords": ["NotreDameDeParis", "NotreDame", "Paris"], "long_description": "(Re)-d\u00e9couvrez Notre-Dame de Paris telle qu\u2019elle \u00e9tait il y a 2 si\u00e8cles, pendant la R\u00e9volution Fran\u00e7aise. Au c\u0153ur du jeu vid\u00e9o Assassin\u2019s Creed : Unity, la reconstitution 3D de la cath\u00e9drale a n\u00e9cessit\u00e9 5000 heures de travail graphique, guid\u00e9 par des historiens.\nDe la nef \u00e0 la fl\u00e8che, admirez chaque perspective du monument, et finissez par un spectaculaire voyage en ballon au-dessus des arches, et de Paris \u00e0 la fin du XVIII\u00e8me si\u00e8cle. Le tout au son d\u2019une fantaisie de Bach jou\u00e9e sur le c\u00e9l\u00e8bre orgue Cavaill\u0
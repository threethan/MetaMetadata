3o5kylXDFIn7xwDbyFyRJ8roAdlLcPDDUsK31TVi4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TSKNQicc-yjaFo7O3pr9lJ05e1jU7CBfdVtmprC8H2Q&oe=6A317614"}, {"file_name": "landscape_2.png", "id": "614240586776866", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75603734_614240590110199_5815528428338861024_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRsGAREfnTcQ7kNvwGGYFNs&_nc_oc=Ado27EQ5JxfH0oqHNIi4oRvES2M36ShT1L72rKBbf6Pbje2naHpGJi1ZXbOL8Uycsa4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X1NXUXMfq74vseKsVM3nXga-VGO0y7AjGbq6nen071A&oe=6A314BC8"}, {"file_name": "landscape_3.png", "id": "818343619180917", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031501_818343622514250_4705416194001481377_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vkOChYnSh0Q7kNvwESJEC1&_nc_oc=AdptoAfMtqpFgdnOEJGm58x8JynLjoWJwdJDJI7GtpEef6MZcVoxTkTbtklaTdxEk50&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g4NC-uERleq0c48cRuYJ7FmlAhKEhY2Pf-ezyROJJhg&oe=6A315233"}, {"file_name": "landscape_4.png", "id": "666181164406432", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001717_666181167739765_4216386184759446709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5Z5t7rzfg4Q7kNvwG0DxJD&_nc_oc=AdoRO2plYQp2PnyCimNaK0_qVN0KQzZGdVYexCahvkudRAKR_hKMvyODqsLkyAa8jm8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kfrLLP_pvtaZa2sqE10DSQzLh8bzlT7ymoulWBNB-wQ&oe=6A316B4C"}, {"file_name": "landscape_5.png", "id": "1560540357694091", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86634395_1560540361027424_1829200862691206615_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BThmI_PdlAQ7kNvwEZ-yMY&_nc_oc=AdoqHQ0g6TsGoxklewqmVQTZwA9iIyo_lnayyPpOQUTgzFflW_-ke5QI2-0bhir7yJQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jNHpm3NHI-ZrX_dr_XJb-IgDqTPFZS8FJlgFNVtYO5Q&oe=6A315C15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Notre-Dame de Paris: Journey Back In Time", "keywords": ["NotreDameDeParis", "Paris", "NotreDame"], "long_description": "On April 15, 2019, the world witnessed as Notre-Dame Cathedral was nearly destroyed in a devastating fire. While the cathedral is currently closed for restoration, it is still possible to visit it thanks to Ubisoft\u2019s VR experience.\n\nAt the heart of the videogame Assassin\u2019s Creed : Unity , the 3D reconstitution of Notre-Dame de Paris was the result of 5000 hours of detailed graphic work, guided by historians.\n\nAdapted from on this acclaimed model, the virtual visit offers multiple point-of-views, some of which were inaccessible to the public, and ends spectacularly with a hot-air balloon flight over its arches, in a lively environment of Paris in the XVIIIth century.\n\nThis experience has been shown for the first time at the UNESCO Headquarters on Heritage Days 2019 and was part of the South by Southwest Virtual Cinema 2020 selection.\n\n", "short_description": "Ubisoft proposes a Virtual Reality visit of Notre-Dame de Paris in real time, based on the XVIIIth century reconstitution from the videogame Assassin\u2019s Creed : Unity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.ubi.com/privacypolicy/en-US", "developer_terms_of_service_url": null, "publisher_name": "Ubisoft", "support_website_url": null, "website_url": "https://www.ubisoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes":
DPMn4iAgEfJn1cA6TCmYl8RsmsPJMdHvaOCiQjtuY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiYEJ2ivmJBU0d7PPb1PmehPgCSoeDTM11EAPBAe37Rw&oe=6A9FFBD4"}, {"file_name": "landscape_2.png", "id": "614240586776866", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75603734_614240590110199_5815528428338861024_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egLegq3IptcQ7kNvwF50Wuf&_nc_oc=AdomwMcwmR271hLGXop-vxXvxsp6175GDi0F0a37ohPq4fjc2zf1v9j5VIj3lLLpKPk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM1u0umQNKQI0607_9j-bFzoxRUExXHjiUwTL2adoAmA&oe=6AA009C8"}, {"file_name": "landscape_3.png", "id": "818343619180917", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031501_818343622514250_4705416194001481377_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usoMVZojPh0Q7kNvwG6--1P&_nc_oc=Ado2JztHercR2MDnXFmUt1tIV4Ur7sp_K4S-ITt7xZECinZhizyXlrTbnPYAOqtXnQY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJb0l0mj6tOIOQxcrjWvdKcblRiXvJ-ZLsSUlWF-1NOVA&oe=6AA01033"}, {"file_name": "landscape_4.png", "id": "666181164406432", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001717_666181167739765_4216386184759446709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-G6MSNkwK0Q7kNvwFE6AMH&_nc_oc=AdrA_-EfP4Ol--pvFTWE8XXEYT2NXC6DCZCO8l8VJqJAUkmS9kLV_BigfsT6B9_Rn3Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLZCSopNodpPcBsYKMZJlmZ-G61QO1cFXL95NM4Uia5A&oe=6AA0294C"}, {"file_name": "landscape_5.png", "id": "1560540357694091", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86634395_1560540361027424_1829200862691206615_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Cw8ukWc18gQ7kNvwH26nQl&_nc_oc=Adrcb21qOeEfBdehUa4YBuQxrhqdYwl4eC6tDPUfTLPH25zL0hIQea1FvtCPURttcB4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6Tl3inWC2i7_N4j6uwpjLB1OdIHVdtyPnmvoW1nxiwA&oe=6AA01A15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Notre-Dame de Paris: Journey Back In Time", "keywords": ["NotreDameDeParis", "Paris", "NotreDame"], "long_description": "On April 15, 2019, the world witnessed as Notre-Dame Cathedral was nearly destroyed in a devastating fire. While the cathedral is currently closed for restoration, it is still possible to visit it thanks to Ubisoft\u2019s VR experience.\n\nAt the heart of the videogame Assassin\u2019s Creed : Unity , the 3D reconstitution of Notre-Dame de Paris was the result of 5000 hours of detailed graphic work, guided by historians.\n\nAdapted from on this acclaimed model, the virtual visit offers multiple point-of-views, some of which were inaccessible to the public, and ends spectacularly with a hot-air balloon flight over its arches, in a lively environment of Paris in the XVIIIth century.\n\nThis experience has been shown for the first time at the UNESCO Headquarters on Heritage Days 2019 and was part of the South by Southwest Virtual Cinema 2020 selection.\n\n", "short_description": "Ubisoft proposes a Virtual Reality visit of Notre-Dame de Paris in real time, based on the XVIIIth century reconstitution from the videogame Assassin\u2019s Creed : Unity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.ubi.com/privacypolicy/en-US", "developer_terms_of_service_url": null, "publisher_name": "Ubisoft", "support_website_url": null, "website_url": "https://www.ubisoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes":
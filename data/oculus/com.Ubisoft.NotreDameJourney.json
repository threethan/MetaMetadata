490785522051_7060671143405339728_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lZQQjXCdHEQ7kNvwH4sNiY&_nc_oc=Adn6B1T9JiUg0ax-qNiLW3M8hSnBRODuX01-GJQxOcFxTeACe4FTwXJvj1Y2Pxk0UG8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw0DD0YV0U9eBL5t8VUywAqpV9aZ7jhUVmY82cREp_tMg&oe=69B56632"}, {"file_name": "landscape_4.png", "id": "5564456170299960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65402515_5564456173633293_8166203934336264507_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pvUSp551dAQ7kNvwFrbsp3&_nc_oc=Adn2ldszVTZzXfTGGfbosr8ZgVDPuV378_h8uApk9mrmMnakMYvgxhm7blxx7x4Ye1c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5mFkGxn7_94cxmCLSw9GYj_PcRYOAGm9MI6LGi9m8sw&oe=69B546F6"}, {"file_name": "landscape_5.png", "id": "634797031492068", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_634797034825401_6944852042907467801_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02CX_UyvQw8Q7kNvwHp0MGG&_nc_oc=AdmgNpN6SJlq3AhEtLYA4ZXLec3dn5ZRZg4tfi5PFBvLWvoOWc1Z59sIRFoJfBDfV0M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiA5LHjjPZFuVbo9YQ7xLWYt_n8J7mxP_QSw1DKLo-rA&oe=69B564EB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Notre-Dame de Paris: Voyage dans le Pass\u00e9", "keywords": ["NotreDameDeParis", "NotreDame", "Paris"], "long_description": "(Re)-d\u00e9couvrez Notre-Dame de Paris telle qu\u2019elle \u00e9tait il y a 2 si\u00e8cles, pendant la R\u00e9volution Fran\u00e7aise. Au c\u0153ur du jeu vid\u00e9o Assassin\u2019s Creed : Unity, la reconstitution 3D de la cath\u00e9drale a n\u00e9cessit\u00e9 5000 heures de travail graphique, guid\u00e9 par des historiens.\nDe la nef \u00e0 la fl\u00e8che, admirez chaque perspective du monument, et finissez par un spectaculaire voyage en ballon au-dessus des arches, et de Paris \u00e0 la fin du XVIII\u00e8me si\u00e8cle. Le tout au son d\u2019une fantaisie de Bach jou\u00e9e sur le c\u00e9l\u00e8bre orgue Cavaill\u0
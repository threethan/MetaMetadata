490785522051_7060671143405339728_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1q7YOKxOrc8Q7kNvwHklksa&_nc_oc=AdoTOItHsH6jk1kKdd5aE9EBNrDF07-hUmVObtNLd_QB0COJJaFJgISB8ducT00Mqpg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx5nxbjpyiQss0VcCM4tFpOk9kSbmItWz1xWEA0lRU1dg&oe=69C143B2"}, {"file_name": "landscape_4.png", "id": "5564456170299960", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/65402515_5564456173633293_8166203934336264507_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ku-t9Wr-JysQ7kNvwEkwQVX&_nc_oc=AdrY5cXA3QSZD2ng9kCRgvSKnzHttg-AAAhtWk-_xTJ_9L9rggC4KVTPiMIy4DDOCcw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6uLSr3Us5u-dZTKbRwp0pFr7NpCQYAFoZ9CYzsHr6pQ&oe=69C12476"}, {"file_name": "landscape_5.png", "id": "634797031492068", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001717_634797034825401_6944852042907467801_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFzI5t8iAM8Q7kNvwEgOsTJ&_nc_oc=AdriWY5iZJHy4zy6SEWX15tyOv6q6baw4FRu5WgcWKGGkFPsRuHj2xIiiCGFi3k-F2A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwN6lDn7Hh_Q1Ghe5QIuG389u0L3npNw80VxH64a7f5ow&oe=69C1426B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Notre-Dame de Paris: Voyage dans le Pass\u00e9", "keywords": ["NotreDameDeParis", "NotreDame", "Paris"], "long_description": "(Re)-d\u00e9couvrez Notre-Dame de Paris telle qu\u2019elle \u00e9tait il y a 2 si\u00e8cles, pendant la R\u00e9volution Fran\u00e7aise. Au c\u0153ur du jeu vid\u00e9o Assassin\u2019s Creed : Unity, la reconstitution 3D de la cath\u00e9drale a n\u00e9cessit\u00e9 5000 heures de travail graphique, guid\u00e9 par des historiens.\nDe la nef \u00e0 la fl\u00e8che, admirez chaque perspective du monument, et finissez par un spectaculaire voyage en ballon au-dessus des arches, et de Paris \u00e0 la fin du XVIII\u00e8me si\u00e8cle. Le tout au son d\u2019une fantaisie de Bach jou\u00e9e sur le c\u00e9l\u00e8bre orgue Cavaill\u0
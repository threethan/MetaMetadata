Aae-zMG4VkM4KLbzDH7x781uvd3j2Ls-FYoQl8Glw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42T__-Po9H_3XBhjcT8_SVAcdOktNQjl7ypNX8XFyV8w&oe=69FB3054"}, {"file_name": "landscape_2.png", "id": "614240586776866", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75603734_614240590110199_5815528428338861024_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O93Pzu4v7cgQ7kNvwFzAOnB&_nc_oc=AdpVTffChvgc8HhhlGr_0K3IsBkVoUnORIcdyBKHgp4fJIMferAK7vOY4RX-SkR5GIw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ChPoLOilGhj5A79WHo39v45aGpGmfBe680z3Dc7RLGQ&oe=69FB3E48"}, {"file_name": "landscape_3.png", "id": "818343619180917", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031501_818343622514250_4705416194001481377_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hE3yOwpcUUQ7kNvwGbwVDw&_nc_oc=Adr7ddZQeBGnjsImr2zyB8LNW9GCH1Z0HHjNRAHv4ShwafuD0ZZWIodIFxpo0E9Dotw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53W-GhtaFDswj4oez3XzaohZ0QHmqIWByOKltE6groXg&oe=69FB44B3"}, {"file_name": "landscape_4.png", "id": "666181164406432", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001717_666181167739765_4216386184759446709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X67E9mYd1aoQ7kNvwG8NMwc&_nc_oc=AdpaYp9bzgEmTGx_dyBwy0gXxYIKt4qejftGsGPuwI91D-kzZZlBl8Fub-J-QvR_yWw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zBOhkS665jZ19KFS_wnI807UX4XAsMHdhFXjGUlGJyQ&oe=69FB5DCC"}, {"file_name": "landscape_5.png", "id": "1560540357694091", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86634395_1560540361027424_1829200862691206615_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jh3ygfYcj4Q7kNvwHRw4lC&_nc_oc=AdpW2XxN0D632NoZhlLtdkf5tiKophBA5REOhHTnWKrcFSHZNfirWOSaz52BPlgc8f8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ESCWb30AD3VulEMzpLiWEI2FYnGo7ZJ8HTQ3E7hI9OQ&oe=69FB4E95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Notre-Dame de Paris: Journey Back In Time", "keywords": ["NotreDameDeParis", "Paris", "NotreDame"], "long_description": "On April 15, 2019, the world witnessed as Notre-Dame Cathedral was nearly destroyed in a devastating fire. While the cathedral is currently closed for restoration, it is still possible to visit it thanks to Ubisoft\u2019s VR experience.\n\nAt the heart of the videogame Assassin\u2019s Creed : Unity , the 3D reconstitution of Notre-Dame de Paris was the result of 5000 hours of detailed graphic work, guided by historians.\n\nAdapted from on this acclaimed model, the virtual visit offers multiple point-of-views, some of which were inaccessible to the public, and ends spectacularly with a hot-air balloon flight over its arches, in a lively environment of Paris in the XVIIIth century.\n\nThis experience has been shown for the first time at the UNESCO Headquarters on Heritage Days 2019 and was part of the South by Southwest Virtual Cinema 2020 selection.\n\n", "short_description": "Ubisoft proposes a Virtual Reality visit of Notre-Dame de Paris in real time, based on the XVIIIth century reconstitution from the videogame Assassin\u2019s Creed : Unity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.ubi.com/privacypolicy/en-US", "developer_terms_of_service_url": null, "publisher_name": "Ubisoft", "support_website_url": null, "website_url": "https://www.ubisoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes":
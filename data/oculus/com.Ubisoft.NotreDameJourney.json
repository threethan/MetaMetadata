490785522051_7060671143405339728_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGC_BK8WNNAQ7kNvwEMyaVm&_nc_oc=Adkfm63JmZyctcnj5pEGXzMHgSElmKIxyXVC_ZLUs156ONMBST8Zd1-Xz0lj8oZIizs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw39-ZId9MCNVLcq_87ivKjQVjV1xKy94JhO0HoSX3Tlw&oe=69AD7D32"}, {"file_name": "landscape_4.png", "id": "5564456170299960", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65402515_5564456173633293_8166203934336264507_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIWFLKLeYFYQ7kNvwGjRDZp&_nc_oc=AdmnF3Ygmh2GYz95y5GtAxoA70RCcLjGfEMLj8jX4TkGnBELi7NkFGCZj3C7syJ2yQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQP1vFZEitI_ajkYC7y7kkPSBo7zWyju-VK950_JjXcA&oe=69AD5DF6"}, {"file_name": "landscape_5.png", "id": "634797031492068", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001717_634797034825401_6944852042907467801_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hrGODWSkZwQ7kNvwGbZCvn&_nc_oc=AdlShBtDglpwmhmEBF5hBMBxZ7AHHvmrENHgqF41StG8cgnlEKNNRzCmUklCF8K7ykw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIf7V-vg6Tf1SZ74VG0ucx2uTp2nYpIaoybO_Z2xJmAg&oe=69AD7BEB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Notre-Dame de Paris: Voyage dans le Pass\u00e9", "keywords": ["NotreDameDeParis", "NotreDame", "Paris"], "long_description": "(Re)-d\u00e9couvrez Notre-Dame de Paris telle qu\u2019elle \u00e9tait il y a 2 si\u00e8cles, pendant la R\u00e9volution Fran\u00e7aise. Au c\u0153ur du jeu vid\u00e9o Assassin\u2019s Creed : Unity, la reconstitution 3D de la cath\u00e9drale a n\u00e9cessit\u00e9 5000 heures de travail graphique, guid\u00e9 par des historiens.\nDe la nef \u00e0 la fl\u00e8che, admirez chaque perspective du monument, et finissez par un spectaculaire voyage en ballon au-dessus des arches, et de Paris \u00e0 la fin du XVIII\u00e8me si\u00e8cle. Le tout au son d\u2019une fantaisie de Bach jou\u00e9e sur le c\u00e9l\u00e8bre orgue Cavaill\u0
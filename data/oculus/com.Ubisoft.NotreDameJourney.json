x_w4vDtR037LwE-xj7QdNz5EFbTzLfyck7H78rQsA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVKDST5ITTP95Va9Ujxybprlen7S3yWxH3yHBGe93oAg&oe=69C522D4"}, {"file_name": "landscape_2.png", "id": "614240586776866", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75603734_614240590110199_5815528428338861024_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUBNMwQStyUQ7kNvwFGEqAi&_nc_oc=AdquAQVcBZRhIZvWFLjtaEU3zo-NUU7itT7zG5aHEAhftEPVYPjbfgJ4YKjOc65kfh0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4jgb4QhfHRYnS2uBM4vLluLA0osWRKODfSFxTVsmwHQ&oe=69C530C8"}, {"file_name": "landscape_3.png", "id": "818343619180917", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031501_818343622514250_4705416194001481377_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiY8uS1eUoAQ7kNvwHlL4Or&_nc_oc=Ado-UZRhN9naUv2xVwqjHvAUa_5XMZ-HlU8TjYWO3wFl5dwuY3gSNqOUhJUVJ_0ZH0s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwf6StnoR23iiT7dFO2ydA9zl0NavzcIQso6Zo3sj4ZTQ&oe=69C53733"}, {"file_name": "landscape_4.png", "id": "666181164406432", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001717_666181167739765_4216386184759446709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nBKmauGJWkQ7kNvwHIo_b9&_nc_oc=Adrl9k6KtuDhQRqPYdr85dofH5wVsYLoygwGC6HJMOaMKlItaePJva-f34ww324wjNo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7bF68rrJQobbUaaBraT7NanA8tjC0j1R8q1XChoHO9g&oe=69C5180C"}, {"file_name": "landscape_5.png", "id": "1560540357694091", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86634395_1560540361027424_1829200862691206615_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baYrIkU_JSgQ7kNvwEJVLQi&_nc_oc=Adrf7gIvaf88VlilWqCxCwYkJ4qHjT3HjzEC51FbJxAqUEyawu1rzFnE2rkJ6Eu2pKU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3cdI0i1TaJ78EPEgkV5Qijoo3JbIB7JOet5gVFTwTZg&oe=69C54115"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Notre-Dame de Paris: Journey Back In Time", "keywords": ["NotreDameDeParis", "Paris", "NotreDame"], "long_description": "On April 15, 2019, the world witnessed as Notre-Dame Cathedral was nearly destroyed in a devastating fire. While the cathedral is currently closed for restoration, it is still possible to visit it thanks to Ubisoft\u2019s VR experience.\n\nAt the heart of the videogame Assassin\u2019s Creed : Unity , the 3D reconstitution of Notre-Dame de Paris was the result of 5000 hours of detailed graphic work, guided by historians.\n\nAdapted from on this acclaimed model, the virtual visit offers multiple point-of-views, some of which were inaccessible to the public, and ends spectacularly with a hot-air balloon flight over its arches, in a lively environment of Paris in the XVIIIth century.\n\nThis experience has been shown for the first time at the UNESCO Headquarters on Heritage Days 2019 and was part of the South by Southwest Virtual Cinema 2020 selection.\n\n", "short_description": "Ubisoft proposes a Virtual Reality visit of Notre-Dame de Paris in real time, based on the XVIIIth century reconstitution from the videogame Assassin\u2019s Creed : Unity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.ubi.com/privacypolicy/en-US", "developer_terms_of_service_url": null, "publisher_name": "Ubisoft", "support_website_url": null, "website_url": "https://www.ubisoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes":
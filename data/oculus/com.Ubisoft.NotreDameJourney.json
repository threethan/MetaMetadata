Q95yiaQYO1tFUL2qkiCAUu2oZRHrrqR5S9uEUPD_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NI9IR0KcMU6jBTfT7K0C_ddY9xVRpbczIFHNUJvCs5g&oe=6A070DD4"}, {"file_name": "landscape_2.png", "id": "614240586776866", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75603734_614240590110199_5815528428338861024_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ie2xPk4QCUsQ7kNvwFtGtEQ&_nc_oc=Adr9UAg0M8C7aLHazBw8r404qu4vmklxw9b0u9HyAdv0KQhtyDaOVX8DXPRQlbTOFOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i6vU37CXZ5shu9XnuzVrIcuxnEn-KO1I3xtQ_jGV4kQ&oe=6A071BC8"}, {"file_name": "landscape_3.png", "id": "818343619180917", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031501_818343622514250_4705416194001481377_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fO0yfOdBenYQ7kNvwHT8Q1X&_nc_oc=AdrTClyT4ONDaD1SPrHwgHo42DJC_WNO_pjHP62xdIuQeV8lJ9l2yr4RfcfxwTdisqo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h9wtUEDmjpLydvbSzJ0eoWs9Ft0hQNnW85WORx4tXbA&oe=6A072233"}, {"file_name": "landscape_4.png", "id": "666181164406432", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001717_666181167739765_4216386184759446709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AujmGkU8dUQ7kNvwGQpSim&_nc_oc=AdrVFyaIJTQhFRx7WVE9UMyn6U39pim9GYmqSCgwGWr_jfTvevFX66pWvKGDkyK4_fI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lK7d7iGOJsp9UobjmEC2KcPQd7SCNLuKRpLlpJzIc4w&oe=6A073B4C"}, {"file_name": "landscape_5.png", "id": "1560540357694091", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86634395_1560540361027424_1829200862691206615_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOFAMhDymlQQ7kNvwEJizCW&_nc_oc=AdrZUlqur9cR2wW4Ke9lSiEH6iy6yqlL2YAx4fOnqNFv8cKsdpRMMWphBpf5VYz_c1Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xwgQeERMObFfZSIY2cMNCVWboMd6JOeyVxQgY_uX6VA&oe=6A072C15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Notre-Dame de Paris: Journey Back In Time", "keywords": ["NotreDameDeParis", "Paris", "NotreDame"], "long_description": "On April 15, 2019, the world witnessed as Notre-Dame Cathedral was nearly destroyed in a devastating fire. While the cathedral is currently closed for restoration, it is still possible to visit it thanks to Ubisoft\u2019s VR experience.\n\nAt the heart of the videogame Assassin\u2019s Creed : Unity , the 3D reconstitution of Notre-Dame de Paris was the result of 5000 hours of detailed graphic work, guided by historians.\n\nAdapted from on this acclaimed model, the virtual visit offers multiple point-of-views, some of which were inaccessible to the public, and ends spectacularly with a hot-air balloon flight over its arches, in a lively environment of Paris in the XVIIIth century.\n\nThis experience has been shown for the first time at the UNESCO Headquarters on Heritage Days 2019 and was part of the South by Southwest Virtual Cinema 2020 selection.\n\n", "short_description": "Ubisoft proposes a Virtual Reality visit of Notre-Dame de Paris in real time, based on the XVIIIth century reconstitution from the videogame Assassin\u2019s Creed : Unity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.ubi.com/privacypolicy/en-US", "developer_terms_of_service_url": null, "publisher_name": "Ubisoft", "support_website_url": null, "website_url": "https://www.ubisoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes":
tent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGKkLOI9RJrXYL2qNCsN7gbLJenV3DsF3pQGOzI2PCyA&oe=6B084FCC"}, {"file_name": "landscape_5.png", "id": "1560540357694091", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86634395_1560540361027424_1829200862691206615_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdqW7ycJVgYQ7kNvwHpdMBc&_nc_oc=AdqP81c4gGZKd5UHZq1tIIaXplhgIDmMrvSjV3yiUhEwu-rjXrQwxQ3I7Cjfddi8UYs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsFz_QT55I_4ZkxcbdVT4iAeaLjh5KCWmFB1KNLuPY7w&oe=6B084095"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Notre-Dame de Paris: Journey Back In Time", "keywords": ["NotreDameDeParis", "Paris", "NotreDame"], "long_description": "On April 15, 2019, the world witnessed as Notre-Dame Cathedral was nearly destroyed in a devastating fire. While the cathedral is currently closed for restoration, it is still possible to visit it thanks to Ubisoft\u2019s VR experience.\n\nAt the heart of the videogame Assassin\u2019s Creed : Unity , the 3D reconstitution of Notre-Dame de Paris was the result of 5000 hours of detailed graphic work, guided by historians.\n\nAdapted from on this acclaimed model, the virtual visit offers multiple point-of-views, some of which were inaccessible to the public, and ends spectacularly with a hot-air balloon flight over its arches, in a lively environment of Paris in the XVIIIth century.\n\nThis experience has been shown for the first time at the UNESCO Headquarters on Heritage Days 2019 and was part of the South by Southwest Virtual Cinema 2020 selection.\n\n", "short_description": "Ubisoft proposes a Virtual Reality visit of Notre-Dame de Paris in real time, based on the XVIIIth century reconstitution from the videogame Assassin\u2019s Creed : Unity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.ubi.com/privacypolicy/en-US", "developer_terms_of_service_url": null, "publisher_name": "Ubisof
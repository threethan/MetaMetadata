1820382_1716506969743623_5467693911012168357_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bu8osflXfhwQ7kNvwEi6n8u&_nc_oc=AdmHb4lQrtruhqSjfOhDqyRqKH383uPI0SyIfav_KDWjYR2Rhw81sKN9Z-sfkw_pTak&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoRjEeyUBZGO_m503bWOSk_-WGoAUe2R9AvzKCgLD0Og&oe=69AAE772"}, {"file_name": "New Project (3).png", "id": "1403299114214425", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823876_1403299117547758_1999219501802589543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqNeOi-5zNUQ7kNvwFiAMs7&_nc_oc=AdlP_6NbLiLF7yRgQC_WFsEpA0GyQKtNYQdr-odaHtCDSyaC2loKK0JnYvTCuC7PyRk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6RU3qVvqS3aAc1sEf1wBgdgiUtFmizT0h7oCNE36EXA&oe=69AAD6D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1406182814638637", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618251_1406182817971970_8152933936321516392_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgcbvFfDOVIQ7kNvwEA8VGX&_nc_oc=AdkTlD5CGP3ZdLDd-oGGMI-FhqMwi2HyjBu-pcylJ2hnNGXAj3qcAd183T7PLKNquKc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzIHezkgjuv85SnmMpRLSDNPvbFYSHYZ2YSclMSmtYSSQ&oe=69AAB108"}, "display_name": "Fire Safety - Industrial", "keywords": ["Training", "Simulation", "fire", "Safety", "Game"], "long_description": "Elevating Industrial Fire Safety Training in VR InfiVR introduces a cutting-edge VR training module for Industrial Fire Safety. Dive into the dynamic world of \"SafeIndustry VR\" by InfiVR, where mastering fire safety in industrial settings becomes an immersive experience. Navigate through virtual plants and warehouses, pinpoint fire exits, and hone your skills with virtual fire extinguishers. This interactive module not only educates but transforms learning about fire safety in industrial environment.", "short_description": "This app offers an immersive virtual reality training module for industrial fire safety. U
6-1.oculuscdn.com/v/t64.5771-25/491820382_1716506969743623_5467693911012168357_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1xv8CID6DkQ7kNvwFqZD2c&_nc_oc=AdoP6DempDoaMwr8kFdh3KxoybLGiN4WlAqQ13tZ7EupNT2_aSlS0i_o-UQsbdCaJ-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJKOF7sDzNER596puUV1tPJqG7jDr8W9Puz-qzscWJfQ&oe=69CA8B72"}, {"file_name": "New Project (3).png", "id": "1403299114214425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823876_1403299117547758_1999219501802589543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPoWR6376tEQ7kNvwG9jHsZ&_nc_oc=AdrWUI6mhmfFtkGLsoKso2fHhhUeErm1LpT1n6DzE2-r3KvAPyjQAcievZHTYrf9w8A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSr9QAFxwC3rRlOejudq8IfSwSqzTUEJgkrCfphh0kLg&oe=69CA7AD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1406182814638637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618251_1406182817971970_8152933936321516392_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzYIAEJWuh0Q7kNvwHn-shi&_nc_oc=Adq9GvSSpaHgO3ofLbhI1AKTHou8AQSYbq4U0nvmQFO5sIHxV6E1YRrsJknD8ICy-wg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxdu5WSbFH1UYa0D2_tZIc8Hle4wOgQmkM6oVfAArNnSA&oe=69CA5508"}, "display_name": "Fire Safety - Industrial", "keywords": ["Training", "Simulation", "fire", "Safety", "Game"], "long_description": "Elevating Industrial Fire Safety Training in VR InfiVR introduces a cutting-edge VR training module for Industrial Fire Safety. Dive into the dynamic world of \"SafeIndustry VR\" by InfiVR, where mastering fire safety in industrial settings becomes an immersive experience. Navigate through virtual plants and warehouses, pinpoint fire exits, and hone your skills with virtual fire extinguishers. This interactive module not only educates but transforms learning about fire safety in industrial environment.", "short_description": "This app offers an immersive virtual reality training module for industrial fire safety. Users can explore virtual plants, locate fire exits, and practice using fire extinguishers in a realistic, engaging environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.infivr.com/privacy-policy", "developer_terms_of_service_url": "https://www.infivr.com/terms-and-conditions", "publisher_name": "InfiVR", "support_website_url": null, "website_url": "https://www.infivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31555116630800878"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820559_1948643219235684_7273482840078363048_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7dh0axaL8kQ7kNvwGvoeRm&_nc_oc=AdoFnvIS2S8aP69SdmyQcdhOXXO653JcSgvyXRNV0D_mSBADUchs9IF3rW9_4j6ZBXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3FYvGjVMlZs-n8k5QxFzQ74R_P341FUoL5bARgohVQQ&oe=69CA7F04"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fire Safety - Industrial", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1753286760, "lastRevision": {"nodes": [{"id": "30308532342125986", "release_type": "SCHEDULED", "administration_st
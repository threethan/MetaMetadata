20382_1716506969743623_5467693911012168357_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76-MslAswM4Q7kNvwELyhJH&_nc_oc=Adk2g4OJ636nCHBCrVjhilIrBcPxbo_hT30B9fABpNZwhoEv6MB4th2ESVMqvqdn7kw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afsz8ITEYndx7EJbKUoK7NkpuZ9vf27mWBbnuHCQn79idA&oe=69A995F2"}, {"file_name": "New Project (3).png", "id": "1403299114214425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823876_1403299117547758_1999219501802589543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqNeOi-5zNUQ7kNvwGyZ7_Q&_nc_oc=Adnrk04Vvtwq-T6E9lg-rvg8e2gWwVzSEmRhb6Lfz2p1uRLSp1VBmZesKEJo6PWsi4k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsPxRNDm6dCeCnwsT0uuMlI1t5o1eeX8oEumVRzLplmyA&oe=69A98555"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1406182814638637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618251_1406182817971970_8152933936321516392_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgcbvFfDOVIQ7kNvwEQjahI&_nc_oc=AdnCFjMTPo2-nBxq_UBW6tWKVm-OKVNEUwrp99MGpydboAU-QPi_asVUZOiXIFZ3ZE8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuQFcnvphwTnsDjEuLhSDZbm1Pgf4ifPlF1fIUbbIUXDw&oe=69A997C8"}, "display_name": "Fire Safety - Industrial", "keywords": ["Training", "Simulation", "fire", "Safety", "Game"], "long_description": "Elevating Industrial Fire Safety Training in VR InfiVR introduces a cutting-edge VR training module for Industrial Fire Safety. Dive into the dynamic world of \"SafeIndustry VR\" by InfiVR, where mastering fire safety in industrial settings becomes an immersive experience. Navigate through virtual plants and warehouses, pinpoint fire exits, and hone your skills with virtual fire extinguishers. This interactive module not only educates but transforms learning about fire safety in industrial environment.", "short_description": "This app offers an immersive virtual reality training module for industrial fire safety. Users c
6-1.oculuscdn.com/v/t64.5771-25/491820382_1716506969743623_5467693911012168357_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDudplobsN4Q7kNvwFXjH0S&_nc_oc=AdoVQL-O6T22b41KhP-TjLTM0BTan5P3UTAzOreZvEY2WOPt71BOKFJjkvLi8Px4X_E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Q6cWS120eSbtIjmhpRauqB7PaCac6bC__J_sGO9oL3Q&oe=6A26D472"}, {"file_name": "New Project (3).png", "id": "1403299114214425", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823876_1403299117547758_1999219501802589543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jl7RDF7fA3gQ7kNvwFDWU19&_nc_oc=Adp2YYobCADyVED-gn96kxOKbGkymKskSd3wYn6xZqmEnFJvV5N04YVkXcQ04uzD-fs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KHQWd66Ya285LVysganC1O0l5UzF72Fu8iSvbHjfkiA&oe=6A26C3D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1406182814638637", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618251_1406182817971970_8152933936321516392_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HCROs-GWAEQ7kNvwHia546&_nc_oc=AdpXQ4QHUkENIkT2EBc7jCmmhDVmQMCUKBo6uXeJOr4u9qglgaMUYCzc7t3tPlouKwA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JJmGavff9XN7OLJ9Nm13aV4MitpztBNDbEObY0Vuc9Q&oe=6A26D648"}, "display_name": "Fire Safety - Industrial", "keywords": ["Training", "Simulation", "fire", "Safety", "Game"], "long_description": "Elevating Industrial Fire Safety Training in VR InfiVR introduces a cutting-edge VR training module for Industrial Fire Safety. Dive into the dynamic world of \"SafeIndustry VR\" by InfiVR, where mastering fire safety in industrial settings becomes an immersive experience. Navigate through virtual plants and warehouses, pinpoint fire exits, and hone your skills with virtual fire extinguishers. This interactive module not only educates but transforms learning about fire safety in industrial environment.", "short_description": "This app offers an immersive virtual reality training module for industrial fire safety. Users can explore virtual plants, locate fire exits, and practice using fire extinguishers in a realistic, engaging environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.infivr.com/privacy-policy", "developer_terms_of_service_url": "https://www.infivr.com/terms-and-conditions", "publisher_name": "InfiVR", "support_website_url": null, "website_url": "https://www.infivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31555116630800878"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820559_1948643219235684_7273482840078363048_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHhGXnRLKu4Q7kNvwFTp7UG&_nc_oc=AdooKFQwhMc9VKufDcZrsAvW3ASICB3a3QLTQIRBEjY3iSHKIw88giZZ_RB7oDt8NAg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o_V-09eRQykXl_dolSsSGBdFIFnQvl8c53Q_7V8toTA&oe=6A26C804"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fire Safety - Industrial", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1753286760, "lastRevision": {"nodes": [{"id": "30308532342125986", "release_type": "SCHEDULED", "administration_st
20382_1716506969743623_5467693911012168357_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EG0312vXzK8Q7kNvwG2gyjf&_nc_oc=Adm4Umdz3_BYkaS-VI9KCTVKrICg-I4wxsxAnuIb4-rr_hedN3z4utYCiTPTjrBrOFM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxen0J9gSxtgdexxJ6nf3gi9Y2QrkUxBBbEAVH6_3Nwxw&oe=69B146B2"}, {"file_name": "New Project (3).png", "id": "1403299114214425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823876_1403299117547758_1999219501802589543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMf4X1ThAp4Q7kNvwF30zhb&_nc_oc=AdkCQKbqpujCapgFAOYnmvrlwJnuVXxEoQv52BI2Mnqg62NUfxD3v4iDvurl6YEtOnM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_HVBsBP1iHZQjQrNkasXNTijx3VULFdmpq9YjzqgsVA&oe=69B16E55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1406182814638637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_1406182817971970_8152933936321516392_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnOf4QF58O4Q7kNvwHX1OZN&_nc_oc=AdlrXV_6iP1qjVzuzlQ57Ee1g5CgaKn5wo40B3RP6xVfE72sbgkfkQMFDKBU7Xi54AE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJYNsEnfS7JtiL04MzlSlcE9mM_ZilM7L0Zg3pxLuJfQ&oe=69B14888"}, "display_name": "Fire Safety - Industrial", "keywords": ["Training", "Simulation", "fire", "Safety", "Game"], "long_description": "Elevating Industrial Fire Safety Training in VR InfiVR introduces a cutting-edge VR training module for Industrial Fire Safety. Dive into the dynamic world of \"SafeIndustry VR\" by InfiVR, where mastering fire safety in industrial settings becomes an immersive experience. Navigate through virtual plants and warehouses, pinpoint fire exits, and hone your skills with virtual fire extinguishers. This interactive module not only educates but transforms learning about fire safety in industrial environment.", "short_description": "This app offers an immersive virtual reality training module for industrial fire safety. Users c
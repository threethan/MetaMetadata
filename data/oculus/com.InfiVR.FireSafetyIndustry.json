20382_1716506969743623_5467693911012168357_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76-MslAswM4Q7kNvwHeeinC&_nc_oc=Admi5Xdkh_dGheEwHiEbfCvCu9fx_Ao_Gb2DOYF8QKeCDsmmfe7g8C-zep5pdxuo9zk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuKhbtRu-TEJtPkcZFTA_JlcqT-z94p4tWY91YfRr0S5w&oe=69A80C32"}, {"file_name": "New Project (3).png", "id": "1403299114214425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823876_1403299117547758_1999219501802589543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqNeOi-5zNUQ7kNvwG96BrW&_nc_oc=AdmONKSJ41OffkN7OFv0DNxKzuB7cx1XpdFd2FptSOmmTFrKTARICL5UD-0Furpfqdc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft2let3BjtTHnhVn8qgtctqvE1A8TY4NBDcRqQwsVME5A&oe=69A833D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1406182814638637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618251_1406182817971970_8152933936321516392_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUZ2X_qXMs8Q7kNvwEj_3PU&_nc_oc=AdkBwA4hXuNgQFh84FknOyW8mIrZ83itrQJUN22YU9nQ6OlCZ_J15AFw243CIPCUv7o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuaGzHcVBvrhfQiYQ66aNIn9oeTHHW24FJCnD_CICNunw&oe=69A80E08"}, "display_name": "Fire Safety - Industrial", "keywords": ["Training", "Simulation", "fire", "Safety", "Game"], "long_description": "Elevating Industrial Fire Safety Training in VR InfiVR introduces a cutting-edge VR training module for Industrial Fire Safety. Dive into the dynamic world of \"SafeIndustry VR\" by InfiVR, where mastering fire safety in industrial settings becomes an immersive experience. Navigate through virtual plants and warehouses, pinpoint fire exits, and hone your skills with virtual fire extinguishers. This interactive module not only educates but transforms learning about fire safety in industrial environment.", "short_description": "This app offers an immersive virtual reality training module for industrial fire safety. Users c
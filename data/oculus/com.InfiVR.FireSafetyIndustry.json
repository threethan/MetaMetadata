20382_1716506969743623_5467693911012168357_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbjyTSwGqfAQ7kNvwGAAZNW&_nc_oc=AdkBOMOdi7iJPGX58K_2cyhSrOqzOeCj6CWqAfBhEUJRFyGl9liL-WPM0xXtl7tEbkk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyljsojTpwOtAkvojVPlBA_ono7R_vpDa12uqEToJXhxw&oe=69BE75B2"}, {"file_name": "New Project (3).png", "id": "1403299114214425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823876_1403299117547758_1999219501802589543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRGjI_wTLlcQ7kNvwFVt27X&_nc_oc=Adk7m4IY9KNqB8CboCvGJRrh_GoyJPc0qmNPXI7P0KTZj02dszAnfY2ed0eKR2-wPv8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnhvSXfOFDdE4hoImwIliYsPmgq_wzcaZ1cZOSoREB5A&oe=69BE9D55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1406182814638637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_1406182817971970_8152933936321516392_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leZz5xkEfLMQ7kNvwFIM5l3&_nc_oc=AdnPPnvnVqri3aqw2AjFKhxckmZl62qyl5irXEw1f9kMyTFohyVwT1mQ7w2SBBwFtiw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgGj09iqBjPshQscubZPAzIj-mEoE1-pmudOcLY4CgtA&oe=69BE7788"}, "display_name": "Fire Safety - Industrial", "keywords": ["Training", "Simulation", "fire", "Safety", "Game"], "long_description": "Elevating Industrial Fire Safety Training in VR InfiVR introduces a cutting-edge VR training module for Industrial Fire Safety. Dive into the dynamic world of \"SafeIndustry VR\" by InfiVR, where mastering fire safety in industrial settings becomes an immersive experience. Navigate through virtual plants and warehouses, pinpoint fire exits, and hone your skills with virtual fire extinguishers. This interactive module not only educates but transforms learning about fire safety in industrial environment.", "short_description": "This app offers an immersive virtual reality training module for industrial fire safety. Users c
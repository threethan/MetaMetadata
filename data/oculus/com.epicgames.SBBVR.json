kZ0Q7kNvwHCoG4b&_nc_oc=AdoFFcRJh6POYkkllq3-jdwvZfRPiv0cMWSN6ZvU9S1Hw34NOvqLpl394dOzVdiITm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeYLKaownWzjQXvaR4V6k4DiAGE9e7DkVT4ZeGcCwGig&oe=6A7EFC82"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8MaCJhzXecQ7kNvwF3SF3u&_nc_oc=Adq8088k6WkLhWwnpK2hempTTzwMtsxSw1qpVk5zUoexZxPWDR4lRVRoQhis8trF9vs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEY4qa7dDJVgIZRZ68JpFWUsDnlJ4cnYCjAo9mDDp-zQA&oe=6A7F18BD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oxO3tRzFzAQ7kNvwENMcuY&_nc_oc=AdqdjqoMXxz0dPaFcJDhMpsyIjiKWX6b1j3L_xRs5YDGlWY06vxn6Ryml2pqjtndiWY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcoCneHPjEkw_WCP97yWDRvYbHI5bqYVBfB3NzDhYNbw&oe=6A7F17AA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30Sq4H7jPp8Q7kNvwGOK-IV&_nc_oc=Adp4UUx2h6n96arhRgTgoPL7YYhNNUD7j2HDvF3ms25OLonfMfy7r8PQyf3LeHCPWWc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8OVtKHpzA30S2c9J-MAmIlHw_eyaaZuLIVHEKQXopwA&oe=6A7F2032"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_c4ojsFQXN4Q7kNvwECGcar&_nc_oc=AdqrAw6ZH8BWt2ORbKJXqnQLWuw3yc2f1iwatfZFSRsVl4XWxk6-6ihWtHgPSzg3ySk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0q-B7RxUsiLmNH0_fwP2zZILEbewa4phhqco9D5PZSQ&oe=6A7EEF26"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
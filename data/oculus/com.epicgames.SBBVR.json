enshot5.png", "id": "1175644900145733", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4FLZaTn3TMQ7kNvwEgjWaH&_nc_oc=AdrPOKJOmtqOBDzBXKBs2zyzGVUmNQXr2FNJrYQGN-j4Yipboyh4yd7RZUj218Ua3DY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTAzLw04swjnkFdf3kRiMC_MEBDI2_tbN5mI9b6GP45w&oe=6A68AF3D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1X2wsd7LkEEQ7kNvwFM6Asp&_nc_oc=Adq6qRdKZtI9oD5MsYsQ4zS9Du8vAcofW9f1Ez87t4gbcDLSVHZR0B_4wQ1R_hMNtYk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTU6gvNFxmqnlbnSlQ9rgq0SExArV_0FvuH_AgPfTGDw&oe=6A68AE2A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0tIBQchb5sQ7kNvwENLSRK&_nc_oc=AdogeQSAMKGmJFeAOcA12BtfiVW-c1wkdlbiaaa53-Wid0glkuNGZ7QyKN4-6n2s9RU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgdrB_LbTjUVMroTLMcVFVAMlpF7nlo42kC-oUOB73CA&oe=6A68B6B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50YttqWOr2AQ7kNvwHPiYyD&_nc_oc=AdqIC8rRzRscHfNtpZspyVCCbYtG0GV7Z9KSksM5wZgzSvcxT70Gc7FCU8xXVOqooVs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3--bOl0tZJw4zX-82wsPBIYDYGkxNHSM-HUa_bUENrQ&oe=6A68BDE6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
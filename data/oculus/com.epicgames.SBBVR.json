enshot5.png", "id": "1175644900145733", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqkq2wnKAxwQ7kNvwGazYH4&_nc_oc=AdrYBG2LROd6Tq892ZzfcfcrleodgdFWFWB1VLBhwQMLk5YGY31DS-BtajrefBBdYho&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGn3j6XmlXQpJwq2qg8keBxGUf8yM6L8UI9y_NrKIpKiw&oe=6A97443D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NSAQXYwLgQQ7kNvwEuGiCl&_nc_oc=AdoIqWF-W_GEAdXVuGsrQmr0kgj54vBofoURvFdJmU6yHxufGFWv5Q1_09jAuxm8swI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHamHwe4k69m4G3Q1obfRgW3-UGKU7OiVrrDib2-M0WGg&oe=6A97432A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2lx7f_-N14Q7kNvwE70YWk&_nc_oc=Adq9Of9ss6FGyckdPVpD4TUPJEVSRMBiF50tgI698pNGes-_po5ITykWEIxfyXuxACA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHsmGT3HGITdSPNELCm637OhxQV7JEXNS2QOMkYOq8hA&oe=6A974BB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnFovZDJJTAQ7kNvwE_wmy0&_nc_oc=AdqDjz0PkgFSoxULcDM4hBRGyCLV_HO-F_wl8Tk8ZHot_cv2DI_DxE7wrXGma1TkCyc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA4rjZAbnJOK1fpp_-y9p_Wed8m7zqZFOZpJAV_Mg71g&oe=6A971AA6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
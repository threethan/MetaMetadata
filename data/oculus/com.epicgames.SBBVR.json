lDMQ7kNvwGoEEJv&_nc_oc=Ado63qJB1QrJHI9AZU0zZiC9dLCAp-J-DUI8XYdTNDVh76yAJ-yJOiZMVp2womt5OIU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8XW71wSzFVeZX5_seLHXHHD6zLBBmehSxQxCBZXCVsQ&oe=6A298342"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MALiHpYg9koQ7kNvwFtYPbI&_nc_oc=Adra4ceH-TJn1EBF_Kj2htkr5hcyYTB4bM-_ZRC2QNnLY1M6azE2TX531A4aZNX4sks&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kYkXhOX08im9KlB_EuieGP_LBlG0rqqvfbFEf_K3lag&oe=6A29673D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bnMzlUgLY0Q7kNvwF4sJDc&_nc_oc=AdqcLdMtX35ak285ynu4c02oo0C8b4A_vzT8Z6ofCbanPKnMwcx7TuTxEbF9XJiMz2c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sN60xaytPiDOaKXcdGv88Nc-geo6QnAJ-FsM7lbgl3A&oe=6A29662A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBgg-W8gDuIQ7kNvwGINGb3&_nc_oc=Adpqpbt6vDxiwZiWA9EMMx0gyYs51j5ur1ucBhIXe3NBTyprzetNhFGyLhQ0vc51xAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96p6W5h0c3Ea8Ks6ZpaY8h42IqqprH7yj_Sd_iS2N5Lw&oe=6A296EB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cC5H9aT_VIsQ7kNvwHOZdQn&_nc_oc=AdoWcF1wiB1-lftuhPQgmeY_o59SKeUwbKNTIJ_W_Kewd4Eaf8L4lSzSbTYNXqdx_aA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Axe9AVlHE2m5wLoipWzal9oJ0B509t3G14XwPN9TZJA&oe=6A2975E6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
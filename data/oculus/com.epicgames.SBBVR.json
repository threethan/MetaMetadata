6GoQ7kNvwFstD7C&_nc_oc=AdpnIQamms-kjinH5ZV37wO1UMy5bUmMds0Ye4neg0d3QqdwsHJ5tMJGH6gTjlJrBEA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT09jzkl2ZkxxoQceL7BjwJ_upmI-6l3jDYSlg0jry-nw&oe=6AF338C2"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Eht41WKJlsQ7kNvwHdmSRF&_nc_oc=AdrV2x3oJ-bGII0EjtJ37J_RQEjulscj2seZRAmZ6_R4Y4NkjbFTbOiTeVap59Ei3hc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBQg7pu42jqOzhQOz68j90WBxOYNisGdOYPsUKIe3E1w&oe=6AF354FD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4MUdmFlp4gQ7kNvwHitJ3D&_nc_oc=AdpLmoksB-BaDG_u1U4mVRBWhQqtesaVppSndA3vKcho4ubgKnugfLZri0S0AfaZJr0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScCjm5fFa5AJK4juagCBiH7yK_Hu0OJokbACCm0mZPxw&oe=6AF353EA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9nPIBjvCSYQ7kNvwHnUM4W&_nc_oc=Adqyy0gcKULOS3tk4hmIE4wu3G7MDZe9VUU2yr6vTnfd1MzNjWWtApRrDPXwcdCJd60&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU1vsfYlEMsfTo48nAU9Lsr2PJUDqDSu1SZeySd7IWnw&oe=6AF32432"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKGPAaA2tnAQ7kNvwHv6wHJ&_nc_oc=AdoDImeo5V35k2yeCpAsii-I028NVV6OcDkxBExruzDfrg9HoenscbxFJCag1km3lsI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWw3iwoafcaqTmHyl53aVTVy5gHx8iwTOMNWzzntaBSA&oe=6AF32B66"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
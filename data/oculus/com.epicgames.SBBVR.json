F4gQ7kNvwFmGnNL&_nc_oc=Adp8yzBJQ6-H95sr1cNqxpB3zMflQx9TqwT_iAw6R1RxUNw8e4x79-d8bkbqxn39bxw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0TPiDJCMfKny5YWjtDSHMekX4PaiJyPDv0hQL-PLblw&oe=6A243D42"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWb_Z3dY9M4Q7kNvwFmkg--&_nc_oc=AdrbvKkYGpw-tn7uoqHnJ-87hiVDyC84amifFjGZ0GbaHcutxD6i2HbmXj187pnh1J4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sfLWiPiWdoLY3x1XLyGbZLTyn6O872qRiGRMt5FkvdA&oe=6A24213D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srw1DZZKXuEQ7kNvwE9jyxM&_nc_oc=AdpEyyvmj1MFqZFSCf-3xBBgxi8r0cm1qJdmfa9XGh_2Wjmu7KLro3hTLL1BYG6vuXg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-N7ltkNHZ_YDod14hDwEzQGhoz6K8WMi866WVOsw3Slg&oe=6A24202A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06rDP1f_In0Q7kNvwGVPPLb&_nc_oc=Adp30sjmj5z92XVpZK0uTsnqFa1ctNvh9U2oFkFjHKKY5obpFHH25xMzANQ0dCOn1o8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SN1Eu5cMrHeHDusfq98sDmPpc29YZ7JAOQl3UgXk04w&oe=6A2428B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6nLRwb7EKQQ7kNvwH52q6m&_nc_oc=AdpFXkzQzf5oecH5EXu3-b9dhZIpFPMPaT_rVrWh5Sjyg56DEwYidSSXP4-of3X-Pms&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KJKyTfQ_oNp0XwTN5ucLQNydspsj78Eqb30wNUhJgBQ&oe=6A242FE6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
mPEQ7kNvwG6wMt7&_nc_oc=AdrGIG61EK00V3t15TsCKazd9vIrJGx7cyMra1jPeHV4nvn4Ew4t-gvdzpba4afEgwM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ms_-HZuOwgK8dbUg2DYci_6Tefcib5ErW9WeQWbAGTw&oe=6A47D5C2"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgrZt0ClmscQ7kNvwGO1GJe&_nc_oc=AdotXB8W9G1EIlBlJpwdzuloJ14ZZGqjr_HQaevR71kiJycY5yWkb5-LfsB-cy4dots&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8Qp0YTIWE5F6SMWMuAKHgjgJZSiOd9mVU75uLKC3o2Q&oe=6A47B9BD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdANcVERZG0Q7kNvwG7Bk_M&_nc_oc=AdoQ2FJsb-r1ku9DkvnHipsvcI_iXn-vdiXThABm-DepeLAHUIh_-L0jCs6K1S184Vk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GILkrXKfjHZoe-QaA6bsUnWG3g9s3bFFJUgUizswkxQ&oe=6A47B8AA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ji1RtL1_6eQQ7kNvwG7Limy&_nc_oc=Adr4XJpTUT7Uuy9z8v5N4PeggU4ubbTrtAQrKAAw2HLER7TzDtiHCJHstneFxG5YwUw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99m26frppypndDjTPrqNaYbM_yoM3AIsPRXXu-zZ8_pQ&oe=6A47C132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1zY08032BUQ7kNvwHS8JN1&_nc_oc=Ado1MvvefC1sb6D6oZULz7hNZYYxo7fe4CCjNWalkc-Wwafjflng_57u3FnUiR5U-xE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YQ82rkmrcpFIher-d0oYevqwkyfPLjUAm35UG--ioWQ&oe=6A47C866"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
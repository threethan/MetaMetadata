mPEQ7kNvwFUWELW&_nc_oc=AdpLIooWA4GujQUowo_OOjMmbyBtvAPXf3oQmUJOZBNOKao7U0Qgha9aaaUxSJcDGe8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3szT-0Y06PkdX33pXq-fxV7JnTzI8JqHc-uMO2D8zkQ&oe=6A4A78C2"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZtpdSwc7gcQ7kNvwGxWsIo&_nc_oc=AdoQOEzXmbO3da662o-gbzBZzIc-n_LtT5hsuayDAZDcP9xaFmMRXWYbHURF7Uvedvg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARnh3xSOPWP3Rai7CkgdOodo2uyOAszcPA9Ht20U4Nfw&oe=6A4A5CBD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdANcVERZG0Q7kNvwHIQUg7&_nc_oc=AdqpBQOarFdsD6_IYFmmmIiMsIN3XqVdE450VC9OKgMe20bKBvO4vxSCoLim5g7hTrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDR7KsNxO095F8EdbeqWfN2b8vXYxkUfKzyG4S2gWg6vQ&oe=6A4A5BAA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6US5_IoemIQ7kNvwEeU5tp&_nc_oc=Adr9GxlOUCqskXsbupqzopGW1Na5cKAPYIx5D8Mg5UNZfXYg2x6jKRFERziXOjCc8Mc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRxZIsqUvfClaFbii6m2WbLrtBxbrHcUASg11E7sZJDw&oe=6A4A6432"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6BDq8H9hPUQ7kNvwE14mrn&_nc_oc=AdqWeqW3Si4lOokqTFoYyjAKXsR83Oyl0ZRLH9_YgXC3r9GGOjIa_O64Dn-PSRm0JSE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDm0exkM2SSmQhvtMjb_v-glSXeVqA5C1PseRGMy6vPXw&oe=6A4A6B66"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
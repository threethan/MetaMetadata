b8ihTdkevqAaRzrwuHOQBAV10Xbl-GqQHUfxQM7CbTYYpJbMTAxQLaEOv0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwd1ZQ61w1o8GJ2NYPSL2N29l47mI1gD6ySzq69KPi2Qw&oe=69AEAF82"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQRJPZYEwgkQ7kNvwGI9jzU&_nc_oc=Adl553I2c9ADm_C2dzBXc9Za3bVHfmkHU5ae4SX5y2LYUPCyopEgFNfVG2mYDi5WXAw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTqRvEasfrwVeLsqJN2lIZ1R0UnUks3QJDYJxUUXompQ&oe=69AECBBD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJNYl0t7HyEQ7kNvwFpM50R&_nc_oc=Adn4up-Yh_91duBFHis60ZtxtmpUuWBvQDH3jsENLSRUsvmFnWdSn8iO9OWXmjpNqD8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1japOO65zFnwWc4nyULNDWEH0fvc6Ja6yS2MsmOxaNA&oe=69AECAAA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pmi8dNIa18YQ7kNvwHl_0kA&_nc_oc=AdnfHSLyNoi7TW88A4hkgdWlw_DB1XvkhH-KxCqQfU6MPtR6Jimq49UwWDH3MqWcszY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzahFZWi0JT0LKg8yCnQnuS335-wJ6b6kxnqRkEhNr_Tg&oe=69AED332"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwJrqPDtymUQ7kNvwH6H-TF&_nc_oc=AdlEILg9I_UVPSvYXoPVaH93wRPc_WDAk6uYVtpAzDr7fnPNnk7qgz_n5f9XMFG0dKU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOrICKCBVn7A68gRUzifFps4G3SsVMj_KILCfKDFGX9g&oe=69AEDA66"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_a
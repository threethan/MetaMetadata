koQQ7kNvwHy5yLp&_nc_oc=AdoLUZX8MJ1_kVV3h6ld_eZhox0LuJYFlIg2ZY1GjdB3MlJ1Jn3SB5qbIGiXe8JAQ2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1rYc_pUaUjyIY1yY_t3rh65251oB9u6Thdxm2aF6dmQ&oe=6AA6C1C2"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjII5VnAJskQ7kNvwEsu1cn&_nc_oc=AdoQ_pP-DnWENtWKs09409XIj1ryJg9UpmaTszlYK1nbWf9EwUHc243rD9aNFTWxqrM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt8LnNsK7nUFuThd37WVEkfz5hEs1YOoqXiS6DDWUJcA&oe=6AA6A5BD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0KijYQPVK0Q7kNvwE1o1zc&_nc_oc=AdpzL80eTy8INMh_ygT5kE-Dajy4l9YvC9GmvtzrreHJ4FDUxgbrEh6lRefTqGXXm8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH64w5B80elvL8syJsneAyEOt4Yd2g8tIJRJXptN03Lg&oe=6AA6A4AA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3yfm7jWDuMQ7kNvwHLFYcl&_nc_oc=Ado82R-AocdHO8LddsSAHIx4jXOY7_P7Juyu71C-8UYIGgaOiyYQiedDuFGTbzlTsB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnIx8jygxlek2Oe6f1qAE0Hfq6K7rr5O0zdQz303in7Q&oe=6AA6AD32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb6exn4lvV8Q7kNvwH8JT4c&_nc_oc=Adr0BmtY1WVb7YKeSVR_kjLu_1cymP5zksbQa0Eiog0Cdtkav_r8rRXNB94HCfcVaMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmXRjCPHA6xFwegKPj7OUfenwY8f4VPbMwoL02hLaCYA&oe=6AA6B466"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
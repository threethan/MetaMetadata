SaQQ7kNvwG0Z55r&_nc_oc=AdpqyqMcr7FYuyJQHwhNnkEPy0BQRERUGrknNovRb3RvXRuLmIPLJ7uwLicAdIfloNs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pUhXSB24gg-r3ajJJrKkXRCapiIlcIh5etLGWsFPlZQ&oe=6A3560C2"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqLlDKZPHocQ7kNvwFdCLS8&_nc_oc=Adp04sriUknTRCkwKrMlNOvUMsMN06JBIzELNly12kHicG899tTrbYWymLBRrtciXMs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qtcp99ozg-i95OJazuL9eBD9YgVbqs9C6htqnDYKTZw&oe=6A3544BD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKNdRdhjiWwQ7kNvwHzdiEf&_nc_oc=AdrrGv5WRVnF0fNAzaoUAoF5Rhofrga0qRkLOVB8IQhGZVRM1ATSznyj_jgw0bq_c4o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hvDI9mfbNWPEGjLWntZ_RZREocb4TcsdEm_txyP1DXw&oe=6A3543AA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J03tbIcAH78Q7kNvwHQoj8l&_nc_oc=AdqtqQJz6NzSdGt9U5oSiJWXsX_slfv6sy3gG9hQHVus28klDwGEb5TYaNi5PXpUkRQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZWKZw_MbkMLc1oyUll4T26NqvKK18lzZqlVcUD40Lqg&oe=6A354C32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxD0Dv1zfN8Q7kNvwFOmyP6&_nc_oc=Adr_7Ccyc6fzTdqVfAOdJs66hQDeVBbLaoInY19EyJC5T1jw51pxu6YxoxEgZpY2dp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UmVcRPY5vk6N_xOZNh9UoHqpgdQ1xiSIlRPQSC8suew&oe=6A355366"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
oq0Q7kNvwHccxBy&_nc_oc=Adq7LWLE8EzZq7BZwMN-43Ec4b-I_PzqEUZ_Womhj3dj0VjWlYf34fekATi6yNEy7Ho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIprbP_3zVFrSUd6Mny0PKH961Hbty1ZBiHt-FY-2GLiQ&oe=6AAFFC42"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hsm48ppd5ncQ7kNvwGvYDaS&_nc_oc=Adp9cUxsYe0FD4DaafMhNHetDs5rY5R3pN6fK6_JNhGDjAxb7KQdPEvi5v7KH7BiD6s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHrz0PkBr1tdt53FE6VMmjenmgObFvvDHLIXbZt0R6vQ&oe=6AAFE03D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ0JWfLtY_IQ7kNvwGTh3Mq&_nc_oc=AdrJk0xDaKJbNVhmd8wktciD7AOc7gnYyPRxhwYB3991vc5rUOWU6qOSI-EXwK44RtY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2JDok9dGpfpdgAJwOmrTnqYzHvwdBgUd-UYTPwkywIA&oe=6AAFDF2A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJXzF1zNWTUQ7kNvwGztClx&_nc_oc=Ado6xDcRy-7ZNX1oG5tbAo2su3ToHN_OdEOBcqnQypQ9R44FdUNiZJLqzwfwgwOOlOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqtOFHrqKox0T1h07rSkceL8C9kGeA9JYGTq3zyJg47A&oe=6AAFE7B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSLpJYfPh4IQ7kNvwFJHaSM&_nc_oc=AdoAZ1RKn9xmipb106jfwNVy0_twA4Fpi8H77RKQJunHqm2EnbfRZXrEIYemfdcXYxw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0L6qkpdvesK1SWBPwOcqsR7iQkBpp6K3s02NX-3c72Q&oe=6AAFEEE6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
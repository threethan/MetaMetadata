LHUQ7kNvwHL2dun&_nc_oc=AdojxrsVnz2nFOS7_i3woRJMc2k4DTler8fOqY_dbjcj8frcxEOMFYit-M142CGnd-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjOnYYMntEMl2Eg0G-51H8N99odqN8ycXICj-XW-zCBw&oe=6A7C5982"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5-QoeJf92EQ7kNvwEAaecp&_nc_oc=AdreUQIDJeAwIXhQSIfFc4MX0CEUkVTZsoYwuv6FpjFI4C9fJplW9-h71iBXwRxOf1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaCEGbHhfOIwHI031jl2nB4rx-lxkfPizEOEEI5-bQbw&oe=6A7C75BD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cz5N6bu0lRoQ7kNvwH1tAjr&_nc_oc=AdqfPRbhpuhk3_ubZdma2CKiuyU4xBwCvJv2hKOM0JBJCMNGaQSnjGvhka-QU4woXZw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZTcnVExNoSbG2oSOjASrWc8vrYaHWNXUwxtp0EanKmg&oe=6A7C74AA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wSoG_bLE3QQ7kNvwGY6eYX&_nc_oc=AdqHcUy0PqSliwsTzkWDHBd8Kg9h1p1X5F8W5Rr7vJZlFE0S4m-LrMfGY5ROZNE1dok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVcbSIMdYGoyFMjFjXNYqqLgVT8SCvLlZXppvZNOTTAg&oe=6A7C7D32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_c4ojsFQXN4Q7kNvwGRwBcl&_nc_oc=Adoo4pPQljd4MfuFSrw31aw68KNhMdrPqchovCSFyCITuhgWj6l8o4s8EGFxeHJA84w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpHFUf0aYBp2mLrqAxupyHZA_1r7wWCN3mLm_rEEt1iw&oe=6A7C4C26"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
-c4Q7kNvwGKzctl&_nc_oc=AdpJCjOA4njChCV7ZHj6G6sQmtgTUojt8RHf2spzIyHDnlTb4j4w-XLTKUK-fDlI4fc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LXIj8-p3PxOXpMiV9e47v7A2dy877tovVgnE8rArV7g&oe=69E76002"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMkt76SvSkAQ7kNvwEHiSDt&_nc_oc=AdoQpk8cDuw0SfBYcBJImW4fwAmXJHVOgeI-S0syy_1F6E-cJDGNy0g42Aa4Ox9T4d4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vLbDlWOKvRkDsiaFduwtJfPbD3ZJY3r3TA2h-TqOcNw&oe=69E77C3D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RCW491m0wAQ7kNvwGkMFQr&_nc_oc=AdqMTUzqkDRsOy60YKsfiKBobdITWaQn3z2zUh1rGnacMvE3rGLfTEE6Mrha47IdjLg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nVAelGqhB03a-tqVIPJEorb6IEfuv_RgEDI83u3LyRQ&oe=69E77B2A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSfTS8yxXjIQ7kNvwG7EPpk&_nc_oc=AdoSkfYGG0njA2hW77BQUzCnQg2XcC8uyF41O0lsay7qUh16WaZyQ3J45d8CpXnU5Vg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qVPMkOshuVL74AQk1-UXawMfTK0KKzEZ4bKx1gjLDjA&oe=69E783B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lt1Ywg0-7iYQ7kNvwEuWwjv&_nc_oc=AdqtTMn3dt-TWFSEt0sSjK53nmxX6L7-PkT6qbViwE6GyYJVjgFB8YB1KXNCsM5XFbk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2t8YYQckyeW0xgfwMnYWh0B8_ahlS9uyZYl0pmDLTNeQ&oe=69E78AE6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
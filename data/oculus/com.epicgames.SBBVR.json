1joQ7kNvwH7xhkl&_nc_oc=AdpmInREoLpKaeZmKvSYuBLR2D19HoGkiD5NRJTmrmB-ziFKLOJSHzwCzUSSNCLyiTo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv1xYTSIgzUM8aQIo1HTESLyU7-XbbqnooC1gRi7DyNA&oe=6AA2CD42"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmhy_8ZpoBAQ7kNvwEzw_3y&_nc_oc=AdoO1fwZeYf_1XTBR3_pMu98egAvI7cKENJjTnhi86Bt1N81UNe1DJX-Nj0fJwTOFyc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQys-4rIRWY-dLZQf9hfvGJAeETgYXbuQjI28qB1Oavw&oe=6AA2B13D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVJfpcZszE4Q7kNvwFl1bBg&_nc_oc=AdoaAAIByA-Ss15C3lZpEheb7xqb0Se7Ws2z2wB7ErJB-A0D_Al9DpZ0LFsYVVN5JIo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBQQJ4Gk3oYKF6rgXnCBf8UTEUqapRxtvVA5S9EZskUQ&oe=6AA2B02A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kP45w885WIwQ7kNvwFglXKq&_nc_oc=Adr3FmjnSTCj0Y6-5O1UWGCAjzYwuEpz55i7szfsTGemlp30zxvmyry6adQp-hFbGuw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVG4am7m7yco8m1c4FU2vAbemNSxSKvnZgmQZJLFNJ3A&oe=6AA2B8B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0ybL7OGWqYQ7kNvwFfZRjJ&_nc_oc=Adqkx5FbYWuEOWCMRBdOCGCwAPFTzk2zupd5gEChnIjsf4ez2KFYOuZ2ajNGYKz-SQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDV5q-9CaZbz3a7JQcHWtju3vbibibEGwH9BOImjRk6Q&oe=6AA2BFE6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
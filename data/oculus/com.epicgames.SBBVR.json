waUQ7kNvwHbz7qO&_nc_oc=AdrqFoOqQ1ylDqUoe06RLcx5xXWfTWVB7AU0N3wEZ7HFulXtnZBok_7BZAgl_GF4ur0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JEpAJxsmzBju-YjwGlVsrublLQ3nlP8afLJ6dJWMRjw&oe=69DF7702"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgTsKhUPYtQQ7kNvwG1pGlS&_nc_oc=AdoP6SX3vHv8f3JKpUphY6wLrljhk7T0o_efEcELDqUb6OpHU3RVBJac4sphODe1fSo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nBgPi2OwFkKZRvNfpi07Z3yzDsyhBNvIOnb-xB2-EZQ&oe=69DF933D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1s7zl_XqqHoQ7kNvwHkBBGY&_nc_oc=AdodYEKVGdtes96CZCMvhFVgvxvDsmYCWG0WGRnTx0v25vTwet2MSKNTQOITVK6CReY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KlSzDE-RVgH0uTa2dwlFY3W5qqabkWLtSDP0P9f05dQ&oe=69DF922A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUZpCYuUag0Q7kNvwE4An1Q&_nc_oc=AdpGiLAiwyi2bPot4EyFcb2BzQTeEVPit6mOHRUJ1S6z1W6aLAQbpQiBrjzozQx1DGU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TIYRDHFn7SDl1q0YsU8ftZCdfXoAIP37zSg4Cd_qRLw&oe=69DF9AB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5cJW9vl1iAQ7kNvwEXa6T3&_nc_oc=Adosn1LiXcZxd_BqKzCdnCKgdDoio9ixbLH9JSP4VjKtL1-dHmWisZ6DgutFVqWeYic&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TOrsELlFSXr4gjcOaN0OjRP69-QYR21bNVCWJcW90gA&oe=69DFA1E6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
ZFfE1mYQzjoVklyGe2ZaZK9m-ECvK8-RSyBIPVJt9KlkmQzVXddwGoMhxg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJLB_8c_JDJ457B522sSe64jzNjETVBZKDhZOT8aX0LA&oe=69BD3002"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV4nO6d_UAgQ7kNvwGzF_4M&_nc_oc=AdkTj175wr9lPyFlkntzeyBd2CEOMGVT9_QcnmWvbcJLi_1ucgSIZjWq6axFD5gQe18&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoWWLD-LdRhdNY4a_C5fGePhNRmAHESCO1DB70d2sqYg&oe=69BD4C3D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VVkKM5LlSkQ7kNvwGs4387&_nc_oc=Adk30afCvg4Vkv_E2kxoQZlS7vf-CrYG5m8JvO1evsYoiqow1QidzEKdKnoMclAMghU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXmoHLojQM-EsFyTtluQw43t8nhx8C7nPVDyAkN6uZDA&oe=69BD4B2A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcVrYmmsRBUQ7kNvwGukJhf&_nc_oc=AdlmfhweNs1C1JCpxNq06d8iUxQy-kniUsoLGvNjXmvbuT4hmGWaGbn1SadZz7AYg0I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx74ZRCdVBilRLy9pLdy5klY2Jj6XzHBUeLG3bmoN4a7A&oe=69BD53B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSSQFE6jSZIQ7kNvwHSS6-6&_nc_oc=AdkoxmdCYVLIgycrTLdDvfoKAWrQOLiP5wfR1xQOhxf1jPyX1qHalTkIAlZpS1IBJ5o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwduxgRhUD_45pT6VY44sfvvvIIu3UfpmWB5V4G7d4W4g&oe=69BD5AE6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_a
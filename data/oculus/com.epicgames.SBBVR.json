6_oQ7kNvwHkhXLc&_nc_oc=AdrAVNw1fEV7LbXMOilno1UPMgq4AsJv3f7_WB1rpnHYnr_vNn2AQRSKjFDp0v7cS_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-Aet5EhqLJzB4TX4ACHCE2oOGBqc5sbHlbzV5judvjw&oe=6A69E482"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3v6qAbjQ_TkQ7kNvwHmlcDT&_nc_oc=Adowc6nErgsd-X6H3169N-Y2lzysC7bpFpLRIKin4ev3_Ce8x6srIKAICpEieB9DHYs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVYqnFW2OI2pcRGRs8DT7Og1J8S1fxtOYExbnB_iCWcA&oe=6A6A00BD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1X2wsd7LkEEQ7kNvwEPLp4b&_nc_oc=Adr9IDTsIxC21SbY5e6on6L9V-JA9AJqzTnnfHxHfxX99GZMh_DZ8LPnGoJcQwHTfmc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDftV3_zzSJ3-Ytiyx8tue-fvIBgGvryi3B6Vq4NEuVag&oe=6A69FFAA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2Yx2aBxD_IQ7kNvwFUkdvA&_nc_oc=Adrfze9CkVl2Zxo4-I04jYWopPSaKqOCL9NKJoPCA7NdbO3oSodevQJfCTVFK4I_-KU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTJTPdv4u-_Nq8WGWtfYhrkuXKofmEfNz7iCGurUa9Mw&oe=6A6A0832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50YttqWOr2AQ7kNvwEUJzXi&_nc_oc=AdrDxqkm8aVUMR4oPs1Vu-3PW5N0ZE4Umu3nmE58XCdGTB1TkcAfBfgQd3W5y7L12Bo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhXsl-1t6orNsEVTGr7v4Yhvj0-gpfYgTmavVGfIsr_g&oe=6A6A0F66"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
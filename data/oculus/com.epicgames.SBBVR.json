mPEQ7kNvwESB8jF&_nc_oc=AdqQaiax9--HqQL844gzmLQnFAe5603Ibr7r6bIkCWiiXMVislMrb2pLvBGsCuUDp5c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmBt1R6jke4dvzevZvR_tCmfY05qHultuVWz-8lWGdqw&oe=6A75FA42"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETE7MSsW2usQ7kNvwEawGN4&_nc_oc=Adqou_f4Gb7nUW6J_43wO3yK7759rHgrwnEYPyFzleRgvpC7ToVpFOFdRuIWELtVQ6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6hxscEhINX6uP7tlWn7yd9aGKSxXPVW8vE-_tu_YCnw&oe=6A75DE3D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyV70ylI9r8Q7kNvwGg7i9H&_nc_oc=Ado8bFj8xFkXH_qLNXuvnIiOcOCY2SNKWRpfhcxKsSZDuL4qARSN5xK-RWr_AZRycuo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBj8E-RrKv7TheQ1Imx-nmUM0UAvEJz770z_OasfOYfg&oe=6A75DD2A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5RjSGfaDa0Q7kNvwEHdxAT&_nc_oc=AdrFYN0SBI9mz-2WYC0orqF7Vd_N0GakjRB-I4AnbNeLQ3-rtuWA7C5rruzr0Wjn41I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiPPw887rtaskqk_zRbOPY_m-XW4CAqb4lMm28Hm1j6g&oe=6A75E5B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiFzGMiH-scQ7kNvwEQOnO4&_nc_oc=AdoxqXPCBNIPgzePmJNOEjGgDd8bX4qvT0Rn6m4hp7wJIPBafGrvNhybE0Zkw-aNPwg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEstjL4lMfBVwHx9W-VPu0iWhtvgaX4VrFE8Qw_UaSxHQ&oe=6A75ECE6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
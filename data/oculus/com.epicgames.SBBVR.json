ZRUQ7kNvwGJA8Kz&_nc_oc=AdopTDqhN7wCrQhe3Uaa4WX7VMjUiKFsz0ULq1ykkR8Ek4ZjEUOp1prRl00FnBwgj10&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9_M5ALJvPlcVufuarF1uOQc6RJvV4L6Lx92Lmb4O8-Q&oe=69CE5382"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAM9obNbVyMQ7kNvwFATy48&_nc_oc=Ado_RfNS0daTw_8DXpvbaYSk-D3e2maFt-JEUrjxyRy6KE2HT9cyTITXtsqDvFnVUkE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOCKULfFqiZHLp_eC0iK76Z2FlMGf2hh0pZlNbap111g&oe=69CE6FBD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gxtbpkAY4kQ7kNvwEXLQQT&_nc_oc=AdrAfjYAYy7KPzoHsZk0hhGKcX_1XpvWp2c6IMUHMdKUPKOkfnm--I1zg7-lsaB0KUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw36JjGHdzhZV7wQ5jbKwXnoRrkuv0dz4ley_PwpWlIlQ&oe=69CE6EAA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9p4t5SwYToQ7kNvwG2FN2z&_nc_oc=Adp1MZPirlwPeISgZLMcbq9YR9nhKxC9Sgb26sQdb-BNAyO_5X1_muCNNiURU3xIepc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2XJJibVMynbtSYYe8QaYsdGBT6l5PJj5OMJCSPS4pBQ&oe=69CE7732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pv1zPGqqNFAQ7kNvwFUwgos&_nc_oc=Ado5OawvA2TH2HFKxvx9f5m14usRKjVlazHNLQSo89_IgMpdEbPEayXFLnuZIaybmgE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybnpXFRyd4DNLJ_u_3_Kc4iSu3yQMbC3KlIfGHupQ4tA&oe=69CE7E66"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
fh8Q7kNvwEuHC7x&_nc_oc=AdpSbqkDawE4JAB4UBbJq8YiXua3MezOQWwhkNIoz32DSoWu9I3i57wnrAIz8jXzHY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpblfVxszOXSZJAuh6H7jP3nTnXuNI4HUdXVSll3oFdw&oe=6A649E82"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kws3_FIUQqIQ7kNvwGWPmYY&_nc_oc=Adq2WJtl5PQbpViUeWX7YnkRVMwGc0lSemcJoBME9bu0TiyEuGFlm1ZeTH_ZrI-FHxk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKD6MgEFTh_6GSZdYNoOMlEj-vfb-guIUsY16Tra2XIA&oe=6A64BABD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W97AlTQOU_QQ7kNvwFyfvi8&_nc_oc=AdpJeJLi3vuZaBgzZ9V2G116aAox3UYCwRyflI2GGxvqvX_v33V46bHHsSYAx3HzRV0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGaNPp5qF-1Or3fsRJqAY6No_UZQ0KjpuqAqj4R5BW4w&oe=6A64B9AA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-Q3xgogAysQ7kNvwGpvjH_&_nc_oc=Adr7oWIBsBTHXfjfjOtxUorwU9QHqPn432vv4XRD7jYWQ7Q_jkpjFLaya5kEP-VXsGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw57qjq_4NQ44HgY9YRoxRay2Icz5Y5qM9-S4HM0PpOQ&oe=6A64C232"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_QfsfMzrdcQ7kNvwHpQBEl&_nc_oc=AdpNclB6tS8S3mqlr7J2thH9RHquxBLcMAoYM3LR-eA4LZE8XDWBcClhENEClrEFcHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4P7YlLghKhgDdXkrOvsmOrr3TdsBtv6Xjuwg0V4o2Bw&oe=6A64C966"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
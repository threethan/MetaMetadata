mPEQ7kNvwFiQURx&_nc_oc=Adpngp4wrbwjxvGJNaeuFlW2HPafPbY2T7X6o7ERVu9z0P8TgXfd_UH1jA80f6Y_eG0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWlLg8k4Z6MB5t4j1cBjjZUPeD9O6dfKOFcqz7-rH_1A&oe=6A74A8C2"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-px2l9OLIkQ7kNvwHPKrJ-&_nc_oc=AdoYErYio8gYA9G75VeIuE19elnDWKDSl-X1RB-7Fj1vDAs8qWusmAbD2QnWjEctnPU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOXc_gERldCYmPcDXZhoObTmddMOC7UTpwr1MpDdt_2Q&oe=6A748CBD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyV70ylI9r8Q7kNvwFxvP-h&_nc_oc=AdrkxnxtCzDdNE6HqQg0POhxrOCYKUQ4NOHHZ7-bJvjva7ZoWIk4vCAxOwKrC96STPs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh-W2DwuoPzDoExs4ZJDRCTpS2ClkzOhz0XVUpWrBiRQ&oe=6A748BAA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TH3I3T9ccqsQ7kNvwEzRTAl&_nc_oc=AdrFTdce0qzpF3Thba6M5Ond_5KHNhoUiTY9dZYgR4gYviX66y_-pxvU1xkP5vZv6Ns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFknKr2ahq5MOS53-j1OdK0sShWKsNSiMBL1SDuDqGzhA&oe=6A749432"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiFzGMiH-scQ7kNvwHl7zYs&_nc_oc=AdoTGBJkNMjSDzdLbqYr0aGpBqABeWDaTgOT_Q5XVB_NWdcMU97DjlD1TB0VF55tiQQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGW9ryWJq409Sf06P3yUtwsmqy3BeIgZt84dIdc9uhpuQ&oe=6A749B66"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
czwQ7kNvwGeEBVw&_nc_oc=Adq609KZKDyXDI6VOaBVAWYkQmP2Xs9t9HSsY0xulf2ruz4zUxhoTApje1dKTbqOv18&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnK4VxxEtMVkVDFjL66a4qjblC7r7LR3cxTcS4lt08iw&oe=6A58F942"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osDUYRtrBVEQ7kNvwETWo_X&_nc_oc=AdqeQPPpiPFcSzrKTqrSLBMjR0pHkrwH1xfkc9pEiBQAAMzPr--M_Y3XxYSmUhJ9UfA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaqmKw_x7lWaqmPGh4baRCViQ3hIKPzdYhNMl7t9pfJQ&oe=6A58DD3D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PozJ_W4HxZ8Q7kNvwHrGJlJ&_nc_oc=Adrlb4RZN2ivPYxitLd-d50gPtOa0Q9bZlzEbNBQFGReA0nOWpaT72kC7HSVu5-Ym74&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNCSUsn0d2hflbPL2TYpnjsUERLXa2pIlQm9UQ7q4QKg&oe=6A58DC2A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TvUOi12NUEQ7kNvwFS9d5L&_nc_oc=AdpAQtsFnrS3QBylULXCvVys9z7KxltN3m_3a2KKZdBvZWSj7il-RVAveX0jIgqptdk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIV0R9_F8KjdjQCa7FpoWPR6ww1h8iOfKGEZ2EdKoTiQ&oe=6A58E4B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoMFGKuJzSsQ7kNvwEdDo8N&_nc_oc=AdqlgWYtymwZOlXNbJQmlUOp3qPmzxUgh9zY0TwO9zNJ_yVabrjYMrAwEr56qc2g2mw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgEa69kJqwuYCPkbpQD8g9o2UzUUpgbTlb02Bu1GwpQA&oe=6A58EBE6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
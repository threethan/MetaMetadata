fh8Q7kNvwEodbxW&_nc_oc=AdqXCcL1q63HTAotu1Im4CgrDAC5M2M5czBMvGGaTRV4rE3Sw9h5rFJ6YCKyRH65q30&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKSvyufbCMkLL4kMhk0OuoXf53VjoWJixX9WApax5Ohw&oe=6A638542"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kws3_FIUQqIQ7kNvwEN3AON&_nc_oc=Ado-wQ2yN5T4uZy2NUz6TQSbJSst0WtlutHnbFc32IP3wBC6Qcc0gPfFBJtdovuyvcA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn2OApLHL5PduD_EmXX_wBdQJPmt9_IfM1XneCKPhlHQ&oe=6A63693D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W97AlTQOU_QQ7kNvwGGk9QP&_nc_oc=AdoLxPg9GUujET7fxYxKDHRyV3ERB4scqz6gOeT_H8q6mWK7i4D8oMSygEflIUo6Ac0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuuM5CwCfTR6rvXk1azMr9jTngFq3Ek2p_e0W8wbLszg&oe=6A63682A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-Q3xgogAysQ7kNvwHwhNWE&_nc_oc=AdoW0LfJUTrTfg3OA1NarSIaTCwVxFkKv-QMi1El7J1jOOv_qwk48fIXAzy7GOFgBh8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCi_O7FNK9lZRb7-C-9DmbUWTNl9Cxv3APmOk1x0Mtipw&oe=6A6370B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOajmUQbtAwQ7kNvwEE7Vkj&_nc_oc=AdrHiZ3SBelvnHKrNw5pk4QXcJKxeg5hT_WkEyrJ121rLDHO8D5UnnUcyJni923dO40&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjHV292Yd9Dnh_-6oD-slz3g3_aDtGHossGQAeSuMLOg&oe=6A6377E6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
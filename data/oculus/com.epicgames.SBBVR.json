mPEQ7kNvwFPgkjo&_nc_oc=AdqwQ1MfOiLc5_-Qp-wL9lsF2cJvnmx1cM7GpI2gWGNh_uKVh_Ajerzy4_f21rNRae8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJzjsNScDFR_l6zKDYp8UFUdqDiljVTrFpSz2IKzv6ww&oe=6A492742"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgrZt0ClmscQ7kNvwG1BTqg&_nc_oc=Adr1xu3sxrFsEB2kCR9o31o7BS94pIkEg9kZSB_00aLLIk6km19IxVyTK_PgEqXQamg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQmykMxzHhGsSUKulfcV-jAnXutoXdkZLNHfN5cGDJrQ&oe=6A490B3D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdANcVERZG0Q7kNvwGjI1S8&_nc_oc=Adq-Nl9yZVqUmpNioatbYvmHJvJox-RjjbhPKQkecY3SlyYoTKF7SCqLFLzhGDJuh80&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPaXBZ6MrHakWoMgpsB-WMKXAbKI4SAQJG_42Qfe_Ghw&oe=6A490A2A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ji1RtL1_6eQQ7kNvwGs4Ggk&_nc_oc=AdpGh16EbyvbD5htNh1CjU9XRsrWGr61a5K17gl3Zl5pot0XxsnmLaxsJDGkXawdl1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmitByV6_aCev3jVPt8ouRXJ-KhrmerXSo8C8KlySqCw&oe=6A4912B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6BDq8H9hPUQ7kNvwHKBrY1&_nc_oc=Adr6HrUIimc5IUaPr1vV7Fu3jbPvyeNBEPbHgkYfKYj5pe_nS7ykySf359j7UjpqsHU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAr3vTY-rC5hqwc4QFxnuRPb9EyWMIdsIr0oe5eVnRQLg&oe=6A4919E6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
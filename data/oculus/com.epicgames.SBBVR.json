y2EQ7kNvwEKIA1o&_nc_oc=Adq3d7gmiAD3qK2tuGVBCkaU1Xvqv-oHA2j9Z54xNsfDXEuC6PzQvhHW8_BRlDYE8xA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mFabmXoKsGpR8HXVlvWvAVzXyOMFJW8OH-mChO4bcWQ&oe=69D39982"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac27QHMrAscQ7kNvwFeMVMA&_nc_oc=AdqwIIPqSffgMFd2443I3BuKpDVpTFBQsRoz65WK0F07rR1BL5WWzZHSqp3Dzy2hFZs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22XglioKp4lzNh5TLUB9mkqRkot9342gKEq8ELLsl7zg&oe=69D3B5BD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jVzixjEpPwQ7kNvwHZ5h9v&_nc_oc=AdpGW0ufHCF9gziM-uRVtF9sZ8BGn5DKHDu8dgD9xNPVSD1VdKZNcPJutwo8YWLCaso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3V9KMNqbsSrdhyLxtDMMq693Uv5-RG7g-egqbU9kXZzg&oe=69D3B4AA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyZFU38kZEMQ7kNvwH5e4pp&_nc_oc=Adrnx-f_M54R2VjzKXmqGNbEKitLcKFkYVOxUbv6brugZAw8-zmY3jiGY4Tadw6eOw0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N2VQRTusHp79oQr5c-urOgMEDyPB_ZDmdZpfQ0rDUjQ&oe=69D3BD32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beUEGC28b4AQ7kNvwHkwQu9&_nc_oc=Adop4lvRAoAr0B34HHcju7fF7rhG8lmPa5ToQRdZG9btTTVw3ztciYtGaHbqGm7pRoc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PaIMzFd0eQ75l9gwsIU3YFv0M7dfzsDyW9_YHUZ6tQg&oe=69D3C466"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
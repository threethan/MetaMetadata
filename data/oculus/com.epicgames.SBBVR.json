WUYQ7kNvwHtZK84&_nc_oc=AdrOEu3gOJNDepgPPY1RihzGtQQeRy2-zJ6Z1YUEc90JfQIVdRfpW1rd24BDtlB1Rus&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_up6m4mlTKZne213fX7OVf1AsRuok1Z-hiHjyUyw1h6Q&oe=6A2C2642"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_zLmDI6Z3QQ7kNvwFyykcs&_nc_oc=AdrgrBhwytTzic_mRb00rV76vdIUISmqcnS0c18Nz1VXZ3GPIOZy49aeHcDUzOm-Nlo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9G40PGHExpcFtMN_-aMGkmzwyIOaMoeP4TrGK8HLdR2Q&oe=6A2C0A3D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kxlh-iRqZ4Q7kNvwGiczG4&_nc_oc=Ado42qif8wLNqzxUMjIUZ8UkZhigB8WZhncW41D9hbGq_HqIW_d4o0jY-U84KFX3Xk0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Tv2e3br5VIRp_4NaejyjAzNAgogc-2Ie1R9JSyZ--xQ&oe=6A2C092A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRyjFh7dFewQ7kNvwGk71sx&_nc_oc=Adp8pAjP3eoV5Y2WwVIVW2Cfud_p4qMZHTiFlkg8CzswAapmMum92jvf3JBPfML1JYc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Zy9lMdnnNtmEwxxZ4yksP8tNSLCnzUpQaoogaBKfeVQ&oe=6A2C11B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cC5H9aT_VIsQ7kNvwEamrXQ&_nc_oc=Adrv2Hp4EmzAQqqdyFHvoOvPFcmCXhJulxnhf-FDJjSpMIB3NXQxWNmmKM2gqR5qpks&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FzwTYF0nBbPAdQ2kQ0Lm6SeytSwJM52pbGbLFIfZ8KA&oe=6A2C18E6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
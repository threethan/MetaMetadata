makQ7kNvwFT4dKK&_nc_oc=AdqB3IqAEimQF43hW0n4raClWhG6omdzylOujdwFCiSt-Mx_NcBvjMINKYhQr1PHLYA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WeufeFwoQSWl32oHAaP9jDi75DJaeSJGyFJzJuTTdDw&oe=69E25242"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgTsKhUPYtQQ7kNvwFNY3QZ&_nc_oc=AdoCN_ga4S3pNLhZ8XafecUB8hwNqQtIGFtCVOSXAdub5HcZGpRl8aV0MJR5wqY5Yt4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3b_8vVsvxcxz1uCL4sBoWNfMcmNWtPu5ClFpNuLZhgAg&oe=69E2363D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJqhVaLZf-kQ7kNvwF6s0yq&_nc_oc=AdqsriPqZZ2Kdbvz9SUmqv575S5_ffpVtP29b39qhWjliLuVwxBt0RAgAr7rXi4mzI4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2B7rYjTrcB0n3cjSYXk22w9BtciwjIWq2hM38LhYJzIg&oe=69E2352A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUZpCYuUag0Q7kNvwFy32PL&_nc_oc=AdqW0JaVfXNUOPRDFCN-tEJBUHqaB7zbMPdUp7-UuMYQZscCuKPOLHlpUuUFHy3l7x4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kyd8qFzHuybI0BvdmzFq52BJIG_6lPl4rL0YJVwmG1Q&oe=69E23DB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tENy4bsb9ugQ7kNvwFVsk0J&_nc_oc=Ado5-c1UMZNyXlAsvCe1DLI9Pm8ZPh5BCGGCx5u_tmN7__IP5g3ZoQmjmc3d_bUCd24&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Bj6BxqxOU5IcLH7UxwX1RmfzzmC2GLjQ8wc9hArKUgQ&oe=69E244E6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
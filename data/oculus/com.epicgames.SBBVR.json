nwoq0Q7kNvwF1ia8N&_nc_oc=AdqmzfAvF_-_cbj42Cpi4p4ZzQbH2TlX5h_NVkDvATcia0the9sdZGmk3ITuODWnQnc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWIuEjY9EKzL20Z23z1NTpipB_yHBlWlIIWVgeQt3cjw&oe=6AAEAAC2"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hsm48ppd5ncQ7kNvwFugKa6&_nc_oc=AdqTs295rWN6tx0GLLh6cr04DT3YCpNXSdtCX80U67q1k3rHNZXIDKvFqtoT315HVuY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDlgr5rRNPLNsPZvgjTB3LdaVmJDmq4DNJBS_T6QdAFw&oe=6AAE8EBD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ0JWfLtY_IQ7kNvwEiPWM-&_nc_oc=AdrDDAAFX_h7oL3fM7uQNL2wKLdzGrHagVdER7sY-AhO8RdaaHDXuXrmvfIkAy6sgDM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJha7VdT5KRGClTnrRQgEQuMkSnSMWju7TGWAw3B3xFwQ&oe=6AAE8DAA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJXzF1zNWTUQ7kNvwG6o1U2&_nc_oc=AdrLsCbFVPni9ZSpB7tG_6pYffemsQkrlEYmKlaFl4tyvWgoB1-UInsThGDGkyKizvI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJfkmWVN0XpX9YisakXwSuc6ymCjlo2SKMMIpjAOiUdw&oe=6AAE9632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Dx8wBO6tjAQ7kNvwESRPjk&_nc_oc=Adohsolq4CQiSiwuHaUmD20XAW3ZIofn5iSE6wkPLagGd_A-5ITo0bnv6pmpM4KxYyU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5XCLQE3n1Ma5cTZiw6Zqr8vJXQC0bEdmK9G70NQ5UFQ&oe=6AAE9D66"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_sub
bW0Q7kNvwGsu_-J&_nc_oc=AdpoCcm26h4xUWWRPeFU3dtbUnHeE62T4BND3lPWihKCVmx5RcHfMeo04jYho8jgfuU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpFIM3NsugNPPXKDqOpOE0zyfjX_wplRBWelXfzNQy_g&oe=6AA17BC2"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmhy_8ZpoBAQ7kNvwHlw4bt&_nc_oc=Adp36pcc4evSXUgQYbmJbQOMMin0ML2e65dN_UBI7k5GK-q6Ow-4czPnh5bHyEN_AWQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLdwymil1Ek-2pGEXvAgY1tZQsh6c86AolZAVtYiIMnQ&oe=6AA15FBD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqFh0-6LWecQ7kNvwFjKr6m&_nc_oc=Adrnw7ulUxCLXy1kr6r3TTqhbsUW1q30y7KTU4VPB4oH773eh4WDV6DAe7iXO18aMFA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMhBGQ5aZxbxYp4DGyKTJuimlRV-7ibI0uimjY2qbzXw&oe=6AA15EAA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kP45w885WIwQ7kNvwHIt8t9&_nc_oc=AdoKy2jVbDm4uspXo_TDjCMPNJ3qtDawj3joWCONuPb4itlcv_Dw_SJIDrM0T_rVcYM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJP4t681Bo4vevB_tUnP5VaWy8qx6k4jo3sOvSs0sMksw&oe=6AA16732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0ybL7OGWqYQ7kNvwEXvrJJ&_nc_oc=AdoEOuJghWxBKgkzsmLf-0eZXts61p-DGD-N37_6sF8HiMXVuZIsrPaJE5D-SdWJQto&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyAXgc5giT74Dh0M5LjL6nmlQTfj8giPRho9bqm9G0Ag&oe=6AA16E66"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
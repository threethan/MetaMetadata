czwQ7kNvwHgg3hj&_nc_oc=AdrfMiyma4EHtsc0tqe38y7SfSB6Umqe-_6G_Vb3DaC0bQmcElrd-OF1Ir27oEAtwwY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARi6aUfHUVnzCMLguFwosDI7nB0XuzV9pOULXk8EIw6g&oe=6A5A4AC2"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4LQJ0CfwPwQ7kNvwG8xKMw&_nc_oc=Adr6uEp0qBM417vCmKEJ3N8KxFet824rb2yW2_BIAv9c6pMkFrZyRZdztx8FKOvS6OY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAn0PZ-QH_Hasb1zN16wqggsWqTNYlvviR8d8Z3P_fpcQ&oe=6A5A2EBD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PozJ_W4HxZ8Q7kNvwEpA8_7&_nc_oc=Adqb8kG3edgszQhlmI9AzVgdnpatn_VQ1sk4_K55c6V39J3hUUVLsQE9ghrWcPakMvw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEmZ5DaX8uu2gjUdkndPL_uDMMgYvenZH62nxiLG6SuA&oe=6A5A2DAA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtcF2FYTVbkQ7kNvwG7-yXg&_nc_oc=AdoNIrsm_7xtg3PnqSL2nw4cCIu5jEnNjzi4rfmtU0xt--v2vvGfvGlIKGxHmvL_OkA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaac_N_Di-B6R-RoifaarUWcQgDqYSEudj5OnIhjufcw&oe=6A5A3632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoMFGKuJzSsQ7kNvwGYZwBJ&_nc_oc=Adqz5qIBWKhngQUEPbjRf2DF0tIieegNSmxlLhojY5KnM4--SRb5sAUI716gI6JJv7Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMBJlOL37zlny_JtBMmSN2p82HzBpz9q8eq8_1Pg7pYw&oe=6A5A3D66"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
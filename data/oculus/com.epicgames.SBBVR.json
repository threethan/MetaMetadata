FUoQ7kNvwGrlsjZ&_nc_oc=Adozn_1OQGaslbwHRyeKG2XDuhaS2Zv3_2LOFGjm7h1l-C_5HsfH0Iv9Iavkjyif5dI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WCZIoRlwyiTilnKEaFoQPa_Bl1bl47gP5rGMjd1lmtw&oe=6A073C42"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubqgC8w3uuMQ7kNvwE_v56l&_nc_oc=Adr77gkgHSQZxvsVGNzacQ18s1s2GKSkxyuLYDVxkC42x9WAJumW71ZDXy5T6SGsEJU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R8XLxsN5G5-sv045yQadmCEeBxdYigXTmtiE17g7K1Q&oe=6A07203D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akVPRzl-h8sQ7kNvwHBMVHw&_nc_oc=AdpnELIXo6HOaVuoVn_Q3x9czbw8c9Mn8vGiCHpCVly2OT7yNUZBh6UB-n5F5hOoJl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hMwjh0nbzgvEG1OSiiaKtesOJDOZlj52LofFm7RWedg&oe=6A071F2A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpGJzOZfwm8Q7kNvwFAhlGL&_nc_oc=AdpAvaogpJ9ZfQQ_q6T85Y_CXZAsUoOM12nEjpDbQY8pwhSySTAGWFl6KTAb_QjBJKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Nu_jKxwGIbI3I06-yUI19ogwk8swl90sX9ci71Kf3xg&oe=6A0727B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNxGZI6qwBkQ7kNvwFsADuE&_nc_oc=AdrTor2bZApKvorwDowfFMlR4-ufg9AHXhYWRWL3m60TZTWv1BDZUeiVQY1mlkQ1s9o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Bsw6OUjAPigQZ8331PnPoOs3bkaHHTnxfjLyxsSYJTg&oe=6A072EE6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
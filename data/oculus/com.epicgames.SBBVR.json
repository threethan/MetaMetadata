ilXzbC3xaMWk97wGLh1RFf9fuOEFIVQHagKnGyYI0uGFcUjb4IMVSSES_A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzt9YczbBLd__khCwtzG6ycH__PpUfpwXyr4h6MnvQUYw&oe=69B3F582"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqfGoJpmptMQ7kNvwH0uE6F&_nc_oc=Adn2S2ZSMtL5lf89NG-S63hmhi9EczbQfPJxHfwNMeOtgWpYHl42ZIC5dBpaRbrAWlc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz0x0OgsE_JPcWdlb8oQNVGkaT1zJs9cdsvYho-9UcFcQ&oe=69B411BD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vk0UYOV9cWgQ7kNvwGill8R&_nc_oc=Adly3KKCv-CvNk4UHgcosxyvV4vHfUAv6_EIjBAoGMHE1dOg_T-lcOg32RtwYlAot8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwE5FnkxT0_GNl_iRi8YEf7azqvbet_L2zI49zAgcjLxA&oe=69B410AA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTu8c2bffP4Q7kNvwG6479L&_nc_oc=AdmwwBbzTI5o68vdEQsWLV12NcuDcAfsSO4UlcAhknPDngLsYIcZ8b7Po0DjurfSFGA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz8v-ojNIjEWS8u4BydsrJ--zQqgB_B2UQOv-47e0__fA&oe=69B41932"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_RSpuwnJEQQ7kNvwF3mqZr&_nc_oc=AdkEjGq84pb7kIdmDEH0043nx98bvxKrBZDD2bXX2UcnwUOGrMVHjHb30UyaA9zIAHY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyBlF8d3AQXEyO5KcjiYqqs5UcVx_KES-FxXWNDlJjOkw&oe=69B42066"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_a
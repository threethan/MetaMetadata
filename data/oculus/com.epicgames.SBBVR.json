waUQ7kNvwHq2ign&_nc_oc=AdrtQqx9XGA0EjMSRh7r_WL5BXXa7FVAX3GnceWbS4M2ZJ4tcpGYTFV3uWzmtxH7cV8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dyyHduYj2UVXH63i22SrIAGAcXAsRuPCQ-qLlG7bzGQ&oe=69DCD402"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IJT30t56wwQ7kNvwHqFtib&_nc_oc=AdoGIW7Zz8xgU85-miPs247FUnfcKsbZCPm4GvGl4YvTbT6kJ6AW0F_7SXAlZ5myaQM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mp2jd_AYuthF8RVAh2xcQcT0j50iwdREL3QfsGpSJNA&oe=69DCF03D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1s7zl_XqqHoQ7kNvwFdo598&_nc_oc=Adoj1eBtIAeoD9Sp8o7pdO0PI2vms2N5E5mKcV3OZ4yiHofY-3cCWcaO_NgKqjZKuIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UhgRYJYJ-rkWB8fY7v2HKmnZwZXWvUoPuOlMxAyHJdQ&oe=69DCEF2A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_Mg4ciTOh8Q7kNvwGGBP-C&_nc_oc=Adoe1tmf727bwpaEGqU8sIpLmpGu1UFRZuPRhSPLVYpR7taeUw0KFcLjZsOLJvYH4Z4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Z_u-c2VuweEJuelO0nH0F_cM7Kx_9hFoujFuXs-5-eQ&oe=69DCF7B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xMNBVKC-5EQ7kNvwFTK_nZ&_nc_oc=AdrzikN66dSk0sLg-5naMP1qD_eHu04u6mLtILtlvam2JoggVm3Ge6lxFBly3cFDOpw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dUwGqyNbWz8SwCaj6K8aQZMH6bzeBAoDDS0Ei2-DUyw&oe=69DCFEE6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
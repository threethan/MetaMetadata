v3Yq72J0M9TdgzndMPKuQeHmGA3O5MbW9uU0jno0_pNgf-O1e2n2QDLazE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyP7ENFiQr5doDGOnCX3cGxi7HN9Rv_ujnFj3Qx_iBJTA&oe=69BE8182"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV4nO6d_UAgQ7kNvwGleU-M&_nc_oc=Adm53ABvZ08_Kv_SkIJNc5D0X7kYWXQLfIiaiSSr5H8KJheJagR9wFKokYC2PNJAcrk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzw9uzA6iVbRO1GS5dcYsrysBnKsdZ6HFxmrYov31qZjQ&oe=69BE9DBD"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VVkKM5LlSkQ7kNvwGc0kq5&_nc_oc=Admeo6Y03j6S9jDo5MBIcY5dr4kgZGpPwdfsZngvLmSKyNHDvMQ9fPfv_U9MhVpbai0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxc2GdmosXrVcH2p8uBpS7uXZGNnZJ3HY53VoOnJafvzQ&oe=69BE9CAA"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcVrYmmsRBUQ7kNvwFczJCu&_nc_oc=AdlALxVMk9yqYz1uVkoURbB2_MDt4L7I4MTs1X0RtOK-YlX_zGxfaGaouq0vCQHUQ_4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqL2Pona_zdfnbMELUfiFlmjaVhKV3hhU90rRLQpj4yA&oe=69BEA532"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sguqp4R9sC0Q7kNvwFw8cLY&_nc_oc=AdmLluvvvZ9rT3-JFI9g2nY22YzGLH0A8H2O4yIFde3k1qIgwZ2CKlPU3LMCumwuk9s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxO79vhdHxkpPC3O-Waqg1w5nW6l5t8ED1yRRElnlq64Q&oe=69BEAC66"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_a
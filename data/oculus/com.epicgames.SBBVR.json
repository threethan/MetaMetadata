B7YQ7kNvwHX6JeE&_nc_oc=Adqdzhl7JvYS65rgQ4DvcIkR6t9fdT8a_BdBemvkL6IM5YS7zILNGxSkwUzCeFPXcEQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSQ_rUfJURPpuXSzeWYuxzIA-MvEmejpmhMwjMfVoOww&oe=6ACCFD42"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teDH2xLts40Q7kNvwEMX_t9&_nc_oc=Adpjf1sfDBFzrz39e5YBW7BI4oDxGyatj457_B1J0XoPBAa0ANn-WhlxJq6ZZclDQLA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQY3nfrUSn19LA-UOSO5PWEoJI6yA7hty-1w0AMde41w&oe=6ACCE13D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPaxICwjzZIQ7kNvwHssBz1&_nc_oc=AdoU4ZBykNfXp-aIm5JHPughpF33s9rnQAeoMRTf7cbt3zCCMyjHGNXgy2DgIDxCPz4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO90W7gEr8p-QGRb5lJVxk-ZWCYpscZYiIP0DZu37E7Jw&oe=6ACD186A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VuxSEnMDLkQ7kNvwGDWbE2&_nc_oc=Adplo_dvrq5igmedXm1x-nLADKXQWsf2WJQtVVyOB8LxDmlUFLisnAAyntfRCAAV5Ss&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe9WvK8fPf6-GIsjeKa3MTFyNv102-e6QItTd19EbMbA&oe=6ACCE8B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSGe8VGRiRsQ7kNvwEfzp54&_nc_oc=AdoKIMEVw1aTdMSlUsPExL6xg3gGBqmjOL3dMUHwCgCzVFQuyfJRAl-JJfrKEMpKsec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiVT1nRE24oNC0OWNNTSnlLf5RPl_lSeC9N1R6CAxkEw&oe=6ACCEFE6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
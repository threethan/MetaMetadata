z4UQ7kNvwF76SRc&_nc_oc=AdqD2HvNIcODvtYOUyDHVDAFwN99XDLL5Bu7SnEZPR3KyXlWeN-cwgWqmY4b_cC_t0M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Jid41fnXw_FRhgvkvmdyMM3wFtEQR1mbRxhv53z58rg&oe=6A219A42"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWGt_Z36s8sQ7kNvwGQp1Qp&_nc_oc=AdrMJofOdT896pjgVnYbWxChQmfX3LwgKKNNQtkDLD-3CapnQpBfgW6HRoGnKnlC4_c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5aqUBX7Xo9oZZl6j-qooc18JcIhDKLUsvSvVCFIbGrQ&oe=6A217E3D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3X-5PVpU33cQ7kNvwFTpEkv&_nc_oc=AdrtRclCitkmeP_dc3qEELqRV0QmdmYA_2C22K0EdAuo3Cl5mMlCGGpHS5qYEzIhc-U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XAKyfeppfGf7DoJaDNc9k8uB6IZPWI-FQb9Y_kmiRNw&oe=6A217D2A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5-odJc7D7wQ7kNvwETCYwy&_nc_oc=Adrp7TspXQCIfIrDPtCOUwr1H2JUdjGP9-a8lC_50qay2Tvmjve5vpIQ_6veepyaKXA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JtHZD0foVgpEwFt5hCYwEiB7vfbjSDSI5K2mEnRlbcw&oe=6A2185B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6nLRwb7EKQQ7kNvwHn71w_&_nc_oc=AdrIwFNp4gLikMt1BoqR5R9o4FRdOIqrKOVH0mLTi8gxQOqhASNSKhXc_PA2IH3v5Wg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GNHeQp2_gn2jPTo__qT0PLHjrCOk1yfdxiMSosR-4cA&oe=6A218CE6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
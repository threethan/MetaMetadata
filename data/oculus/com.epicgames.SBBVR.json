10sQ7kNvwGJya73&_nc_oc=AdplIdiL1KtzJApBiqGT7jLJY2EBi1IpYp8Yo-ah8J1IPbbSdVJ3frqsfA5rttZXtsw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SbZgzQY688fEgNj9ttqqa1DTvvIXsLjYtdi8o_rMc0g&oe=69FF5342"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_yKmMqNBz4Q7kNvwFx2fCO&_nc_oc=Adql3lIOW0_VBoDa-WzhacDJo0RBpcn9xWEjCplwu2sCsr0c3Dow3WllV2plES2EqUs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uilJbGdk6XtwxhEi3pmWH3KSS3DPVw40sm3XJxCyuMg&oe=69FF373D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ka4tPnJmnhgQ7kNvwGlxC9v&_nc_oc=AdozLdZUVYYeUDUEtk2hrGlDHUtcBOcYOiM7VgF0uKbrE3Q5fU4v9cF4sii_ETUYm1M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4S9rqZLDI_LNY3GA8_QT05P4nI9dnd5TVoHHRjTQG0Iw&oe=69FF362A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BudbBBiDwIcQ7kNvwH6FIz9&_nc_oc=AdrWb3jdRt0CziGb8ABmg2DYPuCtcE6VosgZAgt4dwklNX5ZAlYrdptk1TGIPwTQ9H0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zqGx_HKK1jKf44oqEMHoJCuXs0-a_kvFa9ugnRc1DkA&oe=69FF3EB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99VmYJAkTTMQ7kNvwFF1EGO&_nc_oc=AdqnmM34jRmEkEx22WmnlsX2KiZbFeM2AhcA3VZc4jVBnJg-crcT_Y006wiOVJZDkhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cfUYTOxLON3i9GS1A5ZHkaOUIihDu4x4wsQV4wbMuJw&oe=69FF45E6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
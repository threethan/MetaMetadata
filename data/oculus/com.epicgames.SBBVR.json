_UUQ7kNvwE8t1y3&_nc_oc=AdpmDCXh0lx758TQXt9qWQukaNYYIGIiflaOkJ2hcCi-QTSklkNhoEadKca_Khcjpsc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbTwT_uplO34rA0BK06AXeG2lqoA7vodXmjht4vC5a5g&oe=6AEF4442"}, {"file_name": "screenshot5.png", "id": "1175644900145733", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210390_1175644903479066_6548082995314525943_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNGE2exWpr0Q7kNvwEQdb4V&_nc_oc=AdqmktQ3c0HMyIfXOwIJidXvRW1wHVFVS4UnWQfSQvlj7PGMM9HZyqo469HfVeJXTbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy-EbfxfBXBdOkJ33JPQIA81X2QfCka81LIzAK616TEA&oe=6AEF607D"}, {"file_name": "Screenshot6.png", "id": "1611035453071922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1611035456405255_7551629153741614966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXUOer7QHFUQ7kNvwEtdZvT&_nc_oc=AdqN2Lgz3CJSz9wfolKqAzVoiYZAR0nBstncw2iN_VYmnm_v60B1spK4l5pJmLbJOQ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTftv5He5VYlTIG9lLXBzSC1NxCLH0V_6ltoqmiqulnMw&oe=6AEF5F6A"}, {"file_name": "screenshot3.png", "id": "464793966155416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035463_464793969488749_6973340850056647455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrxeOf067DEQ7kNvwEoacPA&_nc_oc=AdpYLMraF55ljU4glDcFWhUjUw8ds9-C-l_sw7punWeBwN9X-XBsIA55_90wdhJWB3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT35V-8MMfSg0Kyicc4FvIHAvFwyrRM1hcVC3dRW4PNmg&oe=6AEF67F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenshotMain.png", "id": "1968903010260858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566697_1968903013594191_3058892170572246747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jz0fVL8YnkYQ7kNvwEm6gHN&_nc_oc=AdqVOS7QU-AnklVzpmH8MsCHP98hD3OWUh44rsO7Kpo75DP30VpLysjS4ZARZ6By9Ls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBcA3wqu3DswM0m3jxDUkLRMXqbzr8ezTbq09CjPZ5wA&oe=6AEF36E6"}, "display_name": "Super Big Brain", "keywords": [], "long_description": "An arcade style mathematics brain teaser set to chill music!\n\nTo begin, there are two gameplay modes, Random or Challenge.\n\n1. If you select Random, you may choose either a 3x3 or 4x4 board size. \n\n2. If you select Challenge, choose 1 of 10 prebuilt \"Challenge\" boards from the dropdown menu.\n\nWhen ready, hit Play!    \n\nIn both modes you are provided a number you have and a number you want to get to.  To complete a round, Use the buttons on the board to navigate to the goal value.  In Random mode the goal is to complete the most rounds possible.  In Challenge mode you compete to use the least buttons pressed.\n\nA top 20 leaderboard is provided after each game to show how you stack up against the competition.  Show your friends or parents that you've got the Super Big Brain!\n\nKey Features: \n - 4 functions available (add, subtract, multiply, divide)\n - 3x3 and 4x4 game board sizes\n - 10 different music beats\n - Play up to 20 rounds each random game\n - Random hidden time bonuses to find\n - Leaderboards for each game board size and mode", "short_description": "An arcade style mathematics brain teaser set to chill music.  Select whether you want Random or Challenge mode and hit Play.  Use the buttons on the board to navigate to the Goal value.  See how you stack up against the competition, challenge your parents or friends to see who's got the Super Big Brain!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superbigfuture.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Super Big Future LLC", "support_website_url": null, "website_url": "https://www.superbigfuture.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscri
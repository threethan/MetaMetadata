dn.com&_nc_ss=7f20f&oh=00_AQTs2IIS_hk5eT8KE_MlUzO0eemInYOEnIwkeVYYF8Jq5w&oe=6AEB63F7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQekWm1U48oQ7kNvwEM3BBT&_nc_oc=AdpIy8f9fSoyIc8o4ZbcKfgk-eFv5r1TOxlm-iwBrBrAcWV76HBJAJELT5NsAFVEdtg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9xQ7NLRvpxu8KIEzBpgFtV3h0l9mtBlPwv4QQA-6YOA&oe=6AEB2EC5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYs-gvH0i4sQ7kNvwHJl8G9&_nc_oc=Adrx0jIvPqyWwdALEJT4htU2Rq-RiDMX_QX13p2sx2qlS4yazlK6rJikzS3S1HSKv3M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIyhVbcty2b7aGP6dzsSWY2pIZ866oocF5po03d_EhuA&oe=6AEB2CF8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThKAgEM-T3UQ7kNvwGpi7Qx&_nc_oc=AdqFwkbgO4LdgR4mqmkBdGPj4a3vxLHFm4QHmcfdxIicl-pZcTSH1l6NHp0ShNKhzfY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEsqGg90iCl1QFApQE1fuoi3uoLirvzG0iDwyUjya0mg&oe=6AEB34EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHEl24Rm5MYQ7kNvwEedx71&_nc_oc=AdpvYIypgMDhhfwya1eDYkCf9ygW6rwvx50ZOj-TP0rubGQoYLAQWtb_WtCpUSmGbIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1NNAAjcknE2_Y4MBqT1SmPTSFev50bM8esUHprUR2OA&oe=6AEB4E83"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
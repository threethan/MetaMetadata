dn.com&_nc_ss=7a30f&oh=00_Af3EQfRFY4ssnC7V2vGF95D1DeFHzZZVVTlJSwZZyNunfw&oe=69E622B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gg2dQ2MtXToQ7kNvwHYCNXF&_nc_oc=AdrxCYtwmCAj59NP_qo02-pbUv60sFCjrl_xZ9F4-qrL984XQk6XIUF6NYO6lwCsjUc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZtHTvo_TtWHuLEwr8fQ5F5tAGKBBf3sR3kl70eqoxhw&oe=69E625C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXD89q4cdT4Q7kNvwE-1V7F&_nc_oc=Ado2W_vSC9M9P11kPEH3xA3lm8aZtFVV3CVI7UFHL1NV31eIqbzpjFKWUbl_PUe-hEc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18Ap-emN2RblppOVPm-uA3ENvNEHC9uS5iBW8XHgqYgw&oe=69E623F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLeiBqexHPYQ7kNvwH4a1UT&_nc_oc=AdqesYt4_F3gdkn_O4qXjuAVj56vXRggUmygF7St86H-X6PiJ5yofo-33G1hIRpOi5U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vT9dWIt7GId1IqjTH5FRWMYVtPpxjDYbT5y-nrcAE9Q&oe=69E62BEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVM2oiT_720Q7kNvwEBKtt_&_nc_oc=AdqUTtMVTIAm7p3K5yAe447849qiQWGe3g4YX8ttVMNjpHsNIkSYWfG4FVrt460Nv9A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31au-_IrXurvb5ht3vC9GZMHPPWS-VarKxx00YIFdX9A&oe=69E64583"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
luscdn.com&_nc_ss=7f20f&oh=00_Af4sKa9YyohT-hMHyg8lFjsGeNTxG0xh_LCbXEeJFbW79w&oe=6A11A437"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKxzW79ITzwQ7kNvwFAFUCX&_nc_oc=Adrxd-f1zpZjDPhGRkd5RyZpgAEIe6MjCR2b6po2xFyANNJ6-MORKo7lJGzb8x2RSbM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VgEPXHMVfhamkon7-Y-2sEYSjNILIcirvb5Aqt0d40w&oe=6A11A745"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h10wDiWGlqMQ7kNvwGdUf-F&_nc_oc=AdoPmSoknR2F2rdD0-t52Zic2H_8V6XYQOP2eV0Lqs_IQ9j7G85cACpgJJatON7wkMs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58QOJW3Qkifm-5h3kOOg4fpXTcGsoQTWijhtcLNYa1nA&oe=6A11A578"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIdBD0WBs1oQ7kNvwF1CfNF&_nc_oc=AdrBxL8J2QDoWgqjiyOI4vfy5dXUxZgVPLkWwaiI9X4B5YzcZt_xMnQoAidEcciZPFs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49xR7seVz9S4_SOrVsRfGXCCTbvWOaYLMQDdmbWVPgUQ&oe=6A11AD6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xE9xv7HIYcQ7kNvwGnT1WZ&_nc_oc=AdqPTgbNUyHS1uPh0CgcSdFOYhsNN3gKwBnDHtahZGGeWDJiu3Z6V1erltO0tsiI5y8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bvqmRJetgOoEYHpfSjIhlZD_6Qj7ImT9hNIHWaOLMPg&oe=6A11C703"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url"
luscdn.com&_nc_ss=7f20f&oh=00_Af-hZjZQolm0jFyp1Dut9HnjZTVWDSJRZE4F20FiJz1jUg&oe=6A36C677"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4PZNcFrXDsQ7kNvwG_mkdS&_nc_oc=AdrBIm89NeopqSDA_ve0uSS5EHDrCeSEX0gOxdqKNrKL4CYGnkHVbLBT5XI5mPcsu6Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RBjmzrM3n9tuTkrfg95iV_itSr_MUlx1PfghPDWrNXQ&oe=6A369145"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jvq99Qd6vDgQ7kNvwFK6VgB&_nc_oc=AdrQKk-bppSM-Kr0EAjxxoXcntHDGOdZQmG9uWtEAuJjtwPVr0_ZrSsIeh0Og7w-GU8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IgaXeHZn7hNRY6-6qpdvpH5ZKa2Eawx23VRXOtyS5SA&oe=6A36C7B8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ajiy39uN57EQ7kNvwEcfUdo&_nc_oc=AdosdovCYGcbxgcYtrpPQo22VyCVVriZDJsshJWqc7jElXAVkL7Lj_CF3nJVJ29nLhA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f51ilJGaFn62jZISxEW1HIKDhnm-t7So3sTGUdsPdMA&oe=6A36976B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_lBVw2Cn2MQ7kNvwHKVlJe&_nc_oc=AdoSthivqwwmTK3mvb_sw_MeQPvOPVKTyzS_zosK2rUANn4m8KfofwEf7sict7cIeNA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4_xltrQSSTClEJjO_WSnw9OSf-qgpfpro-uMRHK6KTw&oe=6A36B103"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url"
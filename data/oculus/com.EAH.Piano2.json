dn.com&_nc_ss=7a30f&oh=00_Af1TX1wlQlgDbSEV9bt8fDY0IlapF_2Q5PuKPQDVIU1aqA&oe=69DA4537"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8Ov6mz_aFgQ7kNvwFrV_J5&_nc_oc=AdoT0BkVx7WvifOkOX2zCG4zSTf2B9SP3RdxnbDNBi7lphpBFuZwA78kI1gUK5bgf20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32W2pByEZ-seMoP4WwdGjywLG45G1_t2_-_AWuWfcqTw&oe=69DA4845"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48XxiuKs_HwQ7kNvwGN3bs9&_nc_oc=AdqCb3ymJKauM098E38FdntV_xyDZmqCpV89doDO9z9AXXxxeS9cCBr_LXX-CMm172c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JGZy9bEplWcvFzDWsKvFcHLRszoi-xAWhs3oOImh3aQ&oe=69DA4678"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIn6Cst3XBQQ7kNvwF-oKtI&_nc_oc=AdrKy8dU2Tzo_t5Hm1Zfg-VQx38DsprejJvvKuY8ZsK2FH5-p_i2v_VXtUWqiMAv2tM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BvE-7Rj86QIpFyLhZuedwcao-C5p-g6phtpAS1o0hxw&oe=69DA4E6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypQkwlmUQrwQ7kNvwElwVHI&_nc_oc=AdpLdDmyG5gtEvWs3qeuHYLtjztJzs6Xgg3rDpBVefZfGLWUT545VReDcLl5AEdx07E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0S2OeEhF8j7LfwB0lDSuhTpvY7C5lK0DoQNfL1XCUL7g&oe=69DA2FC3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7f20f&oh=00_Af5DTJeGjDIUvsz-2MfhOP6XsuADrzcMTsW1C30S3U2gwA&oe=69FDDDB7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwB0AdybGSoQ7kNvwGdRzL2&_nc_oc=AdrxVKdI_8x19ngbPHUn--YMWXXWTC-8wOVF2INYezZ4cZp16D_xGQ9qA4TB6D1Oc7I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TszkEIMB2kDrEEzGVBa7OAIvZDT6b4mpujM5yqlSaAg&oe=69FDE0C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJdG9Fk1OfAQ7kNvwHhA3i8&_nc_oc=AdqTEp_bJZqKDQ_qs1yRj-KLL018rHvXYrN1VVPPRIiyNjNI5adrOkOyGYvuWN_WPZQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZkT9M6LV0nwfHwGXwP5loVIvFvV0VD3o2tVmOR7IphQ&oe=69FDDEF8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaKgVYusbiQQ7kNvwEAFBea&_nc_oc=AdpaME5HJcICNKuzCDKTWcQ2ay7WzBAjXbwTTPrkHtgBjezg7_WrVoOFFeRVynTYeYo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56bAJpHZZNfTfxMeUpy6vOHq78z4z35InffuSoI_OtWA&oe=69FDE6EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-Xsj1t4yyMQ7kNvwElz70x&_nc_oc=Adpi3PYW8RSwUpycrQpqz67pNH5P8F6B7eQTwbPjrCM_pWCcK3aURxyg6w0fVQ6ImWU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ilhpu_xJNZgzhcHMMiGWJX_7qBRI76NbVSXOlLdBFRg&oe=69FE0083"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
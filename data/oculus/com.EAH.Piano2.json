luscdn.com&_nc_ss=7f20f&oh=00_Af99z9VPt3g_8Wtz8zaSajYNTUBnLBROChwfSSZlR63xGQ&oe=6A466037"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaybO777c9YQ7kNvwHrqkHE&_nc_oc=AdogSnQ6r5847yMxs09SWUv5zP_W1deN9E8WA6Cjax51xj2d0zq7r2Kr6KyqnZi9sVw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6sDctxHEYeXXn9uNizK5iVCyTyKBK1dzNB8_B5mPY-A&oe=6A466345"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9J0rdongyYQ7kNvwH9hceu&_nc_oc=AdrCFFM9ZUIi-OZTkU0IaPRuXndUSIbZgaHBTMslA-qUmgCr8Kn-1LDG-i9jklimbEE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fBCRa4eRbVO5SLLArUMzGODCcvwRbeqA5Ijt-EHtwbQ&oe=6A466178"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KahL0jiZIfkQ7kNvwF0JI8g&_nc_oc=AdovhAAKPh6CPzFPIKBu_HffMTv3R_3L_5V8YJmj_20j7RrsjvYByrPQPgTWA7_PTog&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LIksAN-8dfvc_7NgPMJFr6VTmPdCqVXBzOzZdEmBJqw&oe=6A46696B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fip7MklzHkAQ7kNvwG9W_Ei&_nc_oc=Ado129Th0DgK9FmclDdyeu24JEVr-cBrwWLaqvfUictT0JNziKHLomVBg-0D5xLSeR4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5crSxIbSra8EXelGzxxkNWVmczDH0xP2FdzR1s5IbEw&oe=6A468303"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url"
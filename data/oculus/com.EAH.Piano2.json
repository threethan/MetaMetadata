dn.com&_nc_ss=7f20f&oh=00_AQMCqkkVQ33J2U9EsA9sMAQo_8jViI1LwiOa5Z_MnFo6Yg&oe=6AE49437"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5LOGzlb4cEQ7kNvwGJivUH&_nc_oc=Adqt2cyiW9Gtd9vBydhu5Nny9ZC3qTVLxyJGugLHpHbhM4lWX8ytrYggCGwrrLRfjhA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0423YrRPHOnLspKb2QnMoMASuxib98ub33yyjeZOo0w&oe=6AE49745"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arN3MlPMkSoQ7kNvwEiqI9T&_nc_oc=AdoI_gNm3a71s_CUVqlX_V7EF76Rcei1434ZaHGnZZwfh-tAIg1IDcD304Y1IC_h6B0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6AtYmdwG4Z_Anc4cwMg4Thein1T1gVhRluh3QGRfvbg&oe=6AE49578"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2im35ZyJZ4Q7kNvwEEIf6q&_nc_oc=Adpjw6yla4sqfHvg_OlzgPeNtJ1UG-58TPSgvGbpFBQ00wvtgFrc9R3HmWOVtTMVJ0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeWPq7smVGX9XBnuK1tN-uGmSnQZgKCyt2bjemy9dR9g&oe=6AE49D6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nO_ZxVggOHkQ7kNvwGbtfWL&_nc_oc=AdpvPeCjRNpKdOovWpzFaR8I9as4-Tp9HZsqRoJ_WOG6Mr3O3Ou7X9yQNRUeoSRVg3Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuNlVOc9lTxfmtb36sdymHta8gKOdSwaJtfe61BXbQjw&oe=6AE4B703"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
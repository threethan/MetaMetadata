dn.com&_nc_ss=7f20f&oh=00_Af-Bck0U-uMOwjYlLHgS5g5bjSwfoG0JAlE8ltIT_w__jg&oe=6A2D53B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78gjtI4JZ5sQ7kNvwFNPDWS&_nc_oc=AdoE0qyihj-OuClQZblD-kJ5r-h3KcxTrHB8kf3nBQaz2SOZ3u94jkQ4g-5bFrqxdD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--vmIXWepAQeakfvNR-KGtLMeFXEeaXs1Yy2fKXKIj7Q&oe=6A2D56C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uR1o1B-vlxgQ7kNvwHmeAYF&_nc_oc=AdojXu--E-MBWh0Rm4XyMQW_WeTkSqdBOQT0mcfc4qlva7MpJtIzVuMiY1QXCEJHgO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pmU26lAL4bqY-DgR-7W3TXQvyCs3chGSe5Xe-Nc7yag&oe=6A2D54F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyJrDdKLsJYQ7kNvwHRu68J&_nc_oc=Adrf-HAc_smqDhvO9zM7CV4sPO__bqm-kcHghUFxDj8-hiXNKKFrk_KdtXiqWRBIe4g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_A1YgEbfqgTUeNpyX1r2lelia5Q4tCzNKEedL1UYZ9g&oe=6A2D5CEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZbcyI_R_kgQ7kNvwEvpTq-&_nc_oc=AdozM7WTxos51s0Km3vXCxiGo6LWkTmfn-SSDffUls78Q_h22ufcMuk3dDHiOLfXCSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sXZcs5uAd7q3Llm7QvrfNwkcOnOkv8qI1jMrXjQZNCw&oe=6A2D7683"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
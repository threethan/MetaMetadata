dn.com&_nc_ss=7f20f&oh=00_AQF4w1hHXobn_9gDLxEKXVWJmBnH9Gm62GtLpT3mBcbH6g&oe=6A806237"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwGEE-I-4UQQ7kNvwFYzaQY&_nc_oc=AdocqPEuX6ze827yAuNwcJczJtJPm1dEafya0ST7A0kimjrzYBqcAHScKg5_nkNlSOc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDO64_91QwDppsCgI-nu8U8b7LONhCmsGNG7IY_WraiQ&oe=6A806545"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gg8CxZJ9VjsQ7kNvwE3EHQq&_nc_oc=Adr6bjdKCvlyKLXw7zISn_PfnwPo8YCPJ0zMymhGdh2PoeTmwXQJMM1bipGGg7lDDBo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZnNHHeJcIGu_BPqp6y1fzbmpFpW4j4Qr_L6Mr3-9i_Q&oe=6A806378"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_PjzeNszlkQ7kNvwFgXy4D&_nc_oc=AdpbUWJ10n6xWyzzXoDfsTXWzpB60S2WkK8tV0DK2oG9pA-L8YFUFezlawjC4hCmOcw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEidGJWqsVnNZXlb9Y5ii6Nj-l2WpbEqcSYQzOGOz66nw&oe=6A806B6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTah-2MkAy0Q7kNvwF0hMrv&_nc_oc=AdpsB06VkPhDSInDZiIkOJbOrGuzMPaUJkQpGYyLfJfpfaBPX872kqLNn_OJt0Sq3Mw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTFphucmDHk2F3P_sf3R8CTHS9LhFMBALd5Gx-LsVwKQ&oe=6A804CC3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
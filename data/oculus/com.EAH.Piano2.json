dn.com&_nc_ss=7f20f&oh=00_AQQSN1qUimaffHF4qdYHo5rXmEo_hFOUDVblWiTJ5EKQ_Q&oe=6AF34CF7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpkrrgcTYdIQ7kNvwF5mW2F&_nc_oc=AdpGC2iV2c0S0RHLOZnlIYk2L83txhtJ8FHxKmQCwRe2cOgKeKHqLG-2ZVF2xHt1bGw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuGuYBeruv9wEHGozmQizP1qA9bcVbakaqky2nHUkh-w&oe=6AF35005"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DwnUKEtiRgQ7kNvwEbyASF&_nc_oc=AdoxBV5TPBIWuyvA2LhcQgopdQgkNrGuTGWqcPusG9_y1OQySL62OU3yBwOIiAqhSZ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpRhq-2ToGoTwTzGKRvogwh3i7fleEUd8ELVgEXKff3g&oe=6AF34E38"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IewrEwf86vwQ7kNvwG2vc79&_nc_oc=AdocMDjTmKMfQRlyW8dgkMXgr5vJMRkZKqYro8m6v9YCd8r32ta9lASfzKrw_qJ7vc8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1ZxpDxO9W6Ej2Iiu5Kk3s9j9dm0R3FjxxjMqY8wI3aQ&oe=6AF3562B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpjqEKUmlooQ7kNvwGK0HTu&_nc_oc=AdrDykoxCf3a4L4GhV1bBO-od29s0mnMO5QWyZa3Y3bkseLJr3oUOsKCAtjruTiNFX4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPClSy3Xt4WuWHCHY9GraT5R2VU8V6wlui81wgrN3Siw&oe=6AF33783"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7f20f&oh=00_Af8gNl9UBZtooOl1toP4O58RalQ-69sPflIuUrHrfhd4RQ&oe=6A450EB7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BNAzaYU4X8Q7kNvwHwPPqm&_nc_oc=AdpI7RhYxrNrdG7r6V2qUTwCunZl4KwDZHQZzoAsuVwfZ25Jd75wt50Mkdtt1hAL9yw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nFBVhNtvtgGuo6-VvTpb0tI2WyDJDE02bezPrX56pjg&oe=6A4511C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9J0rdongyYQ7kNvwFVwZ7K&_nc_oc=AdrlGvcJ2r1i6AdvCSLBRYsAfLFu2Gvch11RD3OFDRhzOcFnhwSYqJBXtMx-UiOa7t8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wq1Ykx-avVfu8ue2vY9rBlXmHaPmT0MRQcyrdhlV4UA&oe=6A450FF8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KahL0jiZIfkQ7kNvwF-PVz_&_nc_oc=Adrt4uSnl-o1zay-oNcG1wJWYI4cYc6F704NZBE526z9Jms3TOvnQ8TQ8klG1yg2zp0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iair0Jh4SQ7CAN7522acBwy3G8gLU99Cl-9iIDpFugA&oe=6A4517EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fip7MklzHkAQ7kNvwHmESMF&_nc_oc=Adqki_ep71CKOMP2TEF8lWVJ_2lmUmRXlsN-uRqxHl5pK4aDCogkGAPXVyI4j44qXaw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rVFXspsvgLsQTPs7MxwASFLQUEKWAZ5Gh8i7Qb8X7Rg&oe=6A453183"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7f20f&oh=00_Af_9H_qLWsWy6YAxDZ63krrtsfMs4xPj3-8AOO5dPNXQwA&oe=6A3D25B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQn5u1lOF68Q7kNvwFt1L0j&_nc_oc=AdqS5h3Q7lPzuDcQ3AwVTyIG_eo7tRe_oRicU-6IQuHLUqlGT3R5x833LPiLXeJ4yEY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Poc9Zn09wnU4TKGSVSRexkKGSkQENuKyH7ZM3EcjpwQ&oe=6A3D28C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYKif1mc55AQ7kNvwFgTWuC&_nc_oc=AdqG9hbiGLIO5s1Dwt4Y4lcNAOK60p1Nok8KAWh8fw573fXme0j-15vLb9npKkVjbFY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8inDaXdehQ6ZSyftYQQS1kgyRH_VWTE0o35dK6c5uG2w&oe=6A3D26F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DIzE0M4GFIQ7kNvwGVsqBO&_nc_oc=AdrEq2BN39_sMO1T6Dz9NwJV6dKQpw4BvbR2no1c5TDwBDuJTcepjgEw3x1h7HpC2kg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MferuVCyBDGi6ejDmCXyTTI7FqAC3VTV1BTuXX8PXfQ&oe=6A3D2EEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBjBK6GftVUQ7kNvwH6HOWi&_nc_oc=AdqeFJdwYz6EJMHWrwgNvIP5VH1F52c1LSptmmdJbFPoPezQVnJZQMrk3CVwCXmkgPU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QA517OFkblh24MRqcn9rRGyGOLTqectljgeuo42WAgQ&oe=6A3D4883"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
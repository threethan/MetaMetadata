dn.com&_nc_ss=7f20f&oh=00_AQBCO9_CIvcIuBbsdRLWMc1B6C-eRQiynyhZ4-SqwNMWTg&oe=6A6C9BB7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSKr4iX9s-MQ7kNvwGJuMU-&_nc_oc=AdqVKdUSc6BwNZb67xDgBB-IkKVFt_SVyrTNpy0hunvean_0_qLd-hxaAmWiaIa6yq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBL3GPFRVXupwOaRaDKKeDm5KdseSTpFHqCj6yIXxQw4g&oe=6A6C9EC5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW37ou1fZ_4Q7kNvwEXE7fw&_nc_oc=AdoDVKKO4NuZAZ-cFIiCI05-xlTY_aKdHI6IojyrQLMG7AgEpCarf-Ix7CAwMFerZck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI7pjVMmaAKAwhHvnY7-S8iAo3qAsmPpwNq_IwKNrGDw&oe=6A6C9CF8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qm2pwX8dPYoQ7kNvwFLs_3C&_nc_oc=AdpdWuj2cD3wKX_S-DLu5XOHyAwzBP2wqDrNCVaazjlUVo_K1G0IMd-ilNWdZ2Uikcc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAslSklt9Nd2KphvAwdgqKmawryY_b_BW02TZDFcQ3Mw&oe=6A6CA4EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhsPNemSKNsQ7kNvwHg1QN4&_nc_oc=AdpfoW9v5q9O3Vq1F73FXQnXSwPfvBDvPqYUKZ0wu8gAPXv-rq9igXiR74CaIn8YYY0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtCzbk4kdWdBrihK4Lbo8yL7FOlcu-ClfomOjB1eMrVQ&oe=6A6CBE83"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
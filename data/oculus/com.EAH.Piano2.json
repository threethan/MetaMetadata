dn.com&_nc_ss=7f20f&oh=00_AQIS6NIhRgLzDvtb3tgQJbjiso_NgGieYg2PTxWelQts0A&oe=6AA00637"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQoPSv4YKcoQ7kNvwHsd1z5&_nc_oc=Adq2rENWGMHnHDZ5ezQAGAY61HRCxn3PVSzS0gpzxR_8tL_-IsmumjJbzIwGg3XAQdg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa6OMuqT9H4YYLtVtG5Zt0nNiSoIDhBy4xHFcllEntKQ&oe=6AA00945"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1fMCACc8Z0Q7kNvwGt13-q&_nc_oc=AdqG4K2bGPI-cLV-NKVMneDVxDy-P4Da9NXyr33rsEZDmXXC84j8yvLJs8TQW7O5K3Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4aSUcqS6P5vjKn9OMMddZsUMH6znNAOCd_rsSpC8c8Q&oe=6AA00778"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLUBHWLTWdIQ7kNvwGaW6-2&_nc_oc=AdrGdfqiyVv2lfJFVpMr-4zAmsJh2qV-hrXZ3JcN9Qc8x0NdItlGvCMzdKvWHadS4Xs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmS1Nthc0UkLrj0RnR4EulreJOHP9yRCV5XvZ2bszByQ&oe=6AA00F6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j62gU5qiN5AQ7kNvwG7tW_h&_nc_oc=AdrelWT2rzu66k_Z5BkdG7q6eq0o3Wmyauqm1NxHblko63cRHP0HiR3zEE7VRZVMQzc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9vB0SOhrMSLyz6GGb1zA9FU1KGIaSEFW7aYI4N61K6g&oe=6AA02903"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7f20f&oh=00_Af4GRM7RQkEOUmRsLyRfQfFoF3pTS_wombMCdJXEJIlaBg&oe=6A16EA37"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWLr8vj0TMwQ7kNvwEWH_9L&_nc_oc=Adqs11qaD6xjrgE2VGyquZ5K4i_mQ0r9xZXak4N0THdgnmWCUTYcq0kLiNsbXQKXtR0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZJos-sjxLV29tR-rakgCZzemrDWt44ftcFHOv_N0mWQ&oe=6A16ED45"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srBYgssCN-EQ7kNvwHMy3e_&_nc_oc=AdpYySj_D26L-Wk5PVZbPdyHXgvNybrKSctRmIMZOWEntDR9r-uYrJkvWFj1p7yabPY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7utw-AjADJon2bR8f8HKW3aS9fEdPK4HBm-xAF3wj7sg&oe=6A16EB78"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSrp4Cmc5e0Q7kNvwHGTQGi&_nc_oc=AdpE4wLoNvu8sigoIESaVNnD4vMFVd52AqMD0hMt9mxZ-quoj4fE0Cp_m26M9mo25dE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gEL_58x9omaqUtB3NvhzGZlbpstAk9di7-ZPDaghNPw&oe=6A16F36B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IShJJza3XQgQ7kNvwE03h5X&_nc_oc=AdqegtX2PvmH7nZYonFp3Ava1sy5ENDS30-zyc8Xl0OqPjok1EfJN8rsi33iGtikxsw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7teCDoci8DDP0d5t8K4IkSSbC4jDFt_QtqWmw5TJGQtQ&oe=6A170D03"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
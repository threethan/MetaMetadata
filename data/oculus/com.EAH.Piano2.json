dn.com&_nc_ss=7f20f&oh=00_Af7xfVNuxbFJtQgK0fMPSjG7bhZjUV8QLp_QbtLsNo--lg&oe=6A1C3037"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7OHN7E3HZYQ7kNvwF_EPPy&_nc_oc=Adp1DQngUpn8hdTGI-VxA7KF96kjJDu6QBTHGUpP-6dB0GANGKLcwgEotdYOA-JW-9w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5T5ebz7RHDTrMd1zizKlR2XsevdVew3FC-XvPb013CqA&oe=6A1C3345"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiiqAtHhLM8Q7kNvwFhtqBA&_nc_oc=AdoWoe0KV-bot5iRA-eLFvT9usmItxm-QVHBcs2BvdJOGWG36KF5pGCBgkGBAWXOTto&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Sjqk3f5PGfkxKa5Wl3yUKK42B4-1Rh2BLEaxnSPSjhw&oe=6A1C3178"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlhGGI7yfNIQ7kNvwFKIFkL&_nc_oc=AdpJia6QACHLuU4m1TLtzu-xfykYFkR5_a2ax6SsqCyQ1sJwYU9LCLUg_FTAys6O6vU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tvXWlfd4w9fISmTnvycqFBNxhNA29kXmsxJgOZE9isw&oe=6A1C396B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhJDPEhZESEQ7kNvwGxp_MV&_nc_oc=AdphbNMIDbjLQHsCcSNl7KkmLiEL0YFovRiOJ7UmF1nkUlF2o2CALc8Txwwl4ld-TZU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c3ERR3rSL2kDM1mJY7fZ8EJPG9_bA5FvMOKgGYHB5CQ&oe=6A1C5303"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
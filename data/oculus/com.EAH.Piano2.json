dn.com&_nc_ss=7f20f&oh=00_Af83ozPdqVgbgAreAoDlBe1iSoA6sWePLrkAXLg6C6OgNQ&oe=6A411A37"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2SReB7zq7cQ7kNvwHvObdX&_nc_oc=AdqurTeqyN13YRxrOjBvk8wUqESjPB2eh1p7WPPqoxY15VxJRAXv_2pbRBitrZvGbd0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZhNHaTOnkvkyGRTNFDeYksouedrxRZmrcOOjyLvlo6Q&oe=6A411D45"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCS8DnNqjAMQ7kNvwE_W1Br&_nc_oc=AdrKzjMQ0dc0VNRtE07sOyn9Km-H2-U_8bxe9IHzGxpqz1QQKglCBAaAc4WqqDZZg94&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qP-cO2EHJ1knam6Hr5l4otHdyZpOYRKRfcfr578-4Sw&oe=6A411B78"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdGnlqyPbvgQ7kNvwEiB-iB&_nc_oc=Adom7f0KskpgItwBwJs6DylLyOZVf8AKN-y7kRPav9whaqOTYG4Bb7HNr3dBKttrX_E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cBu_omH64MhEp_iJq1wzo0lAcYDJrTADcnLLiMsx4Kw&oe=6A41236B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqWJoDPSF44Q7kNvwGmhZ-t&_nc_oc=Adr6sxs6P4gu774SO0o_A-6F_wdtPJkVFfIGJK6rOYED1Es4Na4tdFVrFiJFN0dStBM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZgDXTp9WwdalpJljrurJf0YHQuf1mn7z1VxDmVI0oPw&oe=6A413D03"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
8xGo-h902jtKrvabAcRrEAA1GQbZ9smJO7NA&oe=69C138B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQG8a1pzepoQ7kNvwH2lDKj&_nc_oc=Adph4UDN9Hs1_Z5povMYda2VzbH6P4Q-bWx_4-AKW43sE1hsE_W5gsUTkJIeBKwKr40&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxdkyJTKR1q3kISiqsiZijbaE4vUy6Bw1908kgs2rFr5A&oe=69C13BC5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLrx1wqF3FEQ7kNvwGfz38v&_nc_oc=AdqqcrwMU4tnfOJbBkfbPpv2_8r-5stJklfalyn5IwgdTUT9PUMkVtoPjs9xFRP8Z_g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRTxKqN1Bybo-6IK-HJU0x9dSBvZUOD2MsvNoXUAFgzQ&oe=69C139F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--1_7TRAJg0Q7kNvwGz4ofc&_nc_oc=Adrj8d3w2ZoKub6nG3wowUdgisILLA6opIWo5y27d3SurFE9oJGNHFuSOtIekvVywqI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5Z72XcgPZxQjFusBw85WWrabzZV416gg70HzgFrS2Ag&oe=69C141EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xd0p6WvmFWgQ7kNvwFVXYk5&_nc_oc=Adoe61nRfbXsL7W9mS9ihhPBx4FjklfHvHCcXwSnPPxjqdu50FjpUoDjKoXvZlYCqWA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEELL6_Ao_eX9PTK_7l23VlWff5TejE74vItbdshft5Q&oe=69C12343"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_o
dn.com&_nc_ss=7f20f&oh=00_Af7Fppr-lPJHPKEh-utukH2rr2zK8T2GB6weyYqP6aXUXg&oe=6A0C5E37"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hriaXU2HzUUQ7kNvwEZpuwU&_nc_oc=Adr_d1f_I0-3ILgzeOZgaNE4w-GOgzFQiZ4E8I8iThEFBtPc0sotg69I8K38uabQ6Bs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PaVRZ4flSSCVrWUZ0Is8ufEbMyB51uChc48A5-21x9A&oe=6A0C6145"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3r_MH38EwIQ7kNvwFPFKLz&_nc_oc=Ado9jNSFVowOe-_mn2db_d78DuT6eThmqO5dcIGTLksyn4iOrKbNY4UyYv1KwMQZVUs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71O1Ds9uH7aVKbay-jvjELnqdXBgcKz_PYcwg3UQqnnQ&oe=6A0C5F78"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9AGIUXC9FMQ7kNvwH-l90K&_nc_oc=Adrexva8znAy8QiYKf3GyiXa7dVqgidwQi17u5Tk18gv4mkdOULVAXBnmyCeHkjhe9E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LYvw-QJeypKA3QNRu1KjTO_7srST18sqhjRn9J3PwaQ&oe=6A0C676B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eqz2enL7dPoQ7kNvwHCghL9&_nc_oc=Adr9tNmR5rufHmafhixFQ8uYa27evKqnkBWTtqP__dd6NsfpS7me_oVtkgEc-7Jq1Tk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JGMlFBpf7zsg-KIGf54Yfh06uTB7akHVOXu4O6h6_eA&oe=6A0C8103"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7a30f&oh=00_Af1WQiOfehzH13gIqiTKniNYzZGNVdHQ44zjLByrMMmvpA&oe=69E77437"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WgFTryxcxAQ7kNvwGnJ0B7&_nc_oc=AdpgvvPwvHta7wgQun86T1bEeRUzVlaX79Id0xJa5dGseUTsKi_4cC8IHdCx6WLai2s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Qq7AfiQIVMCcb0TWq8mrOs4XjhcaqGACXPVKL97K56Q&oe=69E77745"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXD89q4cdT4Q7kNvwGwucvl&_nc_oc=AdpToFoqr6_JErq4UStPPtz38EndKRJ7xZvzhX0jZjoh_l7IGQuMMaWl9077_VUT0vc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af024X_kz9KWyfumvn_k2WkU4LabbOAAxrthv_dxD7kpog&oe=69E77578"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLeiBqexHPYQ7kNvwGHOFOz&_nc_oc=AdoXCSrwD4Q_cP2fUS5OJ6q0F6AksHxfogePU1UzV50f0cl51Lm6TLG4LfdMZPwrZw8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WSsoXOuLvifw1Pd08MWWpL8zKvNRmLiag2gV0-2UajQ&oe=69E77D6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVM2oiT_720Q7kNvwGRlmcv&_nc_oc=Adqvc1lGIi1R3YwiHrsylzA2BmYw1SpBFEjAQqCEV3Cv1TE_s55ZOMwNZLU9zNLMufA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Cs5D0rotS8YcVxEArjZSV8siBfjvJ3pHYoIlqhTtqyQ&oe=69E75EC3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
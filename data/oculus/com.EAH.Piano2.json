dn.com&_nc_ss=7f20f&oh=00_AQCZ7A5gOPqTgOBbWPGsV5evJxJcTBDNnE0sUqDu9sDB4Q&oe=6A6B4A37"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSKr4iX9s-MQ7kNvwGfzQZQ&_nc_oc=AdoEnZ48F8_S5qB-Oo1XJRim_QEuUZQ7pEkP022cq48HchDKsteJ0X2ZESgDUMiUiDA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD41ba3IL0G_hBsKQjPJVgjEidU2Hf3c_1FvKW_LD94Ew&oe=6A6B4D45"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW37ou1fZ_4Q7kNvwGXiG2G&_nc_oc=AdrxULFxAPANK5fNEMs_HNZwHtaYXw-0mablmwTfgpXh7wJaTz4b9xdIVDM8IoM-aGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhHD-WO0tch8xyv_cPIfYZxWmnljQDMkbP-8l9H-wBJQ&oe=6A6B4B78"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qa9X0ZgghgIQ7kNvwEjBYSU&_nc_oc=Ado9gxL1lVVLwPLPUTdW-Q1OtX0HYWEeDQsHLsy1dcnErCXGaapTmXKnFgZo1QDLkbY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArWYYJclSKAvI82tvFmTOf-ZbpVAq0KotPZrDipaBKig&oe=6A6B536B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhsPNemSKNsQ7kNvwF1__JA&_nc_oc=AdpPGYFLjhtQeU6C2m_BpOclBk_YmQUPwfbn-eydsvYeQo1udp9QayrxzptqEgf6lk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_B6bf9QW5wtD5StmH2TKZmeSOZg4T95gftWM2T2YrTg&oe=6A6B6D03"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
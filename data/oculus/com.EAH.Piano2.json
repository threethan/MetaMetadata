dn.com&_nc_ss=7a30f&oh=00_Afw99ya9Nxr-akH3Y_35fAgNTelR69f_afwCO_rzuq-xOQ&oe=69CE67B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lksdOWODGzgQ7kNvwGkmdTX&_nc_oc=AdrxJQsEC8EVy8EEh27m8JdPCIoMgq2cHuhTwmGEbQRY7Cx0nNMdgrGl1NqZ3ZHWPGc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3F3Qg-_3KS8JuWwSpz9nRAKJPY5WgZu3TvNo61_OThw&oe=69CE6AC5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ayazue48vAQ7kNvwEFVO51&_nc_oc=Adr6I-9vkCRdsd_ADmbEnSNdtHl_EITx8CY1pMF4dSUSyGh8bjKrVhwLrxk7GnkPa44&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBAnxbGxjeRGHDXeFfl6g0saTm5wMya7rMOIU3y_Mb3Q&oe=69CE68F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAlUSR-UpskQ7kNvwGlH-wr&_nc_oc=AdrXsmRZ7MSHJUtuYv-twZbVur0g9PP5-9Wb5nlN7ndO2xFHN3rlgrckZu5lpnJAqkU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyI6DgVCHAFpRnDEGmVlRS_avh50TXpvXXW74EMuFtLxA&oe=69CE70EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LHa_SI7KMMQ7kNvwEStv9t&_nc_oc=AdosRwF7eDqdk9HAaN0LUJLp8qfjPygyWQe2GukU0SNnNWJOnTq2hM6aXyqB8B4CNDk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXgwYWiuJz7KTytmXuf8-2jA01UDgKSUo5k8NStLMp8Q&oe=69CE5243"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
UNlbbpg&oe=69F20037"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AURlHBmwpT0Q7kNvwF4l66c&_nc_oc=AdoDL0f3Ax_hsAPNMSPx7w0ODLCxSpB2I06CiaDjXbWoEag3BBv-zta0A3jfpdVQxKg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2ODQsY5D1vdCws57V4tDqhabE2joKuJvJ8taJC1EE9mQ&oe=69F20345"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Mn5gPun_z8Q7kNvwFXtbjt&_nc_oc=Adphb6xkzIlnBD7UfMoi1CeyiwpnWbGqaS1B_vUePVF210G3N_dq2lcxDRXJzOjSZ5g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0iTwZ2Vbt7ZDaO1b8NE6phyZHAtDnpoNLYtg5ZNPO4gA&oe=69F20178"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWOmfxBT5QAQ7kNvwGJGwnN&_nc_oc=Adrnao01UAqf60a3cn7VIS0geT552l2Wxe6mK_L8JQJ4Hvu7Cxc63FI5g0I8hLUFxfM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0mly44wRS6_DYAt7tN1L6uHzfrTNJaLX8ucCWy8Yv_sQ&oe=69F2096B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7ML8uExVBMQ7kNvwFe2LNc&_nc_oc=AdrL5GnXSzyxZPJXCj8wOaz1zc1wnOR8SSp4tO7GDg-4itDsl1Zq6NIXaubqpdaFhIE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WxchvOMrQz0NZW1KhQtGULRwXMslB8M6ysSc_jPK5xQ&oe=69F1EAC3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name":
dn.com&_nc_ss=7f20f&oh=00_AQBzAHboVf5mtJ0tpLtb1l_SSwntfp_TobiCFeQVudFhHQ&oe=6A5E1B37"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EN49LU-q3WYQ7kNvwESUt-I&_nc_oc=Adr3EP15xOZgltCaRNxhmr9CbzSAkeoDny3pGK4QjFSmNZ-C9p45YFuLRqJiLtUTcA4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjPFH6L_bbhZftAzmCD62XXV-_tiIitCfi0YlGzjEzTQ&oe=6A5E1E45"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRFFXWatcKEQ7kNvwHIEHax&_nc_oc=AdqSE84exYy69fpU3aCs2ngPwUTp_9itZ9CPdY1lJ_DrX7GO61WryfrXibu1OwKFdl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYrZPZsk_IoJWYj4Q8qGYxA8e2dCHofMtEDhF-CqOLKA&oe=6A5E1C78"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Se5MpgaFYAgQ7kNvwGkR-_q&_nc_oc=AdphIiicM_NetiwUqmIZ7wrGieA0so_ODxc69D8xUf4nmvfZ7xPILLg2CvFlZj5ymAY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAH9BodC2v3mCF4AU4mk89-dNU9Vo8Qvv4XRNTy6TdGDw&oe=6A5E246B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opOwFzvcDFgQ7kNvwG4VCET&_nc_oc=Adr3TbwhVrfGB5K6ZonEUnE3kx1vmUgEvoBZwMHaKnZDjGqgn-VVYouCbI6dQ5iqi-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ8gbKSOFcd0Uwv4gBhBaOiAoBoxKmoYf4i22GpiTJBQ&oe=6A5E05C3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
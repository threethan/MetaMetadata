jhIqMF98GCU9sgLJGVwzWw-2UJ6WyXcDZ3ZQ&oe=69A97DB7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlRbSKT60I0Q7kNvwHgsFA8&_nc_oc=AdkuoY671qjXbil0VVF99DesKUKcIOubYuLr9jTz6uB0nXh55UicBTjMme_aYKOxKuw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftKiKO7RDHrIVT5aPHcyxiA3ZPhEDyyvx5QnRhrFjUOnA&oe=69A980C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7I_IaEDVBsQ7kNvwESByft&_nc_oc=AdmY0_tTKwrAOsOvcT80_UodC-JL8DaNA0RwZdpP7ghHZEfd__4ryqjKktoohHzs6Rs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfudLFYuabBCR9_Na3RnTxN9Z9GtI9nHdGtSaRiQ8i-OdA&oe=69A97EF8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uIl8MVUD4YQ7kNvwFFMrXh&_nc_oc=Adk25PMsUO1kgE_MHr6-cWoG71Nq7S7XM_UMiVJaz_D98Jw83qzitVDS-3kU_fNjIoA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftvCiXLJtsPkCIzNVZUoVEt8df_Nfs_RDjcjdfAAodWlA&oe=69A986EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVpzEQ-zOrUQ7kNvwEjI3kS&_nc_oc=Adn_rAmAzq9eYnrVXxgCptknaov_l1tRXD-JRH6vY2fYjnRVOXkSGmY6jGw-HqetrXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftSxbDHguAufxx5I-_7LmVstDZoa_plex65AsaH5DwFeQ&oe=69A96843"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_o
luscdn.com&_nc_ss=7f20f&oh=00_AQHyCKytj4k_c5t0dj_8lCMOCoiynhi2CUV07ul7hFiCAg&oe=6A7DBF37"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwGEE-I-4UQQ7kNvwHi8y9E&_nc_oc=AdpNwVQ9uy5vV3Hf5SCnJXXrmVeZmiS_CKGbx_q1Hs2uRDbYsuW_wSbF3mVc2mmc6ek&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxYAAWP9sTOvhsrK7X8PS2cJpoFAzp22OX0JI5zQz4LA&oe=6A7DC245"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rI456eZDDqEQ7kNvwGAFgMf&_nc_oc=AdqP5vh0l0I1eKCmD0Br1tqvTkdai2It1_OUnfrHxhN670_Bu9o6IksDw6gIiFT9uF8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHgHpOY62x9wfg81xU9TixifMNTnCCBOhdaKscF_ar6g&oe=6A7DC078"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcBh1J1O0zAQ7kNvwGl9oi0&_nc_oc=AdpR4WYfh8yNT3hlh8G02zFQNBkZJb-jhtViXosyL19WLAUqadly6WsJ_11L_Qv89LI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCoO2Mi4TeW5xdjzQjXpp_GqwxyjYFW9RPqHMiRXhb4g&oe=6A7DC86B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLI_UOZA0sYQ7kNvwHqNkxN&_nc_oc=Adoa9G1HCML99sndBV2_4cfqOTmwkmRe9MKD_W46hDX0LAEn3qc018xuSRTrFYCybZk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGWv8qTArmJntcHBp1RZl4rZxywi1eJf9nyvSx2P5CjQ&oe=6A7DA9C3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url"
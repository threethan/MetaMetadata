dn.com&_nc_ss=7f20f&oh=00_Af8HI6HBAYqKth_zV2cI9pzcFc-jt5biLbdlunGStuOp0g&oe=6A2EA537"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RieYPrRkyKYQ7kNvwEBA1nh&_nc_oc=Adpd4MT_su7OOHRHJogCpYJaUcb3LkVh-lDF8mkhZWQEP85q_VIy8YrYeBKjRA5dqpA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vlJ879E9tOtFP-KOQXlMUYUMIBhvOItM3yGw2lyYmzg&oe=6A2EA845"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uR1o1B-vlxgQ7kNvwHcmcvp&_nc_oc=Adr0XS7DnrmxpA2k7wmF8v4n2RSOo3vJ8IVopPuoqRr7A3JTzhZqgr36kpy8dHasZEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MA89cgKRqLO6R6eY7dv_kLCm8jTzb1QbqVLdpQVBWpg&oe=6A2EA678"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyJrDdKLsJYQ7kNvwHYJKNo&_nc_oc=AdoT0URfqHy0C55zGOB3J4gdj2oMeY58BIWnxpFRTqqfgDsfulIp8ox8tHa0dY5MkqA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f0aVIF-qb_71L43DKy516-3uATp1nj3O0ccx3cbT3IA&oe=6A2EAE6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZbcyI_R_kgQ7kNvwGe4ik9&_nc_oc=Adpbwnqqu8Duhcsz2-83Z6BcE-X_Ys8pyEgmBzaSzcSAa_k2wK-7b1XiKU2R-7NGkAU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8t9uRuYbLD5Ht1_bX6M3eIbPaFMvC4dwNRfwl246NH6Q&oe=6A2EC803"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
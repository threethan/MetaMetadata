dn.com&_nc_ss=7f20f&oh=00_AQN_xEpcxwLf9miN31IkSydvRdzs33t6PdpunWo4lFKV_w&oe=6AE342B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_4r2QzU_akQ7kNvwEx3OjW&_nc_oc=AdpSFgkvfG9ZBaAKC5XbOr6p3KiK8cyOo5mZXcZA0WGo_dIlACdEuZiv9ASoVcPzupE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_dd-O-RHLzRWgm64R_PiGNZ5rex4x-s00viSIu-Ie7A&oe=6AE345C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arN3MlPMkSoQ7kNvwEjLUTu&_nc_oc=AdppPVJ8pA90PLJly5bIdt49V-7AEtoGryJfIksJAjlHrEbbcGF1sitk1k-teMhN-rY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5XgLli-i0r7pN6jxKpmLLXrgYJLhxnqQ0ekwWIOk9Vg&oe=6AE343F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2im35ZyJZ4Q7kNvwF5OYIj&_nc_oc=AdpOprKjhgsh-XBpyo3SG-D4da6nrM08Ey9InkYT_EzN2P1VBpb_KkWm8dPEV-VECb8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMArmYSFOmD5z8UZtNf2M_bkSaR4-SUzasSAQkIfBz2xA&oe=6AE34BEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nO_ZxVggOHkQ7kNvwHSQdpp&_nc_oc=AdqBl9OwNWVgPhViJE_yH2dd_BCQSB8GMkzjR8dSnKs_ziFQq99SpVFLkMtS7eqv5Js&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX3Tiynnp7E_Mhokvna_Cf_DvcVqb62fM4HRsO9V02OA&oe=6AE36583"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
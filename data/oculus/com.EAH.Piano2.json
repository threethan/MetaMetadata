dn.com&_nc_ss=7f20f&oh=00_AQHUxhmXlZmajhWn_buVo8Xlbzgq8xVukRqOJzD6G64n-w&oe=6A8AEE37"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nGk1Dafo9QQ7kNvwGNzX7o&_nc_oc=AdpiNv4tWOal9zV-0Jcvte-pEQfnSkoNLDxW4kywnR2ZjYsKrC63zZ_IR6vlH_c0NZM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5S-KYkMks7EcIwZp6QZkx_h9g4ponOjsh39EZOZcAqg&oe=6A8AF145"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWUUBBJzJHwQ7kNvwF-gSjM&_nc_oc=AdqncK6q24GYj2F1vu7jirTY1hQDGmLcJ8ITkhKawcTmFJEkdx2d4-Ac_30or30_HN0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4gu2pzd1D0D8nXH3HsHs7KqQOXaNXp9bf_5PLPUSdzg&oe=6A8AEF78"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Vjvr9SfZf8Q7kNvwHFj2k9&_nc_oc=AdpEuNC2wHr03Ci1Wv2Khj0mnqBCOAknayTvjnp6Qc8JJI5Q5DpgDMoJMSyCZs6nBl8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-579K8hH9e3ZSMH2QuiG_OfKR0CrQAqvQFzT-_sLiJQ&oe=6A8ABF2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhoUBYQOI_0Q7kNvwEQ-SAw&_nc_oc=AdqLyD5FlWoPtOmm-hkvknpTCQ6fMD3l8MlUeF_k9RIJPrTB-jBAkBm6fFV6im6TZFs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1AFH8MhUkR_krbrquLWIHBHyU-B51RMiLmnikRaxGdg&oe=6A8AD8C3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7f20f&oh=00_Af5nJi_7Iq_mhDjXnIQDc_LAs9cpmxPq3D7iVH1LQ7sc0Q&oe=6A1ED337"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJCWsOZrPsAQ7kNvwGhqH6f&_nc_oc=AdqVgjvojbEC1c4Dt0Y_yaPRSbNq3cj0w9FkaKzpHlxPLro4Pv7P8F-dkSFYPHJepac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PGc3hAcNafmhA4Hd-AGCS4AtKBmjFdT3BoOLFOoih_A&oe=6A1ED645"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiiqAtHhLM8Q7kNvwESkxB0&_nc_oc=Adpg2yQcrbR70a_wkRQ61X-_WPs0mUVixfYuXdYB_NHgdG--76jd22Y2fnnVIT9nUXo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Kdd9V3N7ZCFjcsVPaf9zNNO47OBemYa791c2YD46KJQ&oe=6A1ED478"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTgrgRZfMhEQ7kNvwGvx1U2&_nc_oc=AdrEYJgqOI1xw6VMyYTAqKecM8hx1lbAT9pyL9t2LlsQFVnlbN3brW3CjpvY-AzSVXA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-su1ZxNNRjreMTopGj1McrBx9MBUwySMn-ZZY4q5b_A&oe=6A1EDC6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhJDPEhZESEQ7kNvwGNGbcc&_nc_oc=AdpRXa6yXokMGg3n7wF_NpGm9hPweSgkZMP0nrV-PJWG-fnw6MhKWggRBYr2a8LuFNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oswa1T6hqLhsLC59uQ10Zav0tPKyK6qR4sfxnuffnSQ&oe=6A1EF603"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
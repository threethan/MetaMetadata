_5360430878652844406_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V80EnbJ6EMsQ7kNvwG-gw5j&_nc_oc=Adq4hFBebJwXR7gDr8XMZvMeWvjAUTda6BmGe_e49TilIGLmABqrCqtb9liLn33UtQc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXp79hu3708wxE0rAhYitMLArcPGKF_F7qwcszS6-OTg&oe=6B05C1F7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCpjcw9WF80Q7kNvwEbdU2q&_nc_oc=AdoZqhggKdKKjrHAOTwwOlA8aUSwKnwJRmv9nzW-bbu4p9TBnTsYBQcGh0dzDy55Zsg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThl3WdoQ0k7BNovncWFRVeMc5FvedtlBNUdW1EZrmV6Q&oe=6B05C505"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gAWIVLxfKUQ7kNvwHvC3fm&_nc_oc=AdpfQWt8LiMVlagMLh5y0IHNPSPiwKu88CtBbPAU_Iqrow6taib-nBjpbId6iYeqYjo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNg2bRPrOV_ExWQJfH_Km7VABii4FJ4_ULvmp0dycE3w&oe=6B05C338"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lx871HwT7kkQ7kNvwEns-uY&_nc_oc=Adrz3xhB9Gv4HaQwDrO-tfRw0pbQn1jc4nWapfSspct_0_Qpu5xmR1k6YTfTN7FLsOc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8zXB2ZyQZAcxjYCKiyF-eMrcD-tJp8di9UIm09K57JQ&oe=6B05CB2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6X3_qWtwv8wQ7kNvwE-unzX&_nc_oc=Adr8kc16PpPjj1YFBXqWyupcOoD6dxIXSeSC_tymAX70rzdybKh44_95-A7p4xx9TFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIEf5IRCq79KK0LDASbGPlRMtqoCyDqWwuKVAJSikDUA&oe=6B05AC83"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name": "Andreas Hoffmann VR EAH", "support_website_url": null, "website_url": "http://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8953303331379610"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974804_3408493612784264_1726599624567440105_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=560Pdb3-II0Q7kNvwG8qegC&_nc_oc=Adpp8QpjAOQDMkVPxEyQuGCQr5bh4BygR6lgVUWMP_CbW0PZGOAw1rMm0cFWcIj7Yr0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJJOQm6Md7o3gl_H1YGaZYCP1Lm--8NNAYMr_nNiNcfg&oe=6B05B20D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Piano", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1679345827, "las
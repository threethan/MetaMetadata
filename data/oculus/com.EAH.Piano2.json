dn.com&_nc_ss=7f20f&oh=00_AQG2gnk0rD9SDzqY-YcKkqFUc3ajWUYijkuuGnCpkcEBLA&oe=6A7C6DB7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvqTbpMgW0cQ7kNvwGikIVl&_nc_oc=AdpRrvX37x3gL2ifq10-30UlPQnc2Fuh1NZv4aJjp_7l1Zb6ZUjpCMZMVJhHJdn1K84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHU5f6fCV7WvkEyUvv0MtxayOMk938ggGL-NifQYvoeqA&oe=6A7C70C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rI456eZDDqEQ7kNvwG5Hngu&_nc_oc=Adpvh-BFW638mdRRMyH5TACzXSLvLZgHY4DOL3t01b2HDQDTp1nFMMOFqUvjblnX31g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVio__aNUnfLTvk9DHOob6X5EEIFMR0jH4hI58RnuvdA&oe=6A7C6EF8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcBh1J1O0zAQ7kNvwFVeWL0&_nc_oc=AdoCBG0iMxGVYUaTVHqUbL0WUNol0Y6sWJNOzKgpb-00cPRHiYiRe1K6WdFY2LYR3rk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf3a10xdK4i6CGEjbHjYBymQ1f2bXR01YE0RsiVf1PYA&oe=6A7C76EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLI_UOZA0sYQ7kNvwFs6wWi&_nc_oc=AdpkghYxYXSFdyf32ADBLXkCKl_OQ1LLWNsoGiDSOFbWN2LU7aBAIA0EwOhQpDbXXqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEk_ChCwonK6-hOO_9YmUO48dhT9w-4k9JehtyX0IpIrw&oe=6A7C5843"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7f20f&oh=00_AQMsS9N5RSsw4H_xhwa0QjlAenUrJI18E58zXlvBOLdZ4A&oe=6AD105F7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUn_PL4IF5gQ7kNvwHbNAV3&_nc_oc=AdpDUE8Oy0siCvak3zHfIt87IscfXd6hYtVEomkqhAbQ1i8q1FxoYpkDiuMN9VIeCHA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKkb2X46WbTHTvI5Rt7Pw9oQfhXF1VX0w9S1mzhb96pA&oe=6AD0D0C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3A7OpaItuQQ7kNvwH4vau4&_nc_oc=AdqSttsjT7sxCD_NvIKIpL8ssANSU5e5-QiQ1sK8uyIOinmFwfVrRl2ul3ESTlm0LDA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPkJgIT-9WqEy2Ci3VjBEi-heJ3yCNG8nf338R6kWDeg&oe=6AD10738"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RK0ZBUtgXrwQ7kNvwF0zCjZ&_nc_oc=AdrbSVfC_tUIsXbcHHZwxC2ZS8P2MbrBoQGDCLIMmi_jrqQ8VLXzeGvh8nA9q2lO00M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOOjgk1PATX-nZA4OiFxcvpNKnvh6umu-AtxmhBHBdjg&oe=6AD0D6EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m06yVXQaaJ0Q7kNvwGvxOQP&_nc_oc=AdoL0NcCUQRu-PcVnbjBvWw5l8OgZeoytIN1iD3b-z9MQ84m3b6UzEjHG-f1DuJIuDg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKwzSvOu14rXkAQXfVA1q11la0lED2y9Fq6bpHJboJcQ&oe=6AD0F083"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7f20f&oh=00_AQEhVVkA3akO7Z2IDRjO9SsidW9eXHedtwIAo-d6Uhn84Q&oe=6A787937"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXzFcTVmm3cQ7kNvwHXkz6E&_nc_oc=AdrsYXPjTs5d4v9on-NksoATIm4fZcS5RQxExU7DVxDTZ8vq_mzEYZQ0OaLz9uICQ7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsbuLGvKkKnLbbMMNkqIndqr3AmHnRtQVkrfPucSsfkQ&oe=6A787C45"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvFB6_2kmhAQ7kNvwHGQc_G&_nc_oc=Adp3W6TLCbx6OgIkH5oqQ1FYKj1V_PnVBqadVZQYP3tK45I4Twqq34dQm1-WjNqNaI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGktF_Cx-DgZVy4NHgf7XxQQJ3HDiV4vUrXOV_zkGXPAw&oe=6A787A78"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uVWzYiuG4UQ7kNvwG4sgXX&_nc_oc=AdpmJH97uucTMtWYrI3Rrla1ykJT4PwrFx05qR0Z3ySbcKsHgHXrAEoTME-nXjVUeyI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbiLSHyrZOURhRozYarqeUNd1TYIeOlgd62Y6le7rQOQ&oe=6A78826B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IXAXw3KA6QQ7kNvwHgXoKD&_nc_oc=AdozzClkGJnzPkVOeJYPQLDJkE023iJXAclrj69ftD1zk0k8TJMLoukjNhyHeAx_kDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ2o_uGUsluJ3IDZpdZhmFnqxCca39EP2ngUINuBN2Gw&oe=6A789C03"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
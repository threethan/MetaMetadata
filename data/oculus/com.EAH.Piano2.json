luscdn.com&_nc_ss=7f20f&oh=00_AQLOpOXCnPr_UwcnTcNNPG0OgPqgHpcerm1DKw7rp502Ew&oe=6AA3FAB7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stB_B6ys_a0Q7kNvwHebJb0&_nc_oc=AdqsrEIuJmz0PN4-pVWIUUgvWcTaIu9FTd9mzjDXGBAHVp2epihgYBeVERdB9npFeg4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtn08zKxnrAchVFiK6kU3JrPuFZVdOVmDQLKSni2t0pA&oe=6AA3FDC5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hay_1Kikd0cQ7kNvwFjkj8k&_nc_oc=AdoecNCwibVdf80edX7xZ4vx2YNv1On4k_b0HZejDpsretikQcKl0j2ljheJzJYrp9c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAsQcoFDAXF9f4dGBpLllXKilSTRb-cBw2z0gwkelQoA&oe=6AA3FBF8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gd93kXTFvKsQ7kNvwFtgMTq&_nc_oc=AdqfqTL7fp1q9b3YHIFppX7blyxb-jSIFT7rkEMs8MAH6i290F9zRfvw6bs3FdzzCeg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDgRLhUloG-vG3hUVBTb3zSb5PODco0psPZv9zEiVwjw&oe=6AA403EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxFHUyjkhHgQ7kNvwEpQ1Vp&_nc_oc=AdpUp_Go5NxBxfkaSmhFuqME7OVQ1pXBXKFe_7RZqMwjYYIe6fZbog45aayDUu3B6Q0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWXpdYKbOu5Mv8aDpLC3s0liw5TP-NWO9L21mtWogl0Q&oe=6AA41D83"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url"
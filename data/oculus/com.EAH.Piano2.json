dn.com&_nc_ss=7f20f&oh=00_AQSD9ayGsM9UVnMblrGKeXGfmVtoYEJBXhKYgiTyVH578A&oe=6AEF5877"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbrLGa44cbkQ7kNvwEyZsT6&_nc_oc=Adr6p0y4-hrGxjWxjDxalhARZuj24Ud0vT5rkoKxINTc6acCwswoMGD0nqH37UoPoyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvR6gbFP_BKvbxZ-UN_yAWLgPlvPKRLA3gRJBjqaKRyw&oe=6AEF5B85"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1p77cqABLBsQ7kNvwHMc96p&_nc_oc=AdoFxLr1E5DJ7YrrTd798feY-w6qxs5nKkxyQ0T6GPNaZOKnIEX4XD0rlxVr2DwcWzI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThGmqg774LZQj5cwI3NGQe_KT-HgEDJnC10RM8-GpRpw&oe=6AEF59B8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yY13zsfYvIgQ7kNvwF8F9YP&_nc_oc=Adr0Ccb0J6mJT4dlsUx8InYDmLoO6QtWIiZ2V3lxB5TRBsNiZ6qJmNvnkVYgaXl_eks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMLtPfWws_ttKO0Ty1NxLRQqx7WLDyH0pGklRipX64Aw&oe=6AEF61AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uThE9GtXC6IQ7kNvwG6bzEP&_nc_oc=Adqhl9O0Ahcpm1NNxninJ5PX2FCOvkqXFaVPX9vFAVsynjDFSdeuibWONqjUiYSWP5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTYwvQJ5J6-inUmCmNYWzjvqXm4vLI3Qz5A60pJz77gg&oe=6AEF4303"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
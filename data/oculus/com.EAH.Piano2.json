dn.com&_nc_ss=7f20f&oh=00_AQPFE2j1dBc3gFQelyI7oEpMmn8ihi8KRDvLkxI7bAhvnw&oe=6AD3A8F7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUn_PL4IF5gQ7kNvwE7dhPL&_nc_oc=AdqQNdeFbggvIV5UEO2Bv-3IAC44ZRvwqFz_5SHh-2S3MHFxmXcHch37MENQyxqKbo0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMp6tq6uIZPjNwCsaERdMFZTlB1bLPV7Q733eKiZ8kCuw&oe=6AD3AC05"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3grlwWB_8MQ7kNvwHQOGYE&_nc_oc=AdoFdZKkMitwr7-qTWyXSdWw5iRWZ7tU7KsL2484XDhPsvmn7nb2mDHDLlX5xXRFZFM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM43NUvMnKayKswAtI-cO6Uek161W09SAH3nX_tuaN-eQ&oe=6AD3AA38"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmMYPOU5ZdEQ7kNvwFtTI3-&_nc_oc=AdrSBhxc-OKsTUsxDOKd-_y_HVZAvIQCnQX8lZAXN44DFlOpMM71fTtOcxpm1gHkfWU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMz3zUfZuM6GLkEGdTdMMpUdfySbBl6iW2Zv3j1mYBqOg&oe=6AD3B22B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXf33-pYw8AQ7kNvwHXnWXe&_nc_oc=AdozuUzwqZqkC93Xm1mU2JOVJD7VJYiDk7SFZw0-raU-yMyrMwEaMs1U2hKhGAPv8_8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNARbV8kTdqYiqICfuM3VuCqsui5vYo6sugA2VSjv5EMQ&oe=6AD39383"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7f20f&oh=00_Af-iF36cryyJe_V4X_UUN3pJ_2Mc5oV6efrV6NbIykkCxg&oe=6A241937"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dfy-UKJ__SwQ7kNvwGbv85d&_nc_oc=AdqnQ1qoNM8gmX-MG2PVtSuBwH5Cv7DIRpWLhSgOPD5QdpMPXORStLkzmFz4puS2Eho&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ns8y1Nzmz8j7gmeULS1w4SIKnTc-kMGePbayDQ5KWSg&oe=6A241C45"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLjuicmuhEUQ7kNvwE6yrkv&_nc_oc=AdqTK3HnFpwSnVC1t_vZeyTctYP1oVUUVsHxEvuNkqUqrrJd-rLsa_DQ96ZjoPZFnZs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_48TK_z6plnU1P9ZVn4fu_B1dhLTP5QdPBnE2hh32MKQ&oe=6A241A78"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yJ747GlzOwQ7kNvwEMfTzc&_nc_oc=AdrHte6Q_ZxrBWYJUfNm6-cRmvtDNEZfVi7OWizEQtbat93lUxRzHoqPVh2s45b5EzE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87wz6fvmCjevm9xHfExtdItllYXo1iHtMg3ySXOT53Rg&oe=6A24226B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2wAnGlFaGUQ7kNvwFejSr9&_nc_oc=AdoR4PGw5v7BRhn3m1F7p4uy2puok4PEafmSVUKS7oBnAjypLUURPEr_I91xT6sGXxE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Vu9wArVRfBlRsXYxnCmMUKO7JigYse0W8UtKjUmaBUQ&oe=6A243C03"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
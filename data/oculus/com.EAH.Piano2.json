dn.com&_nc_ss=7f20f&oh=00_AQPqcUOpJJ4qPCq4SMPtKf1Z-uSsEGrKYhZ63EmPDJi-vA&oe=6ADF4E37"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5StXLFqHm_AQ7kNvwEXTpov&_nc_oc=AdoGeqxpYZfnFS6OmpJkzz2BBkeFukd63L1e1pKZj6b2PwnSoUNhPa9Llv67XYBCpfw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJZtivdtrRkXn_w8YPmRG-ATbRjrOjI_E0MsDutT1LAg&oe=6ADF5145"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuZUvVOpExwQ7kNvwHaW7E4&_nc_oc=Ado6acV72XbkqIiV6puQfJm6vRLlZVfD2J_TngsCDgoHC3NYOXx1YJn0Qu3aUq0GIkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-69U_xbrUonlfa5eDVUbke5mmBGKLPm0jhtGw-A9dLA&oe=6ADF4F78"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0JaHfx_QysQ7kNvwE7fo3t&_nc_oc=AdpaVKFcD5QS3S-j56Mp2sECgoe18Tne7GN3_k-cKu_Er7NSwE406-RqoRGDuyR08_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQkFVXAVPSOyCo9qTnlD1N6mHUfm-RsiZDDpWH945WUw&oe=6ADF576B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjmMtyYXPLsQ7kNvwGSUHTN&_nc_oc=AdqlJOwTazL1Ywzghkcq4mWeGJkMW4PCE1BHM-pMt8MRRzN9gcPYYf6jJhrBQ85P0_c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyMsJmD1nfFycEoZ2iLVOinJOWbIDeoQDt2U8N3PVFUA&oe=6ADF7103"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
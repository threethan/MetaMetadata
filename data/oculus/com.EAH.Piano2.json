dn.com&_nc_ss=7f20f&oh=00_AQGJqSBAT4WiquYJBt5dJeJpPUMfVdruvNL8OF7S-Kmslg&oe=6A973C37"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASTyriP-_x4Q7kNvwHosGBs&_nc_oc=AdopiQUr2pRPHygFcuSskqpaVrLBlVnCjGAykFQDWfVrwe_HcHobLlrCVevfJPDA4Zc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp8QReZNzn7fwK9PbTGpwdDIW4uvXHrQkJyqkM_-6fTQ&oe=6A973F45"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcxlh-DNlq4Q7kNvwG36tmh&_nc_oc=Adpb0PSQ9ZQ4fN9ovIrgEyJgF4yOkOu0Sc_jTR20JfUGNGFVS8R-1Raq1RArY8vlujI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwWUQGCJM_tNc7dVGzR284a8SLFjHVmC7OIJs0hIuZ4A&oe=6A973D78"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQ4mWFVbV38Q7kNvwEO7uaP&_nc_oc=Adr1bOKWHRepnuu8V6sC0uLCGJJeXg0PUGlt-gFXwwp8VxY0p6OlVV_8l94KTA98d0k&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHObrEN0XqXnSYjbxuhKd-yabL-RtKcaSsIw_v-3GEy6Q&oe=6A97456B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCGKy3Edo7MQ7kNvwES2844&_nc_oc=AdrpIY2MQGfm9RQFQX-uBttxra0o08te7FD1GqsoTvCM3Cu2SdiyA6sOIbQabsEAhyc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6IOagIefiiAzG5Oh0TmY-JuZ_ELaRqkD64rgI_UTTgQ&oe=6A9726C3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
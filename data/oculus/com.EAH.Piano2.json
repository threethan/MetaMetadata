dn.com&_nc_ss=7a30f&oh=00_Af1KNki_TGS7qUBLSRNP-vrxWXqUq5JQVnR5LOmPBOQpFg&oe=69D7A237"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8Ov6mz_aFgQ7kNvwENbs7Q&_nc_oc=AdptZf-zqLiFEBp702qN6xOC9PvazZ8iIQBInKA9y4OpnbKWpQmqKJqNmGBgOb14FeY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AayPFYVrfCYz4Bx5nURPTF9tFW0oBt483aWZHLCET1Q&oe=69D7A545"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xy_GAqNJ8JgQ7kNvwFEIp03&_nc_oc=AdpVxyOYlMqjiH0T7y8kVDrsJyG79Nzp0g4qUIUB0Dxd8DU338UsO09k296GPP2nItI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wEzwDXblmnpbdn-3dHwfFHBX6RB90_o5N2L6S11C2rQ&oe=69D7A378"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-rU9AjVvW4Q7kNvwHycJ_J&_nc_oc=Adry_o0r8YXaIdpWKi3AKb6BfLQ4D1uLRQchqQJvuD73CJgg806LhWWTF4gCm7ajrvU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Kq7lv1iLs3aQlfiqJfOHAVGNG9xz4xff89yZ-_JJObw&oe=69D7AB6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4ofSGSed7YQ7kNvwGcV3oN&_nc_oc=AdoEoVTQMKWhYaKreUeMhkNuEZ1EzE6jbm6Eugj1v5h5fvCIDXH0_TU3GAcGLk5Er8w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-fqIIqUxZRwU0DbNsL2mQ9aCufxfn6joqKLOflIliMw&oe=69D78CC3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7f20f&oh=00_AQAvzIhWgW082jEUW2ROybREmeMkZIXba8KI0yu2s4AvFQ&oe=6A60BE37"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EN49LU-q3WYQ7kNvwF9Kif3&_nc_oc=AdobsNS8KIvUX-l4qttJS6-B6kGOkfrFZZ3cxkRmqokeXiqhLkG5Yb5sIiT1E-BLkOA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUxeY5X1ugxzPY0z_MxuLjlZkOe2N1ByXpvnf3hVPc0Q&oe=6A60C145"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUT3SzXXmB0Q7kNvwGDWb0b&_nc_oc=AdqgvameXcKzKKO6OSOHU52dG715WtE1OFCkIm6-YQ99rsa_RzYVuoETSvkSN6H440o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9BRPaKt_qETQ6mEGT9VjKOEtXBQwV9uAQomN34kHJ2w&oe=6A60BF78"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zZQ6ZynJFsQ7kNvwHzhZ0w&_nc_oc=AdqdZB_ctFDZxlirMV7i0Mc2nq30BEMVqQOSKrizeSfClnd56DAbxgR8nd2X6lNefog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv5yhDKj5TZY6gFbmI8NIpZMIHrL1mvfFSgt7L_TAEBw&oe=6A60C76B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KMVjOs9V38Q7kNvwGNvGJg&_nc_oc=Adqng_dOC5N5aAU4TbVWJVRf2Skh2S70d4UTVKdBtk1hbQ2Y7olPcdmCkP-rGgBaSpc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTjDjU-MnY9lVzbzDwpa0HRjeJjMuG5tI1R927iSEiSA&oe=6A60A8C3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7a30f&oh=00_Afzcvk0_dOVcsdIr_US8Xm_TNUx4uDWjN7YJ59PREJpryQ&oe=69CA7337"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkPsdN24cc8Q7kNvwHUWhiO&_nc_oc=AdocMJNzkXqGNzt8frQVZPHiVlJGQD-iJeC12lQBNcNyC8bi-zWoJcF54bCUgZ-KXW4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6ZU1PnSboDXuQ9J-F4_e6LUqJ9s3UOp4msx8Taz-LLQ&oe=69CA7645"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuEsyzuy9oEQ7kNvwFAfPqO&_nc_oc=Adq9qdr5noPHD1OpdCwdgDuYdfHaopxUTAsSE8Tt7RY78SJLg_Ya1Q9DJz8wT1Ji7eU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxH8gAkgGQRRqz21JbD8eQBm9rBKp1EpGLKzACXFxpG_g&oe=69CA7478"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLdfKYULLnwQ7kNvwELFFJj&_nc_oc=AdruBoausI2X9NVjL9OZsv8xw-8IMHmO6COo9sTT8e-B5bsJNkbQfYSk-OU-Z0t0QQE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyETPvy4sklWZB8jS0rutCCM3OghPs1iXQDUFF168L5QQ&oe=69CA7C6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNSO3BQE5QgQ7kNvwG5zWyC&_nc_oc=AdrkyJlAKeEPWzSOgL2bIFocL2ev4KxXGwEHLtplIywSvvoV3_voUCpKhTQV1LG6lvg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxujg86__RhsmrYlhBmn2WwABR7sEF3u2SonLD9aD4gTw&oe=69CA5DC3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBYGon7Eln0Ff3x9Oj5gi3igCOLkED-ynuLFJCpW6w1w&oe=6A8D9137"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQ6de3CItM4Q7kNvwHvHE0h&_nc_oc=Adptn4PqBkWVsoZTKnDaSiEC5CH6VEF-uuxpN11HQ3D7X8jyl_x8mTGrKTyz5ebVC6E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqeh30t58BKZZWhPqQR5BbtBUi_fHJgwf7fwc7-LysVA&oe=6A8D9445"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWUUBBJzJHwQ7kNvwGAF9cw&_nc_oc=Ado1oL3NjFQvrSpecYdTfYLx5qUZd3X9fQ-e44pGxiIF9uOG7b1wsbHlFuSt2m2DQf4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBe7sjrMczqeZD6y6NlRx_twcIMmrMzf0c1JaXAfhwog&oe=6A8D9278"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTkUr40D0ZgQ7kNvwFm4pit&_nc_oc=AdpMbl7ajuo-Yib4pqXG59g4p2FEiFvzexqexv7YxDQzOeLugs2ZmltR3cSygnwcEAo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJ8QxQ12_pAmbRhjIQ7LA--qf7ozpD0NByl3VLWtJDUg&oe=6A8D9A6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhoUBYQOI_0Q7kNvwFBWLLw&_nc_oc=AdqD__t6BipAChJ5KNu-iHYEVz1jjBM-5nvQPIMpGzlP_FQ_Xu2WCjppAZpORdOnuJk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1ED2EBt2q_Zwg0puUl13DeIlGPxCP81JjX2zTE24O-Q&oe=6A8D7BC3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name": "Andreas Hoffmann VR EAH", "support_website_url": null, "website_url": "http://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8953303331379610"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974804_3408493612784264_1726599624567440105_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0wyKslE_bwQ7kNvwGc96X-&_nc_oc=Adqa1pgwtFD1-q-ZvbuCvV4qzq7Zl8QvH6kknoh9MWNw2tsiGbYAaYOu7e9ge4uQK0s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPXOwmwnI0Nk-lvxMX-88PdSq17juSOnjZGZGN_yE9-Q&oe=6A8D814D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Piano", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1679345827, "lastRevision": {"nodes": [{"id": "5845235662186408", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5845235572186417", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "866417247751971"}, 
dn.com&_nc_ss=7f20f&oh=00_AQLMNN3s3BwK4bp_GwOoEWIlgAwuDH1cb3dUlOHXtxlbiA&oe=6A9D6337"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQoPSv4YKcoQ7kNvwGfUZrX&_nc_oc=AdpNqyUNqoLZkyEbKG3BdxzGZ9lpVJHPr7OdvJR_6Fi32rHH_hBXyKEJ_8wXr_d0VWU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU4wMc7iamIv_9udww7OP15pZGly-NoN-d07ui415lOA&oe=6A9D6645"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvKlklI05nkQ7kNvwGfFkuL&_nc_oc=AdpsH2G1bu3rDsTFaKkGB3_wI4c08F1jfnxrotd1S3StZNRpqfIdN1j7djHncolp7s0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs3El-F1O9WoZDM6wdO0D2DswjH3TqM9u7q0YRfSO4gw&oe=6A9D6478"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5f15TV-mn40Q7kNvwFbGHsH&_nc_oc=AdrlE_5jtVzPqkTmdly4YEw76-CXwg_ezmDg9OBx0vOWa2kNwQtoAkZxyGCDKcCt3W4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbtGeP8bbYEqt-aaPz5x3tOrzejMJcZCvxN4qCGEyueQ&oe=6A9D6C6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYVKlDq0YkUQ7kNvwGE0zeD&_nc_oc=AdpAsipRMqGkUDm2svDnR0x7EK7rYvp8WDbRcd2PQugCojKI0u9vGmFOaaifms33IQ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcR9wWlOrRh8iyyiOMWWS02WQUA2QMNAQzOwLHuj2gag&oe=6A9D8603"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
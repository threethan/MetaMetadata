dn.com&_nc_ss=7f20f&oh=00_AQCnlBQ99SgBHoy6On12iWyCI7sPrRUk0jPg73j25oGNSA&oe=6A68A737"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w68V6Wd4WloQ7kNvwG0p0Yy&_nc_oc=Adr2A0sFFr4tRlmK3cDCU_E4BEV71T_Cez-obdyvJ_cCVvng2Q61UsrQ0D116HsTBAE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbjMB66YBXjSeB3LvptFyZ4x8o4Nnlj6EBONB2t2LzDA&oe=6A68AA45"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZ6OtmZQylYQ7kNvwGFArIY&_nc_oc=AdosBSYN0H2JgHj63myIatyjv18HFKQLfwXkDCEJTlLJCbnQyk-z9H0qQ1an5La3KEI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-arUsfhZQsnMCmSfA6dJFh-ot0lw8kMem_a-UMTHlbA&oe=6A68A878"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qa9X0ZgghgIQ7kNvwHazWAX&_nc_oc=AdoAXWR7uty_gf5n9a-75HVOyhOo1UpIAychBAnOad66iQlJ9bgOYOtmaGIHG5I0zIg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW1mUo3k8Et8HEPoeBaA1cnyAvcv05kVsLr23P8kcHZw&oe=6A68B06B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeZcHZNUcuAQ7kNvwFuy0JH&_nc_oc=AdoAxf9YQ5dwrSqWbuRBOAxi9Q0wNahNU-zWlIXacIpNDZYrGNQXDax3lO_pdYufHzA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrC0QzpLDqjMsHyeMir5ttGSsiAmHGJX8oqAeiUUdM4A&oe=6A6891C3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
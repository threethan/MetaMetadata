luscdn.com&_nc_ss=7f20f&oh=00_AQJmwneqkLoQmLFMrAFhVM7lfwAyhb6V7lAHFuv5YVqMnw&oe=6AA940B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHLCRLog3kYQ7kNvwHfNrkg&_nc_oc=AdqetbMMsi-i278CGwAh92L3pFdmx8Ttgcja6eiQIknpF0vq0IthzQbPjCKi4BcD1QI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg1fkhyXVG8RD9B09JYWvZBMMxcovOsHm6-HaMP5afug&oe=6AA943C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGXv31I_QF4Q7kNvwGRmnLH&_nc_oc=Adq6iaqp4q5GUb9_KTadGEfuBr4yo4JuxzNLzbRVFx9Ktb20vc0niZ5ZeWqCq8fHC5Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuCT848-xqlWcc7y1F_w7XjewgssfPb2jScTYnVeE97Q&oe=6AA941F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8z8sbJ0A_VwQ7kNvwHpzTzM&_nc_oc=Adryzxa47x6mt7VaLrABmXwLvvd8Wr3IcPigz-3TUB4AJeay0mFRiimvj7B_5F6TMhQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOyAW0eyXicfi8vCFV97hZGysTKHW8neyjFaNJ01F_Uw&oe=6AA949EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2nCjavrUWgQ7kNvwG7tVaX&_nc_oc=AdplbVVS2cXiR8wECpmt-fRiqx7O5M7U8ZYxL0t6Ja4k7AlIiwx6YtyU9zjaIWrCFwg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm2GENZ3PLZp90xHDB9KpeMEPMJ5N0RfCcneYo3cl8ow&oe=6AA96383"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url"
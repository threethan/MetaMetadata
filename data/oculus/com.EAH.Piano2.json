dn.com&_nc_ss=7f20f&oh=00_Af-0Fa3sZ3p7vlHl23CNJn-7fW2vESpA-MMfxUZPHlc49Q&oe=6A2C0237"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78gjtI4JZ5sQ7kNvwFrjtYm&_nc_oc=AdqaOH_z0MBpgu49HF5iafZhGgd8po4-lLqdQpPrJ442Mki-teZfAdraHq-YYyG6PW0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EtZ763GxcSoMVhDoJgLjGoXh19InsUN2pf60DIbOJAA&oe=6A2C0545"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uR1o1B-vlxgQ7kNvwH5DXSs&_nc_oc=AdpDGT1Ia6YfKtGGFqojEUS0nKBXZVm_AmQ9PNObZrH3vZ1jLHGctWdlO4c4cTE5mK8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nrT1whI0keOXDTQSclcMk63w6QBkhwDilOTlj5hOeZA&oe=6A2C0378"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kijwSYnWSeAQ7kNvwHE5xQL&_nc_oc=AdpX3-OpUJbtC0HR4qMfTkdsf1YRrNSxrhUl7TVHXnRb8hzT91em1TEN8mNHNRVn9nc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a6KLdS73zN_QyCO7zuOziV4y9fQyv7Jr0DMOMbKc4ig&oe=6A2C0B6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZbcyI_R_kgQ7kNvwFBEhmA&_nc_oc=Adp3ITpz5OIX4XktRIH902ieviR22WoywfcgqL9mpz5sTQ45hwa1yR3kaitPsHf1zvc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EHbx2U7ueEGiTmHNdnPaPrmcyrBftksqkf1VUN4bfaA&oe=6A2C2503"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
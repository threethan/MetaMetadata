dn.com&_nc_ss=7a30f&oh=00_Af3J4dngntcsebXpso4fwbZ_PL4creNDxtIFCknpnrQSSw&oe=69E37FB7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gg2dQ2MtXToQ7kNvwHuqNtZ&_nc_oc=Adqi3g1gYo6-Jj88IF-cGNi8NlFYNEqJfcgTCp3a9BF6mcTRJvSq878S0CMBIsYvQK0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_nDZfbhshSA_kPno1HAzx9513ihvtCBsZIq01CEVTDg&oe=69E382C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4vSfYugNh8Q7kNvwHaJMYO&_nc_oc=Adp4znWPzye0GJm5Al8MbyH4Jz9spk2e7ghtPTWZ9QN7Hpngdr2QyOmtaCdfCc-cerI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LqatxNCaD2vBXsBQI7KdmEMCDBSF08ENsQOcAJbnhsw&oe=69E380F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KY8mHY1FLWwQ7kNvwE3E6MZ&_nc_oc=AdoF7krqnXbd6-JIjLuNa0zm2C7vu2VGwNZwSKkcfQKjAbr36E6WY4SR9dN8y2wOx8I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MpppgfgUSlgu8s2de59m_mu3ud4U5CdcJ9Tp9i2U0hQ&oe=69E388EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TzkLB65O8oQ7kNvwHKF4G0&_nc_oc=AdqGsKaj_imsp-MBuiEY7FUFHADV_zCtVKYJvvM8hCZWMHGMXMNwcFn9r7E6iAdkJKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mSfC8R0zUHIzq7wRo4Sljtx11epl40jjvH7SSulVA2g&oe=69E36A43"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
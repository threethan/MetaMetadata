dn.com&_nc_ss=7f20f&oh=00_AQPmYOtP_PHHQ6KVxwVHKJt5bBgpj_mTF8UpGnZ32zRRJg&oe=6AE1F137"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_4r2QzU_akQ7kNvwGsx5uM&_nc_oc=AdpzN5IJHydCeEW-MyjahzZtST7s2GSHJWi-QYcl1OuMFq1LNN_lTAjroNGOsAbDdxg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxu4lD0og2iEFavV997xGueL7cCRMAVYyXRbM7XCBZJA&oe=6AE1F445"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arN3MlPMkSoQ7kNvwHbWDsw&_nc_oc=AdpVsTizOJT_H3qFH2cuOQ8_0VzOlI8979ajBZp_XO7OTfXwaeDeeqf9gDJ7ncb8XAQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz9R7Tn-4k6fESo1MAVCJh9jb3JnoR6vJXTmPaqbJENQ&oe=6AE1F278"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0JaHfx_QysQ7kNvwFMmohS&_nc_oc=AdrEXPjnvheLkLQm-sSIu8exVklcygUj7kwq-2atERIVtxX4jfCpvJuRSGrMOcfv4U4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvzb-eTAYsMc9fT2TgR0wvCbU2UCNBn-umPbj3dFO3eQ&oe=6AE1FA6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nO_ZxVggOHkQ7kNvwF3wAPQ&_nc_oc=Adq-klxwwIVV5pvBxGrfZrY3wnSH5WEhGydANsW7kg9qT6WWgM3mxAJu3RgwT5l3EBA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQQGCHnvNtrC1OXiCExKiEOiLeFAEKm6swfxpr37sMXg&oe=6AE21403"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7f20f&oh=00_AQAVpshh8T3u8wD-30YUDqwYjhkjsO_0EiKzq3XorzZPnw&oe=6A4E4937"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTtIEaydGbsQ7kNvwGwzBIr&_nc_oc=Adrz5ZXEZE0Cb45G7O1Agn8ZWJoa30B-Nu2vfcd0OSnBxKFzeIxl0JtAjDzmO2c3qGk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCz7za0WM8qg9xajpvJXDgTse1RALLLM-g59pqr65ODBQ&oe=6A4E4C45"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xVFYVUIyiUQ7kNvwGdlU5x&_nc_oc=AdozHhc9sbWHJJW8ZV-yzSXsNs2qveSZeh49fEFC1aWkMjf8y9sEBzu_rAuaMBmA1Pg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmyRPyoueiWiyT64Co4vukQEDkPjk3IO9pTI8sUD9IaA&oe=6A4E4A78"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=us-Hh36KHXQQ7kNvwEhGD7A&_nc_oc=AdqpA38N54_wKIX60NXOq9EW4ApKMAhWzBNN7nOOqCMoJJmnhBkDnN_v4eHtfWhcxyM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeKrGwQp77VQ8SK6oSQlenHV935--sr4zBGFbQIrcveA&oe=6A4E526B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HNtHp9ZejkQ7kNvwEX1DgZ&_nc_oc=AdqEc3Pwuprg3OqgAY6zLg5vAQ07zmFy_pfFYnyQ1mB72bedz9EoLgMO15dwjtMM7Bg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChsM4Ze7YBhNKN53kI4rt0oEypI8pbx0SBJh5E8S9j0w&oe=6A4E6C03"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
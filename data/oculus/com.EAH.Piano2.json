dn.com&_nc_ss=7a30f&oh=00_AfyLqOR8mE-v9qEHILix_VEXSn_B_v9vMy_6ih8KM-kpUQ&oe=69C3DBB7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLLc12CIdW0Q7kNvwGE5OSu&_nc_oc=Adr3BojkCMFFxEA5cuVwbWYDw85RYhbDpPogtk2-UhsHSCjwbsfN_zWzoBFZTRFJuAo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZCZk122qNdxqgO9ejTCaJoHsu5AKQRrkQyS_GwPV2wA&oe=69C3DEC5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLrx1wqF3FEQ7kNvwEn1hl0&_nc_oc=Adp4v5zrwqpScGzGLBRu7XyEQYg7dEBDwLOX93Emj4ZKnnryO0SZWvTCD9DlZtMLM4M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAU8buLUEeQpqA-iQxBvL5lj1XsDsYUWUaizJE_uODtw&oe=69C3DCF8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgw0iaRQJgEQ7kNvwErNTWf&_nc_oc=AdrPDjmt4mrUwvf9hRCYBBBL9-Hl7kN303EZ00XbwW76vVTm_CEoditq6DRS0qqgaS0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFpXQjNoGZ3qTrkb_qoSQTfxzxsxCYyjpQ055qLi4riA&oe=69C3E4EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xd0p6WvmFWgQ7kNvwHRZjuw&_nc_oc=AdoodKiCQrR17umzfCd1TwXDaxm6iExNfQ8y0Th686gA0Iu9jr5L5ANjaq7ofkGUmMc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzauqVPmkUjgorMhKBE-bIyDL0QCoPCYIVsxWn7tgY4lQ&oe=69C3C643"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7f20f&oh=00_AQKqJ7LmhcLilz9uQla5IWbXCmxID4sz5fyJcxWVbtnz_g&oe=6A996EB7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPco8c2-HWAQ7kNvwFr71ox&_nc_oc=Adp83mDNlOq9gh9ai-eDgIypm85H2dhIUfbmpj3GehcaQgR5rczgfjtCMpYbN7EgtFg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJty1bFrm1APeyhP4vyntoMquOA5tJhOM4EaOuyOkMgpg&oe=6A9971C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcxlh-DNlq4Q7kNvwHAu-1c&_nc_oc=AdokAENLhG9JnOryhgrx0kdgAK0iHJszgvU50nzYusjlrBi9jFFr4iQDKuIZLXht108&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-u3AG5dZOq1hPoA5l2y65Sif_ttoX1dV6mu4x_TBq3g&oe=6A996FF8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NbeVro3wdwQ7kNvwGIwC7b&_nc_oc=AdrbXR6zwb-5YX8CAa6Vcb5S1BzqwPwxWcZdgSgt8VN_w7AGHTeD2no3TNMfSbvnMaM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL52h3pudh6pWGlmV5saRbuwXQZL-2MjD1ut866erVM5A&oe=6A9977EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCGKy3Edo7MQ7kNvwFURhu7&_nc_oc=AdrzsXLjOESe9RQGCEX6yR5YVLUWaVae3jcZope7k8RN21jBK44gf5rzdDI5kCVYw1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVlC3EnBdo6Nw6YM_Xlx4ckPcNlIhHmcrHdH4IwTVSgg&oe=6A999183"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
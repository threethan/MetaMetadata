dn.com&_nc_ss=7f20f&oh=00_Af5FRnZkm7oSE7H55R99B76stVRbjisMdlZxCNi2ZQ8uiQ&oe=6A1ADEB7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7OHN7E3HZYQ7kNvwFrNIIN&_nc_oc=Ado_sRRLN-TjfW6aEIggUjVFyZolUeC1eXo6X9HAnpN_WILdjwwPAPt7Wk5-MMaKmvY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QaayEt5S9C598ixuItaO3p7p66WUAfcmW5-ojVJOiNQ&oe=6A1AE1C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwqDhrzekX8Q7kNvwEGQ7k4&_nc_oc=AdojIoGOJtYysrK0YiRufxgmKNvF1qDVAxikknMn4cLdSUX8SiwS-mkgj6mEX5UHO8U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OyVIO-pS8-DNqjY4whX3fwwMEW1k6pe_KPURtwLuwLQ&oe=6A1ADFF8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlhGGI7yfNIQ7kNvwG9N3AI&_nc_oc=Adrs_loKzSwwcfq_VrW_MwhOnJnCs6kvTYt4fHoeAA427x48mOabyc010-YGwlro6c4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43g1OMUl7Adl1KbUv0y7CGxH4JhVRjjwteyNAFlkmI7Q&oe=6A1AE7EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRZb3DIvSz4Q7kNvwHs0L6v&_nc_oc=AdrZuWyiaSp4DQ-C0b5np7RjGEEQ6SRNfqwTGa9ovQSASFoSD71rLUyfbY3JYHNV9qA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7D2sIzIG5FQRx72N-Pf0B86_hsb5R2T7H4IshBXWo0iQ&oe=6A1B0183"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
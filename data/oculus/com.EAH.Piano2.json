dn.com&_nc_ss=7f20f&oh=00_AQGdjLxGopcOEWT27dqwcb7yuj-nr7uxog80yIHhbVgppg&oe=6A8C3FB7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nGk1Dafo9QQ7kNvwELLtIJ&_nc_oc=Adq1jo9lgLPm3Kz0VeGmEdAUZVVt8s18V1fLq5PUZWkKDplBIm9NipVMG2SyKYYqDfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZoCAWtkPcjd9e3arXpU55HgSe7myvoyku6LLa-f_ExQ&oe=6A8C42C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWUUBBJzJHwQ7kNvwGmgc3Y&_nc_oc=Ado8pg3Srd-KEE9s-PU5528bexzU-W3RISoktOIXpHMrWH9mFfhjGeRxKQS94owq6YA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHddPp0gkz1s6hp8Mg-dNQ0jbzRlba59tItzilWXUM1hQ&oe=6A8C40F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTkUr40D0ZgQ7kNvwEzv9TO&_nc_oc=AdolfIksVuVKky9kAJU3TaWmbU5OuIO8cKK3-R-bz8lCpRZAZiDAZMfn4bfhw9VepjU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkE4oE1nIV29noI1GjZPhM9IQfEQqWC-ATq4nF4C9ekA&oe=6A8C48EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhoUBYQOI_0Q7kNvwHLnMkv&_nc_oc=AdrsEBpAdb1Z7Rv3p9Or5KNdCnBXzhMGrGyX9MdDvOtqIzkqHO-sYDD7Y2GBe_Gj_OI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjh-knWL_YtEDN2fhtpAVWjlwvJFN1jeZ51eg_DsAmiw&oe=6A8C2A43"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7a30f&oh=00_Af1AtHG5U170ltfTB72bkVloyxR17zGUw-iwelVmBsnlcA&oe=69D8F3B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8Ov6mz_aFgQ7kNvwEq2Vux&_nc_oc=AdrRvE-Q49KjlyVtqXHz_VAPxrCOuUisG7pIWhPVWz1GfbR2jCCOLw_k8WpJfBXl5yU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YeWBKSExXH_Nbmeohf0Snc00D26uVCwumbuGJZMYW7w&oe=69D8F6C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48XxiuKs_HwQ7kNvwGEVVLJ&_nc_oc=Adqz0bIcoH6UWG56D-roGBY9tPEFrZ27sZHQ931NSvfyMxwFu8diG3eyZmxDGhMeLQQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1slfRsvhqozyNea3oAROBtTANgzIXkgDehF97N-uIO4A&oe=69D8F4F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-rU9AjVvW4Q7kNvwGUQh6l&_nc_oc=Adr1OSrQpN5bv_z6aDIDCqLrWETFQ5ybnuQNtSIIDl3T8hD0rLBQXsxN2o2VZwoqw6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WkRGHTpD-zomyKKVXL7mMZgksKkR0hjUnG3kgKuPG2A&oe=69D8FCEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypQkwlmUQrwQ7kNvwG1f-2r&_nc_oc=AdpVQqrCeAvBIFSjiXIsGAw4L_RvreHSKplTOds275qpRyAB3NDIGe2duVw6ES8XwOo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cJfdapkh8eAbEAjtu4loaHWwoA955_237cD69rvqxZQ&oe=69D8DE43"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
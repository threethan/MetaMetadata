dn.com&_nc_ss=7a30f&oh=00_AfzdOWsdA4SRHPiRZm4ZfAr77_WXwNvznML6oc5BoLT_3A&oe=69D10AB7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4v3kGH8G_EQ7kNvwFWWWbx&_nc_oc=AdrSVVt9PHPb0dS9Cpz0NG9Qz-DACz4zYGmFDyovV62rTxVXVtZ5jM_QUw5Qhu4l2ws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3DgnpYVZ8sVgEwCiFDSxyGlh-UJ_0nP-jteJWZyywcQ&oe=69D10DC5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZ9rv8F7amIQ7kNvwH7AzWJ&_nc_oc=Ado7xI9EtgQSdV_xzPTUWPYotm4-kVBX9XBhEgP8BPHmegSZW4Amr_q_oxhqaIIr4lk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzj8Ggyve3JfT2FIt5EaC4EFchK0bf1SfY8tswWsJ8BHQ&oe=69D10BF8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAlUSR-UpskQ7kNvwFhDk-D&_nc_oc=AdrvnQ84wgpdB1anoSvaG0Rr4yBmCwBRAfHgZhJBmgJEYBxxCbJfoi_vOOUgjEOAdk8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2FkHCtDztQxGoGJclcEHV8VDAc-fymp8L9hWbr4GYrw&oe=69D113EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDN3WP-uvfYQ7kNvwFSaw9c&_nc_oc=Adpo8oXk-pnrKvPRAi6-mpJ0LKAJBNvRWjKEdaOXA27A45ImhcL61G1e7kWXk0gjj3U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afygsf1-norBcm0XesptseLjM13_f0mtjGwnVXVFpaNcFQ&oe=69D0F543"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
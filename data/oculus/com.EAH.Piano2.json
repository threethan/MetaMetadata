dn.com&_nc_ss=7f20f&oh=00_AQL55L3ZDDBTjNahdT0g6YrOOKe7wYJBl5QbNpkSq1jO0g&oe=6AB66FB7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jB50Y2JaStkQ7kNvwFTgZZB&_nc_oc=Adoxlk58NmJo8vF3CoMMvfvgzHi7RFg4Bv0Y-SpraSUM4IcqjsvSPEXFbKjzfK4u3H8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf-XZMwaPqQag0S-wgyK9CXLiAUpMBSw75L_0i5XVVBg&oe=6AB672C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwWYNilN1GIQ7kNvwGHBGGP&_nc_oc=Adq5oI5JjvFvBHvaCL5JkHkvVQbWAv1NU3x4PIX19w2GOJ2Dg_cIY71JJVzITMaApDQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILOPbIQbUnPDNz97SpyMG8zrTe5asTGgfMr0Tlk8vVFw&oe=6AB670F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekoWN3kYBIoQ7kNvwFCyKrc&_nc_oc=AdqgIXQQsiCDk7_JbyMA4mqspFFFwcQNkaKo2dBFPwjRpEgBcy0xKJskWGOvk9ookSo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHJlGG7OPPz5a_OSm1E-dfUS7_WWB-89-HPQ3mS4iitg&oe=6AB678EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsKszSI3bYMQ7kNvwHNZV8y&_nc_oc=Adr9bKyAtR1ukk2ZFLObqaoXCzX3w5dFAWoQVKdxOtdlLKxYAxQ9E_xpzHngbhG9FwA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaSvJwD2P93dmN_eFfeMMdshoObgOE7HR4o5x61e1YZQ&oe=6AB69283"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
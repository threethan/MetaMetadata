dn.com&_nc_ss=7f20f&oh=00_Af4DPO3x8oizNrlzq8NfF2l8PXvRwlcrltspM5twLao7Ig&oe=6A071837"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPOO23zxnaoQ7kNvwHl-ak8&_nc_oc=Adq5-ZJxh3KX_gktQOkCwn1rGlNYWP0YyoF5Y3VRMWMwwpD6-RVWNghRC8thQ4mFFW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ngNUmSGSM4OXm8Anao7txi81ivZ1GCYiPUQyJDPwjvw&oe=6A071B45"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2nBgKlNJHoQ7kNvwHwKKIJ&_nc_oc=Adr2Yu20BC7TiJ9HFigLjBCp7NaW9l1Ykj9udKV8vmU-gGv8lg2rGcSHylkO6JNsdSo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cvJVI0biEmVVB9p6JK_O6Q1WEU9Jh8YAnQWu0ZNFKKg&oe=6A071978"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LK4k4ZX_JfYQ7kNvwFudvIK&_nc_oc=Adq7AtKXlWpByKlEMwN3K2jO2120mCv6pUVUT_oez2pzIDu7B3c2qr5yRSV2FoAojJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w5dY-u10GyMA7Wz5nc-5m2Wg6lGGWaRI47NzN1huq4Q&oe=6A07216B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op24s9VaqAcQ7kNvwE__JqG&_nc_oc=Ado822ADNVw8uDSLXZnZow7Lp8193aB81M4j5FePS6C0z9X3JUaCwC0cobFEPJQZJU4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wROgyIPG1DFRgmedyfOQ7DFS-Q9drzQR8xMzBR7Wkrw&oe=6A073B03"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
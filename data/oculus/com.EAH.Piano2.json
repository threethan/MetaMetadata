dn.com&_nc_ss=7f20f&oh=00_AQBeunGqZk9y6G6-u3L6Asx01VpbofcX7HtggLYenxB8Rw&oe=6A58D537"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TreVAYeUx7MQ7kNvwFpE1-5&_nc_oc=AdqDM2FXhYZvm-MtLo3n4ln_glp0xhDar00aHRkpmuDCfM6Gx0P_xo3ycr1ghZikc30&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqQMXu6cciuP_xdqvGhIoW5AMDAvrwsoxa1FWJvAJw-g&oe=6A58D845"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEomGnvHp70Q7kNvwGFPhCE&_nc_oc=Adp-cZk0qVL352ACV31zwYoBivjZZtoSU6Ho6eaLmbqaEnQndUBT4qz-rc0NcPlUOGk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMOsKT6Uuy46xbVDVg3ntZuABRSufhCANd4jeBsEXt_Q&oe=6A58D678"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrbo3W-dTEMQ7kNvwGtEUrb&_nc_oc=AdoNobqkmZvwLOxdVFAL2whuW2iN1x7t7leHiwFLEIUdAdVmXVnFaPzOyn1LtQuzdRc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbYZKXk8lEA1q2SYKsq-fR6jhMPYWjqw80E4Pnu6INLQ&oe=6A58DE6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsolGWtp_qQQ7kNvwGe9-NZ&_nc_oc=Adppl4YE6Hb7_6yHKE6VHQC5SKVfcUKI49-Flm-nKBOWk9dMuiAXlYAiTN85GJDuI0E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDijOpomquECtCRr4Hih23y0AH__g9clZlMO9U5SxHLtg&oe=6A58F803"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
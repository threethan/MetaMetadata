dn.com&_nc_ss=7f20f&oh=00_AQLdBZvmQ5QOFzo1mrh9SJIdyNM-RlItsq-knC9f2zsKbQ&oe=6ABE58B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yA8NGGExHMQ7kNvwEB8QAF&_nc_oc=Adr88YSRWsrm7Se9YkkJ5omlNzeEUUtmrYCbbaDStWl1ax-WzsRjHEnHckPnVZ8rAPo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdkwGcVA7FPEKDhhWNJdlHSsNkQpvvtkP_OkKLrkSJgw&oe=6ABE5BC5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OEVSdr-r8cQ7kNvwGI3U5u&_nc_oc=AdruxUcmYzFMk1_Jn2WJdP3K57eLzZinvqcCjQMrMdy8n6Kml2IwyRqaoADsZ_V391c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF-F2AXN8Qv_HaUgsmNSHOiKdGV2rtg17h13i3x9Wr2Q&oe=6ABE59F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-fswS_UmxYQ7kNvwHZk_1I&_nc_oc=AdoylZHSFyCw6gm3kX1DbwAVNwT3-z5p5q_9_hZc_oMf2QvE8GFGPtN_wkNhkLAUo5E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCfDoy5kqN8xOQiQ63Pa0d3bvXBrK0s4awrSYOvYqxSQ&oe=6ABE61EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lb3Rnfk7ZBMQ7kNvwFoHEk3&_nc_oc=Adol_HUEkZMlvvTVdeODpH3jVpJIzgXHDePfoGS2uU1Hy_GT0zYG7Cm7_Kz2nADO1eo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgWDknI62jw8RTBYBAwWlWsiQmg8QVmOVXBcZvcx3cUQ&oe=6ABE7B83"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
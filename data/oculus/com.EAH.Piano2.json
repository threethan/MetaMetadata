dn.com&_nc_ss=7a30f&oh=00_Afw2B3nkFYNhi24uWVR6OwPRnuklD_kdr3SLxWkFw42kvw&oe=69C52D37"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLLc12CIdW0Q7kNvwFUSZPb&_nc_oc=AdrML8WCU2bWmDohpiKkfw6oxz93avickXNNske9jlyVmu8hgr8S88ebTvsUBUOyA1c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0-u37HLUhHY0kUOKSXsWUe3vtiFZYYubiRNKGcOr20A&oe=69C53045"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJtN-W0XV4AQ7kNvwFY474o&_nc_oc=Adp_hU4xRtcz8PES_oNEohSVWkculs6yMlDAHoxnCB7egTvprzUsxjcokWEX6lp9ZjI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyw18q5jFa_mAYgNLDsWQHHNcG75WaNdDDgmSuP0FQskw&oe=69C52E78"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgw0iaRQJgEQ7kNvwH7mueA&_nc_oc=AdpGTyB-UZL06eLIwwopvz-yN58AjcHb0E5zWMkWNLcVyVTiTdHssL3_xAzMeWFQpGQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4gqme2_s1n7lDflmDKrqA_iPsNYaWZek57Z595yRbXw&oe=69C5366B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dd2F0DdsdPYQ7kNvwHZlQft&_nc_oc=AdrWkJAZvm1sB1s38mScDynWb5x4OOJPUQokhYLLOzuuo-ugALadhum02B27rPvPhkw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2WcgG1_T7Ghu75JGE01GMXnhA3M9t6Por1gTMzUn0Fg&oe=69C517C3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
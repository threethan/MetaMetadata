dn.com&_nc_ss=7f20f&oh=00_AQESRkVMlp_Rg_GNktxQrveThz4Y5GLm2HBjIejzjge_aQ&oe=6A95B277"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASTyriP-_x4Q7kNvwGhuzZf&_nc_oc=Adp-zo59t4_RAqTSPDMJ4JVQNUDWcJxJaoVGf8hYrG24FUxgvo7AoZCVoEVKdhROqHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFes04rEBDXxTFOZxfcQwHTXQUVZMGHss2PoHLQHLjqXw&oe=6A95B585"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9z8rpLWCmzcQ7kNvwEgL7n4&_nc_oc=AdolDCXuWoGJ3t3FMk5qmDjYEIhJbvlv-hNI7hQdEs4ceUByxzVdt46gmPjdu5X9Syg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0tywD9JXTPrOmCvb8YbpGsA3EHdLj23GYyKSX6mAiwQ&oe=6A95B3B8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQ4mWFVbV38Q7kNvwHIUM1w&_nc_oc=AdqwfFFYXOwPgVkosqC6d0n8ENuxQsJ1EdraYyuunmMZ854pvA_EoxcLeWt-6oa48mY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1bSWuu_-riJtZmLGGi6WI_5QM8j4lTW_TaNd5W8vGMw&oe=6A95BBAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCGKy3Edo7MQ7kNvwHWsrdN&_nc_oc=AdrQq1d__2VWDDfa6ObcWo1ijWd86tOvWScjejNvNZXcy9_ZLzNtfQeX0r2en1e_xqk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPEK8gY9_1IB6fYgHwL36IQ7zNF7ukB4ccVO2fKc9tLA&oe=6A95D543"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7f20f&oh=00_AQE5JJVjs07BeITH-Yw0RMOe6iw8gTs11_8M4aqCcAJSeQ&oe=6A9428B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v32agVxRcoAQ7kNvwHJxOms&_nc_oc=AdpVGO-ye9N_tLvGTU4nXbHEKpYm_3SMxp5YJ0BytueUJ7kX88j5UY-ZIWfxQKcOFTk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzMKDynVOWy1l9gquAbWHKehfaIy96MUr7O_dOwMZKEA&oe=6A942BC5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9z8rpLWCmzcQ7kNvwGtzeU6&_nc_oc=AdpgQdf6_Lv-ftDf0z7VmmZmrAhySg7c2f_dnF6w4eLThCle49fbSi7XYqqoE_aqm2Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0hWjQrbnmg2XnvtBn7oJZXwZFIyWUOggjssUkbb5-jQ&oe=6A9429F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQ4mWFVbV38Q7kNvwHBZ1vr&_nc_oc=Adq71OXtEhZC-KsbiDAQFcVqcByoupTiVtIC4euSvPedttLSh6TT0Eg-sBcEWfFNXWk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxLDwDFq1RQSrrqOklQCMPzspvmY9SlDbc4nhzp41XLw&oe=6A9431EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Stl0_u5C0XQQ7kNvwFvLKl2&_nc_oc=AdposHWVPX-8OFwKoyxFyuQNFsa_IuhT_iMl88hzA87rN4Et93WGQ1j1m0ciTqXZzKc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfoxQnOIlTCFbdlzzVbdtdz1VQ76JMzelK-I2USvtJtA&oe=6A941343"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
ud0tO2PfrlKojhN6-z2T5is4Vzuq-742gQMQ&oe=69BBF2B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQ6q5QpZH80Q7kNvwHmlEZY&_nc_oc=AdlcytJXMdjhYkimTRV4lqI1WmcsqnpO_sc7Y6H7BTT0HfCoJmNA9XFf0RtkoWzDOyQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxKSlIgMwg8ArshHw16Ax4ird9oUNtcqF6WI3UsB94-sw&oe=69BBF5C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hqwZLeHmNUQ7kNvwGiGjtX&_nc_oc=Adl_6YBAR89iv0oUMmOB4KEIPx8di9BxE1zOx14pjeksxbflFyAJNFgnDKRQM1cIlg0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwMdJD8ZfW_B__4zr_jEQ40L-PRwg4q06hr0QlBsoQfgQ&oe=69BBF3F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKT82YaDaKUQ7kNvwEh1xXC&_nc_oc=AdkLIgc3jzeO0i8q7ShWcDeYIdAJDybbMagRhxCRZCU32QVSxDiuMewe7pybK5Au-KY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw4cDhGrLOHuDWcJXo1lDzqheq4Ruth2xSlbu-Qrm0X0A&oe=69BBFBEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQAkhz_-5pUQ7kNvwHj1wNA&_nc_oc=Adl8TjO4Ew8ce1K6PVqbpekeGC8wvkgLe-qiBLEghm1vKDz93RGyQ7-v3BlEZ0qR9HE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfydvkgygCEC84qXNxDSAi72D0lKKy8mnosv5Zbrn5YORg&oe=69BBDD43"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_o
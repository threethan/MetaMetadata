dn.com&_nc_ss=7a30f&oh=00_Af3JofMSIsUa-IP-GS2UO6omNz2zJy5rn5ynGcqXH6w2nw&oe=69D4FF37"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbovsUjQjNEQ7kNvwEirolB&_nc_oc=AdrSRS9ih3Zn55QvMo0yLyaiVKGEnF-x2MLiu5JyC3nNhFe3hWazTg4l-rGYnT2bNXE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yk3Lk2gtWfAwi7wWoHou0cbgcE3D-tnMRJUXXIct0Mg&oe=69D50245"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xy_GAqNJ8JgQ7kNvwGBQJ0i&_nc_oc=AdqpxGNrEu9xnPJEhqaINyzQCnOrfzBPU1hu86T1DHXXt_M_zj8ZH242APUqUc4UjE0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0m-sxB64MGLIbkJGTzCy5C0o2CrbMt_IpUMxmy_G9oCg&oe=69D50078"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RGRlOUcZ9YQ7kNvwH_Jz1A&_nc_oc=AdqQwRglYKPypOfucMDzQDbSlvuC0b1K73UL1DTxfIxR66-EzcSEwpz0yrFbQdoDOAc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gTIUsxvQ4bWLzmr8-kj0Y_0UMwUXVD7NxK9C883luQQ&oe=69D5086B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4ofSGSed7YQ7kNvwECJM17&_nc_oc=Ado3GXV15aGIyeZhiLzvKU5YlZgS3xJLQaW7KbFQyqeywgLpAJ9G5XCjZ61iu5Ah-D4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2C--ao7YXioBGkxMTcfnZ-VrG5AdkZRWP9mwknj6L8jQ&oe=69D4E9C3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
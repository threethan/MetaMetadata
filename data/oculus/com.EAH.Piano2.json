dn.com&_nc_ss=7f20f&oh=00_Af-7EabJdl8C8nUUlT09NTaF1GW0Fugs3iUw_kvOkAAe9g&oe=6A3EAF77"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2SReB7zq7cQ7kNvwEpaaFw&_nc_oc=Adqsyv0x7kIDKvvI-V6WtCqYaxQOJFD3pLqWqKWPU4ADu_R_U6dwoI8cfOcY209o__w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xYMm8A7eaEpzWCtgS9q7QjlGSgHuiM12Ejj76v3R1WQ&oe=6A3E7A45"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYKif1mc55AQ7kNvwFSWvub&_nc_oc=AdqIBsOEmNr3JMfZ7AowCzZ-gZ9Qz1xIuhrw6N-4YbKGHtmvGzvZDhTc2DGzIk8cIIE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_uu67VL1C_AzbIykKJQUpU4HPJFkzI7HaujpBmd2qdg&oe=6A3EB0B8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DIzE0M4GFIQ7kNvwHqSJzV&_nc_oc=AdqazflZc7AdhrsGh3rn_6ZXsn3AxDRQfTgNTFIy8fVDbtPohgarp48BUhTlwNc6H5k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87AzEtEhYt69hflCK7mUWKKi_Fn9Egwv5ZdoprlyJG9w&oe=6A3E806B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBjBK6GftVUQ7kNvwG7ARFH&_nc_oc=AdpiyA5MwkVpIwB_0ppmK2HmdC7ikpL4hUwRnG7bHZXgZOY1hpmUq9Rz_sj_tpLVNtQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gob_xbk-1zrSxqLU7mgYZORJuhLthLzFs2Aw_lwvOzw&oe=6A3E9A03"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
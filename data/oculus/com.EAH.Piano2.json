dn.com&_nc_ss=7f20f&oh=00_AQPrAghGQ9se2Mcg14wDPaRU8cqF5ArmlGZrY8gPHtpl9g&oe=6AE5E5B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5LOGzlb4cEQ7kNvwHXSf27&_nc_oc=Ador8KOxxV0uXRuoI3v65Id4jJKtzVSRm7MUDchHTvSmF0AcDyNdk-Zj4-v38MfQHJI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVGbRsrGArrCo9Sl3n6EumV7sNP04mQWO0vgV6e9_FHg&oe=6AE5E8C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzOkBd3gu7kQ7kNvwFtuQvO&_nc_oc=Adqwa6BO-71zh_Tfxbt2ats99ehpUBlWvYzLzpSbyBW1lIM6U5Jb3kWwkpIqK18PM_4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNawB1uBC-vENCEXdZDDHPg3som9andkWLCmBN329oAGw&oe=6AE5E6F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2im35ZyJZ4Q7kNvwEVDTQO&_nc_oc=Adohx_8klHp3tV69BAe_6wEQujnU0gzYQ7G9NDYkNzl6xAv9d9zO9IoHE5EfaICFheA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPObue7Ek7uF3cVgowXMVTJyE-NUDDY6CqraPdr8G9x8w&oe=6AE5EEEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDOrNcogavMQ7kNvwFGKwEi&_nc_oc=AdpqBe8mFEV-fcYlOa6SJpc2BesVdczpCsvzhFVn1onVgHrfDn9HkttZKfvEkeJOdtw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrC8HbKHay_7YDFIzPhIS104uQRbJWwTwAdax95bo5qg&oe=6AE60883"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
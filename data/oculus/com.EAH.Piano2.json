dn.com&_nc_ss=7f20f&oh=00_Af6NyPS2hUwPhv_oaWXQ6tiLV0TkbZlYUwNgsCVpWWNEbw&oe=6A2024B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJCWsOZrPsAQ7kNvwH0Io75&_nc_oc=AdpzaRisFUslywMrOW6V4f1IOBsvmBIsHzuWcutUyCdqKw-jwKdLVxWSKZP-T12_ms8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uvFKiTfcg55U0BAwZHcquhJnIgyT0iQ8l3A0noNN5SQ&oe=6A2027C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zdA4-8-dccQ7kNvwHhI-Sf&_nc_oc=Adpqnh5x9W-f5O8p3zy1_sjxlXvG7lMPNwYTJPbz0phmCBr3d9WDKkIYlPTyltJfQ_M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I1oyAOfsX_IQLGbpOWFLJ4kAaK9ClygecSswfjwMreA&oe=6A2025F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTgrgRZfMhEQ7kNvwH11k85&_nc_oc=Adq2VkwLZ6ygEdch0xFAyvYd3di_uXrZTRmt-YO2Dr74G6EYUMtYXAGK-2sNXlSJdYo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hSF3ziu8Cx05XavsPRP6llO18zHUmqyPCJSm55ChZNQ&oe=6A202DEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zt67kfRK7XEQ7kNvwEMHHJ5&_nc_oc=AdpvgN7uTZYIQy5Nq6q4Y8ydrjmdU1ZoqVcVO3sHPc8Z61fNejtXi-NsyipvlDyfp9Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZRPGcL3HB-0Yrjc4MqR2ZqqbQRQI46f8wfOpdy9yLXQ&oe=6A204783"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
_5360430878652844406_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAqAQwu96EsQ7kNvwGBYMz_&_nc_oc=Adr_jvhqWo3eiX2QIF2aQDfrAOrzwVQDLKiO5SotkNajyA9OE7_3lYeKFOmcnmw1bj0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4pbld3xZb_0DhO1MmOa0etYQ54VM9Gc_CTQ1kXmBwcA&oe=6B09B677"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWYdI0fUy8kQ7kNvwGtgxnd&_nc_oc=AdrUgnSBS6_d_fpYqmjm5vMiwbAub2iq4-nM_yQIWMEJzIfXkluNHH4sSczVnx9TMW0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRewUDKvpgCl6C56Yfo3xqsLy9Vh1ZzeeLAYjM2Y0qgZQ&oe=6B09B985"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOOv0bmXPHoQ7kNvwHhhvRB&_nc_oc=Adrr_bJGFlDEMIle35nE0Nnn9WxSV1QkKCO0Q8nL48cWxOOU8ljFoIScajfNbp7BuoQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi5yW8DiHZnpup0vA5_Wn1mWGziT0nmZHsYKBUqw4img&oe=6B09B7B8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQhnKqOM-rMQ7kNvwHRxYsh&_nc_oc=AdryE2GVMoLuOA0QCVGh5DOf1VdEbm3Wx2cO24Ubdr3UGCwMKKI8F35949yHQIjRlJI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1pLwtf4Rlys6rzbg4M86S1wTOonGUlYD7qOJO8aB15Q&oe=6B09BFAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8JLw8VA-XAQ7kNvwFMfRi5&_nc_oc=AdrEqnZt-uXTdP9BrCn9FZKwj7M1yHUrv-uTz2IeJdXOlaKZXAxw2ynbX0dnv7lnaDA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpxq6tzqnk62BaBu0ZSWFJ-dfiS45PWqCFgMjGbHHWvg&oe=6B09A103"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name": "Andreas Hoffmann VR EAH", "support_website_url": null, "website_url": "http://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8953303331379610"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974804_3408493612784264_1726599624567440105_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nafahjxP8gQ7kNvwGGJXDo&_nc_oc=AdqqLjCrFDigO_TwQ8HXr_F0qQkIrFZ3DaQTusDHIg_1uPxNXqTIkAiLOY4vtyzCI9Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLagbKoHO9Cibp1wBjxODVFMhRHwpqYWe2iP-fTVOltA&oe=6B09A68D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Piano", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1679345827, "las
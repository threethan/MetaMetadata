dn.com&_nc_ss=7f20f&oh=00_AQDfTItVn5uZNv4SBOzt3zlYuzyE2rhi53D3TkQskaCliw&oe=6A5B7837"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwGQ7L6aRLcQ7kNvwG4YkHM&_nc_oc=AdrVN0aHou71NYIreQyete--CU3OLYo7XUEJezTcM-Du1OyvZycyca-LZn2gBxddRio&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJXBjrKzOAGGnqu5ce-zm6-R0F4mlVesyDrE1uAz0u7w&oe=6A5B7B45"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRFFXWatcKEQ7kNvwFKEPX4&_nc_oc=AdpZnOmtRrB-7pvtAmNvL9qM8veWP-IRid7Ao60ocQbwMMLwnu8nMjNdrOAmGFL7dtM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBmf_zjc4en3eAFH6RusZ1K-hRLbSUMUJASZhcefCd0A&oe=6A5B7978"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrbo3W-dTEMQ7kNvwGvfAJc&_nc_oc=AdqaPN8j9DZfWLM0eMOLr9LpPgTqSI-w_F-HNDUVwqd2J8otruD89xJY2Yp2tJqtbu4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGzxC5tCypLkHcQdyGTSJj3BrhzlWn9pOC7_bssibqCA&oe=6A5B816B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opOwFzvcDFgQ7kNvwEG3bqg&_nc_oc=AdpVkjUQtyeeqUMEocEAa8AEFDQdHAwXzNYA44-XeIBY93dmLJ0wFOeJlS1Xbz7DILM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7Y1qr3_yyEuyuf2ZGfbDAt2NvzCUZM-QNh_WiqU7xJA&oe=6A5B62C3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
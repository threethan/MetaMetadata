dn.com&_nc_ss=7f20f&oh=00_AQBl_FV5uTc9XVg9cHn4kTFHM-NMk4MFbcmfqoTOyc0DzA&oe=6A4BA637"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KN2EFlRyR24Q7kNvwEoazbi&_nc_oc=AdrM9F85YRrBIcjfBCGUKdLEg6ial9SfSu-gURfb9vTrEX5pIWAPvlLRZNUdafX3B1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV3ppYSGSH-ji3JLm0Q8Da_mCUIoIf2WqkJ6M-_bfc7g&oe=6A4BA945"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xVFYVUIyiUQ7kNvwGXs6lc&_nc_oc=AdqNLafGFkQ3lBr0DVKKohdsiz0Euenw1qQiK6KyzyMT2sIyUYg_fpH1iaKeERwPDSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKLst2TTWqL_VSWS9kUZjEB-748mP2fHKP8UShKJBTSQ&oe=6A4BA778"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qx8vKFLvpEsQ7kNvwGUGxNC&_nc_oc=AdoKg23uOVz7m74zRQe8Br1fTm2af8iRZgSKVqflrgjZjwvVRELdO3WHEQmU4YFp8C4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfnVDadA6EjOqBoMqPCwvY4CkxFNiAeLfB8MAyPVi-8g&oe=6A4BAF6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HNtHp9ZejkQ7kNvwFaQDdF&_nc_oc=AdoKiZ5x3agl2Dm1bmil8PHcXWrCKl-EunsIFOC1bU1ROUR7PUryvMg6U5wcMqRdrk0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5KHGJIR2dGldPDCL9tLaS16WItwrvo9plXhouN-JrTg&oe=6A4BC903"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
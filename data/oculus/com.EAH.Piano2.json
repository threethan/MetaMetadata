dn.com&_nc_ss=7f20f&oh=00_Af6UNnt0_psF-Ivz82hROgHr0Af95e8qJCt1OtoBkMT5jQ&oe=6A1052B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKxzW79ITzwQ7kNvwFSedyw&_nc_oc=AdprplWWMa7iqa0hEuOx2dRDr4jRiBER5SazzE9u0UBZBiCdjDE7A0BcN9EE5tRe0AA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZEFWqenxydQMoZWppT9G9psbxyc4AR9DzyYfbp0KULg&oe=6A1055C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h10wDiWGlqMQ7kNvwEz8vuP&_nc_oc=AdooFdqJvqFip-S4uFDZ3fmAIchNJG_6CQN7-MnEZp7g6z7If_PpSvqx74xsr7SqTio&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c9NnKs0hdiJ-wOcLvbkzvB2B6L4VuApg6me0vc7YqVw&oe=6A1053F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iZRz7ixiuIQ7kNvwH6vInZ&_nc_oc=AdrNzrsqR49eeuVdgfYJwQkTLpVQZ_B7HuolOJZI3RQq7Z57ZeJC1I8QKVFdV1BgPvQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Asojfm0XhIIKJ_mHCk92qjcDvNX9nYrLjDeIhmMMv9A&oe=6A105BEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xE9xv7HIYcQ7kNvwG89VTU&_nc_oc=AdrfSYu8RexChwA3B4mWwghro5D2YiGOR0DJAVUc6ohLs0DgkJ_gMupF5VSmh_oVXlM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TCwDjkrQiZGTqJ0YECrIRK7MGwxTUnAs_TgS3OGERNw&oe=6A107583"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
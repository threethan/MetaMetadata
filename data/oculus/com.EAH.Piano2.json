dn.com&_nc_ss=7f20f&oh=00_AQAIJZVvSqNMPtg9AJoy-Yr5-Kf91zaxw1_sBQwFHO4GIQ&oe=6A54E0B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTh0eUEsxisQ7kNvwFAjfmw&_nc_oc=Adq8i-_4UNWMvHC3XG6Cz3Dwreg6e4TQZ7DAIJr1QvzUywqqqsvvOCcEZQ5ePE-WwRc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY5aopBo7h129XDyywWXK2z-pX1Xd6EfYc6EGPRYLw6g&oe=6A54E3C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAOii1qf2ykQ7kNvwFhLdMA&_nc_oc=AdqbscY6UQMteqe5i8C3KL6Sgg5-zjydj2s1FrXAKIaw5fVnnTA_iV8Ait6B7F0g1d4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF6hmlsHPtIxy3FPgOtyAFQBh2v7if8uHXiV9PDyaK8Q&oe=6A54E1F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNb7u4Xy8JUQ7kNvwH8Jggy&_nc_oc=AdpY2BbJajqiq0GSISn-rDoSUm_lJ8-KN1YNn6ImFMN0HF-Q-Q2n-nfeozs2i9wa0GA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj25ccE_5zTjI8gNH1yW9pnvOKMxxontynLOBsbVAGcA&oe=6A54E9EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxDpa_5r6hgQ7kNvwHIKa9i&_nc_oc=AdrbvzDfHr0DChLQAcXUZ-9ZOtrtzmcW-FLA2a-88BOFKaUNpXBXvDOHojtm72R80b4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3cgWOf65_BH2EmXBUMNjDgLexVQCu2sMEGIXUrWhSow&oe=6A550383"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
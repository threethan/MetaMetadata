OrkJrRCc0CYfJBfTfgwk7r_jMRHAYyYhDUkA&oe=69B2B837"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_VCjzPjv0sQ7kNvwG3N-MM&_nc_oc=AdmFIrhZYSbR_olcQEgixjdjAcYbc0XH7-DVp0N5zmIJpPghjioTXLhSlYgIJDeA__0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwzQdpJZyJw1x3tcsyW47qcp9k29Juggd3I_ZYFRz-Ncg&oe=69B2BB45"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwzzqAdKOBoQ7kNvwH6f6PY&_nc_oc=AdkXkmSgDLQo1TkSP6lJq7pO_goPTDr8N1wxAtyqffC22FeLyrslw0S0r4EZXpgdGhU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxtnl0CDdee3ufOylozbR4Vzi2YT-acpvGmholnz9GKXQ&oe=69B2B978"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_Gnq4_b1CUQ7kNvwFloHwd&_nc_oc=Adl_9FRbQQkvxPs4jfdj5dhTkhYYPTIjBi4BzljgRlzZswBnXIIwngYQJN4WnNLcfzA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz4bxwUuRRo8j1aBFysy0-VcxgI5h4Ujt7DhEQlCQOmpQ&oe=69B2C16B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-YTzpU6ySEQ7kNvwGctMnb&_nc_oc=Adlcrp6kWls7VEGHC1QHZhY09uqFV0fFr-MD6fkIOAxvx9-gaiY8vQjqbeqI_vfM3ts&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyzyuhVwzIItUzEwJ_LNwbRsmNRrIIOR8yFD2AskdV_Kw&oe=69B2A2C3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_o
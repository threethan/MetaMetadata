dn.com&_nc_ss=7f20f&oh=00_Af6nYxqhiHDBhs2861cYV-ilhiP5OqYPcgWbsxjgqSnVOQ&oe=6A12F5B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dptfwvr8eAAQ7kNvwGhV9T-&_nc_oc=AdpYO5eN8sQCBhDkL3I9p-sgEeiKWwfbiKwE3QvvIigwEZGGNxz7qmWGKYwCCndUbDs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eKhdrBR1eUh7l9i8QuB02lOiSKyXhmFuS8qiTjZJoLg&oe=6A12F8C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h10wDiWGlqMQ7kNvwFFB0Wc&_nc_oc=Adr7O6cL-Y068ZhE2fhhk_nFiEmrfzEuscJQ4er4KBSkuY_pBobnY7-93f9qoK_iFlw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vYt6jIgoNi7tzLUWqKAKIi3_dSSFbdAZB4axQgVeqhw&oe=6A12F6F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIdBD0WBs1oQ7kNvwEm1VDK&_nc_oc=Adokm9d_EXTDb1cY6vkI5gNP0ghLjRztVZEZZkpQWIc1yQV0-fv3xlyWZSri-_8cpU4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72o7ZDMjZ4NYI06AsKC_p6BfIVqH-Ryzji-t8geEzelQ&oe=6A12FEEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xE9xv7HIYcQ7kNvwGbjTXx&_nc_oc=Adre0zA5sG38P0IKQhTLKAJIxwZ48LiLSPB9Q-jmssPttZnOoM_K87W2GUWm1jRYCEs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5laIjF9Kxm0iKBgeHnvFjub_CsFrGz3qXW2tCCl3Q0UQ&oe=6A131883"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
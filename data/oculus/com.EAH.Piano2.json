dn.com&_nc_ss=7f20f&oh=00_Af1RYSUER2PuOeVNlkDT-rW1qcDYPTn0Ilw7KOxgvrfjYA&oe=69F5F4B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeP4qOs1aTgQ7kNvwETYFOO&_nc_oc=AdqMLNBevBx6wqwx4zSepMlZgkl5zvMQR9AMEGTDe7Sh_BsyoPWYFMK6kNsCgVX4JNg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0R9zGR-tgH87elRPfR7MjHHH_WNEMNC0mtrNaQ2_jHUw&oe=69F5F7C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5Lz_kpNm4gQ7kNvwH1vyFq&_nc_oc=Ado8u8ADST8_rJaD2wCBU5sRidCUSs9pPUSVF5vFDY6OHHCbnvRr5q-jSmV7XAgu8zA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05BBKgK3UO77WPaPntJjsadqUr7mRskb-bGCuCteQkKw&oe=69F5F5F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3KCL89JgGgQ7kNvwEfnxjz&_nc_oc=AdpjXkrbpmAGQyRLxAqQSznPe7vIMpTNJ66HSsUeFl_Qd54e_gmwJ4xA5unvuYotp6o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0FZH1W93MKFXzd8EKE90L9sMAzMfhaTA6p3-2tyOUZCg&oe=69F5FDEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9JfyW1BFG4Q7kNvwEvvd8_&_nc_oc=AdomHOk8KiWiyuaqZrn3fhLYsuhSwpudAxbY9TYs2cietzdtfG4eO4C-2hAKXwzQsRs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0n1bbireG-v3nYN-x2k-fPtYM72HJkOfLDZlHtj04G2w&oe=69F61783"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
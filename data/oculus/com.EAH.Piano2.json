ZCKqcBUF_ij1tZGn_yLuLVPILM5iAREFfDeQ&oe=69B166B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_VCjzPjv0sQ7kNvwFeOseh&_nc_oc=AdnHUQDec7R_BeBIQw4F4-0mC91AbyNXFESZxyteiHj3GUszELXR6oSWbEert0mU_ho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLNvtCdD-mose3P-XdErpijtkD9JRpdGyXA7ZFwdvtuw&oe=69B169C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwzzqAdKOBoQ7kNvwFudvve&_nc_oc=AdnUwN7IKpGtJ5l5cDMWo4xOFnqYgpCmxroRD_3Hh3eaMcti5e_oUnenlaJb4blQgvU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkGI43aMqhRq46-0NQSxfDKhAQHJKN6xPTmibZB1pINA&oe=69B167F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhddQE3HyN0Q7kNvwEhmSc0&_nc_oc=AdmlKMDMVy5TzlG1gNfQkT4OVAKzmo1xOOoWS5kdiqRwAu-x2xgOZZRErdhEMsHLRKM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4eBVbiMq-1qIPp5Zm9CB0WWsjA1he5XNjai8KjA8G6A&oe=69B16FEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-YTzpU6ySEQ7kNvwH9Qu82&_nc_oc=AdlW29kkLqdXKeCvVZm2_uWh7i3ukthWKUzKZobxZw8W_j7vDmX3zReXOaEX3U0yZig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzO6AYa2RSlQxzOtjGQCyNXqjaKCpYZDizv_05wEjGRTg&oe=69B15143"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_o
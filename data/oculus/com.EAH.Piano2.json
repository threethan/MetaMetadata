dn.com&_nc_ss=7f20f&oh=00_Af_c1s7YX4W4XuJYTZI1svHe_ImAAFLssxTTnF6nZIBfGQ&oe=6A3299B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTwIGk0IuDIQ7kNvwElbbZD&_nc_oc=AdqbEGfqLdb9eOJxUctExeqwceCelFmOGX26J2njUVO05KGnKhiqGxU0IhuwFGWoXMg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iGvCfell8XHGnBFOfV53FmwOfkmpqSSLzY_8Kw8RhOA&oe=6A329CC5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3n5AB7b86IQ7kNvwGGaRw1&_nc_oc=Adp4tyliuAD-Q7JDZ-wqdXeoMYmoBiI0Ri2Ue9Qt3NjAukoN8jXy335vELsrkhSsRK8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y_7gW452fBVvUFjTLQnuQADybOjeWbDx-3L9kt5oAfg&oe=6A329AF8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83ylkr34ylkQ7kNvwEJlkLS&_nc_oc=Adra_UI14nnTyYk_vSMyJOeVIKKGEpklvuYi54m1mR0mncwtWjA4-pJOUC9ZiHYbYaw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81x_yqguDeZJPjcknHidGscHpRfFMegk1WWPDm7QqJiQ&oe=6A32A2EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrOC5MC4NWoQ7kNvwGzeJ8Y&_nc_oc=AdoQOVk04v8GI9KXRVN9PDB2MDcg18OocPqFt8uDd0OY3wLoby2ZmmlCKb_3NL0pWsU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RQJcl9pBXIZiHthH1SqPmQaydfVV-smFdZzZzXuFbFw&oe=6A32BC83"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
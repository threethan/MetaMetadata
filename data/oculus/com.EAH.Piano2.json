dn.com&_nc_ss=7f20f&oh=00_AQBnIqeTYfG5J-KnDncP4EZdJfXO9Lvs0th9KROG8a8uKw&oe=6A6DED37"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7KFHzNY4zQQ7kNvwGC7lng&_nc_oc=Adqp_URWWaxTOw8DkiQwc2WP6eH3Xe_7g_ZllR91hgebIv4QLE-BQ2o5Oa7lJXOAcRs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnvzQ5zrticbUMYTfISBQgew2Tna97FS7Wf3_ilR_w7g&oe=6A6DF045"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW37ou1fZ_4Q7kNvwGyF05Z&_nc_oc=AdpQBPYENHzaCD03yKEcyY1G5OQK_Fhyilc5j7dkbdxYO53AwDw0berjSxXffshfV3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJrwwMNB-ioKaWuIqrrFeEZaDLk6ERSc4sOTXU_hOFYQ&oe=6A6DEE78"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qm2pwX8dPYoQ7kNvwELe9gi&_nc_oc=AdpRQY9sWgpRoqbViDllOFStx6GTW1bCh_y_wh45y7SQ8yOLJ560e-PglpzrGZztfXU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAr-afQRZbENAt-md7fg9_EoN6L-HixP_pl9WnOmwyU4g&oe=6A6DF66B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhsPNemSKNsQ7kNvwHmCnj6&_nc_oc=AdrfOBBFIMQlbipjCm02xC_ZF6NfRhfScsrLcvi7VQFQPlU7q3v8UYld8q7sTIf4KHU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-HiULlVcwPkivrqhlTv0JlZIlJ7OX9-nI4xPLiZoB9g&oe=6A6DD7C3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
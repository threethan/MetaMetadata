dn.com&_nc_ss=7f20f&oh=00_AQJULJ_WoK4xoZ4qI3TPraDnipEOFaTKlvEgtjYge3H13Q&oe=6ABA6437"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVYjEZdNoIAQ7kNvwEbXhQ4&_nc_oc=AdqGNx_Ev1b7G7Ld0rk3w7_q7P1hn-LlbANTIpTfYG4gQQEUO9ZgKn0dQIvXqvAbJ8A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILY6RGyma4EtmBtyOkwvoi6vp_xfSzcDyEMEC9oM9JBg&oe=6ABA6745"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Psype9GQlnwQ7kNvwF3pVLA&_nc_oc=AdqETyniI-UEIwqFkaN35cq9XxOqn655jkFO_OmaxTl1RDndnej5g4wdu4BeQDTcYXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeCv4PpUUg6j7AyDO4tzlCWYHBCeLxyyvn4BlttlUoqQ&oe=6ABA6578"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVv0zcr47MMQ7kNvwFNEmaU&_nc_oc=AdrHst70-DAdbNzT4EyyFm9wP-0G4zv5cgo9gvenCHHtgHiA7MHeOEyLjAh4yWnIems&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsX_-rK6I_yy-zxZtYT07kJnuuli4qtdq4gg2DPb5fCg&oe=6ABA6D6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sx1f-8kcCNMQ7kNvwHuaTHC&_nc_oc=AdrWL-4FC3ewFjL5SWhjRMnHQGdZSlfjXQJX0s27UtodcRECLGFg9kaSSSzSiFzXqfI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5jtDB4rry6Tw-hdLLqLDZHgAHCjET2NyyBmz9IgF4yQ&oe=6ABA8703"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
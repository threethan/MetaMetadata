dn.com&_nc_ss=7f20f&oh=00_AQFEIRwtfiQ_hErM6AoMqT7jvMLLCYDij5uPTkWp34NWGA&oe=6A92D737"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v32agVxRcoAQ7kNvwFc7Lgy&_nc_oc=AdpvLq1BqUAFjlLjhScuq8hBxysCewZsukPD-8M2tebhj-KD2rhcAuIpKFJix1PO8io&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVQ4PYeI1QZrvUcgrymbqI2255IzDzyNEDLSk8yj58mA&oe=6A92DA45"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9z8rpLWCmzcQ7kNvwFeceqP&_nc_oc=Adpe_Zbl8UgrkAzoh8-FN-ClhSUHIKNBCwTJ6mPIR83w0TTRcWapF5XFsmFXWY32wEQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXPbB-Xl1NiddTDQ3Ct_ETFEv1lgrH-BWu0CNFe1FQ4g&oe=6A92D878"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQ508RfBwXgQ7kNvwFQHOjV&_nc_oc=AdpZse44d_LEe1e4fbCtNHmUYdPhYp8T9t9Bqgz4tcSRCZFuwznoM2Dr8x136yp5gYo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1upaEmkV286A53uyd0a-W2FuZauUJiGKYpiJOuWnhYQ&oe=6A92E06B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Stl0_u5C0XQQ7kNvwE7g1aC&_nc_oc=AdpxyqEo4T2tCHiBef27OXfgQNvK8eaohS8JUjY4Goj1DcnIO0P6fHTnqqYqTpSUyNc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgtQP2jc8s1DMhcKaDTO7W4y57b4Klb-vOFDOKtE1cAA&oe=6A92C1C3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
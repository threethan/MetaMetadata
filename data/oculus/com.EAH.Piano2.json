dn.com&_nc_ss=7f20f&oh=00_AQAPsm3f_VRVGJ69Q1YSy_qNj1Ctg7sroZDS8qD_XD_t4w&oe=6A50EC37"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTtIEaydGbsQ7kNvwHOwXW5&_nc_oc=Ado9XEzyUU5OH_n5kl0WumwbD-_nzLOy-c1n9D93MBAFlWog9wuCPkp-aEQbb2cHYn0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAu-2vtNodIjHE1OX1LBmp-4HZWZ3xTFe6hA2LNLg-dKQ&oe=6A50EF45"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RakEaj9A06wQ7kNvwECbcUl&_nc_oc=Ado8uTMl4q-TzKvK7fKGbip9iix75jPfiE59gmVIH7ws2wHOh-KSoyQE0NGHASu1c64&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLurpTC7bW_016jeXAMsYusTaz-w2y295vvs4GOHnitw&oe=6A50ED78"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxrJkalaQg4Q7kNvwHpNdY_&_nc_oc=AdoPuSGLtaduByQREDPLIQcYp3xzN5zB21Ngad8raNSUHr-YX7hUU16k89NWGsaxmKM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCafyBPhbn1CbvJIq39Ms5c7piOuwz-4LAG4JtN_S924g&oe=6A50F56B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFGpRWllb4gQ7kNvwG40Pdb&_nc_oc=Adr5-q-t7clG1nHh8TqiNMFCzzQCm7AdemQc_D2hKo01MaSj0tlvr1hwfMfokYEYdtk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDP8cFExTiwzQrgIMT6Bchwvv2iMQPwcyZayTBuXImpjw&oe=6A510F03"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7f20f&oh=00_AQTfPjBmDUL-hxAS1FcXx-odTAMSYmMKPRLA29nyV7BQTQ&oe=6AF9E477"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNASnMgfIP0Q7kNvwHZubmm&_nc_oc=AdrhffpcdbRJFK0Opd2xs3sJ9d-6hEVlCu7rXoJ7w64FP8Y7UeiLUE19ME-weA0BHDU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZb_I0XqX2nqmCuwWDrNVQ-P8fQoV27ohCw3llngyJWQ&oe=6AF9E785"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77CD2aGuqkkQ7kNvwGfPhDl&_nc_oc=AdqMc5VCUS9_ouWgbzq3Ny-LDx7PHCHpmJyRpBaw3c0iToXFAXFA6PPwettWivWB2So&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4SiOS_07iLo0lOqgZd0ClDU7PGwH7U845IM6Fe_F1fg&oe=6AF9E5B8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-vb7QIX4xkQ7kNvwFWLq16&_nc_oc=AdoLHflp_tfPVetRdaQ2w0nrg-0h__UaMZKXpemIhfubn4Wbp6d1iGdC-M0ucP4pqEA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlp6as6s1-_Ff0t2JZ5BlTqZqe3iOi62xNbuuSdbFXug&oe=6AF9B56B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UedQRwjNKPEQ7kNvwF9941y&_nc_oc=AdpfmF8U9Qd_j9Rulc-GWthFIS3-5i3YfKcLi_6tX38nxOF_jMI5raskY8PL1uqtrRw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQKB2fyT3j98YHrK2JiDo1HA34EY0J8HMzh_oVoGu-AQ&oe=6AF9CF03"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7f20f&oh=00_AQFiw0B8pg0EI69A0PgiLqsGuX6yZyqrfhDSRfHKrUk_Cg&oe=6A7F10B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwGEE-I-4UQQ7kNvwFqwW9a&_nc_oc=Adrrlb-K2rGRfWphOWaO35awuzqV5vxC8a28oTw4x7UolxMelX_u9h5j4aBI_lXFE7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGn4Vq5DmbTbecPEP68gcj33HaMtyec8SEB9WDoL1skA&oe=6A7F13C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gg8CxZJ9VjsQ7kNvwGSkwVH&_nc_oc=AdqiVVYNV-ppghY7vb9XQbOcG5_ZzFZOdnmRhCPVAoUORuQw728E9I1aTkebP5rf9zg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE64z_m06_svlnp_QEWtVgSWau0R6qAC1-5h1USL9qSpw&oe=6A7F11F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcBh1J1O0zAQ7kNvwFFMZVc&_nc_oc=AdqRo4tSD_1x2lfHVUm1KHKyhZHc7DGH0J-w9Mg_LN32HGV58rnjeuLAyqzGTYmCgvE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgexDlZmaKVIlTvc5kljZ2ZgKau8JZtJkPQdnGsMR0aA&oe=6A7F19EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTah-2MkAy0Q7kNvwFQClAV&_nc_oc=Ado1B7_DUU7ml_bNJQmr8kwa8r2ulTFaOAKW0RTE0QsSnrlROoK6V479zA0Khitfo9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqVIV-HOXs9aCWLJXHy5FZldhDy0yNo5Kl5IX8t29cQQ&oe=6A7EFB43"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7f20f&oh=00_Af0HqMeJUuSvUcxP5Wn30Q_BWY93XUgS3fvtoaisf0zlSQ&oe=69F4A337"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeP4qOs1aTgQ7kNvwEJDnVA&_nc_oc=AdrBrNDZkECes4divHmcR_V05gY0b14x8ZRHgGVFkWe9BBueH-7OJvh5CI0T9CYnvh0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3nSMiXhBw9YYA8OTbINR8oCa-epZAI0SsO92OGbH4M5g&oe=69F4A645"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5Lz_kpNm4gQ7kNvwEh0kL4&_nc_oc=Adqy2OQTUJk1AxwpxpgIg7ZocLu94IR-8XIfZG7n0Modh9-4pxjfMdCSBZ4yUqXyOLk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1onP3wjzX3PowP8ZwIPXYWVarFwWqe74lhNmYptgd8Ug&oe=69F4A478"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWOmfxBT5QAQ7kNvwF_4Gph&_nc_oc=AdqRFq5vEW6YD4en4KJEXadps6ya9xmaO32ZqfoQ6RVF0fbl5hCuSkVnjb8xGZGmnvA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2y30xkaegQsCxUD_KrNQlCXJkOLigWtpaLgjx3d3b0Ew&oe=69F4AC6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9JfyW1BFG4Q7kNvwGnW2bA&_nc_oc=AdpsgY5yJtSTwKWPOZGyZ7uX4DF6phPyUUiq5qw4Ul7QgDUP29kJjXHPNXo6Uo_P2mU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2iBG85Brr-TCjF0guTfXrrFtkQotLc8OQDkKF-fiq39g&oe=69F4C603"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7f20f&oh=00_Af9U4ZKbgll-ivkP99c4ZMNKUMaart0ypbRRE0WN7ZG1Bw&oe=6A33EB37"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTwIGk0IuDIQ7kNvwH9RNhh&_nc_oc=AdrB9rF9nAiPWqSSSFKROWUbn--GQkoudCFwXgRtpikvgPnw4fHx-QssFb7brGwTVUY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_34gt20Zh9-cu0el6lBCK3tInrehEwu4As5snIKFEJhQ&oe=6A33EE45"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jvq99Qd6vDgQ7kNvwHh1SXx&_nc_oc=AdqDBJ797xsLbdWZT6nbs6Mtn8OMbArnO4fFCXUjscMdelPxHQxn4j7dKyM-fiGOYEY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wSRY_zqko8QnYdxGToM1RBikbapHz9L3LYS6mvp0hMw&oe=6A33EC78"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83ylkr34ylkQ7kNvwF3rnr1&_nc_oc=AdrugBEI4rXvaC-LfT3sHF65sG_TWXuQEF0x0boN0M_NXoODGbOmtLgFJxpXTKk-p5o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CB5P15VV6wMt92-JMMuuquU3uF7uTayZRU1Wjx5GtXQ&oe=6A33F46B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_lBVw2Cn2MQ7kNvwFA23-5&_nc_oc=AdpKjinKnTFTMBsuxcGKxmrtmew3p3hfgSLCvpDyzDxcPzn5K__pq27N174PEGko70Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sKasI0mtzf7NUCwMRX-fRd8h-c5nAcIsqk5hXTgXWNg&oe=6A340E03"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
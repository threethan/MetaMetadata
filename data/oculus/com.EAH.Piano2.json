dn.com&_nc_ss=7f20f&oh=00_AQFP3ryNQjl2-FJpj6n3kjEoEhYXsvV8N2pMttg437vJrA&oe=6A71E1B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sgy5wcsMj40Q7kNvwF13Wy2&_nc_oc=AdpuVpfDxAylqrL9zP9YjUihnKNrMWP7xZJJsaByca9TgfEGnf2u3tzES-fgBeTKx78&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsfK_AcX0uARCyfLfpQdd4eHPgaXXt1J9KSo2s5OeH9w&oe=6A71E4C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXHN2vCteiMQ7kNvwHPakg8&_nc_oc=Adqts89DtQx_S_x3ZQ4QD8CJL82FsDtYdaRMJxnElQjRKxBMP7ctXh-7joax7GF4EfI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-pPago9TRpc0WNbDQEf2sRRALItszN-QdUtzcpNH7AA&oe=6A71E2F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsjGqVB9c4YQ7kNvwG0fuLe&_nc_oc=Adph_7jbZ3U3j_c_6-M1UdMvak-ZxKplljaBHYY2gpCO3UfMxIHnCRSJJ7bJA7wDQw0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtKPcKwTRfGIzfhb3wXl-8d6wU51gY_bjMACdXodwSzA&oe=6A71EAEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSzsnCeAsb4Q7kNvwEPdevI&_nc_oc=AdrblKN6Gz78cEu3uQQUevZHsSE6t2UJC45xvWwwhc5N8megHccxxLMhF6zqHqwcsig&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH53PSiBWcQGad1j1aveM9hq7XC2tboexIxnvmF7NdQgQ&oe=6A720483"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
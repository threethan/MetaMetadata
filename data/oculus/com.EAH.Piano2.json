dn.com&_nc_ss=7f20f&oh=00_AQI5MR8OmDYVk1_O-pkynDVMY7XUP-iKnx2gx0xcMFP_oQ&oe=6AA157B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stB_B6ys_a0Q7kNvwH1cQ-S&_nc_oc=AdqT7myCgvzAvzsRhtdd1GT89yh7PRaUB3chgcKxyfW7SzAyQ9TYSenxH8QEUHbenb8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1dzRIWFTl6GfEQqYE7NNVG7xgXNpSyCbvguCrlAuw6g&oe=6AA15AC5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1fMCACc8Z0Q7kNvwGzsK6A&_nc_oc=AdqHi6ECiPJFIBmtxWUWgLXUYbi9UJ3GwIdkHeFGBj0hAFLVItp1ncwDr1DVvujIOv8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINSxbNURqDsc5DrgWtYdxJr7FtihYJFFK3HCJSrxA-xA&oe=6AA158F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLUBHWLTWdIQ7kNvwH8PYWo&_nc_oc=Adow5En7b6Zh-ndgkG3SQbwnKU4EUBYamzgcqsKHoCu1VlP-rH1kszGVkcOF7lcPMXM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiPFLOt_VWiGEzHr6Ers9371WoZO82YeJRyxAhhEA8NQ&oe=6AA160EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j62gU5qiN5AQ7kNvwEyTz04&_nc_oc=AdqCCZFpBmyK2fCNAvN_ZULJ0iDGH0YEQ41CCFIObPjQRKCKVz5Xf9JsNy8O0U12AnM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLNsOxAPMr0QxL_dj56nMfeTax70c8nuExxLNIGhMVKw&oe=6AA17A83"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
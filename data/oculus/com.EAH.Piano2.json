dn.com&_nc_ss=7a30f&oh=00_AfzwzBpEQXuZwZQw9h8GjWZcNp0Mz2XRuOPagmhjplBYQQ&oe=69C7D037"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkPsdN24cc8Q7kNvwFzii2l&_nc_oc=AdrWtnycOLHELNMXzYZ2kIBHudbzLwZWXS1CdMrqgNt2J8As_Qe8ub8RMcbTQOsudzg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_Go4unjZzC5N33tjVsJtcnLCb5E1PVMR7QYBpceANEQ&oe=69C7D345"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJtN-W0XV4AQ7kNvwE7YKOs&_nc_oc=AdqoR-fhnC-GLK44fAGci0s7c1OIX0-MS9NhzWGvp7QtEsSUBlbtF7RKuCN2Rh-lpg4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1aBkDYBlbXZHeoKG2NHvFufPQnQv2x4mFfXb0XX2kLA&oe=69C7D178"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9o9e7T5l8AQ7kNvwFR64V9&_nc_oc=AdqtGWBDKJKOUHgUW_p_5W5yEynm2VfaLHUNGuUPiJB_XGCfBpqYEr-c-ZU40ncKuDc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFUuMFHMq_ibxcQIWUoUotTbbTfEm2wwsukLYaZfGJMA&oe=69C7D96B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dd2F0DdsdPYQ7kNvwFR2hhM&_nc_oc=Ado18GZZsz51P48H3Jk1QSe16_Nq7UCHwx-lNc7K2L5XaMPw6Il8yoRXNS5torssvVw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBL-hr7iUTmfZGOmO6LinYkQvsu2lBSK-7vIoarvqxag&oe=69C7BAC3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
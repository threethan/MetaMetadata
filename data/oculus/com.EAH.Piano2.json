dn.com&_nc_ss=7f20f&oh=00_Af4lupzAq1FM1YdslUGKiwcoxZSblRIUvIhqzhc_WpTcDw&oe=6A09BB37"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPOO23zxnaoQ7kNvwGKBElf&_nc_oc=AdrJLapc1okgQUYDPUuQOkHqYCQbVsXCTa_InMDGioog7gMsPs5XuIW-g3eKRd8i4Z0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fTzReEzlSyoTICSSVrt_MyW6HSl21Rj2NMIK0JFaBKQ&oe=6A09BE45"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pwJ-5sVkvcQ7kNvwFcQ2Vh&_nc_oc=Ado_3PVMoWQUsuH_pUrNwDtivnV3_jzaUP22xWADK2GltRNY3G27GfovQz2hgS4hJ6Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vFDh6P7WTB7HMsfvrngVu_5BHTW_m-yDQHfOFxIxQvA&oe=6A09BC78"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9AGIUXC9FMQ7kNvwHe4bMr&_nc_oc=Adp05hyQEektvCqQUdvrP-ZMx0L7Xl7giB3DNf3w-HeWVbMXNDQDi9ohEJuQysadgVo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VYXZjV1wDfQ7XlAgnugtKS_jl8dkTRNwTAp2s5_K08Q&oe=6A09C46B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opmDq4hfjDQQ7kNvwFDva_Z&_nc_oc=Adqedwf_CbshhL9FD54aWOBZZT4Fl_De__oHuOSoxWnebgPdnndPL9mrAa60tGJIiVE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VXeF1XRPSx7knpaPBA_H6N-b9zvRFmQcETWzYaozdiQ&oe=6A09DE03"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
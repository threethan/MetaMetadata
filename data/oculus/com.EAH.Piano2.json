Bw7JJYrrvl5fRvXvo49ziiVPJATnSeYqGRvg&oe=69B01537"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_VCjzPjv0sQ7kNvwGM6Ulz&_nc_oc=AdnDoVGfzkurHZLMENWGWWyCjVOq7zHdrKuQSqwnTHp4vihJ6mIhhZxMMzgi4tF3nyY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyO9WKQ7ir0SNYwlExWza5z6zgBBrKvz4ro-haL8e1Q0g&oe=69B01845"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttBBKsmk8nMQ7kNvwHlIiRQ&_nc_oc=Adm1OSp08RBdpRv8i1A9xWTSC9S9q_sybsad2KUTwLczCOEUk6Xo7JUOTkCFuIVzhHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjaQmOUgMkN59PuF4EaCOBiJFrZtL8AKgJjll-UyhRAA&oe=69B01678"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhddQE3HyN0Q7kNvwG0w6dm&_nc_oc=AdmsRAp6kZ-7lx8CYWG8HQanP8Mjzysfeksus7RoCWdMV5T0kSTyr9Smr0b0Y9xjhmk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyI1HyvFdxllbw5hMrTaWTG8mUc1DYqe_zN9V1cu2AlHA&oe=69B01E6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxWHz1gk4BIQ7kNvwHWQRDC&_nc_oc=AdlvoHoeZRKNw-BGomuYlNxM6Bq-PXa3iO96hHoW3EGWj7cQuyHsfzecNFtr2b6VICE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVJFYRUF5mkv-AnttS74qRLxOJ_1cwFjNptOK7_FwKyQ&oe=69AFFFC3"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_o
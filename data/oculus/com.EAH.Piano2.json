-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVYxnTdkKLLW5kG3zpJKj3tibqMZQYm8RtV25XZQ40DA&oe=6A8EE2B7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQ6de3CItM4Q7kNvwGPgOq0&_nc_oc=AdpDlP4XAUMRAjFpnXIbwMENYZJpxVBdssrxKFrdh46BOpV0PHX0HluzaZQLYS16zCE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCxR9eF7cX4G6FLkf6KtP_YI3Eba05NbGR-9jaM7QHVA&oe=6A8EE5C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_9iJjzGbFAQ7kNvwEU_JEy&_nc_oc=AdpHh3lIgRZKJSOkdlFlsizzRzOa9PGk_UwQVIkhoZKepkXserSgyKFbFR1MJt1tdxQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgw-NvNDc1RSz0EDeC5FSUw-ijQv5bDv-7Md-Qm-8U9g&oe=6A8EE3F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTkUr40D0ZgQ7kNvwGjlzWS&_nc_oc=AdpkYN5LsJ-NL78jMm3Lz7tugAAiC0uH43jLEViYP83R_h0FtBHr2sPwepaj0nv8gpU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDwAGXoHzDAVCbz0fuPIPyfuC7PKNspmTtOfmC48RzHg&oe=6A8EEBEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pilpzR8eVrsQ7kNvwF_ZS6A&_nc_oc=AdriQm5yXA7GYQig9i0RJ6WUwh0TpaT8vbi_fMEMNKhMkhDBw2Jf_V9cIiWqgAvtnIY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3SdB4NOFE_ONxRsUB-NkcDRyWFVYfYAWdFzuw3jyTZw&oe=6A8ECD43"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name": "Andreas Hoffmann VR EAH", "support_website_url": null, "website_url": "http://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8953303331379610"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974804_3408493612784264_1726599624567440105_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0wyKslE_bwQ7kNvwFFZlsG&_nc_oc=Adr7OmUUvtqSGSV-PiVyqwPwasDW2U0ftLChOiA8-7bUdrvLTKGGqZyuK2zyBo4biTk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUR4BCYMFzcfAGXOuEGCog_jEPQiOrdB_Ef21FrL9tDw&oe=6A8ED2CD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Piano", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1679345827, "lastRevision": {"nodes": [{"id": "5845235662186408", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5845235572186417", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "866417247751971"}, 
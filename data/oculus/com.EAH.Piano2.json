dn.com&_nc_ss=7f20f&oh=00_AQO9gToSRUFKpZkHk4Oz5h07dInrlByJcDfG-DtGT8RgBw&oe=6ACA6E77"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTIqWONyYAUQ7kNvwFazYTU&_nc_oc=AdrzcPSyt4GVY2RyjseiEfIqyyaRjhDL6_wNGTtzPk2EIehRe0afmg_V62E7av57zEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkYelj5C5RL_H69m7JFRZNoo61UNEeXKsr8UoxBSw20Q&oe=6ACA7185"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UT-4yaqPu0gQ7kNvwFkvg-P&_nc_oc=AdqEhYpGGFT8smg4nIrLI-Pjv8nAedS1urvRWof0RtuLxPYlS4pZGxaxYysus18iKIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGHsgArkax5ze1zKsL9KR3QLXm-WngqPq0Lxt9Hu6ADA&oe=6ACA6FB8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6Jhyb7tbKUQ7kNvwFQGUxF&_nc_oc=AdqCwsvG-Wov2KE-rQI0EfeTM0-sgDGQhDZNz101eaQUrjqUYhhbJirIzal09gZZ13E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqmvDL4Ev8eCkwAb7uD0JaGY-yDG0LsCxTbit-0_shVQ&oe=6ACA77AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6m7UDoN4sWAQ7kNvwHkJpeG&_nc_oc=AdpPIIeqsSubn-uzI2vL9XsiRwP0FKPoqRME6km-6rQPiR7ee52K73gZKUnnhiJ3vIY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYaBQGyrUqEyZXMMCNqkXO48qnDI9AExenaBLpAD4LsA&oe=6ACA5903"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
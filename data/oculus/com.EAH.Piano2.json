dn.com&_nc_ss=7f20f&oh=00_AQTe-xjgcPTfeIpZ_XFzjlQYJjn8NuTMQDLOL6nd48ZIew&oe=6AECB577"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbrLGa44cbkQ7kNvwG4XpVA&_nc_oc=Ado0dyFFssV5XSueSg-U6c--nThb0N_4pKLu9ZpAZf6DL3yCb2Ee4ev-rkD587k8TM8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX0QXJ-IALF81f0Wn6coqcplulx-W7hBwWdAxuLmhV4w&oe=6AECB885"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYs-gvH0i4sQ7kNvwHqqe-7&_nc_oc=AdoCSJza_bKNbRuyQslo3TLuNyE1axilPYzSRjJihzYavGOduIZaV8lbF3jo10Ix1so&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSnBuwjcDA59LoWV93VRMkG-OUG2UXHeEu7ACBsPC5VA&oe=6AECB6B8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThKAgEM-T3UQ7kNvwEbXWlY&_nc_oc=Adp9qryYkkwDE0duGU4RAVIip05KaoWCZdz18AJMXZw4n1ucOi7WDeYWjgXvXLS-MuE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0g4LsBkFT-4UJWbNdYZCWnY4rx3_ucZ-0x8VS_g2OOQ&oe=6AEC866B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHEl24Rm5MYQ7kNvwE_7jsz&_nc_oc=AdrPjjDPDgpsCBoqRkNPpAu691nWBKkroDLYm2ssFhpYSfo3V-pffspJBNqC5O5Cr94&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo5VLne9dYgTWDsgGEFTOMzDWn_5eWGGGNwxHL0cSaig&oe=6AECA003"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
dn.com&_nc_ss=7f20f&oh=00_AQNeKm2fsMZ9H2jEZhsveEJ8kJ8UjiQGzooOSoOH8BFwQQ&oe=6AE09FB7"}, {"file_name": "App325601440.png", "id": "291506919890643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195909_291506923223976_5420446589130703572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_4r2QzU_akQ7kNvwGsJBS_&_nc_oc=AdpFM6QUYDiv78TRbVMc91dL_NVgGYVFMWyO7y1jwjas2kUX2QPf6BuAe0cac1Vo9oQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGRJjZTvE3jdsvT9YTQ46N1g9e-L7b_cnqxgnc6HpOvQ&oe=6AE0A2C5"}, {"file_name": "App425601440_3.png", "id": "972317723967494", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036681_972317727300827_3590825593399314284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuZUvVOpExwQ7kNvwHU1VNT&_nc_oc=AdoJGVP8YRZ9Jm4VBNkINmIEQzbnqLS7vpbxymOtQsgg_p_pnuGl2HDyw-NmfoKPcnU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzhMMjPzcBUGGhUmeRUlcYt7n_3Oa39XTyZNUlia1O-g&oe=6AE0A0F8"}, {"file_name": "App525601440.png", "id": "1456961418480184", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036671_1456961421813517_4665322179453087397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0JaHfx_QysQ7kNvwEM7qK2&_nc_oc=AdqIyESX73Q4sfBBpJ1Zp0faIM12ypDaAW_jZW3RkdonjEpWZiD6e-x1nSQaiA0DHco&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYJzAUWt8lOMqn5iIBv8k20SJEWAuUZ59xLtnY0bUSuw&oe=6AE0A8EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App5CoverImg.png", "id": "721013929778784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036681_721013933112117_2701330966288946065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjmMtyYXPLsQ7kNvwFpbhKP&_nc_oc=AdoiPyOuIdd8k5bAO07fQFlCL1UfTS4TUAqa2jkkFKDRClLgYFvUXvH7_ckJjf_RmVY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTvEjzCBc4kt-uO6mgnUuwcfpRvrcSIYLJ2aR67w81qw&oe=6AE0C283"}, "display_name": "Piano", "keywords": ["Piano", "Klavier", "Music", "Musik"], "long_description": "PIANO - The ultimate VR piano simulation\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience.\n\nYour musical journey begins in a free small apartment with the sound of a simple room.\nFor those seeking diversity and new acoustic landscapes, PIANO offers a selection of additional apartments, each with unique sound characteristics. Each space is carefully designed to offer different acoustic experiences - from the intimate warmth of a cozy loft to the expansive resonance of a luxury villa. Expand your experience with in-app purchases to discover these exquisite spaces.\n\nAfter purchasing three apartments, an exclusive bonus will be unlocked - the passthrough scene. Here the magic of virtual reality is combined with the intimacy of your own space, and you play PIANO in the familiar surroundings of your home.\n\nPIANO also offers an exquisite collection of ten electric piano sounds, accessible through in-app purchases. From classic tones to modern sounds - ready to enrich the atmosphere of your rooms.\n\nAn intuitive volume control puts you in full control of your acoustic presence. Adjust the volume to create the perfect ambience, from gentle melody to powerful symphony.\n\nPIANO is an invitation to rediscover the world of piano playing through the lens of virtual reality.\n\nEnter PIANO - where the art of sound meets the space of infinity.", "short_description": "PIANO - The ultimate VR piano simulation\n\nPlay Piano in different apartments. Play and record your composition with normal Piano Sound or Electric piano with 10 additional sounds and Volume control.\n\nEnter the magical world of PIANO, an amazing VR simulation that masterfully combines the art of piano playing and immersive technology. With PIANO, every session becomes a unique musical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
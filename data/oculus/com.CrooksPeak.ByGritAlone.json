c_sid=6e7a0a&_nc_ohc=bwamfFqX0uMQ7kNvwEtHkoL&_nc_oc=AdosvZAZXeyelMLuLR7jQ-qt2AdjKslihy9toQsCo5P_Y1RDmSOl0pgl6ZId4YLCCOU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVlapyMM8_01y0DkiodBD8fthsS6nraN-APkm_QjxSFg&oe=6A7C7812"}, {"file_name": "ScreenShot_IceCave_V1.png", "id": "475035741556053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75326678_475035748222719_2411778706841041105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uk3yqwb_quYQ7kNvwGhodK5&_nc_oc=Adocs38AlEEkS8wxpJDb14lUMwF2dXNl4QxTS-8ODRxxx2wppEcporg0eMOERUCm_HU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHw4QmBN95JYhf4GFnZ4rPl4YMNeitrErlLL8PTizjNNQ&oe=6A7C5294"}, {"file_name": "ScreenShot_AgaEntryCorridor_V1.png", "id": "769037181979337", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_769037185312670_4297071497369343849_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMXruedAwd8Q7kNvwEJtD7_&_nc_oc=Ado48bDYsSVcoq8Ay5rm0O1XV_hHVvS8QDFFfMcPk-skVUgPTLG7jEzr67kDh4CgrHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6S4HFi7KJnDSAUHATReQKQh9OIsP-ZQm1J7kThZZlDA&oe=6A7C5FB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover_V3_2560x1440.png", "id": "556848373646536", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031527_556848376979869_7441225304369638921_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OKu3_-pEzIQ7kNvwFkz3Sc&_nc_oc=AdqbQ169XmFQ6EcLyEWmZx7U3KUNa49bbRhV2lJkOGcYzjL7BCYK3GxmO3Nqqw0X5so&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdJ4dql8EJDYsg2aWXdgdunPVctqfysxKSVB3qDCxanw&oe=6A7C621C"}, "display_name": "By Grit Alone", "keywords": ["action", "horror", "alien", "scifi", "shooter"], "long_description": "# A challenging indie swarm/boss shooter with a story rich sci-fi horror linear narrative campaign.\n\n# \ud83d\udcac \u201can incredible trek through the jaws of madness\u201d 4 / 5 UploadVR\n# \ud83d\udcac \u201ca high-octane but still lore-rich adventure\" 7.4/10 Press Play Media\n# \ud83d\udcac \u201cBGA\u2019s storytelling is just about unimpeachable\u201d 7 / 10 Auganix\n\n{1217972975831984}\n\n# Get this game if you're:\n- craving a challenging shooter with bosses, traps, swarms and suprises\n- a lover of deep twisted lore with immersive audio, text and holographic logs \n- into bizzare environments and surreal horror experiences\n\n# Don't get this game if you're:\n- arachnophobic\n- wanting cutting edge AAA graphics\n- looking for a resource constrained game with an inventory and limited ammo\n\n# \ud83d\udcac \u201cKeeps you, like, right on the edge of your seat\u201d BMFVR\n# \ud83d\udcac \u201cWhoa, okay, tentacles everywhere!\u201d Beardo Benjo\n\n**Cosmic Action Horror** focusing on frantic combat, sinister storytelling and atmospheric dread. You\u2019re marooned alone in the Bermuda triangle of space, filled with ancient derelicts and ravenous aliens.\n\n**A linear narrative campaign** with an anthology of twisted, disturbing tales to discover. Prepare for constant action as you traverse ship to infested ship; there's no loading screens, no inventory and unlimited ammo. You will need skill and speed to rip through the ferocious swarms and deadly bosses to get out of this corrupted hellhole in one piece.\n\n# By Grit Alone, you will survive.", "short_description": "Cosmic Action Horror focusing on intense violence, deep lore and atmospheric dread. You\u2019re marooned alone in the Bermuda triangle of space, filled with ancient derelicts and ravenous aliens.\n\nA linear narrative campaign with twisted, disturbing stories to discover. Prepare for constant action; there's no loading screens, no inventory and unlimited ammo. You will need skill and speed to rip through the ferocious swarms and get out of this corrupted hellhole.\n\nBy Grit Alone you will survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bygritalone.com/privacypolicy", "developer_terms
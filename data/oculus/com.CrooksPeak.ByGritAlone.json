g", "id": "434041015933981", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031393_434041022600647_3313075640739459282_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODW21ZRSz0kQ7kNvwG0Jt1l&_nc_oc=AdrT_GSlwSkJ4pSoDFV1cwjAuzLaUl9J_dWfSn61NGeMYCdassoMoP91aVvprSWe1bE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrAUpuEpsE7__9LHTrcPwHj5mfqyMzrM5iBtGfhNMMyw&oe=6B0303D0"}, {"file_name": "CoverArt_Square_1440x1440.png", "id": "408076932201830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476753_408076935535163_1643876385163837005_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_86sqGm9xgQ7kNvwGRYes3&_nc_oc=Adoi15oQ8TioKugM9zxBwsLwrLj7raObpM24xJR8Zz9O8ueRHHOonjdMddFdfY2Gd5s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5sDbetiWATm6pixmt-Y-d-kGxMU8m9mgOrt2OuJlm1g&oe=6B032BEE"}]}, "id": "1129131014979040", "locale": "en_US", "screenshots": [{"file_name": "ScreenShot_AgaEntryCorridor_V1.png", "id": "769037181979337", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262744_769037185312670_4297071497369343849_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giooAIh4T8AQ7kNvwE8imZv&_nc_oc=AdrqYdTFGJ8dZbdNMRfpUAYTMLnnUcgdu5STrkcE-3xRDLSQz45fyUVGeHZg1tH66s0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv7BVOFRsbF0nshgqOOQ8qv3PqUaSlpHsHx_u6mP2egA&oe=6B0310F3"}, {"file_name": "Screenshot_Chapel_V1.png", "id": "434663395968166", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_434663399301499_6823376406081814035_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORJLEfMbKJAQ7kNvwEMcIIt&_nc_oc=AdpdH1ObpDGTKKvBFHkgcH7ny-tHcAEHIcJDCeYCKmY-OdDiJjkG4UCsA6xUXQ5mMeY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9a08aImJe-mCCz7iRmJL2BPjxmYJjOSuHyEZroxcgMQ&oe=6B032523"}, 
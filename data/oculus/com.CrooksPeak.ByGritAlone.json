kALUQ7kNvwHQ_aN6&_nc_oc=AdqDp0rQh6fSSV_sQdfgCzn1xL6Kc3SAuBu69X72wMSGm4ZsHxbjW6J4fBfaaGOFgfY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRsjPjpDEGSza2oRcYJLUTUdpWHKVT0VJImRF_0IURmA&oe=6B031F64"}, {"file_name": "Screenshot_Mir_V1.png", "id": "765909982318366", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031344_765909985651699_7770434399843880174_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBQ1OBJGTFoQ7kNvwHfk33Z&_nc_oc=AdqVOTR97aX10y_4El3fao0y5vi_kqPOtUxiaCE7gp7bvZSRwLaJIoIKJNnLi9p5Onk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2WjDkqydA-3Sb_PnBjp5WeN5E094bqL12_w547juiBA&oe=6B032952"}, {"file_name": "ScreenShot_IceCave_V1.png", "id": "475035741556053", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75326678_475035748222719_2411778706841041105_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdNVYsBg2y0Q7kNvwGy9EcG&_nc_oc=AdoE8Aon1MQicsZnGmwKi35Fsg64AHWY2js-_VGLHfAjhMEb3hmhC7WZmhQmwIh-QcU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTceubWZs6rkUiIRBf5PqkYVusMtztNYXqfXQYzHxvgow&oe=6B0303D4"}, {"file_name": "ScreenShot_AgaEntryCorridor_V1.png", "id": "769037181979337", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262744_769037185312670_4297071497369343849_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giooAIh4T8AQ7kNvwE8imZv&_nc_oc=AdrqYdTFGJ8dZbdNMRfpUAYTMLnnUcgdu5STrkcE-3xRDLSQz45fyUVGeHZg1tH66s0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv7BVOFRsbF0nshgqOOQ8qv3PqUaSlpHsHx_u6mP2egA&oe=6B0310F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover_V3_2560x1440.png", "id": "556848373646536", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031527_556848376979869_7441225304369638921_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSUSYw0YI2MQ7kNvwHTtiuR&_nc_oc=AdoMTi94aw6VKSgraptm7ydTuz38KKpktEv4v9qN9JagB7YFzET_eIQ-211sIgeZDHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZnND6ZLXumCK8k3_DvarP-KWE_vCpbQRW5tcdsHuC8A&oe=6B03135C"}, "display_name": "By Grit Alone", "keywords": ["action", "horror", "alien", "scifi", "shooter"], "long_description": "# A challenging indie swarm/boss shooter with a story rich sci-fi horror linear narrative campaign.\n\n# \ud83d\udcac \u201can incredible trek through the jaws of madness\u201d 4 / 5 UploadVR\n# \ud83d\udcac \u201ca high-octane but still lore-rich adventure\" 7.4/10 Press Play Media\n# \ud83d\udcac \u201cBGA\u2019s storytelling is just about unimpeachable\u201d 7 / 10 Auganix\n\n{1217972975831984}\n\n# Get this game if you're:\n- craving a challenging shooter with bosses, traps, swarms and suprises\n- a lover of deep twisted lore with immersive audio, text and holographic logs \n- into bizzare environments and surreal horror experiences\n\n# Don't get this game if you're:\n- arachnophobic\n- wanting cutting edge AAA graphics\n- looking for a resource constrained game with an inventory and limited ammo\n\n# \ud83d\udcac \u201cKeeps you, like, right on the edge of your seat\u201d BMFVR\n# \ud83d\udcac \u201cWhoa, okay, tentacles everywhere!\u201d Beardo Benjo\n\n**Cosmic Action Horror** focusing on frantic combat, sinister storytelling and atmospheric dread. You\u2019re marooned alone in the Bermuda triangle of space, filled with ancient derelicts and ravenous aliens.\n\n**A linear narrative campaign** with an anthology of twisted, disturbing tales to discover. Prepare for constant action as you traverse ship to infested ship; there's no loading screens, no inventory and unlimited ammo. You will need skill and speed to rip through the ferocious swarms and deadly bosses to get out of this corrupted hellhole in one piece.\n\n# By Grit Alone, you will survive.", "short_description": "Cosmic Action Horror focusing on intense violence, deep lore and atmospheric dread. You\u2019re marooned alone in the Bermuda triangle of space, filled with ancient derelicts and ravenous aliens.\n\nA linear narrative campaign with twisted, disturbing stories to discover. Prepare for constant action; there's no loading screens, no inventory and unlimited ammo. You will need skill and speed to rip through the ferocious swarms and get out of this corrupted hellhole.\n\nBy Grit Alone you will survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bygritalone.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Crooks Peak", "support_website_url": "https://bygritalone.com/bug", "website_url": "https://crookspeak.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28937283795887601"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476753_408076935535163_1643876385163837005_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_86sqGm9xgQ7kNvwGRYes3&_nc_oc=Adoi15oQ8TioKugM9zxBwsLwrLj7raObpM24xJR8Zz9O8ueRHHOonjdMddFdfY2Gd5s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM-dZo9sdLDbgoH05fDe1kgmB7Ro5xCEOvRJfWzfi6nw&oe=6B032BEE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "By Grit Alone
KyQ8Q7kNvwGZT3m7&_nc_oc=AdpGTy4AFAkUfoIqXpd4RkfMiP74ra9te2WMRXUb6cl_XM2NeKUyxVwFK5XD-QPBWhc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXqeSe9fZ5F1Y4ngmVUjes4XJArrOoSJXQS8tiu0PDCw&oe=6B007C64"}, {"file_name": "Screenshot_Mir_V1.png", "id": "765909982318366", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031344_765909985651699_7770434399843880174_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9LjJKIzBGEQ7kNvwHKsKND&_nc_oc=AdqAt1nIs-N0Hqmbjlq1f6vFKKZxtWpLYgxQJtW1Pa0czCBBMHIbdD-qN_Z2nPyyJy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKwgP_iDDfK87tf1A5PGA9oa_OEzGpgpgspIvQcMajHA&oe=6B008652"}, {"file_name": "ScreenShot_IceCave_V1.png", "id": "475035741556053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75326678_475035748222719_2411778706841041105_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdNVYsBg2y0Q7kNvwHqR_xO&_nc_oc=AdpuTLCaK1scNLxa6f9W_D9ZYcI79kWhZBj2gsEddEZ9WTqa5q6r9nDVsZ3KuYp53fk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEGSNQW67ezOVLgPdmLhfsnMOT8SJyrJHjN-t6Ch-V_Q&oe=6B0060D4"}, {"file_name": "ScreenShot_AgaEntryCorridor_V1.png", "id": "769037181979337", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262744_769037185312670_4297071497369343849_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BFqpIJjivMQ7kNvwEEVOI7&_nc_oc=AdpXIFpndwKIvwTvBNMB4SHtdSQjZG1Khle1CKx8jAPTfXxXRWxSc2M6xliLzQ47tfs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiqJcU8uSOc92Y6NUVnTPfoUVR6ra7NV9e1C77REPqzg&oe=6B006DF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover_V3_2560x1440.png", "id": "556848373646536", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031527_556848376979869_7441225304369638921_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILtbbF11HYAQ7kNvwGy0fE_&_nc_oc=AdqZjMxR2Dh-RKfw7R2PPQJdvbSiRWAPmfY8jGqlhRM_r5mna6VYuLDnUuUCWJopewY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVzj33KMnC8sLDeEMsc6iwTofxfqL7wJkk3EfqQfpWmw&oe=6B00705C"}, "display_name": "By Grit Alone", "keywords": ["action", "horror", "alien", "scifi", "shooter"], "long_description": "# A challenging indie swarm/boss shooter with a story rich sci-fi horror linear narrative campaign.\n\n# \ud83d\udcac \u201can incredible trek through the jaws of madness\u201d 4 / 5 UploadVR\n# \ud83d\udcac \u201ca high-octane but still lore-rich adventure\" 7.4/10 Press Play Media\n# \ud83d\udcac \u201cBGA\u2019s storytelling is just about unimpeachable\u201d 7 / 10 Auganix\n\n{1217972975831984}\n\n# Get this game if you're:\n- craving a challenging shooter with bosses, traps, swarms and suprises\n- a lover of deep twisted lore with immersive audio, text and holographic logs \n- into bizzare environments and surreal horror experiences\n\n# Don't get this game if you're:\n- arachnophobic\n- wanting cutting edge AAA graphics\n- looking for a resource constrained game with an inventory and limited ammo\n\n# \ud83d\udcac \u201cKeeps you, like, right on the edge of your seat\u201d BMFVR\n# \ud83d\udcac \u201cWhoa, okay, tentacles everywhere!\u201d Beardo Benjo\n\n**Cosmic Action Horror** focusing on frantic combat, sinister storytelling and atmospheric dread. You\u2019re marooned alone in the Bermuda triangle of space, filled with ancient derelicts and ravenous aliens.\n\n**A linear narrative campaign** with an anthology of twisted, disturbing tales to discover. Prepare for constant action as you traverse ship to infested ship; there's no loading screens, no inventory and unlimited ammo. You will need skill and speed to rip through the ferocious swarms and deadly bosses to get out of this corrupted hellhole in one piece.\n\n# By Grit Alone, you will survive.", "short_description": "Cosmic Action Horror focusing on intense violence, deep lore and atmospheric dread. You\u2019re marooned alone in the Bermuda triangle of space, filled with ancient derelicts and ravenous aliens.\n\nA linear narrative campaign with twisted, disturbing stories to discover. Prepare for constant action; there's no loading screens, no inventory and unlimited ammo. You will need skill and speed to rip through the ferocious swarms and get out of this corrupted hellhole.\n\nBy Grit Alone you will survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bygritalone.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Crooks Peak", "support_website_url": "https://bygritalone.com/bug", "website_url": "https://crookspeak.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28937283795887601"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476753_408076935535163_1643876385163837005_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cna0dxIN6UoQ7kNvwFFh2wK&_nc_oc=AdpnaI27d8MWMZxFN7u08_z3Nw3TtE2Tx9K8Uy2Zlt7Kc_dnI7LejixPasI_24ozb-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKAqa4Ae4uO6oI-tu3NKwU56i2U2gIZN-b2STzqYexLw&oe=6B0088EE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "By Grit Alone
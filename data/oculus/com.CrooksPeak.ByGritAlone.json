c_sid=6e7a0a&_nc_ohc=m_M00UAKtgQQ7kNvwEqFDWK&_nc_oc=Adot0s2UmANNZ3TKlPyrKhYqpaqvES31YVdMXW65qlg1vNyovQjRSf1paaiIupKfUcA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LCkXlAC5v1gt64B3NwbyrPx6BqI7m6KFZz-TrILnVEA&oe=69FDE812"}, {"file_name": "ScreenShot_IceCave_V1.png", "id": "475035741556053", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75326678_475035748222719_2411778706841041105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOdojg3Xms4Q7kNvwHLYSlH&_nc_oc=AdpVxmWHKbLfkAUe5j6WnRg4KkILcf6mYsdlhGif8W6hnJaTK8Q06S3UkPSpisXTsjg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ecp9ykk9JRt8mSTwltvzAq4baOWa7jc1cUchQQhFpSg&oe=69FDFAD4"}, {"file_name": "ScreenShot_AgaEntryCorridor_V1.png", "id": "769037181979337", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75262744_769037185312670_4297071497369343849_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zy1fUVAgyoQ7kNvwHzVUi9&_nc_oc=AdqrVTwAaF1Lg2WFwW2w9laoo38juhOGGD38l5Y977THl9-z5Q6U7xfji8fr1hE_sfA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73ArHJWan7ZhzjOiLstmDMKn_rQrfHg5kDJzDivJuzIA&oe=69FDCFB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover_V3_2560x1440.png", "id": "556848373646536", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031527_556848376979869_7441225304369638921_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HsN7IV-Y1YQ7kNvwEjHOSx&_nc_oc=AdoOm_rJ0TDfRBDynyOZ7Lqv7Az72oIxt3Cka2T2DSMGJCT-Az4sJP9PoqDAnMl7w_M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Dm2_q1r1VBk6rU4AuGL8i-vQy92EIvj3DnlZansekRg&oe=69FDD21C"}, "display_name": "By Grit Alone", "keywords": ["action", "horror", "alien", "scifi", "shooter"], "long_description": "# A challenging indie swarm/boss shooter with a story rich sci-fi horror linear narrative campaign.\n\n# \ud83d\udcac \u201can incredible trek through the jaws of madness\u201d 4 / 5 UploadVR\n# \ud83d\udcac \u201ca high-octane but still lore-rich adventure\" 7.4/10 Press Play Media\n# \ud83d\udcac \u201cBGA\u2019s storytelling is just about unimpeachable\u201d 7 / 10 Auganix\n\n{1217972975831984}\n\n# Get this game if you're:\n- craving a challenging shooter with bosses, traps, swarms and suprises\n- a lover of deep twisted lore with immersive audio, text and holographic logs \n- into bizzare environments and surreal horror experiences\n\n# Don't get this game if you're:\n- arachnophobic\n- wanting cutting edge AAA graphics\n- looking for a resource constrained game with an inventory and limited ammo\n\n# \ud83d\udcac \u201cKeeps you, like, right on the edge of your seat\u201d BMFVR\n# \ud83d\udcac \u201cWhoa, okay, tentacles everywhere!\u201d Beardo Benjo\n\n**Cosmic Action Horror** focusing on frantic combat, sinister storytelling and atmospheric dread. You\u2019re marooned alone in the Bermuda triangle of space, filled with ancient derelicts and ravenous aliens.\n\n**A linear narrative campaign** with an anthology of twisted, disturbing tales to discover. Prepare for constant action as you traverse ship to infested ship; there's no loading screens, no inventory and unlimited ammo. You will need skill and speed to rip through the ferocious swarms and deadly bosses to get out of this corrupted hellhole in one piece.\n\n# By Grit Alone, you will survive.", "short_description": "Cosmic Action Horror focusing on intense violence, deep lore and atmospheric dread. You\u2019re marooned alone in the Bermuda triangle of space, filled with ancient derelicts and ravenous aliens.\n\nA linear narrative campaign with twisted, disturbing stories to discover. Prepare for constant action; there's no loading screens, no inventory and unlimited ammo. You will need skill and speed to rip through the ferocious swarms and get out of this corrupted hellhole.\n\nBy Grit Alone you will survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bygritalone.com/privacypolicy", "developer_terms
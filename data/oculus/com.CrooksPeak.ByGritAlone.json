&oe=6A467D54"}, {"file_name": "Screenshot_Mir_V1.png", "id": "765909982318366", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031344_765909985651699_7770434399843880174_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtQ1cVQ1YPUQ7kNvwH8Vn1w&_nc_oc=AdqkrEouh4wEmpxPEYBvWCtwiJHeiMiP-9T9WV2rPFiMebG6L8Ykh1Ta4GqWRqOUWnY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-Y0Vv8ChPKeW6cuDkwz0EV_cR6ng2e4pa6pYlJtMj3w&oe=6A466A92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2560x1440.png", "id": "3877503005805240", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75371509_3877503009138573_125829425033070742_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWCWFFiyK54Q7kNvwGBU990&_nc_oc=AdoxxVb7YClVLPiJCS-G7zbjM95v1DF50Jn8HmDY6wqDhpnF8UYs6_3Z2eIiErdqu1k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8labKF4FK9KauVoMLH5bhnTDMruobEJgvbzJAEV6fMVA&oe=6A466220"}, "display_name": "By Grit Alone", "keywords": ["action", "horror", "alien", "deadspace", "scifi"], "long_description": "# Stranded. Tormented. Alone.\n\n**By Grit Alone** is an action horror shooter combining frantic combat, bosses and challenges with a harrowing sci-fi anthology story.\n\n{1217972975831984}\n\nYou\u2019re marooned in a bizarre unknown dimension of space, filled with ancient derelicts and ravenous aliens. Uncover the mysteries of the dead as you move ship to ship, slaughtering your way through hordes of brain starved horrors.\n\n# Fight. Discover. Survive.\n\nExperience twisted stories from our incredible writers, with credits including DeadSpace, Resident Evil and Dr Who. There's no loading screens, no inventory and unlimited ammo; you\u2019ll need skill and focus to rip through the ferocious swarms and get out of this corrupted hellhole in one piece.\n\n# By Grit Alone, you will survive.\n", "short_description": "Stranded. Tormented. Alone.\n\nBy Grit Alone is an action horror shooter combining frantic combat, bosses and challenges with a harrowing sci-fi anthology story. You\u2019re marooned in a bizarre unknown dimension of space, filled with ancient derelicts and ravenous aliens. Uncover the mysteries of the dead as you move ship to ship, slaughtering through hordes of brain starved horrors. Twisted stories from writers of our favourites including DeadSpace and Resident Evil.\n\nBy Grit Alone, you will survive"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bygritalone.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Crooks Peak", "support_website_url": "https://bygritalone.com/bug", "website_url": "https://crookspeak.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25740887795527233"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "887706130606536"}, {"status": "PUBLISHED", "id": "1608060197245005"}, {"status": "PUBLISHED", "id": "640794662416400"}, {"status": "PUBLISHED", "id": "1940595600028689"}, {"status": "PUBLISHED", "id": "689359726928450"}, {"status": "PUBLISHED", "id": "1131399554825177"}, {"status": "PUBLISHED", "id": "427697007003348"}, {"status": "PUBLISHED", "id": "1305939940430237"}, {"status": "PUBLISHED", "id": "520572430960803"}, {"status": "PUBLISHED", "id": "4331830600376820"}, {"
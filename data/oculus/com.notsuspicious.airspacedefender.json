RvtASzbo3mPsiKQvEPtd_OAtJGl1OvKg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEd7Urz_FqogqIpyO3bm11ghRGEC26sxVVrzmetYxUL-A&oe=6A8D79B2"}, {"file_name": "build_178_ss2__.png", "id": "582563514230273", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75584096_582563517563606_6608274517652325672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXK8NvsjnggQ7kNvwHaPlw1&_nc_oc=AdpVUl-BRxOZTzyr_YboWSjKkQ6-36h4vGdv3EYXvBlDG9R0bh8KafyyuWe7yxaMqZ8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8eMEKTxB-JCgwBjL8lz2aN4riZYxZczfNkbJDlbWQew&oe=6A8D88B3"}, {"file_name": "build_142_ss8.png", "id": "9250475258309826", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001684_9250475264976492_3047236528094911763_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2_NOPe-o4YQ7kNvwGsb2ce&_nc_oc=AdqUkQ5I0J0A5D-beYvC8hvGDgoCpXciHdsd7jFONBSm-GQoKzZqEGpXFobIU2fCV28&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuVgqMwn_tziJDI_vHIbgzHyQ0U9vsPlXI-YXKFhIX2w&oe=6A8D77D4"}, {"file_name": "build_178_ss2_.png", "id": "1133884188074233", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75250457_1133884191407566_1152689678558865883_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJ2nafU4PLAQ7kNvwENODwB&_nc_oc=AdoffwqwWWldbrriqJA7VplY6MlUeA_36uy3_JQhGEfjvCe-Z5FPXvCr_4TVXyImSk8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExGOeXeqnP6P_SH_wGoc3kyteO0XtQZtLL4BH2OfYFcw&oe=6A8D83B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Glitch_Logo Landscape V4 Final NS with Awards.png", "id": "884740613741238", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75462207_884740617074571_4283912548400376450_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yODA--U3ozAQ7kNvwG_vQwU&_nc_oc=AdqVoYUHcGkREleC93pMVuQvvO2X76XmChxkeI_orMii4Ed1iBhYSrEk_l1Tl3yz2IU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-mV1hCKurTSw7kOBdfZ-tD7KLC5j-PB0RFxRD_9zP1g&oe=6A8D9AD6"}, "display_name": "Airspace Defender", "keywords": ["tabletop", "arcade", "retro", "defense", "shooter"], "long_description": "# UNLEASH THE ORDNANCE WITH A PINCH OF YOUR FINGERS\nYour city is under attack! Deploy the command console to manage your defenses and protect your citizens. Thwart enemy attacks with carefully timed retaliatory strikes!\n\n{1209565883674718}\n\n# IMPROVE YOUR REFLEXES & MASTER THE ARSENAL\nIf you survive the immediate onslaught, you'll get a chance to rebuild your city or upgrade your arsenal from a selection of missiles, bombs, drones and lasers. Complete contracts to earn extra score!\n\n{439655972206404}\n\n# COMPETE WITH FRIENDS ON THE LEADERBOARDS\nWith each wave, new threats emerge: faster missiles, helicopters, drunken kamikaze... Will you achieve eternal glory on the leaderboards, or will your city fall under siege?\n\n{908217047621802}\n\n# RETRO ARCADE ACTION MEETS MODERN MIXED REALITY MAYHEM\nWhether you're hanging out in the living room, catching a sunset outside, stuck in the toilet, or anywhere else, you can always quickly jump into the action!\n\n{1416222999731459}\n\n**\"A must-have for Quest\"** - UploadVR \ud83c\udf96\ufe0f\n\n**\"Breathes new life into an old game\"** - MIXED News \ud83c\udf96\ufe0f\n\n**\"Gets your adrenaline pumping\"** - 6DOF Reviews \ud83c\udf96\ufe0f\n\n**\"Greater than my imagination\"** - Bill Carlton, arcade gaming legend \ud83c\udf96\ufe0f\n\n# KEY FEATURES\n- 6 **Training** Maps; 7 **Practice** Maps; 2 **Arcade** Maps with **Leaderboards**\n- 8 Turret types, 5 Enemy types\n- 15 Turret Contracts (i.e. skill challenges/bounties)\n- And more still in development...\n\nJoin the community:\n**notsuspicious.biz/discord**", "short_description": "Airspace Defender is a 3D tabletop arcade game in mixed reality. Manage your city's defenses and thwart enemy attacks with carefully timed retaliatory strikes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.notsuspicious.bi
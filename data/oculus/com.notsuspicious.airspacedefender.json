PVl8CrX3lGQgfxLUqqMj_U-z09s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGOIyR9e-BEEf9cdvKaFjHktYDOwSj8gCjYNEMX9HIFg&oe=6AA41B72"}, {"file_name": "build_178_ss2__.png", "id": "582563514230273", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75584096_582563517563606_6608274517652325672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYP1gHzxe78Q7kNvwFxZVgb&_nc_oc=Adp4QpJJ5Mcvq-rP_tU0kj4a33nGk_cSrjtQunHlT6S8KxBs47ab42yhwxNy2GGNMKA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXPyPvzqEhwQpcQtrW7xN137r8s_fbATijhKRumiFP0Q&oe=6AA3F233"}, {"file_name": "build_142_ss8.png", "id": "9250475258309826", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001684_9250475264976492_3047236528094911763_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mU3K0tE1n8Q7kNvwG3N41L&_nc_oc=Adr5vMSx-DCnQ38ntZksPn_qm5nLN7VjuC3OROwSJ7_sge1dowBjClmvJ5f0C2qAkGM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVBa-H74YrwN2gmkAWfoFPhYspGh7id4tOGGFlwPnmCg&oe=6AA41994"}, {"file_name": "build_178_ss2_.png", "id": "1133884188074233", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75250457_1133884191407566_1152689678558865883_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIn8RrhpP-oQ7kNvwGcq_Lu&_nc_oc=Adq_OPNXRXhwA2xtYfJKndOExzng_j3JTo5BAE5b0L_DtjSwjc_mtpX--eck8vNQlQ4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDEnBtsM0pvDzizjEIH01RzwY6NphYVA2wWXdzhEsRiQ&oe=6AA42575"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Glitch_Logo Landscape V4 Final NS with Awards.png", "id": "884740613741238", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75462207_884740617074571_4283912548400376450_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rU05i0BEZmsQ7kNvwGUJ7IU&_nc_oc=Ado-xHxC3qhMa-70lPHbxSIPfsfrB0DfAGuUv-xdB7uRDRdJGlEJ1rv4RvGddFxK2wY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKE33Id4nXoT8LW2MM24cbIsFK7lBhw2IaqsnPDpM02Q&oe=6AA40456"}, "display_name": "Airspace Defender", "keywords": ["tabletop", "arcade", "retro", "defense", "shooter"], "long_description": "# UNLEASH THE ORDNANCE WITH A PINCH OF YOUR FINGERS\nYour city is under attack! Deploy the command console to manage your defenses and protect your citizens. Thwart enemy attacks with carefully timed retaliatory strikes!\n\n{1209565883674718}\n\n# IMPROVE YOUR REFLEXES & MASTER THE ARSENAL\nIf you survive the immediate onslaught, you'll get a chance to rebuild your city or upgrade your arsenal from a selection of missiles, bombs, drones and lasers. Complete contracts to earn extra score!\n\n{439655972206404}\n\n# COMPETE WITH FRIENDS ON THE LEADERBOARDS\nWith each wave, new threats emerge: faster missiles, helicopters, drunken kamikaze... Will you achieve eternal glory on the leaderboards, or will your city fall under siege?\n\n{908217047621802}\n\n# RETRO ARCADE ACTION MEETS MODERN MIXED REALITY MAYHEM\nWhether you're hanging out in the living room, catching a sunset outside, stuck in the toilet, or anywhere else, you can always quickly jump into the action!\n\n{1416222999731459}\n\n**\"A must-have for Quest\"** - UploadVR \ud83c\udf96\ufe0f\n\n**\"Breathes new life into an old game\"** - MIXED News \ud83c\udf96\ufe0f\n\n**\"Gets your adrenaline pumping\"** - 6DOF Reviews \ud83c\udf96\ufe0f\n\n**\"Greater than my imagination\"** - Bill Carlton, arcade gaming legend \ud83c\udf96\ufe0f\n\n# KEY FEATURES\n- 6 **Training** Maps; 7 **Practice** Maps; 2 **Arcade** Maps with **Leaderboards**\n- 8 Turret types, 5 Enemy types\n- 15 Turret Contracts (i.e. skill challenges/bounties)\n- And more still in development...\n\nJoin the community:\n**notsuspicious.biz/discord**", "short_description": "Airspace Defender is a 3D tabletop arcade game in mixed reality. Manage your city's defenses and thwart enemy attacks with carefully timed retaliatory strikes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.notsuspicious.biz/privacy", "developer_terms_of_service_url": null, "publisher_name": "Not Suspicious", "support_website_url": "https://www.notsuspicious.biz/discord", "website_url": "https://www.notsuspicious.biz/airspace-defender", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1676485315806614"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24415553634769257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001671_758489706390731_317277346532944294_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F780llN7yLMQ7kNvwGxHEhx&_nc_oc=Adq1u9v9SrnbJNKivoi6leBp96OkIZUzj1o9_m6R7A4hHvQltEWx70t7K8XjGPuekrQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUhtlM1kwyTW9Swc82YB4lo-bumuEWk4zYI5GGJC-5Rg&oe=6AA41B1C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Airspace Defender", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Tabletop", "id": "1676485315806614"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1729270800, "lastRevision": {"nodes": [{"id": "7523170247767527", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "
0xvinwUlRsrPF7d8dqgGGHM_EAU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS07YJsAazYnKgdXP2E4YTWyOrcgIczbvXeNQ7v23E_bA&oe=6AF1DE72"}, {"file_name": "screenshot_4_fpv_coral_110fov_2560x1440.png", "id": "1464480168847046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299891_1464480172180379_7311202102298453443_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_0jbsRn9zEQ7kNvwE1OYOK&_nc_oc=AdqmSVp1Lb5ppj4O6vUpr1iGvYRkoDPMFfkLms7AudQ9qhRda5P31BB_xyL2e51SgQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEvPXI-o4-nNpGr4HlNJU6f-e8I8scIIsVMSoDZ6pC0Q&oe=6AF1DFC4"}, {"file_name": "screenshot_5_fpv_crimson_110fov_2560x1440.png", "id": "1351512386802537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_1351512390135870_1992109308952828625_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cG8LzEG4a4Q7kNvwHa47fm&_nc_oc=AdoqoKlClKlWZu6-abm4GFPIwxOcxvN1GIx2WY9lMXVnm-RK5UMa7DpECb5XU5AQtlY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpBqvebNmACkCMKLDqqtZ0eNaRCyAhW5IU5SBlh8xn0A&oe=6AF1DE0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_1_arena_wide_2560x1440.png", "id": "2068962084010381", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314663_2068962087343714_6941575723482969108_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72E5qI6mbtQQ7kNvwHIGoqg&_nc_oc=Adq7Dzahy0FdScab3ovH6CjtP006sb_zBSL16rqdeOHjEqIKqAsYS1aD1uJeQqF5xWc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5X23JKDmAgNrLH0y3cXwY9sxBbxBY0ETl_WxI4IKKLA&oe=6AF2071B"}, "display_name": "Arena240", "keywords": ["pvp", "240hz", "ffa", "combat", "bots"], "long_description": "A 12 player free-for-all PvP arena built to run at 240hz on Quest3 (or 207hz if you aren't able to developer mode your headset to push it to 240!)\n\nNOTE: This is an EXPERIMENTAL game testing the capabilities of the Quest3 it is UNFINISHED and NOT COMPLETE. \n\n- 12 Weapon pickups around the arena\n- Bots keep lobbies active\n- Joystick locomotion(you can swap/disable in settings)\n- Everything grabbable/climbable\n- Some weapons have movement tech.\n- Earn crowns for highest damage, eliminations, and health pickups.\n\nCONTROLS:\n\nJoysticks - Move/Jump/Crouch\nA/X - Dash\nB/Y - Drop Item\nTrigger - Fire Weapon/Use Item\nGrip - Grab/Climb\nJoystick Click - Push-to-talk\nMenu Button - Open Scoreboard/Menu\n(You can also grab one hand with the other and pull to open the menu)\n\nBuilt by the makers of DUST\n\njoin the DUST discord if you have suggestions/bug reports: discord.gg/dustvr", "short_description": "12 player Free-for-all VR PvP at 240hz! (207hz technically) Bots keep lobbies active. Joystick locomotion. \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://vrdojo.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdojo", "support_website_url": "https://discord.gg/dustvr", "website_url": "https://vrdojo.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28501062912877834"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499294644_1408978018114904_4727143691513256978_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGxHzWM1drAQ7kNvwFcj2p1&_nc_oc=AdpISm
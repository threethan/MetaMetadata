771-25/491823276_977690344648494_5075479123136692600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24Y_DowwUr8Q7kNvwEptQCD&_nc_oc=Adot3RUugXci0U1UNdjY9z_4sFBrNvM-9QiqHtFKmUFb3Pz7M88s_h8g3HYtsly8KeI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3dW9MIRMJ2n5APQqARIQvV9RdJ_WHN1yKhWW4iTM6Skw&oe=69F34D68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "smash_room_2560x1440_nostretch.png", "id": "1659363705247945", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618264_1659363708581278_8094600907996488109_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8a1Y8v57eAQ7kNvwE43xw7&_nc_oc=AdrOnHlGpkAnSf4qx6zqL0M1EwbINnU-4Ja4wt945agfQ3n7CbbdNU5ZWZCdBhK9fHU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2L4qU5PCpO1gXiwR931b2FZTlND6y-UVU-Yy2PfBn2lQ&oe=69F35FF3"}, "display_name": "SMASH ROOM  XR", "keywords": ["smash", "room", "sandbox", "physics", "destruction"], "long_description": "SMASH ROOM XR is the ultimate VR destruction and stress relief experience where you can smash, break, and destroy everything in sight with no limits and no consequences!\n\nStep into fully interactive rooms filled with furniture, statues, bottles, electronics, and structural elements like walls and columns! Every object reacts with satisfying physics, making every hit feel powerful and rewarding!\n\nChoose your playstyle with a wide range of weapons! Use melee tools for close impact destruction, guns for fast-paced chaos, or explosives to wipe out entire sections in seconds. Weapons are placed around the environment, encouraging exploration and creative destruction!\n\nStart instantly with 1 free VR room and expand your experience with additional content. Unlock 3 extra VR rooms and 6 Mixed Reality rooms using passthrough! These MR rooms bring destruction into your real-world environment, allowing you to smash objects in your own space.\n\nMixed Reality currently uses passthrough and requires physical space. Multiple room sizes are available from XXSmall to XLarge so you can choose what fits your environment.\n\nDesigned for stress relief and pure satisfaction, SMASH ROOM XR delivers fast, addictive gameplay with no missions or pressure. Just pick up a weapon and start smashing!", "short_description": "SMASH ROOM XR is a VR destruction simulator where you can break everything around you using melee weapons, guns, and explosives! Smash furniture, electronics, statues, and more in highly interactive environments!\n\nIncludes 1 free VR room, plus 3 additional VR rooms and 6 Mixed Reality rooms as IAP. MR uses passthrough and requires physical space.\n\nPure stress relief! Pure destruction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-extra/", "developer_terms_of_service_url": null, "publisher_name": "Ultra Fun Games", "support_website_url": null, "website_url": "https://www.ultrafungames.com/#hero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26648738964720304"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2071377196767459"}]}, "baseline_offer": {"id": "2071377196767459"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776860400, "status": "PUBLISHED", "id": "2071377196767459"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results
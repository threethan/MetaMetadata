f&oh=00_AQSWN7gkiYqWpKfNMb50SaL1V1EfiT5Li2fpkC-1UMj-cQ&oe=6B01C928"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "smash_room_2560x1440_nostretch.png", "id": "1659363705247945", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_1659363708581278_8094600907996488109_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yM_2aVNVpTUQ7kNvwGfPd4Z&_nc_oc=AdrbeAfytgI-TYfI3rdIxpAwdEzexapHfEqPaX6UFJUOoc8KBBAAJVmAb6STAb71Z6o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC-vRbi183K5Dm3x2yBBGQjtgjhY_sB5GX9PUGzzotPA&oe=6B01DBB3"}, "display_name": "SMASH ROOM  XR", "keywords": ["smash", "room", "sandbox", "physics", "destruction"], "long_description": "SMASH ROOM XR is the ultimate VR destruction and stress relief experience where you can smash, break, and destroy everything in sight with no limits and no consequences!\n\nStep into fully interactive rooms filled with furniture, statues, bottles, electronics, and structural elements like walls and columns! Every object reacts with satisfying physics, making every hit feel powerful and rewarding!\n\nChoose your playstyle with a wide range of weapons! Use melee tools for close impact destruction, guns for fast-paced chaos, or explosives to wipe out entire sections in seconds. Weapons are placed around the environment, encouraging exploration and creative destruction!\n\nStart instantly with 1 free VR room and expand your experience with additional content. Unlock 3 extra VR rooms and 6 Mixed Reality rooms using passthrough! These MR rooms bring destruction into your real-world environment, allowing you to smash objects in your own space.\n\nMixed Reality currently uses passthrough and requires physical space. Multiple room sizes are available from XXSmall to XLarge so you can choose what fits your environment.\n\nDesigned for stress relief and pure satisfaction, SMASH ROOM XR delivers fast, addictive gameplay with no missions or pressure. Just pick up a weapon and start smashing!", "short_description": "SMASH ROOM XR is a VR destruction simulator where you can break everything around you using melee weapons, guns, and explosives! Smash furniture, electronics, statues, and more in highly interactive environments!\n\nIncludes 1 free VR room, plus 3 additional VR rooms and 6 Mixed Reality rooms as IAP. MR uses passthrough and requires physical space.\n\nPure stress relief! Pure destruction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-extra/", "developer_terms_of_service_url": null, "publisher_name": "Ultra Fun Games", "support_website_url": null, "website_url": "https://www.ultrafungames.com/#hero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26648738964720304"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1691606769415916"}, {"status": "PUBLISHED", "id": "1790608242060435"}, {"status": "PUBLISHED", "id": "3411246475929551"}, {"status": "PUBLISHED", "id": "4581354248799141"}, {"status": "PUBLISHED", "id": "1598128551482515"}, {"status": "PUBLISHED", "id": "1781732019779354"}, {"status": "PUBLISHED", "id": "1997313997602141"}, {"status": "PUBLISHED", "id": "1817503089452706"}, {"status": "PUBLISHED", "id": "2406633626472451"}, {"status": "PUBLISHED", "id": "3412985072186404"}, {"status": "PUBLISHED", "id": "2570246070036202"}, 
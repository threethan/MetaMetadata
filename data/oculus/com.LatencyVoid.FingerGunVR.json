18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7lVjJLWltgQ7kNvwGy9Bpw&_nc_oc=AdoSxHd_y2s9L6cR8so_LualOi7NL63gf8c1MoXKniGfvSF-Bhw7QcXbwJoosHXd4UE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBt6oeJ6FFUTAUZBmTAivB9KsEpvnjR_D9veqvbMAY0g&oe=6AEF525B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PihAq1VJEqIQ7kNvwFETKqo&_nc_oc=Adr0JpUfC2kcgxob78jSOyLKHf0zWeO2FthyYi7dJvCRisIcUVvbGci9ILFLnXEk3VE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQopZAf5sT83cP7BoCctgC2xiBGPNvm9wOp_k9wqilM7w&oe=6AEF37D9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRkPRmsg9c4Q7kNvwGNnx4S&_nc_oc=Adrtu9YpaqI5TWqi4pKZrSZixLeLEWN8oIgUOYC02dOcG6OZ-Rx2JjCrdfRHwp1ER2k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCAVZPVLilT95sb2pKBB5a_j_Nk9UY4OYBsK8Sk3QP1Q&oe=6AEF46CD"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEMHhNIG0FIQ7kNvwGeDwQz&_nc_oc=AdrSk3quhmMesIp2LImXtOhiH2kPTal95OHysbhIToAhEAIqkX_P456EVs5vubJo5Sw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5IoCHuO-4b7HG_IiYL9ud1L4deSZiOnmdWpzPdNJqsQ&oe=6AEF4F95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueBXZd_bccUQ7kNvwFgwsJf&_nc_oc=AdoqkIvdwZWgPGGuWAdaqQCQT1uPno419IyzCnNZ40MsFnEfXs3Lydmm5RJEWOuQfzg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwshEme2k_DHYdhOhywGxlvyX_ginm-KV9SYseqWIz9g&oe=6AEF5AD6"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
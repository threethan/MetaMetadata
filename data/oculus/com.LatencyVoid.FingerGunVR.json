9618515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcXC90hkYGkQ7kNvwHHfZzp&_nc_oc=Ado7gYtL3H3nlR9IUW7Cp_CW85OJVqBrYuYwNE8WeNyMC2kS50pxF9rTtafHcxgtxf0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KY8krsrNmrpJ0rWZCGBb7NayEw9B2rBOaOtfET6WdJw&oe=6A465A1B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVl-OKZiyEsQ7kNvwErJ9Ei&_nc_oc=AdrusUhDAERjrukcmR-kOL2JOJuaOG-5badyPmowX8fy22z9SuFXnqw3Ml6cot0clxk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ef0tTa7MfUlxtIoKGmJKEokDhuWAHyEs1-iz3n1HDVg&oe=6A4677D9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvZKsgQEJHMQ7kNvwEsjroU&_nc_oc=Ado7vPROYhEaWIdBK5eUKYmF0ucjXgq_SiARqDY8iJl5KomBfbidDCwmXlv5qCRoSL8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I25bCKs9XiHsPJmcdTJDH2fzZJtZMOzuR3h-2DNWEBQ&oe=6A4686CD"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-Gmsl9QxwUQ7kNvwFQr6EO&_nc_oc=Adr6heGpGrt6pp_e1-lg6WjUNoexWdZEjTmt3YZBrjMp65e2cglGefajcZI1L_ENXt4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mtUoU16ncyvvETWH2uWPOPMN7wGnc0SNx8tHV8sU7dw&oe=6A465755"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neSlWlU_08kQ7kNvwG6SW0m&_nc_oc=Adp_O6vcJhljFs5NlWvf5JBF4SIr8VYB7WYU0LVFKHGdkxGXzKfWK4l5bSesjA_1vhU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Jq82GVaFeT3punD4Ho18Lu1lyr7C-m2IEh0aryY8AAA&oe=6A466296"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_w
18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-96UGMayjRUQ7kNvwHWzOo0&_nc_oc=AdpceUkCDXM8lGD0sAiqEjP6gxx-zFHsPf7INJTblOy6rczm5DYETmkyh0BDutH7k7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eNqBf2_THm39aBLSDNZn-daihuJQUOCAsWawMDahMFQ&oe=6A2E9F1B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neAeFwIkuJoQ7kNvwG5_fg3&_nc_oc=AdqKrO-YQEHY1C6gSpGE7f-M38bDnuEGCkCejImWS_LZCOskX78Ypiy_AkiMnzkxZ64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iarHRlf-MuwkRRiBoJAbPucjj_rx9toT6dzwg7rnUEA&oe=6A2EBCD9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3e5GANjk_KkQ7kNvwFg452T&_nc_oc=AdokaLSR0Yq1TQmwv15n49GaPhRd6a9wiNx5CxtWgzeTqIuqImN1PKives1RAIlVEEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a65xWb5LoXJpjPZscuvUNh73Hrel3ga2T9Cb5Cko1Ug&oe=6A2ECBCD"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3saxU1aSOK8Q7kNvwHpGN-X&_nc_oc=AdquM_SfYUfsuvdkyjwiGpp24tieSfoxVk7DcEGg0me1mEqSr2_qHmaQY2lWtiZoP_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8087acZi8bNZ3ewfsLhRt9fjnh78hfwm8ujnq770OcOA&oe=6A2E9C55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmWe14u9i4AQ7kNvwGUqb6s&_nc_oc=AdpOf1wM-BNKo8TkZHJTQnaQvF_RBPpWTSRBrth-OhE7G30zBaKKb_-UaOKK1hy9oEw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8t_WoXlP7ymXIVi0Gu6zx0waVjf0txgrXJsp3ukCcaXg&oe=6A2EA796"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
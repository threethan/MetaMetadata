18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nzo7R_7e9vgQ7kNvwG8n4pp&_nc_oc=AdrrASF287BVwA40lGR5woE57w5PqGmCoxfoJPbNQtaJ0Y1MrH1mgMhcBV2nvSjlFTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rWdy91RL9ZDl7tLS2q3rrDbx8Z9tm7rrhmvgCxnYKIw&oe=6A0DA99B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FufqbMN2oIQ7kNvwEWiegG&_nc_oc=Adrc84IJArDE5cxat5m-lc439BoYoANHC2QA2a86Kr76xM4liSN-Q1bQ-8r63nECo7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eSA7rPRUwMlcM0I2p8X1XYsf2Y5SPmaC-JF08jsVThg&oe=6A0DC759"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWvGxbEfVgwQ7kNvwEJ1Woc&_nc_oc=AdrDXfXwk9XqU1KXKnBdYlK9xvZ0Yo3zKE7Mm-TIYPc_0UFwCxP2lWiMrc22oHQsAtI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KuNxvEzFx_hUZnO7nKr15iPdL-R8ii06rr8bN90hIZQ&oe=6A0DD64D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcmvCjfOlVAQ7kNvwEeHGAE&_nc_oc=AdrAVxb7XzQmgd56h9wCK0FbZ6HbAsa03uFy5qPEjLtEYvi_agWIaRH-nmoYg089mxs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o3PJXIXct68Wpu-b-u-OEc8SQ-QJbmbKMV3FreE-Jtg&oe=6A0DA6D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1FMI-yM2i8Q7kNvwHJ3c4o&_nc_oc=AdopHdbPGXBnOcFWZ6G51669S0KvaPb1XlItMgjO3f6OLAajWH1KNmWBtH40dseV50M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uefN28SDF6eufM6D4wraEqy2ZVbx_93J2FeAfYn7tng&oe=6A0DB216"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
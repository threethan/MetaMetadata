18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2II1PCAipdQQ7kNvwHM5og2&_nc_oc=AdrD5yyFJrfhzaFG5OEDDSJBfdNaxSsvUXzP98zsEJ7pOnNeerL8maRmabPBlVTPlZU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINUxS2A_yotYNm4hPB7u2hNs0zPhO9HzP1W_af3PcD6A&oe=6AA1519B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaB7_tGzcscQ7kNvwFy05cf&_nc_oc=AdoOBtmi-BhzWn0Gdn10BHzWwgHENpHggs9GapvWMXPHhx483HJjW0RBxvJTEhlVoJs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZv57m0mLeSFt9JH9OntkmKmzIJH4xh0EFkoLZXcHAJw&oe=6AA16F59"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmlgzMVU7EQQ7kNvwGI5MyV&_nc_oc=Adr-_CCQ5p77OqPxvg8m8k4R-N2YQN0xJSzoaJ9XAF_1lSGXl_48S60x9fiy3KwrHsE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg38T02ADd3cY8vud5WzLcN79bmI8HCiemXNyj4c3i3w&oe=6AA17E4D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJCQK1hBZi8Q7kNvwEDA_2G&_nc_oc=Adrnlv5trICuQ-sI6lZ3C0AfGJhW-ezd652mc7D1KtKTlam6n9Rbs2ARs719yYCQ_WE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJlujd8phd1Nbtij1AAqHicTxn2Eb4VyN23s7_ZPvDag&oe=6AA14ED5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Wj3XD9QwoEQ7kNvwFT5XQO&_nc_oc=AdoXtfE0MXAQo9TkQHoUvvHU5hW6RTxHZ_8t-V9oSHx6CuNGlrC_TybxQWP-abpOq98&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkjcV9iIS6jwh0PYQm4cb0IFQo1ShYOnoPX5LoVMtWGA&oe=6AA15A16"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etq6O3117_8Q7kNvwHTMp-q&_nc_oc=AdrJFtB8i5dTvFNBKzu-kBk-dXaZ3ivH5YUyejaQxHxWGLZ7TF8xjGSIGGsTi0fXbBA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vvfoxiuVGjOoaJ4WRzah438obcti3e02hPWmn65_C4A&oe=6A41141B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3INBDvkYHOYQ7kNvwFctC_M&_nc_oc=AdpuTS4aqtUrW1OE43fr0kPw-vxUdiI53CgycPB0Z6rC7A1bbAr8dILjWMpbGyNHT1c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vRUlJaSY2QiFSNGxSooaXG7Yn8ykfDZ8K8YeoYlEE6w&oe=6A4131D9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yw4jZ0BdKSUQ7kNvwGRJfCu&_nc_oc=AdoA17k7VGpVhE9-fR-BdehcQoLWdZAF07yj2eEMCdcmOgpBXSj6lEpPEWbAXoVsus0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80ESeonqAMZAtrstPPPBCyTSxYp2xmdRhrS7jutnFoTQ&oe=6A4140CD"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lv7ekqwzEE4Q7kNvwElanAD&_nc_oc=AdocVdCaCd-UckA4zASR_gzLM59ZAV-mSpmeGLhPt7gWUKlWXAKZx415CGsBfgTnc3I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lYOdz_GheG0S7hAbJJX00r2rwYy9L10pBFFfK7KSz3Q&oe=6A411155"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUsDIbcF_AgQ7kNvwEs-blj&_nc_oc=AdqpSNMVRd8uPyLbXd4LEUhDWEHwd0IaJvDxCcs4Zvn7-zxyiqLhOHic1_A0zwly9O0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KcKLsntl7vMKxbMBVmIQiOvmoLwzbV5iv26m_EUWfvg&oe=6A411C96"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
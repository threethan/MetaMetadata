18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvqH2qCPXScQ7kNvwGvzfS9&_nc_oc=AdowLtxiMxKi43Y1i_B_QfMuv5rN8ohdpXZ2EU7dMIPQe50pLthsOIPsZSvkk9l-W3Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFkmvYkgta1iON80HHq8-TQIj9AO4O_yAsA-HOGVcTkA&oe=6A747E9B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Jpl0vATppUQ7kNvwEuWDTc&_nc_oc=AdryXhm-g55T11ZJZgl52RnAxMwuaNd09Y93kjS7it3sAKI05Gq_Vlua9--xnbf7uj0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLX1liCpRrW95BakPKDQNjPyss-IF8XSpRxUnyE0SCzw&oe=6A749C59"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb7qs6md1KMQ7kNvwGTlqqg&_nc_oc=Adq9Q_mN_Tozu34ZQhkYZqPi7i7zrUtzFQCVaVM8_c8PLM9nnNQMLqLiKo6kdj_1Ekc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG755qsKlmXzCUz070YKGmRQxvlAxOYJ9b9CtXgthIHQA&oe=6A74730D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sffp6xcxsDoQ7kNvwFU4f07&_nc_oc=Adp6ZruXvDGE6wWSLezTPTuTyQN6EpJjWBJ0iZzbAJBeE5WRauFpRBgVa8j2aq1Z524&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP89y1HAjogCnwSt4U3OV-TbhIOxhw5_DXb_9CAEa52A&oe=6A747BD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CugCi6bqA2EQ7kNvwHoaDjZ&_nc_oc=Adr93nGBX-okzS2QLVXTxp4xRwTIZAszlLPa1GpcadXgYQC_zWUR92pRobKcTB-RYyw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmd_LLT7D2k47psb0q0YVi5X4x3qw5kiIC3CLw_s5UDA&oe=6A748716"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nlm1yGQO5z4Q7kNvwE20Le1&_nc_oc=AdqmoSnwv3Mwn7JP--PZe7UCwUXa5lutdNelc3Bhr-jFF_W5M37pJ-KwsDPBq9wBErw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHLHcemKaGJCMu-NyHuS373hrZIyUoS_RpRY2WGcJkEw&oe=6ACBB9DB"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZgYwmlgSycQ7kNvwEmiTKx&_nc_oc=AdqUZMcqZ5j4JJdid30DonRDliUuqA3-qeC3InmW5a1-AykvxIeRI70QxN5ym4alt4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-2cXLNfsrsxpCKjlSxoEYsv0dwj6UcfCKXvVjdXKoFg&oe=6ACB9F59"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjzURKvXzH0Q7kNvwE-Y4HV&_nc_oc=Ado8mW11ZcYpAdT9h7m8aZzb3k1I3zI0BRos7l8bTejYRTD0bl-pNHSBP3tTnCGm1dg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO88YSt_skJ3CtPqC0o7KLGktpz4KeIlxxBADekk9zI6w&oe=6ACBAE4D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvsuTi93JKQQ7kNvwGqmLSA&_nc_oc=AdonAWk4bv_twAWRE1OzSvF56voApktpkrvqJMi2G_jpdBvp_JXCKDhLW5lZ4AfGQfA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMa99O8ghveLTKPTiIRWdaxtp3dbXlhhrHo3elfBLGFMQ&oe=6ACBB715"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIiwhB5kYmkQ7kNvwH4xT6K&_nc_oc=AdqZmxJbS0DDJCeNcMcRhnTzGoaVTKbf2d2jqZDVThNf_uQvLX7PkTbSN9eSEgwpr7M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTPSJWPW4rUyjbvzyOHd7A0ErMYYO76AchpsNOpCx9Xw&oe=6ACBC256"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
oJGXbRqYbGgLT8a3cZ7z9kCCGt8FwQuuYd5Dzrwivj1RYMs0bbRA6zResz3CJcJM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyxm4NkoNniOuJqx6_OVF0bnHV3qwP81K8sfo0mdXWysg&oe=69C2841B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zfKn9S9cSAQ7kNvwEt7Gq1&_nc_oc=AdqFZhBPwW01_BoClM9KMrjOTXRGiY1dHNe7cEPQy1_wsnBTsguAozt-_7bfin5nnus&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMYkwUmxqTlXBtgioS5-ju-JRLIw5aXbncyuObI1a_bA&oe=69C26999"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxZV1hOejHEQ7kNvwG04VQR&_nc_oc=AdoXEZV7f2Zsva6P5DNxMvPhgF9K5GDQtlnWnM85Mz8ANf0JGBO-W4KM-IGz-9K7U0U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0yGXhtLl-P67UnCN6Zgcuz8EOwUoKmNV8-o5NsHmhRw&oe=69C2788D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgGV2tOKI6wQ7kNvwFr7hnc&_nc_oc=AdpSRmi9CTKYg7ZKUebgRCcV241JJlZIJnM7OPhvwI6_bJCIDznitdYlJF9LEjsRmTU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVbMecCf8syaLIQFmuLNCRHP4DLycX01DeG7uZlGTLPg&oe=69C28155"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNnUmSedYIkQ7kNvwFdi-TH&_nc_oc=AdrJPqxWp-8UBk4YPPfg00BFwf7rGEIdNNBbJ89ESPqcQyBkMBoezXR8WuhLzc6UA4o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzorYrp36ZQbthXEob3EfANhQWM-gf_Lo9q0Fs47idVHA&oe=69C28C96"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_website_url": null, "website_url": "https://latencyvoidvr.wixsite.com/latency-void", "category": null, "comfort_rating": "COMFORTAB
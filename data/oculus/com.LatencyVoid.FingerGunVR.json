18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdMJTlX4_7oQ7kNvwEk8WlH&_nc_oc=AdpuORfQ2yU8ITnZVb9vBlktvmK15hOToWgBc4wPSMHrUCLVEYH-ee3AT0z4SI0Uvlo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6FEA43m1AIyKobGTC6xe-GMv2F2PqaSNk23zBVHo1Zw&oe=6AD3A2DB"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEAsZtZcQ4AQ7kNvwFfgmY7&_nc_oc=AdqXDXNmb7pTJUYmyz-g8zV-XKU3PpdkMgNb48FSQwCUkyHF7HyzbbSRQ7L7eG9j-K0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGPGl2zdl1SZMAhDFaTTBzWNbO_NnbNmPk9oQ6zrjNIg&oe=6AD38859"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1DhC3XbyWIQ7kNvwF9ygEo&_nc_oc=AdoIgZ4vKY_S2F63vwC8eRO_obuRVPl7Aul_NNs1w1-84njsJFEcOsY8LHZ4apwpBaI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjz8_KgQxYMKLSrAvfIo_0N5zUPD-0pJ1Z3MYNqd4cww&oe=6AD3974D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wB-CkSJADWcQ7kNvwFsNmpb&_nc_oc=Ado7pp0jTqcPKwLWoUvKWM2W5XBxHZmDFXdf0EE9dsj1FrzGdGV8FaQCi2OMfnpJD_c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNucGlm90q7XKJp2p5UDa1TNTw-4EFQSXgxMN_iZP8Jzw&oe=6AD3A015"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=752v4rT7a4gQ7kNvwHGbQIG&_nc_oc=AdoqQ5Z1cyJ7W6sTnnkg32kT6l5E__s8fQvYYUJ_JLxoqE_s8dLE7ezahiYsutMcH_c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMf7mtFck2KPkht28ErY9WbJhccPgfxOLYdXBIPjLW3Bw&oe=6AD3AB56"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
G2ts7Am6NXF1HGWRCatxkMd8hPof-jFP4wb4-FE4LNL2XzejFJDYAgk8EmlrwicY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQ0LZ2fbecbINvTQIWX6fuWDeqaWlTIR1UPP9onbfCtQ&oe=69D1049B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vBDpWIfXeIQ7kNvwEQO13L&_nc_oc=AdqQeSxMwdPHj3XldBO8WrCamw90Ig3eLJXhwEmCFTgwh0GlJgEBAud78GFdoHfG76c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3tWhk17VI80xKx7R0hDFKWXlRYC07EqI9-KQCgDYUDA&oe=69D12259"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPUEdZ5jl9kQ7kNvwHIl-Y5&_nc_oc=AdoKnNiuG_D1jXyrfI0qj41Fj5CCs8xwlfhLUICeOI0CMlPOE62cFx_GPZQqPIqlA2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgCSncwvJDxt1NSKNLnlXGz7fJ0kQMeQF9RW2eVJFSFQ&oe=69D0F90D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXn-lOUEWNoQ7kNvwEgKbnS&_nc_oc=Adr4C2erPyp-TR6rzuuGf-uapq7cHv5u-vfNG6-8EgtKvs8XN--hvPyqj2_8Ki_iKs4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytYvO1KNc-4TTIk-4T1hL8Yp6Mc7oKXaR4g0jn6DFv4A&oe=69D101D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EB07TxSkA8Q7kNvwHTYm6U&_nc_oc=AdrzpRTnS2vYS94BbebOoQ74Rqkw21Jas14DM2To2nr-idD4G5adaiIsg6xt5DKD51s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7GWfK_50AZ76C_4SVTj1xXDQ0-kDXEPw6lAcNI3VD3g&oe=69D10D16"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_website_url": null, "website_url": "https://latencyvoidvr.wixsite.com/latency-void", "category": null, "comfort_rating": "COMFORTAB
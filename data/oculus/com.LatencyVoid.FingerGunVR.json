18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SEY37L5O64Q7kNvwHbidyB&_nc_oc=Adp_v9vX6N-lnBlUqhJAw0Jc3CLRztVqtlud6WQgSc7LBgU46wngjcLWLaRzLYGMKso&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qcT4rVWRYRzhgNd2tnIhzTqdE0Ja8kH-YRd4Iw-Hx6g&oe=6A32939B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INT4LNv1VxMQ7kNvwFv5RyZ&_nc_oc=AdqJE4NXneghAd6ZehWCYk3vCVMAV9Ktkyxt0Xvb3qFLYaTSwKuwMH0SbDKmHy7WYec&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LSitZX9bT0LysvuyeyCFoicE0sxVtutnsZbpPbvsW1g&oe=6A32B159"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6aQlG5U6y4Q7kNvwGx0prv&_nc_oc=Adqvon6j73St8BoRUFtIzmkEkScM0-jji-o4A5APyHBZ5tBrXa9FHxlvLut_7LKvRPg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zZT84ynp8R5ZI1O9ky-8I0Djp2nUneM99jis2E411Lg&oe=6A32C04D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ea5arHeP5IQ7kNvwGdaFLC&_nc_oc=AdpTc94JAZXwrZqfwH3s6M2efB4zZwBjRUSlqpS_HvlYN9vRnhmxopREwlJmeNEAKb4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_C1zU5lAG6L_nyOmO_cqFm_jVhfkmXwVrD3FK4arCng&oe=6A32C915"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O61Xu4YSwjAQ7kNvwFuRH_w&_nc_oc=Adq6M0BbFbzHFCFONQAey1kzLNKnTDMeCe7JY-uNamRu1N8s_BduJN8v51OXpKHVNJ8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yFAz2JHnYqbGRnd_YpRvq-m0Z0uCJZlVO_M5ULWp_uQ&oe=6A329C16"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
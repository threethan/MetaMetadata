18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XHY46NgNy0Q7kNvwELreDq&_nc_oc=AdptpVDv1OASNrkJLIsUIdaPqHsvQOQPc8scpZ_QcqBqq-4zKACEPtiuht8NJqUuSOY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9GzB1oINI8J3S9akxPwbm32K1cbQXekaxFaY3abrj8Q&oe=6A97361B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKA-IbjA80QQ7kNvwHn6Jww&_nc_oc=AdrphYaUynVwQat50O95pJtENumsq7Je9JPDDUZzfVTz8m8NfUraHeh8QsuJzXzrN4E&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4fFDUUVgAKLe9s09VlX0b0YbjhPV3A1IwD0UXAVCdoA&oe=6A971B99"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qr-4pWU3YMgQ7kNvwGtjcbq&_nc_oc=AdpvTGDz_1oHCZEp1z1bPgbTjv3qGMAhtRM8XNdANjLZulSMMmM9h0GncP89-xHGKTw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzhUgtcN3BuCP6OsuNzZArkaws707A4VPJyi9U_UTgbg&oe=6A972A8D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZPCbhQ9XLgQ7kNvwEyyZ2-&_nc_oc=AdpmSUhmFyVxgyzF2uFz_RG5u_HoyAOPlfZsb5xLNHZOwh9uIWrxyS-CJBtmAbZ41qI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGF4bsKYD-ZKWez6-t_lhh2cS7UJfdoAoS952wh0UMFg&oe=6A973355"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AShCKUkWwDsQ7kNvwGOhiWN&_nc_oc=Adr9iYUwwWYYWEkUSpI9N_58Dd6KKMmhzaFmbefff8Tac4JT4FR67s_2BLKPESb4Els&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcPUi6mFFqO6irfpgWPMwSX36zI2hXsYmU8OTXPwdWxw&oe=6A973E96"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
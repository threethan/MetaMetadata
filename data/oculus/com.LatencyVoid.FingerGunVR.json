18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7IzT0j4sZsQ7kNvwFgtbYM&_nc_oc=Adq_Rm0ebN0AAP0mKeHLfhLUugHdUwXozNJHBP0jSxUO68GpCAmBjsNIgODwK_lXeTk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhV509lhginTs9U4Td0509abmWCac5HzbpqqIOuPsy4A&oe=6AA5461B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpgTZhAYIsEQ7kNvwEm-mCS&_nc_oc=Adp3azs_gfawuy4DC62MbqJwxSVoHz1CENO6hrIAefJdCTifnKNwOOFzXO0OjRczkYU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-eGAaaXWdxLStIS7oFLOAVS6JHSFrQfifTgDm0UmTPg&oe=6AA563D9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb5oCdNsUHQQ7kNvwGaCeY8&_nc_oc=AdoL2wPS4Np5HRtdmi1DRkNq6wmyvz5W3_p1tu0CvW1ukEmKKwKs3ZDCKk13ZwYQTVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7Nzl6eyyrIn7vd5j8AJA2W7-ngqgw-Rd3NLlgm-_bvQ&oe=6AA572CD"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ibRYEyDwGYQ7kNvwE82ltD&_nc_oc=Adon9690FK1oTnCQYvgpVLbOafz8c8FrzhI2K17g4fBNav6etlJDOSgvJPrPHEtitFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHYzpUFQKv9edBgaQIOksVzyXjKNqRowiEit5CwDGdrg&oe=6AA54355"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeZYmSjJTc8Q7kNvwH_r2B7&_nc_oc=AdrCy9GZDgQfwdJgw-evFPtEiefKexMXREkoHhvn6FOYGc2_sT2pIAKWBiyaa35hP_I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbWot7JPiviiomDhF6xAqi4D7LTHWBHkHbfn9RJdcu4Q&oe=6AA54E96"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
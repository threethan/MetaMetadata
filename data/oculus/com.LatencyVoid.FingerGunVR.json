18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3Kq4fQkIF8Q7kNvwEMg9ak&_nc_oc=Adq4Gw49C28YgtglB1dnW7cd1RWLXoSu9yrHSBnlBhrwZToSHgD0pde6cVwH7Pk7r4U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDy2Ds5a4KbWsbp8j4HV3Je8L5_ZLez4Ywq7Jrzi5TzHQ&oe=6A68A11B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7TiOSHA-8IQ7kNvwHSRR1B&_nc_oc=Adq54-6igkq9b3axqnv9E2hDECjmfQmjcP6p1gv5NdUsDsjHm6a0Aun1MGHpoPT-Sz8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8wNqTRFLZq4Cu3xi75ns_UpR7zsTW8GVw0xXQa5Rg8A&oe=6A68BED9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zlfj-to2BPYQ7kNvwHXetPG&_nc_oc=AdoH8NT0naOos_CDw6rOxEqlp_eUgPbp0luh8o8f5ui-IW1ndmjMWGS6y9ZzXX8pL6w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9Jg2KYuCRGT3lxqcKVjDW9DBYGbWTZ8Of25aUrjO1mw&oe=6A68958D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khJx0X1uAJQQ7kNvwHY-MwK&_nc_oc=AdpqoC2pBJUbI_pvTpp8wO82hlp3P98Z2UGzrJIeaeZQOMn1zhUXx09xbZzgU5FBPAQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClhEcACxw0-iduS1grrhC8jqpL5XcFILfSIn6iQQcqUg&oe=6A689E55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pihySJX9gDQQ7kNvwEeXXSz&_nc_oc=AdoLd6cdgKNWnXLUooMmrQ_xGd85_I-_GbnyoDvVHzyyEtO86N0S6FAvwQEHWoonF9o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuOPg5Pp81ADtq2DEoVMbw2eBWUu7dQpfYXoHa9qL24w&oe=6A68A996"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
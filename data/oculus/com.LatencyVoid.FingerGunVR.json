18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8srOxgzFw9AQ7kNvwGhEFV3&_nc_oc=AdpgBxsXDTEvmEKmiJpEGHbq78r9q0JvNPU7fD9MkKH1qXdOjA6q24Vzv40Nl-UYu28&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH1w4xaQrelmciDyPqoo-qdLOuYw0fVu_arS_HkNtN7Q&oe=6A6DE71B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hst3FQ81YJcQ7kNvwE7awwe&_nc_oc=AdrV79hQkv3ZgjYcC53J6_7dpcDRwWnQlGIQajmoOxo-f4ZISOYUSRjLxT22ZUzSj0I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxQ0GDDRkvej7FOsUQ2RA43IyOOdL1wYpIMRcnZjMOsA&oe=6A6E04D9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-cqOVeSFtMQ7kNvwFp0D8T&_nc_oc=Ado53Tco3v092-LEdntUtDabkSk_SKpZiiC7VoBK4O83nSPmHm0dkGsFsWWRI7HssUE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSLHYeEapyFu78IjKAOtkfMJ_uxnRH2RghksGs3TnFJw&oe=6A6DDB8D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBOF-LXfs8kQ7kNvwFSj6hw&_nc_oc=AdpKUgoSF_mHSHADimwXvPrlO4RpFfPaWAZTtxsgfu4u9yKMr0bo-ZzDzgPqPiohxXM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB10fyXQ0iJhfaZEAtkRqIxGSGV5Do63XCEskSjQ0iAvA&oe=6A6DE455"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQt96hshLRgQ7kNvwH65vLd&_nc_oc=AdoRVgTjJT940xlZ21bA1OIc3Ga650Wr4Lr-ca4gQnvD1gn2gH8JcxOxTzPQl8fPEH0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALljrGNVhKlMixGN9UaDdKBb8g2DxfLgiCXsslH24Ukw&oe=6A6DEF96"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
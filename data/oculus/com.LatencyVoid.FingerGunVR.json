18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8hwMjTndnkQ7kNvwF8LR7w&_nc_oc=AdptvcLv6b9fzFDst-4nCZ9d7KrXrTDGEplBZ6Nsx9w4Lae8Rb4t3uNjrMKUm0assFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89JkzDMfw4WzD4filCP0yBM5u8qnyXZKZCGbYHMpGCSw&oe=6A259CDB"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCBgZMUUN_UQ7kNvwHg2SOq&_nc_oc=Adqh_O700sHxk9GBUCI8QoB9R-10U7jOEKw2tkRpRmQgQgJ_ffEvp_tb-C9GqagqFFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9foZLa5IG3bEfwQg7FLKGzFWn8W_xtxBCMtSsaIYXpZQ&oe=6A258259"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pbv4L1kp_a4Q7kNvwF3vZ9g&_nc_oc=AdpJydbYIVxhKRToaLsufhLCiyvKMtBp7KU-rjVB9pd8-5rhOjGktBhUMzFMDb5HcMs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EkAsm1VsRjMgrlN1KsuzyxArCDRVznkY6T3hYfUAvuQ&oe=6A25914D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ve8oPNQsQUEQ7kNvwFB2NpL&_nc_oc=AdoSQTCPAoGgGcIowZUxC2tfJUPhjLaROZ3BZ5sdLcNBnJYbgYMKaH8SVcOl7Jx_tYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UXGi7tG3W4yYLuMdstoiePWDw7ICXrwp6wWmj-0H2yw&oe=6A259A15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joIe6nMh-qQQ7kNvwG2PwAp&_nc_oc=Adp42ftcjqoCcnkCFccowPs6l5Mw6irqKO_Ua_BYlQaJb1XbCyCmVfTsd9GsdwwkwvM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_B4kTRXmHXo7OpoB00O5lk--PmNkGGUhBOcMO8zCdSpw&oe=6A256D16"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
nkujn72C4cVg0ch7OgWlj-UhvEAwnF6xW4o6UiB7Ze6Xas8K_1pyGl2Y0l8p5Sd4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2A7sLFowZ4GGtnBhTbbdUhR6rSHBjV5rjXs1Eq3yyRyg&oe=69F34B9B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uy80S9Z2FgcQ7kNvwG9O1BU&_nc_oc=AdqnzIXWLnlWMKpcZT7g24o0RYz5kQhzYp1j8RsZ_7IqzJGXgPUzpnCpnezRYdEssLo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3kjVYPLwdX1mEXLCxQuebjdYLkbHmJB0Y4Sq1E5NFHLg&oe=69F36959"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83xJUbd6gKcQ7kNvwE7nJBq&_nc_oc=AdrHy_2ITqudIfD_fO9k3GE3xaf4XYXGfzsgaijZL-o5wK3wiOBI_EZL5PV5KjsbkNc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qqMQbmMcb14JB17SSvdFA1dX2I8l79hqsLFODZ5bgRw&oe=69F3400D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7d08h3DqyzsQ7kNvwG8kZqq&_nc_oc=AdpDDHfL-UcJT3IKZxuh8x_iTENgoW8DVvP27Hv3N5L0s-eAbX3o9ttvxzSMUudVQD0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0KaN0aG1Hx2kGvU0gzaAggFFXy-0oka5INgj4rVtNoSg&oe=69F348D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmQ-yJMkhiUQ7kNvwEjTjDU&_nc_oc=Adok7Nyt0EEQV7KbTtPiljVThHPPv9OkMovEyJD7wwsYNh6H57JA05Dck_CtGuOhoIc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03OCWEm4dBh83tDIAlnEG5Tw81kWJl1CLSFEqdN6qTQQ&oe=69F35416"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_website_url": null, "website_url": "https://latencyvoidvr.wixsite.com/latency-void", "category": null, "comfort_rating": "COMFORTAB
n1VtbAH8ffbmHovawzSYr1oeQ6G2CSiDDowpAp-kxRfhnX3z9W9oCRglxkl5DFgU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2p6PjyQvmdf3Opx8Faf0UAG4AEEGR5bhFWW4toaOJc6Q&oe=69E2281B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsr4tPl2pjwQ7kNvwHpynmZ&_nc_oc=AdokFxTKptdRJz9S9xAnaU_4pXx3l-g5QOIHdr0qQjMxLdmRcvGGMdOBY0IpBB8LTNs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FlWg1Aqvtlx5E9ZI_VEUO9txxnqfzLZdJO-osuRIIpQ&oe=69E245D9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t81l3LRT6FoQ7kNvwG-Mfd-&_nc_oc=Adql6cHUtbtxfFpyyk573fG51jONQwClbAte4K_DAz_zW0TvNpej5wHCoLn9QGj3f6g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NQnTfYEC9ptTANbYBqUp9x8YrS6XAFwFKqGfTH45OyQ&oe=69E21C8D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LquBUYzupnMQ7kNvwHa013F&_nc_oc=AdrByUYJhxA4mXvLxciz1P9B5hRU2AAWIQrH16JzrnV5BDe5k7j3QaCDdzV0WBWGEg8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kHSQBRoduMSrV-TiKxX68XHmIRma4Ai7BjCWV3D2m-w&oe=69E22555"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wdxb-JZTbqEQ7kNvwFXGsaH&_nc_oc=AdrZoy8p443AOs52bg0k-_h6lHx8Fk1Bn5pvnZbNqB4QYos-LkwiGtiT6l0ChyJDdeo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ftM_u0QcsxvQmiC9IHcr0nmx43rtc6u-ZGL_WtqCP8w&oe=69E23096"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_website_url": null, "website_url": "https://latencyvoidvr.wixsite.com/latency-void", "category": null, "comfort_rating": "COMFORTAB
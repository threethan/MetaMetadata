18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSA7mgJ6lO0Q7kNvwH1HEJm&_nc_oc=AdocNW2UtKmC5FBz-lQBoyBhpaXmEXgYgSHPiTnBTXO52q_reE7IpYF_7n-fGgEElS0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_AaOwrocr0-VnHErw1nd7qdoWmquUvhPFx00vRsvOYw&oe=6AB1239B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DRJBSts7zMQ7kNvwHji4TZ&_nc_oc=AdojkxrUbVbJcfahNjoBTLRdQSb7s5nA1scgkT2XWTYOWB_8f9CtL6upuCRM0zPHzZc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-gs5aymMQd7K7YNeuWmTILUOsvWZjYd68yUoYr7PUkA&oe=6AB14159"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_d88Q3_yz5IQ7kNvwHMSmRk&_nc_oc=AdotSJOjW8X1vhpmyh0zq--OseJRQKbwJl5gRj9Wo1ORFFnip9rKJPkLLmsXL7yyBZU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAyRuzFQ2eAWpg1hTRVQ43_ueF7jaIGwGVMM0leeC3wg&oe=6AB1504D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mzoZAFP_EkQ7kNvwGQtr32&_nc_oc=Ado141C1wmdnI2ku9zyxLXrB0U2UhF7-jGI0w2YLADvnMRdRUgkQeqZYrmt5U2VvDJ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWJxRr7H0kk0ghHDUy4ufiq9Hxk5kT5Rli56ZYg1yUwQ&oe=6AB15915"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPvKa1-0cQQQ7kNvwENtwYw&_nc_oc=Ador0nYtfRMBk_d_rggHziI1XT45H8vVcc0ScKrQg07JLDv6VVTwV5o6-QaQzT1ZO-E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkUrQscF8VCtXdhXEXFl89BlTQL2aYlg4dW30oGUK1mQ&oe=6AB12C16"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
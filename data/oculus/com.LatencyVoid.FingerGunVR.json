18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnVrB-zMdisQ7kNvwHDPO3u&_nc_oc=AdrfqEBJTdUBhCEWBypAQYhx35K2hWGtJMu-j5PSWem15SHCargr_nT3bAykV7I9Ow4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af899CkFYwV3mHJcVBZ0PYgqSe0SWYrUMzvN83UC5nkw5Q&oe=6A2BFC1B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iuprg-2FNG4Q7kNvwGPo9GC&_nc_oc=Adovq_MBvBa1e_VGLYJ-JMoQ6aoz00H_FZKG-DR_STTeijSkVMkgZAx5NjAdaeP8os8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-Zsqg8N-YY40vDN8Vo02igaOgTdXHTZxhtQUK9y6A0g&oe=6A2C19D9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5dML5-qxhAQ7kNvwGhmecL&_nc_oc=Adq2Et6fKuCugCvqx-jaaxPQEnL4VpOYHGYGeQsLUawNd_Ok3kdMRx2iaWbHo-Yin2g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bbdeVMWHKxo2x11jEFJg7W8a1zJcfh5_xAolVVWHIEw&oe=6A2C28CD"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_Vt2KckAA0Q7kNvwE8Kd8f&_nc_oc=AdpRk3nOW2p3wwzfpbl-v9NbDHkOkgUICbcM86qkhhEnX-x_vdflkME3eY7xQSu3wK4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-67K-hs3o8DpLcWZaxpc_iXUrnye_NUu8lndFd_j0QvQ&oe=6A2C3195"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmWe14u9i4AQ7kNvwHLYu1R&_nc_oc=AdruLxezPUrjjIf2QNAy8WoZxjbqP606pjdWFvKpAU7mXLiRkGKcmw8b48d-jIY-VSE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XI7UqvAHUvRlXQrSrnovsXSpxihSwjUdo0jSUCu2AxQ&oe=6A2C0496"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
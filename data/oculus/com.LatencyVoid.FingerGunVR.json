18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AN0Uy0zXBocQ7kNvwEAEeU4&_nc_oc=AdpYhPkT4UTGcZkkYTJTABKGroZFjCRd1E_3CgfUPce6glHg5YIJnuGIYPV7JrLQJ9o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IidMIdO-C84JkkiU1RFc1EF8dyNcUVlVFoGeBbzRc3g&oe=6A01CC1B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enHXTg-48rcQ7kNvwHnghIV&_nc_oc=AdqOpckVwRFj6fitLN2uwe_YZzS41_Rq4ChVeNCeym1c4QYo5DWl5cF7NiDx-YLcJa8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xeO6Ow9KfposVuzsyP-EpOa9Zv325S44a3yBUaIe7SQ&oe=6A01E9D9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sd_T0bechP4Q7kNvwEZQswj&_nc_oc=AdrRqPlXQb1coUyHdYUxQ6AkOwWfQ-NnakisOw7RJciW3hfKnmZiiT3Cp-O9PPLtH7g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tn5Nq4y9Ei3_bwjLzHwTglkD77uDJNPks5xSjUrY-EA&oe=6A01F8CD"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmsYJqvxk9AQ7kNvwG0STFS&_nc_oc=AdpNo8VUVjobdjshN_QrytpTrWZJeMCOt5AgUDhylMXAab2nddvTERf_XtB7gviVlHo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sV-2Gay8s-Wta7h9fCZpDEgJ37A-YiPbPrPPZzQsvRg&oe=6A01C955"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tT5IEO-8GY4Q7kNvwEVgUtI&_nc_oc=AdqYDJJ-7UvnuozT74rNWYKkDsC8ilbluRMHEZqXIva8spakErQL-3yCrBa12xNwVmY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JZcZKOhuy6U--Su-qowqJGMBCcKAip4jNq3cZPeo2Og&oe=6A01D496"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
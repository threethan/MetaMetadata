18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-X4IXFoWL8Q7kNvwG4t5ux&_nc_oc=AdpXAYl7e6_ABUSDER2ncZ7nMLn5j3JZoDYW35Opn_omNGdGr82cyA3wXSiERAl3G-U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTv0wsokuXq3XWxHfGgTOvarPRd2MiCPfn4XMJ7iz2hQ&oe=6A5E151B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neXaSkSXyHcQ7kNvwHQ7fg3&_nc_oc=AdoHhP0KxjtYULbfjpdp05y9MdHLjHme4U-Xf83b0d9kv_HzATBTqlTgIAjp8QVVgI8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyMw_EutNr8EnUMuDL-uKmZGrE4rmwPOwgDs5isVhNfQ&oe=6A5E32D9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFI48ihUKlcQ7kNvwHikdw9&_nc_oc=AdpzP0qekQ9mXgNg49iLj_oMQg2MYd75fC7FvhYgQLiPbgWGn-6Pwk9YevQB9NHwawM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChFbEaxfaTuT0uU8nFWcb0Z5NeiEJBbfW4zS3wyhsvjA&oe=6A5E098D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8J4-dYzAO0Q7kNvwEOm2sS&_nc_oc=AdoFWaOSS3aOXGhsrN_4ZrGGdLbUSGjuSiLVNEUSqbJqDvFCdSy4pQYBIvm6UGc61Mo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATFWo2mMHrolt6KCt3789_CAN4bCVBq0l4IgKoYYVJNg&oe=6A5E1255"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUI1qetlwRUQ7kNvwHtVKdr&_nc_oc=AdrACct8YHHarj_g0o6Nlj3CiNzmWVmBkzwr4pLc1NAPR6NNOBc17dTKCJtMdYf3tQ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGlqHD3wfWAbPKlTvzH1OnXdf3REdNbky0kFA_v0EZkg&oe=6A5E1D96"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
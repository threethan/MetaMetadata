18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIO6vpqPydkQ7kNvwHDsUo2&_nc_oc=AdpG4UrrWrVhodvu0WJ4ro3cEKdvNlBS0xQou-zKwj97OdRplV6hSp092TotOh352hI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8T6CmerDrUS_x-nSw2iq5hUC9NRdmMzKMUuHKQz9fmw&oe=6ABFDC5B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSaIUvb14lAQ7kNvwFUU1fw&_nc_oc=AdqMu0HzGJ4JNkFiGXFh0HpZlui9lAcs2g8j3Tr8Hkc9JAOkznBw8gkVOlrez7UAjPI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOExKOy_LuOVln-IsqfJnsVtJSk5oTxaBW2jhlZI969vw&oe=6ABFC1D9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrA3GEWsUJsQ7kNvwG5j0nr&_nc_oc=Adrh5VU6MQbAhem-SPGopLKHMBtoId7n9ZRgIdq_Eb7PjJuIid_QAMTUoUWZvY6Hzzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM6jUIX6LvldTx6pCV7GXE5FC-PIsESULj9vgVxcMXvw&oe=6ABFD0CD"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3CGuw3l_yoQ7kNvwGY0Bc3&_nc_oc=AdqZys20obufYRM_EA8lTQv2nfQg78fXzQBcoeRK1RUlbp26CNgxMM4fDiWrTzvsEvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNt08w6dwW-hV9r93HUgaxzbUbG3Qeahxav7o758Lw0eA&oe=6ABFD995"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzm59gAVjQ4Q7kNvwHy8gR2&_nc_oc=Adp0xk6Ghcqjh5-uD3oiBaMB0-3uO04gy2Tk3nom3cW5pVjKBSFr75--hJJ4ml0Xc5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaDX0PuGJ1UrpRTEKdH_92hjIj_LA_dGUAIF00NdlJ4w&oe=6ABFAC96"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
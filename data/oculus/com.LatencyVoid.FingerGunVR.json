18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYjbB5lKymgQ7kNvwFNKLvD&_nc_oc=AdoS1uLz1fOh9AE2HtqBtmpkAhm3SJ57lH90U7Fq8GsLO2CMow5sbZhy7aqQBzwfrpE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4IafZ6LU6EOOEpiyr7Zrsc5Mgtdx6-UFuw5ge3Duv1w&oe=6ACE5CDB"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZgYwmlgSycQ7kNvwHIs-qW&_nc_oc=Adq3FMy4oHfP9CWwnHvjhmyoNzFbeHLGScNgO5A6_2k9p7Tp611OXqcCuIaxmaUvjOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMC3NZjxeLRdgzX3I4tTabcbXgmQBkEQ53Ddchx0X0snw&oe=6ACE4259"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjzURKvXzH0Q7kNvwHJIKP-&_nc_oc=AdopCz_ey5a_vBCwlAq04hZi2WTj_efetI2RZ8m7wQO3Gqoh_HpTnXiOeZ3V7-Pq6_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObuLkHZ4-0Y5X9Q8FEesaWVkxDX8So7eEx3JjqR6tTDQ&oe=6ACE514D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEMC3kTbFp8Q7kNvwFObR8Z&_nc_oc=Adq7nZxfvUESm9r3drSZomVcXAVhvG_9iXHrAck4YyBDz8c2zGDhYrmb97vHOgEdrQo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTQqUcSCbuyFwqdFCB5zAAMnecl_zC9pQ8r-aIsBFt8A&oe=6ACE5A15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mq7KACLovpwQ7kNvwEvN99u&_nc_oc=Adpf-fI8EAMONmpCSU8MuS-Xb3Hlip9-U704Xeqralfucog9XicDfPksWIAzJzZkob8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7ELTcklzCRT2RhcOyW9gSDhw_0NKjwOrJWJoiYMdjJQ&oe=6ACE6556"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Q0tuFujRIYQ7kNvwG1WeYu&_nc_oc=AdoFqTjgYPJvTgVq9qntrUQfuVAH75hG4S2teX4TRyB6QEeHr0Hs2ZXCI5VtWzyYhpo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVtftmw7AY3ZzX91nTkt05aHvrqTESoBtm3TBgPfnsIQ&oe=6AABDD9B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZ-IsLxkkAoQ7kNvwGGVkpd&_nc_oc=Adq2ZBhYqkOENIBMsv9ILdT4QYvGr86CNl22WWCq6xzTIXGEtccRjGw1-y-7rlvj2Js&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkYS7sx0XVC_6Yj9xHA0NxEwdUl9osNjvrXPrABClfrQ&oe=6AABFB59"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dSNvMN8kXYQ7kNvwHnUWuo&_nc_oc=AdpyPVE3-tlm65WakAHjItBDXZ60GITBmSvkX7qIxPfiAWVfkaCOKQ3yKFAXc927BHo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVxUCBEkW6_J8aAlUdJ3PkkLCYjX5_dVZOvIxtpjFBPA&oe=6AAC0A4D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edr6cW8e4tYQ7kNvwGTAFF0&_nc_oc=AdrU5qBOFmoHrIMdzHoe0urD8ffJM_rOgmvjRKwC3XB1JzsO7NXJppvkUghjSPbRz98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK__IoUocN9DlT_VycOJv7i1EN0I5RpsZO_7W58yeUgvg&oe=6AABDAD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvlchXzvuLsQ7kNvwEVifJV&_nc_oc=AdpZ44DhNX24IyykIkd4AUsvJqd5rT0ZBHkggqfVpCLTg64Gt0T_BhaVCwvHEMgONDI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6_tqF2MhCBzaSdAeqU22cmAfLoY08Ce1SZDdMXeCTMA&oe=6AABE616"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
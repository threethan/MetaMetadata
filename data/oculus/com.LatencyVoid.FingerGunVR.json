18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nlm1yGQO5z4Q7kNvwF1XZB1&_nc_oc=AdqwBBtlfsmWiTbXcOzI3uHhRu2M9rBISw-VJN5WMovzBNm98eRulY8jtGLbbhTrlTQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGbIgzaM1fg6VMw519xaiHzRs4Y8gUxZEMidD5LQIoog&oe=6AC916DB"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHhDSEKNeaoQ7kNvwHJBDUo&_nc_oc=AdpCno0GEIU0ixRu1uF62aZcUneASHqCbxlqeKpTGYyxrNieD_QsnMVB2ImZRe65jNE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjhSal2j3BtRoljdLtgSeF4EAYxLojcSkRZOv2ChuAgg&oe=6AC8FC59"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6MADB-GDIcQ7kNvwHR2Tyd&_nc_oc=AdoW-rj2H37tcvsM_RH38zdS26eqyhdnwzB5uvZTgUE1P8T6aR5G0cg5fepD1FddVEU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWH3kc2pSbw3Sh8u2w9kSViHbmG6PPW9DIVTmhlFreaw&oe=6AC90B4D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvsuTi93JKQQ7kNvwHhAFKP&_nc_oc=AdqbOEY129Z4uQ0YbUbsr59hEmM1q8FqBlfDgs5fGo9d93s8ZEvwNKSVK_C3jZ3UHD4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkxtkiBoHqygO7d4MsO4OZ70aOHImWsVh8QnY62UNGOA&oe=6AC91415"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uqw-QCa0fgkQ7kNvwEArisr&_nc_oc=Adr7YQpimvCaDMhcyRSy8Pnq0TV_Tv5qvMXxIeg_THcFmNGRB1S39LSZScVAq6aqxy8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiQSyyJt3UPfL9bY0TSJsDkBNUY7uD3yrO8-jYQ6XqpQ&oe=6AC8E716"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
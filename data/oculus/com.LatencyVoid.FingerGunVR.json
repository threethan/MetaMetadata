18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMMqTAnGVLIQ7kNvwHdEbJQ&_nc_oc=AdrD-SHy3mKLBRBrbebNbd9CSvB2-aMVDgPSvfJg5ZwTbTDsC9XRutQ8VGREZgNlQcs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH47TMF2hXbd5ZQGhDOQPOJPBpgNI3AaSLMAcwHi05s5Q&oe=6A7F0A9B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nl08Dty3R0oQ7kNvwFURIvs&_nc_oc=AdrPpm0oSo7Oo0wJUq1JYUG1GD9lluBPgA8XwF8ebZhEsg_tD8aH64EqG9ng12zmfdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-qyZUH9lEflsLSrOMBtiAARsdX0-bw0Zk1S7nxR3mPQ&oe=6A7EF019"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iz5Mp6U1BfEQ7kNvwG1549Y&_nc_oc=AdqNwSkIM8V8i5YkHD1i_lLa8nbFz_cdfnTp4kOqqQHwF5WL1rvIoU7mTwlMlX8MvNM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwSnd23ByX7AYbaPci4n65--Kz7AMEo_gzNkKgsqqoDQ&oe=6A7EFF0D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfxzCZ16D5cQ7kNvwHY6NAc&_nc_oc=AdqYT8hh1ryyb2p29yuRHecpvQ3plfrUbrAUifqdGGLI7BmBEQZW1WvxS2ubEbe-H5A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjRdUDSU2xGhWoPVdbS5RwO36MrF7d5Xx_SJxptk7wzw&oe=6A7F07D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyrpkIrljtAQ7kNvwEtmMJV&_nc_oc=AdrTPi5uDPv1Ny6ThSDr84dEQiZLw4iCg8_NLXt0XEgDoV3dVpuQ2kL0QlfBxbfnuY8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNTBdIJYpsAj-cr3ik__cZ-UMVG1ioDp3Ox3XIdagWdA&oe=6A7F1316"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
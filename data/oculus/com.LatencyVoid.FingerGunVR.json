18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-X4IXFoWL8Q7kNvwGmy4rC&_nc_oc=AdrZN3OQp2Hjejxk4NoRaUfBTgNPhKRMz76z9tro1z2gx9NIzScZFwXb4dE3rGS4sIU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdWNcWvX5bEmOBgxwSiF8cLa4thYhvf_lSman9SMyG3w&oe=6A5F669B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neXaSkSXyHcQ7kNvwGFFVvv&_nc_oc=AdqUIDF6-e-F75-pHun_a1wTf5rfs-m_ZFe1zRhXcQDfpNinSEobFqv7PeQCobR7XIU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3RnJnQS8gzP01SJi7ES9OEEfunwMKohmXI49YE0kwqA&oe=6A5F8459"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFI48ihUKlcQ7kNvwH38rl7&_nc_oc=Adp7c8wb_lz0NYSqClZ5KppBh5uMrStPWdIHM7t4q5Y8DL1pM4axmfdcYiwyDrfq-UI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpiOOs4Eq5B2T4jV6w2u7AltrHTZ_A2REmj7-_uZa2OQ&oe=6A5F5B0D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8J4-dYzAO0Q7kNvwGoBpNu&_nc_oc=AdpQXQibTQrt4E9_vvlzBRKaSYqHUXkBz_1Mp403jgzOAuUKuQp59-wUT99JVjuGR1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAA3hQG1VKwGQzTCeWpMMQP_mQHA77Mb4rS-T0_5wxyA&oe=6A5F63D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4h7dta5Zw_4Q7kNvwEAb2S3&_nc_oc=Adq_rSRz8N-mHOsEMx4mgd78jpsAm9s1rpU2VBJFVcG-49uRMRVDETkGyimIrM71OyU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxaNQinoUnuf196Obzsg_rqXOIxs9Do7WMNNFRUcfFCg&oe=6A5F6F16"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ra0JhNF-l6IQ7kNvwHndIRe&_nc_oc=AdrpBCbosl5c3clbJbcHcykhJR945rPFx7zZypujETx0WrV7nqgJ7z5r6x92EjP-ZTw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-6_yXTXvjBy1r-U7XYebo7o7YKbZYzb6OAWlYYGO_mg&oe=6AF73B5B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H873CPyatrIQ7kNvwGeNTHG&_nc_oc=Adr7ftyx_d4vzY9ifxU8ws5Qv3czN0kFpdmNOMY4RJiQZlm7yCL3mHXOMGNtobAJxB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-FH9DUGoFdIXzNKmDr4_nLFtOZY5dChnBH0LCIQ01vw&oe=6AF720D9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfR9-Nx9xgYQ7kNvwH97YM6&_nc_oc=AdrJMP9DEQ0sUJP5mCNMKhYmM5ESQpHUPtf1EOCMINRcDKsBR6WjRr86Wf3PPgoVJiQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBB48zdnbulpHmPqt9VFnkWxjRefJx52HvQlUMbfJX5A&oe=6AF72FCD"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xPrptHsnagQ7kNvwG11DlH&_nc_oc=AdoWuUQOkdVtFv0oVgPSiucApvPoaKwy6TgP8XYTzfuhyunqxdrAZLxXEX7veM-D_UM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJYw07v__8cxPhgPelNjRuSCIOo3B3yIlUmOPaTC8Z8g&oe=6AF73895"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7U8F4t288JMQ7kNvwFUPL8v&_nc_oc=Adqmzr1LUH8LoUrW2nAUSXv4qxn8a2mXxwW-S-Ooeuhl8irTILkrtqTKWWeAfFUYcRc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOgcsgDhN6ziCWsEu9M5A9cacPjClKa46PtEoSDs-EwA&oe=6AF743D6"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzbcQrF4kawQ7kNvwGb03JD&_nc_oc=AdrWPaRP9NcOTxnfwZ5ZLbYrx4kPwab7z1hvFjXdKFA4i1HF4Sjkp-CgWerGKujIQoM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENU2ZhSbuPrKzSE-2IhQC-47j2O2l5X4lZLmKJtLjdZg&oe=6A79C49B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwgdLMn4dSgQ7kNvwFyT_zD&_nc_oc=AdpnLsU12nFKP8Cg2opZSZp6W6UJ5hoTjoKxhFoNRwfZNXubPyaEXXx89TXLoG6RuWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYebOOoj-hXXNBvI6sPGBmGYbUYI3heR2mIj2v5OBDkA&oe=6A79E259"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7NeVFJFvjYQ7kNvwG43cjW&_nc_oc=AdpX8iwg8V1Qdosi1BwTEectN3b1_k-cKpwH-M1h-1DEQG9x9EBWHVMSXX5YbrveFYw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl75n8jQV5Ukv8njcKZz_BQ6xJhtysmIRN0Ag1wZu-KQ&oe=6A79B90D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VE5b3dg1RrsQ7kNvwGoplir&_nc_oc=AdoAg9OwEJ8oC9JHbicNAUxUmWg4-nrjP_n-hjlvGVCfHvHTMDdStIEt0u0I99fqbN8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5r144YFechpr6i6w7TL-4aPAsnNgvRD5xXNHsFizpLQ&oe=6A79C1D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oic-4w2-hOoQ7kNvwHcZtWE&_nc_oc=AdoPqw_wlu9ovV-99I8yMyxcStGrJfhW2bLvyIJtY4QlRFYBjGwaRoAnFn8WfD6ka78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgPO4HmVhsM6OoRMaw5PN-7QLvgxkOJssi2mZADE7dcg&oe=6A79CD16"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SepTJA7GSMQ7kNvwGxAFhn&_nc_oc=AdobAlH4umguH9Q3Uik0whe9Es1XX5PlZ56UqAo3fJZFefn8Jyyzc7Le3pJodexrkmU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Fr5P6SBZLAJwyeHK1IAjxDryzrbBMhz-6HJYKGNtA3Q&oe=6A09B51B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28NrZ7rhJyoQ7kNvwGjVqkx&_nc_oc=AdrI7shJKGP3tB2V6IKsDInNKI_OUUoiIo9bZCKUmQYRoveGsf0zHcTVx-YajHeWWU8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7f_8jf9s4Zm5OjwbwbcNgBb8skXQRXEMTOLJLHGUiAqA&oe=6A09D2D9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdYY3THWeVQQ7kNvwGKJsIA&_nc_oc=AdpK0VOylG3V2TD5j1R4afq3RuU67GJCK4PwBwWAv3puofEDOA6ZIRC4WybyyVqeKrU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4caMxtE9z2VfMXOFTxt5hL0kxtEIA92WWWmdeH8PIrkQ&oe=6A09E1CD"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y87auhiXKIgQ7kNvwHkibkO&_nc_oc=Adp000DDfM5V8_BvVwTdB4AAqIGixJRebFzm8iylT2xGDedntvXKVGGoWp4GW0OVN_0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P9W5rwEbKnXZGVE47lIKWEhVyVYfR9AOR7uXbfz3sMw&oe=6A09B255"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igGq6ToQIfEQ7kNvwFMO6Ya&_nc_oc=AdpVm8ad7A1XbHzvvBX9KODEOQipNxvFpuSAHEUwv5MM8U7zxvDdFeYWOI-16EalBf8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62VI1Rt_Db58l5odBrMxHHaHmJXQieqSPz9iRzoYBltA&oe=6A09BD96"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
wA_FCC2gPOmz3uHqBW59_d0gJAwvKqHr7Q6sz4rhfVSLYamA3prYpJX44BXd_K3Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJAReJNBKrDtkTtA6Fg2RANkE2Nhfukg_cTxMVaVBBJg&oe=6A95E49B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXY-XYPwxdcQ7kNvwFTYBPr&_nc_oc=AdrH-8XTkKNV5wiG8SDtVmzyccReTMmX3dBZ6XMoXJmycsd-RsfoGzti5JhyxQdAYk4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBoGsyNYXehTzg0OninVm1zs42nKYMG2X1OlR_Qz-gmw&oe=6A95CA19"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qr-4pWU3YMgQ7kNvwFx9mh-&_nc_oc=AdoeRUKu8TVsIbmnEj76bLBvJhFd71rA9og9HPLlwQs1kNQ2dnqkWAfaV29naJofI6U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRxny1TFyRtvpF6c1ZI_Tkoq4yiB_87-HbN1GHBShEEA&oe=6A95D90D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZPCbhQ9XLgQ7kNvwHxMKio&_nc_oc=AdoXUQ8R08_7bxF8eTaJrBLC-KVdL_04xVUFTqriInJ3cwVuLDJTQCe4QPLPQ9wno8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5b24bn7YZ_cF9WlLuHKfe0OE63-jjtEkcAOaapDglMA&oe=6A95E1D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClmCXDX1zmMQ7kNvwEE_wKh&_nc_oc=AdrsvwFnvEHNeGg22zYohNTwhsfaB46FHjjdKoL3dhV8ttQ7jk96Ko0eqsxuHG8RcLQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ0HEo6O3ocAaxK2MmXAncWa1LmF-mTdU_zJug_CnPug&oe=6A95B4D6"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_website_url": null, "website_url": "https://latencyvoidvr.wixsite.com/latency-void", "category": null, "comfort_rating": "COMFORTAB
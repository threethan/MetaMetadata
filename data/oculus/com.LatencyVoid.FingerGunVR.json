CBXlHynt7bVezD82hArrkwBiGU1iArTwgBZ8n3d6A2v6D8fheAfhYi7WeBBt0eWU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0xOjWHMIX-4mxqCJRvaP83-Qv5SxtoLzuxgVyhE8xkgg&oe=69F49D1B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uy80S9Z2FgcQ7kNvwGkAgQC&_nc_oc=AdqqfCzbvumRuJnZTPI2ey3_v6bFYtgddldCR9sjDoNKQgqccvcr9MshTwxlq6_vPNs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tE-VONWc3pCRENAvgAvYqqEo6BfOstJ2iNHvAVFmw7Q&oe=69F4BAD9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83xJUbd6gKcQ7kNvwEta6Zv&_nc_oc=AdofPAjwjiUj-WLaw4ZjZ7NWuDvx0iW5uK4R-cVk2Z34GTZSnnnZvK2P2xoM8yXjD0o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2u7wqtlrq7ACBuV8X26AUFPhI-Dw-Xf2xIv8g0Q9hsPA&oe=69F4C9CD"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7d08h3DqyzsQ7kNvwEBd6MQ&_nc_oc=AdqZn_-3SIvdrQeZsndsJmUjC2a97lIFCrSSPgXEwwb53n78dE5X4VkgNwweL9Mmj_Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1uXAqCcNNLrdSQMAx_bxQwZHldKR5SrhftlTcmdDbMIg&oe=69F49A55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBrF-o6YnnAQ7kNvwEnI5im&_nc_oc=AdqLe93WMeAflF7Q-rBrY2ni2SZCZyhHZKyh_F1hc24M8gbKBO1ceP2OlSCFdvHimsw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1YFXo3t3vL00zv4RU3659cdPZOUQqXiMPIGmEYBcbSoQ&oe=69F4A596"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_website_url": null, "website_url": "https://latencyvoidvr.wixsite.com/latency-void", "category": null, "comfort_rating": "COMFORTAB
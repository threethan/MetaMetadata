18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iha9RcpaLMQ7kNvwHvBaRB&_nc_oc=AdqQ_o7jLVwTHCyI6ZNWkN1UJZVdhwe9RCRUiEhWMi6483r0m_Nz873wZtdcLWOYx6I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xmA1HL8fZxkP2TOUXSPW3Pb6LoT0aBPSV9uFNiXDTPw&oe=6A104C9B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FufqbMN2oIQ7kNvwF25QJu&_nc_oc=AdrYRdkQRMa3GmadOJlEG5xii0rXhdomZ8Zb8W_KfOxVNDN9o0zNhO7OTDct5g-_Q3s&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_Z1eaNEkw8cLN9kTnrFDyLJUkqjey5pcHbkD--F5ykA&oe=6A106A59"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWvGxbEfVgwQ7kNvwH9oSL3&_nc_oc=AdobF8VPsO0CoP9nwvvPdUy9XxY8bVM-YdjiL8JdqnYNrpPHMx-fAYEa61s_XsvtD3Q&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59OECQbHG_eu6ia97AD8vT6CnhiPoKIUStDp7QRawhfQ&oe=6A10794D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gt3hy_PbvToQ7kNvwFkR6R1&_nc_oc=AdqVTpfQcbIWyoSi9UPhrjPmk_6R1HCKnT3hm8L_-s0GGKHZ2a9u2q0A50Wma80xo3Y&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cA6IUBaEUhWioM2a0FyDs0jZNcnvlgPxN3lenoSPIvw&oe=6A1049D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXzaQsxdqAEQ7kNvwFNz2Cb&_nc_oc=Adrm8m3-44fsnloYeMErHppQL9KQIul0k4UUhbU-OUdL72hXAovoE2BnIIJGP3GWqU0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_rYy3p1kH4oiaqNgJB36fJZ4OuTl0O4QnUfYWKb8gcg&oe=6A105516"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
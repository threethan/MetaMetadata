18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mH8Ap2cP-eUQ7kNvwHV3xNG&_nc_oc=Adp6i1vaaEa_ghKJh2Ub4ZBZR-Pm_BgkKnTcZ0Jfl2hbAGHmobVyDH2-jvNvpSrEuSI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cq-k0rq2s-hrhcrknGxSJRnKVaSLmcFRCPnmiTw5hfg&oe=6A45089B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVl-OKZiyEsQ7kNvwEwsi8n&_nc_oc=Adq1XnMwZZ8aYG9622RjFC9Rl8-ylQMBunmjTXI3vtjdRqg5cjit6G1bUfkwZ7Gc8UU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gBoNJ_2YvVthRe4rloNs7xqp1VHPze0PpbgTBzvoWnw&oe=6A452659"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvZKsgQEJHMQ7kNvwF0CFZo&_nc_oc=AdrKOYb53i39nJ-rHJWdZL0p1adf4tnHcMQhTkxkTRw-xqof20DSo07SNGf3htBAh60&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tirdBLe3gXmrRfh3JAo3smoB9F3vg1XpFPfxIv3VrQQ&oe=6A45354D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr4YebRlDDAQ7kNvwFSYIvP&_nc_oc=AdrCH2duQg6UI6TqMC1NT6T0DbjUNgNiJs4sIiB7-dr1g16GibX5_iZSlc4Lr9jAjrM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XXZu9KGXye3-jNTQmry4yhIeHFAb7QT1j2zIUk72HSg&oe=6A4505D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neSlWlU_08kQ7kNvwEij_rx&_nc_oc=AdppbNFw_yzrAo9y0FwfYaAaIdlyzO1aqh8tKiBa-b2YkbYCOv1_Sjy6sG9fPAkKT1M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-J1xfHIgSF-kXtzraXskzaPLRniinfASJuHIScSkOVFQ&oe=6A451116"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
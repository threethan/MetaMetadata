18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnVrB-zMdisQ7kNvwGbjWSn&_nc_oc=Adrgjc0ikj3aAXpdtYmJXdYWam9ZayEiToV493Rj_ojyu0nUoT4v8eihXEbkKgYsfvg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o9kmfkCCEH3d_tlIy-8uWg4cpwK1Ce0JhJMVjL4S2_Q&oe=6A2D4D9B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neAeFwIkuJoQ7kNvwETMxot&_nc_oc=Ado7_-Rtp0jjlHA4aTobKWkDJ4JzI1n6NUFAgTqSrv9h1hfLvilvPQoB4Z1VM2TR_-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DiIKF46OwT2mGTn9VUdSnIJRVoTyxgYxeisn7E5dZDw&oe=6A2D6B59"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3e5GANjk_KkQ7kNvwEcyFt1&_nc_oc=Adp5F_HZRDWR5fRWhwnTWvLPmVmhB3UQTfbFXQ1S9AN2CVVM67G5lw5EmQqtddKH1ag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w1UBRQH3aVUYEED4_r4_EIlYwaduxMmfPHBYgQCNOVw&oe=6A2D7A4D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_Vt2KckAA0Q7kNvwFQiLVv&_nc_oc=AdpmYRjj8evlKbAFt0PLDX2aKVkHrji9FaKw24hU5wgrIYaPCiWV825J7ou83IxO2L4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8efGUj9tqvzzbuQ5tVrwQaIJrcH6pIIrf9tQLjqute8Q&oe=6A2D4AD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmWe14u9i4AQ7kNvwH7dVYe&_nc_oc=AdqUplLHRQr8dScK4a32Xn29BbLbmn6IozbU7kDzEn5W1VnqVEozzvdYLV8ohOsrePI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qV4JGbrxzYfA1gH6U0rW1q5hemXQbyY2Dxf8vKd5UYA&oe=6A2D5616"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
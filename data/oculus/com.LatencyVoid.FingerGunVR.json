18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y8drPzL7RQQ7kNvwE3RmIQ&_nc_oc=AdrfUbW1XjyqnWFC1zqLVwEsk1QPXQDz-doqA3Wa75kqtYhyEbfDZiYZTfxnmaOw-uQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKowbcD9nR5ZerxIhHYWXm32n1mfI7F52mqxw-MlRPIlw&oe=6A9AF25B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKA-IbjA80QQ7kNvwGk2ATN&_nc_oc=AdoJa9dMFDMgQDWb16wy6uM0Hp6y-EoQIT8e1_Of0rubc65t4RpAkjQaa6BfUaqW8tE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKansLmMIr_bFATbky37gRVRbq5jc_0rDN9GQf7XvMmlw&oe=6A9AD7D9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPzqUbDb12gQ7kNvwG6JnbD&_nc_oc=Adoo57UKx4nXVTOyf-x1L_FTWMrsaJR_7pYtDX_CtVgOfFqSksjWbzGKHiu4agw3HFw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAei-b3-fgRAEocwwoSicz_1Iq-twioOZ8jJ168TUc2w&oe=6A9AE6CD"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmAntq0SSakQ7kNvwESsKIo&_nc_oc=AdqPn1SfJbM7xk5EIy-S39syUhToSF6BcC6AY8HigkgX-Lx_ffE4lR3KktkLk20MY1w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa90mKaHwzAKYUR4HPq_6hpEFPDAnVe77Wrwk5oJck4A&oe=6A9AEF95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jQ1CdTI3m8Q7kNvwGsq8Rt&_nc_oc=AdoJh_HMM_fdnONzfrrAN-1yNbBFJxgNomPTSDmHPd9-JSTO6orusuZzd6hcxU4irYo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn8T7zoilGp1amExoFVwDs0hPrnQKq690FaI_ZbrXfQg&oe=6A9AC296"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
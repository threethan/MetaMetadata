1855.png", "id": "828904013473183", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BP8zLdlKhb4Q7kNvwH9WlCl&_nc_oc=AdnLP2rgQecKvN9uR9vOcB17SCgLHFj3rCv09MNS9DuAz31XBn53DuxEbx0VjI8H5w8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsjL_lzPdhHfVttpd4F5Orp73vmCo7Cv4miH5nrh6Zrow&oe=69A05AD9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWBJhER14PcQ7kNvwGJ64K_&_nc_oc=Adn1MP3G5EaMXLbEXtVf413Oao7jnMp38i93JNrVYmkBrXjFyxoYNuv__-OWn0SyjvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsSic_Tq-vkn4Ss-YWgrT01tgrtVPYKLtkmjDEmZmVB2Q&oe=69A0318D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKDVZzER8fEQ7kNvwHdyqyV&_nc_oc=AdmCcgHKYVZTmY_qBotPozEmHdnLaHvZ0wXej4mJOCMt5mJ60npGdiBaQRl4mtWGXvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftth1p9S3wcyB75y3qCzMHX3MlTtZO5tanoE10TlUQx4w&oe=69A03A55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruk7z5Bty3gQ7kNvwFqYZIi&_nc_oc=Adm9Y0dBcLUnersKnRz3-Od4tMLJuB-ITbgZHUvOmu9slt5-apbxbbI8pBtioZ67DfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu4UfNym0pIWIlQiB4FjON4kYpFIc9rfRUaIQyMvDe4Ug&oe=69A04596"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_website_url": null, "website_url": "https://latencyvoidvr.wixsite.com/latency-void", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in
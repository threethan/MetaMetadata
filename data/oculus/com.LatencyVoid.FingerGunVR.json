18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYaF2AhJLhEQ7kNvwEl2rLv&_nc_oc=AdqCyppq_3IGBAT_aQTrn9XLNbxs0kqLmDvxN6FyF-aT5N2nR301NC_sECVSNsbxREU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvY96k0_61zTf8IHZZb6-FNGq_dWpiOgx1PJYSa9t4Tw&oe=6A9EAE9B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amQQwgEknx4Q7kNvwE2bVfF&_nc_oc=Adrg4GuWDHNFq4ewVTN4ZyqUQX0GkxPMDRxYdyMcbxvI6nMgh2FKi7dxvcWmaXGvO0Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKivNNnsuCey-zekL1ob6UfKAo5pVuORbGv2kJYrKRbRg&oe=6A9ECC59"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyqfwDIo45YQ7kNvwENs9ow&_nc_oc=AdqStuVir7eg_pQuhZjZFX2LJCFfrotBvsfvAWknFa6XLfAFtb1x9SU53k4vgXGKXv4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImrjR1V0HjyNA7jf7HwixOR5IONfc-7k3KhPEUhl33Wg&oe=6A9EDB4D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLfTb3iWtMkQ7kNvwGvOrsG&_nc_oc=Adqt1-xNFuoLSP25DZEVYc-Xgb2d0yFXQ5-wjMEEImQS3dtKxxlc7rZyWHWiOGMBImU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDHaU6Z7vXk2ri5irDc80Q1dpNDEEvyKnWSaGn-M32HA&oe=6A9EABD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Wj3XD9QwoEQ7kNvwEjkX_l&_nc_oc=AdpkFWGJlZ5au_EAl8iCPNJO8FDClEP1qHCLEb49fGolyEgqs7N6MvkJbnxBnFWUFR8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlcD-_5NzGLaX1LqI2TUgd8DzEHC4OxcqMe-L4K_t1hQ&oe=6A9EB716"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
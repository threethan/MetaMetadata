9618515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Q0tuFujRIYQ7kNvwElm5fF&_nc_oc=Adrcmt9pGp5U2gtiS9JFQFgp4QdzOjqofRFk9H5xmBXGsT8XJm91hxYKjbeUqKGzH7E&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJe2Rvjot9YMDM5pB81MxqizaIFaz_JCq6J8FBnxgzLKw&oe=6AA93A9B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dK5c4CxnMdsQ7kNvwH8pzBX&_nc_oc=AdpM0WJESfBGPpn73QKBSdLIkRXdyQYnquPNBllTgfV1roCv_H6OB4B1Tg5SUWLZa80&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKpGcb0XI14u9_oVKNymaGNZHSpfMGHkjE2Zrz56wX5g&oe=6AA95859"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxAvHWPY5Y0Q7kNvwHD8IAV&_nc_oc=AdpSKa05eRK285TxG5iJBIp87GK-VOAMdwvXJB1YTXHK2wIByWF9xf3BgQTa9I_sR_4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWCXEfvEh8NbvwCm2j-7Iydf1sLd1EaUxYXfquFh3y8w&oe=6AA9674D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edr6cW8e4tYQ7kNvwEXJDOS&_nc_oc=Adq6UGgWou4BXw_MH_GrIRKItOxVBJ2_inbGFpkZimEJNSzG54aJWv22AyV8tyxm54c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKm09Mi84dW-kU0WnXOJPbcqHKdcI_LLm_omyBK7ejOFA&oe=6AA937D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoSbPgzE5G4Q7kNvwH3avv8&_nc_oc=Adqtpdvdq3Hw5QixreTlJ6C2-UMVm6K7fXPSiEJ8JzfNLP7HRfbFKy6FNLbKm8JqTtY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIldYeqSv14Td3G7Brrkk2hpyy9AL_nwD7AAMCnRE3yg&oe=6AA94316"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_w
18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdMJTlX4_7oQ7kNvwEUXcbQ&_nc_oc=AdonwCsZAOFlV0hro4TimN2BFOzmF2B3ySMvcyQx_RffbKyRC3UnnroxhkGsGhtAeLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMW1V6w-5Uu_bNmjAm-sjk59-bbeEStea2pjpaHdxDUWQ&oe=6AD2515B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJZNoCvVM9cQ7kNvwHm8lUd&_nc_oc=Adpa71uXHP1nIXoZkhFNeBK7bK90G0MjZI9dQT5mzf6LalkQFdljQ_P7k1ZouE4iqYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHhoFrVDSfCYOVdomVKZcusmsgN5u_uh8k_3EzualFqw&oe=6AD236D9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKP3wRyeeg4Q7kNvwESzyJ4&_nc_oc=Adq8N0o6itVYCrcoHqpWgUKOLSggOdL47WWw8Yt3B7Pfhb7JcNRYwdQt0eCSJsU6NWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv8P8bmyH7t52R4p3c604fVN_MduJWNUMYqsjYjoRSww&oe=6AD245CD"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wB-CkSJADWcQ7kNvwF1s2CE&_nc_oc=AdpbESVf_YRiA1rAbDrMigW1sUnhJLa3t48OXOHMYiukoR-QJ5MXTyr0ue9k6T8Deo4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBHyrHjGZlkBOVw8FeP2_28xhdL35rVdnNY97mDv7VHg&oe=6AD24E95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=752v4rT7a4gQ7kNvwGAobRh&_nc_oc=AdrdK5N5r7DDu6YpyzUiIjqWaDxPLjsLFe3jyQukzPXz-SzpaAKpSpyaAVFtKFqb33Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoD1KvQgmJoWkeeuvp1B0Y3STry8w9Ehmo8PWXGutMcQ&oe=6AD259D6"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
9618515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUkOJ5lDQ8AQ7kNvwHeG3lD&_nc_oc=AdqEYp6yYMBTHy0MCMxO7UPWEzlEpPqSgzuKKjiWunH_EZXFEkUbTwQoeqrj5F8El2s&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3xdejpQnE9ZK4jbDVEhIiwwX49rUQgOkiF7-bAhZkYg&oe=6AAE809B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZ-IsLxkkAoQ7kNvwHwMcBE&_nc_oc=AdrqeGlpfRNtxspRNNmFbF1q31LQqYnZotaeuEfYO_5rJ4KpZb1tMHJ8qURACiswnNA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpDqPavdmQF7apjthwwj9UX6zV37J5ECOl7l3qwVXmvg&oe=6AAE9E59"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dSNvMN8kXYQ7kNvwEUxUw-&_nc_oc=AdrTNjQZSpG_H7rZZbiP1LuiaOQ2RuriieeiBaVzFdlnll4aD6nO22mI7aLPh5Js--M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJJbi4BL7zywg_-n2K5Noj754yf6mRb28KyjyKoNRTBA&oe=6AAEAD4D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RD7g570nqT4Q7kNvwHEKNXj&_nc_oc=Adp2Su877oZztyS50JhWpLLqGDpS31JbW0PggrH0gBIXqvSvp47xyv2Oell0hJPDlt0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpmdwmpr-6sKUs8DDqx0omq6EYVeZm39deoAiiHbqCrw&oe=6AAE7DD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPvKa1-0cQQQ7kNvwGdFln_&_nc_oc=AdoMINACOeKTIym3J8b7uEkqHSRtkhss8dx58AlSwSO3-vvHQDMeP12ig1QAESHuwCA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF0T9O5KNjDV49WH_4yQUyL3BKL_-M2vS0WNOKpKlqAw&oe=6AAE8916"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_w
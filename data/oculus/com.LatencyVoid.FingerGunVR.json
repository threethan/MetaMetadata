18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHbfaBVeZLwQ7kNvwF7ngpd&_nc_oc=AdqOVNQ37g8VW1bvBnj6yMwJeSFRrMf_AKemgvF_7PbBuJ6Vgitc9m9NhSjLmD1AgHM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1SduYc6CazoZtkVvMmeJFsq0Kk03bbAlQIY4gtFHcTg&oe=6AE617DB"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbnSS4voM70Q7kNvwHYXeTy&_nc_oc=AdqvAvNJI-CS0nKaiXfpDAg_v4Ck57H_uonc1vWmR8EBfi3fiaimwuQxzOvhWnacxAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPtcWvCjFUqwJqEr1nYndL7qcO0dMk1QgpclmBni2Geg&oe=6AE5FD59"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQtBLYeEaxQQ7kNvwFJ-9vC&_nc_oc=AdpLmi3yAVN3k5JdSrB4ROPgjWpgpNvTAQDdXPi9CDBJJafcWK3cLrJ9_q4-BBg4A5c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPY54Xfe8uUQ7yuEbk8hC6D6O2FCAZSd9KrOw_oCMQ_zA&oe=6AE60C4D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEIiSNY2xrsQ7kNvwGvQtsI&_nc_oc=Adqo6uQEYgAM8iZXPyFIylnbIUFppjMLXpqne668ytFSf_U5GAG-FtQPjkjuyyREWVw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLGCWZR5swwcZfrLJc6i5kEx6WXBITKpAd8oGbH9KI7Q&oe=6AE61515"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r032740Ha5MQ7kNvwGHjtBq&_nc_oc=AdpQM9AZ17cHzbVNSwbmgZi4AW9fQa6WhGmP31XNwP9ZTFXhz5elVw5uXvOKF4SXuUE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOK0hsDxgKIYd1mV2mWPy-_oZPKzW8MfqQzl8TCBs1ULg&oe=6AE5E816"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
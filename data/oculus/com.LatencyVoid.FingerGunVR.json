18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ra0JhNF-l6IQ7kNvwHEbSxh&_nc_oc=AdpG_49unJBl-Tc4sjGS-0sgrKyrQkxRbsUtGceaPQpRnOJXK0KyBLJXSd93BDnUDS8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP2RkMvFCTuLhjRHtPaY3h7VRfA71V08yBoxSWEQHQhA&oe=6AF4985B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfbihbAE88gQ7kNvwE8vaV2&_nc_oc=Adp1IyoOw6kkjzb7lHZtjJOWqtIUsBE8yZCCbiEty3Fa8JQvG6GtTukDNwefmEwMAzE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3duAoG5a3o-9O9kGLuOJMgun_WdIA7Hv4ps8JsCZGNw&oe=6AF47DD9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubo9J582W7IQ7kNvwGAXmDB&_nc_oc=AdpyqnAitDtQ66I_aNWOEswXwVdJ4tdh8xtftgM_elrutkC4WYy4_7dqNQyHm0D2QcM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUbP899F5ECv_uwPzaFqnDzhTnBn742WCFclELWkwqzQ&oe=6AF48CCD"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xPrptHsnagQ7kNvwGzBdWt&_nc_oc=AdqRX9TKz6iXh5eref1FgkKt-U-bkQhiTcSz0cuF5h3Lcdz4rMxyOxqNeHBmWXRSR58&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf0iMcsgVeZhqjuum9pUSHv8ZE9S0Y0Z20Qw7fQjHkfA&oe=6AF49595"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bIJ-5yhlCwQ7kNvwHf6hHj&_nc_oc=AdqjhUCXlk94ptDxykAlfImttCdfTaHfWiw0Nax_y73owBKlYBZu-kwPlgYbFYnxIN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEDAvTrkRR_9-P4kSlz4DVM9Tk0vtxjuaKiiI7CrUrOg&oe=6AF4A0D6"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
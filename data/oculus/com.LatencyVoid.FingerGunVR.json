18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=462RJ2NmJUoQ7kNvwHfHI-i&_nc_oc=AdrRar9mLTEsZzz00AxMNEklF4Gr7YnzMc9bEgKAI99x0qsSpeEEUe2lqqsHpDkLDow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6Cz4pSUb7WmVugy2gO5Sqh4jlB0aQkUJeM4ghkCS-MQ&oe=6A69F29B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7TiOSHA-8IQ7kNvwGZ6kzr&_nc_oc=Adr4DwsJ3NDn-IzPBTUGCnlrA2VExmjV0iDN3x-mJeXUnCeYeGrFCieUeBI_ouRVZSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqne5x7HYd9KM-cJcht8-yt5h1xQdZpoZRbtwsQQUjng&oe=6A6A1059"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zlfj-to2BPYQ7kNvwFot938&_nc_oc=AdqYavsHk9UlRKtDD05zMT0LBh9QLRzhkN3OSBarnghdS7AH3TvpJAqqq8pDJ6T9ioU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUDX5YTewAFJdoofWJK-jO8FPslmuTl5P_TUUoLxzZDg&oe=6A69E70D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lw66SXkUKIAQ7kNvwESGgQ5&_nc_oc=AdrFeXvATF-lt-91GfU6BNQjChDw8eLb9jhr4AoDJa_mnzqWdRPcfqC7m7SJ9g3i--M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoh6mVJdj-fV-DCVeTTRmX0gcmqIoOrdITSj_JidIctQ&oe=6A69EFD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pihySJX9gDQQ7kNvwE0RP7B&_nc_oc=Ado7divWMQzBpcF1tKu5-LUqCCZpeK3O5wPQQwH0ZYsOJ8AK65ilTh3ilDCAlgkPfgw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnZcIpTx_5il4KVEtSf95jxgpN-LT2L1_yXDbIhW9eOg&oe=6A69FB16"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
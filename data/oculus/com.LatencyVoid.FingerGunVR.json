c_oc=Adqva8lL85X9laHIBmq387-3u6eAaHSYxE9NYPsUtkJBXT-0r--rEtYy0PrILvvQZBA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBTYWoiivDC2a7JjF4Ky6pybHoeKOirx4xM_PDiZv4Eg&oe=6A8EDC9B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Txkga4sB1VsQ7kNvwEMWH8G&_nc_oc=Adq26wOz8vb42E2aHYqGDHDxoiGQEuiHAtSrgxAhO4XA-vX5Yq7md1yRhVHTr0vg4m0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKac5VFn_OVpYYyY7pR-cS2gh_kYFFbGSogisA8Mcauw&oe=6A8EC219"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80gHckyVeAMQ7kNvwFW10r6&_nc_oc=AdrswShb5GNaL2Bp70Um9kvjNSTVJ8kHB4mB57axkSXhp7PrhgIiyRSX3rDGjnBco5c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9tdI6PmEHAJznNqCv5w_KQqlw3pQxNmYEJM0An0l_Hw&oe=6A8ED10D"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FDr3zPP7VMQ7kNvwGFeqgS&_nc_oc=Ado28tcusqfDRf0GnXgMRFrTDPmVfYXb-VqS46gtVnQRCknjp6JSJhyezG3HVWlF9aM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3RgaHmJKNj8UcwI48WchokwFYMI_6diDNIoAfaWvP9w&oe=6A8ED9D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TN0KZ_s_0gQ7kNvwHEkJ7B&_nc_oc=AdqTDyvQlpwGTlfi0W9r0t6DDKXjhkHjSV33zrHj5iTiX_siUkV1fAJ0B_hDHVP0tt4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiUuU_Kr_MyfHy2c7H114MWmpMxRJhI70dYfzTLdyXhg&oe=6A8EE516"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_website_url": null, "website_url": "https://latencyvoidvr.wixsite.com/latency-void", "category": null, "comfort_rating"
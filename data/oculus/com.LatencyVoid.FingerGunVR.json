18515_1430485841932733_5093673296913378001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bios92LVdwQ7kNvwHeLQjA&_nc_oc=AdrQgQdjeJfrG0sJljXHP_HO88ex-J6NRj1KDlPG-f-SUeZNfhKGr9shMG4U2o7ABYI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68FK1vWZAI2a6-nFzXy92s388KAAwibES47lELUqiAWw&oe=6A1C625B"}, {"file_name": "Screenshot_20260112_221855.png", "id": "828904013473183", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499623314_828904020139849_84462614172846929_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZWxHcaALxYQ7kNvwHb6VwZ&_nc_oc=AdreytAR_5HqUxLWmtQiXYlDXr7bCGFMB9XZjgDhR7biwCEsUQqMLg1jv-KVxCoMpqY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41zeb22ZfEgF8Ih4FQvcoHGL3mFseEN9_KHH58lMIQ7Q&oe=6A1C47D9"}, {"file_name": "Screenshot_20260112_221134.png", "id": "1543319466924107", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617762_1543319470257440_7316136525680321019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWpJ2yB4dtMQ7kNvwHdYTUb&_nc_oc=AdpTrVYSNYoJoYVu1p2Pw8Nt6vxASURpEGR0TLpOvna8ZK9cQGdb7nXytmeKmKIoP6s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55GycrHQBVjoocDaenjvMBWLvM0-BeQUWF7_Y6S7u6kw&oe=6A1C56CD"}, {"file_name": "Screenshot_20260112_221741.png", "id": "1607587390258247", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619174_1607587393591580_7914365068027560857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCM540DnDAoQ7kNvwGGgHj3&_nc_oc=Adrh_FRjHctvjB_5_p26ONr9zBOUBJvRJ10m7BF_CmtqKd7qFlUk-P7wtChUGOlojh0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AtT5VyE0x6ojij2X4caHul48xistRV31_U4bBD9B_9A&oe=6A1C5F95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Img.png", "id": "33257581480555416", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618512_33257581487222082_6390387594924241534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hj5JGlYHLC0Q7kNvwFZDqc2&_nc_oc=AdoDW-RhYPRJnb3iIpJ5ha8BABUKxdohJA9MhwLj9-o32msYiUpllBhzlhPQbmqvR3o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59ZuEJgkkL1vf4dywPVE2xOl6GWcir37VMyMHD318EzA&oe=6A1C3296"}, "display_name": "Finger Gun", "keywords": ["VRshooter", "fingergun", "actiongame", "arcade", "shooting"], "long_description": "Finger Gun VR - An Arcade Wave Shooter \ud83d\udd2b\nThis game delivers fast, straightforward VR shooting with a playful finger\u2011gun theme. Aim, fire, and survive as enemies approach from multiple directions. The focus is on quick sessions, simple controls, and score\u2011chasing action that\u2019s easy to jump into.\n\u26a1 Core Features\n\u2022 Finger Gun Shooting: Use familiar VR controls to aim and fire with a finger\u2011gun style twist.\n\u2022 Wave-Based Combat: Face waves of enemies that increase in speed and pressure as you progress.\n\u2022 Encounters: Enemies come from different angles, keeping you alert and moving.\n\u2022 Score\u2011Focused Gameplay: Try to survive longer and beat your previous high score.\n\ud83c\udfaf Built for Meta Quest\nDesigned for standalone VR, Finger Gun VR features clean visuals, smooth performance, and responsive controls that keep the action fast and accessible.\n\ud83d\udd01 Quick, Replayable Sessions\nEach run is short, challenging, and easy to retry perfect for jumping in, improving your timing, and pushing for higher scores.\nIf you enjoy simple, arcade-style VR shooters with a fun twist, Finger Gun VR offers a light, replayable experience built for quick bursts of action.", "short_description": "A fast, arcade\u2011style wave shooter where your fingers become the guns. Aim, shoot, and survive as enemies close in from all sides. Simple controls, quick sessions, and score\u2011chasing action."}]}, "developer_name": "Krushil Narola", "developer_privacy_policy_url": "https://latencyvoidvr.wixsite.com/latency-void/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Latency Void", "support_websi
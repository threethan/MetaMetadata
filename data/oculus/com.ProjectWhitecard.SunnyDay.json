018927", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_208044814352260_8555260937360815470_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRaV6epfxkIQ7kNvwG1l-Gm&_nc_oc=AdrmbaRfjNigfhpbWuZ-Ulgp2cb8tz6SbtwJkFoqFssAqP5kjLE_znhfoz9hfilY2pw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXrnux1D3wZAkA2z8Tk4r6KAT8_1BjJ3k04TP94QC7EZQ&oe=6B10422E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoVille Trailer Thumb 1440.png", "id": "755854905248627", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982552_755854908581960_2515936280676052565_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WtzS_ZvV1QQ7kNvwEptprW&_nc_oc=AdofXDsiYO5upUh88UmxfNrVqalZrSrYl0FDPcsUhYSgnc0vp5tozH_8c9x5A0SDJmk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUaZrWhYnsVBx4fTEMchf4W4LELzr-VYczbTgBrJfPnkw&oe=6B1064A2"}, "display_name": "DoVille", "keywords": [], "long_description": "DoVille is in Early Access.\n\nDoVille Episode 1: Juniper Beach, is here.\nDesigned by a team that includes older, nostalgic adults, DoVille is your VR vacation dream come true.\n\nIncluded in the first download is Juniper Beach, a low poly BEACH and sleuthing adventure. Thrill to easy-to-use activities; catch the mysterious art thief and save the beach, or simply stretch out for an extended stay in the warm, warm sun. Take a dip, water ski, or ride the hot-air balloon. \n\nMore episodes are on the way!\nFor more information (and even a report on the positive brain effects, visit doville dot fun). ", "short_description": "DoVille is in Early Access.\n\nDoVille Episode 1: Juniper Beach, is here.\nHere's one you can hand to Granny. Designed by a team that includes older, nostalgic adults, DoVille is your VR vacation dream come true.\n\nIncluded in the first download is Juniper Beach, a low poly BEACH and sleuthing adventure. Thrill to easy-to-use activities; catch the mysterious art thief and save the beach, or simply stretch out for an extended stay in the warm, warm sun. \n\nMore episodes are on the way!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://projectwhitecard.com/pwc/pwcmont/privacy-policy", "developer_terms_of_service_url": "https://projectwhitecard.com/pwc/pwcmont/terms-of-service", "publisher_name": "Project Whitecard Digital Inc.", "support_website_url": "https://adventures.doville.fun/", "website_url": "https://adventures.doville.fun/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ART_CREATIVITY", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "462891615464677"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "2780309415477042"}, {"status": "PUBLISHED", "id": "148786977276301"}]}, "baseline_offer": {"id": "148786977276301"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "2780309415477042"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4585460144806597", "version": "1.2.0.9282"}, "id": "162020619057906", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4095930040426279", "is_concept
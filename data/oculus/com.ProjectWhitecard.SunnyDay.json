uluscdn.com&_nc_ss=7f20f&oh=00_AQEjzsPUSjS4JbaxWwbin4dciCpwoPrTLTV-QFH5-egPDQ&oe=6A8D6878"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Image_Cover_2560x1440.png", "id": "418797219253351", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974555_418797222586684_516936567010903441_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr9pQflwW64Q7kNvwGICt4T&_nc_oc=AdqZnmiU9PgvI_VWn_0HaqjKWeBPSako8dG-qSzngEe-beO1K2GZ4dKUF-MF4EyFdGE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_C5J1Y75ALaXoq7CNwldj9vusjEXmtvzxZFbEXy3CLQ&oe=6A8D7000"}, "display_name": "DoVille Adventures", "keywords": [], "long_description": "DoVille Adventures has launched! Designed by a team that includes older, nostalgic adults, it's your vacation dream come true! Episode One, Juniper Beach, is a low poly BEACH adventure. Thrill to easy-to-use summer activities; catch the mysterious art thief and save the beach, or simply stretch out for an extended stay in the warm, warm sun. Take a dip, water ski, or ride the hot-air balloon. For more information (and even a report on the positive brain effects, visit doville dot fun). ", "short_description": "DoVille Adventures has launched! Here's one you can hand to Granny with your (old) Oculus Go. Designed by a team that includes older, nostalgic adults, it's your vacation dream come true! Episode One, Juniper Beach, is a low poly BEACH adventure. Thrill to easy-to-use activities; catch the mysterious art thief and save the beach, or simply stretch out for an extended stay in the warm, warm sun."}]}, "developer_name": "Project Whitecard Digital Inc.", "developer_privacy_policy_url": "https://projectwhitecard.com/pwc/pwcmont/privacy-policy", "developer_terms_of_service_url": "https://projectwhitecard.com/pwc/pwcmont/terms-of-service", "publisher_name": "Project Whitecard Digital Inc.", "support_website_url": "https://adventures.doville.fun/", "website_url": "https://adventures.doville.fun/", "category
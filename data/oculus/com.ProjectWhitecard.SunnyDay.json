ge_Cover_2560x1440.png", "id": "418797219253351", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974555_418797222586684_516936567010903441_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBIWxpt3TH4Q7kNvwFXmZAm&_nc_oc=AdlzEPiTJfVohRsatRj2_YrGo-nI2_W3RHrcWgd6kB3dJYhAP1y2V2UxtPr_-Vg0bco&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv9WKMtIJ4wb2ljSqq9bWa-iYaZvZhevBw7rJjXerI-vg&oe=699DB740"}, "display_name": "DoVille Adventures", "keywords": [], "long_description": "DoVille Adventures has launched! Designed by a team that includes older, nostalgic adults, it's your vacation dream come true! Episode One, Juniper Beach, is a low poly BEACH adventure. Thrill to easy-to-use summer activities; catch the mysterious art thief and save the beach, or simply stretch out for an extended stay in the warm, warm sun. Take a dip, water ski, or ride the hot-air balloon. For more information (and even a report on the positive brain effects, visit doville dot fun). ", "short_description": "DoVille Adventures has launched! Here's one you can hand to Granny with your (old) Oculus Go. Designed by a team that includes older, nostalgic adults, it's your vacation dream come true! Episode One, Juniper Beach, is a low poly BEACH adventure. Thrill to easy-to-use activities; catch the mysterious art thief and save the beach, or simply stretch out for an extended stay in the warm, warm sun."}]}, "developer_name": "Project Whitecard Digital Inc.", "developer_privacy_policy_url": "https://projectwhitecard.com/pwc/pwcmont/privacy-policy", "developer_terms_of_service_url": "https://projectwhitecard.com/pwc/pwcmont/terms-of-service", "publisher_name": "Project Whitecard Digital Inc.", "support_website_url": "https://adventures.doville.fun/", "website_url": "https://adventures.doville.fun/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "ge
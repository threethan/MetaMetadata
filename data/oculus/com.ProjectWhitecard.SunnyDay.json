": "DoVille Adventures", "keywords": [], "long_description": "DoVille Adventures has launched! Designed by a team that includes older, nostalgic adults, it's your vacation dream come true! Episode One, Juniper Beach, is a low poly BEACH adventure. Thrill to easy-to-use summer activities; catch the mysterious art thief and save the beach, or simply stretch out for an extended stay in the warm, warm sun. Take a dip, water ski, or ride the hot-air balloon. For more information (and even a report on the positive brain effects, visit doville dot fun). ", "short_description": "DoVille Adventures has launched! Here's one you can hand to Granny with your (old) Oculus Go. Designed by a team that includes older, nostalgic adults, it's your vacation dream come true! Episode One, Juniper Beach, is a low poly BEACH adventure. Thrill to easy-to-use activities; catch the mysterious art thief and save the beach, or simply stretch out for an extended stay in the warm, warm sun."}]}, "developer_name": "Project Whitecard Digital Inc.", "developer_privacy_policy_url": "https://projectwhitecard.com/pwc/pwcmont/privacy-policy", "developer_terms_of_service_url": "https://projectwhitecard.com/pwc/pwcmont/terms-of-service", "publisher_name": "Project Whitecard Digital Inc.", "support_website_url": "https://adventures.doville.fun/", "website_url": "https://adventures.doville.fun/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPLORATION", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"],
bM&_nc_oc=AdkuSRUTzpACMG6OnEOxRzCPwOTh9-hSZr82jMwkkyjeohLod7fmIounMTV4bA_6U74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftM7OuF2TPloTGC6iP2PQkPGZds_etASsyeiKGoX5pqkA&oe=69A6C783"}, {"file_name": "game_guard_2560x1440.png", "id": "882131290792164", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619742_882131294125497_2545340514225478884_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5fZ__RRuecQ7kNvwFkwO0M&_nc_oc=Adk4H7CRNp0LK2TrdZnRvnKmMnWGjN0Yd788qIxEPMctT77zZJAQ_e7RN-5_5a8-wtE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsw6cRZBkwnXAHxxTjc8biP6TNlEkpAUL2Q9FyQ2W1Xkw&oe=69A6D235"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1415855226396188", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620433_1415855229729521_9019975833178031303_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmbxDlk7DzMQ7kNvwEreUth&_nc_oc=AdlTlNIpMwwSqJMutbLChqI8tMzRadS0iOAcxlL4Y0f-xa6AosgMNWARo-jH0zagjzY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftBi6RvuMvC07ndAfalGghKAt-usFs1f4WoP7VmgPinZA&oe=69A6E30F"}, "display_name": "VILLAINS", "keywords": ["simulation", "action", "villain", "hero"], "long_description": "\ud83d\ude08 **Be the Villain!**\n\n**Be bad. Get wild. Break everything.**\n\nIn *VILLAINS*, you're not here to save the day\u2014you're here to wreck it.  \nThrow on your villain mask, sneak out of your secret den, and unleash mayhem:  \n\ud83d\udca5 smash stuff, \ud83d\udda5 shut down systems, \ud83e\ude9esteal wigs, and cause the most ridiculous trouble you can imagine.\n\nAvoid guards, take down overpowered Heroes, and steal their powers to become even worse.\n\n\u26a0\ufe0f No justice. Just glorious mischief.", "short_description": "VILLAINS is a VR action game where you become a mischievous villain, wear powerful masks, and cause chaos in public spaces. Smash objects, prank NPCs, dodge guards, and unlock new powers\u2014just for the fun of being bad."}]}, "developer_name":
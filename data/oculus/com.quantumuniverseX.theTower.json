culuscdn.com/v/t64.5771-25/499619148_585965174160022_8354128686717260815_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WGrO2NKwVIQ7kNvwFapbKL&_nc_oc=AdrTFl5JfvKb-YIWHloiOrH9hsUdx4rHhR5iVeBa0CR9AYVda0Exng4z8B5oGwXQubk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Co1_ago-SGFWseL6Y4eDpH8R50Qb1Ra4X7em1gdQlqg&oe=6A219B43"}, {"file_name": "game_guard_2560x1440.png", "id": "882131290792164", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619742_882131294125497_2545340514225478884_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2lwDFHnS5kQ7kNvwHwKCMU&_nc_oc=AdqXGW-RXpH8fAQC_q94DAZCXLezFSbpuVMGj5Ww1CdQEd3PH3kQ_YSaClxhPksQRmI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0rM_ps8JcOrcHTtQVhvfCnWCQfR63ciPJGOTkIsEzRg&oe=6A21A5F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1415855226396188", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620433_1415855229729521_9019975833178031303_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFNjomaldiAQ7kNvwG5rlj8&_nc_oc=AdrZ9giAIZU4suNPc0h4rFKSkAbkepMxvLB9XEmgCNXIW4TVKrfAMaMOQYjHWs-I9Nw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81fqG9vNtAIrgVC4JBTFaLS_udFB4kHcl-RslkCnsYJQ&oe=6A217E8F"}, "display_name": "VILLAINS", "keywords": ["simulation", "action", "villain", "hero"], "long_description": "\ud83d\ude08 **Be the Villain!**\n\n**Be bad. Get wild. Break everything.**\n\nIn *VILLAINS*, you're not here to save the day\u2014you're here to wreck it.  \nThrow on your villain mask, sneak out of your secret den, and unleash mayhem:  \n\ud83d\udca5 smash stuff, \ud83d\udda5 shut down systems, \ud83e\ude9esteal wigs, and cause the most ridiculous trouble you can imagine.\n\nAvoid guards, take down overpowered Heroes, and steal their powers to become even worse.\n\n\u26a0\ufe0f No justice. Just glorious mischief.", "short_description": "VILLAINS is a VR action game where you become a mischievous villain, wear powerful masks, and cause chaos in public spaces. Smash objects, prank NPCs, dodge guards, and unlock new powers\u2014just for the fun of being bad."}]}, "developer_name": null, "developer_privacy_policy_url": "https://quantumuniverse.co/games/villains/privacy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://quantumuniverse.co/", "website_url": "https://quantumuniverse.co/games/villains", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23953463904355350"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1499462707865210"}, {"status": "CANCELLED", "id": "1142639021138071"}, {"status": "PUBLISHED", "id": "1602009377874934"}, {"status": "PUBLISHED", "id": "702063012878775"}, {"status": "PUBLISHED", "id": "24126683280293180"}, {"status": "PENDING", "id": "1337744627778437"}]}, "baseline_offer": {"id": "702063012878775"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "1499462707865210"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25132097986491930", "version": "0.3.0"}, "id": "966454468628541", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAp
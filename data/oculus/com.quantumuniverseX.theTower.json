content-lhr6-2.oculuscdn.com/v/t64.5771-25/499619148_585965174160022_8354128686717260815_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6P0Rm3uwaMQ7kNvwFC4Pu4&_nc_oc=AdqKvqV6b0H78aOYCu9Ngfi9V7hS1zEs3YNW72koF3lHUgRFt9qkfm6lOzt8Z5YfTYY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIxVUrUKjUBME_ypQ8EbSRFo0bOnQwnJJbyry2XHYoZw&oe=6A859503"}, {"file_name": "game_guard_2560x1440.png", "id": "882131290792164", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619742_882131294125497_2545340514225478884_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aq4b_mciUDEQ7kNvwHH4hQO&_nc_oc=AdqqWaZy_NZl0j5rw2vDYQSbP3P6atR3DtNek_O8VrmN_wH98ujK3nvUTqJiKVDQeTM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb_c5MC7iFpzkrhG4ROSSQSuQtNALzNwQEhbxZNt69pA&oe=6A859FB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1415855226396188", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499620433_1415855229729521_9019975833178031303_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CMRt7wCl3cQ7kNvwFAypjW&_nc_oc=Adr8Z9vqRIX5NaKXkHy7jE2E5xURqS3Q_zS29q4Wh3KlweONm2p0uOwxcU8iys6WHSg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDJNUJRjVaoHi14ia8ypPEDvGqUObeIdy7WiAuUHOksw&oe=6A85B08F"}, "display_name": "VILLAINS", "keywords": ["simulation", "action", "villain", "hero"], "long_description": "\ud83d\ude08 **Be the Villain!**\n\n**Be bad. Get wild. Break everything.**\n\nIn *VILLAINS*, you're not here to save the day\u2014you're here to wreck it.  \nThrow on your villain mask, sneak out of your secret den, and unleash mayhem:  \n\ud83d\udca5 smash stuff, \ud83d\udda5 shut down systems, \ud83e\ude9esteal wigs, and cause the most ridiculous trouble you can imagine.\n\nAvoid guards, take down overpowered Heroes, and steal their powers to become even worse.\n\n\u26a0\ufe0f No justice. Just glorious mischief.", "short_description": "VILLAINS is a VR action game where you become
com&_nc_ss=7f20f&oh=00_AQTgJ6bb0EIkXoLgujb9-UuzymsL2kIF2uWKSOior7XoqQ&oe=6B032DCA"}, {"file_name": "02_VisionTime_Recently_Added.png", "id": "2131170361137203", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830904_2131170364470536_1932927984431641551_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NrFB5jHR4gQ7kNvwFknwZh&_nc_oc=AdoYgoYHWfvIzELNZAQ10YIuSUCwuXBUvVeSB_N8eRyGta9GrCx-TbbzQDUAtCsZOhU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8FmohQGxeXdT-a4hy1EhWAvWidc5gUzDQmBY99-xOVg&oe=6B030718"}, {"file_name": "04_VisionTime_My_Shows.png", "id": "2592651187918001", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673716021_2592651191251334_1496673220308912750_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LbHlcJtTOcQ7kNvwHy7MZ8&_nc_oc=Adpe-pVqahPO-sH0ppDeHBeyBgmCdthmakvwkjXQGwos_mcpcQwUMXf5LLb6SaXtsLo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMyDWeTBQhnGXD_t7aeCl6ghdRAszXdUWCXk9MrNpRPA&oe=6B0337FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VisionTime: Movie & TV Tracker", "keywords": ["watchlist", "film", "cimera", "movie", "tracker"], "long_description": "Every movie you watch, every show you follow \u2014 VisionTime turns them into a beautiful, personal library that grows with you.\n\nMark episodes as you go. Follow the actors, directors, and studios whose next project you cannot wait for, and let VisionTime quietly tell you when a release date lands \u2014 as a weekly digest, a monthly digest, with per-show controls for the series that matter most.\n\nYour library lives on this headset. No account. No sign-up. No ads. No tracking. Nothing sold to anyone, ever. And when you move to a new headset \u2014 or to iPhone, iPad, Mac, or Apple Vision Pro \u2014 one exportable file carries your entire library, ratings, notes, follows, and watch progress with you. VisionTime is the same app on every screen you own.\n\nDesigned as a 2D panel for the Horizon shell, VisionTime opens, resizes, minimises, and closes like any other window on Meta Quest 2, Quest Pro, Quest 3, and Quest 3S. Hand tracking and controllers both work through the system pointer, and the keyboard appears the moment you need it.\n\nYour library. Your progress. Only yours.", "short_description": "Track every movie and TV show you watch, right from your Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Meshy-SC/VisionTime/blob/main/PRIVACY_POLICY_MH.md", "developer_terms_of_service_url": null, "publisher_name": "Meshy", "support_website_url": "https://github.com/Meshy-SC/VisionTime/blob/main/SUPPORT_MH.md", "website_url": "https://github.com/Meshy-SC/VisionTime/tree/main", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1992079974837238"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828028_1052967274374489_998438230340077451_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCx3eR-xmIcQ7kNvwHW9l22&_nc_oc=AdoNqaSAguQinUXH039qKnp18c4xKC8O1vuf8CEymYfRO6zrieVPfVCqJKSHKgg_rE4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYYKk1T9PjQKmHBHwRj45CLirM_yFuHmUGmJCKPPlqpg&oe=6B030491"}, "is_concept": false, "is_test": false
_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUkfoH9rtYuKY4OqpFeoGDkajojDdsl9lR0kRAZDh4Ww&oe=6AFB44CA"}, {"file_name": "02_VisionTime_Recently_Added.png", "id": "2131170361137203", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830904_2131170364470536_1932927984431641551_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfbavW__-IsQ7kNvwGFuycw&_nc_oc=AdpyOUHNOQ1pkxJfnuPrz0hkHLTbrie-6hUoEpaUz4Ee3YapUKuKYoZ4IDb_NDiULVs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJSxzr-81UWP9fQJwznq91SoF57HYEaRkkYq4_cudj4A&oe=6AFB1E18"}, {"file_name": "04_VisionTime_My_Shows.png", "id": "2592651187918001", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673716021_2592651191251334_1496673220308912750_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30uHKZZAidgQ7kNvwHu8RAd&_nc_oc=Adr22ruvM1X2haxWkHf6xYb3c7aMj7eV7ZZyOOGjnIm1NimeieA3A0SxNMOiIco-bPc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsbqQ2s4KAfq2dqH3D_gDUAR7xnXiH4yM0r8myF-UDDw&oe=6AFB16BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VisionTime: Movie & TV Tracker", "keywords": ["watchlist", "film", "cimera", "movie", "tracker"], "long_description": "Every movie you watch, every show you follow \u2014 VisionTime turns them into a beautiful, personal library that grows with you.\n\nMark episodes as you go. Follow the actors, directors, and studios whose next project you cannot wait for, and let VisionTime quietly tell you when a release date lands \u2014 as a weekly digest, a monthly digest, with per-show controls for the series that matter most.\n\nYour library lives on this headset. No account. No sign-up. No ads. No tracking. Nothing sold to anyone, ever. And when you move to a new headset \u2014 or to iPhone, iPad, Mac, or Apple Vision Pro \u2014 one exportable file carries your entire library, ratings, notes, follows, and watch progress with you. VisionTime is the same app on every screen you own.\n\nDesigned as a 2D panel for the Horizon shell, VisionTime opens, resizes, minimises, and closes like any other window on Meta Quest 2, Quest Pro, Quest 3, and Quest 3S. Hand tracking and controllers both work through the system pointer, and the keyboard appears the moment you need it.\n\nYour library. Your progress. Only yours.", "short_description": "Track every movie and TV show you watch, right from your Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Meshy-SC/VisionTime/blob/main/PRIVACY_POLICY_MH.md", "developer_terms_of_service_url": null, "publisher_name": "Meshy", "support_website_url": "https://github.com/Meshy-SC/VisionTime/blob/main/SUPPORT_MH.md", "website_url": "https://github.com/Meshy-SC/VisionTime/tree/main", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1992079974837238"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1750839726188377"}]}, "baseline_offer": {"id": "1750839726188377"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788309300, "status": "PUBLISHED", "id": "1750839726188377"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1992391078139461", "version": "26.0.1"}, "id": "1098039979321540", "channel_name": 
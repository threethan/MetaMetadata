ile_name": "store_512x512.png", "id": "983398447568876", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595136811_983398454235542_6295508694581575393_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6jQTfq1hbUQ7kNvwGRDdgy&_nc_oc=Adp44yQyTF4izo-v0wVTX3mePQhAazT4wdhwXkGQourRssbk4e1aIZtrvxMkuD47Sbo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwAw57XOWa9xT-m52mVqaEV--hNE_85nX8QjMTpygOBw&oe=6AA15241"}, {"file_name": "amonggiants_logo_rast.png", "id": "975032804501660", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391890_975032807834993_1764748387275970262_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9KIW8gUOkMQ7kNvwEKNlh0&_nc_oc=AdoGQZ-0VFST5UhDpkAufIXHKOACo5ZfketyDFn1rtSOh08l-FEgJiFDJbpF8V1p9hM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLF64FN81T0nzLuMkx0NlfwThX3MGN48F52yGzCPtm3dQ&oe=6AA171D0"}]}, "id": "1016229837975540", "locale": "en_US", "screenshots": [{"file_name": "screen01.png", "id": "858572717126184", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823351_858572720459517_2564797236933896250_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCHDTPVUblIQ7kNvwH5vyUA&_nc_oc=AdoUza22TAf9naU22q23m41UkyYlGa_h8fY8EA51eK8d_hnJ4CFK4AcojCTUaiiqcEE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJc-yyDCcl_h8HfRl9V_YZ6DRm2BQK4oZTnEkZ-jDVDw&oe=6AA158E7"}, {"file_name": "screen02.png", "id": "1338573851097627", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820387_1338573854430960_4811159691930794083_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NpahS63GG4Q7kNvwGZXOKX&_nc_oc=AdqnPm069YwKE3bWiIjoPy5DD6d5qazPyIiv3rumpHpyD5PDdmaa7y_7_86kwRQSj2o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM4x7hX5Aigd10FTMH_VYe9peeQDSNaaQmjFmSMzuj7g&oe=6AA1586A"}, {"file_name": "Screenshot 2025-11-14 at 21.04.25.png", "id": "1066416112168052", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819323_1066416115501385_8039787634958319750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZ0GaMLbxGcQ7kNvwH_Yo1H&_nc_oc=Adrx7tg8pOktL3jnUFvd5j3wbguu5Uvdt_LxTzpjBB-qNlzemVhjtkykQEt4V01AzLc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3KNQ7cgp4um1clilLbWT00HoGgepOZSNeXfGKyXzmdw&oe=6AA16A51"}, {"file_name": "screen03.png", "id": "2091410154936281", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825546_2091410161602947_6722692780438254591_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cfg6Xnil6d0Q7kNvwFTPBnm&_nc_oc=AdqopxOEXhTH_14P3yhiuQHYMr3zltoI76IUSY9rJDJIY5ybD2tDwJ69sD3JmpAylqA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6iuGL1bENmvGvG1eZryFwSvu4ec5_dka4ZyxUPxfBrQ&oe=6AA173B3"}, {"file_name": "Screenshot 2025-04-01 at 19.31.53.png", "id": "1164091195235792", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_1164091198569125_6812339530692988798_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfQF_RAZxaMQ7kNvwHfTnGK&_nc_oc=AdoCdVvqeXWm0mtRPy0lMZfB_ITjeJC3dCsu3wmSestdBIyxDiY0PlpNbtswGy9waVc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxtuYEdy1yUrhd0tY1n8h05cectOws3V3mekboE-5KJw&oe=6AA15BD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_2560x1440.png", "id": "1280611433706310", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499299139_1280611437039643_9059873030143677353_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP6QgJ4XUAEQ7kNvwFbJIRH&_nc_oc=AdpjRecj315eV_y_L0mG2OnzZW-zw5dfnDORAxLquN8-GfdHklx_0hB_mG9c3KuTc9s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzdP7VoHlcFabXHlhoTvyeLiuWay9yM4ODAWTRWBlZBw&oe=6AA14E0B"}, "display_name": "Among Giants", "keywords": ["climbing", "swinging", "bows", "giants", "adventure"], "long_description": "# UploadVR - 4.5/5\n\n**\"One of the Best!\"**\n\nAmong Giants is an open-world game where the player gets to explore the planet at their own pace, deciphering the alien language to get a better understanding of what has happened to humanity by hunting down colossal giants that roam the world and extracting their final memories.\n{824636457215828}\n\n# The Giants and Others\nThe game has over 10 different types of enemies you will encounter from smaller Droids to a huge Spider Queen or the Giant Death Worm\n{830767046537926}\n\n# Meet R-011\nBefriend a feisty tiny Roller Droid, your gateway to understanding this world who will eventually be your closest ally. R-011 will be your Hacker, your Protector and your Friend\n{1332849368154885}\n\n# Your Horse\nExplore the huge alien world by riding your trusty steed. You can call for your horse anywhere with your Horn\n{1412359163842124}\n\n# Your Bow & Arrow\nFind special Quivers for your bow to help tackle those tricky targets\n{1617153256329705}\n\n# Grappling Hooks\nTraverse across the land using your grappling hooks and also use them to break open crates\n{875307924930249}\n\n# Gliding\nOutstretch your arms to glide your way to safety or distant platforms\n{1292691869326168}\n\n# Other Weapons\nThere are many other types of weaponry found in the world but use them wisely as they cannot be reloaded\n{827696256535054}\n\n# Hack Terminals & Locks\nDecipher the alien language a character at a time by hacking terminals and also break into buildings and gates by pick locking\n{1394160675459015}\n\n# Realtime Day & Night with Weather Systems\nThe battleground changes constantly when the day turns to night. Fight through heavy rain, a freezing blizzard and even in a scorching desert\n{1885682562347865}", "short_description": "EXPLORE, HUNT & KILL THE GIANTS.\nYou are Erya, the lone wanderer on a desolate world. You awaken among colossal giants, with their slow, deliberate movements resembling ancient deities. The world is scattered with robot relics, frozen in anguish, remnants of a lost civilization destroyed by a divine event. Can you uncover a connection between the giants, the planet, and your own origins?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://kmonkeygames.com/games/among-giants/among-giants-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "K Monkey Games", "support_website_url": null, "website_url": "http://www.kmonkeygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "37096311913348764"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823259_1253046330116087_4849825091807817885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8jNtTO6bzUQ7kNvwEWnHvi&_nc_oc=AdqEhFXPLUWox1KOhuazLUOON1HJaackIILJDaxqDt2cvbfU7F25fgvtliqOnNpH5gg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgzPgXR5ADOS0VIZgG29jO9_5xr7HOqGV-w27PtUVpyQ&oe=6AA174EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Among Giants", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040
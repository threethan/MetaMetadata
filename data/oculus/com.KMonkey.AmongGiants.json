9", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_607979092404692_496368823197640446_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=empP8pJR_lkQ7kNvwHAxDrc&_nc_oc=AdrTug2iMP8dsawfV_PQzBJar8E6ZynLFDTqTZSwCVfAtsmWx8sfznh3ruBsZObgtGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66eBZzXhf8moDk0TN0UBz-yxe6otmnyG6yqXJDGR3XZw&oe=69FCA639"}]}, "id": "1524009592566905", "locale": "en_US", "screenshots": [{"file_name": "screen01.png", "id": "858572717126184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_858572720459517_2564797236933896250_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDImszc_26IQ7kNvwEWTU0d&_nc_oc=AdoRwaYQSQD0Wg-OY05sdWWd861sKYC-GxHC6w96vge1h3LTddYwJra47SvqEnsNEag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Hs2hgjXG-8cTAo_oh5HYJK1AN6YE01Pn2T2eZCvLH7Q&oe=69FC8D67"}, {"file_name": "screen02.png", "id": "1338573851097627", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820387_1338573854430960_4811159691930794083_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsL9rtKFJIgQ7kNvwEs5I86&_nc_oc=AdoD5F4BXHZCGDFyWkRWYTmv90XP8OoQX0AMBY9rSlo-Zv70H9wiFvE3s0h-1nTCGP0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zdEZZUCbsl7AooH_QRo2GTFVPO-wAHIGM-L0uMC5LFQ&oe=69FC8CEA"}, {"file_name": "Screenshot 2025-11-14 at 21.04.25.png", "id": "1066416112168052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819323_1066416115501385_8039787634958319750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7YVHm7I03kQ7kNvwHHIV0t&_nc_oc=AdqS1zZPAx6ihpYvVUxQZNEE39maevEUw8zOW-_Fp6FFoNMlobOZVIz0gj3Rlc9O2HE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RNaGp9YQXNO7F5Cd53ZRblIL_con8NKQC1Gdmm9DJdw&oe=69FC9ED1"}, {"file_name": "screen03.png", "id": "2091410154936281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825546_2091410161602947_6722692780438254591_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qEa8AGXGz8Q7kNvwG38oNT&_nc_oc=AdptdEipimO2Zm9YTMOIP9oj56pGR9TC0DtFkq2qpfNqZglE53NeTNBBtJZjgyDoYq0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4p5jNC5CUd1dfzmfjBmtJsQDHq_hE1kcWqeE7tjc305g&oe=69FCA833"}, {"file_name": "Screenshot 2025-04-01 at 19.31.53.png", "id": "1164091195235792", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1164091198569125_6812339530692988798_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmBE1FQzbh0Q7kNvwHSas7v&_nc_oc=Ado740ix65gbd0XLuIhTt9IrT1dAiFWQIl1SKQDHvXJGQIwy4_F4XH66smQj5EX18Qs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7g5kxvdBV_9IePOy0yw9WdIVujgDxjg0_wXnA-CQuN8A&oe=69FC9058"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapeB_2560x1440.png", "id": "1127884662460298", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824318_1127884665793631_7961251378149141310_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beQxi864PX0Q7kNvwHcfg7E&_nc_oc=AdptCJTEW0FP_k-VD5TnBZZgtwiOR908jGsC9UbvQ6TQ8HHAR0D9xAYCNfiryMXT7i4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WtSW8SM3yULaJh2xFPFrveh71E_-t8pDSxdWroBHcsQ&oe=69FCA708"}, "display_name": "Among Giants", "keywords": ["climbing", "swinging", "bows", "giants", "adventure"], "long_description": "Among Giants is an open-world game where the player gets to explore the planet at their own pace, deciphering the alien language to get a better understanding of what has happened to humanity by hunting down colossal giants that roam the world and extracting their final memories.\n{824636457215828}\n\n# The Giants and Others\nThe game has over 10 different types of enemies you will encounter from smaller Droids to a huge Spider Queen or the Giant Death Worm\n{830767046537926}\n\n# Meet R-011\nBefriend a feisty tiny Roller Droid, your gateway to understanding this world who will eventually be your closest ally. R-011 will be your Hacker, your Protector and your Friend\n{1332849368154885}\n\n# Your Horse\nExplore the huge alien world by riding your trusty steed. You can call for your horse anywhere with your Horn\n{1412359163842124}\n\n# Your Bow & Arrow\nFind special Quivers for your bow to help tackle those tricky targets\n{1617153256329705}\n\n# Grappling Hooks\nTraverse across the land using your grappling hooks and also use them to break open crates\n{875307924930249}\n\n# Gliding\nOutstretch your arms to glide your way to safety or distant platforms\n{1292691869326168}\n\n# Other Weapons\nThere are many other types of weaponry found in the world but use them wisely as they cannot be reloaded\n{827696256535054}\n\n# Hack Terminals & Locks\nDecipher the alien language a character at a time by hacking terminals and also break into buildings and gates by pick locking\n{1394160675459015}\n\n# Realtime Day & Night with Weather Systems\nThe battleground changes constantly when the day turns to night. Fight through heavy rain, a freezing blizzard and even in a scorching desert\n{1885682562347865}", "short_description": "EXPLORE, HUNT & KILL THE GIANTS.\nYou are Erya, the lone wanderer on a desolate world. You awaken among colossal giants, with their slow, deliberate movements resembling ancient deities. The world is scattered with robot relics, frozen in anguish, remnants of a lost civilization destroyed by a divine event. Can you uncover a connection between the giants, the planet, and your own origins?"}, {"images": {"nodes": []}, "id": "938248179187374", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Among Giants", "keywords": [], "long_description": "Erkunde einen fremdartigen Planeten in deinem eigenen Tempo und entschl\u00fcssle eine unbekannte Sprache, um herauszufinden, was mit der Menschheit geschehen ist. Jage kolossale Riesen, die durch die Welt streifen, und erlebe ihre letzten Erinnerungen.\n{975012561531365}\n\n# Riesen und andere Bedrohungen\nStelle dich \u00fcber zehn verschiedenen Gegnertypen \u2013 von kleinen Droiden bis hin zur gewaltigen Spinnenk\u00f6nigin und dem gef\u00fcrchteten Todeswurm.\n{1710075989833861}\n\n# Triff R-011\nFreunde dich mit dem kleinen Droiden R-011 an \u2013 dein Schl\u00fcssel zum Verst\u00e4ndnis dieser Welt. Er wird dein Hacker, dein Besch\u00fctzer und dein engster Verb\u00fcndeter.\n{2687873084927017}\n\n# Dein Pferd\nErkunde die riesige Alien-Welt auf deinem treuen Pferd und rufe es jederzeit mit deinem Horn zu dir.\n{1105594471749650}\n\n# Dein Bogen und Pfeil\nFinde spezielle K\u00f6cher, um auch die schwierigsten K\u00e4mpfe zu meistern.\n{4309450092644157}\n\n# Greifhaken\nNutze den Greifhaken, um Hindernisse zu \u00fcberwinden und Kisten zu \u00f6ffnen.\n{1375631994596528}\n\n# Gleiten\nStrecke deine Arme aus und gleite zu entfernten Plattformen.\n{1540319987669406}\n\n# Andere Waffen\nEntdecke zahlreiche Waffen in der Welt \u2013 aber setze sie weise ein, denn sie sind nicht reparierbar.\n{707944689013458}\n\n# Terminals hacken & Schl\u00f6sser knacken\nEntschl\u00fcssle die Sprache der Aliens Buchstabe f\u00fcr Buchstabe, indem du Terminals hackst und Schl\u00f6sser knackst.\n{973117065293184}\n\n# Dynamische Welt\nErlebe eine lebendige Welt mit Echtzeit-Tag-und-Nacht-Wechseln und dynamischem Wetter \u2013 von starkem Regen \u00fcber eisige St\u00fcrme bis hin zu gl\u00fchender W\u00fcstenhitze, die das Schlachtfeld st\u00e4ndig ver\u00e4ndert.\n{1270951054980503}", "short_description": "ERKUNDE, JAGDE UND T\u00d6TE DIE RIESEN.\nDu bist Erya, die einsame Wanderin auf einer verlassenen Welt. Du erwachst inmitten kolossaler Riesen, deren langsame, bed\u00e4chtige Bewegungen an uralte Gottheiten erinnern. Die Welt ist \u00fcbers\u00e4t mit Roboterrelikten, erstarrt vor Schmerz \u2013 \u00dcberreste einer untergegangenen Zivilisation, die durch ein g\u00f6ttliches Ereignis vernichtet wurde. Kannst du eine Verbindung zwischen den Riesen, dem Planeten und deiner eigenen Herkunft aufdecken?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://kmonkeygames.com/games/among-giants/among-giants-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "K Monkey Games", "support_website_url": null, "website_url": "http://www.kmonkeygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35281045814875392"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820441_2103688197126972_3317405473795379137_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXY7uBhf_cgQ7kNvwGC3-77&_nc_oc=AdrzN1G8uM3c4Iw9La9aNURZ47dzA5yrh_eZOEbYjEgNErfU20nHoUEpTdzJ38znVPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kbsTIsZXODp3L2LhThb5gJV7oBCD4pCVqvDF_fVZDqw&oe=69FC9140"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Among Giants", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1774346700, "lastRevision": {"nodes": [{"id": "25060508533595889", "release_type": "SCHEDULED
{"data": {"node": {"__typename": "Application", "id": "25060508500262559", "organization": {"id": "1317079748332410", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25060508500262559"}]}, "id": "712176450822949"}]}}, "firstRevision": {"nodes": [{"application": {"id": "25060508500262559", "release_date": 1774346700, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 3}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35285845804395393"}, "id": "941082507652175"}]}}, "binary": null, "live_binary": null, "created_date": 1777647136, "id": "35278364005143573", "is_initial_release": false, "name_with_fallback": "v19", "pdp_metadata_with_fallback": {"version": 8, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "35281045814875392"}, "release_status": "RELEASED", "id": "25060508500262559"}, "id": "35281045814875392", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25060508500262559", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "554790660495911"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "background_180x180.png", "id": "4202104770041901", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821099_4202104773375234_1588077238505421597_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGBhspQLTZkQ7kNvwEsJJwZ&_nc_oc=AdrlPNul0TQRUY1Gh6CdfHK1nApdt9fBzYCjGMxPRKbfmJxyFNOXKpxPVTYlaVSesNo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c2oil5M00GdzpvP5
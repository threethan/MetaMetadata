849307104715924"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "941082507652175"}]}, "change_log": "- R-011 now has a new feature to disable the blue light projection (has no effect on the icons)\n- Sentry Towers can now be disabled when you reach to the top and completing the hack (permanent)\n- R-011 talking cooldown extended a little so he talks a bit less\n- Stamina not required when opening Crates or removing Tanks from Robot Relics\n- Land explored percentage calculation fixed\n- Holsters now correctly clear upon completing the game and starting new game", "created_date": 1779607681, "id": "35793295413650427", "version": "1.0.14", "version_code": 189, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25060508500262559", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35849307104715924"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "941082507652175"}]}, "change_log": "- Drone Hunters down to a single drone with slightly less aggression\n- Spider Queen plasma adjusted\n- Fixed New Game not clearing holstered guns\n- Fixed double door buildings recorded wrong in the stats\n- Fixed Indoor audio ambience\n- Level design tweaks (building clipping)", "created_date": 1779408074, "id": "35746806141632688", "version": "1.0.13f", "version_code": 188, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary
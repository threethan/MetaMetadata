n.com/v/t64.5771-25/491823812_607979092404692_496368823197640446_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnkMqYc5pWAQ7kNvwFkn-ST&_nc_oc=Adr7DeBWZmEkNKk754V3SmPJBITKSTrEJ20IQvv1iDdF0naFJhcywP3weMblRFATvjQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aGW_mDibV5H_r-wRo157itHpD1VmtGGcxmS_XZDjdGw&oe=69EB82B9"}]}, "id": "1854701391647132", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 2025-11-14 at 21.03.59.png", "id": "765690836487660", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_765690843154326_4213525441979447950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvzmPeU-I2QQ7kNvwHI5ZkK&_nc_oc=Adpe50Yk3Trg5mpuC_a9DQkoJbfZTMrxvfQDC_vwUkN6JgZ2K2OY1WB83aJGtq78Dmo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18OpsanwGDmdgnntnNshLSGGdNbu2cvHjapdJ8gtf_6g&oe=69EB5776"}, {"file_name": "Screenshot 2025-11-14 at 21.04.25.png", "id": "1066416112168052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819323_1066416115501385_8039787634958319750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0EFcLnJ5PsQ7kNvwEXVObT&_nc_oc=AdpS4A5rlSXOWOmk5nl8MCoxVCRrHjGRjlHdh6m6IFR2QQ0DRdhRxcOJIpiEPFc4xtA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OWDgzE8F4-2wPPyqVcCmWLkVb01fOxNjC21Kdb5Y1tw&oe=69EB7B51"}, {"file_name": "Screenshot 2025-11-16 at 11.10.54.png", "id": "827196230279662", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298291_827196233612995_1820748001195304311_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bAldyISn7oQ7kNvwF7HK01&_nc_oc=AdoojpXxc-Ty2kjtDRRujkwv5Y684ss8Dr2amw3Mo5WyERzS0Ya1Q-zst5szrQXjg_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sggW84HOhIvlYmgQotrS7IBmZ2btOHW6Ec_It7Tqv8Q&oe=69EB784C"}, {"file_name": "Screenshot 2025-04-01 at 19.31.53.png", "id": "1164091195235792", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_1164091198569125_6812339530692988798_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWK8245T8xsQ7kNvwEypJmX&_nc_oc=AdpwHMfBPak9V0xaUhcAI__R4qL7YVB65qNhOK5phJoz6H05TqfFiGCQjMGT3W3S40U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lez-6l-j6bWdgfX3KD6QO50QQyx6A3b9BusA8sikVpg&oe=69EB6CD8"}, {"file_name": "Screenshot 2025-02-19 at 14.56.05.png", "id": "25652228037715697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819464_25652228044382363_5730527552521063876_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twnlLk3VA08Q7kNvwEDpTqW&_nc_oc=Adp0ASxEQ266QdR3A2w9_C0-sRWe7QtO6uWlOcQLATxyE_kdRsGx6ktmVXDP6YE14G0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jfbP2_RSR2qb0d1MgvxPHDPZWiFJ1buTf2RH5CM-ugA&oe=69EB8644"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "2105423356657529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_2105423363324195_5090811876925984097_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRW13jFSeXMQ7kNvwFWlZW3&_nc_oc=Adr1zRdAr2W_X3AU0OfPHMavP3Z1Cfa2VKGNU2N33Bh-BuQ74X4NRkAvINjyGD_mq2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Bdgd7RqnozoqGL0fmPu8OwQnoRix4bwIPVdyrz7nd_Q&oe=69EB7A1F"}, "display_name": "Among Giants", "keywords": ["climbing", "swinging", "bows", "giants", "adventure"], "long_description": "Among Giants is an open-world game where the player gets to explore the planet at their own pace, deciphering the alien language to get a better understanding of what has happened to humanity by hunting down colossal giants that roam the world and extracting their final memories.\n\n# The Giants and Others\nSome of the giants you will hunt and take them down\n{824636457215828}\nThe game has over 10 different types of enemies you will encounter from smaller Droids to a huge Spider Queen\n{830767046537926}\n\n# Meet R-011\nBefriend a feisty tiny Roller Droid, your gateway to understanding this world who will eventually be your closest ally. R-011 will be your Hacker, your Protector and your Friend\n{1332849368154885}\n\n# Your Horse\nExplore the huge alien world by riding your trusty steed. You can call for your horse anywhere with your Horn\n{1412359163842124}\n\n# Your Bow & Arrow\nFind special Quivers for your bow to help tackle those tricky targets\n{1617153256329705}\n\n# Grappling Hooks\nTraverse across the land using your grappling hooks and also use them to break open crates\n{875307924930249}\n\n# Gliding\nOutstretch your arms to glide your way to safety or distant platforms\n{1292691869326168}\n\n# Other Weapons\nThere are many other types of weaponry found in the world but use them wisely as they cannot be reloaded\n{827696256535054}\n\n# Hack Terminals & Locks\nDecipher the alien language a character at a time by hacking terminals and also break into buildings and gates by pick locking\n{1394160675459015}\n\n# Realtime Day & Night with Weather Systems\nThe battleground changes constantly when the day turns to night. Fight through heavy rain, a freezing blizzard and even in a scorching desert\n{1885682562347865}", "short_description": "You are Erya, the lone wanderer on a desolate world. You awaken among colossal giants, with their slow, deliberate movements resembling ancient deities. The world is scattered with robot relics, frozen in anguish, remnants of a lost civilization destroyed by a divine event. Can you uncover a connection between the giants, the planet, and your own origins?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://kmonkeygames.com/games/among-giants/among-giants-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "K Monkey Games", "support_website_url": null, "website_url": "http://www.kmonkeygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "459781504968480
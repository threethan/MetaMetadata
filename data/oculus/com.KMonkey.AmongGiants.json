b=1-7&_nc_sid=6e7a0a&_nc_ohc=OEBa0lE9gfwQ7kNvwGBY3D-&_nc_oc=AdqeXCFtZNem6Eaza37kRtCJhmw8ww3JvHcwKxZyjdv-6TDic9S4JRP0clN9PBk4TI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I9EWPf8gSoj22b9TyK8H0-ViwjdMVcHVLoybGGYey9Q&oe=69FC7AF6"}, {"file_name": "Screenshot 2025-11-14 at 21.04.25.png", "id": "1066416112168052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819323_1066416115501385_8039787634958319750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7YVHm7I03kQ7kNvwHHIV0t&_nc_oc=AdqS1zZPAx6ihpYvVUxQZNEE39maevEUw8zOW-_Fp6FFoNMlobOZVIz0gj3Rlc9O2HE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RNaGp9YQXNO7F5Cd53ZRblIL_con8NKQC1Gdmm9DJdw&oe=69FC9ED1"}, {"file_name": "Screenshot 2025-11-16 at 11.10.54.png", "id": "827196230279662", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298291_827196233612995_1820748001195304311_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJVtzYU75kgQ7kNvwEI0Xvv&_nc_oc=AdooljgBwNqmoPq9FtsZ8RntQDqNybqeO9x6ktq9nhPQMNyxEpLUaQf4I-NVUPLMOho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4s21A5DQpUQQLdrUWzia2OQa-BR867myjscL3KDXQeGQ&oe=69FC9BCC"}, {"file_name": "Screenshot 2025-04-01 at 19.31.53.png", "id": "1164091195235792", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1164091198569125_6812339530692988798_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmBE1FQzbh0Q7kNvwHSas7v&_nc_oc=Ado740ix65gbd0XLuIhTt9IrT1dAiFWQIl1SKQDHvXJGQIwy4_F4XH66smQj5EX18Qs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7g5kxvdBV_9IePOy0yw9WdIVujgDxjg0_wXnA-CQuN8A&oe=69FC9058"}, {"file_name": "Screenshot 2025-02-19 at 14.56.05.png", "id": "25652228037715697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819464_25652228044382363_5730527552521063876_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmwC1-3tVswQ7kNvwETRWA_&_nc_oc=AdppeVqDXnpEDnrocHrH1_2mMXX8NgErTWnzHXi_VmOlvqBmRn0TpZbyOoV-pwemwMQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59vx3nTBrbE1yCT-3PkvszEh0ka956RV7regL-K9okUQ&oe=69FCA9C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "2105423356657529", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828038_2105423363324195_5090811876925984097_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUSFUUFQiEgQ7kNvwH_yE0q&_nc_oc=Adpnvh2lHfHKwu7y_bo_yCQidxJ3gI1FInooD7NVewyZLcW45VaokDHLKYZPbHO01e4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7olCzANAcIUt69qHHX4Tly5AK2bM6xsKUtNNJwUsYNNQ&oe=69FC9D9F"}, "display_name": "Among Giants", "keywords": ["climbing", "swinging", "bows", "giants", "adventure"], "long_description": "Among Giants is an open-world game where the player gets to explore the planet at their own pace, deciphering the alien language to get a better understanding of what has happened to humanity by hunting down colossal giants that roam the world and extracting their final memories.\n\n# The Giants and Others\nSome of the giants you will hunt and take them down\n{824636457215828}\nThe game has over 10 different types of enemies you will encounter from smaller Droids to a huge Spider Queen\n{830767046537926}\n\n# Meet R-011\nBefriend a feisty tiny Roller Droid, your gateway to understanding this world who will eventually be your closest ally. R-011 will be your Hacker, your Protector and your Friend\n{1332849368154885}\n\n# Your Horse\nExplore the huge alien world by riding your trusty steed. You can call for your horse anywhere with your Horn\n{1412359163842124}\n\n# Your Bow & Arrow\nFind special Quivers for your bow to help tackle those tricky targets\n{1617153256329705}\n\n# Grappling Hooks\nTraverse across the land using your grappling hooks and also use them to break open crates\n{875307924930249}\n\n# Gliding\nOutstretch your arms to glide your way to safety or distant platforms\n{1292691869326168}\n\n# Other Weapons\nThere are many other types of weaponry found in the world but use them wisely as they cannot be reloaded\n{827696256535054}\n\n# Hack Terminals & Locks\nDecipher the alien language a character at a time by hacking terminals and also break into buildings and gates by pick locking\n{1394160675459015}\n\n# Realtime Day & Night with Weather Systems\nThe battleground changes constantly when the day turns to night. Fight through heavy rain, a freezing blizzard and even in a scorching desert\n{1885682562347865}", "short_description": "You are Erya, the lone wanderer on a desolate world. You awaken among colossal giants, with their slow, deliberate movements resembling ancient deities. The world is scattered with robot relics, frozen in anguish, remnants of a lost civilization destroyed by a divine event. Can you uncover a connection between the giants, the planet, and your own origins?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://kmonkeygames.com/games/among-giants/among-giants-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "K Monkey Games", "support_website_url": null, "website_url": "http://www.kmonkeygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25060508513595891"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "i
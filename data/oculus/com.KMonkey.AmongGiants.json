i": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820887_765690843154326_4213525441979447950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHUc-mi7GLoQ7kNvwFjLUYV&_nc_oc=Adp2Wjd2d-Ls4bnIsqazIc5s9ioCBDkls5eoMYfgvwyTxhzHI2o4hICH1Ec_-IAk_04&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYxUArz0QZyaa7OGGDAyLmVTAWMub6Tvs980nDVDJYgw&oe=6AA17EB6"}, {"file_name": "Screenshot 2025-11-14 at 21.04.25.png", "id": "1066416112168052", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819323_1066416115501385_8039787634958319750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZ0GaMLbxGcQ7kNvwH_Yo1H&_nc_oc=Adrx7tg8pOktL3jnUFvd5j3wbguu5Uvdt_LxTzpjBB-qNlzemVhjtkykQEt4V01AzLc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3KNQ7cgp4um1clilLbWT00HoGgepOZSNeXfGKyXzmdw&oe=6AA16A51"}, {"file_name": "Screenshot 2025-11-16 at 11.10.54.png", "id": "827196230279662", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499298291_827196233612995_1820748001195304311_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSd2kloUNEsQ7kNvwEMiNJm&_nc_oc=AdrGmtadQX4ySz5vs3p-f1JTZkWI3e0cZQRRGKAaIl0Gv8ZkpeBPYa1W511J9UMs8oo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-hrapsVoZDWZ3s7Qg_BRFD2nvwPGOg__2L8SHUzfM8Q&oe=6AA1674C"}, {"file_name": "Screenshot 2025-04-01 at 19.31.53.png", "id": "1164091195235792", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_1164091198569125_6812339530692988798_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfQF_RAZxaMQ7kNvwHfTnGK&_nc_oc=AdoCdVvqeXWm0mtRPy0lMZfB_ITjeJC3dCsu3wmSestdBIyxDiY0PlpNbtswGy9waVc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxtuYEdy1yUrhd0tY1n8h05cectOws3V3mekboE-5KJw&oe=6AA15BD8"}, {"file_name": "Screenshot 2025-02-19 at 14.56.05.png", "id": "25652228037715697", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819464_25652228044382363_5730527552521063876_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hE_DX8uZUmsQ7kNvwEVsLsR&_nc_oc=AdpDTnsmr7Tz4SIwfTWhRR4YtYqhmJ7BZpyZDAdpz6t7-9DoeX0BMpzvBJJ8sBBvXIk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd0GsP-OginNTJenxTQ9euMBEhEmtQEPjspaWQVarrww&oe=6AA17544"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "2105423356657529", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828038_2105423363324195_5090811876925984097_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooVWh45bmzYQ7kNvwHXxnOh&_nc_oc=AdpbUXMDnUTM6Z4yZ3aAi16cWQ8b4dcf3ugfivXgwwsjU-bIFbxvHWlPJg-jgsmUoMM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYmaBhr9czrgk21DoqK6bAtEq4uz_QWK0W5WSLQMkj7A&oe=6AA1691F"}, "display_name": "Among Giants", "keywords": ["climbing", "swinging", "bows", "giants", "adventure"], "long_description": "Among Giants is an open-world game where the player gets to explore the planet at their own pace, deciphering the alien language to get a better understanding of what has happened to humanity by hunting down colossal giants that roam the world and extracting their final memories.\n\n# The Giants and Others\nSome of the giants you will hunt and take them down\n{824636457215828}\nThe game has over 10 different types of enemies you will encounter from smaller Droids to a huge Spider Queen\n{830767046537926}\n\n# Meet R-011\nBefriend a feisty tiny Roller Droid, your gateway to understanding this world who will eventually be your closest ally. R-011 will be your Hacker, your Protector and your Friend\n{1332849368154885}\n\n# Your Horse\nExplore the huge alien world by riding your trusty steed. You can call for your horse anywhere with your Horn\n{1412359163842124}\n\n# Your Bow & Arrow\nFind special Quivers for your bow to help tackle those tricky targets\n{1617153256329705}\n\n# Grappling Hooks\nTraverse across the land using your grappling hooks and also use them to break open crates\n{875307924930249}\n\n# Gliding\nOutstretch your arms to glide your way to safety or distant platforms\n{1292691869326168}\n\n# Other Weapons\nThere are many other types of weaponry found in the world but use them wisely as they cannot be reloaded\n{827696256535054}\n\n# Hack Terminals & Locks\nDecipher the alien language a character at a time by hacking terminals and also break into buildings and gates by pick locking\n{1394160675459015}\n\n# Realtime Day & Night with Weather Systems\nThe battleground changes constantly when the day turns to night. Fight through heavy rain, a freezing blizzard and even in a scorching desert\n{1885682562347865}", "short_description": "You are Erya, the lone wanderer on a desolate world. You awaken among colossal giants, with their slow, deliberate movements resembling ancient deities. The world is scattered with robot relics, frozen in anguish, remnants of a lost civilization destroyed by a divine event. Can you uncover a connection between the giants, the planet, and your own origins?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://kmonkeygames.com/games/among-giants/among-giants-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "K Monkey Games", "support_website_url": null, "website_url": "http://www.kmonkeygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_mo
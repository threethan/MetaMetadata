7401809_1637495721636630479_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anSFKewsC44Q7kNvwFHmrMZ&_nc_oc=Adp-deNsXTTP19eYgBNa4loLQSow30UDGvrK4VbDKu8_VadHqIBX_RuDLQsjZzd1kRE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXcxuwqG_V-ccpIlpYIIDWGzORbPU0McTp3opBDSlPEA&oe=6AFC6F03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flight Unlimited", "keywords": ["Flight", "Sim", "Pilot", "Aviation", "Airplane"], "long_description": "Soar across beautiful skies in Flight Unlimited.   \nThe first full fledged flight simulator for the Meta Quest.\n\nFeatures:\n\n- Fly anywhere in the world \n\n- 4K HD Cockpits for each aircraft modeled from the ground up\n\n- Campaign style missions\n\n- 14 aircraft each modeled with accurate flight physics and cockpit.   \n\n   - Boeing 747\n\n  -  B2 Spirit\n\n   - Ultralight \n\n   - F-22\n\n   - C130 Hercules\n\n   - E2C Hawkeye\n\n   - F/A-18 Hornet\n\n   - Cessna 172\n\n   - A10 Thunderbolt\n\n   - Pitts Special\n\n   - Challenger Learjet\n\n   - Douglas DC3\n\n   - Curtis P40E\n\n   - Robin DR400", "short_description": "Soar across beautiful skies of Flight Unlimited in 14 aircraft.\nThe first full fledged flight simulator for the Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems", "support_website_url": null, "website_url": "https://tasappsystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"
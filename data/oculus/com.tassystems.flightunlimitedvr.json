.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0P_613l9lkQ7kNvwEiuvPY&_nc_oc=Adr_V8hYCRF8Feu7xkdSEQ3r2aWp-NYI0olyW-xsGmPUfgyqt5Cwqs6SPwvgKhNQxlc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLDdqjSxuywh-F70GXUMr1VMkdJBKtoFPFaYJRPd_Daw&oe=6A6F5E83"}, {"file_name": "5.png", "id": "2221034668405003", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830411_2221034671738336_5039267090405582928_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=met2LmwW2gkQ7kNvwGPo8_v&_nc_oc=AdrkJRqSPDEmyS7wPPZ1hl2S5rqiB26lPxkQ35eStsJrDe9_w0eZjPT-lS-7Wv91d0g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY0HGj1HPPSfQVLesr3zBm9i2G1TeS7P_3_eVVCglP8A&oe=6A6F36BB"}, {"file_name": "Screen6.png", "id": "1577649393551122", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619808_1577649396884455_8428162596796207091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OW-GohpjDYQ7kNvwGQSdU2&_nc_oc=AdrUUEPdmyautxnO2XIugPtbTqThA1ToPiML8t4DBqKzaGX5DatwjDUZXIG3iv6zQ1I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMU3hzaBPouCAX7wpELFyCvzxYC70d4cuBI_y9VYxyQw&oe=6A6F4972"}, {"file_name": "3.png", "id": "2167667490709294", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499314660_2167667494042627_3515461665461979003_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3I9cLl0el0oQ7kNvwEuq0A6&_nc_oc=AdqTQydGpGzkiy1dFDlcxBgVkTR6gfAvIloygyTT9xsCd4KXhcFlHjpDofWvqi1TUgo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBb8do_3iuqjYSqlRN11N4FdSbj6HKUpzhzgxBuf-WU5g&oe=6A6F5B93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_new_text.png", "id": "997016826223335", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300575_997016829556668_6043501756101622_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8w3aRVA0HjMQ7kNvwEzu_1a&_nc_oc=AdpSLCV8TUiRG4pl1Ksx0GyPp_4mV0Jej6I6iupXWOu0yKqOjeoQ0z1guObY78z1N9s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNUQsG4uGIjglEGijzznXb21tEubF1n79j__8KQH8BYw&oe=6A6F4C50"}, "display_name": "Flight Unlimited - Flight Simulator", "keywords": ["Flight", "Sim", "Aviation", "Airplane", "Simulator"], "long_description": "Soar across beautiful skies in Flight Unlimited.   \nThe first full fledged flight simulator for the Meta Quest.\n\nFlight Unlimited uses advanced optimization techniques to bring console and PC quality visuals to the Quest.  \n\n**Early Access**\n\nFlight Unlimited is in Early Access.  This means the game will be updated frequently with content, feature updates, and bug fixes.  \nPlayer input is encouraged.  Thank you for your support as we work towards building the ultimate Flight Simulator on the Quest.\n\nThe early access price is discounted. The full release will be $39.99\n\n**Quest 3 vs Quest 2**\n\nThe game has improved graphics and draw distance on Quest 3, but runs on Quest 2 with reduced graphics settings.\n\n**Flight Model**\n\nAAA flight simulation physics with realistic aerodynamics, engines and aircraft components.  All forces on the aircraft are calculated in real time based on standard aerodynamic principles and formulas. \n\nThe Flight Model is going through constant updates. We're aware of current bugs and are improving the model. \n\n{2146741272399517}\n\n**Locations**\n- Grand Canyon \n{4197498873837275}\n- Mt Everest\n{1177769114498097}\n- San Francisco Bay Area (SFO, SJC, Moffet Field)\n{2592872007742636}\n\n**Features**\n- 4K HD Cockpits for each aircraft modeled from the ground up\n{1784923008949150}\n- Hand modeled airports and scenery \n{1578837809918429}\n- Unique Activities (coming in 2 weeks)\n- Missions (Coming Soon)\n- Hand Tracking (Coming Soon)\n- Multiplayer (Coming Soon)\n\n**Aircraft**\n\n- Boeing 747\n- B2 Spirit (coming soon)\n- Ultralight (coming soon)\n- C130 Hercules\n- F/A-18 Hornet\n- Cessna 172\n- Pitts Special\n- Challenger Learjet\n- Douglas DC3\n- Curtis P40E", "short_description": "Flight Unlimited is a first of its kind Flight Simulator for the Quest.  Soar across beautiful skiesin 10 aircraft.  This aims to be the first full fledged flight simulator for the Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems", "support_website_url": null, "website_url": "https://tasappsystems.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26723335743962646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307451_1543825287161538_4077866005202121410_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frxSMkLL9dwQ7kNvwGDgM32&_nc_oc=Ado6vt1JZ2XKQmqNMATUESaujIPrQRTZkeiLeR4JlF0SmsgRai7PPo17UFTjoAPWv1I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7b4tjMXqs9Vu89EDQaDOQWAksPm9pO8aKtY7Qn9-ayw&oe=6A6F3AB3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flight Unlimited - Flight Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1765476000, "lastRevision": 
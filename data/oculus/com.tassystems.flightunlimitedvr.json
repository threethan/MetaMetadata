 C130 Hercules\n\n   - E2C Hawkeye\n\n   - F/A-18 Hornet\n\n   - Cessna 172\n\n   - A10 Thunderbolt\n\n   - Pitts Special\n\n   - Challenger Learjet\n\n   - Douglas DC3\n\n   - Curtis P40E\n\n   - Robin DR400", "short_description": "Soar across beautiful skies of Flight Unlimited in 14 aircraft.\nThe first full fledged flight simulator for the Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems", "support_website_url": null, "website_url": "https://tasappsystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10048506845205465"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "2066521143981115"}, {"status": "PUBLISHED", "id": "984921701052725"}, {"status": "PUBLISHED", "id": "1053977651137167"}, {"status": "PUBLISHED", "id": "2736763206673803"}, {"status": "PUBLISHED", "id": "1200942928790662"}, {"status": "PUBLISHED", "id": "838176302316706"}, {"status": "PUBLISHED", "id": "1598952957786390"}, {"status": "PUBLISHED", "id": "1518646442745053"}, {"status": "PUBLISHED", "id": "1522275862319755"}, {"status": "PUBLISHED", "id": "1450987863257063"}, {"status": "PUBLISHED", "id": "3888534171369025"}, {"status": "PUBLISHED", "id": "1953130591912167"}, {"status": "PUBLISHED", "id": "847630657625923"}, {"status": "PU
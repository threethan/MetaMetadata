_G5iJTqc7g_eKgpkK1P8SpbHUbVLWEO1SKjDH_Hw&oe=69986D47"}, {"file_name": "Screen6.png", "id": "1577649393551122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_1577649396884455_8428162596796207091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ofLL7Rhzw0Q7kNvwFQxL26&_nc_oc=AdmjgWvxwlOM8Dx4GhDBUNB9Wllcn4_k1yiKYjX6wUfgCun_Mdl6xOlhTIn96pdW-qk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvgdytEiavu2qg_JtFLR0aDV_v6B3sfTS2ECf8tfn7lbg&oe=699864F2"}, {"file_name": "Screen3.png", "id": "1504580904068476", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499305164_1504580907401809_1637495721636630479_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCWJm4FY04YQ7kNvwHZhZtm&_nc_oc=Adl7Wmh3UuoIopZ2I0dr2yjdAqMEk6m4hudlVJTwBHrkiqc62Z04W291ZkVhKeM24Fc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afutgc2dtXlXtqwlSUNeaxsxEMXrwqxT7-mf8Tjag3LUhw&oe=699841C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flight Unlimited", "keywords": ["Flight", "Sim", "Pilot", "Aviation", "Airplane"], "long_description": "Soar across beautiful skies in Flight Unlimited.   \nThe first full fledged flight simulator for the Meta Quest.\n\nFeatures:\n\n- Fly anywhere in the world \n\n- 4K HD Cockpits for each aircraft modeled from the ground up\n\n- Campaign style missions\n\n- 14 aircraft each modeled with accurate flight physics and cockpit.   \n\n   - Boeing 747\n\n  -  B2 Spirit\n\n   - Ultralight \n\n   - F-22\n\n   - C130 Hercules\n\n   - E2C Hawkeye\n\n   - F/A-18 Hornet\n\n   - Cessna 172\n\n   - A10 Thunderbolt\n\n   - Pitts Special\n\n   - Challenger Learjet\n\n   - Douglas DC3\n\n   - Curtis P40E\n\n   - Robin DR400", "short_description": "Soar across beautiful skies of Flight Unlimited in 14 aircraft.\nThe first full fledged flight simulator for the Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher
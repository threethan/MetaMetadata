aXV86S8DALLu0xeq7i6fc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqy0gAzYDNzsxlDCdQoGyJmp9T4VCFSa15cciJtIxbdw&oe=6AD23F03"}, {"file_name": "5.png", "id": "2221034668405003", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830411_2221034671738336_5039267090405582928_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIRez1pEHrkQ7kNvwEiEQEc&_nc_oc=AdoczX00kPgw23iCT9hotR46JCqXdmPHdYz8Eev1-P-60x2Bda4weewhxq5i8726078&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXpynkGkHjA9rPx4XhlIp1Xh4-c2RWjfbzXKfQAJBz-Q&oe=6AD24F7B"}, {"file_name": "Screen6.png", "id": "1577649393551122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_1577649396884455_8428162596796207091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wquNhWQWe00Q7kNvwF6K9K2&_nc_oc=AdqH39BWvdFbnafohIKO_Z989vhR1w9Me5RigIkiB3MUWKHER8PiRRU3KmfkugCPx7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMI7lAzzlg3X6u7YgaNGkpOMyn-r5XBsTuL-LIqSYY0yQ&oe=6AD229F2"}, {"file_name": "3.png", "id": "2167667490709294", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314660_2167667494042627_3515461665461979003_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmJZi6FbxJAQ7kNvwFrJjn3&_nc_oc=Adr8-SBmusr3x0V6s2q8-9QPSxBYLGCqGdY0CihFvuTVS5cfF_gcQeRwF0cXBFObGcY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP51g8cXA76-v7riJVMElr3xchJwbE1SooCTCdVAZiGcw&oe=6AD23C13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_new_text.png", "id": "997016826223335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300575_997016829556668_6043501756101622_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_X_PngaRvgQ7kNvwFO0D6X&_nc_oc=Adr6CLFSA0L1RY-7tSplg6mlaMr7ulBHr7cX-PaR9i6kx0DrtRsJKz1HCpfDqyQn-JE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvwCpZLznWAKhfa3MUh8JJSAXkz4zbvtuHscvYcPXPmg&oe=6AD22CD0"}, "display_name": "Flight Unlimited - Flight Simulator", "keywords": ["Flight", "Sim", "Aviation", "Airplane", "Simulator"], "long_description": "Soar across beautiful skies in Flight Unlimited.   \nThe first full fledged flight simulator for the Meta Quest.\n\nFlight Unlimited uses advanced optimization techniques to bring console and PC quality visuals to the Quest.  \n\n**Early Access**\n\nFlight Unlimited is in Early Access.  This means the game will be updated frequently with content, feature updates, and bug fixes.  \nPlayer input is encouraged.  Thank you for your support as we work towards building the ultimate Flight Simulator on the Quest.\n\nThe early access price is discounted. The full release will be $39.99\n\n**Quest 3 vs Quest 2**\n\nThe game has improved graphics and draw distance on Quest 3, but runs on Quest 2 with reduced graphics settings.\n\n**Flight Model**\n\nAAA flight simulation physics with realistic aerodynamics, engines and aircraft components.  All forces on the aircraft are calculated in real time based on standard aerodynamic principles and formulas. \n\nThe Flight Model is going through constant updates. We're aware of current bugs and are improving the model. \n\n{2146741272399517}\n\n**Locations**\n- Grand Canyon \n{4197498873837275}\n- Mt Everest\n{1177769114498097}\n- San Francisco Bay Area (SFO, SJC, Moffet Field)\n{2592872007742636}\n\n**Features**\n- 4K HD Cockpits for each aircraft modeled from the ground up\n{1784923008949150}\n- Hand modeled airports and scenery \n{1578837809918429}\n- Unique Activities (coming in 2 weeks)\n- Missions (Coming Soon)\n- Hand Tracking (Coming Soon)\n- Multiplayer (Coming Soon)\n\n**Aircraft**\n\n- Boeing 747\n- B2 Spirit (coming soon)\n- Ultralight (coming soon)\n- C130 Hercules\n- F/A-18 Hornet\n- Cessna 172\n- Pitts Special\n- Challenger Learjet\n- Douglas DC3\n- Curtis P40E", "short_description": "Flight Unlimited is a first of its kind Flight Simulator for the Quest.  Soar across beautiful skiesin 10 aircraft.  This aims to be the first full fledged flight simulator for the Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems", "support_website_url": null, "website_url": "https://tasappsystems.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26723335743962646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307451_1543825287161538_4077866005202121410_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr9RQY1vKWoQ7kNvwG8JKPp&_nc_oc=AdrVxwCaa1CymVEOJhvRFi2rB0-39wK_0X1GhA_ged4gfx0ESE7JHIwzf71lJkeltyw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoOqiAsYNVqNDieS_7cSyYrzkcKK-nORrOnOxk6rwToA&oe=6AD25373"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flight Unlimited - Flight Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1765476000, "lastRevision": {"nodes": [{"id": "10048506868538796", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"ap
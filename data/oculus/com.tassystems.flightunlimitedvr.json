Sou3VFEogGJkjDSsPX34POIuuIyBRhdIMFhnvKMcBzfv3SqWsjqJ46s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29n3hRvOEhfI4nyA4AQytDIwt1h3iRClH1tuexJQh4zg&oe=69DE2143"}, {"file_name": "5.png", "id": "2221034668405003", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830411_2221034671738336_5039267090405582928_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTUzUqBkXz4Q7kNvwGDdYKq&_nc_oc=AdpXfGkeBUvsdRWdYL7IFFRm1SJvN0LPNUojK2WbXtY38X9qlUF3AcZl_h_3l045fxs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3K5apndQA2hrVtcZm9tvn8ZBDTr_Lr1xy0sNuGOmg1IA&oe=69DE31BB"}, {"file_name": "Screen6.png", "id": "1577649393551122", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619808_1577649396884455_8428162596796207091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4cjWVVpsToQ7kNvwHUaP0o&_nc_oc=AdraLtTevm5go4Px9jgpxaCs9lL53tV0jTbAKftl65bGpbL1MitN9OMF_s82SZbTZQc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0l9CNkv7BYOTuJeK_Yxz992mrk1_cdjVUrL9jlrPQJOg&oe=69DE4472"}, {"file_name": "3.png", "id": "2167667490709294", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314660_2167667494042627_3515461665461979003_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCTw_7OQlOUQ7kNvwGkdetc&_nc_oc=AdrFsxGhF1Ir8n__ANWywJuaM5eheUZNWDnZcOZjHwFkOJa-msVQT1v4y8HMTt0_zzA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-UE3yQjHWgkz-WhPrwpaybbywmVGAu-VAD-8DCRADFg&oe=69DE5693"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbupdate.png", "id": "1898340827395694", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308349_1898340830729027_336201419954198523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucjOYPB048kQ7kNvwHBlIw2&_nc_oc=Adomw8UwqsdpoAf-hfl6rzdRyTUgKMGg2ZQqQAfyTC3d7nJNPkCRxvuGN6LvpUDV5aQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JwriIvGnDgJQovGcxeoplXl1uNn_aANclLbGZSNpBeg&oe=69DE54D4"}, "display_name": "Flight Unlimited - Flight Simulator", "keywords": ["Flight", "Sim", "Aviation", "Airplane", "Simulator"], "long_description": "Soar across beautiful skies in Flight Unlimited.   \nThe first full fledged flight simulator for the Meta Quest.\n\nFlight Unlimited uses advanced optimization techniques to bring console and PC quality visuals to the Quest.  \n\n**Early Access**\n\nFlight Unlimited is in Early Access.  This means the game will be updated frequently with content, feature updates, and bug fixes.  \nPlayer input is encouraged.  Thank you for your support as we work towards building the ultimate Flight Simulator on the Quest.\n\nThe early access price is discounted. The full release will be $39.99\n\n**Quest 3 vs Quest 2**\n\nThe game has improved graphics and draw distance on Quest 3, but runs on Quest 2 with reduced graphics settings.\n\n**Flight Model**\n\nAAA flight simulation physics with realistic aerodynamics, engines and aircraft components.  All forces on the aircraft are calculated in real time based on standard aerodynamic principles and formulas. \n\nThe Flight Model is going through constant updates. We're aware of current bugs and are improving the model. \n\n{2146741272399517}\n\n**Locations**\n- Grand Canyon \n{4197498873837275}\n- Mt Everest\n{1177769114498097}\n- San Francisco Bay Area (SFO, SJC, Moffet Field)\n{2592872007742636}\n\n**Features**\n- 4K HD Cockpits for each aircraft modeled from the ground up\n{1784923008949150}\n- Hand modeled airports and scenery \n{1578837809918429}\n- Unique Activities (coming in 2 weeks)\n- Missions (Coming Soon)\n- Hand Tracking (Coming Soon)\n- Multiplayer (Coming Soon)\n\n**Aircraft**\n\n- Boeing 747\n- B2 Spirit (coming soon)\n- Ultralight (coming soon)\n- C130 Hercules\n- F/A-18 Hornet\n- Cessna 172\n- Pitts Special\n- Challenger Learjet\n- Douglas DC3\n- Curtis P40E", "short_description": "Flight Unlimited is a first of its kind Flight Simulator for the Quest.  Soar across beautiful skiesin 10 aircraft.  This aims to be the first full fledged flight simulator for the Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems", "support_website_url": null, "website_url": "https://tasappsystems.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25832502086379354"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307962_2375913932847891_8470279450471247145_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BL6lAElPCZ0Q7kNvwGRB2pY&_nc_oc=AdpLhp7tIYdrZQHs7MRlld2rgy4uEC2fI8qSPwIELRyDnfCI85ENbmtI0pxKJaQzP7Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zdeZjkOS6CKLFPnj2ZWoOF3AweixyPLOh0kXASNiMkQ&oe=69DE4291"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flight Unlimited - Flight Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1765476000, "lastRevision": {"nodes": [{"id": "10048506868538796", "release_type": "SCHEDULED", "administration_status
39267090405582928_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJ9tEyxxsjUQ7kNvwHbZSMJ&_nc_oc=AdnXhuZPmWoqz0uoqX_Ui0rxAAQxfa-pgTl7GXhP7Ko-L6WbGwtA_V17QFNy3Pvt0Qw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsdNZSGSpj5Mmgl620oLd8AJuXrUcbT6zZyBMeL4urS4g&oe=699D983B"}, {"file_name": "Screen6.png", "id": "1577649393551122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_1577649396884455_8428162596796207091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0d5CT7ZOxcQ7kNvwEHuACk&_nc_oc=AdmWHfgKajut99C12xrrS6RjoFEh2gg43al-0JsMLWT2iKeuJhC7KGQAGWHpjLPFO-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftKyU6L8v0nO5drPcAk1pUMnvqSJH8HXGNPnFRaA4B4Vg&oe=699DAAF2"}, {"file_name": "3.png", "id": "2167667490709294", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314660_2167667494042627_3515461665461979003_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vF4WFcW5GOkQ7kNvwFbVSKG&_nc_oc=Adlc_oqOR03wuvYYZCVrpC-gbdw7Ok6-0nAOvy2b9YDiVXL1SvrrTLmZ83mxGfG71dM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfudVzdfOiCnSQrcpUQlfjIcib7yxazs3-9UHGx8dLmd6Q&oe=699D84D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbupdate.png", "id": "1898340827395694", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308349_1898340830729027_336201419954198523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1N1ijL2L3NcQ7kNvwF9eZMF&_nc_oc=AdkGROAuCDQYM2_UJ62SbNKEd6gbgOrsyU1w89OCv2B-bsc6_dvt5vy0ajKoVn3JSKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfufdPgmrN3ZrTzGxqL3-ArubEzHFuBIUcDdIAlpKlfUMw&oe=699D8314"}, "display_name": "Flight Unlimited - Flight Simulator", "keywords": ["Flight", "Sim", "Aviation", "Airplane", "Simulator"], "long_description": "Soar across beautiful skies in Flight Unlimited.   \nThe first full fledged flight simulator for the Meta Quest.\n\nFlight Unlimited uses advanced optimization techniques to bring console and PC quality visuals to the Quest.  \n\n**Early Access**\n\nFlight Unlimited is in Early Access.  This means the game will be updated frequently with content, feature updates, and bug fixes.  \nPlayer input is encouraged.  Thank you for your support as we work towards building the ultimate Flight Simulator on the Quest.\n\nThe early access price is discounted. The full release will be $39.99\n\n**Quest 3 vs Quest 2**\n\nThe game has improved graphics and draw distance on Quest 3, but runs on Quest 2 with reduced graphics settings.\n\n**Flight Model**\n\nAAA flight simulation physics with realistic aerodynamics, engines and aircraft components.  All forces on the aircraft are calculated in real time based on standard aerodynamic principles and formulas. \n\nThe Flight Model is going through constant updates. We're aware of current bugs and are improving the model. \n\n{2146741272399517}\n\n**Locations**\n- Grand Canyon \n{4197498873837275}\n- Mt Everest\n{1177769114498097}\n- San Francisco Bay Area (SFO, SJC, Moffet Field)\n{2592872007742636}\n\n**Features**\n- 4K HD Cockpits for each aircraft modeled from the ground up\n{1784923008949150}\n- Hand modeled airports and scenery \n{1578837809918429}\n- Unique Activities (coming in 2 weeks)\n- Missions (Coming Soon)\n- Hand Tracking (Coming Soon)\n- Multiplayer (Coming Soon)\n\n**Aircraft**\n\n- Boeing 747\n- B2 Spirit (coming soon)\n- Ultralight (coming soon)\n- C130 Hercules\n- F/A-18 Hornet\n- Cessna 172\n- Pitts Special\n- Challenger Learjet\n- Douglas DC3\n- Curtis P40E", "short_description": "Flight Unlimited is a first of its kind Flight Simulator for the Quest.  Soar across beautiful skiesin 10 aircraft.  This aims to be the first full fledged flight simulator for the Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems", "support_website_url": null, "website_url": "https://tasappsystems.com/", "category": "GAMES", "comfort_rating": "COMFORTABL
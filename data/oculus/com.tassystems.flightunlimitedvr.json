39267090405582928_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJ9tEyxxsjUQ7kNvwHLdEoL&_nc_oc=AdmJvP3Tn3dMZAMrqw3VYff-lXtjFEM3zsBpcYnux7IczbhYC2Ai6QyXIkv1WURsCUo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvXIQy3uBRlfy3-ed8Me8qnn0ttTaMfDeJ9heP1xPP9_w&oe=699C46BB"}, {"file_name": "Screen6.png", "id": "1577649393551122", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619808_1577649396884455_8428162596796207091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0d5CT7ZOxcQ7kNvwF2dfag&_nc_oc=AdkbHMYPzMRtFOZH0uWv1iDPWMiVpN4dq9M_lcNFYhsE1DI8sO1odWhEL7ZZJVr5J_Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftrMTRHQXAcNu8N0xw7EF6J1XDDtnuzZ9yiYIu6zHazPg&oe=699C5972"}, {"file_name": "3.png", "id": "2167667490709294", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_2167667494042627_3515461665461979003_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epn9fy-I1FkQ7kNvwH--rVQ&_nc_oc=AdnClEWXk3CNSMHGl8ROv-ymUwxbISTgbbzjjqh1HZNqYHPLeifHk9OAxfykm7W8LMQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuPkjyvs2Ml7FmBoviupgH7v-MJPvkgsxu_TBhfyDAjrg&oe=699C3353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbupdate.png", "id": "1898340827395694", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308349_1898340830729027_336201419954198523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1N1ijL2L3NcQ7kNvwH4jl42&_nc_oc=AdmUsf0JrcDtGm6WGoJRPUNylFDaCz8o4RDl8jB3CEcdgcdZvMAV8WePm057nUc64bU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftBGuiEoI1_q78fU8jlDtRVzEPPLtVqzFU__Ejkxn4miw&oe=699C3194"}, "display_name": "Flight Unlimited - Flight Simulator", "keywords": ["Flight", "Sim", "Aviation", "Airplane", "Simulator"], "long_description": "Soar across beautiful skies in Flight Unlimited.   \nThe first full fledged flight simulator for the Meta Quest.\n\nFlight Unlimited uses advanced optimization techniques to bring console and PC quality visuals to the Quest.  \n\n**Early Access**\n\nFlight Unlimited is in Early Access.  This means the game will be updated frequently with content, feature updates, and bug fixes.  \nPlayer input is encouraged.  Thank you for your support as we work towards building the ultimate Flight Simulator on the Quest.\n\nThe early access price is discounted. The full release will be $39.99\n\n**Quest 3 vs Quest 2**\n\nThe game has improved graphics and draw distance on Quest 3, but runs on Quest 2 with reduced graphics settings.\n\n**Flight Model**\n\nAAA flight simulation physics with realistic aerodynamics, engines and aircraft components.  All forces on the aircraft are calculated in real time based on standard aerodynamic principles and formulas. \n\nThe Flight Model is going through constant updates. We're aware of current bugs and are improving the model. \n\n{2146741272399517}\n\n**Locations**\n- Grand Canyon \n{4197498873837275}\n- Mt Everest\n{1177769114498097}\n- San Francisco Bay Area (SFO, SJC, Moffet Field)\n{2592872007742636}\n\n**Features**\n- 4K HD Cockpits for each aircraft modeled from the ground up\n{1784923008949150}\n- Hand modeled airports and scenery \n{1578837809918429}\n- Unique Activities (coming in 2 weeks)\n- Missions (Coming Soon)\n- Hand Tracking (Coming Soon)\n- Multiplayer (Coming Soon)\n\n**Aircraft**\n\n- Boeing 747\n- B2 Spirit (coming soon)\n- Ultralight (coming soon)\n- C130 Hercules\n- F/A-18 Hornet\n- Cessna 172\n- Pitts Special\n- Challenger Learjet\n- Douglas DC3\n- Curtis P40E", "short_description": "Flight Unlimited is a first of its kind Flight Simulator for the Quest.  Soar across beautiful skiesin 10 aircraft.  This aims to be the first full fledged flight simulator for the Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems", "support_website_url": null, "website_url": "https://tasappsystems.com/", "category": "GAMES", "comfort_rating": "COMFORTABL
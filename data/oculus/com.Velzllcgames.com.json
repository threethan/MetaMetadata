YQ0UX9Tb4hJIg&oe=6A3A8CDF"}, {"file_name": "Screenshot 2026-05-11 220734_2980x1490.png", "id": "1491081739470340", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499292329_1491081742803673_5872130718581109008_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8y8A9zScwngQ7kNvwGpIRNU&_nc_oc=AdrUi4CNfnlYnRY0kMV-ty5MVe-sS2JqlxDVFCc1Y4xKNzkSlQZwlO0q8ds2nyg_J-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iKn4G0EOSjccGpLRd0t-r2B4JoQCbGCPFPATvT1w7hg&oe=6A3A979B"}, {"file_name": "Screenshot 2026-05-11 220709_3000x3000.png", "id": "1638355460752961", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312310_1638355464086294_5532008109845508954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fiun_bigzacQ7kNvwE1y-5Z&_nc_oc=Adr3U_ZY_0Wm9dO6uFVZWsQaSIwCnzuAeNH1kto1Rmlqta04SDgnk0TsCF4yYBCFO6Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pyonRUXgj-m961uSOTKeo_Bfi16blI6rCA7T3HlYEWg&oe=6A3AAF86"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillin VR", "keywords": [], "long_description": "Gorillin VR is a high\u2011energy, movement\u2011driven tag experience where players become agile gorillas and race through vibrant low\u2011poly environments using pure physical locomotion. Built for fast reactions and creative movement, the game lets you run, climb, vault, and swing using only your hands, giving you full control over your speed and momentum. Whether you\u2019re chasing friends or escaping them, every match feels different thanks to dynamic routes, branching paths, and open\u2011ended traversal.\n\nExplore handcrafted maps filled with platforms, trees, caves, and hidden shortcuts designed to reward skillful movement. Customize your gorilla, join public lobbies, or play casually with friends in private rooms. Gorillin VR focuses on fun, accessibility, and replayability, offering a playful world where anyone can jump in and instantly understand the goal: don\u2019t get tagged.\n\nWith smooth multiplayer, expressive locomotion, and a lively community vibe, Gorillin VR delivers a fast, social, and endlessly entertaining VR playground built for players who love to move.", "short_description": "Gorillin VR is a fast\u2011paced, movement\u2011based tag game where players swing, climb, and chase each other through vibrant low\u2011poly environments as agile gorilla characters. Master your momentum, outplay your friends, and explore a playful world built for high\u2011energy VR fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1TY5P-UujaD-xg_u_DQNEFavg5YmW_WaRS33bjzLzv_U/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Velz", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1TY5P-UujaD-xg_u_DQNEFavg5YmW_WaRS33bjzLzv_U/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27397178139867837"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824700_1490621555937158_5783499510939259602_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6o_IMHrYFuUQ7kNvwFHNhN8&_nc_oc=Adqv4p9NezRF5mWF75QH9sG_m9aSmEXg9YeVemvXc6KpysnPVwqB6GH0VqTzfuqSjqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GuqNGfdQNeGXDAjWwQG
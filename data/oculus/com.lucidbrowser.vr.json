-QD0PKOv7tWrkrlDQ9i9OwEQOtC1AFOpTrFG3-U4SgU8I1PI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLk9SPX49t8aucexWKsO7gCE2FXfZHGxVTaXODue_ZkQ&oe=6AE0A4E6"}, {"file_name": "03_menu.png", "id": "1142940881429131", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821704_1142940888095797_5951025591278441618_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTZA8iAUltYQ7kNvwGzaVG3&_nc_oc=Adqk60NPB6pNfpq82G2uzzWrcDtGytc9IBIMO1kAR8nDetAHM6rrXztBGQ8QzKEEZKA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKoqXqYSWUPnFrP4yT1uD0SzsQkGtp6zheNMEIC9UCNg&oe=6AE0B3B9"}, {"file_name": "04_video_3d.png", "id": "28806338792380466", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827960_28806338809047131_9069363056957760579_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBJDGy3qGK0Q7kNvwFUITRX&_nc_oc=Adp3j4Esvf03G83tSXE81s2-lDzD3k8fUazPfxrL-u-cPjT5Anly6y4xPGBdJ69PTQc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0OKzHRIbg4fS9r-3lAnrlkbotyKF4AjyczuyR7bExBQ&oe=6AE0B7F6"}, {"file_name": "05_extensions.png", "id": "4701056793505760", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824741_4701056796839093_4685634589927152046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4UyyiXFv2EQ7kNvwECtoJG&_nc_oc=Adr3UsIxjYXRcRR5gaY8aoWhojXLfgiUoSpVnG7lsWzkyFiG0ZingSFdTTTh560Ju54&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkbDoOnKTIg13tgAqSyVLv_lar9X5_vHSryIvoIwXaSg&oe=6AE0BC9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LuciD VR Web Browser", "keywords": ["internet", "browser", "web", "player", "3d"], "long_description": "LuciD VR Web Browser brings the full web to your headset.\n\nBROWSER EXTENSIONS\nInstall add-ons from addons.mozilla.org right inside the browser: ad blockers, dark mode, video tools and many more. Turn them on and off, open their panels and settings from one menu.\n\nVIDEOS IN 3D\nVideos get a 3D button. One tap moves the video into the immersive player: 180\u00b0 and 360\u00b0 videos, side-by-side 3D, flat cinema screens and passthrough, with playback continuing exactly where it was. Sites with their own VR button hand their video over the same way. On YouTube, a YT button opens the video in the YouTube VR app, which is the only place YouTube shows its 180\u00b0 and 360\u00b0 videos in 3D.\n\nBUILT FOR VR\n\u2022 Desktop, mobile and reader layouts, switchable at any time\n\u2022 Per-site zoom with one tap\n\u2022 Large tab strip, tab overview, reopen closed tabs, close all tabs\n\u2022 Focus view for a bigger panel, multiple windows side by side\n\u2022 Voice dictation in the address bar, read aloud for articles\n\u2022 Bluetooth keyboard shortcuts\n\nPRIVACY AND COMFORT\n\u2022 Built-in ad and tracker blocking (off by default) with filter lists and per-site exceptions\n\u2022 Private windows that keep cookies and site data in memory only\n\u2022 Saved passwords encrypted with the headset's hardware keystore\n\u2022 History, bookmarks and settings stay on your device\n\nALSO INCLUDED\nDownloads with resume, bookmarks bar, find in page, and camera and microphone access for websites only after you allow it.\n\nDISCORD:\nhttps://discord.gg/rzUJydRGyK\n\n", "short_description": "A web browser built for your headset: full desktop websites, browser extensions, built-in ad blocking and almost any web video in an immersive 3D player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/lucid-browser/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": "https://discord.gg/rzUJydRGyK", "website_url": "https://f1tt0n.github.io/lucid-browser/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1351413411392904"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823790_1099968379596955_9097678056832090205_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDJ0ndrtwsAQ7kNvwGdXQQV&_nc_oc=AdpN3Os3_w8i6JSgxcfmho3h3awsbxBhdfSVYx5a6au8mOhf0XUF20clw5-SjlG19gc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVa1SixT8YkmuKPfpf99QhRF7k-yJ_HJsuxEbRzYHGCQ&oe=6AE0B66E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "LuciD VR Web Browser", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Utilities", "id": "393222478507326"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1792594800, "lastRevision": {"nodes": [{"id": "1344144098786502", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1344144062119839", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1418075057172877"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "cover_portrait_1008x1440.png", "id": "29288330940828860", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821704_29288330957
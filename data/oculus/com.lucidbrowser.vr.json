00_AQO0OKzHRIbg4fS9r-3lAnrlkbotyKF4AjyczuyR7bExBQ&oe=6AE0B7F6"}, {"file_name": "05_extensions.png", "id": "4701056793505760", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824741_4701056796839093_4685634589927152046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4UyyiXFv2EQ7kNvwECtoJG&_nc_oc=Adr3UsIxjYXRcRR5gaY8aoWhojXLfgiUoSpVnG7lsWzkyFiG0ZingSFdTTTh560Ju54&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkbDoOnKTIg13tgAqSyVLv_lar9X5_vHSryIvoIwXaSg&oe=6AE0BC9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LuciD VR Web Browser", "keywords": ["internet", "browser", "web", "player", "3d"], "long_description": "LuciD VR Web Browser brings the full web to your headset.\n\nBROWSER EXTENSIONS\nInstall add-ons from addons.mozilla.org right inside the browser: ad blockers, dark mode, video tools and many more. Turn them on and off, open their panels and settings from one menu.\n\nVIDEOS IN 3D\nVideos get a 3D button. One tap moves the video into the immersive player: 180\u00b0 and 360\u00b0 videos, side-by-side 3D, flat cinema screens and passthrough, with playback continuing exactly where it was. Sites with their own VR button hand their video over the same way. On YouTube, a YT button opens the video in the YouTube VR app, which is the only place YouTube shows its 180\u00b0 and 360\u00b0 videos in 3D.\n\nBUILT FOR VR\n\u2022 Desktop, mobile and reader layouts, switchable at any time\n\u2022 Per-site zoom with one tap\n\u2022 Large tab strip, tab overview, reopen closed tabs, close all tabs\n\u2022 Focus view for a bigger panel, multiple windows side by side\n\u2022 Voice dictation in the address bar, read aloud for articles\n\u2022 Bluetooth keyboard shortcuts\n\nPRIVACY AND COMFORT\n\u2022 Built-in ad and tracker blocking (off by default) with filter lists and per-site exceptions\n\u2022 Private windows that keep cookies and site data in memory only\n\u2022 Saved passwords encrypted with the headset's hardware keystore\n\u2022 History, bookmarks and settings stay on your device\n\nALSO INCLUDED\nDownloads with resume, built-in PDF and image viewer (with 2D-to-3D photo conversion), bookmarks bar, find in page, and camera and microphone access for websites only after you allow it.", "short_description": "A web browser built for your headset: full desktop websites, browser extensions, built-in ad blocking and almost any web video in an immersive 3D player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/lucid-browser/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": null, "website_url": "https://f1tt0n.github.io/lucid-browser/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1348069831727262"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1133908699051097"}]}, "baseline_offer": {"id": "1133908699051097"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792594800, "status": "PUBLISHED", "id": "1133908699051097"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1353287434538835", "version": "0.1.4"}, "id": "2030461250821554", "channel_name": "LIVE"}]}, "is_for_oc
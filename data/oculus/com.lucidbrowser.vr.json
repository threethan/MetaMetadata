cP0DGVys4ANyeJvSSogxx7O-QppZY5mWSbAGKCgAFWfspMxY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3jvj3_IJonZ72DqGKxxjsukyFXrae0UCbWIgGI7v5uw&oe=6AEB30E6"}, {"file_name": "03_menu.png", "id": "1142940881429131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1142940888095797_5951025591278441618_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wR57V5Ui91IQ7kNvwHhE-i_&_nc_oc=AdrNI9xJifDbuV2GxdDcRlBa91VOPiCs7LUmDAsSd72wqNkZat2jlqUuqPZ4WyOyrG8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk_UXsTqeK2PX5wcw4YkhBFUx7nGfoVQNEHZs3uA1i_Q&oe=6AEB3FB9"}, {"file_name": "04_video_3d.png", "id": "28806338792380466", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_28806338809047131_9069363056957760579_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYkUwtGpFYoQ7kNvwFUplfc&_nc_oc=AdqslpO8Rgngff0AU6ZmwVdLVnWaZqvORDE0eIfRR7aH9GsnfpabmqiMjL1Uwk-dxfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs7WaggkLpXAnuZHI5YzMmIc4TDhJmea6uWTN829zk1A&oe=6AEB43F6"}, {"file_name": "05_extensions.png", "id": "4701056793505760", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824741_4701056796839093_4685634589927152046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFOrN8rVY_sQ7kNvwGX1hm2&_nc_oc=Adpqj7igRWG_9UXidBEgmLicOxaWmg_LdG-Djk9wwPBIePppTMdanlObPuh3eg9ixeg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLw37qx1G7aVz9uuQHaN51XxlnvIT2IdG0LZm_CoKiLQ&oe=6AEB489B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LuciD VR Web Browser", "keywords": ["internet", "browser", "web", "player", "3d"], "long_description": "LuciD VR Web Browser brings the full web to your headset.\n\nBROWSER EXTENSIONS\n\nInstall add-ons from addons.mozilla.org right inside the browser: ad blockers, dark mode, video tools and more. Manage them all from one menu.\n\nVIDEOS IN 3D\n\nVideos get a 3D button. One tap moves the video into the immersive player: 180\u00b0 and 360\u00b0 videos, side-by-side 3D, flat cinema screens and passthrough, with playback continuing where it was. Sites with their own VR button hand their video over the same way. On YouTube, a YT button opens the video in the YouTube VR app, the only place YouTube shows 180\u00b0 and 360\u00b0 videos in 3D.\n\nBUILT FOR VR\n\n\u2022 Desktop, mobile and reader layouts (reader on article pages)\n\n\u2022 Page zoom with \u2212 and +, one-tap reset\n\n\u2022 Tab strip that fits more tabs as you open them, tab overview, reopen closed tabs\n\n\u2022 Focus view for a bigger panel, multiple windows side by side\n\n\u2022 Voice dictation in the address bar\n\n\u2022 Bluetooth keyboard shortcuts\n\nPRIVACY AND COMFORT\n\n\u2022 Built-in ad and tracker blocking (off by default, light or strong) with filter lists and per-site exceptions\n\n\u2022 Private windows that keep site data in memory only\n\n\u2022 Saved passwords encrypted with the headset's hardware keystore\n\n\n\u2022 History, bookmarks and settings stay on your device\n\nALSO INCLUDED\n\nDownloads with resume, PDF and image viewer, bookmarks bar, find in page, and camera and microphone access only after you allow it.\n\nDISCORD:\nhttps://discord.gg/rzUJydRGyK", "short_description": "A web browser built for your headset: full desktop websites, browser extensions, built-in ad blocking and almost any web video in an immersive 3D player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/lucid-browser/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": "https://discord.gg/rzUJydRGyK", "website_url": "https://f1tt0n.github.io/lucid-browser/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1063584910766706"}], "external_su
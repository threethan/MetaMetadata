r0y0aznSgoqOaeAkpDCtuxJ-VrT0D4eBb5nYttILtpJYt11jFJdZ7M6ovjM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zXi6u9pgx_OIVoBn7jtl5tD0gX9egEnjMPk8_xpxJoQ&oe=69ECD1B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Infiniplay_trailer_lastFrame.png", "id": "23872240162443003", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617847_23872240169109669_3352144252978081025_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWf6ZB0pijAQ7kNvwFQqOoh&_nc_oc=AdqZTEfhiSA_3OT427ZhpGTD_tkYCGspA1e66FlIbnfCticyub5mSqBxlm-4yMzRDR0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34NM9Df04q7M7r7lF5gMlvZT4PAp9LCD3TeNj_1SnEbQ&oe=69ECC500"}, "display_name": "Infiniplay", "keywords": ["infinity", "infiniplay", "gamehub"], "long_description": "# \u267e\ufe0f  Infinite Fun, One Box! \n\n## \ud83c\udfae  Casual,Competitive,and Social - AIl in One  \n\nWelcome to **Infiniplay**, where you can enjoy a variety of casual puzzle games and multiplayer tabletop games, compete on global leaderboards, and chat with players worldwide!\n\n\ud83e\udde9 Casual Puzzle Games \u2013 Challenge your brain with puzzles games. \n\n\ud83c\udf89 Multiplayer Tabletop Games \u2013 Play games with friends and players around the world. \n\n\ud83d\udcac Voice Chat \u2013 Talk while you play. \n\n\ud83c\udfc6 Global Leaderboards \u2013 Compete with players worldwide. ", "short_description": "\u267e\ufe0f Infinite Fun, One Box! Casual,Competitive,and Social -- AIl in One\n\nWelcome to Infiniplay, where you can enjoy a variety of casual puzzle games and multiplayer tabletop games, compete on global leaderboards, and chat with players worldwide!\n\n\ud83e\udde9 Casual Puzzle Games \u2013 Challenge your brain with puzzles games\n\ud83c\udf89 Multiplayer Tabletop Games \u2013 Play games with friends and players around the world\n\ud83d\udcac Voice Chat \u2013 Talk while you play\n\ud83c\udfc6 Global Leaderboards \u2013 Compete with players worldwide"}, {"
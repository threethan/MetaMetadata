q7CBmW_RSLcZa3SRMVSKyyODGPwq9Y8CTTWOAx7Hniu1IHmUzKtGmPoC_V4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gpt8BCZKAs27qxw7l2K-d5X1DOOSa3y_dKXEb4ugeTQ&oe=6A0B2437"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Infiniplay_trailer_lastFrame.png", "id": "23872240162443003", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617847_23872240169109669_3352144252978081025_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wnqgPrhFHAQ7kNvwGyDdW0&_nc_oc=AdqWNCq8YCiI45rtz3IvQufdEfh3u1N1k4nNcpPNDESUGb0B-PWSlQjMwjYW2z1ebK8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72isr9NrYrEy61H5W71csjNSSdLJmjyUxElgniUyKEXg&oe=6A0B1780"}, "display_name": "Infiniplay", "keywords": ["infinity", "infiniplay", "gamehub"], "long_description": "# \u267e\ufe0f  Infinite Fun, One Box! \n\n## \ud83c\udfae  Casual,Competitive,and Social - AIl in One  \n\nWelcome to **Infiniplay**, where you can enjoy a variety of casual puzzle games and multiplayer tabletop games, compete on global leaderboards, and chat with players worldwide!\n\n\ud83e\udde9 Casual Puzzle Games \u2013 Challenge your brain with puzzles games. \n\n\ud83c\udf89 Multiplayer Tabletop Games \u2013 Play games with friends and players around the world. \n\n\ud83d\udcac Voice Chat \u2013 Talk while you play. \n\n\ud83c\udfc6 Global Leaderboards \u2013 Compete with players worldwide. ", "short_description": "\u267e\ufe0f Infinite Fun, One Box! Casual,Competitive,and Social -- AIl in One\n\nWelcome to Infiniplay, where you can enjoy a variety of casual puzzle games and multiplayer tabletop games, compete on global leaderboards, and chat with players worldwide!\n\n\ud83e\udde9 Casual Puzzle Games \u2013 Challenge your brain with puzzles games\n\ud83c\udf89 Multiplayer Tabletop Games \u2013 Play games with friends and players around the world\n\ud83d\udcac Voice Chat \u2013 Talk while you play\n\ud83c\udfc6 Global Leaderboards \u2013 Compete with players worldwide"}, {"
jWm7psxA2v1LCip-4L7BffFijTNNnqu39v_c7J19wWnffULZA4qMgaQzTM0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NB2eKO_8E9M2SIsBW6c-VUS2xHgpY-I3taSo5E6LExQ&oe=6A1701B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Infiniplay_trailer_lastFrame.png", "id": "23872240162443003", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617847_23872240169109669_3352144252978081025_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5r0qjQ95zdoQ7kNvwH4yEPU&_nc_oc=Adov5n0UWNO_aElm-TpYKPbmRqbEbZb90jmrj6aSfjB-Ti1lFEdiu5aQKbR-VRmiAwY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QugpruxS_cUoHWh1DzLQGlRN9VJ7roGLHdhX7YBYHiw&oe=6A16F500"}, "display_name": "Infiniplay", "keywords": ["infinity", "infiniplay", "gamehub"], "long_description": "# \u267e\ufe0f  Infinite Fun, One Box! \n\n## \ud83c\udfae  Casual,Competitive,and Social - AIl in One  \n\nWelcome to **Infiniplay**, where you can enjoy a variety of casual puzzle games and multiplayer tabletop games, compete on global leaderboards, and chat with players worldwide!\n\n\ud83e\udde9 Casual Puzzle Games \u2013 Challenge your brain with puzzles games. \n\n\ud83c\udf89 Multiplayer Tabletop Games \u2013 Play games with friends and players around the world. \n\n\ud83d\udcac Voice Chat \u2013 Talk while you play. \n\n\ud83c\udfc6 Global Leaderboards \u2013 Compete with players worldwide. ", "short_description": "\u267e\ufe0f Infinite Fun, One Box! Casual,Competitive,and Social -- AIl in One\n\nWelcome to Infiniplay, where you can enjoy a variety of casual puzzle games and multiplayer tabletop games, compete on global leaderboards, and chat with players worldwide!\n\n\ud83e\udde9 Casual Puzzle Games \u2013 Challenge your brain with puzzles games\n\ud83c\udf89 Multiplayer Tabletop Games \u2013 Play games with friends and players around the world\n\ud83d\udcac Voice Chat \u2013 Talk while you play\n\ud83c\udfc6 Global Leaderboards \u2013 Compete with players worldwide"}, {"
4JGJOwmi3Fq2tVlAwOKhLuy-PlF1Cuvx0BOzZlk8MvbtXmByE_Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuNkespxkpXObTJZFhjjl4ZVIvQhc1vx8iN-JQoVfaaA&oe=6AFC7FCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_Cover Art Landscape_ 2560 x 1440px_.png", "id": "1861271961530457", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/750864147_1861271964863790_2484115218483186475_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qg-CKSUtMlkQ7kNvwGGCJ2A&_nc_oc=AdrxjgH6eBIjJlcuDv0KBbT66sqhngM0WRi9kGJzc8b7gSWH8cVKca3D95Bgtoqlak0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG40GqktwsqrGZkp-jYFnQCRIx-cCbWLhoiTDFYjOJhA&oe=6AFC81DD"}, "display_name": "VRacer Hoverbike", "keywords": ["speed", "arcade", "simulation", "motorcycle", "drift"], "long_description": "\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e\n\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\n\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\n\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\n\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\n\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\n\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\n\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200f\n{3049039331937448}\n# **THE DEFINITIVE ARCADE RACER FOR VR**\n\nRace through neon cities, alien worlds, and orbital circuits. Lean into every turn using intuitive chest-based controls designed for comfort and immersion. Outrun missiles, drop mines, and blast your way to victory\u2014this is VR racing at full throttle.\n\n{1429230835190476}\nSolo, competitive, or chaotic\u2014choose from Time Trial, Weekly Challenge, Combat, Survivor, Neon Runner, Multiplayer, and Career.\n\n{9812052808906653}\nRace through highland valleys, desert colonies, neon-lit cities, and orbital spaceways. Each circuit offers unique challenges, visual styles, and hazards to master.\n\n{1076039974584612}\nRace with up to 6 players in cross-platform online multiplayer. Choose your avatar and meet up in a social lobby between sessions.\n\n{1348893869520766}\nClassic arcade racing meets chaos. Pick up missiles, EMP blasts, homing drones, and mines as you fight your way through aggressive opponents in high-speed, weaponized showdowns.", "short_description": "VRacer Hoverbike delivers the ultimate high-speed racing experience with explosive combat, deep progression, and precision-tuned VR controls. Built from the ground up for VR and polished over years of development, this game is packed with content: 30 tracks, 7 gameplay modes, a full career system, and rich customization tools."}]}, "developer_name": "VertexBreakers", "developer_privacy_policy_url": "https://www.vertexbreakers.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Impact Inked", "support_website_url": null, "website_url": "https://www.vertexbreakers.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED",
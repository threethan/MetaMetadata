=69D64831"}, {"file_name": "31.png", "id": "1098226868846400", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830007_1098226872179733_6143333809846814987_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFO-M0ish9gQ7kNvwET7Eav&_nc_oc=Adqv30URlcnTb1Cnf22tMKg4TCFSF8Bl5CN8HuqxSzOwB_Bg-iINtM3sdaeOIR1UfJk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PUe62EkgNoE5D1_jZTCfnqUdYpQragjwQU2C43js4-Q&oe=69D659ED"}, {"file_name": "3 (1).png", "id": "1129434952410323", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499293669_1129434965743655_2873263594175569411_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DEUCu6oHcYQ7kNvwHn8kP8&_nc_oc=AdoyI0s7SMRPU-iuFMjbMkVGaPPHSce1-_iZ_c2A1F-ouuanir8AcZIc84-QV_s95Z0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03crmkv8k8sPqA6rXNL9JaXAo_VIH8ncZ78Yzbt0C-DQ&oe=69D64734"}, {"file_name": "14.png", "id": "1379699826474898", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507839311_1379699829808231_1646706276282198397_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utorS8BjcssQ7kNvwFrO7a9&_nc_oc=Adq9N9E6skQWtL6AYiARGsrk8Cq4t-WLvDWX_njsAjzU9LP0_1yDZWjhUBP7XxuMqWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af171EjxYVjH96Av7uQ5BjD0cSSZ1waz5MCkgqPr0sxYuQ&oe=69D6490F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-LANDSCAPE- 2560 x 1440px.png", "id": "990747713513737", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619098_990747720180403_2877332780399879448_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wxmIQKSN-gQ7kNvwFmniNW&_nc_oc=Adpqz4nM8Elxh7zOlnKEE9iZswrWguuRh89eEv9XjLq2dcxrWJKfXGnEGYRaNRWwkqs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08h0rYtWI76jRshFdba0SXHbzQyMW9zrgEb-8moKEe4A&oe=69D6374D"}, "display_name": "VRacer Hoverbike", "keywords": ["speed", "arcade", "simulation", "motorcycle", "drift"], "long_description": "\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e\n\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\n\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\n\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\n\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\n\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\n\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\n\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200f\n{3049039331937448}\n# **THE DEFINITIVE ARCADE RACER FOR VR**\n\nRace through neon cities, alien worlds, and orbital circuits. Lean into every turn using intuitive chest-based controls designed for comfort and immersion. Outrun missiles, drop mines, and blast your way to victory\u2014this is VR racing at full throttle.\n\n{1429230835190476}\nSolo, competitive, or chaotic\u2014choose from Time Trial, Weekly Challenge, Combat, Survivor, Neon Runner, Multiplayer, and Career.\n\n{9812052808906653}\nRace through highland valleys, desert colonies, neon-lit cities, and orbital spaceways. Each circuit offers unique challenges, visual styles, and hazards to master.\n\n{1076039974584612}\nRace with up to 6 players in cross-platform online multiplayer. Choose your avatar and meet up in a social lobby between sessions.\n\n{1348893869520766}\nClassic arcade racing meets chaos. Pick up missiles, EMP blasts, homing drones, and mines as you fight your way through aggressive opponents in high-speed, weaponized showdowns.", "short_description": "VRacer Hoverbike delivers the ultimate high-speed racing experience with explosive combat, deep progression, and precision-tuned VR controls. Built from the ground up for VR and polished over years of development, this game is packed with content: 30 tracks, 7 gameplay modes, a full career system, and rich customization tools."}]}, "developer_name": "VertexBreakers", "developer_privacy_policy_url": "https://www.vertexbreakers.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Impact Inked", "support_website_url": null, "website_url": "https://www.vertexbreakers.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26493361216946706"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619518_1240840481020936_5574147609325911780_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYSwPXdSi0wQ7kNvwFzrOtG&_nc_oc=AdrNmXjdbwXlt_ghe2vd1-U-JRPooovcv-vrthF-UI5OuzjVvj142c9yxbZEQZ3CFSY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jwIus8Z11bdy3lsuS_SC8wdoDc7IY1kHK2IT7XVqTZA&oe=69D65B84"}, "is_c
1323502718855652", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391755_1323502722188985_2711992605517823041_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8RMn6Z19fcQ7kNvwG67NxQ&_nc_oc=AdoqWU9pn0fzwpcn9Egr6yY9a7fl00LdJVRA0PcoAC7J75fVNM14tIPIZNO2cD-PamM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV_OHBGt1xNm015VmnM_GpAjaL41zrPlkmy4pZ0n77pg&oe=6ADCBEEA"}, {"file_name": "vracer_screenshot_0147.png", "id": "1265167407923151", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391716_1265167414589817_6872755616927107704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txWsn3RuHMEQ7kNvwG7RfDo&_nc_oc=AdpZW8SKDYlXL-ZMwKiE1W9AJU3QiPNH1TF8_jepboWCvOzH19llSDTqNTgH_f6wdys&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYsOh9Vxs6D7skrqraZ0BbwO2pjzixeltXX7C_18fgZg&oe=6ADCCD8D"}, {"file_name": "vracer_screenshot_0183.png", "id": "514885784961957", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391843_514885791628623_9018188901165195776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atckKesIL4UQ7kNvwES4up7&_nc_oc=Adrq-0ns8FDawYa9RC-eO4Y3CYjZjphQ5Q7oCROOTIRRgdJZDMQx59W9zmYGKEB0G9w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9HcR2rNX2MFC7-TS81gmsn2TDM8ID7zFvUGD-HNrazA&oe=6ADCC5B5"}, {"file_name": "vracer_screenshot_0209.png", "id": "978315600438539", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391848_978315607105205_1538137399423488537_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oUFiB7BXncQ7kNvwEJTSvq&_nc_oc=AdoE1nmSFG1gezUtgRcMDq7sjjm_mIZUmZ351lpKd0JMIlfu9YU6Czwl3VnDMRu05OQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmTOziyqewbhg16FNDaQSIFdWJ9_1OZAM2roEaZb6G_g&oe=6ADCD7FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vracer_video_Cover.png", "id": "1286923012394095", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393491_1286923019060761_5399601284622079885_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysdZWEzB5_EQ7kNvwETzZGw&_nc_oc=AdqaYgU6Iwu3Az7fLGsmr-1uuw6Wu1aGNbuLjA8sB6jf6Cg7iKsq1y1zMSZVj-L8dcY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNI3OxHZgze-NSVG7FiNqEgT9oUCuGtOQmiqDSgOocN1Q&oe=6ADCA9FC"}, "display_name": "V-Racer Hoverbike", "keywords": ["racing", "futuristic", "multiplayer", "bike", "speed"], "long_description": "V-Racer Hoverbike is the ultimate high-speed VR racing experience, designed to deliver intense adrenaline and precise motion control like never before!\n\n\n\ud83c\udfcd\ufe0f    FUTURISTIC RACING AT BLAZING SPEEDS\n\nFeel the rush as you pilot your hoverbike through stunning futuristic tracks, dodging obstacles, leaning into sharp turns, and pushing your reflexes to the limit.\n\n\n\u26a1     BUILT FOR VR COMFORT & PRECISION\n\nSay goodbye to motion sickness! Our intuitive controls and physics-driven cockpit motion ensure a smooth, exhilarating ride that keeps you immersed in the action.\n\n\n\ud83c\udfc1    MULTIPLE GAME MODES\n\nTIME TRIALS \u2013 Shave off those milliseconds and set new records.\nONLINE MULTIPLAYER \u2013 Challenge friends or global competitors in intense races.\nCOMBAT RACE \u2013 Battle rivals with weapons and power-ups.\nSURVIROR - Stay ahead and be the last one standing on the track!\nNEON RUNNER - Pass through gates and blast mines ahead to pave your way to victory.\n\n\n\ud83c\udf0d     RACE ACROSS EXOTIC LOCATIONS\n\nFrom neon-lit cityscapes to wild off-world tracks, every circuit is a test of skill and speed.\n\n\n\ud83d\ude80     FOR SPEED FREAKS & VR PIONEERS\n\nWhether you\u2019re a racing game veteran or a VR newcomer, V-Racer Hoverbike is your ticket to the future of high-speed competition. Strap in and hit the track!", "short_description": "Experience the ultimate thrill of high-speed racing in VR! Lean, dodge, and boost your way through futuristic tracks in V-Racer Hoverbike\u2014a heart-pounding ride built for speed lovers and VR adrenaline junkies."}]}, "d
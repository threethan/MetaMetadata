5167407923151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391716_1265167414589817_6872755616927107704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuQTgY_5-aMQ7kNvwG4JvnJ&_nc_oc=AdmZZbi3FLfzZFiIHROWGBa1DMx7AwM9Qq-ofSASJAZT56yrLe0By7ti3rjm1blkKgo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFezgs39Uja6lFJYJM2MBhKq6Bl-CzchzaHGlJkamVsw&oe=69B696CD"}, {"file_name": "vracer_screenshot_0183.png", "id": "514885784961957", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391843_514885791628623_9018188901165195776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Th1jypeopWsQ7kNvwECB7GE&_nc_oc=AdlmGt-dQ1vVzRUrnhOcEE7KEYP6LuGot960bhhnZLdlja-zXtnJYZjVD_EMBN91JXg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5i3HjyFu0-MhYQwB_fks7hVI8ZQ8z4fJi78_5Lf-SkA&oe=69B68EF5"}, {"file_name": "vracer_screenshot_0209.png", "id": "978315600438539", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391848_978315607105205_1538137399423488537_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyxoX7r4I_QQ7kNvwGrVOQo&_nc_oc=AdmU3ZgJdGfnFS1XxzRStTQFIoGCJtyxBDsM63M6qLwVQv7n5LuW_aYHFJGhVIs0DT4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afypm7Wl8TOurhuBw3zbeihwfWKt8RyYsObS4MDCrjlAPw&oe=69B6A13A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vracer_video_Cover.png", "id": "1286923012394095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393491_1286923019060761_5399601284622079885_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKyL1uxXJbMQ7kNvwGKy_ZY&_nc_oc=AdkE2aIRZuUvVjLL6B5DWQ_KRdJ7hl_T3A2Sn-HH6JYKPSSkTOLShKRcMsCbE_v9x5s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyarR_4fKQF7s8C15DU9Zw79yJGmAQmmw7zCtuApuj9yQ&oe=69B6AB7C"}, "display_name": "V-Racer Hoverbike", "keywords": ["racing", "futuristic", "multiplayer", "bike", "speed"], "long_description": "V-Racer Hoverbike is the ultimate high-speed VR racing experience, designed to deliver intense adrenaline and precise motion control like never before!\n\n\n\ud83c\udfcd\ufe0f    FUTURISTIC RACING AT BLAZING SPEEDS\n\nFeel the rush as you pilot your hoverbike through stunning futuristic tracks, dodging obstacles, leaning into sharp turns, and pushing your reflexes to the limit.\n\n\n\u26a1     BUILT FOR VR COMFORT & PRECISION\n\nSay goodbye to motion sickness! Our intuitive controls and physics-driven cockpit motion ensure a smooth, exhilarating ride that keeps you immersed in the action.\n\n\n\ud83c\udfc1    MULTIPLE GAME MODES\n\nTIME TRIALS \u2013 Shave off those milliseconds and set new records.\nONLINE MULTIPLAYER \u2013 Challenge friends or global competitors in intense races.\nCOMBAT RACE \u2013 Battle rivals with weapons and power-ups.\nSURVIROR - Stay ahead and be the last one standing on the track!\nNEON RUNNER - Pass through gates and blast mines ahead to pave your way to victory.\n\n\n\ud83c\udf0d     RACE ACROSS EXOTIC LOCATIONS\n\nFrom neon-lit cityscapes to wild off-world tracks, every circuit is a test of skill and speed.\n\n\n\ud83d\ude80     FOR SPEED FREAKS & VR PIONEERS\n\nWhether you\u2019re a racing game veteran or a VR newcomer, V-Racer Hoverbike is your ticket to the future of high-speed competition. Strap in and hit the track!", "short_description": "Experience the ultimate thrill of high-speed racing in VR! Lean, dodge, and boost your way through futuristic tracks in V-Racer Hoverbike\u2014a heart-pounding ride built for speed lovers and VR adrenaline junkies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vertexbreakers.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VertexBreakers", "support_website_url": null, "website_url": "https://www.vertexbreakers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "277
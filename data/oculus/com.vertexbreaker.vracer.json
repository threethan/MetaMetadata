195776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pex8wNPcGjQQ7kNvwHvqEI8&_nc_oc=AdoPmVZESaK1HTX5-_vbC1p2WYKSsacsoG5t10KbudZphgeUn1WkzoS1nyvE-EHE34Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWDHWMmXW_QvFxA96DnGsl3T_7q-6iGe-MEc2WECqg6Q&oe=6A661EB5"}, {"file_name": "vracer_screenshot_0209.png", "id": "978315600438539", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391848_978315607105205_1538137399423488537_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Kn1B0PlFwoQ7kNvwHxml5B&_nc_oc=AdrbaAl9qiPXdCh7WgIlBzRsmazZ6OBas6cq86JZMkNB9QxHmIAM-vD39GXrYyq8SNM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZqlrT_GqtJTtkw9SbyoEAVd2G4lJW5diAmqxrWQIx3A&oe=6A65F8BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vracer_video_Cover.png", "id": "1286923012394095", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393491_1286923019060761_5399601284622079885_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1HQmiOb1ewQ7kNvwEfrnM1&_nc_oc=AdoKye65Nqt82sshAt-S2Imz0cg1OZEL0vs9bcStCYqvXRuD9cCrWHMcQl68aqR211Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrCInvml95lM0kY-0CGVV-Pt1AI9-8vlEBHLCmyHCTeg&oe=6A6602FC"}, "display_name": "V-Racer Hoverbike", "keywords": ["racing", "futuristic", "multiplayer", "bike", "speed"], "long_description": "V-Racer Hoverbike is the ultimate high-speed VR racing experience, designed to deliver intense adrenaline and precise motion control like never before!\n\n\n\ud83c\udfcd\ufe0f    FUTURISTIC RACING AT BLAZING SPEEDS\n\nFeel the rush as you pilot your hoverbike through stunning futuristic tracks, dodging obstacles, leaning into sharp turns, and pushing your reflexes to the limit.\n\n\n\u26a1     BUILT FOR VR COMFORT & PRECISION\n\nSay goodbye to motion sickness! Our intuitive controls and physics-driven cockpit motion ensure a smooth, exhilarating ride that keeps you immersed in the action.\n\n\n\ud83c\udfc1    MULTIPLE GAME MODES\n\nTIME TRIALS \u2013 Shave off those milliseconds and set new records.\nONLINE MULTIPLAYER \u2013 Challenge friends or global competitors in intense races.\nCOMBAT RACE \u2013 Battle rivals with weapons and power-ups.\nSURVIROR - Stay ahead and be the last one standing on the track!\nNEON RUNNER - Pass through gates and blast mines ahead to pave your way to victory.\n\n\n\ud83c\udf0d     RACE ACROSS EXOTIC LOCATIONS\n\nFrom neon-lit cityscapes to wild off-world tracks, every circuit is a test of skill and speed.\n\n\n\ud83d\ude80     FOR SPEED FREAKS & VR PIONEERS\n\nWhether you\u2019re a racing game veteran or a VR newcomer, V-Racer Hoverbike is your ticket to the future of high-speed competition. Strap in and hit the track!", "short_description": "Experience the ultimate thrill of high-speed racing in VR! Lean, dodge, and boost your way through futuristic tracks in V-Racer Hoverbike\u2014a heart-pounding ride built for speed lovers and VR adrenaline junkies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vertexbreakers.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VertexBreakers", "support_website_url": null, "website_url": "https://www.vertexbreakers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7046024605440324"}}]}, "scheduled_offers":
BXzr24Mnn5rFeFVXZfZ9tppR3lh5cU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIYG6BGmWcZP6P4HddGr-rFWMSh8WGPznh7vx3Gm81EA&oe=69C7B275"}, {"file_name": "vracer_screenshot_0209.png", "id": "978315600438539", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391848_978315607105205_1538137399423488537_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQrWZ3rLjzUQ7kNvwFPYZ7L&_nc_oc=AdqQEGpub21hSgKEvrJXK3dlmcYVyzidZI1ShejvX697MXbeUDB1TUP6iH65Ks0svaU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqzOU0NSN_hhQBXiV_r--YpQfY6Z_sVN5ZAHk-d5Mynw&oe=69C7C4BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vracer_video_Cover.png", "id": "1286923012394095", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473393491_1286923019060761_5399601284622079885_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I69LaPJnfzUQ7kNvwHMO5Me&_nc_oc=AdqcgjIqL6SWRmgX0lWRw0em30LTfCAp0EoafUEoK7DtEAK3W5LEu53t8ApRVJIxDXk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoGiAo2Dn9WxP5IqaATFaMgVJRyfatB5Rin6oLv8IiMQ&oe=69C7CEFC"}, "display_name": "V-Racer Hoverbike", "keywords": ["racing", "futuristic", "multiplayer", "bike", "speed"], "long_description": "V-Racer Hoverbike is the ultimate high-speed VR racing experience, designed to deliver intense adrenaline and precise motion control like never before!\n\n\n\ud83c\udfcd\ufe0f    FUTURISTIC RACING AT BLAZING SPEEDS\n\nFeel the rush as you pilot your hoverbike through stunning futuristic tracks, dodging obstacles, leaning into sharp turns, and pushing your reflexes to the limit.\n\n\n\u26a1     BUILT FOR VR COMFORT & PRECISION\n\nSay goodbye to motion sickness! Our intuitive controls and physics-driven cockpit motion ensure a smooth, exhilarating ride that keeps you immersed in the action.\n\n\n\ud83c\udfc1    MULTIPLE GAME MODES\n\nTIME TRIALS \u2013 Shave off those milliseconds and set new records.\nONLINE MULTIPLAYER \u2013 Challenge friends or global competitors in intense races.\nCOMBAT RACE \u2013 Battle rivals with weapons and power-ups.\nSURVIROR - Stay ahead and be the last one standing on the track!\nNEON RUNNER - Pass through gates and blast mines ahead to pave your way to victory.\n\n\n\ud83c\udf0d     RACE ACROSS EXOTIC LOCATIONS\n\nFrom neon-lit cityscapes to wild off-world tracks, every circuit is a test of skill and speed.\n\n\n\ud83d\ude80     FOR SPEED FREAKS & VR PIONEERS\n\nWhether you\u2019re a racing game veteran or a VR newcomer, V-Racer Hoverbike is your ticket to the future of high-speed competition. Strap in and hit the track!", "short_description": "Experience the ultimate thrill of high-speed racing in VR! Lean, dodge, and boost your way through futuristic tracks in V-Racer Hoverbike\u2014a heart-pounding ride built for speed lovers and VR adrenaline junkies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vertexbreakers.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VertexBreakers", "support_website_url": null, "website_url": "https://www.vertexbreakers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7046024605440324"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "882915584508268"}, {"status": "PUBLISHED", "id": "2048149072684394"}
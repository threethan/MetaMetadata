1323502718855652", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391755_1323502722188985_2711992605517823041_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvTeHhSF61QQ7kNvwFlfSeb&_nc_oc=Adqq9j37qQTg7ZB36AljLzgRqTJxQ7mr7RGy2E4tQiQAmcdjh4frMEYxrf2p_wd966Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP905nQWC7l93KfbxX3E4aqFJyRco8MklODpEcUYunfrQ&oe=6AE204EA"}, {"file_name": "vracer_screenshot_0147.png", "id": "1265167407923151", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391716_1265167414589817_6872755616927107704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZktiCuB3eEQ7kNvwG8DKzA&_nc_oc=AdpZGH9M6g8gZuWebja3kYuK2WomaVDYwb4EoSAqWeZ0rADQBC1HVOsSN-awHrDaYWw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwWxmCquFnF1UeyE3-aRfwmAgUH6X_qXdluZH3QhewlQ&oe=6AE2138D"}, {"file_name": "vracer_screenshot_0183.png", "id": "514885784961957", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391843_514885791628623_9018188901165195776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftTlGzXUc70Q7kNvwEllQxk&_nc_oc=Adow32Psi4YIiQaWf9Yp1-MYj164HzEdElrkSiC_H7VRddXJcXhyRgtbCe9Wj0lG9Mk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3wX4I6ZIIEG5zz__O8VFpuQgxX6BThJdIQ7EtmqtrWA&oe=6AE20BB5"}, {"file_name": "vracer_screenshot_0209.png", "id": "978315600438539", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391848_978315607105205_1538137399423488537_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9u1_aHZ9AkQ7kNvwGkPPqA&_nc_oc=AdqCr-LYkgG8d6Wj7w8V-7w3pEXwKokZjdqMdHnhR2WE4w2ve6l6qtk5Hbuh-YTZ47Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIyRw4zypdbgmapu8a4G3yDX4_nlgB5QbOMVz6rdH1rg&oe=6AE1E5BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vracer_video_Cover.png", "id": "1286923012394095", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393491_1286923019060761_5399601284622079885_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnMZmbmyEtIQ7kNvwEfFR3y&_nc_oc=AdothxddNbb0ni9wu_VDYN4JsudiGD0ztmlUHVX7_Ts-Y4uLZ8BvajuKvSnVHK3guaM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5YJFm8kyzu17b3loIy4b1dyi8Xb5Y2Sqqw40VwvTkSQ&oe=6AE1EFFC"}, "display_name": "V-Racer Hoverbike", "keywords": ["racing", "futuristic", "multiplayer", "bike", "speed"], "long_description": "V-Racer Hoverbike is the ultimate high-speed VR racing experience, designed to deliver intense adrenaline and precise motion control like never before!\n\n\n\ud83c\udfcd\ufe0f    FUTURISTIC RACING AT BLAZING SPEEDS\n\nFeel the rush as you pilot your hoverbike through stunning futuristic tracks, dodging obstacles, leaning into sharp turns, and pushing your reflexes to the limit.\n\n\n\u26a1     BUILT FOR VR COMFORT & PRECISION\n\nSay goodbye to motion sickness! Our intuitive controls and physics-driven cockpit motion ensure a smooth, exhilarating ride that keeps you immersed in the action.\n\n\n\ud83c\udfc1    MULTIPLE GAME MODES\n\nTIME TRIALS \u2013 Shave off those milliseconds and set new records.\nONLINE MULTIPLAYER \u2013 Challenge friends or global competitors in intense races.\nCOMBAT RACE \u2013 Battle rivals with weapons and power-ups.\nSURVIROR - Stay ahead and be the last one standing on the track!\nNEON RUNNER - Pass through gates and blast mines ahead to pave your way to victory.\n\n\n\ud83c\udf0d     RACE ACROSS EXOTIC LOCATIONS\n\nFrom neon-lit cityscapes to wild off-world tracks, every circuit is a test of skill and speed.\n\n\n\ud83d\ude80     FOR SPEED FREAKS & VR PIONEERS\n\nWhether you\u2019re a racing game veteran or a VR newcomer, V-Racer Hoverbike is your ticket to the future of high-speed competition. Strap in and hit the track!", "short_description": "Experience the ultimate thrill of high-speed racing in VR! Lean, dodge, and boost your way through futuristic tracks in V-Racer Hoverbike\u2014a heart-pounding ride built for speed lovers and VR adrenaline junkies."}]}, "d
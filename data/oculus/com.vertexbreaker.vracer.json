65167414589817_6872755616927107704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVTu6xaKOAYQ7kNvwGVVRgh&_nc_oc=AdqtK_ZA9OGzqj-xgjYUskJIPO6cAavu7G8hi27KewYxNbsn_Ugq5oR9_PEZdFkjuJ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fMjDBFKUYtoVbKlezBLIJL7UD_Ut_cQ0T3wGV9CILJg&oe=69D8DDCD"}, {"file_name": "vracer_screenshot_0183.png", "id": "514885784961957", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391843_514885791628623_9018188901165195776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFkVhKIS5NcQ7kNvwGeMlAC&_nc_oc=AdoBC9Ar44l5YJyF0u7VT_OueWZ5a99FgA02t9xnqqH6UcJf4pKP1j5BgKA0J2gLWe4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NE2FbJ1ikViudt2loOLLaQboHwuji5lhQGO87H0YOxQ&oe=69D90E35"}, {"file_name": "vracer_screenshot_0209.png", "id": "978315600438539", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391848_978315607105205_1538137399423488537_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YKwSEVidyIQ7kNvwGNJHui&_nc_oc=Adqd2QKf_W0Rrzfj2ja2cDLmz5USyKT7DUibwka36ImbxX5B2K07f-xJUGtWR07x32E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yNcTxn6RM3TKHALDHMcVn7In275a3UXmjsUqgAY8qUA&oe=69D8E83A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vracer_video_Cover.png", "id": "1286923012394095", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393491_1286923019060761_5399601284622079885_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmIWQegJ8t8Q7kNvwGqq-dJ&_nc_oc=AdpIFIeS-_hRl8Yf6gBV6suUMLD4u5m0ShCwlUvdl8icEizOcgCAYyjFd2Mt8TNCkQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QIQbqKagirTXVlzf9FMshlVbszEegGbXWAb_U1pVbtA&oe=69D8F27C"}, "display_name": "V-Racer Hoverbike", "keywords": ["racing", "futuristic", "multiplayer", "bike", "speed"], "long_description": "V-Racer Hoverbike is the ultimate high-speed VR racing experience, designed to deliver intense adrenaline and precise motion control like never before!\n\n\n\ud83c\udfcd\ufe0f    FUTURISTIC RACING AT BLAZING SPEEDS\n\nFeel the rush as you pilot your hoverbike through stunning futuristic tracks, dodging obstacles, leaning into sharp turns, and pushing your reflexes to the limit.\n\n\n\u26a1     BUILT FOR VR COMFORT & PRECISION\n\nSay goodbye to motion sickness! Our intuitive controls and physics-driven cockpit motion ensure a smooth, exhilarating ride that keeps you immersed in the action.\n\n\n\ud83c\udfc1    MULTIPLE GAME MODES\n\nTIME TRIALS \u2013 Shave off those milliseconds and set new records.\nONLINE MULTIPLAYER \u2013 Challenge friends or global competitors in intense races.\nCOMBAT RACE \u2013 Battle rivals with weapons and power-ups.\nSURVIROR - Stay ahead and be the last one standing on the track!\nNEON RUNNER - Pass through gates and blast mines ahead to pave your way to victory.\n\n\n\ud83c\udf0d     RACE ACROSS EXOTIC LOCATIONS\n\nFrom neon-lit cityscapes to wild off-world tracks, every circuit is a test of skill and speed.\n\n\n\ud83d\ude80     FOR SPEED FREAKS & VR PIONEERS\n\nWhether you\u2019re a racing game veteran or a VR newcomer, V-Racer Hoverbike is your ticket to the future of high-speed competition. Strap in and hit the track!", "short_description": "Experience the ultimate thrill of high-speed racing in VR! Lean, dodge, and boost your way through futuristic tracks in V-Racer Hoverbike\u2014a heart-pounding ride built for speed lovers and VR adrenaline junkies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vertexbreakers.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VertexBreakers", "support_website_url": null, "website_url": "https://www.vertexbreakers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}], "external_subscription_type
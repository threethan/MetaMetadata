1323502718855652", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391755_1323502722188985_2711992605517823041_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMQjaFaJ_6gQ7kNvwFS0Zpf&_nc_oc=Ado0wOAHjeSSily-vbOx3aNuwweRrcXMvWV07zMHkmBkBvhWgID7I6dmMW63JxCQw44&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0ryYWhYCErRJXv7XC0PxxWIsAwEHWecvohoJnsbHLtg&oe=6AE5F96A"}, {"file_name": "vracer_screenshot_0147.png", "id": "1265167407923151", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391716_1265167414589817_6872755616927107704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUHM8pF-DIEQ7kNvwG4KCtC&_nc_oc=AdrJdsoWggWCFovnJK6K8bUodqC-eNAriOgWORTJqnZB-QCbNpPEUirjISXTdR1y2QE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ5iyx7AbfUyu6puJOSFyLw8Wa3-B0Yu9HDLTrh4iHWQ&oe=6AE6080D"}, {"file_name": "vracer_screenshot_0183.png", "id": "514885784961957", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391843_514885791628623_9018188901165195776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKGJ9vp8DMkQ7kNvwGozCXF&_nc_oc=Adpr8CpePecRRhCYaYhUuafwS-VkyjVO_Di5060HGqe8h1XiIdHfOAX3fTBeCP4TLTI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqdwA29lykK9J72ib--68v7qz0vS378zJUmEO3Q-3_vg&oe=6AE60035"}, {"file_name": "vracer_screenshot_0209.png", "id": "978315600438539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391848_978315607105205_1538137399423488537_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTKRx9HJpdQQ7kNvwEFpci-&_nc_oc=Adp3mX_OiYmoSnbOuSnxiYLqq2-j26tj4MqCOvnhsTsItLrTKf24Gya1azTB3R-x_to&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqUEFGE3PNofENwceikMxFAiuCMp0xflvOLBQO0NLm5Q&oe=6AE6127A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vracer_video_Cover.png", "id": "1286923012394095", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393491_1286923019060761_5399601284622079885_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5AXYa1MS1cQ7kNvwGygSeb&_nc_oc=AdpaYJtL6_5baR2CnLSHF123XUJ-TTwGV6krFNixFjnp7HzbPn5Hm1dCPqQSy_dRm8k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcAhlMBPFr6_99oZbv5aF25fSUE-zslDCV1psdnbmZng&oe=6AE5E47C"}, "display_name": "V-Racer Hoverbike", "keywords": ["racing", "futuristic", "multiplayer", "bike", "speed"], "long_description": "V-Racer Hoverbike is the ultimate high-speed VR racing experience, designed to deliver intense adrenaline and precise motion control like never before!\n\n\n\ud83c\udfcd\ufe0f    FUTURISTIC RACING AT BLAZING SPEEDS\n\nFeel the rush as you pilot your hoverbike through stunning futuristic tracks, dodging obstacles, leaning into sharp turns, and pushing your reflexes to the limit.\n\n\n\u26a1     BUILT FOR VR COMFORT & PRECISION\n\nSay goodbye to motion sickness! Our intuitive controls and physics-driven cockpit motion ensure a smooth, exhilarating ride that keeps you immersed in the action.\n\n\n\ud83c\udfc1    MULTIPLE GAME MODES\n\nTIME TRIALS \u2013 Shave off those milliseconds and set new records.\nONLINE MULTIPLAYER \u2013 Challenge friends or global competitors in intense races.\nCOMBAT RACE \u2013 Battle rivals with weapons and power-ups.\nSURVIROR - Stay ahead and be the last one standing on the track!\nNEON RUNNER - Pass through gates and blast mines ahead to pave your way to victory.\n\n\n\ud83c\udf0d     RACE ACROSS EXOTIC LOCATIONS\n\nFrom neon-lit cityscapes to wild off-world tracks, every circuit is a test of skill and speed.\n\n\n\ud83d\ude80     FOR SPEED FREAKS & VR PIONEERS\n\nWhether you\u2019re a racing game veteran or a VR newcomer, V-Racer Hoverbike is your ticket to the future of high-speed competition. Strap in and hit the track!", "short_description": "Experience the ultimate thrill of high-speed racing in VR! Lean, dodge, and boost your way through futuristic tracks in V-Racer Hoverbike\u2014a heart-pounding ride built for speed lovers and VR adrenaline junkies."}]}, "d
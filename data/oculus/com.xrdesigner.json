_1691032248394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pzvh1uALv8Q7kNvwEFILRd&_nc_oc=AdowwZMBheq8wiiylZVvMRnB1soxT9LncPmsereKkCUBvSFEPF6avTUD0x6YT7pDvDw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDKY6dQXKU1s7Xo_i597pTQ77r3Jp4gG3_Gyv_mnX3Vw&oe=6A8D7757"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTXklKMV9eMQ7kNvwFP4bd2&_nc_oc=Adpyp-vubSPO_8riA9rB56Rn5pXD06YOXKNIi-5Zy0RlbNJWux-t5iGTIiUWhSDK5ts&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG125pSnYK-u4Ck2uD0P5zpp1RJtNogsyb6RbodF8qmOw&oe=6A8D7675"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKgKJtg8IloQ7kNvwHfLnks&_nc_oc=Adp70QslpsSRBzCv-YXG7IotKnAmxmmR1_tJLw1SuAFogL4IrNMR2yMjRqH4nd3Ladk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyfiHvcrlzkTXEq3H-uqpwNVccdJEqNfiB7ELYYt3S3w&oe=6A8D6753"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_9u9wqf0oUQ7kNvwH3IltQ&_nc_oc=Adrm4Wvdh9zb4yICZtkuWd194WHtxj7LJr5-2pDC6Rn8EdgCUwAwAQX4ZgMOkiEfHuE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO4_xvxBYw2OOeqr2qosgN3HeXDlbsq8x1mcGOHwjMkQ&oe=6A8D941E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMyeIg3XZ84Q7kNvwFFWFts&_nc_oc=AdqHyfbLM3vZaHUe3bETruwFVlL8FLOv2y-A85P0FmmMHmpaFvZEpGfnfku4gjNfEOg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZV69HRKhStNXEQNXjsKu0qBRdvsDoLppgcHsXffuuzg&oe=6A8D7CBA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGwJbFYYfE0Q7kNvwEKgpko&_nc_oc=AdqOBs8oq1rhiOVey4_7VgW7jxlfzq4LcNVZFHFb5cJKQL0gttIzxisbJWJ7eSW6fhM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHV0W9uFqq0uHSKKpjBbQxEDqmqjHJsLwDfqdZOnGa_bQ&oe=6A8D6BB6"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kcCDyyhrSIQ7kNvwGo8pwP&_nc_oc=AdrsSQO3IqMkpqasN3LnSUDaSu98WL4c18-8-vSvPNX1860PPqwpQXJHfqwQG-mhnHw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxkk0IVtnv0CiJP8wqZZe1fBHb9bFBnKzLlAuH03B-lA&oe=6A8D7FC8"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xF8VQZrdUp8Q7kNvwF8GKPb&_nc_oc=AdrkULAxDFSfJKqb7sGIMJm-M6I9C8DqpRFcX-YT1uaM-zavHk3UaN5b1ZrqPZLAc7E&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLZb3Dr1H85hSkBNRF4L5Hva-O_-g6g5T9bQ2s3uXaFA&oe=6A8D87F3"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "
164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DR3GE64rbYQ7kNvwEZACsd&_nc_oc=AdlEc_kA3AXxmM5auBixCOQfsMGBjHtOcvGuTgxxY2X05EIxVhl6vJoH7oSpZ2-LlPI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6KaY9i-u41iqk4N7PyfjmCy2PPTW43qrlWa1kYIi1Kw&oe=69AAB557"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLZDhqtnVXoQ7kNvwElSh9z&_nc_oc=Adm4UDpt8tDMSq3PKecy_NisLpBHUJGaYHKw3zzkNCf1_U3wNH-aYePCgGe53pMarUM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfywLYeCU4hDO4z-TGb1BHRrdHkwUzqvJrIJ1-EuD8tkjA&oe=69AAB475"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAD226WCNioQ7kNvwHhVofB&_nc_oc=AdlX_yJAyH3NtWZ91Lkh5PKRGq5YcgQ-29fSa4IdFHZyNiUQZo-NYXLmcmg9ul8Jx3I&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9X2ktnmT3Wb-v25xU6CI30gVDUhEbPeN6JzVD07rbNQ&oe=69AADD93"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0erfFFCBZlIQ7kNvwG_LIrX&_nc_oc=AdlHufz0m1gzo8xp_VQQrZwPEHkP16-yQs4O5DF0SpRktcDs_qRUVf4K9pNg18f5IPs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyAQEncVerCWICp4Eo2lorsovRgJwgt4gk_WLPk8HXzeg&oe=69AAD21E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndFkW7LHXLQQ7kNvwEATEe1&_nc_oc=AdnlUyRy-4f-EQ1XHDw1L24P17cuTI6oeegJThLDcV8oBWlH2JyKVtbYEXZmmb63itY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzS_m-52Gnuz9THZADrBGM4-5hv12Qplo2rcwxXWy8i6w&oe=69AABABA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzQC_l_0DlIQ7kNvwFz95v5&_nc_oc=Adl-aZubMwZWuwpc0yQ2Y-bbxGx_WMwKJg-PfWd2b0EExfVa-kupqhKAvfunNd78cg8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afw3vNtiH9trDxslL4C3wDH88PTpFDDmWowufDi1Hi2vdA&oe=69AAE1F6"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_oZKqUFUh8Q7kNvwHSb4fF&_nc_oc=Adky7HKHSTLvbprD8MHxLPjUvHBgM8kMIVflqnM2SmHpZsjuLpu3r87s4gDYodXiGNo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfzWE_N9Vy64Ye7zw7ePq1bVhegARQ8cPjQdJBzBcBHLXg&oe=69AABDC8"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k22ladwjjNwQ7kNvwF8FdSE&_nc_oc=Adn2uIa25IKzqT-sAriUtNvs_DBYReMcNzFzlqGXx2bJu7m3p5gB3sXCnMJzinChsvE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfyQaoIMsiykiLUlBSYG41tJmr6tB2GxljEwmxFBE8RD7w&oe=69AAC5F3"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id": "949107410131388", "image_type": "APP_IMG_LOGO_TRANSPARENT", "u
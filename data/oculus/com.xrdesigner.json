691032248394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_FSKRwdCBAQ7kNvwFPWkb-&_nc_oc=AdpskJvhYTih0jjQ7mNbJ26ncLoKpStWp7-6HGoQrGEvStQ0N0R3RWnlZSaVxenuYJg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSTXHemclTKG-_zHdWsnkjIHRF-aQgisI6vSZ8iCqQBg&oe=6AA41917"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qi6bnbI-L0AQ7kNvwEkQnPe&_nc_oc=AdrLHQGkauJPp-2rqDMRBmU6h4_fFxs4EEeDh87nO6N1J5X_9iZhUIMy04dzFfUVp5E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw861EzrlIoPMtFYTjJR2CiBZX_erbOWszMpSq5lmwJA&oe=6AA41835"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8BwRwjCyQcQ7kNvwEaaxx7&_nc_oc=Adp6tdgRl9Yae-R1wkM1gEOZl_gyeIkJEQoKXSMkRyCowIqTeuvM8rH5olZd3tmnG7g&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSYgjEbErM7Ii7zRubv9IkqwYHOzcJ43rwR5TpzjT2ug&oe=6AA40913"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hegeghw1rcoQ7kNvwG4BtJ4&_nc_oc=AdrAyXtU1G3okzzmBVI66ZQN_sz0rDyOG93Abqm-nixCHZnydgGlkd1Aw8j2RN_HA4E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHUT-tlnwabOERWKpZ-5nTNxYXHZTFylvVtAzsEIxIpg&oe=6AA3FD9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHs21NWf-hsQ7kNvwEK9PCz&_nc_oc=AdpPnXNjR1bnpQ5JKlg3IiJ__udzIScPdlFkw-YTSVwOGkEk2rBIeqxU_k8LH-pCulU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLScowfK5iXQLqFpc1pcSEm3Hj6vfNxvXPFr9RkOUXe2w&oe=6AA41E7A"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JylIuPFchpwQ7kNvwHH55KQ&_nc_oc=Adp44UuW_A9_4Mxdvb8OX1DpWGA0Q-qjRiiW5_BM0DHX6VLYcfVa-L2pRBbf81KLFT8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmJkKIFa2EGYyOBxIy4vVsL54Ol_REs-xP9u-tOLbCTA&oe=6AA40D76"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgnzfZGOX3oQ7kNvwFXionw&_nc_oc=AdqtLkPybutORE771e_xn9w3uS9NIzJP7TPotYfLUboXMVuCJvRzRSNdRGHRqfdb0FQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUYHeai-sAx5aNClR3VSpY8JU2tPaCLnOYC4N7ZKpZRg&oe=6AA42188"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfHKlSTrXAMQ7kNvwHC9ju7&_nc_oc=AdrfrrOKfS9US_2JEFEABbovvip-LcdZdghDTR6heBKx4QUY5J5qsBBIwEtPPubiV3s&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOMf3rxBXy_QokFbc6GbsdS0XLGuaEb2cMkf5U-j0_hg&oe=6AA3F173"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id":
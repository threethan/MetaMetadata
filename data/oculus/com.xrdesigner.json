8394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcbVJvUCjm8Q7kNvwG6p_2m&_nc_oc=AdpZmwZjhjUXNrv1LDr9GtRHlRdaTWMg4jEkG-YklYnMqbRLQD_AwvrsSRaRW4BvQXY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Xc9iBV723VWQoLo7XMKHG81laRpJLUAnRq5HywITBUQ&oe=6A413897"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7xmZnPv0AwQ7kNvwE4MvAk&_nc_oc=AdpWQOJFT7Lp8POsckZKK8lqOuZLKnfS273GYtg67MMqSWZd1mKjZRgxGHF6GMkRZik&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g-1K0hpF7MvoUEPvJg9Ap5kKuzVK5y7XcqdyHm6OAhw&oe=6A4137B5"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vC3wJovQC-sQ7kNvwHBXljp&_nc_oc=Adq80loJPdd5HqWXM1AghJpNwd5apPxUoBR1ya66PVNJHq9j11hJ5yG_2SG7mPTUhS4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IkySPvVV0HLlUbDRIAN8sK_1YlS55tZNRTHgHF3wMlA&oe=6A412893"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISo3Gu2w02EQ7kNvwFPdc56&_nc_oc=Adq0OkEoxZJMOfh0kGMGv28AbtjCYVroSjlUizU-4521oAczeac21EHU3ELCxe3fUKc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Gb-LFJ-2ZTO8A5nVhBzNHHioDdz5wdtumW_Of5m7F0w&oe=6A411D1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pxb3Moq2-sEQ7kNvwHf_HIe&_nc_oc=Adq0nOS7qbFkfPz3iy-jEHBitnTo1c9HUcKTybTVXKFn01GhZlYy1Uy_dOaj4HlMEMk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XAs7kq9hVv8iOFFVIf7hWPE2QD7DZiASqyfdx8fBJww&oe=6A413DFA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6NBlCZQl24Q7kNvwEPlaVL&_nc_oc=AdqqXY-lm-jr_qxxY13rNKgi8CkGsg7pfvwQA2veY8cLvzjZ_0N3nLyRaYbYyEALIqM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZTa80s-fQq35i1sBW0eYrsyfd_z3ZIgnIrN898mq59Q&oe=6A412CF6"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DW2tEVnrMUQ7kNvwE8zuZo&_nc_oc=AdpF262-_8tawxOUTusX0o0vKm6oYTVG9TTO_iV77D5dg6XEcM-_6tvw0eS8tRKnwc8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WLulur1a5g4zHzK4mhMRQoeefH2H0GdQQwrGmUZMZHg&oe=6A414108"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqrtducJPZoQ7kNvwGNUxLK&_nc_oc=AdosSk7v5AsNO2ORofDaHDW9yPscxv-9nwXyWlGLp4WacZUTWXi5dNCHSfjL7ufjT_M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af880MVV0hx39q-a5W189D6EsxUyAuHb2BPFXtiaoC69PA&oe=6A4110F3"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id": "949107410131
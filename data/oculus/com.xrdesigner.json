8394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmsqTEKwdvsQ7kNvwGgHYk7&_nc_oc=AdrgvaOTaIC5CKtzfG3miyshjKGvPgOUfUs_tPU-bov2xzse4fVJ0Gu-sHmsHQ43Ubc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUkOYOXGeFeG745Es6gp2zLdP9YZmrNmjS0QFK1iDvuA&oe=6AB7DF97"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uSFbqRRAbkQ7kNvwFNbshi&_nc_oc=AdqIby9JFW9qtN5pS1iRGiXyHozRgO7-MkWw1hkuPt3HyPwNR8nqOv6Fc4lKnTfLW84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqwEmhfsGK-RptnJFCrovy9Tx3iZkeRqf-0uTVGQRqgw&oe=6AB7DEB5"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j11_z46ABeYQ7kNvwHBaRrq&_nc_oc=AdqV2et3BkgYaK_43LgvitzVKzcy8Cbv6aHpk3OOnRkw-f_2VkCtcIhQj0x7mpXFE0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDyJde3k8pvzQoit3fNphWZgFF9rRFzSO3nyiVervfbg&oe=6AB7CF93"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55SIdIn2OMkQ7kNvwFYwwZr&_nc_oc=AdoFUvE1759_8mTYZGtQfc9iavWBrvVB0RcUeBWDJaOZ5y4gVW_I-H6uEI41xViQeJo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMdFOhTM9fFTXFurUsPlYg86aTd6M1dPM6KDEHTyJ1rQ&oe=6AB7C41E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gk0ilOH9N44Q7kNvwGFZPCD&_nc_oc=AdqyAeZmVz-e7xt3wrhg5_teo2Ik7Kahv7KDVeo8s5QfVLioSyC6Ebrqf5eaqC8VHv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL66Md0ITt0ZeQXSi_P6Wz5HufZZtomcYVn4LwojbD-5g&oe=6AB7E4FA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design 
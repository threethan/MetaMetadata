g?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9H02XnPCZoQ7kNvwETUQXW&_nc_oc=AdkBbV0GylxX8p55mEf_F_u4T2wRiR20k30oRFGHKgfcQHXaWZuP71DmhnNwyuQU6CQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIXZOV_98aJRakHvWGRkqixHW9Zh25l11B-Ap6B_28wQ&oe=69B14CD7"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WHHttrlQJoQ7kNvwECA9UN&_nc_oc=AdlITeama1oQ3HQ3U16yj7sdMfeTzwL5Q8eqg3xr5ZCzf1SB6ab9QYEww5XcIMymc8M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTPfPW6OudWpsWqQwIGNLHqZMjYXI7_krUeVvxCCSiWw&oe=69B14BF5"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13HsBXXeCmYQ7kNvwGphE5p&_nc_oc=AdnOS8M-Q1wp7EovmBXpn-vVKFTKYKA11Il7vzmVAb_Ru4qTOOqCqzMC5S9BlHkXGs4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTE2HvBLlsWLDg8STVtfwZFXR44rD7ppgyaNglLSBz4Q&oe=69B17513"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3Nsqq0-phoQ7kNvwH8_3e8&_nc_oc=Adlm_jiReBsj4DIO8Du3Q9rjZLUYd-NFdK6roG4Av0ijSkSc6pkWAPbBKSUlqUln6Jw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8fX5kAQWPSQCLx_bGy4_L7w5PJebkkGwoxV6AHYEwZQ&oe=69B1699E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIOEpXfb3lAQ7kNvwFlDV67&_nc_oc=AdmO_zNC06wWp5r0k9Oa4rrsCFQ9wGoBduEvdWZClFnRqoxSoSE9QWfH2N-6SxkRUKs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkVK50A4P88_aqRq4zh3cg-as7Y4giUW0yX6I9SKxu0A&oe=69B1523A"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKldpYuY59gQ7kNvwHLF5AE&_nc_oc=Adl67qI5i6PK_9UFmMVv17xqbXi1YTB0YIqGfLJ2jMg-3TdMbMdW-SektqwyWK60m2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4vDV0YPzp50rcWjnCaJAI5Vt1qSRpNf73W8tkeozzag&oe=69B17976"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeX8BU-4aBsQ7kNvwH9T9PX&_nc_oc=AdmjZrK52i1P4ZUlt2M8qCa9bcNZlDJlL0A17oOO6y10THTxwJmPGU26jM3lkAr8yu8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfziLXoAPkZ2xTO9O41MhO_TTSCDPa8SEK7fZTq3jzlI-w&oe=69B15548"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O04E3d9B7CoQ7kNvwE058-D&_nc_oc=Adlqsqd_WH0x5mgllubZrPLjfLrvJOz8EOqPmWX3_Xzyr95-oS1luJN6ESBDx7Q4Hik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWeCw1BWzzGj9HD1Q7PBNCkkJh04fHpB03jpn6EV609Q&oe=69B15D73"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id": "949107410131388", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://
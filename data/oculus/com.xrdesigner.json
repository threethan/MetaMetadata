8394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Nh4O1KU7cwQ7kNvwHTYP52&_nc_oc=Adr12Az4AWn7ItY-8Iubt8BBPHfKart9Dmnz20JDkHyqrbi89uAZETadPdg5aSiVkd0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4buur6zk1geXCtNLWsNuwZV9PpxONWM7nCV4QL3Tdt3Q&oe=69FA0797"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XGlVXP5bwUQ7kNvwHaudMB&_nc_oc=AdqFoEWdRUFGTML1Mxp328BXl4lJZPV4k278kgPzn87-4nqBqWazOlj5WNdRx5MTfUM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HYQ8VHuBiuqG-j1_kH047myRYnL4rkZB2N7hO0m1xbw&oe=69FA06B5"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMyMlqh_BxwQ7kNvwGqu3x2&_nc_oc=AdoEYbj_-O9wVCkX_WoP-JV0HJdRb2JaW2G_GVuL6ngPbWUu6-oh8YESAuWR0MBGcbw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72aCgF9OPyu38DmU5T3JvYcJb6_KezeX4yCyyqVNwbPg&oe=69F9F793"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9xMNBY4boUQ7kNvwE8f0hL&_nc_oc=Ado4aYhF1qZfLZorj6qduW1EAljPFFyLpHFxx5f2J7SvIk-79HgMGjTQD8VvRKNyrdQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BHANEruczODo6caU6TMerCMmIhGKnaA5yZuDQ8mFUfA&oe=69F9EC1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDy929DJFNsQ7kNvwHuIr8q&_nc_oc=Adp1cvZuk_rOivGrtvdlxMt4pm03phBxvEDjFy_7s3X_6vJgnl9UXiDmXj5_9Grsj78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52AD7agLAVG9Lrx7gHRw4VU8f8docTyCX_j8711DUfOw&oe=69FA0CFA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylo0MCc8xOAQ7kNvwHrMWPh&_nc_oc=AdrNn2_kT-6p-zz3TThPemeNpPj3mIfRmGDa5banK4BCxQpJeioLUIvaT_udbCnzrI4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6i_ZmU1-mRU3ktDtUUdCWeRTz_WDEioX_8arm7Wvpmkw&oe=69F9FBF6"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhynNsWPnTYQ7kNvwFSIefO&_nc_oc=Adonn__9guqhr-vGKYhAVDt2O3cBZx8BL9H29LPGCscPqCrMNcFSTuF1I3N4FJvOZSs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66_JWTsOWFX2tVrNQ_9MIaCgogEiPggDhtnaLwBWRsZg&oe=69FA1008"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5j9tbph3JNAQ7kNvwGQA-ic&_nc_oc=Adq1LKeUT3oNIQTLQum0jNsZvc5yW7hnhd7rZweVdffrM2lN2sXsABaXcPrAdiEOYBo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LdJ3alD7MuCASrYcrdSGxIRwNYHn4gDgpKoP2kSGt_A&oe=69F9DFF3"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id": "949107410131
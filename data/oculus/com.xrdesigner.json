8394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAgY0Grytv4Q7kNvwFIoGHm&_nc_oc=AdrkOHUDusJwSftwQ1eOZ62eMyzpC6G5VM5ueZABT442d_TboVoQin6Sb5pkKatNfpg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6zq2AbcxiBH1C9f-CtMEjQHetiRxw8Ry__XT_N3XEpw&oe=6A9C3017"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kps7crHK5GAQ7kNvwH-mG7Q&_nc_oc=AdppxtwJtoGsIHilT6AA6rz20vVKABFDz4eXDpJf6MAXrzf-4XBjssCbvaYNM6arPyA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8GmOD21mhubuIDl28xFRykrALkP4FA54kelsZG5m1CA&oe=6A9C2F35"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPpqq29g38gQ7kNvwEwzeFV&_nc_oc=Adred1XXDdM_2ZMuFrKdAKJ22jDjxY4evVb8qGgQAUNXFQDeerav1Wfb8zeGeD5pYx4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFc7CxESpgUjWdy1HpfCXIj_fbr_KHCbEg8d1RxZozIw&oe=6A9C2013"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHylFzKKJRUQ7kNvwHfz5zU&_nc_oc=Adqp3_f1A3GCZQuZgYKUf4qW9KI19Ue2QePFdtUnfYPiY1lB8UJAVYlKPsEgY5PCNYs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuR8EblK3bp9Wr-76agvtJiJgX61ganK6N1kliWXcA3Q&oe=6A9C149E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQJHe-RW_ZYQ7kNvwFJaH0P&_nc_oc=AdpR_4TEePLAnuXcmCD89egK8zzBRE7QJOouU5JeknqbWQed7gpG1lBNeG4DmzmCpfk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgyGI-n18lO1UbKGWDy1rMuPTGoust8kwhH7G1Z6TsLg&oe=6A9C357A"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design 
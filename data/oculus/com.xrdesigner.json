8394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kj7G0I5V1EcQ7kNvwHUcuoY&_nc_oc=AdrMheewJvhZfCjZ03ItyeYLsVMg8g4UleP9ta2DsEqhsonIhMVmEUbuuwVKzC9FU3w&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hoPtaZOCoR1HKZ7Y-JhR1gzirzwHb0gh6udqTvLvebQ&oe=6A09D997"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBTtho5B9boQ7kNvwEmyoHk&_nc_oc=AdoCF-x2W8HVyOphb3OYjMuz_ZAcBQMcdkOzjKRAaRic6asSqxNdNwNQpzuzXjhzC1M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VSWXwWzyu2u1l9PaHstuRsqDMcdF2tvQdO1fZI6LoUg&oe=6A09D8B5"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D85A3eZK2UgQ7kNvwGkk7Eg&_nc_oc=AdqW0pqAgOoowJWjMCTU4aifks_wrmsrwaCF1bH6HoN2mjzBp-gdheOEVWRoBnNzsac&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JPwFtyjLkHhhtRmPvS-uTNWREYRmKwOmOGEy-fttRJw&oe=6A09C993"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCa1EygHa0IQ7kNvwHYXyo7&_nc_oc=AdqAMUdkSURGgvmbaN4GwfEr0KVJCLITOahUCHSfL_JlDeGysOhGgSTy4-iY5TVs8F8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yGbLovpeLvCcjdv7fEjhkIn2T6IjDsqagKarPc1ishA&oe=6A09BE1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xxF__PeQp8Q7kNvwF_OfV_&_nc_oc=AdrxvBUWD2lWokd0_wb7AJog9H2XnMC0WZ7ufqxBurEx83Ng_Js8XH67rzlYBpuVFlw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5V2og-hqQa4ov9h3K_eH89drHlvx-WbsGBJKaCL8JAQA&oe=6A09DEFA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design 
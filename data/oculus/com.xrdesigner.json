g?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nssn5tklx6oQ7kNvwG-_9ZC&_nc_oc=AdkoR0HJANQANi5JhHKsWkZ9H-uEvgLfVPRjL2sngDz0PGvCgf8tarbZKkTf8QB2vnQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIy4RSfpv7vWDLwpyARoZYGibwFfuCM_jUS5eAotKxlQ&oe=69BFCD57"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtUGjMFsglgQ7kNvwHCzEJv&_nc_oc=AdmLoy5VZSVEOD7wz5pEBKje8iNtnu3MVgOC6DIUa_31eDUjDqohaCAeF5BF8voHz3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyylg5_VtYuf2oQPfaTbTM1BRpy0EfA1a8r9KA9JHMoCw&oe=69BFCC75"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OHHBGEet10Q7kNvwHwtQ_w&_nc_oc=AdnOApgHgxiybU2PKaufkETVopK9mKueOjtf18YRSZLUANXBL-2ABZpXty8M7Ln4QdM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzhQIX-Urjde4v2qnepHNxjZL7WOJACLpXQoMVWSEzepA&oe=69BFF593"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_poOCSQHQikQ7kNvwFuVpH5&_nc_oc=AdkT7yrRz46A9YENQZqQtvMTgni2MdHmFpgm6YRFK__YSqxau63INcFIrOlzFr_8MvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfysO45mnYzR1QqYtfmN_hJNkGgcaTU7EIScL6a82fd1Nw&oe=69BFEA1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLowBgNfs_gQ7kNvwG2t77h&_nc_oc=AdkMMG_ucoNBhbLQcU0VvdnNIK7gIkzNqvgXopgPbCznJW3k64JY7-XgJzuiE307oY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwzd1xGb_nccaiFAExs-h1A4NkROqw_GazjEoHkH-8OVg&oe=69BFD2BA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNwvy50Gc9sQ7kNvwE08Kn3&_nc_oc=AdnCFYSBbBJ6KU9FzkpHLFGVOudGCje-vnPbGJtuQ1xIlhvFr-iNgteflVKFkFbGR-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZSJv0o8GypEaYGEsTtpLS_vGXAfJq4UIFCRG348WNBw&oe=69BFF9F6"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiolRsByp28Q7kNvwFsFQjL&_nc_oc=Adk5OYpddGMtMxZjPxUz81fH0e3qwtnkk8WX-S-MY3t0GiSmna9Q1rxvx-dOPdg0xq8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz32bLZ2otRtKjRzj6_N5Wp_npYEG80bVAz0J1Zvif8Ng&oe=69BFD5C8"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjGJVm1jo1YQ7kNvwEcoShk&_nc_oc=AdkwYCP9JhizQB1hOcwWhlO-79ujAITxkTPxzVT7pv51NYTF9xYY6twGakjX_ypxAnw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6d2MetGmPq6BxpvdmoeZm1wyT6PuNof1D9ux65cmmrg&oe=69BFDDF3"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id": "949107410131388", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://
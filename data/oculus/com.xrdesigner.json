_oc=AdkS9tuLakVx18mWDqFFwCOmrL3rJBECwhgdBthvP-8uGxY7jyPk4OLjat-0gV5jlXA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuULuA_etlJHT9d4yLR3R_Bvo8jfh3553DrConHZ0wv1Q&oe=69984057"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lk42bf1rtQUQ7kNvwEGOBKB&_nc_oc=AdmXL7ccKu9yyf2T9qr7Ld7reb5sH_9xrllMbl5fPmkPmkgZaoGxt72JbBgTM-Bb1Jc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu5bHfOKqWQG94JS1F-yETfRxjA4erYiUQgTZyKUcQlXg&oe=69983F75"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pDGHj_AtLkQ7kNvwFJ5BHO&_nc_oc=AdloFMSzKeAIl41E1Afhjx2Y52swV3gST9w3QhdFBAbkM0vlKliHlR94aq7jZCN8JlE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft1H05U5SvGSh_GQtbRNM-GhvDbH8sHl5sO_H1Xs60zdg&oe=69986893"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kasg5vuOxAQ7kNvwHMHHCX&_nc_oc=AdlE8ij6ApmiP6s870NQvic3w6BM7YNQa02dELRNS5y2uRemuhd3lqu4Eu_ILH4K7EA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv25ChBx5eVmxf4C8SxIL26WLccSpM1peB0SStcifkvcQ&oe=69985D1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjpO7qIVD68Q7kNvwFFm0w3&_nc_oc=AdkTh4CcOki00vBxT4O85abzWHnz1cPZPMV1jzct9uR3gzeiiJ-J8QMgv1EQt77Bkbs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsrZdyvuCrGtRHuHcFXldeeYfznk3bnsWVcbHRpnZmmNQ&oe=699845BA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7N749B3-xoQ7kNvwFmYJAj&_nc_oc=AdlHlAmK9axr0Ypc4zGTL_s7p6xj7PpMQ29LVPcgi_Ns5vSLvkIWtVt2_r0bXQCBKcI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuHOT1jR-e0koaUpdPYhwVukOBRwfdnbrTW7lNSbew9qg&oe=69986CF6"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_zG24zs5AQQ7kNvwGbEJxl&_nc_oc=AdlLPcHbELPWmq9m4dfv-iU5s0eUASwPNJnD42OVeEohLmJhMsg1jDVaqpW2mPLq0GM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft4GtRW85QIcaKV3z0XrRxD8VHoNHHcF9DAK61MN13Jsg&oe=699848C8"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8CXpHLvQEUQ7kNvwF1ti7b&_nc_oc=AdkgIZRTTIN69jXoypSltC-sTjE7kb9U4tfqdbtniRUYUHh1hMg4QZUOM8f3DNUg7vM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsAW-_OVX5qLgkQph8wO22Sa4iWYZjqPo2HRZuZRdl21g&oe=699850F3"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id": "949107410131388", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031529_949107413464721_7614679926193402510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39KSff
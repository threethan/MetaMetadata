691032248394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_GN1cdwAdwQ7kNvwH61OSQ&_nc_oc=AdoVqpS_RayVMAOT2VxQ-wC-jwQSkpHLHgyrZ-04ayro-hIVNsIerHnxGysHikI1pAA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZh9Aa9WS5sYnOBC-Ed-KDOMUbLWU9w9MvYf7XZq9j8A&oe=6A7DA557"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqmocCxzxRgQ7kNvwEemu8m&_nc_oc=Adp9l2Ci0dj8lNjtx0F53Tzxmu84XIHG6AclXuXCKhrGrpgjyIs3vqRVV-QORsCGoN0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb4HnqqZTajgAr2So3YU5vOiLgO9enhSEojc4v0f-azg&oe=6A7DA475"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85R452F-G1cQ7kNvwE2yPu2&_nc_oc=AdoSPJoDortFkcYCybtdnjKWQJ1WbEGYH1KHwsgAy7u2V6WxSpXkLpcu7ue8RkwEYzY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdq7-FscQMqSl7yFiB-HuciNcrB8mIO_SMpyGfY4B36A&oe=6A7DCD93"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sihIME0ztPYQ7kNvwEHc8G2&_nc_oc=AdqLrP6iJlZSlUb15h7kwfi8hTRKou4sCOg2chXNsidSoxics-A9jiv11sL4sG0jlA4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEti0N1T0kkNjbcEu7-X7USfuwM1o9Eucb0jjUSJW7MVg&oe=6A7DC21E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RM2M9BzhKdYQ7kNvwFsoIfM&_nc_oc=AdppZY8pZlLDYOV7ZjiDrnoPrQVJVsGOXxQsy83PKASUStmBRqf_8vKZAlm3Bo4531Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmqXXEKsrc8yWpxH9DFQcHjKLtbxN3wdJYVcot7Wm19Q&oe=6A7DAABA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Morp9u_0YuUQ7kNvwFhu8Y9&_nc_oc=Adpms7E0vYMMbYI30n08ztReQkbAYb79258m68Am0PpN4M-jJjuJMiQhd3rZbfuDQ9w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECiACcsPAf3FY-_XAGkuhywJD6eGu0RhbinBwSDW9OSQ&oe=6A7D99B6"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cgoKwfHaV4Q7kNvwHqY1S0&_nc_oc=Adpt3v2N4c_1jZhgyR8Xz0E5aWthjNBkTw8xJ7zWoRSJ7wz2VJUKxceMdH2LUUXmM1Y&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqn_MRmRVySblZQ2gtb41NJgA8g8zezDT62jbYiQbJBg&oe=6A7DADC8"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6H591m4RT0Q7kNvwH5ALUn&_nc_oc=AdqLX0k-AL2xNHYznGNs_8qRU6BaP1NBkpgsHMw7k-auFrXTTnZ06oNgLgushhShdUA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlVNnj3mta0G0rkQOzi2_bsbLUb_8FNIaWGI-Y56nacw&oe=6A7DB5F3"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id":
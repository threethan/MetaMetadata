8394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgjFQnrpvl8Q7kNvwEd9T_J&_nc_oc=AdouAzhdKgPrgFjqSjnSkGAqU0PQi1vaxhqiInu9oHjmNPjm1AniMIs4Dta6yvxsDlw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm433HXP_3QCyrKWK1Es9A8zQq32Z9J4slI113J_eqrQ&oe=6A677417"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEAEuWIkTvgQ7kNvwHTrQ53&_nc_oc=AdpHNfbLpk3NMPDMtaA-jUDuvs6W_R6fxEGAnb5cPepi3Y6bpeYfL8qG2W4zMSRZVnM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmQnX_3Da7CTlFNFdZSMJaz19CbAR7aP0tO7p9bnk6_Q&oe=6A677335"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoCwa4Fnk9MQ7kNvwEHGLKb&_nc_oc=AdoE-aAQZvW_LNy3r8ocvuZFHvZ7dT3an2TSpZm6Y3EKGIsWG9fCQrTZ1WzK6lHeMF8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbvHLWkRQZbvHnoFnS-cIaB-5VoqSKqvoWbAXuRDtu4A&oe=6A676413"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2lp5KLdIK8Q7kNvwFfScks&_nc_oc=Adrwk9nInZ-SLRdgnK8NeErfodY9IKg0n2crCkeeI2_X5XB4lzmupfjBdDCvXMmqzgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqb930QX-PHfaBzBpdjgNWWuFhfKxiiJsbEUcQOGFVPg&oe=6A67589E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPFm6Uk3f2gQ7kNvwGp6dsZ&_nc_oc=AdpCzB1YWXW38ly5jMUsJv_EATGvQRQht08uIXXkaP2wrqTm83okzYu5JvqDQW3iKZ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA52SdJvdS3oslAIDm5DE6vGXw0U9_3sRHtpl-pvfXgqQ&oe=6A67797A"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design 
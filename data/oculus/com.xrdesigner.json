8394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_GN1cdwAdwQ7kNvwGeK3gt&_nc_oc=AdogzQPBfFRNMyR9uLp1ZQ7DhdmSEjnBNRiw4fbWFyI8MwWtTdRpWglZFlOfntY3E30&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5QqatoFEQ0KQXdhMYApRYku8zXPs_Qj3GGuQPMxoiRQ&oe=6A7EF6D7"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqmocCxzxRgQ7kNvwEdusEL&_nc_oc=AdrNncysaod8KQz6skZuDNknsiyQT27JhdwiGGNPboaiMbw_OIm0YGEJLoTVXOIwEGk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv9Qt57UnQIu326OWOclcgZv6fU1Tx6n5QCY6usx81sw&oe=6A7EF5F5"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85R452F-G1cQ7kNvwG0hdlP&_nc_oc=Ado24YBPWwl0-LgFYsmcgh4S5JqANLVXoh3qGG9pT_ymmC_XbHogO1oae67jLrBoFPE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuusyVBM_wVuQdlivegaEDZCPRmjskYPDogcmi-wbDCg&oe=6A7F1F13"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7IYFdv6hXwQ7kNvwG3r_sP&_nc_oc=Adrra11kA2gFMi4tKgirb6aLES1OQgXa2N7m_y8YqwZt0KWUBSRg1v3M9Nq5vwwUP98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg3t6TUNLjRNyYBF7AxMYLE3emkhzSeAVrR_1RondbJw&oe=6A7F139E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RM2M9BzhKdYQ7kNvwEQYDn6&_nc_oc=Adqkw_o6Dje4sf_2pZGmNvmtofNAhoBoj1Mct_-lcK46zCIv7sJSSC2bt8_Fi4AKLkc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSMZoN4smBoKKDoUJMbbIfNJr5dMvdB6vY48PyjPjYEg&oe=6A7EFC3A"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design 
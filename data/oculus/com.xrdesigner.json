8394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRArNRX1El4Q7kNvwGUhzR0&_nc_oc=AdrgrLALarzvKgxwrWP07dvrHs8CkRw9ecwLYMKbFnouByS9mE1FAYQA-MQtcRXdfTE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRRzHRt8tFIwcEYXK20zqGVRcc4VuL99ew-5qagJR2QQ&oe=6A53AD97"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLsYu9LkqEQQ7kNvwERZNah&_nc_oc=Ado5KdhPMdn0SvMBiHo1zpzRKkgwwbMKTiS3q7DSAgw2Ue19ycFhvT81uMdaOnv2DKA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuA1rAIjLSMYc6gycRffDxyIkEFoefBYIPD8scPOoHdg&oe=6A53ACB5"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8atOirj1N5YQ7kNvwF0o-or&_nc_oc=AdoqFehj-Qwela6rRpehEZ_YFP41WaPsEPDpRKqnY9vO4MHN7oIyZwnwDildfOjDHdM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpDvnLOY8eBe5QlODMQ7jpCAdu8402MPsdmy7LtLrxaQ&oe=6A539D93"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLloF5jgE2YQ7kNvwEbKBpp&_nc_oc=AdoWZQ-J1c2YGeKcDpiNPzpQPFfrzdFMSpZ08etv1sReWIlawmdW9OSIjXH8-5VtV6Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWYgiG0rCP9eUw7TwoDUeI6BbFd_C336JB5PKXItebZQ&oe=6A53921E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9m77mbok6cUQ7kNvwFizvle&_nc_oc=Adoj2u2xAPDS-sHjGIDO34sk3CxCh94LXh5c4pFZsrGtevD8byoBVk2eejktKE_Xcqs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxA7hchB27pt1Zq3mC4HuwlLQVpqFa67wmosYNOynf0w&oe=6A537ABA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design 
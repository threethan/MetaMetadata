691032248394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjDFwiN83P4Q7kNvwFLqxKS&_nc_oc=AdoD2GFhp-DVTq6S7JfyPme6gSf0rDO60MvfoJRhZjYFPlHDuJH3qjFHYwEGN0StIC4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ3pUpdgo0_NcD1am_jzV9JugS_Kshxet0XzUBk3cgYQ&oe=6AA95F17"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXNn941QXDwQ7kNvwHWwiUd&_nc_oc=AdpquMSXnQDzhx6Qt4BT-SGanTw-GxFKlhcx10D4rV1mAOhMK6e1trOdoj4nksxdbrE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVMsjKlwaIzXR_cuYFSDphudNWjDCqq5iJmfD4LimL7w&oe=6AA95E35"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD89Z6b9Ka8Q7kNvwH2upTM&_nc_oc=AdqkIAL1xMeKvwXmypPIKL5BzYgWBZPSTdGaTX5faza26DDml8dgPW7D_Gb8LeXdqUI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKFIb_SAxdtxZqVV6We9kqLqfhD1s4cVdFfEhAJj4qig&oe=6AA94F13"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chaw-wu4MCwQ7kNvwG7saqY&_nc_oc=AdolcgFdy4aU4okqQ-Jb56ql0w7zC_5jsa_8eOjTnsmCSi8QIVZTytje5eDTw9YXU1U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyKnK7xBOKeJcGxU0cnCF3phVwfRvXt9MACBR6NCAKaQ&oe=6AA9439E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TmeO-AaU_QQ7kNvwGAEArL&_nc_oc=AdoGBI-QMmOd-yoPzJGSxBwBJ-pDcD810hrrpanPdYbng9IWVo9IXLXTV6vxwXXsPAU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMtCZK0d5e4iSDurAzSjCNgiSiKrARWDgzbUs50ECVtQ&oe=6AA9647A"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4EwdvxBljMQ7kNvwHarHy8&_nc_oc=Adr8bvDdPgyl3625omt_tebATrdg4iRBmHI8cbTf-NqtmlXUFNwwWydoGwpai5BybrU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjTcZIup3lssshAWqiyZkoweYdVSjSFbf8OKAUuP6DFw&oe=6AA95376"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyaEdDs4VqMQ7kNvwHdtThF&_nc_oc=AdqhHPPHd_YeH6OAvb9Sr7dZxrq2fkDlrGosI6urLElSfAZZpdBgJp3WKR6G_yPx0SI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK55RtA7jBCDzEhTYGCuflQ3V1zGuRC36vLGJPuEasJCg&oe=6AA96788"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7PsUhofTdAQ7kNvwGgdLER&_nc_oc=AdrDPBKKSQV6oxFDXWxWRTECr-0I-8uPRl1NyG6kwDuHnspMjwag2v68j1gs0U5BzKQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYxAB18dIvZfLqvl2ht3jSsegASZZhXNlEJeYR9LjM-A&oe=6AA93773"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id":
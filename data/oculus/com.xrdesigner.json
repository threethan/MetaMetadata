_1691032248394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pzvh1uALv8Q7kNvwH50fbu&_nc_oc=AdpIg_Af-VN5UoKruEnSkZMUrhibGVc7NRfvBgwMy6M5RDdMIqjjhXkYoccfllT8o0k&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHENCA6wZgXEr48esgNWFtsQTHkb56uirGHvPiHTGnCHg&oe=6A8EC8D7"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTXklKMV9eMQ7kNvwGk62sZ&_nc_oc=AdrRAedezbDAACW7i1ac0qrdsiD6RrBHBNJbKCaE0hK6XCb-6fmUsAofJNb179Z0tGA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhmWjHfs72k_bVhfrlNBDlZ4804HPV03kFFNcCoY8dhg&oe=6A8EC7F5"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKgKJtg8IloQ7kNvwEOnCHh&_nc_oc=AdqfSUx4fqL2CaB76Nqo3HRzB1XRzkwZLG4b0o9ejvh15VhG4PQrDOrqhKNEkx-7V6c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbHSqusXokENDjik3nLO6uwNhcHsqXaQ3rJ6JDqwv9iA&oe=6A8EF113"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hBRztoUP6QQ7kNvwG1fPv8&_nc_oc=AdpNzfhxv3O2DaI167jnq_FNWaWVGCaSkGUzuPaBs5-r-yl0lpLEHtJWSFIr2FkjutA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyBEXIn9SjgcoFKJW9uaZV8rVFjyx_u6yWXdiI8Fl2tg&oe=6A8EE59E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMyeIg3XZ84Q7kNvwH7NRKy&_nc_oc=AdpA-OmubK4DoU3MJQOuvzlqpX7amKGIoZ7AApC_EHrUR5Uv3NuR8NaNpCstnaZ04W0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHai4CX-KU27xDIFLkHs7xq8QJxdIcpGimZaF8gvdhJNA&oe=6A8ECE3A"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHodmKEUoecQ7kNvwFyU3QV&_nc_oc=AdqZx4JijXZX6Qt0J48Y5md_56rP3BVrmQOs7KnrxnVGDGRAfo7i2cNvcle5piZuK3o&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJboxNbi-MdOJvdbMmCTd2R0W5CRLeBPi-9Z2Y0x0Y_A&oe=6A8EBD36"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kcCDyyhrSIQ7kNvwFU3ZZp&_nc_oc=Adq-M_sNr2Da3qyTrQyBXrxEaWHMawKRuU-PKrGaFDRbDLx2wmPfSKidttKeXD77Mg8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTW4yalk8hWPd92yxwKCMWlWuTIJtf6DZLRlZ4gm8SMA&oe=6A8ED148"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xF8VQZrdUp8Q7kNvwGJI_0h&_nc_oc=AdqY_VxPuxv5kUMvDR-o6OG-nVfKozj2G2ucX9OKwi-3pULrs8VscW44XwIn5crLTcU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBa3gTB1s95rZCZbpctJfMxfdkOV69RKhVJHB4Yj5QAA&oe=6A8ED973"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "
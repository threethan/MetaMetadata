691032248394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nza9nbNw-jgQ7kNvwGf1CMs&_nc_oc=AdpT_0QB3MRAeJD_U8heQdb6GRAV5GJYZnAMAXMRLfUWD9FJEocWXJf5eJiJPdRww_8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sOjU9t3F4RAclwSf15ZKZbsjJ5UI-yPC5qg7TEdWSVg&oe=6A36AC97"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXoAZiauJSoQ7kNvwFvl70H&_nc_oc=AdqoRKE8kdFkRPRP7C7wed2iPio5Ipeh296YsGh1ktNtlNQVqjgYzoX21C9qq6DvqcQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8UGFeQTnvpiGSzpDlS6NFXv7ZiU9J8yt8P22rC_DU2w&oe=6A36ABB5"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bfhoj5amHoUQ7kNvwEXRazz&_nc_oc=AdpUZsar6HNX28qv8lbQ97IOlyWgq8fjV9nbOeBjun8mGXLCz3-80AAfuowA1pzh4c4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nDopaZrRKQQQn6ZfrF2CCreIej95SBc4eVxllDx-FEw&oe=6A369C93"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I24jPVwSJ1IQ7kNvwEXb5f8&_nc_oc=AdpRVzCd1V1kCOGct33cW6VT-QInrA-gopbXd-i20Q2qqKeotq5vAE-D9-nhHZCyRw8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w-I7b3IqQ1MbY3tiJzR3_w3k2tkSjg3LgAmnlA0m1-w&oe=6A36911E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHsrPOzaDrsQ7kNvwGr1DXU&_nc_oc=AdojSd7rQqtdz819QntLOJ2h4d-RbVBXQ_RWv4g65SNKtWMLcX4Bp7EcIFBPqq232dU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4aTKtk5DOZ-wVQxJSLQXRXbWx0d8NdWupTyosn1Ol6A&oe=6A36B1FA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3m7daRZ7IEQ7kNvwFboym2&_nc_oc=AdoYJJw342IAIaPv_xEP2J6RFP2Y0N4ybbSjlMa-ihtISg9dyzm2Jqu5BuPrUXhAyvw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HeaEGhUF0ov6MorE-SlujolAetz3macrvlfV-TmY2Ow&oe=6A36A0F6"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crbFjxBH5wwQ7kNvwECotgq&_nc_oc=AdqteOzneL-Q4OxVESUXGf1nMiYwEICWsdNq-xehrvaD8VvSPOVB-XYOMkoF4EAWzno&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K0m327S11Mh-buoczbKyMLhqJAcNkbrap2i5dFykA5Q&oe=6A36B508"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGF_ov3ERjMQ7kNvwFsZF_X&_nc_oc=AdqyuV73McIV5e1zRKZ2veg8d05TZ6JnVBBZ4PRxJyhZkantHyTrZDb-qnlUvB6JWcs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uSfKac5tiexnSYkW2AmAIfhJ3J2E-tu0BvNv4PmcdOA&oe=6A36BD33"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id":
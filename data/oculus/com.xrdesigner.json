vwG7V4i5&_nc_oc=Adp9ywLL7ZXUkOyaX2HLnfVkqjtc_4mcfU0DUNFHyBcG8DAx61aD2ReSZW4rQ8JogAA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsjf_JdhQtInz2g8ysSEODx0pgExhzSaGBStOT-_9mCQ&oe=6AEC8D76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440px.png", "id": "145909078538485", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86641450_145909081871818_1469081559402083801_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LXBVe5JDH0Q7kNvwGkHRV6&_nc_oc=AdrsZLWWf2LvTJzhg2PrpsAIMHTC07NHeflM7GqqgYXVZS_SQpgL1Nfgb3dblloYPaI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnhB1EQpnwtaBg5A_wqzBkGPFjhE5nihoYZGNyhms_lg&oe=6AECAFF7"}, "display_name": "XR Designer", "keywords": [], "long_description": "XR Designer is a VR game that allows you to design and share rooms.\nYou can visit rooms created by others, or upload your own models and wallpapers for use.\n\n----Functions at a glance ----\nSummon models\nChange the texture of walls, etc.\nVisit other users' rooms\nCheck your own data\nLog in\nSwitch windows\nChange weather\nChange background music\nSave Room\nLoad Room\nVolume control\nChange language\n\n---Controls ----\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller controls the menu panel.\n\n When you open the menu panel of a model and select a model: \n You can summon & hold the model with the upper trigger on the right controller.\n Press A on the right controller to zoom in and out.\n Press B on the right controller to rotate the model.\n Delete a model with the lower trigger of the right controller.\n When you move the model while holding the model, the model will move.\n\n(More detailed explanation can be found at \"https://xrsns.org/\")\n\n---Special thanks---\nBGM: (C) K.Y., (C) L-side, (C) Sound Effect Lab\nModel: (C) MASAYOSHI, (C) Dimensiva, (C) 3D Shaker\nImage: (C) Pixabay", "short_description": "XR Designer is 
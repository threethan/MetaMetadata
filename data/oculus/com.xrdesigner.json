691032248394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vmefAxPpbYQ7kNvwHjOr6a&_nc_oc=Adr-kibOcm4GQoQt4wHAEth4M-JaLNVt7KKvAXGNPmSfltdouthFZOh3Wt8tjAgMLVE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi5i326K_3nMNp2YuCzARezI3s6AFuuesGHDmD4L-uYA&oe=6AAEA517"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nywjFZOEccQ7kNvwG9Rf5w&_nc_oc=AdrR_FfVcsNyJ2Opb3ubOB7oK03RsU9XwBGCcNDuGzb22HckR3ALy63YPbGfoIAWjMo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt43TCQtgk3KlRd2NebzMbVTndt2HDHGDWVran3RJ0zw&oe=6AAEA435"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VI8H0nMhUSIQ7kNvwHuTb6i&_nc_oc=Adoig8kg-C_ZlNTcNph2s9GGyuJ-lMaooh-NBL2A-BlO3hZM6saGw7DWPWhcQAZ5PCM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhUSrUyvk2I-QFexXNBkq4pijOoFH1OjLe7Jcdq8uT0A&oe=6AAE9513"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHngG6SNHlkQ7kNvwFB0NQ9&_nc_oc=AdoDCqmRY6Lwgoxa0xd53Yo5MUN9aboLj_9fZg089HarcUnQJdIHLau71bhEsBVHQqs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0laCdh_BVWyyi45Ot7CCPr7MDZfJ3Nv88AkRlznaWEA&oe=6AAE899E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChvTGJY9Ct8Q7kNvwFd3z3c&_nc_oc=AdqwTxfrWqdMAIVfmDqvDUD5-sc2-8xzzgNd7262LljgeFQLyh8RAeHn-hWEKGOTdd8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlJ77RgHEk8mlqgB-mRc5wmWHSbv5Ye32Ynjo3NgVyIw&oe=6AAEAA7A"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLQk7XFONLsQ7kNvwEkTOZl&_nc_oc=Adr6Ysp6cNa4Yc0XlhNMAssYAhgOAw9nD9vNGb5I31lk1ZRnbSNMth7ynNLMDkYlZlQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYpH4Ma2cheTjSvlU2iybE22W1Mu14fI-9y9hzUhgguw&oe=6AAE9976"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yM7Bp5iHfF4Q7kNvwEdXZXk&_nc_oc=Adr03cYCl779ipKJF0b1Heqk4CQ2626MWc8XS7qhIwLdem2j8gyBj8zvhWZ4ek3hJUE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF3uPybENJA1_DjBpUyZx1XsSPU89h5l91iaxULGOazQ&oe=6AAEAD88"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMHcOREzf3UQ7kNvwH6nTyk&_nc_oc=Adqqn6jyEEzV7lsNyN_UUE_u8vQ2VwDVsdovxdlhfJWl18kuZBsqLV-FW-XG8AhLQzY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuzljT_n6_vacuUS9yEx8hFy9sLWNv5Kv4wqYvThjYYg&oe=6AAE7D73"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id":
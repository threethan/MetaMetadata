g?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivbl5uyBSrUQ7kNvwHGjc6d&_nc_oc=AdmlMQzWPaL2Dn-3psQn4lF-CIcr7ld6yHXw9MR0kQh-iLfmJLNCp98wp-K5FAD_itQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu27dB4M_-gRxTvFh0Wg2fFur_HrjbesLWbLElou4kFrw&oe=69A963D7"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLZDhqtnVXoQ7kNvwGCKhVm&_nc_oc=AdnlF191sUkhPsN7MytSpwzvDrQaFARpeqz1klSFXf4Pim6QZtbjrg6unEk4JVOeGqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsF4VEa234NyEgoQqGCsmLlqy3SPnXQ5vfJaR0bccN0hQ&oe=69A962F5"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_szGGTHXpoMQ7kNvwFLC14e&_nc_oc=AdmimXn_m2Zze_4nzyKOPaUp0nD4kEqgmvruLNF_nC917DQ2Z9to2K0erSsB8KNv5Cc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvJTh5-ncdz-_qko_YMlJnP4PM9yzvIgl8pkhCDdTiS0g&oe=69A98C13"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0erfFFCBZlIQ7kNvwHHnnzt&_nc_oc=AdmBvJR6ryNc_bzTbJi8JXqvdvPJ1Jl0_HU3mYj4CWVl1ylisHzX1FlL4L9lSAwpqq0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvHhMJG_l3Jk8KbeblvvqgWqU-_knW0FOz-ZPNIxN33pw&oe=69A9809E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEdfsLeXC0kQ7kNvwH8lyVK&_nc_oc=Adkt9ZA3lxPNCcH4KZOky7HNrGx1e-m8s6xxWFAw1bd6FfA2z0XTmm24koMvz4e3vdQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvTOtmBvt6OrqKSog6h1b4Yy4ssShljUonEYbxfMxapKA&oe=69A9693A"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzQC_l_0DlIQ7kNvwGxHrQE&_nc_oc=Adm-TwDxVB7KkCoCWRUaNbToSYhOEk009hiqRvIJnsNE1Uel00pbo-dcnJxsWk6hnXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft3f8Y9sGECN_HuiQk9W6Ke3pnqg9RVz45HQznVx8vVqQ&oe=69A99076"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhowSwndGLkQ7kNvwF6-8BF&_nc_oc=Adm9c9Pxx80gasYEVmIHbZ4F4eZ0vzdkCnk_M4GUul-ATch3vMYpRMuwDrmhmCoJ-9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftaxodQlVvl9-snDN33cMGlZmh6GS6EflfxAzHQUCOw2g&oe=69A96C48"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k22ladwjjNwQ7kNvwELxr0V&_nc_oc=AdkyMmlz73HZQkMsUYzHifoVV8t4PK089vOQW5_RD1gPnr-0huLeMutKFPy5RCZ1rVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsarPkLYCT3OItv9ZmA3XPm9BkymOMAaG2DWekLk-nNsg&oe=69A97473"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id": "949107410131388", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://
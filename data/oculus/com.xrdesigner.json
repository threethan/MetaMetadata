8394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTy6UShpKA4Q7kNvwE4s2tV&_nc_oc=AdrYS3uEUpicFirz-5fMBAmBUUm6f2pVlck7EY0KlbYrwePKY3iahoTZKa59tnKey3I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzpgTC1GIliVgFGCpaXNDd7JfeiGN6tWoD4wizQu9CC_A&oe=69C7B657"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8s4_lgBOd_EQ7kNvwEon0J8&_nc_oc=Adp-v1xMBJo6Gkk5Nrk0C5MFy65BWDZX7LKVx-D3ayFLjAuOMgAAHKiKRtt20o0vj0M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxv27-lGHnJVlTxIkWxNnr74y50_9BayOuJxYgl0lP5wQ&oe=69C7B575"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnE5DQZZCZoQ7kNvwGcRPLf&_nc_oc=AdpbuwtU5SutQkqJm3wBG6OCgbRXHuMOy48afrDUtymAwttgOuu0tX1vzuNvL1GQzQc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxb5t41ZebZNtfwEVAol3xRA1EV75Zfuczk24_CDPBhIw&oe=69C7DE93"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFjrfXdDfasQ7kNvwFTW7N7&_nc_oc=Adpri6j_a0v1X07fO2ykMO8aM3BdN0eKrN0mjO7rVE2eM70t5vKzGyeyL_lHU-l1GTc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySKMT04WpmJCs_Iw5a9vhHTOQa1hGMwz61b1u5jkhl4Q&oe=69C7D31E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8XhdEoAsy0Q7kNvwG1gae5&_nc_oc=Adp3Fs0DO8Sg9RZCbBcNEPo8hPvZuKwmbLwRfZQJY4zawq23Fr9bJealS0OTOx93gdk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnB_oizzavZKI6T5RlhWApecTDvzQbRkyVzNB_znHDJQ&oe=69C7BBBA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design 
8394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UK_Pkl8QJcQ7kNvwEzne0e&_nc_oc=AdqdOwIcFjWX6Fp3EeMNV0Ngu9RCcxo4cjqrFHGm1Qn0CDIMZv0zCAHwlEhtfaKyHHQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-o2GUAiGrnuA-t6ydiKj1oJJZRutiuFAHWaFFixUsiw&oe=69FDFC17"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsyMsdbeSEMQ7kNvwGBnaoc&_nc_oc=Adrq7c8Of3CY-9kYh-9BeuzkvqURzQLy-jN3hU47Gf_kylZU3DeEfBfr6WopJ4xs6qg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JBd82kGdIXDRsjATDeFhPx0-e_M9VwOl_U_iJFmfxLQ&oe=69FDFB35"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cS5cfwLh-TUQ7kNvwG9oxG8&_nc_oc=AdrwDPQNF_IsIcYyUP6sFKBne4Ob5Ehva973rSXMM7v7GhN56Y-GUdo2tkdb6KaUIS4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SI1Gil41eOyrF5MlpC2gm_23M-3Ucod5yXnOfhq5fsg&oe=69FDEC13"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QQtG4FoCOMQ7kNvwGbevYv&_nc_oc=Adq9UW0uYlbjsEdyAS7yMFmMRqZaf50b0G8oc9ir6bqArRNF7ZzrlHLa2GZVNRNRDMI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DDTTagVlNW2nwdxaHuXe1jOt3SU5Sd4GN_ZS687HKig&oe=69FDE09E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYgtlZQOX50Q7kNvwHYTijW&_nc_oc=AdoBPlgRH3CTLLF8QEpu9tSgRCvYSdwmkZgBZFOFWtcWc9KGWUi7TZ72u93SHk_lUME&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jTV4CFJQu6ON2uir8Jvk6s-9NIBMBTUvxAmJHjTSFkg&oe=69FE017A"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxTXLrUE0OUQ7kNvwEMqSZb&_nc_oc=Adof8zOASN88W2w220nXMVbMaEamgNlhcFk3-jdxRE9_N_jGF92FuZdlQawB2LhGUe8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AMectIuBEmnZ7abeS0CtxH0Xbgc-FPJw-KZjqiXzNWQ&oe=69FDF076"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5yPLCBHITMQ7kNvwHtLi5O&_nc_oc=Adp_dPVZVFeBKDSo8S0qO1qwVrs4lhkxwdDCDrude2EQjZIfVhnAMWivoqqaX0EKehQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Vj4S_QwZt7RUEwl6RHSyi25gsyJxUaP7q-uNMYno05Q&oe=69FE0488"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDwnqBO3LNUQ7kNvwHWz8lK&_nc_oc=Adq9mOOenfinkdHL-qoKGlYZvB2leGpTDtmbkCKZb0V5SoHI-8iaWxAGhtwEP5jCTzw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Vra04xnTHeTQp3M0ftXLu5qV4HtqsqiSX0JcW-dEu4g&oe=69FDD473"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id": "949107410131
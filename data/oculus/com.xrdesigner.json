g?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8XCg4zJDBgQ7kNvwFG4EtW&_nc_oc=AdnLGlPG2mJ4XAit6oWl8pGummVXZ_ULA_S6QIDsXby1wOsIhn694xFnz7NYJRPcGZo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6H1bblnGJuoLuyv55GJK47DXM8eqKYk4xJFBroatolg&oe=69B29E57"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WHHttrlQJoQ7kNvwHu6Otl&_nc_oc=AdlVzlP-kMz8x_OuNJkmbtXCZCXpGKmIhCOCX0tF7iCN0w2z8rUlBxGtx-GVaQ_w30k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0Pkf63RUvluuZMMeKpIAjM2pq9TvcLijl2LG8m-dI0Q&oe=69B29D75"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bIMh-L1jaIQ7kNvwFRbgro&_nc_oc=AdlU-qvTareAoPuwdIaK83lQEAvJyOd6l_2fgsRMqoQZNHvVFPDH0GlXo3UvRZnBsGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhnFpSokg5K3HI_qh8Tq176DTUDiEIaQB-kZo2iXgLsQ&oe=69B2C693"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3Nsqq0-phoQ7kNvwF4KpGZ&_nc_oc=AdlMsB2DtTYAiy4UW9WU4WMUNzGecCtHFm5X1D5TwBqQ9SvnOGsISN-irUBOI4W1yfQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzDwq4EKgPVG2xLzbE_4my5r3TiDvtkY9yEOJugkYn-Cg&oe=69B2BB1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nK7jKyrVhYQ7kNvwH3uu6c&_nc_oc=AdlaCJBcWks0-nhhzC3cLdegGVV0qoQ6OQa7y18bb7mMdBY0zdpa36ydrAFzEkm26eE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzv51U0iN6v3wRzawkmU8dtHPf-ezn3hBCGu8UsFQ86Jw&oe=69B2A3BA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKldpYuY59gQ7kNvwFw3UdU&_nc_oc=AdkcteBPxweFEeg3wQB4XjS6bgEhK2cwCYioT-Rhk7sHF1ZzuqgljDcz-XdEDc6BheM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVP-ZH6_6yqpqvVi3Cjk81BIDyRGPQhIDH9kwHN-jsdw&oe=69B2CAF6"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aflqbn4KREQ7kNvwEe7yeA&_nc_oc=AdlWwg8HEeXK6aLTGf2zrZoJ4RzLwzkcijEFspCrCHfkxbT4MQaozb8FdcuRtcXAens&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyl9mwE2IudhcWNNILvbd393qoo8EAbS4CyS1-8Zc1k3w&oe=69B2A6C8"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O04E3d9B7CoQ7kNvwG_XFJT&_nc_oc=Admv3Hj9QA0VR0_0YXixWDPkbSIN8YthNPjbZZUqP3lz5begvSX3lS2Pd9mRxYzYrfg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxxcDONmBDKHqKLjItsTQUJOVRYh877W2GNvHNLmswsVQ&oe=69B2AEF3"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id": "949107410131388", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://
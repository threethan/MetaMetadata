g?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8XCg4zJDBgQ7kNvwHYJVb_&_nc_oc=Adm5AqrknOGvboRXivkRayZ5rzLa69qJ50vrPzDHz7_Qfp7uftJNr6YuXXrlLTItpaw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSSCko6mCDKdnUKab3r8pWFLFST1UMlrv-1CDHjWgsPQ&oe=69B54157"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvGy3rtsgVQQ7kNvwGNWqYG&_nc_oc=AdnaDXnG5--veCspsG6uo1i-GH2JCR_r-AwDaweDyzE1u7zvd_ZL4QpxNfN6Wind7Fo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfztwN4Z11ecbS6DeEd79raROoFVF0WfBQiBrrtlg_fmvA&oe=69B54075"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bIMh-L1jaIQ7kNvwHvcQx1&_nc_oc=Admt4pLeGDr4RUwpveP51jVJh5KMuIkGo7CGqY53BQF7qMo6mIWM_xkkp5R5eWUAZgg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxr0lux3lPftfLdkEBtXamioQsQvoz_f4ZpAd9erRqvuA&oe=69B56993"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1DG2Zq1VjsQ7kNvwEIemRj&_nc_oc=Adlbciv5kNevDhdWUsGzU0aC10J3e5zNJtRP19Pnv-6fadEv8mm8KazR5x6JMSwqQEg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqXGpjM0p5n2ILqsMzsZdOG9iIClGbyLRzLWKX62L4zg&oe=69B55E1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nK7jKyrVhYQ7kNvwECjOkk&_nc_oc=AdnZr-gPkCRVaye6bD0fy28D_MftChwLC2eP-DVHE92EcEb3Bw6FEBBCia3vlUoLnt0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFa38fpfcxqlbjLR62DH8FDspVOA02FHqcM0VvoZF8gQ&oe=69B546BA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdOBafn3bQMQ7kNvwGAH0_Y&_nc_oc=AdkKjiE3hr5tKTHgisxOw6MJBqLsVEQd_RBcIS5HycrZwGa64yS4XeIFwVOjfnOYxQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfweSJIwPqfxnynWOyuhxy5gZdg9FpKqnhvwm-n2njGdmQ&oe=69B56DF6"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aflqbn4KREQ7kNvwHw2JII&_nc_oc=Adl3nVCoS7lpETH1brLQ9jbtqjYTa_MwKyWF-IA1GoIXFwSZc0hvUD4zuNyu8F9ISx4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgSX7Oc609AQGNb1l5lWMGWoH9GoxHocWDAWk1m_hBUA&oe=69B549C8"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aagr5OLq33kQ7kNvwEqS0BO&_nc_oc=AdmfpSL6WfoIA-KDQuVye24p91lHP9WYaoqAD0c_8vCy_acyFgs9ePK04l9lv5RhZwY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBYvecW2PGvBVVqwszjXBnR-j8xSVN-Ncfp6Whmx2Rkg&oe=69B551F3"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id": "949107410131388", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://
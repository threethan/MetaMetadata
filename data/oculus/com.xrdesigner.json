_oc=Adm0vW7pT1GIbBHO4A9yLNL2rCEh5P8dy4X1mKGDX55BV-qgRBgwBGYWfB93bWCNiF4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftcvRMnC36CJRcfTon9gqGPg4MPO1tDlw5i4n-WyS1A1A&oe=69A56F57"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkBM1JNdaywQ7kNvwEmKqTJ&_nc_oc=AdnJPtnfZqPkmok1ZpYdgDnLZCsjHMO86JYsLfiy2FNpAbRahq8zTB_MTs-Rnxj8wQw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsBNa35X9vJ_05ciWFbtxnMhW7mUu5ot-XoYOotn0vNgQ&oe=69A56E75"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYw7DfHOnN0Q7kNvwGi-r4C&_nc_oc=AdmUpDNbcno3lvY3eP_myLEEqnzJ7VsAe9OBZ6eTgZDh1ISBd7y17dHKyC1_Hqq-CYs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsClXmp0y7KrCK7WK3r9vpsNJyz2xSuZ28tNamhIdqI1Q&oe=69A59793"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSWzpvbg8soQ7kNvwEr9a0E&_nc_oc=Adnapv1W6dbfZ9C3wyb4CIwBWBa81dywz085cHuLJYZM3nKrnDDUOPgYnLyWwNlHiwA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftfzxLixKEq1iDGvVljMPWoZu2RWemgWRlLFgY8xBaM0w&oe=69A58C1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqZU78-wmqgQ7kNvwEvD117&_nc_oc=AdluZHiP5gHzPicQN2e1KjIJonLTks1rfayCEvBCGh4M6hMVEPhogIRC-Aj2dAmksd4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afsv_wlbuktj6LLfPDTyYdIZZmxgjFBomcvPPa9v19Cjug&oe=69A574BA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvBwrNVtKj8Q7kNvwH5n_b7&_nc_oc=Adn2kUkvTMScGG8ptVpxIoIFQTrpB108yAmoV5eFsCYw6oBnKrLwC4YtGSZQrbgxvKg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvFxh_uM45ECsQ8ZRm1Xac7Qyu1KxXTrq7hyAXwmgyKGA&oe=69A59BF6"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZ78OYRxgVAQ7kNvwHNfdDu&_nc_oc=AdntDcTm5IBXB_rxfJa6jPjE2EVr6i7OphDSaIukROX7HE816hyvHEP2hTX2hx9XK8Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsSqPqvU_i7e1Tsz3ZR8LqcoVKiN81JEzjaoECwwOaD3g&oe=69A577C8"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3ZBDrqtOIsQ7kNvwEc8HDc&_nc_oc=AdnwfnGcvU0qQ6fztNgtdvvphp9OV6fkIV2Zd6DrFypDMK0-Vz-uddtnisrc3YP7kX8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuVlrpLoaICxYAa3kSeFn3IsJDz0KqVu-wXaXg9V4PUUw&oe=69A57FF3"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id": "949107410131388", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031529_949107413464721_7614679926193402510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRgGBF
8394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOuwL0CX1vwQ7kNvwGufnJd&_nc_oc=Adqi5rYbX6gbsN8U1QCIrc7lkZBWOG5EGFJHD6_2QEH1RiSOH7b2bkvne0tJnH8L2mg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OMIUS2x-g6YsT0O3eh1IN-vqa4LV4QQx9FreEzSNR7g&oe=6A297D97"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tDb_So0olcQ7kNvwESCdC6&_nc_oc=AdqSailf6pkMIdkzQZuWGFU-NilZkbQPA_DavW5WvP-3N3yWRfI_X27JHB0cgotk1Rg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W5tfKkNiY03ieZdDoiTratfLYSjuqT7mAqOggBZXm3Q&oe=6A297CB5"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vnl-xtrVgfcQ7kNvwEdAKkv&_nc_oc=Adrr43gw8EQg42l9g2R4Sd0lGC9aq1cZzlI82fypJGmCGUZiiycp8_dmNPkbhxBY8eU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_x0Os18zyK9XK5W8U-PPTasks5kPtT6dOK4zn9E2US0w&oe=6A296D93"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UE6ABeLuW9cQ7kNvwHfjnNV&_nc_oc=AdoW_HgtRhYACmElk43NlnAeTA8rHQ7N5gHI1lMc394k3rlB_VluscHOYCX6JfKjSdo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HwEPm6tly6cDaWBP3P_wJUD_RwdFfbxuq2zsnKCMD6Q&oe=6A29621E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gK1hVEpajtEQ7kNvwGnV7SS&_nc_oc=AdpB3TkboiuKXxWWK8JozQrrv-t90kM2zjle6vxvKrMrdCQ_W_-K5K6CYMRoKaY1284&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NIA81iM_NclRd-xmuayeH93ULThbHG0FocpycatQWIA&oe=6A2982FA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design 
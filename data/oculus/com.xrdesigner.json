691032248394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1PKOMHX2lAQ7kNvwHIEkNg&_nc_oc=AdpfoD4NsrqvIPO-myl0NK-kd87KYKXduUidNXH_3cNJLLUExQCLSIFtQgV7-6UyPFQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HheJHa1wpt45GVkN5aZ-SyEVxCQjVt3HaOfmF0EOIdA&oe=6A394F97"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OMUgJjNyu8Q7kNvwGkkf6z&_nc_oc=AdqJw9tlDQ2gksyHBlrGPb3m4PcoAJtFm7zku_16Lh06KxHZeyzWdTvqKfOOLt5piQQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_y61_WS5ZgaTU_oORMnxhwLSzSwLeuzotkcpG1wGg9OA&oe=6A394EB5"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tBXxZHMq1QQ7kNvwEo5qUb&_nc_oc=AdohjYXA_mZHM9hhFAI4CwvL4DT6Qz5ihKgQd1sTLXfPSACS3Z5nskn8m_r6urrlTbM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KVmzVe8EiA7h1L59_IJOCIePAcEUIOFQG_uMLYgypzw&oe=6A393F93"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymjJKDtONOcQ7kNvwH9nQ5N&_nc_oc=AdpCjZkg4pa_g713vlK11SUxdtreBe7L65g1F-phKaPyUhvbd73jMndJLsmE4JZnIaA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l0e72VUAWSOgiwLvUljuZ6J0JtQ9TnXQwsvzC6dViUw&oe=6A39341E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-bIjfPx_50Q7kNvwGK4cTh&_nc_oc=AdqpiK0cGDjLwlrx_AFCTGp7jbAHFDp45bh0hGHifvuBHaiRcEz4Zn-xu_-ERBo1WqI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I-6fwaP9IqMEpFkA32zluJY_IlTRT-JgZL0FoETBZzQ&oe=6A3954FA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuHsXFc5DrMQ7kNvwFLs1aQ&_nc_oc=AdrruJIpd8m-H_IGm4SOM2YXXoT9Nr5Bg_XfTjp3hYSm0q0_A3jU8b-0uw__vlmDx6M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M2BYIOdLKKJuchtH-A48Tk1wgnOZNC0moXalV4MxAlg&oe=6A3943F6"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PljZU-n4qTUQ7kNvwGqDWqg&_nc_oc=AdoyFFTML0XWgAC7u7ak2v-IPYDTnc-nHKQXVSe_r580ZCujYsJWk4WPqGuaIpW4QQQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LP2tYzqwei4g6EU4qSGqJKz31gJz6Fe1dxDj15wCTQQ&oe=6A395808"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGF_ov3ERjMQ7kNvwHZAupg&_nc_oc=Ado9ZxPrs8iJU6PPWcKyrXIUpvXP8wX--oBz95ab7eRVjIeB9aL7wLxzqErEvGyNSCQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8agQ0anbHd9sU14rtOQkKIvzVg2mEvFsYp8Csc_Z9C7w&oe=6A396033"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id":
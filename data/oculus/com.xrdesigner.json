g?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-btPxjRJKCIQ7kNvwE8w71I&_nc_oc=AdmG3wEA3RXYT84IYc1Ij2GpzKVwgSiNMcEgBCue6-cYduXdbvZWFmbfmdYkDo94Rdc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyf9QoinM7L2LlChao0YFX4Kyg6HXT04kOyvgm6L2ETKA&oe=69BA8757"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWc6ZvvkvIwQ7kNvwFmm8DD&_nc_oc=Adnt2YNijjBAjX3MkfGhwyNoF663g76XoIE72Xmsmh16cj3wDqPKOXcKiDUW8iXporU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzayZxE2hkLj9VcB6tk6gPcrJRJZzmPBlj3X8JQe7NmbA&oe=69BA8675"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHYvatn9YTMQ7kNvwEJ4t8d&_nc_oc=AdkyyyJ6F4SC49XUJ_5Fuu_bvLQR9W9_7FttlKkM0ZiEBC5yq5hmUkwxJAVbZGnIzAU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyRlzaUmq6JX0z_14SIRXjzGEVbiu85VuR6M0dJ8NjLmg&oe=69BAAF93"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFmn1z9M1pAQ7kNvwHtEyzh&_nc_oc=AdnI0Du-8qS1km5KpTdvQYlpdrUrqXnbBCXCoY68xvPbUPGjXtZz4XWZzEsIzdJ3orw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwroi6sXpc-opm8fFblhyr_jDfGiDnlYFOvy3BUcxbwuw&oe=69BAA41E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBfPNZB8mnQQ7kNvwG_1rDq&_nc_oc=AdlLcW5dhJ0x60H9yXSSjxCdhpdpFzOcb-VaWjFUtf_fPkI6zPRFuAX8ebDmIHrQib0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyu5TAK-OKQDYR2NVMA8BZayJ1x06mp3pkD5rkEuXj4xw&oe=69BA8CBA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-E_i3JKCbU0Q7kNvwFWJsHf&_nc_oc=AdkJRATyrdcUfda0Oddg5ni7UYY-EthgBSpi7givDMGyFtFSHXRMpTNxla_8te-9DCk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwbwjOCGvkBt5nJm9aTLOertzARUEN_2jdDCGTQpIHetg&oe=69BAB3F6"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExwLYrTS5ccQ7kNvwF0pkUM&_nc_oc=AdlQ33glvu21FYxsllZ6nPL_0Ctkr9T6uxEplcjBF7E5hSVQ-JvXdoWfIGJ6QISXpsU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyO8D6IcKjQpsyu8ZX6fE6-Bn9uJ3Gh3Aym50wwff5Yiw&oe=69BA8FC8"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zv_cUqhziYkQ7kNvwGMsTAx&_nc_oc=AdmWenzu7-eI-RFnZ6B7-Qzptl16KOoYu0EHuIZFWkVzBryZYhDLOBpLTJGC2WP2SRM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzp0MgGVGCf3E-X8dr_pe7M0lPUP_6za8jM8SKZXq8CRA&oe=69BA97F3"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id": "949107410131388", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://
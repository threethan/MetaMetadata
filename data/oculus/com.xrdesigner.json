8394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvEyKKMo00sQ7kNvwENtkqX&_nc_oc=AdpIhnhM6KIBEwF3PmsYe9FecfmEf1JoLfBfBhTVJ_BINLLNppWO2a2khghv1Lk3gac&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP0imS9RskFjiNHMK8RqjB785qLKrIxqgE8DJwJyeY_g&oe=6AC50E97"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDXjLxsgWF0Q7kNvwG8JxqQ&_nc_oc=AdoqmY5icDuSonI2x2X1tKdNHFp_tdse7lxkhJowU0sg9qXODGmdKi_Z5LzrbyBQc_4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4rznlYLRVk7MLQyNKBlUB_Yk0RVJvqY6v6_LEtODkmg&oe=6AC50DB5"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9_Gn6kJFpYQ7kNvwHbkvhS&_nc_oc=AdqZ8vscAwXt1EJGA7HzWtPrKQJbia8QwQr6DAsiSSPVCkz2_ZGUmUhToAWI8jIgmrg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOc-WWZVhdGNIk-ZRpVapZRVb3-KmW0iDxyPiFm9PE5SA&oe=6AC4FE93"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVMhdAAWHpMQ7kNvwFN2fjt&_nc_oc=AdpGDov8hJP26gq5Q7U2zOr0B67aDcDwUkP4AyNFXFbPR6uo7ztkQ89nS1Y8CYTA1s8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv9xEftWbJ3IGyBzLUCUn8IiaWtH_SaL6g3eH6BYsBUg&oe=6AC4F31E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXdnvwI6HOwQ7kNvwENzFvT&_nc_oc=AdoJGxAgHU2tr1N5Z-JHl_wSrI7r-Mlij_UR78THlVJwkU-1K07FyS6bmiAiA4-CUG0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZfLkvkD_ZG_dyZ2weN5IkXnrAOcXCaz4uXxKKUbfxwg&oe=6AC513FA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design 
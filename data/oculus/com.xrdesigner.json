_oc=Adm5jE2sawtRnI83twsD1SEdQ67WXmXhEtcldiTcRcwdMxzi-ui1tLdUzrkzAVImWKk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv6_Tt9edDoXqILplV0N3cKUJtw5IaHyzbb-vcYpvEr1Q&oe=69A02957"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57wCaDw-u1gQ7kNvwE4ozfi&_nc_oc=AdmaPz2QlqYYs-NfaVUP3IlYmfwC3Ix4S4b2zB4kyDgZev6RiNL2_vQr_VlJJPkZ078&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7wceNP333Vhj06TbzwenlzDEGwyWQyrz0GOxzkzajIg&oe=69A02875"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TT7Kur40lzAQ7kNvwFva0nq&_nc_oc=AdnqAd9O0XPlchlwcS2tHgnDdS8ThdPQOJ5nMKMa81k6NzcUw0obftqG3Aqu8MuWQsk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvseT66KJaovm8426GfXeMzJ2UCEyceSKaQwtJ7wkcq5A&oe=69A05193"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7unPHGoWL3wQ7kNvwEZXtcY&_nc_oc=AdmItP39_HoHPLQQEBYSbNJTUOQZ6LXQfjqhwCFBf16rkBgtz6eIXQiLbbP9OEWUEVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvkfTgJalqomhaYDOdaENJcArDAW8DntI4hD2FwsOw6LA&oe=69A0461E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPFuTFd_MOoQ7kNvwGEp4du&_nc_oc=Adn3hZ0gC7sNi7dejfmg4etE6wE23NTWvtqBP9awglf5e0m1qtmn26XgByqbay8NFWg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftJKDUgTAlGC6Ak3IPWAOmCcuiGlAckM4v_OxGNvJBMRw&oe=69A02EBA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc7e8Y_C_JgQ7kNvwFA4Miv&_nc_oc=AdlwYtEM6ZiIikG8vumPOTOmToe6kaxjA460FO_wLVniKewwFE2pQI239x32HlfbwoY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftphtuk_RRVzfWX3bl0V1Ja330WbN2hgjteTojYAHOncQ&oe=69A055F6"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IRYUv3oTWAQ7kNvwHGNf4s&_nc_oc=AdlWp4AlG8-0GQFL_zAFTCd_6vRYU4skaAW7fYFC8-vexANFj6JWRkPld3ILPdpClUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuAVSA1bZJSvKBmT0R2O9WeBMxlXRgYwPvNCWVrnNVAsQ&oe=69A031C8"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0wv9U9G8ngQ7kNvwHYAuRg&_nc_oc=AdmqGGCsVq2b-_YXsQ8mMLxlcO72bno_xbxdkKq5ak8fceD9R2dKc80kUDJ_byVqovc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft4W2wBLiEyRhZUi0VE85ZqAnmR2AJLSp5qNIeCeNtURg&oe=69A039F3"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id": "949107410131388", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031529_949107413464721_7614679926193402510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwfEJ-
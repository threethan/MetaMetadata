691032248394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKtlAN3mTmsQ7kNvwHEwLHy&_nc_oc=Adqu6yLnprL0SgzOO3baNfF1IPhGFXVVaSRwHCy7qaUjC9UfGFpjnAdW__3TsHNpPWY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eY44iYxz8ZJZ2dg8hwKtR-xSKdBnYqhOgn3XXZiC_PQ&oe=6A22E617"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1q6nCNtenQQ7kNvwEA2GUv&_nc_oc=AdrcsZnPxuR2wag6dPahOKwkxbyH9NAdZkwo_AuvN5iJrOpz3EtL-mzR3uy7tpX1Ga0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TLKtrPJIMooUNh3Ts2r4zvw0fqBtwL2Ewr8n8Qz0ICA&oe=6A22E535"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qfx0_C2fT_QQ7kNvwEveDKK&_nc_oc=AdqM5t59__Z8A33ZJdv6fKEzwtL6UNFz4r0iWBjO5HgF8pP3HtoRoTIEnhBA7-WmKfc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zKpEua8RE0lhgU6s0GfLOiGqsjAr9Gg95PX1zDSv_9A&oe=6A22D613"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U3TOCTR-NcQ7kNvwG5H-64&_nc_oc=AdpZoxpl1rGRtJkXnsFD2DN8MAcGA-b2CfyKuPquwwI1OyaRWH1r_XxpGK33gXg9Mdg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oThvOj4qorUgFZWgNPvHQcT4-Amkh7cAur9o0hmGTog&oe=6A22CA9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XoCRMc3e-AQ7kNvwGPPNX6&_nc_oc=AdokIIfV-DSjzbTqW-1OYjJoPm--F7W_-2xmI4LzlzTn8BkMetFxcOQTE-pUMbIeVqI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qNypq3bDOiDbdNNzuPVv-EA78VHw3B36cHF5xRopXNQ&oe=6A22EB7A"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lm0iHkaucL8Q7kNvwHrVzE8&_nc_oc=AdoJuitUzExRCTDmvy8Fi2L1bd2y_qGWZvISZ6rXTiRJ7LUz5PBZn6lQFVDZUVE8FT8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-N4YoI538_HjYi6jGMgIjNmET9h5riNRG9nL_cwyKR8g&oe=6A22DA76"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBi_5BFFvgIQ7kNvwE9gZbp&_nc_oc=Ado6qE8MYyldJbK3wLaSj5qSCFDOblwuFnIhYXBNL3XqFgPNDqz-tGHgwB7ZqFqg5gQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sqbfase-dKKjIwgKkLan5eUY6xF4VllUxLu2sPCAWBQ&oe=6A22EE88"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IQ8ILBrJd8Q7kNvwH9u6mT&_nc_oc=AdrcGNk8CASFQnvwqcQ9kwfAn5qMEW2D6CfTVPJWSJV56TncM4HaBAb_mZYKAlSqLSk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_divbFqtL4sLj1BTEQmCYo9-f2ghVJahHyx1MA3NN2Ag&oe=6A22F6B3"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id":
g?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nssn5tklx6oQ7kNvwHjM2YE&_nc_oc=AdrklLryMWfg8ZujvUpRh9T_jo9r6iabnIZdqxYdThEqCiKL_pOK8vYCMiBUM44hNeA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIDHNOAY9gvaupPIdoIvZu1SMryL_BcF-_qTl-mKucEQ&oe=69C11ED7"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtUGjMFsglgQ7kNvwG7-LFy&_nc_oc=Adqj0NgQa7qxfG3RfH80wVj6Mr8BxMjpST75Kpt7ZKK6r3WDEHbmiGDyt8_GLYqaiBA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzQeIlLsY742HgdidMyvhXLU3YM-oxtMcLP92Wy4Zrpbg&oe=69C11DF5"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OHHBGEet10Q7kNvwEQpCxY&_nc_oc=Adobe_YVFphYSoB47oGJYKUHRsxRJd5GHXP3cVsLR1kkvypx0Lns5VBTqVz9Bx3NNTU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzAnWJ0vUXILzBDrKOSzn0uJ5TExvIelR_HRHJkBiAVWQ&oe=69C14713"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3XrkrZCb5MQ7kNvwHDdUuE&_nc_oc=AdpEwmXFa2Wybz3KIicCgeGyxig4AETjtVF6qqJELPF4zOXfNNR2CJLl7jas0Bd9v-E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afyam9ze4m1qMmhf0U8dixOltiRhSw0wBrL9OZxb0G_BEg&oe=69C13B9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLowBgNfs_gQ7kNvwHDDA47&_nc_oc=Adp1fo0XspTGTSpajMLE7DK4sll5eXryydPJJ9JwIJjVhpGTsi9m1iTZirFMM0l7d70&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyWvjUzIPN7AEyVY6CF5bFD1dCn2n5V0C9VecC4X-9G1A&oe=69C1243A"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndBAa8J7JlMQ7kNvwFkanCY&_nc_oc=AdpA3guaAyZ8tIqPKsItlLDXb93DdjL6t2lD84gP2puO9aAPTkB7AxjObQkoVPWqyUI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxkTOs1YQgYtvzR5kytqu8J2aJ2CVqcLNDp2wP6rc8t8g&oe=69C14B76"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiolRsByp28Q7kNvwH2_MmE&_nc_oc=Adr8EuBP5Jv8sI9io3j4R24EYKhEa7wGGSBhWcv4_M-SFMaaN2hHgmLTmeZeBQCnkSI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyfNJm8UbgpD9HRshNPxLObw-b0F3JQ9-DB0P7LQIIf1w&oe=69C12748"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjGJVm1jo1YQ7kNvwF0hUVh&_nc_oc=AdrFVeB55fUL1eSN-8hIujyK4ByUDGN-YtWptdSXMJwqkT390bJDX4_QpQuknO5Iat4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afxjp75e3IqdKsEd0IMISRicUxOakqCBSrFQ-7OZ2Gwxmw&oe=69C12F73"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id": "949107410131388", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://
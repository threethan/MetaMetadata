_oc=Adkr-WjtZOOSzpe3V8-rHjl60J1_gThvXrLvOIyaj-xYqPQLeA8aZnf_MtLA48dEXzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs3ymlKIQfl-3vxIc94FPtaJFVFkQUw6sscVlMExusjpg&oe=69A41DD7"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkBM1JNdaywQ7kNvwHQp2Eq&_nc_oc=Adnt8aqra_uQipTrYpuEyZFyA-pAsFaUoIm-gxt-ismiHQLniclCSWkjiVHON_we90s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvYchVph7SAHzytYjT7dc754K6GsnwKi7iA8eVw4qt92w&oe=69A41CF5"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYw7DfHOnN0Q7kNvwFNhnlZ&_nc_oc=AdkqVw3e9vhjhgkUUAs0HUGXXtFYRKw0ixhEzhYCiTmtvDEOaThvyQhPa7miapU-Sag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftL8S7ScLuv8Cp0_d3OtRJMhWTWXPkJ8jNnpDvpNS_TwQ&oe=69A44613"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1kLimivvxwQ7kNvwEUsN9F&_nc_oc=AdlhyHLfoccrp0gFGf5X_silERb40tv-fCnIQJTWC1sc2zc_pcnz9I9UozNKmZSpHcc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft8o7P64BTUOnoINCF991SYKefqrusofx-KYRTqDsrfBg&oe=69A43A9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqZU78-wmqgQ7kNvwEWIG5O&_nc_oc=Adn0G7V1Cxn-nemQenLBjP5abfbutOLhomp43FIFf-jbxKNLunMqhrvanBLAcI9T9vQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuzO7Kf2GKXBMlUe9MLHAvvBL9b-gLvkWfzdrRCd_fG4w&oe=69A4233A"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4P-3ms4i8IQ7kNvwGuiHMu&_nc_oc=AdkSZUBy0FZ1f4DX_0j9knMoCxFH9jpFy-S2u_FlWexniXqIST9QsIiI3GTOsIsz3zY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv412is0MNElB8_rKileGe_5Nw8zbpWccHC7XhRaSo80w&oe=69A44A76"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZ78OYRxgVAQ7kNvwFPRDwQ&_nc_oc=AdkI8y5L9-TRHDEPXIJQc8INeGRAVbns4EYWEi6VOgsRaguZJReAKch16-9uLYIcQrM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfusoVNxbuS1JLiI2oumFxkqJX-kxoJ7-nasYZ1XuDtMzw&oe=69A42648"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3ZBDrqtOIsQ7kNvwGSXCCP&_nc_oc=AdnJAwOiyDSaH1VvflipY2IpBZkN0NQ0o0AFvggZu-rg_H3R4SjL4obuSdEpcy4qGNM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsthbiKYCjOvpct2EVbrjKEVQyXWaDUjc_8pSzhJTL0eg&oe=69A42E73"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id": "949107410131388", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_949107413464721_7614679926193402510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRgGBF
8394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvEyKKMo00sQ7kNvwFWbbfU&_nc_oc=AdqMgEL3LsN4nSWDAiW_RwSsCidzQ34aaze_BzXn83oy-VxJskbSuaAQcsomJRD_GPc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6gtgCqVHJrJ_R_p2c3vc8lOk7LwSzHK3c76fcQOg7KA&oe=6AC3BD17"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDXjLxsgWF0Q7kNvwGvoSA_&_nc_oc=AdonCrDfJGXjwA95rzABQX0fwblMirsYa91kKGe7l3w3aOtsGF_6CABAOKELWvnnTYY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtxZb-EQnzUqpIC4xaHPyn4zmgxFWMNlkmzj6PS1yhKg&oe=6AC3BC35"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9_Gn6kJFpYQ7kNvwGUBjUn&_nc_oc=AdorHCDI9ChjdCiacUE6fGyCCRYTHA8ppl3B9zwkeFLusYvwpOY9mDzQ9CNhCOnKKtY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIz6SsxLa51UagCuX9Jzp7qoERPQZR5HOpg6xb4S_4XQ&oe=6AC3AD13"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVMhdAAWHpMQ7kNvwEFaE0T&_nc_oc=Adrek1BVVYpa77R0UpIc_xlyjix0yhe9PQ4xg9UXx0rp4iPMyih-ytbhXcQU2N8MNUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn-Qfatzl6N9E4KpOktsp9LzRfCkCto9tUZU0e5mf2hg&oe=6AC3D9DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXdnvwI6HOwQ7kNvwGlkT_A&_nc_oc=AdpGQmSh5E9Qo3eAzrbf0eYMAoVVxz4mqpp_54D9oRMHKA--Xt3212phgstMWjir0m4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZD-C_B2O53nXEvmg5p6-lg-2mKAZAS1f-1vXbXoj6bg&oe=6AC3C27A"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design 
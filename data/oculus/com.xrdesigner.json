_1691032248394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrpkYOe40CwQ7kNvwHYc0fW&_nc_oc=Adrz0G8RKsqX_Xp6fqDm4sQaA31mLWVlpaHp9Agf3w8l-3lKeNVgYt3ULHM8IriNZLA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-O3ztVN2uvuCWk01fOguPspRrquMcGYXXet523OWRbQ&oe=6A858E57"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NJ6yzOxgR8Q7kNvwElw-Nf&_nc_oc=AdonWZ5C4KfhaYEn-dxnadv9r2LMoj1_yDvUCxu2T08lXvaziAgGcNTvc4KvrZIUGA0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdvUiRyouwOkI8ppv0bj3ogt1I7DcQwJtLdw4Kf9cipA&oe=6A858D75"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMlGZQIl0l0Q7kNvwF0MkJ7&_nc_oc=AdrJAoBZm3s7ejtEpbWRVgbvITM0rc97Y2EIO-JdsH7MEWBXfeojA78f0xBukJKp_Pw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJ83VWlko4N9wzhMrYI0RdjbVxNJ7W1a7AUJuCH2bXLw&oe=6A857E53"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsbJYGz6nVAQ7kNvwGHBbmC&_nc_oc=AdqMJlo4LhN7jCtzMfv0qoxVsCmjsutpdlWgrOL2q0nnSUl171LQiEWOMP49BNcniG4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRTMOt6bCV-fn59iIs4mATgcKTRY-QjT8NtuTNSVFasQ&oe=6A85AB1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUDBU_TGxrAQ7kNvwEc2cF4&_nc_oc=AdplTKqYE3Hjde2Aq7swboolfza0RS5Rl6lMaL0q9njFy2I0DzgPlN5I9wVC8tJh4IU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXzZD6IHLQC27UIBQdHX4QaJsehbPiQuhGgPNAcu5k4A&oe=6A8593BA"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBt5jkI_LfEQ7kNvwEfWOLS&_nc_oc=AdorNW9fy0yJ0BKXsSIunveppt2XgQMIhJT1WkCpIybhtpaa6iEOMOzusVIRb781pf0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzjn_mbc6ne8GaG2W3unVEKYdDfVn409HSYB_XHqj9kQ&oe=6A8582B6"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j6AxfxauV0Q7kNvwE7xXRX&_nc_oc=Adox3QSl6HG7BnfGnwlMl9Bh6vzYkAX7x-__Zd-9lhueZkoo5IalXn8Qo_y6v0jfcQQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG32kclnGVyj6F0JRSZ0D9uy_HTfBwAZrUU4ufkcUb_RA&oe=6A8596C8"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSpDsF-Aa4EQ7kNvwG0EaFo&_nc_oc=AdqZRMnGnLb2X0dkca9JlvqHc0HwDYjKmNFqBDEetIs6hdp55jJls8rRZV5B8-ldqC8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuu-oQmrSeSdluwa6MOL8luombC0kO9mjsHA719faLEQ&oe=6A859EF3"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "
8394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nza9nbNw-jgQ7kNvwF4-CL6&_nc_oc=Adp_uCD8m2bxvvkvMu-uxDqDCFg2IyphOGtMAybRwW6vKzftfgeGuwkJPHpUDchycGI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9McedGKLhIzj-8TztPXrf_KWnDcW6FN9KHw_gN6X-ibA&oe=6A355B17"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXoAZiauJSoQ7kNvwGY24pN&_nc_oc=Adp__fkxQYSOLCGUDzGwyRHiMtRgQJh4QrTrD4Kn_76z2Bo6D5FqzbBcevyrByfu6yY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tdLWHRwvgy5wsdOZkU9whfNuEyqONJsUmrk0qOJl-xA&oe=6A355A35"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bfhoj5amHoUQ7kNvwFugXmn&_nc_oc=AdpPxPrBQ0AZdPxtHJFXpuuKPcL_GVJj3zXELJATHZe_pZ_ucjCkDkyAx6y9AdsejKc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Eg9J1WtEsPIUA_GShD31SbGVyFdamOXnsAS2n1FCGWw&oe=6A354B13"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I24jPVwSJ1IQ7kNvwFxVKCa&_nc_oc=AdoK8gVlm0gJhk0971aNC950E0yRH4DdFb_xTMYKHz8aZJ6YvRxzqvgEV5qHdwEweeY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v22U1uw0M3_TRXej-hKLCoDa4gg6KPSYEZ1niVgf91g&oe=6A353F9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHsrPOzaDrsQ7kNvwEKb2z8&_nc_oc=Adp4wLNnq3dcVpmeLmB2pXGjZw-sWe7C56rPiULja09ItN99gSOdtjvzP6C-ilYgK9M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9djbGvM9fmGRhbBfoezkZkr2WTrH5yi1LIEFpDuECvQg&oe=6A35607A"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design 
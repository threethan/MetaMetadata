8394470_7682118317740767164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3X7Qnh45JBAQ7kNvwHzfOIz&_nc_oc=AdqVCokvzVcEFgnGQx9i2yUP_gWdEGeHHmVFw68rw0xxZUEMom54JijpQabCkvphRLM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq88Zy6HGYV0zRRfF6WQMhJnXyk6xEYYv4flDBiYI2yQ&oe=6A720017"}, {"file_name": "scShot_2.png", "id": "378452821676580", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75195903_378452825009913_7929827051814968996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Vcmh20gSfAQ7kNvwEKcwKN&_nc_oc=AdpA6TzKxWShhmgbkzh3uNPGMd5ZW5GgDD-P6gm7Zjk2usU0yXeDVFHJUAcVfJuJPQ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5-TrfJ1AzY1kC-aX_F1sE_SbdAca0WIrhadNPCXQNaQ&oe=6A71FF35"}, {"file_name": "scShot_3.png", "id": "1505551713356493", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974474_1505551716689826_1033040203579986067_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NceoLZQ7snMQ7kNvwFU7gpK&_nc_oc=AdpMnq663K8ZXqaAY_Hg0R2Wp2D7kQupgfeF_0pwfyiUEi02mRGAjJGazLhDLke3KLg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcR9yuWX3UjOWg-Sm-9q-FBuv9P4jK9FGYVgNA70tfiw&oe=6A71F013"}, {"file_name": "scShot_4.png", "id": "776653917415609", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035417_776653920748942_800252803639380126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQzN5g3cBI0Q7kNvwEoqM_3&_nc_oc=Adom1deXrgRLXbvkHmXCpOuCEh8wHOZNo9ptk3cOY7iGyBcGPcMyQkEVyycqBoYmHmo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaC0YX0b5jGRWjzr2Q4KhBwJCZA_D2FyeV6ZK5wtuQZA&oe=6A71E49E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "1563629980869194", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003281_1563629984202527_7466738310881786331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdvA10ISG9oQ7kNvwEu7CPS&_nc_oc=AdovXchf8UdTni70ZwNhzxf0YjYmpYpm6oFpbHW74Nm_TNQ2_dcSVEafFO6EbYama9A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQKQluvY2ab_sYz7xiAWhX3B0yi8hhlwSBFMZrdUp07w&oe=6A72057A"}, "display_name": "XR Designer", "keywords": [], "long_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\n\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\"\n(Detailed operating instructions can be found at https://xrsns.org.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nSwitching windows\nChange the weather\nChange background music\nSaving a room\nLoad a room\nShare created rooms\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nMove with the left controller stick.\nRotate with the right controller stick.\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "In \"XR Designer\" crafting your unique and stunning room is a breeze.\nBrowse through numerous official 3D models and wallpapers to design your space, or upload your own creations for a personalized touch.\nBorrow them from your friends and get inspired.\nSave, load, and edit your designs at any time to perfect your vision.\nExplore your friends' rooms for ideas and invite them to experience your creations.\nUnleash your creativity and design a captivating room that is truly your own in \"XR Designer.\""}, {"images": {"nodes": [{"file_name": "xrd\u30ed\u30b4\u80cc\u666f\u9ed2_512px.png", "id": "1663157610879996", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570305_1663157614213329_752428871586704211_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7uvrgT54WsQ7kNvwFSYHYP&_nc_oc=AdpJDR17KkxRXpIJM2NPsWYca56hjjdsKX6ugqVMVFLIFob2wFGeWLSYtdLGAwhH-o4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESj4j4Hj4j7CLYbqHg4eYB-A9VLszEnHohu67fe6Rw5g&oe=6A71F476"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "1590989611650404", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982688_1590989614983737_8848910869138619764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLDJUg4RZdYQ7kNvwFSsrEO&_nc_oc=AdoI14FPo7FMJ_L5_cLwydmK7O9g27AOImwy55thpoaSHpudEpeOawqI2zHhlURY0pU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElRnwKcopyiHyNLf9tyy2rjogEZhzGAWIMt_BdnqY9hA&oe=6A71D048"}, {"file_name": "XRD\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1270668914321149", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984467_1270668917654482_9165728136278102277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCYDMUSwyuoQ7kNvwGjHEQC&_nc_oc=AdoECgB8mpdSgNA-zrfq7gxS2cCMNcArAV7AsWRWEo43Kcwq9TgLQk_-o075oHl5-Ls&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFC77F6R-rhyDO3Es2lSzfMUGLLon4MTX5xwy0t_YR2xA&oe=6A71D873"}, {"file_name": "xrd\u30ed\u30b4\u900f\u904e.png", "id": "949107410131
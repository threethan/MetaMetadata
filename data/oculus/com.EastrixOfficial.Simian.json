 worry about lag, and provides a very stable experience for all users on Meta Quest 2, Meta Quest 3, and Meta Quest 3s.", "short_description": "Simian is a brand new Gorilla Tag fangame based around gun PVP! It has very well made maps with tons of detail and perfectly designed for close combat."}]}, "developer_name": "EastVR", "developer_privacy_policy_url": "https://sites.google.com/view/simianprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "EastVR", "support_website_url": null, "website_url": "https://sites.google.com/view/simianofficial/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24078772718428260"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819972_1178678080653534_4407350837188453970_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PnEEg7kyKYQ7kNvwHqoPfA&_nc_oc=AdqIJy04S-8vQ48MhqVGVdmPk6uXSSKXF96RJC9Gyg2Tg0LRToQQ2ekVigR0WfukKGM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXPouqItRMc3E6ofb74Cd6428KhKqfYMxIntcU2MmvKw&oe=6AFC875F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Simian (OUTDATED NEW APP COMING SOON)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035
2515", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75314846_1070736027195848_7560656726562944090_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLzhgeIppWMQ7kNvwGgnaK2&_nc_oc=Adm0V32jJGuNHq3FiFKgVxANQhI3UZ5Jy4FOhbrzHqZcT-HZUQROUQVlfbP5W3u9HEY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxrdr9PFNuE6bFxOd9a0RkFMA_rvkQPLPHTGSGj857t_w&oe=69B69C07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt-Landscape.png", "id": "476329454223428", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_476329457556761_3593194100586946197_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5wE0slV4roQ7kNvwHJkF4N&_nc_oc=AdkfNPQEQXtHH49Dhebo6E1RiOEtFtKtdk2KMJP3P3ox3bNV401ktFO7twczuOtz6_U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzs6hNNqi_CwPHO5EFK548XRQq2BgAnsCOzwmwCahFV9w&oe=69B6B83E"}, "display_name": "Carrier Aircraft", "keywords": [], "long_description": "As a discount\uff0c you can buy the game for only $0.99 this week!\nThis is an exciting VR aerial combat game. It combines elements of naval warfare. \nYour mission is flying an aircraft from the carrier, finding and clearing all enemy warships.\nBesides flying and shooting, you can also experience taking off and landing from an aircraft carrier.\nIn addition, there are many intense missions about aerial combat or naval warfare, such as air raid, protecting the oil rig platform, breaking through the valley, escaping from the cave and so on. ", "short_description": "Fly your aircraft from the carrier, find and clear all of the enemy fleet!"}]}, "developer_name": "Fengu Studio", "developer_privacy_policy_url": "http://aircraft.manyatang.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Fengu Studio", "support_website_url": null, "website_url": "http://aircraft.manyatang.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_
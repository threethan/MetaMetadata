_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbnEy9K-JMMQ7kNvwFLVIsk&_nc_oc=AdqhiM-I6NZTEJD3oUpoFmcrYelvmGVeTI4c8ifM-Qbgm7eGg0FgpFoYd3KM3PbzOcY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSPHrRnNbuGAACDecb-ZCkDt8TVqlnqI8RrwWEF3k1LoQ&oe=6B0DA2F1"}, {"file_name": "\u622a\u56fe\u65b0-2.png", "id": "1070736023862515", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75314846_1070736027195848_7560656726562944090_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKQZ2EyrfzAQ7kNvwEWzerG&_nc_oc=AdqeUwKRst62k3S2-__KakjmPwk1Uezzl35a4iwigV3UGK2LKkakQok4fVZf2ObuVg0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSJaZMGI4LzichhaFdPUPT4kgjwLuNM6KlHN3pEfaYjww&oe=6B0D9A47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt-Landscape.png", "id": "476329454223428", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_476329457556761_3593194100586946197_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPP3sGXeBFcQ7kNvwEG89Sa&_nc_oc=AdqYwEL5m6JFos3DQPl6k2kxFCzI4GvzAARxGlCCujUfsxeI85K20V6HHMLDK3aTOaQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5PIu8Z1c7aCFIhe-PoXkwEkohDYvjnEK-Rpmljd1ihw&oe=6B0DB67E"}, "display_name": "Carrier Aircraft", "keywords": [], "long_description": "As a discount\uff0c you can buy the game for only $0.99 this week!\nThis is an exciting VR aerial combat game. It combines elements of naval warfare. \nYour mission is flying an aircraft from the carrier, finding and clearing all enemy warships.\nBesides flying and shooting, you can also experience taking off and landing from an aircraft carrier.\nIn addition, there are many intense missions about aerial combat or naval warfare, such as air raid, protecting the oil rig platform, breaking through the valley, escaping from the cave and so on. ", "short_description": "Fly your aircraft from the carrier, find and clear all of the enemy fleet!"}]}, "develope
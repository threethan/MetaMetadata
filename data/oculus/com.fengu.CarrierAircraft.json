6726562944090_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SklJo979_LgQ7kNvwGFCnB6&_nc_oc=AdnTohHIguIcwkX2253bp_HvCuNbX1zQkIvbRF0rnnqfQRBt-uQ_FpHWLLyJA-nKGpU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsLvyF14_aYH5Qj1XofMgvxRn7Vg5DIkq4gX_Fq13OlPw&oe=69A57887"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt-Landscape.png", "id": "476329454223428", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982439_476329457556761_3593194100586946197_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BD216oTsnFoQ7kNvwFdDqMF&_nc_oc=AdnNxTSfhd1pLSAwh2ZFWs4JhNYfuVfxw4gw9vvT1NiKtXbo8nekS0NSVm2C7tREGdE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftB_nQlstshhp2vUtH7S-aN2KFlam--K3NBIipf2Jl_HQ&oe=69A594BE"}, "display_name": "Carrier Aircraft", "keywords": [], "long_description": "As a discount\uff0c you can buy the game for only $0.99 this week!\nThis is an exciting VR aerial combat game. It combines elements of naval warfare. \nYour mission is flying an aircraft from the carrier, finding and clearing all enemy warships.\nBesides flying and shooting, you can also experience taking off and landing from an aircraft carrier.\nIn addition, there are many intense missions about aerial combat or naval warfare, such as air raid, protecting the oil rig platform, breaking through the valley, escaping from the cave and so on. ", "short_description": "Fly your aircraft from the carrier, find and clear all of the enemy fleet!"}]}, "developer_name": "Fengu Studio", "developer_privacy_policy_url": "http://aircraft.manyatang.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Fengu Studio", "support_website_url": null, "website_url": "http://aircraft.manyatang.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "331529188132278"}], "external_subscriptio
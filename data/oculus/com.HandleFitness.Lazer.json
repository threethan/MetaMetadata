png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0MGVlhbsn0Q7kNvwGTt6zr&_nc_oc=AdpEw8QxaJb74tyso1UVyfOp9Uulxbybl9DXZQICFCh6IQdiWhr6OIJnArxYHOBJJLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrE2-rB-uimO__Lj89GkgGjOHZ1fphEnfFh3XLuaxdVA&oe=6A49055E"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TD1KJgqF8pMQ7kNvwFsCVSr&_nc_oc=Adp8aVia1SBGEHcnd2GfQfTyREjHpxo2mK0J73gfRExdae_IgN8GgDzxHQIeKHjgFiA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8yZwAAPoejlWnhDBeVpPaFQJQxpdwPSMEljlt8b2LuA&oe=6A492880"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V58Um2xi99MQ7kNvwFFyC1b&_nc_oc=AdrPgy1LpzTKDCZf5_YSR4-Vm4QlEmZjmI93BvKX5jd4A5eJtEtiAILAVNmxEYfWhoU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0zx3Y8wysi4yhH2HRvIaZvwZNYStoK3uYq4lLH1QeqQ&oe=6A491BFA"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_ieFiP72U8Q7kNvwFOMW_L&_nc_oc=AdpxJziadcenRKB4c7_GfRO51yIXUYWY2cR-fp5McmG_heM-uKpw7HWOx_158j-Lrk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxyPnODm3C4fZR2_8fa4cMllDGAveROFH5p1dhFNcZXA&oe=6A492429"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvq5mqEDzSoQ7kNvwESjn6i&_nc_oc=Adrh8wqQHUmjlGY_okOUYtFR_Jdd6DSSykidleGDwIdsy7umh7i-SMdxgsuLWH594CM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABBs8z1JkVsb5nHH3gIXifqjqTr_ZWonfTa_R5wBL5gw&oe=6A492B68"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtXmcT1SCt4Q7kNvwFvO7vz&_nc_oc=AdrYkH2vTMJwfkHctY2_JF282XX_Fzd-YEJRRZK4ACzL2mwpION9oaEw9MlH96C0QHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW-KsenMXHFndBZU67Z8cwH0mRVC2YHkxwwcKL4IRNbw&oe=6A4F9CDE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yft-ZevXX04Q7kNvwFLuMOY&_nc_oc=AdrBjQV16K9FWbJgSm_8ID58sz40AEmHzd-cfdfdGGudTNNooBYHxTQuGsn-igPYaVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6ah1OZrLLp_zekFjtgl4e6Y-QJeuvyXWTKS_e3dDCrg&oe=6A4FC000"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ghddss-twgQ7kNvwHsLzl3&_nc_oc=Adr280mXaqcRFytBZ_BvQQ_TAPz3g--NvkOvsC0IUXZbmEYWJmu_PdhbsFoKStTymnE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaFJaDlRijP1RLzobRpTi2YpWhiQ9qhkIAVMsN0_afGQ&oe=6A4FB37A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ry9aJqgZNp8Q7kNvwEyMO0Q&_nc_oc=AdoOnvl4w2FCKzFqkceme1uXJHlbxUyofns0Bdx6j6KcWv4dQp3j8Eeurt0xJzXkEI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9PLQEhntaf7bWR7S7dAPLXi4Z7snvRgKDT76rJPY0gg&oe=6A4FBBA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOSX-n7XS0MQ7kNvwGa-f5x&_nc_oc=AdrsCsZz18u-SQFTZ1h_yzUZ50qn7YA-72pBu2oRQ7yqxdNPZlgBO-t7-trgPWfOBOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATne_UX5QIPENJlT3RL-EsA5TxeMnRUda0EImDEEsb8A&oe=6A4FC2E8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ym9zQ-mWheAQ7kNvwFFdhQD&_nc_oc=Adpp5-Nq-xMmIUBrH6oIS14C_QIgGu4z80Z8brV9iln_NH_87jF9iOY7e12oBPH291g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgGlfUVMwCc0N4uKtY8muTtdYn6rcjJ81TXvzE_MoQ_g&oe=6A7729DE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uWK6F5IWqkQ7kNvwHIxBFH&_nc_oc=AdpA5ZGG7vz9JjOBsv_dxgnq-qPVRVQJa1LsNzmAMi7JUmRDb0AgPPVwUsQH926-7Fw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_JSAY88w8DEz7qHIO2SE0DiuISEg0XAvz2TZuSPK5Tw&oe=6A7714C0"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNCNBaETZa4Q7kNvwFr1PW8&_nc_oc=Adqle487Mmjqh1q4ji0xvksQ4JkfGBMtfuuJWxVNMn-7T6KcRgnz4tRq9phQYmQW76w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFKLMuQRtY8tqyR_HYjwRfcJxIdaJX_vYD3gjyc5DvCA&oe=6A77407A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RuGAcM4FWcQ7kNvwETM6zr&_nc_oc=AdrJ_3iehYsnbRU5R2rsKIGSFgSArdW7tBniWQX-VH0Z5sDS-RVOvMEsD4noiMfhVbo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZKQxKFCMWa6FwCd7JTzxbloCu8dXbqDhKNducHlGnaw&oe=6A771069"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvtJu9rup4cQ7kNvwEld8lm&_nc_oc=AdrImse57uHBcgr_AzIvN2IihgSzPRkt2jWKvDknljtuJTKq6A1p9iFVin4rzbNWCgc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbbGVvBAAIOMD6AenFyQaZCYE3ttBaM9FpeOyquTaFEg&oe=6A7717A8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
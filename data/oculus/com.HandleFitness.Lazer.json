png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pn189uXXG24Q7kNvwEd2pgh&_nc_oc=AdrLntw6nrWJl-lw30rF7gproq9pk2dqWr_7PQ0VTFLZ_nHAcM6oL2XEQpcVllBV7pg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOC3Iu0HkZd-yHGkNAXB6c8Ozz2hdsE9gI_0n1a9CaYg&oe=69CBC6DE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f97A-cKs5AYQ7kNvwE_BhMq&_nc_oc=Adq7sYH5ExmHMUXx8ecqBMzubkKhOXGAMgR2qvYrzW2f6mnU9ux1IjoCtDTOvbf1cUc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwdmg8lw1wG_UZAeN6KjH2iQJf0yLCVTO35E_vjzaH0fw&oe=69CBB1C0"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9Y3gnyw-LAQ7kNvwHpfJPy&_nc_oc=AdqClHEPpd05mWWHc0s7UG4_KGO8O839adIrwWtNAH2ZvDVf33SH3zB3JY822K2RCc4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyvn09zNG54jJJpatfRIfyR6rApN_LsGU-7j-2psiYi_Q&oe=69CBDD7A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y75EV2FvYs0Q7kNvwHBNe1g&_nc_oc=AdrAmWoapePpz921lrhKmOrSrvvatRSewGlJqErGjF6VPv6sDOr0KHrKUOKl3ls2UQk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKRUcj37R0gRFmVPoZzUaTb7mGJpp9jNAL3QR88jGiMA&oe=69CBAD69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBLAlN6bgdMQ7kNvwFeUvHU&_nc_oc=AdpG4UvfFSew2D72-9GM65G5EdA-2XTja-Lm5JtBBqMBILKzy6rYyT9y046PAaFCcQk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfBQGNoVjIeymVV45cnjH4pt_ShddKU1JU2JtU9DmMtw&oe=69CBB4A8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5ew2kFWgVMQ7kNvwF_XczK&_nc_oc=Adps3uFHfHZAIF67XVfqlkfvu681mQybVHcTBar3CDemXxkgk14bj19QPNHNtXqIqng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg7T-ACP5CZlBnqlpHNB-VbDm6iLNRFAWZPmMtcL-QiA&oe=6A9C13DE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuSclsKMo4MQ7kNvwHhkUl_&_nc_oc=AdrWivs1OYL6NCAHmPQOnf66cu2xVoJKqZX_CquGMlIArP2_X9AztdhbEO7Xe5-R7IA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLarm8yv-vt3JVE4kmhra6c8BqI6E5IcmCn0HcdgfbWiA&oe=6A9C3700"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxcvsRgzC0UQ7kNvwF4zeE_&_nc_oc=AdptQQV57u2aHRcDUgWWztiMm1qs_qYzP82GQJbtnJbnuT0xPCtuoo3pp5MTGx0SeZA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImJ1AeAyFLKjSq1BYU-0sWGLkOO1SDUCRYfWxGHzUh9Q&oe=6A9C2A7A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1FIAsNpPSoQ7kNvwHTIhsg&_nc_oc=Adpp1WmAG3bsrrMpeSoruZj-33-dFsBuIH2RvxlaOUXXtl9zi8i9T1rZzqw3vaDHzgg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINbcld106yUmEoqipbeqlT5-POEXLe2juN0j3Uqptvtg&oe=6A9C32A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0GStxFsOCcQ7kNvwGrCk-W&_nc_oc=AdrqWIEbO2lRuAig_W4sYY7nTv3NFlnMqF5ZjE05_MfCZm8m7Ctn7_nOGYZTbQvg7Rw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYub8sgP-rKQmogATJXJxXuJn4ToQUucOVhF12ffwibA&oe=6A9C39E8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
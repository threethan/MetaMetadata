uySs8EaM4yRDgI7aKaezR-1wcvgZiwsKQIQj86ns4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftrJ7-docw6Y9wVI_7yAyHpW-TRjsDoQ4vrItuOTJV2kw&oe=6999ADDE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2WwFuDIbxoQ7kNvwHYIjns&_nc_oc=Admm1jQOojz1vdp8Uqkp57coi-fAn4IHGbsbHsHn8zSLZH01r2FahLqwA6ytZTmYRJs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvSWmSd9ddg-eLEWJQ4BsRHdVyFbZjQqBjl8HMfY-xCcw&oe=699998C0"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvpQy-qVyloQ7kNvwGSsG1O&_nc_oc=Adk9wNWs1Gjw-lLEjcsZ6bViSLbkcdMNLxxRCF-yWXTY5rBF-palt8YEqp9nwZc5QVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftjOvOlwbtMSfaAIb1H6XG9NGyQdZqEBzJ-gS1T_wXGuw&oe=6999C47A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1Q7YrDmh4YQ7kNvwGjqNHw&_nc_oc=AdkdJNN7Lvow_mgTnjDz674N-PdvH2ckoxis-eiPibHRtZfCGfjk24IQq-b5cwjgluA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftCxOb9VzLeL7PJ6K2MnHKZp9aqOFRJ6GORR1QhzQrIoQ&oe=69999469"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8aR3SLBhg0Q7kNvwEy9b0y&_nc_oc=Adkexs7BqHBGeB45RrRNSdg0WolAxkToAU9df3veMNepeKJWVBf2Hq0PWlgQKR9t3Bs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftSVBuCOgo2-RnhGSp4l8askBoFa3CAx3xB1EilpJBcWA&oe=69999BA8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_service_url": null, "publisher_name": "RCM Productions, Inc.", "support_website_url": null, "website_url": "https://www.handlefitness.com/", "category": null, "comfort_rating"
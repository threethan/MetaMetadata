png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txcQ2IH7_EMQ7kNvwH4akuO&_nc_oc=Adq_UbXrTfNWSWCu5Fda5bf32-UAExMIGClpg6EPkZ7mcXhtdpP1sCh_Iq1rlV7jod0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKIAsZ9a932GqE2x8WH304Satz3WbcHRWMTC1iirm0gw&oe=6A899EDE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GK6qbqSf0SYQ7kNvwFoH53t&_nc_oc=AdqM1l3OmpdhHtf652t-4Fnkwe8HVXWYOGk1f1SkZ8kXF13GD8dkONhfYAXSaX4bBtg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_Y76dB4y27scN_IANcHfCa6nvrFTrbrFTQ3e3ivGiBw&oe=6A8989C0"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOGELKmtmV0Q7kNvwEsSbOg&_nc_oc=Ado42b2sz-d7dZyRA0LnRGq8jMsY9SQAK0WTcVerOviBs_z1fVoDOzz65KThksuszWc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgT5Esnx9Ah_ruCqTn4OLUVXxdx2XN-wu-pV4MT_OHGg&oe=6A897D3A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqpFJbLg1v8Q7kNvwGVDYWc&_nc_oc=AdpZ1OtnI39JSk08HMXbxdcJiM2lOfGPl-37jeAJ-vikF4F_HBkxVYTJbQWiPtXIqHo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEd6TPufo6I8mlGju-i5ouHMLEOvAFYStRhiS5BIjilFg&oe=6A898569"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tdgu2KdEunEQ7kNvwFT82sV&_nc_oc=Adp-BI3a_aQ0UV1AiJN_tXFAiHckg68qNfK9XEfCKS6dJJhJ-0N-K1CdkDMbW_1VbKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_D01P2eWEZTmzTZFqBuomEO3b513LqXuwhefBQbULtQ&oe=6A898CA8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
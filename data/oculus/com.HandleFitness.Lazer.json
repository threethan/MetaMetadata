v/t64.5771-25/75395596_1032122854992350_6158185522429019667_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKkOgKYLZy0Q7kNvwFkS1LQ&_nc_oc=AdooKC_wUOVT3dEO-59MBIicWmS7oK0ggU3gkHUtV3dqcZq4qYFmU3ih3-sUP87tS2s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HeeZWKZX_p53opG6wm2-nxJILi20g7QJkWdTJQKbyQg&oe=6A0B0EDE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ov0ZIqdCae0Q7kNvwHOP7zr&_nc_oc=AdraGrBsYoy92gdAG60F6cGWchcp0t4a2334YMRj3VJ7rGXthSrDnbTS-rqPM7y89xM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aHmDKI17o6JlXduFai9sWrMrudllYmjnHb8OWJ8kggQ&oe=6A0B3200"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10hVt1AayPQQ7kNvwEZv54F&_nc_oc=Adp8MQDWLZp5q89Q8Pda3AiLOVGwM53H6MBXdHCcFos3mvA2aBjqUeIhOpqxVhM7au8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WIV__KTTFN5oC9hYMHk0ryDzJBmqmN7Bm0ZPLt9p0RA&oe=6A0B257A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrwHS4rucyIQ7kNvwGihUP1&_nc_oc=AdqmmDJ-SEwXFnV9Y4Q9RFf5GizR0b595sg3mZ34KGo_Nb7-wlDzgR7yecJ1QR5qaCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eSo4YDYVo9pRjyfhbBRVUC5xC0MEvkCFxcRl8-KYbSw&oe=6A0B2DA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6V6dtrEJSQMQ7kNvwHd9SYZ&_nc_oc=Adr5VKoLsNyLyUgCUjgwg4zW7jjI7Yy2IxFJzNeWXhyYYbr5uUFQB4yi4iG3QhQKGSI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yuHmoTMizKylS5P5emQqOAz64CuWUM4ipJzcNph53Dw&oe=6A0B34E8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "
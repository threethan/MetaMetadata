9019667_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0nvZQXHmCQQ7kNvwHccohc&_nc_oc=AdrFYb5UYYbx-LaY01Ktvht6voC8yQ93Ml6bBKJ-6xKUsd7Pl11KfoRrGwHiKtL6pck&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64dGteeWRIBeBrBrsD6deJP2eAKAIYwxhMysGRi5Cd0g&oe=6A11A65E"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvLufPww4rwQ7kNvwHthPg1&_nc_oc=AdrpyAGKeFsElnXPWwF_7moyyXBJ9KjO-YraJlYRGRYu1q2-1rlYH9NqbqHbey_KTHA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a-y-3BjTJhn0DJ-JnCekCwE0wBnwRXK5ZCMkRlaEsVg&oe=6A11C980"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J__FATSaqFcQ7kNvwFQ4Lk3&_nc_oc=AdpkBpN4MasBEr6ivFv_iiGIB2VIAheeFsQ1aON7kwMPriNx82xdhqcWXVkYBjzJ3ik&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53cixtqHeibalrlu2Sv1OzrGT_q6K3P8kQhuW62Zz4LQ&oe=6A11BCFA"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYsYhXepzFcQ7kNvwGNszUN&_nc_oc=Adp31diHUE3bdwyMk30yxc4wObxsMBoJ96Ldm7eWpT47V_4jkutx0cU5ZekJldTyzKw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HKQxdws-QWMWKZ3rauyE1UXV910z4DHYmRsomb-XeoQ&oe=6A11C529"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISXu2ZIZOtEQ7kNvwHkMC-I&_nc_oc=Adp2oQW83Q6sJMVZzUe7ssixSsyk2wGvCo8LKxcv5n37R_uPeDzkk-u4-FoN3o1qke0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IR__GUaWg9ViKYQoXvtUv7tcAp7hiXeoBlWHSDgNxkw&oe=6A11CC68"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_ter
019667_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rc5ypgl3fmoQ7kNvwF3k8I3&_nc_oc=AdrRHPZMLGOcEEcDDdz67-eU6JMYjly0hP__rNuFnVvgzRFVPK75c7fifoBsJi9RpjM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvEYH5Kjl1ZeyUX_FqplaFQfBwa-vdGW6aiI8hWW3tDA&oe=6A85AA5E"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLMtW5O0yckQ7kNvwFi6W6A&_nc_oc=AdqSlKoWTGBsKh4pHEzj8h0la7csyDjyWuYDvyYqqyKQ6uUIJ76BDg4JbITaOS2Bh04&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj4Cm5YK0tE769kiSWqel5G4Anj4NJKd7LGTPVWtIxMA&oe=6A859540"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfV5VnjmyhcQ7kNvwEiN5xR&_nc_oc=Adq8dFzqzpFhS_vySKjMdZ-nvHsdwRZF8HJ-2vwaZBoJy24EPxgy28uHdtACNIl80Hk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEerm4JjM6VJxEpKo6WLnTMMPeFoAO5Qa8PAjTllY-3YQ&oe=6A8588BA"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_DVoDE50JwQ7kNvwFl7A0B&_nc_oc=Adqw_z7UKm6-Nt18TIhbAv-Mb-cIt0p13jWCcaaaMaqZGy7PzBGaws73VIzbpwpH0tA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUEhEE1KbDho2tsc90E4bkwLuZ8OfTfTYIXqqCVXRk7g&oe=6A8590E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUDNWCUcCjAQ7kNvwFw1uYI&_nc_oc=AdqHTAD4yubRtI1d4OYz1shSL550D0_F7s3X8wwsnC6C6ZV5dV1nu2OWXn3bStR6HH4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBQMcgfvzlzQIXp-SJuZoDclfgoFOdhFMDVJkNQvzx4Q&oe=6A859828"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_t
png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qozL63q_uBwQ7kNvwGxqChO&_nc_oc=AdoWmSqtNbcPK2s_Ozfw-dqae7g27RVjcSHVNg02RHVtHpdOIeboGEWmM_ZVApsWIhU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af11_4FZ-iBuj4jgRhVItDqN2ORH_Lk7x9gkH8baTvkwfw&oe=69F5F6DE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jbxl1gCSJwsQ7kNvwFkGVk1&_nc_oc=AdpXxKtSrCtrN38LKS8RNe8MUgp4kSHZpxsg6ZfAdcHwoi7q3bSZRsW_u4EEuXyZW-s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0pok7bHqk10LFjXZhVs_-RecJfrpuIebtIzarZZxdALA&oe=69F61A00"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SMnRRsctX0Q7kNvwHSxq12&_nc_oc=AdqFTBU-ZYiVCLWR3pZEMIziHCcAStsuJL2L-xwfD9e-MP2m5VrRrEyyWRujE7jsNcA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0oIGtc-H0EfQq4kYPbojuIQeJGid4x7pXfO3PQSrGn-w&oe=69F60D7A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwxMoXYrCSAQ7kNvwHslHtA&_nc_oc=AdoRSiANBL9I3HgQAwvnBONsssguf1rdJmzicfZeyI13K9dIunSqB2kVSdRHhpNN-Ig&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27rcq2NmOagmeRWSuM-JG2HFRZRLT60GmQjpwSGuKGvw&oe=69F615A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v74adZ9d_x4Q7kNvwEXb3Zf&_nc_oc=AdqUnmhzYa1o7an6mQlAUmbn_UjWXKufV-LA6uPsvp8hu0kgNzwCHgmJIYOC1ycR1jE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2nuheHE7gISW2iPDpeAeWvLU92hI5-yE3KxO96G8iE0Q&oe=69F5E4A8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
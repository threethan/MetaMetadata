png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NNdKzQ1rgsQ7kNvwHfiivj&_nc_oc=AdqTYFp0BB1BhzJwLQBFiFrssPZ8pAruLXHn0pcK2LH-PzSWA7OwrxMZV81Ctp-1KNE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVXA-lJTuNwlNWNkY-t9LC9NfrTU08qnn6Lmh4OwYpsg&oe=6AB5205E"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Do5EnuSkV_kQ7kNvwGIUq_a&_nc_oc=AdqeOk2Kk1zyLzS5gtzmmpdzNOoEqm9kq6pKMggxngAQqGQeYrLnN_amhwTDQB2MPTc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoXym3XCcFQnK8w0T_vZzK3irkM5uWtk9r8RW-nTIrOg&oe=6AB54380"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CVzxrP8Q8wQ7kNvwFBIaY_&_nc_oc=AdqCmemLCqmp49fL_AjMWDgf_CU6qEfGD4kTrfHXLdDdtfokRvdEUXnGOw8zCHSYiOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6qJSlIsqIUmkpe8W1315XcVfgCksBrf0BUpgAiFYYSQ&oe=6AB536FA"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im1z38JeL4MQ7kNvwHdF-tB&_nc_oc=AdqB3-W6qH-xdaqcHlOJAo125M2x6gacfVscFf2OPi38IgsqU51xHxs6o4EXTE_EV0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtXgZhJBKzCG5_LaisEY4FAZBJTIzKn3RDF9Pu_KAibQ&oe=6AB53F29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnCjKsV8MpoQ7kNvwEGd7CO&_nc_oc=AdqnPpJRpTG0bsuhXLTFnOqTYNsgaSsmi6Pz5JRy_gh5sw3vqyp4GdXDoW0EcRg_R2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJifY_vJ7bDThdNopd8sPFSTat63zv5ZQ4K9kuQLDYLyw&oe=6AB54668"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
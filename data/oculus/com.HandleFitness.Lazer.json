CYXTgk9aYTXXuA0Xu-CTlhUhhK3dggSVkUkM_a4xs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsENmgMtXXuHGz9Q1RXkvqHnFwuUW1ktkCdNwHY8wAHFg&oe=69A196DE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YEJWLAl3HYQ7kNvwG2XB3k&_nc_oc=AdmjMRxj0UwBZTOQtOJCTbrDVLqt2_tlIemtKzqXtKRSoxrASd5OBOC8g8gmCka3xEQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu1MBOtlAQQ-95mFKjbG1teo841mW7mcC925qWVnjUfPQ&oe=69A181C0"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmHy_zjqF0gQ7kNvwEMzz3X&_nc_oc=Adn5xX0MThULCFzpiNqJ2UUWn_IfzITWQf3SPRdnWfaaQzklUEOM8ouxHkU3911HN2E&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuDysW92B_GTSGub9w9yCgfso7zaZfuoDkx8WYIhg9q0g&oe=69A1753A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yS61w5DyheoQ7kNvwGaNaVo&_nc_oc=Adnlqr-pTJfUHjboeW704lTsZHcALcwjy_fAHURGoliTDPGeBGeIw2cpeVjfy7N_zDY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afum0uUrnXO_bmnnpAnUSIxS5YigmR9PsLm0IvCpj3E4Tw&oe=69A17D69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeEty-I35xUQ7kNvwF-g3aG&_nc_oc=Adkl0rhnjBmAHjI0RUbp2tVyn9B50m3fw5ubfe743szDLTInjMBVOdzAam4QQq966Lo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftXZl6Uw0DwaHnNbn2UhnW6MbYtlY-RSQpuUcUvI_nSKw&oe=69A184A8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_service_url": null, "publisher_name": "RCM Productions, Inc.", "support_website_url": null, "website_url": "https://www.handlefitness.com/", "category": null, "comfort_rating"
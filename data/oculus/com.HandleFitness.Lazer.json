png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHV0o1D0t10Q7kNvwFSYWdc&_nc_oc=Adpm5V_DjZVYEXfarWirZbYzsnqAkQUVuSACa3bcIy8c7PnU9rEZOBN1YBeBhqpJaTk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIH3bsFMxxlpZLucLGUadlgX5tJCmI8i7ue6Dps5oPvw&oe=6AE344DE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhXgy-M0-S0Q7kNvwF02Bey&_nc_oc=Adoc2iS8iTh0fMZqMr-6l2QmG_wtUsm1oVjf2zyf3JSOP52N3_peUFEet9xjBb6MLEY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUIYkdsK6tRhYni8PsE-aXMaLr0XGT-PUNPAFItR3Otw&oe=6AE36800"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJyZh2A6_G8Q7kNvwFIIyrd&_nc_oc=Adqe2X20kIK7yey_OcT-6Zljiz39f2rlNp1jStHkg6vhXJ0x-VZbShfksqRsNHsNY7A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkw0wMoURiNZrchQ-GJx3a4EHZpUGfQQFyK_1b3BWcnw&oe=6AE35B7A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uQ87twwV1cQ7kNvwHjfJma&_nc_oc=Adr2iPTVy4qH8HNkPi50pLm3trb9OW5LNtgdsDMYjTOoWnuUDfYWw9196TfQLmG7hyk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM-ypSNBS-os6VGITSbRjzWkhJI1sP6tCgJ3nURod6pw&oe=6AE363A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnwvdasKl74Q7kNvwH2eQVZ&_nc_oc=AdqaXhicp-LW8zw7EB08635E_bSnT5968VJsOAQhPuk0ZQBcFSpPfgHqtVbDTW_nPyw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg75lqKA4y2fEGsRMCKe9D71os8ReNQoLTwCSJJ_yE8A&oe=6AE36AE8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
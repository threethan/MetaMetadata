png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCHzRhkfL-0Q7kNvwHZDs-o&_nc_oc=AdrUUGu3Rv1eAuVh0PSgKfWqvVflSiXNJS51fv3pR6_fHm5tuZ4FHOKF2MbbNqiY4xE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fs03lJf2ENuWtTaGSRyphf_bxJtCJ6vLN2RHRg7PUEw&oe=69DE3BDE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sc26UAYkvnkQ7kNvwH_2K50&_nc_oc=AdofT0auC44ujZ_CAfNckrOLAxcXKc2WslYSF4Ehd6RM-BCrlponIpu-nX_k-kl4v_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lXKvybNI2ec_Fda-AC2-yZll2Av1iFYI27zB_Eg2wjw&oe=69DE26C0"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0Wgj3N07OgQ7kNvwFjbF1C&_nc_oc=Ado3XlsLI8d4_STIVwV39JaY7f5iuDYjCN23wK4XyY0u08ayRlsHglQJrDHgDM1r6gE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1e_njmKiAGzEsFu2MDK6Suybf394Obge306CluTwEG5w&oe=69DE527A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhYq38_N2x8Q7kNvwF375Yt&_nc_oc=AdoK1uTqwWsPb4BCswQQ3QvlEsmIbn5e-_3qmF_BfDF-yRBYio0qVrB3iKeTPbsaYNc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xJDbF9-eG-AVLWzNPMbNq_fJUujASS5ntZTSL-MSKOw&oe=69DE2269"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btdM2QKygLgQ7kNvwFOyR1d&_nc_oc=AdoiGPOqnnFNIDOC9eIajZniN5xDEoI3fLHUmYaTz5YFAmbl0-hvPvnWY1a_9PQ4bZc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0f7v1MIuA-Bp1Ynrlul_PBnzcrURxShhnirEV697G3wg&oe=69DE29A8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
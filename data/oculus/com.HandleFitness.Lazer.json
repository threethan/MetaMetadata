png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bbbvZ_8sAkQ7kNvwF3ze1G&_nc_oc=AdpB4dfLWSNHVFN7rD3BKHPnzcxLk4BpLyXeIqZgK81Rolj9Mk5-1--1WAubTts_pJk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zy22jy1fv-lf72527jMkPPh3ieHAqfsimUH2GSHoL8w&oe=69F899DE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAca2rBHnKQQ7kNvwHJ4t5-&_nc_oc=Adp3SKgclJagLHURzkfn1_zGsD_rUjnDT1psTbCLRtTGlrj4q1113amAMXqS2hEBQjU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25D0360ef3cl2LYMPJbr5Ay_3gKa_wAo8Fiy_4D30q1Q&oe=69F8BD00"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5sZRy_N8MoQ7kNvwHAofKr&_nc_oc=AdrN8Uodr-Xv1IAFihlsffxkk5cCN0Bns9ofwpny_tk4wEA3akiYfzb_WUp_VKDkaFc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1RREFl5SCv2V8cSg5oQ3B4lsgp6462lNQRuoO6kNoATw&oe=69F8B07A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbqIBYgcZQIQ7kNvwF_kqLx&_nc_oc=AdprInlwMa_mES42ih5OGB9n-RdURevmHge2LSeDhO0M_HX2Pmp7kYHayn_hPgs18xs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0IdxekcoYJDrWqHtne6zfxL_ubYZYrHgKONOCD0WIjoA&oe=69F8B8A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v74adZ9d_x4Q7kNvwHVYH9G&_nc_oc=AdqJ1n_OekBabJ61HoTLJIbPMNZdLredBfmMR8C3XTlC62jwVYcsZzRlcrKs5_uirEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0S4pM9TgcZH8phbsQwPX_CDwCQlZn4oFjnDPyTZoDWVg&oe=69F887A8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
-sin6-3.oculuscdn.com/v/t64.5771-25/75395596_1032122854992350_6158185522429019667_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rq7udToopvQQ7kNvwH2MeuK&_nc_oc=AdqKfICqzZ9GnjvrpdWB0pvtVw9OFUh3FpCiAETntFP2LaIzb1D-XSdwhSIWTe3UYEQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkRXkxmeJvFUcnYy9Tk5POV7gkjHguB_BL_Q3XkoPSVg&oe=6A7DC15E"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99iyqs4veLwQ7kNvwGh0XcP&_nc_oc=AdpY_CDwi9-bPEbg52wXL7X7VPqC5uv1S-zCECivcA-C8tdc8NnO2RM6Wn-PHnmo0bg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsIe8JpGVxSwMmT8qyvnAq6q-vBok6VbfUx2z-IJ4CfA&oe=6A7DAC40"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QSNO3hHGc0Q7kNvwEnY4J-&_nc_oc=Adrhvhww1zWpHx3MEn4o4HRqwNhxWq6sT4jQXO1hKy3YcXXmxSkn_lWM2ftuL0wt4Pk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvBeuOSPKL-1z1JCGJRSTPKqTidekAEaXcu1wN5qc-Nw&oe=6A7D9FBA"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5lcKTQLR38Q7kNvwGelVel&_nc_oc=AdqwbKHOZfh5-BXgbZD9mZoldItr_ulD5BRRM7T9xryD--jdy7RXIFVS8_t60VlQIIc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSa6tdoTW0ocEji8wOSYx1lNOSY5o4gEmb3MRJEOZo8g&oe=6A7DA7E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTMiUAep8eYQ7kNvwE_GNAg&_nc_oc=AdoVzY_06XDkzmZwA360KfYY54w-_YeZUbOhJEAjwUjjPNqsryhIIjnqpA2UQfL3JRI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1f4yOX6im86UIQ8gpL8z02W_JrjKsg6cyNlcXq9rlTg&oe=6A7DAF28"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "develope
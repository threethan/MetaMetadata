png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rc5ypgl3fmoQ7kNvwEqnBCq&_nc_oc=Adqj9PZYLrk4DUIfz1exUF4qghSnmpT5bPIQDN8ZguLHh6DCbIdMm-_UZt-usPcTN9s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYEcK1oz9fn5QFlQPsxxgBde-s_KAOZBcRnHH8Ml1CZA&oe=6A83075E"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLMtW5O0yckQ7kNvwGZwEAM&_nc_oc=AdoTERUDXw6a8dTxjVpVrYhrHb3OILV17lKpSJGZ48s32kg9yt8Lq2LsK5vnW2u9Ndo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrYXF5gtj5sTHDhsuaeoTEyDkRSOGxPkXF0iEuccZg5w&oe=6A82F240"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfV5VnjmyhcQ7kNvwH2Cics&_nc_oc=Adq1wzpc7SM0imp74_8ADPT7zveLSKNQiQaxw64TC0_MH3D865lnLA2xLS_B9nhpuZ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhpeoeQlArK-bP-GBeId_Q5ane68nQo9XYS2ONiy5NXw&oe=6A82E5BA"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mn3IXFNUxYQ7kNvwFTGqIp&_nc_oc=AdqSt7BU2L_-2-uL9HdhROLZlaMB6MDTf5wKWdwvYhXmadI4rF9rF0mIrnUq9o55JFs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhI1p-PD-SyeJRbWCleonBjzmyZyCd5Wseej3zf3XEOA&oe=6A82EDE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um4pIRVLTaEQ7kNvwHmeZl-&_nc_oc=AdprdjHAfvzM9MqRnzAfKJwAOYH6cIRLeRIHzpXOANTccmbMPl0bCV4BfThNXo0WbbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKFn1L5fzuqKoUghQ-fo827X47hmWHf0_8lkUIWvnjZg&oe=6A82F528"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
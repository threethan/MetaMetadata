png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WoUZxdCw-4Q7kNvwHoLSg5&_nc_oc=Adodh3aOx2bJZTm2HGmdhFn_Fre-xdlQrTHsdY55SHUeab6086jK8qWn5-_y0X2I6Sg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkDGuMSiRn4EHeZ1eE0UaxNyldVjGsGx7dv8VOEEg4cA&oe=6AC643DE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7w9Uy_uQXHsQ7kNvwH-e5b_&_nc_oc=AdqTfjO0Ki6y37G4xjjSmO5sGVo26QBmJuTnBu1rOt0s3PwOan05_3cjJsl8Ez-3Yxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP7DDmFGHqq7S_3dpVn68qJOCD2_3r_-UBej6E3Heo7g&oe=6AC66700"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sdenmOaE7sQ7kNvwE7urPK&_nc_oc=AdpVevvCh_nE3dkT4Udo2aW4l9j4INezhxSgoegks6NEjME5uYPaeouKUMBWVgsNC_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYA_mWHmWsRevPz9LFtVOeeSBtcgKrnV_saNaVmi2Q1A&oe=6AC65A7A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wfFq-jeaToQ7kNvwH-HoKR&_nc_oc=Adr4LZxWKxE_ds1q44r4pwVssf4ReeCUpnadZaFn7uoZsUM16Hf312dji_I56yeFO5Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW-gjJTO1w5CEWmenzrEdYyEgHvyet6m6QTFdT7OZboA&oe=6AC662A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVfcJolKgr4Q7kNvwFLi-ZX&_nc_oc=Ado6QkkmPrJzz6zWbiBQe_VsFmP9DTU4DN6fcj3oK1iP621OmcHTC9tVJfCNXDWuduk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqtLqBqeSQuFGqgzBElpDTBnZGkr6s4VIiGuVyFPTAGg&oe=6AC669E8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rc5ypgl3fmoQ7kNvwFUwwOs&_nc_oc=AdqbUVfh6Zww3kuGK8boWeSzLeAjtH_dS4KRlD-yXNXrIDm67zjlGe0920kJQo3ZI1U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5xYzOyL1frZmKw_o_iEbONflw-1w6bKS6aaKDWj0lxA&oe=6A86FBDE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GK6qbqSf0SYQ7kNvwGdvEnJ&_nc_oc=AdpTqIPgXf2hDk-64K-D8FitUzIt6C4dgfyvpS6RF1QUwhIxQ-G2BU0_geSX1OHs7zY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp53UMla0Yq3IVxFSGdE_E8RL34yoJJOGW3mj0BJeUqg&oe=6A86E6C0"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOGELKmtmV0Q7kNvwEMoKy_&_nc_oc=AdrwlafQ3daB0E5ktS5SvJIg3Bhp3RxcqW5--NYY_2UTlLvutJtkU8tjXtxIFIMCcbU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEavlchs3DwaT4cAL0r72ghb_xC2eBl9RNn4miNlOKcYQ&oe=6A86DA3A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_DVoDE50JwQ7kNvwEMESNe&_nc_oc=AdpO7otAl_P-luEToR9ZNSDs0sqoNSZtgeVcZl2NS57LYIehubimdoqBxrNWUJO2kuI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE743UeJeSspoNygO5Vriiydo542oYu_4kG_B1uNryKtg&oe=6A86E269"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUDNWCUcCjAQ7kNvwH5qis9&_nc_oc=AdoTbPBcahhkEZhba__moRgkM6FfR2OfuZe5YaEkOwJHTZdL6YDze8GykgZF8a8Brjk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc8AvHOAELagqD_LC7SpT3FPZ_7bffhDJVINztCcNKqw&oe=6A86E9A8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
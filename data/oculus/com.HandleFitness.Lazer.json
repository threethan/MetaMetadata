9019667_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8S5i_1XYffwQ7kNvwG0xd7S&_nc_oc=AdpeNy2RPEAzPOAVvvDzBRFr7WLv3v0Fb7BoWCljYZyXNWF3MPw-8zZ2-e75gHQS3d0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yCfCE2ma-GW1vUX1qNtMK5Dywlj_FK8yoLUU74j7JMQ&oe=6A46625E"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TD1KJgqF8pMQ7kNvwH7wa9u&_nc_oc=AdrKs44-saJfhFEVn9Z79qQOVhX0zG5_rImbJt6k3tX_svWscYCDwWMOvdtYYYLPnhQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h_HOGAru1QoXOaziiSt-bRiFJIt3-M2CJWCo3NfWFow&oe=6A468580"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V58Um2xi99MQ7kNvwEy1tzg&_nc_oc=Adp78iTn9EAg_ZGrEUTRTQU_SitSoV3RtxMayiKGFsTDh_zl6HYRtJ4ADwZB7lyjOxM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NmQMDZ_8omV0Hy4inO8lfq3AHDRN-ipFCpKKt56EBqA&oe=6A4678FA"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_ieFiP72U8Q7kNvwFIAuK4&_nc_oc=AdoN_v-ZLz3SBXgo7y8ZYEUbJF-9PTLA3tgMynxVtonxFx7ZSGOHZS6ebGTBbuwlIBQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WIzfihYvZb9CmC5aCK6xXj59on4jqubiFIvKotfJcEw&oe=6A468129"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=af6DZ1R5iXMQ7kNvwEH8ea7&_nc_oc=AdqnDaVxt2J-jtJNMFAhKDk-UlA9h54DqhRGMyzmSYSn39lB_N1VZbLbzBw0ZvQkpQw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iFdPDvwV2zkbBdO0Pcpfm97h-dJL3qZtqKsTnG4oiOw&oe=6A468868"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_ter
png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuQsh3JgHs8Q7kNvwF69bUh&_nc_oc=AdpT1q_ws15nAKtv1hl3UbCJosWVVq0rM0B872bVJ9tQ3PbVU2v5ZB1Z5Tgi_6Gxz8s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgmO5cN2falDOmrtMvSrm3Dka7O345QOBmOYUFHqgGqA&oe=6AA159DE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97I7MUGBQZIQ7kNvwGj4Pob&_nc_oc=AdqFed_SOgncuu3SYNaFrlP6TMqdUNPRTZTzApdF32AR3WJ8MLOKkzdQqGl8SMi1oz4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjLasGVkcl7ZUr7oFsVeBoPy8iJDefb_h-aAWIPJV8hQ&oe=6AA17D00"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3nH9LbFxmYQ7kNvwF4iB3n&_nc_oc=AdphUtpcAz6skg-hvKSiZzZhoTrc164bsf_WNrNjyFYtmDJNSGRiIGhpROuqqqY3rwI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqHKzmKkzSoglt1iM4sa5dOFaBsgRo51LtXYCmbgBR-g&oe=6AA1707A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mH3KreMqWcQ7kNvwGMxeM2&_nc_oc=AdpD6ymEzwZlYzUMntptZcucQFSBu403TmvvB_ZQAOojz5GQoV1hLy7aqGOJjoYMG2c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt-SgsH3R2DEX4LZb1S4IEAEfMpHefFX4QTQd4mv_h6Q&oe=6AA178A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvuQ-sN6a_oQ7kNvwHPm88y&_nc_oc=AdqT6xmDk1H_-W6P-tl2T5T-zrY8MPfk06FM9hCUGMtD7oVm92anNkS-b32Rka5ODEI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhWzIUq-cfLtyj2x5rz6WBsapc1bBEULdfqNbva2kS8Q&oe=6AA17FE8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFt3mX04ilsQ7kNvwGQUcEZ&_nc_oc=Adoh2sC-N88g6FZo1qrIf_qw9rwDFWNWKa3d5wTWkZiS3iKPxnCgzgg4TnpCYnn2XSU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-y45etA6ByINM4KhoSjl0_pB_X1MFx7PZLAlx489IEEQ&oe=6A37E1DE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7XDp55tif4Q7kNvwGItPP7&_nc_oc=AdpmEYWVYswk5OFTQBCRfWqChCc-9SJgwOJZceVR_htRvsWq8wgUx3OMJ6S0Ob3uP0Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GXOlswt85thSaEBkYV6HZFZ2LGST54lCrCIijIvOmyQ&oe=6A380500"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9v3cCYZL7xMQ7kNvwFL_jwr&_nc_oc=Adrv0t6kEWTyUJjAJXrFN75Bb_LxbqoKqtjlZqrDMrvw1bTGOL2DEeOCBDLWWxfXxG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gY5E5bM2xga4FEf6btzXs3bo6uHqM7Jy_R3fXVFRSRw&oe=6A37F87A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx7iEpb2rJ0Q7kNvwGHn64C&_nc_oc=Adq9PNm9KoikyGUnWh1X73liPd60aLU_msGcTvldlIsuzxN8dAgbH_cq8iLMe50lTT0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af801Hh6KCUMNzpaS0GW5S_IHWlLzkGdieRLkiVm1YbALw&oe=6A3800A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUdvgtriZUsQ7kNvwFUPB9r&_nc_oc=AdqHiQOChP5WW8HNjn8Np4XnO5GGTq1bBvDq3t5l7xR5AQSWwD9joRySWzis9W1Ryc0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-g9zr1EYBb_H9mVtkymC5K9oHyfCJT0in9awyYoC5D8A&oe=6A3807E8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
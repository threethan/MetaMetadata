png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lt_hARwEmNQQ7kNvwFzj8XB&_nc_oc=AdpgAcqzuMVNGqD86m31G_8Ro8bI0qbxjlzjmjzFfuJtIAaYa3xd8WqbEleHyIZkrrc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hHcwydrndtdN8WKD_PxMD3y0hJFs7cSx-lG9wDRLgvQ&oe=6A159ADE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaVhaTEnLn4Q7kNvwFk2KOs&_nc_oc=AdooHpk7wEF3hwUmcMVE6G0AxeCERmgs2LSZMl6hLyWQc1XrIJr_i8xn0BihqC487dc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6B8w6gaLASrKA85E3igNpjJBAlQLr6cQ3uqVJIR88LzA&oe=6A15BE00"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bN4zsrCw6m8Q7kNvwEK1RIP&_nc_oc=AdoZ_mRlvw3dgYr7jossIw0YjrsS9Y9rjFTWUiuKFhl9lekU_noj0fWRYKpwau51XfY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64ejT3RwgWWfAkuCPfh0QctTBULSU3tq5CEa0KEt_zLQ&oe=6A15B17A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHs-sR9u4aQQ7kNvwFgdjjE&_nc_oc=AdoI-myr00V5EOKmTgK6XbFVRLD0eeoRmc0kc7A0JlHIFiq7zc_ltDialm_38XlIznw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cmobw8GyGCqFc7_eo4B2vMEYtD2MAcviSjc4UMSfmcw&oe=6A15B9A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2ZcoM_NJqAQ7kNvwFByYbZ&_nc_oc=Adrwot-5nbkElwsHVFg4QmH7yRq6xs0GALdRnEois4-qzm-sc4aqZNomSPqbZKcd3MM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w-y9cc_0o59MM4WKHT6SmcZ4ztJs1JyOWP_RqY3-N4g&oe=6A15C0E8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziZ2CDeSG0EQ7kNvwE-HEd8&_nc_oc=AdrHGpPqsifgBQ9YZwRCD6iRX3BJtrnIDJDrVBuhX423UsCLNzficx82OLrf-8v6djc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ox6dURKM1D0pA0nXmlFBSW3Uo-OTmy8ypo1xpxdiYww&oe=6A0DB1DE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdJog-hSNrEQ7kNvwFsVHoc&_nc_oc=AdrDIjiTZ5P4Cra6QhdYQFtgmBk5FuR6d0mb2I0M-A2Je09VH7JCpUpul7CNQNgrrvE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rkFv7OepMxUmlrIAiSL2NfLJ19IlDRgZnSNGZzYDBQA&oe=6A0DD500"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10hVt1AayPQQ7kNvwFXzVvd&_nc_oc=AdrPovR6y8GFGhDjYHyiakrkNm8lMYmTRqHGzp5SX4js52q5Nzj68hmAfEATvMZORiU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nLc9QQa5_AlCqfh5j_DAsCuKG8pdifR1BymyjmsyFbg&oe=6A0DC87A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrwHS4rucyIQ7kNvwEFDqrE&_nc_oc=AdptSQnBysVnkU87DZgLb7400zfOXMGlvygxVO6ttXMM-loo_iYa49whAmcu0v9xG8Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xl6dc6Y6kqD8k6MDm4eTD_7sZn_-abmL6WOaXLiNIpQ&oe=6A0DD0A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQPdRXpDD8cQ7kNvwFwTKPP&_nc_oc=AdpjoppFoaZSVlhzTX4Hi8T_rsoQCXceWmLPz07kEWrTWmIBuuDpyST2d1fqB3ZdBMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AW1MjEVo1K2QANrSwkQ_CEBbu1savBNuCQmnDXU3KpA&oe=6A0D9FA8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
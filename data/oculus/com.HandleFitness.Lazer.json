png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omjaBW-fCwUQ7kNvwG-FxWO&_nc_oc=AdqjIBLygw_bwllGWQStsq_eEIgsSOEQTkNMN6YlwADggQatKNVwEJ--utv3ZOHRK7A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5Q7FKChkPYOjiF7lXTKf_kTA-08glqE8Ay-S3W7PQAg&oe=6AF5F21E"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QNMIySG23YQ7kNvwEvF0Mu&_nc_oc=Adq8rjDjVuCSI08oROPIwKhKPwU0jx-lrxAeFMo3Tt9oLHED9hUUFCj4a3maFR36U8k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg63fS272DLqk_9R1vVGNZMoMZ0-C1QfUHAe9Len6-Lw&oe=6AF5DD00"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1vh-GnNWfMQ7kNvwFmgOIu&_nc_oc=AdrS02Vfwibpd7pFISurOO2NS0lu5uUk5ZmIBU7MhTYYSgl0j5P-yI-M4tv3cnzZagU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw3SyjTtNMnSSU-3htGPY00dDLSxUjZ2yaYjncN9fmsg&oe=6AF5D07A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC5izeDiYyAQ7kNvwENA-tM&_nc_oc=AdrHkouDIJ6yiIdAmqh2GTZ7Mk3E4YM_SMOIgj2fAzuxG5CaAzrj4blMnm5_4AcXFcI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYFNYMUc3iAHZeHrCFCGym0XiicIb9XYHnWbdklDT6zA&oe=6AF5D8A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3LE-wKZNfgQ7kNvwHAZtnU&_nc_oc=AdqaBEKU9hRm5OAS7_csQgNTsc_aFSmohEZUcQBuQ32p99GoNqETpataPuy5Ul27U6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRL8Zw7Y-wu3Y5mTHIkLudeO4ey4EL8Smz0k2Qn_53tg&oe=6AF5DFE8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKkOgKYLZy0Q7kNvwFHY_Gc&_nc_oc=Adq6RLmYGRvzEom3x5rT-qCfqePdO_my3QSPNu1M4M_KAjCvpRJB1_2-WzQAmvTZ0_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AXtY6in-h8xZ1i93tPopBiWFhllvDXd4jrsn9tLZgvQ&oe=6A086BDE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ov0ZIqdCae0Q7kNvwFRji1n&_nc_oc=AdoODjH6z2JdjMS6JeJSC6nrzeL9WVzBhSZvsvOosYgNbwUtYg9Xg6EttjawaLS-fBg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7D-UtLEZ207SukXqkMggWKqb1VgsV-CMxMsjI2YZUfuw&oe=6A088F00"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9KCarRbFRYQ7kNvwEFghHj&_nc_oc=AdrcO5dYOLB5ZP-FGXD3heGtik8u4q05jRDUaGhyLpaW0zlGJVL8TJyW4bpEp-SvNLU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JY0c5hK9T6A2OqzR2LcIxmjIyC45PXkeNfHgbgsf6pA&oe=6A08827A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ex9rsp45w8Q7kNvwHi51R4&_nc_oc=AdqglQlwLjrBga4gpIPAGo5-aIdNdFycwbiBdbCHYB2bMPBzFtl4qROcJUM1228BAUk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vNFQoad_313s6ovuzD45lwWuLCK5T7rrzddJVeJSAhg&oe=6A088AA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJlTVcMvd98Q7kNvwHOWTo6&_nc_oc=Adqje22OqioWIV6eYRCUbRp8ljH2I6-wM4orwooz3E8CyArBUn-Jpk4KnC747OCAijA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Hsb6532LMv1s62apDOYlcjypZ9Al19xP5-M_jygYMnQ&oe=6A0891E8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
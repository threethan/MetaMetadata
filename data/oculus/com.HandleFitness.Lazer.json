ogFKZWhBVgJY1KF7s8xS00KWW3z5IdHupkvFX3Hvk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfttoIb5dfqWbXQGIittghg0uSG7hhR7df-aSINvJvKxTg&oe=699C50DE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2WwFuDIbxoQ7kNvwGNIc-N&_nc_oc=AdlM0DYRstt_uyPO9X4Gy3dHrdAflyLDbkAPX98cPmYKZNO-cEO_LisK9S_ov5asjsg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftqw0d0HAfDtFEnjj8rUWcZ2uzsS2vfFnDfhyxY3qVgWw&oe=699C3BC0"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3kFkI8dpSoQ7kNvwHaVZS5&_nc_oc=Adkkp_DMvJvmAOQvljFSIU4se8Df3af0iyjbiZ2SFkBnhd7OLuIEDHzINYYITuaQRO8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuXA8SgoPd2A5uclJ53aT1ietyiyQMPhov8DVGVnxJmNA&oe=699C677A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68S21rKzrh0Q7kNvwHhZbZj&_nc_oc=AdlnRHz595_lIRJESST2f30LfwZaVeohyaRG8tEaDsQoov8Y7W6lKlFe6Zoppj-vPtI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsVTF3apKZQUQkxbLdDx2IvMtGRVPSfi2PO53hVlSRNHg&oe=699C3769"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbZJ-di1F0QQ7kNvwHoNTXp&_nc_oc=Adn7wp4gNFlFONjwTi-CUfqvxwyqWGnXPdnwmXqknHgtfk2o48LkszOr50-06mUUkys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuPG8_z9S2mnScAIn25ZZgGebH3R7fdf-9QCfms82gcJw&oe=699C3EA8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_service_url": null, "publisher_name": "RCM Productions, Inc.", "support_website_url": null, "website_url": "https://www.handlefitness.com/", "category": null, "comfort_rating"
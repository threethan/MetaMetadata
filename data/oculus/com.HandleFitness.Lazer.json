png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vB9kdwcbvtUQ7kNvwERt0xn&_nc_oc=AdqFCDln33bPl5k6_SZEoJadAzkVbOil3Xb9BiqCDOKjsvI6sWexB1UMTxLRoylD1V4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RGHaIE4yutoGiyjGPcTZoTwS2OUBi8vy8B4oweYPhDw&oe=69E0DEDE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hN1rj1DgtT4Q7kNvwEj-U64&_nc_oc=Adq6y97e84u62KAKunDUxceZNKN2l8mSLUUrbFuUIxp515pk517N5h7pHadftDMyYag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3H2k06TKwoSdzgMMh_OhSXLoTyDttdbJIS12pXdsgDTA&oe=69E0C9C0"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZd-Juu9Bp0Q7kNvwEXGC9L&_nc_oc=AdpWbz6PWZe2WRQSy99qWIrhH2Pw3tNQ678e56zosCcgx1c3XcZb_AuTcpli1-nPl1Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KLOfnFfOHkBZhqJ8eYv_cnZQ9glByz5EuIygPFNHT5A&oe=69E0F57A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJBaU_scEUQQ7kNvwEa7cWW&_nc_oc=AdrYRYqZtZdWeVlImdfoeqT931Ru2ZWwuzHIjxVtCo-wBMcF1xJR_l_TxKc4bXqa--U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1741CEo5TvoTCGvezYuE0nGBC7pqZLigO3oNRz7-DWDQ&oe=69E0FDA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btdM2QKygLgQ7kNvwFsL2HC&_nc_oc=AdppyigfPa8UOvntY7WxJJ-VxwhQBmdH2zKlJ5iacL-K6uwoK1A5woQYdqit0nPSkY4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0q5p3xDem5M_h-oAbnjw7cWRnMoaVFew_52S3Pd29Axg&oe=69E0CCA8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
v/t64.5771-25/75395596_1032122854992350_6158185522429019667_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPp7A8hstIsQ7kNvwGW5fAc&_nc_oc=AdoH_4Mbro_hbEQjfeA_S-xHgzaglyhplJ6ELN_gD9helxlGTIab3qS9peGJaj2tgSM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfVIrW59Z_2lcxTdHoLDAxlT-qrOMEp_GNBtbyRDldkg&oe=69CD185E"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqLvUQXrew0Q7kNvwGiiTcp&_nc_oc=Adobqr1qMj6DQ6XLxCHGSrHG5JmDlPJH7xaJ4i6bGi-ajoaPgnyUaO0m0bx0qaBo8ww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3TUBI61mbHG-jrIuKKQC6K56lbanB6UA3-IOR5Ghu-g&oe=69CD0340"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9Y3gnyw-LAQ7kNvwHDuB3k&_nc_oc=Adq8qdxxcBhokbiZ6PZPlxEKqIA9f6OvNtX-b7PJxcmQ2xuOjjoBZCuddDXxYpBhWnA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2aU8HdX-56gwarQ4sGEfSohuMmAC71vAsdRp-f2EUSg&oe=69CD2EFA"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y75EV2FvYs0Q7kNvwGyhbNw&_nc_oc=Adp3G-y15cGpKiTQUday6Pv63EQJulrfWu83D-PvK-pUnJMCtz7JOigjXGkfKc040ig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZbwlwfub1cmRekTa9fB0jbk9yrFuKY5oaYIwTwsvc6A&oe=69CCFEE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBLAlN6bgdMQ7kNvwFRaprJ&_nc_oc=AdqLPQD9BCY10hH4r_bd0b_KmUFvQdIwdAFMbrWnBHhSM_tdIYw3fX6ilhpsvNoxRF0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwc8cFCuLBHjd0M5f4-Bf3Tc8DqNDaZUMMn3p0CFMOs8A&oe=69CD0628"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "
-sin6-3.oculuscdn.com/v/t64.5771-25/75395596_1032122854992350_6158185522429019667_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8jRzogmIuAQ7kNvwFGv53m&_nc_oc=AdrbqkkYFzoCuh2Lsht0RWj307lzzRyA8GCGvDAgm_-AyoLe9I1xBLp3F8rgOtLz8YA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICeLFijmkQGf804y2VLDtKZgCyPM6s2NAGlwcoygLW_Q&oe=6AA942DE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNZcKmMzrBwQ7kNvwHT4SnD&_nc_oc=Adp33XEIbnpgimk-ky8kPdzbEtqClHmV5jWuTBY5eXecw4NF1ymQnMIK5w9zFU-4GG8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-aacef6-VKzIAOv-snvGC8NLBY2H-p40hPxsfCMoF1g&oe=6AA96600"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iKgNCxAs-YQ7kNvwGW6ILb&_nc_oc=AdrIF_e6Wdq2Ea8ZHvlVXc3XdBytU7UQjeMS_wsWMWJWR0GUI51azyhQJs8OuO8RSss&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKquTfFzTGMXv9qWDThTziJGlbT9OlvIWBaU4DG0XItig&oe=6AA9597A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEnP-c7MKkwQ7kNvwHD4O-5&_nc_oc=AdqCe3T-ssS5bbPGq4g-DTmVYnzj2fKhgOkypbxdB3NkEYgjFInSlbygq_TcVJ-UIFQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuO0GP612-POzUnFBmLZLwJbUaVOfO1otptyikIxVvqA&oe=6AA961A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSmIMPbfkIAQ7kNvwGg0263&_nc_oc=AdoQiiWSSsbzu8cEeQX45p5CoipXXFlDISNA47K54oAxS3gQ6n8Fn3_03Z3JkVyGwA8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPc4h_C4lDJ-hGiqrv33_TLvPbUSO1Es2m5NYmGh1kZQ&oe=6AA968E8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "develope
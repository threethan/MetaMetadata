png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sg8MbNkIcl4Q7kNvwE36iMQ&_nc_oc=Adr1LJGECgbueQAilQ14ebWxms5NO0wMd90K_949A74wSsau1V2Iiop1uJdhDRlL08I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaVqGKuT9xjvcWM0nb9BQjMR0MKxOm3ktENTqBHK4wnA&oe=6A81B5DE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkZ_9Ua0OWQQ7kNvwGV4SVp&_nc_oc=AdqOs-Omx4VM8aMUyXc3p2y1UZfYPcRm5gD4QaZgpmTFhUX2HEWMY6V-1enaLa_I0BA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPNQtkaeyPJNowVDM_SLgUqVi2nBgJJFqXCxcizc76iw&oe=6A81A0C0"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfV5VnjmyhcQ7kNvwH2jdZz&_nc_oc=AdrhVf7QHe2pwZeqn_UYPl-3STe4Tg0sgzfUGNTO7BaLX3-3WOK2GEEnMDHNgp9sYVI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXM0p5IJ1vfzRNdKFB9kwcjVwqwirJWJWbfyW7YicSQQ&oe=6A81943A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mn3IXFNUxYQ7kNvwGzs1hU&_nc_oc=AdpWji2PS7kvzXVToZEWaqErJ8aw_C9T_XZvF0nKagcVHVkUzI9JE2wXW1QTLAdA25I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmoqJZ1ovvhqfDm1EAdKOP0aGmD-BVKX2mWBesPZV37Q&oe=6A819C69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um4pIRVLTaEQ7kNvwG_Z5iA&_nc_oc=AdpvSR94QLjYOBguaoDwNG70_4x4ObWAJuU8KngG2_9JLxyFuLJEx8_YwSs-QQIQDJA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfoqs2zyJufeVPErKoHAzy5u0QBmfibnevOLRCZO2OPQ&oe=6A81A3A8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
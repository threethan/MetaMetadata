png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whC3ctX8nQsQ7kNvwGeKZfK&_nc_oc=AdqdnMmZYPQ3iWCMiZt8xK57mtAYH-inKIANfHagCcn6VkhjIDC8zyy8KI0pn1KU_fI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFU6SsKI4It_Qs_thUfVSBh-i8I5GwFLAHCY4AYstdCyA&oe=6A8C41DE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7fG4wWg9s4Q7kNvwENytuq&_nc_oc=AdqmSF8_KtD_QbGn0h4aZlFOYKj9XePiTg7fZr0LssPCnf4yPXsXZkEBt4w68jH12kc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuadyiYyGMMbq9mD32LfaEZM2IOddCGtgQUmD5245Ipg&oe=6A8C2CC0"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwteW3IksjQQ7kNvwE-LOgK&_nc_oc=AdoInBS49bVQtku9KqNIdXPlNUucuvW4LxKegq7MmP4F7lTfXAYgflxJIqqUTNU9_zI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2EzXNsJuggFS6BycKUUsujzn0w6Y6K9vpO95MRKykkA&oe=6A8C203A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqpFJbLg1v8Q7kNvwEpD_hn&_nc_oc=Ado-rfzFfitMO4p9yk6vqFcn_zOtv9kew9mI8qJ0iulb7Kw4bPPHRvFV6p9FOv8i2mo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrPbOJD7OnoeBPj1AYqWmeu4dcRtyu1SVlUpuyLsJkYg&oe=6A8C2869"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2MRePeaqM8Q7kNvwHtXOzg&_nc_oc=Adqdex8dRHTk4CXtpQ4-9nXKk2tPy4MZcLuZiz8W8P0NlKj-mhBj2gqudAHS-0GwvPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhhnGMD0-WbbJoY3DhzCAwEh8hmWrf3TnNjfsEfx0P4w&oe=6A8C2FA8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
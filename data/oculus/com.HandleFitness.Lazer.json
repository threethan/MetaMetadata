_tk01QOfdzBI9TuefuY5jJR4WpXlJS0vQadzzLDN4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuIYIKI0DmtSlWJF03tA6b-ImgGQgRUfWWUVCOSFlKRXA&oe=69A439DE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YEJWLAl3HYQ7kNvwEJVKX3&_nc_oc=AdnhlrFM7JRWjr3Z3kW_vLyA4lXX-c_0426iSwA7OYEOxkEpO88GGQh-2jYbpUJKy7I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs0j_eudWOZpHFQIdq4IrAHjrEJr9f7lLm3MuP4cO3ZJQ&oe=69A424C0"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=423ZUczA4kIQ7kNvwGH8Zdx&_nc_oc=AdkFMIuzxzCZGuq9c21ctwFIWBaePxW2tDFwZO2rzPps-nO-etRjaeUOk2TP9JfSaXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv1-HPvhUC2XBSYbbi4Gc0klSmTxNUaQJEh22bXQRXSFw&oe=69A4507A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_-M1OIjK5EQ7kNvwG8FeDb&_nc_oc=AdkYtiThnELsS65-p3JMGINGgo7nLA5hvVHeTF2OVZsN4WXPgTWY6gJduP5VZfxawyU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuh6i0vJfH_a6gqFpGnkJXUeLQUAOQeZFh_uWxKPEjHfA&oe=69A42069"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tdp_gKNNQ7gQ7kNvwGSNENV&_nc_oc=AdmwKg-0Qs8Wfb-4NuH2A8PiQBrxL1cYQZAfNb1EYlRpRT2sR_QjSXIXL4t7d-_DO7s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs3WMpU04dixLt-tSxMGvKaeTbGnEnpV--I-RM-sWUeUw&oe=69A427A8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_service_url": null, "publisher_name": "RCM Productions, Inc.", "support_website_url": null, "website_url": "https://www.handlefitness.com/", "category": null, "comfort_rating"
png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCpZ4uwIxvIQ7kNvwEVD1AM&_nc_oc=AdrPnSDG_klgBHZK_224xh0DPXFXujFmaJyPuTCKGWtxDrl9dSxARRyav2RIIfILyjI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JJ53WVLSqIhB-qKFX7Is9ela4FzxTOyZk3FoUmZfaqg&oe=6A256CDE"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uma3buEqNoIQ7kNvwFT60b8&_nc_oc=AdpDfueaX19GDyIxUHl57lyJAeZttXuP8wq-QM4U7isx3rE4v70_W6Hb5A6LmVR2cMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BGGAfLXjponcWkDHh-H85E4z5C9Q9tvm_rc18Tqq6BA&oe=6A259000"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8VoTAhlkkAQ7kNvwFoWKcN&_nc_oc=AdrEScamurs-ipjzcdHSLjbUheNYMDPghxKblWmoxX5JYFJepohYfYOFt4yNE52tVRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7px5vMaBAMntmebkduM1uhyhfC0Jg1yWAcT3sqwTN5Q&oe=6A25837A"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AxwpDhazCMQ7kNvwGeX5Gc&_nc_oc=Adrv2tt8sAW_4lCqdZw40hF5O3GAPSFj_zmqPydEm-dm3GZJtE9Rz5gR_nFtOF4MnhA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Lh3iCOxqR6iagxOyXOibbtNLdr_g4XKsVmWj928xyqg&oe=6A258BA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJzmOnkbqiQQ7kNvwHQhDU6&_nc_oc=AdpfI0tE1-_O-G8ZbBd8-eedG-Dt42keu7Um65X5vdP2pSO8wN-Z73IGSlyXEE-UoUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OBLjKYOCbWQI_X3wde2X1mwkyCmo5PSh72g5Bdrf6ew&oe=6A2592E8"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSJ7bnPOl08Q7kNvwGfgNrn&_nc_oc=Adr46tYAkxf_4UpAtH1IxsKEq2LsWyEUUVFj-Nu-VWn1_WgrTuPrKMMrRxa9K3Iuy10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcJIARfubA-98gaDjTS9Ht638atIyB1uCyjbd8FcNoKQ&oe=6A98579E"}, {"file_name": "QV18.png", "id": "404089165425433", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_404089168758766_5668102773186771359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xf7bIkL7xXEQ7kNvwFqgoWI&_nc_oc=Ado2xEfUrk1PRA6j1bLthqA5JLS5y596-OmzFdDFWNqKOcffuu2BwO9CTpmD4_PwQyw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzvqFWXk096ISryAy9Gx5a4saDvmFnWUiTGxnSzwtlkQ&oe=6A984280"}, {"file_name": "QV21.png", "id": "358796310243974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974839_358796313577307_1078093856614774465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKrsCqQpkzUQ7kNvwFQKACB&_nc_oc=AdqlqnIrM7JAJI3Sr58qjqSnjgKPfXszrTEouOz-e2-9nsKvyFRfJF6DQbhxHHqTe-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvwIVUY-clgxyRdN9V_P6KuI28BqIfllxQhW6aKucrQQ&oe=6A9835FA"}, {"file_name": "QV23.png", "id": "1369311100612527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982711_1369311103945860_6418632790113140240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tQaLGacMX4Q7kNvwGR89FV&_nc_oc=AdqyDMcwWYgQ711G9uN2Fmfb_OX7GICPqeMxMLghdc5rIjEs-OLSYY65DoGq6gvDCRU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa4Q-P86h1V4USXj4Wa6GIqcl48srpIE3w_KPbsZBJtA&oe=6A983E29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QV20.png", "id": "1737572213432603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395422_1737572216765936_1643452896872951574_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oj32AksP3-kQ7kNvwEklb93&_nc_oc=Adr_JnRen5sACR3uivb87NKALch8CFBCFakNCkY9Z6DaF4PaUIVzU5c0njusD1jPwAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFG_7iDAaIjHMcnD8ToVRXxiy3NvhLbZeIT6zHQ1N8dw&oe=6A984568"}, "display_name": "Qourt Vision XR - Basketball Training (*DEMO*)", "keywords": [], "long_description": "Requiring a real basketball to play, Qourt Vision XR is a first-of-its-kind mixed reality training tool specifically engineered for basketball players looking to improve their ability to make spilt-second decisions. Enhance your cognitive skills like never before by mastering offensive principles such as: attacking the top foot, assessing a closeout, splitting-the-screen, rolling off the inside shoulder, knowing when to euro step, and much more. Get the mental and physical reps needed to build true self-confidence while immersing yourself in the future of film study and player-development.\ud83d\udcc8\n\nSEE QUICK and REACT FAST with interactive drills focused on\ud83d\udcaa: \n\no\tChange-Of-Pace\no\tChange-Of-Direction\no\tFootwork\no\tBalance\no\tFluidity\no\tRhythm\no\tHand/ Eye Coordination\no\tAgility\no\tStrength and Conditioning\no\tCreating Space/ Separation\n\nMAKE YOUR MIND SWEAT with signature exercises designed for\ud83e\udde0:\n\no\tDecision-Making\no\tReaction Time\no\tPattern Recognition\no\tAttention Shifting\no\tMulti-Tasking\no\tAnticipation\no\tInhibition\no\tVisual Processing\no\tProblem-Solving\no\tProprioception\n\nSay goodbye to plastic cones, chairs, and trashcans.\ud83d\udeab\n\nREAL WORKOUTS. UNREAL DECISIONS.\ud83c\udfc0\ud83c\udfc6 #QourtVisionXR", "short_description": "Requiring a real ball to play, Qourt Vision XR trains cognitive skills such as decision making, reaction time, anticipation, hand/ eye coordination, pattern recognition, and more through hundreds of real in-game simulations for the ultimate interactive basketball workout. Download demo to try for FREE! Visit https://www.handlefitness.com to subscribe and experience all features: $0/mo."}]}, "developer_name": "Handle Fitness", "developer_privacy_policy_url": "https://www.handlefitness.com/faq", "developer_terms_of_servic
264403088_7339237598908858509_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-ePIYWoYoAQ7kNvwHqk9Nk&_nc_oc=AdpBT119Hm43uYSv6lqgA4wed1ZJ-ERLtFb4nwgiRfe4AWLIoQ25Ige9HgFIAnJ0Tg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwouLTshVGFf_-xyvfrjEcjt7ka7gu3e_oSCNJSJfrTg&oe=6ABBDBA2"}, {"file_name": "Screenshot 3.png", "id": "1774577097015439", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313390_1774577100348772_8481246353591519427_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4DooNE88IoQ7kNvwFmMqGe&_nc_oc=AdqNUYvfZxgVOA2PGtFwJTxdSYGb3guRxYMf0BTU_iHXnHpKqjGwTzvEPj0aCAv-o4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBVb3mezQcQQqzQMiZZKh888SsEcIUSqM66aWAdCSB5Q&oe=6ABBD7CB"}, {"file_name": "Screenshot 6.png", "id": "1768234281186479", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313063_1768234284519812_802832628426603278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_p8HIcHui4AQ7kNvwFtV2w-&_nc_oc=AdoJNfR_ATStxRe-vkWUApSs663ylVd4lJSiLvVhbSGwmk32mcUXOK_V_5Dzb3dqPZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKStaU-aSAWhhI4drvcvrewT9JAfdidLsjH3HF10YtaLQ&oe=6ABBBCD8"}, {"file_name": "Screenshot 5.png", "id": "1571077134415223", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507833663_1571077141081889_6068624832867016104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqVl_0ED2QcQ7kNvwH0oCFF&_nc_oc=AdovvOw36C8P3yGzuhpOzWqw-7F6ZvK5zMvvD8eoOHfqW_8z58nIsEsALQV2MvFKe4c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJonKTAsqwMYdQoJyujCfn5BgBWeJa-Hooga_6_v-VB_A&oe=6ABBB03E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "3030713383799328", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307962_3030713387132661_6690902262409725082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzJ4qJlzGrkQ7kNvwEUgUyZ&_nc_oc=AdpoWTvFvSJKPr2KL2rOoAaRAgrV8ncRsSK6fIPgiTjnJpCwf5HPUNKq0kd7fFZzHC8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyFejrtR2RAJ4ZdVXcIFcI-oeUHfhHZM9ZHesR7_J8Mw&oe=6ABBE2BE"}, "display_name": "Viscer Nursing II", "keywords": ["Nursing", "Simulation", "Medical", "Training", "Education"], "long_description": "VisceR Nursing II is an immersive VR clinical training experience designed for nursing students and healthcare learners. The pack focuses on pediatric care and essential clinical skills, allowing learners to practice procedures in a safe, repeatable, risk-free virtual environment.\n\nPAEDIATRIC CARE\n\u2022 IV Cannulation\n\u2022 Nebulization Setup\n\u2022 IM Injection Administration\n\u2022 Fever Management\n\u2022 Oral Rehydration Therapy\n\u2022 Oral Medication Administration\n\nCLINICAL ASSESSMENT & PROCEDURES\n\u2022 Nasal Swab Collection\n\u2022 Visual Acuity\n\u2022 Otoscopy \u2013 Middle Ear Infection (Pediatric)\n\u2022 Eye Irrigation\n\u2022 Eye Epilation\n\nThrough interactive VR simulations, learners can understand clinical procedures, follow appropriate steps, practice techniques, identify mistakes, and build confidence through repeated practice. The immersive environment complements classroom teaching, demonstrations, and conventional skills-lab training while providing learners with an opportunity to rehearse procedures without risk to patients.\n\nVisceR Nursing II is part of the wider VisceR healthcare education ecosystem. Additional VisceR packs cover other nursing departments, clinical skills, medical specialties, procedures, diagnostics, and other areas of healthcare education.", "short_description": "VisceR Nursing II is an immersive VR clinical training experience for nursing students and healthcare learners. Practice essential pediatric and clinical procedures in a safe, repeatable virtual environment, including IV cannulation, nebulization, injections, fever management, oral rehydration, medication administration, nasal swab collection, visual acuity, otoscopy, eye irrigation, and eye epilation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.viscer.co/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Simutomy Medtech Pvt Ltd", "support_website_url": "https://www.viscer.co/contact", "website_url": "https://www.viscer.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "973810209015528"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1713398336598621"}]}, "baseline_offer": {"id": "1713398336598621"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787802120, "status": "PUBLISHED", "id": "1713398336598621"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "979983205064895", "version": "0.2"}, "id": "4475082639439613", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "973810202348862", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "979983205064895"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4475082639439613"}]}, "change_log": null, "created_date": 1
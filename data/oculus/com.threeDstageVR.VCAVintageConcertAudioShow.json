": [{"file_name": "s1.png", "id": "2368143493373413", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003286_2368143496706746_6589332102280301367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsjNvbp9rboQ7kNvwGMhdHh&_nc_oc=AdncaBAuvJWsco73LzBldmRe8zIIBOfWtXazUvuvStrU7XjmX5hFQV_Wn5DlRO75jIk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft1GNETXPPXgNJLU3YGgWqNNUm2-G8ygrPCqYUhfQ8vPg&oe=69A56878"}, {"file_name": "s2.png", "id": "7079097928795280", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982575_7079097932128613_87597934111187752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6G4bQai830Q7kNvwG-woPa&_nc_oc=AdnGQNLnasgF8SjZpXxlMbSooKPE-pT2QcIzJWf6NDbp5Q97FvoZOg286R2PqPUcUsQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftVpPBeiaC6PYmMP3oOBp9OuQ8muhHZJzIECKOqx6dPKA&oe=69A5753D"}, {"file_name": "s3.png", "id": "1645981585805365", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75584096_1645981589138698_3259940896657179453_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfyZKd5-qUgQ7kNvwEkBm37&_nc_oc=AdkiqjmLs0BnFsqE7u1NkKJUnmcmCvK67ZiQrP1zdfR4WuVuzJTLoTNA8p8uYQVlPc8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsC8TxNGaVQsau-czBmMPb_MJDmf4N3ac7zhwFcHLyPhA&oe=69A5731B"}, {"file_name": "s4.png", "id": "732192048966039", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031319_732192052299372_947026777290158835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9HfrT0LPdAQ7kNvwGD6dui&_nc_oc=AdkRnWQE73qrCS8ts4nCv42OR2hi1JyYkfbie8x6oCy7IJ_BELNxwxJl0a7gH6mA8BY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv0fiFQ_yCBNIHmbYaHZsONXRTinxPE52jLiWwt1D5a6Q&oe=69A592AC"}, {"file_name": "s5.png", "id": "344094808358483", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75223483_344094811691816_1615298068040978840_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWcULc46Xb8Q7kNvwF5_ZNC&_nc_oc=AdnJfwvswkO6ikGpt0zZOORY6bXEYiEWNset5W1EkB4d32s1K73q1mXRP3rqkM6gpa0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftagQGubtpI5gcS2BewA48kdcAnpzaUPzHyn_1xjyEOtQ&oe=69A57D98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VCA Vintage Concert Audio Show", "keywords": [], "long_description": "Vintage Concert Audio Show offers a unique virtual journey through the history of live concert sound technology. As a VR user, you get the chance to accompany Marcus through the development of audio tech from the simplest vocal systems to the complex digital consoles and line-array systems that revolutionized the live production world by the end of 2003.\n\nDiscover:\n- **Technological Milestones**: Explore the evolution of audio technology across four decades.\n- **Interactive Learning Moments**: Gain insights into how concert sound was created and refined.\n- **Personal Guidance**: Be led through the exhibition by Marcus and the experienced VCA President Wolfgang \"Schabbach\" Neumann.\n\nThe Vintage Concert Audio Show is more than just an exhibition \u2013 it's a time travel that brings the evolution of sound technology to life. Perfect for anyone interested in music, technology, and the history of audio production. Join Marcus and experience how concert sound was shaped over the decades.\n\n    #VintageConcertAudio\n    #VRMusicExperience\n    #AudioTechHistory\n    #ConcertSoundEvolution\n    #VintageAudioTech\n    #MusicTechJourney\n    #HistoricalAudio    \n    #MusicHistory\n    #AudioTechnology\n    #LiveMusicVR\n    #SoundEngineering\n    #RetroTechVR\n    #MusicTech\n    #VCA\n", "short_description": "Join Marcus in the Vintage Concert Audio Show and dive into the fascinating evolution of concert sound technology from the 1960s to the end of 2003 \u2013 from the earliest Sound  systems to revolutionary digital consoles and line-array systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/vca-vintage-concert-audio-show", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://www.vrtravelx.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7615952231767287"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1892187038841235"}, {"status": "PUBLISHED", "id": "845667678304328"}, {"status": "PUBLISHED", "id": "889500316932765"}, {"status": "PUBLISHED", "id": "718193437957249"}, {"status": "PUBLISHED", "id": "1237176561516477"}, {"status": "PUBLISHED", "id": "1690568548231755"}, {"status": "PUBLISHED", "id": "1637622764296393"}, {"status": "PUBLISHED", "id": "622391617216486"}, {"status": "PUBLISHED", "id": "1102501474649730"}, {"status": "PUBLISHED", "id": "24606911072257105"}]}, "baseline_offer": {"id": "24606911072257105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1892187038841235"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9912087828820371", "version": "1.6"}, "id": "779805110828716", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7615952225100621", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9912087828820371"}, 
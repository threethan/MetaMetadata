=69B40923"}]}, "id": "1103490320827716", "locale": "en_US", "screenshots": [{"file_name": "s1.png", "id": "2368143493373413", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003286_2368143496706746_6589332102280301367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hT7-jZ1We7gQ7kNvwFeecrO&_nc_oc=Adl6E1dgaM9FanJRYWSyEICPo8q2HoOuszOq24sxCzNBn1TZ67i8VFosbx7l6YCNAFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwO_aV4yrKyx_oveqj0aJahJL2BVqWSRK87AIlKyaT6Kg&oe=69B42138"}, {"file_name": "s2.png", "id": "7079097928795280", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982575_7079097932128613_87597934111187752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ystkqOtfku4Q7kNvwGyL9mV&_nc_oc=AdlSTD4uLCG2Z6CIKxj_eCswAm4Qkhn76eehZTUByTJK-IU_bjy_tz6lo1dvQpU2Z6o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxVebHjP2JVMPHFJgi2wcrYYfun9PGMMLFyu_HZRU1DEQ&oe=69B3F5BD"}, {"file_name": "s3.png", "id": "1645981585805365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75584096_1645981589138698_3259940896657179453_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtPxswCWruEQ7kNvwGxtMbk&_nc_oc=AdnXZtmsrFEsZqa1Qam_9ZnvXtZElh3FCS4mwAsTOiejT6gdYtMR-7bKjsMdHsGq2r8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx2I43wTtKHwdPAnWouUxW9pvG5tH2_cLLkdBfZVBLsPw&oe=69B3F39B"}, {"file_name": "s4.png", "id": "732192048966039", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031319_732192052299372_947026777290158835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70PSI2Mts74Q7kNvwHlFUWt&_nc_oc=AdlNRXVDPwb6I8PYCZVFVC_MFqbnqQECSbHAHx6xZYLLCs-kpRZglfNpzoP_Ql9VdiM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBYGCMmnTeag_nhrYVAuAOvA-5-CBtqcBxrhcmdmTAWg&oe=69B4132C"}, {"file_name": "s5.png", "id": "344094808358483", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_344094811691816_1615298068040978840_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ML6Q7fXsiHcQ7kNvwFBiQ_7&_nc_oc=Adk6b23_8K8BtngYT8RNC_qetx97t9bVe9oltj5j3AMM6evcYsbypCfzEv53xGb4wAU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8qfB1qSKp5bCh4GdYa7eb9p4fSgkMGo5z_ix9vzeefQ&oe=69B3FE18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VCA Vintage Concert Audio Show", "keywords": [], "long_description": "Vintage Concert Audio Show offers a unique virtual journey through the history of live concert sound technology. As a VR user, you get the chance to accompany Marcus through the development of audio tech from the simplest vocal systems to the complex digital consoles and line-array systems that revolutionized the live production world by the end of 2003.\n\nDiscover:\n- **Technological Milestones**: Explore the evolution of audio technology across four decades.\n- **Interactive Learning Moments**: Gain insights into how concert sound was created and refined.\n- **Personal Guidance**: Be led through the exhibition by Marcus and the experienced VCA President Wolfgang \"Schabbach\" Neumann.\n\nThe Vintage Concert Audio Show is more than just an exhibition \u2013 it's a time travel that brings the evolution of sound technology to life. Perfect for anyone interested in music, technology, and the history of audio production. Join Marcus and experience how concert sound was shaped over the decades.\n\n    #VintageConcertAudio\n    #VRMusicExperience\n    #AudioTechHistory\n    #ConcertSoundEvolution\n    #VintageAudioTech\n    #MusicTechJourney\n    #HistoricalAudio    \n    #MusicHistory\n    #AudioTechnology\n    #LiveMusicVR\n    #SoundEngineering\n    #RetroTechVR\n    #MusicTech\n    #VCA\n", "short_description": "Join Marcus in the Vintage Concert Audio Show and dive into the fascinating evolution of concert sound technology from the 1960s to the end of 2003 \u2013 from the earliest Sound  systems to revolutionary digital consoles and line-array systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ww
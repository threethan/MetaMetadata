=69B94F23"}]}, "id": "1103490320827716", "locale": "en_US", "screenshots": [{"file_name": "s1.png", "id": "2368143493373413", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003286_2368143496706746_6589332102280301367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Eu0c1qNav4Q7kNvwHYHUOj&_nc_oc=AdlZvcunXB-d2vzAki-FCAnvlzDVSK2FkircW-IJbPxdUTQF1UfftBqkHj3l_lK7few&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxpO59hzUJObEgsQ18uBqyccWj_BGT0PVxbqekDY4_xUQ&oe=69B92EF8"}, {"file_name": "s2.png", "id": "7079097928795280", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982575_7079097932128613_87597934111187752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuJh6c5ZGjAQ7kNvwHaaxat&_nc_oc=AdnFjdBEFbx6DDFIU2oJZL_h2ZRJWqJFgKNErZ9-K5s0a688_I06XX2LwXVpr6x4hhw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyYM77kkBkqRYNJXMCli1xJ3jniouqwJYEl1Jp0Zurr8g&oe=69B93BBD"}, {"file_name": "s3.png", "id": "1645981585805365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75584096_1645981589138698_3259940896657179453_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeWhUlixvZUQ7kNvwGIt_fw&_nc_oc=AdmLCSEOlrZXjCTn1yd1VxHA-2fJ13DVUqRgVPeHALXMX-IcN1WAVqjg1WGZyjeMVP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzWy5t_ipLIN62-2N7ArD98GHaRgngD5UBRdPMLYwpsMA&oe=69B9399B"}, {"file_name": "s4.png", "id": "732192048966039", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031319_732192052299372_947026777290158835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jN3ro8robAUQ7kNvwFyzknA&_nc_oc=Adnd7S1OVs730IomjiPNuvNyjTYOE5Pk3IxXEPlCc5T3Eb0b3Ao3xd2rhlDoyDY11ao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1VpaWvMRPFQeLXaf4l_BDHPsTZ17c2cDDNYD3LcvF5g&oe=69B9592C"}, {"file_name": "s5.png", "id": "344094808358483", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_344094811691816_1615298068040978840_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnaLcdmqd5oQ7kNvwF0LaG0&_nc_oc=AdlMGoGqeOYgBFgGWmSMZbmHrvX-L0-nv18aYsLZNCYu1Q-H0h1QrpYr-8UUC3BeqX8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKKEhaoq5YQlyXZAEeR7Kp5qgYqm9gN8oigZQ3YXWA3A&oe=69B94418"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VCA Vintage Concert Audio Show", "keywords": [], "long_description": "Vintage Concert Audio Show offers a unique virtual journey through the history of live concert sound technology. As a VR user, you get the chance to accompany Marcus through the development of audio tech from the simplest vocal systems to the complex digital consoles and line-array systems that revolutionized the live production world by the end of 2003.\n\nDiscover:\n- **Technological Milestones**: Explore the evolution of audio technology across four decades.\n- **Interactive Learning Moments**: Gain insights into how concert sound was created and refined.\n- **Personal Guidance**: Be led through the exhibition by Marcus and the experienced VCA President Wolfgang \"Schabbach\" Neumann.\n\nThe Vintage Concert Audio Show is more than just an exhibition \u2013 it's a time travel that brings the evolution of sound technology to life. Perfect for anyone interested in music, technology, and the history of audio production. Join Marcus and experience how concert sound was shaped over the decades.\n\n    #VintageConcertAudio\n    #VRMusicExperience\n    #AudioTechHistory\n    #ConcertSoundEvolution\n    #VintageAudioTech\n    #MusicTechJourney\n    #HistoricalAudio    \n    #MusicHistory\n    #AudioTechnology\n    #LiveMusicVR\n    #SoundEngineering\n    #RetroTechVR\n    #MusicTech\n    #VCA\n", "short_description": "Join Marcus in the Vintage Concert Audio Show and dive into the fascinating evolution of concert sound technology from the 1960s to the end of 2003 \u2013 from the earliest Sound  systems to revolutionary digital consoles and line-array systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ww
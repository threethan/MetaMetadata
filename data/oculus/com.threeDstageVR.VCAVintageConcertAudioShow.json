7e8Kt3EKYpxVqMLBn7ZZdDFbZlONfaEXEtieYz3ttyB59BJl2K6_cbg3PqOw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXK3wpsNOz_81Mw_ZvV56fLDhzanarSMTQQ_nD053qqA&oe=6B01B75B"}, {"file_name": "s4.png", "id": "732192048966039", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031319_732192052299372_947026777290158835_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLzCG7KXSOcQ7kNvwH6R2po&_nc_oc=Adr_dXYuQ8Imtt6o2NWZ62WgH0lFATGhXu0PLrsGr5dFzSBHjFLb8K06iW6cNAxKMOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOmNBmv9efSHBMjxj0RWsfldLaY5Fa_9XKKHuQAIM5bg&oe=6B01D6EC"}, {"file_name": "s5.png", "id": "344094808358483", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_344094811691816_1615298068040978840_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xao8OEd4VhkQ7kNvwE_EOyD&_nc_oc=AdpFk2Wy3Sv_x0PvEbAX7P_0FQAB-tlx1bH8qQ4RIRuO38AcQnmFsSnooTk6_H4wYHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLHK78zI2nhM956TUzMt5yibbax4CTe2qnNEqzQfD32g&oe=6B01C1D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VCA Vintage Concert Audio Show", "keywords": [], "long_description": "Vintage Concert Audio Show offers a unique virtual journey through the history of live concert sound technology. As a VR user, you get the chance to accompany Marcus through the development of audio tech from the simplest vocal systems to the complex digital consoles and line-array systems that revolutionized the live production world by the end of 2003.\n\nDiscover:\n- **Technological Milestones**: Explore the evolution of audio technology across four decades.\n- **Interactive Learning Moments**: Gain insights into how concert sound was created and refined.\n- **Personal Guidance**: Be led through the exhibition by Marcus and the experienced VCA President Wolfgang \"Schabbach\" Neumann.\n\nThe Vintage Concert Audio Show is more than just an exhibition \u2013 it's a time travel that brings the evolution of sound technology to life. Perfect for anyone interested in music, technology, and the history of audio production. Join Marcus and experience how concert sound was shaped over the decades.\n\n    #VintageConcertAudio\n    #VRMusicExperience\n    #AudioTechHistory\n    #ConcertSoundEvolution\n    #VintageAudioTech\n    #MusicTechJourney\n    #HistoricalAudio    \n    #MusicHistory\n    #AudioTechnology\n    #LiveMusicVR\n    #SoundEngineering\n    #RetroTechVR\n    #MusicTech\n    #VCA\n", "short_description": "Join Marcus in the Vintage Concert Audio Show and dive into the fascinating evolution of concert sound technology from the 1960s to the end of 2003 \u2013 from the earliest Sound  systems to revolutionary digital consoles and line-array systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/vca-vintage-concert-audio-show", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://www.vrtravelx.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7615952231767287"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1692526628408969"}, {"status": "PUBLISHED", "id": "1880731715892212"}, {"status": "PUBLISHED", "id": "1892187038841235"}, {"status": "PUBLISHED", "id": "845667678304328"}, {"st
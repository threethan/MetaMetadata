=69B014A3"}]}, "id": "1103490320827716", "locale": "en_US", "screenshots": [{"file_name": "s1.png", "id": "2368143493373413", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003286_2368143496706746_6589332102280301367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_bRbQDJqP0Q7kNvwEheK3h&_nc_oc=Adl7O_hkWCRotD1Uv7P0UNZbiPX9H4bOcmFZYVyJgFvkXTUfpOqtNOMrbrKAV2FQZRQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4p-v-BCxtvTMeP0piKdcPC97AwbfyqMr14a2DyYQl0w&oe=69AFF478"}, {"file_name": "s2.png", "id": "7079097928795280", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982575_7079097932128613_87597934111187752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQ5OIyjw6lAQ7kNvwHDCGb6&_nc_oc=Adk9HQHGbRU4luOue6_AtuqdEnekaURXzdc5rxcthVRNWXeUPj4kvyjErp4mcCn8xfs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJxPLviud35_QRjqLfcSE8wrofxtWEEN2YpW6mvBP7jw&oe=69B0013D"}, {"file_name": "s3.png", "id": "1645981585805365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75584096_1645981589138698_3259940896657179453_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7WI-wCdULAQ7kNvwGJPhnl&_nc_oc=AdnW7wQn8D_eS7gMLhjJBaIymYBFFVxaF6n-2aQpUe4Fre9fAXAuC0V4KyJzCnESH18&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTRzyZ0f2__phkOjifxnvEwhZyC42_YbX-Lm1UDOTwUg&oe=69AFFF1B"}, {"file_name": "s4.png", "id": "732192048966039", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031319_732192052299372_947026777290158835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuAyVhGy3MYQ7kNvwEp_wZY&_nc_oc=AdngThYbSm6S6XW78RhZQDvvtf2ngxmH3h8cXS01fcA3NOC4MXh-flcjgLQsdhKZs3c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0PJPpwtTo7r0wTUT-cgJwP3T4lCwRnHTPS0uX4pnhbA&oe=69B01EAC"}, {"file_name": "s5.png", "id": "344094808358483", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223483_344094811691816_1615298068040978840_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9Q3rXzlj4YQ7kNvwGirLbu&_nc_oc=AdklZuoQmJaKfUjTORwywZL6AUY_5dkhqhLJpHOX9qQnFBIcG_i-FbttF1HyDkb4GcQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxwa3YXgId4aoMAcuWjbVXqaac8hW9r7hAx-8Y7O5IieQ&oe=69B00998"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VCA Vintage Concert Audio Show", "keywords": [], "long_description": "Vintage Concert Audio Show offers a unique virtual journey through the history of live concert sound technology. As a VR user, you get the chance to accompany Marcus through the development of audio tech from the simplest vocal systems to the complex digital consoles and line-array systems that revolutionized the live production world by the end of 2003.\n\nDiscover:\n- **Technological Milestones**: Explore the evolution of audio technology across four decades.\n- **Interactive Learning Moments**: Gain insights into how concert sound was created and refined.\n- **Personal Guidance**: Be led through the exhibition by Marcus and the experienced VCA President Wolfgang \"Schabbach\" Neumann.\n\nThe Vintage Concert Audio Show is more than just an exhibition \u2013 it's a time travel that brings the evolution of sound technology to life. Perfect for anyone interested in music, technology, and the history of audio production. Join Marcus and experience how concert sound was shaped over the decades.\n\n    #VintageConcertAudio\n    #VRMusicExperience\n    #AudioTechHistory\n    #ConcertSoundEvolution\n    #VintageAudioTech\n    #MusicTechJourney\n    #HistoricalAudio    \n    #MusicHistory\n    #AudioTechnology\n    #LiveMusicVR\n    #SoundEngineering\n    #RetroTechVR\n    #MusicTech\n    #VCA\n", "short_description": "Join Marcus in the Vintage Concert Audio Show and dive into the fascinating evolution of concert sound technology from the 1960s to the end of 2003 \u2013 from the earliest Sound  systems to revolutionary digital consoles and line-array systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ww
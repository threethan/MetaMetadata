4_7726575252313442288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bJkKylNs60Q7kNvwGdxm3F&_nc_oc=AdoylzpWmWiGeza0J9fBacoKgKzTsPHA63vfMnvoo4eGu4I3XRpGMn7mOM_wsHSVjuM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZS4jbVwJLvtgj8kjC7HbNghw5Xkl321cqNc0vsBEWUw&oe=69CE6723"}]}, "id": "1103490320827716", "locale": "en_US", "screenshots": [{"file_name": "s1.png", "id": "2368143493373413", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003286_2368143496706746_6589332102280301367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_PazwpDetgQ7kNvwGI1R-p&_nc_oc=Adqr_oO6_K-N8IBLdssAVydpTSlBv33fYKU9B_cUnsqTm-uSlRZOm12x-yaIdkf4Qds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCB1GUbTtRpR62N4MjQ7q3PXfgi10izF1T1bdGZx1LHw&oe=69CE7F38"}, {"file_name": "s2.png", "id": "7079097928795280", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982575_7079097932128613_87597934111187752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1ZfSVCetxIQ7kNvwFGCmCx&_nc_oc=AdoPnG42qV5bq9AWaw3sYbd-MEBN2F-ZhVUvhkcjOQF6eTraQB-wUjmREyNKI8VCawQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxgjVtMvexoZ_rQVXXyAy6XkEycn5ABkQc4RyZiCV3ZA&oe=69CE53BD"}, {"file_name": "s3.png", "id": "1645981585805365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75584096_1645981589138698_3259940896657179453_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BK6Ly6yzT3QQ7kNvwHyEWoD&_nc_oc=AdoiBKCzYv4Xy9BRPSrB4-pAvhG3EpBFjR1Pws6Af3LPgLbDDDLI2kKK5AMAmAkthS8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPrj8MN9UdNrBfhapwP0xboZqFM3ospznz3m2KxmaTOA&oe=69CE519B"}, {"file_name": "s4.png", "id": "732192048966039", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031319_732192052299372_947026777290158835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrWnb6P1wIcQ7kNvwFFA1zn&_nc_oc=Adp2_YZeroMTnFOTDA6na5apNBPvHvr_6m6VwmuIO6u2zMHanVFbJeTb_wZ7ap-1IDk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAFrBsOOalZsLjk9Qna_sSSh5AedNB9DRg_AVD7R46Qg&oe=69CE712C"}, {"file_name": "s5.png", "id": "344094808358483", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_344094811691816_1615298068040978840_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kV_2p-CP1mEQ7kNvwH6KRPl&_nc_oc=AdrxyEO2CUkphr0tCUn3ri2imUkWwzKotCjFX3iSWIbKN1GMbZl3N7InWqaD_m3BUIk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwobKtiXD9SecX68NCFTWIxZGg4IXjASD0e2PkiE2UvbA&oe=69CE5C18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VCA Vintage Concert Audio Show", "keywords": [], "long_description": "Vintage Concert Audio Show offers a unique virtual journey through the history of live concert sound technology. As a VR user, you get the chance to accompany Marcus through the development of audio tech from the simplest vocal systems to the complex digital consoles and line-array systems that revolutionized the live production world by the end of 2003.\n\nDiscover:\n- **Technological Milestones**: Explore the evolution of audio technology across four decades.\n- **Interactive Learning Moments**: Gain insights into how concert sound was created and refined.\n- **Personal Guidance**: Be led through the exhibition by Marcus and the experienced VCA President Wolfgang \"Schabbach\" Neumann.\n\nThe Vintage Concert Audio Show is more than just an exhibition \u2013 it's a time travel that brings the evolution of sound technology to life. Perfect for anyone interested in music, technology, and the history of audio production. Join Marcus and experience how concert sound was shaped over the decades.\n\n    #VintageConcertAudio\n    #VRMusicExperience\n    #AudioTechHistory\n    #ConcertSoundEvolution\n    #VintageAudioTech\n    #MusicTechJourney\n    #HistoricalAudio    \n    #MusicHistory\n    #AudioTechnology\n    #LiveMusicVR\n    #SoundEngineering\n    #RetroTechVR\n    #MusicTech\n    #VCA\n", "short_description": "Join Marcus in the Vintage Concert Audio Show and dive into the fascinating evolution of concert sound technology from the 1960s to the end of 2003 \u2013 from the earliest Sound  systems to revolutionary digital consoles and line-array systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/vca-vintage-concert-audio-show", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://www.vrtravelx.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7615952231767287"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1880731715892212"}, {"status": "PUBLISHED", "id": "1892187038841235"}, {"status": "PUBLISHED", "id": "845667678304328"}, {"status": "PUBLISHED", "id": "889500316932765"}, {"status": "PUBLISHED", "id": "718193437957249"}, {"status": "PUBLISHED", "id": "1237176561516477"}, {"status": "PUBLISHED", "id": "1690568548231755"}, {"status": "PUBLISHED", "id": "1637622764296393"}, {"status": "PUBLISHED", "id": "622391617216486"}, {"status": "PUBLISHED", "id": "1102501474649730"}, {"status": "PUBLISHED", "id": "24606911072257105"}]}, "baseline_offer": {"id": "24606911072257105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "1880731715892212"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typena
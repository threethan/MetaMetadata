n.com/v/t64.5771-25/39031319_732192052299372_947026777290158835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmGZh_1kdiMQ7kNvwFubKGw&_nc_oc=AdokW0E8G-fWR2kATX_A_OiW_KhN2qTGap1TbPycaPvq045fnfoTqGavkXrzXCelotc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfEdSicZs7Krii1p6PmadsfLS4uRQ51w31YH9KO6fNtA&oe=6AA94A2C"}, {"file_name": "s5.png", "id": "344094808358483", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75223483_344094811691816_1615298068040978840_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAKkFJ5EQSAQ7kNvwHh1h9j&_nc_oc=AdrFzZjHy0hG0D01w5X2VJfGQPVd0f-6scumiFXYeVfBITROcNWeKSki0U0rOEPPZVw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5FNjxRuK72hiIdxKoVui8etaN6G9kDK9vlgABbaR7Qg&oe=6AA93518"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VCA Vintage Concert Audio Show", "keywords": [], "long_description": "Vintage Concert Audio Show offers a unique virtual journey through the history of live concert sound technology. As a VR user, you get the chance to accompany Marcus through the development of audio tech from the simplest vocal systems to the complex digital consoles and line-array systems that revolutionized the live production world by the end of 2003.\n\nDiscover:\n- **Technological Milestones**: Explore the evolution of audio technology across four decades.\n- **Interactive Learning Moments**: Gain insights into how concert sound was created and refined.\n- **Personal Guidance**: Be led through the exhibition by Marcus and the experienced VCA President Wolfgang \"Schabbach\" Neumann.\n\nThe Vintage Concert Audio Show is more than just an exhibition \u2013 it's a time travel that brings the evolution of sound technology to life. Perfect for anyone interested in music, technology, and the history of audio production. Join Marcus and experience how concert sound was shaped over the decades.\n\n    #VintageConcertAudio\n    #VRMusicExperience\n    #AudioTechHistory\n    #ConcertSoundEvolution\n    #VintageAudioTech\n    #MusicTechJourney\n    #HistoricalAudio    \n    #MusicHistory\n    #AudioTechnology\n    #LiveMusicVR\n    #SoundEngineering\n    #RetroTechVR\n    #MusicTech\n    #VCA\n", "short_description": "Join Marcus in the Vintage Concert Audio Show and dive into the fascinating evolution of concert sound technology from the 1960s to the end of 2003 \u2013 from the earliest Sound  systems to revolutionary digital consoles and line-array systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/vca-vintage-concert-audio-show", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://www.vrtravelx.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7615952231767287"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1692526628408969"}, {"status": "PUBLISHED", "id": "1880731715892212"}, {"status": "PUBLISHED", "id": "1892187038841235"}, {"status": "PUBLISHED", "id": "845667678304328"}, {"status": "PUBLISHED", "id": "889500316932765"}, {"status": "PUBLISHED", "id": "718193437957249"}, {"status": "PUBLISHED", "id": "1237176561516477"}, {"status": "PUBLISHED", "id": "1690568548231755"}, {"status": "PUBLISHED", "id": "1637622764296393"}, {"status": "PUBLISHED", "id": "622391617216486"}, {"status": "PUBLISHED", "id":
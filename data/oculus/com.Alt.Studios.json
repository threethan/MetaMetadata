lGy9cJcD44mQ&oe=69D4F636"}, {"file_name": "cac63a5db41c4e04a71b4714b11fee5a (1).png", "id": "766897326411909", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819982_766897329745242_910413575924671860_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZqmReV-ElEQ7kNvwF8rsdw&_nc_oc=AdohYbVJ7E-AhCFL-v_FjJHAkCXraeFhT8n9cWIhpbwOGN22nnIOHiDBaTUp5sLWjeM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0n5JPZBD7ZR824uUshkjSyOfgo5LoTtDx08m3IyM35mA&oe=69D50825"}, {"file_name": "be7a4aa75a444a7fb577209170d351ba (1).png", "id": "880586597727196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821674_880586601060529_6609551892226492095_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1_ZxqwOtl0Q7kNvwEXe3cm&_nc_oc=Adp548yT2Rn5NwPETy6W6UJFIKbewkNccH03LT4kTAhnzvQDAvVhtA3hdAhqb-MyCCI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1X38tqAggyimKkpPIZtLJ-uPaqnF9VFuK9FPlScOrpHw&oe=69D4FC2A"}, {"file_name": "dae134ed4e974373b810fc76f6ba9aa1 (1).png", "id": "885380914024777", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819281_885380917358110_8131266415746554177_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dS_P-uM_AQQ7kNvwGzrCSB&_nc_oc=AdonpkRpkeErwSInkX98_X7PHur36OrwOXDTZ6Z9jq1vmGAXaSomvVqqLGbGKFtQUE8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YHRKf7oJMg3FpsB_wntgpFN7tVviHycQ80AaEXaj2pA&oe=69D4E984"}, {"file_name": "d6078ab9b5a4498790bca752ec4ab8b1 (1).png", "id": "1191288699031885", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1191288702365218_249752815198295780_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSqp1sGY65IQ7kNvwGzD_kS&_nc_oc=AdpopwSSRRS6TmteGx1ZoRkpOqRBzHh3p1WMfr6j533mZLbxKHJE0lpZsmffrjJG2ak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32JqlXMeXmGDyrnKp5apLgnd-psliqBhz2v8og4pk2jQ&oe=69D5094B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape", "keywords": [], "long_description": "Lethal Ape is a multiplayer experience built around simple, fast-moving encounters that encourage brief moments of cooperation and quick shifts into competition. Players move through compact arenas, interact with a variety of tools, and adapt to unpredictable situations created by others in the match. The core appeal comes from its mix of light strategy and spontaneous chaos: you can work with other players when it makes sense, but the environment often pushes you to change plans and improvise.\n\nAs sessions progress, the game rewards observation, timing, and a willingness to take calculated risks. Each round tends to unfold differently depending on how participants act, which keeps the overall experience varied even after extended play. Whether players are forming short-term alliances, setting up clever traps, or reacting to sudden changes in the map, the rhythm stays lively without becoming overwhelming.\n\nOverall, it\u2019s a straightforward but engaging game that encourages social interaction, quick decisions, and a steady flow of small, memorable moments.", "short_description": "Lethal Ape is a very fun game where you will have fun with others."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalapeee/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bombaclaut", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalapeee/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
com/v/t64.5771-25/491819982_766897329745242_910413575924671860_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C677hCXMfewQ7kNvwGscrFU&_nc_oc=AdnzYou4l4NwLqGmdKtq_VK-JP1Voy8GHkG7PqLpGK9dhXeVAY3DYzU3jL95Lq2wM80&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw-Dfzzoegdi3H5ceOVW35rB6p012twUzbPH2SLoH7iXw&oe=69AC29A5"}, {"file_name": "be7a4aa75a444a7fb577209170d351ba (1).png", "id": "880586597727196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821674_880586601060529_6609551892226492095_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7oI6KxUk0AQ7kNvwGqnLPl&_nc_oc=Adln0tfIJJI-JvPFXB5LiXnlpT120YYsM_9v2aJXBN-V9tJUEiN5WPuWYdbWQSt38JU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwh6xA7V_sDDl3EXssFl3DXWXwBlWSv_OFhIOHWYIDNRA&oe=69AC1DAA"}, {"file_name": "dae134ed4e974373b810fc76f6ba9aa1 (1).png", "id": "885380914024777", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819281_885380917358110_8131266415746554177_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-foB9NifywQ7kNvwFd6Xm1&_nc_oc=Adk1CRX7e6OMm4YMOUR0mAQAWXPpCwRF-BMeBq_cGyT-Fw4nStky_h86UBK6rdlonQY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzm9lZ4Cbb7R5M5XRlQUmE_8lTqbEczRXJ3AQpn11oUmg&oe=69AC0B04"}, {"file_name": "d6078ab9b5a4498790bca752ec4ab8b1 (1).png", "id": "1191288699031885", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1191288702365218_249752815198295780_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8loE7_GgEsQ7kNvwEoxF5S&_nc_oc=AdnIbaXE3TgfdOmKtrWjkWCfmR1sebZZrLxWd58N6FKqRmIriZxTYkJ4_3lGwi9sXCA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfznGghc6eHndxE_WQwnoNszDzVvUtqSAV4IS5FHTm1Wag&oe=69AC2ACB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape", "keywords": [], "long_description": "Lethal Ape is a multiplayer experience built around simple, fast-moving encounters that encourage brief moments of cooperation and quick shifts into competition. Players move through compact arenas, interact with a variety of tools, and adapt to unpredictable situations created by others in the match. The core appeal comes from its mix of light strategy and spontaneous chaos: you can work with other players when it makes sense, but the environment often pushes you to change plans and improvise.\n\nAs sessions progress, the game rewards observation, timing, and a willingness to take calculated risks. Each round tends to unfold differently depending on how participants act, which keeps the overall experience varied even after extended play. Whether players are forming short-term alliances, setting up clever traps, or reacting to sudden changes in the map, the rhythm stays lively without becoming overwhelming.\n\nOverall, it\u2019s a straightforward but engaging game that encourages social interaction, quick decisions, and a steady flow of small, memorable moments.", "short_description": "Lethal Ape is a very fun game where you will have fun with others."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalapeee/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bombaclaut", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalapeee/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24988696404163006"}, "review_messa
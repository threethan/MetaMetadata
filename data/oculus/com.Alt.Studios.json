E29UBHwOCqyQ&oe=69D8EAB6"}, {"file_name": "cac63a5db41c4e04a71b4714b11fee5a (1).png", "id": "766897326411909", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819982_766897329745242_910413575924671860_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8A7H0nBpUWgQ7kNvwFLtJLg&_nc_oc=AdrFpe_9d8r-UlpcBBqtBiRSTu620nMDU4K9ZdcJRrcpfH1sILYCy_P2uCfGk7O8N_k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00_5teiPlHwYcGTDJ9UZHN6pzD_Hdc702g1YNvLm_k4A&oe=69D8FCA5"}, {"file_name": "be7a4aa75a444a7fb577209170d351ba (1).png", "id": "880586597727196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821674_880586601060529_6609551892226492095_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mL64tr3xmckQ7kNvwEUjwPC&_nc_oc=AdpyppV6xQirO2RAjz0wufhdjDcV6wdsp5PyY_x6P3zLHn06Og_w_BvVcAPgRsQBY1E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af252xqke17fMaST7M9EaTr0DsikNeQSYC9JrC4mJqgM-w&oe=69D8F0AA"}, {"file_name": "dae134ed4e974373b810fc76f6ba9aa1 (1).png", "id": "885380914024777", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819281_885380917358110_8131266415746554177_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SC7PNFGnWOcQ7kNvwHx3o-_&_nc_oc=AdqT47Vy3N1b_TbaMdE8EkKrgT9rBmJ4x44FkaXBIkV0Q94TqZ_5NwqrBV5juiAeM8M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3evx5Z-t7UuVajVV5eCOIWcNpJlmRuBXHfPKoOHr9ADg&oe=69D8DE04"}, {"file_name": "d6078ab9b5a4498790bca752ec4ab8b1 (1).png", "id": "1191288699031885", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1191288702365218_249752815198295780_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcOaw5IAaSMQ7kNvwGLa2o0&_nc_oc=AdoARUHyQxB_JSvplSTPnLhmM-Mnw79O4BT2LfeLnTMPSo3PfRV9pKkBMLkadsh8TIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01nhCs27cp0nYr8uJhMMQG_ciZ7UIACCU77RzSGfGDww&oe=69D8FDCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape", "keywords": [], "long_description": "Lethal Ape is a multiplayer experience built around simple, fast-moving encounters that encourage brief moments of cooperation and quick shifts into competition. Players move through compact arenas, interact with a variety of tools, and adapt to unpredictable situations created by others in the match. The core appeal comes from its mix of light strategy and spontaneous chaos: you can work with other players when it makes sense, but the environment often pushes you to change plans and improvise.\n\nAs sessions progress, the game rewards observation, timing, and a willingness to take calculated risks. Each round tends to unfold differently depending on how participants act, which keeps the overall experience varied even after extended play. Whether players are forming short-term alliances, setting up clever traps, or reacting to sudden changes in the map, the rhythm stays lively without becoming overwhelming.\n\nOverall, it\u2019s a straightforward but engaging game that encourages social interaction, quick decisions, and a steady flow of small, memorable moments.", "short_description": "Lethal Ape is a very fun game where you will have fun with others."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalapeee/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bombaclaut", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalapeee/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
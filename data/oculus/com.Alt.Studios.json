com/v/t64.5771-25/491819982_766897329745242_910413575924671860_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOGaaJDQm1wQ7kNvwEONvJW&_nc_oc=AdmTQyPvDVfQ-tjoFHR5k1RXyMLcs6-cdcqPMQnMEWzUUxi6hXuDcE94wMF8HVdQi9Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9eZj2RL3gNbTTb_iAQUJRb2y2f6er1mpCmKxF0zx7hg&oe=69AECCA5"}, {"file_name": "be7a4aa75a444a7fb577209170d351ba (1).png", "id": "880586597727196", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821674_880586601060529_6609551892226492095_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7oI6KxUk0AQ7kNvwH2b1Q6&_nc_oc=AdkOyxEgkmcHn5U3H-Dpixwi4mXDgrJa12_kwyBN7rqMhW0sRgQvLLFsgA2y5feMEuw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0pk9ZNhxv0sqFQCnMHjvtvNkBTZWQJ7lVAkTH-cApZg&oe=69AEC0AA"}, {"file_name": "dae134ed4e974373b810fc76f6ba9aa1 (1).png", "id": "885380914024777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819281_885380917358110_8131266415746554177_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpbRLZoJOeMQ7kNvwHSA3SV&_nc_oc=AdkkBhq9LK2tK3JYI1a4SWxrn69O6cAHMrjs1tXfc9yFrAttFP85gU5QomAqv6PoeSU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgiVSgweuIY7pYKyPciiE5qbTFWqSbiOACcXlMOanbRw&oe=69AEAE04"}, {"file_name": "d6078ab9b5a4498790bca752ec4ab8b1 (1).png", "id": "1191288699031885", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825305_1191288702365218_249752815198295780_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8loE7_GgEsQ7kNvwFSqufO&_nc_oc=Adna_Xo3GQIZe2hu_aJOvF40lhJFmqU_qWM-e9UbyfWUiK1SNUzHzQm9oR7M_PmGJGY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-CMNGK56g1Uqw0F19IptY-Ol9OPdkYkw8HRnOQEhndA&oe=69AECDCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape", "keywords": [], "long_description": "Lethal Ape is a multiplayer experience built around simple, fast-moving encounters that encourage brief moments of cooperation and quick shifts into competition. Players move through compact arenas, interact with a variety of tools, and adapt to unpredictable situations created by others in the match. The core appeal comes from its mix of light strategy and spontaneous chaos: you can work with other players when it makes sense, but the environment often pushes you to change plans and improvise.\n\nAs sessions progress, the game rewards observation, timing, and a willingness to take calculated risks. Each round tends to unfold differently depending on how participants act, which keeps the overall experience varied even after extended play. Whether players are forming short-term alliances, setting up clever traps, or reacting to sudden changes in the map, the rhythm stays lively without becoming overwhelming.\n\nOverall, it\u2019s a straightforward but engaging game that encourages social interaction, quick decisions, and a steady flow of small, memorable moments.", "short_description": "Lethal Ape is a very fun game where you will have fun with others."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalapeee/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bombaclaut", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalapeee/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24988696404163006"}, "review_messa
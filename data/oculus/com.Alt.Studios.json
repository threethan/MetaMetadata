1-25/491821674_880586601060529_6609551892226492095_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jyh5lNAln4sQ7kNvwER4yuK&_nc_oc=AdqS0SGda8GdBF2rhCx-cAwjHmXpd-bN6e_AHIh8WTOuVwA9a3YzW_Yof_2sMxsZjN0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLyM0YBN84BKow8VlQWGE24AzYOZuIGaQWx4bpz29onw&oe=6A97392A"}, {"file_name": "dae134ed4e974373b810fc76f6ba9aa1 (1).png", "id": "885380914024777", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491819281_885380917358110_8131266415746554177_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9myhu9sLvHAQ7kNvwGFtfff&_nc_oc=Adq0yr0BRxug15HZjkY-nb2qmN4-mvV-UQ7_vmxeEsA8M-qQOSRfXe_Yp6zVJDB2UwU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTm0Eextvw6Jtm221PjmBhVC5eFhyfRGbQVw3i1Qm-vw&oe=6A972684"}, {"file_name": "d6078ab9b5a4498790bca752ec4ab8b1 (1).png", "id": "1191288699031885", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491825305_1191288702365218_249752815198295780_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmraIFF74g8Q7kNvwFrhMVu&_nc_oc=Adqzw-Qy4aK5QhUgCagaXgQ5GTuZsO7dL9jYMumjtOVgJKRFTyqY_bmVw3TTXdc36DE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmt3Uj9RTvzLVpbV6zyt4LYHbBnio5CbdjPWXivVVC6Q&oe=6A97464B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape", "keywords": [], "long_description": "Lethal Ape is a multiplayer experience built around simple, fast-moving encounters that encourage brief moments of cooperation and quick shifts into competition. Players move through compact arenas, interact with a variety of tools, and adapt to unpredictable situations created by others in the match. The core appeal comes from its mix of light strategy and spontaneous chaos: you can work with other players when it makes sense, but the environment often pushes you to change plans and improvise.\n\nAs sessions progress, the game rewards observation, timing, and a willingness to take calculated risks. Each round tends to unfold differently depending on how participants act, which keeps the overall experience varied even after extended play. Whether players are forming short-term alliances, setting up clever traps, or reacting to sudden changes in the map, the rhythm stays lively without becoming overwhelming.\n\nOverall, it\u2019s a straightforward but engaging game that encourages social interaction, quick decisions, and a steady flow of small, memorable moments.", "short_description": "Lethal Ape is a very fun game where you will have fun with others."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalapeee/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bombaclaut", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalapeee/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24988696404163006"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "689221740929496"}]}, "baseline_offer": {"id": "689221740929496"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765305180, "status": "PUBLISHED", "id": "689221740929496"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27547099534989334", "version": "LethalApeRedux"}, "id": "1096385905780900",
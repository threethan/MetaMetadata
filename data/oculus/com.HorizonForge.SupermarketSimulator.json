71-25/38974506_439527699234279_8822289122343038615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K18h0OB4e3sQ7kNvwFVKKzR&_nc_oc=Adoe8M1Ui9-RQc3D06AcjpbmK1Z1gMsMUWqh50cGtHKc6dcnoal399Qi2bfE5_L2Ij0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM_SrS9vHnRHPyHWM9UU29hU9uW9mBgpW1yPziY4KEqg&oe=6A69EC75"}, {"file_name": "4.png", "id": "2186098068432451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031597_2186098071765784_2365250962047521967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4eZc8qLrQ4Q7kNvwEBptWO&_nc_oc=AdozCXeUCDYNNaMr_nADw80oFSDPPKg0nB4upjT139iDWla8OuqxBldaQpQnmeHeLHM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZPOpJmEcCJndTl3WcVEqbDfAX1dsQW7qTPSvJmpuSTw&oe=6A69F440"}, {"file_name": "5.png", "id": "8084269725013946", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974709_8084269728347279_8301930456597745936_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHYmaXUf37MQ7kNvwEHp_MJ&_nc_oc=Ado-kQRPb9QuvhlWztqUOH-Tg4n46PpcppnSYvVw0oCFE62I8X4gDCBjnqH9m_R6f_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_hCymLeAaZcj-Far34zH0HY9OxIICkB5AvkLuk1UrfA&oe=6A69E983"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supershop Simulator", "keywords": ["Simulator", "Supershop", "SupermarketSimulator", "Suimulation", "SimVR"], "long_description": "Step into Supershop Simulator, the immersive VR experience that puts you in charge of your very own supermarket on Meta Quest! Start with a modest shop and grow it into a bustling retail paradise.\nKey Features:\n\nStock Management: Organize shelves with a variety of products using intuitive VR controls.\nCustomer Service: Interact with AI customers, helping them find products and ensuring satisfaction.\nStore Design: Customize your layout and create eye-catching displays to optimize sales.\nFinancial Planning: Balance your budget, set prices, and make smart investments to grow your business.\n\nExperience the perfect blend of strategy and hands-on gameplay. Feel the satisfaction of a well-organized store and the thrill of watching your business flourish. Master restocking, cash register operations, and inventory management with ease.\nSupershop Simulator adapts to your play style. Enjoy a stress-free experience as you build your retail empire at your own pace, or challenge yourself with performance goals.\nDive into retail management like never before. This uniquely immersive and entertaining experience will keep you coming back to mind the store. Your dream supermarket awaits \u2013 are you ready to become the ultimate shopkeeper?\nSupershop Simulator: Where virtual reality meets retail therapy!", "short_description": "Manage your dream supermarket in VR! Stock shelves, assist customers, and build your retail empire in this relaxing single-player simulator for Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/privacypolicysupershopsimulator.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8100065613389279"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "2068637870722540"}, {"status": "PUBLISHED"
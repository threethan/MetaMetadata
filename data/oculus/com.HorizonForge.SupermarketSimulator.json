ymfqDw&oe=6ADE1585"}, {"file_name": "3.png", "id": "439527695900946", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974506_439527699234279_8822289122343038615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3sndbqho6oQ7kNvwGgV-mm&_nc_oc=AdqSh2MnIaCm-SGg3-EhTZv9dLlu7SysXhQHNTZQmnLI5l5zFPZhlBr8d9_7VI8VoMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMT3PCSaDFFxv0zGxquW7dVM5XbTOM_GmGyjkuuuJVoKA&oe=6ADE28B5"}, {"file_name": "4.png", "id": "2186098068432451", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031597_2186098071765784_2365250962047521967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJciUX19VKoQ7kNvwEGx10G&_nc_oc=Adqa4Y8I-irG-tJmJcL8XwsH5rnKNjBrNX2gmChwI4oUqu6H4JqhIOR5J15cW57gDeQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAgJnW1dky8hPAO8RPPDK-Y0E8MPxqNAvei2vUqL64cQ&oe=6ADDF840"}, {"file_name": "5.png", "id": "8084269725013946", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974709_8084269728347279_8301930456597745936_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=au89BlOcCXsQ7kNvwEP2fa5&_nc_oc=AdrDxMHPEy9o6fQJxflDxgiuIY2RDCfyqBwrjC1m8HZHiwhIy7M1g3A_LE89uyYJAzM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNy2PTPLJcnDSondt-SR9nxCGNIppi-nPtlktD8q8iA2g&oe=6ADE25C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supershop Simulator", "keywords": ["Simulator", "Supershop", "SupermarketSimulator", "Suimulation", "SimVR"], "long_description": "Step into Supershop Simulator, the immersive VR experience that puts you in charge of your very own supermarket on Meta Quest! Start with a modest shop and grow it into a bustling retail paradise.\nKey Features:\n\nStock Management: Organize shelves with a variety of products using intuitive VR controls.\nCustomer Service: Interact with AI customers, helping them find products and ensuring satisfaction.\nStore Design: Customize your layout and create eye-catching displays to optimize sales.\nFinancial Planning: Balance your budget, set prices, and make smart investments to grow your business.\n\nExperience the perfect blend of strategy and hands-on gameplay. Feel the satisfaction of a well-organized store and the thrill of watching your business flourish. Master restocking, cash register operations, and inventory management with ease.\nSupershop Simulator adapts to your play style. Enjoy a stress-free experience as you build your retail empire at your own pace, or challenge yourself with performance goals.\nDive into retail management like never before. This uniquely immersive and entertaining experience will keep you coming back to mind the store. Your dream supermarket awaits \u2013 are you ready to become the ultimate shopkeeper?\nSupershop Simulator: Where virtual reality meets retail therapy!", "short_description": "Manage your dream supermarket in VR! Stock shelves, assist customers, and build your retail empire in this relaxing single-player simulator for Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/privacypolicysupershopsimulator.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8100065613389279
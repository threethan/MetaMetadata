71-25/38974506_439527699234279_8822289122343038615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7DyfYtP7J0Q7kNvwGRqbdd&_nc_oc=Adrmqya2Wi-FUYb8Iai62RMTFwlbp_2Z1e1UwYvNiBCS8GE5fw9wEJLgQecJ8RorMNs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ej_o81QiHNr-SeQD8APoqp6-vRtE33PQ-UOqQnaHYuQ&oe=6A3EA335"}, {"file_name": "4.png", "id": "2186098068432451", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031597_2186098071765784_2365250962047521967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Qgcy2ZI-RUQ7kNvwHoqnqD&_nc_oc=AdolJzc7EqK1O5CgpUhOSgr8Zky3FPqsO1gcYEhfQqAYxevuUgjyBwi5HEDlIbfyEpw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FZPcsHzuFMiZubSsvGB1SheCkN7oSxSpDua6NZhFNcQ&oe=6A3EAB00"}, {"file_name": "5.png", "id": "8084269725013946", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974709_8084269728347279_8301930456597745936_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFT4ODx88R0Q7kNvwEs3hcz&_nc_oc=AdpaLq2Tx577mHI6an_TTZ3IzEtnIN9H_MN3NdGLfc82lPgMHilicU6QlOV89rSYDAk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kPOOicHD3BdwKL1eglOe2ouM7m_lOFcXGE3Qo4QyeIQ&oe=6A3EA043"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supershop Simulator", "keywords": ["Simulator", "Supershop", "SupermarketSimulator", "Suimulation", "SimVR"], "long_description": "Step into Supershop Simulator, the immersive VR experience that puts you in charge of your very own supermarket on Meta Quest! Start with a modest shop and grow it into a bustling retail paradise.\nKey Features:\n\nStock Management: Organize shelves with a variety of products using intuitive VR controls.\nCustomer Service: Interact with AI customers, helping them find products and ensuring satisfaction.\nStore Design: Customize your layout and create eye-catching displays to optimize sales.\nFinancial Planning: Balance your budget, set prices, and make smart investments to grow your business.\n\nExperience the perfect blend of strategy and hands-on gameplay. Feel the satisfaction of a well-organized store and the thrill of watching your business flourish. Master restocking, cash register operations, and inventory management with ease.\nSupershop Simulator adapts to your play style. Enjoy a stress-free experience as you build your retail empire at your own pace, or challenge yourself with performance goals.\nDive into retail management like never before. This uniquely immersive and entertaining experience will keep you coming back to mind the store. Your dream supermarket awaits \u2013 are you ready to become the ultimate shopkeeper?\nSupershop Simulator: Where virtual reality meets retail therapy!", "short_description": "Manage your dream supermarket in VR! Stock shelves, assist customers, and build your retail empire in this relaxing single-player simulator for Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/privacypolicysupershopsimulator.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8100065613389279"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "1933743943795515"}, {"status": "PUBLISHED"
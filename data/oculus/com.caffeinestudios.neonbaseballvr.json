20f&oh=00_AQJIuBS9fxyXfOQJ6dSdSbhxwV6jtvHM6_jJBkQjhfp0Cg&oe=6A9C3723"}, {"file_name": "02-gameplay-hud.png", "id": "883749214466549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619672_883749217799882_7622996917732290498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueMVZwuZUhUQ7kNvwGWArik&_nc_oc=AdpogrAb90Yq-rGfPKI68yQQG83zYLioPA2MDLvlIh9VM561phzcq3MPhoWAhqFdUIw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEE40ITI9tr_yMPFsFjGdKy-nLsdyOc7O5jsXxdFhNPQ&oe=6A9C1841"}, {"file_name": "04-target-hit.png", "id": "2660987744357003", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310667_2660987747690336_7413982874497046720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM9yoSp3cmEQ7kNvwGHUVcP&_nc_oc=AdriOvyyzL5yHMA9tNT-J1oDWMLooOq-2QDA9GNc5Su01HghRf5zkc-oc-Y2z2DZN6U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuAMJc-gANxPyVBAwdM5S7bGq9nBTsg2xGAFPG8aD_PA&oe=6A9C275B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NeonBaseball-Cover-Landscape-2560x1440.png", "id": "5474531686105283", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619187_5474531689438616_1997347691906264199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6anpzrTBcf4Q7kNvwGB6Huf&_nc_oc=Adow5lBwQuo6Ge0bkJfb90cM1K0StowVr3Ir5n-U0mFN-MagUvEs1L2YN7igY1epiow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-sWSSA3TVdIXBckDXQ0FHBTrW_b2PCoqbNuy4qwny4Q&oe=6A9C357A"}, "display_name": "Neon Baseball: Home Run Derby", "keywords": ["baseball", "homerunderby", "arcadesports", "batting"], "long_description": "Step into a futuristic night stadium and see how far you can send the ball in Neon Baseball: Home Run Derby, a fast, comfortable VR batting challenge built for Meta Quest.\n\nChoose your left or right controller as the bat and face an automatic pitching machine serving fastballs, slow balls, curveballs and rising pitches. Time your swing, make solid contact and watch every hit fly into the neon outfield.\n\nEvery metre adds to your score. Clear the 42 m home-run fence for a major bonus, smash three glowing targets for extra points and string together consecutive hits to raise your multiplier up to x5. Each 90-second derby gives you five strikes, so every pitch matters.\n\nEasy, Normal and Hard difficulties make the game welcoming for first-time hitters while giving experienced players a faster, more precise challenge. Your best score and longest home run are saved locally for each difficulty.\n\nFeatures:\n- Stationary gameplay with no artificial locomotion\n- Left- and right-handed batting\n- Four pitch types and three difficulty levels\n- Distance, home-run, target and combo scoring\n- Futuristic neon stadium with original visual effects and audio\n- Seated and standing support\n- Offline single-player play with no accounts, ads or Internet connection\n\nClear your play space, secure your wrist strap and step up to the plate.", "short_description": "Step up to the plate in a neon VR home run derby.\n\nChoose your batting hand, swing at fastballs, slow balls, curveballs and rising pitches, then chase huge distance bonuses, smash glowing targets and build a score multiplier.\n\nPlay 90-second rounds across Easy, Normal and Hard difficulties, with seated and standing support and local high scores."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/neon-baseball-home-run-derby-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED",
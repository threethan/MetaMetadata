J2vn_FhBnjLnRHJ5m_7g&oe=6AF0AC1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CaminSantuarios_CoverArtLandscape.png", "id": "1365138381680233", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_1365138385013566_8827328924257441494_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pwi--i3roYQ7kNvwHFRBsw&_nc_oc=AdpNppDmv-9D2oXBGW6FzAFOq1IiB0HLDq8IMlO8QYeD_i4JH9BJmM8VoqguhhYWxOA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3czxWa8FudSPuEYfcs8WLIEdUOfI2dNuJ-EWzrsytRw&oe=6AF0B121"}, "display_name": "El Cam\u00edn de los Santuarios", "keywords": ["Historia", "Cultura", "Documental", "Religi\u00f3n", "Turismo"], "long_description": "\"El Cam\u00edn de los Santuarios\" es una experiencia VR que te permite disfrutar un documental inmersivo en v\u00eddeos 360\u00ba, donde pasado y presente se encuentran a lo largo de una de las rutas culturales m\u00e1s emblem\u00e1ticas de Asturias.\n\nLa experiencia comienza en una caba\u00f1a medieval, donde un mapa desplegado sobre la mesa central act\u00faa como punto principal de interacci\u00f3n. A trav\u00e9s del documental, podr\u00e1s contemplar el paso del tiempo desde la Edad Media mediante paisajes, valores culturales y los secretos que han marcado la historia de este camino.", "short_description": "\"El Cam\u00edn de los Santuarios\" es una experiencia VR que te permite disfrutar un documental inmersivo en v\u00eddeos 360\u00ba, donde pasado y presente se encuentran a lo largo de una de las rutas culturales m\u00e1s emblem\u00e1ticas de Asturias."}, {"images": {"nodes": [{"file_name": "PathSanctuaries_CoverArtSquare.png", "id": "25621648947452453", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618061_25621648957452452_1622597920346026361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyGUWIEIpwsQ7kNvwE7-ysV&_nc_oc=Adq9UWxHtWd0E_MAAoQo5v5MHZsQI6RyzfCOXZcdUiHMCPHMAW-44EcIXAf1RN8SNqg&_nc_zt=3&_nc_ht=scontent-s
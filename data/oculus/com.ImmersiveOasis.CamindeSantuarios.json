19KAzymfVXJNr0Ho6khg&oe=6A6211DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CaminSantuarios_CoverArtLandscape.png", "id": "1365138381680233", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_1365138385013566_8827328924257441494_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAzWST1obU4Q7kNvwGGdILc&_nc_oc=Adoiy72h6pb_NDYRH4EmYUqao4_YTQ2q5EDQqOMDl6PVOpjK7qDVlPCyTDE0N1IVF-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0QopVzAAc5re50uz1dZb9T9r7_4_0sQkBLHcbP_IFzg&oe=6A6216E1"}, "display_name": "El Cam\u00edn de los Santuarios", "keywords": ["Historia", "Cultura", "Documental", "Religi\u00f3n", "Turismo"], "long_description": "\"El Cam\u00edn de los Santuarios\" es una experiencia VR que te permite disfrutar un documental inmersivo en v\u00eddeos 360\u00ba, donde pasado y presente se encuentran a lo largo de una de las rutas culturales m\u00e1s emblem\u00e1ticas de Asturias.\n\nLa experiencia comienza en una caba\u00f1a medieval, donde un mapa desplegado sobre la mesa central act\u00faa como punto principal de interacci\u00f3n. A trav\u00e9s del documental, podr\u00e1s contemplar el paso del tiempo desde la Edad Media mediante paisajes, valores culturales y los secretos que han marcado la historia de este camino.", "short_description": "\"El Cam\u00edn de los Santuarios\" es una experiencia VR que te permite disfrutar un documental inmersivo en v\u00eddeos 360\u00ba, donde pasado y presente se encuentran a lo largo de una de las rutas culturales m\u00e1s emblem\u00e1ticas de Asturias."}, {"images": {"nodes": [{"file_name": "PathSanctuaries_CoverArtSquare.png", "id": "25621648947452453", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618061_25621648957452452_1622597920346026361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iobaUwLV8ggQ7kNvwED3ObP&_nc_oc=AdrLIjleyXPp7MyPezrgLrR8gafeXgVFwtRhKg_F9Ag7s6C1bqq40fS-HuBST-Zrm68&_nc_zt=3&_nc_ht=scontent-s
dk_EBPpyiPdGyu2sLhqe2vEDhlziPDYpMvxCbjMHZt1O6_3oJnkb3fJZ1JAsZ01I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpty_obeEu0bcqBGlhDErZ0kD7TOSyy8NGYL5RB9OARg&oe=6ACF9911"}, {"file_name": "491823910_1099741545343616_1312906988870335529_n.png", "id": "1561156151756329", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823310_1561156158422995_6970834098119638053_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6kfDuD5tFgQ7kNvwEdkWT7&_nc_oc=AdrqHJ-siiRt0jJtvO3gMzC8BmECawXiLewvrNChRN-HkSmjdBvP8hhfAvt6KiFbM_I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBaGWH4unyD6Awe_FacJ4yT0GSgfkT7uFBB-pLdmyS3A&oe=6ACF9404"}, {"file_name": "491825345_32059824123663660_4455348107004273102_n.png", "id": "2100827733791760", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819239_2100827737125093_1362182679036369605_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3oI-D9qlssQ7kNvwGB2fmH&_nc_oc=AdpssmQCnyLGnUpr-vO9g3NK7yNOX_aP-XnljSysHI-9BL4EpCF0_qSaZEQ8d1ZBBhM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXMPOOTcpOXoG9ZmgfHF5RzbVLMc4wz65lLLH8i34AXw&oe=6ACFAFB7"}, {"file_name": "491827601_3952617995028802_9102322446761840245_n.png", "id": "1244652947556074", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819239_1244652950889407_6794096923022560946_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYc0x4qd1_MQ7kNvwFWWQqB&_nc_oc=Adq6iELrajWqyfviGZ9zpOPh1wK2RQX_0tnKiFs-6iJS8FYpOd6ILv8JdS4LKxk8M3M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6GJ2QTwBSoQV0l9S8U9h3amOt7K-ljs7R0oM0QzZp-A&oe=6ACF8EE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Strike", "keywords": ["Gorilla", "Project", "Tag", "Tagging", "Taggers"], "long_description": "Welcome to Project Strike!\n\nGet ready to run, jump, and fly around in an exciting virtual world where the main goal is simple: don\u2019t get tagged! Project Strike is all about having fun with others in VR, whether you're playing tag, showing off, or just hanging out.\n\nIn Project Strike, you can join other players, make new friends, and enjoy smooth movement that makes every round exciting. The game has one big map designed for climbing, jumping, and fast movement. It's perfect for learning the game and pulling off cool tricks while you try to escape or catch other players.\n\nYou can also buy fun cosmetics to change how your character looks. Wear cool hats, outfits, and more to stand out and show your style. It\u2019s a great way to express yourself and have fun with friends or anyone you meet in the game.\n\nEven though Project Strike is still in beta, there\u2019s already a lot to do. We\u2019re always working on updates and listening to player feedback to make the game better. More maps, features, and cosmetics are planned for future updates!\n\nIf you enjoy games like tag, parkour, or just hanging out in VR, you\u2019ll have a great time in Project Strike. Jump in, meet new people, and see what all the fun is about. This is just the beginning \u2013 and you're part of the journey!", "short_description": "Welcome to Project Strike!\n\nJump into this fast-paced VR tag game where you can play, chat, and hang out with other players! Customize your look with awesome cosmetics and show off to your furry friends. Whether you're racing through maps or pulling off wild moves, there's always fun to be had. Step into the action and make every match unforgettable!"}]}, "developer_name": "Primal Studios", "developer_privacy_policy_url": "https://sites.google.com/view/project-strike-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Primal Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/projectstrikemain/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597
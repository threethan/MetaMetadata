ale": "en_US", "screenshots": [{"file_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLLuI-2DOtgQ7kNvwGTDyas&_nc_oc=AdrnGUfjIvpbmWxnR0_4BSXDxEtNmtRsQh0cm-6wcrlb_mZhhL_OzLwd4dITyTI-VW8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiLLPGriUZ83U9MgbsRebwJouO_knZBEEOF5Urq4Qm-w&oe=6AA3F17F"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpMNVb99hUkQ7kNvwFyqktR&_nc_oc=Ado-ylItu38HwhgTrvg_FkrF6iBp4UD4odsiN0N2_SFPm_UTyosnc0ApMDhGJr51VFM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwtOUiMQofAiGYc1jcHVFFbjsFOvkqWPqQ-pxHtSbjZw&oe=6AA41AFA"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efw4mg_mM1IQ7kNvwH065-E&_nc_oc=AdrwDanzqnwlrkzhPJbs5x7JevLL_JyUucI8ILDrxCIp1IhVUKHjlbFWUkFaekLhS_0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUQ0jWEHwWV8uXRJe-5pNeFlQAJDZPM1nMuonYJtQ4Og&oe=6AA41E70"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Siu5TUmHJkQQ7kNvwFspL9u&_nc_oc=AdoyWtsZIBnzakCbtieZh3uLuztxHVodBhfQUteJQqkvAxU3Aq_Wueq-VmBkWIOcXno&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWL6-KFUcOPbIDJWhstse0FMADBUfBxIv1V1oKi0qRGw&oe=6AA41C6E"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7F-Thn6WUnwQ7kNvwF6BqoG&_nc_oc=AdqNWbz5T8V36daOmv97ij-Rg0Pu7XjADwfK3Fo3JimXrwKZKlBCiDoy8pqA9RCak3U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBkXJVj7gVJXUV6V8oieUWQx5C96Der0a8zpsRfkn1ug&oe=6AA402F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"
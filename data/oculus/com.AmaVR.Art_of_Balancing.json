: "en_US", "screenshots": [{"file_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiA5SYecD_sQ7kNvwH-ZuLJ&_nc_oc=Adru3HsCWoUrlrxITSBIV84NjyROdAwmmbTFIcweKaGkCCecshHhxP7qI5Vd-P7cMZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo6Z5eFMubNYIpvGtbpVI49BsFa9rsMDaQ8gmR46bdkg&oe=6AC27C3F"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ia5ptoudIDUQ7kNvwEIJYt5&_nc_oc=Adp7qksY5KPlytPFdUslcIR-knngfdtBWHsKb8dRBXI2XhoJRF0trPo0eeX_3Uxzvwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO41qjxUvQSx472t-sBRTtNYurinjvxlz8SuHAR2_IIZA&oe=6AC26D7A"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtacYFxtW-EQ7kNvwEtPwzT&_nc_oc=AdpcC-3PcL6yR4u4GWsUpUGscny_R5ahXALRqGhmc2jYfeEeXeumX1YOWXTiHwhT2nc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_G2vpQUsZDaOtWuz1UiYcrWobmWTrvjhlJ2L_Ip4vkQ&oe=6AC270F0"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yU5eW9435b4Q7kNvwHySOnP&_nc_oc=AdoAasn87_a_EDEmszCxfACqqLZq2ME6aqDWk9TSfWDd6rtIEsXv23dQQNR2bnS7xwg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNThjp8obKzig9wdkXTIrY3fjsZ0uXfgAp84u4gA8xKQg&oe=6AC26EEE"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFHhB9wrf5QQ7kNvwHnAlaM&_nc_oc=AdoBJLFYUl38MHW1pGjxqjKlTsNeokr2fXOZd1y8wRFGc16Txxru6f4zzx_30e6khsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPacyPsc72KCF5BlWkAT5KcZjTTo-T_38jQdMZLMXe7A&oe=6AC25575"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
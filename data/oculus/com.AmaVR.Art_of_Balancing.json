: "en_US", "screenshots": [{"file_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbLMNKTEZdkQ7kNvwFYVH9s&_nc_oc=AdoxpgSmn297_upkjglGGsVbXbmmqXu4WGy9AQ8DwyS478l_9RqRE4kZfPPENnlc4Os&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLe-94zbm19amhr1M66vH3iwLlFnO5SuRdSEXN3JE11JQ&oe=6AAA88FF"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqFG9gecYXYQ7kNvwEtUmX_&_nc_oc=AdpkNFKXh0ep4jeZ-aTNi0pQF1Ym5bQ3q7LOGOPJBDd2QyQ9lS7hp6ATc_wFtH5W2N4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaTp-VYv63GhftuZV7KYJNqXBVZn3TD5sC3SWudSKfDQ&oe=6AAAB27A"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQ1aqIq99SEQ7kNvwGMOY4e&_nc_oc=Adp8q3xfP1jzH76fOg6wvFC_EVpuxaenQxNBUMxeXFKp06uSVYz6G-cvlunpT8h6MEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEFvlh0CHRVjMfn-F8huoorAcD6P--mxz-iCBnnrIqcA&oe=6AAAB5F0"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65-bxLz3tIsQ7kNvwFfpYD7&_nc_oc=Adr0_lealXL_7_6SJOZNnY935d5j3h60ld-Jg_VSvVEy5Ls4T5tZcdIXfPCyIbBY1zE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFHONrS3k7-7uu0tAuE-opdZb8wZyA-DmvJaL8-2NcmA&oe=6AAAB3EE"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80APKKat9vYQ7kNvwFxrPOP&_nc_oc=AdphIdd2ltWm5asIcdlkS0zLvJZV6RISicvQzSt8ymQYwD_tIdtHzLj8bn65GLSZOLI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIplkI-TGhHSxsxlmFRPuR8KV4XQwmUshxlJWU66G4oXA&oe=6AAA9A75"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
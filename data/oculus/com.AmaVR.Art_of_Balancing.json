: "en_US", "screenshots": [{"file_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTAeyJqMgbQQ7kNvwEDq5ci&_nc_oc=Adow-tRP2Hg2vnBdkuKiSWZqdC6NVPm6l3X-3eZvtHLWFg6Rk3OzyFkp1Ca1X9i36eU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWJq6a0Xil5-9FiXNPPoXTP5he_ZFYeGLp5BcFeHpd9Q&oe=6AEF4F3F"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQO6MafaRXkQ7kNvwEkCnUD&_nc_oc=AdpJMk7GgODPnJs6kWUFeYWI-8FkLj11rRfw5eEFp5S7d4WJsO_GWtQ4g75l_DQbPiQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_LJOJKkTW7cqztqC5mAvEXsXDvTPDKkNmb6W4_eb_Jw&oe=6AEF407A"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f67h59swwnYQ7kNvwGi5TdC&_nc_oc=AdqKiVSLqPldCpCNN7ysYVVXcppQWwAk0g7OIhUqT31IXaHpGa2OWiN0rhBF1uOHUT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE8P9mN1DLUJjHnu4Y4efoiSZSBj7ex18Pzi3lmzEiRA&oe=6AEF43F0"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4z_ocMSBtkQ7kNvwHwy4co&_nc_oc=AdqTomNgqFc9yM3hnrhCiMtdn8swx6oZfUG1siUcsYeTdwp9ju82TXiICWW77lJ3nq8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtiYDB7YQN_DhPZ58FVDDhVtc98o0vpR1wyw4pnCKNjw&oe=6AEF41EE"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcBGta4Aq4UQ7kNvwFHbz0A&_nc_oc=AdqkjAWqPuhyl9KiHbTo7AiBLr9fbNQQNkGp5vDBOnQvCy1WBfH9NAWkAZOSJY3zwp0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHl2TKCH_vhniSrI_Z0QkF8ezi6SsXrqaODT5OhqXu_Q&oe=6AEF60B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
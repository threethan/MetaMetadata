: "en_US", "screenshots": [{"file_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAc-GsfZhWcQ7kNvwHdXLMK&_nc_oc=AdpqrcJv46Jp_gx-4En6HlVSh2ZF26gJXtFrrv_NsDhNaFfI5812HZJFQc6XPYaQl6c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29A6gGnmB42Bcriplc50lIk0_6ROqvKh8tghqCsus1Bg&oe=69E4C7FF"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffbxeQPi6LYQ7kNvwHTCHTp&_nc_oc=AdrydWRDna7fV6Fkru2L76JHHrxddmYlDaBqEql1xt0QqqKBRpiXoxAs6E8-eGsvQUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GdGqFuoj0Zcq6vX1uImOLWLePIMzB9Vju7Zx6jXqgxQ&oe=69E4B93A"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg2ilPiAXwkQ7kNvwEto6aC&_nc_oc=AdrSl0pdJnsO3CR7Yy6f0ZmyMYIKbpW4COHI_UtVnk1Qr6_WO40PU6SNR9lGUWRPV4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IBujKFenMEYGxKKmCCIvVgXXrIiSbUd0_9yIwIWxNHw&oe=69E4BCB0"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZv-Y71RNEAQ7kNvwF9RwLf&_nc_oc=AdpCkCP0ScMYS8aZ6ftCfQsCemHN6vNq87EmyxCIz3sVYRCzRI8G5C9-yx8H0wN1eHU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oAav0PZHbXT1p0Ed8Mhc-c2UQE_jkSkn3rUbFEdeesg&oe=69E4BAAE"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggq6Puv4SUAQ7kNvwFUVPBi&_nc_oc=AdoQtFjL9WIQX1Gy1nTzO4SYj2C-e6vfjGJm2JP4r-37i_WEYOYuBLb-0wSos3hmL48&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13ge0cKbMPK1kTJisdLexNjQTNghqhv98bchdBQZBLXg&oe=69E4D975"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
: "en_US", "screenshots": [{"file_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8H-_-X16NQQ7kNvwHlRz77&_nc_oc=AdrKKNjy-coCF_WQJB82EubWzIrRhosawLTmiNTQkMrb9BlGy15kdx8dWUjLCFk_EAY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hZRjmkEQJ3oQC5fX03op2lSR9n_20nCo9mCK8nYiDQg&oe=69DA3BFF"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZNb_ZOmZrQQ7kNvwEP2xje&_nc_oc=Adou6a7xmzFbTA_AmRoMlhoQQA1KX6qqpwv60FjVXBjTJJSqk-xm_Q39bEsVFaOzyfw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r67evLA45fDzBHEiattNZRG31nfie7mQtAJ0DhhHyDQ&oe=69DA2D3A"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trW8x-0VCUsQ7kNvwE1yL6k&_nc_oc=AdrYjIyT9Unp0z30I-JEnl0YV6A2GRafdkSyvrgsdG8QGno1ucp3mvooW8-4A7WbQrg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39C7Sx5feei0iBLCIJTSnk2R8zkxXdwnmO13X7s0t5ig&oe=69DA30B0"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4Z3z6TZJloQ7kNvwF2GVN0&_nc_oc=Adr2TeCHCyN_AWMCTuF9c7mlznkaUvTBmVCSg8vKl_lbPZl3dVClP69UamjI51wnBJY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0W0OMDEqPWsRMNpAHuAKiMRto0_C1Dg1vi_f5cOPF30Q&oe=69DA2EAE"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNWXBTpcI5AQ7kNvwFisX4D&_nc_oc=AdqNSB9Epga42ezNgQVDWsm-HvdT9PamE-CRutk8A5xKqQGhQuaaqyrnJdZjGhJeVe0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0M73pYg68hvoMnDJwm8dDTJHAXKqDsEms9j11ZmmK3BA&oe=69DA4D75"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
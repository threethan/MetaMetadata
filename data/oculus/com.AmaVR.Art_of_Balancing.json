e_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5xvMScGWxcQ7kNvwHIxkUC&_nc_oc=AdknxwkVoidKcqCHGXHBiwrVwmRp4mOtSQbaZiQfgk7ghktH5pLLP5rLQUH9xQv25Fg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHCzIn5SOJ6XrwSvxVIQIjVQJnJCBr1Jf0fRD4z2oP7Q&oe=69B6A37F"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhs4IVLXLOYQ7kNvwEzHTf5&_nc_oc=AdnU5w0eVzW3gghO1UgaYFL29JfAgbMGhC32A2UXzrO7hEzUjFtwKv6hVuELy85-uq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpOIRFB41rYh8EnHmEHKhWKOhrc9IMPD8cAwO74ZTFng&oe=69B694BA"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaYWv7tRJkMQ7kNvwGXo0AF&_nc_oc=AdkbWmIVv2eWuID0j7mnf83cDi50m9lO_SXozlcllPSSKXKGrnuQAwn7j_shDCcUmYI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx045p6ccQu2gLAmVHmNOebG9bLfnjxRslA_KFZbsJMiw&oe=69B69830"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHpszkK9LCAQ7kNvwHeb5kZ&_nc_oc=AdmtuLdj6CPvsz0ZxkDbA4DD9vxPe5edWSjCELF9nzDVTZ9Pav0sNp1Osd9flzFpvrk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw94DBQZYKS45ns-S6F53n7jQfskeDoUHpH-xpMtgkNog&oe=69B6962E"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9659QXjkkMQ7kNvwF9LihB&_nc_oc=AdlsP6IXbYsYcYiPe_XRTreKxJjd6g8qaVJimAifXDHSlK3LxPhFjJD2dPAVCF7QzPk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8MnkCMQZw2T3c3O68Fhroa_sTGUck8uf_V372mlL91w&oe=69B6B4F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported
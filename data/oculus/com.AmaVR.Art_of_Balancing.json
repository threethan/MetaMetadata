ale": "en_US", "screenshots": [{"file_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMI3QTggF2EQ7kNvwFtBRUK&_nc_oc=AdpBMzU7Ew_JU7vX-FXA0onmHU0_RESDitgO1aQ8d06jE-aKRsfFSwXIczr_Wmi5nQ0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhDOLUdWiqrmmsczZAI4yn_6-_O3u29k24POQEGi3MJQ&oe=6AAEB5BF"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=095lRjdBKAoQ7kNvwGBc7fR&_nc_oc=AdoA1glPyTtQo6lcQNOYHoML1M2aOXbWu0fIFzJQS-RvAk2-EQmAvoyQvNybUm0hO5w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLloRahYrlcPFidOJqXyd5tK3Qjz1cwNnZ4v5onUkhlhg&oe=6AAEA6FA"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5OIP8eIdgUQ7kNvwG1xSnX&_nc_oc=Adq7kcmfkkPv6nyqV_0l9pHByen8wFHZ9lzBbaT3CJA36UPXITc0GIC6wvk1hZcKZBU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrPSbtzxLOaDwN3vv5AX8HL19cxImOk74lE6pC1omeSA&oe=6AAEAA70"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RgaE0dyhTcQ7kNvwFFK6DR&_nc_oc=AdrjSU8wxxjS-rn0hyShl5JjXQ7ykQxltNl38_gISsN-OGt-PtSU3P_KdtBOe4un64M&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWPVp_6QF_hePKDj4SIxBcPJq-m75zk1J4_Ai-VL7Cew&oe=6AAEA86E"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSrZs0dEWE0Q7kNvwH46053&_nc_oc=AdpRhBDnO8JW_8Xie2taIuDG_QPKnP0_VA0g2-GHmFSWlZxdyFyvg504ay4dk0hrjIQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDEgq3DR-DnmwzVCWVHjZVmvml9pyO64ffI7ZJC30J9A&oe=6AAE8EF5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"
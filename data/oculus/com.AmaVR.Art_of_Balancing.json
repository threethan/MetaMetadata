e_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EfPwFoGaFkQ7kNvwEr5THb&_nc_oc=AdmhhVdfcxbEj4u3NvD4WRPvSwgGHotgcm_BocHFlAEtt0SFsu453LcODj028JjQWhM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5ACTOXOrFETDZ3BFEDTeDOmimJe6as4Mi11Nejiolhg&oe=69BA97FF"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=at2wmODETT8Q7kNvwHC_KMn&_nc_oc=Adn3ifYV1TIxIExPW8BoST_1x1qKJj9M-7oGGVL4L3Nh3J1SyXTuxN0sPKegRUrlFVg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz7QznJIj5J4QTEqcv4UWFXxkPaqsqNNEQlDAMGrltPiA&oe=69BA893A"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8t5mQ1pwUyAQ7kNvwFixOV5&_nc_oc=Adk7VaCDHVw4DuFhett6p_z111vLwS5ZGJQjK1B8RBAjye5sjeSAqtZbp2em04Psjdg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRVFN8uWiElG7d7ZovVPouvLuwpaCguwA8s6iwDbRoTw&oe=69BA8CB0"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtEZZ-vyeNgQ7kNvwGM2Eox&_nc_oc=AdkqrMyZJ4WcqPBBl4EUPeOQwQt8udXWlztPkP6Mszy1sJslA5pQP1soi6VzHqTKr7o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLwmGxAGhokj675dnHWV8uZ6TdxvkH58dfmxu7qK4UtA&oe=69BA8AAE"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOKuzYvuMuQQ7kNvwEtuCOX&_nc_oc=AdnL3CvTMThO-8N-lhIMPBeEXNGo6tIPw6qQU-nb3QrkHOb-IL_ySjWM77qZoJk7J0A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw-P9Yi-oEpKoOKv61sBxRfjOkwl0_2DSMUXnqc7Lsa8w&oe=69BAA975"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported
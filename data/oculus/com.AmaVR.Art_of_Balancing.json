ale": "en_US", "screenshots": [{"file_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0VoTbikX3YQ7kNvwF1M2W3&_nc_oc=AdoQcWlvdPiQEqWJsVBEe0kWIjAFoIdF6coeGMnlqGZxRLmTi5IoGHFkbttdHi-ACzc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Qoex8b0BvMwlFxOVQDGfikKkRuMpu0edKLOMm2VjTbg&oe=6A39603F"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uFwpG_9pLIQ7kNvwHD0vFm&_nc_oc=AdqdYpTYgo_5ea33mSGW1wTZZE17F8WtX3kFi5VUe28ZhVw-z2aDH4alty_xjar4by8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83pXtKMT7iAz3n3PZbY-M5OSNx2Y6PjOHWEVYeCfZkfg&oe=6A39517A"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsDvkgOeaokQ7kNvwH9njfq&_nc_oc=AdrnnGQPLnbDgpYkSRUnaHH_rTgZ2ytJMjpRrzsXz1q-SMYw4UVl1YdkRIhasCODurw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bx5T38T3063x9n5OKa8y9zMJP10YpXJYwWEPn5APKOQ&oe=6A3954F0"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jm2vBd33_30Q7kNvwHFiJsy&_nc_oc=AdqZ4O9geY6sJHgYThlLPTPZmb5EPAvBgPn0WCpZ95tupBJBr0NJ04PWHnGHM0Nv9nQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4bQdEYLNnTxUFRD49aYHd02WyuvsBouNzh4noco9gkw&oe=6A3952EE"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvV1a-VGblAQ7kNvwG5UjQT&_nc_oc=Ado0kS1HbklDORQpYOszEo31HnL74RqmOkPyBbdpcwQrScW_X2o6FdtmzQSmk1goUio&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q3SHU2bTIuHLQ_iSLR-WLSw4Xs8PkT3MQtvbLw6I0fg&oe=6A393975"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"
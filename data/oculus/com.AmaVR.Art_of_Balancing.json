e_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdI_oJr7T6IQ7kNvwGPyBSH&_nc_oc=AdkbgQQhg9wOQfO1Gb6OiWMiysrgE2MVmoQvroOEdAq68_mpvaTEl2M9sC7vpPcDs34&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyst2XRZszm6vFxXodlGY9tq_z3MwitP_-h9mH7kdLvpA&oe=69AC177F"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-VBa-OSRecQ7kNvwHABUIQ&_nc_oc=AdnYSd2htpoKCONjPh22_tELZB536iJd3IQsj-V9bDh8J4f1ZPCb-YSpMlQ1kQp2MNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwoP6_SWYgIe3XhmRCfj7rPMBnoEaVcZ4u83kzgFs41JQ&oe=69AC08BA"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQSnjOJTdPwQ7kNvwEJ_wGg&_nc_oc=AdmTsTcNNglxxGbCQAfwmwHeH36Phut8BMZHclOdIeODHNS9qocwqxJrhQX8W8e_WCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzKrDWn69zMZVG1aZxzrxVt4rC2xJ85Afmat-fN7TkFHg&oe=69AC0C30"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-OnbC0hWeYQ7kNvwHxE6P1&_nc_oc=Adn2eup5em81z9PRWjXqwhrVqkMR6-PEr5rzJKxt4MN9AA3lHWvhZq48hnzzcUVEcag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwhLXuhk8hZGkBuBy9-umME1NhL3qqDnoVZornJiTxvsg&oe=69AC0A2E"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nslx8SO895QQ7kNvwGsQI4n&_nc_oc=AdnToKE8Cmv4rGzfzwrLzn1xMbwxNd6x4M1SYts57x63f0TvoeRYwudYZQASopMbcSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLDBhIK8L0NK59Se1xb_qMTERrd8TD1vNWetFAm-7lfQ&oe=69AC28F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported
: "en_US", "screenshots": [{"file_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJElWWyzuK4Q7kNvwEvO5Js&_nc_oc=AdqASs2VU22yo-8Y5YdiGqpIGPTSMp0GOhLZVbs0qz8i_kGE0dmxwbtOKWH-qP_KW4Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpu5aAzfxGGPiz2Wfk0W68JYZVpOs5s44JxKJtHIGO0A&oe=6A95E17F"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKGATrnesPoQ7kNvwH1lxNT&_nc_oc=AdoE1tj7PbMUSPsV12Ry0k7MKmeJAuRVbQDj-mGjz35dGVt-4z6CzNn2jdycdmP7iAQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGv9nPpRfhdSLU_WUCfBDje5rPnrnGiKXGd27l4gD0_lQ&oe=6A95D2BA"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQXMDBIHysoQ7kNvwFyMk__&_nc_oc=AdpXOgLixkXp6C021L6XUgjJ9z16h3y0AellF2T-NlGU4WFN8TfF-F_Pbdm_Kh3-u8c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoOuX_fPzomb8BKfsmWnKutsOuuIiABIaFv9h6h0-lfA&oe=6A95D630"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kN2rnFTHpp8Q7kNvwH3QiJy&_nc_oc=AdqnlhEeZXhiHmi6t4UC7FgN4OayqzeE8ReHeAMd_ozTn5_tdqKmuTUXeBW81O7955k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcCwo3rkGU5W0XcLH8DAE1bSj1V-7AtzKvc7mJbdWdGQ&oe=6A95D42E"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rc1RUoOfUkEQ7kNvwE6_oWr&_nc_oc=Adriq0_wPQ-Z6jIm4GgghIFR_5pHKd71Z7m3h5YYsOQp3lkx6tJ6ODRoFtNf6Uci6YQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeFao5aKdYrtu80LBZwSbjIDr2tscgmAfLCbSZK5rh-g&oe=6A95BAB5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
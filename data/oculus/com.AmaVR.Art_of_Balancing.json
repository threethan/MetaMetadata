: "en_US", "screenshots": [{"file_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKEyv9I_784Q7kNvwGiUPA9&_nc_oc=AdoB5Lr5OH-TSVBpcJqaVO7x07_Wis-TM1xzQBflbTVUzi04c3_enphOmBcD-7wSc3I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CBElZK5AMbhwFN_WXGsBKWyDhL31UgSXCGsfiuZD0rw&oe=6A3EA63F"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jD6Ixe2ubKIQ7kNvwEL-1iX&_nc_oc=AdrFtZcV14MU4kko2Hy5IEyQjVMpwc-ndRq_CYlDAMHHDFhqVHBTt38EAxT9Sj2U_eU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WPthSc7k99FcWdNBvJlo1AYjM_kDQiwk23FXy7C0kpg&oe=6A3E977A"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBMXBlFDm9MQ7kNvwGekd2c&_nc_oc=Ado7AseR4VpjCTY2WFQVPD7Yi_ubLk9315MtfoNliuIipnyV8vymc6bu6JEm8JsjPz8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8xab-Zo7fdU-oolKsc6VIycTEsDVKhO0eZ8btLQaBlw&oe=6A3E9AF0"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lz8u7AM7bYcQ7kNvwGazIXC&_nc_oc=Ado1Nrn2lcbKPA2Ctz-t_ogKn9C-sImYq71yN7zawWwGcOg1loY1PJN0MhJCvWVWcgg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zpBDvKkMBOdnDcFVTxU8noJ6vqCDIYwc4NpCVJ15L7Q&oe=6A3E98EE"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0PL01NunJIQ7kNvwFiysEO&_nc_oc=AdrLxHgTYhAymEVXF0hPWbmntiBPR61Sm3UfTG1nrfC1Bt7Cj37wJ2sTdc9Yh4Kg79s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nonEfhtgalfofpE2drvulCDyk46dpIFDo4ctgn1-XGQ&oe=6A3E7F75"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
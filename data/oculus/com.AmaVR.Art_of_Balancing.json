: "en_US", "screenshots": [{"file_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iD1tniSD-NQQ7kNvwEshKze&_nc_oc=Adq1-yj6p2W_MzjSnWSJmYnUsazbfTLnZaXixXauTH0bgxS987ZlIzcRTtJpD-_OQww&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3kbDj9gaCP6-1Zl5YZxK-Q-F1V2PtNvF_W5VF04Qchg&oe=6ACD083F"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpSBbYabuHYQ7kNvwEDUEOD&_nc_oc=Adq1t5PRWNNu_gqKSuEbIHKIkxxJmjqV0i8iZDwpB6SkxpJzyjUcjKWqmUR4iUqaXnU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOT8sPPduU_UHS2iaSUAV79Zm-w7vE2SHzFVbESPfRylg&oe=6ACCF97A"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0p8RE3dUG0Q7kNvwHeM6Fy&_nc_oc=AdrD-3zbt8SSLGHaNCO1d9bL1kjYzEi6zSrPafIgPQZfg7GkzjxOqLUnfJRF-GP4HI4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEd6QQfsuIkHiTP-bQcTcuBOdR5eQIX-aUSce_ddqS2w&oe=6ACCFCF0"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mYPKlq0r4EQ7kNvwEHxINq&_nc_oc=AdrU69amhl94y8Wh1OUjq62nqN-hPPsvk5K2ZRiJE8rohlTntaD_gG1Z6DtI__TLy_g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhh2AfAdiYeYJGWiQlLiAn1uru4WpbNdG8Gh6eu9DjQQ&oe=6ACCFAEE"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPIObCLRCl8Q7kNvwGFQVuA&_nc_oc=AdqAJ0AioeuqhoqRAuBE5nORlV1g7K1oh3iJT2-M39tic2rkiOIZNhA3_rgVXZrewfc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPg1ilm3QSLUDCSwp-vuayd3mn1Jul0DHyzLTkNAU0_Eg&oe=6ACCE175"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
: "en_US", "screenshots": [{"file_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3krWZ04R-28Q7kNvwFtQtCP&_nc_oc=AdpeRCQ2a1qMoKusU6CpOEdZabNC32c3FFadesn2dZEu7ycKOFpxmy-IR5OqevxcaB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLosf41GnV_5x3sNWScC-wW5V45Dapzqao_MxRLt7t04w&oe=6AA6947F"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSVTQp2qDDQQ7kNvwGI9ptG&_nc_oc=AdoTNZa3JCFbaCNb5LpUVFd5jyKhPo22sBE9nxV5J5-1qeNcEQU7v6Pu2xNYcqQnvmQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIt5cm-cq6jm4F37y7W8lcunbxU7kvIkEzWlHIfm7LpyA&oe=6AA6BDFA"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMJNI0KjJcMQ7kNvwElzaU7&_nc_oc=Adqjyzc9P_0ty1k9G2Z2D8Vq_mpVilDGvZt0N8yaPin6yU1Gp5190JDIn4qd6l56AwA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYW2XpKNUkDd1QRUnilIXpCFyClxa1GAg3fIlZj2of1g&oe=6AA6C170"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Siu5TUmHJkQQ7kNvwFiE6Sn&_nc_oc=AdrGSfm2eN4k6Y-9cWF4bJ_9XAvXkxY5O8aRaw4nGe6pscqvxjpcsaWB3US5-WRFgG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdutmeClu2EmR1iUoaNjk1nfx_BWb8ivtrOq-D1gdW1g&oe=6AA6BF6E"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4rUACNE60oQ7kNvwFQTcl_&_nc_oc=Adp0b-dTPUU-Wol6aMVqAI9303SYHsO5dN5ORqvTp5927koT9UXc2FJccCTIjxPRYyU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfkuqp8b_P9ocS5y1Pk20hriAHo33PKFdY9ROzpKqsvA&oe=6AA6A5F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
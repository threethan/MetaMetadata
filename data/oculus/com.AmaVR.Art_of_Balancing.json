: "en_US", "screenshots": [{"file_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bjn5cpmBsAkQ7kNvwGC0LaZ&_nc_oc=Adqv1ZuuZLf88HIylc5PLm7G5bx-V3BMcSu5ohwY2qPACS2CSqHzQmJnRzMlepLfXrE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-1g7tkaTPYzTj-Lj-4eS2jKVuYvQtEYwsYmzYJoT3HQ&oe=6A1EC9FF"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zERkfSBszsQ7kNvwH4daA1&_nc_oc=AdrzWOOt6Q0QX_evFkpqyeWuj5fB6rzM831jF_jlXYoTpDCwgaE0yR1A-O9rjhbpbD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55P_FCavAd-A3ZDuA0oUszbcJfyso86wlJpjDrInhD_w&oe=6A1EF37A"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u10q4R8iTbgQ7kNvwFSC_Zd&_nc_oc=AdobhlLgoG9NiGfX9hqU583OkeDOebN5GkkTodjLl7LiL82FGke3GSQZgS9xztuwMeM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61lGBzWjvImPzh4ugl27rz_eKvuGCAxodeIqSeNkCZeg&oe=6A1EF6F0"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQe0QhkVql0Q7kNvwHLUPN4&_nc_oc=AdoJKqGBHeMphIkwPVyGLtrPtzgry03rEpe6_prYxogtAp2yvZSMgNl9oTvyOZrFfbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dYEf0ONoUQ2U-EX8HoJJdWmRAVk_EZdnrheXCqZ5CQg&oe=6A1EF4EE"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KC2B89HQ_XEQ7kNvwFZMpUq&_nc_oc=AdoKO3RxVLWh3rJhGOHYqAatTGplAas5qqebKqJbV2kHW4LkPAomVr3LUi5VxdIhWLM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59f3BOve0sJb8oXBH-Gb9raG5MKBHf9B4EHp5SBxIq8Q&oe=6A1EDB75"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
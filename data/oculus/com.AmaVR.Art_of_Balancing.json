e_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0VrTFnOmGwQ7kNvwH2iwVr&_nc_oc=AdktYiMbhs_pboGWZvW2mX6acWppM3iypTHQCzPwbxK7MccL2ehjMX_aWe1u4kQy160&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfymZ_mQgGg_XmXv0I4hg1I215M3OQUrfSlkmT9guOj2bQ&oe=69B4007F"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhs4IVLXLOYQ7kNvwEvDd18&_nc_oc=AdnKkpVNwfDCpZzleHCkxHkPbDBwe00IpUwZHxV2S-i9Iji6bf2oFYC4powb1zHqLS8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx1zCkUynErNLoddFB2u0zV4Qsr7TJm2p7X9cwBKIykUw&oe=69B3F1BA"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTrcZGjtt04Q7kNvwFQkn8-&_nc_oc=AdkBvhdJ_MOqesvcfSmEa1qVMurC05lWHoFmXlkhlvIkU1QoqFwWhWHgSBlYfPqbURY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZY__o_66LDYU3WudZmI8iBkrc6hE9bcFTQo-fcEFgqw&oe=69B3F530"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJwWITIwg_QQ7kNvwEdWDzh&_nc_oc=AdlvB63AY22vyOm3sJBT7cYF-MaA-xfKWG8rxwit1tir-LuutFh9snpPoHf0hiCXhSU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwhEjm1z7FmNQQ1HLsqvFc9d3D-AznrUrr-ORXAIQ_kOA&oe=69B3F32E"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9659QXjkkMQ7kNvwEWFM8c&_nc_oc=AdmCa3FlUGWU1106-oSjcwH2mZjuHgxwD5UqfBlZbWNDc9ZHXXA-izOg1F-fijVJWGw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyf__Ta-WIXp8t8Lq6YryIAiaKmVzdfiVbkIN0Ux2WifA&oe=69B411F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported
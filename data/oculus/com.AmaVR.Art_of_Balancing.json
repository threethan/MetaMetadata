e_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUNsyz4RZCMQ7kNvwF0kH0V&_nc_oc=AdmjdxdBIAb-lRytIJFzdrvcz6ntU_nJ0KeT27nu-pOkjgs5sfwEKS0wKEvxGj1w7jw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvxDIPoV41Zrdz-NsPRAltvKlkm2GvdtOS9jQV-zUbpQ&oe=69BFDDFF"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmrF1R8wJ5cQ7kNvwH9LYEg&_nc_oc=AdlNxaT5D1xc_HjjF-20hpZqeytGzq8z42UABha_uWP3FMUdWyr60zq2AGdPwdhcZig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWKoD32kNUJZ5BzGpHS8ezZzGab0rD8gVScwrHRWx89Q&oe=69BFCF3A"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYKVOOGjj5AQ7kNvwFJN0CV&_nc_oc=Adku6U7r_HY3Eepn-aBEOe7UaXd98s-cw3NQhNmOWDaMWKViNx4Rm0E_MOojl0iER0w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyb76DPkk3FmUECwbEb6nfMz2ePZ_PZxBcJCZzN5zY2Og&oe=69BFD2B0"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLh6IB8kALsQ7kNvwHBeOvA&_nc_oc=AdmbBNf5N92-KyKxYd0udzKLCupvSkfvarIlGuHd3RM_AplloQIgZYbEYtVNJG0esds&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz1JrC4yp1o2b9kadkjRkIBAWU7Box2SzL0mB88C6sI4w&oe=69BFD0AE"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLV5k8FKRSAQ7kNvwH3Sqrt&_nc_oc=AdkXKo71V1S7WtEohV0xzdo5WiBCrfz_AyunwoIU1Y-UK1TeLyTzst3uL1JXCyTbEfo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyF7fIgA2aDdj3u--gArYLakfggQ52Iy-koG_2gFs1o7g&oe=69BFEF75"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported
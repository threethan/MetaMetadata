ontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzttS5-vO1cQ7kNvwGHpZ1o&_nc_oc=AdnOgN5bH-PS9wZ8tPaG13aO5cbRN3g0DBUKQxXbn4HLicuSpRDTTTtuulZHnQa_io8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftVdXKnWLq9_f2oJE-8qXcTVfrxbIhaOiRq5pZGllF2iQ&oe=69A039FF"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgNJU9pC8XIQ7kNvwHvwrDW&_nc_oc=AdksP5bQeoH1Y37IkdOKlvt3U497By31tSrqa8t9dSt7fqpYfx-_H5rbbxRos6x2Ndw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfssqhIjq47_7NeTGeBUdxwWO345uXj9cjA8feeBkuUnmg&oe=69A02B3A"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad0WXTR_g68Q7kNvwEKM4zG&_nc_oc=AdlVhrjItyweiy57jpZ20k67nbRo__hoWaHIWkcq0F0erloWWOQWaexrPv2LCrF_OeE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfulQAy41QtsCRIvGULGGr-eow9mfJq_OCduQ7SjQcSTSw&oe=69A02EB0"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K97RxUAuPpkQ7kNvwFCDt_0&_nc_oc=Adkrx5UPyN8ccEKloW_J5SSxwZQ9vQi7ayGgS42SrblK8tx_J6Zt12sSv2e7-mUXT8I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsaW1BV3ygzAWBsR-264H1gY4ciunmZr5Ch1OgJV6sh9A&oe=69A02CAE"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJjYgb5AbuwQ7kNvwHzmPMq&_nc_oc=AdkLqc69O4K-d7lAUrj504sCnu2JpyRJdPo8KKHfVRii6w3OAqLX2CE-ruhCouF55GI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsLW-Km61XHNPy2WA71jkIa6E9MwsNs7kSRr0Ca5GKCeA&oe=69A04B75"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "
: "en_US", "screenshots": [{"file_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuAfxpI5rNEQ7kNvwFVIxX8&_nc_oc=AdqOgFsHu1Vrv6ylckppyILG1hLzHPNXPy8oX7K4dsHRTC0rx0O1R2892XT1f3uudKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdakWDZZtNEWFdZ35RVgKLP6P9BYICHcN0lBs9v293Xg&oe=6AB3C37F"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgG5bKuyTkkQ7kNvwGLSYMh&_nc_oc=Adom64ewbwUQTuDJvoCPahQjAaFNk29A_PaoRe1or_41kEfRBFbBozgkf-GxU9oNQMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLH68BFM3rBxsJGY7wwa2ppreNVVufgQap_yKUC-JKbA&oe=6AB3ECFA"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hulcp_HOSjsQ7kNvwFj3zmm&_nc_oc=AdoC0n1oRDIdCod3o5I_ZRKKA3B240DWae4fidDUwKmFkX66SklcWWTesFzs4CHfu2Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwq1IsIOI23-8VeHJwkHR7_--nWSFEXZur-tbhlKJuVg&oe=6AB3F070"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC_Mc3reBpQQ7kNvwEzSrhe&_nc_oc=AdoFyr1IH_FudQbmM6EpWwM4a_Ong-0j1pMo3uQFyD_OFXRrKXgfZQw3-cQtUyCqmiU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5HAWWiK5z_I9wfiyoUGv0HkaYnf9J2F8Mi8sZTcJTXw&oe=6AB3EE6E"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNoDBG6t7EkQ7kNvwHxbDCb&_nc_oc=AdowxNEE7M8u2ZtygHDap1XZ4sDA5jFAo8x4q1hsQ9-tNO7D14vCwSuSB9VQGwlhR44&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJ7RY_J9lxmjtgYJNGqnbR19pX2KyOcEyesuswK6p_IA&oe=6AB3D4F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
ale": "en_US", "screenshots": [{"file_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlCI1SwzMZMQ7kNvwGr_msT&_nc_oc=AdpdvoJM760yblZb600ppp50jgIb2PvbcNaFxhgq6D8m6-MjTPkRffMvvqBnE1SZ4tk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_DC1KEG1saKZRxjOTyadaExJI-4ZqkC3JyI4I-Oe8Ig&oe=6A468F3F"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ycl7N4UiDUAQ7kNvwH4yYI9&_nc_oc=AdrfKpZagWaoMMAWrBx0S-7MG1mB9T0G6IxSuyAYESE4J6JzLnQIBavNwT8wAZB1hwg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92Mi3Q6gthqgvfsHJnnVaOAsifJ4SyU2TG1t0sptlZ4A&oe=6A46807A"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lApQHJvPg0EQ7kNvwEr-ebX&_nc_oc=AdqfLnMsDUpszj1MMzRwbhEfpm0g8P6V7dzIeSAsGqfmhsrBSx6bu5fwZTaA9vymQcI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af840mncAhAXXfRZ8b8r-p3-uo46DjvUQ-DW_WH8rDjldA&oe=6A4683F0"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaH_fPIiJloQ7kNvwF5czSE&_nc_oc=AdpZgRMCb7ibfZpsUErzdSFICfdzAXSgIdopNUmmu1Zn7YrC6u4WuNQ0Y_D7k-HrALo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7XbIGtL0Mo8K0WXq-PtyCOqbpfdXpscIInoQfKJ2-Pw&oe=6A4681EE"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WPLuUmZBlkQ7kNvwGwmoC6&_nc_oc=Adrf_OSGCCEt9fAKuqGrUGtmNMrUX6jZg5OCchMaoO0IVBl_K4ghonbQKcpBewboY1I&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rax5QjeToaDiCyvs0GPNeaU2HmZkJYrW5FJSPn2UYYA&oe=6A466875"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"
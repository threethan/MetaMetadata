: "en_US", "screenshots": [{"file_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WO66NzJuy7MQ7kNvwEptOiN&_nc_oc=AdrnuLPZSvzX-2EXHFpVdWZIGlHqvDv6Mc8QENcO7IEU3s-QMUWdVgHMMoTQ-vlFC2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx2Y-r1wSjQcYkhb2LZiFXeH5KSI_UurZWZqhVGQ_-Ww&oe=6AF889BF"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiiZpoja-DAQ7kNvwF4qc1U&_nc_oc=AdqDAlSOpscLXBIIAiCG3z4zVZQrPrb05U5jmUcouU0QrtXKSJe5XNzgiih7N95N4i4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-MBTPG8ygUNzVLICo_MEw7SW4hozen3fFEOOp8KE9ng&oe=6AF87AFA"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1AV9-IHuTsQ7kNvwEVVAnn&_nc_oc=AdpyUwHdsSvYG-vapvnP6xvLUpprd20oFE8wgnVN7jp0L2_okSSVNnx7kz2nFA38f8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuGb-TkoYYkjUFR_R-LbYLz67LFCfoDHx9lGSUFayiVA&oe=6AF87E70"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FX8B0V_FrY8Q7kNvwFXA8U9&_nc_oc=AdqeMq68-y8jIfBr5wxCn-SfDYaFGzcQ-14Rmt8mKqo7je42AeV5V89jiIpf6kzt4N4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjdJkacIXm50b5dAUBuD5mOHOFAo64Y7jj1ycOf9tqrg&oe=6AF87C6E"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7JVioaFCGAQ7kNvwHoNUbl&_nc_oc=Adre5DBYp34PHL3jzP3GH0WtbuEnHzEknultXx4ozLQu2es9vmTfX1tkPAWWbYE6zaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1YaGmx1VrU9jBn5JGS2w055LifPUHD02AODYNd0mieg&oe=6AF89B35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
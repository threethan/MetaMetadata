e_name": "ScreenShot_1.png", "id": "255602846281067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458097_255602849614400_8966799032844768292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EfPwFoGaFkQ7kNvwGsX6zT&_nc_oc=AdnHznLs1dsw58TSxoi8gEzw2jGlBgZh1QO-o_VrTCH2Mr95fD62tEyKtZETGZuCIGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz7TzufPI7AV7rBAgfmCKS_RnQcFgCa1fvyFZX60_yang&oe=69BBE97F"}, {"file_name": "ScreenShot_2.png", "id": "4236566259704980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75404381_4236566263038313_8118118772047609547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bz-O_Pj83hEQ7kNvwHSck07&_nc_oc=Adk5gdW0gIeSHJh-UecrzX1P-d8hRQY1zO4y_-UUJkhNxyimjGJLq8L_qaCHTFtFamY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx0CBYy8ANpk3g4guIqjrM2ujAjWQbPynRXTBvot4Bu1g&oe=69BBDABA"}, {"file_name": "ScreenShot_3.png", "id": "422188228843788", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404370_422188232177121_3120282046784821020_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8t5mQ1pwUyAQ7kNvwGDM3T8&_nc_oc=AdlS722Of61tRf29R6WdkxKFy8QWl8dQ44a8wlZbIMxH-UcTd7cBKXyl4btVvBWoSxM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzBO2MvRjacieIeKl3-CsSMVM8Fggilpir7iLo-vnAdpQ&oe=69BBDE30"}, {"file_name": "ScreenShot_4_1.png", "id": "1599711943752549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003273_1599711947085882_701139155010109058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtEZZ-vyeNgQ7kNvwEmdik_&_nc_oc=AdkEsB1wmU5r0xSG5P4ZNeZwVbIBIgOieKXwpUXmIcJnoky-aAdjY9puCasmzghCxHc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwV2_Sz1kpXvXo4kpxy_tuyO-7_yo3m1gbACeh6FgQp9Q&oe=69BBDC2E"}, {"file_name": "ScreenShot_5.png", "id": "129317875732014", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75299157_129317879065347_2083993127004899267_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzHU-1q3CYoQ7kNvwGD64kf&_nc_oc=Adn9b58Jgv-4ySDAp7CtvBxGmGdwqi4X0sQC_mfRzcsDxyfyKF6WQpns0FGoRx75y2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUna_poxGXtImBoifZUyfJeci2BMIrsxBuq-ycuIXtJw&oe=69BBFAF5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art of Balancing", "keywords": [], "long_description": "Atop the sea of clouds, there exists a garden where the past and present intersect. A space designed to preserve our collective story. But decades of neglect have left the garden barren and forgotten. Now it is up to you to restore our connection to the past by creating rock sculptures that anchor our absent-minded world.\n\nIn Art of Balancing, you are a rock balancer making your way up a mountain in search of the garden. Along the way, you create rock sculptures. Picking up stones, you feel their weight, hear their voice, and find their balance. A collection of carefully thought out prompts will then guide you to reflect on your past and embed your personal story into the stone.", "short_description": "Master the art of rock balancing and restore the balance to our world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amavr.com/privacy-policy", "developer_terms_of_service_url": "https://www.amavr.com/terms-and-conditions", "publisher_name": "AmaVR", "support_website_url": "http://www.amavr.com/connect", "website_url": "https://www.amavr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported
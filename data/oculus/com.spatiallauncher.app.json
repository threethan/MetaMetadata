a5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlbf78-AO9m6FlZMUz7ex5inZb5GGjkJNPvpPMzwmx3Q&oe=6B09C54E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "1606634827037310", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/753032404_1606634830370643_584397501965421647_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9-_YHice7IQ7kNvwGRwubF&_nc_oc=Adola0SV_TT2esCaeOX88TDTtGZaM19jXCcZM4ZrrCTFyNLUivhnggZMQymUDE7R9YU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6bMB5smuX9XNmHaeyHCQjfE6tBzIr9RwN5X05LiCqww&oe=6B09BACF"}, "display_name": "Spatial Launcher", "keywords": [], "long_description": "Spatial Launcher transforms how you interact with Android apps, web tools, games, and e-books in Virtual Reality. Built from the ground up for Meta Quest, it provides a seamless multi-panel spatial environment paired with real-time 2D-to-SBS 3D conversion, OCR zones, and offline text-to-speech capabilities. Whether you are translating untranslated mobile RPGs like NIKKE, inspecting visual UI elements, navigating web tools, reading e-books via local storage or LAN, or listening to live translated audio, Spatial Launcher gives you complete control over your spatial workflow without breaking focus.", "short_description": "A native Meta Horizon OS panel application for Meta Quest featuring real-time 2D-to-SBS 3D conversion, optical character recognition (OCR), and text-to-speech (TTS) capabilities.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/saogalaxy/SpatialLauncher/blob/main/docs/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "Saogalaxy", "support_website_url": null, "website_url": "https://github.com/saogalaxy/SpatialLauncher/tree/main", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "43496192
nAQ7kNvwElC2s5&_nc_oc=AdrC4RpA412l64ZipdXBmVVfra6VWrdmsaR4HB7S1gLvhONX7NCGDpqifW1jxlftplo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkht-MXEovll8aidJTris2BbsFvpO8a-l97VYcBpS83w&oe=6AF9D2DF"}, {"file_name": "07_shopping_pick_greener.png", "id": "2482082675649478", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823940_2482082678982811_70520243533943053_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7rWR3CTBtgQ7kNvwHmO5z2&_nc_oc=AdqA8rjHcD6UEwMoScHGNY3xw6s9OE_nVEHfn5WuuUs6Hfiocefk-Y3UZXqP26OeCWg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2rg9N0T6-2knen2ctu_OvNhhV-7Gtbku9QSzS92U6JQ&oe=6AF9D4BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Language Leap", "keywords": ["English", "education", "ESL", "vocabulary", "speaking"], "long_description": "Language Leap helps A1-A2 English learners practise real conversations in virtual reality.\n\nStep into six everyday places and complete simple tasks with friendly characters:\n- Hotel - check in and get your room key\n- Airport - check in, go through security and fix a missed flight\n- Restaurant - order a meal and pay the bill\n- Shopping - the Green Cart Challenge: choose greener products\n- Banking - The Lost Card: report a lost card\n- Hospital - The Sprained Wrist: talk to a nurse, a doctor and a pharmacist\n\nHow it works:\n- Speak or tap: say your answer out loud, or choose it with a button.\n- Speech recognition runs on the headset. No internet needed, and your voice is never recorded or sent anywhere.\n- Hints and voiced lines help you when you are stuck.\n- Use hand tracking or controllers.\n- Comfortable: no walking or moving around. Play seated or standing.\n\nMade for school students and teachers in language classes.\n\nLanguage Leap is part of an Erasmus+ project (2024-1-NO01-KA220-SCH-000255355).\n\nCo-funded by the European Union. Views and opinions expressed are however those of the author(s) only and do not necessarily reflect those of the European Union or the HK-dir. Neither the European Union nor the granting authority can be held responsible for them.", "short_description": "Practise everyday English in VR. Check in at a hotel, order food, see a doctor and more - speak or tap. Fully offline."}]}, "developer_name": "Rafora", "developer_privacy_policy_url": "https://language-leap-privacy.vercel.app/", "developer_terms_of_service_url": null, "publisher_name": "Dijital Giri\u015fimci Yenilik\u00e7i E\u011fitim Derne\u011fi", "support_website_url": null, "website_url": "https://panel.raforaxr.com/tanitim", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1364546983401197"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827567_1872883274092865_5871315596675858061_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfwYh7JuVE8Q7kNvwHoB4NT&_nc_oc=Adqo87EmltWLRSgk3dap9d2j8n5qS35ZIruTChEj-wTKh5ZskPQQNivnna9LIIuO6RE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI_QNuEkhXjS-ERw4XZrMm0jUX4mJGy7NjMpCf-l0TXg&oe=6AF9D05E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Language Leap", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_to
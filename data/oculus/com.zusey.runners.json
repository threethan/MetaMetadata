gnificant expansions, the game continually evolves, offering fresh content and thrilling adventures for players of all levels. Plus, as a daily bonus, you receive 500 ZuseBolts to enhance your gameplay, unlocking new gear, abilities, and more. Dive into ZuseRunners today and start your journey in a world where fun and friendship are just a game away!", "short_description": "ZuseRunners is a vibrant multiplayer experience where you can connect with new people and forge lasting friendships while having fun together."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zuserunners.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pulser Games", "support_website_url": null, "website_url": "https://zuserunners.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25818634857804064"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473397232_9182115191872420_4749402997893102057_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T50SeR0EBcEQ7kNvwFhdU13&_nc_oc=AdkwXW61WFqcN9Mmv7Uj_2noVjg14V13UkLmc9jEsEnmG7MuzsQCkKgHPpvBm7s0oz8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv6kWbhbQkndG1gdT27UOGvfr6RqdCEzm7f9rBrazA0BQ&oe=69A584D7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ZuseRunner
fQH73vFjnYvWxIxGbT6ra0Lg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0BpSBEKwg9mY4TiqXjyFc-626PVbYDGK3a1ZoOjTFuA&oe=6AB3E4B1"}, {"file_name": "SS_4.png", "id": "1535148197728784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1535148201062117_1922824099542313681_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6tHut5iyTMQ7kNvwEtQfJn&_nc_oc=AdrDgkdhBd23ZjRk9QTMFePyIjBX7YCspyCGM6NhzKc6e3rIpLzhlvXn-lyemBD781w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpFxwcIQ7F3AfQeymEW7DaHFz12RkDyznR-KczCt8Lng&oe=6AB3E75A"}, {"file_name": "SS_3.png", "id": "804098198884747", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823930_804098202218080_279837513749140826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtC9iBC0piEQ7kNvwHiG8uk&_nc_oc=AdqEqrzz9AZ40cjY2MfXpVi7p4sHHdprmUpG5lxeTm6Cjafcch73M8oS27Z6-GLGhcM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcyh8PgzYMaNITQihzOjqIjJaNJlPfvYVp6gaMFRs5Cg&oe=6AB3E7DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baby Hospital", "keywords": ["Game", "Baby", "Hospital", "Arcade", "Management"], "long_description": "Welcome to Baby Hospital, where tiny cries meet big hearts!\nIn this arcade idle VR experience, you\u2019ll step into the shoes of a caring doctor running a bustling baby clinic. From curing common colds to calming fussy newborns, every patient brings a new story \u2014 and every successful treatment brings your hospital to life.\n\nHire helpers, upgrade your equipment, and expand your clinic to treat more adorable patients.\nAs your hospital grows, unlock new treatment rooms, playful decorations, and advanced baby care tools that make your clinic the warmest place in the world.\n\nWith intuitive VR interactions and idle progression, Baby Hospital combines the cozy satisfaction of management games with the joy of nurturing life \u2014 one giggle at a time.", "short_description": "Step into the world of Baby Hospital, a heartwarming VR arcade idle game where you run your very own baby clinic! Treat adorable newborns, upgrade your hospital, and become the most caring doctor in town!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32204924355819951"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32937514025894310", "version": "0.3"}, "id": "1487130782500872", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32129591486686572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "32937514025894310"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "148
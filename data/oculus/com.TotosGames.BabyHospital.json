2206"}, {"file_name": "SS_1.png", "id": "845207234513599", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818849_845207237846932_4954526904505775839_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NJ7QVy_VY0Q7kNvwHbw7nM&_nc_oc=AdrnNLnWmCqsyZsy3Um2oIUp2P7Q6JT_5J9RyaRNDJur7x7pz2TMy4gwQcyuB7rX2Ck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjm3465cbR0IwZAcwHdZe-z5RjTb_RGNKm4u-rsEHbvQ&oe=6AF72131"}, {"file_name": "SS_4.png", "id": "1535148197728784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1535148201062117_1922824099542313681_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZCg95mPETMQ7kNvwFOG0A9&_nc_oc=AdpnhaVcDI280l5NOeTC-f3DmuEvfyBOEsP3wcA1PTiMKrfaU1QFSvaiV9A2Pd2L_F0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_f9NbP5AVw5Tq2yE9-Cv0DoYi8rWJV6K9sf0l-ddY0A&oe=6AF723DA"}, {"file_name": "SS_3.png", "id": "804098198884747", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823930_804098202218080_279837513749140826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMLcbiTDVJoQ7kNvwGg0Let&_nc_oc=Adpe0hixkVwSz_AxGJluDkr_Iyq9EL_Kn3IlaK23Jf9G-jKpSwyQGjU5vFk10nRZr7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsEMOxmdl6R53fxKhtrn71_E5MNj_zs1wb9mKe2EdJAQ&oe=6AF7245C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baby Hospital", "keywords": ["Game", "Baby", "Hospital", "Arcade", "Management"], "long_description": "Welcome to Baby Hospital, where tiny cries meet big hearts!\nIn this arcade idle VR experience, you\u2019ll step into the shoes of a caring doctor running a bustling baby clinic. From curing common colds to calming fussy newborns, every patient brings a new story \u2014 and every successful treatment brings your hospital to life.\n\nHire helpers, upgrade your equipment, and expand your clinic to treat more adorable patients.\nAs your hospital grows, unlock new treatment rooms, playful decorations, and advanced baby care tools that make your clinic the warmest place in the world.\n\nWith intuitive VR interactions and idle progression, Baby Hospital combines the cozy satisfaction of management games with the joy of nurturing life \u2014 one giggle at a time.", "short_description": "Step into the world of Baby Hospital, a heartwarming VR arcade idle game where you run your very own baby clinic! Treat adorable newborns, upgrade your hospital, and become the most caring doctor in town!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38926487033663616"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_852849194413973_7462606832826973173_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dT1xieFbBsQ7kNvwEDsluR&_nc_oc=AdpqX1GCp3WiTBHuWXzuZT9OS_xEo1jmhloh7S1dFxBSDpW9QWtYj6RNeNBbDiM6UIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHn2amygXaEty651EfMuABrtr1548wHr5SZgH64vNtGQ&oe=6AF737C4"
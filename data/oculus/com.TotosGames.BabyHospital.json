hldmv2U884wEfGj7Ag5CcrSEabIl3stSZgaSX1OljJcW38UQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgaZcBoebGOPm7bp99nsjMOD2GagRwZ_3A5C6R5Mk6PA&oe=6A7D9EF1"}, {"file_name": "SS_4.png", "id": "1535148197728784", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823757_1535148201062117_1922824099542313681_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjlV9gEPH9EQ7kNvwEWY9Rt&_nc_oc=AdqR4g-QYTzkhIWoUzC3Im1wE4aQw7uhVQhpAgka56uliWM5Oaq-teyCICn4VtgIg2U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8pAgbzMxro2_HHrGncx2fxXgpdGmwUX_oSGF_GsPgdQ&oe=6A7DA19A"}, {"file_name": "SS_3.png", "id": "804098198884747", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823930_804098202218080_279837513749140826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sS2gXv_FGJMQ7kNvwHQDyzc&_nc_oc=AdrVacUB5Rq1kyOgmV069_GAzqP6x758Y_p8t9nwfDvuUyM2y6EyAdIGRsBg5lSJZlI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi_cy1-sHR4KR-ETf0WK5LWrJrV2uENBOc5l4Mq5oCWg&oe=6A7DA21C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baby Hospital", "keywords": ["Game", "Baby", "Hospital", "Arcade", "Management"], "long_description": "Welcome to Baby Hospital, where tiny cries meet big hearts!\nIn this arcade idle VR experience, you\u2019ll step into the shoes of a caring doctor running a bustling baby clinic. From curing common colds to calming fussy newborns, every patient brings a new story \u2014 and every successful treatment brings your hospital to life.\n\nHire helpers, upgrade your equipment, and expand your clinic to treat more adorable patients.\nAs your hospital grows, unlock new treatment rooms, playful decorations, and advanced baby care tools that make your clinic the warmest place in the world.\n\nWith intuitive VR interactions and idle progression, Baby Hospital combines the cozy satisfaction of management games with the joy of nurturing life \u2014 one giggle at a time.", "short_desc
.oculuscdn.com/v/t64.5771-25/491823757_1535148201062117_1922824099542313681_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJCNleJ0J3IQ7kNvwHLqnSa&_nc_oc=AdqTsf9wovri4FcPa34fXUJ6uV04O_uurRp1ZY2p13wxIOudvGgtWT6ij21DVhVgap8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzrezktOyaEYeerK8Dp21NHpZFtGe3XwdDIOpcqd81Qg&oe=6AD0E85A"}, {"file_name": "SS_3.png", "id": "804098198884747", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823930_804098202218080_279837513749140826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nwiwxHPOkcQ7kNvwF0CvLN&_nc_oc=Adqa9yUCAl5taAAFzQP3TevBcToyldn6jh0URsfrCJLVARDiVA4bpzjhZLCCXkfuo4g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPF3mdz5QSt0bGlDz_nOS90PNPCjD5N4sXNYjq9wwE_uA&oe=6AD0E8DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baby Hospital", "keywords": ["Game", "Baby", "Hospital", "Arcade", "Management"], "long_description": "Welcome to Baby Hospital, where tiny cries meet big hearts!\nIn this arcade idle VR experience, you\u2019ll step into the shoes of a caring doctor running a bustling baby clinic. From curing common colds to calming fussy newborns, every patient brings a new story \u2014 and every successful treatment brings your hospital to life.\n\nHire helpers, upgrade your equipment, and expand your clinic to treat more adorable patients.\nAs your hospital grows, unlock new treatment rooms, playful decorations, and advanced baby care tools that make your clinic the warmest place in the world.\n\nWith intuitive VR interactions and idle progression, Baby Hospital combines the cozy satisfaction of management games with the joy of nurturing life \u2014 one giggle at a time.", "short_description": "Step into the world of Baby Hospital, a heartwarming VR arcade idle game where you run your very own baby clinic! Treat adorable newborns, upgrade your hospital, and become the most caring doctor in town!"}]}, "developer_name": null, "developer_priva
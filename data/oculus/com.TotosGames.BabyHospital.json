content-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZPC39EiWTh5MIvW6s24VYzhAUbtDkFAnhEvOb6YVm6w&oe=6AE4AD06"}, {"file_name": "SS_1.png", "id": "845207234513599", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818849_845207237846932_4954526904505775839_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCoy_phUNZoQ7kNvwE9oMTp&_nc_oc=AdppjQedM_nldu1LDlmnbTcOZhOwMYgFDwAMD9se1OoEmLwhPI8kM8Zqgg0fXNie_jI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYARsTqL7YfNM8tNbPLlOJEyvslQxplcjYwYDbZWeX1A&oe=6AE4AC31"}, {"file_name": "SS_4.png", "id": "1535148197728784", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_1535148201062117_1922824099542313681_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoWypz9iWvUQ7kNvwGuHPWN&_nc_oc=Adp8YzbSkUYrYzbAkANXuMZJJkXuNbjFM_x3wJ_lXhk0-RhupY1wAm5a6b9FkVEWq1w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxpiOYDoGTnZq6F-y0XqFCvSReCwcJdoLNbTPGuCpMpQ&oe=6AE4AEDA"}, {"file_name": "SS_3.png", "id": "804098198884747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_804098202218080_279837513749140826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PwTiDu0DhYQ7kNvwEG02gF&_nc_oc=Adpr1K1VVPuiS06zR7xNws28E7qMHoxV6MofWga0ZhgXHagvnaSxoZqF35HjueGtRp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPO0b6WgKe8iQy-VubIMPJqSdBnMaN2zirx7dNIBxhjGQ&oe=6AE4AF5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baby Hospital", "keywords": ["Game", "Baby", "Hospital", "Arcade", "Management"], "long_description": "Welcome to Baby Hospital, where tiny cries meet big hearts!\nIn this arcade idle VR experience, you\u2019ll step into the shoes of a caring doctor running a bustling baby clinic. From curing common colds to calming fussy newborns, every patient brings a new story \u2014 and every successful treatment brings your hospital to life.\n\nHire helpers, upgrade your equipment, and expand your clinic to treat more adorable patients.\nAs your hospital grows, unlock new treatment rooms, playful decorations, and advanced baby care tools that make your clinic the warmest place in the world.\n\nWith intuitive VR interactions and idle progression, Baby Hospital combines the cozy satisfaction of management games with the joy of nurturing life \u2014 one giggle at a time.", "short_description": "Step into the world of Baby Hospital, a heartwarming VR arcade idle game where you run your very own baby clinic! Treat adorable newborns, upgrade your hospital, and become the most caring doctor in town!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32204924355819951"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2009864553292869"}, {"status": "PUBLISHED", "id": "1381701843413709"}, {"status": "PUBLISHED", "id": "791765310498215"}]}, "baseline_offer": {"id": "791765310498215"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "2009864553292869"}]}, "liveCha
d0RTViwjwfXMT9yG8CpECIEWKAmHQgrcJCpE3R6SvXgALg1Y&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e1wj9JNjCZ7uTuKOnju4_LUAzFpmN758tnGeJ_ktLgA&oe=6A36A631"}, {"file_name": "SS_4.png", "id": "1535148197728784", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823757_1535148201062117_1922824099542313681_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZ1vcAwLe8wQ7kNvwFB-rxg&_nc_oc=Adot0bd6Nh6i0j1CHMU6S5Vq6R1g1PjE_mXHxjFQkCK4rxSA08WUnuZ47U0alJPRgWE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DS3qMKbOcY3mZND4nx2B3hPWxYU19QnGlm3xgoFa8jw&oe=6A36A8DA"}, {"file_name": "SS_3.png", "id": "804098198884747", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823930_804098202218080_279837513749140826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5X0jQwf8bgQ7kNvwEvu39C&_nc_oc=AdquMrF49UuUFpMiYoRlJ_nFt-CyNSHHeiFK4LMepX1r8Hl5T9oAPtKYyj-KTgJ9FZs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gm0YGH00mgHqsxPbw3eTXpIywfKgb0ebZSUNr-fZmLA&oe=6A36A95C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baby Hospital", "keywords": ["Game", "Baby", "Hospital", "Arcade", "Management"], "long_description": "Welcome to Baby Hospital, where tiny cries meet big hearts!\nIn this arcade idle VR experience, you\u2019ll step into the shoes of a caring doctor running a bustling baby clinic. From curing common colds to calming fussy newborns, every patient brings a new story \u2014 and every successful treatment brings your hospital to life.\n\nHire helpers, upgrade your equipment, and expand your clinic to treat more adorable patients.\nAs your hospital grows, unlock new treatment rooms, playful decorations, and advanced baby care tools that make your clinic the warmest place in the world.\n\nWith intuitive VR interactions and idle progression, Baby Hospital combines the cozy satisfaction of management games with the joy of nurturing life \u2014 one giggle at a time.", "short_desc
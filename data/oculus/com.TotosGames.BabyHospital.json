849_845207237846932_4954526904505775839_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEDeRMwFJL0Q7kNvwEd3cPJ&_nc_oc=AdokKb5C7qnVzFDxYvJ1EGh-pjfxJQ2ESBJ6Z0MUtj86BmCLCBCcMYSiHfpUosvhlek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaPBe_NgdsxHp2iHQ4WRS8W_puP8dJlGx68Cf_wqJDYw&oe=6AE5FDB1"}, {"file_name": "SS_4.png", "id": "1535148197728784", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_1535148201062117_1922824099542313681_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoWypz9iWvUQ7kNvwHNNwBJ&_nc_oc=Ado5wBE96HBP5jyPzT8mK7j-Kz3T-haK42F5niANX44TFbn7IcS5bpqAmoY3kwy04Xs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM24hO8LOswfxGzghJ-loeww53xvpFnwXPVEge1vA81A&oe=6AE6005A"}, {"file_name": "SS_3.png", "id": "804098198884747", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_804098202218080_279837513749140826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4Xz5A6vrhsQ7kNvwFfmBAq&_nc_oc=Ado_ulSuP_aTDRq7wUuO4G4ieelSCasgMBdkOqAQt4PW3XH464gmrjC_bAUaDTpGxP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcz5Xd619mT97A-TDHB34mF7OG08D9RpwF9qWc6Q3bAA&oe=6AE600DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baby Hospital", "keywords": ["Game", "Baby", "Hospital", "Arcade", "Management"], "long_description": "Welcome to Baby Hospital, where tiny cries meet big hearts!\nIn this arcade idle VR experience, you\u2019ll step into the shoes of a caring doctor running a bustling baby clinic. From curing common colds to calming fussy newborns, every patient brings a new story \u2014 and every successful treatment brings your hospital to life.\n\nHire helpers, upgrade your equipment, and expand your clinic to treat more adorable patients.\nAs your hospital grows, unlock new treatment rooms, playful decorations, and advanced baby care tools that make your clinic the warmest place in the world.\n\nWith intuitive VR interactions and idle progression, Baby Hospital combines the cozy satisfaction of management games with the joy of nurturing life \u2014 one giggle at a time.", "short_description": "Step into the world of Baby Hospital, a heartwarming VR arcade idle game where you run your very own baby clinic! Treat adorable newborns, upgrade your hospital, and become the most caring doctor in town!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38926487033663616"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_852849194413973_7462606832826973173_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P--q7N60fCwQ7kNvwGruPmT&_nc_oc=Adp94sCnXJHcCJjEVFMlFabxx3mnaXN3P3NR6uIecGpHslUN0b056rGOnlGdYp2B-f4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnfQknSjXdh-q99tGuhRIEmSOnkuA4mTLOMcFVuzUSww&oe=6AE61444"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Baby Hospital", "platform": "ANDROI
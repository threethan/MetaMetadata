_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzrezktOyaEYeerK8Dp21NHpZFtGe3XwdDIOpcqd81Qg&oe=6AD0E85A"}, {"file_name": "SS_3.png", "id": "804098198884747", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823930_804098202218080_279837513749140826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nwiwxHPOkcQ7kNvwF0CvLN&_nc_oc=Adqa9yUCAl5taAAFzQP3TevBcToyldn6jh0URsfrCJLVARDiVA4bpzjhZLCCXkfuo4g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPF3mdz5QSt0bGlDz_nOS90PNPCjD5N4sXNYjq9wwE_uA&oe=6AD0E8DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baby Hospital", "keywords": ["Game", "Baby", "Hospital", "Arcade", "Management"], "long_description": "Welcome to Baby Hospital, where tiny cries meet big hearts!\nIn this arcade idle VR experience, you\u2019ll step into the shoes of a caring doctor running a bustling baby clinic. From curing common colds to calming fussy newborns, every patient brings a new story \u2014 and every successful treatment brings your hospital to life.\n\nHire helpers, upgrade your equipment, and expand your clinic to treat more adorable patients.\nAs your hospital grows, unlock new treatment rooms, playful decorations, and advanced baby care tools that make your clinic the warmest place in the world.\n\nWith intuitive VR interactions and idle progression, Baby Hospital combines the cozy satisfaction of management games with the joy of nurturing life \u2014 one giggle at a time.", "short_description": "Step into the world of Baby Hospital, a heartwarming VR arcade idle game where you run your very own baby clinic! Treat adorable newborns, upgrade your hospital, and become the most caring doctor in town!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38926487033663616"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820887_852849194413973_7462606832826973173_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Geo0kopMFg8Q7kNvwFx7KDn&_nc_oc=AdqPsGmzKa2SRkjepn97jM35qhh0eY9mAdwLBjn0A4dsIkvVR3HpTJndUC96gBoPeEM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZXD6MTI4lCgQ9dj0UKbXIn7aFyO3AmlusV6yQKdyUUA&oe=6AD0FC44"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Baby Hospital", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1766152020, "lastRevision": {"nodes": [{"id": "32129591596686561", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "32129591486686572", "is_first_party": false, "enables_in_app_ads": false, "is_concept": fals
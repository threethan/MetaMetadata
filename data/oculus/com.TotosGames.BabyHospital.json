q4pm1WHxEKkmBCN8iFmlnEwLaEu1a66-bQKuoT50eA08Mzmq6TxWZAr45Q2EsbyiE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkSiDJJWrWycQ1xbcff7jFjTmbOiv-5FJbzlFE8pyfgA&oe=6ACCF206"}, {"file_name": "SS_1.png", "id": "845207234513599", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818849_845207237846932_4954526904505775839_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAG8lunJlO8Q7kNvwG_qOrT&_nc_oc=AdphHrNtxffJCgiRGo-UPSHhQ6AvOBTxbkAoBp_RLJA5UDlYVYwPj5FlO_2hu2pG6zo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7AZJwff_0jJm6lEkOatXV7tOF10vS37YcmgZnhv-0FQ&oe=6ACCF131"}, {"file_name": "SS_4.png", "id": "1535148197728784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1535148201062117_1922824099542313681_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8R1ydfDkHD4Q7kNvwEjGzT4&_nc_oc=Adrx7dqurgBbWnXkBOWH1fiPg55qRyYwUA-vfLZnXsFyoyVTS4KPXe-74Az3hHP32Ow&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOur_Dq7ijl88WlQ6LqxKQFYwbSelLHRkctuTeVjnDRwg&oe=6ACCF3DA"}, {"file_name": "SS_3.png", "id": "804098198884747", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823930_804098202218080_279837513749140826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zE2Mju_QS8QQ7kNvwEXOYN-&_nc_oc=AdrV1_6zFXcsgccXiMuBxBElaRul7res76C36FDyAdPHiC0VP00aCrBXC7csC31mesY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhBwUy1a8v79UAEKYgoK-1I1ENJNRDEi_u-oH6kj3L9g&oe=6ACCF45C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baby Hospital", "keywords": ["Game", "Baby", "Hospital", "Arcade", "Management"], "long_description": "Welcome to Baby Hospital, where tiny cries meet big hearts!\nIn this arcade idle VR experience, you\u2019ll step into the shoes of a caring doctor running a bustling baby clinic. From curing common colds to calming fussy newborns, every patient brings a new story \u2014 and every successful treatment brings your hospital to life.\n\nHire helpers, upgrade your equipment, and expand your clinic to treat more adorable patients.\nAs your hospital grows, unlock new treatment rooms, playful decorations, and advanced baby care tools that make your clinic the warmest place in the world.\n\nWith intuitive VR interactions and idle progression, Baby Hospital combines the cozy satisfaction of management games with the joy of nurturing life \u2014 one giggle at a time.", "short_description": "Step into the world of Baby Hospital, a heartwarming VR arcade idle game where you run your very own baby clinic! Treat adorable newborns, upgrade your hospital, and become the most caring doctor in town!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32204924355819951"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2009864553292869"}, {"status": "PUBLISHED", "id": "1381701843413709"}, {"status": "PUBLISHED", "id": "791765310498215"}]}, "baseline_offer": {"id": "791765310498215"}, "is_approved": true, "firstOffer": {"nodes": [{"st
C506"}, {"file_name": "SS_1.png", "id": "845207234513599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818849_845207237846932_4954526904505775839_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzQgCzWpOvIQ7kNvwHylvtm&_nc_oc=AdrJx9SuCtuqgLrm9KOtGgYUl0uTJrFKSwVHCRjVNHSG9Xms7sD8HBuiVG1JPBkOE_E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm_AZS7r9oZTrfRr6z62UbNQkaPeTtvewPC6WQHLwlzQ&oe=6AF9C431"}, {"file_name": "SS_4.png", "id": "1535148197728784", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823757_1535148201062117_1922824099542313681_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI4JVWKGAFAQ7kNvwFYRgBO&_nc_oc=AdozGG2q_puELGJRUzleSSdtfZpn4toJpyMqOZk1uIyiXZJ-jmk2r3P1e-eqko7y-nI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGaIaEI_9GdjhQglR19_t9m4Xv75t2ppkCHQmW0oOh8A&oe=6AF9C6DA"}, {"file_name": "SS_3.png", "id": "804098198884747", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823930_804098202218080_279837513749140826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiS45U4pCBAQ7kNvwGPbEnq&_nc_oc=AdpC_ntObxOn50ob6XBTjqRbQ1UfJcITgfNUEOfXs_tJzF7-1LPGovlvdzzVgaxA1rw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiQtM08i39rcmosi4N5ZrlCNg3obLUvGsZjMH5XmgrbQ&oe=6AF9C75C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baby Hospital", "keywords": ["Game", "Baby", "Hospital", "Arcade", "Management"], "long_description": "Welcome to Baby Hospital, where tiny cries meet big hearts!\nIn this arcade idle VR experience, you\u2019ll step into the shoes of a caring doctor running a bustling baby clinic. From curing common colds to calming fussy newborns, every patient brings a new story \u2014 and every successful treatment brings your hospital to life.\n\nHire helpers, upgrade your equipment, and expand your clinic to treat more adorable patients.\nAs your hospital grows, unlock new treatment rooms, playful decorations, and advanced baby care tools that make your clinic the warmest place in the world.\n\nWith intuitive VR interactions and idle progression, Baby Hospital combines the cozy satisfaction of management games with the joy of nurturing life \u2014 one giggle at a time.", "short_description": "Step into the world of Baby Hospital, a heartwarming VR arcade idle game where you run your very own baby clinic! Treat adorable newborns, upgrade your hospital, and become the most caring doctor in town!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38926487033663616"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820887_852849194413973_7462606832826973173_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dT1xieFbBsQ7kNvwHEhIYC&_nc_oc=AdrOmhBAL2nlFVFGgXUlaM8ZUU3VJ4NIv1X0FNlZ9UgKIfBUqK0VTXGPMh5fo8OjDyw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTywyrpS_KXkoTLw4UrfyUlFtlZBpHjmk6CCNzAYmxeBw&oe=6AF9DAC4"
849_845207237846932_4954526904505775839_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCmT3ALLaXoQ7kNvwFBvoNa&_nc_oc=Ado4XY-A7gpdItLCD27-eXurv-Q4Uc8IOlXCkx0j2q2v7yi4-FQ2Absy1oz-YTWqUjI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRActFefn9mWdsmWqkBn5tS3UBibbKfPBiV8MvHPu6KXQ&oe=6AE9F231"}, {"file_name": "SS_4.png", "id": "1535148197728784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1535148201062117_1922824099542313681_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ywr5DUBhor8Q7kNvwGfaY56&_nc_oc=AdqNVWfH3L1eKmXtoNdOhyPB1Yp6bOJC10DYbWX6cKZaFfa_IGTEBo9kKBv0kaTbeiU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQALn8Zl2Psk2OUYu2bq4btAuotA9bBJPNo-hcW8CUF3g&oe=6AE9F4DA"}, {"file_name": "SS_3.png", "id": "804098198884747", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823930_804098202218080_279837513749140826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPwHcs3BkXMQ7kNvwHjSpfs&_nc_oc=AdoirWWRUa6HWOYLvmSk-2S6Y1Yw6DYOkbCSwZnZOZAjol6S2Jnl2sY5aWIdiroOAHs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRObT_D_fABJBDjlDCF2nka_mV9p49LtLBre3_I2Iavw&oe=6AE9F55C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baby Hospital", "keywords": ["Game", "Baby", "Hospital", "Arcade", "Management"], "long_description": "Welcome to Baby Hospital, where tiny cries meet big hearts!\nIn this arcade idle VR experience, you\u2019ll step into the shoes of a caring doctor running a bustling baby clinic. From curing common colds to calming fussy newborns, every patient brings a new story \u2014 and every successful treatment brings your hospital to life.\n\nHire helpers, upgrade your equipment, and expand your clinic to treat more adorable patients.\nAs your hospital grows, unlock new treatment rooms, playful decorations, and advanced baby care tools that make your clinic the warmest place in the world.\n\nWith intuitive VR interactions and idle progression, Baby Hospital combines the cozy satisfaction of management games with the joy of nurturing life \u2014 one giggle at a time.", "short_description": "Step into the world of Baby Hospital, a heartwarming VR arcade idle game where you run your very own baby clinic! Treat adorable newborns, upgrade your hospital, and become the most caring doctor in town!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38926487033663616"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_852849194413973_7462606832826973173_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSkK2oQOMXMQ7kNvwFhTqnO&_nc_oc=AdrKfB9DwKnfWCMbbQOfQ82buyuyVSlHapAtBk80k0_ldMofbjERVgPbubWrOfGZU_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKDJaTq4wg9wn-qsS8nszyUf-RxI9TbTk4LePB5yvxzQ&oe=6AEA08C4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Baby Hospital", "platform": "ANDROI
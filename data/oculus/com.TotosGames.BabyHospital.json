.png", "id": "1350487026869948", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819281_1350487030203281_3453616210583689412_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upUz2gRVPrEQ7kNvwGO3nm9&_nc_oc=AdrxGIBMnyo5L0s_3567BGKtWxxoegk8crcfs44ov7W9ueQq8ePbXsJt3MUdkaEgB0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMEmBaF0DbWRCJeTOV_3SRR9yEKJ9OaBbBHlpy65JcIA&oe=6B06F406"}, {"file_name": "SS_1.png", "id": "845207234513599", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818849_845207237846932_4954526904505775839_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7VfGMpU0HcQ7kNvwE054U7&_nc_oc=AdpqiaBSbJsz6QiKbaLQhPQJkcJERV8NlR0V3KRIaM1xd1Rgub64f_NJWVTmf1wthq8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLsHCzbyMLqUzhWtNHZGI4iNJ0J8svhdX7YqmXx7JJcA&oe=6B06F331"}, {"file_name": "SS_4.png", "id": "1535148197728784", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_1535148201062117_1922824099542313681_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqnOCJDgUSoQ7kNvwGt6s9D&_nc_oc=AdqArEgzizMwQa5F71GllLBVv7GoPa7BcPGhCYqFbOeduKmmQ-nHToGfM0DN_EauFNM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGLcnPe_kXPBerpRSSzzzxzZCJmXnUcg-YSvg8v1cApw&oe=6B06F5DA"}, {"file_name": "SS_3.png", "id": "804098198884747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_804098202218080_279837513749140826_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MW_XzdQgQEQ7kNvwHrfYVn&_nc_oc=AdrnbxTUiILS9vzOvfdrcPUbZ3dXRYpZOHpOJ2Mall0Jbq0pxT-KDjR90ZS4_UnwMOw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtpWh14zmLa780XWmZj1YiYCb4Gp_toVjWaCHdWJYH4g&oe=6B06F65C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baby Hospital", "keywords": ["Game", "Baby", "Hospital", "Arcade", "Management"], "long_description": "Welcome to Baby Hospital, where tiny cries meet big hearts!\nIn this arcade idle VR experience, you\u2019ll step into the shoes of a caring doctor running a bustling baby clinic. From curing common colds to calming fussy newborns, every patient brings a new story \u2014 and every successful treatment brings your hospital to life.\n\nHire helpers, upgrade your equipment, and expand your clinic to treat more adorable patients.\nAs your hospital grows, unlock new treatment rooms, playful decorations, and advanced baby care tools that make your clinic the warmest place in the world.\n\nWith intuitive VR interactions and idle progression, Baby Hospital combines the cozy satisfaction of management games with the joy of nurturing life \u2014 one giggle at a time.", "short_description": "Step into the world of Baby Hospital, a heartwarming VR arcade idle game where you run your very own baby clinic! Treat adorable newborns, upgrade your hospital, and become the most caring doctor in town!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_in
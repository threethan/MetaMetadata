_nc_ss=7f30f&oh=00_AQT2QMvTOb7Z5pJrWXFVpNfAqd3QvW1Tn9pZ0pzygmcBww&oe=6B0C5D5A"}, {"file_name": "Screenshot 2026-04-08 150421.png", "id": "1342769934355393", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618440_1342769937688726_2903849317866160696_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9A6-fRmetacQ7kNvwHqWUtg&_nc_oc=AdoD-HaROZbCSd_-LtdaMnq8AbxjjnQYbTYDwPt5vttZ54pwRXArXxxPlXyUt1fNGL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR6BcW1smu8omin0MXutIr0LrEWE3g8t6gEevqp3iUcEQ&oe=6B0C53D4"}, {"file_name": "Screenshot 2026-04-08 150505.png", "id": "1856394455024952", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618103_1856394458358285_5634477656165125450_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RM1xIHC9tuoQ7kNvwEd-miX&_nc_oc=Adrir86UO9jLPvrY7sjJr4-EjUmHKr4TQuJDsf75g0bbGzMxbHOY4pQwI8MpGN4O84Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRBk2UvG_WVdZ9-j15gKbRK8_xDTF0wl_8wWk-gPbVA9w&oe=6B0C5E51"}, {"file_name": "Screenshot 2026-04-08 150732.png", "id": "1417716736793224", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618264_1417716740126557_3938288830909930856_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sYhDSA_6ZgQ7kNvwHfGPmC&_nc_oc=AdrhDp8jZjnxh4h8NdwyDy9Vgh_2GPPd_bQU5_F361rpgXQqD3hCyKEuF9s-KNjULy8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSmNMdOsZs281V7MyJJ3A-XIZWiY1ule2L7UVyGPtmIiw&oe=6B0C81E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spatial Video Recorder", "keywords": ["SBS", "Spatial", "3DVideo", "Recorder", "Camera"], "long_description": "# Spatial Video Recorder\n\nSpatial Video Recorder is the ultimate tool for capturing high-quality 3D content on your Meta Quest. Designed for creators and enthusiasts, the app leverages the headset's powerful cameras to record immersive videos in industry-standard formats.\n\n## Key Features\n\n- **Dual Format Support**  \n  Record in Full Side-by-Side (FSBS) for maximum quality or Spatial (MV-HEVC) for compatibility with modern 3D displays and headsets.\n\n- **High-Quality Encoding**  \n  Powered by FFmpeg, ensuring your videos are crisp, smooth, and ready for playback.\n\n- **Visual Library**  \n  Easily manage your recordings with a clean interface. Quick badges let you distinguish between SBS and Spatial formats at a glance.\n\n- **Streamlined Workflow**  \n  A simplified recorder UI provides real-time status updates and progress tracking, removing the guesswork from 3D capture.\n\n- **External Playback**  \n  Open your 3D videos directly in your favorite external media players or use the built-in file explorer shortcut.\n\n- **VR-First Support**  \n  Encounter an issue? Use the integrated help system with pre-built templates designed for easy navigation in VR.\n\n---\n\nTransform your Meta Quest into a professional 3D camera. Whether you're documenting travel, family events, or creative projects, Spatial Video Recorder provides the depth and clarity your memories deserve.", "short_description": "Record stunning 3D and Spatial videos directly on your Meta Quest. Capture immersive memories in Full Side-by-Side (SBS) or Apple-compatible Spatial (MV-HEVC) formats using your headset's cameras. Experience the next generation of 3D content creation with high-quality encoding and a streamlined library. Perfect for reliving moments in full depth."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nohtv.shop/spatial-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Nahom", "support_website_url": "https://nohtv.shop/support.html", "website_url": "https://nohtv.shop/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "N
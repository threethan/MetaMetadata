tent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6-h9gmObn6PTaIIqef9_HiGinRsCOcTAIdwqtaUBoTQ&oe=6ACBBA54"}, {"file_name": "Screenshot 2026-04-08 150505.png", "id": "1856394455024952", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_1856394458358285_5634477656165125450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAWdLyTnFwYQ7kNvwHen82u&_nc_oc=AdrGCiqMDr_pOyj6PQPOXCf_HKgzU7XyORl0ESkVrzWTwvFd_WACUuitf9SRQwX_iyE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4Y8qe4YsrZ7uUkCCLDRe45V9gzy_6v8iMSMsF1Obi1g&oe=6ACBC4D1"}, {"file_name": "Screenshot 2026-04-08 150732.png", "id": "1417716736793224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618264_1417716740126557_3938288830909930856_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfsmuQQrTtAQ7kNvwFwggYs&_nc_oc=AdofZHEESmGk_izzoLMp_AFq_SfDL_j-_lW7nWi47QLnoFvcQXZMmO_UhzaBuB_x3sA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMghTBfolsWC9eT5YAAuxWA6Dw6jZiiokbKH4NlQb6UsQ&oe=6ACBB026"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spatial Video Recorder", "keywords": ["SBS", "Spatial", "3DVideo", "Recorder", "Camera"], "long_description": "# Spatial Video Recorder\n\nSpatial Video Recorder is the ultimate tool for capturing high-quality 3D content on your Meta Quest. Designed for creators and enthusiasts, the app leverages the headset's powerful cameras to record immersive videos in industry-standard formats.\n\n## Key Features\n\n- **Dual Format Support**  \n  Record in Full Side-by-Side (FSBS) for maximum quality or Spatial (MV-HEVC) for compatibility with modern 3D displays and headsets.\n\n- **High-Quality Encoding**  \n  Powered by FFmpeg, ensuring your videos are crisp, smooth, and ready for playback.\n\n- **Visual Library**  \n  Easily manage your recordings with a clean interface. Quick badges let you distinguish between SBS and Spatial formats at a glance.\n\n- **Streamlined Workflow**  \n  A simplified recorder UI provides real-time status updates and progress tracking, removing the guesswork from 3D capture.\n\n- **External Playback**  \n  Open your 3D videos directly in your favorite external media players or use the built-in file explorer shortcut.\n\n- **VR-First Support**  \n  Encounter an issue? Use the integrated help system with pre-built templates designed for easy navigation in VR.\n\n---\n\nTransform your Meta Quest into a professional 3D camera. Whether you're documenting travel, family events, or creative projects, Spatial Video Recorder provides the depth and clarity your memories deserve.", "short_description": "Record stunning 3D and Spatial videos directly on your Meta Quest. Capture immersive memories in Full Side-by-Side (SBS) or Apple-compatible Spatial (MV-HEVC) formats using your headset's cameras. Experience the next generation of 3D content creation with high-quality encoding and a streamlined library. Perfect for reliving moments in full depth."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nohtv.shop/spatial-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Nahom", "support_website_url": "https://nohtv.shop/support.html", "website_url": "https://nohtv.shop/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26488114904152094"}, "review_messages": []}]},
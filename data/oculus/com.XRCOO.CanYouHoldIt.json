P3BAUKAxcpAW2rm3MPiZ-BKI45l16JXA&oe=699C5EAF"}, {"file_name": "Screenshot 2025-05-25 at 17.52.02.png", "id": "1423071471937743", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499330004_1423071478604409_5515943538748209955_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6Sgqlistp4Q7kNvwF-1SsL&_nc_oc=AdkpgkAsSjaEsyyXyyGRrxLJUg9xySe72E4mTAReKqhGo_UG8s57LvKuY-ZMA-yhXEk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuBCXvIfR95DqEnkJZ_xQtvF7Vx1NXlhj_qkT5YBeBYUw&oe=699C5ADB"}, {"file_name": "Screenshot 2025-05-25 at 17.56.49.png", "id": "1622933832429244", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499318891_1622933835762577_4329978997005345694_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kbxp5UgU9YQ7kNvwH-tHWV&_nc_oc=Adk4lEGoM5C5qA4dkSC70zUukyxkr304r7TFR4aNi-Iw_fXy3l-rWPSCCIwzI9fcTu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu4P_UWUoCiUfQBYc0S8O-JUaAbdV3AloqHv9mD9pPEAg&oe=699C351D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Can you hold it logo VR (1).png", "id": "2656420264555968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820396_2656420267889301_3735683022476067175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xv7NtdJxoMAQ7kNvwGpo02i&_nc_oc=Adlm1B2hL4dscAkwE1zqxkqz5Mlgj3G3DUP-QivRaj3sbZC4L6LZgUzN5vLAc-kkXa8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvNOCV4Lxd5RUiseiFHdaggKUl6aUuypVS_PDUrI98Ogg&oe=699C4281"}, "display_name": "CAN YOU HOLD IT?", "keywords": [], "long_description": "Step into the ultimate divine test of balance, endurance, and sheer absurdity! In Can You Hold It?, the God of Gods has summoned you for one simple task - hold on for dear life! Sounds easy? Think again.\n\nObjects appear in your hands - some light, some heavy, some slimy and alive. As you struggle to keep your grip, the world around you shifts in unexpected ways. Windstorms, earthquakes, swarming bees, and other divine tricks will push you to your limits. Your only goal? Don\u2019t. Drop. Anything.\n\n\ud83d\udd39 Physics-Based VR Madness \u2013 Every object has realistic weight, movement, and unexpected behaviors.\n\ud83d\udd39 Unpredictable Chaos \u2013 The God of Gods loves mischief\u2014brace yourself for insane environmental hazards.\n\ud83d\udd39 Multiple Game Modes \u2013 Classic endurance mode or Sport Mode, where you punch objects while dodging hazards!\n\ud83d\udd39 Endless Replayability \u2013 No two runs are the same! Beat your high score and challenge your friends.\n\ud83d\udd39 Fast-Paced & Addictive \u2013 Perfect for quick, hilarious VR sessions and party challenges.\n\n\ud83d\udcb8 Just $3.99 for pure VR chaos and laughter!\n\ud83c\udfad Think you have steady hands? The God of Gods is waiting\u2026\n{470045846165870}", "short_description": "Face the God of Gods in VR\u2019s wildest grip challenge! In Can You Hold It?, test your reflexes and endurance as you balance absurd objects while dodging earthquakes, hornets, and divine chaos. How long can you hold on before it all comes crashing down?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrcoo.com/cyhi-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRCOO", "support_website_url": null, "website_url": "https://www.xrcoo.com/can-you-hold-it", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1700921480735423"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_mode
file_name": "1_FinalScale.png", "id": "843219714887715", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619668_843219718221048_2901923829210571571_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndhX4fLiFPcQ7kNvwH838Qu&_nc_oc=AdrmXlilofXSGzS6s82DlpRrJWSgTtu2yDaKJPnVyd50aeE4wGY9HxDmq5rhhElJ3uk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7E-F6aB87o0Xhf9liEd7LtFjd4faoR3gjuXIwYiiOUg&oe=6A9C3762"}, {"file_name": "3_finalScale.png", "id": "755939697488846", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618069_755939700822179_3408696256322272945_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iz9fTiivkKIQ7kNvwFRCCqh&_nc_oc=AdoI_wVY-fUXTtAEpEC-zC7mZPBx0vH2j2K_HR-n9KOWSmD-JyDovFbyTAjBvHD7CcA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLfvuAtL1RuxbTjt0df6rk2kZzP5KEjzbFuo11FPCz8Q&oe=6A9C278C"}, {"file_name": "4_finalScale.png", "id": "4067074400272354", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618284_4067074403605687_10938237572751916_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtiIuUY0dsAQ7kNvwFJDEhO&_nc_oc=Ado4WL9wsJzqPe0Q142DRfHExPKpV8R0R6fiUk6lX4RStZgnvATPiUHkmK2HSeEhKto&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb8Ecir7mWU7DCc0o_uq4e4IA4Z-EOkh48hxBQRkE2JQ&oe=6A9C38D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverFinal.png", "id": "1330131528585096", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618937_1330131531918429_1835065631442477951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2YoZP8VxaMQ7kNvwH0EiJ0&_nc_oc=AdqlIRAW1MyZla6drVX7LQHAACoOKfzi4aPaNlFOFNNpTXyZVM1Qtmw_Eqq0ESCsoWo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWtD6USsQbFDl2VbnTIto6B00GDySqa4pSTfj9uyuvHA&oe=6A9C161A"}, "display_name": "BattleSymphony2035", "keywords": [], "long_description": "BattleSymphony2035\nThe Sky Is Your Arena.\n\nStep into the future of competition where jetpack combat becomes the ultimate sport. In BattleSymphony2035, you take flight in high-tech aerial arenas built for speed, precision, and control. Every match is a 1-on-1 duel against intelligent, adaptive AI drones that read your moves, dodge your attacks, and push your reflexes to the limit.\n\nFeel the thrill of zero gravity combat as you boost, roll, and dive through the air, striking with perfect timing to claim your victory. Each encounter is a dance of agility and instinct \u2014 a balance between offensive precision and defensive maneuvering.\n\nThis isn\u2019t just a battle \u2014 it\u2019s a new hybrid of Sports and Action, where mastery of your jetpack determines your legacy. Dominate the skies, outsmart the AI, and experience the exhilaration of flight like never before.\n\nCan you beat the AI?\nCan you own the air?\nThe future of sport is vertical.", "short_description": "BattleSymphony2035\nTake flight in the world\u2019s first VR Jetpack Sports. Soar through futuristic arenas, out-maneuver AI drones, and prove your aerial skill in intense 1-on-1 battles. Master speed, precision, and control in this new Action-Sports hybrid where reflexes rule the sky. The future of competition is vertical."}]}, "developer_name": null, "developer_privacy_policy_url": "https://heyplayinteractive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HeyPlay Interactive", "support_website_url": null, "website_url": "https://heyplayinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
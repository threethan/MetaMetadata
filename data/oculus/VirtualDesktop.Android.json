scenarios\n\u2022 Added Fovea Size slider in Streamer window, Advanced tab. This is for Foveated streaming with eye tracked headsets.\n\u2022 Improved Accounts tab user interface in Windows Streamer\n\u2022 Added logging of GPU driver crashes for Streamer and Server processes\n\u2022 Added 'Show logs' button in the About tab\n\u2022 Added detection of AMD instant replay in Interfering apps\n\u2022 Added Disconnect menu item to Streamer system tray icon\n\u2022 Fixed re-connection issue sometimes happening at app launch\n\u2022 Fixed audio capture issue on macOS\n\u2022 Fixed audio issue with Vail\n\u2022 Fixed french keyboard layout issues\n\u2022 Disabled Meta's FrameSync as it caused stutters with SSW", "created_date": 1777905249, "id": "26831016556514809", "version": "1.34.18.0", "version_code": 10686, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2017050365004772", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26831016556514809"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1777651066, "id": "26799811216302010", "version": "1.34.18.0", "version_code": 10685, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
droidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2017050365004772", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28183004267982691"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "269719120347043"}]}, "change_log": "Welcome to Virtual Desktop! If you experience any issues, please visit the website at www.vrdesktop.net to check out the FAQ or reach out to us on Discord.\n\nChanges in this version:\n\u2022 Added new Iceland Riverbed environment, coming from the BRINK Traveler app\n\u2022 96 fps and 100 fps options are back\n\u2022 Changed VR Graphics Quality radio buttons to a slider with render resolution / requirements information\n\u2022 Added Rampage VR Graphics Quality on Galaxy XR and Play for Dream headsets (eye resolution of 4608x4224)\n\u2022 Lots of CPU performance improvements on the headset and Streamer\n\u2022 Displayed total latency in the performance overlay is now more accurate; this might show a higher number but don\u2019t worry, the actual latency hasn\u2019t changed. This change reduces black edges when turning your head fast.\n\u2022 Added Smart App Control to list of interfering apps\n\u2022 Pressing the Xbox button on gamepads will no longer exit Virtual Desktop\n\u2022 Reduced size of Streamer setup from ~100 MB to ~75 MB\n\u2022 Fixed out of sync audio issue when seeking a streamed video\n\u2022 Fixed occasional stutter when switching to VR with SSW enabled\n\u2022 Added SteamXR 32-bit support with the Preferred OpenXR Runtime\n\u2022 Fixed crash when connecting while an RDP (Remote Desktop Protocol) session is active\n\u2022 Added support for quad eye visibility flags in VDXR", "created_date": 1787593311, "id": "28183004267982691", "version": "1.34.22.0", "version_code": 10703, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes
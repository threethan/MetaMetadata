oidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2017050365004772", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28979261611690282"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "269719120347043"}]}, "change_log": "Welcome to Virtual Desktop! If you experience any issues, please visit the website at www.vrdesktop.net to check out the FAQ or reach out to us on Discord.\n\nChanges in this version:\n\u2022 Added 144 fps support on Quest 3\n\u2022 More accurate controller prediction\n\u2022 Fixed some audio clicking issues on Quest 2\n\u2022 Added emulated gamepad support on macOS\n\u2022 Added support for 96, 100 and 144hz with virtual monitors on Windows\n\u2022 Added detection of USB-To-Ethernet connection in the Computers tab and performance overlay\n\u2022 Added Lenovo Gaming NetFilter as interfering app with ability to remove it\n\u2022 Added reporting and ability to disable HAGS in About tab on Windows\n\u2022 Added OpenXR 1.1 support with VDXR\n\u2022 Small improvements to SSW\n\u2022 Fixed rare crash of Streamer on Windows and macOS\n\u2022 Fixed 'Not on same local network' issue that could happen with some laptop Ethernet ports on Windows and macOS\n\u2022 Fixed H.264+ bitrate slider sometimes being limited to 200 Mbps when desktop fails to use H.264\n\u2022 Fixed compatibility with Thrill of the Fight when launched from Games tab\n\u2022 Fixed crash with Launch game menu on some systems", "created_date": 1792706119, "id": "28979261611690282", "version": "1.34.25.0", "version_code": 10722, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_a
f&oh=00_AQEWiDQ9D--aurCjAgmLNIIuMXNHmV5q5qK9EsNFZ_Yr_g&oe=6A9749AE"}, {"file_name": "FirstClass.png", "id": "1591587918121209", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39001705_1591587921454542_6001373603645770438_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bth0hXD8oTgQ7kNvwGvMt42&_nc_oc=Adr0b9nCybPLjkCkVgId2PIzlUTLft9oBf7997HAoV2UEkqVruhclhLrlGIbUUrRO0k&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_k20HnrL9MlgvgnG4DQbbtfprpem8dpCQMsGGs4kXdg&oe=6A974B59"}, {"file_name": "Auditorium.png", "id": "1053226699935329", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031482_1053226703268662_4115019812194484195_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjabrJHWQq4Q7kNvwFM9mne&_nc_oc=AdouqaXMaDCdheokmFZom8wZVYo13dCeLTlFsZ__Q33qfAbXVwrPVO-Z0oQsKovteu8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJkVVm__wRWZGqfJNjsMJ8ifvftUgZ7siJlV4kagMQMw&oe=6A973A53"}, {"file_name": "360Video.png", "id": "588613153513872", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974812_588613156847205_6442548811525759348_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPAuN-qb2WMQ7kNvwERh7h3&_nc_oc=AdoO4-b2xV0vymWrqzZm9z5GxNK89HfKs0rH44rop4cX0K2a-BGYBGb10vfAAXasVcE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNFtBpHRFqNBpU7Nakg039WfIF-1ZCGG1FfLE5Tt3k5w&oe=6A973417"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "1261893117932221", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38984446_1261893121265554_2620193258863035889_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoGiBRA9YqQQ7kNvwFC1QNw&_nc_oc=AdqkyQsbF-d-lTPWPzv9GWy6zcNQncLseywyio5CX5vTwoAiOYI6oNCbY-amH_npw9I&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5HeYd8fEHEusQzh3G2uid_zAyxVbPZhQAMD0J-5frbw&oe=6A971D61"}, "display_name": "Virtual Desktop", "keywords": ["computer", "streaming", "movie", "video", "pcvr"], "long_description": "Connect wirelessly to your computer(s) to watch movies, browse the web, play games on a giant virtual screen or stream PCVR games. Virtual Desktop is a highly optimized, native application developed for low latency, high quality streaming.\n\n\u2022 Computer must be wired with Gigabit Ethernet cable to a 5 GHz router\n\u2022 Supports most PCs and laptops running Windows 10 or 11, macOS Catalina or later\n\u2022 PCVR game streaming requires a VR Ready PC running Windows 10 or 11\n\u2022 Videos tab allows you to download or stream regular/180/360 videos directly from your computer\n\u2022 Supports Bluetooth mice, keyboards and gamepads\n\u2022 Supports 3D Side-by-Side / Over-Under content on screen\n\u2022 Supports multi-monitors (physical and/or virtual)\n\u2022 Includes a Microphone passthrough option\n\u2022 Supports remote connections over the internet (enable UPnP on your router)", "short_description": "Connect wirelessly to your computer(s) to watch movies, browse the web, play 2D games or stream PCVR games. Virtual Desktop is a highly optimized, native application developed for low latency, high quality streaming.\n\n\u2022 Connect up to 4 computers (Windows 10 or 11, macOS Catalina or later)\n\u2022 PCVR game streaming requires a VR Ready PC running Windows 10 or 11\n\u2022 Supports Bluetooth mice, keyboards and gamepads\n\u2022 Supports remote connections over the internet\n\u2022 Computer must be wired to a 5 GHz router"}]}, "developer_name": "Virtual Desktop, Inc.", "developer_privacy_policy_url": "https://www.vrdesktop.net/privacy-policy", "developer_terms_of_service_url": "https://www.vrdesktop.net/terms-of-service", "publisher_name": "Virtual Desktop, Inc.", "support_website_url": "http://discord.vrdesktop.net/", "website_url": "https://www.vrdesktop.net/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "ext
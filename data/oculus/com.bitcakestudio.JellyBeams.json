uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuGm6OXHsX0Q7kNvwGCtxT2&_nc_oc=Adoax3vuK7IaJwQ-qt-Bv0iwpfthpiwiLvwuwTfg76ZqC_r01Y7A-8kBecNILfXnRCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWMRgPddkJaHe2AVQUMtjJrFGbd9w1zefMFFIMZyy1cw&oe=6AB92379"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dx-pmjiJrZkQ7kNvwFRjQIS&_nc_oc=Adr835b9HRiGKnvDycBVbyMnZdCe-CFmNhrCQa1EB0UHTQla7CSSz8gbSUPp0abvtsk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlH-rA2pFIQXSbuKhM5lETYGC4Sl7EU4lIC3tpNfK4kg&oe=6AB91760"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nk8nr0t1xIgQ7kNvwHlSU9u&_nc_oc=AdpR3KSSEGubDA87xAECJX-RxH_XeqKc2F3INX-O-Q_bU_g3dsijvXTuzaI6GgTDZHE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_3dMd9XByLI5VfZwTF8LAIIITHvcNv_mWGRhmQbjrXQ&oe=6AB93469"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=738jZEy0rIsQ7kNvwE-W3Cm&_nc_oc=AdrMKEHM_dn7iY4sF94DyqiVN6YW37yYN7lp-DGBQtqLPx1dNIAoeJnpdjkO14eNSbk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyoGrXsFakhA78eJmYVpRhmlrBD9AqADfD1DV981mdEQ&oe=6AB90CA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4w9am__Q5wQ7kNvwEsUlIr&_nc_oc=AdrSH_AzjnRBAAFBv4H4pMHAc-3R64mgZWwejA0r1YhII2XJg0rqsWnfbWMx_60XE98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvTOs1RWGF9fwXkM3it6q3-Jjq8PtLyazctloLLDIh5g&oe=6AB91BC5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
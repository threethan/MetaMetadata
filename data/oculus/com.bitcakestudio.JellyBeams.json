uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_I2h_2JaDkQ7kNvwFezyyy&_nc_oc=AdptygN318yBMuv5hkqV4vyzydVZlLtqQKAOl74R8QqhvdAIxCQyJncaNoEgw0RwUU4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScAxd9FDv-P2CGM6qjq_GB2GJZo4qc5sMsfVxj91ewzQ&oe=6AF8A3B9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCohBgK0BFAQ7kNvwEWaW4e&_nc_oc=AdpLNrcknPeQwEwT6pSoQCQDrMTLhPG-9DZatvOE8RgfWsH5a5CmJ3vQy7sBhZ3E4Lc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3LX6wwqa3NHYm1oB1j4aYunlHU_hYguHyYeUdVExezQ&oe=6AF897A0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DenuhhzfFNsQ7kNvwGGzbzG&_nc_oc=AdoHh__wmOzFKMZE-8BHPQdZq_KBeuelSkQ7rKEQSL1xZ2QxFPApziae8pOhDOsXuGk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7F1_W1NInznEPEt-9gxJlYWgrtnQO7JC6QU7Xj24AJQ&oe=6AF87C69"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QA0QAH39huQQ7kNvwFAyD-Y&_nc_oc=AdqbvlrucDAtLGF-6NYx30q9VYVI7dreS5MGe7i2j9dV9NrRKMykamyYqAhJNjSqxvo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj5npaUUnu1u1tozfPXi6mJNFIAE8Ziszj0lbCvjZeTg&oe=6AF88CE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gzJv6qLHHEQ7kNvwGNMG6B&_nc_oc=Adp88VEUXsWUd1T0feZ2mQMMBXcF2n0td3zWJPb7j6_9bSQjdJMpxwNHb-fHmMdH02Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE_zQ1FgEB9_blJJVIzUSNc1Ji67Q7ya6o-M39zDGofA&oe=6AF89C05"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
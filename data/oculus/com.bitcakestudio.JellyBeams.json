uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0CA_Etzs7sQ7kNvwFnBaWT&_nc_oc=AdpWHzQIyjXwNV0GC2uRtnEONP5S3S0ejQ5FtIwg9cNpzkh3Y4mq3Pkcnv-GDnE3LRo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1t_Ug7GOEzikp3p8U0qA-CgOoD2h6d-bqU26_hpGuItg&oe=69DF9BF9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiT9V6LY47IQ7kNvwH5Yl-l&_nc_oc=AdqVM-oY5cCMrjyqei9iXTchg7iidenToEbwj5xGN9BG96-BfkPePIrk-ZF2A1OM1Mc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2btcTAH0vDb8dVFXPNJRDQW5Bk0oKdzFcsHg9ccchqEQ&oe=69DF8FE0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S412VqFjRQMQ7kNvwFQNQgI&_nc_oc=AdpGQgg4Cg3MVtqomdRngWtvi9t8aq5lYESqmqftBHVhmwsbYoYdTfh3S6d9O2EbY5o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Jj7AAhBJsWsDiE555zVDQ7fUB9GnVAbJFtzu7KPC4yQ&oe=69DF74A9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL2ofeMQsR0Q7kNvwFxOS54&_nc_oc=AdoPxaXNS4ZVl52anDnVA4Uwrk8ljYiDODcf25R3upQPJUa6Cv4m2fSa5Ggzw8EQf74&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SMkCG52ziPh0nv6bL5ndd0Ecw-6VZZtjJ7uB9dl45Mg&oe=69DF8520"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRPQal9_h4cQ7kNvwHtyr6V&_nc_oc=AdpW1yI6CVKPDjvL4HqOfFT8OkY3Jogc0xxTFuQPv1fgIAp061MEYLba2Xqw_C1-0h0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dn7T5w3xaKIjirKLrhcncD5zUPF2bOMTWscNmxeLGjg&oe=69DF9445"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dI9PicwPjS0Q7kNvwFy6u-X&_nc_oc=Adou0toxNh9uVoNe8MtuKOJnLbaly1T6wdgwDUO197Xc6L4TZHhbNSOOWOVr35M1YgE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwtZpE6uVhMLfhgexAl-zCPwgfHFafyMUzLWctmLbsYw&oe=6A71F279"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tgTQ0rRGEgQ7kNvwHwA3Xp&_nc_oc=AdrDqjwCV09kpNiGsGwiyEb5Rp0VUwtPZYLib2mqDWriBc0aTa-UfNLeLOnVZ3R9DX8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3GsRJ14c9C15gZuwNXlDopSFZlA0o2GyB1bap6YCR2Q&oe=6A71E660"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXwX2liKElMQ7kNvwFR5535&_nc_oc=AdpbPpcnGRhoGm6nmZignqlYe9sB7r0rzF4wG6M0e2zLL4ZISzD--3_NQy9NiBRqfvM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUFpFAuwmcxFlzBULt2BydeMk2w7o8CAc5BFDmdOD_EA&oe=6A720369"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fw_GJWHZjgIQ7kNvwFkwyBQ&_nc_oc=Adr21ZFulKl_BW6JfhcQa9OjLMuZ79Uqh9jPACuSlfwBLJI1skzyY7XIcTZjDVwWgvQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGf6BtEqmppsD2Cn_WgcUnwZyO28WCIQiU56WnMx1hRbQ&oe=6A71DBA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHeTwDSQMWIQ7kNvwHPr0IW&_nc_oc=AdqeWTocF24tBflFDY3Jnl7uGZzRL1I8cjAA8vEbGNGphgZP2VfspEs4yUDmkT1qlyM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjveSpS8qhU2EX8kuHiTHuufII4IjgiJYNYiACatYxZQ&oe=6A71EAC5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
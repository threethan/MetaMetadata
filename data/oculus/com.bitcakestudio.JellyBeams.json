uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmtraRNSTaoQ7kNvwEFfJYp&_nc_oc=Adpsghl7N0mCh9n_59-ohfGNgOLSUdQVgIi1GEooh4Jtn76IAVk31_oglYJur2aBoLw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl3-vZY6YZ2zDe-fZI2c7q25t7IhJUBOtqAevOwVbFAw&oe=6AEF6939"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSugszPHJDgQ7kNvwGESIbC&_nc_oc=Ado25c2rH64lE1vAvCtd2wNA9n0pIXmyGgA27MbLe4xd12cR3L9L9nfP9tok_bD4xR4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1TdN9RmBVoIhUHqHVzjpV9DLNmNHld11KNmxPiI6XWw&oe=6AEF5D20"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WNnYNDa7QcQ7kNvwEav1Ug&_nc_oc=AdpxE22uwO0X6Bh72ekpN4d41mFpQzPYs20GGs8QKT6-jPdndtyn7EEor1bNfydyYxc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT39rvab61_cyS2FQbrJ2ullVK1mq2bFySTOTadXrnkEg&oe=6AEF41E9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dC8R6RHaO58Q7kNvwEqMYqJ&_nc_oc=AdrdDfVEgEHpF61dcqYX4nF3yjq27Qc3drXhdKX2q04akfXXeXblOVVZxPMgYR8UZ5k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT36mnyulVe4Ceaf8KyXAIWJ9s_zMMLSlaC9dattC1Png&oe=6AEF5260"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YyxsJq6cKQQ7kNvwFPoUpk&_nc_oc=Adq3OODyHkWyJ7B3XgQKsRo5EfJX2y_FoC-MBxQTKXyJLVXI3wWmj71rDHyO43HWL-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8azClGMFrJdxppCLBtwOPf-_DieJvwOkoHzwk2kL9bw&oe=6AEF6185"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
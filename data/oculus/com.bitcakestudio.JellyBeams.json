uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ol9U4pyBOUUQ7kNvwHFBjJr&_nc_oc=AdrbCKx5ReiUCC9NnqoK1yFEC9ZyHwDlokRS77umylYxjv2YsSMYWqdev9ZhdAhRjb4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eNhFPzbUDX9Z6fk6UWDQYu6EJD46lJIFjtyykFeXoNg&oe=6A26CCF9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cVoBTkcez8Q7kNvwGcbL59&_nc_oc=AdprfIIfla4i1DRUGONCZnHUJGaB5ZgNExNW8AqUypIBhc73ZBwBw4kmoFU-8PHJJHs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zYhrO9nd-tg88RSS1zmEk2EwuXkJB6NaoEpJmR3OJZg&oe=6A26C0E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhXnSwyOBM8Q7kNvwEEVduu&_nc_oc=AdoPEy4aaezeTjnZ4yCazm892BaAKqmCF1Q8umEoe7FeetZhEI6ohd_WOjWD9f5nHvw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96m28ANb-Vrl81CiqcrkljELM5vYu6s0VufwY-gORS8A&oe=6A26DDE9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYdEKBiqZOgQ7kNvwGOtkzQ&_nc_oc=Ado68DrzLnX73XoOmj_CAcNmCa_B3p4-lTABoqkcGTUXhGXf_gqQ_rCqfJGYvJx39hs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ibAT-3iYBBBIh9Ij2N803wrBAkEkigA0TeiqjoDHr4Q&oe=6A26EE60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dZhOXgmf2QQ7kNvwG8u3tb&_nc_oc=AdqC4udQ84PjFQroj_-VFvOGoPWVvX-Gxd1zm2KOHkvvaOnZ3oI4bg2qLflEwW2DmCw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D8VUQa-3aYPWAsRcA6N3ChP8Zc7b6m6zFDok190_sbg&oe=6A26C545"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
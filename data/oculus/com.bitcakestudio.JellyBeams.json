uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtXI3n2JyncQ7kNvwGFcffi&_nc_oc=AdoPflDu5yN3YB6ATeBFTBgwsWX2tL2eu5fYhy1cqgIoIKnH43t6Co-xb6oQthtTooQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Wna_oK3ubj2Kog0UrCJpmyLpTdrEcYGZ1OEt_mAjxfQ&oe=69D3BE79"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43uRXEYIYr0Q7kNvwHmPszh&_nc_oc=AdqNQ5AJoj4QuDtIzFA7Out9blZQV1pKy9ahkHm7XX0sVMpVnaiRVxl0RTs7BcLOUvs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NIDt7s3__qDgeOum4CbQVo4AdzRYfXZEcWWml0oBRTg&oe=69D3B260"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoD0Poouq2QQ7kNvwH52-ef&_nc_oc=Ado8LDwZUziNzvJK73P1M9D6N1Ml1BBtWXsh7l3b57cTuDyKdUvZ8TJxIHoO36yvPRo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10CQO-Me6HUz_FCYc0xMoAXKie8IKHdA1ERZVuCJO-aA&oe=69D39729"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aw_HT2lLHjQQ7kNvwGrdraZ&_nc_oc=AdrgXtnDdbBYdOxdzfghRP_yCYnY7SbxVomqeNSMn6p4dFKTLjDTG1sDlBd4mMjAHOU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1g8sJwO5-8kvkSPvefhfjNXvpHpZ7KtYMCiBW8Vuxefg&oe=69D3A7A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1j9RdDVfuIQ7kNvwGljIa4&_nc_oc=Adr4-okimmNItjSiz1kkz--HZgVz-cKsDayY0LaPdV6bkn4CAJakktinW2YPfY_EoTc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MNwe6QL1jE_cAkEAZfv8TH9byOOlUI-KTpaW6bEmJBg&oe=69D3B6C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
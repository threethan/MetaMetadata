uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pS0egmfHxFYQ7kNvwG5NSfo&_nc_oc=Adr_byYb1ddd2eEXVXVgJs_MQyCd21m7qlzyu5EfcqBy32L4c27U8EbcFVCZZpeHDOg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U1BDZ0psrFE1jwvTbSUlK28PoxzfJbR2V_ZyD-UoUrQ&oe=6A296FF9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cVoBTkcez8Q7kNvwH7Qb3V&_nc_oc=AdrscYM8Th-1jL__pFFfheVqozzNpRq5tuJpGgdLO_LZqXH0Xa7Bn-_Sbup9nLrIgKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S1ncLMgE2ZtFzCFvPWIkeTWvMiV1nmr8NaMDvQZw4dA&oe=6A2963E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhXnSwyOBM8Q7kNvwGUb2U6&_nc_oc=Adp1F4LTjOdzMIYwBgbBZXY-ZC7UDnpcAdroZ-QHjw7bGfqUtr4QHzrKJHfHPlKGhuo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tjgtOYkpQnmeXBf2KLt5FsJ4ahU0eITkgpBbrtCIdXA&oe=6A2980E9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYdEKBiqZOgQ7kNvwEY4V82&_nc_oc=AdpBAzTlf6RFrNXT4aR9RmQ4s72uq_DErkh3GcgQl9DcKazzX8KAy5JXmnebJFryDTo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Dex88ibpZz-UrjANE-CjaIpD38JyDO0FyzuEhsZ1LZA&oe=6A295920"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dZhOXgmf2QQ7kNvwHZ3-oz&_nc_oc=Adrb8sFcwCTfRgEEG7FnKmYXdBTwOq6l81idlIF062n2JV_MGSR7g5xBI0_M-I6hJQI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7MLNAt4sXlkGkXAwuDJfsQaX2dTBAR9NLFmytepDnsw&oe=6A296845"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
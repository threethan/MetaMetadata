uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PT4_UOe2KkQ7kNvwFvBpnc&_nc_oc=AdpXyHMMbzocQmDpDs4hDQF_ABUXh2OVEBqGGi4yXKCxZtsd9LoRiYs-RsNvb0HLp_Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKatMsqaRQAIQm_XSXlJmZ3WzXz8obrI3tbihcaTXnCw&oe=6A86D239"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tP2vbAnoVrAQ7kNvwEVlijs&_nc_oc=Adpu45QOgWGYfCZyWCTDU2mPkhn2B6nMiGNknWjcUGB866WEwu3JZf5wrZtfxUKBbGs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHM4FQedcJQ4XYB2P1SHwBVJKT2L8jWybFUhW-0RfZBxA&oe=6A86FE60"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asmOnHEh1VMQ7kNvwEAAZSi&_nc_oc=AdrelrQjuCNCgIRxgVoRfWVnVvsjvXGDr0IMxpvJ2ht6PxUTzkL1zikdPWTd_gapA2o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHV1A3p9oZCdzDKvQnSQN4aS2BrZRg7_TpUdrBujT2rGA&oe=6A86E329"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QGz8o-luA8Q7kNvwG6V4WL&_nc_oc=Adoqxg_R8V0gn2NFahR0o-b5YNoQUUpjpjgOdyAgZH7W8HW7sCgylNxYfm4IB6N0gs4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHz9UhTcgyqRN7Cx7Q0fg5gYDbJlwN5qsc6vXu7itfLAA&oe=6A86F3A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcDvAW-kV_YQ7kNvwGBplm9&_nc_oc=AdqkmxhaW_Jm0vJncpwMdh2iQYL1FdPb1DxUqZskZFKtyWvHYx9gbV3oXtiydzVrjd8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn_7rZoW8890Udmfcap2IhMPqCub8XuWYHFRHipqaI5g&oe=6A8702C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
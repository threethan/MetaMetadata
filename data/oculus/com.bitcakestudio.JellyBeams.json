uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ENr_ckKt7UQ7kNvwFVPRWF&_nc_oc=AdqrgZcgfCRGXjyBE_NczUDed7xHchXx5HiFIz5DG6HbNv8PtwZa11QuH8jamcYnlGw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NK_7UPqgWjjDZmHkVW_aEV5YjsiK5vTegegSTDLxcwQ&oe=6A203579"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4N49zAfCAsQ7kNvwHpNe0c&_nc_oc=Adp_KPEh-n50AzmspMpzaDK7OGrIE3Fif5mmRTlkczD8yGGr3Wf6e1kajdUmEvZoOsk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70bJB5MY6A7RKh5gUXoCvzKwa8NbF1gdxBtmWmjw099g&oe=6A202960"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4WyqmHAbOcQ7kNvwGXz66N&_nc_oc=AdrwOHMTppMjAMNgAarqIiRGlWRasmTcyC7XfsxkcWJoptnoCnIEG1CPDiWka1UiQMg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cZ8INXtxmKHbEMIu-yK0kHD0PZXnT2kZim8h6rgYG9g&oe=6A204669"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsJLMteQWnYQ7kNvwEtxyAu&_nc_oc=AdqktZq1zkJc4Mpxkyh98pbhmzXATwiyr2X0V3sot6I1ylHsMYELNLfOWpnK2qc0cfw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AD8kcv9SV3WakDHiWVLTZfsaSGVyKrf-t4gywfJIZOQ&oe=6A201EA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2pTFoO_HwgQ7kNvwGiicbx&_nc_oc=AdoHfK4e7TA9WfZ241qpWnrMUxNIpCaeSjq5ki2nhrk2MFrs0cUyD6ASTfaGSvD0FCM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6E1hlWT2f4FEh3wt-2s2L4wisl068ZAgQBSHD6mDxL9Q&oe=6A202DC5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duDKOUeFZKIQ7kNvwGdea5y&_nc_oc=Adq_xTmhI4-370VSxXmpnmfQz8ouVrdT5U_Lltjxq4f1dQUcfjhhUeztmD8Ks5FOSZc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM84leFhpeshT-4h_KVOpyDl3fVhcyfbOqXEUN81oIFZg&oe=6AC7A3F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQTHyMbIFccQ7kNvwGmpJTM&_nc_oc=Adr1MnpPKY5ylInUD5SOv6VysdJwUDPbMgitSmHq0YLDXQyZ29psGDG5AgYkqCC13PY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMf9QlQsBTD_-veYF_CNBf__rkwu6Ikj4vP5zFTazorrA&oe=6AC797E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuODs7G-UL4Q7kNvwEyR_J2&_nc_oc=AdosP3WR9wEN2lGcNH8wrS-T_2Hvb2bF3EOU0N592hOyfVXlz9BudWW2GUNoAYA3vOM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVOW-qXjt7x1tAqP0kH1lGZuXevY8eJv5vcCj2yI7PTg&oe=6AC7B4E9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFn802INu24Q7kNvwGe97Rz&_nc_oc=AdrfpSx-tYlFVN0HsxndDT0ea76uREdo_WD27wdRXbikca16lfBz4es2p4hbyWXpx8Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVJKhXpipo1J0X16Qb6wLIlsS7SKL3VnD0ch3UJfbX8w&oe=6AC7C560"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMnSE7wQeSgQ7kNvwGybKUe&_nc_oc=AdrfoRROA7dcaDQ7NjRc0KoPsciku_fErJ4OwEx89qXj0D9s45-bd4T0j6lfy9ftOko&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg0zt5qp4meqWbSIqoCnmfRtXR08zFRpie-Td6S9QchQ&oe=6AC79C45"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
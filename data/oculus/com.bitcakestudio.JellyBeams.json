uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-ulaY6n2JUQ7kNvwFkAIeJ&_nc_oc=AdpYjdHotArqc4ObboPplniFi7zeXYxCw--XitW6XYBsVY0ldR_UzY4HWWtm82S3fVk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SaQeovGES55AtNVqrz4UpQqOkR-ekBFp4qxR2T4OsFg&oe=6A2C12F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYNlRMumQKQQ7kNvwE3jU_J&_nc_oc=AdrNKqwA2omuLKDDn7Mw7QRFwxQcfBSnr0Y1kiGrGtd1Q1eV7KsV4v9Euw1F99IM-H4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IwgABTVPg1NAbMpr7mtEOrA5DFHhlLbL1hq7jgZ188A&oe=6A2C06E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdzZMulGOJ8Q7kNvwE4ZKyh&_nc_oc=Adpa6_KHl_EFKMa25vnYQ6qKu73uGn6FeCsUFupb0QWZ8X1ssu74I791alfxYoqlTsc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YPltQxjY0gkyH9gSvTnYRuw7rp0RAl6v-qXM5f_xxTA&oe=6A2C23E9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=___heIz3s9sQ7kNvwFd_CYD&_nc_oc=Adq6yCXIgguEkQnN0TTfJug9onboVyUNQg6Drs_79JSikMKdIWG8S1jJ-D3muK8lCNI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vSd2LDrdkhQM4fdxL4uKQdMZXb-H8dslV75jBvXtXUw&oe=6A2C3460"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csFAR2lJfCcQ7kNvwFu_Jic&_nc_oc=AdpNcwDQSqt7oyYrx1u_gaALXVE-rcXb5fWqSMQ1RwjDWyHrOXFTjvbBkgax9IrVadE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Agj6dMCYDyisKeXR5LL00rBNfUWaWdINBWUZWSi6bIA&oe=6A2C0B45"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
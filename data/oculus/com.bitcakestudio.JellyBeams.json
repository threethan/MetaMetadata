uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPp1AU4BU4sQ7kNvwEd0rRa&_nc_oc=Adr9aGHoiz5GrgM4ydF0FuliYjh0UH67myWLxf7BDlknYKzHG04q-vPlJ7T3K4FLKA0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCx3FTyCF2l7Qu6yF9SCuRZtxmFuIna3d0fYgLua4dfg&oe=6ADF5EF9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VJK1FHiy_wQ7kNvwE77egO&_nc_oc=AdqCZmC9AS6WeqA_lOdmDZ1ykCa60yAO8GKW5v3LC8bTGBuj3DU-HXOTGu7GbRQOtFE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPE4_C-nDwcLdUeNLjQbRRuqriMTpRGVnUWvx_QXCZ1fA&oe=6ADF52E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjzyMR__w3QQ7kNvwGurX7N&_nc_oc=Adrcb6yrITrj3HYZ6QDIwGRHIsoNvEOS33yl21q1pWM_TrYhgP-3R2Jc1gmYh4-ox3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3od3I5hbk2fXFcUA0xdN6fN_zP1w8qGNfmfS5pkgTKQ&oe=6ADF6FE9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBv2fYNQnRoQ7kNvwGqXsZ_&_nc_oc=AdpLs-W8N4uOD7W9mmoFyeipqNBSo8ih5qLRPVFvLbPmJVoN_1JByzfywqx7ZFW8JoQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoBse5KmvH_3dPXrXvVha9MLep0FkQ31A2jFcoZjrlZg&oe=6ADF4820"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_5AmSKlIMcQ7kNvwFIkuFe&_nc_oc=AdqacUIzaKSuZfTznqSoIyJIW2g8KwoCtGU4k0BQMTFYgXAXXdCRmzNO3k5tfkFjbiw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzu_IFk7f-nqUygHIrpMrZXvxsxDCBYOQ-kk20Q8ZC3Q&oe=6ADF5745"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
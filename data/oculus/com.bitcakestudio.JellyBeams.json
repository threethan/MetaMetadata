uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSpN4C_WkpUQ7kNvwEmtodP&_nc_oc=AdpoMWWZHTssLLvlW0jx2dwkT0Fw1zVnLhiEHBGohwSsN-JUR29R1ATr3evJkne-jJc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13ki6AVgZ58jt77FL2WGaGWJotyw4mouYm3DMblGOY_g&oe=69F8A879"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHhh5PeB4P8Q7kNvwGKayri&_nc_oc=AdpuuIaz1jc73kUSFFsIOA3ZLrwEufHMv71LQUTVBUChheiYKywZ2vJJl6oyAGX8Jvk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2TsgsE9auzuALGvglRPlRDEh-mEXjUlNCx_Eo-UNQ1cg&oe=69F89C60"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUVNEZktWYwQ7kNvwFtmvIX&_nc_oc=AdqoySVi1oDr37DiA5Wv2f4kSdNTb3Z9n3rVmO9vujPW6U8IjsQSuPd2lJXXPvH_nlQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lDHGjTuz79XfmZG10VnPlQyl3nkhgKVvLO1tulQa3Yw&oe=69F8B969"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXiHAomvQgMQ7kNvwEQawXf&_nc_oc=AdoR3_v2RSnSGQx1AE7ArDg9kb8-X_kEGwssnWxezoELPYs5Qgw-1nWWIC-jUkNpLe0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2a1oAvqhqD2fzkVqmN_j6Hwlsn7ESgj9b_k-8VmCU_9w&oe=69F891A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzbRjgF6Vk8Q7kNvwGRyE7J&_nc_oc=Ado17sy1DDqb0NKMf6IJHIfmraIGUScCUYaLsJV01lmQ9ELJ3BMH2rY6XxpJpNLmIdY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1IbhE7F5o6KgGMwSDa9jkjuHN2tQk1jm1S43lQXTEBOQ&oe=69F8A0C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_gQzIlwoAkQ7kNvwFKBvau&_nc_oc=AdqGAAHDkMZnvvIOl6P9Jephkx6f02aEgDAksjDBlcwiXGbS2VpbbBM1GXQPrwdbMjA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL83RwKD30EbB8YgMjdThgYdKLMwQbvzjx_YWHKtyevxg&oe=6A9D73F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zf8vs9OM5_YQ7kNvwFM2G7_&_nc_oc=AdqzOTpZfzbMou1ALqt-Cr0ZkGhxElmXcjsgh-kNZqvNa8cdTzLHRDxHF81masvcdBk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNiNCy_dviOUsJ1twm6evQqFPEXtXEMl8RKKeajpESWg&oe=6A9D67E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uBATChDTLUQ7kNvwHVq_2c&_nc_oc=AdrZq8UoWMZachN9HzB2NUMBgSbYBkTCqdTgrss1hfSGGTCQUtfXHpoJAlzhwAj4xNw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0nhYjZ05JvtQF46ZaYsGRqqolvvqWyCRTxP3koNPDGQ&oe=6A9D84E9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbKPaQ3UwI8Q7kNvwGJnzER&_nc_oc=Adr-wJGPi58GZJJKlUK0MBao-XFpcsHswKHAYHiprbT2jHcGE6sz5qhPn4O7ykh2raQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-MNnO1LJaNucJjCLmrDjHg564Ctb_qh_jDWB-ZXm7rg&oe=6A9D5D20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-y3o3CnvHgQ7kNvwFfaPPd&_nc_oc=Adrs7ZoIdt40WJPdEiYH_9xmn1WvFYbTPTnXEmUpzGh81mOXWfuxLDKaVzA3xiUtomg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrk4qvABewW-MbmR5qOcfHtUAKZS1rIw2Cdpw4NuO-VQ&oe=6A9D6C45"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
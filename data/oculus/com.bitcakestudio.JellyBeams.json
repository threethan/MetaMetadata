1.oculuscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEGAhN_57UoQ7kNvwHmUIJD&_nc_oc=Adp3JKqjkpu7pJiOMBTM_j9HfX4dg97tbGZSshJqkIqrYZK9RGjODV-gtRXl0rM3Prg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINyy5PNE94u_3wWFd-F-D5TFf9RENQ-rIc4B2Ur3SSMg&oe=6AAE9779"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZ7A1RGgppkQ7kNvwFJbxW2&_nc_oc=AdrgioIMJi9W30S_A9AdjPBBiDiDvqdAPlT8qg-dNDjgseqZmF_MOZ22plwjvc4vyA8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJURhybv6sKNDIpHxZr0xy3tDrfzBFAA_ETspctLAsZRA&oe=6AAE8B60"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_YCKvpAnuUQ7kNvwEpqawp&_nc_oc=AdqH-hRzNLJS9kMnnhG9Z17c8HnaoOxICNlibxk3LBEQtOsxPEzhydTB6VwfnzHCDqE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA-cGFey-su5fuFJUDX9qCAr3bhDPSWXql0I_1VT7e9g&oe=6AAEA869"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oahL78bmlEQ7kNvwHVyTY2&_nc_oc=AdqDdPx4yElYyiD3Yeb0ZttV3N1y5FVp_1FesTI6GmyHeBx5FBxAA2D-TBgE6Ujn-TQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKID8SNanGh8iCyeoq-DxsBcDzzv5Oxo8N715C3H8Kiwg&oe=6AAE80A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2eNWMNYtBgQ7kNvwGB0pVj&_nc_oc=AdoFwjnPIzt1c1BxbFGp6aJDi8SOROao6P2w4Ytq-kkEDLORoT_3Wsr6X2YF6qdCrdE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJitdplyLGbeORxeZ8H3bvPRaRNF8qyb17KqvhgJ_PVSg&oe=6AAE8FC5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "exte
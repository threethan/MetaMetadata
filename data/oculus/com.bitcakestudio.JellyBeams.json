uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mLvqdjAbrEQ7kNvwHNuZO9&_nc_oc=AdrO6xUOgRMRRU07IiYC3OI1x4ApFz0oVVNM-_xuKAkDvZRK1UiTXskYF1dEatULgb4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GsqPqwy74nlTh5hfbsXgfwVWdhf35XiKSfLIBeEELCQ&oe=6A01E2F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5pOxgT9WVwQ7kNvwFHU9Gk&_nc_oc=Adr3Ruq95S0H9MKbvG-fKk1Dtluk75YaICQgQUCji6usrALZ0FQnj2UjABmcfR3mXx0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I8a63aZjJEWjXOrao18-q3ZA3xiOg5bhPTy7yb7YHvQ&oe=6A01D6E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2fxxt8sNmwQ7kNvwFbWd6q&_nc_oc=Ado6-R_tJWO5QtSYSxRaxttrx7lT-PQWCiLgeLmRVFwp1aMHy3G4_Z6IzQeTwdy1gVg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6krequbHEEbTCLlzZZ2mhJf3FCspZ0vPzyarwsBnWTrw&oe=6A01F3E9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKwXxXAGZtsQ7kNvwGC4YL2&_nc_oc=AdqmFsNEYStbN70Z3EXkUPaoVS624fJoirC0tRXu185taae_BG7YuvKgo5FLPwvjtbI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ziSDkau0os2gnhoDd6Y-25C15ht-1SCHp1SZEZdSgXw&oe=6A01CC20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMpmgNA9wQMQ7kNvwE2p6j_&_nc_oc=AdoluWMq1VjQK8NLpYncu4DmrCuNpmzY0AU1XfWm9Dl7Zh7b0nJc_pV-jPuvYWsSELo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WUJCGR-Dhz_vGCYkfJcIGqi-h-gk2FUC2IMWSWU1M0Q&oe=6A01DB45"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
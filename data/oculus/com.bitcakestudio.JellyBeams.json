uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dI9PicwPjS0Q7kNvwFi3zMX&_nc_oc=Adoz7fD32FK0Lx8HZXHdj59NuwShMQEQvQs4UG3MckwUppXsBsc1IDcZnrzh9BkdoXI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtqNSsrcEdV9375OMG4YFdTQa6iOyQk5t4AHw9mXJjTQ&oe=6A6F4F79"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5VxdANd7CQQ7kNvwFWvthz&_nc_oc=AdonzopRuQLFSCBIZOLPsmrFjZCJ_DqtSynuiaZilrSAn38EwK3Cw1IB2ZOXk03nX78&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8YDj95-YxdFAjDjT8bQAzgGK-5hQqCPnbuEICk7fE3g&oe=6A6F4360"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pZmI3rUl-MQ7kNvwHtEHe_&_nc_oc=Adr_Htet3eNrqeUvmhQFUKnrZjwC1FK83fL1sJwl3kwfaqXUGEv6NSbbwMFmK9Lyis8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1aI2OwUxLtHyY_a3oyQm0FKfID-ygxls_9n8odv5YXA&oe=6A6F2829"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QneyrUbG-8EQ7kNvwGDEpM2&_nc_oc=Adqpcd85gnbKVzpwLE96RxJO8CD6x9bKYNVRqvsZXCQD7AQM3cFY6FQu4htGFWBEvSs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3Cs3wy9q4F_DyZVEfLQPuD3p8m00egzsW-JYCsTbRLA&oe=6A6F38A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUNkyJ7NIxMQ7kNvwHypIDl&_nc_oc=Ado67fTGbSUZJ5fa_hazpexj3smiDj5qKZFS8FM_x7MExmrGjORYeK8kQxzv2x_FHxA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlfT2xpMn_D06czZIIKzOubVZRLVPUXkKO4YLrp-IuUg&oe=6A6F47C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
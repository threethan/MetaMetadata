uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiY4LB4oS5QQ7kNvwG73EEh&_nc_oc=AdojTFUO3EQ_zPXV1nt0NpXy1P5VSwAmLTjCuPJCVW0mgWTvEO1Q0Xuzmjq7_7Qv5qA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGnMzqem5VE5x7JBVjsN8PBdQArKH7Lt-9RWVBNVsLcQ&oe=6AEC8DF9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSugszPHJDgQ7kNvwEdnv7V&_nc_oc=Adovian_OSHNviRyt1qYyUZy2gnDSFTkLBnT19LIQyp1tEEU83xWKlrmjm9g76VESa8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYcLjpNao1855XeS7EjzAfny00NMpPNiBvc5HxCV_Iow&oe=6AECBA20"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WNnYNDa7QcQ7kNvwEgMdXK&_nc_oc=Adrm21mSAc0KrFe4zyE-35YwbBUkAmCI6W7JnwPHSUz10B_sW7LuoZPrXC6MSxhZo9s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLln7XRcafP0-Pf2s2br_K_WZM1JmKv62pKJDIoQD0zg&oe=6AEC9EE9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dC8R6RHaO58Q7kNvwHlbbmC&_nc_oc=AdqDzxeTlG4RazXm1tWb_j3irch-3F-5KgcY3qmMhQ7reohIUTm4KFKw5f9dsnTJGJw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCmupNXWsR42SPUY59-aMLzOyqQF1tx_L7C2EzSke3YQ&oe=6AECAF60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YyxsJq6cKQQ7kNvwE2THRF&_nc_oc=AdpNvf_Bx8DnRJMpeGuQ0c0RvpWpuEaJ12mm1lb8V0Y0AHBNV8nkglnxtZJAzIY08k4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkvrWFyRQZOY-6k5XZgNs__-VO6MS_bYTDzmxjtx8tzQ&oe=6AEC8645"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
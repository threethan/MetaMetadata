uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0a2RaEwK_4Q7kNvwHP5JXi&_nc_oc=AdqY6fAJgbH2utw96qt0h8GKE_8exlg01hhMnCGGB-b6qMj3aKv3aTGmKVLzF8z95MY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fj4dLSR0nutzX4AV9wI8sAKc3HTKGGMAoQE3R1wiLpg&oe=69D66179"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43uRXEYIYr0Q7kNvwFph7x-&_nc_oc=AdrOiEuxNKYpgqClonS1sCXEPADF3S7ZYbjnDsB8HYr34dOhZPVy26ofkJuDrzXo_Lg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o_8DVqbY4y06-Gofx0tfD44jcDt9o0Gnb8wGgRR1E3A&oe=69D65560"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoD0Poouq2QQ7kNvwHWJnc5&_nc_oc=AdrtInKajyglEBcQyLlFzPMxvifWxaTss4h9iDx10zi41QosPfPrlnrcjaFJ-4_dsHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rPPJY2QoQMM2QB0_AugLlu2EG4uaMj2ti9oyfKCSorg&oe=69D63A29"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aw_HT2lLHjQQ7kNvwGnrZLc&_nc_oc=Adr2q7yoSL1Yv2-w5jr7FarPI0AUC8zBNpuuiB6O-lbbJPU27bbN4doN0u6b6oU5dvg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QPq2KYWuPSI79X_-zHr6CQSFP6mrt05mJvFpkbyD3GQ&oe=69D64AA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1j9RdDVfuIQ7kNvwGY1lR2&_nc_oc=Adr4Jx3hrVyiRH9OqXdjFu-iU2CJijCH2hjnd_sFfNcs52ASUC0PRZopT8j7BTIeV9E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Obk0GUOA7kAObatITPkLe105nfOE0nwimqgLIKWnHGg&oe=69D659C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
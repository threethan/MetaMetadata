n.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAYBOA7BBHIQ7kNvwHv5iAA&_nc_oc=AdolbhWs3eM2ad_iLgYKF65EH0H7YwyV8Fz8NwYvJIH8Am0h2uvIJi6XNdRsT828lz0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDy4j10hHTC8JFa1RS_xjJF8_QPpyb2QuLnYxvSj0nuA&oe=6AA94560"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-2kQYiksQ4Q7kNvwGLLgTB&_nc_oc=Ado_X9jQ0gKWAFaIoQLoXZtKtHVvjgl8uycaqZXdPvn5sKNISILclYqQRjfcUHnq3N0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyVLSdjmPiPb9Y84sSiFqss5kBQcdjZgscKEKgE-9z4w&oe=6AA96269"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmmfv8c-u4wQ7kNvwHvH_op&_nc_oc=AdplwmzGuKjvSMORJdjlRvg0BG1yOVzVrdk454PgJHxFOiiiFDhEo72bab6RLJd6prI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqpIURSHdeTL_iuujBmJap0ZdEbB_jX8DFZnrvGSgTXA&oe=6AA93AA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jC-bEKklXuQQ7kNvwGat0KU&_nc_oc=Adoe7W3tHAuy-0UtYBnuz6ffqrI96rl2fOzUlDrsSx5zZTeaa9UTUpi6sNLcseny7r0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqvRGpRZjBsKIFePj_oDlxeOvkJB6FYXMMYEeiNnblXQ&oe=6AA949C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_CN", "pt_BR"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_
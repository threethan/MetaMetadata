uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoof7Ok78AEQ7kNvwFvczwl&_nc_oc=AdrWcLFfIcvb06C2-tN1i6BY7X6EhMk4aIkyR_AV7NWSYsBjZWAHrXAWLIixo_fVhZE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z28gWjiLO5OfWe__40xcd2cFRtWDyHD443-vFBCqaNA&oe=6A1D9279"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIWJEpvqaYQQ7kNvwHT4j2Y&_nc_oc=Adpd1LhoWl9qG8MyhHFyMrsnJMBc-503yHIHyKi9_yW3xIYis2ZykopI0_y1BiUagLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45usJrd06R4-PqpljMJb921GjR7y0nzDOz4_LrC1oZIg&oe=6A1D8660"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6RhwfzTBQIQ7kNvwHRX0H7&_nc_oc=AdrRKQTwLFRSnwNW6RZJ00tYbE2dJTSZRkq1fPlon3J7vY2VqEkqsQwM6hFpdlWQKgk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jmcUg4u9XMdW0s33bpXtwmnigiVoB81REQxx3aJyCwg&oe=6A1DA369"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVQCU0BCsasQ7kNvwHCWwHo&_nc_oc=Adq9BR9yGHWJa18iiKlw56wl4U4EeWGmZ3IW1qSwv7D_Q8PDfLZGw7NEwIm4IYdbmmc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61eUwhAg9lBPWvgZGqLqb5FMde2nJu1pBYa4H_6un6LQ&oe=6A1D7BA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SybnvnIw7eIQ7kNvwFCv-Td&_nc_oc=AdqEHnwaDOAWmeNJtm7TuWvdhzF9cpYoW7kMaSw5BBlWNmW1up6SkJZPXPdfsUhI9iE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5g2wrxdGqHOSmn1Zf-Km0vUCZXsAITQmZ9tJCWp5TaNw&oe=6A1D8AC5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
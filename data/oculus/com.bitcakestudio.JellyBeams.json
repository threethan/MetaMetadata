uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrK5YACOeYwQ7kNvwEPd5V0&_nc_oc=AdqtH2iY_AqTp-lT5QXkYhqS0NXXbiUx8XPPhou9QHrQVUdlMA_Kjd9ukXovF2EyQP0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCRbHU2nVwlJcustFKJnznAydaG95_dslqWhYYxAjdIA&oe=6AD0DE79"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhUw15YpyuMQ7kNvwFZYlwz&_nc_oc=AdqAWXMX8xySant838T0cXnixzGcpw6PwvTbMCRVTl8f4ovkdkEMvvWJiE-G_-3kM3E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_eF6KIQHMWUI6dgCeDAisPuVJ115806f3jC6yTMwZkA&oe=6AD0D260"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHe4qOSjd-QQ7kNvwHMIRtx&_nc_oc=AdqgiIV5vDzcTeeoeEo0AxoGOCq0-gbrEjvu4-FEY_iJvSA7W_pzAKbSiEYhYm1tML0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1q3IdNo8JKb2gkXyfP_egO_P2uqdDiVGB-lnQnrHiTg&oe=6AD0EF69"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9K2RrWOIZQQ7kNvwGjWp3E&_nc_oc=AdqK1IrKqUAa5-pvcLtj44XlxJHI9vFjAW4xXVaYzijZDWlF7zG-FTatFnLgAbY_2_A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2mJhqUAyOy9lrjSZlL7CpRJHkDhJwkpf3fnfMRxkSwA&oe=6AD0FFE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIzr9vaO5TIQ7kNvwGKyePr&_nc_oc=AdrwjOY8XijMjJX75DbukXw6qHtvDFGZpsl0LXdAp2NT1Ynv1lUJxCUd8wS_G9eD_14&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdt9w5WCKVpa9RKgBjRHA4QWxMiCkuRKN5vyd3mGLSfA&oe=6AD0D6C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
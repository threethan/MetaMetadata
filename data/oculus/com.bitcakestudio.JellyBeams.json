uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfaZzkAN3rwQ7kNvwFGtkAk&_nc_oc=Adr5SS22e2hxFz-eTd43sNYuXkPwoqFf3czser236nQLoGX5g9BAnZmicgZzgyM1CaU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpjgMVX4ajSLlGwmVPZwVxgrMKd60xICPgIJJJVXA6fw&oe=6A8AC6B9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9n6_zWqCfYQ7kNvwFhiI7w&_nc_oc=AdpE5QqshMr-voiEbFOYQukDEMOd02IRNoHfkXI1AgAeDTR4U8HPh06pU2647wjc4u8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaxQwxmWFeU3w0llq8XkxkbAb_SPMt_IWchV0KK-hqMA&oe=6A8AF2E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N51yddWgf64Q7kNvwFrgnga&_nc_oc=Adq1RQ-6-noC0N4F22FAJnWEo8zF_YOvgRTOjUORVBvkfRN4rHdM9E0V2eeoxIJdh4o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdw-2yPcKp9UP92XOqi_Sk_hYKqZP0184ZlgTwXFr85A&oe=6A8AD7A9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcd5nLSXVgIQ7kNvwF6Nrpf&_nc_oc=AdoG3uwmcXf4xntTTUKJrO5MtnAhiso_7KFrPXUea2Ykn_8vEnzcKqXSujV3uHKLgiA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1CJqXhchfVqi-3DBdaBxAI-3tNM93Tjh3db002Do-1Q&oe=6A8AE820"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0vBzrZm6BUQ7kNvwHSdnOu&_nc_oc=Adpq6bz89O5UYcUP4OCkrGZF1tC73L3LRS4tzLILoAikiqXn9t7kS6ttQY-GRgIPJXs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE56Y51OOJZKTUo0HdXtt8OeLvJ1Kq305kMF26lfxQbIg&oe=6A8AF745"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
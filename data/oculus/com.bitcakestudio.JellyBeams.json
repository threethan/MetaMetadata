uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgYgDDxJ_NQQ7kNvwFurMrw&_nc_oc=AdqW6n7yRvg6eHVTzQ1D69QkxPnr5NPD-LdQq3HiN1wkiIR1GWiLr12jmcSvqerb6lc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DpHrapzfgD13mWSFYXFaNZwUL3hfeAdwLVwjZa3OzkQ&oe=6A3E87F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwzUcUGo0H4Q7kNvwEXpMno&_nc_oc=AdrjNb45DjzsrCAOWgDx7P7tn5LQ6v-61kaIqklLANljo9gpBCOnYi6n-xc4il8bCBg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T62vmJ8y36NT5DpSYYYpDR6e22Ah8dridNC2V7JmrPA&oe=6A3E7BE0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3Se4k_CQ_UQ7kNvwHyu_rZ&_nc_oc=Ado6J7F1ivEvhZpOQYqxj6zjLrlBha6C8WtPg1S9D_XPL8UvDV_yuf-B0hxEdyLivJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pdX9XSWxY0freK1dHCmE2hmYE5xdO-A1XSGXYDp0Wuw&oe=6A3E98E9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcZCg43HbEcQ7kNvwFFQoBr&_nc_oc=AdoL6edPhx4ytwSX5CUa-2rNJMX8y0haXg59hjeaIVjfR4jD7mbLuZPbLT3gIhDHrmQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bgZU78XeyJAh6zc7g4eTf6cbhQ_URU_CSy7Y_kVp1Vw&oe=6A3EA960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mFnGyRt5hUQ7kNvwGLkx5I&_nc_oc=AdqLsrSo_d6nOvk0zsVf4TL1KsVx5feG_RQ72BBE_IfRYdUqPBMjHDlDuDOzR-t7UH4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80_Nb19XqgWai0Bwxh4KPYOwAgq6YYCkIncRmjDxRSLQ&oe=6A3E8045"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
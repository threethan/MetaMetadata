uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7OzZzHxYm0Q7kNvwG6VjKg&_nc_oc=AdrTv8twSvI-pUsvJoO_jPqni8u4e3aQ9GE_xnjti0fU5mNQ3uxynN-lr1wr1DK5_Nk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCy4szxZ_NBEwKrsthi4OuItVgJcbfshwsAz5HD_WqrUQ&oe=6A524E79"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vf_2E7wYn90Q7kNvwGM1kYo&_nc_oc=AdoGLplbVR_696DFyl_mAdamK6sLu8DQmHcVUKcyi7XZK-jG7bN4-J_q2M_was83hQ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_MZvsXvqxesb-WTSoCNa3yd8ERoqwXv7D-UOxbpa9BA&oe=6A524260"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bQkzxosMvAQ7kNvwFjqfR4&_nc_oc=AdoLkyJGMIRy0JUUOBuRwwSZPijVE73Jfi4iT3oruboWUaEjn43nWzFLxzfFwHSUCzc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEQoNt4w8tyQ33JT5WYNfPJ1m8yqc6qPsLZhwTmksJRw&oe=6A525F69"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9Fq3p4Tpe4Q7kNvwFx5LQE&_nc_oc=Ado9_t5a4yHawkhBZJXs2B7x57Xhsi1vMBP4CHHyLWMYm1wqE357lmgnMMVpHcaiK58&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfF97EC5giZDrsHrN7bc23bQxihZUP4jaUuimeJrrj2w&oe=6A5237A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLLHRsY4pM4Q7kNvwE53YuP&_nc_oc=AdqGDHFecnAXB8Cp7kH4BmsSHx1jEK6wtaiMIX1yArsvNIhzCp-IE2i8kG4YUOk2c-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRKPyYaQdQTkxs5j5H9BawHIBl9CvOlj2vwF4IxQSHtw&oe=6A5246C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQL7kj1Nj-cQ7kNvwGsR19z&_nc_oc=AdqnDEPPNUqMMJV9BPqRJQYkNvOaBdQv6_94y5gH1ORcf8aYg07mWUfElkzqMrzfT0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTUBu96qJ4OD9ZZWPON-xXNDzLAaAD9BTMudbDMiBRhQ&oe=6AC10C79"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IbMpDZlNsAQ7kNvwHvMW3u&_nc_oc=AdrZL_yo-pvLo-1_qQDtZrZXL8Lg3r21KhlydE8erhVwb4-BP_kMXM8UzLBmLHMJ6Kg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnMAEA9Jgp6ht0fN5mcZO8PC-wdox5j16VzAGFc7Jknw&oe=6AC10060"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ys6G6vwoKUYQ7kNvwG4JFwD&_nc_oc=AdoJHPGsPrQRCn_4Z3PbnNRTsSoxMhM5zcKnLEq1qDUx8omMuZB0MsqGnhHXQJ0TDaE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8a428yzMXM4utI9ks6JjuJFhL4Cgn9EZpAsjXtVXPqg&oe=6AC11D69"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7hlywdSD5MQ7kNvwFIiyKw&_nc_oc=AdqtGwkPNQbMPhs-rP-EzhGAPq8K6UL575yZuxiwQcy-u8s54iu0LvaSbwQIa8BsMuk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAKjqmn5LcXd8bxuQgpufka9vT3BScITQFFdYovafCNQ&oe=6AC12DE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGZF_FfvSXIQ7kNvwHz8kR-&_nc_oc=AdqZA1N9coXkkftUBKZyOUqhpB4OK3RF1LQbWYeLhhFvLZgsKrE7oFKxYpHzJ5mn8Wk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjoaFTAysosvsF3eE4H4ZWQWSWZcD62T9kKc_aSTYdxw&oe=6AC104C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
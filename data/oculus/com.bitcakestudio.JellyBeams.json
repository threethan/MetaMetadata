uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLUiInMXllcQ7kNvwEnakTL&_nc_oc=AdpT4rr1DO3Ng-kCMMFauRI7k1I8TAMoYMO4ILL7Nc_hXeBFkp2Tssm7Q577ndWjiHo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WitpcGMVsU7OgkomcuJIn-InKv_ERLojsG15Wfd3kNg&oe=69ECCAF9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIFxNjlpqvUQ7kNvwHtfyvk&_nc_oc=AdpUBZHvYC53H3naFm1wqo6aMxBKXpz1Gjma4w9kR1iZlWI7LODOLBdS_lSRme_gQHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oxKHidoMULbJvmx2IQswXj-mNRF4eUOmPJhzTAf0eNw&oe=69ECBEE0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QN191IO_12kQ7kNvwGqXFDF&_nc_oc=AdpSC8YOUHnIJSPWgDe8AHiWL_WJb0tYP5TWMQEN1AiXgP0J7Wzxm1tG7lmO_DyzGro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1l5nRlmsuU2l8D7XC5chs1qaHECs3vX1Di5fDngk9pUg&oe=69ECA3A9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47h5M7jGQ7QQ7kNvwEYb6B6&_nc_oc=AdpGAUBzVej6GdsRw7qWHixz_0jREnf4W6uG-W3TV8yyhpQq1qr-RkvKsbMyzlWktiE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kUAGy-D6932dtQOrDDHQccT6RxZUY8D618WAyioPv2A&oe=69ECB420"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rW89GBJFoycQ7kNvwGs9rI8&_nc_oc=Adp0ImhwXN9Rf2cgXSNA8iw1nIRvAefo_mq7pp5qh5I9EOy1I3c1BqC5mFaOT9sttPI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SMhNPRZ_sk7Q0CH1tBW8Nd6ia0w-uduh7KXbiXilkdw&oe=69ECC345"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0CA_Etzs7sQ7kNvwH5k1I8&_nc_oc=Adq2OzczAPv-KUlab3IekqRunFtK0jJ-JNnjsm7bVkVb4KCGPUvHEXv51mLx1j1W2oI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-tGYgO9eReShN6dQZYN9daxjhVNAthUVVh9zgajHucg&oe=69DCF8F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMd-NGLF2xoQ7kNvwE7YzD4&_nc_oc=Adop7TAAOaSEf1ShrrnnJpfTf3p6-hW3EboSmdBfYf-4wa5zSnMgFoT-5v1Wh6Rjxjw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oVSReqmhQ98mXastLorhUHQs2fpDhoX9xpMNzS0ndIQ&oe=69DCECE0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tgz_LyTcWgsQ7kNvwHqi5Bh&_nc_oc=Adp896AAuwZhZApzGlxBEiNMoSnNjP_gO47YNsQ5oAtxAc6TnNLvirgUTC8k_5D90Ik&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3V3jsxC2omfMiXI22twHIbBDSlQECXewa8nswzveHWJw&oe=69DCD1A9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhsyUGPORW8Q7kNvwE7T1tF&_nc_oc=AdqVj9kXKzwXPNuVAdvka-uPBKOc_aEBg2Zx5ZJvoRYmVTNQg82eEgjBMnVbrSC-4iQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vLSCV5BhKA-UXgcracaHJzS9IuEFqKOBcJPal94-GaQ&oe=69DCE220"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD-mUeebQG8Q7kNvwEi1sD7&_nc_oc=Adr8obzFktgYIe0wNPjJI7Hw3frCV4v9v3s5L5gfdGokqRTYCqTVnNkoEvLBeUf-ZHs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ih8PaYJDP519JU6H5tZE_XR_4xYxEjP7byBr795CUww&oe=69DCF145"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
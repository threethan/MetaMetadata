uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=394Jq8hdcSEQ7kNvwEiX2mp&_nc_oc=AdpFuzdcZ7-Qjsc6QibQyr5cXlrzyecwjuIajx_zd4EGSybRLeY40RHqoYThZ-VnkNY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkHG5qE9yeOxS-S127iURhHMcA6RDkck__pu04-qR_nA&oe=6A676679"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeMumcsMqXcQ7kNvwEZevGf&_nc_oc=AdoumUYGdQPyvBLKeKMjJZHCTiTj1XyJH9MF2svMDKUov6NvQF6l7qGzOOh915Hd8yg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARqa--LK51CCa90KI7v3pPICPT5t7UYMM_yIV_wg9U0Q&oe=6A675A60"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBQ4eLWto7sQ7kNvwEStdNO&_nc_oc=AdrYDIjjh8IftOZjB8_lhHS1zy5gJh4eOBUjOQDk6FhgkIdi1xqWDVvnW0xkxkH0Rs8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBteajJu7eUqWTxB-sur23FPJjPSmUOj5b30O8XRuTEiQ&oe=6A677769"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHN1UhPs0KEQ7kNvwEIdZ9B&_nc_oc=AdqPvFAiQo1Rjr2s5_8_53U7bWAI6rHMvknwOQ361qmWJ0thRUejDDJvEmrGM24Ssoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw2ynB2rtXtgJp2hCJ8_hpWvSKKD_5zvUcS84My1Wtyg&oe=6A674FA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eldde2ZpkUAQ7kNvwGccdky&_nc_oc=AdoHy76iIw8yGt_1iIq72eJZabq6rSZRSbM3r43h6MTcuVfgSN1bQzn6Pr9aKl4MQZg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxEi3XOMiQxVd9XU1cMF0ZHiAETor3C4hoeiPR9N3vFQ&oe=6A675EC5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
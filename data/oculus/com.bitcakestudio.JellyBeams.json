uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgYgDDxJ_NQQ7kNvwHA9hnZ&_nc_oc=Adp92zl4nRo-18AWO0pA3HAumGe1LcpnqlGxRjjRLUhGyx8PnCAlexR6fDI_P8hoUs0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-39tNfAmQZQ8M33QiQ2DVADY-e6WL44A8aG2A0HQda2Q&oe=6A3D3679"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5EOkGFWjYMQ7kNvwGjhNOK&_nc_oc=AdqS1GsuDGhbJrWN2aLgthRHGDtjLtq8TKFlMQ-HfhY3Uwyvtn1RFZw4tHhciJGe1tA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HFLwJNAR88SGN3R7KPcvRzoZdn1m8x9MoNktGWh_4UA&oe=6A3D2A60"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMf_y_a1Fu8Q7kNvwG-QCDa&_nc_oc=Ado9BDqyVoddh_eI79wMuu_IFMwdEUPYJxwuGxsG9nOjoGyTvg-jGxJylZp65T5kBL0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88ZtXQsvNmFW2-5dFoCA74ao3PstF2SFOovK5p0MUTAg&oe=6A3D4769"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgHo8R4JzGwQ7kNvwHIP6uw&_nc_oc=Ado184q3uLfq7R0b0l3orp2MpGd9ZXaDP5eG67mKCYTG1Cd2EDE-3Wwb61GToBAWC8o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8E60t4ZFIuFQpKiesu1EySAbouKdwJGRpHUAAjw8lK-A&oe=6A3D57E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jA2ytTr-ToQQ7kNvwEBuVIo&_nc_oc=Adrg6QYjvu9SwtjtJ-zz_xpXvm80TMpZHY2PlqzP1VdNbvJ8-Q8HskIQxuJbHgYSaSg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81m4XiOQ3wBwFUyTXJ4a7HguH4aOFolwRxFLLp8MmMSw&oe=6A3D2EC5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
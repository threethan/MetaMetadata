uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuGm6OXHsX0Q7kNvwHFGfnQ&_nc_oc=Adrt8CMA9sRX3NucuS5g0QhEKaRDcx2yRZwERyPtJ2GInxj0MUZJnoyecGS6BYhMibk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBVaOWJ3RQ4wpPLPC6-6w4LXBAf_OwkE5gBwABTZKcWQ&oe=6AB7D1F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GwOnikgzqgQ7kNvwElEUkd&_nc_oc=AdrnO6rzGFqceLse4trB1eYqTQ3SObMxwG2GS3AMMP9sri2XNuUGFadYgQ7J87ogeEU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlzueQLpwB6BeiMuUPajUMhHgd165JLbGt6ezdSAZSJQ&oe=6AB7C5E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFDIxYPMVy8Q7kNvwE4hXqy&_nc_oc=Ado0dtpAkGuePAslf3JtT7mNQpji-ZtnDqsxc5Ipqk0frioYb9pLMrL6wp6qBp3WfhM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJQBjsuLWFJzIv1X9jFpcPFgFOEx5GR1PVmEPHA34MbQ&oe=6AB7E2E9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vU6NdzV3Z3YQ7kNvwF-HsMF&_nc_oc=Adr7rSAwRXtmB8AnWLmNWyY9y5weXFD6vv84OxOsNJsuAVOpcV8kaRES0OSeQ3etVT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2brTK0C3qmeTZSOXEIjP_B1gWVsCXEgGWwahZOmuqsw&oe=6AB7BB20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_bFBMln_ykQ7kNvwHid4eV&_nc_oc=AdoTx4MAy0TohWULQkQDIUA8nVlJG6VOhjilvFQsYtIFnTMi_1q-nRCBoheMuoD0zf8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbrPsQ4mMugloaWfdi0RLWfPLGF5dQLAbbRHQYco5iMA&oe=6AB7CA45"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
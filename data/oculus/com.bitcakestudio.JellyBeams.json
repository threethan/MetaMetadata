uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeROW1_1JqAQ7kNvwGRf9DN&_nc_oc=AdqYTc7eCNK8n4XGwiLy9bDPS-d4tsNonl6C9fMQCFDowfSYynogXu-Lj9X4smNwdmk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Uy1_tnsMcSZVlYXfVgsZ3yImw17bsiIMBPogYJE4SNg&oe=6A43CDF9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4ii6NmzYCYQ7kNvwE9Np49&_nc_oc=AdoNPznbYFXEvPMxJUg_p8Kyj_ywY62fnGY4tf7PZEYUPWFGTeuTBHtcAkSS9sP7IIU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zDp5Rkc6_-eoSugLUlJXCn2qdfc1a4lpDBeRlrLvo2A&oe=6A43C1E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5Jgua08jIgQ7kNvwG6VGSh&_nc_oc=AdoSwSOkQ5UVKPKbzTvlJ-8lYu1J9IZTphPkchESayV5n4Y78oaSuTD4ZtTVgMc51h0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sCL9fg8TDpAucCCpWNVOkWr17QljP83-6_-z6aPWjRQ&oe=6A43DEE9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4C1k5BtvcHwQ7kNvwHPtS0Y&_nc_oc=AdpM1QJ4YwCG81ppQSl6f0HjtvzV4kGPYcEsce0AI-AVPcDixPBaT_IIpQeHH8YbBRQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ae5st0NEwO3WbZncsc4788lbcPCLwh4GWVToC0zETSQ&oe=6A43EF60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMm5iknEmsUQ7kNvwGyPi8f&_nc_oc=Adqi1260vOfeybwhg3L711dnYsxaq9Ry3GjJJjMWs_B-x1hPQ-BA-AxmIJPOoNOwCxM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_E7yQjW9VciL2M15UPRNgKiT9HOS1nVwU3KEPcpgfVnQ&oe=6A43C645"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
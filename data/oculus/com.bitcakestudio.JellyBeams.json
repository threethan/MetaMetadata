uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJ3Uc_1y3EUQ7kNvwGTTe-n&_nc_oc=AdpDe2G1GRBLUJ_6H9oBOxMHu4mMbR2O8Ngd4NjsVK_-DgjF7HbU8PZ5-PCj2Qeeqgw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVUoD7sybYNYiKxQ-AJyFA-5KAafXCKN9S1siWYLB0TA&oe=6AA016F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zf8vs9OM5_YQ7kNvwHDEu8x&_nc_oc=Adp8yHO_cglqqA2yiL3MsAF20-P4PHGt5gVUXvww3gV21yLyoNUVPo1A6r7cv0iE9QI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCB-BS09bUPidwsQUJwXBndtuRivFSoqEHnIb7gwF_PA&oe=6AA00AE0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uBATChDTLUQ7kNvwHo3aLV&_nc_oc=AdoqjTlVYnZH9EB_HW0VVD7k9sglVqpmLO7TuWPRCyCtcqAOw4NsubijKrYpOA7MNKE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7bFCGQVpXoTNtgw5Ocqh7HpGrnGaDYV4PtOgq1ECKwA&oe=6AA027E9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbKPaQ3UwI8Q7kNvwH3dIwf&_nc_oc=Adol60WfPyGeky4P_adYXH_r2NJUcwBpaji7AKwbWOIfgy554ho9LJwEG5NOHplXOEA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZVMEmRED2SKWu7t3Bbc2RIeG7ilpTunVa3nu3O_D3Jg&oe=6AA00020"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-y3o3CnvHgQ7kNvwG_3Tmq&_nc_oc=AdrFZAVuKDuvYOgKQgUHjzR53e3enPP_n6dN9NIh_JR_8i1OVCDg4hctUEY47tQ2fWY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwjJ3r0Iotldxgh8zRvsZxKRMehy94BZ0i6uX68p8lvA&oe=6AA00F45"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
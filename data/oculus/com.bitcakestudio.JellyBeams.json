uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arfp92Vz6oAQ7kNvwEvZOUZ&_nc_oc=AdoQgBNdQOOFZXXyOyy9dP5NzdKy2-F8vqTsuSAP23gioSc5v54sZR5T5bTGfXhTVhE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWpH9lA66dzL52YRLbi4SPfXRVc1lTeJdz6JWbyejI6w&oe=6ACB9879"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbXws1SayfcQ7kNvwE2QBgt&_nc_oc=AdrIdV0BopZmRitMK0wodCdzKrDjBFNLcLr4l_QzLlRW6WEIjNRNsK293IcUHw19RoE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBwGvh-ITYp1SH1yN4wsomCvp4aJWTV2DaVkzR0sm34Q&oe=6ACBC4A0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Up91D9uNkDAQ7kNvwGX20_S&_nc_oc=Adp1HK9hoEThJtI_-B9YnjmCMxajf2qftt5iA5a6sjt2chqiU100UBUFxLEnS0VtOpU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP84W3BQUfXIBVqvcpmjC0nFRgQwlGXqA_J7NgCsUGSAQ&oe=6ACBA969"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJl_98t-FbwQ7kNvwH9_OCk&_nc_oc=AdrMu46O3srta3aOZVl1T5nW1MlrFC7OZeCjF-HlnSJPUhSOTXOEDRW-cbYRdOOfpmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrzDDWjliwzuyjwcEX8KHjfkxb4jlAGimFMACit9WQ4w&oe=6ACBB9E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBqdF5mn1g0Q7kNvwHLR8A-&_nc_oc=AdozvvecgXixF03Rc3NC8nhGo6ZicoT5AIi2itHEYaEz2UCrW5huTV_qWXs84Es9S3A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQ5I5BKeVFxx6oXxF8KGPawomIyEQN9ann8cqfGZC3Kw&oe=6ACB90C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
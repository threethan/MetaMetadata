uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ7Bu7QDOlcQ7kNvwHERk2S&_nc_oc=AdpSc-LJlaHkG8XKHEL8f3Dv70DOYGkS2jp9M9R1BXDoVqMwnkbwq-7_wcSm0Eh2BHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-BlCBQpzACZL0OgQW1EuppuLy9ZzOs8ZPbsbS3EljOg&oe=6AF476F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOVh10NjGi8Q7kNvwGgyTt7&_nc_oc=AdoEUvkAbxhFBdgKHSU8G-xpIRBL4Aho2Oa8_MT7j5KEJQhH5zezZ9Ff1wRUv1Wyw0Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9xUU8x81sPXkgcAeIFfdbzG7j3J0Fi_Z7N116pkxnEw&oe=6AF4A320"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVBXknuw008Q7kNvwGXCNI8&_nc_oc=AdrHbhRA7GrJszkrTZk-IHF8eYISBGNl7x6Q0Lj5Rt97IF_ViLe8X9O8L-Rj_991dr8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDKKB-trsmFRZ_x-GutRbhwNSLSmxo9OIP8DvVvdnlmQ&oe=6AF487E9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzaiJ2Zuf8kQ7kNvwFmbDF2&_nc_oc=AdrNLGstXZw-ZUX4H7m8iMGDKXujx_3VMZBuYrlDkLKAYKA9SfBtFPHmkN8Uz4xwA_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMbq2ZWX_CMX9f3ovFWGHBLQIxElfSe74ADe2jntmh2A&oe=6AF49860"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYqXCBe8yyYQ7kNvwGOJDSI&_nc_oc=AdpdZFzb1LHnY2ZIUkELFd9HXuYGSrMt1OzNQDuZXf2tINsWyam3kKS_wudVp4NfwKI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpO-r6qI3px1zFmyj91UPCVJe1md2cKFM2jmKgdpDqKw&oe=6AF46F45"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
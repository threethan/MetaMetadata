uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XABS2bGIiV8Q7kNvwHEomoO&_nc_oc=AdrUUyzUF8gp5Qvak-OPnSm_KJ6ksgTT11yUBn3XeVKMmQpltkETRFzHv7OQ8u13zww&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8FwUQYibroSN30UPpV8OVaFUKa_XotYtn9-HPKorNAA&oe=69C53DF9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnIGC0vdRTsQ7kNvwGAytyV&_nc_oc=AdoJoaS5aK6443AApH7sX-mVTcVxVTILuVaXFQDnWGrVaBVit1t_OxcfXinZW9SXm80&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfgBRwmP37wZTWRGfST7PZFlTGO0AsDb84mC2ScrmTWw&oe=69C531E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30P1-cm8l8UQ7kNvwE6cVBm&_nc_oc=Adq2-QjqjhK2ElUeHWTOnpdeE9EfgbFJ_lAipEHXBID8cJC97Ioo8wQZgBF4vSiLNLQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUyhop-AQO7tRvgi3wjnb0wPnfQ-Jf4yhrkjRJ-3Hqvg&oe=69C516A9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8-d8i7f42gQ7kNvwGhixnu&_nc_oc=AdqDzjy5PQgLx4RdB7cfpcLXgzPrhNCUPse7Y0il2n8zQK7L_QwEAZJVNnjNqHiTXzg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGfTS8_B1IJ4gjXn7p3AiRzc0tqUkZC7MvByrriPnQoQ&oe=69C52720"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaLs2j7xVjEQ7kNvwFILJ5s&_nc_oc=AdovaHJ-IlZvyOVM6ZwlmoRPEbhxE5uxaWWZFzveR2ZeYztdaef9hgmiGbyqd59TPvk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBpFXKViiy_Gfoi1bRIGtP_zJDv270VogAuDUZp_AiRw&oe=69C53645"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
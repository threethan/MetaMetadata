uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbW6-dY1wiYQ7kNvwHEyzBH&_nc_oc=AdoczfJ2jiHmTrwHlDpAut2d53AxFAs10S8L1WuMmviry6nLbvsjQ56ggrzLrvus3ps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2UXtp4LU4wdTE8F2NaDSgjDEWDyvGt1ysb8L7zqBRbg&oe=6AA2B9F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gws3UrZxQLoQ7kNvwF0-F2d&_nc_oc=AdprKUAoM8lhSivisOjXo2W_JaqW_rORLWVSoKnkMgwMb3ro_310fuheJtfG1LbUJsQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ00xZD-nArdJo-fKwe8DfZuIyJr5Xlf69j1n4L5EI4ow&oe=6AA2ADE0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17nKO4VE1uYQ7kNvwFB1pKO&_nc_oc=AdobB7jJa_JNK9poN4gpxfaqYd-kHmTi0CmVqQ3cbCbP_g-d1O0hzQi3JLNEaAN42xM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK46b9PA8ja37LsR_JWMnBeAMEamtumSI13IOJ6q4QEhA&oe=6AA2CAE9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_UV9cWYGm8Q7kNvwEBjhzm&_nc_oc=AdpG9TCBzmYQBA4rueCMVcryWYd-CR7_rlOF0KWjTF62mEF7gniHaBhqBRaIJbodaSI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz4dLkhxkabEidnnIxOOQeVnrLnFWy9UIe-e2Fnx4VUw&oe=6AA2A320"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dE8AS8y9dIQ7kNvwHRJBhE&_nc_oc=AdrpMu4Fwm7Xao1VpwJp2djv1ixYEjjBcq2m1N2sFl0wKLKbyyImRIxxHC0mC4IQLP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwqVDVaa8O1xKZSdbC4dTgc6GCk121osnevC0ObOUPHQ&oe=6AA2B245"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
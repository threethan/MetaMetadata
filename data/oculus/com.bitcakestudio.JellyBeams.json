uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJ3Uc_1y3EUQ7kNvwGMnEme&_nc_oc=Adrg43aGJ_pcDFD3FfEADJjlIO3vXFeLi78N35eFJ5iBo5lx97Wb1joZIm359HrasHk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0rW3jgV22YIdJ7JkCrDmZqedLl7ncmchd8KOoKSgZ8w&oe=6AA16879"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gws3UrZxQLoQ7kNvwF6fsE1&_nc_oc=AdrDmvYh1wpu6gjYpbdN0xJYr6I9NaNqcQsWhDFf6rrYQXeuaGcB0qmH0pGXWISlqXE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiIxO1JBSb_l6pXS6_1c1vTj2yU_Gc5DN7PSGUYlQ8fQ&oe=6AA15C60"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17nKO4VE1uYQ7kNvwE4Zk_t&_nc_oc=Adof27I88oxRQduOKxiKHcjjhOQwImxje75u_7nCiKwpCFrRg6-biZCpon5ssmql8h4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpyIWSqS-pkpK2rhwbhPfdphEkj-yZEZlzHzztUhZAYA&oe=6AA17969"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_UV9cWYGm8Q7kNvwH0nsye&_nc_oc=Adomv5Gs1GV7oHZjN1xxxOJKhSQ7T_Ad-uNA14DyPC53iIUYfyhpxmOUIuCGzeveYBE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLftBBe-z4_OapL7Au2ldC0GB_MHQoL0WORxYqPAOZuSQ&oe=6AA151A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dE8AS8y9dIQ7kNvwEJvr_o&_nc_oc=AdqHwKb4PYaV4YPsLkNmzD0topSqmlvmGmWENtIM5NNAALkbXFFS3sLkJ1-z4dPm0d0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZATZLQvTVcrmM0xqb5n4DK7NibvHYi-KgKySJ2J-7LA&oe=6AA160C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
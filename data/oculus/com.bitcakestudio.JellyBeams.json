uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHR2iproV_EQ7kNvwEePE95&_nc_oc=AdqHCgTWNOVi_3Q66Q-scihYLEeIkLeuZpc6uYeQa23jW-nt79HeR_vXTL7X13s-zgA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhFUeRKblq35CnUIFe7pCHhiTjc4f2qmUVV9IC5GByag&oe=6A7889F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxkAzQlR0UIQ7kNvwFd3zJj&_nc_oc=Ado03H73Jf4wx9vQtQClOM72r-4rSOaQTkLnrJCGX6QAKyBWh85bAB3w-NcMJCkAP-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGAjvyBDOhl_E5lLrrOx_gBM1kPM6R5em1R3hq7x5uxw&oe=6A787DE0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBwfTqRl7RUQ7kNvwGrlfbD&_nc_oc=AdpMEwLzgkAsb6nO8A32dXCq0IhlPJlUwf9zxFLWkw4_HF5On0Mp4MKaHZrXVGuYbU4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_F12ONc80L3IwPV--48-WcTnauxXXTG4NyIp13YodJw&oe=6A7862A9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hD33s3MjG5MQ7kNvwEM0GHd&_nc_oc=Adr18ejIxtcS6TTQDcwnU17ec_DA6W1cSMNroShydHOF-PXqvbUYNe-cVSsyPOx3X6o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOYHzjVv2lOcUIHjxPZGp3BP0Br2md-GMOih8zvijkQA&oe=6A787320"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2-xP9bnzc8Q7kNvwFWqhWU&_nc_oc=AdqedTJjAG47Oq7VjQd0J1GuTTV1MIIqS6I-7_rYEcGvNk3XFA3cJ-p2pWbvGlnr_bk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg6XU8_eVc-Ose78dfOwU4Ot1jb_5Mgat7AprmaVa4YQ&oe=6A788245"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
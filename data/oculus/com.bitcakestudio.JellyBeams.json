uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ol9U4pyBOUUQ7kNvwEEXExo&_nc_oc=AdpvT-NkO5JuEHMQymOetAonHArp9CuNQ4qT1b3Nk31Q1SLYFTR5ZZTj4x2FJBiMTCM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NNwo4ZgdrfJ1mtx6z4veT0MNozxXDIHZL-3uL6MpDlg&oe=6A257B79"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VdU56jC2boQ7kNvwG3qOIj&_nc_oc=AdqRMb0kYH2GqcnPQ7x3HRO_zr6p68HIasO_YE4U9YCzSsLyZxRb7vtpcDlynZJxTsE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QAP7hSmYHGyFeOm_adfo0sHSrG9vW6Ldnje9UUzIU9g&oe=6A256F60"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okJCB-B3aQEQ7kNvwF9C1hY&_nc_oc=AdqqGeK2fqSYPK8MKwF4d9yhNG0-srgWMy1YXLh_KDt9RVrkJXN8lWDQKOOP3G9AeB4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AjPBhZyPRfdhP99GntQTM1L7-WkG81jErd_NbYaK6pQ&oe=6A258C69"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c76lahuTucAQ7kNvwFCc0yX&_nc_oc=AdpM-ILcJAGLqKQriWAqw2zqTjl-jPiJ9aHXkS0Sk3G3RCh70CQ94cgpT76B_COOyak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uz44rXY0UaLYWXi48PUSZr5rtMM0T470uerS1SbniHw&oe=6A259CE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bv9_npb85ZMQ7kNvwGAYlgX&_nc_oc=AdppxOebbfT98lYxmKinHx39wgbCG1QJRjp4Z4bncwHd_Kqw6IEE-wGXiO7vI1pAL64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xmfJn2gQrVDk92lqRqclC44tJ1V2rcgIW4Z8tSMGflw&oe=6A2573C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
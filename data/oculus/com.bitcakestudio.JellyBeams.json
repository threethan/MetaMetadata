uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It4kMQs77ycQ7kNvwGi5kzM&_nc_oc=Adraslm5Bmk1tRn6KuPnDYL-mIYXmEn-IE6-UJK5CtMOk8eLjGgNYEutMkuU4LQaGqI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12mOgnhRF-PSATK6JUrCF15UJMvpHf24tvZbo7X7NgKw&oe=69E0ED79"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiT9V6LY47IQ7kNvwFUNUzt&_nc_oc=AdoKESPL2qny5kCSH4BsVjxHZZ7Minwkc4eFMrJ5JFpVY7c_4XE09NOm3-vFusskiT4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32iKnKel0qYKjJ0yfeHXbZXbI2JUYa2vJHjM6ZGE_KvQ&oe=69E0E160"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S412VqFjRQMQ7kNvwHIFUE4&_nc_oc=AdrUJVB0xmgAgtSYUpErkMeXlo0xARq2SOlR7nbPdVJbZodtepvN3acFSpL7mfIFVoA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ty77cutBJ0_JQBG45ddp6d1v7ydsXBnktlKurI1el3A&oe=69E0C629"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL2ofeMQsR0Q7kNvwGjKX7R&_nc_oc=Adrl6vpEWfTpZzyFig8CVsFZWKjMogRlNyzOG3vJDSWuDKrL4I2vzu1SpwlfYqzNJe8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QNW5Agap3P5cmbDTX1XOQ2URO6zaGWzCPJ0pZm1C5lQ&oe=69E0D6A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRPQal9_h4cQ7kNvwFX6XPR&_nc_oc=AdqyVeCrfKFRx8jJVYbBWyfaBI41-yf9CIeJfXhdBcz9Sfe-gLSN82FP9NNfDwTNyzk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oT8hHOm7pLlbSX8XMG03E5jYotuVR0BrZsP1vjKEB0Q&oe=69E0E5C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
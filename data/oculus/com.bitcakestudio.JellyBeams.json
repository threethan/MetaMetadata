uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wU2DGyAzYjIQ7kNvwHevmTA&_nc_oc=Adqz3MhQli48FQhAhVMP7jVPEh8nIalGZDp_SaY1MvASD13VZsotkBdMluMTwzkM1nI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrkqyDEE1IBOWmTVxmHq6F4lFEtvJTg6gY2Xc-DGa7oQ&oe=6AA7FFF9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neGnMBl-DVEQ7kNvwFbo8YA&_nc_oc=Adol2fjSI5BUPr0mk4Ks2QR8-odbxwKVLbsJoxrYzL1U8ltNv5ChpXjmKWUZs7Ss9fE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXxZ2s5rNTbQ51b3CK0M7z0C2i4laH-Wd15t2WLaOpGw&oe=6AA7F3E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S92YpTKDDVMQ7kNvwF2yia1&_nc_oc=AdoZcX9nbbK-65tyGKA4ApuFbQGHDFLQsei0pDyUYD992gGNwrSvmzGIhZTPGVGnKW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiQEqkbyLgFMqaMtLmEKayYr_MchyhVqa-KdRk_PAHWQ&oe=6AA810E9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=300cQIbBNZYQ7kNvwHPg26B&_nc_oc=Ado1raMdEShZIbXReufatm3jIPI2_Du1EtaI2r6zhnswegSC3LguP3ScJJ_HCwwL7W0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPFGWTMVUcnSSZqsjZUqZeNTtpF_QjPZTq09-NwUqUfA&oe=6AA7E920"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9AyJkQMPOUQ7kNvwGnqzjC&_nc_oc=AdpG2R02Kn4tSqinSDT4NgrIzsircBG7loty_KA-5ZHOkCMHieadN1rsPvSKmV_P5c0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV9I7uZIn4lymlQEL6kTWg_c1PptEt0202gxdMrP97kA&oe=6AA7F845"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
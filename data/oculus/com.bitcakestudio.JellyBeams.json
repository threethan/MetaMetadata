uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoof7Ok78AEQ7kNvwESUDRQ&_nc_oc=Adq40icEQIzeUJsGTTWQTeyLcwg1QPrJ6xsUFgi5M2hDyUQDSUmmJlGz-hoV-hFzNDI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jWymmwp3maS3rShCebZbD2L-Pxv7CopGaJFqGyLFAaw&oe=6A1C40F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIWJEpvqaYQQ7kNvwHC1mAi&_nc_oc=Adpoe-h3lLrB1xV8Loz3S5z6BsiCzY8nyKoL6E0kNypQbUndzw43wwkT1rgT8FZwUS4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54nO_1vve3ayaVYq7tDNzPCvg8Rch1BU3wkdKHJ0w_Sw&oe=6A1C34E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6RhwfzTBQIQ7kNvwGXiWvo&_nc_oc=AdrFZyAzZzLDGPSOqSinZ267bsUGmjS9d-IkMFSHB5BouDjFT1Qncsr0pY7Mz_HnzTY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EOHtOmR0SrbxP_qto8uvtR8esqPKfSesvbpqy-LgEgg&oe=6A1C51E9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVQCU0BCsasQ7kNvwEgYefC&_nc_oc=AdqwigHTtzYj8Igu-tKzRTbMjAEZNxKdvqURzzxdqQydlrHLSaOC6xyp6C56to0wtFQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xxzIqPwI_uFedpfFZ-qiUMGWHwUxRC1CW2BmtrhaEtQ&oe=6A1C2A20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SybnvnIw7eIQ7kNvwG0XiJj&_nc_oc=AdrMJZhdycl8mYLf_psOWrnPNUYl5d8H7CcwuSPBIxm33R4-5UlfRa6xuo5DCoTKubk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Gpyj2_ZzeG9riI34S6dKAThj5My7Yc7u89bMz0gbDuw&oe=6A1C3945"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
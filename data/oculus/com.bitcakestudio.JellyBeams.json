uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5p0_ZQJGtfcQ7kNvwHdwr3S&_nc_oc=Adpspj2JupmVmcG2VVmd9Mlfwg703ej4kiJgJW0Vd7kAMsp2MWnO9_qJlpUdCAogUVM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAofn1fnb63tRwmKT35Kof_xzhbXaXARz1kEn8ka7AEQ&oe=6A846779"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXBZuvPZmHkQ7kNvwG6PAu9&_nc_oc=AdrK00VhSry3UvjK3-SGbwO5EzZhB3RHA3q0qlRm4CXa84bsq2bUz0DemNZpS8JGaSU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBmuwWZphSdZALWpAG09MNjIG8dwkF-UHHbf6wLhBzRg&oe=6A845B60"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C97Pv-XYBGYQ7kNvwHLV1su&_nc_oc=Adqo8QkkaD_YVniCe_FYTNgJvxjnNT2t43vjOr2dlBYDWn7zBb1iT2ESaTwyexRswxw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHj40RAElmE1s52UrwjVAa0NdAwwt5J03BUC2Q47_kO3g&oe=6A844029"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LG2qgAOqGKsQ7kNvwHBSdDz&_nc_oc=AdpOYyxYNU9zk3yOochzc3bFp_kcZHTHm2W0CMMnu7Mn7EouyvIvQvYyZyJqNtl3Cd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERK93W0nWn82LpdZeBBzhzYxIdhItCZQmM7I-FwyhcLA&oe=6A8450A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5idaQ4xOWUQ7kNvwFvCY0P&_nc_oc=AdpCh_AEc2EiL2g_dI3FfjlAapj2xSP_xCpMM2u2Yh2C_0a_V7e3L_2GTeRHhA7NoSQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVskYOxe15fcDLvHaFBsCz2gUuTDQ4zRLPxlKzP8t6FQ&oe=6A845FC5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
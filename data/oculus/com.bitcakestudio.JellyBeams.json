uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuXy4F-91RUQ7kNvwGMhCcd&_nc_oc=AdqJMMqF1yl9PODm_2vhmdTVm5xnWxZBzMNaV3CJDDRH-lpoJ0acY7B3KAGxfqKDExU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI-pW30q1UtuDpkiz8reTi9JuugzB_JkSRv3gX5loU0Q&oe=6A4D0879"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUcCh47sVkMQ7kNvwFpwl5T&_nc_oc=AdqU6a2Xx9fQ9TUS5ZJc-5vJV0uoP0bNhPngF1KbQshskVjCq40sYHDpSmfl09ahUDk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWMAaA68t5gnM46IhobWr4N8JaNs3icNur6FQSLhQ_7Q&oe=6A4CFC60"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POZre5ZX3UYQ7kNvwHue7Yp&_nc_oc=AdrmSdJFto-Pbrdbm7BDCZGqvf_xFTZsW_LVRVbjzJTU_KHZ3xgWG9WpKvd5e03XgRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIoFQKr936zcIhSuSdcCRZI2jRpJMzO6zE2tTbtQy-mA&oe=6A4D1969"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHWj_lK_QQ8Q7kNvwGsoylv&_nc_oc=AdowjAt8SZXo73Kx8eT5vHGYe6xOT2x1-otc5pG1Ac0rsxsyv2K5CNoebjeJ6fXsF1o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB29xl49QJGPMRkaDVbdxkQQkuwf1vzkxhOXQkCLzjzpg&oe=6A4CF1A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7CztzfRf8oQ7kNvwFMU7g6&_nc_oc=AdrfVElk6dSru38F-90oT2YJKqA-Zd4g7Gm5oGwWsee4d4iGLvXr4YnFj-8BTUWX1Mw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrFrINpm0jVCyW8rlA6wrN9yIsZHE-w4-G5_PdlFG-dw&oe=6A4D00C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfBPgr6SAacQ7kNvwFqPONN&_nc_oc=AdqivuqzC4cX09eM1oIvcEygAkZld0bpa23Mm3pV88Cx1IN33Yab5ur7pveelA6yWSc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xJIfN2xVYFyI0ClrysHuH6boqWtq-g5zrcslTzbItfQ&oe=69FDEE79"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0xKgnFEnDYQ7kNvwGlItC8&_nc_oc=AdoAWbG_sLhhvRAxQQEVXP92mYpQbS6RZN4wpd4oKMwaIZOE_TWoUSrar0Y6LAJhAVQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5J1I7X_bVLWbtT1gnGOnL6267QPxz6ALYYLlVgHFh9Sg&oe=69FDE260"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TECOLGKtYLAQ7kNvwHQFT0u&_nc_oc=Adr5bKe9FPjC3oqlabWkJ1VYf6ovzyKscs1Cv2GbFN6RWb58gvBsMLLibjNM3i_UTEE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_ZZ1QOlCIneOQRufFLLN7yKEIqnpKC7c8CW8zaAqz-w&oe=69FDFF69"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1gz7FuVGioQ7kNvwHLDXpO&_nc_oc=AdpQqookqL1cQCoQnRQJsF2WTskPgjhlxMY7uIS9IqZKbFCVJhLan9Y19tU0uf53ZzA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GrZY0XxUgIR6damhCTQ7hbWqE5dOQQzrMItnZjf0IgA&oe=69FDD7A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoAbmpCRIJwQ7kNvwEcOa2I&_nc_oc=Adoxdk6GRPzJHC5zk67HbKbjV-41Bmb6dvgp7-JM0D-l_j0pwEwHw605FP6WgWuGv4M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7n3Ae4IUe7vEY2czLjEVMDc278MTo42w6uFvdkERkQ8w&oe=69FDE6C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oK8NyxJ9FbcQ7kNvwFQmszK&_nc_oc=Adr673gtglpkbSGqXRt__ax8IUVRekzrxWe5FOS-SAReRyCx-Lfs8w9N2yOMSjVXmWE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0jIH9H3ZKBrHva7XZ5gviDSdqXfWHS-M7JJ0op0xTjYQ&oe=69F36279"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpJI7lJsaTkQ7kNvwHBBkFX&_nc_oc=Adr8pB4A15eKf_rSapA4JacFZKaRfws95RNxZQNutHxZ3WnEEUKAi7b3WM5RFqJgN8o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2uUn7Isi917HNUCar9g8DeUA0OZMYrea9h5sMYeI2J3g&oe=69F35660"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7Ru7xGIVB8Q7kNvwG4I6j9&_nc_oc=AdoYMOZyiU_uE_ROaOwEZ_HoOdrzorLBTOsxA2j4EsGMvMLk9cEsYLrY5ruVyJHWCbw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qB2hVCishndqRz2DeRx3XPsCk6th8XWv8lyqoOr8YAg&oe=69F37369"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnLZzq4M4sMQ7kNvwG7mCWa&_nc_oc=Adr9ip10epZmHSVSn9FhBbKmoxPfTiwfvCG_5uj-3fYfBAqZAg_FOLd-Wik-nEir4SU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25Rh8BHPccqXy8b0ChMxWCVLD8zKGwK1_nymsYU-719A&oe=69F34BA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvDle7fJ874Q7kNvwGNQHuK&_nc_oc=AdpqdlPXL-xEmdwjtLi3mvzY5OyjExoAWMJRimViDQWOzjc1FlEmuwRpmTorW5O2n1M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1P_aTrW32yz5TW-IiOQ5k3XSO-QTNTMc3nN6Z2_vrLXQ&oe=69F35AC5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
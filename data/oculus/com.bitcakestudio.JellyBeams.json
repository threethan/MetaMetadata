uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGVdTg8b_v8Q7kNvwGUates&_nc_oc=AdrFwX0Y9KqDNgCQwKTxHUSJI0FAnuZd7Nxoeqs2iPofN2Ns6o7do75E7joDPFwvJdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-DS87WdyxPomLX207vqMyGAhgH8wWUhX4XSKM_2nuag&oe=6AE747F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbK4qToQ5sIQ7kNvwEqiyE9&_nc_oc=AdpZyNHhpZmGhyCGRJzHwR78qX7fd0DUOrHFUF1kj8Q8WEODNoGbkwFM8cLxOXGn5lY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJSYm1A3Gz265LVKygYSE1zJvkA6sDRk0mIcmSsLxQUg&oe=6AE73BE0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRrwEJBuqpcQ7kNvwGtfOKJ&_nc_oc=AdqO5hJEF8ktKoB4pt5f6yo4Vla_Qca7KJaaq2jRLXJkIp9Mfp9ugHB32-CtEhd7T-U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5gm2aqxQDN0vfLkmEiN5j5G1wW8DSQzK2I8ZO1sovzg&oe=6AE758E9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N51CmHlmSqUQ7kNvwFTVQ7c&_nc_oc=Adpauydl0fmwpXfNlfPxekzjWngAkDXZ1wTc4EaExOJawA6YHLeYhtkkGVR31uLVFmU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDQdH8iscMhT5fe35LhgsC0tlJ_BtJxBYzv_yPUGIweA&oe=6AE76960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SafYmd4JeWQQ7kNvwFJuAeS&_nc_oc=AdrSeUuhRy_B-xz0t_P7ca0xFNZkgMpUUktALzfCwn7M-U2PyklcaOnJCZ8U9WBfRkQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYklmqkqtZ9YgJ4pzP5onm55BgFx6IcchSrABRBNdvdQ&oe=6AE74045"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
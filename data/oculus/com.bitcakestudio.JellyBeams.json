uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dERjgkDvr4Q7kNvwFWYCjM&_nc_oc=AdrW14pdQYvtU1nSM7Pwrrje1vYT5WRuaOHoZfYUehnwqH7zq1jwGj60unXozTZqrKk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl2mF98HMb8pa4yd1halpGYWyZP38bv7sm802t6fU7xg&oe=6A974CF9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0In9jNAZIcQ7kNvwGSC591&_nc_oc=AdqhgtcaSj3p5LIdOVFuh_XoQUZOsyPdE1B0SJtDuUYUsZSNZgkP7nTOgl6SiQwbVlg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGd7d44cmJrjg2OydR5WQxFsfbgM6jHJk0NmLkGFgbyQ&oe=6A9740E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5MjBuKdDW4Q7kNvwE4_oKh&_nc_oc=AdqDvQLBd4Ia_mEbVy1Vo1QUVnjinI8RipYmE99WR51yb62JZ9HYBZgNQsEV76aJc9w&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQX04N9okQxm4sLoujverhMqHGBpRhCW_iMCHtvMBeYQ&oe=6A9725A9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=weD-KO2dOoMQ7kNvwGL-ey8&_nc_oc=AdpHKRZUti95QRSMnHjyjq2s_QFRMB1fwlC7mM9vYiLPUVFM83BPVYX4SFy5eANOUQs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvmYGXuGALxQkq9bhUwFPlCpjUdfbnFxEoU96qgzz9yg&oe=6A973620"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWFt3rAlHCMQ7kNvwHKnnfn&_nc_oc=Adr4YROafzug0wxMX1qMgsyLTMUSaWaxY-E4VpQQwAtznOEhjKg6eZtojG7qhGBYjIo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcRHpUhXVjwFHmBn44dokEwkgMTUHpaIJzCThSkoo4XA&oe=6A974545"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snX8IXiLOJsQ7kNvwGlnCdi&_nc_oc=AdqJcfpFFug9Md8-usHA_rdQD49YocGzZyn_s2oT7ftQfth9zXVIBNfcThNmt7r4-44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Z142u7xAr7Wk6deNRBDi94xYkGro4VNWjagSoqMJ72Q&oe=6A0B1D79"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KK5gn27LCWoQ7kNvwFE4erk&_nc_oc=AdqqV7Th9TL1g4aVbc98HC9jVU60Lf968X032TkD9rKFOWvKzNN4F3FlIUUP0dYLzI0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TVhQ6EwrERSHIRoYoM2GNvG9_BX0Fmfh1RfIMbyPwvw&oe=6A0B1160"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCwHInpGTCUQ7kNvwE4asi4&_nc_oc=AdrpDDqM7xQcuwPRPeXgcpdArz_P7nhKNUbiguzg5KMaEz_YmSqjXRk7ObLJumqeMwY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51pfjS0TD2hNN3iiZstA4Z808wxMQJyEU5M3uRmR70Qw&oe=6A0B2E69"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCKbxJIa8XkQ7kNvwF_07Lo&_nc_oc=AdrOEHjfY4Kj-T2l5GRr6-eznSZkAa046QuYdQiWs8gkH7Rdefe6sY19bBCH38g3S0U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YvaBTdjwYFOma57aVc-a1u-3uoEXFe2hNRFdHOKJfUg&oe=6A0B06A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCTdr49s4jAQ7kNvwE1btwN&_nc_oc=AdrBkHqq7mRVJqpzhEQoWUsVpqK_O39bhsz6bO5WlubW0HdlkH0o9JiM4ZYSZP80iNE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ye87ybYVqPdUqD5TU2wdmNxfvz5t70hLcerYbKVcdzA&oe=6A0B15C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
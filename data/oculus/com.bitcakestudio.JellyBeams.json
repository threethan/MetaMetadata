uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeJHcYs7xvUQ7kNvwFtmA6b&_nc_oc=Adp8yJ0snk0KqSqYB-6kpz6BLdL7V7NpxrTkagzTY-zfokJVAURI-0e5ApWPyqtRl7I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1NxRbpj1XG7ANgAw_cp8ve3ie7UUOnmUqQVthP9RhIw&oe=6A803AB9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJMt2yXWA98Q7kNvwEJkLQK&_nc_oc=AdrMi9HzEcZ-mZiD2B5VudDkvv-fO58jumqqOkccZv7XQrvXfcRvXqRhQjROg56Uv-I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEusS3L4nFJGum4F1cXYMh-jwWEz0TE3SGpJkqXycRIw&oe=6A8066E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W47WVGdvC7MQ7kNvwG0730Z&_nc_oc=AdomyMULsAt3092c0AcTIsmi7FPb4dmhxKKnLqHERT0YS35iBcEMO7lavvOkyGa_PP8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdp3P6KkyryVv3B0G28Z_Q_IGUyyLMZmnAPBLljxsqUA&oe=6A804BA9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=557JT04Yvb8Q7kNvwG-ngVE&_nc_oc=AdoqA2ub0nhqYcDTu8KCPTC31C6_AQN2o4AGYbqrRGPC2TAbknwYrPI3-r3lxCqP16w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMqmETHnG3DGYdKNrCtX1gUUZo1RnvuPj9uqbhp2LFoQ&oe=6A805C20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdF8UJ3s9RYQ7kNvwFSPob7&_nc_oc=AdpxNpPjfU59ohGXc_p9yaD-09GjuYvp1U-jiLVXBXUq4De7m9Wd1S43tyByc7Ofu9A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1bdUVMkrezECGXLfZBWLllGcwFwwnJP5cd0TPVnxmFQ&oe=6A806B45"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
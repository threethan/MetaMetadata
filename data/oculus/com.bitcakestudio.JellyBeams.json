uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=394Jq8hdcSEQ7kNvwHfJbeP&_nc_oc=AdqJGLdD_ac8QlRIvvJsk-bqiNeXRCkqAmDstQldIJYx9W0dfZBSYWK1tytVX_PbSl4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfJuPfIDUGg_5Hk5QNjRtuWKT4Jh1i0nej0tH9_vIfkg&oe=6A68B7F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeMumcsMqXcQ7kNvwENbygM&_nc_oc=AdqfUUH3rDqVV7XxjPjLug2q8Q9blVD9VWBDbuzTlKTMb5neoENEuv8Kapmp6-joTsg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeDsbV5f3AMTN3aoytKeBJ9fMx8SEotMJSW1P3-udm4w&oe=6A68ABE0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBQ4eLWto7sQ7kNvwG1GgxW&_nc_oc=AdpdlJZ8zTKIHuyviMRcs6xG0PIeDbPaxWsum_ljD1OftnSQt3ZNDpmuwqUBhERX_H8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCp9u5ZXv6-in__GtDifx5k_xzI8tpi-Vy3mdM7ycjMw&oe=6A6890A9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHN1UhPs0KEQ7kNvwEWRf08&_nc_oc=Adp88kxu6zbX0Q2KkS2tmxYfQhKNJEuHPupqZ-jnfYT9P-2bACmHD-59du-b6Gh81a8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFLE_8-22Ss9UDCbzu7P-OBM5NwbjfwmA55T26AlRu_Q&oe=6A68A120"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eldde2ZpkUAQ7kNvwHqjtBi&_nc_oc=AdqoM23kiXdtE-9IKtQbJPlc5UqRFsxEYWjUIFp2P242S87vpQNp7GsEkzWaetVBG9c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBn8DraxqlLiUf_PjUfGY9ygYuN9XDYftrTBcRafxP-zg&oe=6A68B045"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zXXvSSoN-kQ7kNvwHTsc1X&_nc_oc=AdrHFENn_rVw8dGYrz1gRnP7MpJvJB6EbYCkRCHRSuqesUYVX7Ro6UvfYtDbziXgojI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ivqOwEnFsWlEQFwZW8-xC-dVwboeXS9LIzz-dyfZzjA&oe=6A412AF9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwzUcUGo0H4Q7kNvwFQsviv&_nc_oc=AdrsV-yJ0c9BrIUrC4ZLHsjKnOjdyr8r89VUs_HDXjnfmrLhkHRo73UDkEG7c08S_L0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wWlvh5xzV70nJ3Fw09uiC0eePeXn2Zg7sNqH-mjVZog&oe=6A411EE0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3Se4k_CQ_UQ7kNvwHpNzD-&_nc_oc=AdodhKfpio6S2LfyJ9qN2mJ05hYr4RUfHJMOjvMJu-5C6FnuNVfVPUUpsfPu3Oo8hWg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xMf019WZxPr6Cy4tNsLzXDIzm8wtdi4awj1IKJpAhQQ&oe=6A413BE9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcZCg43HbEcQ7kNvwG0N9Fj&_nc_oc=AdpUGzB6xVPPtiExDYNpKlAJk_vVBky7pwui8x3CbTUdlZk2gUAWbPz3wp2GwPlOTN8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JJXzrOILgOgXa6XaR_Ne1XDTnLeccAIgElQcIRpGPVQ&oe=6A411420"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mFnGyRt5hUQ7kNvwGU5CYH&_nc_oc=AdrpMwX_1HD4vQtkbzFiBxNpRin2dtmCZsEfxB71c1oAoOViPIQ7NCf7GN_wUnhRKyk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F7p07dTsJZvpNrzGVL2FXW5SrVBk3u0zswco65I_p5A&oe=6A412345"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
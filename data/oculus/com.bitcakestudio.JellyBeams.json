uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LO08ctKIPAYQ7kNvwGELxda&_nc_oc=AdqdUkFqQfYP4bSvHqwDOv5mAJ6jwc4N3FPUw28E1gZqKvcP9LoMHIeOmJAWDaYwU2Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vKSic6GrKmE7mqdFBXs1qDw1wX_S1VIOm5psHmEfZXg&oe=6A16FAF9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9nWXthlwfoQ7kNvwFa7EDZ&_nc_oc=AdqBAyMDXjWtfvM6H2_P2i1-3gNmfJjRrAUO48ktu4SoXnzUB9fKpm_fwyBt4qrAxMg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q5lTKFmqb6ByZOci_W6GZJaKyaGQORoqOiKjU__fQDg&oe=6A16EEE0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDlrTr4XtVcQ7kNvwH-ekvC&_nc_oc=AdqJrO1bVbl5U4E1roW5Ux2r8aMnxASNaKIHL_QubSybSy9AJx8uR5n0vfLWPUZ6NNE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s6WfXTlc_XhkkxZVOLPpWvse0cXuRaFUbZHawdzV9jg&oe=6A170BE9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZ3fBZwVhOAQ7kNvwE2PmnY&_nc_oc=AdpsWm9JKUoslwsVok6_Qhb9MvMLADdVBEOSSkG478xxHw0mDR7tcQzfD56fj87JXsQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UT_cjSPv8bXqgnFw0ejDoXSIroZeM0UJYLH4n7tSBfA&oe=6A16E420"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDKfqTlp4RwQ7kNvwFhHWKQ&_nc_oc=AdoGf5dLA4TlKMjSNEpaPgLE9WDAvEyTeQL9wjcpYGmidhc0VTrApSP21VzaQcKsfVE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VCvQy-COQZA_g5uxAqvEg9FwoCmqmN-PrOES78N9YHQ&oe=6A16F345"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dERjgkDvr4Q7kNvwFHBnu5&_nc_oc=AdqkAsi1FsFhj-f5VUSa3Mu2Gx_8D5puVPGz4P847Q4FF9hLjuw-fbpJh_8htTTXqSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCYFluKs7KdvBO3B_PbRTPc0UCUbzSJrb2GJ3C_62hRw&oe=6A986639"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0In9jNAZIcQ7kNvwFN5-6D&_nc_oc=Adp28OzYizsTP9tXjX-h9hyxfGmHnhC14OPrhdvBaVyDUSesf5LZOmFFq5xzDtGKBVs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSklGs6G84A6eNIRvuIDCUliEtKOUrBZ01CgP9SKy-IA&oe=6A985A20"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5MjBuKdDW4Q7kNvwHDP_Ov&_nc_oc=Adru1YG6n34UsMbar0u1CLM0KBVWa4uRghZ-nBdduFc93wQf3OEeTXFRdm-YeFrWfgc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgrIuwQAxmGCCHxFIEkXgs63b66yWqGg8vfpVHTtTc-Q&oe=6A983EE9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=weD-KO2dOoMQ7kNvwH2FNSm&_nc_oc=AdojgQWNPbqVjeogUlrOjiU0Gt9iS2eWwunhBZJwdswnzdzA-f4KOsKRgpjSl5Xt1ic&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLE7-HIfHrpp-QgVpC8eeQlluLDso3kU6FaURDB5A79WQ&oe=6A984F60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWFt3rAlHCMQ7kNvwEtFyqH&_nc_oc=Adoo7w0CMdWx8Gorqa4rkDzu0ukrlB4r42zWG5J_Dg3Jkm-v13KdwRIHmHXySkbf81U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNoPFX1c_maje3ilDE5s10N_BB287Dsnw-I7DfGqP3aw&oe=6A985E85"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
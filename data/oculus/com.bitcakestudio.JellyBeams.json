uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ENr_ckKt7UQ7kNvwF32o5E&_nc_oc=AdqK98wTAaHleiOEz08O5dVapWAz0PjrNyluVnQhasUJtDkl7lwQsNeqNALuxcpwdwQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SE8_3ojsWn3ogWVZFyW5eru6VoCoEL3URzJVIZlhyhA&oe=6A2186F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4N49zAfCAsQ7kNvwHtKlww&_nc_oc=AdoYp4F6H3jHihZqJu6n9AEYjkvwNqaZgXGhRoFNknmLFJvozq1xuULT0yGZNmbvJfY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RiWaXyzJEkT6RoiEwc9v2m8nNng5-qCladYmu2RCnKQ&oe=6A217AE0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4WyqmHAbOcQ7kNvwFlEKlE&_nc_oc=Adppk3XSzsAFlgEwuiazmdH1MJJHeENnlfQopR00OKD8K8gCz1jxelt78cr1ygiGpb4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t0Ko4M0VmMhVwTW1AL7pjBIsBxOA7gJ0XSn95NCoQVw&oe=6A2197E9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsJLMteQWnYQ7kNvwHxAG11&_nc_oc=Ados7qqrZ6v6lZX3Y0VK32Ro_DmSa0PbDhdCHf2TUGh7rYrlJZMl2-feENzJpjpkFKI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NNANIL0bVPnwAqs9yz6_slnOwNHoLrxL0z3-jXMGOsQ&oe=6A217020"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2pTFoO_HwgQ7kNvwEaFlOq&_nc_oc=AdppAxQx6gMmRwWHOK6OFuLFht1Uej72dDQu8FHHvN39GILCLs66zJo9xWuGDWiOgR8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iCoZK7qfZqRYByHh3np20gTcz0BbbDGykjwjAQ1-KLw&oe=6A217F45"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_gQzIlwoAkQ7kNvwEzroTo&_nc_oc=AdqcBU-xFHWfRbSYNmTLqFHgfLGHCUWYQgoZzBLcQZL3l7NBlY_Ta3CKYv-YFdfHcJ4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDfYBiGOLUVolU9dG3SU5-S2F9aOK6qNlrP6hpewc7VQ&oe=6A9AD0F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8DbbCBHUToQ7kNvwHeCcG-&_nc_oc=Adobj9gRzVwH4etLGqkXeQvQqgg7HgJQj4xhZ_5hvD0O39Y_E9B8wCC_YVbEopba8do&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhK9XM5acO9zvDaXyCczTMvSbl6auxALoHS4XsNMmVTA&oe=6A9AC4E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEClBDPM168Q7kNvwEsU5P4&_nc_oc=Adph1JGbZPJgtgzmgSsmNNf44Yy2ldAlDI7k9JPY-ix-0i2S71xXakltuXWM3K29QwY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTEj6Py-hgeOUuBhPszIsbaOk7mr6IGzMZoPMI8qxKPA&oe=6A9AE1E9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7Uewqyk0qEQ7kNvwENsZtG&_nc_oc=AdptoYyD1Z8ff0soQqqwkSjHZexi5waygq8yVKs4EQJwx5BPOiFy3sd1nmm2OxUrvlI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYMx-ngY2a6aFD-_kRQTdaFqLddVXp5uzktSaI-hj9Yg&oe=6A9AF260"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=We2oKsYI7HAQ7kNvwF8jj8D&_nc_oc=AdoqiwnvfvY9Gcbkq6staHB4ylndRREKQzjoD4eOf9BOCItlhqzZtHYmF5DuGhwsMyA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYpPMajvW_6I0_pBxnSO6GbUD9BPCKhahuN6JHd3zTbg&oe=6A9AC945"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
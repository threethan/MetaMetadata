uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLUiInMXllcQ7kNvwFUSJnS&_nc_oc=AdpU1TUJ7X5C_kYPYpPtGXoVhcjS6gOwDoU14j7RVGU8QXwAkiofBi8fiUA2KYzrE70&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3obrVnqGePRGLeCWTrTyuB1XxDpaupRlwCQfYYK_i1yg&oe=69EF6DF9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5eayToHh1YQ7kNvwG0P1EV&_nc_oc=Ado_UtOB2dofLYOdZa9tJPRZhWEYlejeLDp_ILKoKWFrg4qVu0hFlj-Ok1ra4yn3mXc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0XIlQk75EzyDmLfFsddROxzZiKYwbvB5xJTcOa0Z3yUg&oe=69EF61E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv_c0zDu3pYQ7kNvwH5LQDT&_nc_oc=Adp6cqzvNqkqL4aqRPbH1sYZoha10mKnra5sLxT_b_ZZU_7AHDaK2hnnhB2jAc_noDE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0IHLnatzrgf0q7g6r4TVaMOMZqETlAr1dCtuc64Crkcg&oe=69EF7EE9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDz5nRKXd1wQ7kNvwHmHM30&_nc_oc=Ado6HDHR95DeHALLjZM4MXdI7iCyE2418R7nPdpIG3Vrhb5F53BTVNagc5uGHVfGJiE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fttVG496EGUAiqXhIINzTgj07G2qwwoK4ZrNeKqt5pA&oe=69EF5720"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9Znc6d0i8gQ7kNvwFeOcnE&_nc_oc=Adqxo8TLSWNmQFBf0nkSAkb6hx6yJHZedrU_qo_wo7CWm2rYeCYNUHly_I5DHY2khZI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2w4BvFiXnkWoJrno5UZp5hIoTkjGPWVHrV1w2YtoXsXQ&oe=69EF6645"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
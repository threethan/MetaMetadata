uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeQj_4D2bAIQ7kNvwGhsW6F&_nc_oc=Ado3mAED3vZPne9uaAH7rG-rkHnptutWgSz378HhNGaBEB3SrYoIghYW4dcBC2azmFc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD51oUvoeDXptwjmIwo3myxFqzoy4C3ju7EgWuPEyg-qA&oe=6A5A3779"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rM-_i0xWyhAQ7kNvwG1_Ukc&_nc_oc=Adr2tTCAxbpab5xWNQDRqFhbxUUYF2_jW3D6mAZcuQljBXKHoj44TiPfKEQo2-Uv8UI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAN5YPyW-iIDy5PJEIlZBUqti2Yw0djcirjq4fO1mzTiw&oe=6A5A2B60"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8XMDZwZY9oQ7kNvwEa6mhV&_nc_oc=AdraSZfPsizZ_iRp3wfjJLkou53u96vYgqF9jBN65xdR2sPHqRYl3yw4gepuUdf1-Ks&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5qdr4xudt06X9IC4jNw7jty3GeMaDjllPN1HWdXKyiQ&oe=6A5A4869"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gH2lsOgTb2oQ7kNvwF4Ux5b&_nc_oc=AdrxV9ijZVrkwUNetC2QUMjJBhztJ5-xVXx8V8Oyit2yJ0ZtBMv9OTUsslyT6ZB95W4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeVHHOBuBZu2nfofRSDigd5XXhMXnizPBFzlSgRjZzLA&oe=6A5A20A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qElqTtBGqAkQ7kNvwHpUzvg&_nc_oc=AdrF3a1QnU-41aHVfIFSyYEC29Tun80Eq-YqXUnlvCtIJnf_Ymo1gOPTDPxcQE2a8Vk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_VeQoLfOpmn3L0Z9fioT_O9YNubVP5T7ODlDJtToq0g&oe=6A5A2FC5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrK5YACOeYwQ7kNvwECt_y1&_nc_oc=Adq2EPpIc5ttE93nURX_S3SjZtyJ0PP8zwqU1CCwFjevLOgvxZJamQLAG-Bu2pMiMxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ-vUOmcSflaji53vTrukXf-C6UMLrq1qUxcF0OZX5VQ&oe=6ACE3B79"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2z9UeapgnVIQ7kNvwG-1upx&_nc_oc=Adr8VjlRIuRzKU4_6X5YORSDiPvjU1AeMtRM0u6fFBg7OQ_rSvV590M-T171an_dWVo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWNQL3Cl0V9J6_uLaWvqLywFvsMc2E_KzcMl5q5YbFEw&oe=6ACE67A0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdCaWqxPd0sQ7kNvwExwWCw&_nc_oc=AdosMLuRrxVbpc5M57PbAn8BVoGTlDS7z-_DaY3TlUcB3429RFOvFNAdhemSHfAv5D8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM76EHKuEw20l7vEeTR1W-S_e8tMYejiv6k66CnUZ-4ow&oe=6ACE4C69"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWO92wnDjNwQ7kNvwHYHZy5&_nc_oc=AdrjbgeGae56tbABD3Wu8cd1ptyDKK-wNpt71uF8Z0H35aQ-QqnZnX1GG5FsPnF7z9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9TeSXq6hKPWgkjg8bXn560Js79wgwzPWNp-EJ7b-wrw&oe=6ACE5CE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQ2q2mnltNkQ7kNvwFco1sU&_nc_oc=Adrq8-j1qdAaFiiUd90b8Q3q7KEdqt-DKbveyerH0_jWArJij3LyL239HxoTm5E3Nys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx13VmYZx6riEi-lKI0C29PXLZmDhDaci9P1q_WXgu2Q&oe=6ACE6C05"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
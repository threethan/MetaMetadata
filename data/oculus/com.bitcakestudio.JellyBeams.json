uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkTF7v05JnEQ7kNvwFZOS-y&_nc_oc=Adr1IGlaiSQzW-5cuqBw88Z43Y8LgyLvJwnjG3xPWIH5hevsnGlcwjGPWp_Cojc_1U4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgRgqVdunGcND_pcRIF6VZ-GyO4fVREt-v80mlRTgWOg&oe=69CBD579"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81cCA-UQpz4Q7kNvwF7j8L9&_nc_oc=AdpWPfuqJCDbzFV4t4sVg022o7oVnTIqlav10k2QisT4wuxziLYPfJa2ivvOgpcMnpY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzFI-_4GpmEk7rqsexlJEVLNpuR9YkEI27V7IFOmyumg&oe=69CBC960"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2sv4MEeek0Q7kNvwE2Q--B&_nc_oc=AdqLuoaF3ClMiWwauIWOskecXLGhHQIsP4i67kny-HeTl8BSiBktE_8UPbJwPmbOcn8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwyw09bVS2NBIMdf63JAV4s05cT2vIdnpZRQwlxTvqyRw&oe=69CBAE29"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqE0sHUtJQIQ7kNvwHjtXHh&_nc_oc=AdpNFsOOnADw0slIgsYQzg-lJgozix9L-iH0Z_qZztmVVYTZ0cTJ3Hbz4irTooKYZNo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgMm1yI7u8l33R69AZsQ730KVeJX7Z_6VsjA02Xurstw&oe=69CBBEA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36su7bVP3kcQ7kNvwHzWHsC&_nc_oc=AdrCGb5e6YO49mpJ0Vz76zeUUkN_QO_-vZGj9Uz4SapwBt1G-sWRr5ITCFi1Pj1KN5c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZ9vhmHsNfCt5ZK3e2Fob9g3f70u4pGGl2f6j_4iNvkw&oe=69CBCDC5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
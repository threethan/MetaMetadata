uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dW8E8xo8_iwQ7kNvwHaAvsB&_nc_oc=Adr4tqK7wdMUSxM2-i8-6ejY4EXJO_5zTtzIt4xWIy0Fury-1wa9lgJ4DD7rrSPz8xU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hkMBT5a32wqFyHv8y8gesBe3CrkNebkibHGLsbtWQtw&oe=6A0C6EF9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KK5gn27LCWoQ7kNvwHEcYK8&_nc_oc=Adq-vgo-ovoDpgqj0OGK22hBD4DqYqrnCNW3suwC_U93ArYH1QldqEMRvWQ2qfQY1eA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Vy0PRKW1kMZEO2E6PKM4PpTS2-q3VT-ubUd7ETzkLRw&oe=6A0C62E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCwHInpGTCUQ7kNvwEH0Mvt&_nc_oc=Adph__w2G0wDHFeQAk9wbP7O6FNBL_hD7lHij-5aPcSJHvbyi2YqSgs487GbBcxf8UQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Pr7p1jasY1jWps3VDUHnlTowIIW4O2iWiRfQ4AA7wHA&oe=6A0C7FE9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCKbxJIa8XkQ7kNvwGrjKWK&_nc_oc=AdqhAlmI6jxf5pij7liWYw3srl-Xp0qrRPgARIREX4jjbfzhLJpYl6DL7XeHELqfdcw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qnhr3rv96h8UVcixAlfu4eIiTQ6BnAUrkPWvAFNYE2Q&oe=6A0C5820"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCTdr49s4jAQ7kNvwGWx4yr&_nc_oc=AdoihpJofR7q9WPUv3diPXreThXEbXio4xXCWRp1e8PGobHX54eii7vutFzxQWFNXYA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-H-HFmVyhBl1Oqe3QrgFiwKJuiUrMOadbfGUascdCnQ&oe=6A0C6745"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
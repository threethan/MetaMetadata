uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o79NPdlJuaoQ7kNvwHI_12i&_nc_oc=Adr2fkdQtgRyR63vTQtGVjuHnhF2_a1OcypQsc-tzPOA4iwFXNn5juv8fMncVkEMrLY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17yaj0iuzGUUZTQqqYqxiM78tqfNPK2NUOBV5SJfilqA&oe=69E8D679"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDTJ9femenwQ7kNvwEwIfkQ&_nc_oc=AdojX9xawKg9B_7VQ2HOrIKBzyDCn1BYLQtwbeeD0-P7dJ2upQ5_cgmIDe-ERrp8a-0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jx3h9UndPwGy8VJ0ZEV-uZin93C5mcF8FAOQ3VQhl7A&oe=69E8CA60"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LS7hna6NV2QQ7kNvwF5wti9&_nc_oc=AdosEJ6jeZfbmVtiQUfqzbhHdhsd7OJdrUQihU1E2fjy27-5tQn0aOYGxUWRSl7AUm0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dI_ZOYmYc3bMWKr-4k90XPWReSjkNp-ixw4uCh3mKfg&oe=69E8AF29"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxXYOLtrwm8Q7kNvwHI_uBb&_nc_oc=AdqTM05NRI2Wllkp3pvY2ISSIq4TpEirGQatfp0YNXJGs73cm7lM5Ur0YNuqhOaUI8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af168lvCguD1lSPDUQbUYK0f3nc1gucG4-d5dDtR2HPdlA&oe=69E8BFA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IEnwrcEJUIQ7kNvwGu7MKN&_nc_oc=AdrGD6qjSkef8mfd1EL6h7HkX4hz_FBSQw3jY58a7J4b51J-8YXzDgJYkmrd-eBJsrI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20cJDrwWLC6gC6Ncrfe9QEyvCH2UKvnYVOcUUz_PX4PA&oe=69E8CEC5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
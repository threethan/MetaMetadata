uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ7Bu7QDOlcQ7kNvwF4UfW7&_nc_oc=AdpNXG275inTFEJzvr-xDFPhoKYRm2601Va3nLxtqZF1pObKnxTcKMHBRNFPEPcQMPU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3jCY7V-wZdZAocCgQ5zIe4-8lpU_TgOEgg9rYp4eIYA&oe=6AF32579"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JM22VCR4LugQ7kNvwF08PGd&_nc_oc=AdroAzVlK_YMACkLknYaXPvap06a-J1tFFfQS0NLP5hkj_d8UYrtJqbrPM7aBke3Z6g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYuV37LmIMa3jWjEjYqDErIPOWsUxJiRUudHiYEUJVSg&oe=6AF351A0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuIOtRSHsNEQ7kNvwHQcRCG&_nc_oc=Adr1pOX3mEELXXbIEnhqqrASplDYCDf6d5oEi9dKnvMB3xouu3ahA8oVF8enQwVwkn0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-sqb5KxqwkU6kSOKNx96Cw4fKc_TCsxGwhXREp6iQNg&oe=6AF33669"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHnMTjSrZ08Q7kNvwF01oKI&_nc_oc=AdqRDo4At5AIhDoVIZ4xKL6bzPYhXx4M_FaHcZb_XHPfzE5qIkJpYBuJZ7d9fu3cJVY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYMx0Agg_iEmVKrAglOdsLIFJYEFHIQy31fKJTancLwg&oe=6AF346E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgdKK2Ktp3QQ7kNvwEHF_ZK&_nc_oc=Ado-iq7a9UxBHffNofsyqIKUdaBf09IbI4hr0Ecim81bH0DLXNftColvnyrDxIQ55DU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9tPMOe_hE0Fyfy7QTgnwAbmK0vviWUGZ_T9yWhEPEOg&oe=6AF35605"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWbnON5zAaEQ7kNvwFsBQ8o&_nc_oc=AdoDs_2ILhySFt2EEaepZJ3WpnqoJdXgYXPK_vihxGtBc8MuInad6FA8xTJKAH1Q_Ww&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ks4heBFxw9vEAOzvTp5sGh0wSQggp5gr2rhCpjYlqEw&oe=69E63379"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtChDLdssxYQ7kNvwGRc-Rt&_nc_oc=AdrV-qKmsNx1oReidq4NuAnnPXiSA86lK6t8wSRHheuN1s6WzGr-LqNDjtKB51jL3Oo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cuiSU9G2AjNmIahlZKdhAVxtBr6SU9sIcyCzYUdeTEw&oe=69E62760"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2Jvz_jaXIYQ7kNvwGoRiVT&_nc_oc=Adpy4Sp0BAfu0C5ACv4GbEy9-v3pft5lLo9GDv7wE5f1_omdHG6qK3QWaeAQ5-W1wRI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dLCHH0VwXBbSYfHqouHEwqrWGkULlkgFkSQ2B5qjsJQ&oe=69E64469"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rKaKo2w4gMQ7kNvwF0b0EG&_nc_oc=Adpet3SpL8xLkX8BkOrGfZcFIKseQ1qTwM9lJkYs0o80fWCSfyQdVCno-mbEd_V7X-Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NrOk-lk2dWcYRT6QhRbL6YGK0YKvnrS1pmIJfDNtVaA&oe=69E61CA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCzn-d5ecxYQ7kNvwFlXQ-E&_nc_oc=AdoT6wmi8v-M7nCsO-qu0195H_tMgixlbqPwuBO8Ug2LUZhg0hIExrpszFiRz43ew3M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hiHWW0lKPgXz6mCz1ucfwLtVGak33uqHmDm_GC0JkCg&oe=69E62BC5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
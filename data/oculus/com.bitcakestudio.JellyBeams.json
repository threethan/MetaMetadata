uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbiltDrWsDsQ7kNvwEJVCka&_nc_oc=Adrfm6TqlwsoYVePOWSC0L-G45xc-txLZvf4c9l1_Oa-tsX7tdAwHmsuqgpM6GEPLD0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3maLNdwJ1CJ-ojPXO5GN5XSGxCVw3mm_soGCnMc94ljQ&oe=69DA55F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2igLcL-FfYQ7kNvwEDMTuo&_nc_oc=Ado_IEC9x6RADGICLyaJrdFi29XlIP7tPuwDJSj3O8HXM1b22vD_maXWCuuFJvikcO8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cyHu3RHRTFFOIvb2HiA774fOqn3unKXkLe66tlUrQfg&oe=69DA49E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLWdMU9n-Q8Q7kNvwFZmlHE&_nc_oc=AdrTZXR1s3BoTpunDxZUv-MmZJ071H-ZYKhhaCfDpxYgSM8NIGtGJmq4vqdANHXgTYc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IakUjWtW2CHdvcnz6kCTfrKvdI27jFE7N-__xmfyyeg&oe=69DA2EA9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phKBBYfHqqcQ7kNvwEb3zz-&_nc_oc=AdoBWucl5MxeStG9Gk7IK-6EewaG7et3CwOgQKRv5YMzPv1nlH3U7xsbI8jJeb2jnnY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gOocudiRb35skG2sZhSrwexjNewmIlrzrU6l_GsL8Ug&oe=69DA3F20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsxtsMAdZogQ7kNvwELfBMi&_nc_oc=Adrfg5DrOi5y0ixlSm7ZL8szQBBbYorl8nb9H1wvWQ6o1PshYEIQaWRqkP8wP9x-N_k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SFERDy7kEJhwCKc7_3aKJ38NPWldfdrI6WbmLAnVW6Q&oe=69DA4E45"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7OzZzHxYm0Q7kNvwGj4OPQ&_nc_oc=AdrHYfGPqpdjgjnix6edtnSfYE7sCRyIXTMUbNK6ih1_I7UjqVrR4IOYKBH67mAYVro&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBumhK2NjpyQ76eYcURoWWctpQTU4hApkLQhUDn-bXJMA&oe=6A50FCF9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ny_uGdnrOyEQ7kNvwGd2gzO&_nc_oc=Adr76_BHCIMgp1F17jgALNbb7AOl_PYd7U9bzt2Vynvnh4yK7Dy2V3ny_JkkJUeVq54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyH_5jjn3k-MHr28gScHHcxzmRDahs7ZNo_xY4-Mbugg&oe=6A50F0E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ccZgTtwx58Q7kNvwHez4dD&_nc_oc=Adp6VFnSQFZo72dVf-5dH9fycLO7geinjzi-jZGiXhc2bsK1BA-VjLF9zBPWT6iw7wM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtEBJrfS1BOQgJr9702drVtzURusYh9LFr33K_M_0eFg&oe=6A510DE9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM5yhmorKEUQ7kNvwEGjxWW&_nc_oc=AdozkSjMq7UBf6Wo5PtTBtbUPoL7lTp8k7VGYU271cAZYvINPzu-pD2Shf1UzW81xos&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBddXV_AgKZGufMA8GfkOs60bD2ssW0yaDmKZtnddTqdw&oe=6A50E620"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=477fj78Nhg4Q7kNvwEdDZr3&_nc_oc=AdoC_qUrcEqPfT19lyX7hufmvwD7QBMuXdRidE2adEGprSWJw4ZCEp5XeT988rGPHd4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDz8F9BfyrVFfsZoL-awVK7TOJ-PhQk8lUp-kG4ztFTdg&oe=6A50F545"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
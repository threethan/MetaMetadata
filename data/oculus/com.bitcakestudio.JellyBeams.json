uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgizAU56sLwQ7kNvwF-2qLf&_nc_oc=AdoWsefkjmyDEbMZkUGd_FLN5M5a78xMG_ydn8zDmwDOgg0NjJqK_3GiAvaSydC3fO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJQfS-wT-hfi7lwnTpdZ9z3R_RgPp_XS0my1C7GdslGw&oe=6AC3AF79"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IbMpDZlNsAQ7kNvwEIJcyt&_nc_oc=AdpZzam6HBfL3ZQOZOtm92LffLHfwJfDGxen7BNpgmn_N28ZWHx4AAa22A-mqrYrADA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMK47Fe82Un096RrvS72Xi2LFNMFaTHwc0Y36koXXerrg&oe=6AC3A360"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ys6G6vwoKUYQ7kNvwHse4Lv&_nc_oc=Adqbjxmvq0tjRGNl0tXbxKtG5kIgmjZ2HTwgy7V36dsxDRjikJ_CI68MPgykd7KNlQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhk7x7Q7ShiJLI5TokyUktW9DPIXfeMZYr8hJ_XvmE4A&oe=6AC3C069"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7hlywdSD5MQ7kNvwHvIket&_nc_oc=AdqGAwAOl7NI2-5k_T_TYLIe5voLaCKac2QWq7l-gJkhmpZZwqk0NH5SSuNznTAA_aE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFGRg7HK9JMmUQwLpnoOuyDT-FnviYCMLLddCiAzYMWA&oe=6AC3D0E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGZF_FfvSXIQ7kNvwFpMrkw&_nc_oc=AdprITo_K16Z2fzPhL7ADoflnveZBcYpx3eY_v92Ba5TEH6X9BwA5AK4_A1neIJha5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMxCQ901zxJ0V8pqojGl1wTBan04IWIcD1kVO_KmXEwQ&oe=6AC3A7C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
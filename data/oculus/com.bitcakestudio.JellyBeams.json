uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It4kMQs77ycQ7kNvwEsFvHr&_nc_oc=AdrH4WuMi9M-KOfbfIDxV4m_CSGfpTxAZ_xztxmkcg9ulx1h9KKGSVFUGFUgWN1GKpk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07qxLAoL5_HgLSpQgyMx9SN_qEHSX8Fat7-x3awE-PnA&oe=69E23EF9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiT9V6LY47IQ7kNvwFmzhp6&_nc_oc=AdqH11iiIHUxPP19yDeRYFBXdTy3n6nqa0hMOFZ2OnPi7YS9Js7pytn2C8Su0UrIz4Y&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02O0pUx8tM3W1OHQIHfG2zoQ-ZPW-ZTOQwMGEndNc7-g&oe=69E232E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S412VqFjRQMQ7kNvwGRg5qj&_nc_oc=Ado8AEEKYPS26sCWt56BC_wn3TvppCPbid2bxal-Luu-cwrMvmfCT0Gza5GBG_oUnzE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DdRH1PLERUr-3WiUc3fqnMV1bCJT-wQvhl6uKE3HcLw&oe=69E24FE9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL2ofeMQsR0Q7kNvwG9PCWe&_nc_oc=Adr0fzPPkLheunD6zB9F9CH8jTduTXJUMzluV26b7M5xpXuLyf-pptyJuBj2uatoEDk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wG2dpSu33R_AN8FXB-4FY-Niwq4C5lQEHeiqz0Y0KvA&oe=69E22820"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRPQal9_h4cQ7kNvwFuGA37&_nc_oc=AdrmZDPdQu3Xol0tqfajLKGLMQ0eEQ2GnLkExmwEp2FQ8Z9ZaIG4gm77RwpbP_mZR94&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T-W5Q-C147XeWTZDgXow2IAk8ZnEywN6N-6fy7lBqew&oe=69E23745"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfBPgr6SAacQ7kNvwF1k8jQ&_nc_oc=AdqBDT1uv32Lf9KntsLLBYNuuJzQBAqXXr2yZfHxUwXNGc0BbBbINoaYZAcoeEAX1SI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YoqV-6zB2NKz9jgzh0KXAtaEtn3_3i7ftdP4gg4-NKg&oe=69FF3FF9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5pOxgT9WVwQ7kNvwE0hCF9&_nc_oc=AdpLnHlyr-ytnmDnUgSl2IAjRPEJhHcMdJsF2AHGrpyeKA0XmdzOP5SVoMTzCewzH2w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cZ7wy6nL-J5woxqUcFidJaSwt-4OEaJqRRSUQUJaukw&oe=69FF33E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2fxxt8sNmwQ7kNvwFncSkV&_nc_oc=Adp79ERfvCleIvrbrV0MF6a5uqF1ETEwhy5jWMCPa436xAovhROzGqi3LjtQMp5Hybw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qujF8r8l_7fvwilslm9eDHcD6FJuKZo2AH3afNqw14g&oe=69FF50E9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKwXxXAGZtsQ7kNvwEyAXFo&_nc_oc=AdqY1VMVHFhypa6N8UBD-9EwNvZPCelwc0kMvJ70i6u3PJ-YvpLPNbxEDvKXkbfqzWQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64A66RdfOTAAFRyGjKntmFiF-RLGab2ZqoYaD2UJm0zA&oe=69FF2920"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMpmgNA9wQMQ7kNvwHDlDs5&_nc_oc=AdrzGfCzXjPj-G7lthQmnfXi479KD5xJT21Dwe1zsbci51WWEK1rLzTQEQnOt0arO8Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IXEG_G-m9UJjk-86DXzDeHG8bBYX6WJgTpl47FQuq-Q&oe=69FF3845"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
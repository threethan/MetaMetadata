uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o79NPdlJuaoQ7kNvwF8pHL2&_nc_oc=Adqi7gl_SIKyKJgCngIc_iecJaRbEXsM4BwYHv1S2_XgGTl4rpIF0FrNQKWv-Sd-rZE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Npc5gZAToQSZj2G_rucWWzFzsLUr6vI1iG3uHkpocjQ&oe=69EB7979"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIFxNjlpqvUQ7kNvwFoFGIG&_nc_oc=Adrdu0Do6uBIo70i-m4r-iBWzJ-8owe7aUsLgslulryV8pHmPwJj4h7BhdjR52ZIFyU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z_DFdm3c9BKNxUIYYUqGjoviJeuYKoZV6k-pHmbknGA&oe=69EB6D60"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QN191IO_12kQ7kNvwFIOFVX&_nc_oc=AdocobJZ1TvGn-s5or7r3RdpeDqlLrOz6kn-F8EfF-XzUrS2AxwToHCdjaa6-iUifYA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3D-GxHCKaeUlJPfY_6bdTFRCoTqM7y8PNrk6HOz2zxrw&oe=69EB8A69"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47h5M7jGQ7QQ7kNvwHXfjti&_nc_oc=Adqjaoq00lDnBFtwbx59PGOV5BbbHnDT2g-YWYtQNWdi1aan2h_UQ9T5re5UE793fmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22cq5u81Gdv7J14zy__-T0CQaNJFokD3ZyAaIDfGLrxQ&oe=69EB62A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rW89GBJFoycQ7kNvwGjTFAx&_nc_oc=AdrzcgR2MAzTqu5wjYhrmL15JNwMFX9ltNmg6JkDLJ1azW3BqQ3bPG3ySQJciIk7hPA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jzHjYfy-qJsdi5UWnxfSata3AVRhgwH1tYauJxFo9kQ&oe=69EB71C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
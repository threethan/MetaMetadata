uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPp1AU4BU4sQ7kNvwFEBYK5&_nc_oc=AdpNvMeLyHsaTJFt1M3RfNZFSLCdvae2obRq82wodatQfBsMkybxmYjqIJRt8Vdab7o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPklWuopPgD7GETqaQ9uLpiUvLi-SUE-HqboLH8Y4VdYA&oe=6AE0B079"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Uhq_pbhqwgQ7kNvwHHaACp&_nc_oc=AdoaNQFPqQCzYcw6VMUurXS7sZegS8fJMT-17iRTmQAYWrwrulPjTsn6CZdEMBvKlcY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxkQV0rrQhqcLkA-3ZOHMdW7Qj8fhCiblIiF3ZaOjhZQ&oe=6AE0A460"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSo1DViKyZEQ7kNvwG-zOb5&_nc_oc=AdqAc2cRR5HqM5_cC58j2YlWXx2dGY2ixcN0DqwPS_7miDGASgL9lqofHDVfdVzvuMs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuCiiApBBlW-YhFYhjw-bmj9qn8GXjFZKWPUlLIjT8xg&oe=6AE0C169"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrAxIpaTOocQ7kNvwGl0HTJ&_nc_oc=AdoXbuxriepSZ4ibCBH3B0Fdy6esBQZwdmycnDvRRKn6YkGcVR5n0m7sLLx-dIz__SE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKJzTJqdlkU0VfouUFNNDlez1jXiZHusA2NnftYOZ9FA&oe=6AE099A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jn477ZIdKxIQ7kNvwGv8a2_&_nc_oc=Ado-Zzn7K54LAh0o1xKQM_Z0soz8v7ZDffrHrG_UNNuVhWziadDfyHFslmWsILBHRsU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0KafiPyjodDAkgXwi20XY_QinmN87i8yd3X7l44F2Jw&oe=6AE0A8C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
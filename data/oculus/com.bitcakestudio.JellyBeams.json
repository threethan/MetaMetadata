uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It4kMQs77ycQ7kNvwELPY6F&_nc_oc=AdrC6f6Vr5oLlBkaYHHn5LqL0QMzLG72agUm3w7iefB_8eQATGG54MFt40fAQSQJ0jg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0y3M-CUxnGVtV5XpHcS6M028zbsJX3-12WvJqmx_WTng&oe=69E39079"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtChDLdssxYQ7kNvwHAXxbR&_nc_oc=Adri_JZVj3pgXOjaiXF29bxSSyKxJ3IJauyx_d_ehGbs9kPp_a7EXi05_hqA8zoUgoE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bNptnPpkAZ4n15UV412qaRgq7iBPtBt-Ib-Sgu7hv5w&oe=69E38460"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2Jvz_jaXIYQ7kNvwFUeOCg&_nc_oc=Adpg5XMZPGRCMnSyoMdTGFKjYKn3OnkDFb-OzqKfNGWPU9KChMqxX4N4x4MCLZ6Ajsc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WfXhDjwb-3ej2elkfpJpVQxmvTbWz1srTMM4ifQjGgA&oe=69E36929"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rKaKo2w4gMQ7kNvwFpb8ok&_nc_oc=AdplST4IEOU-p7hMzoodDDgZ4Q08732bbRvfsQChoJFbdBhA4qIXKwB9UAQvR-lam_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c-sfVM1RrrVnxIGbSlNy5we7WLRx5_0OmqPV-PYg_Ew&oe=69E379A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCzn-d5ecxYQ7kNvwHiefO1&_nc_oc=AdrfHOPCh8gkLYU47en_lUD4XrCTokcAl8qy9Upr9zw_66RcplN4zUME8GbsYK_CWMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gteo2hhRnpWYZbi_v4wKmfawrz5wfgjeMZf7CwBxBWA&oe=69E388C5"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
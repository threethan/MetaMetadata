uluscdn.com/v/t64.5771-25/38974704_405254633346909_8481309642108960768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7LSYDwBUzMQ7kNvwF0Cj2P&_nc_oc=Adpgog3SVomgdA9SOjPnpEBJywVYeKMfPm7QwpC1YYA0iud_V3CWHNyJk8Z3KEIHhxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeiPt8E9IH_lwwDWBpn5W0oU1zTo3a09GlFgfumNfpwg&oe=6A4913F9"}, {"file_name": "migrated_image.png", "id": "547432135899883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031420_1982056098537478_69863660318621696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHCkFTv0x74Q7kNvwEi-SeE&_nc_oc=AdrbWTNrbLxCO2CABfEw9nHE6I_7klphazhutXijNQeXGbjR6WTgMuUEwbUxzBcIExk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmGpxEyjVd-tZmKKimdeGXA1RPhsUuvSsMZoD4eqqOLw&oe=6A4907E0"}, {"file_name": "migrated_image.png", "id": "308831266744988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031466_1932969613460943_3120359195845591040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1i9OuWL2ioQ7kNvwE5N84O&_nc_oc=Ado-75Ybun7-qIJ1cGWhRUoQvTZ15Vs4F7YgGapdapMCBz2mvZbuiY_Cur6WCJks_p8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgv1B0RDCSmqPoYVZ1xlG3o4LS9ejxT14IY-w0JQFxGg&oe=6A4924E9"}, {"file_name": "migrated_image.png", "id": "221768252213897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982607_347209535858178_3550377321590423552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3STBmlAQV8Q7kNvwHi4fJx&_nc_oc=Adrj6IJmiQVkgLkkfI9sCpkzmaFiK65lW7vP3WMlelUxt2tZdFn9YU8FTTVJ007WItA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8-aOOtjh0Du0jJwkUicNkjQ4k3lGYxHxJEzZqT0R6UQ&oe=6A48FD20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bAXdVZ", "id": "1129755660527729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974880_1129755663861062_6358041805702823936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlAIQBEKPEwQ7kNvwEyHUGf&_nc_oc=Adq_RwBaZSuzeTSUTRcgsN2QLpQ6n2fFieJDCx2JuB0DrbmlegrNpLmF7i3FunRarvE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6IacCDxnkYFOCJggxd3mHZ-op39pMsEeumYFKitl_0w&oe=6A490C45"}, "display_name": "Jelly Beams", "keywords": ["shooter", "wave", "casual", "arcade", "cute"], "long_description": "Jelly Beams is a fast and colorful arcade shooter. Grab your gun and use the motion controls to shoot all the jellies! Try to survive as long as you can as you go through wave after wave of cute jelly monsters, each with unique behaviours and mechanics.\n\nJelly Beams is a great first-time user experience in VR, with very comfortable and simple controls. At the same time, it's a challenging wave shooter that will require you to master different mechanics to get far! \n\nCurrently has 2 different modes:\n\nJelly Attack Game Mode - A wave survival-style game mode You score points for the jellies you destroy and get progressively more points as you get to later waves. As you progress you find new kinds of jellies, each with new mechanics. You only have 3 lives, so use them wisely!\n\nPractice Mode - Spawn jellies and learn their behaviors to hone your skills between runs. In this mode you have the freedom to spawn as many jellies as you want and battle them to learn how to best handle with them.", "short_description": "Jelly Beams is colorful and frenetic arcade shooter about destroying jelly monsters as fast as you can! Use the motion controls and survive as long as you can from a variety of enemies with unique mechanics."}]}, "developer_name": "BitCake Studio", "developer_privacy_policy_url": "https://bitcakestudio.com/jelly-beams-privacy-policy/", "developer_terms_of_service_url": "https://termsfeed.com/terms-service/f267774abb02a420d1eb06683d6d3c99", "publisher_name": "BitCake Studio", "support_website_url": null, "website_url": "http://www.bitcakestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_s
png", "id": "1611356533930188", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499296027_1611356537263521_6470509078941814876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_ydvgiwcbMQ7kNvwEtr_mL&_nc_oc=Adrw3CC5imZWCDP13f2F1LVUsep1-MdtA60FZbnCQjFQq1LfWEKLn3BgYGMvD_oZZIQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtS6LymrzbAtFdo8ZjIYusPppd1cXFx4w7PbB2ZDbcTQ&oe=6AA3FE42"}, {"file_name": "Untitlewerwerwerd.png", "id": "1332619151811633", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499296214_1332619155144966_4114697803364165047_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZi1D790wNoQ7kNvwEnvAwM&_nc_oc=AdpbiZMVReajsosFRqmHfzqV4Yk3lvaMSUUqVu9uI1VUOBchmkomA7u6mhLeeIljeq8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOsQWipHZbgcH2Z7nU4NcQtumeDAVa5mC4cVkwP61xcg&oe=6AA40E2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Prism Tagg", "keywords": ["Tag", "Taggers", "Monkey", "Gorilla"], "long_description": "Prism Tagg drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, monkeys, gorillas, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Prism Tagg is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "JKS", "developer_privacy_policy_url": "https://docs.google.com/document/d/1hYEf1vBkkPNtDsqfL_OXBRrrTjioz2SfTjFN0eFddes/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "JKS", "support_website_url": null, "website_url": "https://sites.google.com/view/prism-tag-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1140590595815189"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1224981367376111", "version": "95"}, "id": "986548521050974", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1140590585815190", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1224981367376111"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "986548521050974"}]}, "change_log": null, "created_date": 1788562000, "id": "1224981367376111", "version": "95", "version_code": 95, "release_status": "RELEASED", "status": "APPROVED"
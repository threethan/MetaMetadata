": "Untitlewerwerwerd.png", "id": "1611356533930188", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296027_1611356537263521_6470509078941814876_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amE5g1sRwm4Q7kNvwHvR_bE&_nc_oc=Adq6_KuukUp8NgWaQJKoiu1FYtvXmIxEWNMPVv4GHkgwUbaLt31pDPx_RZR1kZBdas4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8dpZ-WdPMV0VHpIitsDpIfSzL3hkzyAdz2ch4UdRyOg&oe=6B032282"}, {"file_name": "Untitlewerwerwerd.png", "id": "1332619151811633", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296214_1332619155144966_4114697803364165047_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQvmY1EHTzgQ7kNvwFCkVh_&_nc_oc=AdreXLS4as26eduqkoh_94Og0qyXqKaN7IencoNLWQOf2TzYNll69SOLjFE54xzrOf4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqSB6S3Idz2yzrs1bLNkBdZS3gtjYI7IxDUWW9rrDARQ&oe=6B03326E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Prism Tagg", "keywords": ["Tag", "Taggers", "Monkey", "Gorilla"], "long_description": "Prism Tagg drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, monkeys, gorillas, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Prism Tagg is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "JKS", "developer_privacy_policy_url": "https://docs.google.com/document/d/1hYEf1vBkkPNtDsqfL_OXBRrrTjioz2SfTjFN0eFddes/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "JKS", "support_website_url": null, "website_url": "https://sites.google.com/view/prism-tag-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1140590595815189"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310817_1705950707314733_6934032304063855389_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiY_rU-44PEQ7kNvwG-woO4&_nc_oc=AdoseKVgPxifcEdfBjZleg6pnFPdT06WCG4K6V236OiICTgmMMpYCPEeVr9OeFmA-uI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH9N9a8G8YLEx-tyvb1PytGLAyd4Z-QAMNJXgrynmn9A&oe=6B0315AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Prism Tagg", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1784398440, "lastRevision": {"nodes": [{"id
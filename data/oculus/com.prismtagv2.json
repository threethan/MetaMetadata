c=P6n2tukpTSsQ7kNvwFH8pW_&_nc_oc=AdpZPs7Q1_HKynWd-44YIu3PiSv0c4kIO9HFvSN-CxfzXL6GEMVSNq0e14THOmtuI-E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIdvORNVIz-Tm81Ozp6GW7cXKgi7bJnlux9QMijBN_cQ&oe=6A8AF1C2"}, {"file_name": "Untitlewerwerwerd.png", "id": "1332619151811633", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499296214_1332619155144966_4114697803364165047_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4d8Hwv8fY84Q7kNvwFnMUwj&_nc_oc=AdoYp5anYwB-kEo6fBkhDItj-gg5I4FgoUUhQonhbdz6gB2XWcjV-oJ9G5S4J5FuTDY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrbJ2cMPjeRqx057F8GwgMSiNTKkcuFfOHr9NcueHfrg&oe=6A8AC96E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Prism Tagg", "keywords": ["Tag", "Taggers", "Monkey", "Gorilla"], "long_description": "Prism Tagg drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, monkeys, gorillas, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Prism Tagg is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "JKS", "developer_privacy_policy_url": "https://docs.google.com/document/d/1hYEf1vBkkPNtDsqfL_OXBRrrTjioz2SfTjFN0eFddes/edit?usp=sharing", "developer_
uluscdn.com/v/t64.5771-25/499314648_1981797145955463_4038575403518686057_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ee-TGaGxohAQ7kNvwEnN8SC&_nc_oc=AdoUA1cYU5gL-KRtKEew8Nm_DkIfBh-t9Zrho_HHJodboGnIEpynCrDy25R7vrMSAgw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4lvBocihbtTHf7IgAu5AgW2zLso08YLe_hSN7hPvgpg&oe=6A8C3478"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-black-solid-color-background.png", "id": "600952126192265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295652_600952129525598_4495675431746120279_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9O_nfg8BwPMQ7kNvwFlFj1g&_nc_oc=AdphsfkbEQammirFeZeMvvywjff2LXPYKMVcU_ERe0DSr2aoPCYLfYxpuIio51Sn-ws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyOVSUVE_gZaDoAiwBJJx317_IFA2KRqJjX04_wMK3aA&oe=6A8C47B0"}, "display_name": "Monke Bros", "keywords": [], "long_description": "A monke game. very long description lol", "short_description": "Monke Bros is a hangout game with a overused locomotion system where players move their arms to move the arms of monke. It is still fairly new and might contain bugs but it is still a work in progress. The game includes a small stand by the beach where you can equip a few cosmetics. Players spawn in a hollowed out stump with a tarp over it. In that stump, players can change their name and color. The map is large but very empty. This game is kind of boring but it will get better."}]}, "developer_name": "XSon/Luna", "developer_privacy_policy_url": "https://sites.google.com/view/monkebros/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XSon", "support_website_url": null, "website_url": "https://sites.google.com/view/monkebros/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "10237707857226
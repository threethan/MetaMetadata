uluscdn.com/v/t64.5771-25/499314648_1981797145955463_4038575403518686057_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKMJHU-fPIAQ7kNvwEws2gf&_nc_oc=AdpR69J-e9zWM0QkSniiPKxk1Bnw-5PKli3XZl1_1PpFXkCNMxmqvvbX0hxPIg8kU9A&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrHazJtiSIe-_MsOpLD2tWNzhbtbYpEnzFVGfKziKhew&oe=6A917A78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-black-solid-color-background.png", "id": "600952126192265", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499295652_600952129525598_4495675431746120279_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=karUG7dQFu8Q7kNvwH3b7rw&_nc_oc=AdpFe6DfvJo7i6ZJvCASXRvppDVaa4fqVz1tuf0jaBfuxcwe1gJVS2tDjepo-UrywTE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOa8ZssoLbsw2b4AKhMl30S-4MgCGsbJ8inn56fY7qpA&oe=6A918DB0"}, "display_name": "Monke Bros", "keywords": [], "long_description": "A monke game. very long description lol", "short_description": "Monke Bros is a hangout game with a overused locomotion system where players move their arms to move the arms of monke. It is still fairly new and might contain bugs but it is still a work in progress. The game includes a small stand by the beach where you can equip a few cosmetics. Players spawn in a hollowed out stump with a tarp over it. In that stump, players can change their name and color. The map is large but very empty. This game is kind of boring but it will get better."}]}, "developer_name": "XSon/Luna", "developer_privacy_policy_url": "https://sites.google.com/view/monkebros/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XSon", "support_website_url": null, "website_url": "https://sites.google.com/view/monkebros/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "10237707857226
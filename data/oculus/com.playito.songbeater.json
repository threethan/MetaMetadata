088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvYpap6WiJIQ7kNvwHVHkRm&_nc_oc=AdrhYjhUnuedPESEV1iFlNMpZVQrB-8qLXxNg_KjDifULkErGhUUMtasCVehH4O1j2Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK25ByEPHUEa2Aq7PZPWB3PyqFj4Vod_R8R9at6n_DMQ&oe=6A81AD61"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UzeDnhWTLMQ7kNvwHPapUI&_nc_oc=AdrAcKjKhk4-6csv4SfBgrCGUyilUylm8vS8s-Zf2MEeon10LsI_WBVvB4Bkpd9wcWQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdl7OJA18xOnyt3OeX1nsMUeUfSof93Cl0hhHo_fUPMQ&oe=6A819659"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcFQzO2yC28Q7kNvwEQ6i3Q&_nc_oc=AdrgLClIpE_exEi3XYo_vClKLfNAvw7Xe7Xq14SyrFH2hd9wmI03-mA8HbHByIe075o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECHn5kxLF1kEDmR1LjgzLKuX6Ha6ga-jUJ32LjaeMs9Q&oe=6A8193C6"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mQGrt-WC48Q7kNvwFef3Bp&_nc_oc=AdoeCO5jOu3iuxiIWE9gQ5AIY0vtLV8XXp9m97IyNYyW8Hb3pCJYYY9fvvWH2XYnpT0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsIhuEYsrPtwVWfbBH0uV-O8pEh1N5sFw_AX1w28dslA&oe=6A8196B6"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ2aiSlchFQQ7kNvwG485D9&_nc_oc=AdoyBZBiRPXJ7_8VMqJls3hWefgD0yNLW48xhjSocFcX3nMOprUAeRUB4CivfvtggTQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmD_Zi_se07WBaqBIOS9LfOG3ng8k2pgb8JK2LNLeGVw&oe=6A81990A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ath2MJeKRjYQ7kNvwGLF0Lz&_nc_oc=AdrlhFCT3gHv04hOC-_fcGfwaLMnvU937FoI9PXE6nAtD0SdBPQennMXR1vtL50ZMgk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLef0Da_oacKcRr0AEvWIrx3aGqA4QUAJ6uY6BT7mJVlw&oe=6AB66961"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSDi7cweisgQ7kNvwE_qaX3&_nc_oc=Adp8QAe9MsSi794eVhZ7SYvhNZd6gYWLEermDD4W7j5PsfAHegohpCpgFJ5gM_p5d4A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUggnNRp8IOu3jX7_7mS8ut5L9AUat0lW1qqIYsGje_w&oe=6AB68A99"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuLWUMpr05MQ7kNvwE2xjhp&_nc_oc=Adr4nHzCEKV3WMHU1hyIB_OYK3h8Qzk3R7kZZaIaOtMWsuKeihLqIhKxEm9GfTkbv_Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLch71SGM-OCEp4s9-RdDiPw6tNSjG7kD3G3HfJGPyLMA&oe=6AB68806"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JxZCII1gtMQ7kNvwGs93DX&_nc_oc=AdqNIpWi8tVfgW5jU15N25d-O5sym7d-TWLElQ6rCLPEZG-PiD1y1hyGx3FcT1RhpBo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrQ0PPXoOQXMNZFI36O5eNlTtqDaMfXZY_4mKh0Xiujg&oe=6AB68AF6"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PL3G44rob6YQ7kNvwHLdDKs&_nc_oc=AdrICXIJiFxMHBSM22l1PFXapIKbE74ta6VrknU7hA-QOFNTJZWPDT3ZScu2P3DrYfg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1NxgXVCkXKk3AgINUqwYKZYYuDBD-5T23H0kQj4kf5Q&oe=6AB68D4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
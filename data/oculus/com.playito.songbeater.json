088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7ztKzt3EIQQ7kNvwFII1Gk&_nc_oc=AdrlRKwEqpdJ33khsVbtmRilBn8_fi5NLXnQqTtTc7fNCwvmV70WQWBOUxLeg6gPFqQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN8g6qQXkzQ-yIP_tPDP0KhSi8LvTH0d2ORxkADzhmjw&oe=6A732CE1"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZ0wYb_wtQkQ7kNvwHmRcsP&_nc_oc=AdrhdlQm3aXH2GeK9A6I4y_SoRr654XecL2Nu3pJYEMmNTgor649gRZJ8ntYEHMxlCI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9_k_8o-JWmaEkVlIlOyn_aECWf63fddVP9kfkVJDXeg&oe=6A734E19"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhRKwv_gf8UQ7kNvwGiGCMY&_nc_oc=AdrmKjJ4R-K4WtsuwHWm4FjtTJmAl-_o7tP0rmkpOZPWOVdAneUlahieG1M2CIusQcw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpc0AsQlJ-EGdcD6BS7q0GOvsGVjxV6SKc8qxhf40BDw&oe=6A734B86"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiszrZXX5vgQ7kNvwF-1PvU&_nc_oc=AdrgUSDRpI3IsUm95izau6yWf0aP6ggYS5n5sji6LkEy4twMKejuEDAZg2N7Pg5jqds&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpFeVFYgIpKK5eNVuzr1SX3Jj_HTmSV71EYDUnIZWl0w&oe=6A734E76"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyxPyAGrmTIQ7kNvwF7jWCQ&_nc_oc=AdpYukKehvZim5rpFkMb-zTOF8zXy8Z0clZg_OHY4qSLo9GcEyEaJ64cQiLAdjGFmb8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERdA_WsUr1zaoRGoIukxWxNe0OmAdmmuEaknBvH8mv6Q&oe=6A7350CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
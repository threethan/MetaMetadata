088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAj2Kg8AEQcQ7kNvwHrRFWE&_nc_oc=AdoOfhJD7sc7RHirrxWaU54RaqdzbeWFIheYvuJfm0N2slUC62NJxvroRMsmODS4WwU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7d90QIMh01wlPMbizzxSQQ-KTTxo9E08z60TaaRZPcw&oe=6A244B21"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otP70YRDAhcQ7kNvwGLjTWN&_nc_oc=Adp4i3iRP4WtWalyA6Q8GlxQ5vyPe3ZtoJu5A0dtcX0Rd6gzTFvxZwsbAyHIAgBRA-c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_n63dWKqBFAfMuewSrDnwMghWhRUm_dPd9JZ1oMjm84w&oe=6A243419"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQ9e2jBzztYQ7kNvwHpPap5&_nc_oc=Ado0_P3FHtfQRxE36ADym3OgYu2f6JlFHJxt6PUGciUDVD9QqEjFapGkZ9elS3CUKeY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sB7LYs3v-mEP67pbXzR8aV0ZpKfdCG2XXNH34ii_Msw&oe=6A243186"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8GiaF7ekg0Q7kNvwE3lAWr&_nc_oc=AdpmWdn8mzDgsbqxtPji-CBaoQWPxxuBMBH_MgP7zBSMcmoV8f2J58xlgVXW9A8JSKA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_vzqnvauRSqHoVl790ZajADclKOuCqnEBHJPsiLZaqg&oe=6A243476"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfilJEOKb3YQ7kNvwFXWFhQ&_nc_oc=AdqxQAPHqHbGFo4iZ567WSeaic5sbGWWrS60kOpK4urijxC_KvvnvTbYai2x3j6FMPU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WJ4DyvxS-KqeFMfzeo6nnG7hKpAQKk7RpSWTUs98Lsw&oe=6A2436CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
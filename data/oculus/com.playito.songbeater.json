088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fB-B1lzkXwgQ7kNvwH8LQUQ&_nc_oc=Ado8KYZHa1wO_nFaSMjgLgkIifT58SPEwouAvdqVwr9k-pNPXUeNXDEnuFK4CmyzNC4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TYRp39ceWMGbI7iT_dZANKpBmaFrOsJUwVOQtVUXIxA&oe=6A43EF21"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwcvBebwqd0Q7kNvwEvlPHi&_nc_oc=AdrRI-BHEYibocjjVQBDFyW_rCYv9OVCkw4owrSPj8s3Ev2xfPGeCst6E-0UXDuGOF8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wQ3jAy4R9pMX_f5zOaAZsnYIA6lcrQK8mO5-tkleuuA&oe=6A43D819"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAAyOTuABKgQ7kNvwHrQA9B&_nc_oc=AdovjikK-cYIS-ibrqFIGwSeVLGx-F4FE0jYj-0cSHJP4bC43RiTqrpsu_3Ozd_6Ohk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fWyV1u9Ato6ZyYjcbTuAjVm25YfJ58pnX_jDDlxpGlA&oe=6A43D586"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dp7c2bqHWXwQ7kNvwHZIkHN&_nc_oc=Ado71-JeHLu-w_E2Nxd42e6_m5BfUcUzB5LGIbPCvJPArtQMxWMOCSta7-9KWZ__gYM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oZuZQwquFkbiMLLqq0ObEay4js4oVmCQI3McTRHfZGg&oe=6A43D876"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgCMFmniUE4Q7kNvwHyiqH3&_nc_oc=AdqlSPoQornI52HNguQO6v2e0JJOS-2UZcf_mXnU8r-TKBH3MY7YfeBg_mWJfjbl1D0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FLqR4ikzu_a4dYsLRgfpz2W2bVHEcSumT4NHK0tay0g&oe=6A43DACA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2PyejFXa9YQ7kNvwFvUU0j&_nc_oc=Adod46QU89RJGpYa2m354TCtrgXadPWgn5PCZE4W1K_uMZUqphvduxk26vFWDl73m1A&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vBIA27a3aBcKiXnETyVv1T2RL-25pKTOW10zj2uXnTQ&oe=69F5EE61"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHWd8xx9CTkQ7kNvwGjDnFk&_nc_oc=AdqNBcCEx4W58mLYkwW550YMuIYKPh2BTCVwXEsVbe4fDDx384hyzbHOaIcIGq-Sg68&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SxuJAevSt5K50wtyy8jqiVwG6I9FX_4NPJ848GhHRJg&oe=69F60F99"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaTWoDTwUCgQ7kNvwGnMjQi&_nc_oc=AdpoPCR5I56int2_fbETEsEmx_wbjOUz9jM_qlTkfhBh_cR-d6nr4ArnczTC_r1Fkhg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ZfIgCOBRYoEZw0BTea1GM_J9gawMRTgUMuxgsooYIkQ&oe=69F60D06"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=se8t108LXyoQ7kNvwGZnq-T&_nc_oc=AdrSYVFDkFqn_qp2usXHtbIPgUNMXXB1TUZvSgN9fPPmO3dJIGsG6bJi_ZEynE8-yOk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1TwzrdsAGN-AQ1qlTJpTU0BWpJqFTtg_P9kHt_3EmtgA&oe=69F60FF6"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5OnWkALNE0Q7kNvwE6-T-C&_nc_oc=AdrygE-bEPi15jRKdWv2ak1CVZM0l3w4JTL10chRg_Qz2ZTNqV3XHy7DspYqPMgwf-A&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38r4Tipvm3ehRJFsv55_Lk6SMQiWeOqWNR1BK7KEaGcQ&oe=69F6124A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
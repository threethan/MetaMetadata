088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Svez1IcIVkwQ7kNvwHaFvIO&_nc_oc=AdpHOev3TkzpEez2s5Ism2uV6-1b9mej5ArlI-xSz39LFd--tOMon3e976XxX_c6bRA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqo6cAOX0LcZ7UKnz4n03HfPrZqsMmNgiY0A5lmQd3cQ&oe=6AAA8BE1"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unlEje74wmsQ7kNvwHyVab8&_nc_oc=Adp0Fww_LL0Gn1W5063zzh1DfEdrOjibB1o7db6n7f5G20_eT1aOSIhp0qlGRNNPtzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJ8q4ddPTdajxiwNpQqSKxButO7WCqaAjGYjRlna0DPA&oe=6AAAAD19"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqcfW-82mCIQ7kNvwHe1KIh&_nc_oc=Adpc7c42TJklwAbJ2qVnZsT486equHj1LoiKfCfN4vlKsAk2jSdMqM7f7fJSnRoWWJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ13xjysEsk1cg9BgzxXWsrcOup6Z_G6G_gLGvJaADGcw&oe=6AAAAA86"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DcclhbJtiAQ7kNvwGYz6_1&_nc_oc=AdqRJzLIyvuvWhZAIGL4Tj6nR_qJAvxXAzOoSgFLDmSi5RdOObKqgxHgeoYyr7Xdeeg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoIpkyunKhxReLFu7Y0UDATFViD88zMi0kCCD7VD-cLw&oe=6AAAAD76"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0P5sZl7S-tMQ7kNvwEuvihV&_nc_oc=AdpBBxIK7EFCGerI3FjaSp-NOwA0Q8KsNa0bevwMTTKUHV4jCbQy-J2gJpI0UrGXpes&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItXqKCNXlV-r2BculgX0FV5931_GtINmJ0KX4IMOOHdw&oe=6AAAAFCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
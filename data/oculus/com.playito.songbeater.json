088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h29ahM6zOHgQ7kNvwFFO_ou&_nc_oc=AdpyfEGW1XVx5Ln2oP5itN1gi4xesAduIAWV4dcsnAyM2M8_lOhPxA3eXmM-oE1K15E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pZb2nNmq_ptbJUJNY7rd_Jov8MavlpFAA9SwfqpsEMA&oe=6A0C57E1"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjT99u4w2E8Q7kNvwExKJB1&_nc_oc=AdpsZgdhUeO-fYYfGT7REERn9C3KDP3gBNVBCFTVnSE2SUv-qYnvFhYsk17tLVDuJd8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72oH540Rn_xkfARlZ9C2NxXjv-5p7YAoMUH1Y9IMH77g&oe=6A0C7919"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAjKXrsADREQ7kNvwHGic6u&_nc_oc=AdqSueJRC4c1uTsFITLeRs-Q8cXMbSOrvnh2uqOw8oKyGkCgLqpDy9uuLEXi6QZ1X5c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rCJ0Moqov-7kKuSl1iI6SXnBQHli3MnnW_ZQnQvrRxA&oe=6A0C7686"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GwsT_O0JVoQ7kNvwFxi-dZ&_nc_oc=AdqNKNLe7z4hdGj99VBOpqb_7Gin4r1bzvgTMsfYwbDUkOmW94_aRv_oCs5qhhyni1o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y-weYx_CGGgnaYaPmEal2yDYjmLYjyjiKCM320s0tMQ&oe=6A0C7976"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3k6Q2veKkcQ7kNvwF52E30&_nc_oc=AdofZa7n-kcMquU7r038ZcIphDTDAQhGPlakCs--DSTjl2EMffab9aNbMzBZ5b2HS3Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mZa3U14ZEWz-qYV5x0Z8jBzKkyyKMRPPkQfeStpQEsg&oe=6A0C7BCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
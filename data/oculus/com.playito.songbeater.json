088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rYlP9s_p0QQ7kNvwEVULYk&_nc_oc=Ado4cPKa7blPUUqIQsC7ZIJaxDQY2wejn6INugnds_L8lCQypYJHi7pMlNDnt7fGplA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OWLrk4IIn8VYVnXFUViLlWNf3xtW3Pr39TBmwLQLfng&oe=69FDD761"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NWHNEwDgcwQ7kNvwGIdoEb&_nc_oc=Adq-dYWpJ38QCMrK3ZJbVlW_rurwbIrRmD7tUnGTj34FGEbsz7mXG7v_6ZWdQQEW1KI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TLmsrw-CSpI3O324ZukDS_QtMzlBwjMsdSPo_jiMRpg&oe=69FDF899"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3bVFRHzeNwQ7kNvwGQjVGn&_nc_oc=AdrhqgGJ682NAzLvgXHwSTLW5t39PlWJm1A7bjki7ilLghrHdjOkBVrFNpRk7nB1dGk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VNHR52PXNK6E2e71CjQ03KykQlMi4jo1vBOa1d7446A&oe=69FDF606"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltUBmFjN9EkQ7kNvwFb1_4D&_nc_oc=AdrvPhyhDWd-tQF4SR1waZyCoj5l8eoLCX4M2L8fN44haMumwB9xl89v6Y3Q1K4J87E&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WhxRzezcHoK98ywwU4dpHRUdljQyVT4CcVtOkfnHhVg&oe=69FDF8F6"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahtpVzqhEjoQ7kNvwHhgQdg&_nc_oc=AdqbVZ5jlBvq8fG-OJDEZG3aN_2DJZbGZ4l0hjGX_JwC7d_b3wpT58K_ioHbXpkyP3k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YE_9m7j4e1-QsvlFkjQTmFy3G_L-dV4rVtvw2P1eyxQ&oe=69FDFB4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20C3e1V-LecQ7kNvwGHG7gq&_nc_oc=Ado8sOY1zrkZ_98ofa40DyN0Og4z9nQgcaotzARwhdUlTzYdwWLlHVYVdEuBSVSrkC8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygJNA06dS2Cj3GnIGJELQbOO6LyDq1h87J5mS7MhUxBg&oe=69D10461"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDsKpFUB4qkQ7kNvwG23gj1&_nc_oc=AdpCINp_3sUpTHtSaYlLsdM4Y7SP4LeP9q8wX19DvA4662QGE2RM4P_32PD0iDY5fIw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afya06YLBq8uyhUGMRBsPOe2iIt22JgfqkPRR2Fl5HWjIw&oe=69D12599"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFr8hWvIlqAQ7kNvwGzgz8G&_nc_oc=Adr1eue1s3FiEFl7bRMn22cbUiDmYp4OzNNmdGTh6S-73HnO3z4hmfJqZtg6sdZQZ7g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGoakPcLjgxBHsmUpsDOogQCsv0U5F_uAhrQgb-wMqzg&oe=69D12306"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XmVsQO7cn8Q7kNvwG5wp98&_nc_oc=AdpGMiqFvpDD4pgE-7puB5xGS9P70bg_qwMRLGqY0HJ9xzkV9c9K_1Fpu7RGOMVKCy8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2ojQaG5SkRiOgHOcmhhJvZ_XMeM_C6PD3JLJ1Y_HjiA&oe=69D0EDB6"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37AegNovMpUQ7kNvwE3XMJl&_nc_oc=AdpfW1me7lAI9P9Y3liVCzWMvQ_gxcmS-Tm1Zj_Mk1tTL15lZ79QeFF2PKjZ4esuLGU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHF1MysOQ0UNgpZI3l_lETsxGlkXH9NACIvsc0Jra6Nw&oe=69D0F00A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TUDC1nMuAcQ7kNvwEIu7Rm&_nc_oc=Adr652GHnjGGwzZm3KJsPfCBLLhgY37_JxwLxKOagpbSgByfcSkuK-TczTS3ERWYjMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uPrt0WCIqMI4jKaE9yW5UmsuGs3CefTVjpG2xlxBmsw&oe=6A19BF21"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzGSfz4hTGsQ7kNvwFUzDYn&_nc_oc=AdpnJjbg5Klcus_epNBEEvNkT0XsvMam51GoaXHo8i_SFoAfpg8-N0jfFPIDNY-5vLs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bi5MLh6JUGqM-I778xJ9m4JzUzORIEkmul7pNxZohzg&oe=6A19A819"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIApG1PpkCkQ7kNvwFRO033&_nc_oc=AdpPPSXL-O48tyVorpxR1gRUZjrzEutq18WlXktsaMPqtnuQzY7o8G16TIcFquGVZWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5t2rVRh0Y4u1eEIwcCeIJe0OrLjUOtof4vAbrOSvytbw&oe=6A19A586"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPS2n8glkrUQ7kNvwEqjoOA&_nc_oc=AdqRy9gUWwsa5yaTWGdFip_sUFXBQWmFRWjGYlo4dwi98Biqv_DhMcu7d-UiWvQ1HU8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W88B4xOUH923f40xC8jCodrZW4gIMuFkJlJUUFisVuQ&oe=6A19A876"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXwXqaeACOEQ7kNvwFTg3SI&_nc_oc=Adp4Bx8ybwCXueO4XrbNFYPV9OExPXTBO7mpTNGf9iz7EXPAFX_Wx62QiUng-2Zf10w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43njAtMHpE1iOVPn4vsx3M9SWOTPFhApZG2JhlZlH6Xg&oe=6A19AACA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6tLdzLX5fwQ7kNvwHZSn6E&_nc_oc=AdpekFS6CPvQhkBozwEjA0SbFd6X1y_a8HDJkjYemTYps9G5w-eHZ0Xczy5Wmwv06wg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyD-Ac3jGJ_IUacaULVXseGsAmW9EAdOuwFckcPfC02cA&oe=69C526E1"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpoQRHxOOYwQ7kNvwGmRfc9&_nc_oc=AdqCel7VLIo0xtAL8hpKEFQUXpftHTlX_uJV5m6N9qL1YVkVg0QfovS6cOBcAmCq9Q4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBCHXQzmolufys_ELpwgNWU-eH6DxHloKxrmQ_B7JNXw&oe=69C54819"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzmO9KjY9h0Q7kNvwFK4ALf&_nc_oc=Ado7iWXmvFrrBSyMWOKFdtOe46tKxirJbqUdCdntlGlcGH3st8gM8gKr7ePmQBWJ-Es&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQSmbcWE-b_mmXflXh3gUBD_YFk7kwaIFUt3I6u0_TAg&oe=69C54586"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SEmuyCT0DgQ7kNvwEQyvRL&_nc_oc=AdowZ7iPkmP4UrZfEPY-9VCng9qd6aelrVnjGwS6emKrVMN6o5Cc1AJUir5PTOHtis0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzacEY5fu1QtyiebiuwfrMppwiPleAzZs8n2sPtl_m4g&oe=69C54876"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qArMHsOJgwQ7kNvwEnLGbz&_nc_oc=Adp6wzd0lCkVOeMrqGDVWwoRN-sTV8XPpvJoT7r33Rn6-V2osHM83YLikZrXNmq_QOk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyW_xBC_Al9CTNIsuj8Y5yXBwnOuXVcqhBZyBO2H3ENQQ&oe=69C5128A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eQgc_CcqDsQ7kNvwGM_Ylv&_nc_oc=AdpUd1zlapCiW2tZIEAjfUo5oNr-ZrFnBsPRdmz_0DwdZFJd1SWPkAK3b1-AKNeLOuM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWdgIOawAy5DkwHjXSH2YYPe48DvS6BlSkEcaLuLlTrg&oe=6A562BE1"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44HYo05RigkQ7kNvwFSYA7V&_nc_oc=AdqR5gfZgr7nVGAphEY1s-koxFnXMMWwuSyDSu9UPnD5toWDDlKXQ6LrqNNFrFWHHOk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCindWvLlBnGrH7d2QpVDkiwE2MlLk_iEUtpqenBc2fRg&oe=6A564D19"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-b_shh9NdukQ7kNvwHg-Wkl&_nc_oc=AdqKiIy_Mg13AlsHCouI1WjsmfEMC2RZg0SKxPxDkhGgL3oE45Mbfksjhe9QOXr3Wxk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeUADtLbnA_RqKa_eD-t343RZPOUX272V-LgwgwyLeBg&oe=6A564A86"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0X2UmKMh988Q7kNvwHL41ZD&_nc_oc=AdpRmRaEKWYCD_dMrgm11xqAjpTwJ8fIQFgUMUu9MRtkscvmkSyXMyvOb4LD8Hvv19A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAE-_ufJhYiS6wOBELhhv1eCtb5Nm3nncJEywHhPUOq-Q&oe=6A564D76"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XhBgkTA1uwQ7kNvwGRl5m2&_nc_oc=Adqfb97SOfWtPGGwShF4aGIO3539AuiJ8HhLZ-4AJ5tvN4R6GmaQ5VNeij1GMx1VEIk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxkawycPjz7HbBq7iXk2dpdmfmZ1a_OKjm-SWdSRmPLg&oe=6A564FCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
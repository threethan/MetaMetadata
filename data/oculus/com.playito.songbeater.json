088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MNzkQ4ijSUQ7kNvwGVCvy2&_nc_oc=AdoACROLJV6nTH9ra37NNvPZIhzTndVngljRc1AFZb0QLNkCZqiw4fXbuxPSBBpSLM4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DfW0U5G5iZecHJu3Ml5vX0u29POj50FOaM7qtpcD2Bg&oe=69EA10E1"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFDkq7JOHsMQ7kNvwG-3yw6&_nc_oc=AdqR99H_XD-XRoqRpEGR8Oh5hKkiXwFfyCBs6oVG_Bt7mdhkecZevNQKS71N_4nNiUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fda-ZP7zF5LFawViRU4ZELKD9ucwSN8G4LWDf8I8qPw&oe=69EA3219"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJU_HYEAjP4Q7kNvwG4PhqQ&_nc_oc=AdqoqGHRn75xbu6r3mKsDlUZQAo7Q2OsXKRGQQkzI3afCzHxomnSJ9tLqp12eGv2gOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GsI-A3cqbgc9tQxyAabaDKx7x1ZAaex9ZwMKlP08QiA&oe=69EA2F86"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcDL-jzZ3QkQ7kNvwFTBTwk&_nc_oc=AdqiQFHluws2cnHrLP4Q44GceqYoK16N44HCV08nHlAofIsOidIXXtZMsoQGqYHE4LU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bwYa8NmLCX1aNW0Xzf9UlrK7veHV3mfWv58KzbZXLnA&oe=69EA3276"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbDcB-1MIPwQ7kNvwFPNe7H&_nc_oc=AdoYhOkUtd36qIGUjukpgygM4yDQfj_w8vOtCv5PqxVfFICepCZ1PM5xYXcqcpQJox4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3O1foQ70sr37iC9UBzZqEyfOPwrwgBnP00bdhr_vfL3A&oe=69EA34CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
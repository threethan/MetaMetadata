088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8OF6Tr2TpIQ7kNvwHGzBQL&_nc_oc=AdooH3gfkvlrzdaKkYnf0G7KsPE9OG_XG_V0axJZRIA1QwDSpJdyXXMP01EA_WJz3QY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLVoxE70DyCA6PA0kO8EDfapjmi967QDy6o9xVPz_1lw&oe=6AEF5221"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX_Tmeanq4QQ7kNvwEBMTxJ&_nc_oc=AdoHqM9I3EcFLWUvUuMfbS0YknCS1oJhKqvSyjxuTA3mp2wLrIWzpdGAFCM7AQOssYs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEG4Wrak5cerfmXKZMhcYoOszIoVmNT6BTMGdxLAjxTw&oe=6AEF3B19"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBsvVtzHDz4Q7kNvwF9e7Xm&_nc_oc=AdpUsPpGI8H0jPK6wk3uKaWyWvlfvfqGTcDpock84VPnzJ5sBtxFJC5-x90smvtP1YA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbcH46uXSCrtjYp-trZjE2lUh1hLb47CrM4uQMAnuCug&oe=6AEF3886"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whogBW1PrpwQ7kNvwHRP15N&_nc_oc=Adrg41P8GnqvxqLtymBhL6o4eBJ3W_1JRzJ-rKeTlbz26vTZQA7nWHuzgPvDfy4zt6k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjqH1ktYrzQMIieNksKMFgb6WI769YOK2wLW61ItrUiw&oe=6AEF3B76"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AHW73g23fUQ7kNvwGTaCi_&_nc_oc=AdpdfOrGITboDAcboBA7EkBctJCSwnKyawPpjD3KPjx0G6iBVSXeXayWS5NVyH8xZSs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSujt8K5UI374p3KTILR5Oqwfh7g5w0Z0pwUQSUmC6aAQ&oe=6AEF3DCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
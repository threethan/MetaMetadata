088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2balqBqixb8Q7kNvwHVCgrQ&_nc_oc=Adr_Mjscdq62evbEm8OfAC9Vmtv_kCYEq0avRtG-1QvPoyTpQAfQQ5FgLirV4DkQ408&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrSdS9PwX0E0SZ2MfNv-AYLlWAypReZ_7xfhv411yigQ&oe=6AB90C61"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMc6GdqdG3AQ7kNvwHhHiw-&_nc_oc=AdrYBKicLbublWBmblefObK4v33TnoRLXrN20ZTPshr_x1eqsqCp0qHJYyRzgLdAZUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvnP3jfu8ys-hbsx8X0Vn31ndbj5jcVxwFGtDZVySq5Q&oe=6AB92D99"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuLWUMpr05MQ7kNvwHPVJiy&_nc_oc=AdrIWrNmAlnjTF-77aySeQyg-2AbbrZ-D9x9hOzCt18WBPNlTWS169WLT0BV28tb094&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoA8oCNttsOw2MHSVGVRXipQDhzpatipTN11ORz2ap-g&oe=6AB92B06"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RPsNasdVAsQ7kNvwEb5qnm&_nc_oc=Adofuvwiu3CuINNAAs8p0ZbNWTVL7pSb0hJePfvmM88Kp0v5MNvByVciBq9TOWOGakQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk9ub31MG_5TCaxdz_jw5ol5-mXLs4FLtAyZ2Y5t-TRg&oe=6AB92DF6"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0agZe8VrpMQ7kNvwE2fKg2&_nc_oc=Adq_yMujf8Icy7hO5OQX6iUmyuNfjBid-mKMkf1UyiMjyDKnOJUdEnwhhlw8hZr659o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9yjHGhLuuRKcErjjrmtK-TYXxxnZbHBOBejzAfCUirg&oe=6AB9304A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
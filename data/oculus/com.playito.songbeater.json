088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDc4BSixpSQQ7kNvwFGMWZW&_nc_oc=AdrlciHOGcV_-OitjrQIFdLyuKWR1n4xIeyPnlbiBpLea10l68WPanqmqp9HHWOoEgU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NEfDshSPU2GcrUTgK3yBPQJJYc49sECr-dBJfJtIpZA&oe=6A031D61"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvORfAlDcQoQ7kNvwGrQcYA&_nc_oc=Adqj-a3txuaGOn1Y6shHI0XFRz6zyM-crjKHrQ2vkSZCdSO2y5pXguZt7FjqehujTIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5p0lqDpp-tEdeZZ6ELosDOGlEFFQ4xfIthPx2kQ6BuBw&oe=6A033E99"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYai5GIwA0wQ7kNvwEd3mIX&_nc_oc=AdpHbFRqcXZvn5muie1PaATChT0fk3q0nU_5PNy6uIV-vUQ8E8nTEK2wfGBnc1O6GTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JXFFHlW9Zz6Pg8sRFaBICPQh1onpsE-7-O8XBGcW6JQ&oe=6A033C06"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3n5Sx8Z7jEQ7kNvwFtWeXV&_nc_oc=AdqUtK8FgVZFhWtmNwkaclAe95Yj5h6WOhKhGTxndNqMREOBfd3ektqDK0tP1OfSLBk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n6bsMeqHKCyMsjiNs9yR3I_g6uz1yGAvFsnIbtqJuow&oe=6A033EF6"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSEpy27z-o0Q7kNvwGuWHg9&_nc_oc=AdqwZOK1JPbENcXgGGZvu0sBURN_FS_d2XjYTq5FOMzNyfPsOI5jE36tDLu4ofc1vWw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UxZ9kBhzAiShANQE_5EkrvUQyKsb1fEW2uHjf29_WTw&oe=6A03414A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
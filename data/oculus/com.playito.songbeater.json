088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2PyejFXa9YQ7kNvwEZ3hf1&_nc_oc=AdplZR18nhaln2l_Zh5JbQ9zOcrW1URf1UWhDwY-qOMRS2lBWs-cvMCuh7DScHssXX0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2yDeLDLm_nnAo73ArPt2f4UZ6II1mg2ZInUOwKUNMJsw&oe=69F89161"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6Y5el82CGMQ7kNvwF4fUsI&_nc_oc=AdqBwGFnt0ihiyCFjCnHzYjD9-VWGZGJTbV8HrT7zEN062ee6s20J8qvpd7KKfUSDcA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09AWBZbfqVrIEtwNPGJeoGz2r97y5h1P8EMDBV7VH2Dg&oe=69F8B299"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbhETp6pgfAQ7kNvwElloJz&_nc_oc=Adq7_wBkNnq-2SGSgl1NyJsZhSKtf4zrbc095ZaUT03ZzYP_5SIS4QbfLPIb3koF1VQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af111L66hfSioOlwdeE6XCLyCdOwAKF3696OlswEqCQuYw&oe=69F8B006"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=se8t108LXyoQ7kNvwFuwukL&_nc_oc=Adpp_TOZUAPbe4Y6juDUy6gGv9FJ8-MgdfBpWTdNNM_ZJFn1if87-hMpCkKUvtiAbkY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Cq3Cocvtx6ygLVsIhxvERIjtR-KzhSxS6kUj80rhLdg&oe=69F8B2F6"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgA-30KkHbEQ7kNvwFyiBJY&_nc_oc=AdraReLRI1daNBB9wfc1TBoxu5hoS8fcFOs5pMlnhzqM3aKW2tEgEReOzT8LOZe-9u4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0SKGpPkNPbhTyNPOXr6iRDfGF2U2XKMc764UyC0wBP9w&oe=69F8B54A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmyzGb63YPYQ7kNvwH7LkRm&_nc_oc=Adr4fo4JkXjDMfUA3BlwDh2E7MfjXIn7THdD2HCpbDi_I9C7ODTGiOGfDIau-Cw-aKc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9S3RmqJU_A80XjKFQKyJehCZmMatwNA8tPcVL5eo6V5A&oe=6A2E9EE1"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9v2XZV-zrRwQ7kNvwH0Hlfu&_nc_oc=AdqUvgpEaCBLyiv9DmO_eLP3bSdgC_stZpQyxBKcesGQQHrgYAyBfROxBGcDykHc_So&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96EZVudPfDZ4rSDauS6RLwowY3r43UMYE2BlcPIa48jw&oe=6A2EC019"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6N4APMZ88bUQ7kNvwE4D6Qe&_nc_oc=AdrD9XOgsTuGOBoPvBko9fRh93PpzmdR9Ko9BEKHzNNbOER-4t-cLOdTlIK4MSHVHZs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C_T1uoEHVPoCjl15xHAM9osI3I7yLGulN0DV_Lx0sfA&oe=6A2EBD86"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOm6ppwobL8Q7kNvwEQ-Psv&_nc_oc=AdpT4BecZCgUThqmoisUIeY5yGMicguO0oTv235-TRh6acMiRI0n3EkX3PdKGWw4a-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83HCygtCZawcrd4ywu5lNA2gxx0saQhuEV0yXRBOhsgw&oe=6A2EC076"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7x8MWtcA0gQ7kNvwEVgIHQ&_nc_oc=AdrSrEA0jwaCSVAkpKGGNNetA41LrqGOTp-tjUbbkSp9aDjwptCsK1Q2-NIjMH-fLs4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gU-iNivcmnCwaXeYgnnjP4uG_YvcL81BRiOHKrmPYoA&oe=6A2EC2CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
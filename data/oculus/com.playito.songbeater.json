088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZV6aXutRxVIQ7kNvwEyz9JH&_nc_oc=Adp-uFVVR1AOn0VJ9ecsq2Zfs7PUkf3mHk-xmO_bnizV14nFv9J6fJ2rhSWgQyJI06o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVcRCSTAZe6RWSERAx-Y9shEYNk5qr3X1M1rMeXZobPQ&oe=6A635AE1"}, {"file_name": "migrated_image.png", "id": "905043596601029", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974459_509068239840717_3811970529615675392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpfdQFdjGUIQ7kNvwGTqXTe&_nc_oc=Adob8U0-8kdUTLRYz3bbRO9Bg9oe4mW-0E2-3GqCVxNrq4iiXj1nyU_5RZ3cjs5DvGc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsmwdKsHyj_a0lI5vzpESw8V6jR2ztjmhaB_uNPRbxkA&oe=6A637C19"}, {"file_name": "migrated_image.png", "id": "755117658351441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031373_613324749072589_6066029414494240768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmu90GnZ-8QQ7kNvwHDzaLf&_nc_oc=AdpFpBoNuNESTgP7Ud8sAqqxnb4vvC09ppXMfpV_xYc1Zktlg2GlKzazjyOEGNuKb8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsMdlVAusRZXeegwNAoYuytw_uUpY2FKCujuowItIW-g&oe=6A637986"}, {"file_name": "migrated_image.png", "id": "509070679780714", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974914_2346923235523855_670314850102018048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRel9pdSWiMQ7kNvwFmQHtQ&_nc_oc=Adrk5pMawCJMpAYxQAi1R4YWVBo_hK3-ndHz_0tcz8zSFNfQMcQ0VGZL0Dbk1AO7O0M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCLt6XvC06o6XQ1zys61iwZ4m1TDmp_H3dRtCgPGA7UA&oe=6A637C76"}, {"file_name": "migrated_image.png", "id": "904555523328310", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974710_364096864199719_7653470969436045312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SI3znF6tKvoQ7kNvwHY7sN5&_nc_oc=AdrVG0btMinCJWN8vlZBJjnKRdtrHMmPO1rqbqFQUSfFX1kYHOfjalIlfBC7TxsQLxw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzgBH8Tdrk-k4o3KyA6t694pGIf2RMzonUWDrqS-eNuw&oe=6A637ECA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Song Beater: Quite My Tempo!", "keywords": ["fitness", "rhythm", "song", "dance", "tempo"], "long_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support.\n\n- 3 game modes, singleplayer and multiplayer\n- 4 game environments (Deep Space, Dark Island, Ancient Egypt, Early Access theme)\n- 5 difficulty levels (light, gentle, normal, intense and... impossible)\n- 30 achievements\n- Family party mode; Song speed settings (90-150%), no-fail option; Color customizations; Several types of laser obstacles, stationary and moving; Hidden and not so hidden cultural references, memes, easter eggs... :)", "short_description": "Song Beater is a VR rhythm/fitness game on steroids. Beat 45+ included songs and videos (or add your own) with your bare fist in Fit Boxing mode (singleplayer and multiplayer), wield variety of weapons (blades, tonfas, phasers, staff, saw) in Free Style, or concentrate on uplifting text flow in Letter Hunter mode. Global and friends leaderboards, achievements, calories burnt statistics. Custom songs and videos support."}]}, "developer_name": "Playito.com", "developer_privacy_policy_url": "http://songbeater.com/song_beater_privacy4.txt", "developer_terms_of_service_url": "http://songbeater.com/song_beater_eula.txt", "publisher_name": "Playito.com", "support_website_url": null, "website_url": "http://songbeater.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subsc
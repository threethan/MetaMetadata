0598242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ye1MYsonUiMQ7kNvwGfheDu&_nc_oc=AdogAdZBD66Ue9GD5dr1Qv719i1Xvz4Kpb0DKdzL3tZscl85N16viditSG0b6-zcibE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKAYXiqH6k5v4b67DkB8NvyqJt-Py6UdtLbLOgqVVmfw&oe=6A8AF27E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SEALTOPIA", "keywords": [], "long_description": "From the creators of **Seal Game's** comes a brand-new adventure and the spiritual successor you've been waiting for...\n\nSEALTOPIA VR\n\nWelcome to SEALTOPIA, a fast-paced multiplayer VR party game where the goal is simple: have as much fun as possible. Jump into a world filled with energetic seals, exciting activities, and unforgettable moments with friends.\n\nRun, jump, tag, dodge, and explore a variety of unique experiences, or take a break and relax with others in Social Mode. Whether you're competing in chaotic games or simply hanging out, there's always something to do.\n\nWith fun gameplay, lively environments, and endless opportunities to make memories, SEALTOPIA VR is the perfect place to play, laugh, and keep the adventure going.\n\nThe party starts now. Play SEALTOPIA VR today!*", "short_description": "From the creators of Seal Game's comes its spiritual successor...\n\n\ud83e\uddadSEALTOPIA\ud83e\uddad\n\nWelcome to **SEALTOPIA**, a multiplayer VR party game where fun comes first! Run, jump, tag, dodge, and explore a world full of exciting activities and memorable moments with friends.\n\nWhether you're competing in chaotic game modes or relaxing in Social Mode, there's always something new to experience.\n\nJump in, make new friends, and start the party in SEALTOPIA VR today!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/17Nw68umk2Kf6vxilkdH59G2-hQUc2zYHDGdWTbmdsI8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "BurntWaffleGames", "support_website_url": null, "website_url": "https://sites.google.com/view/burntwafflegames/home?authuser=5", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1239992505864431"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1708203583801759"}]}, "baseline_offer": {"id": "1708203583801759"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786132800, "status": "PUBLISHED", "id": "1708203583801759"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1271195559410792", "version": "0.0.27 - Small Update"}, "id": "2264230814117535", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1230534490143566", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1271195559410792"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2264230814117535"}]}, "change_log": null, "created_date": 1786910073, "id": "1271195559410792", "version": "0.0.27 - Small Update", "version_code": 27, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1230534490143566", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1271195559410792"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2264230814117535"}]}, "change_log": "**Small SEALTOPIA Update!**\n\n(v0.0.25 - Small Update)\n\n**Whats New??**\n\n# Parkour Changes\nParkour now has 3 different difficulty's\nEasy, medium, and hard!\n\nRight now there isnt any reward for beating it, BUT we are actively working on that!!\n\nAlso there is a warning when the lava is visable, AND when its over and starting to fall\n\nAlso it falls REALLY fast now so players wont have to wait long before jumping back in!\n\n# Shop Changes!\nWere testing a new demo of the shop where its now now manually updated by the dev's and not just random! this should allow us to make sure players are getting what they want!\n\n# Other Changes\n- Made it easy to get to \"The Rooms\"\n- Fixed Server related bugs (i hope)\n- a few other things i lowk forgot lol\n\n# DONT FORGET TO LEAVE A REVIEW!!! \n\nEnjoy :)", "created_date": 1786901589, "id": "1271023936094621", "version": "0.0.26 - Small Update", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1230534490143566", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1271195559410792"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2264230814117535"}]}, "change_log": null, "created_date": 1786829997, "id": "1269735029556845", "version": "0.0.25 - Bug Fix Again :(", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1230534490143566", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1271195559410792"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2264230814117535"}]}, "change_log": "\ufffdSEALTOPIA UPDATE!\ufffd\n\nV 0.0.24 - Parkour Update!\n\n**Whats New?**\n\n**\ufffdPARKOUR RAISEING LAVA GAMEMODE!\ufffd**\n\nSee how fast you can climb a massive parkour course before the lava gets to you first! Race against the rising lava as you jump, climb, and navigate through challenging obstacles on your way to the top.\n\nThink you can make it before the lava catches up? Every second counts, so move fast, take risks, and try to beat your best time!\n\nTHE PARKOUR CHANGES EVERY UPDATE! (not including Bug Fixes) Every update brings a brand-new layout with different obstacles, routes, and challenges, so you never know what you'll have to conquer next!\n\n**\ufffdItem Shop Changes\ufffd**\n\nThere are some small Cosmetic and rarity changes:\n\nNebula's Bat Wings now flap when you walk\n\nBWG went from 0.1% --> 20% (no longer rare)\n\n**Added \"YOUR DID IT\" 0.01%!!**\n\n**Other:**\n- Tag fixes\n- Fixed a lot of other things i forgot\n\n**Coming soon/working on**\n- Cosmic Bundle\n- Zombies Gamemode\n- SandBox\n- MORE GAME MODES!", "created_date": 1786823229, "id": "1269613809568967", "version": "0.0.24 - Parkour Update!", "version_code": 24, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1230534490143566", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1271195559410792"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1786762283, "id": "1268408379689510", "version": "0.0.23 - Parkour Update!", "version_code": 23, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
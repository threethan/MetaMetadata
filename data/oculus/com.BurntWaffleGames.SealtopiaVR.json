&oe=6A9AD3A9"}, {"file_name": "Untitled design - 2026-08-17T165558.060.png", "id": "1375087880803422", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/593776279_1375087887470088_7836209859595371798_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXTT3ecvPNEQ7kNvwERBOLB&_nc_oc=Adoz4-SEqVH-MH9YXbG4-fhjz0FRH37J_uIKKVJWHtS6mCgLnY_AbymRlc8sdMFMwU8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_y6lFfzriBROrY2vyCc6i2i_ZOQ6XrR7IZtPV-cxHVA&oe=6A9ABF91"}, {"file_name": "Untitled design - 2026-08-17T165608.960.png", "id": "1755633682123299", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/507829689_1755633685456632_5149382131319032029_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op1cejQVDPAQ7kNvwGqfrp9&_nc_oc=AdptuMKZ8tm9JSJmAT6w5jLW-g9wy23GkXIKDQ_dUXt1ViCyZhFaehVtspG7-WpcPHM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdzEfgnHsYGq0nLO9DhzvBJfA3kqlu7oLcxsbeg_wM-A&oe=6A9AD07C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "775633541_28632569223018025_5495737151845814001_n.png", "id": "1582959226855841", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312470_1582959230189174_5148732844483017196_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GtjGzWnKE0Q7kNvwHJvOKj&_nc_oc=Adqt43CwhgjYc9yqEbtyDuioEdJ4YGvzc45W2N2IWcRP5BrvBFiZ36UIDWMWmR4dyKM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyAIEe6wzhQCvSLfgjJkp3mUTACoUKiYmplLL-eAoizg&oe=6A9AC4A3"}, "display_name": "SEALTOPIA", "keywords": [], "long_description": "From the creators of **Seal Game's** comes a brand-new adventure and the spiritual successor you've been waiting for...\n\nSEALTOPIA VR\n\nWelcome to SEALTOPIA, a fast-paced multiplayer VR party game where the goal is simple: have as much fun as possible. Jump into a world filled with energetic seals, exciting activities, and unforgettable moments with friends.\n\nRun, jump, tag, dodge, and explore a variety of unique experiences, or take a break and relax with others in Social Mode. Whether you're competing in chaotic games or simply hanging out, there's always something to do.\n\nWith fun gameplay, lively environments, and endless opportunities to make memories, SEALTOPIA VR is the perfect place to play, laugh, and keep the adventure going.\n\nThe party starts now. Play SEALTOPIA VR today!*", "short_description": "From the creators of Seal Game's comes its spiritual successor...\n\n\ud83e\uddadSEALTOPIA\ud83e\uddad\n\nWelcome to **SEALTOPIA**, a multiplayer VR party game where fun comes first! Run, jump, tag, dodge, and explore a world full of exciting activities and memorable moments with friends.\n\nWhether you're competing in chaotic game modes or relaxing in Social Mode, there's always something new to experience.\n\nJump in, make new friends, and start the party in SEALTOPIA VR today!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/17Nw68umk2Kf6vxilkdH59G2-hQUc2zYHDGdWTbmdsI8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "BurntWaffleGames", "support_website_url": null, "website_url": "https://sites.google.com/view/burntwafflegames/home?authuser=5", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1279212981942383"}, "review_messages": []}]},
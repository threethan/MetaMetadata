 You can no longer \"cheat\" parkour\n- Removed PUNK bundle\n- Server Fixes\n- a few things i forgot\n\n**Coming Soon/Working on**\n||- SandBox\n- Horror\n- Zombies\n- Cosmic Bundle||", "created_date": 1787361065, "id": "1282813244915690", "version": "0.0.29 - New tag map + better customization", "version_code": 29, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1230534490143566", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1295901630273518"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1787353898, "id": "1282698901593791", "version": "0.0.28 - New tag map + better customization", "version_code": 28, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1230534490143566", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1295901630273518"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2264230814117535"}]}, "change_log": null, "created_date": 1786910073, "id": "1271195559410792", "version": "0.0.27 - Small Update", "version_code": 27, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
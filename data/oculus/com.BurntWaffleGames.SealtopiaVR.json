t=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9z0d_1Qkl4Q7kNvwHiRf5t&_nc_oc=AdrMpEKbQTNLaF9zqTiKoR35gQGvaS_t4mPy21p31Ta4Y1RIBFsPUJjk--Rmh5b2pgQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGocencs6PleTmq0KvjjEc6QgFOcVlSuPLjo14aoaRR2w&oe=6A8AC17D"}, {"file_name": "Untitled design (100).png", "id": "1047882541052336", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499313074_1047882544385669_9130419960488270023_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcDis7U6hDwQ7kNvwGPQzMO&_nc_oc=AdpGdgkW2Fj5zTgRkBN18zdhioBWFeUB6ZCyBK-iZhJCQfpoPMPBXl1NN_Uek-RrlIc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3Mgz-I834wa6HidSRqf-teW6A_Vmvtb6q5M5xSRFq8Q&oe=6A8AE7BF"}, {"file_name": "Untitled design (93).png", "id": "784458414729379", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499310734_784458418062712_1967178000690598242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ye1MYsonUiMQ7kNvwGfheDu&_nc_oc=AdogAdZBD66Ue9GD5dr1Qv719i1Xvz4Kpb0DKdzL3tZscl85N16viditSG0b6-zcibE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKAYXiqH6k5v4b67DkB8NvyqJt-Py6UdtLbLOgqVVmfw&oe=6A8AF27E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SEALTOPIA", "keywords": [], "long_description": "From the creators of **Seal Game's** comes a brand-new adventure and the spiritual successor you've been waiting for...\n\nSEALTOPIA VR\n\nWelcome to SEALTOPIA, a fast-paced multiplayer VR party game where the goal is simple: have as much fun as possible. Jump into a world filled with energetic seals, exciting activities, and unforgettable moments with friends.\n\nRun, jump, tag, dodge, and explore a variety of unique experiences, or take a break and relax with others in Social Mode. Whether you're competing in chaotic games or simply hanging out, there's always something to do.\n\nWith fun gameplay, lively environments, and endless opportunities to make memories, SEALTOPIA VR is the perfect place to play, laugh, and keep the adventure going.\n\nThe party starts now. Play SEALTOPIA VR today!*", "short_description": "From the creators of Seal Game's comes its spiritual successor...\n\n\ud83e\uddadSEALTOPIA\ud83e\uddad\n\nWelcome to **SEALTOPIA**, a multiplayer VR party game where fun comes first! Run, jump, tag, dodge, and explore a world full of exciting activities and memorable moments with friends.\n\nWhether you're competing in chaotic game modes or relaxing in Social Mode, there's always something new to experience.\n\nJump in, make new friends, and start the party in SEALTOPIA VR today!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/17Nw68umk2Kf6vxilkdH59G2-hQUc2zYHDGdWTbmdsI8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "BurntWaffleGames", "support_website_url": null, "website_url": "https://sites.google.com/view/burntwafflegames/home?authuser=5", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1239992505864431"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499310651_1594770895315649_5707520855241818936_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZ8P8t-ruq4Q7kNvwGXu0pB&_nc_oc=AdrT3WJgSLshAk83WX2sosqp-aHRglnF5
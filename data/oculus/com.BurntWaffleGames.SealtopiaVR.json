: []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1230534490143566", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1269735029556845"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2264230814117535"}]}, "change_log": "\ufffdSEALTOPIA UPDATE!\ufffd\n\nV 0.0.24 - Parkour Update!\n\n**Whats New?**\n\n**\ufffdPARKOUR RAISEING LAVA GAMEMODE!\ufffd**\n\nSee how fast you can climb a massive parkour course before the lava gets to you first! Race against the rising lava as you jump, climb, and navigate through challenging obstacles on your way to the top.\n\nThink you can make it before the lava catches up? Every second counts, so move fast, take risks, and try to beat your best time!\n\nTHE PARKOUR CHANGES EVERY UPDATE! (not including Bug Fixes) Every update brings a brand-new layout with different obstacles, routes, and challenges, so you never know what you'll have to conquer next!\n\n**\ufffdItem Shop Changes\ufffd**\n\nThere are some small Cosmetic and rarity changes:\n\nNebula's Bat Wings now flap when you walk\n\nBWG went from 0.1% --> 20% (no longer rare)\n\n**Added \"YOUR DID IT\" 0.01%!!**\n\n**Other:**\n- Tag fixes\n- Fixed a lot of other things i forgot\n\n**Coming soon/working on**\n- Cosmic Bundle\n- Zombies Gamemode\n- SandBox\n- MORE GAME MODES!", "created_date": 1786823229, "id": "1269613809568967", "version": "0.0.24 - Parkour Update!", "version_code": 24, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {
=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YxJfzdRh0EQ7kNvwGe1JeE&_nc_oc=Admci86gwaR4Mx0PlUejLQu8dzNrA46SbLQQg_59fpXA-hkr632tuq9XaaLV3iwiN8A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft30cUOpmeWKzcHRLqGd6NtA8HCdB1JNK2UWCKAlpsmoA&oe=699F058C"}, {"file_name": "MainScene_Custom..._02.11.2025_23-35-51.png", "id": "1343460954021736", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827585_1343460957355069_1015264583345406416_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sonDpr57RKsQ7kNvwFE-Qo7&_nc_oc=AdmNQf_ztlyg7_5CLJ33dzACmQnViPxvW-jsMf8J1yzuHc2GRS2ur9hs74a1hTLNWFM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuKdFwU83nh-vD7ULOIlvNM-s5lpmqsJOUKRoxfcXL-9Q&oe=699EF282"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shadow Chimp", "keywords": ["horror", "fangame", "facility"], "long_description": "Shadow Chimp is a VR horror game set in an abandoned research facility, full of mystery and tension. Players step into a chilling world where remnants of long-forgotten experiments hint at a catastrophic event. Once a hub of groundbreaking research, the facility now stands deserted, decayed, and eerie.\n\nAs players move through dim corridors and abandoned labs, they\u2019ll uncover pieces of lore that reveal the facility\u2019s dark past. Every shadow hides a secret, every sound could signal danger, and every step draws them deeper into the unknown.\n\nWith immersive VR mechanics, atmospheric sound design, and a gripping story, Shadow Chimp delivers a tense, spine-chilling experience that keeps players on edge.", "short_description": "Shadow Chimp is a VR horror game set in an abandoned facility. It\u2019s dark and immersive, with hints of a catastrophic event that left the place deserted and eerie."}]}, "developer_name": "YourFellowDummy", "developer_privacy_policy_url": "https://sites.google.com/view/shadowape-studios/page", "developer_terms_of_service_url": "https://sites.google.com/view/shadowape-studios/page", "pub
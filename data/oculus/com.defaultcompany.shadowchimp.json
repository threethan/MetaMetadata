uGPt5QOeQM7p7EH8TJg&oe=6A1C50CE"}, {"file_name": "MainScene_Custom..._02.08.2025_23-12-13.png", "id": "1936115493978674", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618974_1936115497312007_3729971938051771146_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rk6ajQph6UoQ7kNvwHmGZll&_nc_oc=AdrS6xCD5NSZQi2shvSDkHieyGfsvMnXKcRLtH9R0loLvj0QSznWAQ__DO9n5SUsdCY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TD-1Ln7ih353TazgpWq91GR9bu1lpZVT0Sh8o1v7J4A&oe=6A1C440C"}, {"file_name": "MainScene_Custom..._02.11.2025_23-35-51.png", "id": "1343460954021736", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827585_1343460957355069_1015264583345406416_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xovxR0h2n8Q7kNvwEj5ie7&_nc_oc=AdpBMHCr8NvkI4Iq8fM8OaDlR6pjnr9_Sbmu5lIeGxU7sANypER9KTCxiwFOF_2JTWQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7woA_GZ0cIcqkTrU_9rPqAhFM8nWEXgeevMwzjLc94eA&oe=6A1C3102"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shadow Chimp", "keywords": ["horror", "fangame", "facility"], "long_description": "Shadow Chimp is a VR horror game set in an abandoned research facility, full of mystery and tension. Players step into a chilling world where remnants of long-forgotten experiments hint at a catastrophic event. Once a hub of groundbreaking research, the facility now stands deserted, decayed, and eerie.\n\nAs players move through dim corridors and abandoned labs, they\u2019ll uncover pieces of lore that reveal the facility\u2019s dark past. Every shadow hides a secret, every sound could signal danger, and every step draws them deeper into the unknown.\n\nWith immersive VR mechanics, atmospheric sound design, and a gripping story, Shadow Chimp delivers a tense, spine-chilling experience that keeps players on edge.", "short_description": "Shadow Chimp is a VR horror game set in an abandoned facility. It\u2019s dark and immersive, with hints of a catastrophic event that left the place deserted and eerie."}]}, "developer_name": "YourFellowDummy", "developer_privacy_policy_url": "https://sites.google.com/view/shadowape-studios/page", "developer_terms_of_service_url": "https://sites.google.com/view/shadowape-studios/page", "publisher_name": "ShadowApe Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/shadowape-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24909619278648020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823878_1112599377673595_787640791254521224_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSqGZm5jGiUQ7kNvwHUWkL8&_nc_oc=AdqvYS0e6rbOqDabAWkTI6Ua4amZ9kxU6lmfACzC2qD048d44XUpGr6pfINrg65dFMk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6h7tP8pJw9MQLJ8wgoOojs2XC9nLznR_tMAof2kTVNyQ&oe=6A1C28A9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shadow Chimp", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1759464000, "lastRevision": {"nodes": [{"id": "9050535721649630", "release_type": "SCHEDULED", "a
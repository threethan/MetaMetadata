=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhQIZ1_ZhxYQ7kNvwF4XPcb&_nc_oc=AdngxgtK7hmwHnkoGCW8nZRa-NbTDF4RzrYALw8Ik-EvITlHwbsUlHTC58Mh95nzf_0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuFpnnJ479vigbwXFJoX9zYjuE1H9lG_bpEMF8yJxnVeA&oe=69A44B8C"}, {"file_name": "MainScene_Custom..._02.11.2025_23-35-51.png", "id": "1343460954021736", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827585_1343460957355069_1015264583345406416_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdcHyHPXMnQQ7kNvwHsSmBx&_nc_oc=AdkOF3hFJgnG3gAwhJCAyZ_gnTy5ch0ZYwsmAidkoCcAkkzuDwdwGCG-sTRAduX-dCg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs7rAFBqLty54s2iHDXBXrDLsYj4ZdmmkA7bhyTgZOIkw&oe=69A43882"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shadow Chimp", "keywords": ["horror", "fangame", "facility"], "long_description": "Shadow Chimp is a VR horror game set in an abandoned research facility, full of mystery and tension. Players step into a chilling world where remnants of long-forgotten experiments hint at a catastrophic event. Once a hub of groundbreaking research, the facility now stands deserted, decayed, and eerie.\n\nAs players move through dim corridors and abandoned labs, they\u2019ll uncover pieces of lore that reveal the facility\u2019s dark past. Every shadow hides a secret, every sound could signal danger, and every step draws them deeper into the unknown.\n\nWith immersive VR mechanics, atmospheric sound design, and a gripping story, Shadow Chimp delivers a tense, spine-chilling experience that keeps players on edge.", "short_description": "Shadow Chimp is a VR horror game set in an abandoned facility. It\u2019s dark and immersive, with hints of a catastrophic event that left the place deserted and eerie."}]}, "developer_name": "YourFellowDummy", "developer_privacy_policy_url": "https://sites.google.com/view/shadowape-studios/page", "developer_terms_of_service_url": "https://sites.google.com/view/shadowape-studios/page", "pub
=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjyVc7hgGwwQ7kNvwFdqzrR&_nc_oc=AdlrGddDvuUmsG5H0pbSeuIGKCo9YGMZyBZ7eM8DK77SXnyfA2niCcTLFVKyPWtDIOk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs0FN59U9TCfy4P6oZFuddtWeyLplCZOV49Rb6WW9anxg&oe=69A59D0C"}, {"file_name": "MainScene_Custom..._02.11.2025_23-35-51.png", "id": "1343460954021736", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827585_1343460957355069_1015264583345406416_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdcHyHPXMnQQ7kNvwEgLh4d&_nc_oc=AdnbbUfULpCuvCYr8AlL_yyLF9ezf7aW2TmlLg81c4xaCFxQUJUqrSaQ9CYhY4wO6iQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfudrlTWjYj4f3mKHEm27sae4wtr8ObAgt3_yhY13Gc46w&oe=69A58A02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shadow Chimp", "keywords": ["horror", "fangame", "facility"], "long_description": "Shadow Chimp is a VR horror game set in an abandoned research facility, full of mystery and tension. Players step into a chilling world where remnants of long-forgotten experiments hint at a catastrophic event. Once a hub of groundbreaking research, the facility now stands deserted, decayed, and eerie.\n\nAs players move through dim corridors and abandoned labs, they\u2019ll uncover pieces of lore that reveal the facility\u2019s dark past. Every shadow hides a secret, every sound could signal danger, and every step draws them deeper into the unknown.\n\nWith immersive VR mechanics, atmospheric sound design, and a gripping story, Shadow Chimp delivers a tense, spine-chilling experience that keeps players on edge.", "short_description": "Shadow Chimp is a VR horror game set in an abandoned facility. It\u2019s dark and immersive, with hints of a catastrophic event that left the place deserted and eerie."}]}, "developer_name": "YourFellowDummy", "developer_privacy_policy_url": "https://sites.google.com/view/shadowape-studios/page", "developer_terms_of_service_url": "https://sites.google.com/view/shadowape-studios/page", "pub
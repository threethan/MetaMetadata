display_name": "Inspirit VR", "keywords": [], "long_description": "Inspirit is a web and VR based learning platform that engages learners of Science through learn by doing. With Inspirit, teachers can easily access high quality content on the web and with one click access it in VR for their classroom.\n\nExplore physics, chemistry and biology content like never before with our VR Spirits.\n\nVR resources include flashcards, annotated and breakable 3D models, simulations, quiz questions and more!\n\nTry out Inspirit today on AppLab!", "short_description": "Explore Science in VR with Inspirit. Engage with simulations, breakable 3D models, quiz questions and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.inspiritvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.inspiritvr.com/terms-of-service", "publisher_name": "Inspirit", "support_website_url": null, "website_url": "https://inspiritvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "158774580411056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974773_1216172982375604_5529841230097584565_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9SAHd-Z0qIQ7kNvwHWPe6c&_nc_oc=AdoQXp8UiNwy6Sj9aETsQni_9fApEtlvAdUvNGMWL_FWLgZEJ8w6WXkvrov4itpENhY&_nc_zt=3&_nc_ht=scontent
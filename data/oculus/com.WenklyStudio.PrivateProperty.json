0_AQQTsAh_7rKqsaLP8MGmBFH06IMwxzI6-M2fFHsffU1TRg&oe=6B005413"}, "display_name": "Private Property", "keywords": [], "long_description": "Private Property - the brand new VR zombie shooter set at the end of the XIX century Montana provides endless hours of great fun! This coop multiplayer allows players to team up to jointly defend Private Property from hordes of Zombies. Sounds scary? Nothing like this! The general atmosphere is witty and playful.\nThe Private Property brings an exciting and immersive experience for all brave zombie shooters!\n\nDevelopment Note:\nThe game consists of 4 co-op maps and 4 weapon types.", "short_description": "Grab your gun and try to defend the town from the hordes of zombies.\nBecome a deadly gunslinger and test your skill.\nWatch out for special zombies who can treat you with a pipe or exploding dynamite!\nPlay alone or with other players in online mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacypolicy", "developer_terms_of_service_url": "https://www.wenklystudio.com/pp-tos", "publisher_name": "Wenkly Studio Sp. z o.o.", "support_website_url": null, "website_url": "https://www.wenklystudio.com/private-property", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "345643904158212"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHE
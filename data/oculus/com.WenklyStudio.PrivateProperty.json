FtplS9&_nc_oc=AdnVqr2QAfKZC6AXzMNbZULJ1rxewLrN8GQ-yjD4dTHTWmy0sMlewWBTJ4S52ecHF8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftO-01YGX-bqo5Fwh3kCfYxe0jraEFGxr-85FO-Sl7ugw&oe=699B0D38"}, {"file_name": "FarmMobileSC1.png", "id": "817214762877135", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75282159_817214766210468_7675399571858004286_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rm7w3i8gfqoQ7kNvwFhQgcZ&_nc_oc=Adk9bn0KJzxpIcGMb0NVF38Ck1WCwHhGWpp40UPdAq2ls5y9goST7KWAbOZu8FYZi9o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfttI9N7t7V8JhgkUMGRkvxCD0XXTVq02Wh-4k0Y_K0FrA&oe=699B0B93"}, {"file_name": "GoldMineMobile.png", "id": "847126386330303", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221331_847126389663636_6932442814155814266_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roB7vBxNIT8Q7kNvwHoX-R9&_nc_oc=AdnvijCl4ulRVSG8FxmiUZiqAkltFRT4yFDT927Ar_knV7Z5h9vYz0QTd62_evSZViY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftMdslLszHrjisU4D8z8FiW_QPiLdWxtkhxbTuIGxx6sw&oe=699AE397"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pp.png", "id": "522376852617559", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974526_522376855950892_7620708430461863482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LU4qmbH0HS0Q7kNvwFOcgij&_nc_oc=AdkPsx6TRZV3IV1vyvNzOGXqzcgdv8J-hnmad4unYnfjOr99EbFjx3LPUJj6IsnufB0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsT-aClOVCTVZHaR66l8IMaEXg10xGL0PN8PcG4cdX1jw&oe=699B0D93"}, "display_name": "Private Property", "keywords": [], "long_description": "Private Property - the brand new VR zombie shooter set at the end of the XIX century Montana provides endless hours of great fun! This coop multiplayer allows players to team up to jointly defend Private Property from hordes of Zombies. Sounds scary? Nothing like this! The general atmosphere is witty and playful.\nThe Private Property brings an exciting and immersive experience for all brave zombie shooters!\n\nDevelopment Note:\nThe game consists of 4 co-op maps and 4 weapon types.", "short_description": "Grab your gun and try to defend the town from the hordes of zombies.\nBecome a deadly gunslinger and test your skill.\nWatch out for special zombies who can treat you with a pipe or exploding dynamite!\nPlay alone or with other players in online mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacypolicy", "developer_terms_of_service_url": "https://www.wenklystudio.com/pp-tos", "publisher_name": "Wenkly Studio Sp. z o.o.", "support_website_url": null, "website_url": "https://www.wenklystudio.com/private-property", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "345643904158212"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1166033945406503"}, {"status": "PUBLISHED", "id": "796869210006998"}, {"status": "PUBLISHED", "id": "3118955614934855"}, {"status": "PUBLISHED", "id": "1457134652366814"}, {"status": "PUBLISHED", "id": "1189052719274514"}, {"status": "PUBLISHED", "id": "442145565621380"}, {"status": "PUBLISHED", "id": "1300944481187225"}, {"status": "PUBLISHED", "id": "419347717900715"}, {"status": "PUBLISHED", "id": "1423118921693228"}, {"status": "PUBLISHED", "id": "2223437521192035"}]}, "baseline_offer": {"id": "2223437521192035"}, "is_approve
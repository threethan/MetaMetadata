496683402", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75411996_673505500016735_2170965674423752804_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdfQPI7GSg8Q7kNvwEqRP6i&_nc_oc=AdpHghnvi3fVYpKmPkJnfos1uFqO7N33DBHI_pBsCTQhRHa_PVcZTdyRC6ytIvUHkYc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TGrG5u-hJvYBNBOrzYlKp6O3b1Cq809R1iwLTAn6kgQ&oe=69DE446B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr battle of battleship logo 2560 x 1440 210408 0.png", "id": "187457906371403", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75324644_187457909704736_8884903440668078259_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teYzAXF3pUUQ7kNvwH5ItZc&_nc_oc=AdqpQSGYSFj1G-AhttyarbUnVBud50ZZdzamtnRHA_i41rTiCHE3swJHfvrVgBoScVg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kM5MYLqehR0nlM5tPaw9TL4q3NWas2XWHRBkycbzurQ&oe=69DE2831"}, "display_name": "VR Battle of Battleship", "keywords": [], "long_description": "1. Basic Operation:\n- You can start the battle by firing the main guns of the battleship.\n- The following modern weapons are added to increase the tension of the game:\n    - Your battleship has CIWS Beam for defense\n    - Enemy battleship has Anti-ship missiles\n\n2. The Physical Law Modification:\nTo realize the short-time and amazing spectacle battle of huge battleships, some of the physical laws in this Real-Time Simulation World are carefully modified.\n\n3. Conclusion:\nWe believe that the amazing spectacle battle of the huge battleship in VR world is established by the\nunique modification of the physical laws in this application.\nPlease enjoy this VR real-time simulation of battle of battleship.\n\nNull City Realtime Simulation, Development Team", "short_description": "\u201cVR Battle of Battleship\u201d is a Real-Time Simulation Game of the one-on-one fight of the Ultimate Huge Battleships; IOWA-class and Yamato-class in VR world.\nFrom the beginning of this application, you can choose IOWA or YAMATO and start the battle.\nLet fire the main guns of your huge battleships!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nullcityrts.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "NullCityRTS", "support_website_url": "https://www.nullcityrts.com/contact", "website_url": "https://www.nullcityrts.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "STRATEGY", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1346039089176450"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75236138_803254377254629_6533403719674723395_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsmP4kBiQh4Q7kNvwHATkkM&_nc_oc=AdozHfr8QIWYvv24wGmywjFb19GyErDRjN8dCU6bFr8ugQn86SGKU1KxQjZ7iRuQnNA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xtULzqYJ9YUdJIOOoN1nfoufS5j9no3Lk3aLMF0IyBw&oe=69DE3434"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Battle of Battleship", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1623089627, "l
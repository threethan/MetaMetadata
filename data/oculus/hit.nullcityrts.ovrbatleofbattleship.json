496683402", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75411996_673505500016735_2170965674423752804_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nLHuaZLC8cQ7kNvwHq_BQ3&_nc_oc=AdoVrt-fDXiNrMVpTto_mfTV0OlhynNAinigaCRwIFfQo1lowsmvC3ZOIqUOziyhMHw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6N1ak2B6QAEiAJNT5BKWXVP0TclWIK2FgFscmveHX_LQ&oe=6A0722EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr battle of battleship logo 2560 x 1440 210408 0.png", "id": "187457906371403", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75324644_187457909704736_8884903440668078259_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yloRFGWd6bcQ7kNvwEs802t&_nc_oc=AdqyozWl5slPAugZp37aCQo9hbRlGAH_BfAmOI65_JW3yY0Ag5L1TqFb0ztYYQfqAeE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aQL7L5-iTLHfcXthMJc-j7tz_f32MhU5AS50T_dxArQ&oe=6A073EF1"}, "display_name": "VR Battle of Battleship", "keywords": [], "long_description": "1. Basic Operation:\n- You can start the battle by firing the main guns of the battleship.\n- The following modern weapons are added to increase the tension of the game:\n    - Your battleship has CIWS Beam for defense\n    - Enemy battleship has Anti-ship missiles\n\n2. The Physical Law Modification:\nTo realize the short-time and amazing spectacle battle of huge battleships, some of the physical laws in this Real-Time Simulation World are carefully modified.\n\n3. Conclusion:\nWe believe that the amazing spectacle battle of the huge battleship in VR world is established by the\nunique modification of the physical laws in this application.\nPlease enjoy this VR real-time simulation of battle of battleship.\n\nNull City Realtime Simulation, Development Team", "short_description": "\u201cVR Battle of Battleship\u201d is a Real-Time Simulation Game of the one-on-one fight of the Ultimate Huge Battleships; IOWA-class and Yamato-class in VR world.\nFrom the beginning of this application, you can choose IOWA or YAMATO and start the battle.\nLet fire the main guns of your huge battleships!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nullcityrts.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "NullCityRTS", "support_website_url": "https://www.nullcityrts.com/contact", "website_url": "https://www.nullcityrts.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "STRATEGY", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1346039089176450"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75236138_803254377254629_6533403719674723395_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsBEhqneqRQQ7kNvwH2d0h1&_nc_oc=AdoE5LFp0cZ3UuW20OEQm1GjlYZcpNnHYLwTbKJ96l_OgrnN6wHnlYUccL_5spTBNNg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hsOAgw8JXJyQPcagLWUgLEBDuEDPRDMnbHoPjXboY5g&oe=6A0712B4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Battle of Battleship", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1623089627, "l
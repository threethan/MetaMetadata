id": "673505496683402", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75411996_673505500016735_2170965674423752804_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfdmakEI33IQ7kNvwH95PD_&_nc_oc=AdrHMVFcxDGHSG3S0ONKsmhXwcwGUN8e-oaFzyRTQrrp1peTcb24VAVlDhtuZs5ufLU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQbVz9zlcvfTVMwW80GP_Xv_-1Jtx8FWtOyCUz6DhoCg&oe=6A8D9BEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr battle of battleship logo 2560 x 1440 210408 0.png", "id": "187457906371403", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75324644_187457909704736_8884903440668078259_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UM7_EGA_FFcQ7kNvwH5FUzz&_nc_oc=AdpBk6yLLnAaQdgzR2JdPSoNgvGLqK5LTANgGjWTMj9cwcYaocrpWxGTncLBdvDzFlg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg14VGffCPFyC_241PuZIWfsJFK2gHY48QSqM4qPlhng&oe=6A8D7FB1"}, "display_name": "VR Battle of Battleship", "keywords": [], "long_description": "1. Basic Operation:\n- You can start the battle by firing the main guns of the battleship.\n- The following modern weapons are added to increase the tension of the game:\n    - Your battleship has CIWS Beam for defense\n    - Enemy battleship has Anti-ship missiles\n\n2. The Physical Law Modification:\nTo realize the short-time and amazing spectacle battle of huge battleships, some of the physical laws in this Real-Time Simulation World are carefully modified.\n\n3. Conclusion:\nWe believe that the amazing spectacle battle of the huge battleship in VR world is established by the\nunique modification of the physical laws in this application.\nPlease enjoy this VR real-time simulation of battle of battleship.\n\nNull City Realtime Simulation, Development Team", "short_description": "\u201cVR Battle of Battleship\u201d is a Real-Time Simulation Game of the one-on-one fight of the Ultimate Huge Battleships; IOWA-class and Yamato-class in VR world.\nFrom the beginning of this application, you can choose IOWA or YAMATO and start the battle.\nLet fire the main guns of your huge battleships!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nullcityrts.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "NullCityRTS", "support_website_url": "https://www.nullcityrts.com/contact", "website_url": "https://www.nullcityrts.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "STRATEGY", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1346039089176450"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75236138_803254377254629_6533403719674723395_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jB6UBmIkelYQ7kNvwH6KP-x&_nc_oc=AdoXVzQPhkO1gqXpxpfj-KIZJSjvYZesII9q4FjOCuGmfdpB0Dssjqni5tFdbZ30o2s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdNBFVAV952U1aLt_tzVNJAaHECEWmeJtohwwxgJD6ow&oe=6A8D8BB4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Battle of Battleship", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date"
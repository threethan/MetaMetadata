\u201cVR Battle of Battleship\u201d is a Real-Time Simulation Game of the one-on-one fight of the Ultimate Huge Battleships; IOWA-class and Yamato-class in VR world.\nFrom the beginning of this application, you can choose IOWA or YAMATO and start the battle.\nLet fire the main guns of your huge battleships!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nullcityrts.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "NullCityRTS", "support_website_url": "https://www.nullcityrts.com/contact", "website_url": "https://www.nullcityrts.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "STRATEGY", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1346039089176450"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4142787819162406", "version": "1.2"}, "id": "995574440846776", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3975563042551552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4142787819162406"}, "release
A8599DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Microsoft Word", "keywords": [], "long_description": "The trusted Word app lets you easily create, edit, view, and share your documents with others. With Word, your office moves with you. Whether you\u2019re a blogger, writer, journalist, columnist, student, or a project manager, Word is as handy as you want it to be. \n\nMake impactful text documents, scripts, blogs, write-ups, or resumes and customize your documents with robust tools that enable you to accomplish your best writing with the best format options and templates.\n", "short_description": "The trusted Word app lets you easily create, edit, view, and share your documents with others. With Word, your office moves with you. Whether you\u2019re a blogger, writer, journalist, columnist, student, or a project manager, Word is as handy as you want it to be. \n\nMake impactful text documents, scripts, blogs, write-ups, or resumes and customize your documents with robust tools that enable you to accomplish your best writing with the best format options and templates.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.microsoft.com/en-us/privacystatement", "developer_terms_of_service_url": "https://www.microsoft.com/en-us/servicesagreement", "publisher_name": "Microsoft", "support_website_url": null, "website_url": "https://www.office.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "TRACKED_KEYBOARD"], "supp
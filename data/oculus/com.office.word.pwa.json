723100521_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bB1n9rYtjOgQ7kNvwG7jwy2&_nc_oc=AdqlYT-x9rzGxnSkah127Vl3PvVVwbCk_2T2m6KkleumbgSHf5FvVr9aSzy7nEyrLFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTfYXLW3kOzdGbDEPJkt10ePMLI6V1GsFpU-mx7YOFsA&oe=6AFDCA9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Microsoft Word", "keywords": [], "long_description": "The trusted Word app lets you easily create, edit, view, and share your documents with others. With Word, your office moves with you. Whether you\u2019re a blogger, writer, journalist, columnist, student, or a project manager, Word is as handy as you want it to be. \n\nMake impactful text documents, scripts, blogs, write-ups, or resumes and customize your documents with robust tools that enable you to accomplish your best writing with the best format options and templates.\n", "short_description": "The trusted Word app lets you easily create, edit, view, and share your documents with others. With Word, your office moves with you. Whether you\u2019re a blogger, writer, journalist, columnist, student, or a project manager, Word is as handy as you want it to be. \n\nMake impactful text documents, scripts, blogs, write-ups, or resumes and customize your documents with robust tools that enable you to accomplish your best writing with the best format options and templates.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.microsoft.com/en-us/privacystatement", "developer_terms_of_service_url": "https://www.microsoft.com/en-us/servicesagreement", "publisher_name": "Microsoft", "support_website_url": null, "website_url": "https://www.office.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres
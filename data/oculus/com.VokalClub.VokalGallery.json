 "keywords": [], "long_description": "Leading African Women Against Historical Backdrops is a groundbreaking VR experience that transports you to a virtual museum where you'll encounter extraordinary African women who have shaped history.\n\nImmerse Yourself in Their Stories:\n\nEach exhibit features a captivating video interview on the \"front wall\" of a VR museum room. These inspiring women will share their stories directly with you, drawing you into their experiences.\n\nExplore the Context:\n\nThe side panels of the virtual room come alive with rich content that complements each woman's narrative. Informative text and captivating visuals provide historical context, giving you a deeper understanding of the times they lived in.", "short_description": "Leading African Women Against Historical Backdrops."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sisanda.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sisanda Tech", "support_website_url": null, "website_url": "https://sisanda.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7685679834796251"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "415858410854416"}]}, "baseline_offer": {"id": "415858410854416"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710352020, "status": "PUBLISHED", "id": "415858410854416"}]}, "liveChann
30395002778_8394765781358070813_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LwiebrLiK0Q7kNvwHAJs-m&_nc_oc=Adot3Mg7Cgq4_RQ7WTAL_BReNYSkttY3YdKZ2PRzfumos5f0m-KafsOj0ogWic2_2U0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdHLZwXMN432UIeo4cv09U03mybuvIAswQKIUKZuv9XA&oe=6A9C2ADF"}, {"file_name": "Image Sequence_017_0000.png", "id": "1439689386757080", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75549081_1439689390090413_4681297363425989965_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaZp50hMiHAQ7kNvwFxXtrn&_nc_oc=AdoYOHTJ2IQ4RoGo9hLkzyg5bVrcOiyrLnDy4m91ZPDXD41JjYIauZJ9msUfF_HJSuc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbwMFjOfl6c_F-5r8V5ilvpNlzzlI0xhco9jwg-mGSqQ&oe=6A9C2BBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_011_0000.png", "id": "755989206514620", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86655523_755989209847953_115828304606020556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgXYpjPLetsQ7kNvwHvszvo&_nc_oc=Adon2eSw0ugYB2n3gG8ue6uHWEHNCfgp1thErLLBULAvGIL_4Zr4EJzF7LzOqGUAREo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKnqXOJ05vaLikLIa2yqK-wJVoJA-FausYWOBHtsBbgA&oe=6A9C33BF"}, "display_name": "Vokal Pop Up Gallery", "keywords": [], "long_description": "Leading African Women Against Historical Backdrops is a groundbreaking VR experience that transports you to a virtual museum where you'll encounter extraordinary African women who have shaped history.\n\nImmerse Yourself in Their Stories:\n\nEach exhibit features a captivating video interview on the \"front wall\" of a VR museum room. These inspiring women will share their stories directly with you, drawing you into their experiences.\n\nExplore the Context:\n\nThe side panels of the virtual room come alive with rich content that complements each woman's narrative. Informative text and captivating visuals provide historical context, giving you a deeper und
nce_011_0000.png", "id": "755989206514620", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86655523_755989209847953_115828304606020556_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jl6ysEF4q60Q7kNvwHVJSBz&_nc_oc=AdpNSfub340goG3JXvk-PuaUiML-esVhq7t6FykOcBh0UaHJdFPcEIbrMPnPjOjvPGE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT_ZxDK0jIUu0WuF2NtEC9pwooCSyKB6i_BGONont7xDw&oe=6B0DCCFF"}, "display_name": "Vokal Pop Up Gallery", "keywords": [], "long_description": "Leading African Women Against Historical Backdrops is a groundbreaking VR experience that transports you to a virtual museum where you'll encounter extraordinary African women who have shaped history.\n\nImmerse Yourself in Their Stories:\n\nEach exhibit features a captivating video interview on the \"front wall\" of a VR museum room. These inspiring women will share their stories directly with you, drawing you into their experiences.\n\nExplore the Context:\n\nThe side panels of the virtual room come alive with rich content that complements each woman's narrative. Informative text and captivating visuals provide historical context, giving you a deeper understanding of the times they lived in.", "short_description": "Leading African Women Against Historical Backdrops."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sisanda.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sisanda Tech", "support_website_url": null, "website_url": "https://sisanda.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
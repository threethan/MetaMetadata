-25/38974716_192461400294913_7175964949626297309_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7gBY1Zy8v8Q7kNvwGN6Owj&_nc_oc=AdqyukxjzfF1UdbJ7ZbruDtareDCWKiKp-Zrt2oTIW13x-035XnG3byeccJv2ahRwLg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH28gD7ZEYkh7FiTpV2XdPld6bVyW72SSVGe8lh4b9zcw&oe=6A8EC580"}, {"file_name": "s3.png", "id": "542335511252762", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75356794_542335514586095_216425384345306578_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FneLPIvCeccQ7kNvwFDR04W&_nc_oc=AdqS17nifXm4kmjQWYjePOdw-GW6woxmqjx6fjTMcX3UV1ArkJHWOrcWr5A6rwEMbgs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfYFVLa6IG3fxo0_QyVdlm2JxyGPzmnpwvU59rFFK59Q&oe=6A8ED9C7"}, {"file_name": "2560_3.png", "id": "888998762168062", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/227874642_888998765501395_1211087875730036094_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PT4RWewMBQ4Q7kNvwGumsfz&_nc_oc=AdplNCHn9Lrxg1o3aDcf68AQpSZqGAclYzvLvLbm_vfMDlouVKjm2HPpAkuBOz6URB0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFooI1C6tkpq0C9mFmxdIdDcWQTL0uTlCChTafSCFlVFg&oe=6A8ED636"}, {"file_name": "10.png", "id": "580513944186748", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75485576_580513947520081_2839488034221343197_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gShy5Drer3cQ7kNvwGRe_Ps&_nc_oc=AdpqrMC0ScE5bXjjDkyQbN0Xg3h9ft8EtMuz6mu6GbdTRIFSQSFKXuSWRvP0dhUOg_c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_L9PHz4LQOTyUx6AYlngA00B2tfbXBl4Jn1zFto25ig&oe=6A8EDFC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u65b0\u7248\u672c\u6d77\u62a5.png", "id": "793511699535511", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035463_793511702868844_626627210755769106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhnfmphjvcQQ7kNvwFCjG7a&_nc_oc=Adp05uH8GF_DU_EF7z666PgSS7bG4RMlDriTsZXBa9b5dKcQb9vjT8U-ctCNKgbm0zs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGG9XhyyIdeDmHQF5fsquQZNo1tjAIzpX2Tp53N6Bl1Yg&oe=6A8ED3C1"}, "display_name": "Hibow", "keywords": ["Archery", "Multiplayer", "Battle", "Shooter", "Bow"], "long_description": "# Choose your hero and team up to dominate the future bow fight battlefield!\n\n**1. Immersive archery battles**\nDelve into the meticulously crafted VR archery simulation experience, refined over three years, ensuring you won't be disappointed!\n{834373434687434}\n\n**2. Unique movement system**\n We've developed a movement system based on archery, allowing quick mastery through muscle memory, making it irresistible once you've grasped it!\n{329733713341715}\n\n**3. Hero showdowns, tactical competition**\nEvery battle showcases your strategic prowess. Select your hero, gather weapons and equipment, utilize skills \u2013 every perfect decision significantly increases your chance of victory!\n{824427463068762}\n\n**4. Multiplayer lobby, social upgrade**\n A simple handshake can turn you into friends with other players. Invite them to battle alongside you!\n{428367670175190}\n\n**5. Rich weaponry, equipment upgrades**\n With 7 bows, 6 arrow types, 4 attachments, and 3 melee weapons, upgrading them during battle significantly boosts your combat prowess.\n{811018667625483}\n\n**6. Diverse systems, continuous updates**\nWith new gameplay modes, heroes, maps, weapons, and seasonal features, we continuously update to keep the experience fresh.\n\n# Need Help? \nContact us through Discord, mail, or simply leave a comment. Whether for support or feedback, we are always happy to answer.\n\n# Follow Us:\n- Discord: https://discord.gg/hibow\n- Twitter:  https://twitter.com/HibowVR\n\n", "short_description": "Choose your hero and team up to dominate the future bow fight battlefield!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://chesstar.com/privacyen/", "developer_terms_of_service_url": null, "publisher_name": "Chesstar
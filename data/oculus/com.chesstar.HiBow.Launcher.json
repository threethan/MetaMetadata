&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtuskwhXSK4Q7kNvwFg7yv0&_nc_oc=AdmtUlVx76eNd2ku-0zWtQpKVhA1USxFs5p8jskcMSad_UMAZEA9tSs0xokhYmnQ_Mk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzE07pp9RHCTOcMMa0n1Wlp59YI_G_GIlQi_oloZZPnSQ&oe=69AC27BC"}, {"file_name": "\u622a\u56fe2560-1440\uff085\uff09.png", "id": "442177106909710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575352_442177110243043_2941659630946074307_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_0FRr-y34QQ7kNvwFZR5gD&_nc_oc=Adm2oFtZRIMLM5zhrNek4Vjj-6BBppj2qA4E6OCafPll2qXdXk4IdbUgzrJGRQhs9mU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz4tln3apj2neoyC9Q3UINW50ljroSTRKP-7M9otLfx4A&oe=69AC324B"}, {"file_name": "\u622a\u56fe2560-1440\uff083\uff09.png", "id": "1139606619828125", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75469630_1139606623161458_2046221803729981381_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAlibUwBbnEQ7kNvwE65sMK&_nc_oc=AdknSjFD3loHNn_3hXUoxpA7AmVqDltNpajQN41G5NOJHiU4JesN9x_tQ8RWXgHqbW4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfybDIrFQb_J-_D3pvRlDrhaO_zpN_QFWjGY6Ao7BGe8Hg&oe=69AC32C4"}, {"file_name": "\u622a\u56fe2560-1440\uff084\uff09.png", "id": "152689023329143", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221313_152689026662476_4017254453095429042_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bG3auWgcajwQ7kNvwEeVbbS&_nc_oc=Adn0pigs4S-1Cps3Fv6IqpVyz4Ty9NOPjYwibXZU3XX0i0KFRaPvkkZM6j-FkZulsMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy7K5iwyy6Xr3vXEdqyHI1Wa1Pz_sRjksC7v-HeyZ8pWA&oe=69AC250C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u4e3b\u6d77\u62a52560-1440.png", "id": "532546341002288", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982622_532546344335621_2409358825928692675_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnz8I2_RvvsQ7kNvwHcDVub&_nc_oc=Adk951xLklztXcFS6rE_R1yRUtEOJleHqPPX2sInNME8CG4FzF6wbRHCT2pKhRcifdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzRUfG2_rKSHrAI-bZEXQzIPxtXdiuobt2yDjwExGmcQQ&oe=69AC1ACD"}, "display_name": "Hibow", "keywords": [], "long_description": "Hibow is a competitive multiplayer VR game with fierce arrow shooting and refreshing flying experience.    \n\nIt provides a smooth archery and flying experience guaranteed by hundreds of updates.\nWith unique muscle memory flying system, you will love it once you\u2019ve tried it.\nCreative features for bows and arrows allowing sniping, scattering, explosion and even blinding! Yes, It\u2019s more than imagination!\nAlong with powerful secondary weapon system, you\u2019ll easily accomplish various unbelievable movements.\nWell-designed Battle Royale mode for VR archery, exicting fighting experience will definitely make everyone keep playing it over and over again.\nPlus full body IK system, dressing up store and various social interactions and social game modes. Hibow will not only give you joy and unforgettable experience, but also friendships.\n\nCome and find more!", "short_description": "A multiplayer Battle Royale archery fighting game with unique flying experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://chesstar.com/?privacy_10%2F", "developer_terms_of_service_url": null, "publisher_name": "Chesstar Studios", "support_website_url": null, "website_url": "https://sidequestvr.com/app/967", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ko", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
1400294913_7175964949626297309_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u44JzKgKJ_cQ7kNvwHLhD4N&_nc_oc=AdpnWrTaXecbM5Dgn0lV3xF-MsmDShdqDj7roCEAwLnqZs1p9u5KZf6R31RskzLGgYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqXysKI2lIsFxvFFVlIOSK56uOo9x-Uf5QaLIJ1NStHw&oe=6A5E3640"}, {"file_name": "s3.png", "id": "542335511252762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75356794_542335514586095_216425384345306578_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll4IpSqJiVQQ7kNvwEKfc6S&_nc_oc=AdoTxxrzzQN5sd45A0KEaVa6NtNFdD8ZPbq5v67r0TXJ2LXE8W29ss_8adU9KRatuaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQus_pBgSZf7oFRnpgCqo_jZ84Ig3c2YlFfHRSdKqXhg&oe=6A5E1247"}, {"file_name": "2560_3.png", "id": "888998762168062", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/227874642_888998765501395_1211087875730036094_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3Jo_uXabCYQ7kNvwEPqyIT&_nc_oc=AdqJyHc3T7CIDm_i6LWqUj6JHRj-jfdm5eANKCCCHqvJStNhRjUHKQHhWdOp965XNt4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkEGFtZM3liZtyA4msknNu2cDY-jdEKHhU-xM0g24Lxg&oe=6A5E0EB6"}, {"file_name": "10.png", "id": "580513944186748", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75485576_580513947520081_2839488034221343197_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqKxC5Ae7UcQ7kNvwGPSjSd&_nc_oc=AdptAK39Q1O-tDYZekaXEh_kou3UKiujMtN9o5sbwMNim_ZIEp7EiS966FSXzhHMuzE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD9PSmopotXZDU3x30KwVqbyA-YrytyuO3FjrHWvnh8w&oe=6A5E1840"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u65b0\u7248\u672c\u6d77\u62a5.png", "id": "793511699535511", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035463_793511702868844_626627210755769106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYIf_bKwnacQ7kNvwFpHdz5&_nc_oc=AdrKhRW8PaIF3uuGUk5eIzyo8ale14qoprF_mq2ddQgPfUbC4xmQg5BtIyFVL2ZDNJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnT8mGYDhduhVT9RAlFrx95o9rPGr0HLZF4Av3M2DPWA&oe=6A5E0C41"}, "display_name": "Hibow", "keywords": ["Archery", "Multiplayer", "Battle", "Shooter", "Bow"], "long_description": "# Choose your hero and team up to dominate the future bow fight battlefield!\n\n**1. Immersive archery battles**\nDelve into the meticulously crafted VR archery simulation experience, refined over three years, ensuring you won't be disappointed!\n{834373434687434}\n\n**2. Unique movement system**\n We've developed a movement system based on archery, allowing quick mastery through muscle memory, making it irresistible once you've grasped it!\n{329733713341715}\n\n**3. Hero showdowns, tactical competition**\nEvery battle showcases your strategic prowess. Select your hero, gather weapons and equipment, utilize skills \u2013 every perfect decision significantly increases your chance of victory!\n{824427463068762}\n\n**4. Multiplayer lobby, social upgrade**\n A simple handshake can turn you into friends with other players. Invite them to battle alongside you!\n{428367670175190}\n\n**5. Rich weaponry, equipment upgrades**\n With 7 bows, 6 arrow types, 4 attachments, and 3 melee weapons, upgrading them during battle significantly boosts your combat prowess.\n{811018667625483}\n\n**6. Diverse systems, continuous updates**\nWith new gameplay modes, heroes, maps, weapons, and seasonal features, we continuously update to keep the experience fresh.\n\n# Need Help? \nContact us through Discord, mail, or simply leave a comment. Whether for support or feedback, we are always happy to answer.\n\n# Follow Us:\n- Discord: https://discord.gg/hibow\n- Twitter:  https://twitter.com/HibowVR\n\n", "short_description": "Choose your hero and team up to dominate the future bow fight battlefield!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://chesstar.com/privacyen/", "developer_terms_of_service_url": null, "publisher_name": "Chesstar Studios", "support_we
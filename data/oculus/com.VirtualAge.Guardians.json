f20f&oh=00_AQBf8PHzb5bYSxdsKj7LRI0JG3jd9S0keHOni2DbChVrjw&oe=6A5F5CF8"}, "display_name": "Guardians", "keywords": [], "long_description": "Guardians is an innovative VR shooter that blends RTS and FPS genres in a Sci-Fi setting.\nThe game is compatible with Oculus Quest as well as PCVR, has a single player campaign and multi player PVP and PVE-Coop modes.\nBoth multiplayer modes are cross play between PC and Quest.\n\nAs a Guardian you are part of an elite unit responsible for protecting the federation while they extract a newly discovered and mysterious new energy source, perovskite, a red and very powerful mineral that only grows in the outer rim of the galaxy.\n\nIn addition to their powerful arsenal, Guardians can also instantly summon and control defensive structures and units to help them fight invading armies.", "short_description": "Guardians is an innovative VR shooter that blends RTS and FPS genres in a Sci-Fi setting.\nThe game is compatible with Oculus Quest as well as PCVR, has a single player campaign and multi player PVP and PVE-Coop modes.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://virtualage.io/privacy-policy-2", "developer_terms_of_service_url": null, "publisher_name": "VirtualAge", "support_website_url": null, "website_url": "http://virtualage.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_
j9pd9xfiOl9Ik7iVdJR68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ9JCgt9iQeZtf2UQxiRvMsGaGDZx4g_LJEgqq-xpuqQ&oe=6A997AF5"}, {"file_name": "143.png", "id": "924149197023855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825497_924149203690521_2556642533839172779_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_vBxX_Th-sQ7kNvwF_SWJA&_nc_oc=Adri_7JrEKcUpAoJKKECx5oM_1kwlaUv1JlNpiTex08YDIn6nWMSlCOZg1D_Arqo82c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKce2Oz6ZoQ70ziUckZ9PL3FYrkmDJS2uKdCsf1mllaQQ&oe=6A99936E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MedRoom Anatomy", "keywords": [], "long_description": "Compreenda e visualize o corpo humano completo!\nAprender anatomia por meio de uma tecnologia imersiva consolida o conhecimento e permite uma compreens\u00e3o mais aprofundada da topografia do corpo humano. \nO MedRoom Anatomy possibilita estudar a anatomia de forma mais f\u00e1cil, intuitiva e din\u00e2mica. \nFeito para professores, alunos e profissionais da \u00e1rea da sa\u00fade, apresenta como principais caracter\u00edsticas:\n- Dois modelos completos, feminino e masculino, com mais de 3500 estruturas em 3D modeladas\n- Ferramentas como: ocultar, isolar, transparecer e destacar para disseca\u00e7\u00e3o das estruturas\n- Filtro f\u00e1cil e din\u00e2mico por sistemas e regi\u00f5es do corpo\n- Anima\u00e7\u00e3o de estruturas, como o ciclo card\u00edaco\n- Personaliza\u00e7\u00e3o da ferramenta, via controle \n\n\n", "short_description": "Estude o corpo humano, com alto detalhamento e pr\u00f3ximo da realidade!\nNossa aplica\u00e7\u00e3o apresenta o corpo humano, tanto masculino quanto feminino, com mais de 3000 estruturas modeladas e validadas cientificamente.  Projetado para ser um laborat\u00f3rio de anatomia em realidade virtual, a ferramenta possibilita a compreens\u00e3o topogr\u00e1fica, a rela\u00e7\u00e3o entre os sistemas, \u00f3rg\u00e3os e regi\u00f5es do corpo. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medroom.com.br/politica", "developer_terms_of_service_url": null, "publisher_name": "Anatomia completa em 3D", "support_website_url": null, "website_url": "https://www.medroom.com.br/anatomy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_AR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26606541182322456"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618432_734832196347379_5113041312721428738_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bXhEDpqY8AQ7kNvwE7N67s&_nc_oc=Adom_xP2Tccz-lgo4phMSl22atpucSMyyticNWdoreNqVhIh1g7OoTXgZu-uv9HKHnI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDufJHd3_VIEU7zOGuDesEhaDjljE5Tvq0mHEoo_qdWA&oe=6A999EB3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MedRoom Anatomy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1772023560, "lastRevision": {"nodes": [{"id": "25302203312756256", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25302203272756260", "is_first_party": false, "enables_in_app_ads": false, "i
3", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298281_1618125379660636_97497230603110810_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puxneEacFeIQ7kNvwH-HEPF&_nc_oc=Adpkf_Vj_S2Yz02A6n2e_N2A-qdFYXPdqMFLA2CW9jpg_Y1YXvrjqhSnpewMTdLYyLQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUBb7Y1Achvsa3aMdyMAnY-HLy5xY7WtxaWZmY4XQwLIA&oe=6B0F0156"}, {"file_name": "VR 8.png", "id": "1671554027276076", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831393_1671554030609409_6402991576025029018_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MC3KdtdO_MQQ7kNvwG5e7-1&_nc_oc=AdqkS7AETbcAup2WIwNjbexLLtqvk8DgUf_jPFnJpyeU7h23QRkfeavF7u3Otum1iHo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWxy6Ux43fj-kG0ogqogQzmYSbAnSCnrTN-HM6qRjDhuA&oe=6B0EFA4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MedRoom Anatomy", "keywords": [], "long_description": "Compreenda e visualize o corpo humano completo!\nAprender anatomia por meio de uma tecnologia imersiva consolida o conhecimento e permite uma compreens\u00e3o mais aprofundada da topografia do corpo humano. \nO MedRoom Anatomy possibilita estudar a anatomia de forma mais f\u00e1cil, intuitiva e din\u00e2mica. \nFeito para professores, alunos e profissionais da \u00e1rea da sa\u00fade, apresenta como principais caracter\u00edsticas:\n- Dois modelos completos, feminino e masculino, com mais de 3500 estruturas em 3D modeladas\n- Ferramentas como: ocultar, isolar, transparecer e destacar para disseca\u00e7\u00e3o das estruturas\n- Filtro f\u00e1cil e din\u00e2mico por sistemas e regi\u00f5es do corpo\n- Anima\u00e7\u00e3o de estruturas, como o ciclo card\u00edaco\n- Personaliza\u00e7\u00e3o da ferramenta, via controle \n\n\n", "short_description": "Estude o corpo humano, com alto detalhamento e pr\u00f3ximo da realidade!\nNossa aplica\u00e7\u00e3o apresenta o corpo humano, tanto masculino quanto feminino, com mais de 3000 estruturas modeladas e validadas cientificamente.  Projetado para ser um laborat\u00f3rio de anatomia em realidade virtual, a ferramenta possibilita a compreens\u00e3o topogr\u00e1fica, a rela\u00e7\u00e3o entre os sistemas, \u00f3rg\u00e3os e regi\u00f5es do corpo. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medroom.com.br/politica", "developer_terms_of_service_url": null, "publisher_name": "Anatomia completa em 3D", "support_website_url": null, "website_url": "https://www.medroom.com.br/anatomy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_AR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28294936860149538"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618432_734832196347379_5113041312721428738_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppzoKaPny8gQ7kNvwHzZbUZ&_nc_oc=AdqMmLt30Os6yyA5LwDOKBsXIY2mGZmnKvNItpz3cPQwnbaWglfD9jGg6rIeBa7aj9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV1ztMOtwVXbo8tK0qg-vbmjgxJVLF0YR7N7ecJ6B4niQ&oe=6B0EF433"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MedRoom Anatomy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id"
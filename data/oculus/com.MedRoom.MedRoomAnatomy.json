nt-iad3-2.oculuscdn.com/v/t64.5771-25/499618432_734832196347379_5113041312721428738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptk56ALaPIgQ7kNvwGec_iy&_nc_oc=Adqs3cSR3zX8E71rU4VvbNzFan990gwOgL9EMdOhzw0IQlF9Yoihf3w83QNf3Qpcpb4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nxl7GTPH25QscM3Y1FBuZgrHCt8qNbBiUWENBc6XW2A&oe=69EE0373"}]}, "id": "4229296463990662", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1423275555625731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820387_1423275558959064_5972487820205192613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzARI4rLsaQQ7kNvwHBBFv9&_nc_oc=AdofVS5E4iDLMUKjh_Vc0ldjG_Y94-XutIUorZv2rudi3kx7CeeYjZBbuOA1U5hXEDQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ewPok6QelfMc6yLKMozw9aHu4Uz5NAYtNWAxocWlhhw&oe=69EE20D8"}, {"file_name": "01.png", "id": "986883913797994", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820441_986883917131327_5827313875020849701_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPnnrbH2IvsQ7kNvwHsmpaB&_nc_oc=AdrynT-i5LTT96vKPE3jOAYh-EDuVPFkxp1-WUsJbxcYb-wzPWoskDzkCrpuvUMKAK4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35R8WITp1YN7eskfq7MxhH0-hAtw35i3znnHjLm1No6w&oe=69EE082D"}, {"file_name": "141.png", "id": "1258134302946828", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818890_1258134309613494_1533658700297372321_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n69rmR2ShTMQ7kNvwERYj-h&_nc_oc=AdoXQESyYDEYaR3Mqvs9LE9SSloKTEh8VX0hL9a5t6G_LykaqmyCuoWD_ZOL_SnYJy8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Vk7IMGpZdy9Bca-5DYTIj_xu2474O5Rb2_AIEXvP7zA&oe=69EDFA05"}, {"file_name": "142.png", "id": "2825188017849372", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825305_2825188021182705_1735487210601444941_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYWZcvrSWqoQ7kNvwHlMQ85&_nc_oc=Adqsj2wKTRho8HhewJ94EJoGg-Awu9CmK78ok72kR-hbodjZFABNOcUF-56AgchcmAg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0E0T_8tFXvyN7ivyGwLcZmyWRn13WxB5z5zSIAvWXoaw&oe=69EE17F5"}, {"file_name": "143.png", "id": "924149197023855", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825497_924149203690521_2556642533839172779_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8kNy9az82oQ7kNvwEn-GnT&_nc_oc=Adpd3Cao2A8wY6FMsCOPfN0U-G6LgNw_LkipsQq6tJP7nkkyY2XBp7qVOdUFSW1gExY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XOzR5srZSOUrEQiq0jFYvxzKmDFStTnoP9vMyN3FCFA&oe=69EDF82E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MedRoom Anatomy", "keywords": [], "long_description": "Compreenda e visualize o corpo humano completo!\nAprender anatomia por meio de uma tecnologia imersiva consolida o conhecimento e permite uma compreens\u00e3o mais aprofundada da topografia do corpo humano. \nO MedRoom Anatomy possibilita estudar a anatomia de forma mais f\u00e1cil, intuitiva e din\u00e2mica. \nFeito para professores, alunos e profissionais da \u00e1rea da sa\u00fade, apresenta como principais caracter\u00edsticas:\n- Dois modelos completos, feminino e masculino, com mais de 3500 estruturas em 3D modeladas\n- Ferramentas como: ocultar, isolar, transparecer e destacar para disseca\u00e7\u00e3o das estruturas\n- Filtro f\u00e1cil e din\u00e2mico por sistemas e regi\u00f5es do corpo\n- Anima\u00e7\u00e3o de estruturas, como o ciclo card\u00edaco\n- Personaliza\u00e7\u00e3o da ferramenta, via controle \n\n\n", "short_description": "Estude o corpo humano, com alto detalhamento e pr\u00f3ximo da realidade!\nNossa aplica\u00e7\u00e3o apresenta o corpo humano, tanto masculino quanto feminino, com mais de 3000 estruturas modeladas e validadas cientificamente.  Projetado para ser um laborat\u00f3rio de anatomia em realidade virtual, a ferramenta possibilita a compreens\u00e3o topogr\u00e1fica, a rela\u00e7\u00e3o entre os sistemas, \u00f3rg\u00e3os e regi\u00f5es do corpo. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medroom.com.br/politica", "developer_terms_of_service_url": null, "publisher_name": "Anatomia completa em 3D", "support_website_url": null, "website_url": "https://www.medroom.com.br/anatomy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_AR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26232375473072364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618432_734832196347379_5113041312721428738_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptk56ALaPIgQ7kNvwGec_iy&_nc_oc=Adqs3cSR3zX8E71rU4VvbNzFan990gwOgL9EMdOhzw0IQlF9Yoihf3w83QNf3Qpcpb4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CdHXHPbFuYkm-jhYwshHCViBAkXb7EEQ-gDnSyyj6iw&oe=69EE0373"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MedRoom Anatomy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1772023560, "lastRevision": {"nodes": [{"id": "25302203312756256", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25302203272756260", "is_first_party": false, "enables_in_app_ads": false, "
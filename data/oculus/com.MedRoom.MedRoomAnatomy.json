g&oe=6B00640D"}, {"file_name": "Anatomy 02.png", "id": "2240808246386785", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303140_2240808249720118_3957701941128984111_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUHBk1keH48Q7kNvwEUw3yP&_nc_oc=AdopW8W3xaYLSQ0wwEC5kVSiGQ43pI03NNXaYN1_v9Ocb7PKh1x1FtkZsaxJ_hY72kU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlaIvzZSKmqX7rCcMCoxINfxbUggH5VjUMd_cyn2BszA&oe=6B008011"}, {"file_name": "Anatomy 03.png", "id": "1561524928201208", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300910_1561524934867874_7562836933825257364_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MC6WbZj57QQ7kNvwHmOVyH&_nc_oc=AdoBdOUNX0AwKYdQ9Er4WG3hRzAcbk4RkgCnbFiBoZVkgMxrj5EmPjIY7afGm2GLh0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN7Wx20PmR1bGt7n-VZZQJaaxUARqt3sO1NJQms5t5BQ&oe=6B006814"}, {"file_name": "Anatomy 05.png", "id": "1513484509938568", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827703_1513484513271901_1050428443193672480_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08rQjpdR0ZoQ7kNvwHoyDVa&_nc_oc=AdrJMq9AwbGM8ytf8jYdzz3sCnLtYlkvFNxjcDMGiXjGCPcTGKAqsrcO0mfl-xwlit0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR-PIX-314IsKIxo_-PL8aZZ-D5Yq3yd6Io2xAtzcu1g&oe=6B00809B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MedRoom Anatomy", "keywords": [], "long_description": "Compreenda e visualize o corpo humano completo!\nAprender anatomia por meio de uma tecnologia imersiva consolida o conhecimento e permite uma compreens\u00e3o mais aprofundada da topografia do corpo humano. \nO MedRoom Anatomy possibilita estudar a anatomia de forma mais f\u00e1cil, intuitiva e din\u00e2mica. \nFeito para professores, alunos e profissionais da \u00e1rea da sa\u00fade, apresenta como principais caracter\u00edsticas:\n- Dois modelos completos, feminino e masculino, com mais de 3500 estruturas em 3D modeladas\n- Ferramentas como: ocultar, isolar, transparecer e destacar para disseca\u00e7\u00e3o das estruturas\n- Filtro f\u00e1cil e din\u00e2mico por sistemas e regi\u00f5es do corpo\n- Anima\u00e7\u00e3o de estruturas, como o ciclo card\u00edaco\n- Personaliza\u00e7\u00e3o da ferramenta, via controle \n\n\n", "short_description": "Estude o corpo humano, com alto detalhamento e pr\u00f3ximo da realidade!\nNossa aplica\u00e7\u00e3o apresenta o corpo humano, tanto masculino quanto feminino, com mais de 3000 estruturas modeladas e validadas cientificamente.  Projetado para ser um laborat\u00f3rio de anatomia em realidade virtual, a ferramenta possibilita a compreens\u00e3o topogr\u00e1fica, a rela\u00e7\u00e3o entre os sistemas, \u00f3rg\u00e3os e regi\u00f5es do corpo. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medroom.com.br/politica", "developer_terms_of_service_url": null, "publisher_name": "Anatomia completa em 3D", "support_website_url": null, "website_url": "https://www.medroom.com.br/anatomy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_AR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25848070258169556"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4316764955267290"}]}, "baseline_offer": {"id": "4316764955267290"}, "is_approved": true, "firstOffer": {"nodes": 
[{"file_name": "Anatomy 01.png", "id": "25302557812699076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_25302557829365741_565896539596213652_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_UWPKvzKP4Q7kNvwHmNBeC&_nc_oc=AdlaribCUIVbGHAdQeqAXHmhPJEMkUTMAbDzuWgVQ3wa8B_2G5MMKW6h4hXpIjT1dXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzPDDIa9jQ0yvLBeiAhh7TWNiHK9CY-We-o1Cc3UQv6dA&oe=69B40563"}, {"file_name": "Anatomy 04.png", "id": "1143356731213102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827063_1143356734546435_3505792886544055019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEWCmrO6mLAQ7kNvwGu4F6j&_nc_oc=AdmJkP6sf5izag0_AifDnKljYmdPtMUFf2JigB24t7Hqjcpk1N8YMgiNlMWVTy9wsg4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzrLuMPnkjYWfcy2VDnyJLlaPEx9FDrF7qMfj0O7KdHg&oe=69B3F1CD"}, {"file_name": "Anatomy 02.png", "id": "2240808246386785", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303140_2240808249720118_3957701941128984111_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oarii6Zsj8Q7kNvwHeprTy&_nc_oc=AdmoDZIxhMk56_oELeLjkrvDn0lXYMdfpkMqUITij1dXqxTbw-n4N2ZKcFR96-4WL-E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3tVAQcAYbOJaoWgRSzD4hhBF5TfEWzmVqg6SgZUo5lw&oe=69B40DD1"}, {"file_name": "Anatomy 03.png", "id": "1561524928201208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_1561524934867874_7562836933825257364_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQYr2pzj_YAQ7kNvwFUYm0G&_nc_oc=Adk4mvjMw9y747VW7Jk81OHGb3H5AFxQZGkFuZVmyPCtYBFoxN0AmSYkviSoX7TlS7c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxy7jw5DHeIykRAUurR7sVC82GAcChfUIS34sXc8t7LCA&oe=69B3F5D4"}, {"file_name": "Anatomy 05.png", "id": "1287617999877819", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304019_1287618003211152_3913632142547990831_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHdPKlH3unIQ7kNvwFOqP3z&_nc_oc=AdnS_TnE4utSCJ7HCvzx9mVVeVlKkaORV7sJGFRA_jIkCreozh9iCnadf2WhvroNNn8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyTqgCspcP3yRb2CghdDJqa2o5YTTlEv-Iy0OtFVVXUSw&oe=69B41223"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MedRoom Anatomy", "keywords": [], "long_description": "Compreenda e visualize o corpo humano completo!\nAprender anatomia por meio de uma tecnologia imersiva consolida o conhecimento e permite uma compreens\u00e3o mais aprofundada da topografia do corpo humano. \nO MedRoom Anatomy possibilita estudar a anatomia de forma mais f\u00e1cil, intuitiva e din\u00e2mica. \nFeito para professores, alunos e profissionais da \u00e1rea da sa\u00fade, apresenta como principais caracter\u00edsticas:\n- Dois modelos completos, feminino e masculino, com mais de 3500 estruturas em 3D modeladas\n- Ferramentas como: ocultar, isolar, transparecer e destacar para disseca\u00e7\u00e3o das estruturas\n- Filtro f\u00e1cil e din\u00e2mico por sistemas e regi\u00f5es do corpo\n- Anima\u00e7\u00e3o de estruturas, como o ciclo card\u00edaco\n- Personaliza\u00e7\u00e3o da ferramenta, via controle \n\n\n", "short_description": "Estude o corpo humano, com alto detalhamento e pr\u00f3ximo da realidade!\nNossa aplica\u00e7\u00e3o apresenta o corpo humano, tanto masculino quanto feminino, com mais de 3000 estruturas modeladas e validadas cientificamente.  Projetado para ser um laborat\u00f3rio de anatomia em realidade virtual, a ferramenta possibilita a compreens\u00e3o topogr\u00e1fica, a rela\u00e7\u00e3o entre os sistemas, \u00f3rg\u00e3os e regi\u00f5es do corpo. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medroom.com.br/politica", "developer_terms_of_service_url": null, "publisher_name": "Anatomia completa em 3D", "support_website_url": null, "website_url": "https://www.medroom.com.br/anatomy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442
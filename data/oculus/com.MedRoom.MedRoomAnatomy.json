09MegX51-_M1oitlG6KmBZseahG9W4Ti87s0ttB-0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft6WMlCP4wPrLd1nHsw5EZ0Eo34DlZd8DEnvyu0AVv4fA&oe=69A965CD"}, {"file_name": "Anatomy 02.png", "id": "2240808246386785", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303140_2240808249720118_3957701941128984111_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2V8iUxFUrgQ7kNvwGR1lJR&_nc_oc=AdnWnWJBNXNULKqMl4pbe5t7N4Xk-XFO7layjoRL8VMh6WwBMqfQuvTjXrkMJlQlz3g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftBs4OkWoWY3aA0w_hlzqOSz2q8Z7vb0VV3Q74FHIzwgg&oe=69A981D1"}, {"file_name": "Anatomy 03.png", "id": "1561524928201208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300910_1561524934867874_7562836933825257364_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFB2lFVi5ssQ7kNvwEajs8m&_nc_oc=Adnyysjb5OC_ye-6inqqq0rW8aJ501xCzgNj83qXBwoyWjz0_UGEVcv_4EhIw0MacmA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftyYH-H5Syg1ws8q6OyUATUS2wmsh5oMFRlQPAFijD93g&oe=69A969D4"}, {"file_name": "Anatomy 05.png", "id": "1513484509938568", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827703_1513484513271901_1050428443193672480_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=st7Botn0EHoQ7kNvwEl_3kL&_nc_oc=Adn8p7kNFSXktbFVyWue5HoSgKQ_uzKoR_hPZZwx4l1EVLP6qh3Ah3UuuyxqIAGjz0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu5jsfv-EpIInKMXSox5yTYhlrkUBzkCMzRvse_SddjVw&oe=69A9825B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MedRoom Anatomy", "keywords": [], "long_description": "Compreenda e visualize o corpo humano completo!\nAprender anatomia por meio de uma tecnologia imersiva consolida o conhecimento e permite uma compreens\u00e3o mais aprofundada da topografia do corpo humano. \nO MedRoom Anatomy possibilita estudar a anatomia de forma mais f\u00e1cil, intuitiva e din\u00e2mica. \nFeito para professores, alunos e profissionais da \u00e1rea da sa\u00fade, apresenta como principais caracter\u00edsticas:\n- Dois modelos completos, feminino e masculino, com mais de 3500 estruturas em 3D modeladas\n- Ferramentas como: ocultar, isolar, transparecer e destacar para disseca\u00e7\u00e3o das estruturas\n- Filtro f\u00e1cil e din\u00e2mico por sistemas e regi\u00f5es do corpo\n- Anima\u00e7\u00e3o de estruturas, como o ciclo card\u00edaco\n- Personaliza\u00e7\u00e3o da ferramenta, via controle \n\n\n", "short_description": "Estude o corpo humano, com alto detalhamento e pr\u00f3ximo da realidade!\nNossa aplica\u00e7\u00e3o apresenta o corpo humano, tanto masculino quanto feminino, com mais de 3000 estruturas modeladas e validadas cientificamente.  Projetado para ser um laborat\u00f3rio de anatomia em realidade virtual, a ferramenta possibilita a compreens\u00e3o topogr\u00e1fica, a rela\u00e7\u00e3o entre os sistemas, \u00f3rg\u00e3os e regi\u00f5es do corpo. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medroom.com.br/politica", "developer_terms_of_service_url": null, "publisher_name": "Anatomia completa em 3D", "support_website_url": null, "website_url": "https://www.medroom.com.br/anatomy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_AR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25848070258169556"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4316764955267290"}]}, "baseline_offer": {"id": "4316764
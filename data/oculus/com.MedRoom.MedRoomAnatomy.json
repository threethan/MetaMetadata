nt-iad3-2.oculuscdn.com/v/t64.5771-25/499618432_734832196347379_5113041312721428738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt93SG3oJNoQ7kNvwFTOSMD&_nc_oc=Adqwr2BD-DqyT2w--Cv1uBorpJG_AQXdKxCc_ViR1kqKXq6XfG7vMLMebanbey5m5u4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyA82utXV77LkbKYpPertOBfMccwVSt0h30le_Q2qbW5g&oe=69C91973"}]}, "id": "4229296463990662", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1423275555625731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820387_1423275558959064_5972487820205192613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3eDFOre9VUQ7kNvwGAvg2J&_nc_oc=AdqqLWjuzyV5Gf2kgmgO7xQfNOspouyYO8ocX0KCvAANMYDaoPiIZdGu6VHT1ZxOCMs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzL2LwL8uNTomzHPbElTsWAZBEERoepo6IjSA_Ls_Aeyg&oe=69C936D8"}, {"file_name": "01.png", "id": "986883913797994", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820441_986883917131327_5827313875020849701_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD9rPxu3fdcQ7kNvwFC3b0v&_nc_oc=Ado0OfKXmC3ODjZ3X3kC7aF5AcS6gyBKhRmr5O7EKhZp_iKKx3gmHGoThu5PM5OQ9rg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwB9zNaRiuJ6QsTO51mJhSexZbRfxmH3lobpUO-5Lyqgw&oe=69C91E2D"}, {"file_name": "141.png", "id": "1258134302946828", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818890_1258134309613494_1533658700297372321_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMpNNpXNFfQQ7kNvwGP4nKb&_nc_oc=AdohN6fCsLTUiNfaLLSfNRsGEp-V8Oz0lmh32Woca6xW-Tt0LZR_Rg_AjJ1h0TrY7is&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEQa6fgtoACbnNluC6y6ce-u1mKUBaEDbq6wYj_w3hmw&oe=69C91005"}, {"file_name": "142.png", "id": "2825188017849372", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825305_2825188021182705_1735487210601444941_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Slm4aXVPPVoQ7kNvwGoQoBQ&_nc_oc=AdpKkPDAH2hTydQajnLKHT8JRBgg0S9uqV9Cd8AcHsHaM6Vo7HS4aEZSRWvkaHsQx-Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxF5LERsv5FQ8iN7IzOmNFKfXxBH1qc4tcdwGvzVECVw&oe=69C92DF5"}, {"file_name": "143.png", "id": "924149197023855", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825497_924149203690521_2556642533839172779_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htwN7Vp5EEsQ7kNvwHYxzG0&_nc_oc=Adqmc3y1NuROuDXKbuq5Dravevxfzd8kWmIA13mpYTx1P9AISji_OoSDK9wbMJznK94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwdALTGxtmyazaKLZHPTLtF0TF4K1WYKdEEykfl4JKTA&oe=69C90E2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MedRoom Anatomy", "keywords": [], "long_description": "Compreenda e visualize o corpo humano completo!\nAprender anatomia por meio de uma tecnologia imersiva consolida o conhecimento e permite uma compreens\u00e3o mais aprofundada da topografia do corpo humano. \nO MedRoom Anatomy possibilita estudar a anatomia de forma mais f\u00e1cil, intuitiva e din\u00e2mica. \nFeito para professores, alunos e profissionais da \u00e1rea da sa\u00fade, apresenta como principais caracter\u00edsticas:\n- Dois modelos completos, feminino e masculino, com mais de 3500 estruturas em 3D modeladas\n- Ferramentas como: ocultar, isolar, transparecer e destacar para disseca\u00e7\u00e3o das estruturas\n- Filtro f\u00e1cil e din\u00e2mico por sistemas e regi\u00f5es do corpo\n- Anima\u00e7\u00e3o de estruturas, como o ciclo card\u00edaco\n- Personaliza\u00e7\u00e3o da ferramenta, via controle \n\n\n", "short_description": "Estude o corpo humano, com alto detalhamento e pr\u00f3ximo da realidade!\nNossa aplica\u00e7\u00e3o apresenta o corpo humano, tanto masculino quanto feminino, com mais de 3000 estruturas modeladas e validadas cientificamente.  Projetado para ser um laborat\u00f3rio de anatomia em realidade virtual, a ferramenta possibilita a compreens\u00e3o topogr\u00e1fica, a rela\u00e7\u00e3o entre os sistemas, \u00f3rg\u00e3os e regi\u00f5es do corpo. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medroom.com.br/politica", "developer_terms_of_service_url": null, "publisher_name": "Anatomia completa em 3D", "support_website_url": null, "website_url": "https://www.medroom.com.br/anatomy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_AR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26232375473072364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618432_734832196347379_5113041312721428738_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt93SG3oJNoQ7kNvwFTOSMD&_nc_oc=Adqwr2BD-DqyT2w--Cv1uBorpJG_AQXdKxCc_ViR1kqKXq6XfG7vMLMebanbey5m5u4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbaPsEJs8Ejpye-V2mZsDtWTsUeq6OBgc6BdwtRF1I4A&oe=69C91973"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MedRoom Anatomy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1772023560, "lastRevision": {"nodes": [{"id": "25302203312756256", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25302203272756260", "is_first_party": false, "enables_in_app_ads": false, "
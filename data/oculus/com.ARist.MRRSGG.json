eC&_nc_oc=AdnytFlR27ZG2aeIkW3cxh-h3hQy4-4AKML7Xdv8m_XGfOf-n5kGoDzrRfOLq5gCBaU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbQcfeCjRjwO5vjUqIVPlMmGIyXp8l02pD66Zt5DJ6Xg&oe=69AAE240"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pyhPHJzyJgQ7kNvwHlvQJ4&_nc_oc=AdkjR4LJGjSJrUZdOYnGTWsQzcawTFfQBH358Pb0hoTsDHNGTYK_3O4grqZUsFVcH24&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdglTh_LqYSCr5Q70dVYbGahfV7Jzi3IKyr01je1LrWg&oe=69AAB625"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REXCQYJB90AQ7kNvwGGFoEc&_nc_oc=AdmkvYIYfgwybsZVNSeRAOaq3GbuTG9JTvWXq2DEWrOLcpAfeKUWcBKmb-suRE4P8i8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afykl8ji6Vh73r0ZDI-NWDTS4j2p0uvQ5Mun0D4Pzzp9Bw&oe=69AAB1C1"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvDHkndhaUIQ7kNvwEeNOkp&_nc_oc=AdnAoJ4JWTrnW5MYIcJ364wCY6fAIcHW0MZ9Q7tYJekaOMVPr_2xvETB5nwhRcYttn0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxWJ5eP1idKQMxBbfeyPuSoM57J0_KPd5B2YFnMIifk5g&oe=69AAAEC1"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6YkmY9hPv8Q7kNvwE3N_pl&_nc_oc=AdmZz0V2Qdib4HhQzps65sQTtqLLoFP-JTj2P335hQxDa24SQ89UUDwq7VwWbukL3io&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afw4PGcxj82xUBa5h92ePK-vpvQEDJaPDNLrdvMTwjP5SQ&oe=69AAC858"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619096_1387002286404899_7968350811275259421_n.png?_nc_cat=10
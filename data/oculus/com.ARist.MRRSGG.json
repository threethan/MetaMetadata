c_ohc=PiiwVHME0oUQ7kNvwFONL-7&_nc_oc=AdrNNCh229K0_3yqJBca90J11oisMZD1js1zQlKSJ4pWTFCsy1SQtQf_ht7fFXf91TA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_Js_U8VH5SolwlcBsLA69f_NDNCbbe7mH_kpAzSA39A&oe=69F4B640"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mi9QixmBPnQQ7kNvwEbHSXt&_nc_oc=AdqUWdwH2d3Uple46PQ5SgEbMUVzsRRT6m5xX9x9stYHPZpzWPOY7C1ps3IkRp3mdhw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0JzX05mNV4wwt6T0yT0peLRGN8jMfilIPacGVU4G_lSA&oe=69F4C265"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfdHKxae7fIQ7kNvwHsbJEP&_nc_oc=AdpsyKtNJGQRQWdnj9a7DmM3vHLeOHdYDm8G4yjcap7qL1nwhUIFEsVATM4kFIlG9yM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38hVyWgn-PlpiP5VLqecaS2UzhgEjWztBv47QXexf_eg&oe=69F4BE01"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei_KnCYT-jwQ7kNvwFlScje&_nc_oc=AdoTVGvpA8tAp3kG4bOvh2zrJfxmIeKF7AeepycqjUZFQChhMaNafq2O2FOLInY-frM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Y968YbQ4y7hrxuc1EmGxYapxcyD9NWZ-zfP8V0Xfdxg&oe=69F4BB01"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKsCOhbSeOoQ7kNvwFp9DvC&_nc_oc=Adrhhm9ERTHqFoeuUl9mjXv6YAgC9XWKXffukoOkYhbM1XJwTzA986HY7YDr9s-8Q0E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Mp66X2QznlPcQg3wtkO_sShAjMLikkXrckV8V49WeDQ&oe=69F49C58"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619096_1387002286
ent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzWfvI48fQEcLjFIShaxxlQkc9ZqSsxNwh-ltmmdlJTcg&oe=69B2A1F4"}, {"file_name": "SS2.png", "id": "1133038995656304", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618102_1133038998989637_3882041605513596164_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZby_UruNT0Q7kNvwFt_-qC&_nc_oc=AdmHbTrgwYXUavbYAj3g6fwgbSHWAMGN_7KF0gD10WBp-TSJVzjvGw3xDnDcFc5YfBc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuJDcil1BiODyp_HAFP3-6MTsiEoxBi3-rk57ck9ZDTQ&oe=69B2ACE5"}, {"file_name": "SS3.png", "id": "824267776894804", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618293_824267780228137_3091435788585650660_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fFIGb6GotsQ7kNvwF47vQk&_nc_oc=AdkMJIpBvD8oGulwdxlZq_-r8fWHARYlKMOXJe1Z7feGIilXe_B9AX9qqkP-soYY3Xc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxS2T_jZsF5yJ-gB5EuDLxGORsWXadg9bQFkQS4XK1o5g&oe=69B2C52E"}, {"file_name": "SS4.png", "id": "1160723806016945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_1160723809350278_6984884430553935541_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sf91xTDnQSIQ7kNvwE61_-z&_nc_oc=AdnummI3O0AA0pxdPznPf2ua4rsRrBN54JjsfPZphM7ZeB5R810Lo6Io4jFYS0rmRx4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx9UcLZbCLiyiOPqVlbXWz0N9UB3uCCYWvgnRUdhNgvQA&oe=69B2CB40"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjVQGhbzEMQQ7kNvwE1l_ba&_nc_oc=AdncScsz8QravdmySEA0my-TTpEdA9sUp5iel6EU5LOvyh4_IkwbYSA3WrYYVc6TEIY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDG66Wof1-RY56BgEg1WUQDvIfbBbxUyAHDhhjsXTRCA&oe=69B29F25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZs-ce2oLnEQ7kNvwEkpKzS&_nc_oc=AdkdqRt7V1ZsBVMpkG4Wh3oNusb9tRiWzOxxbZH7YiDE5z-kFENmQ9gF6zpHE3RFkYc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDak5MX4vXJRZIC8dqJGDAqYJO0-e3ctbQoJYh8GpfwQ&oe=69B29AC1"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, 
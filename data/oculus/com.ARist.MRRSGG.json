.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2IPDrTuofkQ7kNvwHhqHsm&_nc_oc=Adkppoomsh1FVWJD_kH6eEVgEgErhZ3twPtUIi5K4878Q23ET6Z7TkKwo_vPXNT-mQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv6nutGYgcKkrdKDCjiPz-g7WbNJQu0nUDYS-zxhBb0YQ&oe=69A6CF65"}, {"file_name": "SS3.png", "id": "824267776894804", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618293_824267780228137_3091435788585650660_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cv59b-bMU5kQ7kNvwFf7bOV&_nc_oc=AdmNbciG-M-515vZaAiLOkeYE0mhClljRfZlCIxk1dPxvoMvHKe0VALrQ86pb41EDqM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftg-cl1Idoj81uw5u8FNn7M20gDOCGQgsA-CuCauMTj3g&oe=69A6E7AE"}, {"file_name": "SS4.png", "id": "1160723806016945", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618297_1160723809350278_6984884430553935541_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLfnLtWW1iYQ7kNvwH5F-55&_nc_oc=AdkfL3vXZK1Vy4z82UJgmU1BXPLOnzkWSUUED6bGBYBSHqyk0b9ciLNWyOvQQJSaGw0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftuMTeMiod-h-_vk2qDwcKOHT_Doi9JWltTm7_OI49xzw&oe=69A6EDC0"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGEC63epq_AQ7kNvwFXZsJg&_nc_oc=Adl1UWNjvqJeFzwCsJCp4t-F6upOPaGrLewPg4AQSG6o2tuvjQmEbH5L8vj7BYuaz14&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvP7Xjg5bwwVp3tcRLo6KNDGhqB7zacihQ0_bTdI1DJAQ&oe=69A6C1A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXYrK6bzVYAQ7kNvwEZW6uB&_nc_oc=Adm7MfUU0H_qXUIWXWASkgAZcdyuVNAFicQUc9hjxKYpPq_S8XJtIUPvPNuHhmbceA0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfteCYoApj_By-baNzD1KxMM3lz0EHKUWkJsLUxk0i_O2Q&oe=69A6BD41"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6iYujx8VR0Q7kNvwHWmh7C&_nc_oc
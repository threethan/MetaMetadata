c_ohc=l_n6Mxz-FV8Q7kNvwEKLkbl&_nc_oc=Adqm0QVLP69BYOH-t-3vX6R9AW6mowPnJMBbqWLGm1x0dgqhv43K8gBA-xjry02TgFk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIiQ1E7AzPJLyZjD8ApFF187VsqvFbq-x0tR-8hHgtAg&oe=6A9C24C0"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YR3lEsmaKWUQ7kNvwHI_Rw3&_nc_oc=AdqAz5Hu9uJir2t2Nqyew8BA0uczHCsahltquRZfjY6kXHGcB1C1OsUKnr4qQXTNGQg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsYF9eZoQ_ODgca9ha_jllKVS3Fz1fgaOXBbVN4jsXOA&oe=6A9C30E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lrR3dOVTpgQ7kNvwEJaWRJ&_nc_oc=AdqfoXNAMCVlGDcuHGNbLaRsyip31irZqO3elw2G5dWS0t7Ox5K9Jui3si8_QRpEOjA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9UtJqTGmnP-KSgLtmI7gd3OUqAYk6dTbKg7gWWraB_g&oe=6A9C2C81"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tv5D-YR4GgYQ7kNvwG9noB3&_nc_oc=Ado0PBiIQt8eqJzhPMzeScy2MEcOJRov37neu-kz4sUSxJLsubBy5-tElCJ06VFUptM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEWW5ZatX_ak2taR2X40cc7DBg9RJm1PEwBlwQBEe_oQ&oe=6A9C2981"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_5Au0x76HcQ7kNvwGH8To0&_nc_oc=AdpcqHL0AwUUzm9zHnHZTJon7Eq0Qpjw7mcndPhtxYYCP0kNYSaEXQf-FQVoezT1fFw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqPOJrfj8meSvQDw6uLbbXb1FcmjdRLbmVG6Te0VZR0w&oe=6A9C4318"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1387002286
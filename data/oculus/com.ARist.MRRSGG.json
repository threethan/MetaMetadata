c_ohc=XuQE0eA6QIEQ7kNvwEhM2jk&_nc_oc=Adr70kWqTClygolEhBn2TDTa0XWyV2XWRM3qDU3CFou6oo73jlKh_6ws1QpIQnQcbeY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yPDhdCOidMWp5oTBfvk6n95zZiIWkF8qKxbrdWqSZAA&oe=69E0EFC0"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYZi_EMadYAQ7kNvwG54Xc_&_nc_oc=AdpNLxQJaQigs9VM-2oomZioB3KqNgutI4ii9VxvUEcquMRE-BrAHdK4zpPsj3JV7T0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3F7j48RrvxZw03aVu_PgGsfTmD7JIOn5oCdM49nggGBQ&oe=69E0FBE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huI1PPCqrKcQ7kNvwGEPrB-&_nc_oc=Adoggyue3XP2OWQ8-8sV7VbgW7xVHtFW-Vlq0UKfyUwkGEJQ-MeCOFqi0cz3ynxG4C0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pYfb9EaA88QanXNzTmYbvIvNlSZFjx1zANosWvyL0VA&oe=69E0F781"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwFfIt5OPygQ7kNvwFkZXWK&_nc_oc=AdqfP0zKkEBgu3IhHikKTSKAWjjm3PUU171voxPG-OfiGzPpEeQ70CNZjuK4zIpWfAc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24LZ9B4C-QDK3CP7BCN3DK0RE6vcdFfqfBevTL3T_rbA&oe=69E0F481"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhCqDmMia_0Q7kNvwGZGY2k&_nc_oc=Adrty3pJsqZTLKouwTlDx8O04DmCWYTMR6DRZmaH93gvTOvSRKsy1v2FFZUXHeCfINE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qbF3fGMxtu_TzPMoL2Lq0FqJ59Ms5_mJl6gnfsFjx4w&oe=69E0D5D8"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1387002286
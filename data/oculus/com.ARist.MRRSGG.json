c_ohc=jWIQyo16LFwQ7kNvwFVfmQT&_nc_oc=AdrBGYUys4fO1kJaEA79m7OUjKF6-AFVjuiTxYP9rsqpVmx1RErZgwGuy6oGbvtuQPA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBFLMgne3438agf-FW9a6VKf7nLgreFZWhlm9CPDc6Zg&oe=6A4E5C40"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoG8XPsQQB4Q7kNvwEna_EX&_nc_oc=Adr6J8Pxo9EqJfCVQihCb2T5izWLCvuIGaRcudKtZsXmfj1BHGwtHhFWm_IM3HAxA9k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs2I7o1kjt9T9PKJ6FqVy7H3W4qvBiXe8WtWBoOj3jpw&oe=6A4E6865"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmVrUmTAM78Q7kNvwGEHOWt&_nc_oc=Adp1loiSSIsqWZoAVlAytS1llQ2PURaY-nZD1u9rYWfSEGVyyfZJX816a9wavtnBZUY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgMYe6Iqw-nvrFpNz1IiOFxZWp5LXYqg5p98lUePE_sQ&oe=6A4E6401"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lU4flPrNvFgQ7kNvwH3o6R8&_nc_oc=AdowHzoYfzzPSrgWk1S4wYH1aZOjTaZqDGO_Y4NPPfGaGgy87ftTSTKyuAwHp1zXYnA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0hpGtcogMF94zk25RjAcnzWjL05n-6GPrq9jrDiXF0w&oe=6A4E6101"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AL46rHKHDIIQ7kNvwFiFcAK&_nc_oc=Adph4o5mgtlW_EoZzdKdAOG2yr-Xv4PsWnwGeEx2NJQmBln7Lz8wfkQYlV2E6uahi1Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSDR-GL4RsfnxvIYm7w2fcbhV4piDpYXwz78kaRFIKsw&oe=6A4E4258"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619096_1387002286
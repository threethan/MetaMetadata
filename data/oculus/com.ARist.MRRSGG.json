c_ohc=IRfZ17mKl7EQ7kNvwFOsi-b&_nc_oc=Adq-v4wkHzlGuSo9wxBAzLl60S9Ya5IHiynxpz1xD7jzivl5-dklGB9ToUk9BHWNEZY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzWg5ktdluj7Zk42eOd38cQzQXuPiwgGVZKOmc1Y34cA&oe=6AAD4840"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8ovcDNX9nAQ7kNvwENO1j4&_nc_oc=AdooSVDxPx7fRn-g0DM1WEfh7kchGzSCJJI7r7936HMVFsEyKOebhmfhvKgrwYBKXwY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAyXm2AObZzE9ALa_9UL3SRS3KWiuseXEknwSJRy75bw&oe=6AAD5465"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3e35eK3w5gQ7kNvwFyZy-P&_nc_oc=AdqVgYplqjvnirC39meg6AOuZpoqmTyhE8rj4itsTnCjFznjByKhxxCZs7WqIfl5yJ0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbWDcnypOLMZ2thSqe0p6MNl-HPr6GvBRuD9tR248iNg&oe=6AAD5001"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvsbXNHLy4IQ7kNvwGwQFwM&_nc_oc=AdoWntDz3Agyrh9ofikNVqv-cKZaZhzhf-3_-COyxHQym6sB1vVqqWkDMEH9HbgJQGk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLA7g3MakDOVoLl-D4onhNoqN5fVLIq9UCQfKJCeN9Gog&oe=6AAD4D01"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Je3Ir3mJKroQ7kNvwG2DW6o&_nc_oc=AdpAU3zzbf6Oeq6GN-C0saYoRRdp7Y2onKAmZSDMBF9S9fzzKI53QKNVrrhMybDnUmw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwKfvYAUoS1SK_I5vXVcvDJxvAQc5NPIjBgu_CGdRCxw&oe=6AAD2E58"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619096_1387002286
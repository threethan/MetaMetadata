ent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7PA-g_xu7qeqUoSnabx3add__5-SUwIiKEwZHIk3erQ&oe=69B544F4"}, {"file_name": "SS2.png", "id": "1133038995656304", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618102_1133038998989637_3882041605513596164_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZby_UruNT0Q7kNvwEhI0jq&_nc_oc=Adnok-lHZwHwAamtvwekjGUeO6Vv0y_KtAU2272ri0Qv7swedG9OamAUgIV8rQlv-To&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-IX1CksQtoKMBLn9mN4HzepXP-ZaHR-TSuXO541O4sg&oe=69B54FE5"}, {"file_name": "SS3.png", "id": "824267776894804", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618293_824267780228137_3091435788585650660_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fFIGb6GotsQ7kNvwGhzYod&_nc_oc=AdlEVv6-tNNwbvbyWqxcXTAOyZI6XgeX414SsPP327zxE59V-Oqu39IF1NUBvTULHxQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx4b42eGVIgWWEvbQiJDFkF2RE5L7cn-e3QJpS27ef8oA&oe=69B5682E"}, {"file_name": "SS4.png", "id": "1160723806016945", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618297_1160723809350278_6984884430553935541_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sf91xTDnQSIQ7kNvwE5qDq2&_nc_oc=Admq1yvVjhF3dVeIRRzKNOSQoNKCsECCzugoq_Oo_RmBewD-2Fw4vsgvH_X4IEFgv-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxfNvS72c_ogWv7fNXMjiXnIPuUIAIRIghA9BGywQWYDA&oe=69B56E40"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjVQGhbzEMQQ7kNvwFLQunJ&_nc_oc=AdnOiPtzbPfwLvz-QmObgNy9I-RfaEZEwsYUryssm7gdOeEPCsGIGoZBtZ6B600z1GE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyg4GQ4VF2kXCWcicnaN6HZrfsjqy5gFbz5m3VHWBZ1lg&oe=69B54225"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjMhG0HNV1kQ7kNvwEXype4&_nc_oc=AdmuOAQ5mA8ds2Hzr_sVF2UZoUwhTJY23C0Ya-B9eEWpXW66DzFWzffYLYnz8w7I3ww&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxKdlqU1VIvOzexPDFazhKybctn39Zyos8uHDTMQCEBjA&oe=69B53DC1"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, 
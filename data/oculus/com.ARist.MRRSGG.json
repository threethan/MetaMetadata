c_ohc=j0LT5L3prykQ7kNvwFSvZO1&_nc_oc=AdrilpFjOcm33zhn_F0VJCi9DxeynVQHHCztjuNFB65lyZDG4K8BcarFgFk__J0VhIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KF4tFbXg42HXgoMAuv473Oj4Wjq4PXSvT8b6gK2FrPw&oe=6A1D94C0"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPzulMMpJNkQ7kNvwEBk4SV&_nc_oc=AdoYXZtaaM0pufui4scEBkHS9MwXraBZwlhhb675A4f1VEv-9pzRkPM_AauTCV54oYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58s184Mn87MBuc5vw74GWzwJOlTiEtkvJeB_wNyPwgrQ&oe=6A1DA0E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gk7j25Rj5vwQ7kNvwFDvZIa&_nc_oc=AdrMCbronra_oBf66Ho4GfG0GfCe_e2IJE0zrNKRtmIkkAUUkoPszNshtLD7VXDvdKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UfvPgdwtT0lI15dzWhgB_NhnV9NWdhHmQOypPdJfszQ&oe=6A1D9C81"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfXiVK_Jt4wQ7kNvwEDRbKw&_nc_oc=AdrdxXv7qV5_rA8p0DZaSQwFJXwzEuTwTcYTyu7KMHqXsu2b0MsXUxMLVsNeuuxAUdE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IPZz7m-_RAW2m16ywb7s2TbtUo3TlhwxPG7TCS9ggmA&oe=6A1D9981"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddvUOOchK3UQ7kNvwHLpKZ5&_nc_oc=AdqqqR0JOCnGW-J-jCp9XQkbld24ZFG8hJ8H5oDTCZmrdNC_riVn5XTSFu2Flpu3BMQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SgOUtATNzD1l-q7k-IAIEAL20tIUH5CfpMkMiX0WSYQ&oe=6A1D7AD8"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619096_1387002286
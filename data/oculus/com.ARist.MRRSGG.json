.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WofbOmt1S7EQ7kNvwHAVlz0&_nc_oc=AdlDqxGtGgZous8vragot3e5j10s7ttC2nBWyIygS2Q_uM9j6Bf2t0Q3pleB9HSqX5I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu3e6jZZkEl9FBQ_klUfRshnK2o-UkOH2TiZgIQzI4rCQ&oe=699D94E5"}, {"file_name": "SS3.png", "id": "824267776894804", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618293_824267780228137_3091435788585650660_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjyChNJhfHcQ7kNvwGMROAK&_nc_oc=AdkaaNQoyF639DPeiQ4ZZOO0k4SGAuYtPGDSlqO8-XJ-41EY8eD7qg5MV4LIzMPab54&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfscZaTTxj-_JqoAjaGiBXEu_eNHyupG85YEdY9EDm0J_w&oe=699DAD2E"}, {"file_name": "SS4.png", "id": "1160723806016945", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618297_1160723809350278_6984884430553935541_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LN2SHxcXeYQ7kNvwGZVMUW&_nc_oc=AdmlHfT_-TXq6hua9-xWlBoEQRy4s6yOq0wyBi6lqNkPuXqva2v5hSBgF89ivRMvyYk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv4quC4Dd7mGk0j_tWrKUyeknsmkGill7ET7U1T1Omp8w&oe=699DB340"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKbHO6TfNUsQ7kNvwGH_GPE&_nc_oc=AdnFkRnFns_vgprFPTajGuNKvs2xwd8TP-krOKv03ddlaSe7dgewUNBf0RakFZ9IP08&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvDPElgERPx5io1vHMO8BrFPS-6OwHf2OKlvOr8MxDPew&oe=699D8725"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8P8iMftuIp8Q7kNvwFjGUgu&_nc_oc=AdkmZa0YHhkI9M0D0msPBvdjxQGtOhdVL7qsAOeK7-5mlg_su4q-CE8J2UAAh-ZedwU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvEI1X4pi6UR77PWbWLgBA02C7na3c_2F3qu0VseTCyew&oe=699D82C1"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZKEcCFVniEQ7kNvwG9S6M5&_nc_oc
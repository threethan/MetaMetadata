c_ohc=SE1bFje1maYQ7kNvwHPvQ3p&_nc_oc=AdotjFi5L6Rhz6DJFuMbVmhAouBp8yZ-MHI9Tx08AWd4CFxPNelV3LQB57gokLino2g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Nxj4Q-ZQ1dKzoN1t8QN5aRmBjC-nq4fJAWE0B2v-VZA&oe=69DA5840"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vO10Tk1CgAkQ7kNvwHjhpK6&_nc_oc=AdrDco7CDqQRj7hyDuF4lY0K4pdYABd4n8ra14F3akhMT-seGG2N55v8xEYjubpN0tQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1c7CT9jZUEeFe8md4Q8b2PHGITiF6WtqLPFwieHO8-Tg&oe=69DA2C25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xj0IxCHR4Z8Q7kNvwHCmT9D&_nc_oc=AdqCaXLJaAiIo1nY0Uf80o0jV2xKBnxW9m-E1DqkGC4cBnFMuc1_L7BBOBoeiVNZYxw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0N-0iBHDI8n-JClcPXjx7yQd_2HleONsXv9S1gRyqi8A&oe=69DA6001"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3jlnwLSc-MQ7kNvwHAnQMs&_nc_oc=AdpOhwrlnHZxfH4BUKM5iasIdlmwX-2EeYtaaCwjvnw3aHG-px_Fc9blbq4hWyQL4Mg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lALWJdGWt2yTgBu-LRT_MPuglo-w7jKzOm3c2tUhczw&oe=69DA5D01"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIYqDL0fZRQQ7kNvwHMcpaV&_nc_oc=AdohAgjVjPW7vyLpv1_HS9VzA0UDfalbn709ujW_U7fhNEmLb0Hhq2vgLB1aQm4d8bM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YQVqUAPeCjHCfK0Ie4_6bl2-RZDvu8Eb8g7td7J1V-Q&oe=69DA3E58"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1387002286
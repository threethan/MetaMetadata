c_ohc=KMNS4LsXH7gQ7kNvwHTD_0_&_nc_oc=AdrlxEe-ePNjURNkHiWUzfs9RR4s8tac5nzfTwSEudav3ePOMLlIbpWsvDRYlqvFasw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBp7QSEJ8tRyNVwoFEUXjBlXPdGYg70guCQ2almhC-l9g&oe=6A6F51C0"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqXB8qRh7vYQ7kNvwE5jqqA&_nc_oc=Adp3hGj-Bwzm7Mioq5r3ZR6K_b4LstNDEFbiJDrMLPW3uGPRmDF9YPbSXBwbGdsuPQc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBg6IOnjkMnbQ5VvHKE3w6C1EzmIY_sTTz37qVky1vyHA&oe=6A6F5DE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIr6Yt3QaS8Q7kNvwFiIIgU&_nc_oc=Adq4wsGL3_9QbZ00NLaC7V5Vp_IApkhMi_DL5hpjFJHyKzSs0Ov8IpiQbUQ1Oz5t6fE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTIXHjj4TZSFAcLBun8PTIwklVm89gYvHSqu0v4ZEdEA&oe=6A6F5981"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkmbV4EE9L0Q7kNvwECuwvX&_nc_oc=Ado2hDeapDtFWGqC-Q4B_PsQhKHyWcX0pdI8z0i-lqqH4Gh6yVxlnR0ikJEy3Knj9O4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJI5SVydlFu9dKaCjOGChhVXlmQvTQVGP1MdBj8BqQXQ&oe=6A6F5681"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZxj6j473AUQ7kNvwEyoHMV&_nc_oc=AdqhxAWht2wJcsXWHfNRCZQWllyupMsCFF3DVbdHbp_2jXCOcicbTbcg2C-FQW-OJaQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhhFjEAptBWD3i82mxBQkZy8KBXI-o_pMPYCHwUl4LWw&oe=6A6F37D8"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619096_1387002286
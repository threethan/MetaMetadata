F2E"}, {"file_name": "SS4.png", "id": "1160723806016945", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618297_1160723809350278_6984884430553935541_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-bUKiyfP_gQ7kNvwH3-3jG&_nc_oc=AdoykLb5A4bHZzxokGqQ9vBzQWU34sY39-u2sbmG4OgdQ7G9omAjrv1JIwBZColoUac&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAxFsXFVfZj2uKnHgEugZTBxZZWuQxtOb1BtRO5HWZOA&oe=6AFF0540"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyVawAxiXAwQ7kNvwEmD2z4&_nc_oc=AdoJy9WRAQajGgpUTQFAjGnC93Mz0lxZp-q2ryknV3tryhH1mxE3iB0SCMlK10sYU04&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3aYy6ndcGi54FzGFneAtAaZbmx_5YnOEistQTpNXI7A&oe=6AFF1165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtZE7oxjIMkQ7kNvwGyuCe3&_nc_oc=Adoa3cCHWt7NfinhySOXSS2KHLFcI3-XNrR8_oNPRS1e6YL0-48eSLHENXiJ0VrgXmI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQDjJ9DRSbJ7hLXhz2Oq93QYiZesNVmqOwHyZPnjYatA&oe=6AFF0D01"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEJUrb58QpkQ7kNvwEL5CUf&_nc_oc=AdrBNuCO9tCWlNLCjDdlne5aDvKU7rfC_AXNVAGo5yVHYfmJ2LeVKJOIRa1NEXYS5MM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS09Br3yeR0Vz7qPy7-9qb8E-roUJCiZ0LCHtJb-SCXfA&oe=6AFF0A01"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNQdFURN8XQQ7kNvwGQTFBv&_nc_oc=AdoK9AUfMHUuYO25ffu8dbRPkhlYF3QOqS
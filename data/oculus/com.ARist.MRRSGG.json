c_ohc=roTeS6mOc28Q7kNvwGLZ0UA&_nc_oc=AdpfvlLxoSnTbkGHnsC94goUdlt-_lazmbgjgovHeovySk99W_Hova-LdSuRFQfnP8c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_z_SaUjQMsZvcbqnaP1Onu1IX8o5VWs_MWXGTBAWqs5A&oe=6A32ACC0"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODAl8QMQCXYQ7kNvwG7u2RN&_nc_oc=AdpugVjijRkjb61C8In1GaWaiycxYLuqZ30HKiE7u9DOawUv7YEMZFRu_9xIl5WobWg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XI7cJu0cNcWqAjys-pNabQLqEtKmD8R3Xk4AQdsGT6A&oe=6A32B8E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MAeKOGHjVoQ7kNvwE7hSnE&_nc_oc=Ado5c9fTmsdYKMypDlpCsTjqKQUvQbY94iMH0-fzABzdv5PFgOtL7nBVllyzM8J6YlU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S-_IgrdTaeNQy2r1IzIWY1TeHwAuPFkkvdrXBN8yJpw&oe=6A32B481"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--UhIQKR2_kQ7kNvwEAkqeW&_nc_oc=AdplaPn0_QFygNx8CDXBYUx7ZXyhMFajsmP1Pcg06DSfOeRyH5l4SMkyDmP2JtOd9yI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zpTPVZFYkHImWnGxLFPI5tQB4AaXPLK0WR0gXeISwyw&oe=6A32B181"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVdLsZssAXQQ7kNvwFWxvNT&_nc_oc=AdodKJ8skqfjK0WjKLe6crCCKOtXEnLPtD8iATHwR4p19VkhtvdIKGfDbHz_M46g_BY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xywc2buu0v1auQ63Y4DYuXBczZYmdzhvvlFCZQLPS8w&oe=6A3292D8"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619096_1387002286
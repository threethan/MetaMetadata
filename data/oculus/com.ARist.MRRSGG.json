c_ohc=-UVpYT7gT0cQ7kNvwE0gJf7&_nc_oc=Adqh4nddjWftMd14ApVk3sSFwc2jgtjAiW--pnTz9VMrXTf2n8NS4K3Ktg2Xsd26pik&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FdimmWQ7AmDNWc4GnU2XUrUPDnhGUSOt5ckTph0kCyA&oe=6A2820C0"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lwFgHyuUq0Q7kNvwHW5xxp&_nc_oc=AdpW5Y4ZfEqZvupIDOzh-y4RKH8YE8RLYkLCVhiVod4q799SYpGWniC4KKMqbJUTtZM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HlGPpKxZt2hMDtnt5q7evI1w15zaHtr40bSNN1XQbKw&oe=6A282CE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4ndXUEN8rUQ7kNvwFDtbYp&_nc_oc=AdqyBm-KEp9ISBTeM2eB9r_lFGn9gC4s3D5eE05fIBdUgh103WD5AOh2f7cEltwVgUY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mcH6PUWXThDsFbhU4zyg_gj3DjTiEVRhEHM08HeFwjQ&oe=6A282881"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7qjkBlshSUQ7kNvwEIrMSu&_nc_oc=AdqoGv4-M24BoYsEfzkWoEbvOq423Rbba0oiXz9T2TZNzbnHq3SZHT3zAv5QRuo-5CM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96YNu1jt_MhyM4RVIqaUp0rx6c2CwJbWV1JjfYRJAX-Q&oe=6A282581"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPN4SMc4YqcQ7kNvwHbQegz&_nc_oc=AdpFz6PN6Mi_iM5-j7eq0A47ej9aJejtmdK9iQdCIAM5GMxlT2_KZj3AXDCnCV1yiDs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zBUE96UspJSvtGqQskK6H7WEg8KoFLhAfqG0NsimOtQ&oe=6A2806D8"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1387002286
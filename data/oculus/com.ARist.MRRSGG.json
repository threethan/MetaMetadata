c_ohc=ZJXTEKnVCNMQ7kNvwHQ7rwe&_nc_oc=AdoPkQXiN4RGdW9-wWzKYHnwXGcDl7XIdwsujeN-ay1BJiqUh7DOIHEa02MpM8Co9aI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ogi72sScQE1XK0el3ud4CNq21kWopgehR1BFdYnZn-g&oe=69D7B540"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaH4Vho_PlUQ7kNvwHQ_oA3&_nc_oc=AdoK6pBApUmzGWy76Cr51T2p2I9wNDosfABqn7AbhsPylq6AF-96AWxP9_IUvVQp91M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1y1exfY_XnMvM-sN_dT8kieKVwxxlukM2v3z_CaO8gZg&oe=69D78925"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xj0IxCHR4Z8Q7kNvwFfomgd&_nc_oc=AdrgYE8U3Ls6W_xdCR44XMgOVP3jaV9M33QL50Q05_MEmeOSTyF6n3AU0jVQ0KMNWtk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Vlul5--bj3-qhsEUp7iLpA-CMV3tuhUI80Lrig_pkTg&oe=69D7BD01"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnCam0aNB4gQ7kNvwEAkxGe&_nc_oc=AdofgiKpxb6r6JXOipq-XVTJTSwWxocacXKUOB4VbiuujyKSp2M9KuCGR-Xk1clWHVo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38geRgsH1uqiG7OR1QzQOhJ-DGYkzXSrAtM60HvBgDeA&oe=69D7BA01"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-M_fEHvguUQ7kNvwFLHcs1&_nc_oc=AdovlsJtZrwN21j5GuFkqkTHuJLrLLT1DUpv7Psxh8phH-KFWv9YuHbwsGs_QzZnY8Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tLsyyDzT4omarQgiysNJgJFepdm4d3c5gqARAtKc_4w&oe=69D79B58"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619096_1387002286
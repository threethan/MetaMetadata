c_ohc=8zogblnfoR4Q7kNvwG-DKad&_nc_oc=AdrLYspiTiKfpX3emWWwPhAkJkDqZaxgYTK6vI3ORoctj7IR97GG9hSDvbgm87s3exs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsyEDYbsQ0x_h18aI1EeshH46i8jCifyE-lF6t3Mielg&oe=6ADF6140"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgN16-HyF2oQ7kNvwGCin_d&_nc_oc=AdqdgxL7S_t6Q1JzP-H5SQwDHjgQA-4UX3tR2zjvVN7oiXORnYUHIGIqFg_e7dyt0wM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUv7ETT5atbWIYyIc_rotVLMU4-HDr4BEJ7BE2pz3how&oe=6ADF6D65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuPyzOw2KlQQ7kNvwFiFMHy&_nc_oc=AdqpUOPDTmK-T7w_kr_rljzA9xVawj6AfIWEjz_-F2-exXQc0dIw-isX6CSO2P_PSaA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPur_3r3cm9r5ZwlIdJ-Yw8r8nNh7c1b_IYPSodJ-NVOg&oe=6ADF6901"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNK141s8IVAQ7kNvwH3-LwA&_nc_oc=AdrX8JTXTc3cKdL6VOVAuEspQKDzTN_aPvQCXoF7JtlHiCjc35DNbfN80Ws0IvvbNtQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnCV7lH38qsLFfDVdPVBu9cBdjCsp2n5JjYbeOfgeE9Q&oe=6ADF6601"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7U7gkSxLWIQ7kNvwGOapfk&_nc_oc=AdroritiipaGqDV0xT0epfnUFQ8u5eyi-U3p9jYAXOyck5_n0VN9i1QD1ydT6n6vCQc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYgznfAQeMiY7i91EwJNm6dxfF3B3SyWCksk0qUu-DxA&oe=6ADF4758"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619096_1387002286
c_ohc=oGyoHMtn_KEQ7kNvwGvyebb&_nc_oc=AdpZKGzV2Tx-JmW_VnQa67JRco8qCZnfmFzV1Wg0dj7kWDAuhw189SaKELFhRTh5qtw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SqvRHW_bft00UD_jzo0AhDg3LVgPt8vvLqX0j15AN1A&oe=69FC9F40"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6z9URwaZGzoQ7kNvwEmjFpx&_nc_oc=AdrajroizdLkJxsk67GFmc5DIkWXOHgX0SOtKKI2Hy-czwfXB9DUNydHweWwjkAnRK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47cql_BDAlyCREhy2znUYtZofF8z9lF1bECcztbSwz2g&oe=69FCAB65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nb6k5A90oE4Q7kNvwGbrx-y&_nc_oc=Adoj639SYPdumaQ3ZNprUVfCwI7N5v92aQtIwI9Hs7MwiczwFSshbuvF1uMtyEpz0E4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4M8o6uwXbonbDMvSPnOewpcul1VsS_gR6ZNACtJ2FdKw&oe=69FCA701"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZMMCwU61pUQ7kNvwE0uDNp&_nc_oc=Adqsg5IdQ9rj0MqXB72nnAkbbuEZ-OViqECMuVWvDWSlmlJosGtJjPAO2C1lIp3VZSQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40CnDWq86Xp9qAUY4-4J16RmowZya8sA-gPgh3aHq4UQ&oe=69FCA401"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHDOU59o6LkQ7kNvwFJ-bP8&_nc_oc=AdqGw1NhWMe3A9-im-mEsau8cmW9aiM5O1ypox963lPFL6YaYEp4fptRkAqrUlV2X4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wIAtvnE6gxWaDN5FNdAVc3E7V1kFAeUf4qwL-davLnA&oe=69FC8558"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1387002286
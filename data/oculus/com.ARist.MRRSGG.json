c_ohc=pJ7wkuSxgQMQ7kNvwFvI7Sa&_nc_oc=Adq8IobnHcsjUmQdVDhE3itl96nVFD4q2vCniObdX2PWOxGK66iAjutFxFB5kWxsme8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiTGdONYzZ9CNj4b9htu21Prt9rXWYOur3_jvbexgaww&oe=6AC50340"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zOe2L39xTIQ7kNvwGqwgBS&_nc_oc=AdrjMfh0BkhFI7P_hyipslHhwYbuccsHh4p7Z-PhVHtHUMbU9Y60oJ-ouihVKnqAhgQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbK396KEMmfr44lkxs_sDEInp4kVJrjz_QQ11WwosiCw&oe=6AC50F65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcrM-VOOeakQ7kNvwGTG2yG&_nc_oc=Adp6ZKANT6ayRw8xcDGir5RwDYgs9PvjCcPH7ovkX9T20KKaLSvhkrijTQKQzkvZqzE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPJEdoEOCy6oNMwDFaXmM8-pYmEDkTE3cVvUMAfncRqg&oe=6AC50B01"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kt96iDi31oUQ7kNvwEP4ChP&_nc_oc=AdrB1Lyg7CRd4wZ0iwOmeTRPKMfq22_PWVHsUYBXIIhKctEFqyIoAD11t8dW6B3gdx0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzZRWMoxOMmm4E-Q6HsPT7EGfKVABctjmhEYXSJHR4Lg&oe=6AC50801"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAnyHY4vMX8Q7kNvwGTjyKP&_nc_oc=Adov5U1JPomLiWdmf6pXoS1qIa52ATas1lgzrjmhJMRfCjn7Mg3sMeQGYl-hhqO_vfY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIhCNXS7eD2bFysur7jE4vhmn3xA6fKpN9n7gVlQ_XBg&oe=6AC52198"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619096_1387002286
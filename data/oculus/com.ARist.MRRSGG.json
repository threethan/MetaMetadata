c_ohc=II9QXjs7rJEQ7kNvwEUslLI&_nc_oc=Adqq1OJPLYRy9ptbGcCqbxJfij_MMoAj1P4JpX28G3efAB3gHWD-G30HaGlnMOxwUmQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98fu_zqxcfyl0FsoaTtQ4klIZ0WKoIKO9sLtr52e6YhA&oe=6A412D40"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1APENoR324YQ7kNvwGPe_9T&_nc_oc=AdrmIIqhGdBFA14Tsw1KmK2aJtHT6tcwnsx9DBWHpJSEXFbcYEXm0hUn05W5pMlPsTw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1qC9SBwLOv62czkMQFnkQt4lKebvnEh3VxiVjXIfRog&oe=6A413965"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9Vgqm2-YW0Q7kNvwFcZzUK&_nc_oc=Adq11eyHuDfsx7gw8w85cUOOK4IEPJXMOMUXcGDS1_xKGr_txoL9689cKbcEjmIYo1w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h1SXUYMPyOBS7ct_49678GQ3CtgpKetAWmBnP2STCDw&oe=6A413501"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFAHTYmdghoQ7kNvwFrkBKs&_nc_oc=AdqYLQnHM0m6Fbsubu1bQK1CH1IxK8Bla9lyx5Bw1ooIuHFV9j4yIu_mlClKM-Vn8D0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TzPePz8qNOXOyUfdyWTnYTC-BN6TPiQY9l-3fpPncWQ&oe=6A413201"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FUw5FBMVMYQ7kNvwE5Y4il&_nc_oc=Adonp3Wc6ODJ8xCMYQdUzppz_4yZd3h3PsIP3vTFFs7uZHIjhYq7H1YWJSxdBRfr8do&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gvexm8AcpiEzEsRqw0czmaDCCjWpVrK04GHJJv6En3Q&oe=6A411358"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619096_1387002286
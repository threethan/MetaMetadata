c_ohc=7t1EYG_9HesQ7kNvwFd2_c-&_nc_oc=Adrf0V_hzIosyrB5uHTHV7ATXa8U_qovjLEscjDjHpCAoVgjArTAg8Ir6RAp4YUjUG4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsaXbc3CH5ypicgzsAJAMTYdIFr89msGxsWuTFS1c7hA&oe=6A6768C0"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hmB1AyptrgQ7kNvwG9kKqH&_nc_oc=AdoHXb5V038cTGt1ge9jOSHbYn98l99v9WFc0BhCPzZcypYcEk2MNdro2ikM0GEbFIk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChNQSihQ7jntOLWXnHYJ1wf1mnAAAxQK5HhTYv5wHRjQ&oe=6A6774E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DATv_MkZxq0Q7kNvwGvZst3&_nc_oc=Ado7oMW6zWYtXh46N2uOaepVs1JJJI5WhxC8fi_HpuSdzAqYQ1wXVkMjrusBmpZnx78&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3OXQJczlEChcOaCY5hhSSZZgtSNdxFDJGye63mYhaEg&oe=6A677081"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63aMQLRGINgQ7kNvwHnFCw8&_nc_oc=Adpl_zDJiQlWiQj8CqbdjS05AAVZ-SPudgkDPAf1n4wjrhNNB6hlubNm5qSb-_fHv_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKsyQ0hThQMDJdH9lbXWxwlYlg-XeWpcse7prgW1cvjA&oe=6A676D81"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrRD3HzyBYMQ7kNvwHTr9W6&_nc_oc=Ado44u7WuDLJvKGMaNdGFdmCNCDxlm8bDMVnvoIVwA9Xm_ClHe93RvGEgI9GLvx8R3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuckUrzd008Zf2DvGB53gzKMl3I4kDAcYZYT3OzYTfkQ&oe=6A674ED8"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1387002286
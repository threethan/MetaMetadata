c_ohc=tHb7TcGgIlkQ7kNvwGWSJUd&_nc_oc=AdrSEPnkyThx2SEpucjRAg_nzjeGEdtFg73mKo8dwtGNJDONyUR4gN2YDcYqJ5TQap8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG160rNKNPHErLDQkNvhuZARRyKoQUsHjKMpNvg5K3QnA&oe=6A7C4880"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3x-yWLunJVMQ7kNvwFQBv7-&_nc_oc=Ado2K4SGLzJak7ilfSFdnnQKwnz2Vgo4TQD7y80P1uHjq38fzepDiB-a9GcfZQ-QRc8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHkA8nHLUbQiAl5WJe908HIkwe3sotXwPULZngumW_7Q&oe=6A7C54A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cz_HsXMRkXwQ7kNvwFh71p_&_nc_oc=AdrvzgbqRUl9gyCcoJD9K2UTZMu-uvA4qDkyichm9IdHw5EY9CCLocRdu2dYgWoLqs4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMQ_Uw1CHhT5MG8rknx3DaNJZk_LI1AjClprMpvTCfdQ&oe=6A7C5041"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Egzgbg3lCpQQ7kNvwGemf0c&_nc_oc=Adpnq9H35ugIR2xjFCB06ajK47dP6NA23rUimYjytLlhb_594QUDHGbz_-Uy1blgr00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwCXzJRt8B5mTjxzrugE5Jt0FGl1q6BR7a42re0PwyZg&oe=6A7C4D41"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKShZBl0jEEQ7kNvwGEebIM&_nc_oc=Adojk4qvrn_xkoQYH1DJp2hMrsaqnZr_Tk35g5yFd5E1RVkaZC_IJpOR347A4tiP5aM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHti2aIPOglhkX5K8Le3iPTtSlK69Ro00DvH4lp4ayHKw&oe=6A7C66D8"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1387002286
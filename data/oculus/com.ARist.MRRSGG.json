c_ohc=H2hG0QT1CvcQ7kNvwEDno6F&_nc_oc=AdqiAR2E_vks2Dx0NyZRnzxzAEOFg7Kc0NFHgwynwlMCpqyTp0YQ22kxOgkiPZuQqg0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHcOf7dWuSqpaaXMbriUmKfOABA-KBHSfee717mTMbmA&oe=6A897780"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_agq73MLB8Q7kNvwFlaoHM&_nc_oc=Adr3CFLo9NHRSTagdwH7vQT7blcqVSE6-OJw7-tqo-6tSnPHzPPWJPUIt5kytAxTSyc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiJCIb0YnAq-OBwW7nct9lWcv-uViH-7xNG8yiqvcAKg&oe=6A8983A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7uw0iyFs3IQ7kNvwEcLrg1&_nc_oc=AdoVvJ3HMTyCGlBu52LhkfPxlz7IY0Km7HXeAit3Rf0rDT7y1hhjAnTWxssyBqs6WHk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6_rzVJDAGAZCBTx2C3SEf3RHh6jBunlH6vtVK6j73Lg&oe=6A897F41"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a19TYVB2WNMQ7kNvwEU5Ov5&_nc_oc=AdovEuypYV0CYnpK3GuojV9jHxW1_y4LEM7MAxFRHsU5qAIBXnoJ1j8eJzXw8P8kKa0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLKJO6C00Z9tw67doNkXn0Wb0Je2ntVR0CEJzUElbISg&oe=6A897C41"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQQKeQYpoOIQ7kNvwFMD6VQ&_nc_oc=Ado7bJ7EqcyoKi7QAUNN50zJXAN7X3Tu5oFWNx4ddU-KxgXAZC9XY6ytJGduRgr6rUI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMKpUstJOZ5s8xaM2_GQmnt4gpiS4gPRHSvOTyqZEz2w&oe=6A8995D8"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1387002286
c_ohc=TUrnfNCcXdYQ7kNvwH93jT5&_nc_oc=Adp_EEQ-P-cClhgNLZ1RoG7NNc1R0M-rCTy63igeKuPqp9R3Vs4PZEjmx-QtaKMpZxg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0s5CqtY0KbkqrSBxgKfRDiPh4JM9A4zgiAJQ56G5mIfA&oe=69F8AAC0"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whBlnvGx304Q7kNvwEk6jmQ&_nc_oc=Adp0dGJlJ7FKCZintvMyydBUcs8Lf2rgOIpJX7pAfTWIxa_xyGkhEIFnU5mBWChtj5Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hKwrx8w7Kma8P9sHpCb1E2IFEPAx9050fZHZ-qvS9SA&oe=69F8B6E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMPwsl-3_qsQ7kNvwG_6gaT&_nc_oc=AdqhFD81WsHTwcBQPPphlJ2gSlRGJ6wmu2_MfnaLpl4SxA_HVxq-R_AZublIrVvAX4w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2CWYZP82SVy4MSdgT6KO2YYpBplIQaVOQOmjrsR3Wddg&oe=69F8B281"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKRNO6pzT_cQ7kNvwEs36fa&_nc_oc=AdqKv5qljwSqPy1EYWsLuLUsMLkLaC8GP5RVUv1IBiYhJ263CvNjbBD6bAoDr9ceBuk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3XVCIFZsxdGVfaFHeP7yoWxDj8mOF6Kxg0puhs-btrlA&oe=69F8AF81"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Siu-zKhscsQ7kNvwFZLSyj&_nc_oc=Ado_mzyesEz56WX9aPsINvNOmxMQPzbvOpxJtD0N7o9mT0KJzGBKRKuTu9vtKmbeOwE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2CPCiASDFXxxK-UdivaHZJHu_qSM9tvUt030bW0JsncQ&oe=69F890D8"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1387002286
c_ohc=aipu81XwdZsQ7kNvwG56k4m&_nc_oc=AdrjMnTk5jh1jPd8QENAWkw57ywOm5pvqzIzKtFJKsWCgHfYAuB1xTcYTHeyiY7EBdM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1faaAMRBdA5g3JsXrCAxwbxQRsJanutcUP2Gd-Eqd6UA&oe=69EF7040"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5_e3ZXuvHUQ7kNvwGXrvLG&_nc_oc=Adpx8YMBBrnV87uN0TBaNllMJUJQzLXst9pugJJMc2267RcseA-NULY3uXdUnmbO1cc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0AAMv-oSBt7Ec59PRVwqhW0a9EvnZeKwIDHAfeasLaWA&oe=69EF7C65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUt3VuFJLp8Q7kNvwFXfH0S&_nc_oc=AdpoS6dkRZ2IWbcaCkTD7RM7oojhfOKiHkMqbIdW5FQ4A8jmK3nFP5Wq2ly_hvaXozc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Ya2fpLpdtAcIRrbvaYDuihtBsrn1rqR0aD6a5q0r48Q&oe=69EF7801"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-33Y4bQGRl4Q7kNvwHhPOSG&_nc_oc=AdoDRqQrquYBgNzLNjOL5GjjSu-OAHD1GZNfssHdLK4bwSAmM9Mxzc8nrTfWGux2qqg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1MeQgNyBeei0QC_w7DqUxQPrnsHhni-XTuy3kDmqXhdA&oe=69EF7501"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiFc2xBNp9MQ7kNvwH4WB1v&_nc_oc=AdpY_VKsdGYdzpzRog48N1jqjGa2EtNQogHqsNWPd5frFpMBACmtElU1xpOcbEFWV50&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3pENp9oMsmkTGqs1V0m2v-v-18DmDKWGEihjTxCrL4IQ&oe=69EF5658"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619096_1387002286
.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WofbOmt1S7EQ7kNvwE5KIWk&_nc_oc=AdkJuls1oLhNYR_HGja9QPkM1STRVsRdQF6LY_xtKz4N3_uPr3ZXs--ZoVxaGR3DQ3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsRb6GYfLcY5Zx7wV1sXKojADINuWtveZtll235AIbT-Q&oe=699AF1E5"}, {"file_name": "SS3.png", "id": "824267776894804", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618293_824267780228137_3091435788585650660_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjyChNJhfHcQ7kNvwHhPqOP&_nc_oc=Adll8-ab5WL-1lIFqUUzlGoCwFCaPFNtQFfDVX6Ljfws3EXzTxkmfMll9JJ06AZIZ74&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvi_p3_-fd6YCS7Tp0UgQu6jxDetlx5WgK1otF-vPWnmA&oe=699B0A2E"}, {"file_name": "SS4.png", "id": "1160723806016945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_1160723809350278_6984884430553935541_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LN2SHxcXeYQ7kNvwEeM5gt&_nc_oc=AdkpHoUcf65qb4Oe8VCsAnSZPG2dQWWsIL2BVDNZXIv9ux-OKgrTCt8Rjp4Uwt7Lx_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsJ3P2GXVYGVBccd1ObpXAwpMYTJtgVoCmoVjbFUYMcFw&oe=699B1040"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKbHO6TfNUsQ7kNvwFrktPh&_nc_oc=Adn8e1wonR57F5VLfmJLLsMdNC_CaI7ASAjHnOGJfZ9pLMEZzNWCiV0DpREIdSfPQJ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft0sUooOugPOl_aecSM7VQi4I1BfxaTxhL4ZobSTlASWQ&oe=699AE425"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51s6NHo2mM8Q7kNvwHv5XYX&_nc_oc=AdkGALTZUFkTOHR0uvZTmv8KUA56OvNBpXFe-GPtn7EvAmBgsyDVybeeahdqSIRtzYs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs_c8L7lSYCTANPztUWhZCeCbM_RqVRAQEHeSNIfScKXA&oe=699ADFC1"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZKEcCFVniEQ7kNvwE20Dw1&_nc_oc
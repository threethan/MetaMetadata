c_ohc=Lxm4oAjjaiUQ7kNvwFjjraT&_nc_oc=AdrpaOAf75IzrGTzcgTca6E1mpLU-sDCYlHvZ4xluo4zaRzBlTRk1qbzhnOmlrOiLIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLbzTU-F46rnhs7PPafwFTncyGMMsxzMK8uI9wsCOaLg&oe=6AA6B0C0"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXHayfIWv4IQ7kNvwF7742Q&_nc_oc=AdqLXXnQdqKvAC7RB_si8LMZXx_UJWh4olV9m3uHxoizgTvFHnYPXLci24NK4lPIlho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYjwmL6Znm9QoIQmxg1fFwRPkIf2BnyBPnKaajwNLfpQ&oe=6AA6BCE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqyZ1lLtd7YQ7kNvwF2_PC8&_nc_oc=AdpI0QjRmjnv5LY9cjUV2I9bljpVCTaMJQOOlL9uIxJKE_4cTMmMR4mBDEg7Fu0DaY0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfb2TKIxTKmrdNS6VOf79AhjTmXW3BvrrAvUn6Edk0NQ&oe=6AA6B881"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caqNFCO0jREQ7kNvwHLMFGt&_nc_oc=Adr-KPaZDGMCSWYvitrQQOIRMa4jVqfLeXRojKJwdTD1jYiKL9z64duF0zne6S5V8bo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLamvtc1LQt8Z5vMnQJMqvqqumM09xGg-4G1T6oAuyROA&oe=6AA6B581"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-dTqk__VOIQ7kNvwHjEw8X&_nc_oc=AdrtRw7lL3U5pqrt9Vy0v87Z2Hkk9h0wUFVpfrs7jygV9NoObEWqOiHb6uK4dzFUHyk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiiPpLuOZooEnJUphR_FELsXhVTYU3BS4BRT11_vWClA&oe=6AA696D8"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619096_1387002286
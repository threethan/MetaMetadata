c_ohc=II9QXjs7rJEQ7kNvwEp09Mg&_nc_oc=Adp6pJkRUD5X7IH_CFHrbZv1Sw2cLYhgTgv9uItVxN2HSz7rBvCdcUdBxoC96kZMNuc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84ETZ-5NBXxMqeAsM-oK7i5RY5sAH13z1DVf4l8URdYQ&oe=6A3FDBC0"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1dKlCrLDkoQ7kNvwG4nTkT&_nc_oc=Adp_QvljA_bYYvsK0-mWUxmf0qKs7cZdKSzLVwryBkJmCU-zXsqwuG4Y3jh58SNVvXU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--nNLF414iS-fvgwdtK2YoWfvVyq2zFszZc7NB53kYhA&oe=6A3FE7E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9Vgqm2-YW0Q7kNvwFZDUJn&_nc_oc=Ado4wPf25injIXd6v02oLBOZRpJFlGB0fUyCTVh2Coa3SkVVLeE3q961menaHq5zQmA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97XlNxeuvRSh24aw4tbPG6Iaus4PgBf8D8iew7jxYF1A&oe=6A3FE381"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnIGMsPjoJkQ7kNvwHIAl8O&_nc_oc=Adov8pbB4U5Dye6iWdAle6LQZEAa7BJFxxZLK2HzTP5yhzZsdokoQCQjYjLPYsB8tY8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9So3jnN3G227Zry3KMQFlyCN6Mu1Jo9iAJ_UQ59N8duw&oe=6A3FE081"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FUw5FBMVMYQ7kNvwHNKzaz&_nc_oc=AdqhAPZzfRnHEJEcQNWRKrTnUi3sVuG_6u5qFCTnMWE6Kxrb90kxWAr5xFRIsqn9dnY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a5TvY_FQJ1TQ47QAW2364OnXL2U7azZuxHk_NIQmI4A&oe=6A3FC1D8"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619096_1387002286
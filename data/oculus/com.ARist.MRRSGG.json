01", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_843521518111634_6863257859002990697_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmNKlV0N4acQ7kNvwGPJ-L1&_nc_oc=Adno8nkKxM54bNSOV16zR2XQytLbwBcOLnbzreGT-oGV1K4E-1nIdvK_GLnruGthYt4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxeFv-9uuiXmhw9XquAEVYzs5m_tpEpG6rFrJSOyxH5Dg&oe=69AC2710"}]}, "id": "1163417718757321", "locale": "en_US", "screenshots": [{"file_name": "SS1.png", "id": "2064647930970878", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619078_2064647934304211_886345753828511673_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g2xQ8ZweO8Q7kNvwGjA76x&_nc_oc=AdkHQ9bmmQm6MJFg8UvbYyfZlhcFt_o5ianN53S8o296tjGCmRjju5Dzd_h7aKvOou4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwD_-K16DxZJLkvvYHxsm8Rhisr0GD6_8mmIrWzB_clMQ&oe=69AC0A74"}, {"file_name": "SS2.png", "id": "1133038995656304", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618102_1133038998989637_3882041605513596164_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGQ8QUc5OZcQ7kNvwH-F9Su&_nc_oc=Admd25-1SJPHdoP3X_qTmXypRHyIu5lj-xz_Ijmoyg_Fn9MlVFoMP4CpxL2UKO_tfR0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-V6HFdaU8eNnOaSuvJtREYZRCRaOAGs8mqcQ29KFEkw&oe=69AC1565"}, {"file_name": "SS3.png", "id": "824267776894804", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618293_824267780228137_3091435788585650660_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKQq6lKsheEQ7kNvwEh11GC&_nc_oc=AdmXBZCh5EQTwQzpjr94oK5f1BIzNFlFF3-CCq5ZPmDEUIHTfxZTg2aHg8ZWEWMANk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfypIU8kUVXPWX2Hi-iIu_NkI8bp0C02POgWO8utkJlMTg&oe=69AC2DAE"}, {"file_name": "SS4.png", "id": "1160723806016945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_1160723809350278_6984884430553935541_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmjlCmlq5dEQ7kNvwGgrmzK&_nc_oc=AdnUErkgkJcENCkMgGnWmln5d1indpScnfb0Qg-pyrLL0Z2-haJyWjAt0tmCSGobgTU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzagY7tNbWylWeZb9qQI60NqMg2z5gwg12W_syq7gAoFQ&oe=69AC33C0"}, {"file_name": "SS5.png", "id": "759727260454325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624983_759727267120991_1266501669953778969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pyhPHJzyJgQ7kNvwF7Jhml&_nc_oc=AdlG6nvsJl7Hp0f53ok3pdu_ByY3zaFC07M21lGdCDog_V3ACEAXRgdTKusciNvTLIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXyGElSLr24ywntUpGBa0PMr8ftPwUn5VXdqMQdV92kQ&oe=69AC07A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS1.png", "id": "1823369341636479", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617850_1823369344969812_4125471720244184492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTTs1l_7_c8Q7kNvwGtO2_j&_nc_oc=Adk6ma6gVns0z_LqPPtv1RMnJzXhrNXLhEWUTBsNGhlkka27WwjjujLFgWxX_OvVKpg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpWxJ09KehPOWRVUC8U0CZPAjLYl80BGDRiE0yyFecpA&oe=69AC0341"}, "display_name": "MR Real-Shotgun game", "keywords": ["MR", "Shotgun", "Passthrough", "Party", "friend"], "long_description": "Players sit at one of four seats around a table and take a shotgun loaded with a random mix of live and dud rounds.\nThe rules are simple: shoot yourself or shoot another player.\nRounds continue until only one survivor remains.\n\nThe shotgun\u2019s pump-action, shell ejection, and trigger feel are recreated with care.\nIts weight, handling, and the tension of facing a muzzle create an immersive VR experience.\nAmmo patterns change every round, producing natural mind games driven by luck, deduction, and courage.\n\nGameplay is round-based.\nAfter each shot, the shotgun automatically moves to the next player\u2019s spot.\nA monitor arm on the table shows ammo, turn order, and hints without blocking your view.\n\nTo heighten the excitement, several special items can be used\u2014ones that let you peek at a round, boost shot power, or take high-risk gambles that change the match.\n\nDesigned as a party-style VR experience, MR Real-Shotgun brings players together at one virtual table, mixing fear and laughter in every match.\nIt works both as a focused small-group challenge and as a lively turn-based party game.\n\nMR Real-Shotgun delivers a simple but intense gun-action experience, making full use of VR and mixed reality.\nFeel the tension and enjoy the thrill of pulling the trigger yourself.", "short_description": "MR Real-Shotgun is a mixed-reality VR Russian roulette game that recreates realistic shotgun handling.\nWith a random mix of live rounds and blanks loaded in every match, you must choose: \u201cDo I fire at myself, or at someone else?\u201d"}, {"images": {"nodes": [{"file_name": "2560x1440.png", "id": "4071728603045097", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620856_4071728606378430_6082007646211553204_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvDHkndhaUIQ7kNvwFmyxzn&_nc_oc=Adn1-BD8V-ANa3f_4QGh4kZZoRZF4WdPMYT_2ofCt6gI0CoaRm-divXuK0H-aohiSlE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyk5YPZ_KYP3IHeCt6ZZzqo-O8HbzkiIyDRc7BYYbEsJg&oe=69AC3881"}, {"file_name": "3000x900.png", "id": "1618796835951057", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619672_1618796839284390_1901251409983700090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6YkmY9hPv8Q7kNvwHUYWS3&_nc_oc=AdlxnKvDon4oHWWtnWP6JpTAcfV9HZKcIrLqjzlnSw-a4HjueNrFjxc67FCZxxDDxok&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzNVjfXo6mi2sl8nQAt_sFpt8Oo4KPM-or4x8r7mJE0ZA&oe=69AC19D8"}, {"file_name": "1008x1440.png", "id": "1387002283071566", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619096_1387002286404899_7968350811275259421_n.png?_nc_cat=104&ccb=1-7
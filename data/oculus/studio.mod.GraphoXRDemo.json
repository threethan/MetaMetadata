cdn.com&_nc_ss=7f20f&oh=00_Af7vR1l_-DL3nWCfqTLvZFwpliUCiSxZaJxx1_-EtxOCcQ&oe=6A1D8871"}, {"file_name": "grapho-xr-ovr-demo-screenshot4.png", "id": "3959625570975931", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/468726059_3959625577642597_1886134438474685898_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzhhUEoASZIQ7kNvwHwTvGM&_nc_oc=AdqWdmkgqqzaIjnKGSfbj9u1Kr099vYJw1IwC90PgSUZrO2Sez7ZQWQzcIfr1F6INTk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rcqz9gdsqpk8JSVgNvDfG4EM1Ou4Ajn94-TlrasKNjA&oe=6A1D9245"}, {"file_name": "grapho-xr-ovr-demo-screenshot5.png", "id": "1686004475380457", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003268_1686004478713790_8466601274807976636_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ODJV_jTmXQQ7kNvwHHL9Qx&_nc_oc=AdpQabnOOMtlPOw5_-__kZX3S0AqjCFeXPFp5SyHoYQW7UWJ10BNvQ-BUDJF0PzdBnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HKgF9E3BdJ4-_Ql73tzAJMNmOEYlKj4tDF_RiwXSmgA&oe=6A1D8B01"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grapho XR Demo", "keywords": [], "long_description": "Grapho XR is a spatial graph visualisation tool and a new way to manage and present graph data.\n\nIt\u2019s an interactive experience that feels like Minority Report meets 60 Minutes. Grapho provides flexibility to switch between data sets and between visual themes, ensuring the look is right for your audience. Display and take control of your data. Share knowledge in a hands-on intuitive way. Use it on-set as an interactive in-camera VFX solution.\n\nSee also\n\nhttps://docs.grapho.app/#grapho-xr\n{839084764896338}", "short_description": "Grapho XR Demo is a spatial graph visualisation tool and a new way to manage and present graph data.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mod.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mod", "support_website_url": "https://docs.grapho.app/",
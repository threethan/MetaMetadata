cdn.com&_nc_ss=7f20f&oh=00_Af42JhP0DSQ82PBPEj7pof5esfpjUlk5Ri5Zp503ynO2Kw&oe=6A1C36F1"}, {"file_name": "grapho-xr-ovr-demo-screenshot4.png", "id": "3959625570975931", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/468726059_3959625577642597_1886134438474685898_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCGTP9e7D_0Q7kNvwGEVuSK&_nc_oc=Adoa6OTw4eCN-_xwLsyOaY82v7yIDaNigyk8c7TH0IAWiVc7m5bNejaF0nmOb-Uhlek&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wLt8MleLdP0klEPUqo1kK3GoFRJfP8HnZjEO6wBpFKw&oe=6A1C40C5"}, {"file_name": "grapho-xr-ovr-demo-screenshot5.png", "id": "1686004475380457", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003268_1686004478713790_8466601274807976636_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ODJV_jTmXQQ7kNvwHMQm3R&_nc_oc=Adrmza2dYMGMdC_duh14rQKzahabVQF_IpxwNJnPDEtHDYa7MBEutr69z8SKE-LEvtQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71XKJNNgeinSZcvInVfbysZa6fF5LEMYsmV6NFkU58TQ&oe=6A1C3981"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grapho XR Demo", "keywords": [], "long_description": "Grapho XR is a spatial graph visualisation tool and a new way to manage and present graph data.\n\nIt\u2019s an interactive experience that feels like Minority Report meets 60 Minutes. Grapho provides flexibility to switch between data sets and between visual themes, ensuring the look is right for your audience. Display and take control of your data. Share knowledge in a hands-on intuitive way. Use it on-set as an interactive in-camera VFX solution.\n\nSee also\n\nhttps://docs.grapho.app/#grapho-xr\n{839084764896338}", "short_description": "Grapho XR Demo is a spatial graph visualisation tool and a new way to manage and present graph data.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mod.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mod", "support_website_url": "https://docs.grapho.app/",
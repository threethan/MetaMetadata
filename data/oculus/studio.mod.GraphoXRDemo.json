cdn.com&_nc_ss=7f20f&oh=00_AQFJcVoRDbHy4vRcEPtARzoC9Sjt1MQb-oYqsHWblLITDg&oe=6A903AF1"}, {"file_name": "grapho-xr-ovr-demo-screenshot4.png", "id": "3959625570975931", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468726059_3959625577642597_1886134438474685898_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k85F6O_QE4sQ7kNvwGzJQKK&_nc_oc=Adqzb3Jf1NfBB4gS6PS7GAo6O1CivGP-k4f9q_hXEPDpYo8zy6vH5nODxvcXvJWDFhw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhiuWolVJbfQUeKm2hk5xp6H3Fy1lu6FbTqpTKgIPkEA&oe=6A900C85"}, {"file_name": "grapho-xr-ovr-demo-screenshot5.png", "id": "1686004475380457", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003268_1686004478713790_8466601274807976636_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26aWOysEWUAQ7kNvwHn56ZK&_nc_oc=AdpgnCoiyrQRaw3IcTcQbHHKdQWr20qOCcf5cK4HEvFWYyqJb3tROhrXQ-i-OYS21uA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6Ds4YTDQ69TzCt4VSx_lU_CNdbC4I5Z7iLukb8dJ59g&oe=6A903D81"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grapho XR Demo", "keywords": [], "long_description": "Grapho XR is a spatial graph visualisation tool and a new way to manage and present graph data.\n\nIt\u2019s an interactive experience that feels like Minority Report meets 60 Minutes. Grapho provides flexibility to switch between data sets and between visual themes, ensuring the look is right for your audience. Display and take control of your data. Share knowledge in a hands-on intuitive way. Use it on-set as an interactive in-camera VFX solution.\n\nSee also\n\nhttps://docs.grapho.app/#grapho-xr\n{839084764896338}", "short_description": "Grapho XR Demo is a spatial graph visualisation tool and a new way to manage and present graph data.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mod.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mod", "support_website_url": "https://docs.grapho.app/",
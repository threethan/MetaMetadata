cdn.com&_nc_ss=7f20f&oh=00_Af6OL67xFnDBT8L1O-487PkWIO1ttFGQ31jZM_1sQ7JHDQ&oe=6A087071"}, {"file_name": "grapho-xr-ovr-demo-screenshot4.png", "id": "3959625570975931", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/468726059_3959625577642597_1886134438474685898_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHIK7PzCOp0Q7kNvwGdTjtr&_nc_oc=AdoNpIrTX6SvtloS-wSYMAGgrbW2hYBXdeJ60t2lYJ_R0pXLBq7uLm2N5hA39hzMBA0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44jwbTmVI-0JEWHp6gB6ZpKjwkh_0qOvoZkyvhlwNCyg&oe=6A087A45"}, {"file_name": "grapho-xr-ovr-demo-screenshot5.png", "id": "1686004475380457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003268_1686004478713790_8466601274807976636_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDc9vTE6eX4Q7kNvwFYGJI4&_nc_oc=AdpxI5LzstrspFufVUpLp2vJ7-PO84G4sNz6rwWXd02B3h_rnbxx1ee54UB2e_aNXP0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lmoSjYOfAhmo_9jN3A9MFaqLToXzSZ1M2Y_qVlLZNBw&oe=6A087301"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grapho XR Demo", "keywords": [], "long_description": "Grapho XR is a spatial graph visualisation tool and a new way to manage and present graph data.\n\nIt\u2019s an interactive experience that feels like Minority Report meets 60 Minutes. Grapho provides flexibility to switch between data sets and between visual themes, ensuring the look is right for your audience. Display and take control of your data. Share knowledge in a hands-on intuitive way. Use it on-set as an interactive in-camera VFX solution.\n\nSee also\n\nhttps://docs.grapho.app/#grapho-xr\n{839084764896338}", "short_description": "Grapho XR Demo is a spatial graph visualisation tool and a new way to manage and present graph data.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mod.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mod", "support_website_url": "https://docs.grapho.app/",
cdn.com&_nc_ss=7f20f&oh=00_AQHmAuU_wO0kZqVNwmW-sNdvgLa2QXwSCI4hiNDbyeEGZg&oe=6A772E71"}, {"file_name": "grapho-xr-ovr-demo-screenshot4.png", "id": "3959625570975931", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/468726059_3959625577642597_1886134438474685898_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zxDHf6tYDQQ7kNvwFkyBt0&_nc_oc=AdoPAcAT5ynt5jfIMtKyoZu2jgiZqanPeBDr7ciMkOgqQJX4eZBTLquvljB5XKekaME&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzBmR8VF6Uou4sJL94qXbLdrF9c65AXn7CzK-BMi3vpA&oe=6A773845"}, {"file_name": "grapho-xr-ovr-demo-screenshot5.png", "id": "1686004475380457", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003268_1686004478713790_8466601274807976636_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52IbfvELiRQQ7kNvwHO20MS&_nc_oc=AdrZ1w65vmem0hNRUhcRublon7fm3gGOVYCS6ExsxIrODac-Opr9Qfw3OgVTvVwgOu4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZK7LUZPiqW7y6kRpj-aB316xNL4UVRBOCuFcJiz7SFA&oe=6A773101"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grapho XR Demo", "keywords": [], "long_description": "Grapho XR is a spatial graph visualisation tool and a new way to manage and present graph data.\n\nIt\u2019s an interactive experience that feels like Minority Report meets 60 Minutes. Grapho provides flexibility to switch between data sets and between visual themes, ensuring the look is right for your audience. Display and take control of your data. Share knowledge in a hands-on intuitive way. Use it on-set as an interactive in-camera VFX solution.\n\nSee also\n\nhttps://docs.grapho.app/#grapho-xr\n{839084764896338}", "short_description": "Grapho XR Demo is a spatial graph visualisation tool and a new way to manage and present graph data.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mod.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mod", "support_website_url": "https://docs.grapho.app/",
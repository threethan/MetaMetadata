en data sets and between visual themes, ensuring the look is right for your audience. Display and take control of your data. Share knowledge in a hands-on intuitive way. Use it on-set as an interactive in-camera VFX solution.\n\nSee also\n\nhttps://docs.grapho.app/#grapho-xr\n{839084764896338}", "short_description": "Grapho XR Demo is a spatial graph visualisation tool and a new way to manage and present graph data.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mod.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mod", "support_website_url": "https://docs.grapho.app/", "website_url": "https://mod.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24571647465769024"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392200_1134872561364616_3615556489544683307_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXbBo_M9BtAQ7kNvwEKPFJr&_nc_oc=AdnATDfrEYTsaqG4M-tNhxSY4pj2g0_NC5zL5wdT9F5rDAK16HVNlUiUqDcyaHVk788&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuq_63uCitFESO9_xZn0TKh35bY39pZyHL9Dp_edSOwbg&oe=699EEDDD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Grapho XR Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", 
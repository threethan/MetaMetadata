cdn.com&_nc_ss=7f20f&oh=00_Af65p7Mhu3FbEi5VJM6mzHr25gUn4RmM4TfZL76U5SJKnA&oe=6A0DB671"}, {"file_name": "grapho-xr-ovr-demo-screenshot4.png", "id": "3959625570975931", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/468726059_3959625577642597_1886134438474685898_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoAjOOvctbQQ7kNvwGsr743&_nc_oc=Adrzv7kUCyxXvBa6MmQXngGNNo6VNQoKlsG183aWILhGQHWWmUwO32EnI4gv0chhgOA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G78ZRYM62GgtrmrLQquQ8ozWCzeOV3vSZUfDHIkL4EQ&oe=6A0DC045"}, {"file_name": "grapho-xr-ovr-demo-screenshot5.png", "id": "1686004475380457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003268_1686004478713790_8466601274807976636_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4V0GobNksEQ7kNvwH4FoVl&_nc_oc=AdoGxyU0ZxteQXtZw71HWrIG328UIZsA92EYS7aOFgrDiBYsoNi86I-xYXuez3MjSs8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qIFGXXFNkc995f4BfX8Xhj1ElMdSrie3yKzv3_bLz6Q&oe=6A0DB901"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grapho XR Demo", "keywords": [], "long_description": "Grapho XR is a spatial graph visualisation tool and a new way to manage and present graph data.\n\nIt\u2019s an interactive experience that feels like Minority Report meets 60 Minutes. Grapho provides flexibility to switch between data sets and between visual themes, ensuring the look is right for your audience. Display and take control of your data. Share knowledge in a hands-on intuitive way. Use it on-set as an interactive in-camera VFX solution.\n\nSee also\n\nhttps://docs.grapho.app/#grapho-xr\n{839084764896338}", "short_description": "Grapho XR Demo is a spatial graph visualisation tool and a new way to manage and present graph data.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mod.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mod", "support_website_url": "https://docs.grapho.app/",
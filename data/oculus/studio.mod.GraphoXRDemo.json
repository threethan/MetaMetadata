cdn.com&_nc_ss=7f20f&oh=00_AQFnh5BgmYNNKQc05hfGIy2Y-f5Fqr_7zUTFu41RO445Jw&oe=6A830BF1"}, {"file_name": "grapho-xr-ovr-demo-screenshot4.png", "id": "3959625570975931", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/468726059_3959625577642597_1886134438474685898_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFVhpin0-5sQ7kNvwGMCLa6&_nc_oc=Adr951porqnp0vANpIu0iXN25LZG7zWaWlcGB-ZtP90pGOw1_Bm4GVrKGm42QYkLGsA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa3ulHj3ArKxnCCJ4FnNIT5X3OTaBDIy8i43BM5WY5Tw&oe=6A8315C5"}, {"file_name": "grapho-xr-ovr-demo-screenshot5.png", "id": "1686004475380457", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003268_1686004478713790_8466601274807976636_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pjx9kkmGxs4Q7kNvwFpef1c&_nc_oc=AdpthrZffmP5bN5fTdZBrKW5gkEA2jDhuoRkKqHmcFeJnHSIqD-lT5fBLXreWW0CeOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqCe1xJs2a51K8VaGq9EnKYHkP8XtEU9N1s65GXqb5eA&oe=6A830E81"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grapho XR Demo", "keywords": [], "long_description": "Grapho XR is a spatial graph visualisation tool and a new way to manage and present graph data.\n\nIt\u2019s an interactive experience that feels like Minority Report meets 60 Minutes. Grapho provides flexibility to switch between data sets and between visual themes, ensuring the look is right for your audience. Display and take control of your data. Share knowledge in a hands-on intuitive way. Use it on-set as an interactive in-camera VFX solution.\n\nSee also\n\nhttps://docs.grapho.app/#grapho-xr\n{839084764896338}", "short_description": "Grapho XR Demo is a spatial graph visualisation tool and a new way to manage and present graph data.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mod.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mod", "support_website_url": "https://docs.grapho.app/",
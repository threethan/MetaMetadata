cdn.com&_nc_ss=7f20f&oh=00_AQE7yWeK2IJkTpdWAns2UkJ5o6Xmb2T02sRjpe4KnC4yBQ&oe=6A748B71"}, {"file_name": "grapho-xr-ovr-demo-screenshot4.png", "id": "3959625570975931", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/468726059_3959625577642597_1886134438474685898_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zxDHf6tYDQQ7kNvwFCBm69&_nc_oc=Adp-tZZmVG8kdbDkERKiVyUgPgf0Tyx6R9iNE2SvknmPsGH5AeC6-3FxEqdKJK3vQQY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfCTAvmQqYlZoTdZho-6gb7UHAI9b8KwvmayF-dQ89bg&oe=6A749545"}, {"file_name": "grapho-xr-ovr-demo-screenshot5.png", "id": "1686004475380457", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003268_1686004478713790_8466601274807976636_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1P6nVv2o_n0Q7kNvwEHqmUC&_nc_oc=AdqaEEP4QGxphJtnaTYlaokLxouJ8gLeRAcco2bUiMdot-bq3WxqhjY_fVsGsb1b6X8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHldO5-Rjr1jcwib5tCvyWkCbhDMCdUnLMOTqeuEb1Vyg&oe=6A748E01"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grapho XR Demo", "keywords": [], "long_description": "Grapho XR is a spatial graph visualisation tool and a new way to manage and present graph data.\n\nIt\u2019s an interactive experience that feels like Minority Report meets 60 Minutes. Grapho provides flexibility to switch between data sets and between visual themes, ensuring the look is right for your audience. Display and take control of your data. Share knowledge in a hands-on intuitive way. Use it on-set as an interactive in-camera VFX solution.\n\nSee also\n\nhttps://docs.grapho.app/#grapho-xr\n{839084764896338}", "short_description": "Grapho XR Demo is a spatial graph visualisation tool and a new way to manage and present graph data.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mod.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mod", "support_website_url": "https://docs.grapho.app/",
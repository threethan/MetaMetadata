port meets 60 Minutes. Grapho provides flexibility to switch between data sets and between visual themes, ensuring the look is right for your audience. Display and take control of your data. Share knowledge in a hands-on intuitive way. Use it on-set as an interactive in-camera VFX solution.\n\nSee also\n\nhttps://docs.grapho.app/#grapho-xr\n{839084764896338}", "short_description": "Grapho XR Demo is a spatial graph visualisation tool and a new way to manage and present graph data.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mod.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mod", "support_website_url": "https://docs.grapho.app/", "website_url": "https://mod.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10030995736927438"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2004757353332519"}]}, "baseline_offer": {"id": "2004757353332519"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1738293600, "status": "PUBLISHED", "id": "2004757353332519"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27748097458123993", "version": "2.3"}, "id": "384398711366751", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9765613903465624", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27748097458123993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "384398711366751"}]}, "change_log": "* Replaced API use of Neo4j id() with elementId() - This is incompatible with previous versions of the server, upgrade to grapho-server 1.8.0 or newer is required\n* Added support for larger graphs\n* Added support for loading Unreal Engine levels from nodes\n* Added option to show/hide error log in Settings | Advanced (hidden by default)\n* Added option to clear the cache in Settings | Advanced\n* Added option to disable/enable auto grip in Settings | Basic\n* Improved asynchronous downloading of assets - there is no longer a 2GB file limit\n* Improved spawning logic from Expand/Collapse\n* Improved scaling nodes with 2 hands\n* Improved app stability\n* General performance improvements and bug fixes", "created_date": 1777356844, "id": "27748097458123993", "version": "2.3", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9765613903465624", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27748097458123993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1777350255, "id": "27747198878213851", "version": "2.3", "version_code": 15, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9765613903465624", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27748097458123993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1777342847, "id": "27746162594984146", "version": "2.3", "version_code": 14, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9765613903465624", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27748097458123993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "384398711366751"}]}, "change_log": "* Added download progress bars when downloading API data\n* Updated pointer visuals for clarity when hovering over graph handles and nodes\n* New distance control system - press TRIGGER while hovering over a graph handle or graph node to toggle open & close\n* New force pull system - press and hold TRIGGER or GRAB while hovering over a graph handle or graph node to force pull. If holding GRAB you \"auto grab\" the object once it reaches you. This is a simplified mechanic for triggering force pull along the original \"flick\" mechanic which is still available.\n* General performance and bug fixes\n", "created_date": 1753248033, "id": "25070147915918974", "version": "2.2", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAss
cdn.com&_nc_ss=7f20f&oh=00_Af64-hf20FtJIz14lOaKokMCJbQ_L6B7cQ3SOPNOKV_8Hg&oe=6A202B71"}, {"file_name": "grapho-xr-ovr-demo-screenshot4.png", "id": "3959625570975931", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/468726059_3959625577642597_1886134438474685898_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzhhUEoASZIQ7kNvwEZWYfB&_nc_oc=AdpE7oSQ8htVJNqdO9dBXaxZBCnVxNr1zc1v3rx7n2LsmbDyHvPZLnzVIDcA56WNQtI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TZMr-5mZE6G2OWvT_6WByazT5MXvXlJNbSZOHA5WmEA&oe=6A203545"}, {"file_name": "grapho-xr-ovr-demo-screenshot5.png", "id": "1686004475380457", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003268_1686004478713790_8466601274807976636_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZX-WoBGKN18Q7kNvwHA0bRX&_nc_oc=AdoC3reZnW23ts6GF2Erd96_t7Ms7a5r3vUYjkaVVrzLxMsA0T3j1BqhuCRbQVG54Lo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N_i8u3GYepPvQCZsA-TLXma0hI_bkOtHkA33THQPTaQ&oe=6A202E01"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grapho XR Demo", "keywords": [], "long_description": "Grapho XR is a spatial graph visualisation tool and a new way to manage and present graph data.\n\nIt\u2019s an interactive experience that feels like Minority Report meets 60 Minutes. Grapho provides flexibility to switch between data sets and between visual themes, ensuring the look is right for your audience. Display and take control of your data. Share knowledge in a hands-on intuitive way. Use it on-set as an interactive in-camera VFX solution.\n\nSee also\n\nhttps://docs.grapho.app/#grapho-xr\n{839084764896338}", "short_description": "Grapho XR Demo is a spatial graph visualisation tool and a new way to manage and present graph data.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mod.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mod", "support_website_url": "https://docs.grapho.app/",
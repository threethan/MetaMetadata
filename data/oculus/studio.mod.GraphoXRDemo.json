cdn.com&_nc_ss=7f20f&oh=00_AQAmAOzINjyf4TOf0xD6FuZ-nuVhsVaMFVlrF2_pRJ7v0w&oe=6A6367F1"}, {"file_name": "grapho-xr-ovr-demo-screenshot4.png", "id": "3959625570975931", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/468726059_3959625577642597_1886134438474685898_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JKi1rhOnwgQ7kNvwHV9f3u&_nc_oc=Adr7SfqxPP-9-EQxpv9B6CxmAVfUfu_8unJjGwvIPf5wPO-1qgEfJGpbYRAU8vtq750&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAspwd3gLkod8JFgA-eak-UC9a3ngKbyNXPY9M51P_ERA&oe=6A6371C5"}, {"file_name": "grapho-xr-ovr-demo-screenshot5.png", "id": "1686004475380457", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003268_1686004478713790_8466601274807976636_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slrw8Hs3epEQ7kNvwE3-ye2&_nc_oc=Adr8pe3LqO4DHWdZ1ukHAZIQ6kE_fj3SOxWetifuRv9ewS8dsmabZabpeF6jNVdN5y8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtx-GtZsk6zRtTCh3CyAFZN9jqjE09KwQcPYrzQlCelg&oe=6A636A81"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grapho XR Demo", "keywords": [], "long_description": "Grapho XR is a spatial graph visualisation tool and a new way to manage and present graph data.\n\nIt\u2019s an interactive experience that feels like Minority Report meets 60 Minutes. Grapho provides flexibility to switch between data sets and between visual themes, ensuring the look is right for your audience. Display and take control of your data. Share knowledge in a hands-on intuitive way. Use it on-set as an interactive in-camera VFX solution.\n\nSee also\n\nhttps://docs.grapho.app/#grapho-xr\n{839084764896338}", "short_description": "Grapho XR Demo is a spatial graph visualisation tool and a new way to manage and present graph data.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mod.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mod", "support_website_url": "https://docs.grapho.app/",
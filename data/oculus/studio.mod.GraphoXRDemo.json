cdn.com&_nc_ss=7f20f&oh=00_AQNZzFPQdZ4lzlNOD2d7Xf84oDl5sw4jG2zUesR_xoetfg&oe=6AC4F6F1"}, {"file_name": "grapho-xr-ovr-demo-screenshot4.png", "id": "3959625570975931", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/468726059_3959625577642597_1886134438474685898_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGRTI1tZadAQ7kNvwF5CGGq&_nc_oc=AdpBGKB4pZAfkEJ6w_BQwl8KRA_2ihCon7F91V3NN1uaf05LASSNQN6nquyn-pjp7sQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP3yddVpJ3bNBmhsqvCbf4RVGjAVtp5-YFrEG55Ixp4g&oe=6AC500C5"}, {"file_name": "grapho-xr-ovr-demo-screenshot5.png", "id": "1686004475380457", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003268_1686004478713790_8466601274807976636_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDtO5JCOMe0Q7kNvwHslBT9&_nc_oc=AdpvddfXViQK8QU57PlluPR1ZRKvqRnEhF-EY5VwRWMcy1W6kJ7QBjmy0G7LQQLiV24&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSeaGkRuJwvlZPU3U_5UM1GS3iRnuy053c8IUJmLj8dQ&oe=6AC4F981"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grapho XR Demo", "keywords": [], "long_description": "Grapho XR is a spatial graph visualisation tool and a new way to manage and present graph data.\n\nIt\u2019s an interactive experience that feels like Minority Report meets 60 Minutes. Grapho provides flexibility to switch between data sets and between visual themes, ensuring the look is right for your audience. Display and take control of your data. Share knowledge in a hands-on intuitive way. Use it on-set as an interactive in-camera VFX solution.\n\nSee also\n\nhttps://docs.grapho.app/#grapho-xr\n{839084764896338}", "short_description": "Grapho XR Demo is a spatial graph visualisation tool and a new way to manage and present graph data.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mod.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mod", "support_website_url": "https://docs.grapho.app/",
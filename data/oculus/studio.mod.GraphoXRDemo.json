cdn.com&_nc_ss=7f20f&oh=00_AQGLRmnJCQluukUZDUTQ9cAmJLA9aGost1YEc5t-yLPhtg&oe=6A8C4671"}, {"file_name": "grapho-xr-ovr-demo-screenshot4.png", "id": "3959625570975931", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/468726059_3959625577642597_1886134438474685898_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ex3eONPU5TUQ7kNvwHLJU3T&_nc_oc=Adp1Rkqh8jD7PI5bhnu23RukFnU6w2zZ5ORiPxAO-IO7e2eAh0x5KnNbUxMCzd3PkbY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4zyEoantgsMS7FQU0tY0eAJzXcZR1DeKr0P7HsQYZNw&oe=6A8C1805"}, {"file_name": "grapho-xr-ovr-demo-screenshot5.png", "id": "1686004475380457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003268_1686004478713790_8466601274807976636_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gYeLu85t0QQ7kNvwFcH5lu&_nc_oc=AdolHmi33QQra75qYBC0L3KzAFaqgIU3Pnb9VKe87z_hfLLFmPpYhYdYOyoDOkeZxBM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHd9tOL25OKflv-wj10wnsIWKu0nuMhj4ikP6Ly9y8NZw&oe=6A8C4901"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grapho XR Demo", "keywords": [], "long_description": "Grapho XR is a spatial graph visualisation tool and a new way to manage and present graph data.\n\nIt\u2019s an interactive experience that feels like Minority Report meets 60 Minutes. Grapho provides flexibility to switch between data sets and between visual themes, ensuring the look is right for your audience. Display and take control of your data. Share knowledge in a hands-on intuitive way. Use it on-set as an interactive in-camera VFX solution.\n\nSee also\n\nhttps://docs.grapho.app/#grapho-xr\n{839084764896338}", "short_description": "Grapho XR Demo is a spatial graph visualisation tool and a new way to manage and present graph data.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mod.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mod", "support_website_url": "https://docs.grapho.app/",
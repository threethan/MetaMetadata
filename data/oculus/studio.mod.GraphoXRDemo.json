cdn.com&_nc_ss=7f20f&oh=00_Af1D1nXb70c5lLd7MrV2RqurIf9IgR6W_qoS8FXITMFpSA&oe=69F74CF1"}, {"file_name": "grapho-xr-ovr-demo-screenshot4.png", "id": "3959625570975931", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/468726059_3959625577642597_1886134438474685898_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kokl65vLRHMQ7kNvwHEqDTz&_nc_oc=AdqGuzNflhNdX1SIcJa3h1G1SvyCdlF7qp5gS490Ur7EbgxQ39I8brnEzuhcBd7J7wo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2v4CpPdo0a3ULJADfEy_PnRBEhATwUnnez0E99wZv1mQ&oe=69F756C5"}, {"file_name": "grapho-xr-ovr-demo-screenshot5.png", "id": "1686004475380457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003268_1686004478713790_8466601274807976636_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpctC1yFwa0Q7kNvwG39rWr&_nc_oc=AdoyXgmM3hIUXSjAbwK6ilpLd2M9CjJEdQKJ9vFgtpPsZE-5yXgQmzWfF1JfXF3Od1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1KkJiyMCPPV4na7oW5oLp5TAkFGuTfb5HluMBJtYg-iQ&oe=69F74F81"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grapho XR Demo", "keywords": [], "long_description": "Grapho XR is a spatial graph visualisation tool and a new way to manage and present graph data.\n\nIt\u2019s an interactive experience that feels like Minority Report meets 60 Minutes. Grapho provides flexibility to switch between data sets and between visual themes, ensuring the look is right for your audience. Display and take control of your data. Share knowledge in a hands-on intuitive way. Use it on-set as an interactive in-camera VFX solution.\n\nSee also\n\nhttps://docs.grapho.app/#grapho-xr\n{839084764896338}", "short_description": "Grapho XR Demo is a spatial graph visualisation tool and a new way to manage and present graph data.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mod.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mod", "support_website_url": "https://docs.grapho.app/",
cdn.com&_nc_ss=7f20f&oh=00_AQDBo42W786Oai7kh5XV5DF_-b1kRcV049jkW6HGABd_rw&oe=6A4A5B71"}, {"file_name": "grapho-xr-ovr-demo-screenshot4.png", "id": "3959625570975931", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/468726059_3959625577642597_1886134438474685898_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjO5zhvIhkQQ7kNvwGFhh97&_nc_oc=AdqKmZ3k6eoXWAwMW2SQOEgG_DrQTGYH9y26U-Dn3pbu_m0XSxVR2OanrCUYLxGa4WU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfnKcTIL05CHx5_bkFzoDg0BrqRkQBLzQwA_Jh2nvZiQ&oe=6A4A6545"}, {"file_name": "grapho-xr-ovr-demo-screenshot5.png", "id": "1686004475380457", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003268_1686004478713790_8466601274807976636_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMusySp-fRYQ7kNvwHg5MTq&_nc_oc=AdrV-Uy3bQ7MERPWKC1IFrM8v5OscR9UtmTIDQ6o0wQ8S5uQSp5rh0mkXPH4EJdZEdg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqdOdICZFp-zEGtUJribrDkLoaE2iw9pPJBTLXSHYX3w&oe=6A4A5E01"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grapho XR Demo", "keywords": [], "long_description": "Grapho XR is a spatial graph visualisation tool and a new way to manage and present graph data.\n\nIt\u2019s an interactive experience that feels like Minority Report meets 60 Minutes. Grapho provides flexibility to switch between data sets and between visual themes, ensuring the look is right for your audience. Display and take control of your data. Share knowledge in a hands-on intuitive way. Use it on-set as an interactive in-camera VFX solution.\n\nSee also\n\nhttps://docs.grapho.app/#grapho-xr\n{839084764896338}", "short_description": "Grapho XR Demo is a spatial graph visualisation tool and a new way to manage and present graph data.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mod.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mod", "support_website_url": "https://docs.grapho.app/",
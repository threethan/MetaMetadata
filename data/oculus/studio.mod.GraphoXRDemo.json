yWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9765613903465624", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27748097458123993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "384398711366751"}]}, "change_log": "* Added download progress bars when downloading API data\n* Updated pointer visuals for clarity when hovering over graph handles and nodes\n* New distance control system - press TRIGGER while hovering over a graph handle or graph node to toggle open & close\n* New force pull system - press and hold TRIGGER or GRAB while hovering over a graph handle or graph node to force pull. If holding GRAB you \"auto grab\" the object once it reaches you. This is a simplified mechanic for triggering force pull along the original \"flick\" mechanic which is still available.\n* General performance and bug fixes\n", "created_date": 1753248033, "id": "25070147915918974", "version": "2.2", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9765613903465624", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27748097458123993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1747722390, "id": "24571565652443872", "version": "2.1", "version_code": 12, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "view
cdn.com&_nc_ss=7f20f&oh=00_Af7D_FB-FB3HbVpub-Hlw5Di2hOYT3GhAQ9Scr9jgsnAJw&oe=6A008771"}, {"file_name": "grapho-xr-ovr-demo-screenshot4.png", "id": "3959625570975931", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/468726059_3959625577642597_1886134438474685898_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hsfr_-cyYE0Q7kNvwGrNYji&_nc_oc=AdoFY-9J4X8z2I1UltKToaqVesT4JlOOKIReFlcH5Lp4xRUV0E3kDoiUwlfjtJ2RM4c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NyC-uDcX36CePSqQguyhkcZYa2VdYQjEXqX8fS3_rXg&oe=6A009145"}, {"file_name": "grapho-xr-ovr-demo-screenshot5.png", "id": "1686004475380457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003268_1686004478713790_8466601274807976636_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1N13wbdxPvUQ7kNvwEM2JC1&_nc_oc=Adq1nGDg_1f4sRI-sNpuD4Q0N4XrRfHbrmZLyOJlut9dVQ-jyvQvmpdq0yADELKjbL0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z4S50fGce6aw6hH61CZMKozy94PZ-0Bg9BO-ZWrS4-Q&oe=6A008A01"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grapho XR Demo", "keywords": [], "long_description": "Grapho XR is a spatial graph visualisation tool and a new way to manage and present graph data.\n\nIt\u2019s an interactive experience that feels like Minority Report meets 60 Minutes. Grapho provides flexibility to switch between data sets and between visual themes, ensuring the look is right for your audience. Display and take control of your data. Share knowledge in a hands-on intuitive way. Use it on-set as an interactive in-camera VFX solution.\n\nSee also\n\nhttps://docs.grapho.app/#grapho-xr\n{839084764896338}", "short_description": "Grapho XR Demo is a spatial graph visualisation tool and a new way to manage and present graph data.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mod.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mod", "support_website_url": "https://docs.grapho.app/",
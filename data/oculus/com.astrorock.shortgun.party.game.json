nc_oc=AdqAY9BWohTOfYkfvzvSMRl3t97g_b6aA22k2bP8OmzLjBmFTEhr9Mln6xNLyTD2d_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQR_ck5IqggJT3AaIDh2QNeYE0bV9rsP9KelW1kyM1_1g&oe=6B0D9E8D"}, {"file_name": "SS5.png", "id": "2018287992165582", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620530_2018287995498915_1227911702152147295_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2bTf2NPJ5EQ7kNvwFMUgpj&_nc_oc=Adq81DQSTLgoiq607OK40TmiZiSC5hDBxcYnNX6gvYVS7HFDHjE7fyfIcuIxUevoE_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRGCd0xgRaCtwc5P_RViWQkbInEQTB1dgM6rfDfzdIWYg&oe=6B0DA46E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shotgun Party: Mixed Reality Zombies", "keywords": ["Zombies", "Guns", "Shooting", "Katana", "Survival"], "long_description": "# Killing Zombies Never Felt Better\n\n**Shotgun Party** is a mixed reality zombie survival game about killing Zombies.\n \n**HAND-LOAD EVERY SHELL. Pull your shotgun from your left shoulder and feed shells in by hand!**\n\n{1099027506343450}\n\n**SLICE THEM LIKE BUTTER. Draw your katana from your right shoulder and take off heads**\n\n{1789859202221739}\n\n**LIGHT THE CANNON. Place it on your floor, aim the barrel, wait out the 5-second fuse and blow the horde apart. Pretty sure it was stolen from a museum** \n{1799911087780149}\n\n# FEATURES\n- Your room is the arena: zombies use your walls, floor, doors and furniture\n- Grab a shotgun from your left shoulder and a sword from your right\n- Feed shells into the shotgun by hand\n- Place a cannon on your floor, aim the barrel, wait out the 5-second fuse and blow the horde apart\n- Shoot off limbs and slice off heads, then grab a severed arm and throw it\n- Walkers, Runners and hulking Brutes\n- Glowing ammo you can spot through walls\n- Health bar on your wrist, \n- Slow-mo multi-kills and combo chains\n\n\n", "short_description": "Zombies are breaking through your real walls, doors and floor. Shotgun Party is a free mixed reality zombie shooter for Quest 3 and 3S: grab the shotgun off your shoulder, draw your katana, aim the cannon and blow the horde apart in your own room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://astrorockgames.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Astro Rock Games", "support_website_url": null, "website_url": "https://astrorockgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1432501623283684"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627477_1149349377622991_6476079213854096095_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JE0Y1NnGzWgQ7kNvwG2pW82&_nc_oc=AdqUnee_Xx3FBp9qd71bJ1Rb5GoMMxqSmkcs6HCZoLxBZnuLXlzuzPmWcygfdpyaBnI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_fH_xtcDl0x2WNZe63jE_-L12s4LDwVqj16pDEhru4Q&oe=6B0DA8FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shotgun Party: Mixed Reality Zombies", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name"
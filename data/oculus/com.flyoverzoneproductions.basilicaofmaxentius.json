724", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974856_581330912297958_4122475065725943808_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dM1dAQ4XO9MQ7kNvwHD6YVz&_nc_oc=AdoCmOkF36wE1WTPHVJgAC_cOz5dXdDL8dhfSalcJ9uUEBdDOWL1Y2fgeXRxmm4Ni0k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlP1Q-eBTGh0By6VqR4exHbAfSTYW808Murff5LWlo8g&oe=6AA56909"}, {"file_name": "migrated_image.png", "id": "494684121198588", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974892_338557503577789_6562123851151441920_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4wAjYlhT8MQ7kNvwEB9HMw&_nc_oc=Adp1xpRxMSB0XrH6BhaWwXoztRKyTYNM5zjIXyzATDkvX2UWr_NukF7jN3pOnEJY9Yk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSj_5lliG-OZkZ59X90VRAslpwUGA1mLVqQZO1fcVHWQ&oe=6AA56DB1"}, {"file_name": "migrated_image.png", "id": "1297355567141036", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974465_170790393826803_7239535915666767872_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8oWWOudTykQ7kNvwFkiBEE&_nc_oc=AdpPFXpbeI5UkEuNzsah_o6VWNC2qd6-ApSk04HQnQmnbWSLCx4FC_v9Wt_u7GHzarQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK27Hfgvwt-tEI-7oyzZx9gpdJmJp6luRttQOo8Rtzvrg&oe=6AA5619C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rome Reborn: Basilica of Maxentius", "keywords": ["Rome", "Archaeology", "History", "Travel", "Education"], "long_description": "In this fully immersive application that supports free roaming, the Rome Reborn team is proud to host Beth Harris and Steven Zucker of Smarthistory, who present the Basilica of Maxentius and Constantine (also known as the Basilica Nova). \n\nThis was the last monumental civic building built in pre-Christian Rome. With a main entrance off the Via Sacra, it was constructed during the reign of Maxentius as part of a project that included rebuilding the nearby Temple of Venus and Rome. The vast hall (96 meters long and 65 meters wide) is covered by three cross vaults 35 meters high. The walls and floors were covered with marble.  \n\nToday, the building, like the colossal portrait of Constantine, survives only in a very damaged condition. The Rome Reborn team\u2019s digital restoration allows you to re-experience the splendor of the monument as it appeared when new in the fourth century AD.", "short_description": "In this fully immersive application that supports free roaming, the Rome Reborn team is proud to host Beth Harris and Steven Zucker of Smarthistory, who present the Basilica of Maxentius and Constantine (also known as the Basilica Nova)."}]}, "developer_name": "Vector VR, LLC", "developer_privacy_policy_url": "https://www.flyoverzone.com/privacy-policy-yorescape/", "developer_terms_of_service_url": "https://www.flyoverzone.com/privacy-policy-yorescape/", "publisher_name": "Flyover Zone Productions", "support_website_url": "https://www.flyoverzone.com/contact/", "website_url": "https://www.flyoverzone.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "582196460539382"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974704_2372436112773763_6325272214551658496_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAP-aDdJhl4Q7kNvwEVWQXl&_nc_oc=AdrHEQ0Pu-BQ6lbocyZ79VFaYStaw_CnfF_rYzLbtaYxtEwX6mwCqpfQjh_3PlXgjd8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oc
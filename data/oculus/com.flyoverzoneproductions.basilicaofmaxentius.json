0DzNljlbHHzmAs34aNrBpjaNvbdrESgBbE0StuP5pbpYPZ2Kg2c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJFkBfWLXRBQ2bA7LEpV4FBpF0ceLQbbBn4PjY9FeYEg&oe=6AFF283A"}, {"file_name": "migrated_image.png", "id": "513050716059724", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974856_581330912297958_4122475065725943808_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MktPLpqAN2MQ7kNvwEiqjNk&_nc_oc=Adr9xPetHxftEeUu03kDka70ifuWRRZF6S9tdVnCIHsuCFKN4W2iBcnUiEI6bl34dGo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOXWX7NSDF6W4LfWRCmt-fl5EeKN8rFHwBwnIT7zCERQ&oe=6AFF0F09"}, {"file_name": "migrated_image.png", "id": "494684121198588", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974892_338557503577789_6562123851151441920_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yiv1N2hBlEQ7kNvwGfMkBM&_nc_oc=Adq2UfFX79gllb8sbzLkFAxYQgXY07NtpMfu9crY1m-gWaNaI4i7KLw9YrTBwOvqrhw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSODG8Ge8rp7NPxyjb8KWVAHkKSRvv7RcXYZAcahKgY8g&oe=6AFF13B1"}, {"file_name": "migrated_image.png", "id": "1297355567141036", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974465_170790393826803_7239535915666767872_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7r4A6LsRAUQ7kNvwH60yNW&_nc_oc=Adoo1zo29ABrk01AZUYXhHPcPcbtYUxLyQ9narQkeUHnELy0hrOAe3cKON3X9s_Oup4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_08mb4bFvixrUaCMYui6960re370u64uz20g-U00hBQ&oe=6AFF079C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rome Reborn: Basilica of Maxentius", "keywords": ["Rome", "Archaeology", "History", "Travel", "Education"], "long_description": "In this fully immersive application that supports free roaming, the Rome Reborn team is proud to host Beth Harris and Steven Zucker of Smarthistory, who present the Basilica of Maxentius and Constantine (also known as the Basilica Nova). \n\nThis was the last monumental civic building built in pre-Christian Rome. With a main entrance off the Via Sacra, it was constructed during the reign of Maxentius as part of a project that included rebuilding the nearby Temple of Venus and Rome. The vast hall (96 meters long and 65 meters wide) is covered by three cross vaults 35 meters high. The walls and floors were covered with marble.  \n\nToday, the building, like the colossal portrait of Constantine, survives only in a very damaged condition. The Rome Reborn team\u2019s digital restoration allows you to re-experience the splendor of the monument as it appeared when new in the fourth century AD.", "short_description": "In this fully immersive application that supports free roaming, the Rome Reborn team is proud to host Beth Harris and Steven Zucker of Smarthistory, who present the Basilica of Maxentius and Constantine (also known as the Basilica Nova)."}]}, "developer_name": "Vector VR, LLC", "developer_privacy_policy_url": "https://www.flyoverzone.com/privacy-policy-yorescape/", "developer_terms_of_service_url": "https://www.flyoverzone.com/privacy-policy-yorescape/", "publisher_name": "Flyover Zone Productions", "support_website_url": "https://www.flyoverzone.com/contact/", "website_url": "https://www.flyoverzone.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "582196460539382"}, "review_messages": []}]}, "cover_square_image"
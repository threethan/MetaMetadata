724", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974856_581330912297958_4122475065725943808_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1CyeItHx7wQ7kNvwHc1e4D&_nc_oc=Adpft6suU1c4FofWsKAtzeMK-ZbnQadUltkAVty0V8ghlJ_2DctYGew_OJnewTpPGLM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKAotSbNc5hJOcyGZW2dFjv7_Xf6D6UIuqmGVyX-oPeg&oe=69D0EF49"}, {"file_name": "migrated_image.png", "id": "494684121198588", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974892_338557503577789_6562123851151441920_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rv47ygSb5bIQ7kNvwFC_R48&_nc_oc=AdrbjLIiw469VPBAaMf9N02sVnA_4yYJvEoaolo3TGsZW8CmXU_WphPOQxvScR6RPuQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEUXdZy8bBG56WTD1zBoUslrBV7CjJWwumI8-t-3znfQ&oe=69D0F3F1"}, {"file_name": "migrated_image.png", "id": "1297355567141036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974465_170790393826803_7239535915666767872_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Iue3BKcIc8Q7kNvwE3dKiQ&_nc_oc=AdpUU2hnescOjz6cPkT6nChDh7JmpxE9y1zq8qXsNGI8jR235icEfZx7kojpPZnUuGw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYErVpAQCbDAwguZeJZMfSNLqHWqERYEDQde3TJpY3Gw&oe=69D1201C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rome Reborn: Basilica of Maxentius", "keywords": ["Rome", "Archaeology", "History", "Travel", "Education"], "long_description": "In this fully immersive application that supports free roaming, the Rome Reborn team is proud to host Beth Harris and Steven Zucker of Smarthistory, who present the Basilica of Maxentius and Constantine (also known as the Basilica Nova). \n\nThis was the last monumental civic building built in pre-Christian Rome. With a main entrance off the Via Sacra, it was constructed during the reign of Maxentius as part of a project that included rebuilding the nearby Temple of Venus and Rome. The vast hall (96 meters long and 65 meters wide) is covered by three cross vaults 35 meters high. The walls and floors were covered with marble.  \n\nToday, the building, like the colossal portrait of Constantine, survives only in a very damaged condition. The Rome Reborn team\u2019s digital restoration allows you to re-experience the splendor of the monument as it appeared when new in the fourth century AD.", "short_description": "In this fully immersive application that supports free roaming, the Rome Reborn team is proud to host Beth Harris and Steven Zucker of Smarthistory, who present the Basilica of Maxentius and Constantine (also known as the Basilica Nova)."}]}, "developer_name": "Vector VR, LLC", "developer_privacy_policy_url": "https://www.flyoverzone.com/privacy-policy-yorescape/", "developer_terms_of_service_url": "https://www.flyoverzone.com/privacy-policy-yorescape/", "publisher_name": "Flyover Zone Productions", "support_website_url": "https://www.flyoverzone.com/contact/", "website_url": "https://www.flyoverzone.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "582196460539382"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974704_2372436112773763_6325272214551658496_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPME7uzI-HsQ7kNvwFVJGq5&_nc_oc=Adp77a1c4JgSh9cSIM87Z1Mqehm-pWCH8GPunaSGGqwAa-GRMCdMRyHZe1o-Jbwz13E&_nc_zt=3&_nc_ht=scontent-ams2-1.oc
W37gRX_uWjvyM_tBZBtDemT3vdTiIWp_pChcxvV0AMByzPnl-J8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR43nagB54PueH3ql_1kqbnkYmJhvsW_fUs_Mn7bC3Bsg&oe=6B0862BA"}, {"file_name": "migrated_image.png", "id": "513050716059724", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974856_581330912297958_4122475065725943808_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJ-el_VFOpkQ7kNvwGCb4rP&_nc_oc=AdpOaPxa1tVZQl05tHTGyH-X_JDa-tS0WTH9kWidaNp01Bh3d-z8Nmq8PXOq5_HRCqk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzHTEzMjHGXxFZRbbTQ3Bi8vgXBNw7bwefMiwrOpBWKA&oe=6B084989"}, {"file_name": "migrated_image.png", "id": "494684121198588", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974892_338557503577789_6562123851151441920_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ta4sQQirvEkQ7kNvwGzSGI9&_nc_oc=AdpNjl8RYu79O3CdEGEPFsIAKubNwR6XiVHO9QEC6fJ_NwqklZ_QdOgYoh2aTCzULww&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx4xmKnvxp7MRdN_bzI7f30WHFjajrSW9JF2K42P5-SQ&oe=6B084E31"}, {"file_name": "migrated_image.png", "id": "1297355567141036", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974465_170790393826803_7239535915666767872_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6r-8_MznEIQ7kNvwEsnxgw&_nc_oc=AdrMKTqYYkRyWzhZFqUyCzEg6AuNJ7Wj3l_N6wnjt4l_Ju3yQ6aWMVDSueWncmiFHMs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS41riN52WkX2p6oaStOLWm9I0lFD-s7E58Za7iqHH1pg&oe=6B08421C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rome Reborn: Basilica of Maxentius", "keywords": ["Rome", "Archaeology", "History", "Travel", "Education"], "long_description": "In this fully immersive application that supports free roaming, the Rome Reborn team is proud to host Beth Harris and Steven Zucker of Smarthistory, who present the Basilica of Maxentius and Constantine (also known as the Basilica Nova). \n\nThis was the last monumental civic building built in pre-Christian Rome. With a main entrance off the Via Sacra, it was constructed during the reign of Maxentius as part of a project that included rebuilding the nearby Temple of Venus and Rome. The vast hall (96 meters long and 65 meters wide) is covered by three cross vaults 35 meters high. The walls and floors were covered with marble.  \n\nToday, the building, like the colossal portrait of Constantine, survives only in a very damaged condition. The Rome Reborn team\u2019s digital restoration allows you to re-experience the splendor of the monument as it appeared when new in the fourth century AD.", "short_description": "In this fully immersive application that supports free roaming, the Rome Reborn team is proud to host Beth Harris and Steven Zucker of Smarthistory, who present the Basilica of Maxentius and Constantine (also known as the Basilica Nova)."}]}, "developer_name": "Vector VR, LLC", "developer_privacy_policy_url": "https://www.flyoverzone.com/privacy-policy-yorescape/", "developer_terms_of_service_url": "https://www.flyoverzone.com/privacy-policy-yorescape/", "publisher_name": "Flyover Zone Productions", "support_website_url": "https://www.flyoverzone.com/contact/", "website_url": "https://www.flyoverzone.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "582196460539382"}, "review_messages": []}]}, "cover_square_image"
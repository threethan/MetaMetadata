_nc_ss=7f20f&oh=00_AQRZdbhG9L7iRtfU3XRRQX_NYl_SL49V8fggPX1U979cDg&oe=6AFDBD89"}, {"file_name": "migrated_image.png", "id": "2752999454750043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974892_338557503577789_6562123851151441920_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwblUFssNecQ7kNvwEH1Mly&_nc_oc=AdqGl5MauxwESqPRsHDgDa5e4mxTX8W0n4BhhdB3TEPlkFnPOxrzMXPpz0C32ZPdcvI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGOCIBFND8ta0Le-nGx2AonKiZiT-BJ_2mNil5v2WzKQ&oe=6AFDC231"}, {"file_name": "migrated_image.png", "id": "625533951560068", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974465_170790393826803_7239535915666767872_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XJP6RbjarMQ7kNvwH74Niz&_nc_oc=AdqAbjswK5-7E0Ovg-FJv2U7YdKuglxpKOScnY21-avUTHtXH0g3y_slD4v6ZCx0__Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKoJ7YqY0umZPdPviXI-4ediMXc4Qrk3sXlhLJiGwW2A&oe=6AFDB61C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rome Reborn: The Basilica of Maxentius", "keywords": ["Rome", "Archaeology", "History", "Travel", "Education"], "long_description": "In this fully immersive application that supports free roaming, the Rome Reborn team is proud to host Beth Harris and Steven Zucker of Smarthistory, who present the Basilica of Maxentius and Constantine (also known as the Basilica Nova). \n\nThis was the last monumental civic building built in pre-Christian Rome. With a main entrance off the Via Sacra, it was constructed during the reign of Maxentius as part of a project that included rebuilding the nearby Temple of Venus and Rome. The vast hall (96 meters long and 65 meters wide) is covered by three cross vaults 35 meters high. The walls and floors were covered with marble.  \n\nToday, the building, like the colossal portrait of Constantine, survives only in a very damaged condition. The Rome Reborn team\u2019s digital restoration allows you to re-experience the splendor of the monument as it appeared when new in the fourth century AD.", "short_description": "In this fully immersive application that supports free roaming, the Rome Reborn team is proud to host Beth Harris and Steven Zucker of Smarthistory, who present the Basilica of Maxentius and Constantine (also known as the Basilica Nova)."}]}, "developer_name": "Vector VR, LLC", "developer_privacy_policy_url": "http://romereborn.org/privacy", "developer_terms_of_service_url": "http://romereborn.org/terms-and-conditions", "publisher_name": "Flyover Zone Productions", "support_website_url": null, "website_url": "http://romereborn.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "337978798054299"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "623234318215748"}, {"status": "PUBLISHED", "id": "2056858631045492"}]}, "baseline_offer": {"id": "2056858631045492"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1577250000, "status": "PUBLISHED", "id": "623234318215748"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1990318707722213", "version": "1.0.2"}, "id": "2283255525021388", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__ty
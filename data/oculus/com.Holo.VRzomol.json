ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oToYgjU4B1UQ7kNvwEveUZ5&_nc_oc=Ados8xYEMk2nZBQhwpjV7qbzSaJBYQ9opTF-TyiDLmrPwTa55IdeDDDKeZG7dg7TVzA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvAIgDafSLHXLQ22gMfSyA_nvhYDEeUZKFD8mbLWHMmw&oe=6B0B11D5"}, {"file_name": "3.png", "id": "425621870050920", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984459_425621873384253_5444166115704050078_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xqGrB74tfIQ7kNvwEDA2no&_nc_oc=AdpKGfnX0QCZXYqaM216ohL31zyBnStoTCuW9_Jg16aPsSuN4LqGGbkwvrc6tQMspqQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRlq3bsxCVOk3MqJrky1FvEoobgNGwEv6YJnBJUCnxjJQ&oe=6B0B195D"}, {"file_name": "1.png", "id": "1135274944267833", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572936_1135274947601166_7513787693106153823_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JF995fWKftAQ7kNvwGqTu5D&_nc_oc=AdrsPMfR0WmKQN9jTqp6PXwO-RUPg9_kEPh90cl_NhboXth_h68OdmioNiFFm3EC7zA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTmWE1E9JmCcTl9Jqi66Ae3TqQpefs0eB6eFZOIm4hhrg&oe=6B0B27DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "1087976862503576", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75588060_1087976869170242_8690834638362885484_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oCE7uigVssQ7kNvwGNLb6L&_nc_oc=AdqvQjzchXdjnpm78-uEmSuBE9tF5vcd8MbvmKMHjQyQD_Vc99gGaEFnKP01nPkBH3E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8XRisVoc1PaawYomG1fEe6r0PrGwoOcX6nGlZflrZFw&oe=6B0B1D00"}, "display_name": "VRzomOL", "keywords": [], "long_description": "The VRzomOl is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrdanceyinsi.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": "https://www.bilibili.com/video/BV1JC4y1n7Uq/?spm_id_from=333.999.0.0&vd_source=f44d7fafb67bf1b4c28885f69f021585", "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "8149325901748851"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1299754398166903"}, {"status": "PUBLISHED", "id": "973
6047", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031330_2149338838769380_1342380476848011217_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0MctOSj7BQQ7kNvwHOQQhh&_nc_oc=Adn1nRJcpNPUf7ZSnMeGriVUfxv__EnYi37ASViHmPXCEKrZG4YMgYsudcn7LB705SI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft-EiWD6WOZPMJnB7bohvgbBcey2rdKeJ9FG-HL74SO4w&oe=69A19E95"}, {"file_name": "3.png", "id": "425621870050920", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38984459_425621873384253_5444166115704050078_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTQ5fM05ap8Q7kNvwE4RxaB&_nc_oc=AdnwjSiumOzBcHERSxHpqVw-gonC1KyChL6UWul_d2-rzYBa72U8tKPvAgtFXVR8SoI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsXNyhi9rURScFGVGTjWHGGW6f4EznlTccacueV9E9Cxw&oe=69A1A61D"}, {"file_name": "1.png", "id": "1135274944267833", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/57572936_1135274947601166_7513787693106153823_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_pqkcJV6n8Q7kNvwHeQ8Q6&_nc_oc=Adnjpm_j-c9oOXrkUB9MYc-SOzrwCSXDAxnQ0AYNrfzhFYaa9ifvD2jdDrXp44oBUK8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftQcS1RrMy4h-PExCipN6qb7Q9CyS6M9MeA-Y9jOe7jYg&oe=69A17C5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "1087976862503576", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75588060_1087976869170242_8690834638362885484_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaWriSzvBPAQ7kNvwEtTWBy&_nc_oc=AdnpNBXqByaSk1WjwLYJNfk9sd-LdS-mwfYtJNWIl2SNT2xNe8Y8SUrMuBI5JntM7R0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftOcbkeQ27MDHhVNI9tVeomF3W9bTVrX-nivQbkDG_2fA&oe=69A1A9C0"}, "display_name": "VRzomOL", "keywords": [], "long_description": "The VRzomOl is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrdanceyinsi.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Holoren", "support_website_url": null, "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26736553699266123"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75395597_1141833577010956_6472850014483885218_n.png?stp=dst-png_s360x360&_nc_c
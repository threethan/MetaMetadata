6047", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031330_2149338838769380_1342380476848011217_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0MctOSj7BQQ7kNvwG0sDxx&_nc_oc=AdnhNO1K7B5NcOO_At9pzyvwhVZZ5BOJsJVObcmlO3EWcntWSyV7V2j3RohpUydPlWA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuxOJPp4n7zPgIclAmT-5ffongO98Ns-xL_71759ujQhg&oe=69A2F015"}, {"file_name": "3.png", "id": "425621870050920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984459_425621873384253_5444166115704050078_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTQ5fM05ap8Q7kNvwGIuVwz&_nc_oc=AdmI65Ul57HZpaZAu2H4fhoIYAy7B8EJRIYnZQn0wSuuiJiOInNtutcIUB8OGpyUoPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuEsA-vw-3EfrsSBYsRq9acM0t61CBtzMHpIua2f_-cNQ&oe=69A2F79D"}, {"file_name": "1.png", "id": "1135274944267833", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572936_1135274947601166_7513787693106153823_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQRg7GIEIjMQ7kNvwGv2P-1&_nc_oc=Adk9mTsIIKC5sVWsEY35T__v3pBfh-ia2yTUziwlC8uwJxwO8YUHtv5hOvf_JQKN4WU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftrphdjyKI8CV12BUYdNiwYHgEeqpYswCwO3xTxrtzvtg&oe=69A2CDDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "1087976862503576", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75588060_1087976869170242_8690834638362885484_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaWriSzvBPAQ7kNvwE61uSJ&_nc_oc=AdlKTKLpaHboACHgfSb1Oggvxsn5ZlQb7vF_u3j6Bmh609xA7S6HlPEUUu0aqQfZ-eE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvj8SDAq1DMcW7xaB9SqiJKbwKKkLPCaKr2Uxo4vXVSDw&oe=69A2FB40"}, "display_name": "VRzomOL", "keywords": [], "long_description": "The VRzomOl is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrdanceyinsi.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Holoren", "support_website_url": null, "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26736553699266123"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395597_1141833577010956_6472850014483885218_n.png?stp=dst-png_s360x360&_nc_c
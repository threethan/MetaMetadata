23_15-47-46.png", "id": "1604751663662282", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974777_1604751666995615_2285144112468674279_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9N5d6t6Wl08Q7kNvwGuDxOj&_nc_oc=AdpYmkhfSLq1fdIn35ESvj_ixOcMEmizHxDKbNbCvwq8HKeaoy9XKEV7jyAiWV_0Xac&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2F638mHhT0rT-n9ea0iUpD2mr4D5mxAG4nVwU1ZM53w&oe=6AFC6BB5"}, {"file_name": "The Monke Den_Custom..._28.10.2023_21-41-04.png", "id": "3180314478940617", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974800_3180314485607283_4765689194169736487_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFkpmhm9nywQ7kNvwGc6MHb&_nc_oc=AdrEh7RgPTj47hskmZOucnj7yE6xpmTBP_UNlTlA7AXDANmKT3e0e-3Ii0Ix-NhmrIQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVuc4B2Oq4brJq8UeIBgqOPIfZ9578FfN-RRkFdmJzXQ&oe=6AFC7CF1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Monke Den", "keywords": [], "long_description": "The Monke Den is a game based off of Gorilla Tag. You can play with your friends or meet new friends. There are a handful of maps to play in such as a Forest map, a Maze map, an Obstacle Course and more to come soon. Hope you enjoy the game and remember to reject humanity and always BE MONKE!!!!! I'm TrooperVR, I am a Gorilla Tag player and lover. I create content to put out onto TikTok and YouTube, I have recently been making a hobby of developing Gorilla Tag fan games, but over time I have failed over and over again. But I believe that I can make this game work and keep moving forward, my inspiration is Cebus, Monkeys Realm, Capuchin, Monkeys Place, Samango, Monk and Cube Runners. I hope you enjoy The Monke Den.", "short_description": "The Monke Den is a game based off of Gorilla Tag. You can play with your friends or meet new ones. I hope you enjoy the game and remember to reject humanity and always BE MONKE!!!!!"}]}, "developer_name": "TrooperVR", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/bc67117d-fa26-42b0-bf66-16ecef188bad", "developer_terms_of_service_url": null, "publisher_name": "TrooperVR", "support_website_url": null, "website_url": "https://sites.google.com/view/themonkeden/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6974635239262085"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9358660014192917", "version": "1.7.9"}, "id": "231920222906446", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6905513376174272", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9358660014192917"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "231920222906446"}]}, "change_log": null, "created_date": 1738710424, "id": "9358660014192917", "version": "1.7.9", "version_code": 179, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_f
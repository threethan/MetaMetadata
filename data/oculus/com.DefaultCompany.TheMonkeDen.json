283_4765689194169736487_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cEW5RZANuQQ7kNvwGdyZr1&_nc_oc=Adr7zMDDqLBsLbx6eKqqE0w6Pn74N6icY4vZeAcO6ujSd_70YJKoutXdoCIiEJnbE6I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8xHhiEnaHW5t7zTuYjIEKPXrBL1QKIr_QexA7UCZODA&oe=6AF9D9F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Monke Den", "keywords": [], "long_description": "The Monke Den is a game based off of Gorilla Tag. You can play with your friends or meet new friends. There are a handful of maps to play in such as a Forest map, a Maze map, an Obstacle Course and more to come soon. Hope you enjoy the game and remember to reject humanity and always BE MONKE!!!!! I'm TrooperVR, I am a Gorilla Tag player and lover. I create content to put out onto TikTok and YouTube, I have recently been making a hobby of developing Gorilla Tag fan games, but over time I have failed over and over again. But I believe that I can make this game work and keep moving forward, my inspiration is Cebus, Monkeys Realm, Capuchin, Monkeys Place, Samango, Monk and Cube Runners. I hope you enjoy The Monke Den.", "short_description": "The Monke Den is a game based off of Gorilla Tag. You can play with your friends or meet new ones. I hope you enjoy the game and remember to reject humanity and always BE MONKE!!!!!"}]}, "developer_name": "TrooperVR", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/bc67117d-fa26-42b0-bf66-16ecef188bad", "developer_terms_of_service_url": null, "publisher_name": "TrooperVR", "support_website_url": null, "website_url": "https://sites.google.com/view/themonkeden/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT
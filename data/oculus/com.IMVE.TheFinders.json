10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7zicFqrs1MQ7kNvwFfbdqz&_nc_oc=AdoLAncH7vZ7Kms2MmbPEN319lMHtNikokz6srMxonioeXBHVg0eN7g44oa1217jmkk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vs8OXw0Ooikl16_HRm-Ncf8ptNwClTukAIyGbtKuLSg&oe=69ECCECC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BULwt8gs6VwQ7kNvwFUz5Ym&_nc_oc=AdqIPKiswttDGuRhPee8wCxT_g2ObGIrYNpEKprBzcRw4qQW7Ta1FKYOrMbhCejSQr0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HXT3jFRSn95Y43xHvENW318Pu8GIdholJClDuEuH8tg&oe=69ECA77C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDoQjBSt_YUQ7kNvwH9ETkn&_nc_oc=AdqkniLqUAlgnBNckOvvWlpVxH7wniOguRw4M6tU-ELOl1RO6m5nyMw3rOsETxcFwsk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DihW9nloCzlPBhSFKmExtmILh-ypgnTdSEOWGHWlncQ&oe=69ECBEAB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
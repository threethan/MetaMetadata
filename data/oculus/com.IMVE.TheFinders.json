10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mafXBqDx_IQ7kNvwHbDv3s&_nc_oc=AdoXotxFcUqy5RV-Bh35MQpuKUAMqI8keEXan72SO5WyRZcSRZYNFdBpiPIAypRi1aU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u6Ul2Mh5ELSrhSTSggCyVKpBU7QiX37d7T5VFSbRk1w&oe=6A2D684C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9AUPL144dkQ7kNvwF_ko5N&_nc_oc=AdpSTWhW8SNlzCEUDbwRqwbR7MmdwmvJPVYO_nSDuYPG3LgquSz3rbpC1c8tdHYTdDU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fly5Pqmck6B3qtuhwsHlmehAoNayQDE7ruvPmalqZhA&oe=6A2D793C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4Rd1YI6nwMQ7kNvwGHVmQi&_nc_oc=Adpcel0t0RswCr4aKRIcRNPRH8_3lPYt2vDlkzbst3qjlQiaHuI9bNk9XVLUQbc9IxI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vJL8gTj0CNc0uObywS68wZAua69qmSPIqQ3Q5edf12A&oe=6A2D582B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqwBxtOdlWsQ7kNvwFjEpGj&_nc_oc=AdoUoBAurVYiHFw6g1v7bLPvfXjwhxfcPG6O31301Uq4s1m5g4LJdtVVUH1GUd7friI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMQUFx6-Zh6XomCqJ_sCyChxUmQZsL46iE9Hvq2XEVig&oe=6A89790C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRef6lHjw0QQ7kNvwEQtfVV&_nc_oc=AdrAI2VWrBLwdPGotNX1IWEjw3fZVs24DH_32HKtmtDe_Sb_QUeDV-XONFBGoQck_Iw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFU-ZZMSvH2JyrUVOigZCwxqAsjmtQySul5A4wceyIpXw&oe=6A8989FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0Lz0cJwMO0Q7kNvwFA26XH&_nc_oc=AdoOvm9w9F7iH0mhQ9tS2O_4z1agA6QBz4w65MaXgqbpG2r63D3qacGqf9SVLWFD8KY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK5ZPbTAO9kfzfw0f3kU_NB2AX4D1rnNStYBdQYPaTBQ&oe=6A89A12B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HppdMUaExj4Q7kNvwGzchia&_nc_oc=AdpBxjFrRoh3GKrAPHdRbp722APD64aRvPneldoln6J4k3YrnoXa8xT7phrROu7uvto&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7Jwm9HiPF1WIWcIbkzWPRIE1R35X6Z53DPtctF_Hmag&oe=6AAD49CC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndeU_IAS9yEQ7kNvwEHOVP8&_nc_oc=AdoX48VPvGIhpt7Q6-Kv-zUYq6a2wP23_rE7ARKBwTcco2nqc1iNVUai47X07t-0zSo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnRk-Dm5nO_finJEBnPNE82iqEpnyS-IHF-3jeRhmFHg&oe=6AAD5ABC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jriS2bgoQfwQ7kNvwHHnBzE&_nc_oc=AdrnO_g1UgZqntXkZfI01JVuc9LeTAM6JZhncbcksK6w0nnnTl8wCvgFm4lvxXd4tO4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDXnWHa4JaWAYilPLRQnv5WpWBxPIJdgQ8dUXOY_T-tw&oe=6AAD39AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
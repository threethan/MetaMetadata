10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMfOGVtaRTwQ7kNvwG6l12y&_nc_oc=AdqxRfIOT-lXEjIVUo7vBcqvaHIsDPhyxlSPTHOltO14RiKlfrq9gURNBZVxAniOYwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGz753ZqZUzurpThHISnH1WtrnRTlulTFENgBnQbi2oFA&oe=6A7B30CC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aR88c_7k2pUQ7kNvwG80NGH&_nc_oc=AdqfbznPfMId7M2YZW02TfmdzPwRH4n5Zh2NXWWIhauGGOvvUlAVt2A11nrLvK0-uw8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQNApP-A9jekBCdBGQJF1-OLQpADpfyknJ2N2amTOdFw&oe=6A7B097C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_47EhCZrMkQ7kNvwGLQJXb&_nc_oc=AdpTaG0IKOlpU8l9DdeQrHVDvmTJGmNL2tc7uuHxS1gutEoc3iyLkIM4K3s2UQh3lMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElCsU7O-lWf_FfNwzsvSG9ipAVd_aRjuR1MOVlaBIjhA&oe=6A7B20AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaYnH7WmQ0IQ7kNvwFrNXHK&_nc_oc=AdrWY8wnWIP_27ZnK5VJ98s0y6MNnlMSbD5oobIf4X17It6QajlNYS2B52HxmRQHncE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxaU21HbM9apddoX2ZHgKuBW8DVYOn91QUZXqtVRzGckg&oe=69CBD94C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5vDElzlpNYQ7kNvwGgxp5j&_nc_oc=Ado0xUBX7ePD_Jzr5NMTxu4sWX_aZJcxZmGCIK_aZeaNy4ozNu9Kyf62PtJZbmeHf24&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoNCLbefYGKgcYWETsOpS0FbLFZ_yPnm5DzP2MUL3TNw&oe=69CBB1FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCP7QU9C34kQ7kNvwH8MQbB&_nc_oc=AdqyZO4MjwzYWtdRcu7C46p2lwCbqzLbNiVov-v3u9fa7rl6RvWljYxYxJqEG0H9sFY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWlENhiCXhYsXAoUZt4ZMrpgrIsE9tb1d8kigvPnAgIA&oe=69CBC92B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
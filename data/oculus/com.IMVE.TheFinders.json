10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Grdk4MVHKrsQ7kNvwFqF-mT&_nc_oc=AdoVUQ5_RJVtlp5BRyC3EQO4q3oMXiq9dI5r0MIMT3-MtDflNDo5_C72xs6AS4wkH5s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4KHteZmqukLf_l-EtvFJdYdEcftOVIH8kBmI1x1Wz5Q&oe=6A53A3CC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H12Hti50tx0Q7kNvwEVDtxF&_nc_oc=AdpUFWS2w2elCyH9p7Z5Xm-Mxa2eDlKVB63u9eKP4itrCBa-p7mnFZduKnV3w8HLEsc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ8clEoPLF1GcLAMz9pEOYUcx4waPBbpsRTZ4ZP8n_Kw&oe=6A537C7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDM5BGaCiBsQ7kNvwGjfiOt&_nc_oc=AdrNK2n_FqPFDaH5RyP26N4md4yoGMwV2Vuq1hof97tquAas1LROOMhXYEu1D-n59i4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_XxFZ64u7syHh5eUFBrV3chbbYRu1MvmKxC7x8M-DUg&oe=6A5393AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
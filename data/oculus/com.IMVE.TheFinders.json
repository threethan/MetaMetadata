10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0wVrpRWnnUQ7kNvwFi3CGe&_nc_oc=AdquhLAa7BkCRyPrH0QTE5A_ih2Y_RDN45OnDEToRQx6nYgRgqY7sqvEOUAs-rC19FQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HQ-g21taouJDd7-8Qt2IPZfijivujUhp-pIounNqYEQ&oe=69DCFCCC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJVra2tE8sUQ7kNvwE39aDU&_nc_oc=Adqkjj0SXCmLR47l6TQSkzl2WkPFbIxvHfUNLZNf1SNlNpEoOjdOvigCchOjDiPcJYQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ScmSP3kAaz7AjiGCL_95csM0u3W3GCYBbn1cLV6djXA&oe=69DCD57C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIjUifcKdOMQ7kNvwFYtZiX&_nc_oc=Adp2QKG_5cgSEmGgERss05QGje1mAOrYDNTgtQ16FXF2880qB5K0TBuw_pb9-qQGh8M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3P2uH9eFvuoE3-vVC2QRb0Zh1deSrru3e9B3aOWjzH9A&oe=69DCECAB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
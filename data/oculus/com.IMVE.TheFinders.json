10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_gu3rq-HycQ7kNvwH9juSd&_nc_oc=Adq6CXbXUFBOnLgQQKAcR0CMmy3oZuTPlX-cfwSgxzRnhNWjW-kod_M-YnYoEq72v-Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s6xNXJ5I59XR4FOFRrqBCz9kGHMzuFakFsMCquXGyMQ&oe=6A0B214C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0muQvOdB3YQ7kNvwGZgdmQ&_nc_oc=AdpuImD95XPXXjNRU7amJe9M7Xk3IXhbWk0RnEfdGQHvyH6HQNNz7Vhl2irgbljLOE4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XSyFwm_5uVlS8DTAhA03ijLvpiJH7bd_gtk-9u-i2wQ&oe=6A0B323C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmnE2Ry-A_kQ7kNvwEaUzNS&_nc_oc=AdrKivRx6PdNAi4-iX_Mn8VemtDm88jqPOQoKRAhtf_nRVZvAMbtMkmnnzwkjV5mdOQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bXm2kzcXNdjA4ThaeF929wk2UJqX0jXO-JB4c4A6NTQ&oe=6A0B112B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
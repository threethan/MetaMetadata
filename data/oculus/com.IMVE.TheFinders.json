10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcobXLLdbaQQ7kNvwG7gGW4&_nc_oc=AdoT4LDg2r-Wsrg6oPKbY8nQIQxNCYdPBuR7tgGTqTcarfG5LSxemhtgpkk9ucvkhVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGnD3LY-uDdGT1BY8KklT8g-LJUt--OEVbUK1AsbjfLg&oe=6A84330C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EWS788E_UYQ7kNvwE_fR_7&_nc_oc=AdolK3R6uCfhK2sjIti1qiRdlhiqhsJLRIIBOIWXo2WGHG1Q1j1qodixnwTjQeI39ro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-8fs79U7Jn7dI1FtguwIKGHAzliftgF8_Ro7eXtk7rQ&oe=6A8443FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poCqa2uG4dEQ7kNvwHr671K&_nc_oc=AdrQpEx_gS0o63Yag6bGV2HRmAXu4AGVs-fueutAVDkkfvMRkdbLQgG7to8uEZW5lWg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9AamRwSlRxcugfUmkhzspeow7U6HcQCRNQ3sn2ZhSPw&oe=6A845B2B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
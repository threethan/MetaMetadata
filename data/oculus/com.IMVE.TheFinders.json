10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDiBwPE5zyIQ7kNvwGme0Vm&_nc_oc=Ado4GwZL1v_vl7EiR1vv4i_gJXsi9RiiAeIbOKTMhsHr--RR_15k7YBLEE6RIF2iNBA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-6NLNenbqXIucq7J_QSbZ6hnMV5mbv15uC4v1fCzLPg&oe=6A90108C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SY4Gnf8Fj3EQ7kNvwHgFX4S&_nc_oc=Adr6QXRv7J3lbbjh78nWdzGB6dL6MEY2gKaJ4OHAiHpKwNX2L16tEnVTekxzXOyQ5dw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcH0qsadt1h8X3PcSvERGyDXHETZwusRvkbKJJ41QljA&oe=6A90217C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wu1GikqNd9IQ7kNvwG7Sn2R&_nc_oc=Adrj12I43I35oFKKJ4wQ0aiPglIgwMh0TeSwAEUZX41A3qWhhCFeamATOnUNZk4Qu6o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEsH_LdDcDM3iPozyrjAEaOXUBQG__yHXtX6dCtZdmag&oe=6A9038AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGelnSQQipgQ7kNvwFe0Ybu&_nc_oc=Adp7Eurx4_OXgYhAZTUukRWLCNownInfqRv9MmlY0JJyn58psPyt3Lx32ioApurs0ys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdLmb_0WGsfT10W65kmylhjCYyoPRriGWsFPcAv5Q8VA&oe=6ABFBECC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x817gfiYDmkQ7kNvwHACssi&_nc_oc=AdoBGU1acdPoqYwdiz7x94w1QR1vNp0iEHEkyhXVROdMJnK5pma3dA-EXtARuiboTJo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjt9zcac1yqgasRSn6-eaj63TNv_UJSuz7hpBghWODEA&oe=6ABFCFBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vryWJT1OJFAQ7kNvwF7w9Zw&_nc_oc=Ado0bDycb363ZWnvCiE0Iq_Q5tY0DOVT_fxhSrHpDR-dYlXOrv7AcEQriAdCnCT0Vas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ7mDuoqLjH1cU-AutyAaspmEJKM2ZRSkn36hzfk1q6w&oe=6ABFAEAB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
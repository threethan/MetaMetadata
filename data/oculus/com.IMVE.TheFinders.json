10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANJXKSyG184Q7kNvwFn-9cE&_nc_oc=Ado5cuym24Ql_75WE19Kuv3vR6POT0bvoYnGfcavepZaITVzWb4x7EZYDWv2jCQ-Bog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FQ6yAYkTH3dy7aSS_S2-wmB5rJ4NNSjHLMUdAM1N99Q&oe=69D6654C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaPothsBzNkQ7kNvwEich10&_nc_oc=Adpq5W6Ww5S8IAOSeA9FSBr5YiHmIFE6K5mh9fNze3u0VdHYOs6-3l3YiOcj_XWAd8s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rB-2nQpPW8eOYJ5rP3-uO7l-JUJtRRHzyCuch0tcp6g&oe=69D63DFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykENJvHIlbUQ7kNvwHczcZV&_nc_oc=AdpTkIX-2clIbucAY_6EJb1EM8WdN_KV77iq5lJg8T08PMl1TRbDKwPX3iuLyb4fJwE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vjt8foDOrjEqp8mdu1fKm0z9wJIUa3uCkwS6ojgdolw&oe=69D6552B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
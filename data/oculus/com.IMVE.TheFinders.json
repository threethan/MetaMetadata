10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0wVrpRWnnUQ7kNvwFRp99o&_nc_oc=AdoQ-Da3amBYSpJBd7PIrjwqLNJwoEK17snQkfkwcKB_Tnb-JhMOy566-Cs7KDkZ9hI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jtOPaDqPRBdB9mpKmBQ4UklJlYkwJYkZrBCVqWnyWQA&oe=69DE4E4C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJVra2tE8sUQ7kNvwEFaFT5&_nc_oc=Adr-Kbo0hSppF1bIJJ7GOrw3TPrRL5aSTKBu8CC3j9Y8PpjEyxWFOmoo9hJFX1NnDt4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WA_koLZDM1hR0any5KHDYQmqUDPYlSTZul5Hm5S6O9w&oe=69DE26FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIjUifcKdOMQ7kNvwGfM4vK&_nc_oc=Adoa6AQ8xiTOjgtCekK8tTmrAwRXs09rgGos5A6icPO81LzE3t9sn_xNVFcPPiJdUVw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wnKFur9fXQno0jSNrzro3SoLncfWJUsn9Rmieq05ztQ&oe=69DE3E2B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
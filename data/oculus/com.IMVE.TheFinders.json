10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNEQJ3iidy0Q7kNvwH2-xT0&_nc_oc=AdpUZzyb7Hi6YlR2ulJ9GLcBm5ho26C2HaddKTy6dUCVaYr15hSnMKFwuNhCcT9GIOs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iNF81V0PDZP4ybmyf9BKvlTfmmQ992QLKYotSDL-Wyw&oe=6A16FECC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiLI0dFIAfIQ7kNvwFQuDjV&_nc_oc=AdrQ0vd82mHAnkuHDzuQiS8jn9gu635u1NJP6qQqWjXx2l8uNjFtZ_2xsJl7yGHDD8g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55WAam_S6n8ccWphaHo6r9U1h2shC7M9AnPwbWgblXjw&oe=6A170FBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-d-daK8SSC8Q7kNvwFW9Nns&_nc_oc=Ado_5KHzVLbgSw0RVsCrBaMPHLcWPdfPOcDZM8WcyFrRFHMYZKmdTY-tEIl-qt-52Uc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sGCsUCjdC-ja6y0kSvEMg43XPElEFVtRLwKC6CJWctA&oe=6A16EEAB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
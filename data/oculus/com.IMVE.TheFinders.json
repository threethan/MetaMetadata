10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znuiFWx_5lIQ7kNvwGMXhTr&_nc_oc=AdpoqwmqLIW3ysoU3KmW3zcIXKQhftBvVCQORH0PGhxbNkyrC2zUMof2EXqgzhxC724&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLig33zrspY5AlEgw0aLBOO_jBRbhwcTWlEdRgrZzJ2Aw&oe=6AA01ACC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0JGIsdtatwQ7kNvwFPF9P-&_nc_oc=AdocnyV3g7mQKk8UOdZGMUw4jz3FV6hVqhtwCap-k_amPksP-I4eAXXFNhYGDS0DvnY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIG56ptzOnH_oRbFtjCa9s_ZEEiBteVeRY2ngoJEihKVg&oe=6AA02BBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNJUe4MUQ20Q7kNvwGO3I_X&_nc_oc=AdpycqMnrftUsWYOT3lywnrw1X_Ql3UH9wEUAgLUSJCOOPEDqUuys62qA_e4FC7R6KY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzcFWpFc4fR3H_qAVLqJrBZ3LAEBzVBBV8n_gUQzy2-g&oe=6AA00AAB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
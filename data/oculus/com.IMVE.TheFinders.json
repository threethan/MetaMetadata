10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zU1c3NzouwYQ7kNvwG5e22R&_nc_oc=AdqVMH0ZKI5Jg1gu4-Ujqr6ZB_21B2DUI4MPXsC4FDm5yjIVzj11glhcNPS3XEuJoT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLEuEFfburw1lgldWtNCE3-MTnAdrkt-m5KFAb4nZ9VA&oe=6AA2BDCC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPxzFbMTRL8Q7kNvwE1Utmb&_nc_oc=AdqBjuorjXlJOICndSQ9rjbW-eW722Ofb9Ld9H5IS-0jKN2ErEpgHJMP206KfFgdHns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9MQNI8CUVDVvpINFt7kCOfGg2a3s_LV9Obbn2TrsYBA&oe=6AA2CEBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qj9qALnSd44Q7kNvwHwZQdX&_nc_oc=AdpnuDxtuKvdYCwWJmU1-4qvcH0WwHVrfh62vSXeXGNJtKFs5XAQzrLkaID-vwYzSFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQII2NlS3xRWMCXcqNGHVrX1labtVoIc3NQBGz4xAqjjCA&oe=6AA2ADAB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
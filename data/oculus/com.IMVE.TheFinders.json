10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qMPOs3n61QQ7kNvwE91uxy&_nc_oc=Adoog8aTFLyOc0T-VxKgA0rw4ZHPvymMd8gStkiMN8UeglvOOHkPmlLP1pp0NTI3fdY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HyZfSlLMc4uIoJPiApNk_Ssa0FNZXGFjo8oJXQXLl7w&oe=69FCA0CC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTkwgySbl7sQ7kNvwECuawM&_nc_oc=Adp7EhjCD2CfLTo2rD071s8sP8L8daU9MdZng4CteW4-ynmAcncxY4fZ5pZ5IB3LLV4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RTOb3XCMcQest0lJ2tx7q_1j3q919ivBXilLbBURKKA&oe=69FCB1BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wh1UDKQpKD0Q7kNvwF0czLt&_nc_oc=Adpya4ut3CUmf8c9xgV3uhGP99mWJspbmcpmJS9HE6GvD4dcvOwMMxFJZf3lWx1nZJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ld5U5vT_GMGQWq4WgdTgmJQydqfmJ8Wp8LqGC7M1hig&oe=69FC90AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
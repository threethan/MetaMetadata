10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFRnUsVkW3sQ7kNvwGKn1K1&_nc_oc=AdrYBexEs0YTdL9MtmCLY9OwofXVg9YBYLRvV1NSq-LBtWy8MnCaoq_MUq1tLyE9X30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3lg-F87yGAAhbd88-T7YWhL6GJ_zFfS6pQPtfX3Z9fg&oe=6A57984C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qerSamjTE5sQ7kNvwGLWIMl&_nc_oc=AdpPI-B0iC-1APSNljxJI5Eu8ijXdaV8GLEWhWZ4wHOVaAiq3Te5v3rWBV94EN1lilI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTY3aGIg7pTnxheSVRdouIEQrrJlJXSxvVrcvK10sdRg&oe=6A5770FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_n3nmGMjZoQ7kNvwHW4wDE&_nc_oc=Adq7MPve08xdwrcydt3Ek9mLirL4kee-XTWWOEmh24QwStOja7QwHFitHgHOw6HzRdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyud2v8LsdC8JEaHuADJWYbHhcrWCDb8JPyJjjsOtYUA&oe=6A57882B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
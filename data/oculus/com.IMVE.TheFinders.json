2197424110_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_RjY99WvZ0Q7kNvwEK7LbD&_nc_oc=AdqE5FXWy_3n97GKTdxTNv1aT58Ut14P3xKraCbgfvW0oGlT0KLR9JeF52nOzG34F-Y&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNK9KC2p6PxKuARxOKCS2r8dMI8SBw7PG3ltfedtUgZg&oe=6AA9554C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9mB2dRNq4AQ7kNvwH6N3Yw&_nc_oc=Adojdw8ERe_Jox6X5lN-9JUD1cuj4YNbEd1fE1vyPeFd5fd5HKWv9j7Dk9GsqqEJwl8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKja7hX_Wryekt8F6FsI-_XHFx1t5ZYSNN-YdzfjCMcfQ&oe=6AA9663C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqloStq82sMQ7kNvwEq3UaX&_nc_oc=AdokdjuqxjvoJntynkeh_r8EIDu_ocIeVocl1Skp2BdYINZOVk5ZbDdF5G67tSemvyM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9a0zeFRM_YIxHRpxDmB4gBGE9HCH0RqOQCm80F0S7qQ&oe=6AA9452B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can
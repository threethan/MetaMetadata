10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E43MnpYLYmoQ7kNvwFPcTdp&_nc_oc=AdqYb8tPO3KaTxBNlawgrr1onulOdFmY2x8MCixK_Wu-AJEUzEYaVmXLtgD2Dau2x-A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ZpRCkjAWSpAzvXua-E0nDONiPMK-7qO-U7qP78v-f7A&oe=69F6094C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mj5-00sW-kQ7kNvwExD_g4&_nc_oc=Adokb9ii76prqNyzb_LettsXZwfVePTQrFgJX3UPuigKBLTVDT1kvUFikYzPv1am2Hc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2DWIyQOHCz-gBvEEHisKQYSiC8NSzom6b6-CfMG_YEyw&oe=69F61A3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqRe3K0P7CkQ7kNvwE_lmSB&_nc_oc=AdrC5BkeVojFLSXFR5SU6q2OEfB1GyCMoxQ6glHLAC86dhDyDLur7GEqh7r9Qu86RjM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0aR8ey0r-Wxi7TV9a_i6vMOgiwwllipL-vm4SGUuOfHA&oe=69F5F92B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
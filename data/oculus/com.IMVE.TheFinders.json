10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKA5RmYglSkQ7kNvwH0waM-&_nc_oc=AdpExDHEghcqDbgs0-krR3l-MYgwK0y-8e8Dlyu8TrDX8phk9cfhkNpFb2G81SbZCzw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK25OMo43ijelbYYlON-lZN_nNPQ-5hmzZgdQprWKOLpw&oe=6AB6844C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oo6ie3__LrgQ7kNvwEsH1NT&_nc_oc=Adrl2eWk9utbAjWgQRZGMqD08mCc5kXdcAJnfSZ3RjW373k-Y-lts9usUMtYvADKIhw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIieledwD17g_vu3bXpvWI6zcOQlFSabfxBbhKC8bVZVA&oe=6AB6953C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nveMAHwlFMQ7kNvwF5vpAP&_nc_oc=AdqfAkOXuOZQLi22u-3HJ-_RiM8xp-kjjstDoDCogaNb14Jf-YKF234mtLWkhJYtTVE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLFpdY8FiCPMTfEfbu7HPhWJOmGx3mFuthdIP9HNjyRg&oe=6AB6742B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
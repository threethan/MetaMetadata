10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PH_BBrZn-EQ7kNvwHMoiDc&_nc_oc=AdpC9G0if4veS-JYcHJhXk9wzu2fCw0-rrlsaTPK5QfY9452dM0pDB_21YDc0bb7wdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR9F-tMeN9vnA4WY63LoZstAwtF10SRFJen2b7OEzyvA&oe=6AC261CC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXvdgEdiY3EQ7kNvwGuRONg&_nc_oc=AdqihZfrPZXqCW1DIyzAFxhgdDCjMGI8emxIzk0OSJ-9BPtSWWEhX7_yExaIePvdJhE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDQTJKhd9hMFTu9XKKpow3nDIJWby-nqJ8fT7zdQQqOQ&oe=6AC272BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NMRa2i5wJEQ7kNvwG_ePNX&_nc_oc=AdoW2hWhwT8LhUkCXmz8BShleKnj91gLxi4Wk9l7LivqRej4g-XpUthqYcD6izQLf5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnsyIP1l7dGZ8_SSAPzJMGCfoB__4T3KrXSA_aLAu6gA&oe=6AC251AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
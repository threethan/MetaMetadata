10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhdegaAUvbAQ7kNvwG4hbNT&_nc_oc=AdoFgyeH6Ff_9yZo3AkQbxyIMFIMyoLuwljYuBAVMZCWbyarV5KvBCq8U-Xw_lepLeo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FwpHHAKnilWlr39uVpGaMdbP4fCxXsDgFiYPLMpi4aw&oe=69E3944C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pB23rAmCCnsQ7kNvwEdMGGy&_nc_oc=AdoVlKCdJCUu37sjGH3O5AMWSvoPFWTQ--6TYWaixVpUK2MppPpkW4jfw3CM8ZpjUE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qTGJGWWoVg3rATS9QZLLECXZ3593h50veTJDfxEDACw&oe=69E36CFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50JMWzvV6ZYQ7kNvwEhYRav&_nc_oc=AdpKMJPQIAKRFFzfJp14577YiyfIIEkY1oj5Zp3h-H3HACgqm_XqqD7eycn3BNIbevg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XBxRl4UKp9lCbKEYB9ae9svs3dBXR3Y7PhkM16RJ0rg&oe=69E3842B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
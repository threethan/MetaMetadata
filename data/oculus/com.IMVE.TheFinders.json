10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpDhEOSNYsQQ7kNvwEgdMmZ&_nc_oc=Adr6E6vNJP6s8bMjv6Cj345syhBZKQJS5-y0S5RLC3UtliaQZyfCwHetJmXHpn8_O48&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oAbG-1l014e_P3fl15B4_pDhxeTM5-oz_K5cwIdWKDw&oe=6A242DCC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inIJIrUYmesQ7kNvwE7P3IZ&_nc_oc=AdrW9Gn_qyDOToQE4G3izHpl83E1-QpOseT55tGkrLuBiACNsqSAkSbHzRf1E1fcVhI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WSdfo_rwX257yuhSDA4v9FJYGbkVAez2VU6P_YTC2sg&oe=6A243EBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RglmsdwVFMoQ7kNvwFsCaXu&_nc_oc=AdrtK9_4kBoh6b1_DqY9nvCXpDEJyjRdO4PI6Wkcf4IonDR2kf29PHWNo63hF_dCycE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9btYiSYlQVK3leFiRwwUna0kDKhHtf6WCXKlg6SrhBWg&oe=6A241DAB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWyMbNv6ssIQ7kNvwG8c57U&_nc_oc=Adq-lklzOM16vNnqbJo_fQF81La2AZwqV26nVCUEPsAGQPEaNft7FzwP-0eQaNZBqWE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-_M65aodoolvHpLw3zxA4Y45MA1uKCkeAmK516dvehA&oe=6A1AF34C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5pFpP7Vc0AQ7kNvwGnsAAd&_nc_oc=Adq_3Jvfx1zefmbrHDlqD-cpWKUDL1rqeFjS39v3H9wrsxKGvbnUveJsotPE9k_waYo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XK9iKjP0iSoTP9FXX4spwZVPTm5q5iz_2veyuVWA0qw&oe=6A1B043C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8bRWfnszHAQ7kNvwF4LErA&_nc_oc=AdrYNOis5A3vFCJTJwsN6PvAOcQiMTHczHEDB-a8N_2_3wBXn3sPYvGCbK_3WKAlspg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40px9lpQnPJaK0oNzl4ua-RG-TZxMcSUAjQBv0yA9IxA&oe=6A1AE32B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rf1So1Z1eAYQ7kNvwHPVJ9g&_nc_oc=AdpGDq8u8tp7Z736SBOotLjuVg-_M467DwqYaCq9ElUyTrqvHHd6iW_UXAa2Ie0lfps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdsZ-oL2aUPELarXorjQZIc2xkW-S-VcQcveFp5hvq2Q&oe=6ACA4ACC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uA8QUMTvsMoQ7kNvwE4eTbK&_nc_oc=AdrBD97d1qNsOtDwDXgIv3gSD1mDAnRNEOpL8KPoQf_FHs2HEuYLUz-RG-poCDvk-rQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_yNb7tKSXKpIf-X5Fj-UrO73O4WTYCN8zmCU77phjOw&oe=6ACA5BBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NApSXKnPnWsQ7kNvwH3J-3v&_nc_oc=AdrmNF9MMENnMHv60vlLLrUhrRzKxnub4chtoM1RJe4GVD_X7kD94BsMSAsomTfks2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrcVF1V47b0DUtvBj6ngKZrMazLb8R3yogc9DPqxlLdw&oe=6ACA72EB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
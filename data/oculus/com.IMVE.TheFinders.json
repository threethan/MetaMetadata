10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_RjY99WvZ0Q7kNvwHLvIjQ&_nc_oc=AdqLIH4UAy0DYTWPqZFOvkWa1hgeZGmKRSZ42G3d9MyzuBbHlxMX5ZzoFk6dq5YE4Rs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1beFqU6OFJf2s9a9KLFarW3RFveT_kYUNIOf6h7OVSg&oe=6AABF84C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9mB2dRNq4AQ7kNvwEsyTjm&_nc_oc=Ado1n1Q_vG41c6QWlSwOLzYPyQnp4dt-JU1-ym4efwn3ZSVIVsO3lVL_ILLZAchGBIU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJME8BjeHTr-MiM_326nIZwltV_1aKJ-Zkdd6O8bp0IBQ&oe=6AAC093C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqloStq82sMQ7kNvwGUuxp9&_nc_oc=AdoTaxTrlyGManERh8mwA41JTNdDcI47RTEudszvyHYIEhik6rk4qOda9gmVqEt-iaY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYAclG3MdK7HneQA1By-yCa_9meTPgMi4wGmqIrw9cXA&oe=6AABE82B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o84SylJsdYAQ7kNvwEdwCBA&_nc_oc=AdpYOwhakdBPN5ym7DSgVHCbow7Zjr7hqYnAXcCzmLOvvoyOIcNDVYiLMNtWhMiUALE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXu3R7sZJ_MsGiYu5kx2ovivs5C38-WBkjd3unNljZ4g&oe=69C3F04C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSRFlLOasfEQ7kNvwGtC3ZV&_nc_oc=Adq9-faGJjtRWeZ_XojXiF_eJBh5wX6K2nkXDCVtV8w4CSbSqHmi9Er3DQxd7K4j9RE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCI1uRZr7zj4t6MGKHhvAM59tG15bPEgOp4SWbSz-Yyw&oe=69C3C8FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dx2qt16c3JsQ7kNvwE0fJMh&_nc_oc=AdoUZmuKUhX-V5gHVef0yop-T_pKGRAXHfaUII3C4c0v0kzYLfc6qbxgaqjdxXCD7Dc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSxa9kXW_TnQf8WjYCW-d4y6xOFPUMsNcVHQp6luwArA&oe=69C3E02B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
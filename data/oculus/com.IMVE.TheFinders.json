2197424110_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKi3e08JarIQ7kNvwEQOdoM&_nc_oc=AdrBNXVq2EEFrR3od2cUL9QcNbWPLnrEHGvwiQ408-O-vDtjjOijGS7kjoUFIp-15Dc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rkmNjdlceclapkWxIRwE-BOEARLedaHkZ_gcbgfbF6Q&oe=6A3945CC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQrPc8mTV4oQ7kNvwHQBgc0&_nc_oc=Ado8ZSvk6mmeqKqA4qnCAi3H7i74KM2qBfmu8PE7WDNTLok25Hgo4yVoukZDr1mxBqw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sGDgsL4mdXFFlBPlEMLMx14c3hyhL9rFKbEfz-iSYeA&oe=6A3956BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6KfkOUUXL4Q7kNvwGMbeXo&_nc_oc=AdpVQQqcmHi-OPjbP_A0hYQt6hHUt5YQN6HXO_FA175q3wTcw9UPusS349kU6rx9kKI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tUNZAyNLosaDxSYIH73zP8FRf3eNrrE_fbMmkxPAYZQ&oe=6A3935AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpD0aKCY6pYQ7kNvwGn7vic&_nc_oc=AdpgB-m6R0CXraKD0IyshJn8hVdyxSdf-uT03_ptusDXqD1GihEjNztlS5Zj17pFlx4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4yI9v6cg-BdGmCgQIY91NM_yfOROD80eZ7kYVG6uEMw&oe=6A803E8C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQUnmjuS7_EQ7kNvwHvSMIJ&_nc_oc=Ado0Dms00tciMxNLvz0fhjb68i-c9vxWE_k-BBW3Njwph_2KlfoYyJla9C0N6mYFkLc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9Vl0Xi3YrNCwHN8obPyAbXizqWVU5KZ7magCsGB65ig&oe=6A804F7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVhJ7zP5Mg4Q7kNvwExypcb&_nc_oc=AdqzNwHLR_kOr0uc7_dRnAU474uEvklyLe8bgilp5boEz8UXJLB8dm91dc-6D1jdjQU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvb4m3qZz_MetQciedu4WWHTuRzhRvOMpcMlSDQ77_6g&oe=6A8066AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
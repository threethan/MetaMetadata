10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1-tum8AUegQ7kNvwF5K9JM&_nc_oc=Adr5GDpPZHZPYjEfoKdFRDrYCdyJOzqtdLmMyu7pmWz-qI56qygPYWf9bMYffwjbw5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyKa_OlxeeJmSO62pkAHzLYX09cQjsz3o-yJVIOaSy7A&oe=6AEB404C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwnB_zqCGdsQ7kNvwFrcBs3&_nc_oc=Adq8Pyr3IiiKI-iB22lp1n-Me7aX4hZBahv8r01ORpj9OQ628BQ5nSyzfCFeX11eIQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTutmRPKR_76nHAAXMrIHfjB33agNE5E9P0FTBriS5afQ&oe=6AEB513C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dQY45z9WGMQ7kNvwFJIMi3&_nc_oc=AdpeeMxQfQX2OxanYSyKkumYmOiACP_HZ9gz6JqLmirj5WCF2yTNG02gQOiuV0UnAxY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDh7OonpU3RC6TPVGVWvtnD6fuLsFsDiN7QwJYGSuffw&oe=6AEB302B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
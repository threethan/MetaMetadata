2197424110_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUuIxopEpDAQ7kNvwEHXT5X&_nc_oc=Adr_IuuVleAEWNlp2hZDA1xJhMJUL4gQkQXytu5wGupDYRQXkoKyaz0R4BcHiGcqUA8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T_UjU0OQuIFRBEPO5ebxpKzI-GtHPe7qpFfGsJuKYoA&oe=6A4674CC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfN9A-v1PhAQ7kNvwElQQd-&_nc_oc=Adquplm5F68nZNuzilg9bPzeGplVElKRdp7o83CM-m70ghIEr4pLiifS-CvUwPreo7U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NEzvFe6fNHeTG7yHbtlJJfe-uKdAVvMh_2eMWOW7BTA&oe=6A4685BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqSS3-9O8HgQ7kNvwGixnAj&_nc_oc=AdrkRHxTTuT1t65cRx-Owo2M_o552A6zc7X0JBVQgGZwOqTJN9TLBJdN9dq_Uo7ifjo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Is8mG_gripAIJ58noReiR4-12rQOWj1Pk9iV_niJCEQ&oe=6A4664AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can
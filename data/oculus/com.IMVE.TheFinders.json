10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYlepfQQMV4Q7kNvwEXKs6u&_nc_oc=AdoD9A83y2meS-MZNwFEgCDgnwHBJAIUoWqM5hAdlrOtNh461VI32E_1iuNMZIWrSGo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MujmQ7YSb_2r5-JIG56Oap2-52lY5vHXHfuDNADcHkg&oe=6A28224C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXlKgpq_XhEQ7kNvwGR5LIP&_nc_oc=Adq4iQeWYdCuZx6bO93wfi37EF_dT0XYZjaK7nuvdput5U2geyrg2FUQpcQym5AIJ3M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RldS5iIovDoZqdRTQPlD5UL40yrcnRtBdNJ-YOnpu9w&oe=6A28333C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIB25jph2FoQ7kNvwEPMUX5&_nc_oc=AdqYwuhmeUsfudu9FBNRcwqiG9jEQGDdyrFqDCwT_MltfgybhZWBsSXWfEtlTkmHooI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yCw8UkiqAASjMFkwA3dvTQDGrjHYhBjTThzbU0iZbww&oe=6A28122B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
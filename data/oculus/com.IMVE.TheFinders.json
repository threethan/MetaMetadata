10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rf1So1Z1eAYQ7kNvwGUi0sK&_nc_oc=AdrYmNGKnQs8d68S0jaC26TLEK_Q951CnEdDJ-78GCKyY3PXFMGkWsCEfIv_fe7lyrA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7PTeF3zWOUFhlzud3qU40hgc786FC_K_ZqGaZG3rKQA&oe=6ACB9C4C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uA8QUMTvsMoQ7kNvwG8ac5f&_nc_oc=Adr-h3kRe4FcT7TeOLrvsF2wkLlptzQ3wLhnjmSv8DkqsmdMqn3Lu9qkRLYPfpqglqA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpoEs_c864vF56wwrWblQ2z3ZNDcbCcMqfsa7YNl98OA&oe=6ACBAD3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NApSXKnPnWsQ7kNvwEKVEXA&_nc_oc=AdoAY3OMTz2g866OdofA0y5zIBSZD39vUtTKmZNabNarNwmOgAigvh-jhF0KiDtun4M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMIzQzq8HkSOciInbFwJskoPxt9U7jON9dvlgU_fJO5A&oe=6ACB8C2B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
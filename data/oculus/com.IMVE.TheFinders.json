10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWyMbNv6ssIQ7kNvwHYx2IK&_nc_oc=AdrIasxsaLuf6XIrG-MO50_icHwPyJzRWRPK5cUiYZ-2FHMDvxM9lzQhRRfNwTXa7t8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CFKKX7T9EfhYgV2Jfpi02Di_mvSjV-SLY9G3hK_FGoQ&oe=6A1C44CC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5pFpP7Vc0AQ7kNvwFY1UCO&_nc_oc=AdoIiyoe_OtR5-Jw_M9IcRGDZm2N7a9TT-qoFynTctxuHYXulXVYhqDlsrMLo04jsi4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66HxKobFcC_TPn8JBiOf67g8J4gp3sWz3B6lwS8FwLtg&oe=6A1C55BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8bRWfnszHAQ7kNvwFo-p8s&_nc_oc=AdrsH5KQB6rorG7tzBro3eM0RvKVM5CQl60HoxQ-nJ7NDtP-5mhUqfYu-9doNWd6zKg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o47FCc2GzzGUSYfJghqhXB8U47rOMq5G3yyvzBHVz-g&oe=6A1C34AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5i2evLR0oUQ7kNvwFFBaHL&_nc_oc=Adr3ytvLLE7x4SbB4Zq-5NDCZAH1D52LL8rHopK02atjWJBfSZKMDwkzS13hurt44WU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC-6lgFjtZTmMf2UvrQKy1qpL3JfhY6ZxbCEOr-XLXXg&oe=6ABBCA4C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXEf5OcHtz4Q7kNvwEm1Gup&_nc_oc=AdpNv0tPjQ0MNQJSwBAi-nGhoW94Vyj06TCAejJItWrsWOc4XSKuNyGZFVnts9moaTA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkXZskGk_BmBXk2RfnjL6T8My9TloFpgdNtfwQ-UNqwA&oe=6ABBDB3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXsQyxPfpqoQ7kNvwEgMXkJ&_nc_oc=AdqbE53qGcUHGUZA3rI5LXl9r6Vr9f8rWDygg1lFq87Pj5lbOJOxUU1FLbmspQwwXGw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKhEIRNxdNhgaKCYLfBkrBgq5OR-9atXWwY_KHliOx9w&oe=6ABBBA2B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
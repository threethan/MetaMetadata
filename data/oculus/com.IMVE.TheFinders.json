10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcpBaEUom1cQ7kNvwGDRMLu&_nc_oc=AdpW3YiEbt3P5QdsGkUWxIc-BKOsSezJgjGS2wIPElmWPTtceHhOSWZAiLEPOBqXdDE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0g6R8C85988zuwrJamrtgnctlA_S0Q4IvRb18cJoYuvg&oe=69D270CC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_591qyOu2kQ7kNvwFa0CG8&_nc_oc=AdoXjlbx_xXwRaRLM7fIw-BKJlt5qg3_h9iu7LFWnrv4BsY1YL4DFbcbKb05m6REZRY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2inheuelKerybOI3o_4xdVoO4ZC0JzE7D86uckxLjLsw&oe=69D2497C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWRAQnr3zykQ7kNvwHMAhAF&_nc_oc=AdpHL9Ohh23MXylltOMuZkGosu89zsIJW2y3qUT87BT42T7yYQNtC1mN0VyCZ5Lt8ok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RuopHUIQYQbSWHm9tyWYyUH_7hw0at_IisuBz4fGhug&oe=69D260AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9FYx40lsHgQ7kNvwHl0TFm&_nc_oc=Ado4ROxzCqaL3gE9gFVZQ_3b4hv3piS7OPWQngSg3rrixz3gM0z1t614abj1Tos01L0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67CyW0oBmMQP-PN_JG8BQlFWOlWG1simDv54AiefkBwQ&oe=6A072CCC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTrQa9Fe40wQ7kNvwHx64aZ&_nc_oc=Ado317ZNMWxPddNo-Dk22LMFcZ3TgffWLaVFdrQG-8nTPL7WOVrykBBBA_6_DXl30NQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d8resRlE-E0N0ggliFlZNsaIh8VeChTazx-9KBTbg6w&oe=6A073DBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSiPZwdwttMQ7kNvwFzV2g-&_nc_oc=Ado974XZqaZuK4XakzbRkuyZchGceg34gfXdb5_pBkxYqsGVrQvOiRwE1aSDMvmzMjc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DhBSSQ4HC2FUKOd7sgVYf6BUSnSkD7F1UjxdrcOTrbA&oe=6A071CAB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vlxwdik3GKYQ7kNvwHZK7Mm&_nc_oc=AdofWQHS-AFE8mBpVTjQv3OfpEGtma_TdTRs0DTCybGTB8gvGd7c8mm4jTWsohdqCrE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAR8wxN221GfIzt4bPCp2lFwip2aGGJqFkMShAirQU59w&oe=6A6B5ECC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOSeSU3NdLEQ7kNvwFDWmPq&_nc_oc=AdpXbx-y1tzgIomg9QHSHojt3eRiixn84y8wndf2SeGje8T6EPqbDylFfREbdKkiYPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOszmVlz2wuQdfSfWSrDSs3-LoKvc1Y1Jg0oIvXQs25w&oe=6A6B377C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3vAFIgtDAcQ7kNvwEfmPmB&_nc_oc=AdoM1tzo6zRcov7ojR6U8QQG926P6spuid0nVbD-HsNkRd63rnwWhub8LpmRoJ06BC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJGfaRIZWM9JhI4XZ8b1V7HJKmSPlik8Oc3R6wQQzIew&oe=6A6B4EAB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
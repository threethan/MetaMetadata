10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NscZnLZNC8UQ7kNvwG5dz99&_nc_oc=AdrhxBrMsZUz1snmWzyKssd73NNDF2yKrdXBbqddG2enfzBaT2IFzrfFgdyg31MehOo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy3dsoZD-0vT2dpihMiKTKrT8zVb4Evk9OAyX0WsPHBg&oe=6AF3294C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3m8WeKesIjEQ7kNvwGMbenf&_nc_oc=Adq76NRoogkAwYlmcdfncN6T2lZvGKIZDrGRTFxLd1nBEWPZprXYHiYw_co_U1lw8Uw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSap5s5ARigD1Vkg2IQpT74eg1_1QAlu6GTOCB0QaKZuQ&oe=6AF33A3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lw_DbD7zA7sQ7kNvwFuIvDW&_nc_oc=AdoC8mWR1siTwS1ibrXskrK4BVcq_pzZaHYFAXk2Ayy1Wq9lX6dr6iKkjQHYzmKDfOM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRzr7xWEE4qf2Kmb_b2sQgUAWsfxw-36KOAuvnUpRbfA&oe=6AF3516B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKA5RmYglSkQ7kNvwFkDIQX&_nc_oc=AdorU57mB81AWBjLtC2u1lHYRUaVRez3GPKuTA5ZHSoMaTNx3NJOfLzs-L7rmrR_AFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuicq8ELHq_9n1JtCR1iZ5HpTH6VGgqlkCCQOWVO6a8g&oe=6AB532CC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oo6ie3__LrgQ7kNvwG93P3a&_nc_oc=AdrXP6zscbcW8Rbo1NRjW1qoy6poAm9q0R5zzmNP9kdJP7HwVErEySxTOV7XcnPFu3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIft0GYjM4GohngkkRBNJws9IEstxRXh7M56WfRB_BD_A&oe=6AB543BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nveMAHwlFMQ7kNvwELD91x&_nc_oc=Adq9nkgx2Kv-0GXEej166-vUCa5qyPGCaRqVJJ8fFYoqe_nNmxqQbr5gxgutcKkaM4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqPHu2RaAcEo3Zd22IhKIgv9twV5Fuj7s7P3XvD9MkzA&oe=6AB522AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YZ0Ktocn1MQ7kNvwFdkeu4&_nc_oc=AdrcC8OBiz3W2wxtgra2lDNITcf1dcVZE9LwUw3ha26CBswZea301BtmNsZkD-uVB_I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkNj3aWXiIU4QQqoeJJzYuHuQNr8sPjAIxHuK_-llWIw&oe=6A71F64C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XQn4mb6rh8Q7kNvwFWqUKc&_nc_oc=AdqoGw1ZvicDQ87VPiR5F1Ke7lkmfM3cgy1jQmvWd1Pqp5tVMUNQZJVWqQjGj7hBSgU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOeunQUOxZEZAmNMX-Lmg-BmKuJqQFePo42tV8L4iMKQ&oe=6A71CEFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4xwU5RyscwQ7kNvwGtU-Md&_nc_oc=AdrMax49ElwnSBDAI25paIX5w4lN147vyM8Wtx67TAhvKj4CIGha4D_DvszXsB2XPAM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkFJwtt17ISI-RYyIGR3Mas4DcdVCIs25GLPIgulGeDQ&oe=6A71E62B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
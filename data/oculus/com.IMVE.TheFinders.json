10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MN0GXyz0t0oQ7kNvwFJSmky&_nc_oc=AdpB9HIaZhlw5tWSZKvqVelFhTv4TzvYEFdG3OkiiIBBQkCgVcQfbOVUiA4yQaLRkds&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZGtz7UR92PBzDZggRJChZYgROda_ENra56-rEJgmAmg&oe=6A91620C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLBisGZlT8kQ7kNvwHE9JMo&_nc_oc=Adp90TjwzACpst5VEnsUpnewtIDfJLgPRoEgNTlNtjgZXR2r_iFL3q7mjug0V2W1Lh8&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJI8MPpf7kqMGfaxX90B3L411WH19Qk9qrAfYyfkFL7w&oe=6A9172FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdYtvshXqpoQ7kNvwGRq_M7&_nc_oc=AdpSnVJPtP_LEA0OAeimeCnOhBAuoslutn2NE_JKpU4mCQa_18X7xL6L8n2j0OS0gcU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHljxmVKRr4HVdOSYOGeQV7JLaRHzbsfMM8JrdwVdsrsA&oe=6A918A2B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
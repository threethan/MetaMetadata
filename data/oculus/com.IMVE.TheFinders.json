10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiYOf2YwcP4Q7kNvwEowOcM&_nc_oc=AdpTrO4WbaAYeOqhpM93kbmdSrykifcvQY1BcZSeF_WoK0ohtbJlCE-GsgAaG--QVBs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VXJvHihGb7n_H8Eqs9ozgwvJthfp5gSNWWepbnzrcNQ&oe=69EF71CC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fS6GxQZx_ZoQ7kNvwESXnBn&_nc_oc=AdrgaSrFiLAb_FAheIB-FF1MVNnLmJERAtPibCNh9HRfN4W6keRAxJPxeWUhjFRMJ-E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13N33SDe7CJ7j-LHMJ2MfFsHgBD7SBC6Se8SB6nJ-wUg&oe=69EF82BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoA_uc8RVZIQ7kNvwGCeage&_nc_oc=AdqniLtxfms4mfPrgoGC1oOi27VPSe2ZaibSdgUXh6iMmkXS2KUAeJ2AnN5N0AYykv0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0mX0OiI-nja8o0mt7JKZhUwZaTy_IQ7u41R2Z9U1cD1w&oe=69EF61AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
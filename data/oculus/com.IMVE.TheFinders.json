10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znuiFWx_5lIQ7kNvwHB_Cdy&_nc_oc=AdrbNfZGK4mHuzBUwU8z-pP1w0Enihr9oGaLS79qDem98I04qRrDjNPprsHq2SEFJhQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItKUCV_4Zx52rmCdOEK0o1jvRK365qAYtQs5SL2As4qA&oe=6A9EC94C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0JGIsdtatwQ7kNvwELjM61&_nc_oc=Adqxr9X5xgdPE5NH6zFg4DN_fRmWqdMg1wSLZuXPQN_3A_BlQpJ-J_z6zakfslTcu84&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQIl_JqvwOcndKed9nMTPuvi9njRjGX8hBA45qN3LUog&oe=6A9EDA3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNJUe4MUQ20Q7kNvwHT9pDJ&_nc_oc=AdrfQwF3HS1bo02OQVOhC66cwei_iHnaOgURZgGURg39fr9tEnKxxjuLZh8HB4DbVh0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZqheg_epeXLQ633vakm8znXzQs8tWw2ZLUa_1GKy3LA&oe=6A9EB92B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
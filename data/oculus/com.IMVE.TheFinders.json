10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4jUeK2UNuwQ7kNvwF6Vyjp&_nc_oc=Ado9uugUFBl0OcyQu-w-BBqQT-3KbOcAaamppmmv2-5KnWzaGQfCfKAfCfozwfzw1AY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQGC5q5Aw4pJ5OcOe9qg1ulgaLmE2pVVblz_uTyMN4JA&oe=6AA803CC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZQKy2i3t3AQ7kNvwFS5DZm&_nc_oc=Ado4vRk1mwLU3anGQc-Yus2uIs_Xnsxqc9653_Rr9-FqIdO46NmzKA48QadaafyukLM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJt_KraF7N5pd5ntP5Al7Voi8KnhrBZ7gTVgpYy5py_AA&oe=6AA814BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdWsvd5uITMQ7kNvwFPsMwF&_nc_oc=Ado93hufxLJhGhmagHUEXS7Cm3zSRb63rFy5NVn7N-9ozPuGKZDHvW9zIjTsamFXgOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaS0w_DhhKC7-kzmvFSxJMuszdAMWj18J9rU4bXArRPw&oe=6AA7F3AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
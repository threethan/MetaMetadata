10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qMPOs3n61QQ7kNvwEcrPCy&_nc_oc=AdrnOoKyv3XX5rHmyXf67kWJ5B5xXJygkdy0oHSUq5YDBMqZShTETyhS-QaRLXoYvPQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53QQh7BQNI3jwj8FYqtKVBpFP7e_qyghYWdbgVArcmSQ&oe=69FDF24C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTkwgySbl7sQ7kNvwFa2dRD&_nc_oc=Adq1BQUz-9JKRclUN4Ec5iE6Zi3TI1GojVUqfzJ4szhEhBVLtQrrKzo-yGTN2jA66w8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59R4YDgaFdpa6FV47WHHhY166NEpfF7LrEPd6GrBCSJA&oe=69FE033C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wh1UDKQpKD0Q7kNvwGBySGk&_nc_oc=Adoj6jTdvxjpzGoCnaxe4ytFXIWi98WVzQaJO9hxnUlG2Q2R6gJIcTc1JhSErwA-8DU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SAj4iWInaIKCVUwCe4YrVPRyLWoQIU8VrdtcCMML2uA&oe=69FDE22B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMfOGVtaRTwQ7kNvwHtG_Z8&_nc_oc=AdrMkxXTR_5J8jjQHp8LMVI1L7Yt8Wx_Q31wH1eiYdraGRiXJ343DhC2apR6H7L28as&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR5l--ED29jAssEroDcQT5_jrL2GdUIRwT1BMMOgQl0w&oe=6A7C4A0C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aR88c_7k2pUQ7kNvwGWn7uW&_nc_oc=AdqjQlgr96UV5QrJPKCuQdIspOqX8crj7Wks3eTPzej0s4efyomoFktZtVEeQAV65Q4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4XEyUGdsFmuS1DztcG9ts2VqcBnA4JTpEBn0Ne0uOSA&oe=6A7C5AFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_47EhCZrMkQ7kNvwFiYgmf&_nc_oc=Adrn0q7Mr-5RBRf3sf9jxO6Q9-Xc1rYqITlf8wN1vLUTbQrLvaS5n_A5wXSQcmhyRXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMw_rxIQn6-t6rBwPObnbWvUvYtnQ_oSTWTq7qRCEzKw&oe=6A7C722B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
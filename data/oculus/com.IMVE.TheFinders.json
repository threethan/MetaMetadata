10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPCxt92uNAwQ7kNvwHB_ev8&_nc_oc=Adqv6znzB_Uo0Rdg_ZeBp7YsO_udsjwtTCq0kAzq5ymrkbIDUBxNS5kiTdaULoVzQgc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K7kO8mws05oduz_2Yz1J63nDNCOkO1dLKBexs7-l_mA&oe=6A42804C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NiymqPT0k8Q7kNvwFwg5ED&_nc_oc=AdrWVgthnt6uHROPi50URkWDCv-SHZEuPId3Ahb4VqIdv62eLrFOcvPRqYhbvI2AV_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HFc8KuQBtgP4EvHtrO5A8HbTb2YU2MCinMf7Ows5E0A&oe=6A42913C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NseKRXqntNUQ7kNvwFJsGt_&_nc_oc=AdqaXriwdxWSAeTO-Kg6D_HwJ62oIelcM8VbiEngSLGj5LmZYeOEcso0xb7A1FoCWRU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iiFEf7kx6PUNl-sO9WYypt99BvnwAl13RLuv74XScTQ&oe=6A42702B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
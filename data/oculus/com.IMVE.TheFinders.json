10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUuIxopEpDAQ7kNvwHaVnBC&_nc_oc=Adok5hQBwOuaBXC6aiEOFqTEHdC5RCg-eUkR6fRCdrxFQj1mgSClBNmkx8jzQEyjzjI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GnHr3DBHfMzwscgT-Oal7TlIvesGbSFGNUAcGUFv6aw&oe=6A47C64C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfN9A-v1PhAQ7kNvwFMbJWe&_nc_oc=AdqMSOeyKVaTBJ90Gin3EXpmYBQtRAfF4FWl3Fs2ysG-JT5d49TJmSgRxTUTQyNW2k0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mdoml5Mg_WPW6GigyzsUfhJ0Fqr-A4lKpGt_T6FEcgQ&oe=6A47D73C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqSS3-9O8HgQ7kNvwGLMUnn&_nc_oc=Adq0vj9_UsIOctPB-ew7Gp-Rkr_pCft3BrZP2vucuRD4XjAz2M2WdA8iWYYtpjgS7cs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WLKPzL-N80bL99UockmDfNe0xiSMBaCIGItT0e3sWnQ&oe=6A47B62B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
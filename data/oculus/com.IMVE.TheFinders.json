10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5i2evLR0oUQ7kNvwFZ2s2M&_nc_oc=Adr-2RL6NzBiNoj3gFkqYtcZtk-_kEFZxJW_DYguX_He_Fv7X_ibUGNg4YfeuzpiJIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMPwNu66NCaPAm4YBzcoXSBOJ-GqxR8ZTom-pUIuRRdQ&oe=6AB9274C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXEf5OcHtz4Q7kNvwEsNzFl&_nc_oc=Adq9sJbBEC4M9gxMz9RCGL4Lu6yzRPC479QiCHcvM4DOeZJn0ZsVrgu-kqwjUFcT0-s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmiLwSQWGkyUxE_7WTO93KEoltjr5CyN6C65DnHqGcaA&oe=6AB9383C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXsQyxPfpqoQ7kNvwEWtm2P&_nc_oc=AdpL5gaGLe0XV_4Xrd3NzfFtuJ68vmbZ2zpLGey7zOIKvoKPHPvjqfVyvSN37QF9IUo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBxqLmthMbgpSv_p7ulQ3Lw2DKX4rFsXhgFwfw3ECmZA&oe=6AB9172B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJxfv1nQgesQ7kNvwFEbuXW&_nc_oc=AdpitjFyiu4OmeMx2lN3mhy176sR0I7gnXR9FsFskJ8r3W5K_c64YqYGEd76oPpv2hA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P2dGl1bAfBBR98R4Wf1ztS7YxfjKesgLFM-PI_5dJ1Q&oe=69FF43CC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYxljWHRF4UQ7kNvwHA5RRr&_nc_oc=AdqkGAgdyVpKNsSiS7_44z0NFV7BACLkWvCn2EaONXGfQAYQmTJHixnffw_-KTOZoYU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l0ng6ajIM7N79VQFvMvLdCP3hOXPtAoMFi695TfCkvw&oe=69FF54BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SWSkF5nJ0QQ7kNvwG2iwqD&_nc_oc=AdrpUevJ3_PUitBz8Sg9_MHg_oUh65MTSQe8PbjsV32Imm7RmR5w1AjeMXRg4-HANFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7p7v3oeVu5Ybn_4SzJ94umdXYWy26RKEvbaqdKJQVJzA&oe=69FF33AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
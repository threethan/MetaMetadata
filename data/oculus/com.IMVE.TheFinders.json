10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSDNRyDVt9UQ7kNvwGy5CSk&_nc_oc=AdqHTKrQlDGgUljQ-6K3PqothkwoOsDyH_Q2WCFAQvqbB90vFUqzFFULMnmJfilS5uo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsIVE6uu-hKCpTdu9lZZhAsVmV0u6ZUu9oGH8BfgaNhw&oe=6A99834C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfIUzuFXV24Q7kNvwGRfrvr&_nc_oc=AdqRWXRnzl0WvTZ0ta36DjoK_nJEhHfLth-AYSjTgVRWu9WbplGBLW49wY-EAQ6YiZw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR-_jFuH_-fKlxmXfKZWqXo0wovrqDds8osKOIN11mWA&oe=6A99943C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ms13thvwf8Q7kNvwHH9iIB&_nc_oc=AdryV-jITQbBMADr4tUvSogRYW-pSuanWueDqr7gV0N3_ovuh1CA20YY1OJeYstf0L0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITsWxEZPDG3FkHdhvwWPui9UV1KCLKFZ8pDozXhQVAiA&oe=6A99732B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MN0GXyz0t0oQ7kNvwHivrgI&_nc_oc=AdqZdczYr9hrY1Qc34pHtznw68fQEzReMzcQXdJl7KdY457oN-ovZGDZqK7wyoFGCBA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXyEtZqndpMZ2hyV2SD-ulmB1CGMFKsyyIlRTx8QR3wg&oe=6A92B38C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLBisGZlT8kQ7kNvwFrYC-t&_nc_oc=AdqoDnqU0rw1UyZTASKlwiNleSFgRBpxY9pcT34zHzLlqweOhWCBUA_knTxdAOt0_dI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRGQ4giR9Q0cj6FOXP2UzZVd8Yh2etQ5Y4m_bEMsVllQ&oe=6A92C47C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdYtvshXqpoQ7kNvwF2VJp6&_nc_oc=AdocUWiyIxnynftqWF30z7kdx34vrPOhhqBWLYF5ge9Tkf4W9iBUZ2YAxr7frcUKah4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFen-xltmy-ccESVtNkqOBZ_NKg_gl0q4PbPjdjrrqGfg&oe=6A92DBAB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
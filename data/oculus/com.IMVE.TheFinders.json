10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3AxH7DHsxAQ7kNvwFOUXKg&_nc_oc=AdrubVznNJqbj78yGFSiov2uM68RJkZ3JpNu_2CJQXQuSGc8AOD0bGrN6u4HPrttJas&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOvGpE7JTvKGvU6DgSsC4dk7_Gkben007H4NtKK8z7Ew&oe=6AC504CC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf0g-Hg6YA0Q7kNvwF9miGl&_nc_oc=AdqGRLMZuJXsMML9DnO19qyLGfzSmKCwXNcbmXp9Of1oXKDQv_4vDjuSBKRUOqZsh9Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDO4EXxHDl-ftcwXnr4HS2e_5HcVh4e8ZWteEI3f9K0w&oe=6AC515BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbOw48e_nR8Q7kNvwG5OcPp&_nc_oc=AdrkaDIJukrOHsnhAu6SQFPhIvEAHn0Jca3mGTG49TNNPDoGj8vIImBCxRoyUUsh5Tc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMsqPcKCbAZIZYtOZfa2JtHJpYU-PoizGinYS4w2bKhA&oe=6AC4F4AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
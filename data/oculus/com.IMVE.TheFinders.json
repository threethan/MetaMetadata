10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhdegaAUvbAQ7kNvwGi9UvQ&_nc_oc=Adqu_SLfxe_GkKr40JP3jWs96lEX8nc10V8RRTaaLeS-n2HL6O1MwHW4emnbiMDaki8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1x7Ty6G--UZXasG3Uo8g_wfVeZNW-e-qTHq-f_FVsFVg&oe=69E4E5CC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pB23rAmCCnsQ7kNvwGd3oUw&_nc_oc=Adr5N4GzDexviVeAMc965_AlDLTlTsSWEz4wcwKC7Xn_0U1jH7ityGbM8E80M2EZmTc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EtyvbpLr4BEpjXk-OOgRHHESkqqtZgs73zhsI4EGK-g&oe=69E4BE7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50JMWzvV6ZYQ7kNvwHfnRNF&_nc_oc=AdonKvi4Pae53rTtASMT8wgF_c6d-gXZLaQupVFX435SZOn7o5QRvz4ppZRY_5ZDzOw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07qIRnKj4UKOLq28fXrehp-S3Wm7HIFTy0fRlSFbdIuA&oe=69E4D5AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mafXBqDx_IQ7kNvwElzbx_&_nc_oc=AdoLXqH6pkKs_SE4xJGlKkRfO9d1fOB3dz1dqMDz1o4y8VSVorW_DPjVpAjzsDi3rX4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TtXW_FHFTYtO6yo-gAbtCNf2aA0GMokmIyBb7CbTmPQ&oe=6A2C16CC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9AUPL144dkQ7kNvwET5d7N&_nc_oc=AdpYXYcHXYyY4yEPj8rwqjWjSSV_KOSVhoLv7XT-oOIKDDm4-1WobC8OBrVj_rmGSrU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C1TDAbYukw2I8x9HbSwr7zqKBIeihCcGz9vyZjoOQbw&oe=6A2C27BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4Rd1YI6nwMQ7kNvwHbfKyx&_nc_oc=AdpWXkMxPmTgwQvT4ttAAWKZyuTQMR_dROqj3TrwIKo3uJq1JzpWWaLSXRkflzKFG0s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qJulh5G-PuydetrTCQHeS0yufkMeXcBNd1DuC5WyHkw&oe=6A2C06AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
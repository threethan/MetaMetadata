10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XJiYXQHCbkQ7kNvwFXkqxc&_nc_oc=AdqrgI-ReT1BlVZ6K4Gepr631H0l9-6JL37LKD8Y_FHe-mb5ryKS634vG0VBiCN3ATc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGToZp4LunTmnvv6iG5wHqDvHi2sJ3DqESNdJfekYqLpw&oe=6A88278C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrSnUa1A-5QQ7kNvwFr54wf&_nc_oc=AdrtdJF-xu-y6YPIfxzvtyASVEbivUHpzngStXXNH7eleXAaxJSLXVLLTjDvHVE24HI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5m_f9CQ5Yrv42NAXkCsLDW2djdqpe5Dg-zqbwb6NuOg&oe=6A88387C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5M_qvvGs_wQ7kNvwHgZkQv&_nc_oc=Adp3FWwWacaeYywn2-0kNndfxZdm97Y9NKUcisRI3-wRiCDqqYIfHeTK8F5637WWsuw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHV5NUPClXijbvmAGGgmHt_O2x5wHRRYui_eg6XuZcCvw&oe=6A884FAB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
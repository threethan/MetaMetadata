10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxQdhHTMWxAQ7kNvwEBGuGg&_nc_oc=AdptuGk_3a7xDENCgdo0Y693waeghdNQ4x9eRrDlKxwG2ZuyXOH88zDp48rSGgaz9Go&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKopcFcOs242uQ2px_xJwD4Qj70ZvCrDSZBrqriLrx2Q&oe=69C7E4CC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOrbjNSY7LMQ7kNvwG6PyCh&_nc_oc=AdqrVxjogcGuDw0SjUYrxS5r-0QCiAZru8ei6q2Gsx7k8h8oGzhjAESa-wyRs92ER6Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-Hql968W3qVEEHZiMR2kVCx20cAB1hz0yDAQWVjEFVQ&oe=69C7BD7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB8_lgSUxqoQ7kNvwHnEAgw&_nc_oc=AdrerSl6D4zQTv_OVJlgOaHAHa55Kibofibjl2w4sM9MvqlLbU-4XV8WcrBslTazvtU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsxKWoKh0KWHqctig7eTDjuhlufPtrwfPsc5k84vSpyg&oe=69C7D4AB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
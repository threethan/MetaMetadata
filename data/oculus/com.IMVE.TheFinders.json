10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mafXBqDx_IQ7kNvwG9juhz&_nc_oc=Adpbxutb3ceMuClWTas8C2nmDoc2WeDDPo-gUrfjXVo7s7qVUv1E3O8u1GELwTWYCes&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kivkfiX4cJLj7z4IGKYWpaKoLdmFl1D1jlc4boCAbTA&oe=6A2AC54C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9AUPL144dkQ7kNvwE6vbRF&_nc_oc=AdpR3rwew1g470BJQQ86j8WtKcrzyNnJQAuktK_wu4Q9cxz2gjf902QeocTXrB7jYOE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qFw8xmP149xtv56yqlc--jDDnL5VGfBQlL1-zgOPBdw&oe=6A2AD63C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4Rd1YI6nwMQ7kNvwE3exi9&_nc_oc=Adop_JAn4NtYkfZ8T8SM5GN2oERPXlH7tBB4lwxIThV7RyEUs8o_fldsp5dswoSCowQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZWot1UioaRK4rVE0K7Ob-GFp5VZYEVFmhlw_NNEbtXA&oe=6A2AB52B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
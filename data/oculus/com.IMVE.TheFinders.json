10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-35anZx5_AEQ7kNvwGcvC1c&_nc_oc=AdpUR8wtvc4PEarY-TkiRZOQRtEFljuFS-Z_HPzgCkpL0ORKENJsvriSANkeWOsgrH8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28tvLtdbYzgeC05qaSWLWXsmC8K9ywp8DlcaL3qaMrKA&oe=69DF9FCC"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t18ucqTmGrIQ7kNvwHCH2Mz&_nc_oc=AdofntOYmd9eW-fQhMQtu3I2a1s4tdyT9YstYZUBiW8MUc3YfpCEIOpa5DF_xfuRCZ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xnEriT7HPrL61hnw1J1aTLrxn5PtHJZIAaOZsr9ywTg&oe=69DF787C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qi-cvkz9BgUQ7kNvwEqjrQ_&_nc_oc=AdqCIKI0LXFAgahGtxW__hPc2zdelirVy6NGCTG5_xb3iUyZ0P6jJEClM9xRqyHG5YY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37b9BED9zjXFj8aO1eJt952dN478mV6xhumWwm7jqOEw&oe=69DF8FAB"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Grdk4MVHKrsQ7kNvwGbzH8n&_nc_oc=Adq5yGSaKyyDS1grCCshqHBMLjhOL2Yf9RZUB8KxCwqDbwr376xe9ZV-vus-ZaAuFEE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBNgmlPoymsR3A-7e7rXq9mxYcl9uKCrsvNXV_C6TLLQ&oe=6A52524C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H12Hti50tx0Q7kNvwHO-FbB&_nc_oc=AdrE0SLFW82M7Pj0gp2QSStA8gOf74fl__Xn-P5yaXm6EAyM2JwPs_Ilh9EWY4P8Pn0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1TcRj8d73_Dr4TSKb1Ut2gcKmHK1QALSsNzWFIN3-pg&oe=6A52633C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDM5BGaCiBsQ7kNvwEOyGxj&_nc_oc=AdqF6C-PrVOagPdsSh2kDiNcw1yc4jp9TQO3Q-4ex6Of7z5op9iwijDuc3AhWWcyELU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvKnmDkpDr2cDFTus1hiNXPLSM6BI6mTQtUIlnaFDq0A&oe=6A52422B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
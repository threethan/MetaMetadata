10_6877594147168239640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PH_BBrZn-EQ7kNvwEqnkEb&_nc_oc=AdpIfPwJ1lcdWkSAaKpf0ERFNEEPGYfmRBb-zlbExDeCPAG88uoRcECZG-0t664sL84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd5a75STiZtlPrgIDrltwxgGekRATOoq1vPpHFu9lxLg&oe=6AC1104C"}, {"file_name": "2.png", "id": "2953570888277783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392093_2953570891611116_6048066563426032845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXvdgEdiY3EQ7kNvwHzmyBa&_nc_oc=AdrvJFuws3v6dk6XeFVLZ1ch55YLzetCR7xK3cmcBj5zNpvZ5Fr_2zb9e_DZOOAJbkM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdufRtOXjji4ThL-l1cwJ99t8JhsP7Juf2FDqlMskXgw&oe=6AC1213C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Finders_Cover Landscape.png", "id": "1629436301031148", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392069_1629436304364481_4255148496526447739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NMRa2i5wJEQ7kNvwHvqsGO&_nc_oc=AdrLN_0H3kCbE6b9I-v7XoZSqKdh2rwk0mhVvVaWI5tIX7O6bT1RATxhLHWoXgOC-d0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOP5-cBnt35E95kVpsDe3es4evcKQR0EOBiWKTWv2eXeA&oe=6AC1002B"}, "display_name": "The Finders", "keywords": ["pet", "cat", "finding", "challenge", "finder"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Coming Soon), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n\u30fbCute animals\n\u30fbSandbox exploration\n\u30fbMain quest \n\u30fbMini-games\n\nMore features will be added every month. So, stay tuned with us!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore
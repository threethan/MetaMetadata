9003136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSL7lFgAc4IQ7kNvwHajmtx&_nc_oc=AdqmH1IMgHgHaMMlhQqYLUp00WbjTdQtW-X4cEWuQTBAuLCirdwZOzF8VKQgYX_VE58&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsnnMw8-auhVs9b196OQ5aqmOinFKDsOfE8XX8Vde7TA&oe=6AA95A73"}, {"file_name": "migrated_image.png", "id": "574104920127947", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12427564_1860028620877760_5437187408552525824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVd-7lHajNUQ7kNvwHKeVRa&_nc_oc=AdrMNdVjW_ZmTEsg5VRZtX6SQvAdzO8i8ltq6gH2MHsORQX0qW82bUrN61nRCPa-Cv4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlLhMowaMaM6ygnUQlP6StSfPt7-7B49mO_YYurcuz8A&oe=6AA94FD9"}, {"file_name": "migrated_image.png", "id": "227707755266707", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12533842_278759825895480_2713575254034219008_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqJFCnq17HAQ7kNvwFZmC4x&_nc_oc=AdpOmnzFUI20F5nKTvHc9sj17d27fvzzD7KITIgtiyyE64-FNrIQM0fUHs87q15D74s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9Z0oQM10otjvKW0AjE345kGDYysnuuwAGQX1xTrGcsg&oe=6AA966CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maski VR", "keywords": ["Episodes", "Comedy", "Series", "Slapstick", "360video"], "long_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm.\n2016 marked the 25th anniversary of the television slapstick comedy series \u2013 \u201cMaski-Show\u201d!\nTo mark this significant date, AFL Productions decided to make a present to \u201cMaski\u201d and Virtual Reality Fans by launching a VR application for the revered comic troupe. Now, fans will be able to download all 8 episodes from the first season, 2 of which will be presented absolutely free.\nThe c\u043emic troupe \u201cMaski\u201d gained international acclaim from their initial appearance. Successfully traveling the world, creating a new repertoire of live performances and developing their own style of clown theater based on silent cinema, the comic troupe \u201cMaski\u201d didn't stop there.\nThe post-production design was carried out by one of the pioneers in the field of Virtual Reality, Chingis LLC.", "short_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "developer_terms_of_service_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "publisher_name": "MERIOT, LLC.", "support_website_url": null, "website_url": "http://www.aflproductions.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "615786576158409"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12139051_800492883433059_2164792220173991936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDCmBu-2gWcQ7kNvwFLOy7i&_nc_oc=AdrE8x5Y5qxzUNs0o7MXYSgNkkO9rmXe0ePFvXmTMcUvkAH00rB5EexW3jBZq0ONyb8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqXUIn1XWgYSTVXpdpGHFFO-OT7-UXUUW6DFOKF7a2jA&oe=6AA94B76"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Maski VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1492585200, "lastRevision": {"nodes": [{"id"
ge.png", "id": "2477131559203817", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12449036_400864693601963_7345112744447705088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cotYIIGkCz8Q7kNvwGil8Lz&_nc_oc=AdmX2kCE3eh2U68Qbp_DLsgiVDoTgwvRK3dbEx9Cf9gQfojJtpaEh-mGX5yAUYd7R-w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvJmLMVOAQh-6J2PjApJgblQV8x4AEps1yr9kiq41rllA&oe=69A5A023"}, {"file_name": "migrated_image.png", "id": "1211747442329297", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12427564_1860028620877760_5437187408552525824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUKol2T2OCIQ7kNvwE5Ymek&_nc_oc=Adn4cSa4rXGo_Kjtgj5SqTO1QNx9E3ozAC8_qBcLAt0mFo22zvsBs2dFxUn62dUWG_k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afu2vx7170bVIduOiKLoMpMsvzBkldr0VInoLDMsjj5AeA&oe=69A59859"}, {"file_name": "migrated_image.png", "id": "1132468973770173", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12533842_278759825895480_2713575254034219008_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ud_GfuA0paIQ7kNvwHu3dZ2&_nc_oc=AdkL13TsU5h1oXzd_gNQpOsYzuDrzYFN5Ym0CxPyjXhN7Tyyyh8zCXEH2rZ4QB5bfgA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftsFjY9WoDFCJr75XYeoNznlXG9xFgpgRRfLXsqPnnXrQ&oe=69A5770F"}, {"file_name": "migrated_image.png", "id": "208394603742873", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12533842_398465947200146_946885846039003136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CK7JjbmVAKgQ7kNvwEGsEyJ&_nc_oc=Adm4HdqJPgRF9hGjYVhApQi9fFw6ehAjWXaf3kD22vtctYndCh1wMj2v8PPwc_3fqiY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftYHJnIQMMMljrDlDcEh3cp61fHDWrHXT0R7y_C9gRAaQ&oe=69A56AB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maski VR", "keywords": ["Episodes", "Comedy", "Series", "Slapstick", "360video"], "long_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm.\n2016 marked the 25th anniversary of the television slapstick comedy series \u2013 \u201cMaski-Show\u201d!\nTo mark this significant date, AFL Productions decided to make a present to \u201cMaski\u201d and Virtual Reality Fans by launching a VR application for the revered comic troupe. Now, fans will be able to download all 8 episodes from the first season, 2 of which will be presented absolutely free.\nThe post-production design was carried out by one of the pioneers in the field of Virtual Reality, Chingis LLC. During 3 years of diligent work, the company has developed more than 80 cases in both AR and VR spheres. At the same time, more than 20 years of wide experience in Video Design open the doors for Chingis to help in creation of the most famous \u201cMaski\u201d project, that was filmed and recreated in the 3D 360-format of high definition video. ", "short_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "developer_terms_of_service_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "publisher_name": "MERIOT, LLC.", "support_website_url": null, "website_url": "http://www.aflproductions.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1228607547678266"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffe
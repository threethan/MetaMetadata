n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-QdR2F6K38Q7kNvwFC5vAx&_nc_oc=Adpjbiya92uZn_bCgyFYqV74lsitV2-6ySJT7ekGIySSb47dVSQPQwRWpgkX5fdZvPs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ezNU5H5R7GMakPeymRcEvShVhlMZ1ouXinEyt27yz2Q&oe=6A185573"}, {"file_name": "migrated_image.png", "id": "574104920127947", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12427564_1860028620877760_5437187408552525824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gqfYqGkwHkQ7kNvwE6E2-T&_nc_oc=AdochIkEgZKZLr7JThjCANGfGl9H0efC5j1KRKCVSfRXyQXglZYv_RSRcCn4_bTmiFo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t1Vqz3oH_vXTj4KkH3tgJ95eJVjVc2lWUwqFxfi1Www&oe=6A184AD9"}, {"file_name": "migrated_image.png", "id": "227707755266707", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12533842_278759825895480_2713575254034219008_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydCUHeOXAoYQ7kNvwHakTpR&_nc_oc=AdpyKmD_UVNryQq_PHMPU6urCO14AoBRjZqvH_yBLtMqiY4wg9A45dzSrzNNQmWqLyU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UsWnQAWJeiLHmkDQN19_5gdP7G8naSzoD8xFDIau3NA&oe=6A1861CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maski VR", "keywords": ["Episodes", "Comedy", "Series", "Slapstick", "360video"], "long_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm.\n2016 marked the 25th anniversary of the television slapstick comedy series \u2013 \u201cMaski-Show\u201d!\nTo mark this significant date, AFL Productions decided to make a present to \u201cMaski\u201d and Virtual Reality Fans by launching a VR application for the revered comic troupe. Now, fans will be able to download all 8 episodes from the first season, 2 of which will be presented absolutely free.\nThe c\u043emic troupe \u201cMaski\u201d gained international acclaim from their initial appearance. Successfully traveling the world, creating a new repertoire of live performances and developing their own style of clown theater based on silent cinema, the comic troupe \u201cMaski\u201d didn't stop there.\nThe post-production design was carried out by one of the pioneers in the field of Virtual Reality, Chingis LLC.", "short_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "developer_terms_of_service_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "publisher_name": "MERIOT, LLC.", "support_website_url": null, "website_url": "http://www.aflproductions.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "615786576158409"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139051_800492883433059_2164792220173991936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIK93wb2JykQ7kNvwEgBoAb&_nc_oc=AdqP38Es_9DPGTnWYhY5kstHVXti5JuI2sg7Z5JETTFBF3V-yFhjNcOhchAT6e9KJwU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W-ni_LdfopbvXi8GPNzpXlVhXDKzTiMR9q1uAcG6WIg&oe=6A184676"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Maski VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1492585200, "lastRevision": {"nodes": [{"id": "1403647
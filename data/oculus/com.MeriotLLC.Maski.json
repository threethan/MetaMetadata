n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0a7H62OSOQYQ7kNvwHtzTqI&_nc_oc=Adob5jDxQLWoM8YDrH2yhj32JxDZ4MAyxokajZ9D-gqXEC97uMxcLll6F9_BcKpDvD8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsXj0t1e1ZF_PElX5Lo_XNr0b0lCd2ImZNOiiL5bPZrQ&oe=6A60D7F3"}, {"file_name": "migrated_image.png", "id": "574104920127947", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427564_1860028620877760_5437187408552525824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7z-9OH-8EMQ7kNvwHXWMhz&_nc_oc=AdpWndb_ndDu1el0xSGGc5WiXrn7fKg8rhO5dW_PvWZnczBPOI20P4MnymjPmo1pn8E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYMw3uJjs0dqy-8YeTfJyC1MB8cRLiGCGFQ_KHUD53VQ&oe=6A60CD59"}, {"file_name": "migrated_image.png", "id": "227707755266707", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12533842_278759825895480_2713575254034219008_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEPZhNg61WgQ7kNvwFB3Sam&_nc_oc=AdqZwiXWPtTS6RSdivWlZTBzsnA1l4CCElBYtH1ZG6T_h41RmpAnVLKxldzvSDtDiPw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALyNagEFcAL_f_sVc9OkuzzTh9FoOFmOeR3cX2iHgWbw&oe=6A60AC0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maski VR", "keywords": ["Episodes", "Comedy", "Series", "Slapstick", "360video"], "long_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm.\n2016 marked the 25th anniversary of the television slapstick comedy series \u2013 \u201cMaski-Show\u201d!\nTo mark this significant date, AFL Productions decided to make a present to \u201cMaski\u201d and Virtual Reality Fans by launching a VR application for the revered comic troupe. Now, fans will be able to download all 8 episodes from the first season, 2 of which will be presented absolutely free.\nThe c\u043emic troupe \u201cMaski\u201d gained international acclaim from their initial appearance. Successfully traveling the world, creating a new repertoire of live performances and developing their own style of clown theater based on silent cinema, the comic troupe \u201cMaski\u201d didn't stop there.\nThe post-production design was carried out by one of the pioneers in the field of Virtual Reality, Chingis LLC.", "short_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "developer_terms_of_service_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "publisher_name": "MERIOT, LLC.", "support_website_url": null, "website_url": "http://www.aflproductions.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "615786576158409"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139051_800492883433059_2164792220173991936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=my7Xl103jq8Q7kNvwF0LFKZ&_nc_oc=AdrsF658G5TF9251P7ZzmHLcedYKeAexbf3uwsMromHYhwFrXyB14YxGWQtrnipRj4o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDBcdqYfcp-I_J6STOWcTmp1GPmfgCc2eTRVsGB-j2zQ&oe=6A60C8F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Maski VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1492585200, "lastRevision": {"nodes": [{"id": "1403647
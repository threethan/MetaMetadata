&oh=00_AQXT-MWEmzpkmTitNfjtW0WO3dld1zkSZJiLqELd0hsrdQ&oe=6B1064E3"}, {"file_name": "migrated_image.png", "id": "751017925425450", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533842_398465947200146_946885846039003136_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03VnwkwSfZUQ7kNvwGOAQhd&_nc_oc=AdqLW05ju4DNNElgXcg0JGeXL0vVOGBj6g28YnDvQPm7lW6a9xzSxeLbTP6JFACKWrU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUh_Yf-XnzOf9Gr6fibq8mMLU08y5csIN7H34Qw_lKk-w&oe=6B1067B3"}, {"file_name": "migrated_image.png", "id": "574104920127947", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427564_1860028620877760_5437187408552525824_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDYd9atKFF4Q7kNvwEBb4bu&_nc_oc=Adp2vB6q7tslwJD3aemxtxn8AHCfZL_91a4J4puad67hnQerVBNTVr0XC1wrLkg3L54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWqFMy7jFJVrCOLOp4v8ztdGqQa4YAhDYGz2JA8dBqYrg&oe=6B105D19"}, {"file_name": "migrated_image.png", "id": "227707755266707", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533842_278759825895480_2713575254034219008_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxCXd3gHPh0Q7kNvwHJa4Ha&_nc_oc=AdrJ0GZlnpCmyeQhpqkCjlgA88n2_oqHvbNvGIq8yO7ty8cVZvswB4nCxnFxGk5HfBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWbIKz5hVA0k7DstT2gMFl-tdXQTw9YzoP-tPEroBErCw&oe=6B103BCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maski VR", "keywords": ["Episodes", "Comedy", "Series", "Slapstick", "360video"], "long_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm.\n2016 marked the 25th anniversary of the television slapstick comedy series \u2013 \u201cMaski-Show\u201d!\nTo mark this significant date, AFL Productions decided to make a present to \u201cMaski\u201d and Virtual Reality Fans by launching a VR application for the revered comic troupe. Now, fans will be able to download all 8 episodes from the first season, 2 of which will be presented absolutely free.\nThe c\u043emic troupe \u201cMaski\u201d gained international acclaim from their initial appearance. Successfully traveling the world, creating a new repertoire of live performances and developing their own style of clown theater based on silent cinema, the comic troupe \u201cMaski\u201d didn't stop there.\nThe post-production design was carried out by one of the pioneers in the field of Virtual Reality, Chingis LLC.", "short_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "developer_terms_of_service_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "publisher_name": "MERIOT, LLC.", "support_website_url": null, "website_url": "http://www.aflproductions.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "615786576158409"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139051_800492883433059_2164792220173991936_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTLE1kGfQK8Q7kNvwEd-Eq6&_nc_oc=AdpfN3KzUdX3usy97NhPZwPN8XG2OeodR-Ov--fQvbNDPsRR5YBoJjjGccXQaOjs2k8&_nc_zt=3&_nc_ht=scontent-iad
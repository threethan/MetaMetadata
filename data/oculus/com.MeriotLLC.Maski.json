ge.png", "id": "2477131559203817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12449036_400864693601963_7345112744447705088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQYuEEug6YUQ7kNvwHgTv6e&_nc_oc=AdlE6XQ-o4vvhRR9ZMWZJ2DGokN6XT4SKD8pi3wjf0g_Ykz8SI4pbOUSW-ii5-MBIvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afseat5N8e8Yd6PupuevuSZOi1ubPHEetAek45aOFYZO9w&oe=699C65A3"}, {"file_name": "migrated_image.png", "id": "1211747442329297", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427564_1860028620877760_5437187408552525824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sybOslYqHcQ7kNvwH9pN1e&_nc_oc=AdmqqGYZG7FO9FOX8iBt_eeSbE02aSA1fffVlTvd_rDpKvEQ1optvjMIXdLU1UR3XDs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfucJsU9Iv1wQRWOqlDFUNyvQtSiMQB3yWnIRA0bhjR1Yg&oe=699C5DD9"}, {"file_name": "migrated_image.png", "id": "1132468973770173", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533842_278759825895480_2713575254034219008_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndoCeyzgyLQQ7kNvwHYmmA0&_nc_oc=AdnCur-RKawitE8cRAwMEkzFqJZV31hP7l1G76Lke6kSNgWuT2vtDenOe7CpoSGj2SM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftpTRnO9bkAGBdQsxGh5yKSQoX4mbHf6pweE2QWibiK5g&oe=699C3C8F"}, {"file_name": "migrated_image.png", "id": "208394603742873", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533842_398465947200146_946885846039003136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AakgmQjRdLAQ7kNvwH9VOM5&_nc_oc=Adl5GF-PNtfe8AVaCyg4dCcD3Ag4DaPY0c7zhZUXEmPdVAKzOOj--fFW-IntTabz_r8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfskOEdZXBMIQPCJ1eS5Mw19fre_NH7S1XNbs593KgS5Ng&oe=699C6873"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maski VR", "keywords": ["Episodes", "Comedy", "Series", "Slapstick", "360video"], "long_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm.\n2016 marked the 25th anniversary of the television slapstick comedy series \u2013 \u201cMaski-Show\u201d!\nTo mark this significant date, AFL Productions decided to make a present to \u201cMaski\u201d and Virtual Reality Fans by launching a VR application for the revered comic troupe. Now, fans will be able to download all 8 episodes from the first season, 2 of which will be presented absolutely free.\nThe post-production design was carried out by one of the pioneers in the field of Virtual Reality, Chingis LLC. During 3 years of diligent work, the company has developed more than 80 cases in both AR and VR spheres. At the same time, more than 20 years of wide experience in Video Design open the doors for Chingis to help in creation of the most famous \u201cMaski\u201d project, that was filmed and recreated in the 3D 360-format of high definition video. ", "short_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "developer_terms_of_service_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "publisher_name": "MERIOT, LLC.", "support_website_url": null, "website_url": "http://www.aflproductions.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1228607547678266"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffe
&oh=00_AQRzLpczH-3nj_5IR7j8RnYF51ghRnxPPHUFiiL2bp-L_A&oe=6AFF0923"}, {"file_name": "migrated_image.png", "id": "751017925425450", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12533842_398465947200146_946885846039003136_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SUZzTCFc1IQ7kNvwGKF9wO&_nc_oc=AdoBvA490gMGXPS4wHfr9mVOfdtost8HUS4OH1NljFWzoFDw-GTqk9CvPlZtbSYhtSk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9EfWWxy36ms4RlGDj5Kt5c-D1wgUFBoOBukE297WrEQ&oe=6AFF0BF3"}, {"file_name": "migrated_image.png", "id": "574104920127947", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12427564_1860028620877760_5437187408552525824_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5H_-YOBKdIQ7kNvwHokMqs&_nc_oc=AdoLO4ZlpOqVEmA-8LGPPqIFeqEgjzM9f_yoktaqXqKEqk7WZl8KXzEUNmDSS4A6k14&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN5eP1edFu7Zj-0p4qhtAPIZ33pJunhzTpBXUAGwomZg&oe=6AFF0159"}, {"file_name": "migrated_image.png", "id": "227707755266707", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12533842_278759825895480_2713575254034219008_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L68L0bmiHJsQ7kNvwEVFDMo&_nc_oc=Adqm6KJrOc100zRLDbje3gZpSvFQ54EqeNpN6ZpDeM2jrqQRdYMgbtSnk9qWDvekVD4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKYWQmW2C1X_cPishspwAjW4N8kDO3Itc8-dS_VLzfdA&oe=6AFF184F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maski VR", "keywords": ["Episodes", "Comedy", "Series", "Slapstick", "360video"], "long_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm.\n2016 marked the 25th anniversary of the television slapstick comedy series \u2013 \u201cMaski-Show\u201d!\nTo mark this significant date, AFL Productions decided to make a present to \u201cMaski\u201d and Virtual Reality Fans by launching a VR application for the revered comic troupe. Now, fans will be able to download all 8 episodes from the first season, 2 of which will be presented absolutely free.\nThe c\u043emic troupe \u201cMaski\u201d gained international acclaim from their initial appearance. Successfully traveling the world, creating a new repertoire of live performances and developing their own style of clown theater based on silent cinema, the comic troupe \u201cMaski\u201d didn't stop there.\nThe post-production design was carried out by one of the pioneers in the field of Virtual Reality, Chingis LLC.", "short_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "developer_terms_of_service_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "publisher_name": "MERIOT, LLC.", "support_website_url": null, "website_url": "http://www.aflproductions.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "615786576158409"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139051_800492883433059_2164792220173991936_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XphHiUcT3cQ7kNvwG-IJfE&_nc_oc=AdouY8lJ462SPUKD16BsJknfQoL7MmZKGPq5ko4WyN19gZwLW-axxCbypKxtve93EW0&_nc_zt=3&_nc_ht=scontent-sea
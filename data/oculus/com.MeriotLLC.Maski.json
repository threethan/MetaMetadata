9003136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Lz28OTHLiAQ7kNvwG5RgQo&_nc_oc=AdpF_YieaLvuDomd7yRd9IeMTsvYx-PAbAGiebgvoE3vjlK43RspdgrDCUgp2PBP5Fo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uxWh_9S5tv1mckbp1fOfHrW0xRo_F6hJsg3sOovXaGg&oe=6A11BDF3"}, {"file_name": "migrated_image.png", "id": "574104920127947", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12427564_1860028620877760_5437187408552525824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o845pKoKK94Q7kNvwGm5jRl&_nc_oc=AdqcHKtL6qu9aM4hwHwZh2d9cG3Wzc8HG3Yr9dCCYhnZQvLqgZOuWFWsTYFJtK3XX6w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L0EN86GTDdEnBe8AgqJVYLoWsoNjY20LzUfxXG6Nzsw&oe=6A11B359"}, {"file_name": "migrated_image.png", "id": "227707755266707", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12533842_278759825895480_2713575254034219008_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWjvkUptfPUQ7kNvwEuiLz5&_nc_oc=AdrXaYP8ELDf61Rc8lhy4xHbVgrCYXhsCjz4M0hiCMTAsodTinOM75mzPA1oTvyv0L0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53z5_c-_JtSKSvSpiBeIlmFu292H-5Zj6VpsbTL5Fcqg&oe=6A11CA4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maski VR", "keywords": ["Episodes", "Comedy", "Series", "Slapstick", "360video"], "long_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm.\n2016 marked the 25th anniversary of the television slapstick comedy series \u2013 \u201cMaski-Show\u201d!\nTo mark this significant date, AFL Productions decided to make a present to \u201cMaski\u201d and Virtual Reality Fans by launching a VR application for the revered comic troupe. Now, fans will be able to download all 8 episodes from the first season, 2 of which will be presented absolutely free.\nThe c\u043emic troupe \u201cMaski\u201d gained international acclaim from their initial appearance. Successfully traveling the world, creating a new repertoire of live performances and developing their own style of clown theater based on silent cinema, the comic troupe \u201cMaski\u201d didn't stop there.\nThe post-production design was carried out by one of the pioneers in the field of Virtual Reality, Chingis LLC.", "short_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "developer_terms_of_service_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "publisher_name": "MERIOT, LLC.", "support_website_url": null, "website_url": "http://www.aflproductions.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "615786576158409"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12139051_800492883433059_2164792220173991936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JErKo1A6oG4Q7kNvwGfk0Ln&_nc_oc=Adpn8BDtLlSQQB2AXlgZ1rX9FRO-QhTEJsUbiPa3Cr1aU5ZQaMaqFf05GeOwNILmDFg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IWkCMql-4WCeRJPZqUYlgPAwJ6Y7CskIsuSZGQn9hcg&oe=6A11AEF6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Maski VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1492585200, "lastRevision": {"nodes": [{"id"
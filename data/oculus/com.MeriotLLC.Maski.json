ge.png", "id": "2477131559203817", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12449036_400864693601963_7345112744447705088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEjiQU0444oQ7kNvwGmdc__&_nc_oc=AdmPNqboUHZvkSS2TGezndw-R9fchIKImuLlZQzeCQfpCiQ9cnPFq_5SNBhKfE1XeCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftt2gCIXv1Jk9GsKawVj-PxwnNbzSEAqo_eOU472KSflg&oe=69A05A23"}, {"file_name": "migrated_image.png", "id": "1211747442329297", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12427564_1860028620877760_5437187408552525824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Z8dFRU02UUQ7kNvwHs5gp6&_nc_oc=AdkIMlvoOrHjb92DCfMg1v4d10GZ4_jyLUE5u3ev5JQzhhOz0GAYqsYw8ELPIMOpeKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft7HVwh23_PXhiiILlt4WlBgW27NFthIGxOsaZvfytI8A&oe=69A05259"}, {"file_name": "migrated_image.png", "id": "1132468973770173", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12533842_278759825895480_2713575254034219008_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rmez8ZLOrBMQ7kNvwE0x9AV&_nc_oc=AdmdkLBVkRBFgkrtb94_bfZ4AGcS0fAlo1C0L5ofrHquRSQKtV-RpKo1uD1kKY_USqE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afty7iQL4z68Y-cuIkglbl5-TPzpL6NNQlqETZQzSBmBOw&oe=69A0310F"}, {"file_name": "migrated_image.png", "id": "208394603742873", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533842_398465947200146_946885846039003136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8xp4lP8awYQ7kNvwGub4Bn&_nc_oc=AdnO_2cuts1Qcyxf2iMwzrFfO8XUR72EVef8_O7jpuxnuHOm4aRx2Q9aCtJ9Th2vHFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvs5u3aLV2nIaCGq0YzDDjtn0y691IHfJJ8AWeCdCr4jw&oe=69A024B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maski VR", "keywords": ["Episodes", "Comedy", "Series", "Slapstick", "360video"], "long_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm.\n2016 marked the 25th anniversary of the television slapstick comedy series \u2013 \u201cMaski-Show\u201d!\nTo mark this significant date, AFL Productions decided to make a present to \u201cMaski\u201d and Virtual Reality Fans by launching a VR application for the revered comic troupe. Now, fans will be able to download all 8 episodes from the first season, 2 of which will be presented absolutely free.\nThe post-production design was carried out by one of the pioneers in the field of Virtual Reality, Chingis LLC. During 3 years of diligent work, the company has developed more than 80 cases in both AR and VR spheres. At the same time, more than 20 years of wide experience in Video Design open the doors for Chingis to help in creation of the most famous \u201cMaski\u201d project, that was filmed and recreated in the 3D 360-format of high definition video. ", "short_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "developer_terms_of_service_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "publisher_name": "MERIOT, LLC.", "support_website_url": null, "website_url": "http://www.aflproductions.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1228607547678266"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffe
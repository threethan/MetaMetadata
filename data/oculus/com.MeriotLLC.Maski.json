n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUK9jSNlCAUQ7kNvwGW8UN_&_nc_oc=AdqSVFJ17dhaePOzz9En8KVkauoS7UBZsn3Ap2QwchL-gYBk0eN1BdZEMvs9NT56aVk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YgZjXaB5oIpI78NBhAuhDtZsMQyds5jvRb3BkLXoYfQ&oe=69FA02F3"}, {"file_name": "migrated_image.png", "id": "574104920127947", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427564_1860028620877760_5437187408552525824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eET6JOCcTUQ7kNvwHaWRBQ&_nc_oc=AdrPUF3gP8MMBNRM2-c6MSxSyrF1PeBZXQdR9c6UqyJBqI1X9VELpN1RieufddOQUXY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Pv3gMj22SdO4a_ii43WrD7NlA9_kXkX_zV2v86GgWOw&oe=69F9F859"}, {"file_name": "migrated_image.png", "id": "227707755266707", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533842_278759825895480_2713575254034219008_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2ck8HrhLc0Q7kNvwFKd0aK&_nc_oc=AdrVYxYVvzK5sYNg9JkHajuwdCyfFVNgPMWj4gkXZfMigBsE2Zeg8pV_opt5BRGsCmw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IGr-7SaiB-ly62AcRxboZmoa-BbD3XxF2sJpQHySAzw&oe=69FA0F4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maski VR", "keywords": ["Episodes", "Comedy", "Series", "Slapstick", "360video"], "long_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm.\n2016 marked the 25th anniversary of the television slapstick comedy series \u2013 \u201cMaski-Show\u201d!\nTo mark this significant date, AFL Productions decided to make a present to \u201cMaski\u201d and Virtual Reality Fans by launching a VR application for the revered comic troupe. Now, fans will be able to download all 8 episodes from the first season, 2 of which will be presented absolutely free.\nThe c\u043emic troupe \u201cMaski\u201d gained international acclaim from their initial appearance. Successfully traveling the world, creating a new repertoire of live performances and developing their own style of clown theater based on silent cinema, the comic troupe \u201cMaski\u201d didn't stop there.\nThe post-production design was carried out by one of the pioneers in the field of Virtual Reality, Chingis LLC.", "short_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "developer_terms_of_service_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "publisher_name": "MERIOT, LLC.", "support_website_url": null, "website_url": "http://www.aflproductions.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "615786576158409"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139051_800492883433059_2164792220173991936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScWPSNA1nPkQ7kNvwGipxmu&_nc_oc=AdpwH7v2TZ895_WSRkw_JqlQz1ouNZD6N8fuNJ1VAcP92Z-LJE7sipVgwMMZ9oiNZnk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4inJr3deOUPQwBr0iIK0_Ml9EldH_GuMHy6oX3TbQoDw&oe=69F9F3F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Maski VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1492585200, "lastRevision": {"nodes": [{"id": "1403647
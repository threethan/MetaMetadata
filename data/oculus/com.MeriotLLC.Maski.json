&oh=00_AQQC3MoUkveoPRn7Q6opKC_RXxY4d0VElxrtH30-CB6wZA&oe=6B0335E3"}, {"file_name": "migrated_image.png", "id": "751017925425450", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12533842_398465947200146_946885846039003136_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcWg6spiUEcQ7kNvwHlBj0l&_nc_oc=Adq51ufdk2ZbC3ekcdZXmeZ3dgIPGtRKUrxUeKGMKz-Yv9w6u2G7TZdoqiD6WCC1zdE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUf6wv-Ptummy9vi9zReD5wyRrbW89Q_0r5Ded8tM2VA&oe=6B0338B3"}, {"file_name": "migrated_image.png", "id": "574104920127947", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12427564_1860028620877760_5437187408552525824_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5lO4Q3N3rQQ7kNvwGqjME-&_nc_oc=AdoP3EHBk8IY6IAZhZtamnAqOsmilDQ58LQIv4AEL3VpsPsWe5jycn9snIq2KYrxVrE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShpVlvonhMSMq_tsH1MAg6pn5luVjLbGEMlSUNOjtPlA&oe=6B032E19"}, {"file_name": "migrated_image.png", "id": "227707755266707", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533842_278759825895480_2713575254034219008_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfhDIbdYy_IQ7kNvwGw8sO1&_nc_oc=Ado63XKXBjeroDl1z1UIvpBNRZsX5OJEChrMGk0QGCbWYXOCHhIknC_57ask5e4Xk24&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTn7vrPyTNfw07O7kXeZQXCO3TUnVOD4pOmU8-f0vVuiA&oe=6B030CCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maski VR", "keywords": ["Episodes", "Comedy", "Series", "Slapstick", "360video"], "long_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm.\n2016 marked the 25th anniversary of the television slapstick comedy series \u2013 \u201cMaski-Show\u201d!\nTo mark this significant date, AFL Productions decided to make a present to \u201cMaski\u201d and Virtual Reality Fans by launching a VR application for the revered comic troupe. Now, fans will be able to download all 8 episodes from the first season, 2 of which will be presented absolutely free.\nThe c\u043emic troupe \u201cMaski\u201d gained international acclaim from their initial appearance. Successfully traveling the world, creating a new repertoire of live performances and developing their own style of clown theater based on silent cinema, the comic troupe \u201cMaski\u201d didn't stop there.\nThe post-production design was carried out by one of the pioneers in the field of Virtual Reality, Chingis LLC.", "short_description": "\u201cMaski VR\u201d is the first non-dialogue comedy series in the Virtual Reality Realm."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "developer_terms_of_service_url": "http://www.aflproductions.com/images/2017/viar/Privacy_policy_Maski_VR.pdf", "publisher_name": "MERIOT, LLC.", "support_website_url": null, "website_url": "http://www.aflproductions.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "615786576158409"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139051_800492883433059_2164792220173991936_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNd20-Sc4LwQ7kNvwHcO7HT&_nc_oc=AdoWldp59NRR5GBm9bbLjmI3hF2denphTWSRecZsJoyOrbsKgGE-83A4YpS7nTa_Tf8&_nc_zt=3&_nc_ht=scontent-sjc
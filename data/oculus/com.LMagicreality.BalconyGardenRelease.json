I-xACku5lmK66fECVc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHibQm0Jmu1u_F8ygGLsD8q_DMTR3qEYPijbwlG4nOPUw&oe=6A845AF2"}, {"file_name": "Image5.png", "id": "4248670872084567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618284_4248670875417900_231133374886497440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqgE_ks26ccQ7kNvwG1M3DO&_nc_oc=Adp0ydraP0DEOHv5UT28PVuHoHjciwcGD1UlmuYKZM3md39jlz7-VKwYVoFhg1m6laU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiooCbrS6hCr8pdUP3-KchGejmVmOPUECgrY6EGwTbfQ&oe=6A843738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Game Name.png", "id": "9510434352414022", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820559_9510434359080688_3458326697162279646_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9K3WYhFZPtQQ7kNvwG3YgNy&_nc_oc=Adr2yeJy6Asn4G29TkNo0vQyROnrFzrgqlYLwbpnE1vDIM8XGQxxYX2wOLXIfV-tpHU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGks0fkhOzzXnSfP3boz7D_HwagElZcL_XlBo88cfd5CA&oe=6A8437A7"}, "display_name": "Balcony Garden", "keywords": ["balcony", "garden", "grow", "flower", "plant"], "long_description": "**Play at Balcony Garden for a chance to win real flowers!!!**  \na cozy, stylized gardening game set on a peaceful balcony. It\u2019s all about growing beautiful plants, relaxing, and enjoying a slow-paced, soothing experience\n# Features:  \n**\ud83c\udf3c Grow over 75 different types of plants, including flowers, aquatic plants, fruits, and vegetables \u2014 with a main focus on flowers**  \n  \n**\ud83d\uddfa\ufe0f Discover rare, beautiful, and uniquely shaped plants from across all seven continents, these plants are inspired by real-world botanical wonders \u2014 strange, exotic, and visually stunning**  \n  \n**\ud83d\udca6 Water, fertilize, and weed your garden, each action influences how your plants grow and thrive**  \n  \n**\ud83c\udf27\ufe0fEnjoy a dynamic weather system rain, sunshine, clouds, and more \u2014 changing the mood and visuals of your garden**  \n  \n**\ud83e\uddd8 No grinding, no clutter \u2014 just pure gardening and chill vibes, you only need to buy seeds; everything else flows naturally**\n  \n**\ud83c\udf19 Go to sleep, then watch your plants grow, time moves gently \u2014 and every morning brings surprises**  \n  \n**\ud83d\udc3f\ufe0f Interact with small animal visitors from squirrels to birds, you can feed them, play with them, and enjoy their company.**", "short_description": "play at Balcony Garden for a chance to win real flowers\uff01\uff01\uff01growing beautiful plants, relaxing, and enjoying a slow-paced, soothing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/ShiSuoGameStudio/LMagicRealityStudioPrivacyPolicy/blob/main/LMagic%20Reality%20Policy.txt", "developer_terms_of_service_url": null, "publisher_name": "LMagic Reality Studio", "support_website_url": null, "website_url": "http://www.lmagicreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26099307153004291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308056_2049419965870081_2241494842159759840_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJQgY_nAiS8Q7kNvwERsDYw&_nc_oc=AdpWyVlQ7PFtxqaVwLoDGvjDBeyceq3xvYuIjBPpgT
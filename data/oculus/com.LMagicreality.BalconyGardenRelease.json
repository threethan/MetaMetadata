rWBTaWG2TFhe0kkDyZbsSF1sC4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLll8VIsDXud7Wu1EbzxZxQjut9IdxwKyTnnzP4zFupjw&oe=6AAE8AF2"}, {"file_name": "Image5.png", "id": "4248670872084567", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618284_4248670875417900_231133374886497440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9EpqCBPphIQ7kNvwExm3hl&_nc_oc=Adpx4vRIetomIFcBh8hRkmFVpSp-gSCdMTHlC_9iyE_uWYTjpJUrKj3_2jfBfz9wZ5A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkPIsE_Grav4xZLtIKnQbvRc9NyHLQVx4pea8Lu_8PIQ&oe=6AAE9F78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Game Name.png", "id": "9510434352414022", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491820559_9510434359080688_3458326697162279646_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpP5ewed7HwQ7kNvwFGxb75&_nc_oc=AdpVvjCGx0oY3My5UVgTvuAhICI2N3FGSsT3yrVYrqUHpGnzlQHCqx0kis21p22qnP4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI7igKd5WV4a8bFHGqs-eIfx-7PmITfYENlj_qqfWj9w&oe=6AAE9FE7"}, "display_name": "Balcony Garden", "keywords": ["balcony", "garden", "grow", "flower", "plant"], "long_description": "**Play at Balcony Garden for a chance to win real flowers!!!**  \na cozy, stylized gardening game set on a peaceful balcony. It\u2019s all about growing beautiful plants, relaxing, and enjoying a slow-paced, soothing experience\n# Features:  \n**\ud83c\udf3c Grow over 75 different types of plants, including flowers, aquatic plants, fruits, and vegetables \u2014 with a main focus on flowers**  \n  \n**\ud83d\uddfa\ufe0f Discover rare, beautiful, and uniquely shaped plants from across all seven continents, these plants are inspired by real-world botanical wonders \u2014 strange, exotic, and visually stunning**  \n  \n**\ud83d\udca6 Water, fertilize, and weed your garden, each action influences how your plants grow and thrive**  \n  \n**\ud83c\udf27\ufe0fEnjoy a dynamic weather system rain, sunshine, clouds, and more \u2014 changing the mood and visuals of your garden**  \n  \n**\ud83e\uddd8 No grinding, no clutter \u2014 just pure gardening and chill vibes, you only need to buy seeds; everything else flows naturally**\n  \n**\ud83c\udf19 Go to sleep, then watch your plants grow, time moves gently \u2014 and every morning brings surprises**  \n  \n**\ud83d\udc3f\ufe0f Interact with small animal visitors from squirrels to birds, you can feed them, play with them, and enjoy their company.**", "short_description": "play at Balcony Garden for a chance to win real flowers\uff01\uff01\uff01growing beautiful plants, relaxing, and enjoying a slow-paced, soothing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/ShiSuoGameStudio/LMagicRealityStudioPrivacyPolicy/blob/main/LMagic%20Reality%20Policy.txt", "developer_terms_of_service_url": null, "publisher_name": "LMagic Reality Studio", "support_website_url": null, "website_url": "http://www.lmagicreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26099307153004291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499308056_2049419965870081_2241494842159759840_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIPq_4z_EBEQ7kNvwHSIn26&_nc_oc=AdqZIIeVXpuc-lfx-UhCtnelKVuD-
_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS98ZYj9QKZWfwvibPCNKoWHsIVwJRvV_5JLOyWvG5rZw&oe=6B030F9A"}, "display_name": "Clean Energy Smart Home", "keywords": [], "long_description": "Have you ever wondered what it takes to become carbon neutral? If so, you\u2019re in luck. In our Clean Energy Smart Home, you\u2019ll interact with all the ways you can reduce your carbon output while increasing your energy savings. \nKey Clean Home Features:  \n - Seal up leaky ducts in your house. \n- Use a multitool to replace your old lightbulbs with Light-Emitting Diode (LED) bulbs. \n- Cook a burger on your electric stove. \n- Choose a new electric vehicle and plan a road trip. \n- Swap out old appliances for new ones. \n- Gain a new appreciation for what it means to be carbon neutral. \n", "short_description": "Have you ever wondered what it takes to become carbon neutral? If so, you\u2019re in luck. In our Clean Energy Smart Home, you\u2019ll interact with all the ways you can reduce your carbon output while increasing your energy savings. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sce.com/privacy/mobile-app-privacy", "developer_terms_of_service_url": null, "publisher_name": "Southern California Edison Company", "support_website_url": null, "website_url": "https://sce.com/gogreen", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "
118970948680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mA4wdypTF4IQ7kNvwFWkHeQ&_nc_oc=AdraHV560OxH6HyiJgcw2BWSRhaXWhQH1hNnhLaAwJViAwHMD3jtTebPY5UK3xwLscc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI9Jeq-YeL_dOw2QgbTUFLpjogmVLvB8yAzJ3LlXYThg&oe=6A4D15FA"}, {"file_name": "4.png", "id": "464023283443345", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_464023286776678_5054891083823893912_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oWSaKeq-HMQ7kNvwGpXSNW&_nc_oc=AdoPHFGO4m336KzUCV2BoC34I3yBfaLv-ZcTNrcarSsKINUVMGHl90zivyBC9McK3e0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcyJBxVzfqXlOktrQeNY2mWkS27MNqMm9kZHvN7mLaqw&oe=6A4D14A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1605927180064005", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391937_1605927183397338_542796705772801359_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDDZDzzLYcYQ7kNvwHAcF8C&_nc_oc=AdoE0OjiyXp4_4CiWxB3aIcdanrPk3iLDnAc76X2HyCCo-HVwHeIeHRXPUI363Lw9aA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvzirhxs0etRYWLFWdNnSRrUcD9Ii7t3SuZwXmzlUd6Q&oe=6A4D1948"}, "display_name": "Ski", "keywords": ["ski", "skiing", "alps", "sport", "endless"], "long_description": "Strap on your virtual skis and dive into a dynamic world of procedurally generated slopes with two exciting modes: Free Ride, where you ski endlessly with no objectives, and Ring Challenge, where you aim to pass through rings scattered along the slope to score points. Whether you're striving to beat your high score or simply enjoying the ride, the game offers a fun experience every time you hit the slopes.", "short_description": "Experience the thrill of endless skiing on procedurally generated slopes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "supp
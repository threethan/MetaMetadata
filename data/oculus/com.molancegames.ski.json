118970948680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsfchtohYKQQ7kNvwE1tB-M&_nc_oc=Adrccmtywd31iuIcm_0hCs1o_3Vy1-ABBqXAIE1YD2EF8yeZVIJCSzAPcGb8vVVwXKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYJD7VtWewVFoRe-pyA-d4HHRbqgXJlUK4VINMnwL_Rw&oe=6A49217A"}, {"file_name": "4.png", "id": "464023283443345", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_464023286776678_5054891083823893912_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1AlUuDDaIgQ7kNvwF45X49&_nc_oc=Adom1fcHSaoaWDcvUwBxHwFNGY5N93AOVWo4Vpk0kFQtblveoGVfA5DH62ASwtiuavI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZYgTJWoWrqz9xxvC9k2m2ixE9KE8XWeVZP9nFHjb9MQ&oe=6A492028"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1605927180064005", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391937_1605927183397338_542796705772801359_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NEqSSCmcVgQ7kNvwHAsC5I&_nc_oc=AdqWDstMr6GIyjebU6B_ShWmhv-u9Ncs0kAUVuZxGdfqV2rVYhuGGJnwtKKV4El_oiI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo3GZS9oztOGNNjaJo77dBJDkHtIOT2EsUw2wc3fJ7CA&oe=6A4924C8"}, "display_name": "Ski", "keywords": ["ski", "skiing", "alps", "sport", "endless"], "long_description": "Strap on your virtual skis and dive into a dynamic world of procedurally generated slopes with two exciting modes: Free Ride, where you ski endlessly with no objectives, and Ring Challenge, where you aim to pass through rings scattered along the slope to score points. Whether you're striving to beat your high score or simply enjoying the ride, the game offers a fun experience every time you hit the slopes.", "short_description": "Experience the thrill of endless skiing on procedurally generated slopes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "supp
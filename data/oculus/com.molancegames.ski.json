118970948680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9yQ9PFjwBIQ7kNvwGaLNcx&_nc_oc=AdrG3eKLc6gZufWzE3vF8T3u15RlFJVhe0H5Xy9qoW_moVSJl12MT65Dth9Oj-HCSN4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZOFXGBn1pCwCrHqXp1oOulPJ4xRuSfSE3b_8moo87QA&oe=6A2588FA"}, {"file_name": "4.png", "id": "464023283443345", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_464023286776678_5054891083823893912_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UBQ_Uk95QAQ7kNvwHqlsyn&_nc_oc=AdoQPuFzuOamylpjxWMjINS_5uft9kJmYXSXMNt1SnoxynrhvLbx3i3AGdwEtH_D388&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yCb7nECyx4bkldjcDoH4uwnBvtZY1hhkK8MlmkfrQyw&oe=6A2587A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1605927180064005", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391937_1605927183397338_542796705772801359_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ri4Fm13IzsEQ7kNvwFzbpV3&_nc_oc=Adp6Ubiwmum_gSl-ScFnXnTHraD5ecyfjiymWLV25xY1b0CBUkZ9IUDodVVg16sFKgM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dFawCHuqP1RQwTgLnQy3kIAINgK_l4a3V43CMV6UtoQ&oe=6A258C48"}, "display_name": "Ski", "keywords": ["ski", "skiing", "alps", "sport", "endless"], "long_description": "Strap on your virtual skis and dive into a dynamic world of procedurally generated slopes with two exciting modes: Free Ride, where you ski endlessly with no objectives, and Ring Challenge, where you aim to pass through rings scattered along the slope to score points. Whether you're striving to beat your high score or simply enjoying the ride, the game offers a fun experience every time you hit the slopes.", "short_description": "Experience the thrill of endless skiing on procedurally generated slopes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "supp
118970948680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsfchtohYKQQ7kNvwHKahs0&_nc_oc=AdozfB1VoEC28a-ABMi7HNWS_wShpQYwZvZiKWvVdlZQSjqs56gm3_ijOUi7p85ffKA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9M3H09Q0e3lgS9G046AcsARpqnZEOzvRraplmgj0YpkA&oe=6A47CFFA"}, {"file_name": "4.png", "id": "464023283443345", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_464023286776678_5054891083823893912_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rp2c_H6RvVcQ7kNvwGeirzO&_nc_oc=AdqkS45-A-8MOIBgQ6wXvy6BvCjYjwpneVcawGZhghM2l0GlV4FvsbK53xmbr4_yOXU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yk1nyk8EcdVOzs0MWk2NV8u6Wln9rsENnL-MizQra5g&oe=6A47CEA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1605927180064005", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391937_1605927183397338_542796705772801359_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NEqSSCmcVgQ7kNvwFKMcW0&_nc_oc=AdqBbA8YyLNKTYIR_VvCgj08r4buD8Gy1BnS-TfGeQsMvu4dI02cTTpkjwnpw4mwFz8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Pb3QbvXheUfRqOuBw8JKn9f2ktaNogP-F9vVeDxSTIg&oe=6A47D348"}, "display_name": "Ski", "keywords": ["ski", "skiing", "alps", "sport", "endless"], "long_description": "Strap on your virtual skis and dive into a dynamic world of procedurally generated slopes with two exciting modes: Free Ride, where you ski endlessly with no objectives, and Ring Challenge, where you aim to pass through rings scattered along the slope to score points. Whether you're striving to beat your high score or simply enjoying the ride, the game offers a fun experience every time you hit the slopes.", "short_description": "Experience the thrill of endless skiing on procedurally generated slopes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "supp
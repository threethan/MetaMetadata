118970948680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl7Tiq8KRQMQ7kNvwGDrLaY&_nc_oc=AdrKVhLmhv7m15-PB4UL9yy-skZ8-LUyt4E6iGnJJglCo6GJn94tgYczDLiCz3_rVyU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhkePg2sMYPkx4cXkil1PqA4xCYpZb9U91eITbNXCrKg&oe=6A56507A"}, {"file_name": "4.png", "id": "464023283443345", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391924_464023286776678_5054891083823893912_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwzXkptjvwsQ7kNvwEkuP3Y&_nc_oc=AdqNYeQHouj0mM5MQA6n-6IaunaNcqGdfXA4pXoUHVylRWbeGtEa8-4jSeIF9d4UB14&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_93DZyYrAW6j0vfNQvhQRx4Mrxo_BITDddyIR2IaiTA&oe=6A564F28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1605927180064005", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391937_1605927183397338_542796705772801359_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNiebdpx5_4Q7kNvwGTyM03&_nc_oc=Adq3slVgPCorRrla_jO9NIAb2XaYeooXDGbdAiN45WjdUPe2EU07YjOWhYwJsX_LsdE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHkT5DVCJuEpXG3Di1QPT-Fe_NKmJ8AT9a4jC5643Qfw&oe=6A5653C8"}, "display_name": "Ski", "keywords": ["ski", "skiing", "alps", "sport", "endless"], "long_description": "Strap on your virtual skis and dive into a dynamic world of procedurally generated slopes with two exciting modes: Free Ride, where you ski endlessly with no objectives, and Ring Challenge, where you aim to pass through rings scattered along the slope to score points. Whether you're striving to beat your high score or simply enjoying the ride, the game offers a fun experience every time you hit the slopes.", "short_description": "Experience the thrill of endless skiing on procedurally generated slopes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "supp
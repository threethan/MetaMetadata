118970948680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJ-CV7vEegAQ7kNvwGPsEe0&_nc_oc=AdrZugygrggLov8EQCbJAtDLpVcigd5J6mFA51yWp9UAAD8DphqlAvSkhg_59YbC4lQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e-jTnKn4iEC8TFlnfgDwWNMXy7RVJo9ROdo841xfZ7w&oe=6A4289FA"}, {"file_name": "4.png", "id": "464023283443345", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_464023286776678_5054891083823893912_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSFeP4Q3FxoQ7kNvwFqC27X&_nc_oc=AdpZbDny7rDWZNXsONxU68rsPcg3OBkzDJ4WDLTCR1a71d5mF32odwNpD_DCM4To2kU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yPG2pvbAM9NcfLOgc7ZbT2a1J83Uis9vM4OL2lTHXUA&oe=6A4288A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1605927180064005", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391937_1605927183397338_542796705772801359_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DunA2xc8T0Q7kNvwHl2gjC&_nc_oc=AdpeG19UvR2_ZK9ZoaJ409sjR3OIFOAbws6JvArfybHEzQVJhKHqXA80lrzd16Du0KA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OOQpM52Z_tgmJOtgK3-3JhLTNkLTLqbHhxq2I2kAM9w&oe=6A428D48"}, "display_name": "Ski", "keywords": ["ski", "skiing", "alps", "sport", "endless"], "long_description": "Strap on your virtual skis and dive into a dynamic world of procedurally generated slopes with two exciting modes: Free Ride, where you ski endlessly with no objectives, and Ring Challenge, where you aim to pass through rings scattered along the slope to score points. Whether you're striving to beat your high score or simply enjoying the ride, the game offers a fun experience every time you hit the slopes.", "short_description": "Experience the thrill of endless skiing on procedurally generated slopes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "supp
118970948680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwEFJyNtDjgQ7kNvwGnlOHj&_nc_oc=AdqdFhVFvsSF_17Rd6wUtHF0DXnUo5lUZN5QnBVTuWgkSZrmAr4dIkqPmBcGkF9QrTY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8J778THY3w3ghfFRM-cKWKEw2s2qxzyqwmjht3OjYbA&oe=6A66227A"}, {"file_name": "4.png", "id": "464023283443345", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391924_464023286776678_5054891083823893912_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbS0I-c-nmAQ7kNvwFt5J59&_nc_oc=AdqqrP7sz3JuiFMgmBgVKSjUbxVbKhV90XCkyg_ivWtBXdaReiIt3SNXB37XPSsINw0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBA0pX5oKMvf5lLjgWCaYMMY9Bgh0Nl2WudzmoA4ykUYg&oe=6A662128"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1605927180064005", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391937_1605927183397338_542796705772801359_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiBHXbBzTtcQ7kNvwHdGF18&_nc_oc=AdpVn0SQIpKxKthTXwyzPwgK7ds9g_G7RCwg837ng9HyOkLVUIZReKG_YsdgUOx3Rtw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByJJKPPsaA5ZyRU3vX5xrJdXd0wbe5G8TD7Ut41zHJ_A&oe=6A65ED88"}, "display_name": "Ski", "keywords": ["ski", "skiing", "alps", "sport", "endless"], "long_description": "Strap on your virtual skis and dive into a dynamic world of procedurally generated slopes with two exciting modes: Free Ride, where you ski endlessly with no objectives, and Ring Challenge, where you aim to pass through rings scattered along the slope to score points. Whether you're striving to beat your high score or simply enjoying the ride, the game offers a fun experience every time you hit the slopes.", "short_description": "Experience the thrill of endless skiing on procedurally generated slopes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "supp
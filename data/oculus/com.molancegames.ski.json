118970948680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5tFPPMlQJIQ7kNvwHhMTSr&_nc_oc=AdoL3FrxA4EZIfa-d9x8bqzlBjCpi96SBQB1OyLue-MkwWF6nr9aClDwv_lGSveNsLY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh3K53BrmH6lCMEOjHpxsA7H0OHyBlBUfhwFXcZ4OkFQ&oe=6A843CBA"}, {"file_name": "4.png", "id": "464023283443345", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_464023286776678_5054891083823893912_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsP3f9_NZKQQ7kNvwEvbRbJ&_nc_oc=AdrO2lj25otqzZkQ8Yp7iRGbos3sKh7W2F-EgTtlOqjbgewY9F-BV_Qw7DLOed2ibp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcSxf73ia20BIJeEOPYErIB47wReJXTLSFus23tnq8tw&oe=6A843B68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1605927180064005", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391937_1605927183397338_542796705772801359_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k76cJ2h-X7gQ7kNvwFMx3z3&_nc_oc=AdolfXNwS9BygS9GP1sGqolMrpLeVXNsNAi1S5zuYBRJC9WNPw0tvB86q7zgg9hnLeI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn7_FzWOOoYF4gSx52sY_qATOgRkEEWb6uARGUqSWWeg&oe=6A844008"}, "display_name": "Ski", "keywords": ["ski", "skiing", "alps", "sport", "endless"], "long_description": "Strap on your virtual skis and dive into a dynamic world of procedurally generated slopes with two exciting modes: Free Ride, where you ski endlessly with no objectives, and Ring Challenge, where you aim to pass through rings scattered along the slope to score points. Whether you're striving to beat your high score or simply enjoying the ride, the game offers a fun experience every time you hit the slopes.", "short_description": "Experience the thrill of endless skiing on procedurally generated slopes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "supp
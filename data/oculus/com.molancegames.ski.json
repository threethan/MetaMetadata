118970948680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3gL3jUV5BMQ7kNvwHNgg2P&_nc_oc=AdrvfS7EnzTAiThh7XMTDiOxF50yL_GLUa0nm2hmQ1rF2tnVQ1Etm7Y9_eTMsgSCcYY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKylStjq9cHBliYA7v4fApa3tLSGdeRXLmkVhSgEuGKg&oe=6A74A2FA"}, {"file_name": "4.png", "id": "464023283443345", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_464023286776678_5054891083823893912_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7HXa0wmbtMQ7kNvwGAYx_4&_nc_oc=AdrOara5h7tBJBDdyp9qW1SCy-ysT8gFB5ik4sGobjNH37PHpUaxALGm7cBlwC3H15o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeUB_AAeG5eCushcV1zU8ouzASDXF15SO5S5s3io90qw&oe=6A74A1A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1605927180064005", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391937_1605927183397338_542796705772801359_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpl-U_42v_8Q7kNvwEPXiMS&_nc_oc=AdqBwUpZudVpqC5YlvTP7mtRHIQ0iq010eKY-HXnIEsQa2oaFDVJIZSzug8LZYvVDUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqwiBKrA6PRdBxJQ4XXDMWXYfs6TuatYrDHcRYTgjQ1w&oe=6A74A648"}, "display_name": "Ski", "keywords": ["ski", "skiing", "alps", "sport", "endless"], "long_description": "Strap on your virtual skis and dive into a dynamic world of procedurally generated slopes with two exciting modes: Free Ride, where you ski endlessly with no objectives, and Ring Challenge, where you aim to pass through rings scattered along the slope to score points. Whether you're striving to beat your high score or simply enjoying the ride, the game offers a fun experience every time you hit the slopes.", "short_description": "Experience the thrill of endless skiing on procedurally generated slopes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "supp
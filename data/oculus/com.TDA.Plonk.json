8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=od4Dbd4CXs0Q7kNvwHsi3E-&_nc_oc=AdoqUog7CykEx--pmWX2j2lw4yeHEJIjuILUKpfHanGxaqE3m_o6t4-AsuNIyYe3uHI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af758uLqcp2h-aMAU21LnX5veBK6Z5gCAgUFo1LPsn4tog&oe=6A1EE952"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClfgiZhI-qcQ7kNvwH8lU_t&_nc_oc=AdroHF8NlexL3JmjI_1pFtXz74y0yKfr6Y28H3sIUdUWQsuOEROBsktpxVkmgpKK0Xs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ek7KqMW2PAYRzp-l0A8MDNQkDNxoKxqU2Fyn34XasWQ&oe=6A1EF227"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6a8NpGWwXN4Q7kNvwGHzaor&_nc_oc=Adqv-URMZiJTyeT0bqhWvHOgLGOhJTwpdEOIEGK3nfYEFc04VgWrWXn2gY021F03vQ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n_JT0QcNoThISSQ_2PkmCPu3gxJGqIXhakgHsGLbf9Q&oe=6A1EE75B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoExtA1hWn8Q7kNvwHDHo8E&_nc_oc=Adp3CCZSYfN6ri3Q5jYcQcRp0VJPPVMfE0RgIj_vuoHP4HSqFTP39872v9UZhgIo8jc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fDzQXGjgXYj6w_f6k2Fuxhex83mZWrErfIyJzL_q_og&oe=6A1EF2AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZrE0HcqBgIQ7kNvwEIUF1n&_nc_oc=AdogBdMDq61Gp65LxhqJhkUkZ9V30jEcPsVALiAFs1fOIbSGAxXGOMkloqkjgGP5TEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63jNlX7bcSG9uWc99_1M-JTwR-Er1xQpsLts7Y_RhENw&oe=6A1EE050"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
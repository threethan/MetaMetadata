8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4u4M5fHZAIQ7kNvwGq0FYn&_nc_oc=AdqR7aVsLsGXeRVRnGx_zRDjn8f79drHCR6LOmb8WF90iATjpQm92PVmA4hl99-81cE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZeKtemqIqld-RpRzOqFlPRV9kljMnCGOtr_hqX2p7kA&oe=69D51552"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5h2FJLz8sQQ7kNvwH2n7bZ&_nc_oc=AdorKJNUh15mgplZJjT5eS8EQ21cglJRhEmj1qT4F7Rz-GTAlFr8DAXB8_pnmWMdoWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NCEbqTEofsGt1LNfaFmix6wwOGQi39B4k1b_iLRDDOg&oe=69D4E5E7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsjdaaA2yEkQ7kNvwFKS72y&_nc_oc=AdqBwDrQGRpNqBjSoN5VtzhmS-__4jqLlgN9vUm7Yfssz1A6Qs9hkIerkHrF-xRgyTA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lGGVXVDRnXBZwipBgltcEJI6jJ2DnRitWpDHTvNGtNQ&oe=69D5135B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPULaAW7gYsQ7kNvwH28J4w&_nc_oc=Ado_AAs5mmzdsMyJLuUGhO-WJfwQaP-mBu7WAY-g_qtOJblbiigaes-3kufTZ4HK8fs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xMlOhUjmFNV9KdFQJDBnD1rAH2FcW4xRwLl5htAPyhQ&oe=69D4E66C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IANe8hOuJ1AQ7kNvwFHV8nF&_nc_oc=AdqlBtGOQgjJuPtiOwYtrxjWD-0f7V0kgW1z8EyXd7Rx3bsN5cj3VC2e6a7VRQ-BUuE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31kvzqOCjLoyNL54xlp_-EKjGnDrav3FSD6VVchlAGIg&oe=69D50C50"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
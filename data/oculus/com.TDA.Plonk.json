8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1gxjpZL2OUQ7kNvwGTA5Gh&_nc_oc=AdpM1V8zF7lQdtHjlg-l0T5ngV_1ZIBiPkePZBOQWmxTTYWtwIL_P6-Zkk2-1pFUCGQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3s3kEEjUv6MN5_grYKnSPpQBpMvXnnwQizm-d34SVr2Q&oe=69D909D2"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkwrtiB663EQ7kNvwGkdbny&_nc_oc=AdoG_v-0Vnf9HlBmwPXk0QIVf3b44fuRPHZEKC14rmK_rmcCmuLBMiNhpoMSWBPfmpQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1439crH9cSC8vZPQtYjj9DsuRAsz7L6t1yfRw_EPclfQ&oe=69D8DA67"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSjiZQbXK_cQ7kNvwEGpLv6&_nc_oc=AdojzGPu-V48OUPzMuQ1AaLkB491GCvOXzKUfU6jZCWpTmeYEVuJN_KjSm2EfISOQdI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZoibbATJd2N7ntjXbGEpaH_6EvWqbej3pTBp4PrLtzQ&oe=69D907DB"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cv29DDa1JJ4Q7kNvwF4gNzr&_nc_oc=AdoKh1UMdo0IuXWBIyZqOtATF1BM83kkCWURbR8Esr2KWIqFUd52j1XcsKV_JQBTgQ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Z_TrvYra0JINYCfMl4kJaqLgPt-UYoECm8dVt2p83NA&oe=69D8DAEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3j-37rGp0wQ7kNvwG0OUUg&_nc_oc=Adr2e-KIJd7FZ6qpOr9xIGVR0yVuVhwZe9zmkTMXgJQKvT2sfuaHytggm5hebiR6_bI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af013G9fdyb4uiKCtS2as08j0VYCRuJe1FrpyGP04ojikg&oe=69D900D0"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
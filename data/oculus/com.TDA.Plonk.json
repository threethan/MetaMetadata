8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R35ayAg30ykQ7kNvwHolp-m&_nc_oc=AdroRPdedn96UuzFGvH4jm7-uSlih7GRaxhQr-1l-bwm3kZF3nrBP1seQLwVI50l6Vw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3W7rQ52edbPl5uF1mc44jAnBT5w_6gbjsaZMMyNnAAig&oe=69F75C52"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QceWHbTwF4Q7kNvwGONZ1A&_nc_oc=AdqGVBjw7MySj1n1LFPsWDbYB69JLzYEmavZClG9YKrW-K1H-UhgS3S20AdCAqQetX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0n_VXoRWeE3MFfE08VwxxZwfZ7wWbyg23TZuitMsrRFw&oe=69F76527"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKBpySXrYQwQ7kNvwE0sdSv&_nc_oc=Adqa8V6X01xDrk2ullK9-QafVjWbSUPNVg-sNpWZGIbDEA2fWsg19hoFZ6rvOW3l2ag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0LUT440er0vecuroJbI191MxmS5m27Flc67sNAG4lJOw&oe=69F75A5B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElZLJmCodVQQ7kNvwFvsODf&_nc_oc=AdoAKRze0-HaxvQUQqCEHyB1O7HI_pxoZZtA4EmOkGxJdOhaXjrecupfmnWnETrbWiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1-Y3eS4T0C9I-dKzO6LqwhSxDBq39_NC5kGXysM11UZA&oe=69F765AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwDLNyCr8uwQ7kNvwGCS4bt&_nc_oc=Adrms-1K_kfOxXNyuWUSKl7px964xADDlvPlkmCq9R5II2uijjjvSlqRtE3_XELZcew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08BreMdlf3EByc1KyLO2_DFw-_d8S_UNXocBJbQ_L8cA&oe=69F75350"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
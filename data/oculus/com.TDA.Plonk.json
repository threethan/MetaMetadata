8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_7UlMRBj2IQ7kNvwHTLRMp&_nc_oc=AdptYUZ_gXH42N-F9A3dhwxrWjj1vvA_ldjnVmPqyMcznMkxndcfWqq6-WohHaisZRY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GJPSbmL64--jUBBfTAw4rw64UcT2eED1q6Ufz04WVrg&oe=6A1068D2"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jt959ug9ukUQ7kNvwHWCMVT&_nc_oc=AdpA-11KYEvhiIpfTTW5FJlmFKSJPrbrl24uONFbLGBbFh80RAXFsjS_ybphWhMsJ6c&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59RkvnhHamRy2F_Fba57gWuXuEyw4-pmHU3l5slhh9QQ&oe=6A1071A7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kY771CqvybcQ7kNvwHDp-og&_nc_oc=AdoJhb7uDFviiAB_iJUd_xBCXlMCK2vlhQbnU_3WgDE97GhCGGfvVHFMVciKmm1Z_tk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iV-HKAUJkdxfci08pULu97kD_lCnk3cTK3soBa0kX-g&oe=6A1066DB"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGBeDU-8nwsQ7kNvwEU5Ken&_nc_oc=AdqGsnsftdqfOsNi6PVN_zYhqtUO3InQaMzU6LvxSGKQyFKcrQC5wOehTi6E4V98V7w&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5K6qk16iha7OVEwmzzZI2QKI2R5LmnW91ADnFtLLVGNg&oe=6A10722C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTmsJfYcx2QQ7kNvwHrvGtJ&_nc_oc=AdpBCotgZwMXMwKPjLdEdK2SoFB4qweEel4BP5zB9Pnff-9C25b-ElbFRwhKEiYogls&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47C0Fl40bcHoZRGrkgC6zSBFG7iuqZoms5nehYhIpPTw&oe=6A105FD0"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
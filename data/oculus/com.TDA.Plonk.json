8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBGaJy6Qw4oQ7kNvwG91Cjc&_nc_oc=AdpyUBBA2clbEnZgzv8HJ2WaGaO0_Kwfu1Ng-6WVw_s3vWgZ2GDfe-8gn2djJfneyng&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5378HNW_bbuJv3bWFCZFB3E6FCpZwurM3Ep1hPn2t3gQ&oe=6A170052"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKF_Wpb-tVwQ7kNvwGaAcBO&_nc_oc=AdpSrIc1529EumFpA_OBH4K52L3u7svJnhaTcuHbSp0uwD9wxw-bJl0hwv7NlNKtyGE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QnQHbRlN1bF3Ksx-HASYUgQomNL9F-G99VdtNmW5VHA&oe=6A170927"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBmVoSf5FMcQ7kNvwFnlNek&_nc_oc=Adov4red2qYYsd_NwbBXMkj95MfSZgh3bgO0Z77GeJD37VpjVdf9deQcTkZSF1MSwOM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rpbdlUqPqsaTtMESC6h1D1csD-shdV_pwOO4QdeaJYQ&oe=6A16FE5B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McyQlIHgz98Q7kNvwFX44c8&_nc_oc=AdobUT7dxT7r_052kHAbxm80jBwGhRQCgkuXxf-tP5n6-Qh7804Ghydfb8WOf-mmAME&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NPzjl9EdbBQZyBHf3UiG-3uy6q4ZjlLhZ_uer59FJKw&oe=6A1709AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6vP9khJZfoQ7kNvwHDWuB-&_nc_oc=AdpTpjTp_eMHpCLi87vFMdi73lDbuEKjW1z_viRxpqct7dcjM4nT4ocqB2S4ZFYDClM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Tb0rHl0_1yfybpc4XMHWW9VtgXR3HpGhWo32OjD0F_w&oe=6A16F750"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBq42uo7bKgQ7kNvwG38y1N&_nc_oc=Adpw0Ca3eUdbdf1uRoQbXGFVEIPVbCTzJyLtEz_DsEd8fuJW5phUQ_j7RZki9Gi1b4c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxxbd5VlHf27pCJ1_ghr5erYSj5y5bgLvHClJTcxPA7pg&oe=69CFCF52"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfmvjkvSHSsQ7kNvwHIZLuG&_nc_oc=AdrkoinPnBv-rlDpv5QxglN4NvuBlCUyMgtBANEe1YtLapThypP0xGjhQH8DEFpSFOU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWwqywsH2qRfmquopODp6Ia1VWcgSlIBnLibjqeuIp7w&oe=69CF9FE7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pc-hz51roH8Q7kNvwF8RptO&_nc_oc=AdqyDHQzOjBLYJVSVDVGV6bRwrBmSFZjCrfAClFEpHz0dow5cA8IRrR4iFf7XSh143Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPCkOkhoD77O1pPSkESBQyivOIIiZYO7IrRqwzGiJlHw&oe=69CFCD5B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeULSCxc1gQQ7kNvwEDLWj_&_nc_oc=Adohdz4i61HNNnOifdHhH4cG0p38ejUhehwKUrXg-rHQP3PMx8EJesMJKEU5N5Mf4RE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1-LSXuKK-2uglF3YqhaXrLb2ODhiqPqCJvBN-fhLIzQ&oe=69CFA06C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsSyInSbx_8Q7kNvwF13_eN&_nc_oc=Adph1cnBv104AH-8IxQY0SEAoZ8U-2bTGDA6HmIA-ORCA4lwRQig0gb9m3aDnAx1a_A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfznT98TQgrjIjGeCaSAeU9VrqKrIOU15bsav23fekV6yQ&oe=69CFC650"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
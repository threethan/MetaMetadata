=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mb0XW4EoinUQ7kNvwEkfBfz&_nc_oc=AdqJ-rUWMOYGDHKu4MgzFoKEoSSqnN0Eu0JMaaHkAHbVLu-I3z9Th5gBgGEVX41QDCg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3l8n3R1FESz4bZ6dV8cRJsO5oNZriyr2hcNebE4ge6Dg&oe=69F21652"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bm-76ce_vtgQ7kNvwED8hU3&_nc_oc=AdqZ3yNtf2BECZOK9Pd1E04sHuRh8Y3nFWATBbn09okHweOh7r1Xgvf0v8vtY1ZdH4M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3-dyO_0mHgMgRsaD9sl-0zmViW1kVmTZ-vZvqiStvOHA&oe=69F1E6E7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pyz0uvnEnCAQ7kNvwEsPaLY&_nc_oc=AdohjQ1NYGTYn6eRgRUS9ZRWfkxGvSQPSmqZMu-n8612fgDaBJXCyFxIJpRwzkOB3yA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1biP5iD6lcLEBwCt_CwbVsqicnXafakHmrbcWZti7nPw&oe=69F2145B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-Q90DTdAE0Q7kNvwHNU6iq&_nc_oc=AdpI7B8PBOMDool5AsNxZ3iH6IKgF5fOJdCyxk_lLeemg0WlgvKhxYyjnL0eAJPd0cs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1QpwjczxLO7MuvUMiyaQe7ulSmcXlzzpTHmpjf4y2YFA&oe=69F1E76C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUYXEboMacMQ7kNvwHd2NNI&_nc_oc=AdrSW7ea-BFIridsmQoF6zm6OtqcoL0ggawksMnjARzNSPcru3snSOavATnug7vMHhw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00rcbJcKeelY_YAgF1zqTHTGWpFniWT0SvxK1qcHNyBw&oe=69F20D50"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035
le_name": "screenshot_02.png", "id": "1606150194051639", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828008_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-zyxCa_muQQ7kNvwF773Rv&_nc_oc=AdomDNRf1KaQVwvDiZNZ5ycTMEVMok7ANzA7oUCjKwOOTESmJaaYBH1_Jxn4w7lvgs8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2UpEDe0q5FOu6QmFwjCzbdm3y4HT3LJuaIuzqsc296w&oe=6AC26352"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgYeOnxiZxwQ7kNvwHgk7d8&_nc_oc=AdoMnGUubbVI7XhTq-KqqSyfigcl4zJR0K8QfwesNLNQyoxaNvHUq78OLBH28emYKX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPq6vkCA8r1xFsZAPKJEG6a0v-sxXpovdwjkGdqiE_ezA&oe=6AC26C27"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lajvYWxPAAQ7kNvwHILmu2&_nc_oc=Adp9Z1OHQIV1Ya3OL22T2ISE1pKzc9DAOZaDLfcYR7Snb7AJi044I5kKwnkph2vsQgo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbwqvf7RQZZNAfvUzGZFQyy2-E2M3b4oihUS45axLr8A&oe=6AC2615B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qF9dj4SF4IQ7kNvwHHP9Xq&_nc_oc=AdoqrOBgjxxFOcQJUAPBW60vt1wAqMtlDHTC33U7Y7ET66WYw_8wb43TXGyGf5pWO-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzsi5wbv4MW_po_zCPcQp8FpmNFQwcM9bzRSrMb6Noyg&oe=6AC26CAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nORavEla8O0Q7kNvwHNC4l3&_nc_oc=AdoOh70ZhWWyjjLvAvrZfb55orVzaRax5WGt2DRzyR8K_1JbQVBBDrNzxIGO5bcu_LA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbp1DBSj1F5aFVf__208FMWmZXaVg4-cDGHT4V4acadQ&oe=6AC25A50"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "pu
le_name": "screenshot_02.png", "id": "1606150194051639", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828008_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OVpvcjV_zoQ7kNvwEbv8WA&_nc_oc=AdoayVavk-pcJuItRlbqXp8e0fp4atPmHWUcrRPTuHW7vU391Q2ZLTLahKKricLwgyY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ4wx_xKQONiBKdfAoBkFJTLk2ts1B0sbTntn3zTH1-g&oe=6AE358D2"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzduNjOITsgQ7kNvwFcaPiM&_nc_oc=AdpAafSrjTfiQaKHS0aIiJfz5CPI4k9z5sHmOsoEFWRB7VNYy3Qo1RQF1shAf4AVkcw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTDhpELSh7hNFs9111DT1wi2Dc0xFFojjm-q9bGOJKpQ&oe=6AE361A7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=da2wfvwtywoQ7kNvwExBTdz&_nc_oc=AdrQ-lE5x3iEzYx-TCyS5GUWcPcgcim0Q7fTUbxyJAFG-g7PHbSlNXeGgoxrlkFIezw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuvnOf72WMXFwnYIFBlqhUNRSU7zFB5cj1DsDGSGi3RA&oe=6AE356DB"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUGS4t01wc4Q7kNvwEOxslq&_nc_oc=AdoTdNtOa4RumJDWS3SF8jSeuRVqkoILZxVZfPAbttr_JDJiKoruZCTUSpWgfV5vpo4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJANWMSfgSo_vx7qat0v_LO01CwbUampAjsrTt9qvdBA&oe=6AE3622C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aT03clt2TncQ7kNvwFBGOyf&_nc_oc=AdrwAUbAEtxokask4XCgYyn47-fuMu82SEptiW7DT5gWwtVcQ_2VhqWYl3I7xbfaBa0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzO5ejJ0HG_BTOAWfXbHlElFVEkOAag6o9vF3zSw5rCA&oe=6AE34FD0"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "pu
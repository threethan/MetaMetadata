8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8gbCdmF66cQ7kNvwF_JmhU&_nc_oc=Adp4IOjpk8kJ8IJgWG2vWMDkiGhkDvtO0x3_GkxOV1AJhplhk5Pczz37ujWzUw7pGrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sOOCV7VPGhIE1S5aUDPzKzLkLNaeWP0KAUIKE4fCS9A&oe=69F9FF52"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vesK4TZoZEsQ7kNvwEl_0Vt&_nc_oc=AdrP3SAIjFe7FQQkJ4QJbqpOisthm8QKlr10MbdbscYcOHu1QunWTik2aKeU1n7iNCE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40uS0_M6-mJBsuoTxMaQCziKa63l04Ceu2ZPAirtjytQ&oe=69FA0827"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04TTeA7Y9D4Q7kNvwFmjOKD&_nc_oc=AdpEJAQxyOh3po1aLAY9nGDo8n1uGb_X4LcpMWrzeeOjtV4zA8AnwDJehy8lB5PFNWY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kHn0GsxNCxJ3XGG2wstW53Yj3BKeu9bp3Yw1Cw3IQ4w&oe=69F9FD5B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElZLJmCodVQQ7kNvwFXxnNA&_nc_oc=AdoJ4uXfPnXj_X97s-QKEgf6Fx3bbxRxrIKDJW5yWOxJfxa1x4keUODTQr1AMtdK22E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_7Sx19PzXcRkhsL0KnlwGfq4Gso-5scexxav3kFjlYg&oe=69FA08AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zw1YerH80QcQ7kNvwHTMoHB&_nc_oc=AdryjGw_OyRLaSzfoVBLFFrPGvKySB4W4ZhRPxbRZVkdcvA3_l72Tp6WHfNkDgfyW_4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x9TuKJh_M5wwSOn9D5xy2G9od_vwSMdTyrxEBzJvDtw&oe=69F9F650"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
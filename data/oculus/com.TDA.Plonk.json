8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8gbCdmF66cQ7kNvwEz2OO8&_nc_oc=AdrMrTJARd9ljdzskal9LkLY8fz4KUwHmnOqDmUi8a3a79bD1YZK5MWfw9dQLIQOOKY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2b3EdGzLbdqpY3aX6OzeR9L5Xh3xJUZzhUKijBpvokAQ&oe=69F8ADD2"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vesK4TZoZEsQ7kNvwGdCznA&_nc_oc=AdpZKWduNEICZrtntDM3cvPN8_1cw8xQ6OnSi-r6kNZaZCeA-dSh-RwFdUj6jtDFvjA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-uMAYrK1dHlD88fsZtzimxst2W3Uee2SHhNhuXxmeng&oe=69F8B6A7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04TTeA7Y9D4Q7kNvwFEKwm1&_nc_oc=AdpOIMcqcjmufHGwb8bSFyW5DDIfFr6PcgrzK3zBkCAmbNCogx-qe0o3tQYrybDPesw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dEnqZ-P0wsUzz0FMQwKDeFyz41Jr-uawb2H-kW7ejIQ&oe=69F8ABDB"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElZLJmCodVQQ7kNvwFpNsky&_nc_oc=AdqF-w0tRKAb_rjddufd4-j0NJIh3wJVEMJaN0hAHOajchjLkaNO1fWsYLM6gHpsgPY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2LJnW9y3S0_TXDOt2jSNAznbl8IbfutOQu_EhxHK706A&oe=69F8B72C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zw1YerH80QcQ7kNvwGey9Ue&_nc_oc=Adp8514JPwR9SLs8ckDFIbBEf9wfPXcTuM-dKVHsU8KsGZZFAMwgngHZqqV4U19ia7c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1LfPRS7XK8RE3dkSbWE8NDSovHjwlKG2k1pA6dXc_H5g&oe=69F8A4D0"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAMfj20L7tsQ7kNvwGnPd9G&_nc_oc=AdoyltXrdecQgqkMud8PCOTS4VrWTbxpAPuv2Oh5xzCQqCcpgS1b3iauN1-KSP_x2Dk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mOHczWX_RP1iVbzH_iTfOxKY9l3tzofzZlhslFTbeZA&oe=69E78A52"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d94uv7lRciAQ7kNvwHDC2lz&_nc_oc=AdpCJei6Trko6lSGnY0xl7wUgPT0-fEoJG03fwwQzGVQGJq5GMbyiQgGHE0-G8gjS8o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0854yCXEqvhw8QdZ554T5RFRSMHh4Z7sM5GoxHw2tuUg&oe=69E75AE7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QaAV-gJNiwQ7kNvwH1KggK&_nc_oc=AdpgESbx5cPlYxd4oTwjZp5b_E9cgBo5ySG21l7L9pBAJRi2j8A5WgUaUYCw1xyunDI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36QizZCZn35JWm47l3aHLwDpCtalvZ5DOl_fpaa2wVeg&oe=69E7885B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1FNntZrNuUQ7kNvwE3rwNp&_nc_oc=AdqgMYMDK1NSW5hglOkhVVOxRzWyC_50lBQ8b07SJxRA7zv7CWL6hyNQm7OI9uDRMuc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uRlAyVfSEepABOp2XLkVd_3szqU7t8hKxb1tQ3vGrJg&oe=69E75B6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UCINkxpyyMQ7kNvwEXMnGH&_nc_oc=AdpYkU4QtdQ2WbsKxPCWKP04DBxRoTMiEV8GHnWjB4qC9xM04a7KyBT7gVHK0ZJfKow&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mHSmKXjs7XiMmGgN_oy887uTWlsysiaUPczk7f36qcA&oe=69E78150"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOADpxS4r7YQ7kNvwEuG4dV&_nc_oc=AdoqonQdA3fnUfHNkWz9UFaoPy0MATmBN1kC6B2hE40aaZuu8yAr-cZJl_umI5xw0tk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3z3lM_t-fVQvk98BryPqNHNSZAwB7q5c8XITIl3GjT1Q&oe=69E8DBD2"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53MyFPuZ3egQ7kNvwFDaR2k&_nc_oc=AdqVwR2oHXnUS9hwn_D7Y7f7NnFgkKCCRUnkAGQwJVKah65dqLzcHOydY4P-hiCIJQk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hsIdLQX1vHyDn8pOpuz1nDTljidOp83lpLxzvUa0hgg&oe=69E8AC67"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEaWd7p-X1kQ7kNvwFkRCW_&_nc_oc=AdoJTaC9c78kDKRtUOe7Qi9RhnnR8hXcfH2lsMF5ZU7MfyZxvXNOB_ExGNrIJIVWeQQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YFFYbYjsw1EvU-XEsSS4S_wdiuQKbHwK4bLfEt0CW7Q&oe=69E8D9DB"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1FNntZrNuUQ7kNvwFtiP0_&_nc_oc=Adre0Lwdu4vnib2oJ7puzO9ykqktYo2KlN-Ngeax7-PgOOO9Pr3Mas8rcHf_mzXhQxU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WebbmsVKdgaQJlbWpmTRprb60g079roBvv-MTjn1YZQ&oe=69E8ACEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJWQfz5bezAQ7kNvwExK3du&_nc_oc=Ado7o_wI_QzUT-2aQwACUwq4lBUEY_9-CHEhxlT3n3Jx7pf04vnABbX8zNQ3IlvV_KA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2w1YM0JF76JY0c0apxaIZRNOCSptKpuMAkucpYVleG3g&oe=69E8D2D0"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
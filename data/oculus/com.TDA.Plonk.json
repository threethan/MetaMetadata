8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XI0LOlQtYboQ7kNvwG_BsOa&_nc_oc=Adpe5rcTGcsB3bSHv1apRa5U7dTddytyZ5lnNibo8DjHnGmDsI3O_ypZWxmG7MMfiyw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af593HG1Gpp4DgNX8007UTcRzK0MuWw1MtN50Ws2GrFlDQ&oe=6A0F1752"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNmhipehyX8Q7kNvwFETFaT&_nc_oc=Adr8j7I_RsWyM339H0ua1OHG7HkNcwtJEzYLkONe7kKVx2Gd3QmiHe_iZov8W0yY0nc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ksHdzTnUukP__D_9UOPzdIAznFQp_9HEOlxqrm_yANA&oe=6A0F2027"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yb7C-Z3r_YQ7kNvwHCjE2t&_nc_oc=AdozmPEogCwOBpERTdSBSrHv4bQRrg8B_32OxWjHi1uPgFy6Whqttb4oz_hi7ojt5Og&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SkB7n5UdNVgfSYNBejqD4Vq_OTupZzxAuLD2-0YXHXw&oe=6A0F155B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGBeDU-8nwsQ7kNvwGvp7k8&_nc_oc=AdrhbX1dvI2AthQzkH6OYGOv2LyrcBM7DsalQEZqOAXMusyzUiqg6GcaJmxybeJdwnY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vyOGVqq9Zyv9xFaHnV5kaYBaBHPbtVd6qXBQOkCC77Q&oe=6A0F20AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbOdlERHu2IQ7kNvwH2dYmm&_nc_oc=AdooxPTtVKf-AMcm8l5TN5Gm1ef85gNPRCmi4s6S6qE3AhwsdGrYJhB5cJBX2qA5pEo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FfgviIWOSBaNJ5tkrIjXnOBmB3FpmgKlmLVBLcVxhfQ&oe=6A0F0E50"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
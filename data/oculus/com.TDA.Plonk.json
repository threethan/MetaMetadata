8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4u4M5fHZAIQ7kNvwE-_mYW&_nc_oc=AdrLQdGwdytPnTWze6TmJYglLSABXwfQVpkV0H-DlD0sAHbyOFADRtDcOjnBoWkuU2A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AwjTTY-wBphQpIYp-VQNIjZ4YjsOxW9NBfCcUwihNZA&oe=69D7B852"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5h2FJLz8sQQ7kNvwECPJCH&_nc_oc=AdqZbKFBnwMpMTDG5yMUdMjxwdYsZDZ-6DyV1Az1QCl_2_ir7chP_fsLAXVFUaProWQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ytfX5Vm7WbtLVnOYVYCc_CwxeN_K1R8yyvPeOyT8oEw&oe=69D788E7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsjdaaA2yEkQ7kNvwGlchrz&_nc_oc=AdpjJ86JZEu-nZKEcVEUT2TZDDdzoYXhKMlal-D1QiMjlxRprhXt1dw1Wqh7gVNvZC8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i98gRjv9cbAPnzDNyBh9oZdmOoQTBcFDd0HPl-0BoZQ&oe=69D7B65B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cv29DDa1JJ4Q7kNvwEMk1KZ&_nc_oc=Adqjk14pD2Vv5LWlVLw14DE4-0wymjfn1dcZFkCMEWe72cl9T41jV_hESx7pfAxXV_M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20i100a5Bl1AUgDa6HG2ZOgLRJvoD4GECZFRT-4eKMWA&oe=69D7896C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IANe8hOuJ1AQ7kNvwEun45S&_nc_oc=Adp9mYVnKkvu_KGFYKdvP8XBaHxe9NCVnrFVqLoLN0atyHExqYQtupCrCjhXTenM0rA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36O0fp-v4tD0V59AHHI0AC-w8Q7piVoLg0O9HE6hsCyg&oe=69D7AF50"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
28008_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_7UlMRBj2IQ7kNvwHmw7Et&_nc_oc=AdrkUUL2DmgMvdbGsQq3GWqLVsTq6jUnzLV0i3601oOsxdkbzuEWLc4QCcsau3bH008&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZjOK_b_ufo2jqLlw105fUeXnSzFv6BwYstfMq9WKAMQ&oe=6A11BA52"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jt959ug9ukUQ7kNvwGaP3ld&_nc_oc=AdoBJrZ97SWpe4Gm-CG_IHpL72JUbU729IqD_0XRnX3Yt2n-Hd1iDKoooNp_GYrwFC4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ALyUyPB8ys4R37LLYt_vvTWURgn94QzWNyF6GIeR1LA&oe=6A11C327"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kY771CqvybcQ7kNvwFXaiWj&_nc_oc=Adpf4I2GPh3khdQB6aMdigHbh0Bqf8FUYO__VpMd1KJld3U6gjlIxbsy63Wwi5wXxUM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d0snS2nPI9uydhl6CBZmTR4PhchXOlofdcdH2xe9wSQ&oe=6A11B85B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGBeDU-8nwsQ7kNvwHrTfY1&_nc_oc=Adrle0JeUCaYwEzR5XnjybVEtbfWKT2ZBQCA3XHVm27Qcb6Q8A0-s0QgLFLIRhdj4gg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g1JaBseVl50nc0B8my_F3aIoq5GBxuWnGTv6XO-cVJw&oe=6A11C3AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTmsJfYcx2QQ7kNvwGHdDN8&_nc_oc=AdqGPj4x25zfQrU-5KGWuR3AcIbnIVVLuI4DuzJ_PeKdT2a3T0Zsal3ECYLYT1tucC4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7D4y-8MWETmPI11bB3Y-K-BpiX-YIE1uw-aXmD_tcByg&oe=6A11B150"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "categor
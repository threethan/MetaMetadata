id=6e7a0a&_nc_ohc=epFXFKr8EqsQ7kNvwFztgGp&_nc_oc=Adrym3T2y6KSMj4upQsA6-NKJ4XO_165DMjM9SqYzsvsGog2LGGaUZ-JoTYbu0hDfTU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTorsMTjhLVjnuynQVZ_oMz7DBemHzymtEuS4fdqN7H7A&oe=6B0DC112"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxrTWNYrptcQ7kNvwEk_1an&_nc_oc=AdqmetFxUjd7JmlxCZ8ZAXg3Us9kIQPUNibuzHdD6BSkb-AN_r1V2peLIQBX42BjW8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSEhTtGETCYAEwEm91ctmAVVFeHcSy-d_nhn0hsrzzF6Q&oe=6B0DC9E7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yx2faYgj0LUQ7kNvwGpPjod&_nc_oc=AdqXmUq4mg32rUZFqco38rYfYBgx24f-3jYkAQlc3NTfaFG6gvvoXl0XZJrxvAoqB-s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRIxKMctIbUzxKlNPpHI_quxrv4KMJ2V1JVKBzw_kz7Ow&oe=6B0DBF1B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqaeSRZKRaoQ7kNvwFeeBQq&_nc_oc=AdqfEP7Pjp06PpG8NY66Do1bbgPf8a2nPaA2f3ELhp3JfV5hAlv23JY7d4RJzFO94R0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQmxzytDKtFnoQP38q1qpYqIwoYphbPxx-tcH0VoXGeFg&oe=6B0DCA6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A02O6N0rpWoQ7kNvwEEvKJN&_nc_oc=AdpAFKm4kIAaZWEvivnrt6NcjjnxkRiUJ8SoCXpAeMHj9DIyvBV_HpTyVHJGKKei4wU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRHrtyQ3aROWaS9wmuC-0xSuxENlONSVHnNqY4RpyLayg&oe=6B0DB810"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "htt
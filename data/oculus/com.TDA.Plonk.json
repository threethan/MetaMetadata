8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5t75booHaxgQ7kNvwFO8K1-&_nc_oc=AdrH7VpNJbDCTU6oAmh00au_IlKaGB_2E2_kPTgCzgD0zEv-hXhJPxqvkx3t2ijmyDc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Fdk3ruk2lR4Q9LpKUmoWJm0L9tAx_PUu_T-HONToU3A&oe=69EF7352"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k60HhHzxp2EQ7kNvwH2Gug4&_nc_oc=AdrUxUYDCIqIwsoEilVsHcjHz3ryTwMkNyr1QvDHm0YVdC3M6BmVWO0VAeCNooN5EVY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2OCGJVhWMYXlE0phteMnManm5A8XMv3seqD0jRi9P0gg&oe=69EF7C27"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCV7rtM83FgQ7kNvwGcfGPR&_nc_oc=Adp51XlK0aVld_Dl4JBjGl7hnxlb4opF-K_0mhymN_CBwr3olkRxrShby9gxlMmstIo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af06jIwEbYatvbJuVWgQ0sMLQH9RJI2wBAwm2VbLvm4K7Q&oe=69EF715B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-Q90DTdAE0Q7kNvwGGkd6K&_nc_oc=Adp6khASCVF8oWkaqGJV5YjhHsnTJBLH4K3z42b1ExcUm8tcp0pXDUK8UOPOOKrW9Tc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RPycNvx0pAbZ2GWD4kQKfEdaPAm-pp0E9qPJ3uw1FJg&oe=69EF7CAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1Y3iqn-2CsQ7kNvwH9W8P7&_nc_oc=AdqdTufBth7nD2DZcOALuTZJCGDYSvwgjxt67U4IE4uZBk8lsvs0lwP3EIGcQI1Pkfw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1pWz2PLwMx7e-aw6O3Bqijx3FBqF5QnfXx68jOxFrTKw&oe=69EF6A50"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
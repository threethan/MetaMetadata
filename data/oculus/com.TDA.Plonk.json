8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XI0LOlQtYboQ7kNvwFcAqG7&_nc_oc=AdoZtt92wzZ9Nn9EIK-WihMviEDP_GOJ5Ehc4vBAq1k7WWVAkfk3YRW95v1izhgARXY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_n-Mj35nLrezoj1I6hCvSMHTw8lMvNboS6edEb8V7Og&oe=6A0C7452"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNmhipehyX8Q7kNvwEhNX0b&_nc_oc=AdqGjkoLXsjz697Tjf6z-VSOhwB-c7SrEJTSWTlfzahONlwKyynu1mbL8FLAtTDJW7o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SPnrrApd9c_F4L4v3m4SPeXY8DhsnRdrMnH-sLK4fjA&oe=6A0C7D27"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yb7C-Z3r_YQ7kNvwE2_9p_&_nc_oc=AdrlDWmzRIPeFnolWEEnTkumto4gRqyfwfd9dkM8DqUW7tINc7O8AYsYsnYTbPzOcQE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DOiBw6u2TvpMNOzTM5BrOiQ28nLFI5mFsbyjFyVEjCA&oe=6A0C725B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M84CvgItFvkQ7kNvwHrLU1x&_nc_oc=Adq8wVc78KOvmP_-Gg9U5vqUB_wEx57sJKR5W8AKOj1mAkcXLjB_PlM5myAv6kG5v-M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4krpM03lawi2pOhirrTay4hy-uPkf1uK7kcBTji8LooQ&oe=6A0C7DAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbOdlERHu2IQ7kNvwHxv6gl&_nc_oc=Ado4ds5m1PpJhHIYWnLgEOOuT5OGW2e7vYuagi9Q4lRkk2qZxZCCmQeA24Lmy4n0xb0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46X59GOc4VZ93lBfTV8hFGd_F_0Zj5MNsZRjNA_iwShw&oe=6A0C6B50"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDywCz-oWKMQ7kNvwHotnS_&_nc_oc=Adr2zyyUBFvBKIhcOyr4QM13sPhVNl164eseiNfxGqlTz74YUSR18WviZrUtPF_pTkY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PeUxVlND4DXapdTIlJmS5KkEubpq7BgmcPJsswrPWjw&oe=6A413052"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Z-a_UM8QzgQ7kNvwHLslRU&_nc_oc=Ado9-LQQXR6yDcB3pBuMvng9Ou7WQakpioHOwM9U72M_6dj5YRTuqqyk-kS4r44owhY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-s6kCZed-ceXvq7Pc478wsi4rr1M3O59uaOJYLbspAg&oe=6A413927"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wc5SPdxTcrwQ7kNvwFNCJzS&_nc_oc=AdqAbenbyzV4HAgn23AVdcYR1DW4RA4hQr5r1MlXaZ71sROl2vx_ZFI-2viGBujLDm8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MmdSkBbBmdSyuKXYsB7zFckno-PlTzNNPw1kociMXZw&oe=6A412E5B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZvbKZ7gBq0Q7kNvwFUvbN5&_nc_oc=Adq4Wabe4s54qNQ_0dZehMVuioT20_Tui_R0COseLx0CWxYbP2GfxCwAcIMTSu9-K6g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yQC-G8ttn4BeEpivNe64It4M1f4Y5vBfXLxKuw0rjgw&oe=6A4139AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9dIFDEvYpoQ7kNvwHPI4Kh&_nc_oc=AdrAas7cTqCcQSbRNS2Q-VC9L5CoB8r246B3W0Fr66dZV3o5T_sLbmogOGXS01LTQ3g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-l6Y2iiIhjWOE5ZhUNEcVQnKwindbqdt9EZ5GAjZjgOg&oe=6A412750"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
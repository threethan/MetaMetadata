8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAMfj20L7tsQ7kNvwGWZuDz&_nc_oc=AdpYdXdP3JSWvWmSgvfQwd5UqgSZENalSEWCX6D4Ko_tJ9Q7Mh8sLsMg8p30O7Rgo2A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EDnyEfjE1z914VUn7K6rJk26GzTmlvR7ZCEd1gvakuA&oe=69E638D2"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d94uv7lRciAQ7kNvwFHbLe2&_nc_oc=AdropN7wCT0sZarqB5rrr1ZyLJGWBg-fsxM8_m2UUYuCGnb5UYzpW81r2dAwS2HO3jw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Q0Sj_Zc1HSJIvA_AfRjmI0WEozQt8RNXtWtU-aRdGPw&oe=69E641A7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QaAV-gJNiwQ7kNvwGGgPEE&_nc_oc=AdoT0T189ogDAfCmuqEzFo1tHB5vSJOQs-AqdDcekPaeGyR79AW6NMHxafGGW_VsWOg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1he_h1GVHhAzJqcpJ21OYk6-p_UExdisQnCHEOwo9UsQ&oe=69E636DB"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVKLbaSQdIsQ7kNvwFeXSFa&_nc_oc=AdpXUS8djh_JUNUJ8gbwvcr2OOtxSdQdMLmzqCWJSwOpJtVoDOaT65orKa92aybS4R0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WYapr-E7RmP2xqmSTJkD5nlz8kbdPd0Q0nDLnBvb7GA&oe=69E6422C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UCINkxpyyMQ7kNvwHOXEVJ&_nc_oc=AdrqnYLLy6kYYa2Bnl8--z0UbKtm8aPhR6_Dv1Y7oibOAYk4Q1t04jZdHlnFNtDH5pU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37N691-dmQ9Mk1Pe7fBU39e022qGEoywCN6GbPvm6FBw&oe=69E62FD0"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
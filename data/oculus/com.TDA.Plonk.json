le_name": "screenshot_02.png", "id": "1606150194051639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828008_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQBpBWUY8FwQ7kNvwE-BSI2&_nc_oc=AdqwfO_vviSMTwjbhq1927-S6a1MLQztWh6Iz5pwmLhKoJRQBzwu3eD5hNKaoQbk7LA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgsaa-UuA2qYlwQi0vpyu-MztgHP6vQDYYbWT_JSoAcw&oe=6AAFEE52"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwylYLlCsKYQ7kNvwELGRRf&_nc_oc=Adq9Ski1DWR2xwLlULCpjapQofy1Cl2d_aloeXc2Ljx5qQAT_VIUWUpgiqq85d2AT1c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9kCqmQ2QjCY2c0mwY10O7AkEiKPQqcjVkJ8dzpvZSwQ&oe=6AAFF727"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qlwuWdohasQ7kNvwGP0ANL&_nc_oc=AdpGpa4WnIpoFXownsxQ9mOomInTGwTybfug6y7kLydulW1egv6dyw8cH3xKJhDO-io&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXWSqrxgcv2DlbubD7RxvQzFvo5NFP_4djO9EPyfL0BA&oe=6AAFEC5B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0myJBLD9DUQ7kNvwEUAP_R&_nc_oc=AdpTVUKv5CL6zelFOfply2PCRZk3j85Rl33ybYoabMYpVgy0bLgoXZctstCxFiiBDtE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_eu4y-nnQ_XrlwYq0noSjrOyc9e9e3C4-0rDN7YwRAA&oe=6AAFF7AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6E0y861TPcQ7kNvwEilcXS&_nc_oc=AdrsXNP2tC0GL7NPuRoeVnGd_Gi3DoNhejQTe0B87o2VZ-3HVWL5vHTNUGRjmvotiV4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRWRI75i2G9rQ6qpJfWFcqSnwcXbBCAETooledsilMJw&oe=6AAFE550"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "pu
8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDywCz-oWKMQ7kNvwFpwLLV&_nc_oc=AdogrSbIrcjkQesPFQfrzjw22k5zymbaCDm-mQy7PEPTy1rNInB8_-DDvqL5p7N6k70&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X_ngq9dN135AthZqWVAoiOhMsX07zC71Knm2zp_c8Xw&oe=6A4281D2"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Z-a_UM8QzgQ7kNvwF-zoZW&_nc_oc=AdoOvh4ddgHyDWXcbMgLC7Lownc8V03H4RG6JTUBtPU3R_Bb9ZceWQcq5b85T1v3VvI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9yjyzpsl1zjRHiVsb3tVKYom234Q3lB02FfAqXuh8fA&oe=6A428AA7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wc5SPdxTcrwQ7kNvwH8S-MD&_nc_oc=AdogajGCNhcKO57SvCfEtSkDC0N4IUKVxUor1MzCyGzVur4dVqT023TGLu3MD9c8qCs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b3GWa4E9v0FUSCc_ym9pXViwDzMkiuxleDqHZc8ofFQ&oe=6A427FDB"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ht0IisWRxxAQ7kNvwEco8ew&_nc_oc=AdpKPgg7lsLn8vC_GvQPKZWGVrgY4qJq6v69qle5xPlr2dN8xcwDVZiOlp5pb64lY0c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Oaz9dVNtCUVc4u1z0ff-PL3I8bXhQSW9cV2KDjvsz2w&oe=6A428B2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9dIFDEvYpoQ7kNvwGQrPoX&_nc_oc=Adq6h66JBmqWtHrGikMOxrlnLVh738dOp5Uy9uQFU1sUNfvrbzUXanDAewqSS-x46x8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uA9ADej0oFvy4HTGMkBO4tNUBpti8w9pPjiTWF-nUWg&oe=6A4278D0"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
le_name": "screenshot_02.png", "id": "1606150194051639", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828008_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEfbnepada0Q7kNvwGlWLG8&_nc_oc=AdrSxOGf3-l5-G8BoKyH5tBvtuZMd1sDugf45CD4h97zHQvHXMzrq2UrIkSmoPaCsus&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBrUyNKRTnMrw3aAOReZdTOnV8fZirDkY3sCxU6zmQ-w&oe=6AA2BF52"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umjilWicMbIQ7kNvwFHOluT&_nc_oc=AdrcMvMQPKgQft8op8K8AmmNGPLSx-DUBdlNUCcOfqt33OvIA-n9sWbUOf1t2Uxzbf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtnJDH6gSDZQaYQpwsuw9kMr5oOaNLZycSMpY8v0e76A&oe=6AA2C827"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ikt0H-w5nnQQ7kNvwFsnJoH&_nc_oc=AdoPaFYFZ-utmc_OO7hXKoFo7EY7tEXo1wbnpS11EYtYTOU5y34JEokJmhyGgJtB2_U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWsV6Vc27ymZRDy9td8ZINZMkA3JBzd_DyH4ssIkE2PQ&oe=6AA2BD5B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvX2fnCY-xEQ7kNvwHOAMQq&_nc_oc=AdoyhRiqQXUTeP10Od3LNjRGH7M3kYHSdrbf1DcI9GBkYUAM0y20QLtM4KdeADtK-mE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6iM0KD22FoqX2l98TzHnnQhEhCzt8U0hyjateOuLHcg&oe=6AA2C8AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n0hwyPUk_0Q7kNvwFmSISq&_nc_oc=AdoLtCp4hhhdoReLr_hpraUQDW3le51gnObgH95x0YzAzke4MD2ip8UFDPIritj427U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8fziNICTtIVsGvSwOk_3oJJ67qrBhMPGsYU_zvvCUJQ&oe=6AA2B650"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "pu
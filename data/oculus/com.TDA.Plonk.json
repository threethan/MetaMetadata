8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZoDXABcgIsQ7kNvwEqWhdL&_nc_oc=AdoVxtf5Ww5lw6htXQtW96sEI2n1QVBF4REHQUdpMV8ToQPF6Olo7nrkIk3ivzBo3pA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kB9ZeA-etj4i6zM2APWslBU6pBKL-hLgMFU0V8rbRpQ&oe=69DCFE52"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBf1a65RrtIQ7kNvwG1QJwD&_nc_oc=AdrcYNfo-x3YqgoKCCs4AHuYs9-cSumFRinUcU8Osq2ZCl1LCtZZL9R8wYADhTBWZ1Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hwcJ6HAhKHc1agz64TvU6K1uGnZ_palqhLvbCJMKl2w&oe=69DCCEE7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJUnZjpP2LAQ7kNvwELNC5v&_nc_oc=AdpfJ3soryvZytiVPew8-ld8NAuCZXoFiYoTob6B-benCaUBOWjK78fgWieAsNRiD4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RKVt2h6lpbRG0I4H4HyVk082It57hhWVgh7yKe3n0sA&oe=69DCFC5B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqph97EUlGwQ7kNvwHZQTbp&_nc_oc=AdrxHwkEYKq1GjfbljgVpBYxPzE6D8NENwcZcfXoltlucKr8l4RZH81mPlqc3oWdNoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2md8rALx_OJRUXyQblD9SRMjTSlWPXL2LaD-2KK_175A&oe=69DCCF6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT_zNGBi8jcQ7kNvwEC74JD&_nc_oc=AdoS911liEFIwWr9PddtGYbICLks6NPcayH1sMNS2K8gtJIv7-E__BOIJVWmhqQHI9A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xrNdQJBny1E4h5ALqr6C0Vr2kOdOwMNqsSGEAFXGlAQ&oe=69DCF550"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
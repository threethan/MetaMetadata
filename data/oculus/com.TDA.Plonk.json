8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZoDXABcgIsQ7kNvwE1HxU0&_nc_oc=Adq_MB4rI983DdkCBnUHBt4kAo9_VCQ3Exi_Vz2nbt9jwtsflzLaZQ0g1Ewx0r5mzvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SDs611lGNDEx_5qdWDWWXFsBLRhbFG70RxElNvVT4SQ&oe=69DFA152"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBf1a65RrtIQ7kNvwGxfEFE&_nc_oc=Adr42WsE_ozpLYO0OrhhJpJY8GLmUwLciqq31aklMMO9Z0kDKMBNB1ILVyox-eyQg7M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JHNhLCZ_Cx68aHnbdtudtg3yuF8XrmIsZFOwKN69a4A&oe=69DF71E7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJUnZjpP2LAQ7kNvwEYvaFf&_nc_oc=Ado9kUa-vIoKctmv-fU3sdxMEZtI4sfTTHXWvj1IELuiKXXGou5LZSLZiceI4lCCI6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0a8b-SKfyAI6t_B9s_HIbnGx1D5nH6-m2JkkNIpKcmcg&oe=69DF9F5B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=571mw6EciWcQ7kNvwF4BFgQ&_nc_oc=AdpMyApbttYa_lYnJKsroZvhqWF3yS743s5M0GFX1zhNzYtN5AzSzq71RnDRyBrDOMA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GcK8o1BTQ5WI12ZakJ3UkPCiVioUR9m5x6TZl1MaL6g&oe=69DF726C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT_zNGBi8jcQ7kNvwFWo_Gf&_nc_oc=Adr7iMFGfEsLDPexUDFHqRPB0VIv_6BSmj4_quNqEdCkdfcioB4icEdbpukg6iFeLSo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AVv84T5RE8KzuqFS9oep7oAb8XVeb_TU--VT-WkRnZg&oe=69DF9850"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
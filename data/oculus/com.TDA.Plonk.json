id=6e7a0a&_nc_ohc=KZtVtFcSvIEQ7kNvwF0sD0p&_nc_oc=AdrtRmbdwTjgDIeihpI3xGbRwmMc92Ie1dYXQB3V6r7GQwxDoK7L0YRAjqfMIXrVMPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEN3ImmRakjsir882Kc6I5h5e7Oahk_Kehcv2Ald3Mrw&oe=6B072992"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tYB5Uhwhw0Q7kNvwGQyROR&_nc_oc=AdrELnElRxm1h13qAyvEU1LID7DqXclhkdv5HOkRyLyf4pMU8SgZmXbhAvxNBzuApYs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs5Bc61L5oLLzzpervH6FV69Mx9pYoN7YHMHvKFPY9gg&oe=6B06FA27"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpljn9HWznUQ7kNvwFIt7jM&_nc_oc=AdqD1-rRGspX7rnQ0UzTMESm4g6QkcWwgyub0-6N4deyjBUr_ODElgH6En1evOnO4hk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3j9HmzNVAy9m2gMibIPkrgv_-cEPdR3IxjpUzw6IkQw&oe=6B07279B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCy6VvOYHIsQ7kNvwFnRXxN&_nc_oc=Adp22mBDx0rCs24M1haNWKGLJ6Tl4zKrCqcmd0E-vStxovXrOIriI2obQ_hYxJSFxhg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyUdd0fXLZ0l27fvrXu6r1qqpaCZxdcAqjq0_EcbaOVg&oe=6B06FAAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UY0O5UK02nQQ7kNvwEBrxx-&_nc_oc=AdoyWBhUMJpAveFlqMV0mBzpQYbZCYxshZciaBOX3ZhFALCWVMv4eY9JuwRfr39TSI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuP_iRkev7kaDOLIZe_AyOjIYuuIiyH5ls-FHv9V8ZsQ&oe=6B072090"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "htt
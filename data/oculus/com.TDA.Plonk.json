8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnbW8xegRYEQ7kNvwEv2qvZ&_nc_oc=AdpZ8zJeyeKHWHGzHpkkMCdWGi07nS0JCegvOHjTHE4M0BV9lSRua4y0xtAySvH7RXQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3EoalxIYlTbnEncVjkTGTzEmqr0YiaPVO4H4NJALalQ&oe=6A3D3BD2"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXB4rxuK3pgQ7kNvwEH5vbZ&_nc_oc=AdrMHdXF3Sbx-xmYOBoi_xkoXP2w-vT3jJh3JqJkJ8lAMNJjLghgp4iTwk9edfc4bh4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UrO1Hpg7jGjIjt5rj4Rmqc1JqmRjPkHq7_ir5zoNOCg&oe=6A3D44A7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2khYXvyz8oQ7kNvwH5TJAo&_nc_oc=AdqcGtfxpCZ1uGG7wOv4NRGzdogQqwuOY4V5TruVzRJ8RQfM2lZmBdlGOq-lXslRID8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XpEYlw5RE2RT3zkVtYmHWpZ8sFNcBTKYTcl6g7sWBLQ&oe=6A3D39DB"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSIHKJL3NBIQ7kNvwHY8STO&_nc_oc=AdphuMwhtIPHrIVXe0JtOo69v3fJMVSU5sylb2mjJ7ILTGTiko-zIfmnorZU9vDJOKI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jErJ0rvxkST0vYS_zekJFFQbwxITmBfsiqLcKJkxHYA&oe=6A3D452C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0gKxphLKB0Q7kNvwG-80dD&_nc_oc=Adpy3kKhNhyDNej3zzS8IowPUXaexTaGyhK1TtqV9GGDPucI_67hZyC-bQb4goBPyZU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dsX6h7RLPD3rmcxq73sfdDQ7dkiMX5XLDk6AcIMV5nQ&oe=6A3D32D0"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
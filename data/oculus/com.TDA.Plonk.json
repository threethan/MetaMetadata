28008_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXQcTQVn1kQQ7kNvwFB1yX6&_nc_oc=Adr-SAM77TALBbgzNPJ2zXFpfkWALtqXQ482Jr4Zkd5o5uR5Q0fZk3IgBScyMEx2uG0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87ho83BZ2_vYO5mmaQ1ML0XYXFpMq_Wakh4rMYfuUBaw&oe=6A36A452"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_8gwie3R20Q7kNvwHsPF3e&_nc_oc=Ado0EbePQsZ1rC7QQtY6dp_tjexd5c-tvCzrKBPh2TEtkQcCMwdt6rolfTpFguJIqXw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FawwAcCiWkiTLPWJ0CkPLCqGZa-lV3Xn4zBrpw5P5DA&oe=6A36AD27"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL7SmNXLdE4Q7kNvwFyqJtx&_nc_oc=AdoHBMVS7uD1s_ZAKrJnRwH_ASfWPwgMmrkDSpjd3EHfSUhMiCV6Q07nYSRVuLzxviQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Lbj8Ihaea2Q03YBvYzkVi1aueu7JgcIdNSa7R51oa-A&oe=6A36A25B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9v0pYzNyz1EQ7kNvwFgbrT0&_nc_oc=Adqlb3MtFZdtURFnRrj96zAj6P8yj0isToPAE9MReu2nJh5F023GgmQzxq7cXUrLcLU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Jz0H-J7y1u_s6Ui5mGDN2UlchxFAayTpTBb0CQAFqNQ&oe=6A36ADAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_5sw9HbYiMQ7kNvwF2bmYl&_nc_oc=AdqBRwk4cZIzQMQh9D9iQnplk_8QTEH_BtGuqP8wbfhwAGHofqlgqylw5cbVbvklsJk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TTLC9yXUz73ESDClp1uX1-Zqq0QfF6_aFDiGAuWkA4A&oe=6A369B50"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "categor
8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAUZHEo7QKAQ7kNvwGsqfy8&_nc_oc=AdqmaSSGxQvVX5fvSM9HMHWUrdicFXiPwqgjbpfZP2HacRHlH1ONC8mr0DUwB8QO8sg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IOo_3BuwXt8gRdhjgBW0PmEWLP9YDoljJqdFyKrR-wQ&oe=69E0F2D2"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dnx_LFpPD3sQ7kNvwEz0Vqq&_nc_oc=AdpHaEvZRwCqrszERu2g3CRHadB3bnOTRmjxpVOoCHRRrzH94qJaxY9zNZDlBQ_QLxk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XYm51WYarjI3AAAyR28eD1MuFQJ8IXXMlMk5am7K3tw&oe=69E0FBA7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNWUnc63fzoQ7kNvwHHibXZ&_nc_oc=AdqbZlhbQr23qceAy7ZC86TSCPocRmI_cZrnGjO1JnMgp7Pjo-xF233D1bWXBI0fan0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XrYUycV94nWesPfE4XKf-gBJCWFtxFsmo5psw04vAlA&oe=69E0F0DB"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=571mw6EciWcQ7kNvwHYRYpK&_nc_oc=AdoW4lLIE6HmOUi_MQJ300-HiP9YCbcI3aGmlgnHlBuDZGusk5SCs4kbzmQdZMriUUs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZaYQ2zXDiMsal7sjnQy7Gy087zYEPtlC6BaPv_4Jmhg&oe=69E0FC2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1K1AxnI_ywQ7kNvwHZdGGq&_nc_oc=AdpPMgwOu4C56bZXYpLN9D0Uk_pRwF42-MdSRS5gviI8BeNat8pv5nWGUOQxbg-OYeM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YoV7z0SXnblxkq7jPRIFVbtqJgExBbZsqGR73xpfdrQ&oe=69E0E9D0"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
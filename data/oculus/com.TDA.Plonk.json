8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXQcTQVn1kQQ7kNvwEnHhYQ&_nc_oc=Adoao46NKyCq-wTh_XYOSMciZ3kEdFPLd7l2hJZ7N663bFnPnSXMTkB-_PZS_MVjeJ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X1s7ym7rEvNK55QeTwQmY2aLmLwAOIZQJe6cREiNeKw&oe=6A3552D2"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_8gwie3R20Q7kNvwH_RyON&_nc_oc=AdpBLb3eVjzCSKEkEkTXA68vAFKIPwJh5I6lHTGY8WS2KEznY6NfYsdTNTtHNXBd7k4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y6nrJjs5W1-9Y9YAF-6CNC2vUR4j7I96duWgAdLNPcA&oe=6A355BA7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL7SmNXLdE4Q7kNvwFppPSU&_nc_oc=Adq1AUvmMn1giBwfoUgzMtZuk7Fz2ZKGhat3uCcolrEnhYGq5VIwScMhwsQ4L0XHWKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-74M4nXUtmHmoSjZTs2RpZdRyaj36u7SjEZCGtCwE94g&oe=6A3550DB"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bP64HjoG-IQ7kNvwFKBDoJ&_nc_oc=AdpOOYcJtj11w7A3FgiFc1MvK8TV22YpfhydYyFczjD5fOo2ExxfMq6VreL5ilXWbb4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YDTt1O_aXM-01SeLtfVUum1ii9j8XROxN5CVDQIbY7w&oe=6A355C2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_5sw9HbYiMQ7kNvwHEFbxm&_nc_oc=AdqYv2JfB6bot3t_lwhvP07G-OylmULOJZazTv-CipmAssxuMYpzrHXD_sAqIHkwwtU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8on2QIONY0m-CutEGG6gIcv012Ru8EprhtnwdYmkC-Sg&oe=6A3549D0"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
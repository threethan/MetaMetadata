8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R35ayAg30ykQ7kNvwHCSMcu&_nc_oc=AdpizxK5H-hfDCBeBVV1ryYbX8VSAe6xrSmU8V5xRvMSzOpfAP5QKCZ9BfGxPTAZE2c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ZJiFT3wtTewo5PlY1tZ5eY8T-_CGZUBAbAWpgQ6OACw&oe=69F60AD2"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QceWHbTwF4Q7kNvwGr_k6c&_nc_oc=AdoqqvuOckV-p2paHQzG5eUCoX8wCsrXk20pv8ZY4WEySEEh9FVCXOHjb2r0r_NkArM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2GPynoG8DvEm6IbauCro4Ww7R2jAHbeU_m5OPXfXPMiw&oe=69F613A7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKBpySXrYQwQ7kNvwHnqI1z&_nc_oc=AdpRvgW9Lo89VRMMPEhQX1b60ax-9WBKlkXWkp6IXhJlS1gR8_O0ZthEtF5ckTLLypk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0GCa4tMyxn81kkircqh0HIg2BYBV081nbeNJ_J2bjw8g&oe=69F608DB"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fREcb6B4zfAQ7kNvwFxRCje&_nc_oc=Adp5gbzJpBejTzU4uE7t9BHpRwkzBZ9dhBQRvbkKNEMOQOh9Y6Lo5XOBrhoQIKNahuw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1khX7ikezakOC0u05K6snq4gsWr-6GeP9R7Tfndw3S-Q&oe=69F6142C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwDLNyCr8uwQ7kNvwEVb_LU&_nc_oc=Adp8_Zf7IiTMTYYVyZPsZpgy12eMMpaRzc99eOVtpkisVyl3toSiv6SiSiCeKKzHKEU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Zb9cjPdEfzzqFZFEomusKMKELYfB-f6wzL21HLbUUxw&oe=69F601D0"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
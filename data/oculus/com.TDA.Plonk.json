8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpIt_eRMYLMQ7kNvwGzqTxY&_nc_oc=Adq05O37RTGM8HaF2iPejahvZJUvREcF1H2Ok0iH2LsIVcPf1nZHUUM7P_huBtauops&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cKt4GB2w4I-FTSnE-sTeNxXShRY1HQylAOMz8UoOutQ&oe=6A242F52"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11MLvZz87PwQ7kNvwEqlTxp&_nc_oc=Adq5T3SEg4-lHw5ijDRkoXsohUdnXh8fG_GMcfAvrtj3WG578scJp23zqrl-UshfuyI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b1H9_TlqUipn_mMBkVPVR0PyiT9jSSVeRJvw9Usbp_Q&oe=6A243827"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bovXCQItCEcQ7kNvwGAlcQH&_nc_oc=Ado3hKNbQ7svEbhBe1IJy6iTvLxFjP0127aqRHRBSX3KM5z8TJQnUgKUXp_TDQJkOgo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82G9i3PnMhpEuSrli3CRfK0wLhHIOJ-qiIZqqufb52Zg&oe=6A242D5B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5vNVwzgGgIQ7kNvwGlNgP_&_nc_oc=AdpwFqIsINiAiyJAcG15okpUAs8BhDghl0SbtOAEHDnFOUHlrXtdCp0HuZz-zfFJrkU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q3pKcLb44naNCyBvt3WvX2Mb6pgNTSjmEorILAoIwfg&oe=6A2438AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtBaFAAemc0Q7kNvwH011MB&_nc_oc=Adrwfej608e7UwoGjxbsexXm9LUJPbWkzFjvJyBfukoPVwDp9Pkp0Cg25gI1SJax-cw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BMhaIq-tfk-WQhlfbIjKCwfg7vXIkOQrC1ANvHZaslw&oe=6A242650"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
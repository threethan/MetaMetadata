8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnSXDkHcN2oQ7kNvwG8nura&_nc_oc=AdomtKW3p-i4U1KtP6D-p3jTv9Y8j4sdsxN_mOwk3MIcmDesiu9NP5-ykXTmMuKWKB0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RbuTRMjnsErohY5R8nsFIZwm5CiKHv1vCjl4Qf5j7QQ&oe=6A2823D2"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Hwj2Eif5cYQ7kNvwHV2-Wn&_nc_oc=Ado3Zh42JLz-e5vinMZvuf-XMpjhq7BvrG3zHYcodOtWxToXv1YdOB9cAV3Xs5AV7zk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99VHttmKDGSD0BHhMPnPZ23Y9rnCYpXQAkLwA06rMxOA&oe=6A282CA7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROst9jVuKLIQ7kNvwGqMV0R&_nc_oc=AdpnUaNHb5G4GiAzMLlF8o49HPc3bqKnkLL9EOS4TSF2_xycFFz709uJM5r7C3tZDpg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_z17OaCdB9cxzZZmNmnhzHcgT2ASRcvG6axqv8CRAZlw&oe=6A2821DB"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lk7UHa6IAicQ7kNvwHQVU0Z&_nc_oc=AdrCuPptDiW6u1QZ3NdUjLrDwOm3g25HJpXEQRkXc-TKKWGREWfGGsIR1DtTaV-7j_M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i69a0TdtWNy8zM55Loiuy0nnAfWq31TyTFXmmx5sAoQ&oe=6A282D2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1UN9ADzUB0Q7kNvwFVYBLB&_nc_oc=AdpG84IErewNHpjdhC_9NFgqhxvQ-LNis9TSVRwra6-ZHahEBM_jJiwl3E4UBK4WlH4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mQSRg3wlOUL-CMFbqPWz-gCTjW73Bj_U-sEv13THUlw&oe=6A281AD0"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
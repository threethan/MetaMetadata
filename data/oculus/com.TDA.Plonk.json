8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_7UlMRBj2IQ7kNvwE15j4n&_nc_oc=AdpnC98mTQXivAZ3o6a_J2akbURIuqF1oU3WousFVw0Te8PPbt6LsHr3YiSmCI_cvF4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rTGSC8HkEC7cbeRTDOqBIlv4sC1PhcfUt0CeQQUOeEQ&oe=6A130BD2"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jt959ug9ukUQ7kNvwHdW8XG&_nc_oc=AdodlwD9eX9bKklGaHFNLpI_cSB7ANhUAS2cy9ZxXeug_4Ny8srrzgUwBTd9EzMfCcI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af536t91OPmAkMebarASU2eMmNPsRHQhGd-z5B0luU45kQ&oe=6A1314A7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kY771CqvybcQ7kNvwEKvmi0&_nc_oc=Adq3kL3uSr9Hbv7GbqJk4kbZ1WuaAQJ61XksF8dGCgRaNX9ux7w927lTaA1-wQYku1Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YRwjryCcH5fphYz1xO4agkZB-ruUsI1rmDueZ2SAv3A&oe=6A1309DB"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqMqUjc4IPYQ7kNvwFm5dfv&_nc_oc=Adqm5gxDqsTKphayKV7gUg1zC1q5xcg4zQz-LA4iizARk0GtbXDiBTZMTykD9JpImBA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gOnCZGfzharLq44iC52aqzX8T7M9GyEsQLnK-4e_5Pg&oe=6A13152C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTmsJfYcx2QQ7kNvwG5F7Gl&_nc_oc=Ados9bWmTVwy7ps8xaIOXkivENb8igQBc2j2e3CZWgzW4eVxK7XJorkfUvFdSRpm0Nc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78WOwHBfVmpIx45eJwjCAwC8O3H4ah80sRbAuObKAMrQ&oe=6A1302D0"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
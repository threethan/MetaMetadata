8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8gbCdmF66cQ7kNvwFdmjvp&_nc_oc=AdrBAy6_-oVd2AVZ9m3aMIjdzCjL1c36J0GyixO-FQmtD6VINdi5Vn46bFp_h7TwFjo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4125oBH-aYysacpE2lgYD2zimXES5C3bAYuKv7IaG14Q&oe=69FB50D2"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vesK4TZoZEsQ7kNvwF8hs71&_nc_oc=AdovEBsawzkqI52QLn2jAOVP21RlklRQOa2Zg2dWCP1X57cl89MMt70XoWbUfwK7t2c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Mj1loC3Isf0pTq34kHfFFawy8m14ZGIijzBz22MUlTw&oe=69FB59A7"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04TTeA7Y9D4Q7kNvwEy-sJR&_nc_oc=Adr1qs-nEAHEWmBAC9O0s98sKVngAFXbHVcF0rPppgkwsZA3TLKQFyZxM93KfxHgfI0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5unkTh4wsOZhGGDYB87jN9QsZd_ddJ7Ei1xyjkCHWTvQ&oe=69FB4EDB"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnhuGTSnRI4Q7kNvwHxubPR&_nc_oc=AdpLQcp5ixGXnkz6uxaChO-aqrPl2BHL5ggYDquYzHNDATTL4LLTsU29ljcy0NRNMiI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rrson3gqrSRyyrEiPUnOjdL9PLDyf40Et4Y-i6fBLNg&oe=69FB5A2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zw1YerH80QcQ7kNvwFKrljf&_nc_oc=AdpW0wvzP1orVrbOxaMXbYV0VsPHQjbMpxvS3cF6guk_vUUtAQlimoHgw-dwIm_oSas&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FAbggTSJkmNDaY-_7xJ-nn8NcNhKBnpPIUbwrW1tc2A&oe=69FB47D0"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
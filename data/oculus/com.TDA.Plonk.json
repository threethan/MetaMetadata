8_1606150197384972_1849543909289458880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sy25yH1FhosQ7kNvwEE89Nw&_nc_oc=AdrcEZ7xEKN7lRfwHw55_3rAcX2J0RS8XB0ur0A8lVzrEm7U5OISW-D4Wk_K9uaJKTo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ALdqLSWddoT6vxhzKjErwyqlF24ie-767ZiOMxgXu9g&oe=69D27252"}, {"file_name": "screenshot_03.png", "id": "1591223211998303", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824081_1591223215331636_3496501669777281334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crWdz6bAI8UQ7kNvwEmirpq&_nc_oc=AdovzuSZ4OPa4yazPEDD6ySf_qiAje40p1gGCIyOJe3CMxnWBrKqQMttL6gw-5o-3W0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39gAQyVq_NSyVpzx5_gTXxXOwnyqMWrdefVeXJaBFxQw&oe=69D27B27"}, {"file_name": "screenshot_04.png", "id": "1249378823976677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617762_1249378827310010_5569963111798915096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqYEjdlRSy8Q7kNvwHOu3Sr&_nc_oc=Adqt0rp5nyaCYZdH4RsW4atZZZ-SP2PeGnixb9yvEy2C0xj9HASNh7txYPeb5Tm1hZY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VR7mDku7HGPY91NG6Th4ZzQxDej7CnyrFULGkjV7lpg&oe=69D2705B"}, {"file_name": "screenshot_05.png", "id": "1433859161847917", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617831_1433859165181250_5831040570483238158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeULSCxc1gQQ7kNvwHf5_u4&_nc_oc=AdrlyYKMVKdV8msatSSvEbllBKlrX_opbQaxrz3rv0dtkn1iuesoB1JlTrXRDu0CEDE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22Yxr-z8W9UY6kv8o3boJMVCF_e234FKbBIVAN4dl4bA&oe=69D27BAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "911272228186260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619159_911272231519593_3363245660758003150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqS2Q8p3rUYQ7kNvwElc8u1&_nc_oc=Adq6D9WQBbi52qPZf1c4W7m03L37-Ag32E_vaaVP7KoAEjES0Co49rIEIkDfdwm-a8I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JG_Tz8ae2p_HxrZolF0eI7kfXmd3u9xRf-bLYpingdw&oe=69D26950"}, "display_name": "Plonk! A 4D Puzzle - Demo", "keywords": ["Puzzle", "Cozy", "Cereberal", "Time", "Claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{1739173690390979}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{825140593175692}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{762339476734294}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1521653053301167}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1098844395732972}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": nu
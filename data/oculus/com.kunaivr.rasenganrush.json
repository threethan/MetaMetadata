721988659141295_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTqxUUZd9IEQ7kNvwG1kcpr&_nc_oc=AdoBPybC3kiBYcZveiihzZk7m8tvsLzSIhv14vkbENuIHYgP9Z6vU0ya6YzHWIN6STU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5cPAZdwAxWo3uCm29G_0Xxdu9wG2o2mino6ncJz710A&oe=6AD3A392"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rasengan Rush Landscape.png", "id": "557998943371848", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035373_557998946705181_7620526343911324742_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0XADltsBB0Q7kNvwEeDz6k&_nc_oc=AdoooTLH88y_W0cuNZeZUvRuPnvrX1TrsovnkmCAbYBJtZ8pito-aeExJkk3LY8C2Sk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt9KYT2OmE89ycBSFXEppxH1ONXmdE0FJcYG1CdOC4-A&oe=6AD3A3E5"}, "display_name": "Rasengan Rush", "keywords": ["Anime"], "long_description": "A Naruto-inspired multiplayer PvP VR game! Battle with up to 4 players as you walk on walls, use kunai, teleport, and rasengan to outsmart your opponents. Many content updates planned based on community feedback.\n\nJoin the discord to let me know what feature you want to see next! https://discord.com/invite/zGff9GcDCZ\n\nMade with the help of copyright-free creators: https://neozhou777.wixsite.com/rasenganrush/cc0-credits.", "short_description": "A Naruto-inspired multiplayer PvP VR game! Battle with up to 4 players as you walk on walls, use kunai, teleport, and rasengan to outplay your opponents! Many content updates planned based on community feedback."}]}, "developer_name": "Neo Zhou", "developer_privacy_policy_url": "https://neozhou777.wixsite.com/rasenganrush/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Neo Zhou", "support_website_url": null, "website_url": "https://neozhou777.wixsite.com/rasenganrush", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27113615221620386"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "558742480090587"}, {"status": "PUBLISHED", "id": "1069201804881215"}]}, "baseline_offer": {"id": "558742480090587"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732402980, "status": "PUBLISHED", "id": "558742480090587"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38869183462730111", "version": "5.0.6"}, "id": "794049176269983", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38869183462730111"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794049176269983"}]}, "change_log": "**5.0.6: Hotfix 6 (10/11/26)**\n*Dev Note: With most critical issues with the netcode rewrite patched, I\u2019m moving on to focus on new jutsu and cosmetics for the next couple of months.*\n\n**Improved Hit Detection**\n*Dev Note: I've been getting complaints that players still feel they're getting hit by moves that they shouldn't have. To deal with this, I'm making the game more defender view favored. If you didn't see that you got hit on your screen, the game won't let you get hit in more cases. *\n- Removed lag compensation on earth spike, fireball, and paper bomb. If your opponent sees they hit you at a past position because of their lag, but at your newest actual position you dodged it, you will not take the damage\n- Removed lag compensation for melee if your true position is far enough away (2.7m) from their hurtbox when an opponent tries to melee you on their screen\n\n**Fireball Nerf**\n*Dev Note: With the improved hit detection that's accurate to 1/30th of a second, fireball has gotten much stronger, since it's much more likely to overlap with your hitbox at least once. To compensate, it does not instantly kill you on first contact. Now it does a huge amount of damage over time. *\n- Instead of insta-killing on contact, fireball does 24 hearts per second (0.25 seconds of contact to kill a full health target). Damage is tuned to kill a stationary target as the fireball passes through it. \n\n**Minor Bug Fixes**\n- Fixed missing collider on top floor of construction zone\n- Fixed a glitch where a prior voice ban could come back\n- Fixed a glitch where the ranking server might be unreachable", "created_date": 1791763787, "id": "38869183462730111", "version": "5.0.6", "version_code": 271, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38869183462730111"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791762280, "id": "38868811652767292", "version": "5.0.5", "version_code": 270, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38869183462730111"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791761244, "id": "38868582799456844", "version": "5.0.5", "version_code": 269, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38869183462730111"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791757261, "id": "38867695109545613", "version": "5.0.5", "version_code": 268, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38869183462730111"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794049176269983"}]}, "change_log": "<b>5.0.5: Hotfix 5 (10/8/26)</b>\n<i>Dev Note: I'll be patching the update all week. I'm paying very close attention to your feedback on discord.</i>\n- Hand sign detection should now be almost identical to the pre-rewrite version of the game\n- Fixed damage effects showing on your screen when you didn\u2019t get actually get hit\n- Fixed more glitches where you can clip into geometry\n- New gameplay setting: \"Cancel Jutsu Sequence by Repeating Last Sign\". Experienced players can turn this on to have more control over their jutsu windows.\n\n", "created_date": 1791511368, "id": "38793484456966679", "version": "5.0.5", "version_code": 267, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
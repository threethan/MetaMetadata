B00AE"}, {"file_name": "mBieML.png", "id": "1722413795226405", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035373_1722413798559738_6635721988659141295_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zgen81Ai0aQQ7kNvwEP0NZt&_nc_oc=AdkscQ7g6RCbZiaCf7a6fyBcSJvok18aNDI28-eKDlwUtcgzWKKEWslNFgumrGIJ1i0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuLImpgQ42WEIOdFdGlC08PT_ZjU4jpDNv2eVr1Me7vlw&oe=699AF7D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rasengan Rush Landscape.png", "id": "557998943371848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035373_557998946705181_7620526343911324742_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEASEOh5EEsQ7kNvwEQIbN7&_nc_oc=AdnUw1dlO0z2pEjn85svh1KYZgdNiNE0K0ryy_KtvuJ6G_uriWCy7fDPYCzbfHwxNaI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvxzcBAKmdoPaEeB1k8mkg9to5vWsMtNvF02uXQg_BwcA&oe=699AF825"}, "display_name": "Rasengan Rush", "keywords": ["Anime"], "long_description": "A Naruto-inspired multiplayer PvP VR game! Battle with up to 4 players as you walk on walls, use kunai, teleport, and rasengan to outsmart your opponents. Many content updates planned based on community feedback.\n\nJoin the discord to let me know what feature you want to see next! https://discord.com/invite/zGff9GcDCZ\n\nMade with the help of copyright-free creators: https://neozhou777.wixsite.com/rasenganrush/cc0-credits.", "short_description": "A Naruto-inspired multiplayer PvP VR game! Battle with up to 4 players as you walk on walls, use kunai, teleport, and rasengan to outplay your opponents! Many content updates planned based on community feedback."}]}, "developer_name": "Neo Zhou", "developer_privacy_policy_url": "https://neozhou777.wixsite.com/rasenganrush/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Neo Zhou", "support_website_url": null, "website_url": "https://neozhou777.wixsite.com/rasenganrush", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27113615221620386"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "558742480090587"}, {"status": "PUBLISHED", "id": "1069201804881215"}]}, "baseline_offer": {"id": "558742480090587"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732402980, "status": "PUBLISHED", "id": "558742480090587"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33673979368917239", "version": "3.9.0"}, "id": "794049176269983", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33673979368917239"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794049176269983"}]}, "change_log": "3.9.0: Gameplay Improvements (2/17/26)\n\nDeveloper Note: The next update will be focused on adding a skill based matchmaking system. A report system should come soon after.\n\nMajor Improvements:\n- Kunai Slashing: You can swing your kunai through players to deal damage instead of having to perfectly stab them. Head/neck slices deal 6 hearts, body slices deal 2 hearts.\n- Paper Bomb Nerf: Explosions are delayed by 0.6 seconds between activation and explosion, with an obvious visual and sound cue before exploding, to compensate for their high damage and mobility.\n- Directional Boosted Jump Nerf: Chakra cost increased from 1 to 1.5 to encourage more fighting and less running.\n\nNew Cosmetics:\n- Added the \u201cShort Dreads\u201d hair style, made by LYROID!\n- Added 3 new eyeglasses from Roger3D! For the lenses, you can choose between none, transparent, and reflective.\n- Check out these talented artists' work in the credits!\n\nMajor Bug Fixes\n- Fixed a bug where the neck hitbox would permanently disappear on a player after dying. I think this was also causing the rare and random kunai deflection issues as well.\n\nMinor Improvements\n- Added a larger fire blossom surface impact radius to make it easier to trigger paper bombs with fire\n- Players move slightly slower when moving sideways and backwards. This should make melee fights feel a little less clunky.\n- Added a toggle in gameplay settings that disables paper bomb spawning on kunai so it\u2019s easier to switch kunai grips\n\nMinor Bug Fixes\n- Fixed issue where you would be unable to grab forearm after teleporting for lightning blade", "created_date": 1771369969, "id": "33673979368917239", "version": "3.9.0", "version_code": 161, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33673979368917239"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1771369419, "id": "33673883835593459", "version": "3.9.0", "
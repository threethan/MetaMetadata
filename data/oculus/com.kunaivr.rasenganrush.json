721988659141295_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uw8P-V0RTD4Q7kNvwHJ0-m1&_nc_oc=AdolrDRN_me1pSqjkedAR3Z4hRjgPhFufv1vIupxFFBQvzberhzN4UAhvqXuEz6ZOW4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2_aQRzizJRLEb63a4nerNmfpf_LNNLjWpv0eEYgH4cQ&oe=6AC91792"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rasengan Rush Landscape.png", "id": "557998943371848", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035373_557998946705181_7620526343911324742_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mqf_5wvRo2MQ7kNvwGOtc8V&_nc_oc=Adr1iIqPg6hw3Ttq97D9S5lZ6BCApU-Fvte4XEhpEVRpHgeLGm6MRyKlUdbIXlYyc2o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7e8dSno6iJ3758SK2oXGphmalhGHEbQzXTnozQqk5Kw&oe=6AC917E5"}, "display_name": "Rasengan Rush", "keywords": ["Anime"], "long_description": "A Naruto-inspired multiplayer PvP VR game! Battle with up to 4 players as you walk on walls, use kunai, teleport, and rasengan to outsmart your opponents. Many content updates planned based on community feedback.\n\nJoin the discord to let me know what feature you want to see next! https://discord.com/invite/zGff9GcDCZ\n\nMade with the help of copyright-free creators: https://neozhou777.wixsite.com/rasenganrush/cc0-credits.", "short_description": "A Naruto-inspired multiplayer PvP VR game! Battle with up to 4 players as you walk on walls, use kunai, teleport, and rasengan to outplay your opponents! Many content updates planned based on community feedback."}]}, "developer_name": "Neo Zhou", "developer_privacy_policy_url": "https://neozhou777.wixsite.com/rasenganrush/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Neo Zhou", "support_website_url": null, "website_url": "https://neozhou777.wixsite.com/rasenganrush", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27113615221620386"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "558742480090587"}, {"status": "PUBLISHED", "id": "1069201804881215"}]}, "baseline_offer": {"id": "558742480090587"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732402980, "status": "PUBLISHED", "id": "558742480090587"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38690712290577230", "version": "5.0.1"}, "id": "794049176269983", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38690712290577230"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794049176269983"}]}, "change_log": "**5.0.1: Hotfix (10/4/26)**\n*Dev Note: I'll be patching the update all week. I'm paying very close attention to your feedback on discord.*\n- Added a \"legacy\" hand sign detection in gameplay settings to make it feel like the old game\n- Improved \"legacy\" kunai throw detection in gameplay settings to make it feel more like the old game\n- Added safeguards for rare controller tracking issues\n- Game now avoids permanent black screen when joining a lobby with an afk host\n- Improved region ping detection system\n- Fire blossoms to detonate paper bomb: 3->4", "created_date": 1791167647, "id": "38690712290577230", "version": "5.0.1", "version_code": 257, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38690712290577230"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794049176269983"}]}, "change_log": "**Patch Notes 5.0.0: Netcode Rewrite**\n**Developer Note:** The whole game has been rewritten in a new game engine built for multiplayer. For the fairest possible hit detection, we\u2019ve upgraded to 30hz server authoritative rollback netcode. We\u2019re now working with the same technology used in triple-A competitive shooters!\n\n**General Netcode Changes**\n- The server will ignore any inputs from players around 200ms ping or higher. This limits how badly lagging players can impact everyone else\u2019s gameplay experience. It also helps address issues with VPN cheaters. \n- New game mechanics revolving around controlling other players\u2019 positions and items are now possible.\n\n**Hit Detection Changes**\n- Regular jumps can now substitute attacks in the same way that boosted jumps can.\n- In the situation where you see a person super jump on your screen and hit them while they\u2019re in the air, the game can now recognize that you correctly hit them instead of your target being invincible for no reason like in the old game. You can also preemptively read their jump and shoot above them. They\u2019ll jump into your attack and take damage like they\u2019re supposed to.\n- However, if you boosted jump but your attacker hasn\u2019t seen you jump on their screen because of their lag, when they hit you, you will still spawn a substitution log and not take any damage. The invincibility window is just smaller than before because we can be more precise (the simulation is accurate to 1/30th of a second). \n\n**Ninja Tool Grabbing**\nDev Note: I\u2019ve always wanted to allow you to grab other people\u2019s objects, but the old netcode didn\u2019t support it.\n- You can now grab enemy kunai and paper bombs\n\n**Knockback and Wall Stun**\nDev Note: I\u2019ve always wanted to add position changing moves, but the old netcode didn\u2019t support it.\n- Punching, swirling spiral, and paper bombs now deal knockback\n- Knocking back a player into a wall stuns them based on the speed they hit the wall\n\n**Upgraded Kunai Throwing**\n- Improved the throw detection so throwing kunai feels more intuitive (like a knife instead of a dart)\n- If you liked the old throw detection system, you can switch to it in gameplay settings. I had to switch physics engines though so I couldn\u2019t perfectly replicate the old game\u2019s feel. \n\n**Paper Bomb Nerf**\nDev Note: Paper bomb nerfs have been requested by the community for a long time.\n- Chakra cost: 1.5 -> 2\n- Paper bomb max damage: 6 -> 4\n- Fire blossoms required to explode paper bomb: 1 -> 3\n\n**Chakra Sense Nerf**\nDev Note: This change will allow you to be more stealthy in your approaches, encouraging more ninja-like gameplay\n- You can no longer hear footsteps in chakra sense\n\n**Swirling Spiral Rework**\nDev Note: Swirling spiral has been upgraded to be more unique and useful \n- Activation is quicker and more reliable: instead of waiting one second, you make the ox sign, and then make a circle motion over your palm\n- Damage reduced from 6 -> 4\n- Startup chakra cost: 150 -> 100\n- Passive chakra cost: 50->35\n- Hitting a player attaches them to your hand for a second as they do a slow spin while being hit by the move. After that first spin they get knocked back and spin faster. The other player's vignette is activated to reduce motion sickness.\n\n**Lightning Blade Rework**\nDev Note: To open up options for more new melee jutsu in the future, lightning blade has been reworked to emphasize its use as a fast linear attack instead of the best close range attack.\n- Startup chakra cost: 50 (same)\n- Passive chakra drain rate per second: 125 -> 50\n- Boosted chakra drain rate per second: 300 ->350\n- Decreased hitbox size: it matches the hand instead of the big electric aura around the hand\n- Speed boost only applies when you put your hand behind your back now\n\n**Big Quality of Life Improvements**\n- Host Migration: If the host leaves the game, a player in the lobby is promoted as the new host and the game continues\n- Simplified team battle communication: instead of having a confusing toggle, your teammate hears you telepathically while your opponents hear you based on proximity\n- Legs no longer block your vision while crouching\n\n**Other Small Gameplay Changes**\n- You can hold back on the stick in mid-air to slow down your momentum\n- The larger impact splash of fire blossom can now deal damage", "created_date": 1791134316, "id": "38682502664731526", "version": "5.0.0", "version_code": 256, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38690712290577230"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791127673, "id": "38680370544944738", "version": "5.0.0", "version_code": 255, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38690712290577230"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791127053, "id": "38680159481632511", "version": "5.0.0", "version_code": 254, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38690712290577230"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790978951, "id": "38639402665708193", "version": "5.0.0", "version_code": 253, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
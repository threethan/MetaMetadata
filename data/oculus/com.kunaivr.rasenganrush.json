721988659141295_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lm2YiKofKtEQ7kNvwEHvw1N&_nc_oc=AdqElFWc9UWQoiHRzUaUGzKBGkWh8IS97r674d_CoECm-Xdfu3rfIV418lQ4QovFg4M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpIHZPoNJ9Xk3vm4y9HT8Tt0GwcsWgKkaQmwAvSdXDng&oe=6AEA0D12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rasengan Rush Landscape.png", "id": "557998943371848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035373_557998946705181_7620526343911324742_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UNKHeh-VMIQ7kNvwGngHhU&_nc_oc=AdoaJWqj4PbG1Jb7MklqGrEExnC5L8L5KTwGEpTQAfG6saTe4rfYir_yQR_YPslifrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ477RpkQNeqtxkeYcXPf6PiSjhI1Cq0ZPAJphWcJwquw&oe=6AEA0D65"}, "display_name": "Rasengan Rush", "keywords": ["Anime"], "long_description": "A Naruto-inspired multiplayer PvP VR game! Battle with up to 4 players as you walk on walls, use kunai, teleport, and rasengan to outsmart your opponents. Many content updates planned based on community feedback.\n\nJoin the discord to let me know what feature you want to see next! https://discord.com/invite/zGff9GcDCZ\n\nMade with the help of copyright-free creators: https://neozhou777.wixsite.com/rasenganrush/cc0-credits.", "short_description": "A Naruto-inspired multiplayer PvP VR game! Battle with up to 4 players as you walk on walls, use kunai, teleport, and rasengan to outplay your opponents! Many content updates planned based on community feedback."}]}, "developer_name": "Neo Zhou", "developer_privacy_policy_url": "https://neozhou777.wixsite.com/rasenganrush/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Neo Zhou", "support_website_url": null, "website_url": "https://neozhou777.wixsite.com/rasenganrush", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27113615221620386"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "558742480090587"}, {"status": "PUBLISHED", "id": "1069201804881215"}]}, "baseline_offer": {"id": "558742480090587"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732402980, "status": "PUBLISHED", "id": "558742480090587"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39234179419563845", "version": "5.2.0"}, "id": "794049176269983", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39234179419563845"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793328146, "id": "39344314215217031", "version": "5.2.1-integrity", "version_code": 281, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39234179419563845"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794049176269983"}]}, "change_log": "**5.2.0: New Jutsu: Lightning Storm!! (10/25/26)**\n*Charge and release a field of electricity around you to punish close range attackers. Enemies caught in the field have greatly reduced movement speed and can not teleport, but they can still escape if they\u2019re near the edge of the storm, so make sure to activate this move at the right distance. This move does take a lot of chakra and forces you to be stationary on release, so watch out for counterattacks! Check out the tutorial for more information.*\n\n**Chakra Overdrive Rework**\n*Dev Note: One of the most oppressive parts of chakra overdrive was getting a permanent two bar advantage over everyone else from a single interaction.*\n- One overdrive only increases your max chakra by 1 bar, but it can stack up to 3 extra bars. \n- Landing an overdrive still instantly brings you back up to max chakra. \n\n*Dev Note: Pre-rework, it was way too easy to get a game-changing buff by randomly lunging at an opponent at full speed with a giant hitbox.*\n- If your player is moving faster than sprinting (for example, jumping, falling, etc.), your chakra punch will not result in an overdrive buff. This forces you to use the move more deliberately with good focus and timing. \n\n*Dev Note: Now that the game has knockback, there\u2019s less reason to rely on one shot kills to govern player interactions.*\n- An overdrive body shot does 4 damage plus large knockback instead of 6. \n- An overdrive headshot still does 6 damage\n\n**New Teleport Features**\n- If you teleport, any enemy kunai or paper bombs will detach from your body\n- If you\u2019re touching someone with your hand while you teleport, they teleport with you (in 2v2, this only works on your teammate if \u201cDamage Teammates\u201d is on to prevent griefing)\n\n**Fireball Buff**\n- Fireball is insta-kill again on contact (however, hit detection is still based on the defender view instead of attacker view)\n- Fireball now has splash damage on surface impact, dealing 3 hearts\n\n**Fire Blossom Nerf**\n- Fire blossom splash damage: 1 -> 0.5\n\n**Quality of Life Changes**\n- Added chakra sense vision for ghosts\n- Adjusted netcode settings to help address certain connection issues\n- Improved short dreads hair texture\n- Improved lightning shader\n\n**Bug Fixes**\n- Fixed a glitch where substitution log may appear when a victim took damage from an earth spike\n- Fixed a glitch where you could hear someone hit the barrier when they didn\u2019t\n- Fixed a glitch where a player\u2019s camera could half clip through the ceiling\n- Fixed a glitch where a player that you knocked into a wall would snapback to an old position before fully staying at the wall\n- Tried to address a visual glitch where you could see a kunai miss you when it hit you\n- Fixed disabled \u201cshrinking barrier\u201d in private lobbies also disabling barrier contact\n- Fixed a glitch where you could followup punch a player multiple times while they were in knockback from an initial punch\n- Fixed glitch where fireball could hit players behind the caster", "created_date": 1792963939, "id": "39234179419563845", "version": "5.2.0", "version_code": 280, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39234179419563845"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792957372, "id": "39232491536399300", "version": "5.1.0", "version_code": 279, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39234179419563845"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792803003, "id": "39187583110890143", "version": "5.1.0", "version_code": 278, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39234179419563845"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792708812, "id": "39158733507108437", "version": "5.1.0", "version_code": 277, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
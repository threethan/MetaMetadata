721988659141295_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lmB72Tl0boQ7kNvwGF3teV&_nc_oc=AdpCvPFsbZnZf2uL-ZrffRB0kS8Hm84SRSx44xmIRt8UwLuzi6zRIuR-WqZohDUyTxU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9ADnoG9h5Bow8scT4icbKLrKvg9um7f13AxQBsTSPMA&oe=6ADCA5D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rasengan Rush Landscape.png", "id": "557998943371848", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035373_557998946705181_7620526343911324742_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmlAz0wXffMQ7kNvwHIresD&_nc_oc=AdowHTChAVVztNk6e3pevnrWiZHTdZbL5WJJsOoVDCuMWzkAhopebRIyjYgoUbHUIjg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7ViB1JjOdxC0lvNWNIH9K8ChnLMZMJN1_1UlyvZlY0w&oe=6ADCA625"}, "display_name": "Rasengan Rush", "keywords": ["Anime"], "long_description": "A Naruto-inspired multiplayer PvP VR game! Battle with up to 4 players as you walk on walls, use kunai, teleport, and rasengan to outsmart your opponents. Many content updates planned based on community feedback.\n\nJoin the discord to let me know what feature you want to see next! https://discord.com/invite/zGff9GcDCZ\n\nMade with the help of copyright-free creators: https://neozhou777.wixsite.com/rasenganrush/cc0-credits.", "short_description": "A Naruto-inspired multiplayer PvP VR game! Battle with up to 4 players as you walk on walls, use kunai, teleport, and rasengan to outplay your opponents! Many content updates planned based on community feedback."}]}, "developer_name": "Neo Zhou", "developer_privacy_policy_url": "https://neozhou777.wixsite.com/rasenganrush/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Neo Zhou", "support_website_url": null, "website_url": "https://neozhou777.wixsite.com/rasenganrush", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27113615221620386"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "558742480090587"}, {"status": "PUBLISHED", "id": "1069201804881215"}]}, "baseline_offer": {"id": "558742480090587"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732402980, "status": "PUBLISHED", "id": "558742480090587"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39073800212268434", "version": "5.1.0"}, "id": "794049176269983", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39073800212268434"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792448906, "id": "39080448851603570", "version": "5.1.0", "version_code": 276, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39073800212268434"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794049176269983"}]}, "change_log": "**5.1.0: Fully Color Customizable Jutsu Skins (10/18/26)**\n*Dev Note: The next big update will be a new jutsu: Lightning Style: Lightning Storm. It\u2019s a defensive jutsu where you charge and release a field of electricity around you to punish close range attackers. You can follow its development in the experimental app release channel and the playtest channel on discord. *\n\n**Justu Skin Shop Upgrade**\n- You can now purchase full color customization for almost all jutsu skins. (The old color cosmetics for lightning blade, chakra, chakra overdrive, fire blossom, and fireball have been removed and refunded for players who previously owned them.)I \n- Modified swirling spiral to reduce risk of future copyright issues.\n- Added color customization for most kunai and paper bomb skins\n- Added avatar previews for all jutsus skins.\n\n**Fireball Damage Buff**\n*Dev Note: Fireball was recently changed to favor what the defender sees while also being changed to do damage over time instead of instantly killing an opponent. I got a lot of comments saying that it was nerfed a little too hard, so fireball has been buffed to reward accurate placement.*\n- Fireball damage at center is a one shot (fireball damage at edge is still 24 hearts per second)\n\n**Earth Spike Hit Detection Change**\n*Dev Note: Earth spike was recently changed to favor what the defender sees on their screen which has led to a lot less complaints about getting hit by earth spike. However, some attackers feel that their attack is being unfairly substituted. Here\u2019s a middle ground:*\n- If you hit a player on your screen with an earth spike and they were only walking/running, it will count as a hit, even if it barely misses them on their own screen.\n\n**Improved Voice Chat Report System**\n- New report verdict: \u201ctoxicity\u201d. The voice chat report system looks for overly aggressive speech instead of just hate speech. Offending players will receive a warning before receiving a series of escalated mutes (1 hour -> 2 hours -> 4 hours, etc.)\n\n**New Facial Animations**\n- Avatar face animates when shooting fireball/fireblossom\n- Avatar face animates when damage is taken\n\n**bHaptics Support**\n- Added initial vibration support for bHaptics TactSuit Pro, TactSleeves, and TactVisor\n\n**Quality of Life Changes**\n- Added private lobby settings to control barrier closing and chakra for content creation and training in private lobbies\n- Added vibration settings page so you can toggle controller vibrations\n- Improved cpu cost of hit detection\n\n**Bug Fixes**\n- Fixed a bug where impact sound effects would stop prematurely\n- Fixed a rendering bug where large visual effects like chakra overdrive would hide outer visual effects if you were too close to them\n- Fixed a LIV camera follow glitch in first person\n- Added a connection test option for players who can\u2019t connect to the ranking server", "created_date": 1792427494, "id": "39073800212268434", "version": "5.1.0", "version_code": 275, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39073800212268434"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794049176269983"}]}, "change_log": "**5.1.0: Fully Color Customizable Jutsu Skins (10/18/26)**\n*Dev Note: The next big update will be a new jutsu: Lightning Style: Lightning Storm. It\u2019s a defensive jutsu where you charge and release a field of electricity around you to punish close range attackers. You can follow its development in the experimental app release channel and the playtest channel on discord. *\n\n**Justu Skin Shop Upgrade**\n- You can now purchase full color customization for almost all jutsu skins. (The old color cosmetics for lightning blade, chakra, chakra overdrive, fire blossom, and fireball have been removed and refunded for players who previously owned them.)I \n- Modified swirling spiral to reduce risk of future copyright issues.\n- Added color customization for most kunai and paper bomb skins\n- Added avatar previews for all jutsus skins.\n\n**Fireball Damage Buff**\n*Dev Note: Fireball was recently changed to favor what the defender sees while also being changed to do damage over time instead of instantly killing an opponent. I got a lot of comments saying that it was nerfed a little too hard, so fireball has been buffed to reward accurate placement.*\n- Fireball damage at center is a one shot (fireball damage at edge is still 24 hearts per second)\n\n**Earth Spike Hit Detection Change**\n*Dev Note: Earth spike was recently changed to favor what the defender sees on their screen which has led to a lot less complaints about getting hit by earth spike. However, some attackers feel that their attack is being unfairly substituted. Here\u2019s a middle ground:*\n- If you hit a player on your screen with an earth spike and they were only walking/running, it will count as a hit, even if it barely misses them on their own screen.\n\n**Improved Voice Chat Report System**\n- New report verdict: \u201ctoxicity\u201d. The voice chat report system looks for overly aggressive speech instead of just hate speech. Offending players will receive a warning before receiving a series of escalated mutes (1 hour -> 2 hours -> 4 hours, etc.)\n\n**New Facial Animations**\n- Avatar face animates when shooting fireball/fireblossom\n- Avatar face animates when damage is taken\n\n**bHaptics Support**\n- Added initial vibration support for bHaptics TactSuit Pro, TactSleeves, and TactVisor\n\n**Quality of Life Changes**\n- Added private lobby settings to control barrier closing and chakra for content creation and training in private lobbies\n- Added vibration settings page so you can toggle controller vibrations\n- Improved cpu cost of hit detection\n\n**Bug Fixes**\n- Fixed a bug where impact sound effects would stop prematurely\n- Fixed a rendering bug where large visual effects like chakra overdrive would hide outer visual effects if you were too close to them\n- Fixed a LIV camera follow glitch in first person\n- Added a connection test option for players who can\u2019t connect to the ranking server", "created_date": 1792354856, "id": "39052633967718392", "version": "5.1.0", "version_code": 274, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39073800212268434"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791928394, "id": "38921790364136087", "version": "5.0.6", "version_code": 272, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39073800212268434"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794049176269983"}]}, "change_log": "**5.0.6: Hotfix 6 (10/11/26)**\n*Dev Note: With most critical issues with the netcode rewrite patched, I\u2019m moving on to focus on new jutsu and cosmetics for the next couple of months.*\n\n**Improved Hit Detection**\n*Dev Note: I've been getting complaints that players still feel they're getting hit by moves that they shouldn't have. To deal with this, I'm making the game more defender view favored. If you didn't see that you got hit on your screen, the game won't let you get hit in more cases. *\n- Removed lag compensation on earth spike, fireball, and paper bomb. If your opponent sees they hit you at a past position because of their lag, but at your newest actual position you dodged it, you will not take the damage\n- Removed lag compensation for melee if your true position is far enough away (2.7m) from their hurtbox when an opponent tries to melee you on their screen\n\n**Fireball Nerf**\n*Dev Note: With the improved hit detection that's accurate to 1/30th of a second, fireball has gotten much stronger, since it's much more likely to overlap with your hitbox at least once. To compensate, it does not instantly kill you on first contact. Now it does a huge amount of damage over time. *\n- Instead of insta-killing on contact, fireball does 24 hearts per second (0.25 seconds of contact to kill a full health target). Damage is tuned to kill a stationary target as the fireball passes through it. \n\n**Minor Bug Fixes**\n- Fixed missing collider on top floor of construction zone\n- Fixed a glitch where a prior voice ban could come back\n- Fixed a glitch where the ranking server might be unreachable", "created_date": 1791763787, "id": "38869183462730111", "version": "5.0.6", "version_code": 271, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
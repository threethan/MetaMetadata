i": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035373_1722413798559738_6635721988659141295_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCrkghO7YbYQ7kNvwGFVW7t&_nc_oc=AdruYDsYKkrAgZeVvVqzI6fkFZ7wVaGmgxiI2DttBK9G9_1DwuLYyEybrOHn000PHyA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MB5caQgSIE0R5gjXG5IOymWDDKYzIR4GbwZnXidTeJA&oe=6A12F052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rasengan Rush Landscape.png", "id": "557998943371848", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035373_557998946705181_7620526343911324742_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9brTupG-84AQ7kNvwHh_8Ek&_nc_oc=Adr7L1_Wao2K-mV0KQelZpMVemKOr_Iy92FTyb9M7UMUz72cSdojKcXeQwWt58XuuHc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MbzgMxk_kvh2PwDETxOs-1_t3ktHUI2D-tdv1G-jBzA&oe=6A12F0A5"}, "display_name": "Rasengan Rush", "keywords": ["Anime"], "long_description": "A Naruto-inspired multiplayer PvP VR game! Battle with up to 4 players as you walk on walls, use kunai, teleport, and rasengan to outsmart your opponents. Many content updates planned based on community feedback.\n\nJoin the discord to let me know what feature you want to see next! https://discord.com/invite/zGff9GcDCZ\n\nMade with the help of copyright-free creators: https://neozhou777.wixsite.com/rasenganrush/cc0-credits.", "short_description": "A Naruto-inspired multiplayer PvP VR game! Battle with up to 4 players as you walk on walls, use kunai, teleport, and rasengan to outplay your opponents! Many content updates planned based on community feedback."}]}, "developer_name": "Neo Zhou", "developer_privacy_policy_url": "https://neozhou777.wixsite.com/rasenganrush/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Neo Zhou", "support_website_url": null, "website_url": "https://neozhou777.wixsite.com/rasenganrush", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27113615221620386"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "558742480090587"}, {"status": "PUBLISHED", "id": "1069201804881215"}]}, "baseline_offer": {"id": "558742480090587"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732402980, "status": "PUBLISHED", "id": "558742480090587"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35446844751630683", "version": "4.2.0"}, "id": "794049176269983", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35446844751630683"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794049176269983"}]}, "change_log": "**4.2.0: Report System (5/17/26)**\n*Developer Note: You can finally deal with toxic players and report hate speech and harassment!*\n\n**Added Voice Chat and Username Reporting**\n- __Easy to Use:__ Your device collects the last two minutes of voice chat for you. To report someone, press 3 buttons from the menu lobby list, and you're done. \n- __Fast:__ The automated system acts in seconds, so you don't have to wait days for a moderator. \n- __Evidence Based:__ Action is only taken for cases with clear evidence. If you think the system made a mistake, you can appeal and a human moderator can roll back the result.\n\n**Cosmetics Improvements **\n- Added water jet color customization in cosmetics shop\n- Added ability to equip two different chakra sense eyes\n\n**Hand Sign Tutorial Improvements**\n- I'm working with professional UI designer Barnabas Lee to improve the tutorial, starting with hand signs:\n- Added new tutorial section to better break down how to perform hand signs for beginners\n- Hand sign videos show oculus hands with controllers instead of in game hands\n\n**Quality of Life Improvements**\n- Increased voice chat volume\n- Added LIV camera streaming support\n- Added internet connection strength information for each player in the menu lobby list\n- Added 3/4 majority force start for when the host isn\u2019t starting a game when everyone else wants to\n\n**Bug Fixes**\n- Fixed issue for players with \u201cclose\u201d hand sign distance setting where jutsu sequence might cancel if the last hand sign is repeated\n\n**Balance Changes**\n- Fire jutsus now detonate paper bombs immediately. This prevents you from being able to pre-trigger a paper bomb kunai in your hand for half a bar of chakra. \n", "created_date": 1779068483, "id": "35446844751630683", "version": "4.2.0", "version_code": 195, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35446844751630683"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "c
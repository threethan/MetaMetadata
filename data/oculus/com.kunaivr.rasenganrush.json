ary", "id": "39464181159897002"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793826381, "id": "39496932189955232", "version": "15.2.0", "version_code": 288, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39464181159897002"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794049176269983"}]}, "change_log": "**5.2.1: Cosmetic Presets (11/3/26)**\n*Dev Note: This feature has been requested for a long time! You can now save and load outfit, jutsu skin, and ninja tool combos in 10 different slots.* \n\n**Fireball Hit Detection Change**\n- If you hit a player on your screen with a fireball and they were only walking/running, it will count as a hit, even if it barely misses them on their own screen.\n\n**Bug Fixes**\n- Fixed being able to go through the back of stairs in construction zone\n- Fixed earth spike being able to hit through ceiling/floor in construction zone\n- Fixed glitch where you could clip under the ground by virtual crouching, and then really crouching\n- Fixed glitch where you could clip into a building by throwing a kunai inside of it and then force pulling on it\n- Fixed glitch where in certain instances, a player could sub an earth spike just by walking\n\n**Backend Security Update**\n- Added meta attestation to server logic to add some protection against cheating for ranking, voice, and general gameplay", "created_date": 1793723856, "id": "39464181159897002", "version": "15.2.0", "version_code": 287, "release_status": "RELEASED", "status": "A
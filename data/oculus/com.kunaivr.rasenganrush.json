721988659141295_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_ZU_iJHeVkQ7kNvwGipWeq&_nc_oc=Adph0F105a1hpUkEM3iKXsV3pA2w9zLBzd6KOUEwim2S-FMejkiWzx7rsdeEjpQXh7s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeZBEeL8cnqIsjYilHp9jPV-2wEqmi0jPvox8vP8o60g&oe=6A4E43D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rasengan Rush Landscape.png", "id": "557998943371848", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035373_557998946705181_7620526343911324742_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jTViJY84LgQ7kNvwFR08GW&_nc_oc=AdpAtEgQJcpEjWJF4y6VHt83Qi9Akp3bgCK4z0JqCDZsQWIw-WlRQO1cspXFTGaquoQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxv4d1JpdwhyOCArwXfhswr1TJGQw-TeAAosqkKFhpSg&oe=6A4E4425"}, "display_name": "Rasengan Rush", "keywords": ["Anime"], "long_description": "A Naruto-inspired multiplayer PvP VR game! Battle with up to 4 players as you walk on walls, use kunai, teleport, and rasengan to outsmart your opponents. Many content updates planned based on community feedback.\n\nJoin the discord to let me know what feature you want to see next! https://discord.com/invite/zGff9GcDCZ\n\nMade with the help of copyright-free creators: https://neozhou777.wixsite.com/rasenganrush/cc0-credits.", "short_description": "A Naruto-inspired multiplayer PvP VR game! Battle with up to 4 players as you walk on walls, use kunai, teleport, and rasengan to outplay your opponents! Many content updates planned based on community feedback."}]}, "developer_name": "Neo Zhou", "developer_privacy_policy_url": "https://neozhou777.wixsite.com/rasenganrush/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Neo Zhou", "support_website_url": null, "website_url": "https://neozhou777.wixsite.com/rasenganrush", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27113615221620386"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "558742480090587"}, {"status": "PUBLISHED", "id": "1069201804881215"}]}, "baseline_offer": {"id": "558742480090587"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732402980, "status": "PUBLISHED", "id": "558742480090587"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35599321183049705", "version": "4.2.1"}, "id": "794049176269983", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35599321183049705"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794049176269983"}]}, "change_log": "4.2.1: Matchmaking Improvements (5/23/26)\nDev Note: The next update will involve rewriting the game from scratch in a new netcode framework to improve hitboxes. This will be the game\u2019s biggest update to date, and will probably take at least 1-3 months.\n\nMatchmaking Filters\n- Filters help avoid the worst possible experience: playing against someone who is way above your skill level. \n- Replaced skill lock system with a three-tier skill level filter: \u201cfair matches\u201d, \u201cwide matches\u201d, or \u201cany matches\u201d. Each filter makes a trade off between match fairness and queue time length. Hosts can choose a filter for their lobby, and joiners can choose a filter while searching for lobbies.  \n- Added a popup warning for players when they try to join a much higher level lobby\n\nRating System Improvements\n- Your skill level updates immediately after you or the host leaves the lobby. Leaving has always counted as a loss, but the update would be delayed, so it was hard to tell. \n- You can see the skill level of each player in the lobby UI and in their player profile\n\nImproved Report System\n- Improved the accuracy of the report system\u2019s detection system based on player appeals\n\nBug Fixes\n- Fixed issues where lobby vote-start system might not work\n- Fixed some UI visual glitches", "created_date": 1779671813, "id": "35599321183049705", "version": "4.2.1", "version_code": 199, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35599321183049705"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794049176269983"}]}, "change_log": "4.2.1: Matchmaking Improvements (5/23/26)\nDev Note: The next update will involve rewriting the game from scratch in a new netcode framework to improve hitboxes. This will be the game\u2019s biggest update to date, and will probably take at least 1-3 months.\n\nMatchmaking Filters\n- Filters help avoid the worst possible experience: playing against someone who is way above your skill level. \n- Replaced skill lock system with a three-tier skill level filter: \u201cfair matches\u201d, \u201cwide matches\u201d, or \u201cany matches\u201d. Each filter makes a trade off between match fairness and queue time length. Hosts can choose a filter for their lobby, and joiners can choose a filter while searching for lobbies.  \n- Added a popup warning for players when they try to join a much higher level lobby\n\nRating System Improvements\n- Your skill level updates immediately after you or the host leaves the lobby. Leaving has always counted as a loss, but the update would be delayed, so it was hard to tell. \n- You can see the skill level of each player in the lobby UI and in their player profile\n\nImproved Report System\n- Improved the accuracy of the report system\u2019s detection system based on player appeals\n\nBug Fixes\n- Fixed issues where lobby vote-start system might not work\n- Fixed some UI visual glitches", "created_date": 1779669050, "id": "35598725599775930", "version": "4.2.1", "version_code": 198, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35599321183049705"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794049176269983"}]}, "change_log": "4.2.1: Matchmaking Improvements (5/23/26)\nDev Note: The next update will involve rewriting the game from scratch in a new netcode framework to improve hitboxes. This will be the game\u2019s biggest update to date, and will probably take at least 1-3 months.\n\nMatchmaking Filters\n- Filters help avoid the worst possible experience: playing against someone who is way above your skill level. \n- Replaced skill lock system with a three-tier skill level filter: \u201cfair matches\u201d, \u201cwide matches\u201d, or \u201cany matches\u201d. Each filter makes a trade off between match fairness and queue time length. Hosts can choose a filter for their lobby, and joiners can choose a filter while searching for lobbies.  \n- Added a popup warning for players when they try to join a much higher level lobby\n\nRating System Improvements\n- Your skill level updates immediately after you or the host leaves the lobby. Leaving has always counted as a loss, but the update would be delayed, so it was hard to tell. \n- You can see the skill level of each player in the lobby UI and in their player profile\n\nImproved Report System\n- Improved the accuracy of the report system\u2019s detection system based on player appeals\n\nBug Fixes\n- Fixed issues where lobby vote-start system might not work\n- Fixed some UI visual glitches\n", "created_date": 1779666814, "id": "35598257949822695", "version": "4.2.1", "version_code": 197, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35599321183049705"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794049176269983"}]}, "change_log": "4.2.1: Matchmaking Improvements (5/23/26)\nDev Note: The next update will involve rewriting the game from scratch in a new netcode framework to improve hitboxes. This will be the game\u2019s biggest update to date, and will probably take at least 1-3 months.\n\nMatchmaking Filters\n- Filters help avoid the worst possible experience: playing against someone who is way above your skill level. \n- Replaced skill lock system with a three-tier skill level filter: \u201cfair matches\u201d, \u201cwide matches\u201d, or \u201cany matches\u201d. Each filter makes a trade off between match fairness and queue time length. Hosts can choose a filter for their lobby, and joiners can choose a filter while searching for lobbies.  \n- Added a popup warning for players when they try to join a much higher level lobby\n\nRating System Improvements\n- Your skill level updates immediately after you or the host leaves the lobby. Leaving has always counted as a loss, but the update would be delayed, so it was hard to tell. \n- You can see the skill level of each player in the lobby UI and in their player profile\n\nImproved Report System\n- Improved the accuracy of the report system\u2019s detection system based on player appeals\n\nBug Fixes\n- Fixed issues where lobby vote-start system might not work\n- Fixed some UI visual glitches\n", "created_date": 1779566247, "id": "35575786282069862", "version": "4.2.1", "version_code": 196, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26557592687222645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35599321183049705"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794049176269983"}]}, "change_log": "**4.2.0: Report System (5/17/26)**\n*Developer Note: You can finally deal with toxic players and report hate speech and harassment!*\n\n**Added Voice Chat and Username Reporting**\n- __Easy to Use:__ Your device collects the last two minutes of voice chat for you. To report someone, press 3 buttons from the menu lobby list, and you're done. \n- __Fast:__ The automated system acts in seconds, so you don't have to wait days for a moderator. \n- __Evidence Based:__ Action is only taken for cases with clear evidence. If you think the system made a mistake, you can appeal and a human moderator can roll back the result.\n\n**Cosmetics Improvements **\n- Added water jet color customization in cosmetics shop\n- Added ability to equip two different chakra sense eyes\n\n**Hand Sign Tutorial Improvements**\n- I'm working with professional UI designer Barnabas Lee to improve the tutorial, starting with hand signs:\n- Added new tutorial section to better break down how to perform hand signs for beginners\n- Hand sign videos show oculus hands with controllers instead of in game hands\n\n**Quality of Life Improvements**\n- Increased voice chat volume\n- Added LIV camera streaming support\n- Added internet connection strength information for each player in the menu lobby list\n- Added 3/4 majority force start for when the host isn\u2019t starting a game when everyone else wants to\n\n**Bug Fixes**\n- Fixed issue for players with \u201cclose\u201d hand sign distance setting where jutsu sequence might cancel if the last hand sign is repeated\n\n**Balance Changes**\n- Fire jutsus now detonate paper bombs immediately. This prevents you from being able to pre-trigger a paper bomb kunai in your hand for half a bar of chakra. \n", "created_date": 1779068483, "id": "35446844751630683", "version": "4.2.0", "version_code": 195, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
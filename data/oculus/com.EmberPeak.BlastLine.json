&_nc_ohc=SQwyeGdh1sIQ7kNvwE51r83&_nc_oc=Adr2rcc2-tSIUABkvV2bpm3XeJleZGncCeOp2fC4JDlB8SCEsE2tHjxs2l6EJEi67_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM07pvllUHktSpH5aBOc0PRjjzdBolXi5uRwDo_Hbctg&oe=6AFDC767"}, {"file_name": "499313074_838183169226831_3756970441432741419_n.png", "id": "2206476066614671", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/814574569_2206476069948004_3965981159512306370_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUYj9BBiOuEQ7kNvwH-GdCP&_nc_oc=AdqhMH21JwArM5zFSNteXRtuPaoSxdyp7UUqo4oJqfT22t6DvA2OYd9UiRHQ7PNIiRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6qCBKTNfH3EGgPWVSFLjTgy05uszsIDuDbbf28w8dMg&oe=6AFDD3FA"}, {"file_name": "499311597_1480066134118371_2415940981295660216_n.png", "id": "1144070998288216", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831279_1144071001621549_2656983400028242458_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5ZJa3iuu8MQ7kNvwE1bpBv&_nc_oc=AdpISmQ82MOHAJm4r5n1ZriijU8x10gYrgZFaNbv8Y2BKpZ6pRloyQpG3zChSWXzhwg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0GLwB1P3FUMJ2UqYnPwAnhTCtTcW3CtTgyE_jPE5kfA&oe=6AFDD786"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SuperHot Shooter", "keywords": ["Shotgun", "shooter", "dodge", "strategy", "action"], "long_description": "Every bullet hangs in the air. Every enemy waits for your next move. In SuperHot Shooter, time only moves when you do.\n\nNo health packs. No second chances. No backup. Just you, a room full of enemies and a split second to decide. Lean out of a bullet\u2019s path. Snatch a pistol from mid-air. Throw it, punch through glass and take the next shot before anyone can react.\n\nEvery fight is a puzzle and an action scene at the same time. Stand still and the world freezes. Move and everything rushes back.\n\nSomething about this place doesn\u2019t feel right. The walls are too clean. The enemies shatter like glass. Keep going and find out why.\n\nBuilt for Meta Quest from the ground up. Fully wireless, roomscale combat with no cables to slow you down.\n\nSlow-motion combat where time follows your movement\nPistols, shotguns, rifles, katanas and anything you can throw\nDozens of handcrafted levels\nEndless mode and challenge modes for replay value\nComfortable, standing or roomscale play\n\nMOVE SLOW. THINK FAST.", "short_description": "Time only moves when you do. Dodge bullets, grab weapons and outthink every enemy in slow-motion VR combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1435548132980888"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593832569_1530264928918975_5642442740645166746_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b077N3KEFOUQ7kNvwGtCMEP&_nc_oc=AdofXEgOKJhGTCG8Cvcc9yMBENAKuFjpGVl-lESr0ETa3CAE8tpOw_EdPPZzRMPTeFw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFBXrcroaKpQ-TtPi-wVixttSllx1xottJ
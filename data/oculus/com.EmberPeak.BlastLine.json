9ubthD2EJdVS3OohfTXnAhw&oe=6AF49682"}]}, "id": "1031230455976133", "locale": "en_US", "screenshots": [{"file_name": "33.png", "id": "2154354501789111", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307470_2154354505122444_3843098167436855806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13zx1h_XOQwQ7kNvwFWAzv9&_nc_oc=Adr23799GOXm96geMiV8tq6SJvoGIr9fzZe_3Jw4HW73nTwe07kKQo1pbO3MJlBRuWY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSqHU2xNIEg0aByP9twrib4yMqM0vUSnJ7CbqI2eYJ_Q&oe=6AF47152"}, {"file_name": "55.png", "id": "1911374249497002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308050_1911374252830335_1976584659005312843_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4AZ09-vGRUQ7kNvwGD01IB&_nc_oc=AdoYbBK0ZtdVVEQqKPPUMzeqaONfgxXfIvTNBmMN1DCG0LEwL9xQqUxF6on4EqO_DEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEuL_hQThLNAjzir-cIJ2XiJbJgSuP1Fy12psYJYY9rw&oe=6AF49A0D"}, {"file_name": "11.png", "id": "1349589203261298", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304952_1349589206594631_2781220959116397150_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVTE7nNue-YQ7kNvwFY8Nsp&_nc_oc=AdqI1DTyzrRfDJNLoxyWEHJZe1r1f81mQHYpKAiuv5k6AKScsuizqebbwtxMOt1IL28&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj1Ia6cdfV2_E59SLHwour5_NWcYeB5RQ_55EsRxKGjA&oe=6AF49BFE"}, {"file_name": "44.png", "id": "3457576017735350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_3457576021068683_2315214488520958624_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1UdfAz0ijQQ7kNvwG_ezUX&_nc_oc=AdqTkmGrlmVurw8pR2cEgulaCKsy5B1f-tbZL8t1kUYil2xyBr3IxkXc-SZdGfxOJ3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTivTN1vkd37mPkas_98hKvIqqHQTekchEQhgNzm0yJvA&oe=6AF48B44"}, {"file_name": "22.png", "id": "977320322009212", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310734_977320325342545_3636623542292636322_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEk76VqIleoQ7kNvwGzDTtT&_nc_oc=AdqmS_zuV03etjDH7Yr2UUNzxIB8m6lrauBz9rvAaXTlaueX7IV2kSavIBtvBVWWItQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCka5AknRiWxeXkVPSr5XaCl_AXeynTubWLflu_4HpUg&oe=6AF484E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlastLine", "keywords": ["shotgun", "waveshooter", "action", "survival", "fps"], "long_description": "They\u2019re coming. \ud83d\udd25 You\u2019ve got two shotguns. \ud83d\udd2b\ud83d\udd2b Don\u2019t back up. \u26a0\ufe0f\n\nBlastLine drops you into a dark industrial kill zone \ud83c\udfed with a shotgun in each hand and waves \ud83c\udf0a of aggressive melee raiders \ud83c\udfc3\u200d\u2642\ufe0f closing fast. This is close-quarters VR combat \ud83e\udd7d \u2014 wide pellet spread \ud83d\udca5, heavy impact \ud83d\udca3, and enemies that get knocked back, ragdolled \ud83e\udd38, and launched into crates \ud83d\udce6, railings, and factory walls.\n\n\ud83c\udfae CORE GAMEPLAY\n\ud83d\udd2b\ud83d\udd2b Dual-wield pump shotguns from the first second\n\ud83c\udf0a Fast wave-based arena survival in tight industrial spaces \ud83c\udfed\n\ud83d\udca5 Point-blank shotgun blasts with satisfying knockback physics\n\ud83c\udfc3\u200d\u2642\ufe0f Human raider enemies \u2014 readable silhouettes, relentless rush-down AI\n\ud83c\udfc6 Score chase with \ud83d\udd25 combos, \ud83c\udfaf multi-kills, and \u2b50 wave-clear bonuses\n\ud83e\udd7d BUILT FOR VR\n\ud83d\udd04 Physical pump-action reload rhythm between bursts\n\ud83d\udeb6 Room-scale movement to create distance and survive swarms\n\ud83d\udcca Minimal HUD \u2014 ammo, \u2764\ufe0f health, \ud83c\udf0a wave, \ud83c\udfc6 score, \ud83d\udd25 combo\n\ud83d\udca1 Industrial lighting and \ud83d\udca5 impact feedback for readable combat\n\ud83d\udc65 WHO IS THIS FOR?\n\nIf you love \ud83c\udfaf arena shooters, \ud83c\udf0a wave survival, and the raw feel of a \ud83d\udd2b shotgun at arm\u2019s length \u2014 BlastLine is your line to hold.\n\n\u26a1 Strap in. \ud83d\udd04 Pump both barrels. \ud83d\udca5 Clear the wave. \ud83c\udfc6", "short_description": "Dual-wield pump shotguns and hold the line in a claustrophobic industrial arena. BlastLine is a fast-paced VR wave shooter built for point-blank combat \u2014 pump, fire, and send raiders flying with physics-driven knockback and ragdoll impacts. Survive escalating enemy waves, chain combo kills, chase point-blank bonuses, and push your score before the arena breaks you. Simple to pick up. Brutal to master. Built for players who want raw shotgun power, not cover camping."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1211504252051945"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "29302205876041022"}, {"status": "PUBLISHED", "id": "1023958210413566"}]}, "baseline_offer": {"id": "1023958210413566"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "29302205876041022"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "And
1-7&_nc_sid=6e7a0a&_nc_ohc=_dIx-T6XEYoQ7kNvwFsHRub&_nc_oc=AdrisXzt-dqB6ImDxz55sYxt-4tWUWEuyLFGDiKBuPTlH8XhKo8ncQ0NEt683_RxWVQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbrg0m0zHwl_xx014IkI0NqERxCaVrMzDsv1ztjAphAA&oe=6AF48CE7"}, {"file_name": "499313074_838183169226831_3756970441432741419_n.png", "id": "2206476066614671", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/814574569_2206476069948004_3965981159512306370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqMTzFrpgiMQ7kNvwGnzbbD&_nc_oc=AdpZQIKp4PhbPnlkfqZVDz6GSXcu9covUu-5UGA4T8NWhYrBoRqL6pzW28u5SvPhFQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7bKV_gdwUmNPtGNBoc4dyvtO-EAfr1uUYQBXZ1yGZYA&oe=6AF4997A"}, {"file_name": "499311597_1480066134118371_2415940981295660216_n.png", "id": "1144070998288216", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_1144071001621549_2656983400028242458_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a19i7OrOiHcQ7kNvwEN3fVa&_nc_oc=AdrI--bSgPvcam8ao_ZI0Ae3_KKT_-hMyrXQUVgrbeRYafq80muMEpb71D2FE_qWN5c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmImX8ZKNIbmjQVxpEgfD-MBPPltE4g_eNH3AHTDCUkQ&oe=6AF49D06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shotgun Arena: Survival Shooter", "keywords": ["Shotgun", "SurvivalShooter", "ArcadeShooter", "WaveShooter", "PhysicsCombat"], "long_description": "Grab a pump shotgun in each hand and fight through relentless waves in a fast-paced arcade survival shooter built around close-range gun combat, physical reloads and powerful ragdoll impacts.\n\ud83d\udd2b DUAL SHOTGUN COMBAT\nDual-wield pump-action shotguns and master the rhythm of pump, aim and fire. Get close to your enemies for devastating blasts and high-risk point-blank bonuses.\n\ud83c\udf0a WAVE SURVIVAL\nEnemies rush the arena from every direction. Survive increasingly difficult waves, create space and react quickly as the pressure continues to build.\n\ud83d\udca5 PHYSICS-BASED ACTION\nEvery shotgun blast delivers powerful physical feedback. Send enemies flying into crates, railings and arena objects with physics-driven knockback and ragdoll reactions.\n\ud83c\udfc6 ARCADE HIGH-SCORE CHALLENGE\nChain eliminations, earn multi-kills, collect point-blank bonuses and clear waves to push your score higher every run.\n\ud83c\udfaf SIMPLE TO PLAY, HARD TO MASTER\nNo complicated loadouts or slow tactical planning. Grab your shotguns and start shooting.\nIf you enjoy shotgun games, arcade shooters, survival shooters, wave combat, gun games and physics-based action, enter the arena and see how long you can survive.", "short_description": "Dual-wield pump shotguns and survive relentless enemy waves in a fast-paced arena shooter. Pump, fire and blast enemies backward with physics-driven knockback and ragdolls. Chain kills, earn point-blank bonuses and chase higher scores as each survival wave becomes more intense.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1369635389572163"}, "review_messages": []}]}, "cover_square_image": {"uri": "http
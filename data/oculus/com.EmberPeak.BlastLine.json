kNvwHBDucM&_nc_oc=AdrjJ3IjiOCAbpDOjmm50Hsx9v2PKQZW8D0fjFqWDOmYM5ijB1KdxN83l1eHEb-4Ugk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgK_XsL-F5jFt_LHO2vb1T8SDJHUvHftQJp0kZ3qi37w&oe=6A9856DE"}, {"file_name": "ss4.png", "id": "1589721809333075", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507829686_1589721812666408_6884459209605939410_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPSsFpcRwAMQ7kNvwEDNhek&_nc_oc=AdoFvEi89VA_RSizOYTFzi73X6P1TcYm2oOCj164zrcCp4N1BLp7pVTlDwOD4NBGM40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJn0k9NbfztoFuWvIozq9Ifjn91AK7biHuIMmnlr0ialQ&oe=6A9865E3"}, {"file_name": "ss2.png", "id": "2201744197337027", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310726_2201744200670360_7971664590654522271_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWE3EMIPJcYQ7kNvwHdSiEt&_nc_oc=AdoIAIq6k0B-9Ex23hASYVh80os1zHSW6QmDxdiQHenIcvLxPWUJKpA5CwzBlKrz6fk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5j2fmv3keF8JsW6-TIT23ycQSK8BNiHbTBA5VJMLUFg&oe=6A986AB4"}, {"file_name": "ss1.png", "id": "1051575380661232", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1051575383994565_6782217294036833401_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06Wp-v5klU4Q7kNvwH1nLif&_nc_oc=AdptVadr5omIWfmyZM6UvhHUQi9j2H2xdFzzXpDWT9FediAUeppnHT4i8KmeWJxqR_k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKohZ3FnPH069ZitoKaNCBLflvXo_3UzbJcD8T6uAJNpw&oe=6A984572"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlastLine", "keywords": ["tactical", "gun", "shooting", "soldier", "combat"], "long_description": "TWO SHOTGUNS. ZERO COVER.\nThey're coming straight at you.\nGrab a pump shotgun in each hand and hold the line as relentless enemy waves close in from every direction. BlastLine is an intense arcade-style VR wave shooter built around point-blank shotgun combat, physical knockback and brutal ragdoll impacts.\n\ud83d\udd2b DUAL-WIELD SHOTGUN COMBAT\nPump. Aim. Fire. Repeat.\n\u2022 Dual-wield pump shotguns from the start\n\u2022 Powerful close-range blasts with wide pellet spread\n\u2022 Physical pump-action reload rhythm\n\u2022 Enemies react to every blast with physics-driven knockback and ragdolls\n\u2022 Get up close for bigger risks and bigger rewards\n\ud83c\udf0a HOLD THE LINE\nThe enemies don't stop coming.\n\u2022 Fight escalating waves of aggressive melee raiders\n\u2022 Move around the arena to create space and survive the rush\n\u2022 Watch enemies crash into crates, railings and industrial structures\n\u2022 Stay alive as the pressure builds with every wave\n\ud83c\udfc6 CHASE THE HIGH SCORE\nSurviving isn't enough. Make every shell count.\n\u2022 Chain kills into combos\n\u2022 Stack multi-kills\n\u2022 Earn point-blank bonuses\n\u2022 Clear waves for bonus points\n\u2022 Push your score higher every run\n\ud83d\udca5 BUILT AROUND IMPACT\nBlastLine is all about the physical satisfaction of shooting a shotgun at arm's length and watching the target react.\nHeavy blasts. Violent knockback. Flying enemies. Fast decisions.\nNo complicated loadouts. No cover camping. No waiting around.\nJust two shotguns, incoming waves and one line to hold.\nHow long can you survive?\nPump both barrels. Hold the line.", "short_description": "Dual-wield pump shotguns and hold the line in a claustrophobic industrial arena. BlastLine is a fast-paced VR wave shooter built for point-blank combat \u2014 pump, fire, and send raiders flying with physics-driven knockback and ragdoll impacts. Survive escalating enemy waves, chain combo kills, chase point-blank bonuses, and push your score before the arena breaks you. Simple to pick up. Brutal to master. Built for players who want raw shotgun power, not cover camping."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "sup
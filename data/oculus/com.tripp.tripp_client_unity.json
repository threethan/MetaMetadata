s. We welcome your feedback at support@tripp.com. TRIPP - Fitness for Your Inner Self! Footage captured in-engine.", "short_description": "Based on scientific research, TRIPP helps you change the way you feel through targeted, deeply immersive exercises that leave you feeling calm and focused, less stressed and anxious. The TRIPP platform delivers daily updates to its subscribers. We add new experiences regularly. TRY the FREE demo and unlock the full offering at TRIPP.com with a credit card - You can cancel anytime during the 7 Day Trial at no charge. TRIPP - Fitness for Your Inner Self!"}]}, "developer_name": "TRIPP, Inc.", "developer_privacy_policy_url": "https://www.tripp.com/privacy-policy", "developer_terms_of_service_url": "https://www.tripp.com/terms_of_use", "publisher_name": "TRIPP, Inc.", "support_website_url": null, "website_url": "https://www.tripp.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "RELAXATION_MEDITATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1354684228325960"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1323635115491629"}, {"status": "PUBLISHED", "id": "532481964012133"}]}, "baseline_offer": {"id": "1323635115491629"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740515880, "status": "PUBLISHED", "id": "1323635115491629"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typen
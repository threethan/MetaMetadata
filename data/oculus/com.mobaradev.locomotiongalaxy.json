20f&oh=00_AQAjZdtDqKDXbrFueyif-yFB-QCW_NkM3rFcFt82J9Jnnw&oe=6A5115F0"}, {"file_name": "13.png", "id": "1960450737944549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618264_1960450741277882_2204928023390578777_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17tQdwEPW5AQ7kNvwG84n4x&_nc_oc=AdouzUTJJNu7ED7UHoXk5No6DhRa-V_9msMsU_jnbgTQIRHU_emvsPesDetAUxz-E80&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOftUdnaYonOwfOcZzzn5E9D3uw8WmXXiKQTKx0B8G4Q&oe=6A50E983"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImg2.png", "id": "895785093338552", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617850_895785096671885_3327118725137944412_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVw4tDmdCl0Q7kNvwEgVjmS&_nc_oc=AdonhQGD1RlaR6ccSX9-f0TBODaTn_XuvzFBsD2BrItcY3u2VErf_cGChnKfoI0XR7w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB567ToL8lBIu4S0RdYKOfCSePvghtvGhh8hKEG_vt1pQ&oe=6A510101"}, "display_name": "Locomotion Galaxy", "keywords": ["locomotion", "teleportation", "galaxy", "exploration", "dash"], "long_description": "*Welcome to the Locomotion Galaxy!*\n\nExperience the ultimate VR movement playground across the stars! Explore the stunning Locomotion Galaxy and discover which style suits you best. Master six distinct techniques across three alien worlds to collect every star. Want to practice? Jump into the Playground Mode to mix movement styles on the fly, explore freely, and hunt for hidden coins. Embark on a journey and master 6 distinct locomotion methods in the most immersive movement trainer ever built.\n\nMix & Match: Switch between all 6 locomotion methods on the fly. Want to Arm Swing up a hill and Teleport across a gap? Now you can.\n\nWhether you are a VR veteran or a newcomer looking to find your \"VR legs,\" this game provides a safe and fun environment to test your limits and discover your favorite way to play.\n\nMost games lock you into one way of moving. We give you the keys to the whole galaxy. By repeating the same handcrafted levels with different mechanics, you\u2019ll gain a deep understanding of VR physics and movement, all while exploring the farthest reaches of the stars.\n\n\ud83d\ude80 The 6 Ways to Move:\n\nConquer every level using a spectrum of movement:\n1. Teleportation\n2. Dash\n3. Smooth Walk\n4. Head-Tilt\n5. Walk In Place\n6. Arm Swing\n\n\ud83c\udfae36 stars to collect in 5 distinct level across three alien planets!\n\nAre you ready to find your flow? Download Locomotion Galaxy today and master the move!\n\nThe game time is expected to last between 45 minutes and 2 hours, depending on how thoroughly you explore the planets.", "short_description": "Experience the ultimate VR movement playground across the stars! Explore the stunning Locomotion Galaxy and discover which style suits you best. Master six distinct techniques across three alien worlds to collect every star. Want to practice? Jump into the Playground Mode to mix movement styles on the fly, explore freely, and hunt for hidden coins. Whether you're finding your VR legs or seeking an advanture, the galaxy is yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mobaradev.com/privacy-policy/locomotion-galaxy", "developer_terms_of_service_url": null, "publisher_name": "UNR VR LAB", "support_website_url": null, "website_url": "https://mobaradev.com/locomotion-galaxy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
icon-v1.png", "id": "1027295663715039", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628909_1027295667048372_3530914028923752995_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5e1J2_SrdcQ7kNvwEDIv01&_nc_oc=Adq-zxkjBQvwK3HnORN4tr6ZWFM1ijpAcAnebHH149jHgzIgAWi3jv9EETbt7X7kyhc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQY9Ey0_ya_-w91jujNicvJvYfMLS42SZgrwt8gmXlj5Q&oe=6B0C5EE3"}]}, "id": "3438035699737288", "locale": "en_US", "screenshots": [{"file_name": "01-alien-invasion-angle.png", "id": "2096638207635270", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628455_2096638214301936_2652399150724529198_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbKEhUrK-KgQ7kNvwFmYAC-&_nc_oc=Adr2OCTZhEXLd0uQQUIDiMP59eV5Gnu4UccCmkWJsGhSA5urs8c8OBqs6hlRqy0MSzw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQUObLvONSk1fOJU5ipKmObk4r3lRhjNTVkdneVKccyNQ&oe=6B0C7E37"}, {"file_name": "03-bowling-roll.png", "id": "4460765554188218", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624592_4460765557521551_5177866448824996905_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQIZQPLpLNkQ7kNvwEx4chb&_nc_oc=Ado95NSYrfN54csXMIBNpGTCxe3uOPnzinIkguTbt_YIen10rmsRl3UDQayUImaBW60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPuBpuA6et31LAw1SSialAyBqJq-iNWkZ7hIDEN3YfgA&oe=6B0C53A1"}, {"file_name": "05-air-hockey.png", "id": "1851062896252369", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628454_1851062899585702_6690423345498618918_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKBtuA5CnKQQ7kNvwFBR7KG&_nc_oc=Adop_4NgXXncr8DLh8LSabPiEonPanSftGsbwjhwDLGEtaGbt8VGGaU3N1C_JemA9XY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSXxweq6CxE90Pi15EpFOsehABs5mw7EIw7kANYCxslig&oe=6B0C8533"}, {"file_name": "02-pool-midgame.png", "id": "1795642241652022", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499626728_1795642244985355_6492212168926620475_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-lW75m2dBAQ7kNvwE88-o9&_nc_oc=Adpf-q1M_JpTfmO-lq5BB_51WCAT9-zKdR6NltFtsCzTF5jhrVhQRpFHXcLyPeDwBeg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSzLGt0ZkNIe54nFEyUUMiO5a1M1jggmpsK5aER9AeJAA&oe=6B0C650F"}, {"file_name": "04-chess-in-progress.png", "id": "993771803114231", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593877129_993771806447564_5841823636963048634_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ourTPuwqgUIQ7kNvwHRI9ve&_nc_oc=AdrO_JApgakqprm7f7hX19mUD3-AruHxpY5VFM3YHhHNSrZ2bJQKYc50xyayIhMJnJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZpyiiqBZ6bfU5zuzUlrdMjfgsvidoc-VjHTzb_k336Q&oe=6B0C774C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anyday Arcade", "keywords": [], "long_description": "Step into your own VR games club.\n\nAnyday Arcade brings six games together in a bright, welcoming space. Throw darts at arcade targets, stop charging ships in Alien Invasion, take on an air-hockey CPU, line up a pool shot, settle into chess or roll through a ten-frame bowling game.\n\nMake it your regular place to play:\n\u2022 Six activities in one club, with three bowling lanes, two pool tables and two chess boards.\n\u2022 Play offline, practise at your own pace or challenge CPU opponents in air hockey, eight-ball and chess.\n\u2022 Create a private online room for up to eight players. Share the club, watch a game and join friends at the stations.\n\u2022 Pick up and use the game equipment with your Touch controllers. Choose teleport or smooth movement and adjust turning and graphics in the menu.\n\u2022 Keep your local scores and settings, with Meta leaderboards for supported results.\n\nOne purchase. No subscription, ads or in-app purchases. Online rooms require an internet connection. Voice chat is not included.", "short_description": "Your VR games club, any day. Play darts, Alien Invasion, air hockey, pool, chess and ten-pin bowling in one warm, welcoming venue. Drop in solo or create a private room for up to eight players."}]}, "developer_name": "Roomshift Games", "developer_privacy_policy_url": "https://www.naveens.dev/privacy/lanternbay", "developer_terms_of_service_url": null, "publisher_name": "Roomshift Games", "support_website_url": "https://www.naveens.dev/privacy/lanternbay/", "website_url": "https://www.naveens.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "1413561211845794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619369_1158080843391890_661395188595125660_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oantzkCzEG0Q7kNvwFdng5z&_nc_oc=AdqUmB5NV3j0VpCK3ylj_NyVrDNkM9nOmir6xSYR5gUnah4EUJNBcB_yiqqc_fQ_h-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1U6klH0WWdCxq6uG5X8J2hnwEQS-s6uGgfE6hszNKsQ&oe=6B0C709B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Anyday Arcade", "platform": "AN
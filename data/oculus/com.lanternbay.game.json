BZPjLAq6FEEbyzMgD1CvdqIDz4zq-uUp_UM5ZdIIXgkePk0s5IrQeCY-xc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcmLeIiH3MoUSpJVOCOjo2pA7PiQ5Y_SDpqnCjXF7DYg&oe=6B0DA521"}, {"file_name": "05-air-hockey.png", "id": "1851062896252369", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628454_1851062899585702_6690423345498618918_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKBtuA5CnKQQ7kNvwFgOrEB&_nc_oc=Adocb9WGMgmi6EAXsMtp-j7zrOTGzHrZTy9u9zBZurM4OuRA5QbPJde-kbxtXv4K7bo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTsmCa34oSnGPd4016QeC55WgZ5EjWi_VaF96eAM9V5QQ&oe=6B0D9E73"}, {"file_name": "02-pool-midgame.png", "id": "1795642241652022", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499626728_1795642244985355_6492212168926620475_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-lW75m2dBAQ7kNvwEjVh7U&_nc_oc=Adp1gGO16nL0k6BgcKb8m4XkJAv5nsTKP4RVOT_ZCpCyH9abuuZDYi-run7_Oa46PUY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQLsul4Iu0Ehs2LTtaqZUJ2jt0gxozerFLq_o19GocgTg&oe=6B0DB68F"}, {"file_name": "04-chess-in-progress.png", "id": "993771803114231", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593877129_993771806447564_5841823636963048634_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuRX2rq0I74Q7kNvwERehI1&_nc_oc=AdqVlCOhseRfCqXJ8MqckAzNXyHtpz7Jlvgnz5hDtILhOAsCr-eaH-t0UdwRPsB0UH4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQPFP1l3i5I0VqRcV4UysGqRZY3ik8S9GbNncdIV1RaPA&oe=6B0DC8CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anyday Arcade", "keywords": [], "long_description": "Step into your own VR games club.\n\nAnyday Arcade brings six games together in a bright, welcoming space. Throw darts at arcade targets, stop charging ships in Alien Invasion, take on an air-hockey CPU, line up a pool shot, settle into chess or roll through a ten-frame bowling game.\n\nMake it your regular place to play:\n\u2022 Six activities in one club, with three bowling lanes, two pool tables and two chess boards.\n\u2022 Play offline, practise at your own pace or challenge CPU opponents in air hockey, eight-ball and chess.\n\u2022 Create a private online room for up to eight players. Share the club, watch a game and join friends at the stations.\n\u2022 Pick up and use the game equipment with your Touch controllers. Choose teleport or smooth movement and adjust turning and graphics in the menu.\n\u2022 Keep your local scores and settings, with Meta leaderboards for supported results.\n\nOne purchase. No subscription, ads or in-app purchases. Online rooms require an internet connection. Voice chat is not included.", "short_description": "Your VR games club, any day. Play darts, Alien Invasion, air hockey, pool, chess and ten-pin bowling in one warm, welcoming venue. Drop in solo or create a private room for up to eight players."}]}, "developer_name": "Roomshift Games", "developer_privacy_policy_url": "https://www.naveens.dev/privacy/lanternbay", "developer_terms_of_service_url": null, "publisher_name": "Roomshift Games", "support_website_url": "https://www.naveens.dev/privacy/lanternbay/", "website_url": "https://www.naveens.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": []
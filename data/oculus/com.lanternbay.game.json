9", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628909_1027295667048372_3530914028923752995_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QX35ZyliV7sQ7kNvwGm1GHt&_nc_oc=AdqGnZ03073FUVa_Opkmfq_pUCLV2zONIXyx6mgiCX9j7WYXdgYIE_twfmntwyKSYO8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTw-QetjysNf69gviskOKtbSZCFKa3ZsYXP3-399xOm0g&oe=6B0DB063"}]}, "id": "1148169471042705", "locale": "en_US", "screenshots": [{"file_name": "01-pool.png", "id": "3697575217056082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908771245_3697575220389415_6202953898032743320_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdDd9gzlem4Q7kNvwG4i37t&_nc_oc=AdrVI82I0IU28C_EwpHK7lffXocB6zDOuXImA-rw7hivGQ51Yjmkyk1sYcv_-t232ZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1sQrCPWxelauYLdli3OxjLpOfYoxjw41jNWF23rNUfQ&oe=6B0DCC1D"}, {"file_name": "03-bowling.png", "id": "1209989948121320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908771237_1209989951454653_4353648375915901926_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Akx7tWO_gnwQ7kNvwHaZiFh&_nc_oc=AdpgUw0RR5xiDt26Qrvr7MHuW1SlbrgmUFD3Z-I8RiQdpmTsDdMZsskBZINqEsxcIPw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJijr_7uIbhdZhzKQOMrGthWcqvttncJ9N1sI60r7k4Q&oe=6B0DA515"}, {"file_name": "02-cosmic-catch.png", "id": "1384615040247974", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908771276_1384615046914640_2220841486756633694_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Kg59ZJh-7QQ7kNvwHwJcQ6&_nc_oc=AdqSdi1Gzb4LxV1QSm_x2f7_EJq2e5PjW3FWAfrWHt4w7NsfLxtpL9daxUjHAiwr6NI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSh4XvyoEeL7NIeEVkINhZaYdqsDZ07IvfUmI98UwnMYw&oe=6B0DC511"}, {"file_name": "04-twin-blasters.png", "id": "1037769682672860", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908771268_1037769686006193_4758365675921254007_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tS_G8y5AiT0Q7kNvwH5I0VX&_nc_oc=AdpvX4z3za7d_X5gK6z8X_2Tr6pnSgYtTwCrZys86bRwIVjqB_wcOhQpgqBXJAoyALA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqjNxM0Mj5NAgp16AHmF25acEBUxwLVGa8IuJ8RSgyhA&oe=6B0DB24B"}, {"file_name": "05-jetpack.png", "id": "1165479299282733", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908771237_1165479302616066_3560211360505226260_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7URXoM3diIQ7kNvwEMLsGz&_nc_oc=AdqazhFMICdfe1HD_UTisUdNa0TLtzfqsbVQwD49JRls--76qWJk9bcmmS6HHmBxZv8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSKi5hndxePeTIDW8yhlELU9npJy0MqTYXACVVkTFG8lw&oe=6B0DAA53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anyday Arcade", "keywords": [], "long_description": "Pick a song on the jukebox and rack up a game of pool. At Anyday Arcade, the bowling lanes, air hockey tables and chessboards are all a short walk away. Play offline at your own pace, challenge a friend to ping pong or see who can sink the last shot in Cup Pong.\n\nDrop into the Common Room to meet other players, or share a private room code with friends. Up to eight of you can play, watch and chat as you wander the club. Voice chat is optional. If you want the whole room to hear you, pick up the karaoke mic on the terrace.\n\nTry your luck at Cosmic Catch. Land a prize in the chute and you\u2019ll have a little companion to follow you around. When you\u2019re ready to head outside, strap on a jetpack for a lap around the ship, grab the Twin Blasters to fend off a wave of saucers, or step through the Moon Gate to look back at the arcade from the lunar surface.", "short_description": "Meet at the pool table aboard an orbital arcade. Roll a strike, play darts or go head-to-head in Cup Pong. Drop into the Common Room, invite friends to a private room for up to eight or explore solo with a claw-machine companion and a jetpack."}]}, "developer_name": "Coolheaded Studios", "developer_privacy_policy_url": "https://coolheadedstudios.com/privacy/lanternbay/", "developer_terms_of_service_url": null, "publisher_name": "Coolheaded Studios", "support_website_url": "https://coolheadedstudios.com/privacy/lanternbay/", "website_url": "https://coolheadedstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "1494953550373226"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908771259_2221439402111969_1441817748372650231_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bs8vCoW6gvUQ7kNvwEl41Tq&_nc_oc=AdorTvOmNh88y96QLDQSyVhd6S4zjbJJmXik4T5pm1wxY-48IXdyb3NBx5Af-2vtbks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRUHOdyrHsdZZhuziTGyi6y6L6mxL6gqLrIWIfAgsE8Bw&oe=6B0DABAA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Anyday Arcade", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "27765422
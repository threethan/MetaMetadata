v/t64.5771-25/499292426_1672382921558867_1638477332937480153_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6K-Yat9zfcQ7kNvwF407OS&_nc_oc=AdolUi5WXHBTP-lU-1I_aAkHvYgu15Wua3LPbAPi1yOORG__-qxJiAkEhQydM93xeBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL1-ImNLoNKQTmtTdavQyy878q_IHVBK7MCBvKsY2jgw&oe=6AEDF2F6"}, {"file_name": "04_pendulum_hall.png", "id": "2292100518224248", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_2292100521557581_8349297826944920694_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rz0Lfjz0NAUQ7kNvwG_TOHF&_nc_oc=AdqOHYMxOjrLtkW6nbyDgXvYq0CNTAaTBd1FU_OQH4kcskm-HG8X126QSqhx-znjRcQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL3qHwX6oW5sOq84WNdHRJ1N9zjLI3CnHzNbfo8J29mA&oe=6AEDD9EC"}, {"file_name": "05_revelation_mode.png", "id": "1522362582500870", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298221_1522362585834203_1433948520855857431_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wya3p14eetkQ7kNvwEOoFko&_nc_oc=Adr1NWOtJowV9fOpnmxOZy7BjhpGGmVSrVYC0dEpb107PsWFn9NAvPVfVUVkCAMc964&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkFir_yFayjRZyLebfh0w8dUyzi-_uzXJw1tcMM59kWg&oe=6AEDF567"}, {"file_name": "03_victorian_room_tilted.png", "id": "2090910375144723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296127_2090910378478056_2714308310770990024_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8zXXkZbZZwQ7kNvwGvZSeQ&_nc_oc=AdrpOJrTCGEoB21z-VCYMD00Yt4N1qvVuaQTK5kXwxf9wV8V_8aofziW9ZsLCejetvY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA9w3SYz27buc5F5qqcr1-jxufnoqI38tTjNpWplYUIQ&oe=6AEDD7E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1768190094496088", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310731_1768190097829421_8161383201140615281_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shi0z5HsEq0Q7kNvwGv1hr7&_nc_oc=AdqwjBPJmx5OfDzqREQSE6cuqZ17nOw4DfuJ1-kXBMZHbkCbcfI7c0GVfmZg4tub-SE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0jaXLfevbF3nWkWN-E2KOnlgAbJZ_J897vNi09ofV7Q&oe=6AEE050B"}, "display_name": "Gravity House", "keywords": ["gravity", "room", "science"], "long_description": "The lobby tells the truth. Flat floor, square walls, a body that knows exactly where it is.\n\nThen the tunnel. Dark. Just long enough.\n\nOn the other side, the house is wrong.\n\nFourteen degrees sounds like nothing. On a hillside you wouldn't notice it. Inside a room it's enough to send your hand looking for a wall. The next door makes it eighteen. The last one, twenty-two, where a pendulum taller than you swings through the crooked hall, tracing a straight line the room refuses to accept.\n\nThe house keeps leaning while you stand in it, too slowly to register as movement. You won't see it happen. You'll feel it in your ankles.\n\nYour eyes rule the floor flat. Your inner ear objects, loudly. Between them your body picks a side, and you never decided to. Balls roll uphill across a table, and nothing about it looks like a trick.\n\nRoadside gravity houses guard the secret. This one hands it over: true horizontal draws itself in light around you, cage after cage, and the lie you were standing in falls apart. You get to watch yourself be fooled.\n\nA health warning meets you at the door, and it means it. If boats have ever disagreed with you, this is the same short circuit. And if it gets to be too much, level the whole house in a second. The room is yours.\n\nMinutes, not hours. On purpose: the trick works fast and it works hard.\n\nThen hand the headset to somebody else. They'll lean. They'll swear they didn't.\n```\n", "short_description": "Your eyes surrender first. Your ankles keep arguing.\n\nPast the dark tunnel, the floor quietly stops agreeing with you, and your own eyes take the room's side. You lean. Everybody leans. Nobody believes they're leaning.\n\nA plumb line hangs crooked beside a stripe painted dead straight, and the honest one is the string.\n\nThen, in one instant, the truth switches on around you, and you feel exactly how far off you were.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/48d0927c-518e-4f9e-b4ee-50515d037b20", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/code/artifact/48d0927c-518e-4f9e-b4ee-50515d037b20", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1101176782348424"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619113_1031645712818518_7017757376398833266_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIL7gRslXUkQ7kNvwEZLD5s&_nc_oc=AdpSvP0FyNEDfIHk7fIKCYL_SZTYoawpqeoxjkdn68CE-Lhj5vCB-BJkuctwJI8tpjc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSOsxcmJ10hsrijI5UyBY517CmW2ZnfEr4Sh11YZ4ivw&oe=6AEE00FA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gravity House", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1789484580, "lastRevisi
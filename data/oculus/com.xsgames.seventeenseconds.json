BF7TO256AwbUe78t7AoXkl6HKc0G71mVuY4f7rTs5kzs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPLq1k7Coum4lgExdbVf10AEb6KxJDTEALVqr5LFN6Wg&oe=69AD6DB9"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRE7o84BTUMQ7kNvwFA-iYu&_nc_oc=AdkzHFI1usqBY8OxvDMFFA3XEeBHeb8oDxNf3SB0V6h8u25aDaGtSi1c57oFjVeH9dw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8am_ozLHWd5F8e5vC5BpyWXsQodUY9T6azBRPDJmbNg&oe=69AD617B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQgkl3ahSjkQ7kNvwEiPIpv&_nc_oc=AdkBlZ_aoq82Ju4iRVpKw7yGfb7GgXqvE2R3Idntx_xaAA18uXAX7rRrSRthfz4Tii8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfziIhs4DlOmVZ353abJe7tSIwpQE08ojH3wzwgJ_9xg4g&oe=69AD83F5"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 seconds to eliminate every enemy in the scene."}]}, "d
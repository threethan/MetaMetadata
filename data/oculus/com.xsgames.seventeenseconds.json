Kf35dVf5JsRy-uVtQRTP2VMw&oe=6B01C8F9"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRkul15xUVEQ7kNvwEZW6kG&_nc_oc=Ado533QtCzrNdPnEwGbLVM7hDhL2t3wZgIzQHMnU5bq7oDA0lXhOcFv6MxssqOsZaHg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBc5ZeIonhauIUULP1agzOsW7P1EZMkR9bsREeZxy-2g&oe=6B01BCBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-k6ibUrwsQQ7kNvwFYiavB&_nc_oc=AdrI3al6--bhTdMuzE136VD_tjBcpqSETzgHVNMAVan4TFXfIyKZbKIUEL5xoL7vFvE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVQmmDOEikfNvDiO6VtMjHbD7NoRTmf1Buoh29pbi2QA&oe=6B01DF35"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 seconds to eliminate every enemy in the scene."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgam
NvwGOgTY-&_nc_oc=AdrVWiRn0Zhlh57ITMspTgUNelkRhw_YLlItIWNBfVLf5gaorcL6E-HnBZ10m4Aj3wI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dW7COkmOy-tSUCAP9uIdENuOCmDWJVmI30m56z6AxZQ&oe=69EE0739"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0pPuPgdRIsQ7kNvwE7ObSS&_nc_oc=AdprJqc7XWFnGRHDYRMjf4NXZSlYkBpR6QEorEpTH7YDIh5qNqHspO6Jwid-Rv-k82k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PRG8eQUCuzJIO2jsVlLgx5M5ZIZOG7cEuXgPjPBAaXA&oe=69EDFAFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U_cmJZduw0Q7kNvwG6K5nV&_nc_oc=AdqT7kbUVB_bFTHaLkizOhAmid2whLSkRs24XMM-vyfAlMezVMBeQeLEnjkyKAxZtD8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-O9dRgqn_dDglwxySziGICdzElHwkiyl1pxyIogYQAg&oe=69EE1D75"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 seconds to eliminate every enemy in the scene."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8618805208244499"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824618_726018743344162_6639824558380070457_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlnFCWcSW3AQ7kNvwHtHyjn&_nc_oc=AdorFfaoxdHk3z3gaDF_Cmfh8Xl63rf75QHMtox7Nj6IaVruiJzMf-APpayQDJ_s7rI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BZK-5D80IZRSxXfMJzXkitUJIRFJVaruj-qc2S-wC7Q&oe=69EE18CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "17 Seconds", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1750164660, "lastRevision": {"nodes": [{"id": "8618805228244497", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8618805201
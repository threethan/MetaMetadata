MOr29capHOE9plfWjlmlM8eQ&oe=6AFB3179"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZL5sdCWROYQ7kNvwG0Us7i&_nc_oc=AdrhwsAvKJ9NPuHaf4JIYUll8xonVKHaByUtO6IQrI9mj31g1HbPCqHBnGGX4jq8MP4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3HhIk3HNnJ0qT0f2bdUAEtnyhO8lyM2obT7bgIGx3wA&oe=6AFB253B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lx5NG4aXmgYQ7kNvwGFHDAZ&_nc_oc=AdpORTXte7LeUNAjoFaXbT-xoGAo9uh01rO0VphR00ZbnundSYZ2FUTZIVAXyDJd0OU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6FU7vgHpoyjoW3hYnQLr9cJagpw2H1M8ppMvD9BBsRA&oe=6AFB47B5"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 seconds to eliminate every enemy in the scene."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgam
NvwGK3z3J&_nc_oc=AdqDni7RNoaZWk_JJIHVdwqELYF0W4qNuk9RaEUIsP97pOmylkCu4aHFTRFlcLTkwl8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuTMD_9V3H277qPQLpGgafF3JCosNMIsr-3gSct2MYqw&oe=6AE5E139"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKe_509cJPAQ7kNvwFyCXQj&_nc_oc=AdpFUsvT1Gx9RXxJUMPKIjkZx8nBL1WOJBySh4QlUpe8vgR-kYUXmxJR9n0RjV-NyDU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBPJ61eX1raVIrmyw7P1y-ePkF8z4fKdOczr8tjn8HBA&oe=6AE60D3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxthqofO8hEQ7kNvwFhqdvU&_nc_oc=AdpWeIVKslz2n1kot5kN6I_U_LTjCu7r906WdWzk-QqbwKmFPXTVAaSkHygZ5GOrnkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6KCGT-LTmbGBlj2kdlsNAWD4i7h09uRQRc_wSzeKV9Q&oe=6AE5F775"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 seconds to eliminate every enemy in the scene."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8618805208244499"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824618_726018743344162_6639824558380070457_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDvJrvoKLPAQ7kNvwEJfxxz&_nc_oc=AdoAVxI68aV_SGT9vl563Mz9tofuTDs01r-iev18Vf42FQOoSbuiDLTs050qfjCeUrA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOc8rlAi-o5X_xCgKNngfPUv3NLl9CU1-d634FRnELytA&oe=6AE5F2CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "17 Seconds", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1750164660, "lastRevision": {"nodes": [{"id": "8618805228244497", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8618805201
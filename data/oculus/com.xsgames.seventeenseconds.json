QfOzwquY9XIv39DhSx2r86AA&oe=6B070EF9"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3Hq0O-jaOgQ7kNvwEUilu2&_nc_oc=Adqq4nl1wBDuGZTvcmslS9uEnOl3kYj8pwzpq34fgdIZiyDBBypfW40v5xqeF1olErw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh0OuecHBtBVV8XEKLCGNDK4IvYWGBgLITDID_LoW7Kg&oe=6B0702BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uO666te0e7UQ7kNvwHDFXQ_&_nc_oc=AdqvFQuj6kyRzcXJuTWX_Lx025v8kNS6z5LV2B7no6TakSq-1lZd3eLiduDx5GSbaEM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe8GkPbMZs7K4q53NP7g4hq9ESla9Ag8fEk7eQxlGy1A&oe=6B072535"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 seconds to eliminate every enemy in the scene."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgam
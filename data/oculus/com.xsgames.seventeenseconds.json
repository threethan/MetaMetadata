1830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMB9h07kmxoQ7kNvwEAvAkA&_nc_oc=AdpNYAA5N1qVMLiYpj-DfiXwP95_GYUWx6WwaXa7SuTxkbzN4U8b2TxuVusUD7QVgm8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Q0GZ9L9xWVBgxVPym_CO1MklRX69N1mbpDwALNuZMrQ&oe=69E785F5"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 seconds to eliminate every enemy in the scene."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices"
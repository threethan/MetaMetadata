nc_sid=6e7a0a&_nc_ohc=Q1wTMeX43wIQ7kNvwHCYhg6&_nc_oc=AdkmEwnSFPi7qinrpQHltQrnWRXrBbQNVxq6SzQ9CkCPgxECRi-HmL7SWZbN4MCuS1A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftP0aJiUpnFGnCuZyOhXxp0g7o2sfYJpd9GwRt5iurqDQ&oe=6998497B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qPBkfOmqy8Q7kNvwGCsVZX&_nc_oc=AdnkV2XG-jl14irqurbLcLS49Ic1oM97k0CatwD0R-qzj4mNXNrHXxzYwVBQuTm2Kzg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftMJe4HNIT60ehrqhrAYHkDPXdO0RHM3hXZGPVRoWWWdQ&oe=69986BF5"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 seconds to eliminate every enemy in the scene."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
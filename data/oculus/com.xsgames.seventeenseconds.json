N-WN42GHEaFV-ZS77Mup8X5Sg&oe=6B007193"}, {"file_name": "4.png", "id": "1232174618412556", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827273_1232174621745889_3487414923485955156_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmyeD9HoUSkQ7kNvwGUFbQc&_nc_oc=Ado6TZ80GwO02Dhd7Kt5rCv07bsWAtcAfGa89zyIFW1VLTRt9TmEwE5hZqXsniys0o0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3xAUgZazCHAhybQWHDNzncwkJaHlI2vfDGAuUri-Haw&oe=6B007779"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhUpSxMKIwcQ7kNvwFJKteh&_nc_oc=AdoNU-Swo--wcVzloHdBIesCFG4RSfXZwE5tuLQizI9OhzTem80F6_hTUwuwI2aTtZg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmoruqg4W2Mfin3uqEPrtfAOzuBIVnq09uVLoQZzHUAw&oe=6B006B3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-k6ibUrwsQQ7kNvwHo_ZaM&_nc_oc=AdqUWxVaeHhemy8iXZHjt_AAGkG1Gq5BRa2OPrtgTYZOenI7mNjtdvLINJbS5jaef5M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRXq3PKb5-D3FlND-U54LKKVb3shEV4qr1ADvZmGSQ5Q&oe=6B005575"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 seconds to eliminate every enemy in the scene."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8618805208244499"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824618_726018743344162_6639824558380070457_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7vxpAfx2HEQ7kNvwFVKGuz&_nc_oc=AdolCiyK9gvJLq44NFQfPuicspvIpGObbNBAGonZCtBF0VrXNqb-0gU4IucSxRmGz_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiAANippyoLC5hhGGIcUhywwlmwlAr7KQn8fi8ShushQ&oe=6B00890F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "17 Seconds", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27433
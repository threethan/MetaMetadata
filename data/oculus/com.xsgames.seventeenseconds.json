NvwGhYKYB&_nc_oc=Adr6Qvy6HzWnFu9zDj2f7wY4wjxI-fu9yO6-TJR-pOftQmx13O3EHxnixnlyXcbT-hk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkVJhL9JRMsmCbDc4OrM9gqFgTO5K-WCeyj1cWKHRTQw&oe=6A6B45B9"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOviIlN7ZS0Q7kNvwHfKd8T&_nc_oc=Adrxnp7Ho0bUL2XlF0LU90aaLmr8kyQhxHUTWl_KTegnXlnzsOJt5fj0E6Uj9CB7_6o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuU9GTIbRlzHNzGfqofRE4m_a3T9IL69eC3njHOnUZkw&oe=6A6B397B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmgwOhRRrdYQ7kNvwFXnf87&_nc_oc=AdpK25BbkVU4S3ab5eRG1ynL0DAMKMkm39kdiivaotbRwFcYvVc-9uc48Ht5EoaVgqY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtm3pQX25XZkvHGQZC3sqQZMR5q_e3k33R-q9cOEO9bg&oe=6A6B5BF5"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 se
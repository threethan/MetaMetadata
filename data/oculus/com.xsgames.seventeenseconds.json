NvwHGw3VT&_nc_oc=AdqG7MVTsptbUiJU6KTOAXI_PvQ90mD2T2voxRgbGxnIOIOqR-Vi1UawqRzTjbbRtK8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_Fr_pPoPu5XJYbPHlhGxAzSgnep8eZsonjs0DNXolTA&oe=6A09B6B9"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RcfjA5DHsAQ7kNvwG-X7WK&_nc_oc=AdpvKmQji5obeS-xKx27f98zORtU_KoaZ4bK1sC8tPF9M5PY83_lMJQIQnOqvblPO0c&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q-wvgMFLMijpr4_4JRRGEBFRIVIU_fJtq4ghd7RNc9Q&oe=6A09E2BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSbkdHbn9y4Q7kNvwHJgXd1&_nc_oc=AdoczeKujj9v-D4Jz061ndrFb4LEGfjKrTjoXqRLegoixXi0QGJr_SZmGhIKh3jIA7U&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dCCXJCB-oYRMvKtsX8ea1gpRoI7_2jVWY1W3dDIlWSw&oe=6A09CCF5"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 se
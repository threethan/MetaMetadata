NvwGuzk8s&_nc_oc=AdofllqhZcGgaaYxQmTgiTt5t0-mFKlbxWfnsrzkK1eaWxXujlqa_T7DKhDJhAvou8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAGU7MegTMTODGtJ7MqK3UJCaagjnR4TtHpgDTUCnD6w&oe=6A6DE8B9"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOviIlN7ZS0Q7kNvwGmyKbD&_nc_oc=Adqzy1qacrT_wSFCb-rPm8Rx5mvAWTjKmI-enPjH6lnZa-AcO2zPEj_aP4LJfnBkpJQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEUEoRuanRSTe-m0MDPslOktCJALRunt_f5ylSGDSa2w&oe=6A6DDC7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-OFvc9ZwmcQ7kNvwFLroiZ&_nc_oc=AdqLrXRiiQjzkfa1A-JhN2pVZJQpyHyk8wumVUNMEL13s2YykVI7ujD_2moUn4zrkJU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbU4iD0GPzP1O4eJSQoczVj4F9Af5hjnRaH0kwHOf_Jw&oe=6A6DFEF5"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 se
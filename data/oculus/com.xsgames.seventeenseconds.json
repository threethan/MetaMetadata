OIQol3irioFgnFlwDOlZKTq_oY5fDd8r_rIfP65uYiR0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCjUgxzMpg-9QB62afGKa4QaGH4V7egQIAChPcNZh3CQ&oe=69B16239"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsy1lLNGPEIQ7kNvwGxUY32&_nc_oc=Adm63x1dZm28Y_LgXjEdmx1FSOw--xjMbyu-aCMwS848M_KnIw7h-dYABGOa5XkxqM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzt2uZx1fSPAVKxavKSMKA-9zt1OZKod4xwMV98FZJT2w&oe=69B155FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6em5LasgXiAQ7kNvwHhHi49&_nc_oc=Adnt8JJLpDolh4VfkG_VWz0ISrJvqslUIYCXPxiegErH7jBNGlSccWMsCiUBOedOPyk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5smoW1iU1n8vJ_vMeUnh2-uOp-Nr4dxgvoBXF-5NUOg&oe=69B17875"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 seconds to eliminate every enemy in the scene."}]}, "d
5QzaypUSLgfuKawnsG0PSJnHnAZ4Mefl98BtCNcppCiw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxrNB2Bg_jq4JKWyEzSmAJ6CEJUpEGH2AnB5i4zogTb1Q&oe=69BE9139"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnC-HU4uwKEQ7kNvwHfONPz&_nc_oc=Adk_v4bNPuB1vhdesWmclAnfW1S1Foz36ZC7GT1Jb-G0EvZM_bm9u8Em3WZ_xenKeuM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwYzSKpK3KjxGtf-3gPQWV1cPx3snaVtnmC6Xe9RJCww&oe=69BE84FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI8JltG73-sQ7kNvwFEx48I&_nc_oc=Adn_FzRKtlAfOwn5hXwKCUG43-_bvzQY9g-bzFxTNGeS5NAKT-G0SKg8z2EFoz4EeIk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfybiCLYoext2jjyuzU44oHBhwpvAmj-YQSNXXrAglBegw&oe=69BEA775"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 seconds to eliminate every enemy in the scene."}]}, "d
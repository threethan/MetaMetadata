xIxO2OuQciVQn2ffvk7DTCrvA9G_lQrn8g5g9Bmr65cE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwMO6Dz1QehvHKkIeLLDfDjRShFmxcX2yjnD1WTM7RNdQ&oe=69B94B39"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INbZQ1hznLIQ7kNvwHjq-V9&_nc_oc=AdlzI151xChTeJgX7KjoeD5tFZtNkxbHaYGgvBEjYj6SDXrWYglbBkCEjS5xYufHw0Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyoCF2JlTS15YxrSmMZ5otvo4ku7R8kv8XsKATDdRASQQ&oe=69B93EFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3dXqEvvjZwQ7kNvwGAugAw&_nc_oc=Adln0VJDE7HXWSrTCDU-QPUtjGKCnit6Pk2R2yC_p9W4Zt1POjbr4XsRQFxfvjn901g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzFDZxbGlKCcQ1UQfB3_2rWwrNpCPwkiDA0BkCm69cEaA&oe=69B96175"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 seconds to eliminate every enemy in the scene."}]}, "d
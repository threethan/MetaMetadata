NvwGx-1zF&_nc_oc=AdqAsOpodZf7KPsWgSoKGpPaTtHmOcX7iyAuZepF6y7zcW9URdFxsXzvC-mG21TzclE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jZnwkF_cb1lBX0vQq3iMZbnL4ZXbTXZ1Xjo2mxbYWZQ&oe=6A3AB679"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kco6M7v-emMQ7kNvwF5owxU&_nc_oc=AdoA8zr6jrU4YijUxNbjFc0VDXB9l4bvAU9kZn-QUGx-weC47zuLbIqKHQWAxDKv7Wg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9boB8iXhToQ7lCpYYrGn3rZ3Hm_T_dQzUPVwjSKXm7GA&oe=6A3AAA3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cPL6WB82OkQ7kNvwE1lTmR&_nc_oc=AdrVNK3l7oIbRmecVAXz_LyybFZmiZFFolQrBHyEaTCfFn7gL5EPxrSKrGHDcXYfRCg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-24MnflU8th_b92vZ1DC5p_w1t7qQ-rf69Dwuzk1re9A&oe=6A3A9475"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 se
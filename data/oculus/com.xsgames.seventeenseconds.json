NvwF0-kOz&_nc_oc=AdrOpdjRNwa2tqyuI4BDEq-CRfTrTiM9tNROB5xpSZ86VInMuKsmStj1QhllH9tr-MU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDSChdpK6aEYJD9Da2N0mqtCXKO1aLc9KxquxnNioxig&oe=6AABDF39"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iMUrXhzJtIQ7kNvwFPN_qM&_nc_oc=AdpyublET8sMXQ__e7l8qoy4Q9RkOuzwJdC2_r8wIIVyq778pQr55pQiGHToLkrn8m0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDBBbFgW2YBKEuqT0VAiBL6W0TqWgOlA19KCxukJGYgA&oe=6AAC0B3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvWcywFmOe4Q7kNvwFdO5R4&_nc_oc=AdoTa7Gl5dYJnNlO2kiZgmjB_p4wdNhTVZxl0gx-SQ-FsKbnRRBI7nUM3SYi5l8n2b0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI60M9VesMC19qe2nvhRXo9c_fCScCSHekrM30WQknSvQ&oe=6AABF575"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 se
0Yi9sJIeCTSF15rv36sDuNaG1_j4fowyypiphNlXyRcA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpPiwrZastrtoGhl-XJYjnQUcYuFKne0gjo4IYOYWDLg&oe=69BA9CB9"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INbZQ1hznLIQ7kNvwG3BP3C&_nc_oc=Adl-huZj3Wu8iEoeVuNC1QnivqsEBIGqK-c3JPkO1WwrIKqQzedpmtqcBYerus6PDrc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzkR_cRk3liVcCRw6pE9bhifgxYeMMi9mVrsHVXFc2zng&oe=69BA907B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLJzmjpbtH8Q7kNvwEeD8T0&_nc_oc=Adkl-DEEtxiaKnjKLn_UOoOosCB1m5z0qz9xiaCD1B0coSGkLcuJeZVYTzzmKsGfo5c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyRMvEEKMjtgXMw-NI1-GU3DXSE3l8hQqN1dg3cLPXRyw&oe=69BAB2F5"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 seconds to eliminate every enemy in the scene."}]}, "d
NvwEQVDb-&_nc_oc=AdooZHiHbpdeReANOHrkWIa_7gY-4TXdVc8z0qBDHXlVq_Z6TqS9Ikkbv1kzt7bOCJA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qMI2F8zRRyomDzSpYYtptQ_wp-gChRqJeHJRXORIF4w&oe=6A05C239"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KS-ZzLxGPS8Q7kNvwH6A8oU&_nc_oc=AdrkLCw1g0_P3EVmG4sDpWBvH29QpGfGaZrkJMO8nDCBCIUekZPvXv0CAlgeFTbmhZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ABqYzDEfr6PL3i5tcIeT9kmKRQjCr71C7oAfY29FJ9w&oe=6A05EE3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XcKZOBsXfoQ7kNvwENE1ay&_nc_oc=AdqaCW9QHh8fpRgyQ9mKHswxdZqbJwqOwgobd8BPtm0jxVhlBHZkWm6eINbDaneXZ4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t5tPt0l1KlU1qWMXhgcqESqUWiYWRp_fc9eFYAsi-3Q&oe=6A05D875"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 se
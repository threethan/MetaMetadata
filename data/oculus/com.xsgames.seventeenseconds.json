NvwEk_TsG&_nc_oc=Adq1cbQ6FDgaD1B7DMEmmiKPB0_iDgDNcH-OvRdysHXidySuPkCdq4Rw6f9qA6W0TAc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2lN5YTPG76Catxs3j5uIvxQD0-AqT8z2HrJgkyLsR0Q&oe=6A9EB039"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TmVRX7G1hMQ7kNvwGeLTOR&_nc_oc=Adoze2DimPNEiU3xjWHjiDYPN2KNQ09UF3REuYpqwQKFxaqgsykUWlxxzzTSB_bbhT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPRoyaxYVG8VWbjLZcuyEgkPuY1gKcbUtJTCgjrwt4UA&oe=6A9EDC3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1Jf5PtmvrwQ7kNvwHqBdS9&_nc_oc=AdoJJR8T2U144GxRslRlBOm4tT0mRKgzsxxd_zAhluCjfrnI1ej6H3g38gRozGQmgiA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsvvy0v9jHvN2QpAWv-aUk3_Yh1xDEBfllgoSaysyhbg&oe=6A9EC675"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 se
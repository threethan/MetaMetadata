NvwHiRyKN&_nc_oc=AdqWQ-gf2rCwu3u67FCQvQYvl-BlvV24qHQ-WhL55b1E-Y-diwh0572zdEb_77DlUBA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60elQfDKhntjgVHz52Pf0KPjlo1K-5A86GKSt_IB-XEg&oe=6A1ECEB9"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-yGLWuJwnUQ7kNvwF5Xz6N&_nc_oc=AdrsPOTshDltXijg0UivM5Ty7tHZ3jATaZ0wsI5bmZK47N4MJRaFDR_BQDPLDgE9Sr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4K39j08-z-G_K_ZlqKw2QVnGDVedCsCQKPchBVlFEONQ&oe=6A1EFABB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qx7r_SMQ6OQQ7kNvwHR8kri&_nc_oc=Adr7ELuOOvvaNi0QV79OTYOJ7fDzHjhNIXNpV8Djd_oiQ8MER6kAwCvHjgXZ0WXKm04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BoxYLppc73fT7-HMIZxz789T2-_3BqF9SGY0AJd2bqA&oe=6A1EE4F5"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 se
NvwFVEt7p&_nc_oc=AdoR7SENZRd2P9nJNmdrcpstCFPMCf18XVCWu-I8ExwGQhk5GmJwFrIRNcTsdwnUpok&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQecogb1nSn67HiYpFQ330_EiT228xxPVBqTic9DWyXHA&oe=6AE8BC79"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKe_509cJPAQ7kNvwHoQ4AP&_nc_oc=AdqB8iAxrArje-x20ZPhtsPQGUYNinek1IB8LbbYsj2aT2Tj-h7ZE0DTklAyolfT3Bw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjOElLaAdoQ1Gc5_CZP71x3K4KG8WLQ9WpqDohxrfBiA&oe=6AE8B03B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tf5rzS8bF5UQ7kNvwFwxx1i&_nc_oc=Ado0HNoJxEow7Pmeav0QrnGtLWZrvjohX3INt0YS4fZqoBCcoVAgQ3p-clENoPShHS8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyHzQaf4HgAsW6ieeb8bzq4KMjfKO3vrxQFFTHsjooMg&oe=6AE89A75"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 seconds to eliminate every enemy in the scene."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8618805208244499"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824618_726018743344162_6639824558380070457_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYm0nHy3jXwQ7kNvwH-xv_2&_nc_oc=AdoDmcvKF8MjT2AsvafICfUVTWgKUKmq2nJY2pdgEYGvCNgUsisPUQl5yJKIpYlUkWk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVdd2RErypDXc6uccWGRRjgEaFb5QPHaS6YQQQLNul2g&oe=6AE895CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "17 Seconds", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1750164660, "lastRevision": {"nodes": [{"id": "8618805228244497", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8618805201
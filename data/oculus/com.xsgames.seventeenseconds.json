NvwG2JW-0&_nc_oc=Adopb2EKbO7qN5cuR14CxfA7bh0dtc9Ypj8SnCXlMoPyw_2uAVP328q3hXqU5Dr3oog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXS1rV-DHI7fQDIGhSPY1LMEu1bU25k1qgY6LHADw6hA&oe=6A75D1B9"}, {"file_name": "1.png", "id": "1365400798921883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827789_1365400802255216_2202366853478543823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoRGczDTSYMQ7kNvwEMraV2&_nc_oc=Adppt4PnXMpl1UBcdELtRUVs8df-t0QNdq2wWJb8YL8AZtxBYeuOIo2Rgt1IL8vGtns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvQ53hgyci7UIxFXC7lJGEDEfk7C5C9R2jdKuhgy0p4w&oe=6A75C57B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1317519259994279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830401_1317519263327612_1097563240788127539_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uu4QqPxsz-AQ7kNvwGXpGjB&_nc_oc=Adpu4Xc_Ho8GOXxzSv32hs4AjZXBgHatoidnnJian_OEoFWQmryoVXKedGFJ9GDT_Co&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOIyuZnVW-CI3IDnhHBv5xiy8rrA4Q7mhuXth7PdE5DQ&oe=6A75E7F5"}, "display_name": "17 Seconds", "keywords": ["shooting", "fps", "timing", "strategy", "super"], "long_description": "Prepare for a heart-pounding race against time in this intense shooting game. The clock is ticking: wipe out all enemies in under 17 seconds or face defeat.\n\nYou have a pistol with a few bullets available, plus some melee weapons on a table. Please pick them up and use them wisely. When you finish the bullets in the gun, you can throw your weapons at the enemies. Do not kill innocents, otherwise it'll be game over.\n\nYou can see an old computer on the right side of each area. Insert the floppy disk labelled \"EXTRA BULLETS\", grab the muse and play a cute minimalistic game to gain an extra bullet every 50 points reached ", "short_description": "Dive into an adrenaline-fueled challenge where every second counts! You have just 17 se
3-2.oculuscdn.com/v/t64.5771-25/491825503_1536121444701703_3548332987667901863_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rO5br_R_E0cQ7kNvwHuL_VI&_nc_oc=AdqlCTyRl2J6_HPKPUCNvJOARKREGYDR37cqSVtQybQSN7772azdPFPdcpuds7YAXzs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXDQkIeuS5ncgc6barMEURgPeQvhJeBI3ypK92lkB2Ug&oe=6A578339"}, {"file_name": "screenshot05.png", "id": "899086286547082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823940_899086289880415_3427163508259272819_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ef9ij0U3JKYQ7kNvwFY4TCC&_nc_oc=Adr6OtcTWhkLL9uWdPPPKLSnWKLMHIhD83iH22hhCEnRgJo4_iePu6VLmTkpZhVIunE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtxiK1ZyOTjPINXZHvsJ8z_iGPE3Scrqry1-ynypZ9ng&oe=6A576EB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-trailer.png", "id": "2686323025116815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824318_2686323028450148_6988330016720440263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOXiO0e6n2oQ7kNvwErDo_8&_nc_oc=Adq_4VVsXHUxx7v7ztvDcMMOfAKIv492eV0AXKg7bI4znnbIctfJ7_1X46m09Y38J5w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWkVuRCsGMpx7aFaMKVaVymkUXvmzoq-NT8K0P-Pm0_w&oe=6A579657"}, "display_name": "OnlyIPTV Free", "keywords": [], "long_description": "# Watch your own IPTV content on Meta Quest\n\nOnlyIPTV is a free, VR-friendly IPTV player designed for Meta Quest. It allows you to add and watch your own IPTV content through M3U playlists, with a clean interface built for comfortable live TV viewing in virtual reality.\n\n# A simple IPTV media player for VR\n\nWith OnlyIPTV, you can browse your live TV channels, organize your playlists, and enjoy a simple media player experience directly on your Quest headset.\n\nThe app is designed for users who already have a legal IPTV subscription or a personal M3U playlist from their own provider.\n\n# Key features\n\n- IPTV player for Meta Quest\n- Support for M3U playlists\n- Support for Xtream Codes login, available only in the Premium version\n- Live TV channel browsing\n- VR-friendly media player interface\n- Clean and simple playlist navigation\n- Designed for personal IPTV and streaming playlists\n- EPG support when guide data is provided by your playlist or added manually\n\n# Important\n\nOnlyIPTV does not provide TV channels, movies, subscriptions, playlists, or any media content.\n\nUsers must provide their own legal M3U playlist or Xtream Codes credentials from an authorized provider. OnlyIPTV is a media player only.", "short_description": "OnlyIPTV is a free IPTV media player for Meta Quest that lets you watch your own M3U playlists, live TV channels, movies, and streaming playlists in a clean VR-friendly interface. It also supports EPG guide data when provided by your playlist or added manually."}, {"images": {"nodes": []}, "id": "1753686265790538", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OnlyIPTV Free", "keywords": [], "long_description": "# Regardez votre propre contenu IPTV sur Meta Quest\n\nOnlyIPTV est un lecteur IPTV gratuit, adapt\u00e9 \u00e0 la r\u00e9alit\u00e9 virtuelle et con\u00e7u pour Meta Quest. Il vous permet d\u2019ajouter et de regarder votre propre contenu IPTV via des playlists M3U, avec une interface claire pens\u00e9e pour un visionnage confortable de la TV en direct en r\u00e9alit\u00e9 virtuelle.\n\n# Un lecteur multim\u00e9dia IPTV simple pour la r\u00e9alit\u00e9 virtuelle\n\nAvec OnlyIPTV, vous pouvez parcourir vos cha\u00eenes TV en direct, organiser vos playlists et profiter d\u2019une exp\u00e9rience simple de lecteur multim\u00e9dia directement sur votre casque Quest.\n\nL\u2019application est con\u00e7ue pour les utilisateurs qui disposent d\u00e9j\u00e0 d\u2019un abonnement IPTV l\u00e9gal ou d\u2019une playlist M3U personnelle fournie par leur propre fournisseur.\n\n# Fonctionnalit\u00e9s principales\n\n- Lecteur IPTV pour Meta Quest\n- Prise en charge des playlists M3U\n- Prise en charge de la connexion Xtream Codes, disponible uniquement dans la version Premium\n- Navigation dans les cha\u00eenes TV en direct\n- Interface de lecteur multim\u00e9dia adapt\u00e9e \u00e0 la r\u00e9alit\u00e9 virtuelle\n- Navigation claire et simple dans les playlists\n- Con\u00e7u pour les playlists IPTV personnelles et les playlists de streaming\n- Prise en charge de l\u2019EPG lorsque les donn\u00e9es du guide sont fournies par votre playlist ou ajout\u00e9es manuellement\n\n# Important\n\nOnlyIPTV ne fournit pas de cha\u00eenes TV, de films, d\u2019abonnements, de playlists ni aucun contenu multim\u00e9dia.\n\nLes utilisateurs doivent fournir leur propre playlist M3U l\u00e9gale ou leurs identifiants Xt", "short_description": "OnlyIPTV est un lecteur multim\u00e9dia IPTV gratuit pour Meta Quest qui vous permet de regarder vos propres playlists M3U, cha\u00eenes TV en direct, films et playlists de streaming dans une interface claire et adapt\u00e9e \u00e0 la r\u00e9alit\u00e9 virtuelle. L\u2019application prend \u00e9galement en charge les donn\u00e9es de guide TV EPG lorsqu\u2019elles sont fournies par votre playlist ou ajout\u00e9es manuellement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onlyiptv.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "AT SoftSpot", "support_website_url": null, "website_url": "https://onlyiptv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"
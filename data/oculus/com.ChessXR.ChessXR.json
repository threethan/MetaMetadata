it_IT", "screenshots": [{"file_name": "screenshot_01_2560x1440.png", "id": "1955840095824689", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_1955840099158022_4122560308254305890_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NR9vqv6NuJgQ7kNvwHVsKYY&_nc_oc=Adp89Nmy7YhyzR3oNq3DD7f08_rZEwJFNkDKFu9_aRTlXBMezqHvPJo5Yfn0eaUZqdE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWr0EkKe9EqN37iRKbMdLui8BbQ3DNqKf6yJOPU-QznWg&oe=6B103F18"}, {"file_name": "screenshot_02_2560x1440.png", "id": "2007977129866503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821704_2007977136533169_413141565995722840_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=718WP2_iyi8Q7kNvwGiHexI&_nc_oc=Adqs1ROenGLsCwtbiLikwjCO0pdS1rYu3GMMuU83PFCvA57jQPsmb7Sa-JSdxqYIU3w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZtOAQpGvnexXAdd7HsdUM5YatdbAJBU2WgP2gnRFIeA&oe=6B104520"}, {"file_name": "screenshot_03_2560x1440.png", "id": "2442923489781178", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_2442923496447844_6692031965516224638_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfWoxcVVrA8Q7kNvwHsk64A&_nc_oc=Adou6WgpMO0ppObYT-RQMdhKxEvJ6ESmO5H-w8Nf0CBMASlJbBut9097fZQHg5ffVVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVYX4ripEhpWF6p4-i2MgrVFgvM2hdY6-Gum8CHaHv0A&oe=6B1041F7"}, {"file_name": "screenshot_04_2560x1440.png", "id": "2177493582841134", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_2177493586174467_5103757615912833649_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdWeQ_ZyBNwQ7kNvwFzXWRj&_nc_oc=Ado3JV6ma8GTYJokr-a5NBA-jzkpe6XYwwkG1eCnpsM3PWbHm9mOe4P-muy6ULNiZwA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXbOrApqTG4EqJf1RaaMks6I9puOwO5y6mhViyb9s9hxA&oe=6B105A63"}, {"file_name": "screenshot_07_2560x1440.png", "id": "1110662088426938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824741_1110662095093604_2959037292607480903_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5qhNVMC3h0Q7kNvwFTAnCx&_nc_oc=AdoSSgKwjRHXDwRdLx1lzFkrBgStdCw6g_aTtTyiTtjEFUr9ZSqY3_BBQ7JqJkFxQhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUh88hQHLC8Icb5a-qC9ex1ZCT3QT8GpwJ6OmCEh3xqvA&oe=6B105252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2352750991926351", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_2352750995259684_4026602128262768324_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WptzAf5CoBYQ7kNvwEABU9Z&_nc_oc=AdrTfCydbJM_79X6wNrFKo9wh3JUTCuSv9KOhYa6H62kFKcyqFHXJFZiGyVIHIbAlp8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV1QCe2OGxgWnP6hhzRnohUDvAejsC1HNnUyQwaKPuknA&oe=6B106CB5"}, "display_name": "Chess MR \u2013 Scacchi in Realt\u00e0 Mista", "keywords": [], "long_description": "Porta la scacchiera nel tuo mondo.\n\nChess MR posiziona un vero tavolo da scacchi direttamente nella tua stanza grazie al passthrough di Meta Quest. Davanti a te siede un avversario virtuale che riflette sulle sue mosse e le gioca con la mano, proprio come in una partita dal vivo.\n\n**Gioca in modo naturale**\n- Prendi e sposta i pezzi con le mani (hand tracking) o con i controller\n- Le mosse valide vengono evidenziate appena afferri un pezzo\n- Dopo ogni mossa premi il tuo pulsante sull'orologio per passare il turno, come in un vero torneo\n- Afferra le maniglie dorate per spostare e ruotare il tavolo dove preferisci\n\n**Un vero avversario al tuo tavolo**\n- A ogni partita un avversario diverso, animato e con il proprio nome\n- Quattro livelli: Facile, Medio, Difficile e Maestro, il pi\u00f9 forte, che pensa pi\u00f9 a lungo e vede pi\u00f9 lontano\n- \"Scacco!\" e scacco matto segnalati direttamente sulla scacchiera\n\n**300 puzzle per allenarti**\n- Matti in 1, 2 e 3 mosse ed esercizi per vincere materiale\n- Trova la mossa giusta: se sbagli puoi riprovare, e alla fine sai quanti errori hai fatto\n- Se ti blocchi, puoi chiedere la soluzione\n\n**Suggerimenti che ti spiegano il perch\u00e9**\n- Chiedi aiuto e scopri la mossa migliore con una spiegazione a parole: catture, minacce, attacchi doppi, scacchi, pezzi da mettere in salvo, sviluppo e controllo del centro\n- Vedi anche la valutazione del motore e gioca la mossa consigliata con un tocco\n- Fino a 3 suggerimenti per partita: per imparare senza farti giocare ", "short_description": "Gioca a scacchi su un tavolo a grandezza naturale nella tua stanza. Sfida un avversario virtuale, muovi i pezzi con le mani, risolvi 300 puzzle e impara con suggerimenti spiegati, dal livello Facile al Maestro."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.1mmers1ve.com/privacy-policy-chess-mr.html", "developer_terms_of_service_url": null, "publisher_name": "1mmers1ve", "support_website_url": null, "website_url": "https://www.1mmers1ve.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1538451456010341"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_4422588337992139_2757479309883574247_n.png?stp=dst-
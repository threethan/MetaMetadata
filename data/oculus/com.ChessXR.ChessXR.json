F754ACHOobpUfxrUhdXB_6CReNxw1qg&oe=6AFB2E84"}, {"file_name": "screenshot_04_2560x1440.png", "id": "2635671120213705", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823757_2635671126880371_6183965583961069422_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbUz6m_39DYQ7kNvwE3JH2k&_nc_oc=AdqZPbuEjRw_RWZR-MvIRrMMwm0z2-NKWSeqNJcyGKdsiQI8LRtq68wrLTzy6q778L4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-b_XBfqR_9VR1LnLUVyB_fkKTjGfRPqyASNWY0vzEow&oe=6AFB18D9"}, {"file_name": "screenshot_07_2560x1440.png", "id": "2692144114535375", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823905_2692144117868708_7912223150508098241_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1W2hMKn9o8Q7kNvwFxHbgd&_nc_oc=Adqiz3tPDHhUHQyXWZ2-pjhKugUYOmpMIU2bfSgh8SM36KpIt7f_nncANUo4nRJSLPU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStLRYWj2Dz_KVmwBIkt5NGhZwdbyRWSNPAFiWHLOag5A&oe=6AFB2215"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1817245636198674", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823757_1817245639532007_8159436477001535337_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_tMCuT8CZUQ7kNvwGr9_87&_nc_oc=AdrHyemN8ByypJhD8721nsB67DV0tAqGUB9EuTaH4HZjj3VbFvjrc_pN-hhLggMAy7g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsQJHwXVvUa22cBNTsH_VlT2y9Ips6TsIYfQMTp-2Ttg&oe=6AFB3D5B"}, "display_name": "Chess MR", "keywords": [], "long_description": "Bring the chessboard into your world.\n\nScacchi MR places a full-size chess table right in your room thanks to Meta Quest passthrough. A virtual opponent sits in front of you, thinks about its moves and plays them by hand, just like a real game across the table.\n\nPlay naturally\n\nPick up and move pieces with your hands (hand tracking) or with the controllers\nLegal moves are highlighted as soon as you grab a piece\nGrab the golden handles to move and rotate the table wherever you like\nA real opponent at your table\n\nAnimated virtual opponents with their own names and personalities\nThree difficulty levels: Easy, Medium and Hard \u2013 perfect for beginners and experienced players\n\"Check!\" and checkmate announced right on the board\nEverything you need for a proper game\n\nChess clock with 5, 10, 15, 30 minutes or no time limit\nPlay as White, Black or random\nHint button, Undo and Resign\nFull move list in standard notation\nFloating panel you can show, hide and recenter at any time\nItalian and English The whole interface is available in Italian and English.\n\nWhether you want a relaxing game at home or serious practice, Scacchi MR turns any room into your chess club.", "short_description": "Play chess on a real-size board in your own room. Challenge a virtual opponent sitting at your table, move the pieces with your hands and train at three difficulty levels in mixed reality.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.1mmers1ve.com/privacy-policy-chess-mr.html", "developer_terms_of_service_url": null, "publisher_name": "1mmers1ve", "support_website_url": null, "website_url": "https://www.1mmers1ve.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1474775
_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5PlNiShdVm8ubRtUFhRNwszranFE7tlmYDZ30RQqYyA&oe=6AC3D5BA"}, {"file_name": "New Project (17).png", "id": "869860207993418", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003259_869860211326751_8073700598733340192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JN9eneHbOHcQ7kNvwHXjmXl&_nc_oc=AdpqCLjDE0j-ZwldOqo0Y7qH_nbo6vaiSXLO47RZ9OkLvEzaP_ytIb8bF6kE-l4k8sE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-MT00clVH4kFQz9tkwozNPVwSEllgyU_ZVPnIPcUqlA&oe=6AC3B8E6"}, {"file_name": "Untitled.png", "id": "1142401653398795", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974575_1142401656732128_4307231838817405837_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o91gkW0hOUkQ7kNvwHf1Uvv&_nc_oc=AdpdGW_X6kl4kMzdXAF0hjbSdORvuBExJs0aXHNOerTS3MDV_ALKbswaWQTUwhOoqHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPt7G3BJ8TZT-cxsbDLDgUoDqFs_s61V8dpY8D5dEZFSg&oe=6AC3D40C"}, {"file_name": "New Project (1).png", "id": "865121068170817", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75392878_865121071504150_7414861295218057638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h49Dtw6MMBYQ7kNvwE_Rj0l&_nc_oc=AdqfiZXVxEzajYj7yS8dqYljH9lcAT_AJoUrKG7sDEhfJ_iTJUl7YWtDkgFVMFEUPvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOExiGorT9yu41Jmz9wZqxDAfWi3wBIt0oTfrwBSS0V3w&oe=6AC3B02E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (12).png", "id": "1265056527543615", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974745_1265056530876948_6444653153638334487_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kO_cv0WYBgkQ7kNvwE-1AN-&_nc_oc=AdolzmbOOGP9hhif-RQl12LaMzid_1QqKkYSnFPTOaDCT-LUndkpK8PcoHyJH2U-TzQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYceyvn6h8Qt1Y1tzy_FP5-wjN5mpvVRrcUOhX5UKcJA&oe=6AC3BE27"}, "display_name": "Mandrills", "keywords": [], "long_description": "Mandrills is an incredible multiplayer game that immerses players in a dark and terrifying world of cosmic horror. The main map of the game is a mysterious forest, adding an extra layer of intrigue to the gameplay.\n\nOne of the unique aspects of this game is the NO GRAVITY mode, which allows players to explore a gravity-defying cosmic space. This mode offers exceptional challenges and the opportunity to experience what it's like to move through space without the effects of gravity.\n\nFurthermore, players can look forward to an upcoming game mode that will focus on horror, introducing even more tension and fear into the gameplay.\n\nIn \"Mandrills,\" players must cooperate or compete to survive in the enigmatic forest and confront the chilling challenges of cosmic space. It's an unforgettable experience that delivers both excitement and spine-tingling thrills in a cosmic world filled with dangers.", "short_description": "Mandrills is an engaging multiplayer game where players take on the roles of wild monkeys. In Mandrills, your goal is to either avoid contact with other players or chase them, depending on the rules of the server you're on.\n\nThe game \"Mandrills\" is filled with exciting moments and fast-paced action as players must use their movement skills to gain an advantage over other mandrills or escape from pursuing rivals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/20329a35-445c-46a2-9127-5f09fdbc7dd8", "developer_terms_of_service_url": null, "publisher_name": "fluffymonkyvr", "support_website_url": null, "website_url": "https://wojpieslak.wixsite.com/vexo-runners", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2Q21jaN3v9aioYlUpJLijU3dtttP4v5LDfgJJDi59tg&oe=6AC5273A"}, {"file_name": "New Project (17).png", "id": "869860207993418", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003259_869860211326751_8073700598733340192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JN9eneHbOHcQ7kNvwFZNAJS&_nc_oc=AdpERUCrLrAH6dc-5kvJso09sObHlDyQAX_xWeu_-URry96NXMU_QVFA8Xm_jDWZLpI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAfr8qI3KfhZekmO10b9AW5cJmo60aPgz0rr8o9NKJ-w&oe=6AC50A66"}, {"file_name": "Untitled.png", "id": "1142401653398795", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974575_1142401656732128_4307231838817405837_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgvmxzaB_bMQ7kNvwFOFts0&_nc_oc=AdrF4X3zXqQ3GJMjN0G5k9T2sn2kM6-8KqWnEb3PLx0Dp3ToZUc75eNXuVpRerrJ3xk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9b6k9BCPBTbwR9sUJN4izEiGZRzRd_2xle3GKN2Be8Q&oe=6AC5258C"}, {"file_name": "New Project (1).png", "id": "865121068170817", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75392878_865121071504150_7414861295218057638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h49Dtw6MMBYQ7kNvwFN1Z0g&_nc_oc=AdpHQHuShNmqQ3CssEYBXqOYJnmswNV8b75OtlvRYKPCN3vm6-6sRC8D57MPMOV3L4A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKGlMQWAlKLTuJ2rg61Ija82nNIE7PvoR3lOeuR66HFw&oe=6AC501AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (12).png", "id": "1265056527543615", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974745_1265056530876948_6444653153638334487_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qzl8AOU4zEAQ7kNvwEXiUgm&_nc_oc=Adpw5Acv59NB1YMewlPhsaCMPWNUR83XLLq1vstECLP1e-bu1LtOlRlSz1ClgHEreH4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzWXqS4qFSJ2Wbc2s1x_I-IFGsfVe8PZ-joLX8-Lnzzw&oe=6AC50FA7"}, "display_name": "Mandrills", "keywords": [], "long_description": "Mandrills is an incredible multiplayer game that immerses players in a dark and terrifying world of cosmic horror. The main map of the game is a mysterious forest, adding an extra layer of intrigue to the gameplay.\n\nOne of the unique aspects of this game is the NO GRAVITY mode, which allows players to explore a gravity-defying cosmic space. This mode offers exceptional challenges and the opportunity to experience what it's like to move through space without the effects of gravity.\n\nFurthermore, players can look forward to an upcoming game mode that will focus on horror, introducing even more tension and fear into the gameplay.\n\nIn \"Mandrills,\" players must cooperate or compete to survive in the enigmatic forest and confront the chilling challenges of cosmic space. It's an unforgettable experience that delivers both excitement and spine-tingling thrills in a cosmic world filled with dangers.", "short_description": "Mandrills is an engaging multiplayer game where players take on the roles of wild monkeys. In Mandrills, your goal is to either avoid contact with other players or chase them, depending on the rules of the server you're on.\n\nThe game \"Mandrills\" is filled with exciting moments and fast-paced action as players must use their movement skills to gain an advantage over other mandrills or escape from pursuing rivals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/20329a35-445c-46a2-9127-5f09fdbc7dd8", "developer_terms_of_service_url": null, "publisher_name": "fluffymonkyvr", "support_website_url": null, "website_url": "https://wojpieslak.wixsite.com/vexo-runners", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
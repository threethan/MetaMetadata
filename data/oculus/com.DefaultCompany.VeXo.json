_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0hXssGC3aa4Tb2GmrhU5a0hIH9dDxCgWQiDwX17r_Gw&oe=6AC2843A"}, {"file_name": "New Project (17).png", "id": "869860207993418", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003259_869860211326751_8073700598733340192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JN9eneHbOHcQ7kNvwGSJ-aw&_nc_oc=Ado1gRqcM1Y42lYyFjnWQ92tIXjuchyhR2nPh_1yWb7Yzt45j55nFC9Zu173yrRosj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOK2V6ITI6GafkQ8y_WjkRC_mGfSINUeUg1gs46ofxMHQ&oe=6AC26766"}, {"file_name": "Untitled.png", "id": "1142401653398795", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974575_1142401656732128_4307231838817405837_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o91gkW0hOUkQ7kNvwHwGLz6&_nc_oc=AdpnoSXSH7O0fm4UcYHOrEijnj995fqpgkIVOZW_MCg_z7Kn47oorb-EO64mOeP-crc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_wdLxT7eqj_zAKliYLUKNlLyH-6f3lqe7q8EnNJXmiQ&oe=6AC2828C"}, {"file_name": "New Project (1).png", "id": "865121068170817", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75392878_865121071504150_7414861295218057638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llJMhu_sL-IQ7kNvwE5Io15&_nc_oc=AdoRX_Ej3O3HkigE-Z4bpYtpOJ-kZd-ZjRpOq8vGLimjuebwGV-qxUOsyr2jSR_RDtU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlIwwxI0hjiQEyuWce9MeStgebcR0Uva4lief0xRnn4Q&oe=6AC25EAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (12).png", "id": "1265056527543615", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974745_1265056530876948_6444653153638334487_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kO_cv0WYBgkQ7kNvwFvkESn&_nc_oc=Adq2XS0TQi_5mg29OtUWEIHc61x4FPJF9LBcAynrbI_2XR-s0XeaI3srUzsccuhaNbk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO912IX2UV3pOzbKrLOSzMcYMZWiLgIp_myZ5L9dKvhpg&oe=6AC26CA7"}, "display_name": "Mandrills", "keywords": [], "long_description": "Mandrills is an incredible multiplayer game that immerses players in a dark and terrifying world of cosmic horror. The main map of the game is a mysterious forest, adding an extra layer of intrigue to the gameplay.\n\nOne of the unique aspects of this game is the NO GRAVITY mode, which allows players to explore a gravity-defying cosmic space. This mode offers exceptional challenges and the opportunity to experience what it's like to move through space without the effects of gravity.\n\nFurthermore, players can look forward to an upcoming game mode that will focus on horror, introducing even more tension and fear into the gameplay.\n\nIn \"Mandrills,\" players must cooperate or compete to survive in the enigmatic forest and confront the chilling challenges of cosmic space. It's an unforgettable experience that delivers both excitement and spine-tingling thrills in a cosmic world filled with dangers.", "short_description": "Mandrills is an engaging multiplayer game where players take on the roles of wild monkeys. In Mandrills, your goal is to either avoid contact with other players or chase them, depending on the rules of the server you're on.\n\nThe game \"Mandrills\" is filled with exciting moments and fast-paced action as players must use their movement skills to gain an advantage over other mandrills or escape from pursuing rivals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/20329a35-445c-46a2-9127-5f09fdbc7dd8", "developer_terms_of_service_url": null, "publisher_name": "fluffymonkyvr", "support_website_url": null, "website_url": "https://wojpieslak.wixsite.com/vexo-runners", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
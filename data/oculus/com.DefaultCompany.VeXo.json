_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdQKgYSUvzj-jLbeQtDOm2YhTMXQKqIgERpmvPW7DFLw&oe=6ABA62FA"}, {"file_name": "New Project (17).png", "id": "869860207993418", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003259_869860211326751_8073700598733340192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Kq8OD-6R3gQ7kNvwF5S3Qm&_nc_oc=AdrCSek0UfbpDBfSzY409tQxQVBbDOV1ge6rIY-k3dRowr0a0w-oUPO3qFr7dbSXiVQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1eINB7q7GVsMqada7vg8qgXn2J4QaFm2ClMdzjq47xQ&oe=6ABA7E66"}, {"file_name": "Untitled.png", "id": "1142401653398795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974575_1142401656732128_4307231838817405837_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6d_Yy0Bs738Q7kNvwHa48Bd&_nc_oc=AdoLKfQqkcy0OaLiUsih7U-oYlmFSBCUc8ShG_sZ-g6t9w0F0M9oI1QThaaPg0e4iLc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKDT-sYW5xa72UbiYQa4JuDn7iE924FvrItsylE1eZKQ&oe=6ABA614C"}, {"file_name": "New Project (1).png", "id": "865121068170817", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75392878_865121071504150_7414861295218057638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoPmQXamrVgQ7kNvwHHukek&_nc_oc=Ado_KrwHGVY_phPCF2edmULN20ehloj-IXR6Oil9XoUKDj0ztOHbFnwAhXnx48JFzXA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIINpip23fOULJ2t7QN5L30LrOLJ10_ReuzWeqHpdKWig&oe=6ABA75AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (12).png", "id": "1265056527543615", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974745_1265056530876948_6444653153638334487_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ChKes4PFVAQ7kNvwHlM_QN&_nc_oc=AdodL_mc913juhZuKzF9ADailM3QskuMckXZ7msN9SD2j4I2YfsP801ShtDMvHl52iY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZpYp2vLIcS1dPFeG8Kotvy6vCaqrRB7DiJZzR92a6ZQ&oe=6ABA83A7"}, "display_name": "Mandrills", "keywords": [], "long_description": "Mandrills is an incredible multiplayer game that immerses players in a dark and terrifying world of cosmic horror. The main map of the game is a mysterious forest, adding an extra layer of intrigue to the gameplay.\n\nOne of the unique aspects of this game is the NO GRAVITY mode, which allows players to explore a gravity-defying cosmic space. This mode offers exceptional challenges and the opportunity to experience what it's like to move through space without the effects of gravity.\n\nFurthermore, players can look forward to an upcoming game mode that will focus on horror, introducing even more tension and fear into the gameplay.\n\nIn \"Mandrills,\" players must cooperate or compete to survive in the enigmatic forest and confront the chilling challenges of cosmic space. It's an unforgettable experience that delivers both excitement and spine-tingling thrills in a cosmic world filled with dangers.", "short_description": "Mandrills is an engaging multiplayer game where players take on the roles of wild monkeys. In Mandrills, your goal is to either avoid contact with other players or chase them, depending on the rules of the server you're on.\n\nThe game \"Mandrills\" is filled with exciting moments and fast-paced action as players must use their movement skills to gain an advantage over other mandrills or escape from pursuing rivals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/20329a35-445c-46a2-9127-5f09fdbc7dd8", "developer_terms_of_service_url": null, "publisher_name": "fluffymonkyvr", "support_website_url": null, "website_url": "https://wojpieslak.wixsite.com/vexo-runners", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
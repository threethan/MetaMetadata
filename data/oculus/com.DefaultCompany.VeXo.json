_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKphIYnP51QR5hRbrgfD69UGOqN5Tj8dXZTj1PLETYRbw&oe=6ABD05FA"}, {"file_name": "New Project (17).png", "id": "869860207993418", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003259_869860211326751_8073700598733340192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Kq8OD-6R3gQ7kNvwFQWIP4&_nc_oc=Ado1C3LXAaOh_HCTU0s1RfvBohwkBEfuHy16jV7JyK18jqluR_amZuxcNtN14EOhpTE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfD4JYWah1cyXMJCfGHRfAqLcrND8qq3VnWzzSzLfeqw&oe=6ABD2166"}, {"file_name": "Untitled.png", "id": "1142401653398795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974575_1142401656732128_4307231838817405837_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfxHHpheb4MQ7kNvwHBWgNC&_nc_oc=AdpOfq1hmHhVwRctAgtghs9UAzQqi1TNv0wKGnJDd6NoiaNP3zbqS458ci-1SK4dsqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWQt_iYBIWw4WJAchbZAFnPa85cV-Go5oFzWXi_87ROQ&oe=6ABD044C"}, {"file_name": "New Project (1).png", "id": "865121068170817", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75392878_865121071504150_7414861295218057638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZx8-agE9a0Q7kNvwGlBRVs&_nc_oc=AdqiXtNiZnv3_iS1Ae2GwLCmK99rxXPDWKHUeyFb32PApD1YqTrpK3mhBWruYl3IZnQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRnEkM23Ov0svIawu8JK7V8jQQTXeEeW7n3-N8GLYdBQ&oe=6ABD18AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (12).png", "id": "1265056527543615", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974745_1265056530876948_6444653153638334487_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWFX0wp9KgsQ7kNvwFNLjM8&_nc_oc=Adp4tNAfwTXMmVmJ6qZyz3epkLvLQ-3W3CXxLVXiOIg1uQBBRRtmL43b-Etfsrhg89s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEb51zuA67oXmkylAsxudhRekojYLVsgHL4VA5Wv8Q7A&oe=6ABD26A7"}, "display_name": "Mandrills", "keywords": [], "long_description": "Mandrills is an incredible multiplayer game that immerses players in a dark and terrifying world of cosmic horror. The main map of the game is a mysterious forest, adding an extra layer of intrigue to the gameplay.\n\nOne of the unique aspects of this game is the NO GRAVITY mode, which allows players to explore a gravity-defying cosmic space. This mode offers exceptional challenges and the opportunity to experience what it's like to move through space without the effects of gravity.\n\nFurthermore, players can look forward to an upcoming game mode that will focus on horror, introducing even more tension and fear into the gameplay.\n\nIn \"Mandrills,\" players must cooperate or compete to survive in the enigmatic forest and confront the chilling challenges of cosmic space. It's an unforgettable experience that delivers both excitement and spine-tingling thrills in a cosmic world filled with dangers.", "short_description": "Mandrills is an engaging multiplayer game where players take on the roles of wild monkeys. In Mandrills, your goal is to either avoid contact with other players or chase them, depending on the rules of the server you're on.\n\nThe game \"Mandrills\" is filled with exciting moments and fast-paced action as players must use their movement skills to gain an advantage over other mandrills or escape from pursuing rivals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/20329a35-445c-46a2-9127-5f09fdbc7dd8", "developer_terms_of_service_url": null, "publisher_name": "fluffymonkyvr", "support_website_url": null, "website_url": "https://wojpieslak.wixsite.com/vexo-runners", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
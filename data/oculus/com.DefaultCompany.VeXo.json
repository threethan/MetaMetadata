_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKheb7-rJk1umwPX56MCX-bLV63XLlIK7Iv4yGDf-JGvA&oe=6A996D7A"}, {"file_name": "New Project (17).png", "id": "869860207993418", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003259_869860211326751_8073700598733340192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdrB9SBL2TgQ7kNvwGHx2yS&_nc_oc=AdoDRvJWVayGKuzMABX3np_AGOfuV7jKFnwMMwTaR0wTZMc0T8ZgZRBzmRDAXTGQGxc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQs8mwjIzF0zIwY7Sajo7XfvwcYuK_3OEX3KmFtpIo3Q&oe=6A9988E6"}, {"file_name": "Untitled.png", "id": "1142401653398795", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974575_1142401656732128_4307231838817405837_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StgDkODsTM0Q7kNvwHIiZkl&_nc_oc=AdqIuo2PRP1Vvy2D0vvUjZF-mSQQUWc9dAixWMi7rG6JFhGvVFpaRVq7qck4KvFDo6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpwp60KM7twaJB5fm26k9mxkDaVMPcVN9I4EIBymBh9g&oe=6A99A40C"}, {"file_name": "New Project (1).png", "id": "865121068170817", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75392878_865121071504150_7414861295218057638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRypWM1uDp8Q7kNvwFIuBIB&_nc_oc=AdrwTAWhufuHRFSuBPtngqtygpV9CpFCCyWVJef0RFWG4yThRXE_0-d-41NNK6uu5RA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN-jp3kVfCtEY0BRKj05l-_Qboemm9LuEpj8IK0A2cgw&oe=6A99802E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (12).png", "id": "1265056527543615", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974745_1265056530876948_6444653153638334487_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwYzptZokOcQ7kNvwFTiyk8&_nc_oc=AdqRLJw4aceKeJbnwKA2upklAwpx5l0Wia_OG7SbwP_N0iKLLbcVRZ0Fyok7QIbSU38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqwFpWgIlJv2rUPnVIv0k34SuBs2pAepMNsWUHV_iKJg&oe=6A998E27"}, "display_name": "Mandrills", "keywords": [], "long_description": "Mandrills is an incredible multiplayer game that immerses players in a dark and terrifying world of cosmic horror. The main map of the game is a mysterious forest, adding an extra layer of intrigue to the gameplay.\n\nOne of the unique aspects of this game is the NO GRAVITY mode, which allows players to explore a gravity-defying cosmic space. This mode offers exceptional challenges and the opportunity to experience what it's like to move through space without the effects of gravity.\n\nFurthermore, players can look forward to an upcoming game mode that will focus on horror, introducing even more tension and fear into the gameplay.\n\nIn \"Mandrills,\" players must cooperate or compete to survive in the enigmatic forest and confront the chilling challenges of cosmic space. It's an unforgettable experience that delivers both excitement and spine-tingling thrills in a cosmic world filled with dangers.", "short_description": "Mandrills is an engaging multiplayer game where players take on the roles of wild monkeys. In Mandrills, your goal is to either avoid contact with other players or chase them, depending on the rules of the server you're on.\n\nThe game \"Mandrills\" is filled with exciting moments and fast-paced action as players must use their movement skills to gain an advantage over other mandrills or escape from pursuing rivals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/20329a35-445c-46a2-9127-5f09fdbc7dd8", "developer_terms_of_service_url": null, "publisher_name": "fluffymonkyvr", "support_website_url": null, "website_url": "https://wojpieslak.wixsite.com/vexo-runners", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfPYqNuuBo8cL5PMUw7dWTZ-HWxjMMD_oQ2c9uXGDI3w&oe=6A92D5FA"}, {"file_name": "New Project (17).png", "id": "869860207993418", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003259_869860211326751_8073700598733340192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVhwwfpcvgoQ7kNvwHDypTU&_nc_oc=AdreKqSumHfy5VSjHszUpSZJgkK3VnB83wcByzwzN06cyVcWnA5bDintIp6BtgrT1qE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8LZtUusiiSLZV5-LEozX2FVpY6en3KEKi5dk96Xlynw&oe=6A92B926"}, {"file_name": "Untitled.png", "id": "1142401653398795", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974575_1142401656732128_4307231838817405837_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gB1Dk5bj_zUQ7kNvwExw3iu&_nc_oc=Adp3D-ZVbeiKy_zZNRZHHf_Xkgih1Zht1S_HMq9mBPTuIhd9E9Ephe4LDpDJC0mdsG4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWb6tspisC5wzl1wNsD_wB1l-lPue0cDY1x9LJWZO5_Q&oe=6A92D44C"}, {"file_name": "New Project (1).png", "id": "865121068170817", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75392878_865121071504150_7414861295218057638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDOn5zSVZ1kQ7kNvwFLwVRP&_nc_oc=AdrqBUUqIOr-ViTeRORsEj7gz-8T5T3uWIfNO0G8Yu8Jxk4EBvDCet5T4g8OSkK8hFY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJtfzsdhL3_7dLgH682TfZnC3n_OPISgQ3XwuCNoLg_Q&oe=6A92B06E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (12).png", "id": "1265056527543615", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974745_1265056530876948_6444653153638334487_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ub71VWKEKB0Q7kNvwEhAohy&_nc_oc=AdqRvHTC5wL0AK_7F4exNbHa21CRR4PVmMAQug_6xW61IOsJUYvozQSdZ3Js0fhnYDA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFs9AKIPM35BhzXlMKznnpBzrqGfovLnILkDIhIKwEDmg&oe=6A92BE67"}, "display_name": "Mandrills", "keywords": [], "long_description": "Mandrills is an incredible multiplayer game that immerses players in a dark and terrifying world of cosmic horror. The main map of the game is a mysterious forest, adding an extra layer of intrigue to the gameplay.\n\nOne of the unique aspects of this game is the NO GRAVITY mode, which allows players to explore a gravity-defying cosmic space. This mode offers exceptional challenges and the opportunity to experience what it's like to move through space without the effects of gravity.\n\nFurthermore, players can look forward to an upcoming game mode that will focus on horror, introducing even more tension and fear into the gameplay.\n\nIn \"Mandrills,\" players must cooperate or compete to survive in the enigmatic forest and confront the chilling challenges of cosmic space. It's an unforgettable experience that delivers both excitement and spine-tingling thrills in a cosmic world filled with dangers.", "short_description": "Mandrills is an engaging multiplayer game where players take on the roles of wild monkeys. In Mandrills, your goal is to either avoid contact with other players or chase them, depending on the rules of the server you're on.\n\nThe game \"Mandrills\" is filled with exciting moments and fast-paced action as players must use their movement skills to gain an advantage over other mandrills or escape from pursuing rivals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/20329a35-445c-46a2-9127-5f09fdbc7dd8", "developer_terms_of_service_url": null, "publisher_name": "fluffymonkyvr", "support_website_url": null, "website_url": "https://wojpieslak.wixsite.com/vexo-runners", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
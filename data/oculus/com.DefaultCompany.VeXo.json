_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6rdkQEKtUNw1bGGO4RAeZBf77T2Um4zXe7owir2L5SA&oe=6ABFA8FA"}, {"file_name": "New Project (17).png", "id": "869860207993418", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003259_869860211326751_8073700598733340192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsJuBRq4HBkQ7kNvwE-A_HX&_nc_oc=AdqVSQCmUVm4PzGAUdblzMj2BHgYjCjwWZbXFikmRMY2wfP-iUpRYvhzdZQ33NSGZDU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-bs98651AM0smbXSyJXQVU9rHdNn8-PnlhtZXVRIjLw&oe=6ABFC466"}, {"file_name": "Untitled.png", "id": "1142401653398795", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974575_1142401656732128_4307231838817405837_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfxHHpheb4MQ7kNvwF2J5eV&_nc_oc=AdpK47x28J4KHjFh7nu6Y6Aiaju6KhjL7FoVPppQ2OIx9t6FeWGWc44Qk467aWj70ZI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTpgignuo885w8UVGMM2F2APikO0nFxrXp2FXVwCM6-Q&oe=6ABFA74C"}, {"file_name": "New Project (1).png", "id": "865121068170817", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75392878_865121071504150_7414861295218057638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llJMhu_sL-IQ7kNvwF08n1R&_nc_oc=AdpGMGaqpQmwWP5nMwq36HMqNCv-ytl5VpOqX-VdMhxq5jZs5qJR1XjqOAbQRr_q8fk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW-7KRFbky4faIg6ADgQ7ykidvd-u3uIly4y3i9EB3Cw&oe=6ABFBBAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (12).png", "id": "1265056527543615", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974745_1265056530876948_6444653153638334487_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWFX0wp9KgsQ7kNvwFtzRpz&_nc_oc=Adqj58quncmX-ykmoUgTidItCPLvjteq0Ni4xCK5u5dIfKTqxWMpaW0CEySiInIam-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPwA013b_SdPo5tVqItn_jbrt2yxFJIiPjpBCt8mR-Nw&oe=6ABFC9A7"}, "display_name": "Mandrills", "keywords": [], "long_description": "Mandrills is an incredible multiplayer game that immerses players in a dark and terrifying world of cosmic horror. The main map of the game is a mysterious forest, adding an extra layer of intrigue to the gameplay.\n\nOne of the unique aspects of this game is the NO GRAVITY mode, which allows players to explore a gravity-defying cosmic space. This mode offers exceptional challenges and the opportunity to experience what it's like to move through space without the effects of gravity.\n\nFurthermore, players can look forward to an upcoming game mode that will focus on horror, introducing even more tension and fear into the gameplay.\n\nIn \"Mandrills,\" players must cooperate or compete to survive in the enigmatic forest and confront the chilling challenges of cosmic space. It's an unforgettable experience that delivers both excitement and spine-tingling thrills in a cosmic world filled with dangers.", "short_description": "Mandrills is an engaging multiplayer game where players take on the roles of wild monkeys. In Mandrills, your goal is to either avoid contact with other players or chase them, depending on the rules of the server you're on.\n\nThe game \"Mandrills\" is filled with exciting moments and fast-paced action as players must use their movement skills to gain an advantage over other mandrills or escape from pursuing rivals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/20329a35-445c-46a2-9127-5f09fdbc7dd8", "developer_terms_of_service_url": null, "publisher_name": "fluffymonkyvr", "support_website_url": null, "website_url": "https://wojpieslak.wixsite.com/vexo-runners", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
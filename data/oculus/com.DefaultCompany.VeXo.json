_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-96S4VMK2H2nkfmWRq0rgm0qObTzS3mRrgRT6IIIHsg&oe=6AA69C7A"}, {"file_name": "New Project (17).png", "id": "869860207993418", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003259_869860211326751_8073700598733340192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nONX-7AtusQ7kNvwGroD4z&_nc_oc=AdpVkEvfhCLI-XzGnDO2BryC8vjfsagWX_pNzKYCnHNZ0LilBMXvlqldHMtwK6feXvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJohA4fP4EgJiuWgtfUFpw8eEO7JrQRhrS5UdB08e2dGw&oe=6AA6B7E6"}, {"file_name": "Untitled.png", "id": "1142401653398795", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974575_1142401656732128_4307231838817405837_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0OnmJa42UMQ7kNvwENZTx4&_nc_oc=AdrLXiS-F3_IGsH0T3HL02xHCwhiFUs2LhO6fyg0LcaePAKkrhkjTP5J5Girmfj5-TI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdDLhhJ9JgAD8Pn_vH1fbP44tx3UCdgGXG9jW8ONVgpg&oe=6AA69ACC"}, {"file_name": "New Project (1).png", "id": "865121068170817", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75392878_865121071504150_7414861295218057638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3Lv0bEzdq8Q7kNvwFQ1zfu&_nc_oc=AdpPy7WZTaxm_yRtbNf5zGv5TalVE1tRH861IVeDv4XQcDyPx412ci_t7-csD2AdqJc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmE8nbOlKAoyfqk3nOxHS1U0Wh9z-oD_j-GYUHsR-IVQ&oe=6AA6AF2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (12).png", "id": "1265056527543615", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974745_1265056530876948_6444653153638334487_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-pncx_jWwwQ7kNvwEXG8Mw&_nc_oc=AdrHLdkcSUP8e2FTS3TKQSOGq5QhT3PgIIypWge8_OAPifOVFtbl0ePW_K6YfLeDlOk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdDIO5zxwOqQbsTD2mIkhcK2vRXasdfw8e7r15b7H74Q&oe=6AA6BD27"}, "display_name": "Mandrills", "keywords": [], "long_description": "Mandrills is an incredible multiplayer game that immerses players in a dark and terrifying world of cosmic horror. The main map of the game is a mysterious forest, adding an extra layer of intrigue to the gameplay.\n\nOne of the unique aspects of this game is the NO GRAVITY mode, which allows players to explore a gravity-defying cosmic space. This mode offers exceptional challenges and the opportunity to experience what it's like to move through space without the effects of gravity.\n\nFurthermore, players can look forward to an upcoming game mode that will focus on horror, introducing even more tension and fear into the gameplay.\n\nIn \"Mandrills,\" players must cooperate or compete to survive in the enigmatic forest and confront the chilling challenges of cosmic space. It's an unforgettable experience that delivers both excitement and spine-tingling thrills in a cosmic world filled with dangers.", "short_description": "Mandrills is an engaging multiplayer game where players take on the roles of wild monkeys. In Mandrills, your goal is to either avoid contact with other players or chase them, depending on the rules of the server you're on.\n\nThe game \"Mandrills\" is filled with exciting moments and fast-paced action as players must use their movement skills to gain an advantage over other mandrills or escape from pursuing rivals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/20329a35-445c-46a2-9127-5f09fdbc7dd8", "developer_terms_of_service_url": null, "publisher_name": "fluffymonkyvr", "support_website_url": null, "website_url": "https://wojpieslak.wixsite.com/vexo-runners", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
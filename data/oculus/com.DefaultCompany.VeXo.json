_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImamolLIJUTvtlG6JR8rw_PjVMIEjwliDG6pCt1oe2Zw&oe=6A9C107A"}, {"file_name": "New Project (17).png", "id": "869860207993418", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003259_869860211326751_8073700598733340192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFb-C2mDk_IQ7kNvwH80bqZ&_nc_oc=AdrjdRYqFOUHlr4cb-6Z5iOLT4mqTLVJcHjqzIflX0ObMeZ1C_Is_Rl9nlqRjRmdC4c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIn2cQldx8VTsV5mKyyPuQg3VemGOjEjcXlJ8yFR2OXw&oe=6A9C2BE6"}, {"file_name": "Untitled.png", "id": "1142401653398795", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974575_1142401656732128_4307231838817405837_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StgDkODsTM0Q7kNvwF_AMQ6&_nc_oc=Adov9ZPQFbkx41wer3hurhao2aXACFJR4rPQKHjMxzHfqSk6K5lp_6YNpSK2eXRUAis&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLakW7ZpfB8c_J6ABaZakZx5pGZx7n0oTUna93SGyB82Q&oe=6A9C0ECC"}, {"file_name": "New Project (1).png", "id": "865121068170817", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392878_865121071504150_7414861295218057638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDMC2-J9CO0Q7kNvwG9fmLe&_nc_oc=Adq4tip-ZI4m8xtyBwyByL6y4VqZjvXjjnMyZ5oJwkEqIEpIehVtV5GoLcuAM7SucUA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpkRgRnMQbs0BvkIL_zfK_Zp6LyNGZJL46wnCsAlJSPQ&oe=6A9C232E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (12).png", "id": "1265056527543615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974745_1265056530876948_6444653153638334487_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwYzptZokOcQ7kNvwFXO7dj&_nc_oc=AdqBSjqzsKUytRjarOT4-hsU1J2AmoP_jZqI-WJQO3AlUCW7aSf_i-a6-G8VRCevjm0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJu0fW9yOoupE5uNe4u5jVPORl9WfbffYuP1ioHfLGrEQ&oe=6A9C3127"}, "display_name": "Mandrills", "keywords": [], "long_description": "Mandrills is an incredible multiplayer game that immerses players in a dark and terrifying world of cosmic horror. The main map of the game is a mysterious forest, adding an extra layer of intrigue to the gameplay.\n\nOne of the unique aspects of this game is the NO GRAVITY mode, which allows players to explore a gravity-defying cosmic space. This mode offers exceptional challenges and the opportunity to experience what it's like to move through space without the effects of gravity.\n\nFurthermore, players can look forward to an upcoming game mode that will focus on horror, introducing even more tension and fear into the gameplay.\n\nIn \"Mandrills,\" players must cooperate or compete to survive in the enigmatic forest and confront the chilling challenges of cosmic space. It's an unforgettable experience that delivers both excitement and spine-tingling thrills in a cosmic world filled with dangers.", "short_description": "Mandrills is an engaging multiplayer game where players take on the roles of wild monkeys. In Mandrills, your goal is to either avoid contact with other players or chase them, depending on the rules of the server you're on.\n\nThe game \"Mandrills\" is filled with exciting moments and fast-paced action as players must use their movement skills to gain an advantage over other mandrills or escape from pursuing rivals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/20329a35-445c-46a2-9127-5f09fdbc7dd8", "developer_terms_of_service_url": null, "publisher_name": "fluffymonkyvr", "support_website_url": null, "website_url": "https://wojpieslak.wixsite.com/vexo-runners", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
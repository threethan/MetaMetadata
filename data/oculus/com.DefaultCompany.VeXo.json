_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVv16X70bOsm2owlNG9DslfTkN758mf9Tv5Us1n524Dw&oe=6A8AECFA"}, {"file_name": "New Project (17).png", "id": "869860207993418", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003259_869860211326751_8073700598733340192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0DPrnaXY_QQ7kNvwElByZR&_nc_oc=AdpgYusmq0MGT1iMa_3dkLMzL5uNi206A9Gwy8Y83ABFkAxG-Adlcos7DUFJJ03-pfM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYsiRsf-LDjgyJ2AtWrKl3HSjlv4__Kyu6XjRf4QAGhw&oe=6A8AD026"}, {"file_name": "Untitled.png", "id": "1142401653398795", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974575_1142401656732128_4307231838817405837_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnENJE2QqIkQ7kNvwH-C0FG&_nc_oc=AdoPbIZ-fqovVZOOXhXt_oY4sN9eizi4oEfGg5U-neKLFqKw1OVZGLMTS2w8_6mi53Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQES732jf7zDcVNeZWwtCE4K5hR9BTLbBKKXWeabnEixoQ&oe=6A8AEB4C"}, {"file_name": "New Project (1).png", "id": "865121068170817", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75392878_865121071504150_7414861295218057638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB46Qg7eo58Q7kNvwFtH-Pd&_nc_oc=AdrTElZXat-FTcGcdNk-9XXdDqQ4A-s8HoMJFMb_x_MOnLH8B4oKXZsD-6Utw_KtlZ4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAQkun5R_K8fX2hkHrVtB3JdalxFpZ8jBGH8wdK3aFVQ&oe=6A8AC76E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (12).png", "id": "1265056527543615", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974745_1265056530876948_6444653153638334487_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-G7h7i6z8kAQ7kNvwF872Zu&_nc_oc=AdpiabocoOw6JaMfY_HHTa9cO-JdphRn9dLrouOP-mrcd-LzkBH1KWFZ5ISL9EF9Ku4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQET6vfnpbB443YsAVQLnahvItd1JzAPQNdJStNLh-YdUg&oe=6A8AD567"}, "display_name": "Mandrills", "keywords": [], "long_description": "Mandrills is an incredible multiplayer game that immerses players in a dark and terrifying world of cosmic horror. The main map of the game is a mysterious forest, adding an extra layer of intrigue to the gameplay.\n\nOne of the unique aspects of this game is the NO GRAVITY mode, which allows players to explore a gravity-defying cosmic space. This mode offers exceptional challenges and the opportunity to experience what it's like to move through space without the effects of gravity.\n\nFurthermore, players can look forward to an upcoming game mode that will focus on horror, introducing even more tension and fear into the gameplay.\n\nIn \"Mandrills,\" players must cooperate or compete to survive in the enigmatic forest and confront the chilling challenges of cosmic space. It's an unforgettable experience that delivers both excitement and spine-tingling thrills in a cosmic world filled with dangers.", "short_description": "Mandrills is an engaging multiplayer game where players take on the roles of wild monkeys. In Mandrills, your goal is to either avoid contact with other players or chase them, depending on the rules of the server you're on.\n\nThe game \"Mandrills\" is filled with exciting moments and fast-paced action as players must use their movement skills to gain an advantage over other mandrills or escape from pursuing rivals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/20329a35-445c-46a2-9127-5f09fdbc7dd8", "developer_terms_of_service_url": null, "publisher_name": "fluffymonkyvr", "support_website_url": null, "website_url": "https://wojpieslak.wixsite.com/vexo-runners", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
259_869860211326751_8073700598733340192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-m2j4rFjQMQ7kNvwGT86mq&_nc_oc=AdmePhPfEl1YWwJrnqp7of7AWn9iLuIrNv6cGwy6d_RvIrJ0DLRGuQklA1POHJKDOzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfshgUiZCwwwyb93p_mqzd1GNy6lYEVHqQAEXzL2IgYHgA&oe=69A2C826"}, {"file_name": "Untitled.png", "id": "1142401653398795", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974575_1142401656732128_4307231838817405837_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVN9F2MolY0Q7kNvwHvXhjB&_nc_oc=AdkmqUzrORhS9_eM1wwyy6Q8LWkSHMOBe54cZtmYR4_fUmHA3eLoe-qjxZCx2LrXn-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu6GZCkiZouwPJVimMCWdLtiTXniMyQpY44b307xDcAvQ&oe=69A2E34C"}, {"file_name": "New Project (1).png", "id": "865121068170817", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75392878_865121071504150_7414861295218057638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eh-GJ6NSIy0Q7kNvwErBLqY&_nc_oc=AdmZYYifiOhVWG_E6oyEVb8sGpQB9yq-Vq5BPF05I_QGkbVsN5Zt3vP1hQO_HpSn77c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvcQSSLNNCbD2fLXN3b2eQaZNzjUEIWU54qsEXKwMxJJA&oe=69A2F7AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (12).png", "id": "1265056527543615", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974745_1265056530876948_6444653153638334487_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtE5Yg3uvnQQ7kNvwEwSYby&_nc_oc=Adl-K5Vwm03uQRqPNHz1nQfDBm4uo-ZPXS8cWrM1pWbVt82hou5-hqFtB_N5VsIJu7k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftWf8pxaHIW6QQ9qP6ZohrjftLShrDCOnAxpfdw5Wj5ig&oe=69A2CD67"}, "display_name": "Mandrills", "keywords": [], "long_description": "Mandrills is an incredible multiplayer game that immerses players in a dark and terrifying world of cosmic horror. The main map of the game is a mysterious forest, adding an extra layer of intrigue to the gameplay.\n\nOne of the unique aspects of this game is the NO GRAVITY mode, which allows players to explore a gravity-defying cosmic space. This mode offers exceptional challenges and the opportunity to experience what it's like to move through space without the effects of gravity.\n\nFurthermore, players can look forward to an upcoming game mode that will focus on horror, introducing even more tension and fear into the gameplay.\n\nIn \"Mandrills,\" players must cooperate or compete to survive in the enigmatic forest and confront the chilling challenges of cosmic space. It's an unforgettable experience that delivers both excitement and spine-tingling thrills in a cosmic world filled with dangers.", "short_description": "Mandrills is an engaging multiplayer game where players take on the roles of wild monkeys. In Mandrills, your goal is to either avoid contact with other players or chase them, depending on the rules of the server you're on.\n\nThe game \"Mandrills\" is filled with exciting moments and fast-paced action as players must use their movement skills to gain an advantage over other mandrills or escape from pursuing rivals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/20329a35-445c-46a2-9127-5f09fdbc7dd8", "developer_terms_of_service_url": null, "publisher_name": "fluffymonkyvr", "support_website_url": null, "website_url": "https://wojpieslak.wixsite.com/vexo-runners", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_mode
7&_nc_sid=6e7a0a&_nc_ohc=MpQGTRTcD8oQ7kNvwG0pj-g&_nc_oc=AdoGfPN_tzUc815ZTd7YU0FFNeSdQ9PnGs0weStQmZyqUdbGEHTfN3kFILVn2ciowvk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEG2b8LpwPfbYp5ptI3z7BTvatPkX0p0MYlje1gzpm22g&oe=6A71E41B"}, {"file_name": "screenShot_2022-08-16_17-32-39.png", "id": "754788192478332", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974672_754788195811665_1965013380078461039_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSCZtQWd-XgQ7kNvwEaxVbC&_nc_oc=AdpkDN9yfxCLumPQgKQ0KQ79UEQQXnMnMzeDFPHtNap3DxDPYDEdQ_bqbbp_jHgXx48&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOlNa_s8Ay3p74o4cFUIWgSf4nGQib5FIIoGwWdbIdrQ&oe=6A71FF8F"}, {"file_name": "11.png", "id": "357281973019318", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982469_357281976352651_8546329914532511041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Nmi_YeGjOoQ7kNvwHkoZ07&_nc_oc=AdqPv9BYbkOSE_dtqi_-1XxkfTWOhkazdNWFBIeFJjUr4Af_fAtHDRHxbRkQ1Ak6nEo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-fZpf0nqLEGkp1zo0FuP-5yvlfn5awZOFy-cT_mJXyw&oe=6A71CFAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75658018_1127523848176206_3694338244670832203_n.png", "id": "532541412542933", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036682_532541415876266_9014538991903330233_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xv2dLveotBYQ7kNvwFhSf23&_nc_oc=AdrEWHPxqTi7vYyNw3Wa3eE6ftk3HoA4j6n9ojRRJeYbTd7nuhzmsY7I11JOqlPoaJ0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW3bm8c48MFQ-23aPnUkGc_F4ifnO2A6X7vooTNiSdng&oe=6A71EA10"}, "display_name": "Chess VR", "keywords": ["chess"], "long_description": "Brave chess players, unsheathe your sword and commence a medieval duel on the chessboard!\nImmerse yourself in the medieval castle or the pixel-style arena to achieve multi-scene travel.Try to interact with pieces and personages, something interesting might occur. Of course, you can challenge our knights and heroes, the iron throne awaits the conqueror!\n\nFunction Update\n1. Hand Tracking\n2. Avatar & Voice Chat\n\n Core Features\n- 8 AI levels \n- Online mode: Friend Room; Playing with mobile or vr opponents\n- 4 scenes: Medieval Castle & Pixel-style & Space & Japanese-style room\n- Review and analysis of chess moves\n- 1000+ puzzles \n- Fight animations and sound FX\n- Both Hand tracking and Touch controllers are supported!\n\nWe will constantly optimize and update to bring you a better experience. Avatars, voice IP are on the way. Feel free to leave feedback in comments.", "short_description": "Brave chess players, unsheathe your sword and commence a medieval duel on the chessboard!\n\nFunction Update\n1. Hand Tracking\n2. Avatar & Voice Chat\n\n Core Features\n- 8 AI levels \n- Online mode: Friend Room; Playing with mobile or vr opponents\n- 4 scenes: Medieval Castle & Pixel-style & Space & Japanese-style room\n- Review and analysis of chess moves\n- 1000+ puzzles \n- Fight animations and sound FX\n- Both Hand tracking and Touch controllers are supported!"}]}, "developer_name": "Mastery VR", "developer_privacy_policy_url": "https://masteryvrstudio.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Mastery VR", "support_website_url": null, "website_url": "https://masteryvrstudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITT
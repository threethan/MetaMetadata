sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-F1mJW3DqoPxnj8t3U2eqC4G-F4JBjUBmSR2_ycSuAqA&oe=6A36C05A"}, {"file_name": "3.png", "id": "460014655667310", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974751_460014659000643_1895291394585281199_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=bA0ItAhQ_3UQ7kNvwHYKyWr&_nc_oc=AdqyLE8YQ5GQfDRRE2yTGuuLGIae1BjkMn9wDcdtqh5wG1yOPezhSwnfc9EuV0Dic9Q&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jS8UQvWCUVFXesNqppk_u6SHRVDL8MbCVa4deNNhpoQ&oe=6A36B3BD"}, {"file_name": "1.png", "id": "690235401966661", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974844_690235408633327_4694687908405151518_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtF_Z7PaP5UQ7kNvwHf0An8&_nc_oc=AdqwDGjzWaI0-CO5VSojVijkQvn_cEkW5Sn5q4dv01R3XSqAlJ3TF-PHte9rAJOMjIY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_54vsSjApczjIZqECJDTatyd1Wj363aBxFdledDn72Qw&oe=6A36AE61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "650205073081398", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75322599_650205076414731_7889925823714149704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbGfHh-RAywQ7kNvwGBZpmu&_nc_oc=AdrPpfXYPhwh2QnTfcLssE3Gha2cBJsqzK6CCom_4Zp5JwmmTVEJA0gbF79ly-6GcJg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XpXDKQhXXNC911LoZtZGryJV1HgkLiGeJYmvicezbxQ&oe=6A36A1E0"}, "display_name": "Chess VR", "keywords": [], "long_description": "Sit in front of the computer and play chess? Click on the phone screen? You're out of date!\n\nAlthough sitting on the sofa or lie in bed at home, you can still feel the ice-cold air in the medieval castle. Dressed in armour and armed with a sword, having a hearty game with your friends! Of course, you can also challenge our knights and heroes, conquer them with your wisdom to reach the top of your Iron Throne!\n\nFeatures:\n-5 AI difficulty levels\n-Challenge the endgame and make the difference\n-Play against the Knight in a medieval castle\n-Detailed chess move hint, novice friendly\n-Retro UI design\n-Undo function, no fear of mistakes\n-Great controller experience!\n\nWith frequent updates. the traditional chess experience as well as new features in conjunction with Quest2 will be provided.\n\nIncluding richer scenes, chess with friends, tournaments, real-time voice chat, fast chess and super fast chess, review analysis, chess timer, chess online, avatars, etc.\n\nDownload it now!", "short_description": "Play chess with computer or your phone? You're out of date!\n\nAlthough sitting on the sofa or lie in bed, you can still feel the ice-cold air in the medieval castle. Equipped with armour and sword , having a hearty game with friends! Conquering Knights stepwisely with your wisdom to reach the top of your Iron Throne!\n\nFeatures:\n-5 AI difficulty levels\n-Challenge the endgame\n-Immersive medieval castle\n-Move hint & Repentance, novice friendly\n-Great controller experience!\n\nDownload it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://chessvrgame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SUPLIFE PTE", "support_website_url": "https://chessvrgame.com/contact", "website_url": "https://chessvrgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_mo
7&_nc_sid=6e7a0a&_nc_ohc=3YoKXucpEHUQ7kNvwG-ZKYV&_nc_oc=AdrVR0Juxvn0vN4Tv37w5TmdzmvnHjuR2SjOz6Z35Aewom-HWLKQ9M52fXwwKMe3aJA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dzOa85Gmcrv8wGr05-6u5bw629zG6Y9ZWcInBrPAnsw&oe=69FDE01B"}, {"file_name": "screenShot_2022-08-16_17-32-39.png", "id": "754788192478332", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974672_754788195811665_1965013380078461039_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KKSGsOPuh4Q7kNvwHDAPkB&_nc_oc=AdqqyaXA0M5__ufMk6y0sYxbPvjYEPBn1ZBt7Otw9GC-fIDD9Gy3T1o-KWxyeVw6bWE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HnLy-B_xe50h6KbRuCdtOBsi4qdOV5SoX63EUOlVwTw&oe=69FDFB8F"}, {"file_name": "11.png", "id": "357281973019318", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982469_357281976352651_8546329914532511041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJ-OlgodZHkQ7kNvwHyB2Hv&_nc_oc=AdrzmMiqISdYPaa8iDT5fiamPCZSGxzj4UYsoTSN_JMqnoE5eJO4UCXFjoDxOGVYgq8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fz9pWr4cmbIcZCm1gXs-OSEmWH5mbLALf1VADW6VwXg&oe=69FE03EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75658018_1127523848176206_3694338244670832203_n.png", "id": "532541412542933", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036682_532541415876266_9014538991903330233_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UV1yZRKRRB0Q7kNvwGFzAId&_nc_oc=AdoLpc32DKiTfcgwLGy8TztDEaY904aekLW5oIUUhq3Z1djI8EOyaEimGhortnnigeU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lJIdFuWo0OaLzQvQHQWbTyOcXNzd-_ZYB60k8IzAR7g&oe=69FDE610"}, "display_name": "Chess VR", "keywords": ["chess"], "long_description": "Brave chess players, unsheathe your sword and commence a medieval duel on the chessboard!\nImmerse yourself in the medieval castle or the pixel-style arena to achieve multi-scene travel.Try to interact with pieces and personages, something interesting might occur. Of course, you can challenge our knights and heroes, the iron throne awaits the conqueror!\n\nFunction Update\n1. Hand Tracking\n2. Avatar & Voice Chat\n\n Core Features\n- 8 AI levels \n- Online mode: Friend Room; Playing with mobile or vr opponents\n- 4 scenes: Medieval Castle & Pixel-style & Space & Japanese-style room\n- Review and analysis of chess moves\n- 1000+ puzzles \n- Fight animations and sound FX\n- Both Hand tracking and Touch controllers are supported!\n\nWe will constantly optimize and update to bring you a better experience. Avatars, voice IP are on the way. Feel free to leave feedback in comments.", "short_description": "Brave chess players, unsheathe your sword and commence a medieval duel on the chessboard!\n\nFunction Update\n1. Hand Tracking\n2. Avatar & Voice Chat\n\n Core Features\n- 8 AI levels \n- Online mode: Friend Room; Playing with mobile or vr opponents\n- 4 scenes: Medieval Castle & Pixel-style & Space & Japanese-style room\n- Review and analysis of chess moves\n- 1000+ puzzles \n- Fight animations and sound FX\n- Both Hand tracking and Touch controllers are supported!"}]}, "developer_name": "Mastery VR", "developer_privacy_policy_url": "https://masteryvrstudio.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Mastery VR", "support_website_url": null, "website_url": "https://masteryvrstudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITT
g", "id": "460014655667310", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974751_460014659000643_1895291394585281199_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=iiq50YHL6EsQ7kNvwEq6vEh&_nc_oc=AdkoPG_dxhgGLwksjHyxPlJtYidUPwV59ao0VZ0GAX0NK99tR9vVGlfMs9loFVjpQQc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzvahdBrL8wevDuOiIj0keusWeUlVd4LUOgfI888j4K9Q&oe=69B5487D"}, {"file_name": "1.png", "id": "690235401966661", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974844_690235408633327_4694687908405151518_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uP23BL33tAQ7kNvwG48j0x&_nc_oc=Adn9_Lt2GoRTusrYdcyY3IWgqqtRgWIprIwHZwYiagTNHVp566peuS3ibwwrb7Ixh00&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw__sVJWFrJVq5yFQUsBAN9gh9cJijdFWr7RY8CyxR_QQ&oe=69B54321"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "650205073081398", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75322599_650205076414731_7889925823714149704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnzoalvOAXkQ7kNvwFk4jNH&_nc_oc=Adm3s-G1892xk9mlSflxGeKznBPB9VQ4pGqSSJ6jidhwyuavSx8blXzC6bkvCxowhfM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzaZNDzVUS8s412Phbz1hQIrz9MyraeFUm99LzXYcP_Tw&oe=69B56EE0"}, "display_name": "Chess VR", "keywords": [], "long_description": "Sit in front of the computer and play chess? Click on the phone screen? You're out of date!\n\nAlthough sitting on the sofa or lie in bed at home, you can still feel the ice-cold air in the medieval castle. Dressed in armour and armed with a sword, having a hearty game with your friends! Of course, you can also challenge our knights and heroes, conquer them with your wisdom to reach the top of your Iron Throne!\n\nFeatures:\n-5 AI difficulty levels\n-Challenge the endgame and make the difference\n-Play against the Knight in a medieval castle\n-Detailed chess move hint, novice friendly\n-Retro UI design\n-Undo function, no fear of mistakes\n-Great controller experience!\n\nWith frequent updates. the traditional chess experience as well as new features in conjunction with Quest2 will be provided.\n\nIncluding richer scenes, chess with friends, tournaments, real-time voice chat, fast chess and super fast chess, review analysis, chess timer, chess online, avatars, etc.\n\nDownload it now!", "short_description": "Play chess with computer or your phone? You're out of date!\n\nAlthough sitting on the sofa or lie in bed, you can still feel the ice-cold air in the medieval castle. Equipped with armour and sword , having a hearty game with friends! Conquering Knights stepwisely with your wisdom to reach the top of your Iron Throne!\n\nFeatures:\n-5 AI difficulty levels\n-Challenge the endgame\n-Immersive medieval castle\n-Move hint & Repentance, novice friendly\n-Great controller experience!\n\nDownload it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://chessvrgame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SUPLIFE PTE", "support_website_url": "https://chessvrgame.com/contact", "website_url": "https://chessvrgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "515297899952549"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status":
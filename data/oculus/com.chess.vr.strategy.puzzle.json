7&_nc_sid=6e7a0a&_nc_ohc=tp8P8m1SPTkQ7kNvwHLKx8l&_nc_oc=AdqSDKFRBb8G6BcMFtC11By7OvRzCap24PG6CHsujFmWiL_VmbtDcBaaGelloMeQikQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XkT8tnarc97l35EtS09SQjio05lQfUE4_3J6P_RfkXA&oe=6A10551B"}, {"file_name": "screenShot_2022-08-16_17-32-39.png", "id": "754788192478332", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974672_754788195811665_1965013380078461039_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLgUFkZPChgQ7kNvwH3u4Fr&_nc_oc=Adql-lJfpe4_7Q8Q3SD44EKjAH4kFK_VvYwT_PshE9z5-hXB3QaqBmgZ9pbjoMzfM9o&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47R8qe6_n3CFo2xIrdPMYuZjvShdEaqixLYowOaMxY1A&oe=6A10708F"}, {"file_name": "11.png", "id": "357281973019318", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982469_357281976352651_8546329914532511041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07PtsxllGzIQ7kNvwGsvvo3&_nc_oc=AdrHGrmw4V__z71IuuRZM1nOSnfQjMLR-XbzIFb5P4Wm3bbQeX-NgU6tAjKe4Vz-cwg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af582onONkVsU5tyr0rk1e2w3oRsP1uq8apBDboXRJOAzQ&oe=6A1078EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75658018_1127523848176206_3694338244670832203_n.png", "id": "532541412542933", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39036682_532541415876266_9014538991903330233_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFvO8VVoKCUQ7kNvwGSLkyv&_nc_oc=AdpM_FgMXTbTYd96O1g2cU-G-hPP3pw7JuscIPuhX4RjE5flAn1OJ0OFVl1ccsVP5so&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l-rQBkR2Rh-dAqbvQkgkenns_Y3lDfpn-OgKzFN7jFA&oe=6A105B10"}, "display_name": "Chess VR", "keywords": ["chess"], "long_description": "Brave chess players, unsheathe your sword and commence a medieval duel on the chessboard!\nImmerse yourself in the medieval castle or the pixel-style arena to achieve multi-scene travel.Try to interact with pieces and personages, something interesting might occur. Of course, you can challenge our knights and heroes, the iron throne awaits the conqueror!\n\nFunction Update\n1. Hand Tracking\n2. Avatar & Voice Chat\n\n Core Features\n- 8 AI levels \n- Online mode: Friend Room; Playing with mobile or vr opponents\n- 4 scenes: Medieval Castle & Pixel-style & Space & Japanese-style room\n- Review and analysis of chess moves\n- 1000+ puzzles \n- Fight animations and sound FX\n- Both Hand tracking and Touch controllers are supported!\n\nWe will constantly optimize and update to bring you a better experience. Avatars, voice IP are on the way. Feel free to leave feedback in comments.", "short_description": "Brave chess players, unsheathe your sword and commence a medieval duel on the chessboard!\n\nFunction Update\n1. Hand Tracking\n2. Avatar & Voice Chat\n\n Core Features\n- 8 AI levels \n- Online mode: Friend Room; Playing with mobile or vr opponents\n- 4 scenes: Medieval Castle & Pixel-style & Space & Japanese-style room\n- Review and analysis of chess moves\n- 1000+ puzzles \n- Fight animations and sound FX\n- Both Hand tracking and Touch controllers are supported!"}]}, "developer_name": "Mastery VR", "developer_privacy_policy_url": "https://masteryvrstudio.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Mastery VR", "support_website_url": null, "website_url": "https://masteryvrstudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITT
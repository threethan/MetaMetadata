7&_nc_sid=6e7a0a&_nc_ohc=sD2HqgeLnLEQ7kNvwH1i1_K&_nc_oc=Adov1ZTIvpj2DuW9H-DKn4GG_Ds0QUFFRCyfSsFI8kIy61QxHtZvCoR2tLyDjZcn0AQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW9lLtCJTwyXyWS6VvOO4Z7GCnW5Ge0wZbL0sh3kX55A&oe=6A7F131B"}, {"file_name": "screenShot_2022-08-16_17-32-39.png", "id": "754788192478332", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_754788195811665_1965013380078461039_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arDt1DhZbSwQ7kNvwHEDdEO&_nc_oc=AdpA_EHjeJpkVWjchC8WHHxoL35MSxq74GkxhUNRKyz_AkzuXn3-Lt3FoEvYKsQyXBk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7ahB51bIGt9YKPN42ls6mH-cuzPAW8MF2awSxt0_vqw&oe=6A7EF64F"}, {"file_name": "11.png", "id": "357281973019318", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982469_357281976352651_8546329914532511041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3tJd7z_Kb0Q7kNvwEA7zRV&_nc_oc=AdoJFG7V5FtyGx5rwVRj6vp3Z9KupzPOToOBB2jLfC7EgwmFLqWFz56qwO_rCpbXoek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2YiHm1_3MApzT119R1c_0B6VMkIow45K7QDR-7Zn0Ww&oe=6A7EFEAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75658018_1127523848176206_3694338244670832203_n.png", "id": "532541412542933", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036682_532541415876266_9014538991903330233_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiDSrJXPnZMQ7kNvwGgPqAS&_nc_oc=AdoJtKv-TI9pMPVR0QOWiWPZETHgGbb9GCKY5kbrMevgdwgT_JZYcA4WlE9mYrIArQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMNlJGNLgtbsSDnLLKT2PCy_YCvJlltmQx8iP0ZBvT-A&oe=6A7F1910"}, "display_name": "Chess VR", "keywords": ["chess"], "long_description": "Brave chess players, unsheathe your sword and commence a medieval duel on the chessboard!\nImmerse yourself in the medieval castle or the pixel-style arena to achieve multi-scene travel.Try to interact with pieces and personages, something interesting might occur. Of course, you can challenge our knights and heroes, the iron throne awaits the conqueror!\n\nFunction Update\n1. Hand Tracking\n2. Avatar & Voice Chat\n\n Core Features\n- 8 AI levels \n- Online mode: Friend Room; Playing with mobile or vr opponents\n- 4 scenes: Medieval Castle & Pixel-style & Space & Japanese-style room\n- Review and analysis of chess moves\n- 1000+ puzzles \n- Fight animations and sound FX\n- Both Hand tracking and Touch controllers are supported!\n\nWe will constantly optimize and update to bring you a better experience. Avatars, voice IP are on the way. Feel free to leave feedback in comments.", "short_description": "Brave chess players, unsheathe your sword and commence a medieval duel on the chessboard!\n\nFunction Update\n1. Hand Tracking\n2. Avatar & Voice Chat\n\n Core Features\n- 8 AI levels \n- Online mode: Friend Room; Playing with mobile or vr opponents\n- 4 scenes: Medieval Castle & Pixel-style & Space & Japanese-style room\n- Review and analysis of chess moves\n- 1000+ puzzles \n- Fight animations and sound FX\n- Both Hand tracking and Touch controllers are supported!"}]}, "developer_name": "Mastery VR", "developer_privacy_policy_url": "https://masteryvrstudio.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Mastery VR", "support_website_url": null, "website_url": "https://masteryvrstudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITT
uluscdn.com/v/t64.5771-25/12504564_610242305815244_1095839284_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZtscItttgEQ7kNvwHrrwu3&_nc_oc=AdoreVzO2qQszXLvIePkABAB82Ql5-vxDWq2H2w16f5d3Ku6xv9kjHA4IKbHZuDFwFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpP8JsVVyij-jasQlQvp81Larw96vfOpaBphUAbZsIzA&oe=6B06FBAF"}, {"file_name": "migrated_image.png", "id": "200731254543910", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410197_827988217334297_882990334_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1FoyjXCTO0Q7kNvwH0va3z&_nc_oc=AdqEjrEOR3rV-7dgYXsVu3G0Ip53BdcFc_ocipzaPP1pQvPBWAj5yS5Fo3gwULFfB5Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiGye5e8HCrq7C3c3EXqvTIDdVKX3lRd1X0YhWdjwuMA&oe=6B0716DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hypercade", "keywords": ["Classic", "Aracade", "Action"], "long_description": "Hypercade brings a modern spin to nostalgic arcade action in VR, with simple to use controls paired with classic arcade challenge.  Play four incredible arcade classics completely hands free or with a controller.  Brought to you by acclaimed VR game developer Hidden Path Entertainment, Hypercade includes four arcade games, each with its own unique take on fan favorites of yesteryear.    \n\nDodge dive-bombing aliens in Space Swarm, a classic vertical shooter featuring waves of unique enemy flight formations and challenging special bonus stages.  Evade the onslaught of multi-legged creatures in Crazy Critters, but beware - shoot them in the middle and they'll divide in half!  Save humanity from homicidal robots in Robo Rush, a classic twin-stick shooter featuring a unique hands-free mode.\n", "short_description": "Hypercade brings a modern spin to nostalgic arcade action in VR, with simple to use controls paired with classic arcade challenge.\n\nPlay four incredible arcade classics completely hands free or with a controller.  Brought to you by acclaimed VR game developer Hidden Path Entertainment, Hypercade includes four arcade games, each with its own unique take on fan favorites of yesteryear."}]}, "developer_name": null, "developer_privacy_policy_url": "http://hiddenpath.com/privacy-policy/", "developer_terms_of_service_url": "http://www.hiddenpath.com/terms-of-use/", "publisher_name": "Hidden Path Entertainment", "support_website_url": null, "website_url": "http://www.hiddenpath.com/game/hypercade/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "349783686785193"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12680395_1395685570448605_1490191465_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qarh9s6J2MgQ7kNvwGlwISw&_nc_oc=AdpftuBxD3AC2NZ7jXrXUY8FQudmEfOvdTlrWspsopmfP48qEyI9dez-krpXjd1RM-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtwekhVHu4o8Ob4GnceRz7aLDUOdkXZPCdwrJi-at0TQ&oe=6B070D2A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hypercade", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1472626800, "lastRevision": {"nodes": [{"id": "1303271159745920", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1010026535719776", "is_first_party": fals
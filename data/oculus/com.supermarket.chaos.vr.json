ttps://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307470_1944777296181395_6653226495953761528_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVTaciy58uoQ7kNvwFXf72U&_nc_oc=AdpmtSCEGgXLc8ITjwhdlv_mDy0zwsLcFyhjRdQrobDSlbw8zMATxXyBky59g5gq8pM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2k4BYhY0cMxwOLtiVBFdP4jkkAMLgAXjg7g60xjFVfw&oe=6AE8B29D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shop & Store: Supermarket", "keywords": ["supermarket", "simulator", "store", "shopping", "cashier"], "long_description": "Welcome to **Shop & Store: Supermarket Simulator**, a hands-on VR supermarket and retail management experience where you take control of your very own store.\n\nStart with a small shop and build it into a successful supermarket. Order products, unpack deliveries, stock shelves, organize your store, serve customers, operate the checkout and keep your growing business running smoothly.\n\n**RUN YOUR OWN SUPERMARKET**\n\nExperience life as a shopkeeper and store manager. Keep shelves stocked, organize products and make sure customers find what they need.\n\n**BECOME THE CASHIER**\n\nStep behind the checkout counter, scan products, handle customer purchases and keep the line moving during busy shopping hours.\n\n**MANAGE YOUR STORE**\n\nWatch your inventory, restock products and manage the daily tasks of running a supermarket. Good management means happier customers and a more successful shop.\n\n**GROW YOUR BUSINESS**\n\nEarn money through sales and use your profits to improve your store. Progress from a simple shop toward the supermarket business you want to build.\n\n**HANDS-ON VR GAMEPLAY**\n\nGrab products, arrange shelves and interact directly with your supermarket through immersive VR controls.\n\nIf you enjoy supermarket simulators, grocery store games, shop management, cashier games, retail simulators, job simulators and business management games, **Shop & Store: Supermarket Simulator** puts the store in your hands.\n\nStock. Sell. Manage. Expand.\n\nCan you build the ultimate supermarket?\n", "short_description": "Run your own supermarket in VR! Stock shelves, serve customers, work the checkout, manage inventory, earn money, upgrade your shop, and grow a small store into a busy retail business.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373026942566341"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313069_1109714558228507_8066390417845951609_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sEPUeq04AQQ7kNvwGvB2zy&_nc_oc=AdofiyInQyPK_2yf7zG6kgnH2ja8mNvWDNfrUECoFxNm1-9fatW7L3JTy40BFGrOQaI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7hHHBzlK_J1wyYmaB0-570L-8-z-s-aj6g9WSlstf4g&oe=6AE8B7FB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shop & Store: Supermarket", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 178438
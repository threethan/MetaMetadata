XZLOdOLWzoTUBm2OrWpK3nJi-XV4SngLuXmnyFCJyirquRTrVWPmaQm79Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKdbjf3KYqX3kwBBOKzxiiuY9YIiYl3e5ot_ePb5F5hg&oe=6AE8A01E"}, {"file_name": "2.png", "id": "1056336290152839", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499312332_1056336293486172_4066013923603281249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mbvsrt5OYaAQ7kNvwHuUHqs&_nc_oc=AdoQC_WzQ6KHvuv-S9ZYOA95oz0UC9MZXGJkLaDfXMTN-1Uylcz_BBx7vqMUcG9-xdg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0j9g7r7i1zn2Ugtk71hGmsGKkBugh07AOjVZ6yR_fOQ&oe=6AE895FE"}, {"file_name": "5.png", "id": "1944777292848062", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307470_1944777296181395_6653226495953761528_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVTaciy58uoQ7kNvwFXf72U&_nc_oc=AdpmtSCEGgXLc8ITjwhdlv_mDy0zwsLcFyhjRdQrobDSlbw8zMATxXyBky59g5gq8pM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2k4BYhY0cMxwOLtiVBFdP4jkkAMLgAXjg7g60xjFVfw&oe=6AE8B29D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supermarket Chaos VR", "keywords": ["supermarket", "simulator", "store", "shop", "funny"], "long_description": "Welcome to the most chaotic supermarket in virtual reality.\nIn Supermarket Chaos VR, you're not just managing a store \u2014 you're living it. Physically grab products and hurl them onto shelves, scan items at the register, count out change by hand, and pry open delivery crates with your own fingers. Every action is hands-on, every shift is unpredictable, and every customer is a new problem waiting to happen.\nRun your store your way\nStart small and grow your supermarket into a retail empire. Set your own prices, design your store layout, customize your space, and expand into new sections as your business takes off.\nThe customers won't make it easy\nNPCs shop, complain, and cause trouble \u2014 and some of them will straight-up steal from you. Spot the shoplifters before they walk out the door, or watch your profits disappear.\nYou can't do it alone\nHire staff to keep operations running smoothly. Manage your team, delegate tasks, and build the crew that keeps your supermarket from falling apart.\nVR the way it should be\nNo button menus for stocking shelves. No floating UI for checkout. Everything in Supermarket Chaos VR is physical \u2014 grab it, scan it, throw it, hand it over. Your hands do the work.\nKey features\n\nPhysical shelf stocking with hand grab\nHands-on cashier system \u2014 scan items and give change by hand\nShoplifter detection and theft mechanic\nStaff hiring and management\nStore expansion and upgrades\nPricing strategy and inventory management\nFull store customization and layout control", "short_description": "Run your own supermarket in VR \u2014 stock shelves, catch thieves, manage staff, and survive the chaos. All with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1216343311568039"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1381872754145584"}, {"status": "PUBLISHED", "id": "1362797989277621
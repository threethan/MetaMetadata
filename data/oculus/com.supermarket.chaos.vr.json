5/499311585_1030754026527986_6437593979503653409_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AU0gW_ILGGwQ7kNvwFQXQGf&_nc_oc=AdoKLVGB3nM-yOfly_neyaKP0jQIC0P5duk7sD-uAuHmmDjkOEAgezIY8-AMGedSEI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_ChVTycOXdAh7kKGtzOEPgx40axhtH8UnRvGFCBOhsA&oe=6A8C104E"}, {"file_name": "Cover_Landscape.png", "id": "1016550194507119", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1016550197840452_3818530746442656339_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZLu4tG2SfUQ7kNvwFIxCYi&_nc_oc=Ado-FeN9ihp48tOAaOWrofScRjjloGfWAC5bgEFCnLHjGtvBgl5auvtGLpxZ-t0Vhi0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOnCMOeHRSPiyR-Mvc-qwZpgElCpunxSKhBgRctOhBzQ&oe=6A8C16DD"}]}, "id": "4560348467582686", "locale": "en_US", "screenshots": [{"file_name": "4.png", "id": "1391716609683110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1391716613016443_6286850460759222267_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nh4yfTqHgcQ7kNvwEseRBJ&_nc_oc=AdqrRrfgXS3Bg9dcLdvhi0xSHA-h4Gtfcm0oH9IA0dsJBf5JkEtmZ6D3XR2wFbDm6RA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-wdPIMAhf0xEhYsa9oSqeEUipJW7rqrLBM09Zo5VgsA&oe=6A8C1C6A"}, {"file_name": "1.png", "id": "1963151857770906", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312332_1963151861104239_7562932622535608589_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2R1e6q9MvwQ7kNvwGc0I9O&_nc_oc=AdrlsSun36waWKR8zzFwnoOurFEb1m3JYA-yHzVvBTXsFMy8pHUR_eT_hBUKLM6HoaE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7nUyBooHoAEXPTC8MQz16-Y2Hs3X8Nf3TXkGm05myQg&oe=6A8C4498"}, {"file_name": "3.png", "id": "2224247151448190", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307962_2224247154781523_1017062518219415978_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT0JTFUMCrAQ7kNvwEliMfl&_nc_oc=AdqDwiDb5P1peDw7fQ2iCVquBKNtxvYImqxHlIaEswpZlxZYDzwgNM4C2tXfHxkgwgY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXKHHtFKK3RedN-zzZSBDtaJLmyFLRa-_7LKKyPahlTg&oe=6A8C1EDE"}, {"file_name": "2.png", "id": "1056336290152839", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312332_1056336293486172_4066013923603281249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KU9yi0pCVFkQ7kNvwEuuovK&_nc_oc=Ado2SwE4jydHAupX87y92b1bMUUrEs0w_As221dfqNXrI_YrU37OwJca8MipSz_lgxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLeBzvfTd0mjdB0jZAi8o1vMvuk7Db6T-XHwkoGxL7og&oe=6A8C14BE"}, {"file_name": "5.png", "id": "1944777292848062", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307470_1944777296181395_6653226495953761528_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qobhP7lgiK8Q7kNvwG332ZL&_nc_oc=AdpXKqVSgT642UoSiYgpVTvj9cUk9TLCm44e-gdXLWaxiTup_sJH4o6PDXMDZeQ6-Bs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIc0zOokPRS9dC8ijZJL5-BlW3XBWiWnIViZpszxbJeA&oe=6A8C315D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supermarket Chaos VR", "keywords": ["supermarket", "simulator", "store", "shop", "funny"], "long_description": "Welcome to the most chaotic supermarket in virtual reality.\nIn Supermarket Chaos VR, you're not just managing a store \u2014 you're living it. Physically grab products and hurl them onto shelves, scan items at the register, count out change by hand, and pry open delivery crates with your own fingers. Every action is hands-on, every shift is unpredictable, and every customer is a new problem waiting to happen.\nRun your store your way\nStart small and grow your supermarket into a retail empire. Set your own prices, design your store layout, customize your space, and expand into new sections as your business takes off.\nThe customers won't make it easy\nNPCs shop, complain, and cause trouble \u2014 and some of them will straight-up steal from you. Spot the shoplifters before they walk out the door, or watch your profits disappear.\nYou can't do it alone\nHire staff to keep operations running smoothly. Manage your team, delegate tasks, and build the crew that keeps your supermarket from falling apart.\nVR the way it should be\nNo button menus for stocking shelves. No floating UI for checkout. Everything in Supermarket Chaos VR is physical \u2014 grab it, scan it, throw it, hand it over. Your hands do the work.\nKey features\n\nPhysical shelf stocking with hand grab\nHands-on cashier system \u2014 scan items and give change by hand\nShoplifter detection and theft mechanic\nStaff hiring and management\nStore expansion and upgrades\nPricing strategy and inventory management\nFull store customization and layout control", "short_description": "Run your own supermarket in VR \u2014 stock shelves, catch thieves, manage staff, and survive the chaos. All with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1246246231911080"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1453069513250375_7578795220211693151_n.png?st
, "id": "1581962226043922", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035448_1581962239377254_3007149884306043668_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGSabvpndHkQ7kNvwESwjOV&_nc_oc=Adot88mIw4yB1AByAL-8PRBJ5OLEZ5mNZEQjpe-UjdhyAF-mg8e_aNyv_QScVwibrmM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvpSkjWdnvJOr0XbDO3qEHCy1OSfXXneOh6NT-KpPcvA&oe=6A8EDFAD"}, "display_name": "SPACE TROUBLES", "keywords": ["shooter", "action", "space", "trouble", "drone"], "long_description": "Chase each other in a spaceship in 1-on-1 matches or up to 10 players on the map.\n\nAs a soldier (in VR), you'll meet other soldiers, as well as drone pilots playing from their Android mobile phones.\n\nThis is a free Alpha version currently under development. We'd love to hear your feedback! Join our Discord community: https://discord.gg/DHGGk2fc5j\n\nAlso available for free on Android smartphones.\n\nRoadmap :\n- Additional maps\n- More game modes (Team Deathmatch, King of the Hill, etc.)\n- New weapons\n- Expanded characters and drones\n", "short_description": "Chase each other in a spaceship in 1-on-1 matches or up to 10 players on the map.\n\nAs a soldier (in VR), you'll meet other soldiers, as well as drone pilots playing from their Android mobile phones.\n\nThis is a free Alpha version currently under development. We'd love to hear your feedback! Join our Discord community: https://discord.gg/DHGGk2fc5j\n\nAlso available for free on Android smartphones.\n"}]}, "developer_name": "G2G VR GAMES", "developer_privacy_policy_url": "https://www.facebook.com/photo/?fbid=534733362658093&set=pcb.534733762658053", "developer_terms_of_service_url": null, "publisher_name": "G2G VR GAMES", "support_website_url": null, "website_url": "https://www.facebook.com/GamerToGamer", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
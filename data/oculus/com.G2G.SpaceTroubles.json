id=6e7a0a&_nc_ohc=shGswpj4qQ8Q7kNvwHFN_dk&_nc_oc=AdkEZuv3a00K6mukyE1wliVehbWHotYsc3NqmbplG-wa5ouJxipbEh-Z8umZRdmbdJU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu3b5ljAqqf8_yhB5wJ0YD-_q1Fd3X-rdo1Nx1O99THXA&oe=69A6D7AD"}, "display_name": "SPACE TROUBLES", "keywords": ["shooter", "action", "space", "trouble", "drone"], "long_description": "Chase each other in a spaceship in 1-on-1 matches or up to 10 players on the map.\n\nAs a soldier (in VR), you'll meet other soldiers, as well as drone pilots playing from their Android mobile phones.\n\nThis is a free Alpha version currently under development. We'd love to hear your feedback! Join our Discord community: https://discord.gg/DHGGk2fc5j\n\nAlso available for free on Android smartphones.\n\nRoadmap :\n- Additional maps\n- More game modes (Team Deathmatch, King of the Hill, etc.)\n- New weapons\n- Expanded characters and drones\n", "short_description": "Chase each other in a spaceship in 1-on-1 matches or up to 10 players on the map.\n\nAs a soldier (in VR), you'll meet other soldiers, as well as drone pilots playing from their Android mobile phones.\n\nThis is a free Alpha version currently under development. We'd love to hear your feedback! Join our Discord community: https://discord.gg/DHGGk2fc5j\n\nAlso available for free on Android smartphones.\n"}]}, "developer_name": "G2G VR GAMES", "developer_privacy_policy_url": "https://www.facebook.com/photo/?fbid=534733362658093&set=pcb.534733762658053", "developer_terms_of_service_url": null, "publisher_name": "G2G VR GAMES", "support_website_url": null, "website_url": "https://www.facebook.com/GamerToGamer", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connecti
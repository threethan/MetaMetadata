qNeLl7KxXGvJiIsuqwXLN_wjcYslaphdd9SuzZA&oe=6A4131E5"}, {"file_name": "\u622a\u56fe28.png", "id": "1238922257909363", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618267_1238922261242696_8805472434839404368_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dc5Q8TDxqJUQ7kNvwG-_Qkp&_nc_oc=AdpuaJLDs5wV1JR0VHVxgPB3xoYvBcFDe3I5z8MmWCGAtbCddQDO5ygR1STJZrroetU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af938A6i6y4GJ2KbUxPk-hyNiCto0DXPvC5k2_pBfkVtXg&oe=6A41172C"}, {"file_name": "\u622a\u56fe011.png", "id": "1106796344541842", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499309337_1106796347875175_8618257856411180035_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OmxO_lxv8IQ7kNvwGnQGqy&_nc_oc=AdoZurX59dv9aDfYQr4dN679weBf7TsvoPIms2dXR_gsm8rZCKtamHmNGBDTOu_13TI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9q34zmVPw37xObj6A72Sr0BEl3f_whOAcPbdWpcHYHw&oe=6A411839"}, {"file_name": "\u622a\u56fe012.png", "id": "1740827523496153", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393687_1740827526829486_30513896042776523_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0gwJSr25T8Q7kNvwHGOqyJ&_nc_oc=AdoYqm6t4FC4JpU43tltpEL7BYD1uQLZBiyGjLIuhMA_7NeafOBlLJcWDY2LGfjLfu8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nlmk9vps_qL1KgN36Crc1QPkd5x_d5D9W4XL5xnPI1g&oe=6A41287F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dungeon Blocks", "keywords": ["fight", "blocks", "battle", "dungeon", "multiplayer"], "long_description": "\ud83d\udc7e**Enter a Spooky 4-floor Dungeon**\u2014\u2014packed with monsters, traps, secrets and surprises. Fight, explore, or just fool around with friends.\n\n\ud83e\udd1d**Play Solo or Co-op**: Play solo or with up to 3 friends in this **co-op sandbox dungenon crawler**. Every fight hits hard. Boss battles hit harder(Built-in voice supported)\n\n\ud83e\uddca**Fast, Tactical Combat**: Sword or bow? Dash or dodge? Combat is **fast,intense, and tactical**. Bosses evolve. Only **teamwork** and **smart planning** will keep you alive.\n\n\ud83c\udf84**Shape Your Playstyle**: Unlock your **talent tree** and **shape your playstyle**: smash or snipe. It's up to you. \n\n\ud83e\uddd9\u200d\u2640\ufe0f**Choose Your Hero Class**: Witch Hunter, Black Knight, Birdman...**More coming soon**\u2014\u2014and you help vote on the next avatar in the Discord.\n\n\ud83e\udde0**Explore and Discover**: Discover hidden rooms. Trigger traps. Loot hard. This dungeon **goes deeper than it looks**...\n\n", "short_description": "Enter a Spooky 4-floor Dungeon\u2014\u2014packed with monsters, traps, secrets and surprises. Fight, explore, or just fool around with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dungeonblock.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Joy Inventor", "support_website_url": null, "website_url": "http://dungeonblock.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "24606307042303653"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1020881323499500"}]}, "baseline_offer": {"id": "1020881323499500"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749180180, "status": "PUBLISHED", "id":
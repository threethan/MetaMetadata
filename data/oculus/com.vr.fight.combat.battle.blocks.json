m8P4AGi2ZjlN3T0umcVKdU8KQCZ3I7N2HorXAtQ&oe=6AF5CF65"}, {"file_name": "\u622a\u56fe28.png", "id": "1238922257909363", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618267_1238922261242696_8805472434839404368_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmBhANL6BB8Q7kNvwF3qjhm&_nc_oc=Ado_Sb5rsS3pSzmN0ft0LnoMnf_l1BMkYiyG8WUk15G4lkhLjQPkpZvRJbl5WfDETsg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5f8na0SDFb2SV-gOB0VQk-MtrLNyYDDuIC06wqQM7QA&oe=6AF5ECEC"}, {"file_name": "\u622a\u56fe011.png", "id": "1106796344541842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499309337_1106796347875175_8618257856411180035_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNXsvxtr7_kQ7kNvwEQdAia&_nc_oc=Adq92KIRlqlrXwqYFtB0vXMyIacDtY_MC6FBFJpcQakXe_duKytuBePr94KlOGhUifE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHwZVuTPo1muSnGqtxfDtiL-uuTbtFsIUQVQU0NXxUtQ&oe=6AF5EDF9"}, {"file_name": "\u622a\u56fe012.png", "id": "1740827523496153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393687_1740827526829486_30513896042776523_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TpvNu7UPpUQ7kNvwHCSbjL&_nc_oc=AdrTTIICPCxUS4USpFYZTFc0VwtV3VYaqIdtw166xXOw4qMQHKHUIGw1x-RqG3cjhzM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO94FMmQy6oGkfLTbNBns-Q2riaoUhnhwAHWG0gaY9CA&oe=6AF5C5FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dungeon Blocks", "keywords": ["fight", "blocks", "battle", "dungeon", "multiplayer"], "long_description": "\ud83d\udc7e**Enter a Spooky 4-floor Dungeon**\u2014\u2014packed with monsters, traps, secrets and surprises. Fight, explore, or just fool around with friends.\n\n\ud83e\udd1d**Play Solo or Co-op**: Play solo or with up to 3 friends in this **co-op sandbox dungenon crawler**. Every fight hits hard. Boss battles hit harder(Built-in voice supported)\n\n\ud83e\uddca**Fast, Tactical Combat**: Sword or bow? Dash or dodge? Combat is **fast,intense, and tactical**. Bosses evolve. Only **teamwork** and **smart planning** will keep you alive.\n\n\ud83c\udf84**Shape Your Playstyle**: Unlock your **talent tree** and **shape your playstyle**: smash or snipe. It's up to you. \n\n\ud83e\uddd9\u200d\u2640\ufe0f**Choose Your Hero Class**: Witch Hunter, Black Knight, Birdman...**More coming soon**\u2014\u2014and you help vote on the next avatar in the Discord.\n\n\ud83e\udde0**Explore and Discover**: Discover hidden rooms. Trigger traps. Loot hard. This dungeon **goes deeper than it looks**...\n\n", "short_description": "Enter a Spooky 4-floor Dungeon\u2014\u2014packed with monsters, traps, secrets and surprises. Fight, explore, or just fool around with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dungeonblock.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Joy Inventor", "support_website_url": null, "website_url": "http://dungeonblock.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "24606307042303653"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1020881323499500"}]}, "baseline_offer": {"id": "1020881323499500"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749180180, "status": "PUBLISHED", "id":
le_name": "01-grand-theatre.png", "id": "1155403083504553", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/772632092_1155403086837886_4287936282520908490_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adGsSWtYfgIQ7kNvwEZrHOI&_nc_oc=AdqIc_-6vJ8TilDOGwL8qLNaPzkbF_KzuSN1giiP_bpvZDaqeZdp9xwxeiSsi6xcjME&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6cRspj-5dTsf_S868MNyjS8k1rUsFs_YPLodHqHwwkA&oe=6AF7352D"}, {"file_name": "02-seat-map.png", "id": "1683446913126756", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654922264_1683446916460089_6506067360987478519_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4g43zzrQjCoQ7kNvwHgkCaK&_nc_oc=Adpg1zws7csd7QGlG8fKzZQnHZNf8pwbgwrT5Nto0bNMAp2b-M-Mrm49XNOxdZuLVVo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjpwa7HdgV2yvGMkJIAMdgRWG2wzgK5al5RUhgRPb40g&oe=6AF72557"}, {"file_name": "03-room-gallery.png", "id": "1895643318275799", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/804229564_1895643321609132_5732875117725595311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJCcIztLX9AQ7kNvwGw8_EV&_nc_oc=Adoxve-mSZ1Wy9HC6oS4YUPZhrTROPj2I0hVJ_OsyzCdlPw263sFiWnVgbE7Ovho688&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWaXgFlYa07rjGRs-aSFRreWbll7e5cpc6ENavbfPXmw&oe=6AF742A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grand Cinema Pro \u2013 Video Player", "keywords": ["cinema"], "long_description": "Watch your own videos, websites and your Windows desktop on a giant screen in 21 authored cinema rooms or a floating-screen void.\n\nLOCAL VIDEO: play flat, 3D, 180\u00b0 and 360\u00b0 videos from your headset or your home network (SMB/DLNA), with subtitles and automatic refresh-rate matching for smooth motion.\n\nWEB CINEMA: open YouTube or any website on the big screen, with a built-in pop-up blocker and the Quest keyboard.\n\nPC CONNECT (experimental): stream your Windows desktop and its audio over a USB cable or your local Wi-Fi at a steady 60 fps, with full 4:4:4 colour for sharp text. Requires the free Grand Cinema Pro app for Windows from the Microsoft Store. Pair once with a four-digit code; no account, no cloud and no tracking.\n\nMake it yours: pick any seat, adjust brightness and screen curvature, let room lights react to the picture, and turn on a music visualiser that reacts to sound.\n\nFilm clips: Spring and Sintel \u00a9 Blender Foundation | blender.org, licensed under CC BY.", "short_description": "Immersive cinema rooms for your movies, the web and your PC desktop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://grand-cinema-pro-privacy.luckyfinch21.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "Grand Cinema Pro", "support_website_url": null, "website_url": "https://apps.microsoft.com/detail/9N281PMBRKK7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412576725276909"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1492828446074908"}, {"status": "PUBLISHED", "id": "1451887083542120"}, {"status": "PUBLISHED", "id": "993142590519517"}]}, "baseline_offer": {"id": "1492828446074908"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794162600, "status": "PUBLISHED", "id": "1492828446074908"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1433031253231456", "version": "0.4.13"}, "id": "1165388672764161", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1433031253231456"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "\u2022 Fixed a crash when using dropdown menus on websites in Web Cinema.\r\n\u2022 New ENTER button and a wider address bar in Web Cinema.\r\n\u2022 Cleaner Web Cinema status text.", "created_date": 1794195544, "id": "1433031253231456", "version": "0.4.13", "version_code": 22, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1433031253231456"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Sharper, clearer stars in Tropical Beach Night 2.", "created_date": 1794171707, "id": "1432557159945532", "version": "0.4.11", "version_code": 20, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1433031253231456"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "25 rooms: home cinemas, big theatres, lounges and open-air beaches\r\nAny seat: choose from a real seat map, front row to balcony\r\nFree movement: walk or fly around the room with the left stick\r\nMusical Beats: place visualizers anywhere in the room and they react to your movie", "created_date": 1794158369, "id": "1432204616647453", "version": "0.4.10", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1433031253231456"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Version 0.4.8\r\n\r\nNew\r\n\u2022 3D & VR adjust: change 3D depth, fix eye alignment, watch any 3D movie in 2D, and tilt, rotate or zoom 180\u00b0/360\u00b0 VR videos. Settings are saved for each video.\r\n\u2022 3D and VR videos set themselves up automatically from the file's own information or its name (SBS, TB, 180, 360, VR180).\r\n\u2022 YouTube 360\u00b0 and VR180 videos: choose \"Open in YouTube VR\" for full immersive VR, or keep watching in Grand. When you come back, Grand returns to the same video and time.\r\n\u2022 More of your movie library plays offline: Blu-ray M2TS with lossless Dolby TrueHD 7.1, DTS-HD Master Audio, Dolby Digital 5.1, MPEG-1/2, Theora, FLV and 3D Blu-ray (MVC).\r\n\u2022 Dolby Vision profile 7 and 10 videos play in HDR10.\r\n\r\nImprovements\r\n\u2022 Looping short videos no longer freezes after seeking.\r\n\u2022 Videos with a cut-off last audio frame keep playing instead of stopping.\r\n\u2022 PC Files no longer appear in the Local Video recent list.\r\n\r\nLicences\r\n\u2022 Open-source credits are in Settings \u2192 Third-party licences, and the app includes the source code for its open-source media libraries.", "created_date": 1794057680, "id": "1428177313716850", "version": "0.4.8", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1433031253231456"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": null, "created_date": 1793955026, "id": "1425260420675206", "version": "0.4.5-autoplay-preview", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
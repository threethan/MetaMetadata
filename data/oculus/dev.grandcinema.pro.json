scdn.com/v/t64.5771-25/829188179_1877770226716279_7431652853327612262_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APVBjYjiIV0Q7kNvwG4pfS5&_nc_oc=AdopSoit_UL2hWe2r1MYAGSVfH1O6paM2O_JPCaOQDugtXDWC6cOTI46g6LlfnfyzwY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_eSfVD8eCALTyR7b7NYCPrHWx3hBZUh-PUJhN3E0olg&oe=6B08628F"}, {"file_name": "04-music-visualiser.png", "id": "1642452353952110", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/737543484_1642452357285443_1665494074810744958_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWF3LOlX1qsQ7kNvwGcRPjC&_nc_oc=AdoOpx7FLl-9ZSBNPBNNRxnuGtc6yFmw_wAP9DPdKND7s0O6N9Wz3Cb_YPrUYmaVNCo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7vKP4Eh6dYJUd0oBMqc2NwmtWCIQPGemwrjD4XdjSvw&oe=6B0842C3"}, {"file_name": "01-grand-theatre.png", "id": "1155403083504553", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/772632092_1155403086837886_4287936282520908490_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Em2Ud13TT0Q7kNvwEFQIbS&_nc_oc=Adow9_2-5RuMv7Gvkh56-DBCodT77EY0YFTMOHmNyp3SHe2wB-4o9vNDbJ1vn7QKj7o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSVsvn0xsy-DMQk8rSyGYUZVBLtAsD_6Z6zoh33bG5jw&oe=6B0858AD"}, {"file_name": "02-seat-map.png", "id": "1683446913126756", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/654922264_1683446916460089_6506067360987478519_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmSZdgcPLOMQ7kNvwFgolaO&_nc_oc=Adqcfj9dF2yDh1SXXtMUkDoK1SFUtkVMjU1PqrTzS8_ug51h2ekkQ1TrPEJ6OJQHYPY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxEVm4yegDxe00qSgB2VdVB6IAWmtvv19JHK-0kjTr9Q&oe=6B0848D7"}, {"file_name": "03-room-gallery.png", "id": "1895643318275799", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/804229564_1895643321609132_5732875117725595311_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7BUFnAJcz0Q7kNvwFx6Ymt&_nc_oc=AdqlGKnj77gnYIef0i84UeeZt-9YniIvOG8W2r-E3dbkfdFexuHDJkaoY-keI_ilfvs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdANnU849PCoaLkxWpL_LotK5rwGamy2MWReguwLIP7A&oe=6B086625"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grand Cinema Pro \u2013 Video Player", "keywords": ["cinema"], "long_description": "Watch your own videos, websites and your Windows desktop on a giant screen in 21 authored cinema rooms or a floating-screen void.\n\nLOCAL VIDEO: play flat, 3D, 180\u00b0 and 360\u00b0 videos from your headset or your home network (SMB/DLNA), with subtitles and automatic refresh-rate matching for smooth motion.\n\nWEB CINEMA: open YouTube or any website on the big screen, with a built-in pop-up blocker and the Quest keyboard.\n\nPC CONNECT (experimental): stream your Windows desktop and its audio over a USB cable or your local Wi-Fi at a steady 60 fps, with full 4:4:4 colour for sharp text. Requires the free Grand Cinema Pro app for Windows from the Microsoft Store. Pair once with a four-digit code; no account, no cloud and no tracking.\n\nMake it yours: pick any seat, adjust brightness and screen curvature, let room lights react to the picture, and turn on a music visualiser that reacts to sound.\n\nFilm clips: Spring and Sintel \u00a9 Blender Foundation | blender.org, licensed under CC BY.", "short_description": "Immersive cinema rooms for your movies, the web and your PC desktop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://grand-cinema-pro-privacy.luckyfinch21.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "Grand Cinema Pro", "support_website_url": null, "website_url": "https://apps.microsoft.com/detail/9N281PMBRKK7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412576725276909"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "CANCELLED", "id": "2265986353960207"}, {"status": "PENDING", "id": "2667398137112415"}, {"status": "PUBLISHED", "id": "1492828446074908"}, {"status": "PUBLISHED", "id": "1451887083542120"}, {"status": "PUBLISHED", "id": "993142590519517"}]}, "baseline_offer": {"id": "1492828446074908"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1799694000, "status": "CANCELLED", "id": "2265986353960207"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1477789895422258", "version": "0.4.37"}, "id": "1165388672764161", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1477789895422258"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Better external player for stream apps (Stremio Android, Nuvio and others):\r\n  - Continues where you stopped and reports your position back, so the app resumes and marks episodes watched.\r\n  - Subtitles sent by the app (add-on subtitles) and every embedded subtitle and audio language, switchable during playback; your preferred languages are remembered.\r\n  - Bigger buffer (up to 2 minutes) and faster multi-connection download for web/debrid links; clear error messages with automatic retry.", "created_date": 1795304872, "id": "1477789895422258", "version": "0.4.37", "version_code": 46, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1477789895422258"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "- Use Grand Cinema Pro as the external player in stream apps like Stremio and Nuvio: choose it when you play a video and it opens in the cinema.\r\n- Works with either controller: left-handed use, grip-move from either hand, arm-down button presses, trigger tap to play/pause, trigger drag to seek, thumbstick skip uses your skip setting.\r\n- Menu: opens where you placed it; double-tap Menu brings it in front; one-tap open/close also with hand tracking.\r\n- Rooms keep their direction when you switch; only Recenter turns them.\r\n- YouTube & Web Cinema: thumbstick seek and volume, A = play/pause, seek buttons work during ads, real-tap Skip ad, smoother seeking.\r\n- USB drives: NTFS (read-only), GPT/MBR, opens right after permission.\r\n- Network: up to 5,000 items with clear \"showing first N of M\", FTP passive/active, choose a start folder, sleeping NAS wake-up retry, folder names with spaces/symbols.\r\n- PC Connect: Forget this PC, Disconnect stays disconnected, no tab jumping.\r\n- Subtitles: automatic language encoding (Polish, Russian, Greek, Chinese, Japanese, Korean and more).\r\n- Fixes: green bar on some 1080p videos, YouTube VR return, file-access limit after many picks, free-space check before copies, custom 360\u00b0 photos keep their room, clearer error messages.", "created_date": 1795299232, "id": "1477687925432455", "version": "0.4.36", "version_code": 45, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1477789895422258"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "- Smoother, more reliable menus: the VR menu no longer freezes video or the menu button when opening/closing it or returning from Home.\r\n- Faster scrolling in Files and the Room Gallery.\r\n- More stable sessions: the VR view recovers by itself after an unexpected error, and the app frees memory when the headset runs low.\r\n- Faster saving of watch positions for large libraries.\r\n- Many small stability and memory fixes.", "created_date": 1795272481, "id": "1476004158934165", "version": "0.4.34", "version_code": 43, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1477789895422258"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Upgraded Horizon OS hand tracking and automatic hand/controller switching: exclusive device lock while holding Touch controllers, instant switch when picking up controllers, clean auto-hide during playback, no floating \"Open menu\" overlay on top of videos (left-hand pinch opens the menu), and higher tap-vs-swipe tolerance so hand taps reliably register as clicks.\r\nFull hand and controller support for placed room photos: add photos from inside VR without pausing YouTube, grab and tilt photos flat onto the floor or walls with either controllers or fingers, and pinch with two hands to resize.\r\nController and hand support for all 4 menu drag bars plus 4-corner curved resize handles and hover feedback.\r\nGPU-accelerated 72/90 Hz menu rendering for smooth scrolling in Room Gallery and Files, plus fixes for Web Cinema \u2192 Local Video switching, rapid Home \u2192 reopen lifecycle recovery, and focus-change stability.\r\nFaster, smoother DLNA and Cast Receiver video streaming with persistent HTTP range streaming, rolling read-ahead cache, and expanded Wi-Fi buffering.\r\nSofter default UI click audio with a Mute UI Clicks toggle, controller haptics, cleaner Local Video Player layout.", "created_date": 1795234726, "id": "1474686712399243", "version": "0.4.33", "version_code": 42, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1477789895422258"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "-Added ability to upload your own 360 degree photo to get unlimited environment vibes. Please give feedback directly from settings. \r\n Faster, smoother room switching: rooms prepare and load skies in the background while your video stays visible.\r\n- Smoother 4K HDR playback and lower GPU load, with reduced memory use in Underwater Reef and across long sessions.\r\n- Redesigned local video and YouTube playback controls with a wider seek bar, adjustable skip intervals, volume, and mute.\r\n- Prioritized on-screen thumbnails and smoother Room Gallery preview loading while scrolling.\r\n- Improved \"Open with Grand Cinema Pro\" and switching between Web Cinema and local playback, plus Rotate Picture for compatible DLNA video casts.\r\n- Added Penthouse Canyon, refreshed Skyline Penthouse Terrace, Aurora Cloud-Sea Summit, and Orbital Observation Lounge, and restored animated water and seabed lighting in Underwater Reef.\r\n- Expanded AVI compatibility, including older Xvid and Motion JPEG videos.", "created_date": 1795129148, "id": "1471878729346708", "version": "0.4.32", "version_code": 41, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
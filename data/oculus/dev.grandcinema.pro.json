853327612262_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85v09_q2ZqMQ7kNvwHWf_VC&_nc_oc=AdqV5XWJ1gqg4MNziHE1BcbFVN1BYPWjefbvrR0LU-V_ArmkMxcXp4LebyOCmLcSwws&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI4SJxcRuT2kXIgHCgnmGUaDniNh3McYOblau99eVDWg&oe=6AFDD68F"}, {"file_name": "04-music-visualiser.png", "id": "1642452353952110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/737543484_1642452357285443_1665494074810744958_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFBXobxYiMIQ7kNvwEPO4Xd&_nc_oc=AdpHf7x5sSnAFxYrr947-jXhUplw65R1MJjLM_pWcnpU5gkFT25F9jblJrLOIePqLqc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFhDD0MfPcrDk1PmZcAf29K4L_WOqfhXIXB-6bfR5wuA&oe=6AFDB6C3"}, {"file_name": "01-grand-theatre.png", "id": "1155403083504553", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/772632092_1155403086837886_4287936282520908490_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWUdaiCS1ZcQ7kNvwEYIIos&_nc_oc=AdoyUAdGoxPfxgqqjgNmvF2CeLxkQgnZU1tRD4Dx_-h0ifdgw2hvP9Qsuj51oQgPvOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSI1v4sn0Fb9IN-m3ucLf69m8y0k37UZ7nQeJ8kgANsQ&oe=6AFDCCAD"}, {"file_name": "02-seat-map.png", "id": "1683446913126756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654922264_1683446916460089_6506067360987478519_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n_ljsZSs5YQ7kNvwEuOLVW&_nc_oc=AdrGz1kl2PcP1R6fFnR8ZMbR-4YRHsbezVgkkygSQMl9lB6ZG9ZchcZv3tyuW7aNfwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhanLEXiwHw5se40LoXVvKYaFsZLGQ5qvlsfQYtxLWgg&oe=6AFDBCD7"}, {"file_name": "03-room-gallery.png", "id": "1895643318275799", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/804229564_1895643321609132_5732875117725595311_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUFN8opBOYAQ7kNvwGTs2Pq&_nc_oc=AdrUKuWK3NSegendCr6LqxrAqbrK-r3hLvtDhdzf2A2qRkQwh7jRQQSHQZhXeWfVPwA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe1gu8l6dhPtoPKI_UR4VfKU2AfR5aTMmTerynXmHgYA&oe=6AFDDA25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grand Cinema Pro \u2013 Video Player", "keywords": ["cinema"], "long_description": "Watch your own videos, websites and your Windows desktop on a giant screen in 21 authored cinema rooms or a floating-screen void.\n\nLOCAL VIDEO: play flat, 3D, 180\u00b0 and 360\u00b0 videos from your headset or your home network (SMB/DLNA), with subtitles and automatic refresh-rate matching for smooth motion.\n\nWEB CINEMA: open YouTube or any website on the big screen, with a built-in pop-up blocker and the Quest keyboard.\n\nPC CONNECT (experimental): stream your Windows desktop and its audio over a USB cable or your local Wi-Fi at a steady 60 fps, with full 4:4:4 colour for sharp text. Requires the free Grand Cinema Pro app for Windows from the Microsoft Store. Pair once with a four-digit code; no account, no cloud and no tracking.\n\nMake it yours: pick any seat, adjust brightness and screen curvature, let room lights react to the picture, and turn on a music visualiser that reacts to sound.\n\nFilm clips: Spring and Sintel \u00a9 Blender Foundation | blender.org, licensed under CC BY.", "short_description": "Immersive cinema rooms for your movies, the web and your PC desktop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://grand-cinema-pro-privacy.luckyfinch21.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "Grand Cinema Pro", "support_website_url": null, "website_url": "https://apps.microsoft.com/detail/9N281PMBRKK7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412576725276909"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1492828446074908"}, {"status": "PUBLISHED", "id": "1451887083542120"}, {"status": "PUBLISHED", "id": "993142590519517"}]}, "baseline_offer": {"id": "1492828446074908"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794162600, "status": "PUBLISHED", "id": "1492828446074908"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1451496104718304", "version": "0.4.21"}, "id": "1165388672764161", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1451496104718304"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "What\u2019s new (paste into the Store)\r\n\r\nNew Library\r\n\r\nA modern video library: large full-picture cards in Poster, Wide or List view.\r\nSee all your videos at once, with Resume, Folders and Favourites one tap away.\r\nA progress bar and \u201cminutes left\u201d on every film you have started.\r\n4K, HDR, Dolby Vision, 3D and VR badges.\r\nLive search: results appear as you type, from the first letters.\r\nA big \u201cAdd video folder\u201d button, plus Open file for single videos.\r\n\r\nSettings search\r\n\r\nFind any setting by typing: results appear with each letter and open the right page.\r\n\r\nAudio sync\r\n\r\nFix films whose sound is ahead of or behind the picture (Audio menu).\r\nThe setting is remembered for each video.\r\n\r\nWeb Cinema\r\n\r\nYouTube and Shorts now switch videos smoothly, without reloading the page.\r\nLive tabs: switching tabs keeps each page where you left it.\r\nFaster Back and Forward.\r\nA steadier display refresh rate, with no flicker.\r\nNew VR video mode for 180\u00b0 and 360\u00b0 videos on websites.\r\nA Go button and a keyboard button in the top bar.\r\nBetter support for websites with protected video.", "created_date": 1794614342, "id": "1451496104718304", "version": "0.4.21", "version_code": 30, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1451496104718304"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Fixed DLNA and Casting\r\nFixed fast youtube playback\r\nFixed incorrect Video orientation in casting.", "created_date": 1794524780, "id": "1447844638416784", "version": "0.4.19", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1451496104718304"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "New\r\n\r\nPhone videos recorded sideways or upside down now play upright.\r\nWeb Cinema: bookmark your favourite sites and change the text size.\r\nConnect to PC by address: if your PC isn\u2019t found automatically (mesh or guest Wi-Fi), type the address shown in the Windows app.\r\n\r\nImproved\r\n\r\nWidescreen DVD and other anamorphic videos now show at the correct shape.\r\nVideos are only treated as 180\u00b0/360\u00b0 when their file name and shape both say so.\r\nPC Connect no longer reconnects in a loop when the PC stops sending pictures. It holds the last picture and tells you why, with tips to fix it.\r\nLock screen and admin prompts on the PC now show a clear message instead of a black screen, and the picture comes back automatically.\r\nPCs whose graphics can\u2019t run Grand\u2019s sharp 4:4:4 stream can now still connect using the graphics card\u2019s own video encoder. Text is a little softer in this mode.\r\n\r\nUpdate the free Windows app to version 0.4.3 to get all PC Connect improvements.", "created_date": 1794433674, "id": "1443411768860071", "version": "0.4.18", "version_code": 27, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1451496104718304"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "- Includes Underwater Reef with animated fish and a drifting boat.\r\n- Restores free movement and teleport after closing the Meta keyboard.\r\n- Improves movie playback when changing picture settings and when the headset wakes.", "created_date": 1794304960, "id": "1437382626129652", "version": "0.4.17", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1451496104718304"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Added New Snow Room.\r\nOpen Environment have ability to increase screen size.", "created_date": 1794266324, "id": "1436392679561980", "version": "0.4.16", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
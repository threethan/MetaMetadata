le_name": "01-grand-theatre.png", "id": "1155403083504553", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/772632092_1155403086837886_4287936282520908490_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZaGaiWHLpgQ7kNvwHwit4m&_nc_oc=AdpmPglku6pWYheBFTxjnOhocJP1wHRtt8UOxr2ShHE3N1xavlKwNvLzbJKMnaTWo9Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa2M3Ch1YbxTcU8YEAhzdcvzHO_DZUUpCT7UShLHwGJw&oe=6AF886AD"}, {"file_name": "02-seat-map.png", "id": "1683446913126756", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654922264_1683446916460089_6506067360987478519_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4g43zzrQjCoQ7kNvwEANDW3&_nc_oc=AdrcJxdX92mNr7Yk_VAiFE5EU2nOvSblox8hzWo3chUoDAtCj2kijGjwEhcQC9g9fYs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ51fFPmcwTNCd3UEVh_uIltH3-KvFWo7acVZoVid-KQg&oe=6AF876D7"}, {"file_name": "03-room-gallery.png", "id": "1895643318275799", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/804229564_1895643321609132_5732875117725595311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=du24YTl_cn0Q7kNvwFCM7Hd&_nc_oc=AdqAN8HD9deM3__xaFtSXW8cGl8PlPNdIzh942WaYZ5NL3D7jh4SAB3dKNJJKrUV_V4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeatGnCbfHU40DxudmwIH_n4Np0i8s1wbHOe1KklXFZQ&oe=6AF89425"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grand Cinema Pro \u2013 Video Player", "keywords": ["cinema"], "long_description": "Watch your own videos, websites and your Windows desktop on a giant screen in 21 authored cinema rooms or a floating-screen void.\n\nLOCAL VIDEO: play flat, 3D, 180\u00b0 and 360\u00b0 videos from your headset or your home network (SMB/DLNA), with subtitles and automatic refresh-rate matching for smooth motion.\n\nWEB CINEMA: open YouTube or any website on the big screen, with a built-in pop-up blocker and the Quest keyboard.\n\nPC CONNECT (experimental): stream your Windows desktop and its audio over a USB cable or your local Wi-Fi at a steady 60 fps, with full 4:4:4 colour for sharp text. Requires the free Grand Cinema Pro app for Windows from the Microsoft Store. Pair once with a four-digit code; no account, no cloud and no tracking.\n\nMake it yours: pick any seat, adjust brightness and screen curvature, let room lights react to the picture, and turn on a music visualiser that reacts to sound.\n\nFilm clips: Spring and Sintel \u00a9 Blender Foundation | blender.org, licensed under CC BY.", "short_description": "Immersive cinema rooms for your movies, the web and your PC desktop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://grand-cinema-pro-privacy.luckyfinch21.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "Grand Cinema Pro", "support_website_url": null, "website_url": "https://apps.microsoft.com/detail/9N281PMBRKK7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412576725276909"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1492828446074908"}, {"status": "PUBLISHED", "id": "1451887083542120"}, {"status": "PUBLISHED", "id": "993142590519517"}]}, "baseline_offer": {"id": "1492828446074908"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794162600, "status": "PUBLISHED", "id": "1492828446074908"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
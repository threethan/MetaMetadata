14938655242_91024190543804638_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-R1X6IfseQQ7kNvwEf7FgD&_nc_oc=Adr8pSHTXBDn_lqsSb3XDx0IjST0Y9AB4-25iy-VGtn3LDao-KOv-z_ZOF5qwCy56hM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQDiZHZ7bUYTdtruM8u5XET_bFhjJ4Z4dsmxHNcosABdA&oe=6B0B267A"}, {"file_name": "05-blue-sea-beach.png", "id": "1476957720558702", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499628050_1476957723892035_4659682181593899840_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSN_r0pCjXoQ7kNvwH1zKDu&_nc_oc=AdqlZTgtITfpzp_RDpbDl5fDcvRBbVmh-MfZ4kbpY-ABp9J8RAV7HWH-mboRT02LOyo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSyq9nhaLvEnXhGwT8VQJ5VGxHsnlugbEAfO5ZVPpN5eQ&oe=6B0B39FA"}, {"file_name": "04-beach-under-the-stars.png", "id": "1442485504689193", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622153_1442485508022526_4864039256984028111_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjVl_G5lcbwQ7kNvwHrxInl&_nc_oc=AdrVpOUReABv82s8x73TWjZtCQwM0Yv-oFOGHWDGW-Y2XbvSWnCVgoUaKfrDDotjxD0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQ8FajrBJiTZl8yVig1VkeBFdKNxk-SYigCDfMpfZNZA&oe=6B0B46C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1111006955091460", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619369_1111006958424793_7171558952698630711_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cy3KbT2xhBAQ7kNvwF706jF&_nc_oc=Adp9b_N27e9gceILEtgScvvrYous9voc0isjSetARKRoaCmb_Nxx-3dpKOZZTWI24zg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS33S3fPLUZcfo2gfp6NbfeY-TeeUN4riV1QHji2QwNvw&oe=6B0B1B37"}, "display_name": "Grand Cinema Pro \u2013 Video Player", "keywords": ["videoplayer", "movieplayer", "360photo", "musicvisualizer", "theatreview"], "long_description": "# Grand Cinema Pro \u2014 Your Personal VR Cinema\n\nTransform your Meta Quest into a private cinema with giant screens, immersive environments, customizable rooms, 360\u00b0 media, music visualizers, and wireless streaming.\n\n**Large IMMERSIVE ENVIRONMENTS**\n\nEnjoy traditional theaters, a Snow Cabin, Underwater Reef, moonlit beach, and more. Choose your seat, adjust screen size, curvature, and brightness, or enjoy a floating screen.\n\n**PERSONALIZE YOUR CINEMA**\n\nPlace your own photos anywhere in the room. Move, resize, and rotate images, including transparent PNG decorations, to create your perfect movie-night atmosphere.\n\n**VIDEO & 360\u00b0 PLAYBACK**\n\nWatch flat, 3D, 180\u00b0, and 360\u00b0 videos with subtitle support and automatic refresh-rate matching. View photos and explore immersive 360\u00b0 panoramas.\n\n**LOCAL PLAYBACK, STREAMING & CASTING**\n\nPlay videos and music from your Quest or stream from a PC or NAS using SMB and DLNA. Cast compatible media from your phone with available audio and subtitle selection.\n\n**AUDIO-REACTIVE MUSIC VISUALIZERS**\n\nEnjoy your music with colorful visual effects that react to the rhythm and bring your virtual surroundings to life.\n\n**WEB CINEMA & PC CONNECT**\n\nWatch YouTube and browse websites inside your cinema. Stream your Windows desktop and audio over Wi-Fi or USB using experimental PC Connect. Requires the free Grand Cinema Pro Windows companion app.\n\n**YOUR CINEMA. YOUR RULES.**\n\nWatch movies, listen to music, explore 360\u00b0 photos, or create a spooky horror room", "short_description": "Your private cinema on Quest. Watch movies, play music, browse photos, and turn a 360\u00b0 panorama into the room around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://grand-cinema-pro-privacy.luckyfinch21.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "Grand Cinema Pro", "support_website_url": null, "website_url": "https://apps.microsoft.com/detail/9N281PMBRKK7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1471902249344356"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823790_4788538061375236_4749988724480929124_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLrYsOmZMOcQ7kNvwGfHP8q&_nc_oc=AdorlIXLwg5NDLhi6uynMMyfQlWH5Z_l0ysgkhO-6pJmd0Nsu3DzPNfSvmLxZW3x7F8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRWbkFNAN8d_VNsWgIkgfnKottu7E2i2ac9vchSHCuErw&oe=6B0B37F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Grand Cinema Pro \u2013 Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1793825640, "lastRevision": {"nodes": [{"id": "1412576738610241", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1412576711943577", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1610191763752790"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "meta-cover-square-1440x1440.png", "id": 
scdn.com/v/t64.5771-25/829188179_1877770226716279_7431652853327612262_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KA-Vcl7yJLcQ7kNvwGGH9Ih&_nc_oc=AdrSWt_VyDI66FjbSjh_oDp8DRD3XAygtzN0919WAmvFvKKUzUu_76hCDAQGK9vZ4M0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSX_zOWd68h-EFpJif5ATfSLBsvWnT6zaCjhltqfuUG1g&oe=6B031C8F"}, {"file_name": "04-music-visualiser.png", "id": "1642452353952110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/737543484_1642452357285443_1665494074810744958_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtVrD4jyFjMQ7kNvwFHwH-a&_nc_oc=AdpsIQycuEh4GRVw2Ln3V410E1MEDcQWdXV4epWZ0U1pzNFydSs6Oy8z5uZsUns6cRM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcxdm8__QXclC2FTxplahUIHHAFYRgmrlhF0i8tpbaZA&oe=6B033503"}, {"file_name": "01-grand-theatre.png", "id": "1155403083504553", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/772632092_1155403086837886_4287936282520908490_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZAFhqe2664Q7kNvwFZLlUc&_nc_oc=Adqu6NuVteLSBPIFSJcIRpwfljORlrwF97EW8FHEh2hL5m46350dIJrU8L8WEezEHgI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKyCyBkNKtBE8VGsyqxHtstIzYX4jokMfxvPuhmFb4zw&oe=6B0312AD"}, {"file_name": "02-seat-map.png", "id": "1683446913126756", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/654922264_1683446916460089_6506067360987478519_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eR2RS68KwYQ7kNvwGazBpL&_nc_oc=AdoXyUkPOPAH8Wdu6LahkvJwbiw5dky-XTOPRHVUHjJE-LvUMW1Ux3Ycru5US589P30&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2u7yHr8Iekt-fu2BMXmAQYx6z2GbCPGRezNSwNAJ8ng&oe=6B0302D7"}, {"file_name": "03-room-gallery.png", "id": "1895643318275799", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/804229564_1895643321609132_5732875117725595311_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXiHQgxWnRkQ7kNvwFgDly1&_nc_oc=Adr7oQc6VU5g3S7pdJijzdoCU-VKmrgeUxyHMc8pejzR0JGd58ZavZEPLye3gMNSNRc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjfIhLpe8K-vSziuwbLrRzJbHis1UiP1_HmhkrFEd-pw&oe=6B032025"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grand Cinema Pro \u2013 Video Player", "keywords": ["cinema"], "long_description": "Watch your own videos, websites and your Windows desktop on a giant screen in 21 authored cinema rooms or a floating-screen void.\n\nLOCAL VIDEO: play flat, 3D, 180\u00b0 and 360\u00b0 videos from your headset or your home network (SMB/DLNA), with subtitles and automatic refresh-rate matching for smooth motion.\n\nWEB CINEMA: open YouTube or any website on the big screen, with a built-in pop-up blocker and the Quest keyboard.\n\nPC CONNECT (experimental): stream your Windows desktop and its audio over a USB cable or your local Wi-Fi at a steady 60 fps, with full 4:4:4 colour for sharp text. Requires the free Grand Cinema Pro app for Windows from the Microsoft Store. Pair once with a four-digit code; no account, no cloud and no tracking.\n\nMake it yours: pick any seat, adjust brightness and screen curvature, let room lights react to the picture, and turn on a music visualiser that reacts to sound.\n\nFilm clips: Spring and Sintel \u00a9 Blender Foundation | blender.org, licensed under CC BY.", "short_description": "Immersive cinema rooms for your movies, the web and your PC desktop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://grand-cinema-pro-privacy.luckyfinch21.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "Grand Cinema Pro", "support_website_url": null, "website_url": "https://apps.microsoft.com/detail/9N281PMBRKK7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412576725276909"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1492828446074908"}, {"status": "PUBLISHED", "id": "1451887083542120"}, {"status": "PUBLISHED", "id": "993142590519517"}]}, "baseline_offer": {"id": "1492828446074908"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794162600, "status": "PUBLISHED", "id": "1492828446074908"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1456929580841623", "version": "0.4.30"}, "id": "1165388672764161", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1456929580841623"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Photos and music in Files: view photos (including 360\u00b0 and 3D) and play songs from your Quest, PC, network shares and DLNA.\r\nAdd your own photos to any room: grab to move, stick to resize, twist to rotate. Transparent PNGs stand as cut-outs.\r\nSnow Cabin: falling snow outside and new windows on every side.\r\nCast from your phone: audio track and subtitle choices; photos and big 360\u00b0 photos can be cast too.\r\nPC Files: select many files or whole folders and copy them to your Quest.\r\nWeb Cinema: long-press a picture to save it. Safer, more reliable downloads.\r\nEasier Files: View, Sort and Show drop-down lists; \u201cOpen with\u201d works for photos and songs.\r\nFixes for Private Vault, Web VR, Live TV guides and DLNA.\r\n\r\nNow you can open photo and video and music with open with button. and directly play in Grand cinema pro.", "created_date": 1794764226, "id": "1456929580841623", "version": "0.4.30", "version_code": 39, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1456929580841623"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Photos and music in Files: view photos (including 360\u00b0 and 3D) and play songs from your Quest, PC, network shares and DLNA.\r\nAdd your own photos to any room: grab to move, stick to resize, twist to rotate. Transparent PNGs stand as cut-outs.\r\nSnow Cabin: falling snow outside and new windows on every side.\r\nCast from your phone: audio track and subtitle choices; photos and big 360\u00b0 photos can be cast too.\r\nPC Files: select many files or whole folders and copy them to your Quest.\r\nWeb Cinema: long-press a picture to save it. Safer, more reliable downloads.\r\nEasier Files: View, Sort and Show drop-down lists; \u201cOpen with\u201d works for photos and songs.\r\nFixes for Private Vault, Web VR, Live TV guides and DLNA.", "created_date": 1794762978, "id": "1456853524182562", "version": "0.4.29", "version_code": 38, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1456929580841623"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "B button opens and closes the menu. Press B on the right controller to show or hide the menu at any time (thanks for the request!).\r\nWeb VR videos play in VR. VR video websites now play in VR right inside Web Cinema; YouTube VR videos still open in the YouTube app. The VR video button turns gold when a VR video is found.\r\nWeb VR controls. Zoom in, zoom out and seek, all from the menu while you watch.\r\nDLNA fix. Some files that showed \u201cCannot open null\u201d now play, and any error now gives a clear reason.\r\n\u201cAdd media folder\u201d is now prominent.", "created_date": 1794699554, "id": "1454394401095141", "version": "0.4.27", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1456929580841623"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "fixed youtube full screen issue.\r\nunlocked 8k 60fps", "created_date": 1794696576, "id": "1454320324435882", "version": "0.4.26", "version_code": 35, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1456929580841623"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": null, "created_date": 1794679939, "id": "1453948337806414", "version": "0.4.25", "version_code": 34, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
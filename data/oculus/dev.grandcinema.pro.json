51vwZA&oe=6B106C7A"}, {"file_name": "05-blue-sea-beach.png", "id": "1476957720558702", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_1476957723892035_4659682181593899840_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTFU0WjXiacQ7kNvwGDtUFV&_nc_oc=AdqgPJq_YaFDnFzpJb6RJPKTQZe4STNTwAHH8s2Rmxdm7rQF8eQ2rOJ-1BLconN1x8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWyL2OvzauJ0u0WnxO5xuOhCHqP8uPRlqN9TqrGmzLYdg&oe=6B1047BA"}, {"file_name": "04-beach-under-the-stars.png", "id": "1442485504689193", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622153_1442485508022526_4864039256984028111_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBQ_0QD1vdQQ7kNvwEfrGKl&_nc_oc=Adpgna1ExOFu6cVTxJkSxwN_rD664iwz4E1izTmS5Aw497B45v58BASbvs70WVMSK8E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVDRDgcUJqNVfhOAKCby7uZZgZY9adXwYPW52UlbM1P8w&oe=6B105480"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "grand-cinema-pro-trailer-cover-2560x1440.png", "id": "1523457522957545", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771262_1523457526290878_7491526584540890800_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrJfA1sCXOYQ7kNvwHGbmhk&_nc_oc=AdoxATwxRIoSST8WToDb7Tp1be-pDEuCb__nhQyp6kTKvM1XdkMK3aKe9RAJy5znQs8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWgsWuY59UKm7jb2DX8G2D_nRMqVpLOnBx-pgkBLts-aQ&oe=6B103E9E"}, "display_name": "Grand Cinema Pro \u2013 Video Player", "keywords": ["videoplayer", "vrvideoplayer", "3dblurayiso", "blurayplayer", "3dvideoplayer"], "long_description": "Grand Cinema Pro is a feature-rich VR video player for Meta Quest 3 and 3S. Try it free for 30 minutes.\n\n3D Blu-ray ISO player. Play unencrypted 2D and 3D MVC Blu-ray ISO and BDMV files directly, with chapters and PGS subtitles. Watch MKV, MP4 and AVI with HEVC, AV1 and HDR10 support, or play side-by-side, top-bottom, 180\u00b0 and 360\u00b0 video. Resume where you left off.\n\n27 cinema rooms. Choose a theater, beach, cabin, reef or black Void. Use Passthrough or your own 360\u00b0 photo. Pick a seat, move freely, add rain or snow, or watch lying down. Place virtual spatial speakers in the room or lock them to the cinema screen.\n\nSubtitle Explorer and Screenplay Sync. Look up a subtitle word with a tap, use dual subtitles, or follow a PDF screenplay scene by scene. Read PDF, EPUB, CBZ, TXT and Markdown with notes, highlights and dictionary lookup. View HEIC and spatial 3D photos or play music with room visualizers.\n\nUSB, PC and network media. Play files from exFAT and NTFS USB drives, SMB/NAS, Plex, Jellyfin, DLNA, WebDAV and FTP/FTPS. Play M3U Live TV, cast from your phone, or stream your Windows desktop with the free PC Connect companion.\n\nWeb Cinema and controls. Watch YouTube, open media links, or browse alongside a movie with the floating multi-tab Mini Browser. Adjust the screen and picture, move the tablet menu, and use hand tracking or either controller.", "short_description": "A feature-rich VR video player for Meta Quest 3 and 3S. Play unencrypted 3D MVC Blu-ray ISO and BDMV files directly, stream from USB, NAS, Plex or your Windows PC, and watch in 27 cinema rooms with movable spatial speakers. Tap subtitle words for definitions, follow PDF screenplays as movies play, or use a floating Passthrough screen. Try it free for 30 minutes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://grand-cinema-pro-privacy.luckyfinch21.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "Grand Cinema Pro", "support_website_url": null, "website_url": "https://apps.microsoft.com/detail/9N281PMBRKK7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1484734124727835"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771239_1004522505485806_8591419977467187148_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37p9sVd0WeIQ7kNvwFnzD4X&_nc_oc=AdrFh9dwI2VVoQ_EAO-31KOzRAJHu8Q310zqjoR5J49QNP_eQrEJfiYouFNKajCG9LE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKNqTPU7Wfv1dGrTfPlHq0UiKXvHDOXji9YxFppI1DPA&oe=6B104F82"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Grand Cinema Pro \u2013 Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1793825640, "lastRevision": {"nodes": [{"id": "1412576738610241", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1412576711943577", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1610191763752790"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "meta-cover-square-1440x1440.png", "id": "2583250272114476", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824665_2583250275447809_262387607307729386_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKiBcp_xBS4Q7kNvwGnv5s2&_nc_oc=AdoKcGd3v5slPBp8qnXoQ9cZhwJZZfYRXtYnSfnAX8XIHgRy2GerlBm6bpFQZZXm0Lw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVd3M6rCVWOa7T8n2QGPShWDuFtNoIumWGHibQcZFkbgA&oe=6B1057C0"}, {"file_name": "meta-cover-landscape-2560x1440.png", "id": "1660326892355132", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_1660326902355131_8784479047392030688_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOfLZtXrzREQ7kNvwEq9eSM&_nc_oc=Adq1-YlIf1r52j2vMY3FEJFSwWwqHFFByssgeofyoniqTOMnD4yYcEo1E6V29WuhcGI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXF32XRrU7EHGdkAadFLV3I18DGwYDee_7KQi4UzKTl9A&oe=6B1049E7"}, {"file_name": "meta-cover-hero-3000x900.png", "id": "1491400649713093", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593922576_1491400653046426_1879166448223194830_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FPjv99Imu0Q7kNvwExYw7O&_nc_oc=AdrZGrAp8TPKOXHsExt_ygyBzveJsiE0jd3c48S2-f1vh4O0VJw_T0Z0bZkP4Itxmrc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXf5BQPz95b9IQGnhyQVpRT4LCfkt-wT0NKHj1IjPRt2w&oe=6B103F75"}, {"file_name": "meta-cover-portrait-1008x1440.png", "id": "1384426323552468", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620669_1384426326885801_1599627294777928992_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4og8O0mMXcQ7kNvwHSbmdn&_nc_oc=AdqL9BQNmtUuRzOK5JwMz8h9MQsUmlqdDU_AEfigfnZ_V3yXK5Bf_d5dI6utnxafmUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUTDDC0GwhqHjJA4fTYNMvvkTLx2-Ry-7telfixPUfrSA&oe=6B103AB4"}, {"file_name": "meta-icon-512.png", "id": "1110141528493909", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624606_1110141538493908_348003011042060146_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSe2hao0DwQQ7kNvwG_5MOS&_nc_oc=AdomIqbsFc6eAoICBBJiMaeHsG-bpRZuamjTgAzDgFDG6JWkVhuGqu96DdDKosHpdgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWy_jUcP73R7c-hrR9sjvBcUGVFX8I6QcasXEjZlaKQpQ&oe=6B103A85"}]}, "id": "1951474875818443", "locale": "en_US", "screenshots": [{"file_name": "06-pc-desktop.png", "id": "1877770223382946", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/829188179_1877770226716279_7431652853327612262_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMIIHAkRlKYQ7kNvwFFVs0G&_nc_oc=AdpS-qnqnRokthVAd6EnK5nHC0rvLNB76mf3bFgY9KPa78kbmcjiDUV_lFRbim0F1kQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUI6ivY-4Vp-xiACmed_hCxnEc2sdYleRNMzUoAKGt4fQ&oe=6B104B8F"}, {"file_name": "04-music-visualiser.png", "id": "1642452353952110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/737543484_1642452357285443_1665494074810744958_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SAM0AYEGH8Q7kNvwHNsDFr&_nc_oc=AdoFwSSPmIDOZBqvNeF7GR_R7QNSmF2ePZXEHUZJbU3L6UOq7aHfxUD2aFCBcrO7k1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU94lMNo9xfW-oyW5Meu_M9VagNZ_uKDrJ4D4D7Jy2XRw&oe=6B106403"}, {"file_name": "01-grand-theatre.png", "id": "1155403083504553", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/772632092_1155403086837886_4287936282520908490_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKk4z34DDP8Q7kNvwE-mR6M&_nc_oc=AdofhTrSKAzHjP9qrR3E6iYxNecOzgYoYynHBCnM1xVILPyDbAfRtSwXGM1RF9wtm5M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXHx1yqFRK-yuir_LiDas3YOl2gCQ3992WCTluoK3vvMg&oe=6B1041AD"}, {"file_name": "02-seat-map.png", "id": "1683446913126756", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/654922264_1683446916460089_6506067360987478519_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVCxFXAeuIEQ7kNvwGMYAhL&_nc_oc=AdqY2Q2L-upEWEsHHSbCAdJtd9bJdg3DAFg10NFP_onbkZKq7aC62o7pZ25yGtZzfoo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUPdK1fLGjyhDNuE17goI7x1N7F24wjlvDCFPioKdHuTA&oe=6B106A17"}, {"file_name": "03-room-gallery.png", "id": "1895643318275799", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/804229564_1895643321609132_5732875117725595311_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfCd7nNAhsQQ7kNvwGQTa-6&_nc_oc=Adrj-vkiW7WqtafkIc45BVkBE73vaHlbor8sIK6IxQWo65b_qhZjAB_TX2-qGcW1dQU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXOBb41Ipg2qfXS8tsT-rG03gEi2nJUQFYGtFB5WbO4iA&oe=6B104F25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grand Cinema Pro \u2013 Video Player", "keywords": ["cinema"], "long_description": "Watch your own videos, websites and your Windows desktop on a giant screen in 21 authored cinema rooms or a floating-screen void.\n\nLOCAL VIDEO: play flat, 3D, 180\u00b0 and 360\u00b0 videos from your headset or your home network (SMB/DLNA), with subtitles and automatic refresh-rate matching for smooth motion.\n\nWEB CINEMA: open YouTube or any website on the big screen, with a built-in pop-up blocker and the Quest keyboard.\n\nPC CONNECT (experimental): stream your Windows desktop and its audio over a USB cable or your local Wi-Fi at a steady 60 fps, with full 4:4:4 colour for sharp text. Requires the free Grand Cinema Pro app for Windows from the Microsoft Store. Pair once with a four-digit code; no account, no cloud and no tracking.\n\nMake it yours: pick any seat, adjust brightness and screen curvature, let room lights react to the picture, and turn on a music visualiser that reacts to sound.\n\nFilm clips: Spring and Sintel \u00a9 Blender Foundation | blender.org, licensed under CC BY.", "short_description": "Immersive cinema rooms for your movies, the web and your PC desktop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://grand-cinema-pro-privacy.luckyfinch21.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "Grand Cinema Pro", "support_website_url": null, "website_url": "https://apps.microsoft.com/detail/9N281PMBRKK7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412576725276909"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2667398137112415"}, {"status": "CANCELLED", "id": "2265986353960207"}, {"status": "PUBLISHED", "id": "1492828446074908"}, {"status": "PUBLISHED", "id": "1451887083542120"}, {"status": "PUBLISHED", "id": "993142590519517"}]}, "baseline_offer": {"id": "2667398137112415"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795461960, "status": "PUBLISHED", "id": "2667398137112415"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1493957873805460", "version": "0.5.1"}, "id": "1165388672764161", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1493957873805460"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "minor bug fixes in iptv", "created_date": 1795799215, "id": "1493957873805460", "version": "0.5.1", "version_code": 53, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1493957873805460"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Grand Cinema Pro 0.5.0 for Meta Quest 3 and 3S\n\n3D Blu-ray and local playback\n- Play unencrypted 2D and 3D MVC Blu-ray ISO images and BDMV folders directly from local storage, USB, PC Files, or network servers. Includes chapters, PGS subtitles, and read-ahead buffering.\n- Play MKV, MP4, and AVI, with HEVC/H.265, AV1, HDR10, PCM, and multichannel audio support. Automatically detect side-by-side and top-bottom 3D and 180\u00b0/360\u00b0 VR video. Adjust picture sharpness and color warmth.\n- Browse, search, save favorites, and resume playback. Supports FAT32, exFAT, and NTFS USB drives, including files over 4 GB on exFAT and NTFS.\n\nRoom Speakers and spatial audio\n- Place and drag virtual cinema speakers around the room or use Lock to Screen. Configure speaker layouts for both local video and Web Cinema.\n\nSubtitles, books, and Screenplay Sync\n- Tap a subtitle word with your hand or controller to look up its meaning in Subtitle Explorer. Use dual subtitles, automatic character encoding detection, and SRT, ASS, VTT, or PGS tracks.\n- Open a movie's PDF screenplay alongside playback and follow it scene by scene and line by line.\n- Read PDF, EPUB, CBZ comics and manga, TXT, and Markdown. Highlight, take notes, and look up words in the reader or Mini Browser.\n\nCinema rooms, photos, and music\n- Choose from 27 cinema rooms, including Void, indoor theaters, outdoor settings, and an underwater reef. Use Passthrough or your own 360\u00b0 photo as an environment.\n- Enjoy screen lighting, rain, thunder, snow, and swimming fish in the reef. Choose a seat, move or teleport, and recenter as needed. Room orientation is retained when switching rooms.\n- View HEIC photos, panoramas, and 360\u00b0 photos. Spatial 3D Photos adds depth to flat photos. The music player includes interactive room visualizers.\n\nWeb Cinema, PC Connect, and network playback\n- Browse on the cinema screen or use the floating, multi-tab Mini Browser with Show in Mini. YouTube supports thumbstick seeking, 5- and 15-second skips, 3D detection, and fullscreen playback.\n- Open and resume saved video links. Use Grand Cinema Pro as an external player with compatible apps.\n- Stream a Windows desktop or game with the free Microsoft Store PC Connect companion and use a mouse and keyboard. Browse videos, Blu-ray images, photos, and PDFs with PC Files.\n- Connect to SMB/NAS, FTP/FTPS, WebDAV, DLNA, Plex, and Jellyfin. Choose a start folder, browse up to 5,000 items per folder, or wake a sleeping NAS. Play M3U Live TV playlists or cast from your phone via DLNA.\n\nControls and performance\n- Move and resize the floating tablet menu, then double-tap Menu to bring it back in front of you. Use improved hand tracking or either controller on its own, with trigger-drag seeking and thumbstick controls.\n- Watch lying down or use a floating Passthrough screen. This release also improves YouTube startup, library scrolling, and PC/network subtitle scanning.", "created_date": 1795755665, "id": "1492547410613173", "version": "0.5.0", "version_code": 51, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1493957873805460"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "- Clock, date and headset battery (with charging indicator) on the control tablet.\r\n- Network videos (SMB, NAS, media servers): MP4s that stopped with \"file ended before its picture details were found\" now play; smoother playback after skipping to the middle; real file names instead of codes in lists and Continue watching.\r\n- USB drives: NTFS drives no longer stop with \"Drive is in use\" after declining Quest's format prompt.\r\n- PC Connect: connects automatically when you open it and when you switch between USB and Wi-Fi; \"Forget this PC\" works on every tab.\r\n- Seek bar: calmer look at the bottom of the picture, never covers subtitles; also shown for thumbstick skips with the menu open; skips use your skip-length setting everywhere.\r\n- Faster, smoother rooms, menus, library, surround audio and streaming (many performance improvements).", "created_date": 1795386017, "id": "1480963361771578", "version": "0.4.41", "version_code": 50, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1493957873805460"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Streaming apps: steadier playback when another app opens a video in Grand Cinema Pro, automatic reconnect, and Play always resumes.\r\nVideos opened from other apps now show their poster and appear in Continue watching; expired links are clearly marked with a one-tap button to reopen the source app.\r\nWeb links: videos you play from other apps are saved with posters, resume exactly where you stopped, and refresh their link automatically when possible. Find them under Show > Web links and in Continue watching.\r\nPC Connect: wake your PC from the headset, sync the clipboard, send files to your PC, and clear re-pairing when a PC removes the headset.", "created_date": 1795375666, "id": "1480740205127227", "version": "0.4.40", "version_code": 49, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1493957873805460"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "- Plex: sign in with a code at plex.tv/link and play your Plex movies with posters and story.\r\n- New look for your movies: posters, ratings, story, quality badges and a Continue watching row. Movie info also from Kodi .nfo files and (optional) Wikipedia.\r\n- Works with headset tracking turned off, for watching in a completely dark room.\r\n- Back to your Stremio movie in seconds after watching something else, with its title shown.\r\n- Wider playback timeline and an easy Back button on movie pages.\r\n- Many stability, streaming and security fixes (Cast/DLNA, SMB, WebDAV, Private Vault, PC Connect).", "created_date": 1795357991, "id": "1479950891872825", "version": "0.4.39", "version_code": 48, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
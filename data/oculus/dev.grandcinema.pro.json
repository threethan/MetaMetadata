"}, {"file_name": "02-seat-map.png", "id": "1683446913126756", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/654922264_1683446916460089_6506067360987478519_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o34qsCkVJOEQ7kNvwH8m8OD&_nc_oc=AdrWxRqOROPfxCM16n2I7qMEiLl0YfS2PethUgfKZYq_VXNsQg2BzuEmbGS_sqU8Ttk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS6QNO7yxa_GWtXLobLD2lMQ-kLUIZTpO-JzcrlYkM1yw&oe=6B0B2417"}, {"file_name": "03-room-gallery.png", "id": "1895643318275799", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/804229564_1895643321609132_5732875117725595311_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPwu0deYb24Q7kNvwGGNw4Y&_nc_oc=Adp3nuYlXkng1hKR8ldSoBGr3ir673CcGSQ26-wJelWz8NzlMHE4kC-eWLOUkF0fw-o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRi-OEbPbnXkLFRrdK4ijeQjbdMte4MEaMdWXHaEggM0g&oe=6B0B4165"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grand Cinema Pro \u2013 Video Player", "keywords": ["cinema"], "long_description": "Watch your own videos, websites and your Windows desktop on a giant screen in 21 authored cinema rooms or a floating-screen void.\n\nLOCAL VIDEO: play flat, 3D, 180\u00b0 and 360\u00b0 videos from your headset or your home network (SMB/DLNA), with subtitles and automatic refresh-rate matching for smooth motion.\n\nWEB CINEMA: open YouTube or any website on the big screen, with a built-in pop-up blocker and the Quest keyboard.\n\nPC CONNECT (experimental): stream your Windows desktop and its audio over a USB cable or your local Wi-Fi at a steady 60 fps, with full 4:4:4 colour for sharp text. Requires the free Grand Cinema Pro app for Windows from the Microsoft Store. Pair once with a four-digit code; no account, no cloud and no tracking.\n\nMake it yours: pick any seat, adjust brightness and screen curvature, let room lights react to the picture, and turn on a music visualiser that reacts to sound.\n\nFilm clips: Spring and Sintel \u00a9 Blender Foundation | blender.org, licensed under CC BY.", "short_description": "Immersive cinema rooms for your movies, the web and your PC desktop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://grand-cinema-pro-privacy.luckyfinch21.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "Grand Cinema Pro", "support_website_url": null, "website_url": "https://apps.microsoft.com/detail/9N281PMBRKK7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412576725276909"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2667398137112415"}, {"status": "CANCELLED", "id": "2265986353960207"}, {"status": "PUBLISHED", "id": "1492828446074908"}, {"status": "PUBLISHED", "id": "1451887083542120"}, {"status": "PUBLISHED", "id": "993142590519517"}]}, "baseline_offer": {"id": "2667398137112415"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795461960, "status": "PUBLISHED", "id": "2667398137112415"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1480963361771578", "version": "0.4.41"}, "id": "1165388672764161", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1480963361771578"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "- Clock, date and headset battery (with charging indicator) on the control tablet.\r\n- Network videos (SMB, NAS, media servers): MP4s that stopped with \"file ended before its picture details were found\" now play; smoother playback after skipping to the middle; real file names instead of codes in lists and Continue watching.\r\n- USB drives: NTFS drives no longer stop with \"Drive is in use\" after declining Quest's format prompt.\r\n- PC Connect: connects automatically when you open it and when you switch between USB and Wi-Fi; \"Forget this PC\" works on every tab.\r\n- Seek bar: calmer look at the bottom of the picture, never covers subtitles; also shown for thumbstick skips with the menu open; skips use your skip-length setting everywhere.\r\n- Faster, smoother rooms, menus, library, surround audio and streaming (many performance improvements).", "created_date": 1795386017, "id": "1480963361771578", "version": "0.4.41", "version_code": 50, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1480963361771578"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Streaming apps: steadier playback when another app opens a video in Grand Cinema Pro, automatic reconnect, and Play always resumes.\r\nVideos opened from other apps now show their poster and appear in Continue watching; expired links are clearly marked with a one-tap button to reopen the source app.\r\nWeb links: videos you play from other apps are saved with posters, resume exactly where you stopped, and refresh their link automatically when possible. Find them under Show > Web links and in Continue watching.\r\nPC Connect: wake your PC from the headset, sync the clipboard, send files to your PC, and clear re-pairing when a PC removes the headset.", "created_date": 1795375666, "id": "1480740205127227", "version": "0.4.40", "version_code": 49, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1480963361771578"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "- Plex: sign in with a code at plex.tv/link and play your Plex movies with posters and story.\r\n- New look for your movies: posters, ratings, story, quality badges and a Continue watching row. Movie info also from Kodi .nfo files and (optional) Wikipedia.\r\n- Works with headset tracking turned off, for watching in a completely dark room.\r\n- Back to your Stremio movie in seconds after watching something else, with its title shown.\r\n- Wider playback timeline and an easy Back button on movie pages.\r\n- Many stability, streaming and security fixes (Cast/DLNA, SMB, WebDAV, Private Vault, PC Connect).", "created_date": 1795357991, "id": "1479950891872825", "version": "0.4.39", "version_code": 48, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1480963361771578"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "- Fixed a crash during long 4K streams from stream apps (Stremio, Nuvio and others).\r\n- Smoother streaming: videos from stream apps, links and your media servers (DLNA, SMB, Plex, Jellyfin and more) download minutes ahead to headset storage, so 4K plays with fewer pauses and skipping back is instant. Uses up to 4 GB temporarily, cleared when you stop.\r\n- Open-air rooms: the screen now stands on the ground and wide films no longer float. Indoor theatres get a Screen size slider up to the room's wall.\r\n- Hand controls: move the menu with the bottom bar, or pinch a side handle to hold it like a tablet. Menu size is remembered near and far.\r\n- Picture & Sharpness: Meta Quest Super Resolution and Sharpening are at the top of Picture controls, work evenly across the picture, and can be switched on from Web Cinema too.\r\n- Your own 360\u00b0 photo: separate brightness for the room and the 360\u00b0 surroundings, plus a one-tap Match button.\r\n- Works with headset tracking turned off, for watching in a completely dark room.\r\n- Files: new sort options (Smallest, Oldest, Longest, Shortest).\r\n- Fixed: the last subtitle line of a paused movie could stay on screen during PC Connect or Web Cinema.", "created_date": 1795341179, "id": "1478982555302992", "version": "0.4.38", "version_code": 47, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1480963361771578"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Better external player for stream apps (Stremio Android, Nuvio and others):\r\n  - Continues where you stopped and reports your position back, so the app resumes and marks episodes watched.\r\n  - Subtitles sent by the app (add-on subtitles) and every embedded subtitle and audio language, switchable during playback; your preferred languages are remembered.\r\n  - Bigger buffer (up to 2 minutes) and faster multi-connection download for web/debrid links; clear error messages with automatic retry.", "created_date": 1795304872, "id": "1477789895422258", "version": "0.4.37", "version_code": 46, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
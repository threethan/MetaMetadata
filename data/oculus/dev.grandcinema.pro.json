853327612262_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85v09_q2ZqMQ7kNvwH7D3NJ&_nc_oc=AdqRKPOIqaswiUZ7fCDjhubuRQKbbj7k6bYKKTkHIF1kyaJD901fUD4UUu6fVtVzadE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAWdlLefJrdk2xUj23M0n47uJMwWXSsb_1-pmcudhVhQ&oe=6AFF280F"}, {"file_name": "04-music-visualiser.png", "id": "1642452353952110", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/737543484_1642452357285443_1665494074810744958_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFBXobxYiMIQ7kNvwG4IIMY&_nc_oc=AdoalzluPE3LpSivulyx2vpaXnnJv6FPjsHQ83mQAj2mRMOO638TBwxMJpdxdDwPPqo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_y4z8K9utYPYvegk6ZBgoWCvrIq488zYQMl8QjowY1A&oe=6AFF0843"}, {"file_name": "01-grand-theatre.png", "id": "1155403083504553", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/772632092_1155403086837886_4287936282520908490_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWUdaiCS1ZcQ7kNvwEWJNjt&_nc_oc=Ado-KNI4T5pGdx7_dnDUFNUC5JovR5qDA7RSLUbjskv7OT5kjGeA-cihk_cmXnG0NO4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhukS-AnoYiCxAlyTuJtEnJ_6BY0TsoyF7vDuHKPhILQ&oe=6AFF1E2D"}, {"file_name": "02-seat-map.png", "id": "1683446913126756", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654922264_1683446916460089_6506067360987478519_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n_ljsZSs5YQ7kNvwHVZbUy&_nc_oc=Adofmw8te_61N_h2_meCvj-4nPpqXtjD6hN0sCOQxxFlsch8PmJecbqq7R24vN59dtc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTL22qj-6yRhNHvHssgnLhLbvEjZ-FA3SUPj6WGsKMKA&oe=6AFF0E57"}, {"file_name": "03-room-gallery.png", "id": "1895643318275799", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/804229564_1895643321609132_5732875117725595311_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUFN8opBOYAQ7kNvwFrlNLG&_nc_oc=Adq_LZMWHDDdFjPIM_irjazPneuyCDv_CaAwcBb_I1rROqSyPka5EUjyxqNHvWBzCeA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjpeF0-gl1lMyGxhXulibEPJNH09RLlcYeRpzCPxoLLA&oe=6AFF2BA5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grand Cinema Pro \u2013 Video Player", "keywords": ["cinema"], "long_description": "Watch your own videos, websites and your Windows desktop on a giant screen in 21 authored cinema rooms or a floating-screen void.\n\nLOCAL VIDEO: play flat, 3D, 180\u00b0 and 360\u00b0 videos from your headset or your home network (SMB/DLNA), with subtitles and automatic refresh-rate matching for smooth motion.\n\nWEB CINEMA: open YouTube or any website on the big screen, with a built-in pop-up blocker and the Quest keyboard.\n\nPC CONNECT (experimental): stream your Windows desktop and its audio over a USB cable or your local Wi-Fi at a steady 60 fps, with full 4:4:4 colour for sharp text. Requires the free Grand Cinema Pro app for Windows from the Microsoft Store. Pair once with a four-digit code; no account, no cloud and no tracking.\n\nMake it yours: pick any seat, adjust brightness and screen curvature, let room lights react to the picture, and turn on a music visualiser that reacts to sound.\n\nFilm clips: Spring and Sintel \u00a9 Blender Foundation | blender.org, licensed under CC BY.", "short_description": "Immersive cinema rooms for your movies, the web and your PC desktop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://grand-cinema-pro-privacy.luckyfinch21.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "Grand Cinema Pro", "support_website_url": null, "website_url": "https://apps.microsoft.com/detail/9N281PMBRKK7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412576725276909"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1492828446074908"}, {"status": "PUBLISHED", "id": "1451887083542120"}, {"status": "PUBLISHED", "id": "993142590519517"}]}, "baseline_offer": {"id": "1492828446074908"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794162600, "status": "PUBLISHED", "id": "1492828446074908"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1454394401095141", "version": "0.4.27"}, "id": "1165388672764161", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1454394401095141"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "B button opens and closes the menu. Press B on the right controller to show or hide the menu at any time (thanks for the request!).\r\nWeb VR videos play in VR. VR video websites now play in VR right inside Web Cinema; YouTube VR videos still open in the YouTube app. The VR video button turns gold when a VR video is found.\r\nWeb VR controls. Zoom in, zoom out and seek, all from the menu while you watch.\r\nDLNA fix. Some files that showed \u201cCannot open null\u201d now play, and any error now gives a clear reason.\r\n\u201cAdd media folder\u201d is now prominent.", "created_date": 1794699554, "id": "1454394401095141", "version": "0.4.27", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1454394401095141"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "fixed youtube full screen issue.\r\nunlocked 8k 60fps", "created_date": 1794696576, "id": "1454320324435882", "version": "0.4.26", "version_code": 35, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1454394401095141"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": null, "created_date": 1794679939, "id": "1453948337806414", "version": "0.4.25", "version_code": 34, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1454394401095141"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Web Cinema\r\n\r\nCopy and paste on websites: select words, then use the Copy / Select all / Paste bar.\r\nYouTube stays on the full desktop site after Google sign-in (8K / 60 fps choices, normal seek bar).\r\nThe Google button always opens the Google home page.\r\nVR video controls, website downloads and a music player for downloaded songs.\r\nLive TV\r\n\r\nThe channel list stays open while a channel plays, with Pause, Previous and Next.\r\nYouTube live channels in playlists open in Web Cinema.\r\nLong or mistyped links no longer freeze the app.\r\nLocal Video\r\n\r\n\"Open with Grand Cinema Pro\" from file managers.\r\n3D side-by-side and top/bottom VR videos are detected automatically.\r\nVR adjustments are now sliders, each with its own reset.\r\nMore subtitle files load (older text encodings).\r\nCast\r\n\r\nSave a cast video to the headset.\r\n\r\n\r\nServers shows Live TV and Cast at the top; Settings starts with Lying-down mode.\r\nPC Connect shows whether you are on USB or Wi-Fi, with live details in Settings.", "created_date": 1794671782, "id": "1453549777846270", "version": "0.4.24", "version_code": 33, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1454394401095141"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Web Cinema\r\n\r\nVR video mode for websites now has its own controls:\r\nPlay / Pause and \u00b115 seconds.\r\nA seek bar.\r\nQuality choice.\r\nZoom and Recenter.\r\nDownloads: files from websites are saved to Download/Grand Cinema, with live progress in the new Downloads page.\r\nDownloaded videos play in Local Video.\r\nMusic files play right there.\r\nPC Connect\r\n\r\nThe menu shows whether you are connected over USB or Wi-Fi.\r\nSettings shows live connection details.\r\nSmoother Wi-Fi streaming with the new Windows app (0.4.5).", "created_date": 1794649092, "id": "1452448571289724", "version": "0.4.23", "version_code": 32, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
g?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltKeBMEK2osQ7kNvwE8O_Xj&_nc_oc=AdodF6SwPgOviByWO7MmNJmzT8U1hwbqeyL5x0kLzZTqnPSS7iYFz8kFn8MdZTvLHwY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrw8UYuOJ5PmrMRGJdd9fdYCQI_fAlRRUEfkcUU5YGzA&oe=6AFC813A"}, {"file_name": "04-beach-under-the-stars.png", "id": "1442485504689193", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622153_1442485508022526_4864039256984028111_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wc9LnfKNbxoQ7kNvwFPmZOo&_nc_oc=AdrW2PpOa9jYpk0SrgrYK_KGUtg2gRlyipdusa56MwsUWAclN1q-v9BdK1QOsESSr8E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbJbnezAN9mv1xPqBCu2IvEFr6sjvOFJd32aHXEMQV-g&oe=6AFC8E00"}, {"file_name": "02-retro-lounge-rewind.png", "id": "1101966855803787", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499623876_1101966859137120_8258407809121892632_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuTs7hNPB00Q7kNvwGlvQhn&_nc_oc=Adqhr41LdZrBhV4EPkAWjDfSIn4crG_mwur0PHZvalU6yBL3GyswqVPtvJ4UW3X4V_s&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuxiplp-30B6EDa9MMSwzZBHhnmMGfXFs8a8_3XiXNWA&oe=6AFC68A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1111006955091460", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619369_1111006958424793_7171558952698630711_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPyJsH4Z0psQ7kNvwECA1GE&_nc_oc=AdowyOqk_SpWuO515bfWJlyAPgIN_ZixuRvXCZas8mbL8AYCCSm1z28lB-jNv9BynNI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbGQbo4yH5cOzb6u0t2fsc31dF72XjK_rQxH0nfCOvdg&oe=6AFC6277"}, "display_name": "Grand Cinema Pro \u2013 Video Player", "keywords": ["cinema"], "long_description": "Watch your own videos, websites and your Windows desktop on a giant screen in 21 authored cinema rooms or a floating-screen void.\n\nLOCAL VIDEO: play flat, 3D, 180\u00b0 and 360\u00b0 videos from your headset or your home network (SMB/DLNA), with subtitles and automatic refresh-rate matching for smooth motion.\n\nWEB CINEMA: open YouTube or any website on the big screen, with a built-in pop-up blocker and the Quest keyboard.\n\nPC CONNECT (experimental): stream your Windows desktop and its audio over a USB cable or your local Wi-Fi at a steady 60 fps, with full 4:4:4 colour for sharp text. Requires the free Grand Cinema Pro app for Windows from the Microsoft Store. Pair once with a four-digit code; no account, no cloud and no tracking.\n\nMake it yours: pick any seat, adjust brightness and screen curvature, let room lights react to the picture, and turn on a music visualiser that reacts to sound.\n\nFilm clips: Spring and Sintel \u00a9 Blender Foundation | blender.org, licensed under CC BY.", "short_description": "Immersive cinema rooms for your movies, the web and your PC desktop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://grand-cinema-pro-privacy.luckyfinch21.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "Grand Cinema Pro", "support_website_url": null, "website_url": "https://apps.microsoft.com/detail/9N281PMBRKK7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1436311962903385"}, "review_messages": []}]}, "cover_squa
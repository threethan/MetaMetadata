_oc=Adqna0O6TqW_IpxyKoiEsGh714bet7jifgX22IMqCXiVecHqArCcPLS8wgOc3-LpWpo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrQAZeGpaQw3RbtaSoZNRBMIxKkeFHhyQCx6Bd1bnFtw&oe=6AFC88A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grand Cinema Pro \u2013 Video Player", "keywords": ["cinema"], "long_description": "Watch your own videos, websites and your Windows desktop on a giant screen in 21 authored cinema rooms or a floating-screen void.\n\nLOCAL VIDEO: play flat, 3D, 180\u00b0 and 360\u00b0 videos from your headset or your home network (SMB/DLNA), with subtitles and automatic refresh-rate matching for smooth motion.\n\nWEB CINEMA: open YouTube or any website on the big screen, with a built-in pop-up blocker and the Quest keyboard.\n\nPC CONNECT (experimental): stream your Windows desktop and its audio over a USB cable or your local Wi-Fi at a steady 60 fps, with full 4:4:4 colour for sharp text. Requires the free Grand Cinema Pro app for Windows from the Microsoft Store. Pair once with a four-digit code; no account, no cloud and no tracking.\n\nMake it yours: pick any seat, adjust brightness and screen curvature, let room lights react to the picture, and turn on a music visualiser that reacts to sound.\n\nFilm clips: Spring and Sintel \u00a9 Blender Foundation | blender.org, licensed under CC BY.", "short_description": "Immersive cinema rooms for your movies, the web and your PC desktop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://grand-cinema-pro-privacy.luckyfinch21.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "Grand Cinema Pro", "support_website_url": null, "website_url": "https://apps.microsoft.com/detail/9N281PMBRKK7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412576725276909"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1492828446074908"}, {"status": "PUBLISHED", "id": "1451887083542120"}, {"status": "PUBLISHED", "id": "993142590519517"}]}, "baseline_offer": {"id": "1492828446074908"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794162600, "status": "PUBLISHED", "id": "1492828446074908"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1447844638416784", "version": "0.4.19"}, "id": "1165388672764161", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1447844638416784"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Fixed DLNA and Casting\r\nFixed fast youtube playback\r\nFixed incorrect Video orientation in casting.", "created_date": 1794524780, "id": "1447844638416784", "version": "0.4.19", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1447844638416784"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "New\r\n\r\nPhone videos recorded sideways or upside down now play upright.\r\nWeb Cinema: bookmark your favourite sites and change the text size.\r\nConnect to PC by address: if your PC isn\u2019t found automatically (mesh or guest Wi-Fi), type the address shown in the Windows app.\r\n\r\nImproved\r\n\r\nWidescreen DVD and other anamorphic videos now show at the correct shape.\r\nVideos are only treated as 180\u00b0/360\u00b0 when their file name and shape both say so.\r\nPC Connect no longer reconnects in a loop when the PC stops sending pictures. It holds the last picture and tells you why, with tips to fix it.\r\nLock screen and admin prompts on the PC now show a clear message instead of a black screen, and the picture comes back automatically.\r\nPCs whose graphics can\u2019t run Grand\u2019s sharp 4:4:4 stream can now still connect using the graphics card\u2019s own video encoder. Text is a little softer in this mode.\r\n\r\nUpdate the free Windows app to version 0.4.3 to get all PC Connect improvements.", "created_date": 1794433674, "id": "1443411768860071", "version": "0.4.18", "version_code": 27, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1447844638416784"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "- Includes Underwater Reef with animated fish and a drifting boat.\r\n- Restores free movement and teleport after closing the Meta keyboard.\r\n- Improves movie playback when changing picture settings and when the headset wakes.", "created_date": 1794304960, "id": "1437382626129652", "version": "0.4.17", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1447844638416784"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Added New Snow Room.\r\nOpen Environment have ability to increase screen size.", "created_date": 1794266324, "id": "1436392679561980", "version": "0.4.16", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1447844638416784"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "\u2022 Fixed a crash when playing network streams, including Live TV and Cast.\r\n\u2022 Fixed a crash when using dropdown menus on websites in Web Cinema.\r\n\u2022 Live TV, Cast and Vault are now easy-to-reach tabs in the Library.\r\n\u2022 New ENTER button and a wider address bar in Web Cinema.\r\n\u2022 Sharper, clearer stars in Tropical Beach Night 2.", "created_date": 1794202929, "id": "1433171803217401", "version": "0.4.15", "version_code": 24, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
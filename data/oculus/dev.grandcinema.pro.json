scdn.com/v/t64.5771-25/829188179_1877770226716279_7431652853327612262_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iy-HZWzlFwQ7kNvwG4vKa8&_nc_oc=AdphhuZUWjdn47n1BwCRN0ggFGJQ3HN-6ICS1-nolD99NR4QzIS28AWMwIQMgTflobI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6S4KZoSsrkfJoahW526uXV3cEqqS6rnWZOLBe5zIdsw&oe=6B07110F"}, {"file_name": "04-music-visualiser.png", "id": "1642452353952110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/737543484_1642452357285443_1665494074810744958_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWF3LOlX1qsQ7kNvwHUej2k&_nc_oc=Adp_rSwtpiXxY7JZrIbTgd1zqBqzVxtBdg7R9AWEf8d503Fo4mf_tq8O_7fz95opIko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFUzlHbBeOrCNf1NEErFkoQmGQVjVj8kP7eZM2_gfthA&oe=6B06F143"}, {"file_name": "01-grand-theatre.png", "id": "1155403083504553", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/772632092_1155403086837886_4287936282520908490_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfbZkHoTEtcQ7kNvwFT8v4U&_nc_oc=AdrgU1tXkvUgHoD-57YuvsPqeKmNSrRAqSzqLIISrSOHZ6MwtggvJMngG_NL69tQgsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR850ipxOOVPCENzSIt-oM44Kq6OvVpre_eqG4bUSrTHg&oe=6B07072D"}, {"file_name": "02-seat-map.png", "id": "1683446913126756", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/654922264_1683446916460089_6506067360987478519_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmSZdgcPLOMQ7kNvwFwPij-&_nc_oc=AdqMQRW0U_DOekOrQOui9fuoNKXKvhdkhZ6aV5eTfC7O_wAvR4Yko0OfJeJQc9xQ0Kg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXGtLX43ainYaXNr88rmt6pIYu0NzHWqyKqqcfNOLYpg&oe=6B06F757"}, {"file_name": "03-room-gallery.png", "id": "1895643318275799", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/804229564_1895643321609132_5732875117725595311_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7BUFnAJcz0Q7kNvwEkIs2U&_nc_oc=AdoGkrXmIi1Ko4nhYiWTisai5pSAxWkVobHpmPt_WCGmWkIhUwFuADnQg0x8GdAcO8o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXFo_wruXWsi9-4hhufIDmOINw7djDUoljErcDUvf8tA&oe=6B0714A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grand Cinema Pro \u2013 Video Player", "keywords": ["cinema"], "long_description": "Watch your own videos, websites and your Windows desktop on a giant screen in 21 authored cinema rooms or a floating-screen void.\n\nLOCAL VIDEO: play flat, 3D, 180\u00b0 and 360\u00b0 videos from your headset or your home network (SMB/DLNA), with subtitles and automatic refresh-rate matching for smooth motion.\n\nWEB CINEMA: open YouTube or any website on the big screen, with a built-in pop-up blocker and the Quest keyboard.\n\nPC CONNECT (experimental): stream your Windows desktop and its audio over a USB cable or your local Wi-Fi at a steady 60 fps, with full 4:4:4 colour for sharp text. Requires the free Grand Cinema Pro app for Windows from the Microsoft Store. Pair once with a four-digit code; no account, no cloud and no tracking.\n\nMake it yours: pick any seat, adjust brightness and screen curvature, let room lights react to the picture, and turn on a music visualiser that reacts to sound.\n\nFilm clips: Spring and Sintel \u00a9 Blender Foundation | blender.org, licensed under CC BY.", "short_description": "Immersive cinema rooms for your movies, the web and your PC desktop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://grand-cinema-pro-privacy.luckyfinch21.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "Grand Cinema Pro", "support_website_url": null, "website_url": "https://apps.microsoft.com/detail/9N281PMBRKK7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412576725276909"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "CANCELLED", "id": "2265986353960207"}, {"status": "PENDING", "id": "2667398137112415"}, {"status": "PUBLISHED", "id": "1492828446074908"}, {"status": "PUBLISHED", "id": "1451887083542120"}, {"status": "PUBLISHED", "id": "993142590519517"}]}, "baseline_offer": {"id": "1492828446074908"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1799694000, "status": "CANCELLED", "id": "2265986353960207"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1474686712399243", "version": "0.4.33"}, "id": "1165388672764161", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1474686712399243"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Upgraded Horizon OS hand tracking and automatic hand/controller switching: exclusive device lock while holding Touch controllers, instant switch when picking up controllers, clean auto-hide during playback, no floating \"Open menu\" overlay on top of videos (left-hand pinch opens the menu), and higher tap-vs-swipe tolerance so hand taps reliably register as clicks.\r\nFull hand and controller support for placed room photos: add photos from inside VR without pausing YouTube, grab and tilt photos flat onto the floor or walls with either controllers or fingers, and pinch with two hands to resize.\r\nController and hand support for all 4 menu drag bars plus 4-corner curved resize handles and hover feedback.\r\nGPU-accelerated 72/90 Hz menu rendering for smooth scrolling in Room Gallery and Files, plus fixes for Web Cinema \u2192 Local Video switching, rapid Home \u2192 reopen lifecycle recovery, and focus-change stability.\r\nFaster, smoother DLNA and Cast Receiver video streaming with persistent HTTP range streaming, rolling read-ahead cache, and expanded Wi-Fi buffering.\r\nSofter default UI click audio with a Mute UI Clicks toggle, controller haptics, cleaner Local Video Player layout.", "created_date": 1795234726, "id": "1474686712399243", "version": "0.4.33", "version_code": 42, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1474686712399243"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "-Added ability to upload your own 360 degree photo to get unlimited environment vibes. Please give feedback directly from settings. \r\n Faster, smoother room switching: rooms prepare and load skies in the background while your video stays visible.\r\n- Smoother 4K HDR playback and lower GPU load, with reduced memory use in Underwater Reef and across long sessions.\r\n- Redesigned local video and YouTube playback controls with a wider seek bar, adjustable skip intervals, volume, and mute.\r\n- Prioritized on-screen thumbnails and smoother Room Gallery preview loading while scrolling.\r\n- Improved \"Open with Grand Cinema Pro\" and switching between Web Cinema and local playback, plus Rotate Picture for compatible DLNA video casts.\r\n- Added Penthouse Canyon, refreshed Skyline Penthouse Terrace, Aurora Cloud-Sea Summit, and Orbital Observation Lounge, and restored animated water and seabed lighting in Underwater Reef.\r\n- Expanded AVI compatibility, including older Xvid and Motion JPEG videos.", "created_date": 1795129148, "id": "1471878729346708", "version": "0.4.32", "version_code": 41, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1474686712399243"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Photos and music in Files: view photos (including 360\u00b0 and 3D) and play songs from your Quest, PC, network shares and DLNA.\r\nAdd your own photos to any room: grab to move, stick to resize, twist to rotate. Transparent PNGs stand as cut-outs.\r\nSnow Cabin: falling snow outside and new windows on every side.\r\nCast from your phone: audio track and subtitle choices; photos and big 360\u00b0 photos can be cast too.\r\nPC Files: select many files or whole folders and copy them to your Quest.\r\nWeb Cinema: long-press a picture to save it. Safer, more reliable downloads.\r\nEasier Files: View, Sort and Show drop-down lists; \u201cOpen with\u201d works for photos and songs.\r\nFixes for Private Vault, Web VR, Live TV guides and DLNA.\r\n\r\nNow you can open photo and video and music with open with button. and directly play in Grand cinema pro.", "created_date": 1794764226, "id": "1456929580841623", "version": "0.4.30", "version_code": 39, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1474686712399243"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "Photos and music in Files: view photos (including 360\u00b0 and 3D) and play songs from your Quest, PC, network shares and DLNA.\r\nAdd your own photos to any room: grab to move, stick to resize, twist to rotate. Transparent PNGs stand as cut-outs.\r\nSnow Cabin: falling snow outside and new windows on every side.\r\nCast from your phone: audio track and subtitle choices; photos and big 360\u00b0 photos can be cast too.\r\nPC Files: select many files or whole folders and copy them to your Quest.\r\nWeb Cinema: long-press a picture to save it. Safer, more reliable downloads.\r\nEasier Files: View, Sort and Show drop-down lists; \u201cOpen with\u201d works for photos and songs.\r\nFixes for Private Vault, Web VR, Live TV guides and DLNA.", "created_date": 1794762978, "id": "1456853524182562", "version": "0.4.29", "version_code": 38, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412576711943577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1474686712399243"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1165388672764161"}]}, "change_log": "B button opens and closes the menu. Press B on the right controller to show or hide the menu at any time (thanks for the request!).\r\nWeb VR videos play in VR. VR video websites now play in VR right inside Web Cinema; YouTube VR videos still open in the YouTube app. The VR video button turns gold when a VR video is found.\r\nWeb VR controls. Zoom in, zoom out and seek, all from the menu while you watch.\r\nDLNA fix. Some files that showed \u201cCannot open null\u201d now play, and any error now gives a clear reason.\r\n\u201cAdd media folder\u201d is now prominent.", "created_date": 1794699554, "id": "1454394401095141", "version": "0.4.27", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
37_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJTbtoHKHlwQ7kNvwFGpbb3&_nc_oc=AdqUpAZxkiDCp9B-ECvnDRcAyw4IaqyUA2Vqmw88SjipkUo0JYAvtXa-d9FLnPhQDe8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWlns6P9WH7crndFZbn0Q-T8H8cf2z8rZhaGwZpVzuYEQ&oe=6B0F1BA8"}, {"file_name": "Screenshot_5_Starting_Grid.png", "id": "1632538138511435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1632538141844768_2250890103334268915_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtKNf4bFrTgQ7kNvwFZChoK&_nc_oc=AdqgVY7sbwgd7seHCueytB21f-T3wGyFRncj__1IxqomxysZGYRtC1QqDTLPtdn2_Q4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUQrMATJYQI-BQ9ZHEy5MBWZ-GGwjjP6VZY1pzFsFpaRQ&oe=6B0F008E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FormulaBlurRace_TrailerCover_2560x1440.png", "id": "1930108041705863", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_1930108045039196_5317518843160386359_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gt4XAui4QbAQ7kNvwEkmTCV&_nc_oc=AdrSWFm9gQ_MOWqGZ55iX6WRTIxRrzq6hkTVzv_qL161KvmPHIlPL205veYRNFEVFCk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXigEN5_liaTP0O6NYmiZ3t-nd7iis8F2wtLRwwzwzzIA&oe=6B0F0154"}, "display_name": "Formula Blur Race VR", "keywords": ["Racing", "Arcade", "Cars", "Driving", "Combat"], "long_description": "Formula Blur Race VR puts you in the cockpit of an open-wheel race car where every power-up is a weapon. Reach out, grab the wheel with both hands and turn it to steer. The right trigger is your throttle, the left trigger brakes.\n\nCOLLECT, ATTACK, DEFEND\n\u2022 Drive through glowing crystals to pick up power-ups and carry up to three at a time\n\u2022 Flick the right stick to choose one and press A to use it\n\u2022 Lock on to the car ahead, watch for incoming missiles and strike back\n\nSEVEN POWER-UPS\n\u2022 Homing missile, energy bolts, mines, shockwave, shield, nitro and repair\n\u2022 Hits slow rivals down and throw them into the air in roaring fireballs\n\u2022 Wrecked cars rejoin the race a few seconds later, so nobody is out for good\n\nRACE YOUR WAY\n\u2022 1 to 5 laps against 3 to 9 rivals on a forest circuit\n\u2022 Easy, Normal or Hard AI that uses the same power-ups and cooldowns as you\n\u2022 Drivers at the back find more catch-up power-ups\n\u2022 Pick your car's colour and learn the basics in a short, skippable tutorial\n\nBUILT FOR VR\n\u2022 Holographic cockpit HUD with lock-on ring, incoming-missile warning and hit direction\n\u2022 No forced camera shake: your own car is never thrown by blasts, you feel them through controller vibration\n\u2022 Steering assist, effects volume and vibration settings\n\u2022 Seated play with one-button recentering\n\u2022 English, Turkish, German, Spanish and French", "short_description": "Arcade combat racing from the cockpit of an open-wheel race car. Grab the wheel with both hands, drive through glowing crystals and fight your way to the front with homing missiles, energy bolts, mines and shockwaves. Raise a shield when a missile locks on, hit nitro on the straights and repair your car before it is wrecked. Race 3 to 9 AI rivals who use the same seven power-ups, on Easy, Normal or Hard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
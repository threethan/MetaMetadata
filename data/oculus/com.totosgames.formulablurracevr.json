vgR4KNYrACbdto_NyzPK9ZXwDc0xM4WxPjPi1pISuR_fZjaz8MBzGZr3aW5Xc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSQTWMU0xbLW9qJkU11ZU8Dm-GX9nPxH7dJCqzcwdGPQ&oe=6B0DD1E4"}, {"file_name": "Screenshot_3_Target_Locked.png", "id": "2091899924782616", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827611_2091899931449282_364995707558774961_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3Pi8beEk-YQ7kNvwHZ-dAf&_nc_oc=AdroXWEbakemG9qI6R2TaLFOLvEMBmv9yIHVFfID9MtIy8cxFeo6jKTS9ys7he8AgK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQEOZFPd6O70G0vePQ9m97pTSvfTbHbFfmpWFH_uyqyA&oe=6B0DBA63"}, {"file_name": "Screenshot_4_Missile_Incoming_Shield.png", "id": "1098734829801066", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_1098734833134399_6102250075599786037_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJTbtoHKHlwQ7kNvwFM1SHi&_nc_oc=Adq7KOa_vV9IZiC-KCQ9B_DKQOuwCObdWNLUovJGxoZHKLimyHY4ueOQqmpHzP2OzE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSZDr0BtcRe8USNkboMScUffn2R8xjEhop2Xe_jo--5XQ&oe=6B0DCA28"}, {"file_name": "Screenshot_5_Starting_Grid.png", "id": "1632538138511435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1632538141844768_2250890103334268915_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtKNf4bFrTgQ7kNvwHRcmm3&_nc_oc=Adqr-4ixQ-rZKKf4l8v4q5StR8T2d3QPn8oszsNo4i7MbPXY7S0qPXtN8dgaqFKqMwQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQI284r4ZEaFNCy_CSCGFNvs1eQJQUg1q9iakH7tlhpDw&oe=6B0DAF0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FormulaBlurRace_TrailerCover_2560x1440.png", "id": "1930108041705863", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825462_1930108045039196_5317518843160386359_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=169qROgaZiQQ7kNvwFa5uWv&_nc_oc=AdqI6l0-GT-btF7J3J8oqizjlU8c7RMMdBWdK6oDot3fCpveHO3-2g4EVAWoQOmgSXo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-MvxexJu01LYa9DIFllSPC5Jg3e_LU8bNO1VWq7gKEQ&oe=6B0DAFD4"}, "display_name": "Formula Blur Race VR", "keywords": ["Racing", "Kart", "Combat", "Driving", "Cars"], "long_description": "Formula Blur Race VR puts you in the cockpit of an open-wheel race car where every power-up is a weapon. Reach out, grab the wheel with both hands and turn it to steer. The right trigger is your throttle, the left trigger brakes.\n\nCOLLECT, ATTACK, DEFEND\n\u2022 Drive through glowing crystals to pick up power-ups and carry up to three at a time\n\u2022 Flick the right stick to choose one and press A to use it\n\u2022 Lock on to the car ahead, watch for incoming missiles and strike back\n\nSEVEN POWER-UPS\n\u2022 Homing missile, energy bolts, mines, shockwave, shield, nitro and repair\n\u2022 Hits slow rivals down and throw them into the air in roaring fireballs\n\u2022 Wrecked cars rejoin the race a few seconds later, so nobody is out for good\n\nRACE YOUR WAY\n\u2022 1 to 5 laps against 3 to 9 rivals on a forest circuit\n\u2022 Easy, Normal or Hard AI that uses the same power-ups and cooldowns as you\n\u2022 Drivers at the back find more catch-up power-ups\n\u2022 Pick your car's colour and learn the basics in a short, skippable tutorial\n\nBUILT FOR VR\n\u2022 Holographic cockpit HUD with lock-on ring, incoming-missile warning and hit direction\n\u2022 No forced camera shake: your own car is never thrown by blasts, you feel them through controller vibration\n\u2022 Steering assist, effects volume and vibration settings\n\u2022 Seated play with one-button recentering\n\u2022 English, Turkish, German, Spanish and French", "short_description": "Arcade combat racing from the cockpit of an open-wheel race car. Grab the wheel with both hands, drive through glowing crystals and fight your way to the front with homing missiles, energy bolts, mines and shockwaves. Raise a shield when a missile locks on, hit nitro on the straights and repair your car before it is wrecked. Race 3 to 9 AI rivals who use the same seven power-ups, on Easy, Normal or Hard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "tr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2622422354865668"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1917305026314513_4114100338579060407_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JN_5Ns_sLkoQ7kNvwFIuIzR&_nc_oc=AdpdT-wWx5NmcTygTqSUBDKRwfcMw5VTZR6k_Cp_IyRBPQYLglOb--_m4_hYSu389po&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5agxmDZ1RZbcgcDsAu8qgwkbwdyCcQwVkGvMNAa-Psg&oe=6B0DAE38"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Formula Blur Race VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [
GNwzR79OchjSvoHocIkk6wXSmg&oe=6B09BFD5"}, {"file_name": "sc6.png", "id": "3644218012370908", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221318_3644218022370907_2000367399337622499_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXC2c_3tkmsQ7kNvwFlPWNt&_nc_oc=AdqdKiN_lzXV2CbV_-EqGfveIJE-TTC_RFNAaAvNrSYwNl-RBclX-CIofEUR42CQf2c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpY0_A0GgkKVs5ieY8l__f6DboiuwsPxFLGp-I3GtmQw&oe=6B09C6CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0.png", "id": "260445418989752", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982488_260445422323085_1663529341572936605_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnJoA4XeZ-oQ7kNvwGmAEYl&_nc_oc=AdoYoaSwzm6LdXSbP4ces1S5SCqlbVSaC_QXvNyGpUZRiMchQEXoZzgWiL1gPYBQwds&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLUpO6eC0JWyclx_TRNrZzO1mWK677jrA6hw8RBUsy2A&oe=6B09ACE7"}, "display_name": "Legendary Hunter VR", "keywords": [], "long_description": "Legendary Hunter VR is a VR duck hunting game inspired by the old classic NES game Duck Hunt.\n\nThe game is set on an enchanted place - expect to see a breathtaking moment! \n\nEnjoy the day / night cycles with dynamic weather that not only enhances the visual experience a\n\nDuring the day you'll have to face vicious crow attacks, which will not only attack you - but also the bee hives around you.\nAnd at night you'll have to survive the wolves and the crocodiles. You have been warned!\nMake sure that you use your environment wisely. \n\nKey Features:\n-Hunt Duck during the day time while surviving vicious crow and bee hive attacks.\n-Defend yourself from wolves and crocodiles at night .\n-Attempt to survive as many nights as you can. Your ammo is limited and you will need to fight for survival.\n-Wonderful environment.\n-Realistic gun mechanic and ammo.\n-Dynamic weather system.\n-Experience Atmospheric surround sound like never before.\n", "short_description": "Legendary Hunter VR is a VR duck hunting game inspired by the old classic NES game Duck Hunt. Hunt Duck during the daytime while surviving vicious crow attacks. And survive the wolves and the crocodiles at night. Enjoy the day/night cycles with dynamic weather and atmospheric surround sound."}]}, "developer_name": null, "developer_privacy_policy_url": "http://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://steamcommunity.com/app/642170/discussions/0/3113648183778286877/", "website_url": "http://frozen-dreams.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "519327199428747"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "1149762027550821"}, {"status": "PUBLISHED", "id": "1391234776491063"}, {"status": "PUBLISHED", "id": "1036974048956134"}, {"status": "PUBLISHED", "id": "1325438663113403"}, {"status": "PUBLISHED", "id": "1963521770913741"}, {"status": "PUBLISHED", "id": "962359453032567"}, {"status": "PUBLISHED", "id": "1497937558513908"}, {"status": "PUBLISHED", "id": "662907006670653"}, {"status": "PUBLISHED", "id": "1333365884812692"}, {"status": "PUBLISHED", "id": "1285942849569569"}, {"status": "PUBLISHED", "id": "1047767360738
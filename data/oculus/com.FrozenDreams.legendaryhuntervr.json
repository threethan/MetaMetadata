_oc=AdolwYne7k8BjP2NKi_vfioLazVj5M4SrVA4VOJ5mIFTCAzaTEz4UtLxQhM0gTOm4rc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0nOMVkogncDzMUOQIJ1htrxx38BFSWbcQ2hHMyZ_YpQ&oe=6AAD63E7"}, "display_name": "Legendary Hunter VR", "keywords": [], "long_description": "Legendary Hunter VR is a VR duck hunting game inspired by the old classic NES game Duck Hunt.\n\nThe game is set on an enchanted place - expect to see a breathtaking moment! \n\nEnjoy the day / night cycles with dynamic weather that not only enhances the visual experience a\n\nDuring the day you'll have to face vicious crow attacks, which will not only attack you - but also the bee hives around you.\nAnd at night you'll have to survive the wolves and the crocodiles. You have been warned!\nMake sure that you use your environment wisely. \n\nKey Features:\n-Hunt Duck during the day time while surviving vicious crow and bee hive attacks.\n-Defend yourself from wolves and crocodiles at night .\n-Attempt to survive as many nights as you can. Your ammo is limited and you will need to fight for survival.\n-Wonderful environment.\n-Realistic gun mechanic and ammo.\n-Dynamic weather system.\n-Experience Atmospheric surround sound like never before.\n", "short_description": "Legendary Hunter VR is a VR duck hunting game inspired by the old classic NES game Duck Hunt. Hunt Duck during the daytime while surviving vicious crow attacks. And survive the wolves and the crocodiles at night. Enjoy the day/night cycles with dynamic weather and atmospheric surround sound."}]}, "developer_name": null, "developer_privacy_policy_url": "http://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://steamcommunity.com/app/642170/discussions/0/3113648183778286877/", "website_url": "http://frozen-dreams.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category
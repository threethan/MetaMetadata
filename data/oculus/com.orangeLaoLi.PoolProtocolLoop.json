AO.png", "id": "1061506229253107", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618885_1061506232586440_4324000876334423539_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkdptIfnL9sQ7kNvwFuMNB_&_nc_oc=Adpvhh_2zAYjihnkpHv7WT2kgPDhgunDrA3eHgKnPfoyOSE5TdpcLR_bIg4ruU85UdU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFiIyYVqGWaISZJ6xnji_V-hQYBa3ccTHPzt_N2pNmFg&oe=6A859431"}]}, "id": "1381228392929888", "locale": "en_US", "screenshots": [{"file_name": "jietu1.png", "id": "533356179842273", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618884_533356183175606_5006747058176254016_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmCLeTB4gWcQ7kNvwFIBA67&_nc_oc=Adoohtv4Br0WHH6k_wAutOLg0OrrQEfsJlC95WN36OdINnIVRW-gyocOth2vmSc41WE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWR6XuKoWDnD54_vt0wpqS42exmloIFmnpB4S-9tgXNQ&oe=6A857CDF"}, {"file_name": "jietu3.png", "id": "1018226513711599", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618022_1018226517044932_8587422824232554328_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEfKqPSxcq0Q7kNvwF7nNsv&_nc_oc=Adq1OTkZCCKYZrHvjjB_klD8fsFAjONEIbVnURul8Zpw7Xnd3Cz3_gzRAypJbmsXQhw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIalzSoHZjpAiWDPpy0qt3Cov9iqg6Ja04L2GNTpFPhQ&oe=6A857A95"}, {"file_name": "jietu2.png", "id": "1688301525166578", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618414_1688301528499911_4228950843422145301_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACE--N4mo9kQ7kNvwEvvH2e&_nc_oc=Adr_d3FYHYgizo6v4L0qv2wNBHj0f_ecssnE_rUqyArby0FAV363ElPK-X6i0pUHcSA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPlW17YBM7L1LI9Nj1hUU18ft6m7L4QzkB5aXlSS-QIw&oe=6A859BE8"}, {"file_name": "jietu5.png", "id": "727646036583456", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499623277_727646043250122_6417407749162873948_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ds4AHJbzk0kQ7kNvwEpMiQ8&_nc_oc=AdoApsHtIjJ0sOmL41SX5X9hEIbvc46utgWi1SEoEUt9Wsz17k7rPaYS1WxOXDQRTcA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyl5SZ37R2Ey2jeCTqXW1FZc2Zc5cnJ0MU_L64TgtYFg&oe=6A857B9D"}, {"file_name": "jietu4.png", "id": "1240256297501829", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821950_1240256300835162_1695509658252561793_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OR23Sq8CQKwQ7kNvwHQPYWv&_nc_oc=AdrddTjlStEv4DI8ve44huVdJzWUIseNxRHvVlFJ8E1pa4WW4x90zq_aaxzbOSEPfEI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVrxV60r7vnL7KC7h6jbwJN9WnpSs4zAxwr1tZXAevFQ&oe=6A85A57E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jietu4.png", "id": "1644650439712488", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499305200_1644650443045821_5132490268284932313_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C-yu1LXO3gQ7kNvwHLpBoY&_nc_oc=AdpqRlNdXmvv0eOiwXP2oh6vDUo8HWqO4ACXXF0uu3Q-FZDsmRUx8eD7aXVKajBR-wc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYIwRhHWCa2-0LntngiM5_rmoOepLioHFiIS_ORHluGA&oe=6A858F9E"}, "display_name": "Pool Protocol: Loop", "keywords": ["WalkingSimulator", "Adventure", "Casual", "Loop", "SpottheDifference"], "long_description": "You are trapped in a mysterious swimming pool. Observe the surroundings for any abnormalities and find a way to escape.\n\nEscape method\nDo not ignore any abnormalities.\nIf you find an abnormality, immediately return to the pool entrance.\nIf no abnormalities are found, proceed to the pool exit.\nOnce all abnormalities are discovered, find the real Pool No. 8 and leave through the exit!\n\nSpecial tip\nThe game does not have particularly scary abnormal designs, so you can play with peace of mind.\nThe game duration is about 2 hours.\nThere are approximately 30 abnormalities in total.\n\nProduction Notes\nThis is an anomaly-finding game inspired by \u201cExit 8\u201d and \u201cFalseMall.\u201d\nIt is also my first independently completed beginner project.\nThe level of game production still needs practice and improvement, so I ask for your understanding.", "short_description": "You are trapped in a mysterious swimming pool. Observe the surroundings for any abnormalities and find a way to escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orangelaolivr/%E9%A6%96%E9%A1%B5", "developer_terms_of_service_url": null, "publisher_name": "orangeLaoLi", "support_website_url": null, "website_url": "https://sites.google.com/view/orangelaolivr/%E9%A6%96%E9%A1%B5", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30066393796341494"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821966_1743799882879119_2768173583963851178_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lbt3U8ckbZQQ7kNvwF6LtoZ&_nc_oc=AdoYTjDy-TtLEem6_3jBlwFqmIEBGn-Lc1mq0xQO0KHXK9NRDPcubU3CyV-_2KmA7FE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrwf7Ss6sFSpcTperZbhR-ZFwAhhwP-h511haBBlQrrA&oe=6A85A604"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pool Protocol: Loop", "platform": "ANDROID_6DOF", "context_
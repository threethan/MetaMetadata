zW_fxc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfupXZTEyDbOE7NbA58KwnB59AZo6fn4BM_TZjPSd6VDRA&oe=69A594DD"}, {"file_name": "jietu4.png", "id": "1240256297501829", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821950_1240256300835162_1695509658252561793_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2T5AWz9eEAQ7kNvwFGJQge&_nc_oc=AdkVE2YsFUROW-iv_I8IBXU8p7j2sf8g6fQW2HmLQGq827hZr87gELRVoBca2bEO_cA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftlKu3UCR62hQDtcSnYnUU707XorGZDzDM6GQLDtXg_qw&oe=69A5867E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jietu4.png", "id": "1644650439712488", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499305200_1644650443045821_5132490268284932313_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giHkZpLMRDAQ7kNvwFCj8aD&_nc_oc=Adn2X1ETgEndGV1gRSfT48lJ1uZlNVGobnG9iGjPXbiUb0BA20MqIKQoQ4vUzuEWayY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs3fdelKwEnX8_veBNviwDAhXylnk1CJzzMs-Pg35ewkA&oe=69A5709E"}, "display_name": "Pool Protocol: Loop", "keywords": ["WalkingSimulator", "Adventure", "Casual", "Loop", "SpottheDifference"], "long_description": "You are trapped in a mysterious swimming pool. Observe the surroundings for any abnormalities and find a way to escape.\n\nEscape method\nDo not ignore any abnormalities.\nIf you find an abnormality, immediately return to the pool entrance.\nIf no abnormalities are found, proceed to the pool exit.\nOnce all abnormalities are discovered, find the real Pool No. 8 and leave through the exit!\n\nSpecial tip\nThe game does not have particularly scary abnormal designs, so you can play with peace of mind.\nThe game duration is about 2 hours.\nThere are approximately 30 abnormalities in total.\n\nProduction Notes\nThis is an anomaly-finding game inspired by \u201cExit 8\u201d and \u201cFalseMall.\u201d\nIt is also my first independently completed beginner project.\nThe level of game production still needs practice and improvement, so I ask for your understanding.", "short_description": "You are trapped in a mysterious swimming pool. Observe the surroundings for any abnormalities and find a way to escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orangelaolivr/%E9%A6%96%E9%A1%B5", "developer_terms_of_service_url": null, "publisher_name": "orangeLaoLi", "support_website_url": null, "website_url": "https://sites.google.com/view/orangelaolivr/%E9%A6%96%E9%A1%B5", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30066393796341494"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821966_1743799882879119_2768173583963851178_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kCdIr_8r7wQ7kNvwENJpBl&_nc_oc=AdnNf9fA2pwwoGq2IbHdEkF2tJGH-uK6P9euGVnOy3JNIBq2PLmS7CG2C0xlcCMCVxc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afts5mVqp8scngAFRE-N3t1vazsS50ifa90k4wYzYCWYbA&oe=69A58704"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pool Protocol: Loop", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Simulation", "id": "331529188132278"
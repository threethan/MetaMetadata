7&_nc_sid=6e7a0a&_nc_ohc=9TbKEUaLwOUQ7kNvwGlt3Wk&_nc_oc=AdqAltARf4bYFR_Ww1zV7GXQBs-gm2JG6Wg6tfaasTQu_-vbs0A9r03uNgDfxIo7SCg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KaeYBvhheQLS56KWh33LGctnYDZZeYhtH9QUKHRBuog&oe=6A1452DD"}, {"file_name": "jietu4.png", "id": "1240256297501829", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821950_1240256300835162_1695509658252561793_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hf0BRk920vwQ7kNvwHfeiAL&_nc_oc=AdprIPxjbSc92lSszhMMchYkLg7VIzhJhoocxE93oldi-FqnaXfCtKaNR0-YWe7LXPg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WPCTwpcIpt9HLHOzl7BUd6NwVFAyRumNa_JuKbU-pqg&oe=6A14447E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jietu4.png", "id": "1644650439712488", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499305200_1644650443045821_5132490268284932313_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkQoOlEkvbwQ7kNvwGO-rSh&_nc_oc=AdrYl1AkIA6F1aH6w8jDhen8Y3UReJO3wAIXEreWYnc5gzeWO34QLRFWyAIiJ9s0SxU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JV8dtaY3QyO35YC841ZcRyl1NGqaOISHpmPrlxbi87Q&oe=6A1466DE"}, "display_name": "Pool Protocol: Loop", "keywords": ["WalkingSimulator", "Adventure", "Casual", "Loop", "SpottheDifference"], "long_description": "You are trapped in a mysterious swimming pool. Observe the surroundings for any abnormalities and find a way to escape.\n\nEscape method\nDo not ignore any abnormalities.\nIf you find an abnormality, immediately return to the pool entrance.\nIf no abnormalities are found, proceed to the pool exit.\nOnce all abnormalities are discovered, find the real Pool No. 8 and leave through the exit!\n\nSpecial tip\nThe game does not have particularly scary abnormal designs, so you can play with peace of mind.\nThe game duration is about 2 hours.\nThere are approximately 30 abnormalities in total.\n\nProduction Notes\nThis is an anomaly-finding game inspired by \u201cExit 8\u201d and \u201cFalseMall.\u201d\nIt is also my first independently completed beginner project.\nThe level of game production still needs practice and improvement, so I ask for your understanding.", "short_description": "You are trapped in a mysterious swimming pool. Observe the surroundings for any abnormalities and find a way to escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orangelaolivr/%E9%A6%96%E9%A1%B5", "developer_terms_of_service_url": null, "publisher_name": "orangeLaoLi", "support_website_url": null, "website_url": "https://sites.google.com/view/orangelaolivr/%E9%A6%96%E9%A1%B5", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30066393796341494"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821966_1743799882879119_2768173583963851178_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-1yyHdfjvcQ7kNvwETjRve&_nc_oc=AdqsBOJmu_oQSGyYkbKr7NP9ucUPomSoWt2QBMYMMizYsyNFfFc-TB5IXorQKlIy0Lk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_BfFemUPLWjfLG4FBIYC_MV_rLHifOH_ddit72vz4Zg&oe=6A144504"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pool Protocol: Loop", "platform": "ANDROID_6DOF", "context_category": {"context_
sKEvFphsYs1s0osBNw4aZQDz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThokYxFq1T_T8WJlKpTO4Gs-UiF-LByRBE730c_RGh_w&oe=6AF746C7"}, {"file_name": "Screenshot4.png", "id": "4186315918169704", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823812_4186315921503037_9094267545623940983_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHI24LNvTV8Q7kNvwGbFiPe&_nc_oc=AdpCMAXiqdxoHVgIbv6fYERJRg2IsPUrTMNlhO-hfdRpk2k62GeXZLSij0u5H3QLUo8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWVj_WN4LMXPlNCCOgVc7BC_XqWxlf08vntfdYTdcxQw&oe=6AF73E56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "977816031490900", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823296_977816034824233_4427088176768594524_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXkgRYa0mfUQ7kNvwESehIR&_nc_oc=AdpJacfG39D6dk3bOTdYEdJd9vgXAw7gLQVlhyzrknTGt503Gt21SUoWTyGx5dWLYMQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHmCWgG0W5IX-uxhF0K10p3XWq7574wozgchxUR-7U8A&oe=6AF721A8"}, "display_name": "Janet's Planets", "keywords": ["terraforming", "simulation", "scifi", "sandbox", "worldbuilding"], "long_description": "# Janet\u2019s Planets \u2014 Terraforming the Impossible!\n\n**Janet\u2019s Planets offers the best terraforming services this side of the Milky Way!** Busted ecosystem? Barren atmosphere? Too darn hot to breathe? **Come on up and let us save your world!**\n\n{803767862491561}\n\nWe\u2019re fixing up these planets across the galaxy, and **you're exactly who we're looking for.** \n\nUsing your hands (and **Janet\u2019s finest gadgets**), you\u2019ll\n- warm climates\n- grow forests\n- and gently nudge planets into shapes their quirky residents can thrive in. \n\nEach species wants something different, so you\u2019ll have to **experiment, observe, and learn what each world truly needs.**\n\n{26592635000365119}\n\n**See your creations up close**\nDrop down to the surface with the help of **Janet\u2019s SweetView!**\n \nThere's always more to do:\n- Climb the leaderboards\n- tackle daily challenges\n- play to your heart\u2019s content in sandbox mode\n\nAnd along the way, uncover an **out-of-this-world story** about what it really takes to\n**grow shareholder value in the wilds of outer space.**", "short_description": "Come on up to Janet\u2019s Planets, the friendliest terraforming service in the Milky Way*. Fix up faraway worlds, meet the aliens who live there, and make yourself at home among the stars."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.really-interactive.se/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Really Interactive", "support_website_url": null, "website_url": "https://www.really-interactive.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26079884425024976"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1558515066041824"}, {"status": "PUBLISHED", "id": "1105961528590062"}, {"status": "PUBLISHED", "id": "4619574811696274"}]}, "baseline_offer": {"id": "1105961528590062"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1558515066041824"}]}, "liveChannel": {"nodes": [{"latest
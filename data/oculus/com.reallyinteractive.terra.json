ontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_1546832423822834_9099359206742805823_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oowko92CydUQ7kNvwFE98LB&_nc_oc=Adpig2Hw2X3Xc8m6QYHY46OKSgyuUZ-U_0O62ooLzRM_KVbC5oxmOHN4TPDtwXJKWIo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQfdgggmiTmmAfyTJbfw0lJZjYJjlYDaXrOaR46BZarw&oe=6B0C5EC7"}, {"file_name": "Screenshot4.png", "id": "4186315918169704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_4186315921503037_9094267545623940983_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeBhWknl7tgQ7kNvwH64Oo5&_nc_oc=AdoBNE17NiZwXkHRov5smP4jKVkVD5jqMwfV7SfoNE4gj2hzOxB9sv-UKU_rZjhzdJ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSFtXv2CWAgv7GmoS6NJWr7XoYit7QChUCMg3Bk_kGmOw&oe=6B0C5656"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "977816031490900", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_977816034824233_4427088176768594524_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0Sw7VDgX1IQ7kNvwFdCic_&_nc_oc=Ado3jXZ5u2k3rsuIeO8Bhr3GCd2Uao2XbcxXcM1z2KC6U7V-RJyHnfSgp5etdTIB3Hk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQNcbXb3-wAfDiF5RdHAwY7O4gssuc9kwZsatzHaHZg4Q&oe=6B0C71E8"}, "display_name": "Janet's Planets", "keywords": ["terraforming", "simulation", "scifi", "sandbox", "worldbuilding"], "long_description": "# Janet\u2019s Planets \u2014 Terraforming the Impossible!\n\n**Janet\u2019s Planets offers the best terraforming services this side of the Milky Way!** Busted ecosystem? Barren atmosphere? Too darn hot to breathe? **Come on up and let us save your world!**\n\n{803767862491561}\n\nWe\u2019re fixing up these planets across the galaxy, and **you're exactly who we're looking for.** \n\nUsing your hands (and **Janet\u2019s finest gadgets**), you\u2019ll\n- warm climates\n- grow forests\n- and gently nudge planets into shapes their quirky residents can thrive in. \n\nEach species wants something different, so you\u2019ll have to **experiment, observe, and learn what each world truly needs.**\n\n{26592635000365119}\n\n**See your creations up close**\nDrop down to the surface with the help of **Janet\u2019s SweetView!**\n \nThere's always more to do:\n- Climb the leaderboards\n- tackle daily challenges\n- play to your heart\u2019s content in sandbox mode\n\nAnd along the way, uncover an **out-of-this-world story** about what it really takes to\n**grow shareholder value in the wilds of outer space.**", "short_description": "Come on up to Janet\u2019s Planets, the friendliest terraforming service in the Milky Way*. Fix up faraway worlds, meet the aliens who live there, and make yourself at home among the stars."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.really-interactive.se/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Really Interactive", "support_website_url": null, "website_url": "https://www.really-interactive.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26079884425024976"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1558515066041824"}, {"status": "PUBLISHE
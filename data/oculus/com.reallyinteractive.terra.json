ile_name": "VideoThumbnail.png", "id": "977816031490900", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823296_977816034824233_4427088176768594524_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4iCuyRe7qIQ7kNvwE3vDlc&_nc_oc=AdpaaGPD5jtzei8J-wVxamoIS2uDCBOfwDqoN5P68No-EG5bvUnkC2LVHYdp2eocX5s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeaSfTmUmLYdvW6DFgs_nypD7aY_Qo5s6fjuHrEuLzNQ&oe=6AF9C4A8"}, "display_name": "Janet's Planets", "keywords": ["terraforming", "simulation", "scifi", "sandbox", "worldbuilding"], "long_description": "# Janet\u2019s Planets \u2014 Terraforming the Impossible!\n\n**Janet\u2019s Planets offers the best terraforming services this side of the Milky Way!** Busted ecosystem? Barren atmosphere? Too darn hot to breathe? **Come on up and let us save your world!**\n\n{803767862491561}\n\nWe\u2019re fixing up these planets across the galaxy, and **you're exactly who we're looking for.** \n\nUsing your hands (and **Janet\u2019s finest gadgets**), you\u2019ll\n- warm climates\n- grow forests\n- and gently nudge planets into shapes their quirky residents can thrive in. \n\nEach species wants something different, so you\u2019ll have to **experiment, observe, and learn what each world truly needs.**\n\n{26592635000365119}\n\n**See your creations up close**\nDrop down to the surface with the help of **Janet\u2019s SweetView!**\n \nThere's always more to do:\n- Climb the leaderboards\n- tackle daily challenges\n- play to your heart\u2019s content in sandbox mode\n\nAnd along the way, uncover an **out-of-this-world story** about what it really takes to\n**grow shareholder value in the wilds of outer space.**", "short_description": "Come on up to Janet\u2019s Planets, the friendliest terraforming service in the Milky Way*. Fix up faraway worlds, meet the aliens who live there, and make yourself at home among the stars."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.really-interactive.se/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Really Interactive", "support_website_url": null, "website_url": "https://www.really-interactive.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26079884425024976"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1558515066041824"}, {"status": "PUBLISHED", "id": "1105961528590062"}, {"status": "PUBLISHED", "id": "4619574811696274"}]}, "baseline_offer": {"id": "1105961528590062"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1558515066041824"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28116485101364888", "version": "1.0.0"}, "id": "497092196360525", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7756220811151283", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28116485101364888"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "497092196360525"}]}, "change_log": null, 
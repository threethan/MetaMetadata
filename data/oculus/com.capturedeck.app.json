, "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_2444246019393965_6532343222328605415_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwAqUDiWkNUQ7kNvwE3WGL-&_nc_oc=Adozcgd7b69xbEGE8yK-X5g4jY_-S_ADxWy7aPJICNPSGj-0G302N9E-jnLnFob13Ro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlA08YwTt3BUt7Hh7-KeKVx0VNrWgx-a6Jvg6BlJfVuQ&oe=6AB7C1A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CaptureDeck", "keywords": [], "long_description": "**Turn your Quest recordings into finished videos without taking off your headset.**\n\nCaptureDeck is a purpose-built video editor for **Meta Quest** that lets you trim, combine, customise and export gameplay recordings entirely on-device \u2014 **no PC required.**\n\n{1588174979766811}\nUse **Quick Trim** for fast edits, or open **Creator Studio** to combine multiple clips, reorder them, adjust individual clip volume, mute sections and build a finished video from your recordings.\n\n**Add titles, captions and reusable creator branding**, then mix in your own **background music** with independent volume control.\n\nExport in **16:9**, **9:16**, **1:1** or **Original**, making it easy to create content for **YouTube**, **TikTok**, **Shorts**, **Reels**, **Discord and more**.\n\nChoose **Fit** to keep the full frame visible or **Fill** to crop cleanly into your selected format.\n\nPick between **Fast**, **Balanced and High** quality presets depending on whether you want quicker exports or higher visual quality.\n\nCaptureDeck processes projects **locally on your headset**, saves finished videos directly back to your Quest, and lets you share them using the system share menu.\n\n**From raw recording to finished content \u2014 all inside Quest.**", "short_description": "Edit Quest recordings directly on your headset. Trim clips, combine videos, add text and music, format for social media, and export \u2014 no PC required."}]}, "developer_name": "CaptureDeck Technologies", "developer_privacy_policy_url": "https://sites.google.com/view/capturedeck/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/capturedeck/terms-of-service?authuser=0", "publisher_name": "CaptureDeck Technologies", "support_website_url": null, "website_url": "https://sites.google.com/view/capturedeck/privacy-policy?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1193795490492262"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1582449486719198"}]}, "baseline_offer": {"id": "1582449486719198"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786195800, "status": "PUBLISHED", "id": "1582449486719198"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1193306307207847", "version": "1.0.0"}, "id": "1777873533211009", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1192138420657969", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1193306307207847"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1777873533211009"}]}, "change_log": "CaptureDeck 1.0.0 \u2014 Initial Release\r\n\r\nEdit Meta Quest recordings directly on your headset\r\nTrim clips quickly with Quick Trim\r\nCombine multiple recordings in Creator Studio\r\nAdd text, captions and creator branding\r\nAdjust individual clip audio and mute sections\r\nAdd background music with independent volume control\r\nExport in 16:9, 9:16, 1:1 or Original format\r\nFit or Fill footage for different social platforms\r\nFast, Balanced and High export quality presets\r\nSave projects and continue editing later\r\nShare finished videos using the Quest system share menu\r\nRefined dark monochrome UI with subtle purple accents\r\n\r\nNo PC required \u2014 create, edit and export entirely inside Quest.", "created_date": 1786105244, "id": "1193306307207847", "version": "1.0.0", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
25/491823757_2924628524543875_4261060754875608183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbEqbfFtEVoQ7kNvwGYyOLS&_nc_oc=Adp6Dr4_TrgX9RX13mxLf3X5vXouQ0qYRxx-JTTykroHcivlqIcbnBTr1U4pw9nQCEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPk6r9XS40zZvCjD3D_dtaRHHL5-q3P3p8aXZ6aXjgpQ&oe=6AB7E3F4"}, {"file_name": "ss4.png", "id": "3819425301533973", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_3819425308200639_4217291336427859709_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXyaY7cnsgkQ7kNvwFaImvk&_nc_oc=AdoFGwp7BMUK0TxMdoxmzsQXpUl_Vd3AkVRm-nSe7JGLHSBZo9woc78RDc36LXVzJek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMKXRMgUdb_qvwspb9nfHoLupnMnV79iUOkkiGAwx0ug&oe=6AB7D6E8"}, {"file_name": "ss5.png", "id": "2444246012727299", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_2444246019393965_6532343222328605415_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwAqUDiWkNUQ7kNvwE3WGL-&_nc_oc=Adozcgd7b69xbEGE8yK-X5g4jY_-S_ADxWy7aPJICNPSGj-0G302N9E-jnLnFob13Ro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlA08YwTt3BUt7Hh7-KeKVx0VNrWgx-a6Jvg6BlJfVuQ&oe=6AB7C1A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CaptureDeck", "keywords": [], "long_description": "**Turn your Quest recordings into finished videos without taking off your headset.**\n\nCaptureDeck is a purpose-built video editor for **Meta Quest** that lets you trim, combine, customise and export gameplay recordings entirely on-device \u2014 **no PC required.**\n\n{1588174979766811}\nUse **Quick Trim** for fast edits, or open **Creator Studio** to combine multiple clips, reorder them, adjust individual clip volume, mute sections and build a finished video from your recordings.\n\n**Add titles, captions and reusable creator branding**, then mix in your own **background music** with independent volume control.\n\nExport in **16:9**, **9:16**, **1:1** or **Original**, making it easy to create content for **YouTube**, **TikTok**, **Shorts**, **Reels**, **Discord and more**.\n\nChoose **Fit** to keep the full frame visible or **Fill** to crop cleanly into your selected format.\n\nPick between **Fast**, **Balanced and High** quality presets depending on whether you want quicker exports or higher visual quality.\n\nCaptureDeck processes projects **locally on your headset**, saves finished videos directly back to your Quest, and lets you share them using the system share menu.\n\n**From raw recording to finished content \u2014 all inside Quest.**", "short_description": "Edit Quest recordings directly on your headset. Trim clips, combine videos, add text and music, format for social media, and export \u2014 no PC required."}]}, "developer_name": "CaptureDeck Technologies", "developer_privacy_policy_url": "https://sites.google.com/view/capturedeck/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/capturedeck/terms-of-service?authuser=0", "publisher_name": "CaptureDeck Technologies", "support_website_url": null, "website_url": "https://sites.google.com/view/capturedeck/privacy-policy?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1193795490492262"}, "review_messages": []}]}, "cover_square_image": {"u
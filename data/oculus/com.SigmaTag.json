llations can take the form of intricate patterns.", "short_description": "SigmaTag, A New Interesting Gorilla Tag Fan-Game Using Their Gorilla Loco-Motion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1bcnK7jo5obhjLyCOLYIcPdZqeXiv5pRPvfsTetkCf9A/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "BostonBoi", "support_website_url": null, "website_url": "https://html.cafe/x64b56055", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9384264218340353"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820578_1440280593773622_665075675117157662_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jx-wj7NqSosQ7kNvwG3oRlJ&_nc_oc=AdrgZauObs_0lo7YxcVoeVFeGiJ5ekhoROj3Wj_SamlMDSfiChVvZqIEiKRVZgBwIMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2grwY6mMK9v9ONOKluyd1wjH_5D2KYY1AkFm9JT7itfg&oe=69E8C182"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SigmaTag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Hangout", "id": "10
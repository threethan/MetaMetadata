uscdn.com&_nc_ss=7f20f&oh=00_AQSFEj-xyx5HP45B_eicamf138O3Zoi_dGyRbbFIZIOGFQ&oe=6AFDD15B"}, {"file_name": "Novo Projeto (7).png", "id": "1572443644507727", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825503_1572443647841060_3801337003780547294_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKW06ViqdIgQ7kNvwHCX0t9&_nc_oc=Adp5DddwRI4WngAcR9-aW5A0lTaUuIBagKaWfY2H6b6H5BzmTH2jqxNCUIsVj4Ha18o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCryawdB1Y-ydZ_WB40sLj9wIv-_fDY1IwAr-7almcrw&oe=6AFDDAE3"}, {"file_name": "Novo Projeto (11).png", "id": "904199846044577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825462_904199849377910_6067196221708560636_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bm9Jrw2Y_ugQ7kNvwEYan2X&_nc_oc=AdrxWicx1aIhKnlizAlzfQl01Jndg9Etup9QuFs8JZs9f8mXlMGdZuRmw6-epaKZpes&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkaJz0B_nwqecMqP8IG_GTcg5boyqXm2O2edj9TAT_Qg&oe=6AFDC81A"}, {"file_name": "Novo Projeto (2).png", "id": "4459709317679559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_4459709321012892_7378784446390920699_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUN1jFIlVfMQ7kNvwGEnf5e&_nc_oc=Adq0Jj0wVOfFBLSEevzTCM3-cUpP7InYYZXWdpWC2GmTrc5TmBLjaPMuvVRUcJJkDYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnTX4FzoEDz_oIlsbC5TFJYBJSZz3N9eVY2fry3bHBMA&oe=6AFDC5B1"}, {"file_name": "Novo Projeto (9).png", "id": "1634766814279124", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_1634766817612457_2404291738291085565_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RBWAEfwFzUQ7kNvwEBcke9&_nc_oc=AdrrqpkOmtr6gNj6xk44HU1zZvgUxFxi2i2vmuOkMEaUK7mGn0C2HiL7GfBgqu7FfDw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFeLNfivFNVL1-hqSC3rC3aZVzVly_cPL5xs0MkA7Qlw&oe=6AFDB4FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bloop!", "keywords": ["puzzle", "maze", "casual", "fun", "relaxing"], "long_description": "# BLOOP!\n\nReach out and pick up a floating maze. Turn it. Tilt it. Hold it close to study the path then guide Bloop, your little bouncing blob, tile by tile to the glowing finish. BLOOP is a cozy, brain-teasing VR puzzler built around one simple joy: a whole little world that lives in your hands.\n\n# Comfortable, Always\n\nYou never move your own body through space, you just move a ball on a board floating in front of you:\n\n- Great **seated or standing**\n- Perfect for a **5-minute break or a long, quiet hour**\n- Easy to learn, gently trickier as you go\n\n# How You Play\n\n1. Reach out and **grab** the floating maze \u2014 by hand or laser pointer\n2. **Turn and tilt** it to read the route from any angle\n3. Guide Bloop tile-by-tile to **collect every diamond**\n4. Reach the **glowing finish portal** before your **energy** runs out\n\nEvery step costs a little energy; energy orbs top you back up. Tactile, chill, and quietly tricky.", "short_description": "Hold a maze in your hands. Tilt, study, solve. Cozy VR puzzling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://oceanrootproductions.com/bloop/privacy", "developer_terms_of_service_url": "https://oceanrootproductions.com/bloop/terms", "publisher_name": "OceanRoot Productions", "support_website_url": null, "website_url": "https://oceanrootproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
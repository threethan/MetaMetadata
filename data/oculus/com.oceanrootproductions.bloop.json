uscdn.com&_nc_ss=7f30f&oh=00_AQRhvuWzGcdmWPRG3xqIYllohA09YmOpqbX_wYiw_StfdA&oe=6B0DA35B"}, {"file_name": "Novo Projeto (7).png", "id": "1572443644507727", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825503_1572443647841060_3801337003780547294_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLsQjMATGJsQ7kNvwFnuiMG&_nc_oc=AdpNtCtOZlvMg3DkCQsJuHV7J3QwVMkfb01VO0BPl8BoJlhs27gMaM3tbax0t56SPzA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQbFYJFUuC1xn4JV2p_u-wKJZZy1XIvkxQeqCZgNdgaNA&oe=6B0DACE3"}, {"file_name": "Novo Projeto (11).png", "id": "904199846044577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825462_904199849377910_6067196221708560636_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMuK4AXK9MIQ7kNvwEshNfy&_nc_oc=AdqQPIpSs5YfUvQuf32RXpKOr9nkhkn-IBXQxxIQLGRCe1cFF-bq1M3AYLrxLAyiA9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSXyTdG4_8IXVBKALtldLNyV8G3foz7U858iM-xmT1xmw&oe=6B0DD25A"}, {"file_name": "Novo Projeto (2).png", "id": "4459709317679559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_4459709321012892_7378784446390920699_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cWopN4aRj8Q7kNvwH8xGsy&_nc_oc=AdpX9aD144T5ZOOgAJ8euwoxdsHFqaRFKbkkdABmoCJQt8rS9Ik185mXRdauaCIdtm8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTMH6vZRV5OpXqVwUDMkDGLcWW_CnG_1cb549qTyTLvrA&oe=6B0DCFF1"}, {"file_name": "Novo Projeto (9).png", "id": "1634766814279124", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_1634766817612457_2404291738291085565_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVt0byBNbhgQ7kNvwEtT6z_&_nc_oc=Adoqut8Bn-vhp5qEe_esU6YSUOzcz5CZv03fzIG5tA4EWb-TxYaAhOxmYhBmh6XzfjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBVUU_Rp-Hv3Wn1MUDFW-3GNTQ7M_PKdDcNwA9FsLsIw&oe=6B0DBF3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bloop!", "keywords": ["puzzle", "maze", "casual", "fun", "relaxing"], "long_description": "# BLOOP!\n\nReach out and pick up a floating maze. Turn it. Tilt it. Hold it close to study the path then guide Bloop, your little bouncing blob, tile by tile to the glowing finish. BLOOP is a cozy, brain-teasing VR puzzler built around one simple joy: a whole little world that lives in your hands.\n\n# Comfortable, Always\n\nYou never move your own body through space, you just move a ball on a board floating in front of you:\n\n- Great **seated or standing**\n- Perfect for a **5-minute break or a long, quiet hour**\n- Easy to learn, gently trickier as you go\n\n# How You Play\n\n1. Reach out and **grab** the floating maze \u2014 by hand or laser pointer\n2. **Turn and tilt** it to read the route from any angle\n3. Guide Bloop tile-by-tile to **collect every diamond**\n4. Reach the **glowing finish portal** before your **energy** runs out\n\nEvery step costs a little energy; energy orbs top you back up. Tactile, chill, and quietly tricky.", "short_description": "Hold a maze in your hands. Tilt, study, solve. Cozy VR puzzling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://oceanrootproductions.com/bloop/privacy", "developer_terms_of_service_url": "https://oceanrootproductions.com/bloop/terms", "publisher_name": "OceanRoot Productions", "support_website_url": null, "website_url": "https://oceanrootproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
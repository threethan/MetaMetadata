uscdn.com&_nc_ss=7f20f&oh=00_AQR26WgkEiyFTedjC7yvbO9_oyjy5AaHGF0GEiuL-M0Brw&oe=6B03175B"}, {"file_name": "Novo Projeto (7).png", "id": "1572443644507727", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825503_1572443647841060_3801337003780547294_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DarahXIygUoQ7kNvwFKhrUo&_nc_oc=AdrVQTaJawACXg_VlxOEGgiS3QqrIVQEspyAhMTSfuzDQknAE0VPhz-hbLxUaHaOvlE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-r00AvF02X1Yf9sBjx81SZVqTpX4UTj9XBKEwegUihA&oe=6B0320E3"}, {"file_name": "Novo Projeto (11).png", "id": "904199846044577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_904199849377910_6067196221708560636_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvzhsHb-le4Q7kNvwFaJQKy&_nc_oc=AdonGoe002QBclSlce6GIBuMZ3i9bpyeK5GzCtVZ0MgsJFuouOzmlAjYPCLTWHATYKI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCoLiOf0uTq2Z2WuiHhFF5QWzvVOTU_LMIOztp9zcT4g&oe=6B030E1A"}, {"file_name": "Novo Projeto (2).png", "id": "4459709317679559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828038_4459709321012892_7378784446390920699_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IZ18W75-DUQ7kNvwH1jH69&_nc_oc=Ado9nn3gxYdmwmhA_H3H-IPB3_omq3rmfAshE_lZXNqHbMU79pq5UW2XOmgco-nfP0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrSqTz6K8cz-8l4y3M27fXUunND6i4gPucTrs_Oi_kdQ&oe=6B030BB1"}, {"file_name": "Novo Projeto (9).png", "id": "1634766814279124", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823341_1634766817612457_2404291738291085565_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIb9TlZFVVAQ7kNvwE2151r&_nc_oc=AdpsIo9u3kXXtk0Bc-u-VxdXuM0KU4q_rZp4NNr7oR0SzhY1bLSOBNCGZwoRgUh64CA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYOWQPNbyYcRXxFbRwz5_WFb2ArfT9MhJ_Kj7--0vRoA&oe=6B03333E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bloop!", "keywords": ["puzzle", "maze", "casual", "fun", "relaxing"], "long_description": "# BLOOP!\n\nReach out and pick up a floating maze. Turn it. Tilt it. Hold it close to study the path then guide Bloop, your little bouncing blob, tile by tile to the glowing finish. BLOOP is a cozy, brain-teasing VR puzzler built around one simple joy: a whole little world that lives in your hands.\n\n# Comfortable, Always\n\nYou never move your own body through space, you just move a ball on a board floating in front of you:\n\n- Great **seated or standing**\n- Perfect for a **5-minute break or a long, quiet hour**\n- Easy to learn, gently trickier as you go\n\n# How You Play\n\n1. Reach out and **grab** the floating maze \u2014 by hand or laser pointer\n2. **Turn and tilt** it to read the route from any angle\n3. Guide Bloop tile-by-tile to **collect every diamond**\n4. Reach the **glowing finish portal** before your **energy** runs out\n\nEvery step costs a little energy; energy orbs top you back up. Tactile, chill, and quietly tricky.", "short_description": "Hold a maze in your hands. Tilt, study, solve. Cozy VR puzzling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://oceanrootproductions.com/bloop/privacy", "developer_terms_of_service_url": "https://oceanrootproductions.com/bloop/terms", "publisher_name": "OceanRoot Productions", "support_website_url": null, "website_url": "https://oceanrootproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
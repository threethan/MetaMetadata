d5-1.oculuscdn.com/v/t64.5771-25/491825503_1572443647841060_3801337003780547294_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vr1QTZZ5SOsQ7kNvwFekdW7&_nc_oc=AdpAl-Wp_vPo91Hme9SjkhmW9Ya6IDY6O-pFWrumWD60U3JQC8eZenU6H5Uyc333F38&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKByDs7VHGqAjlFNo0DP7Vs1ef8Esey-a9Y-RUWlgtawA&oe=6A9970A3"}, {"file_name": "Novo Projeto (11).png", "id": "904199846044577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825462_904199849377910_6067196221708560636_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHpGkgBxHZYQ7kNvwGjjS0P&_nc_oc=Adp2Lf16Gt24zCQFo_RmvPTlpNMhokhTKmmLDtR2NeefzxCUB6tgEDfUKVJXylf8dMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKh9o9QEAKenM3xx6CRQ8QSG_cnqDw468WUjTJaf3ZUSQ&oe=6A99961A"}, {"file_name": "Novo Projeto (2).png", "id": "4459709317679559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_4459709321012892_7378784446390920699_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_X9-g7__-pcQ7kNvwFYim7a&_nc_oc=Adqd6ishfR5qeJKehuI50l-NYsU5oCSnJTJF33OYm-7YNvxrA-_t0cycyj3bTvJyksY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzdwy7Jbl7qMTOrS-ShECXlm2lMmVvIqYNSLxpVwy5IQ&oe=6A9993B1"}, {"file_name": "Novo Projeto (9).png", "id": "1634766814279124", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_1634766817612457_2404291738291085565_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3WuGgXtLKQQ7kNvwEcysSW&_nc_oc=AdrYGETtqG2B_dVM19wHgBBQeAFzCZiR1LL7iwtBn5c1YwZqTNgaWYb4Sf0xXT-78TQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp5bz75M72EKOCtp0JT2fqczUzR4dWsTfF3EAOwbNnZQ&oe=6A9982FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bloop!", "keywords": ["puzzle", "maze", "casual", "fun", "relaxing"], "long_description": "# BLOOP!\n\nReach out and pick up a floating maze. Turn it. Tilt it. Hold it close to study the path then guide Bloop, your little bouncing blob, tile by tile to the glowing finish. BLOOP is a cozy, brain-teasing VR puzzler built around one simple joy: a whole little world that lives in your hands.\n\n# Comfortable, Always\n\nYou never move your own body through space, you just move a ball on a board floating in front of you:\n\n- Great **seated or standing**\n- Perfect for a **5-minute break or a long, quiet hour**\n- Easy to learn, gently trickier as you go\n\n# How You Play\n\n1. Reach out and **grab** the floating maze \u2014 by hand or laser pointer\n2. **Turn and tilt** it to read the route from any angle\n3. Guide Bloop tile-by-tile to **collect every diamond**\n4. Reach the **glowing finish portal** before your **energy** runs out\n\nEvery step costs a little energy; energy orbs top you back up. Tactile, chill, and quietly tricky.", "short_description": "Hold a maze in your hands. Tilt, study, solve. Cozy VR puzzling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://oceanrootproductions.com/bloop/privacy", "developer_terms_of_service_url": "https://oceanrootproductions.com/bloop/terms", "publisher_name": "OceanRoot Productions", "support_website_url": null, "website_url": "https://oceanrootproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1185448217983214"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1704752877390038"}]}, "baseline_o
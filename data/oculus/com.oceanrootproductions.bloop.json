ntent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825503_1572443647841060_3801337003780547294_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=monJ0NPM6EEQ7kNvwEL0BH5&_nc_oc=AdpINhErpSwPpG_mIEAGYDelO7x5KGLM_giKvGHc97dit0qzpgXva1VbaTQI3I1n3M0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI8IUkjCDPp5iipzSc3MqDs9xkYIb51bof6NX-JSnW_w&oe=6A8EE4A3"}, {"file_name": "Novo Projeto (11).png", "id": "904199846044577", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825462_904199849377910_6067196221708560636_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9rlp1o76wkQ7kNvwFTi4nO&_nc_oc=AdpGtIVTdFSHOqp6TfTmXvkZCUZpvVxtT7SqtcxZl3gshBetrnnqxzY0ipAWGw5wWtU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCQoaA6Z1hTnbxC0cBYS4N5RJ76_B9-_vCXkzmOuv17A&oe=6A8ED1DA"}, {"file_name": "Novo Projeto (2).png", "id": "4459709317679559", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828038_4459709321012892_7378784446390920699_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwjM_-GR7T4Q7kNvwHRfoQs&_nc_oc=AdpVovMRIzak68vJnTFTOYlXUOYcCndKl-e2YjeVCq1hzTUP7AeQE8GFdJK2u86s1j8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl_5VNt12RHw0ch96JsSeZe0KGOnTFa0a8KeXIhD0D5A&oe=6A8ECF71"}, {"file_name": "Novo Projeto (9).png", "id": "1634766814279124", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823341_1634766817612457_2404291738291085565_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLKnFWG5v8UQ7kNvwHIWuvP&_nc_oc=Ado4DV7-v328IeJ9vBGMi4DAgFbNYeu2XAc8YvEbv5quddOtqrm8GuaHb5cpAy6JU8U&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8BTIIqbfcfJrRAduewX1skcX0X_nSJgdibamzijYUlg&oe=6A8EBEBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bloop!", "keywords": ["puzzle", "maze", "casual", "fun", "relaxing"], "long_description": "# BLOOP!\n\nReach out and pick up a floating maze. Turn it. Tilt it. Hold it close to study the path then guide Bloop, your little bouncing blob, tile by tile to the glowing finish. BLOOP is a cozy, brain-teasing VR puzzler built around one simple joy: a whole little world that lives in your hands.\n\n# Comfortable, Always\n\nYou never move your own body through space, you just move a ball on a board floating in front of you:\n\n- Great **seated or standing**\n- Perfect for a **5-minute break or a long, quiet hour**\n- Easy to learn, gently trickier as you go\n\n# How You Play\n\n1. Reach out and **grab** the floating maze \u2014 by hand or laser pointer\n2. **Turn and tilt** it to read the route from any angle\n3. Guide Bloop tile-by-tile to **collect every diamond**\n4. Reach the **glowing finish portal** before your **energy** runs out\n\nEvery step costs a little energy; energy orbs top you back up. Tactile, chill, and quietly tricky.", "short_description": "Hold a maze in your hands. Tilt, study, solve. Cozy VR puzzling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://oceanrootproductions.com/bloop/privacy", "developer_terms_of_service_url": "https://oceanrootproductions.com/bloop/terms", "publisher_name": "OceanRoot Productions", "support_website_url": null, "website_url": "https://oceanrootproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1185448217983214"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1704752877390038"}]
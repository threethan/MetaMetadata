d5-1.oculuscdn.com/v/t64.5771-25/491825503_1572443647841060_3801337003780547294_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWlWM7zEW_oQ7kNvwG52VSy&_nc_oc=AdruT0YwIMqvY31vK5HRgMUY4IYGRHFoAKAa1ovUo8AnFvYdoXsniGeT4T4_twamHwQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW8wnd4tP3UBe50EESA1WJ0nehTGqJCesKbCyqX-ML9Q&oe=6AF4A063"}, {"file_name": "Novo Projeto (11).png", "id": "904199846044577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825462_904199849377910_6067196221708560636_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jV1EPxPf7JoQ7kNvwHUikSb&_nc_oc=AdrDPJKJ1hZ3xZl-C93abZTOfLFgX9hRWDTHe_Th1432LLvVK6mY8KLX6ep1-g7OE00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS83Pv5y0WgOwHQbW23St6-kYsBiEquNa-6MA3Ec8lqg&oe=6AF48D9A"}, {"file_name": "Novo Projeto (2).png", "id": "4459709317679559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_4459709321012892_7378784446390920699_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w15mtphMD_YQ7kNvwHl0guO&_nc_oc=AdpWnyztgWnO97ku5mYwm3l951IN4Vct3J0its9-Lv2-eSISA6LHCCg_23C3PMIdYuQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLy5KakcUfPgXah5ALh53dNJHXxdjLx7MYo7v0GrLrhQ&oe=6AF48B31"}, {"file_name": "Novo Projeto (9).png", "id": "1634766814279124", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_1634766817612457_2404291738291085565_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0GppJrboUoQ7kNvwFyKn27&_nc_oc=AdqqrOsV8eQEwD5thnrTXG14zgoDrO9qrulqqG7ZLtchZHkSozyLilXis5MRJJldfOc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzMEOYd-4QqTGOqGklCAWDYCzp9BQ6hsdyMwaAAT19tw&oe=6AF47A7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bloop!", "keywords": ["puzzle", "maze", "casual", "fun", "relaxing"], "long_description": "# BLOOP!\n\nReach out and pick up a floating maze. Turn it. Tilt it. Hold it close to study the path then guide Bloop, your little bouncing blob, tile by tile to the glowing finish. BLOOP is a cozy, brain-teasing VR puzzler built around one simple joy: a whole little world that lives in your hands.\n\n# Comfortable, Always\n\nYou never move your own body through space, you just move a ball on a board floating in front of you:\n\n- Great **seated or standing**\n- Perfect for a **5-minute break or a long, quiet hour**\n- Easy to learn, gently trickier as you go\n\n# How You Play\n\n1. Reach out and **grab** the floating maze \u2014 by hand or laser pointer\n2. **Turn and tilt** it to read the route from any angle\n3. Guide Bloop tile-by-tile to **collect every diamond**\n4. Reach the **glowing finish portal** before your **energy** runs out\n\nEvery step costs a little energy; energy orbs top you back up. Tactile, chill, and quietly tricky.", "short_description": "Hold a maze in your hands. Tilt, study, solve. Cozy VR puzzling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://oceanrootproductions.com/bloop/privacy", "developer_terms_of_service_url": "https://oceanrootproductions.com/bloop/terms", "publisher_name": "OceanRoot Productions", "support_website_url": null, "website_url": "https://oceanrootproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1185448217983214"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1704752877390038"}]}, "baseline_o
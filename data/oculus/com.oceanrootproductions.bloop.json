uscdn.com&_nc_ss=7f30f&oh=00_AQTQ0Nxt9XEcbCiJzd5KoUEIW4WA-wsZPVIqzaMK-wJh0A&oe=6B0B389B"}, {"file_name": "Novo Projeto (7).png", "id": "1572443644507727", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825503_1572443647841060_3801337003780547294_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-J42AL-7LVcQ7kNvwHbpYjY&_nc_oc=Ado4QluyFCGmFTbVSw4P860bquqGlZUGXiQgNgqkEj1jpKDAMgx46qbtUWbI8MSvzlo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQShX0BeHNE4J-OyZN_30xW8xKDpAuWbsd1SUHZ4fnvX3Q&oe=6B0B4223"}, {"file_name": "Novo Projeto (11).png", "id": "904199846044577", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825462_904199849377910_6067196221708560636_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBAGSztAchIQ7kNvwG2xZ4b&_nc_oc=AdoJ6OsCQVr-e5u8YHUEpS6u1aAZhT3BMeLFe4KGGMqdJ4dnn8y23atymXXqZHtpWVM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTIRb2Q9VZChFPDWdR2h6ykfpzTwyw4dim18TZMf4xugQ&oe=6B0B2F5A"}, {"file_name": "Novo Projeto (2).png", "id": "4459709317679559", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491828038_4459709321012892_7378784446390920699_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cWopN4aRj8Q7kNvwEM9peJ&_nc_oc=AdqQIPs1v7Epbm8oc9niP06gY3RUqYvXs9gITiaN6s6NJxzDRnpw2yzytUQLCVab_xY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_vg3jP4yEg4pOa8UOZMTUkK8CnqPWyVKzBEBqeDK0Nw&oe=6B0B2CF1"}, {"file_name": "Novo Projeto (9).png", "id": "1634766814279124", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823341_1634766817612457_2404291738291085565_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbGkFjjZ3L0Q7kNvwEUEIML&_nc_oc=AdqBXWy8mWgD_ENobNX2GfWpMsld7n7PzQ7tgtLanVlb-jdGkYoAV4EGs-hfoBrtfJs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSorK4CB_2WATuyToXkdyWMr_W-aOnw2WLn0w0DiFPw9g&oe=6B0B1C3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bloop!", "keywords": ["puzzle", "maze", "casual", "fun", "relaxing"], "long_description": "# BLOOP!\n\nReach out and pick up a floating maze. Turn it. Tilt it. Hold it close to study the path then guide Bloop, your little bouncing blob, tile by tile to the glowing finish. BLOOP is a cozy, brain-teasing VR puzzler built around one simple joy: a whole little world that lives in your hands.\n\n# Comfortable, Always\n\nYou never move your own body through space, you just move a ball on a board floating in front of you:\n\n- Great **seated or standing**\n- Perfect for a **5-minute break or a long, quiet hour**\n- Easy to learn, gently trickier as you go\n\n# How You Play\n\n1. Reach out and **grab** the floating maze \u2014 by hand or laser pointer\n2. **Turn and tilt** it to read the route from any angle\n3. Guide Bloop tile-by-tile to **collect every diamond**\n4. Reach the **glowing finish portal** before your **energy** runs out\n\nEvery step costs a little energy; energy orbs top you back up. Tactile, chill, and quietly tricky.", "short_description": "Hold a maze in your hands. Tilt, study, solve. Cozy VR puzzling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://oceanrootproductions.com/bloop/privacy", "developer_terms_of_service_url": "https://oceanrootproductions.com/bloop/terms", "publisher_name": "OceanRoot Productions", "support_website_url": null, "website_url": "https://oceanrootproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
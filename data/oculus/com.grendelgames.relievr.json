MhFha_5qcY6sRRzMY6yMK5zRHgH9XPaK7ODB5WMl4FSl6XJLVTXGroTXcmGHOj4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbkCRkp3kQJpcxXfwM7tLcDQk0d2fzvpkr9kMhwApXtw&oe=6B031C41"}, {"file_name": "migrated_image.png", "id": "2486348078298761", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001714_2569213943311287_7931789389997277184_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwEOxT6nPNsQ7kNvwHntDqO&_nc_oc=AdqAF4YVxMadwCi9nLcVueZWQBrI86xwgdIOiNvWCNXCRN_qEGVR_YLJpy6sQO-U_t0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZBn5JgpEzvTJNeu40xfYXR9tVrjsRUGSBy1RrGx_hKg&oe=6B031FAB"}, {"file_name": "migrated_image.png", "id": "205330327468352", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75196218_557072108172398_3755362628726161408_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Js07wEBw0C8Q7kNvwFxRyiX&_nc_oc=Adok5zO9R6as0MZsvLf97H-mEggpIUmoLXhhHiJ7Ppq8VJQV-N2E9zxJ3gE5aF51GG4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy6WRChJlelBIZYJXPFgfKQhZcjIhd7TdcugSNsfWoOg&oe=6B032CE2"}, {"file_name": "migrated_image.png", "id": "1141569136177559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75334062_789324258203095_584177331065585664_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwY2ZuhJ7UoQ7kNvwHY47tL&_nc_oc=AdrC-eP_-x0ivdIZEZ6uNJ4bN8HalqfHT22j4mnWT6kNOKEusD5acsaVXZSL7BhoSvM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmIDPBr_y6a-7EvqyDSAeA0wTiwa0RAykfC-H7h1QD3g&oe=6B0305E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75221313_1088812442381038_4237614272976297770_n.png", "id": "7739191896132695", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036619_7739191899466028_3793302328923439514_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tesmaiyw6J4Q7kNvwEMhUul&_nc_oc=Adow91ff1qg2VBNyVFUf9FEAVDiLwnal_6iYVgviLQR-Xh-4WYa4t9HwzJYDoKe-_I0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJeOBLfkxdD8VyqfS2lVuelc2WKDU7PCfju657ybIDzg&oe=6B03033F"}, "display_name": "Reducept for Oculus Go", "keywords": ["pain", "management", "education", "chronic", "therapy"], "long_description": "Reducept is an application that helps you reduce chronic pain by training your brain. Through the medium Virtual Reality, you will be guided through the nervous system of your body. During this journey, you learn how pain works and where it comes from. Along the path, you will complete exercises that train your brain to gain control over your pain. Get ready for the journey and take control of your pain yourself. How to create an account? Firstly visit https://reducept.com/order-1 and select your preferred package method. Secondly, complete the registration and wait for an email from us. Finally, enter your email details in the pop-up paywall to unlock the rest of the game.\nNOTE: Reducept is suitable for everyone with chronic pain. To get a Reducept license, users are prompted to sign up on our website with one of two following payment methods: \u20ac 149/year or \u20ac 14,95/month.", "short_description": "Reducept is the ideal guide to chronic pain reduction. Check out the full description to learn more about the science and research behind Reducept!"}, {"images": {"nodes": []}, "id": "453309283922163", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Reducept voor Oculus Go", "keywords": ["pijn", "educatie", "chronische", "therapie", "behandeling"], "long_description": "Reducept is een applicatie die je helpt bij het verminderen van chronische pijn door je hersenen te trainen. Via het medium Virtual Reality word je door het zenuwstelsel van je lichaam geleid. Tijdens deze reis leer je hoe pijn werkt en waar het vandaan komt. Je doet oefeningen die je hersenen trainen om controle te krijgen over je pijn. Maak je klaar voor de reis en neem zelf de controle over je pijn. Hoe maak je een account aan? Ga eerst naar https://reducept.com/order-1 en selecteer de gewenste pakketmethode. Ten tweede, voltooi de registratie en wacht op een e-mail van ons. Voer ten slotte de e-mailgegevens in de pop-up paywall in om de rest van het spel te ontgrendelen.\nOPMERKING: Reducept is geschikt voor iedereen met chronische pijn. Om een \u200b\u200bReducept-licentie te ontvangen, worden gebruikers gevraagd zich aan te melden op onze website met een van de twee optionele betaalmethoden: \u20ac 149 / jaar of \u20ac 14,95 / maand", "short_description": "Reducept is de ideale gids voor chronische pijnvermindering. Bekijk de volledige beschrijving voor meer informatie over het onderzoek achter Reducept!"}]}, "developer_name": "Reducept BV", "developer_privacy_policy_url": "https://www.reducept.nl/privacyverklaring", "developer_terms_of_service_url": null, "publisher_name": "Reducept BV", "support_website_url": null, "website_url": "https://reducept.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "PUZZLE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7684355364961046"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982488_2349934731788713_8221862706550931456_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zznTyR9YcOMQ7kNvwH1-mUA&_nc_oc=Adru2BorUVrZZ-VbfBr9ekQ62-IXfKne_epKBYf86gCu1s13F0pMwuplb0_EY0FQqbw&_nc_zt=
98ijwf-hkjVJhX9u8gDmAsfNVHHUq0OFQ30pIyb8mlLWfpxpItAT0sX-Ile93W8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTnaqGyTXyRpEJOcyk39e5o01nbZ3n8qfptA08eg6l-FA&oe=6B0B3D81"}, {"file_name": "migrated_image.png", "id": "2486348078298761", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001714_2569213943311287_7931789389997277184_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsiUQM5MiI8Q7kNvwHOpPgC&_nc_oc=Adp7ivgvlX2lInq9TR4LJdN-BR7_rMM6yuQGnT7j6OY9MHlrJ98fjKNUfjoFJtcYmDw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR6VyGBugg8fiZAxp_7kU54rPH3c9g7VIDF05Ib4wgeKA&oe=6B0B40EB"}, {"file_name": "migrated_image.png", "id": "205330327468352", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75196218_557072108172398_3755362628726161408_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIiMWppIj5kQ7kNvwF1-OuI&_nc_oc=AdplQjmV3WQCSei5KDPJDZL_DLEzZbl9GdylWfAuflie5XSLsKpHrPKFedVTemvuGcc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRHv3dRAR4H20HAP3mTt0x4iNNF4ULIz9h9Tw9Kq-74cQ&oe=6B0B15E2"}, {"file_name": "migrated_image.png", "id": "1141569136177559", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75334062_789324258203095_584177331065585664_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoTWYb4w0OQQ7kNvwH9pmx4&_nc_oc=AdqPLmdlvGTYkOirMAHHqpVuxNISOVpJpO5-G6OBtbFmJ046ZWXoTrA_7dVFDCNC2Rg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSRPnEsVr3tbrgPlWBRhviIpLSQBmqmiFc32LlcXrxDA&oe=6B0B2727"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75221313_1088812442381038_4237614272976297770_n.png", "id": "7739191896132695", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036619_7739191899466028_3793302328923439514_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AH1-DpL7NA8Q7kNvwEq32nX&_nc_oc=AdoF7upbOm7bAEY-NfRYbbKn4SLuu6yeVR_YrlmQID1a-gmnl8XjQSjIxabeGGZVKpc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1WDpqy6aBt3boaydgxRJ4KwE9xqiXQaUjz6mhZFMcGQ&oe=6B0B247F"}, "display_name": "Reducept for Oculus Go", "keywords": ["pain", "management", "education", "chronic", "therapy"], "long_description": "Reducept is an application that helps you reduce chronic pain by training your brain. Through the medium Virtual Reality, you will be guided through the nervous system of your body. During this journey, you learn how pain works and where it comes from. Along the path, you will complete exercises that train your brain to gain control over your pain. Get ready for the journey and take control of your pain yourself. How to create an account? Firstly visit https://reducept.com/order-1 and select your preferred package method. Secondly, complete the registration and wait for an email from us. Finally, enter your email details in the pop-up paywall to unlock the rest of the game.\nNOTE: Reducept is suitable for everyone with chronic pain. To get a Reducept license, users are prompted to sign up on our website with one of two following payment methods: \u20ac 149/year or \u20ac 14,95/month.", "short_description": "Reducept is the ideal guide to chronic pain reduction. Check out the full description to learn more about the science and research behind Reducept!"}, {"images": {"nodes": []}, "id": "453309283922163", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Reducept voor Oculus Go", "keywords": ["pijn", "educatie", "chronische", "therapie", "behandeling"], "long_description": "Reducept is een applicatie die je helpt bij het verminderen van chronische pijn door je hersenen te trainen. Via het medium Virtual Reality word je door het zenuwstelsel van je lichaam geleid. Tijdens deze reis leer je hoe pijn werkt en waar het vandaan komt. Je doet oefeningen die je hersenen trainen om controle te krijgen over je pijn. Maak je klaar voor de reis en neem zelf de controle over je pijn. Hoe maak je een account aan? Ga eerst naar https://reducept.com/order-1 en selecteer de gewenste pakketmethode. Ten tweede, voltooi de registratie en wacht op een e-mail van ons. Voer ten slotte de e-mailgegevens in de pop-up paywall in om de rest van het spel te ontgrendelen.\nOPMERKING: Reducept is geschikt voor iedereen met chronische pijn. Om een \u200b\u200bReducept-licentie te ontvangen, worden gebruikers gevraagd zich aan te melden op onze website met een van de twee optionele betaalmethoden: \u20ac 149 / jaar of \u20ac 14,95 / maand", "short_description": "Reducept is de ideale gids voor chronische pijnvermindering. Bekijk de volledige beschrijving voor meer informatie over het onderzoek achter Reducept!"}]}, "developer_name": "Reducept BV", "developer_privacy_policy_url": "https://www.reducept.nl/privacyverklaring", "developer_terms_of_service_url": null, "publisher_name": "Reducept BV", "support_website_url": null, "website_url": "https://reducept.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "PUZZLE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7684355364961046"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982488_2349934731788713_8221862706550931456_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlKSBQH1YJoQ7kNvwFHu0Fm&_nc_oc=Adq80y6ldSb_LQ_YF35jq6DhNgT9HY1lcZlaW9iu5ODcDr764pdyl3kmk-zLx-VJA04&_nc_zt=
45", "locale": "en_US", "screenshots": [{"file_name": "screenshot_5.png", "id": "935035569629033", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499293825_935035572962366_2678812588949091124_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulhgUkbe5XIQ7kNvwGKkL6b&_nc_oc=Adq6NlzHqB6422orATHMMDaNzwAhMK6YULQ334wdI2wh8aUdvNAVi2nqMIK8eGDlYF8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCmfU_Uzs912ht9WSih24juvbEWrixHFfcihzkmPQKjg&oe=6AA00412"}, {"file_name": "screenshot_4.png", "id": "982368444806479", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619374_982368448139812_8828862456287516652_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMsISpCBBX8Q7kNvwEAkwmA&_nc_oc=Adps7wbNXCEB8gbhaj_Ip_QzYaCNEWZuJD5dXfyjBLfQ6z59RH24JaXIp2ExDCpAXS0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEgrzEu7-KYFZ-gOeVybkDqVB0QFjznCVSJFz-DZih9g&oe=6AA01C57"}, {"file_name": "screenshot_3.png", "id": "2088740271676989", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499299876_2088740278343655_7955664210636749399_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIDgeVd5moEQ7kNvwHVFS7I&_nc_oc=AdoGw171LPvRxjZvN29MOUNDX2OQFlCWezQdF7-hqx3OHDkFwwwnK2X6KJBNEFdZ7r4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBJ-TPulKyzLe6WXVDopnJaOLQLeWOIXgR7RbvNqE3rQ&oe=6AA00BB0"}, {"file_name": "screenshot_2.png", "id": "1587636436263716", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298587_1587636439597049_1165678386031828450_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3oE9K7YvgEQ7kNvwE8Y3Ai&_nc_oc=Adp6Izt-eGpMLDb8gdC_hgnCwTdkO8yXQh_Zp6G2sAh5h5wDNMcVBC7aGakn1HG5WD0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi2wO4YcU08CubzcWpaoMqUagpFf-FD08Tz1SzCeJREg&oe=6AA00454"}, {"file_name": "screenshot_1.png", "id": "1529309518652664", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499300725_1529309521985997_5349865467943186168_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uG42ZTytxHYQ7kNvwEKx9Dp&_nc_oc=AdrpQVrfNLFdy0ihbUDjXFXR0zfJ-5euM8JeC97D-1NDrVLD0klGOwjyFdbP92CuDJE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrDMxSs03shYy6NXO1yY6LTZLp-zVxUlmoh3rYf6mlYg&oe=6AA01EE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Real Table Tennis", "keywords": [], "long_description": "Real Table Tennis brings the feel of a real table into your room. Every bounce, every brush of spin and every smash comes from a physics simulation running at 120 Hz \u2014 the ball behaves the way you expect because it follows the same rules as the real thing.\n\nRally freely in Practice mode, or step into Match mode with complete ITTF rules: proper service rotation, lets, deuce and best-of-3 to best-of-7 games.\n\nThe AI opponent doesn't cheat and doesn't play like a robot. Four difficulty levels \u2014 Easy, Normal, Hard and Pro \u2014 model human reactions and human mistakes. Force a fast, wide return and even a strong opponent can miss, just like a real player.\n\nDesigned for comfort: you stand at a virtual table matched to your real height, with no artificial locomotion. Calibrate your height and table position in seconds, then play a quick rally or a whole match.\n\nFeatures:\n\u2022 Physics-first ball simulation at 120 Hz \u2014 real spin, real bounces\n\u2022 Practice mode for free play\n\u2022 Match mode with full ITTF rules (11-point games, service rotation, lets, deuce)\n\u2022 Four human-like AI difficulty levels\n\u2022 Player height and table height calibration\n\u2022 Comfortable standing play with no locomotion\n\nNew in 1.1.0: take the game online \u2014 challenge a friend to a 1v1 match over the internet or your local Wi\u2011Fi. Feel every ball strike through your controller with new impact haptics, plus refined physics for even truer spin and bounce.", "short_description": "Step up to the table. Real Table Tennis is a physics-first table tennis simulation for Quest 3 \u2014 120 Hz gameplay, true spin and bounce, and an AI opponent that plays like a human. Rally freely in Practice, or fight through full ITTF-rules matches from Easy to Pro."}]}, "developer_name": "Jaroslav Kl\u00edma", "developer_privacy_policy_url": "https://masherak.github.io/TableTennisVR/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Jaroslav Kl\u00edma", "support_website_url": null, "website_url": "https://masherak.github.io/TableTennisVR/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1124145420792299"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499301236_2909069039465252_7041674315440732788_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOC68BbbCbYQ7kNvwHsjjc4&_nc_oc=Adpk7Tp6b1tCcqosMl7tIbgEo8OJqbgSHcxNXeMPNUxw6GpqVWY0me2qDhTCgTVquL8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuCCLGCtE5DRgVLC8YYGxOfXjB8YHVUCAgAhcnnX3eoA&oe=6AA00980"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Real Table Tennis", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1784142960, "lastRevision": {"nodes": [{"id": "1107458472460994", "release_type": "SCHEDULED", "ad
.com/v/t64.5771-25/499620940_863818422793060_5994186272620352519_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lOBosTjZ_kQ7kNvwG9Nm_7&_nc_oc=AdqSqfL8qYoHrOLqzCV7epdNsdl62ZU6a_PwBqpl3didru3MpcRJUgKcnWqnSZcULu8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4s0-ClBWQvDvQFD9uIup9ZztBDov-V7yfyd3o4n_dyaA&oe=6A1C58DC"}, {"file_name": "MECHA_Screenshot_4.png", "id": "1337227934301215", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499619432_1337227937634548_1948501587571807527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5WF2tTj480Q7kNvwExB-wV&_nc_oc=Ado35LDd2PZTwrKrmDVtkrhcDuEEVCy5Ete2MxxCzz0kRNpIMHl6SgMSIHl7eI3Ql0E&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VZPqQ1fGfga2aK0Tvl2oPdJkQkJL6EujOX676hRijjA&oe=6A1C5324"}, {"file_name": "MECHA_Screenshot_5.png", "id": "2374131403025348", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499619715_2374131406358681_5109830869351100948_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vE2I3MhxSOIQ7kNvwE-R5q1&_nc_oc=AdqXasJI-45DlpkFZZy6Yxw9y7nA-QiV48zyu7WLv50KSGq247G_mnfmYp_KLbQVA_8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AZYUXhKLhyXlkr2IvEqGckbNb-1yGq43Yw1iQP7oCJA&oe=6A1C3C45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MECHA_CoverArt_2560_1440.png", "id": "1155209546729805", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499619646_1155209550063138_8510117434990572236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CWMbqRuP04Q7kNvwGTMSxU&_nc_oc=AdpcieFjeu-_WFwS7PyhgE2zLRNyRBsSQVHzyEQDqBPeJbyEnUEBwetyx4ScEe8e9HY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gaeIhzgFfLGbkBpy9F93B4AV3yfi4fBpgBq-GmtZWRQ&oe=6A1C4D4F"}, "display_name": "MECHA", "keywords": ["mech", "robot", "shooter", "scifi", "action"], "long_description": "You didn\u2019t just buy a headset. You bought the keys to a **200-TON FLYING MECH**. \n\nFight for glory in the Mecha League - the ultimate VR combat sport. Built for the Meta Quest, **MECHA** delivers **EXPLOSIVE ARENA BATTLES** with **HIGH-SPEED AERIAL COMBAT**, and a full career mode with sponsors, tournaments, upgrades, and rival pilots.\n\nRise through the ranks, customize your mecha, and carve your name into the league with every thunderous win.  \n\n# BECOME THE ULTIMATE PILOT\n\nMaster the **lean movement** system, using your body to strafe, dash, and weave through fire. Combat demands both **precision aim** and **smart defense**: line up your shots, then raise your arm to deploy a shield that blocks incoming fire. \n\nWhen the moment strikes, trigger the **Gigaform** to triple your size and dominate the arena as a towering titan. \n\n# DOMINATE THE LEAGUE\n\nClimb the ladder from Rookie to All-Star by winning **tournaments**. Enemies you dominate evolve into **top rivals** with massive cash bounties on their heads. Impress corporate sponsors by **completing high-stakes missions** that can yield massive payouts. \n\n# YOUR MECH, YOUR RULES \n\n- **6 Game Modes:** Dominate in Deathmatch, outlast the competition in Survival, hunt the giant in Juggernaut, or squad up and take the win in team modes. \n- **Visual Customization:** Personalize your mech with custom paint schemes and adjustable neon emissive glows. \n- **Mod System:** Fine-tune your loadout with an upgrade system where every mod offers strategic trade-offs.", "short_description": "You didn\u2019t just buy a headset. You bought the keys to a 200-TON FLYING MECH. \n\nFight for glory in the Mecha League - the ultimate VR combat sport. Built for the Meta Quest, MECHA delivers EXPLOSIVE ARENA BATTLES with HIGH-SPEED AERIAL COMBAT, and a full career mode with sponsors, tournaments, upgrades, and rival pilots.  \n\nRise through the ranks, customize your mecha, and carve your name into the league with every thunderous win."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.playmechavr.com/privacy-policy", "developer_terms_of_service
sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXCX-TX925hRqMCiXE-iIgvUmJvCvF7X1mASLRI_xeyQ&oe=6AFC7A04"}, {"file_name": "MECHA_Screenshot_3.png", "id": "863818416126394", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620940_863818422793060_5994186272620352519_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aR4HNdERqJcQ7kNvwFlmZ1q&_nc_oc=AdpwJYCMNxte6U_9ut1GznsIUAiR-RvuhUM0Hmla2vMkld7HOcsKlurO3t-doZqL8mQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT55EnW9wAM6tBuBPG2ubIAVukIh6qe1giZ5p8e35p29A&oe=6AFC77DC"}, {"file_name": "MECHA_Screenshot_4.png", "id": "1337227934301215", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619432_1337227937634548_1948501587571807527_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-KWSCZAxUgQ7kNvwHtPPw1&_nc_oc=AdrHYQ2xrLwNhnZOM7CL2drS-nS1mbZYC_MqCtlbneAPJY5_6PDoblyzGB5GDh23DVQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7ueKYrJpEGChdjDFWeryBt-H-rTv0MLOHo6jG4GdUFQ&oe=6AFC7224"}, {"file_name": "MECHA_Screenshot_5.png", "id": "2374131403025348", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619715_2374131406358681_5109830869351100948_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lm4vJd7ccQgQ7kNvwG1CEtO&_nc_oc=AdqqYCZ3Qf3EUDBfZ-hGcu3hojMBs8RLUyLgIlPxgTZxz0um_RSY40igqDFOU-HObFI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeynSs8Venu9JwjBjAlO8aZcHosjBRmRhs6xB0zI5WiQ&oe=6AFC9385"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MECHA_CoverArt_2560_1440.png", "id": "1155209546729805", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619646_1155209550063138_8510117434990572236_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Io0Bowpkl70Q7kNvwHyc_0_&_nc_oc=AdrydoRmsEcLfTRFNldnbqcxr-vx6rkq89zN-3ylSe8O3jXJIU1cux_B7Lkek458bTM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXc_EiJecV4F3H5FQdhqHCUsgNcAT_hIjzyFbw-yx3EQ&oe=6AFC6C4F"}, "display_name": "MECHA", "keywords": ["mech", "robot", "shooter", "scifi", "action"], "long_description": "You didn\u2019t just buy a headset. You bought the keys to a **200-TON FLYING MECH**. \n\nFight for glory in the Mecha League - the ultimate VR combat sport. Built for the Meta Quest, **MECHA** delivers **EXPLOSIVE ARENA BATTLES** with **HIGH-SPEED AERIAL COMBAT**, and a full career mode with sponsors, tournaments, upgrades, and rival pilots.\n\nRise through the ranks, customize your mecha, and carve your name into the league with every thunderous win.  \n\n# BECOME THE ULTIMATE PILOT\n\nMaster the **lean movement** system, using your body to strafe, dash, and weave through fire. Combat demands both **precision aim** and **smart defense**: line up your shots, then raise your arm to deploy a shield that blocks incoming fire. \n\nWhen the moment strikes, trigger the **Gigaform** to triple your size and dominate the arena as a towering titan. \n\n# DOMINATE THE LEAGUE\n\nClimb the ladder from Rookie to All-Star by winning **tournaments**. Enemies you dominate evolve into **top rivals** with massive cash bounties on their heads. Impress corporate sponsors by **completing high-stakes missions** that can yield massive payouts. \n\n# YOUR MECH, YOUR RULES \n\n- **6 Game Modes:** Dominate in Deathmatch, outlast the competition in Survival, hunt the giant in Juggernaut, or squad up and take the win in team modes. \n- **Visual Customization:** Personalize your mech with custom paint schemes and adjustable neon emissive glows. \n- **Mod System:** Fine-tune your loadout with an upgrade system where every mod offers strategic trade-offs.", "short_description": "You didn\u2019t just buy a headset. You bought the keys to a 200-TON FLYING MECH. \n\nFight for glory in the Mecha League - the ultimate VR combat sport. Built for the Meta Quest, MECHA delivers EXPLOSIVE ARENA BATTLES with HIGH-SPEED AERIAL COMBAT, and a full career mode with sponsors, tournaments, upgrades, and rival pilots.  \n\nRise through the ranks, customize your mecha, and carve your name into the league with every thunderous win."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.playmechavr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hyperlight VR LLC", "support_website_url": null, "website_url": "https://playmechavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26051206307802330"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1420370496828286"}, {"status": "PUBLISHED", "id": "1377311327361189"}, {"status": "PUBLISHED", "id": "2003482990360262"}, {"status": "PUBLISHED", "id": "1564627658548250"}, {"status": "PUBLISHED", "id": "1223363759243917"}, {"status": "PUBLISHED", "id": "907978452232541"}, {"status": "CANCELLED", "id": "4144631815785515"}, {"status": "PUBLISHED", "id": "1769080750418079"}, {"status": "PUBLISHED", "id": "891025723349386"}, {"status": "PUBLISHED", "id": "722845204236160"}]}, "baseline_offer": {"id": "1377311327361189"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1420370496828286"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nod
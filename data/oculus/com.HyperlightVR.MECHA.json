.com/v/t64.5771-25/499620940_863818422793060_5994186272620352519_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFDSI7OHTokQ7kNvwGuGk6g&_nc_oc=AdqSdw6tcQ4MFdksxjjZ35xxMNRuVOKawRTfne2IxvMH92Y1Q2JkRZ0qvEJCbAmEImU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TFv1d2f0DXMoUTsNjAgCYo4fyfHm4BoQw5lzckuarzw&oe=69E0CD1C"}, {"file_name": "MECHA_Screenshot_4.png", "id": "1337227934301215", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619432_1337227937634548_1948501587571807527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTNWNVAIsxIQ7kNvwHdVTkP&_nc_oc=Adop6OFkTNjY0i7ieiMZYIbjj7EqeLYqh0yeY3oG30l59ldVEUha1w8TpEMTTF0c6e8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1o-gC1ZO2ZAXMplSbke9E2G48c_w2EQlyvE3_Olf09Vg&oe=69E0FFA4"}, {"file_name": "MECHA_Screenshot_5.png", "id": "2374131403025348", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619715_2374131406358681_5109830869351100948_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7xSXblMilwQ7kNvwEhJubM&_nc_oc=AdrOKknQMjN3kvxbXjlrhz6d1XMwHEUSPRWXZrtW4n9rHnbbd7MJEcLX7iPZgagF-pM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36R2rd7B75Rl5VIRGy6-AKGahS34F669B3OqVV-h2zoA&oe=69E0E8C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MECHA_CoverArt_2560_1440.png", "id": "1155209546729805", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619646_1155209550063138_8510117434990572236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjkIACJxSmcQ7kNvwHok4uK&_nc_oc=Adpg8P9fkLkskoPxdFNm4n_KHv8J4OZxTmWqt8sZ2XZj1pA0zi2oQX18UQ_NbZW50S8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27qfnwb-x84mfPvo_F4fFdCvMHK00qYYSyOlclrW3zcw&oe=69E0F9CF"}, "display_name": "MECHA", "keywords": ["mech", "robot", "shooter", "scifi", "action"], "long_description": "You didn\u2019t just buy a headset. You bought the keys to a **200-TON FLYING MECH**. \n\nFight for glory in the Mecha League - the ultimate VR combat sport. Built for the Meta Quest, **MECHA** delivers **EXPLOSIVE ARENA BATTLES** with **HIGH-SPEED AERIAL COMBAT**, and a full career mode with sponsors, tournaments, upgrades, and rival pilots.\n\nRise through the ranks, customize your mecha, and carve your name into the league with every thunderous win.  \n\n# BECOME THE ULTIMATE PILOT\n\nMaster the **lean movement** system, using your body to strafe, dash, and weave through fire. Combat demands both **precision aim** and **smart defense**: line up your shots, then raise your arm to deploy a shield that blocks incoming fire. \n\nWhen the moment strikes, trigger the **Gigaform** to triple your size and dominate the arena as a towering titan. \n\n# DOMINATE THE LEAGUE\n\nClimb the ladder from Rookie to All-Star by winning **tournaments**. Enemies you dominate evolve into **top rivals** with massive cash bounties on their heads. Impress corporate sponsors by **completing high-stakes missions** that can yield massive payouts. \n\n# YOUR MECH, YOUR RULES \n\n- **6 Game Modes:** Dominate in Deathmatch, outlast the competition in Survival, hunt the giant in Juggernaut, or squad up and take the win in team modes. \n- **Visual Customization:** Personalize your mech with custom paint schemes and adjustable neon emissive glows. \n- **Mod System:** Fine-tune your loadout with an upgrade system where every mod offers strategic trade-offs.", "short_description": "You didn\u2019t just buy a headset. You bought the keys to a 200-TON FLYING MECH. \n\nFight for glory in the Mecha League - the ultimate VR combat sport. Built for the Meta Quest, MECHA delivers EXPLOSIVE ARENA BATTLES with HIGH-SPEED AERIAL COMBAT, and a full career mode with sponsors, tournaments, upgrades, and rival pilots.  \n\nRise through the ranks, customize your mecha, and carve your name into the league with every thunderous win."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.playmechavr.com/privacy-policy", "developer_terms_of_service
com/v/t64.5771-25/499620940_863818422793060_5994186272620352519_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMPDwZSOQoAQ7kNvwF72hpf&_nc_oc=AdprAwxCrQ5RRXYvAH1uuxZ_2PZMQ8hNgvCJZ7aCVtCuzw7WBnspmLVprl7w0sLHBBo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcH2V9g-9sH8Ww_gQSSf3JTxGF9PHYJBlgh3QBiSuVmQ&oe=6AC7BBDC"}, {"file_name": "MECHA_Screenshot_4.png", "id": "1337227934301215", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619432_1337227937634548_1948501587571807527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZan1xa5fT8Q7kNvwGi5b2Y&_nc_oc=AdoXaV9H3tCEBH1g-s2yLwlze0XfGfw8O3Z1Tw8pEJ4Nq--a9e7c3D6EXzDHO4bqseg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4CyphLhh5KUycSKNTaMV_GDBHwSvcKxAMYv5oOuZhYQ&oe=6AC7B624"}, {"file_name": "MECHA_Screenshot_5.png", "id": "2374131403025348", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619715_2374131406358681_5109830869351100948_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gX83R0UJd3AQ7kNvwEmPGSY&_nc_oc=AdrqrnQaXDHH5mymxzdREiWgMX59rBv00SkmfJY9DrF6BOVvnPD8Ap15NTrQ7x59Ey4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrLteJb9SPdYe8e9GOK3fweu8nb3SYRSU5I_rmau_tsg&oe=6AC79F45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MECHA_CoverArt_2560_1440.png", "id": "1155209546729805", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619646_1155209550063138_8510117434990572236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuQfNFTHCM8Q7kNvwE5WjS9&_nc_oc=Adpu2km6c6ldNwXM6aFSZDntyI06SickjxhgDE521BpYhyzpGZUpysQAXHSJ26-gZus&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSpfXXMx3QeywKddU_PDOazi9KpMftx-1bhiJY93UEBg&oe=6AC7B04F"}, "display_name": "MECHA", "keywords": ["mech", "robot", "shooter", "scifi", "action"], "long_description": "You didn\u2019t just buy a headset. You bought the keys to a **200-TON FLYING MECH**. \n\nFight for glory in the Mecha League - the ultimate VR combat sport. Built for the Meta Quest, **MECHA** delivers **EXPLOSIVE ARENA BATTLES** with **HIGH-SPEED AERIAL COMBAT**, and a full career mode with sponsors, tournaments, upgrades, and rival pilots.\n\nRise through the ranks, customize your mecha, and carve your name into the league with every thunderous win.  \n\n# BECOME THE ULTIMATE PILOT\n\nMaster the **lean movement** system, using your body to strafe, dash, and weave through fire. Combat demands both **precision aim** and **smart defense**: line up your shots, then raise your arm to deploy a shield that blocks incoming fire. \n\nWhen the moment strikes, trigger the **Gigaform** to triple your size and dominate the arena as a towering titan. \n\n# DOMINATE THE LEAGUE\n\nClimb the ladder from Rookie to All-Star by winning **tournaments**. Enemies you dominate evolve into **top rivals** with massive cash bounties on their heads. Impress corporate sponsors by **completing high-stakes missions** that can yield massive payouts. \n\n# YOUR MECH, YOUR RULES \n\n- **6 Game Modes:** Dominate in Deathmatch, outlast the competition in Survival, hunt the giant in Juggernaut, or squad up and take the win in team modes. \n- **Visual Customization:** Personalize your mech with custom paint schemes and adjustable neon emissive glows. \n- **Mod System:** Fine-tune your loadout with an upgrade system where every mod offers strategic trade-offs.", "short_description": "You didn\u2019t just buy a headset. You bought the keys to a 200-TON FLYING MECH. \n\nFight for glory in the Mecha League - the ultimate VR combat sport. Built for the Meta Quest, MECHA delivers EXPLOSIVE ARENA BATTLES with HIGH-SPEED AERIAL COMBAT, and a full career mode with sponsors, tournaments, upgrades, and rival pilots.  \n\nRise through the ranks, customize your mecha, and carve your name into the league with every thunderous win."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.playmechavr.com/privacy-policy", "developer_terms_of_service_
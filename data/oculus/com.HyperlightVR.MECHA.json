.com/v/t64.5771-25/499620940_863818422793060_5994186272620352519_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5ZT3YXH0d8Q7kNvwFQvxy6&_nc_oc=Ado6c0W6I2Y46Cy62eOulavOil1jMoF8MIKoqr9ODoRIbbhTU9z70EGBn-yqjU9bYGc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54cueF8i9WuEN8I_fOPFMqQvtoBY18Gi6VZB2uHdv_vg&oe=69FA11DC"}, {"file_name": "MECHA_Screenshot_4.png", "id": "1337227934301215", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619432_1337227937634548_1948501587571807527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lFandnDE7UQ7kNvwESmGF7&_nc_oc=AdrORH12w2jE0VP6LZlrz4QxE0m2qaPr2wT_K4SVzxH6hqQAQdiCNqrNT3wVS6kpTi0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QguOyk6ZFOxear2vikGsN6lfC7gjSMJSzLxFde_HlTA&oe=69FA0C24"}, {"file_name": "MECHA_Screenshot_5.png", "id": "2374131403025348", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619715_2374131406358681_5109830869351100948_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkHLPVJDCZwQ7kNvwHLRvY6&_nc_oc=AdrqKtAKdubKR-8xu1ztRnKSpPVAQJg2hQQD1EoLBEQkrQAglB_XS_TUrOKsDswvpFc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JPLvbeMGejmJYMtU_13gCWDCbMHyUlkuGg0OuxJb7gA&oe=69F9F545"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MECHA_CoverArt_2560_1440.png", "id": "1155209546729805", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619646_1155209550063138_8510117434990572236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8kBxUYqA48Q7kNvwEn0bxW&_nc_oc=AdoMyac3gnxDUAsR-RVVZobNSJS0mr5cVm5whOSW2x2PKdzPUUNsS4ekp-puQJSlI9E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AsuUq67wBpDn-IOJmSuyPiNFQBCfPv4HiYTnj_I523g&oe=69FA064F"}, "display_name": "MECHA", "keywords": ["mech", "robot", "shooter", "scifi", "action"], "long_description": "You didn\u2019t just buy a headset. You bought the keys to a **200-TON FLYING MECH**. \n\nFight for glory in the Mecha League - the ultimate VR combat sport. Built for the Meta Quest, **MECHA** delivers **EXPLOSIVE ARENA BATTLES** with **HIGH-SPEED AERIAL COMBAT**, and a full career mode with sponsors, tournaments, upgrades, and rival pilots.\n\nRise through the ranks, customize your mecha, and carve your name into the league with every thunderous win.  \n\n# BECOME THE ULTIMATE PILOT\n\nMaster the **lean movement** system, using your body to strafe, dash, and weave through fire. Combat demands both **precision aim** and **smart defense**: line up your shots, then raise your arm to deploy a shield that blocks incoming fire. \n\nWhen the moment strikes, trigger the **Gigaform** to triple your size and dominate the arena as a towering titan. \n\n# DOMINATE THE LEAGUE\n\nClimb the ladder from Rookie to All-Star by winning **tournaments**. Enemies you dominate evolve into **top rivals** with massive cash bounties on their heads. Impress corporate sponsors by **completing high-stakes missions** that can yield massive payouts. \n\n# YOUR MECH, YOUR RULES \n\n- **6 Game Modes:** Dominate in Deathmatch, outlast the competition in Survival, hunt the giant in Juggernaut, or squad up and take the win in team modes. \n- **Visual Customization:** Personalize your mech with custom paint schemes and adjustable neon emissive glows. \n- **Mod System:** Fine-tune your loadout with an upgrade system where every mod offers strategic trade-offs.", "short_description": "You didn\u2019t just buy a headset. You bought the keys to a 200-TON FLYING MECH. \n\nFight for glory in the Mecha League - the ultimate VR combat sport. Built for the Meta Quest, MECHA delivers EXPLOSIVE ARENA BATTLES with HIGH-SPEED AERIAL COMBAT, and a full career mode with sponsors, tournaments, upgrades, and rival pilots.  \n\nRise through the ranks, customize your mecha, and carve your name into the league with every thunderous win."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.playmechavr.com/privacy-policy", "developer_terms_of_service
5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzgmeNr8uNPX4wqi2JFV8Pi_ievB4arrDS5HoVFAFNMyg&oe=69B3F806"}, {"file_name": "migrated_image.png", "id": "1036542220065314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138835_1682352715382431_1646859523_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgubCpagCu0Q7kNvwGEeGBb&_nc_oc=Adl9gj_Tnd6B95VI76cAM7EgW38Y4S0M6nbXHGxjSN_uxuMzbq9BF9Fl1P8Q04s0lxA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFzwDtCC4LzL8dgsYOF8XHySRIwVoQaMt6JPMsDSSRAQ&oe=69B4089A"}, {"file_name": "migrated_image.png", "id": "2966589190115938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138836_1016651478394912_434791839_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxSyHM3mdsMQ7kNvwFNlFCU&_nc_oc=AdkJyQ-jC1YQy1fj58BTYMCVawlC9WuWu2vbDcsLFXezB6lZM-dGGDMYxyLigoQAS3s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyD7qVVtS3-_y_FRhwXBHkEUSSUHUdmTqx-e7KDtIw9JQ&oe=69B404BA"}, {"file_name": "migrated_image.png", "id": "2435267713392731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138837_1664248710509135_1718380215_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcQf_CckWYoQ7kNvwFi1S-V&_nc_oc=AdncKTnPrq_V06ruYGl2ThdVKQacMXn-pqEVutZ1F82fTPaEKKeUhK8s9UeZcTtp8Do&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyVGUdoQ5ofyB588kqI3g-nniGLxMTSpzVP38uO_gM20g&oe=69B3ECD0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMW i Samsung Virtual Reality Experience", "keywords": [], "long_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\nThe focus during test-drive is on an emotional driving experience. The user can freely configure the different BMW i3 and i8 models in an interactive way and decide his favorite exterior colors, wheels and interior design.\nLet yourself be seduced in a virtual world.\n", "short_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bmw.co.uk/en_GB/footer/imprint-overview/privacypolicy.html", "developer_terms_of_service_url": "https://www.bmw-service.co.uk/service_inclusive_terms_and_conditions", "publisher_name": "BMW AG", "support_website_url": null, "website_url": "http://www.bmw.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "448693326934547"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139059_998615653587632_1366425605_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSdGI7emo1EQ7kNvwGgVpFe&_nc_oc=Adn14K-3jtmuy1-LsTgjWTJsYNxfFOlzEs4nkJYeM1xLidavnElhURSIutmWjCKV8oU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxe1ejE-MlUuJfrKK3wtRkb83UOM2uf34T0eR8c2VsQzQ&oe=69B417A5"}, "is_con
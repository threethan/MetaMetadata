3-2.oculuscdn.com&_nc_ss=8&oh=00_Afsca0HZZ_2R7FgEKVHFGeoijYJzvDpCafQHaLKvvj7y7w&oe=69A96C06"}, {"file_name": "migrated_image.png", "id": "1036542220065314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138835_1682352715382431_1646859523_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELJRXJ4LwlcQ7kNvwEZb5Zo&_nc_oc=AdlTR3sap6UJlh3_hqrxxQityfEAd_UD2YSFLv9irYRFt9QF0QLNvk7Cv8K96yAYe9g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftLY9O3Z01cdgcbZ8TXP5uZh77L8TRTp694_uEo8pcTXw&oe=69A97C9A"}, {"file_name": "migrated_image.png", "id": "2966589190115938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138836_1016651478394912_434791839_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmy77lM5DFMQ7kNvwF8MW_Y&_nc_oc=Adn5x6gDR5DOPqKOcyc0x4L1szoLS0iHdmLOpeOPGGQAvEdnZVy7N9wSsIXC_uhRfkA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvDKTXNTmTZRXypJ4aTDWAZ77GhjaQ7H3BJRPzEzu_KDA&oe=69A978BA"}, {"file_name": "migrated_image.png", "id": "2435267713392731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138837_1664248710509135_1718380215_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MICE7tKi4C8Q7kNvwFE-OrX&_nc_oc=AdkdIIuIQCPyVPYXOnbxCOQSj39w6DiHagXY0mYFOCf1FPeJncsN__DEO2lGYip_qQw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afsm_ACBqMzHl5kcrTlfxuYrK6O1C9jMGWARWGBfoko7Tg&oe=69A960D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMW i Samsung Virtual Reality Experience", "keywords": [], "long_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\nThe focus during test-drive is on an emotional driving experience. The user can freely configure the different BMW i3 and i8 models in an interactive way and decide his favorite exterior colors, wheels and interior design.\nLet yourself be seduced in a virtual world.\n", "short_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bmw.co.uk/en_GB/footer/imprint-overview/privacypolicy.html", "developer_terms_of_service_url": "https://www.bmw-service.co.uk/service_inclusive_terms_and_conditions", "publisher_name": "BMW AG", "support_website_url": null, "website_url": "http://www.bmw.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "448693326934547"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139059_998615653587632_1366425605_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dG5acfnwOY0Q7kNvwEiVVjT&_nc_oc=AdkVgP-SkzSgDqtHf7P4coD6a2dIcnnuV97mQ1145qDl4S48q8Wq3BPNFmwa5aCXy1M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfustjXO6jvvr_NTkdLWs_kV8Eirv9a653ZkVFoWm_ilPw&oe=69A98BA5"}, "is_con
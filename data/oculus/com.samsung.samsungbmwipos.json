5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyMoaO3RDPrjMKjkr6uV9bSUiexeSxhPqVRHu0FPPUBGA&oe=69B93E06"}, {"file_name": "migrated_image.png", "id": "1036542220065314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138835_1682352715382431_1646859523_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPUbK3mLnhYQ7kNvwGNk1UA&_nc_oc=AdkpwbqCQmJv0E0RqC8MZCketBWlkQeBmFBiYMRN1XkixrYgahFxtI4SNzmBkPqk1mE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0EMRPcrXtBuQCbhdK1iMn3eM7rFXnLacgNA2ijHQ10Q&oe=69B94E9A"}, {"file_name": "migrated_image.png", "id": "2966589190115938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138836_1016651478394912_434791839_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mI9plA9WchgQ7kNvwF_6J4r&_nc_oc=AdlsRgNCO2fKkRhJKchFLn_X5PBoURCZgyg0cUVBpGeURXbf8JCzM6xfMHkjzjD0i_k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNqQSetvfhR9m297irzQW16qljfa6HUGBaLFT05Qy05g&oe=69B94ABA"}, {"file_name": "migrated_image.png", "id": "2435267713392731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138837_1664248710509135_1718380215_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJ9WLeTzZTUQ7kNvwERZ_sM&_nc_oc=AdlbC0AEes1p7ZysZb9toI0ZERu8MOVofNJ5fkSjVE_JEWkD2KWBl0Zv--SN94lmERs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyUgqS39LwjfK0hKVlqDJf9Ay5cmiPLZB7xo05Y0cLw_Q&oe=69B932D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMW i Samsung Virtual Reality Experience", "keywords": [], "long_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\nThe focus during test-drive is on an emotional driving experience. The user can freely configure the different BMW i3 and i8 models in an interactive way and decide his favorite exterior colors, wheels and interior design.\nLet yourself be seduced in a virtual world.\n", "short_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bmw.co.uk/en_GB/footer/imprint-overview/privacypolicy.html", "developer_terms_of_service_url": "https://www.bmw-service.co.uk/service_inclusive_terms_and_conditions", "publisher_name": "BMW AG", "support_website_url": null, "website_url": "http://www.bmw.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "448693326934547"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139059_998615653587632_1366425605_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dxj4OUxttXkQ7kNvwHUIVDl&_nc_oc=AdnrfbgExx8lQStNLuww8wo1HKOtQiRDSdUILa_no66PpeW9hyjGgpRwskcx3Ad12jM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwLtVRZ21-j-4m_L4ubJ773r7cft593naAmNpt7QUHWdQ&oe=69B95DA5"}, "is_con
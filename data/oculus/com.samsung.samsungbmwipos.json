3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwEoxvNIpzPQds1Q77KaPod3a-M7U4NTW6tJpQVbNqP9Q&oe=69BFD586"}, {"file_name": "migrated_image.png", "id": "1036542220065314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138835_1682352715382431_1646859523_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bpuqd091QSEQ7kNvwEaP1AU&_nc_oc=AdmYuPVFD3bObehXVLJ8vc1QCYZXlVLhtyspsxFwmx681c8boZyi_JEncNN5ICuBJV4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy-9hKDtLjqf-vDc5MrXtis-6Ms11DjlJhxjIh-ppZHJQ&oe=69BFE61A"}, {"file_name": "migrated_image.png", "id": "2966589190115938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138836_1016651478394912_434791839_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mH9n-RIerOcQ7kNvwFeBZrG&_nc_oc=AdnjiMfvX7xct25Td_cq7pB8Ng2UnD1BT-X459RyP3wwrgg9bKLXJadI20sc6Mq2zlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsF12ErCywehjmodJWitaxZZXix_diqGg_2nKDPA7ADQ&oe=69BFE23A"}, {"file_name": "migrated_image.png", "id": "2435267713392731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138837_1664248710509135_1718380215_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIEk7qh6gWcQ7kNvwGJI4Yi&_nc_oc=AdklaNpmyII7D3222az6EA1DC0H12YotNlt-pKFlUV4Re7h9T3WijEzKS3TN8kys06U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxAG73ihY4MiwZjKi1MhNrkrYiZaDip9EH0wNgPnLmh6g&oe=69BFCA50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMW i Samsung Virtual Reality Experience", "keywords": [], "long_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\nThe focus during test-drive is on an emotional driving experience. The user can freely configure the different BMW i3 and i8 models in an interactive way and decide his favorite exterior colors, wheels and interior design.\nLet yourself be seduced in a virtual world.\n", "short_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bmw.co.uk/en_GB/footer/imprint-overview/privacypolicy.html", "developer_terms_of_service_url": "https://www.bmw-service.co.uk/service_inclusive_terms_and_conditions", "publisher_name": "BMW AG", "support_website_url": null, "website_url": "http://www.bmw.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "448693326934547"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139059_998615653587632_1366425605_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJRoCwm64mgQ7kNvwEh-YBm&_nc_oc=AdnuDpM1rV2b07EqHEVs4KcJaPrfJLoerFur0j86SMc2vhBYpYCAqGf86qtD3mxuk-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQhDI2YOWTDH1rIL0mMaUjyuiw2LhAqtRI2ccu5ooVLQ&oe=69BFF525"}, "is_con
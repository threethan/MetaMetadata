2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpJx4Lml4IG6udYtf487bZpF6jN99W9CNE6K3IitYANQ&oe=69B00386"}, {"file_name": "migrated_image.png", "id": "1036542220065314", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138835_1682352715382431_1646859523_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAf0mENlR-kQ7kNvwF5SbK6&_nc_oc=AdkCWsxMhLRD0-xmmti6yA3xk2_X5641FUgKiRARXKwR4tTgydSCejB3W2UAFROBvtk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcCKXLRQIJOG2MeB5FMXpjVz_KpRl6iypODVpY6tPIBQ&oe=69B0141A"}, {"file_name": "migrated_image.png", "id": "2966589190115938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138836_1016651478394912_434791839_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GR5KACZOEcwQ7kNvwFKu5pD&_nc_oc=AdlrECx0vIXf3KNbBEIkcb4jpuq7kUCRmZ_gc7yqFujAsxOXvT8s4Rv_GOIlxts9U_4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRSA82JH5Rv34jYhEE0gp9yJXwJi4VaPbGiYvk3vV6uQ&oe=69B0103A"}, {"file_name": "migrated_image.png", "id": "2435267713392731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138837_1664248710509135_1718380215_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1X1pYRWoV4Q7kNvwGEqGYJ&_nc_oc=AdkM7LJMjMXlrkDjMJAhuFXRm546MMrbrBP2J_uV11JJniew3S-hdfAv8FdOkkOX2rQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjbFPxH64WcucVTDJUjbE4RBPP6VP6gCQJ0Ez4g4pdrw&oe=69AFF850"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMW i Samsung Virtual Reality Experience", "keywords": [], "long_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\nThe focus during test-drive is on an emotional driving experience. The user can freely configure the different BMW i3 and i8 models in an interactive way and decide his favorite exterior colors, wheels and interior design.\nLet yourself be seduced in a virtual world.\n", "short_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bmw.co.uk/en_GB/footer/imprint-overview/privacypolicy.html", "developer_terms_of_service_url": "https://www.bmw-service.co.uk/service_inclusive_terms_and_conditions", "publisher_name": "BMW AG", "support_website_url": null, "website_url": "http://www.bmw.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "448693326934547"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139059_998615653587632_1366425605_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSZwCQqBbfkQ7kNvwEdjoNF&_nc_oc=AdkoSoveAlK6vZx1ZcQeIbDAWzzJq8ZMFMx8MKT-mmE5FdlrzqI9-PX2lLuum9nVZQU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7N0pqRoJ3df-WMm4CkICIZHx6tW2A1uND0O66nscO7A&oe=69B02325"}, "is_con
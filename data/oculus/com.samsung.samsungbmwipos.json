2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaWOp7lO9QKSDNj8hMby4otkQ4sSUrxQJy6twr6pJdew&oe=69AD6086"}, {"file_name": "migrated_image.png", "id": "1036542220065314", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138835_1682352715382431_1646859523_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPyo6_yLoWEQ7kNvwH1NDC1&_nc_oc=AdncpBeecbi-i_FRwsJn2_2vYCmaC1AmdZ5kJhAl3E5QWDEdp-vLZEbz0BOVbgrix-Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYKdY5BDq3NKeRGvMaqrr-DGPS806IwBcWy5tywveSRg&oe=69AD711A"}, {"file_name": "migrated_image.png", "id": "2966589190115938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138836_1016651478394912_434791839_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmVTzoyVWHcQ7kNvwFC5GMt&_nc_oc=AdlSjiiLGpq4UBs1v1AM2ey289TTzaZA4k8wR4YvG1a1IfpPAxaKl1gcZ5gWCP-tVZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVvko_NHJ0_NdcJPma54WPKzw5c3H9u3cTmjs7iZ79Dg&oe=69AD6D3A"}, {"file_name": "migrated_image.png", "id": "2435267713392731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138837_1664248710509135_1718380215_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1X1pYRWoV4Q7kNvwFhjU_Y&_nc_oc=AdlXUurvd4QmMqy4oHTQmn7lTMvClsB0mwxqGojmIMo1cUhQ8NonvOPIp2sZeKdZSN0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzc-4jZZ1na5xX6PXfIMv86b6CZIl8MALCPcYp_Z5rkFg&oe=69AD5550"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMW i Samsung Virtual Reality Experience", "keywords": [], "long_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\nThe focus during test-drive is on an emotional driving experience. The user can freely configure the different BMW i3 and i8 models in an interactive way and decide his favorite exterior colors, wheels and interior design.\nLet yourself be seduced in a virtual world.\n", "short_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bmw.co.uk/en_GB/footer/imprint-overview/privacypolicy.html", "developer_terms_of_service_url": "https://www.bmw-service.co.uk/service_inclusive_terms_and_conditions", "publisher_name": "BMW AG", "support_website_url": null, "website_url": "http://www.bmw.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "448693326934547"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139059_998615653587632_1366425605_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSZwCQqBbfkQ7kNvwHnE_5a&_nc_oc=AdnbeExhqQZr1YGlBbzL5tGkG-JizsqsBKkX6LhofTJLSW0pAL0F00nBjZaMB-nW5LQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwg2MppdoauVecjynMsvR658G27mSMG99gcg5Q9ZgF50A&oe=69AD8025"}, "is_con
-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfyApEfwsqPxcrvvnB9e5KRYOxscoOz2TaENUWABwbFFjA&oe=69AABD86"}, {"file_name": "migrated_image.png", "id": "1036542220065314", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12138835_1682352715382431_1646859523_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPyo6_yLoWEQ7kNvwGQIsu4&_nc_oc=Adk5MjN10kKBz0Oh-tAVKfNEBsR_d7oelNVNRKoOC8daqfWF3yldLnDrbxA0aWctwlw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6fSXrtHNqX_GihY8V5xPRiCrmFJo6rstOK_JJOrpN7w&oe=69AACE1A"}, {"file_name": "migrated_image.png", "id": "2966589190115938", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12138836_1016651478394912_434791839_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmy77lM5DFMQ7kNvwEL0f0C&_nc_oc=AdkkGbzPym97q1QqU5vdydjjPErEkkLs_Qi7JZsVLqY_CibIdWYyXalFwSNJOx_vwCc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzJS3V8aAJRBYFQx5vlYurfPw-Pd1WN8HGeS3VXoHtB-g&oe=69AACA3A"}, {"file_name": "migrated_image.png", "id": "2435267713392731", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12138837_1664248710509135_1718380215_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MICE7tKi4C8Q7kNvwFMtg_c&_nc_oc=AdkdLL4As3F0uVPbhQyz-1aL7gxw83WdqG3OdldgLh8pyizTqlTxttM4IKzDcVG9j8M&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvNBFBmLmdNhnuY3ZYOaKQzXTjvDMPT-osl-t9oy5uEQ&oe=69AAB250"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMW i Samsung Virtual Reality Experience", "keywords": [], "long_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\nThe focus during test-drive is on an emotional driving experience. The user can freely configure the different BMW i3 and i8 models in an interactive way and decide his favorite exterior colors, wheels and interior design.\nLet yourself be seduced in a virtual world.\n", "short_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bmw.co.uk/en_GB/footer/imprint-overview/privacypolicy.html", "developer_terms_of_service_url": "https://www.bmw-service.co.uk/service_inclusive_terms_and_conditions", "publisher_name": "BMW AG", "support_website_url": null, "website_url": "http://www.bmw.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "448693326934547"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12139059_998615653587632_1366425605_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dG5acfnwOY0Q7kNvwFKKvoU&_nc_oc=Adng0igpUO_1WoKLWDkW8y8NdPysyS0nUqp35f7xP_3D3Z96wUrLFh67kOX8wgTQDy4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_eTRkF0enDxDFXw68G-PZ0ar8e3jyVO682bo_XpN3zg&oe=69AADD25"}, "
3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0904kxpi8qNPFIuuxEC5dxxKag6BoP3qe7LLEjB_Nkw&oe=69C12706"}, {"file_name": "migrated_image.png", "id": "1036542220065314", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138835_1682352715382431_1646859523_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bpuqd091QSEQ7kNvwEptRFg&_nc_oc=Adr1QTF8ctoNtnxaia0TE_lwgCfqLpDXVcQWaGv7Id9Wg9nfNOW4o-_BlIqN7dvDCQI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKHLm0qstd8MKxH4vrFKXV9wLInk56QeCU1dDw1l9Fhw&oe=69C1379A"}, {"file_name": "migrated_image.png", "id": "2966589190115938", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138836_1016651478394912_434791839_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mH9n-RIerOcQ7kNvwHvpGp-&_nc_oc=Ado2n-4PoyjCyGdVBeGQ8Pz_n-EHtnA_7Sr5G0MrmsXegDPklNhV6VrVVHJabt_TN_8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxRTxcz4q19DHboyjTnHtOI9xz5mMrM03EOT6qvpKaEoA&oe=69C133BA"}, {"file_name": "migrated_image.png", "id": "2435267713392731", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138837_1664248710509135_1718380215_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KB01oDWyJS8Q7kNvwFSQTH7&_nc_oc=AdpSAPbBYhgZ0x_11etHaRBVgxb-CFlidFR2p4RH3FgOANdzhN9BJjJVJq1F8519nm0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTX8iuLYqXZD8yHe0JzdEThIvLyAm_VEza23INF_JDeQ&oe=69C11BD0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMW i Samsung Virtual Reality Experience", "keywords": [], "long_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\nThe focus during test-drive is on an emotional driving experience. The user can freely configure the different BMW i3 and i8 models in an interactive way and decide his favorite exterior colors, wheels and interior design.\nLet yourself be seduced in a virtual world.\n", "short_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bmw.co.uk/en_GB/footer/imprint-overview/privacypolicy.html", "developer_terms_of_service_url": "https://www.bmw-service.co.uk/service_inclusive_terms_and_conditions", "publisher_name": "BMW AG", "support_website_url": null, "website_url": "http://www.bmw.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "448693326934547"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12139059_998615653587632_1366425605_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zs6qzVhuLuYQ7kNvwGkMgNX&_nc_oc=AdrZbEjtMfYqvuuF3DsxbBcHJbpushytThThdTflk9kMUTfSERMHrfywC-GC4k7bmdM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzmxsAwiwcJkG86aruEjhmVECt874p9BqycaxRHFC9grA&oe=69C146A5"}, "is_con
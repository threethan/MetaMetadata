3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYreMB7PJVClcw8byVy5DdLual_M_SrorARDIhEWih_g&oe=69BE8406"}, {"file_name": "migrated_image.png", "id": "1036542220065314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138835_1682352715382431_1646859523_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bpuqd091QSEQ7kNvwHgQ05v&_nc_oc=AdlsjDk7xf401QjJTqC0VF4aNUKRKBfwOlfAY3reqEQfvPLx86PpEG1abif--vzf7Mo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_OSeh7wwbcNEqNEKF0EiIQ-AzJq8ECVPV6pEIPlTTew&oe=69BE949A"}, {"file_name": "migrated_image.png", "id": "2966589190115938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138836_1016651478394912_434791839_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nks6q6W8FQcQ7kNvwFuc75B&_nc_oc=AdmBzKT_i7MSw29m1xrce1OxqaMHWot55rCZeedmJmRZquMWTxK2M1WGXrHfLCudpjA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLlvjEuZT50fv8cnbtb2NRM2uy8xu77rTxnMi46y8nzw&oe=69BE90BA"}, {"file_name": "migrated_image.png", "id": "2435267713392731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138837_1664248710509135_1718380215_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIEk7qh6gWcQ7kNvwFjb5M2&_nc_oc=AdlR7VVEiPh2oAIvUxfe9w6NPLQxcj_OHhMqr_sf3GyH_XBuFZu4u_cRU4goK4VuBqg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfySEYh8JTfPje-keUq4uTyqDU6tXBNKzWUXd6_X1S139g&oe=69BE78D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMW i Samsung Virtual Reality Experience", "keywords": [], "long_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\nThe focus during test-drive is on an emotional driving experience. The user can freely configure the different BMW i3 and i8 models in an interactive way and decide his favorite exterior colors, wheels and interior design.\nLet yourself be seduced in a virtual world.\n", "short_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bmw.co.uk/en_GB/footer/imprint-overview/privacypolicy.html", "developer_terms_of_service_url": "https://www.bmw-service.co.uk/service_inclusive_terms_and_conditions", "publisher_name": "BMW AG", "support_website_url": null, "website_url": "http://www.bmw.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "448693326934547"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139059_998615653587632_1366425605_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJRoCwm64mgQ7kNvwFXtcNm&_nc_oc=AdlSkZ0jpNQHkVbz5D_UENjdFKGt4DFXTFN-Y-TJ__sK-DLvq9Kse8EQaHP2Pxa5gP8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBKM9WCtby1v719xtCT24U-R5Viv84alcMOwsDmxJHQQ&oe=69BEA3A5"}, "is_con
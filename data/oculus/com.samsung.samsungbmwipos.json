6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwlibIl8Wrr2GTtvrbWmnZt44hPXzT6ngOmqpPEeJWgRQ&oe=69BD3286"}, {"file_name": "migrated_image.png", "id": "1036542220065314", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138835_1682352715382431_1646859523_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EV64nPe_lzIQ7kNvwGDcWKp&_nc_oc=AdljWCHO7fUEuHlr5VSnhx771qJlaNndVk7b36G8l2HDEVMEQL73BpURH3iamQ_FhVs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4pPFARxZWUkeEQfCj0x7Ad0cG5-9dHhtOsf4BMgEaRA&oe=69BD431A"}, {"file_name": "migrated_image.png", "id": "2966589190115938", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138836_1016651478394912_434791839_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nks6q6W8FQcQ7kNvwFVg_EP&_nc_oc=Admetm08qwJiznCjM3wvuvxXMWSE8jyOR8h1JcporoWxQiXT1Bv2N46ms-gBBvKkH6A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy6GNec6-XnoMuKmn942t0-VIjH9DRqcnBtW4PI85Ly7Q&oe=69BD3F3A"}, {"file_name": "migrated_image.png", "id": "2435267713392731", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138837_1664248710509135_1718380215_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIEk7qh6gWcQ7kNvwFYCmiv&_nc_oc=Adl-bGUcwcgWVKG5PGgoqEwQXYXm7827Z2_kaeEpqNtASYLF-CiZLpKgAYIwQkqVqTo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWICgWrNPlBiRE_kVT85iWo9iARExg77bNaPAmM4TGNA&oe=69BD5F90"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMW i Samsung Virtual Reality Experience", "keywords": [], "long_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\nThe focus during test-drive is on an emotional driving experience. The user can freely configure the different BMW i3 and i8 models in an interactive way and decide his favorite exterior colors, wheels and interior design.\nLet yourself be seduced in a virtual world.\n", "short_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bmw.co.uk/en_GB/footer/imprint-overview/privacypolicy.html", "developer_terms_of_service_url": "https://www.bmw-service.co.uk/service_inclusive_terms_and_conditions", "publisher_name": "BMW AG", "support_website_url": null, "website_url": "http://www.bmw.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "448693326934547"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139059_998615653587632_1366425605_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJRoCwm64mgQ7kNvwENodk0&_nc_oc=AdmhI8iB1lB4u6vBN7Jdd9vjNsHRmmVgJGwucrre1x3mE0Y-AYiHcdhWXykpgLHV5Fg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxtppkQiAt08u8PnoQSeyGPqsYp54IPxPPioSwe7p8fw&oe=69BD5225"}, "is_con
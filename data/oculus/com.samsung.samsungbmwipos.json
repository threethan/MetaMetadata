T3sQ7kNvwGPab3-&_nc_oc=Ado49gprUFObC3cqMZ_URftigqdEkj5la97Tvtk0eAXkf4zZY2DtqE0WYC_zFf6Hxnw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaTjwCXH1UysNjclxt4b-cFHaE7NiWal8MY8qbls6pnA&oe=6A5A4210"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMW i Samsung Virtual Reality Experience", "keywords": [], "long_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\nThe focus during test-drive is on an emotional driving experience. The user can freely configure the different BMW i3 and i8 models in an interactive way and decide his favorite exterior colors, wheels and interior design.\nLet yourself be seduced in a virtual world.\n", "short_description": "The BMW i & Samsung Virtual Reality app connects the world of the Smart Home with the world of Smart Mobility into an overall experience of the Smart Living: high-quality, urban, modern and realistic. \nThe innovative BMW i Samsung Virtual Reality App is a virtual product presentation and test drive, combining live action material and full-CGI-images into an interactive 360-degree-stereo-app.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bmw.co.uk/en_GB/footer/imprint-overview/privacypolicy.html", "developer_terms_of_service_url": "https://www.bmw-service.co.uk/service_inclusive_terms_and_conditions", "publisher_name": "BMW AG", "support_website_url": null, "website_url": "http://www.bmw.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "NARRATIVE",
cdn.com&oh=00_Afu64tib1VNTomy0P9AJNXZPaefwGtW_DWPrs-BL87zzSA&oe=6999A4CB"}, {"file_name": "44.png", "id": "3910997052514584", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75287554_3910997055847917_7547955738498270815_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kK96EDxLMZQQ7kNvwEVCR3m&_nc_oc=Admrm7xC5D1h06OYvqLOQDXkQomFSLuIPSTh1T88XeeYpunjtHCScZN0aMMCT6fpohU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftKx14vqGHAZAnLGgXUewslL9E0EgWhLY9JFL09PJGUNA&oe=6999AB71"}, {"file_name": "55.png", "id": "1108583490681395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974786_1108583494014728_2542365259850621893_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBRbUyxRvf0Q7kNvwEhK3cc&_nc_oc=Adnn2yVkwTMEm_tdR8DTiqRK84Ah8J2Jlpm5386G2Iwn_WH_8_EJ-32W25Zgl-lNsJw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvNQopFzMimtA5ALtXUtwYnnRagX0FR-JcKHgD-P4F_fQ&oe=6999AD98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CustomMonks", "keywords": ["CustomMonks", "Building", "Fun", "Social", "Calm"], "long_description": "This is CustomMonks, a game about building! You can build anything you ever wanted! You ever wanted to build a fling car, well, you can do that! And play your builds with your friends or random people! Also try out Nation mode where you can build a nation and try to compete with other nation in the map!\n\n:Quick note, when build you should see a red cube on your right hand with text saying build mode, this means build mode is enabled, it's in a grid so you just move your hand to change the place position of a block. To open your build menu press (X) on your left controller, and to select a new block in your build menu simply take your red pointer or (ray) and select a block by simply touching it, no trigger or button clicks: Have fun!", "short_description": "This is CustomMonks, a game about building! You can build anything you ever wanted! You ever wanted to build a fling car, well, you can do that! And play your builds with your friends or random people! Also try out Nation mode where you can build a nation and try to compete with other nation in the map!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/custommonksprivacy/home", "developer_terms_of_service_url": "https://sites.google.com/view/cmtos/home", "publisher_name": "Kinkajou-Game's", "support_website_url": "https://sites.google.com/view/custommonks/home", "website_url": "https://sites.google.com/view/kinkajougames/home?read_current=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7044331989023869"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1688725531685293"}]}, "baseline_offer": {"id": "1688725531685293"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1733614020, "status": "PUBLISHED", "id": "1688725531685293"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7332046450252420", "version": "0.4.8"}, "id": "919781269701167", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6982826181841117", "is_concept": false, "late
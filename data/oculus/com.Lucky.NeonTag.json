44", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974457_352796537838677_4533385544316134948_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rc4PFq9Bxo8Q7kNvwF7kKkE&_nc_oc=AdruREO8J_GhIebXqBe7inMJiXHlnfxYOcP73WLvmrojUMmNO2SLAJ4hNUntuu8H2VU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9DJtBS-oCb9SicEi3_A8xfT0auY8xc4XuC7yleV8fnw&oe=6A8D86D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neon Tag", "keywords": [], "long_description": "Neon Tag is a fast-paced multiplayer game where players take on the roles of agile gorillas in a virtual cityscape. The objective is to tag other players while using parkour-style movements to navigate the environment quickly. It's a mix of strategy, reflexes, and parkour skills, creating an intense and enjoyable gaming experience.", "short_description": "Neon Tag is a fast-paced multiplayer game where players take on the roles of agile gorillas in a virtual cityscape. The objective is to tag other players while using parkour-style movements to navigate the environment quickly. It's a mix of strategy, reflexes, and parkour skills, creating an intense and enjoyable gaming experience."}]}, "developer_name": "LuckyWallsurfer", "developer_privacy_policy_url": "https://sites.google.com/view/case-tag/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "LuckyWallsurfer", "support_website_url": null, "website_url": "https://sites.google.com/view/case-tag/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7nMcUNDoKEQ7kNvwFjeOT1&_nc_oc=Adr54UZv0TuCqTQSPIfYvMsuQgY-49biXu_q0V9OxI_pDW-nVYQbsZbKNaHNjcg-Kos&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ31LPmoT3O90ntfvHXe39-Oqbbdbl6vCvoMlnV2dGcFw&oe=6AEC8E30"}, {"file_name": "05-spacecraft-cassini.png", "id": "1967138690538941", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825503_1967138693872274_1644928388085687737_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caDr9xK-DcMQ7kNvwFjSSI5&_nc_oc=Adp-8qYIt8dg9lfQHk5DtfE64-9RiTFrqhQ17iFwivIeFU5uKz_LpflMTskhdIq0owI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaNJucwy7UkTEQvHMJeJRq4KqpKXJqa_LMhmtlQF-7nQ&oe=6AECA02C"}, {"file_name": "01-wind-by-height.png", "id": "2076870726277186", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823341_2076870729610519_920256083650597421_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4j8XQBp6-VQQ7kNvwFbGGfS&_nc_oc=AdrUJcm6bHBTzeQw2LaGjrr2AMl2qaNL_25FFHCXspQ7dx8_tOdBsMUx5DTDu0E3rek&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMOEiN4cBOQ36Ue7IdLXKBrJ7EqpZ0k-5xdF5P9VJpDQ&oe=6AEC83ED"}, {"file_name": "13-mars-rover-reconstruction.png", "id": "1088199160660266", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821796_1088199163993599_8504765071078781288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0oWQwqANhoQ7kNvwEhywFI&_nc_oc=AdpI-q1pJOx3awX94K11fopa-tihzV6KSkv9e0DNOU9nVyae8kWglXl2r-DRbN5sgM4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjcm6V-ke5E9plnnk13ghpynriEY-zHnfiDnmrIG-Bow&oe=6AECB327"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "28323548477328708", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823310_28323548507328705_5476976617868162782_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdHD1pqGhNEQ7kNvwFDri08&_nc_oc=AdoIWI8oiNV6Fe47oOGLpuQRJxvzQWRD9QpXcvUEgKyyl4Yx8OLvxxVpD6BUHwvLH7w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-_gkY7sIBlwZyJhqBkEyt0_eiVfGTFxPJx21vAV5piw&oe=6AEC8607"}, "display_name": "Planetary Vitals", "keywords": ["SolarSystem", "Planets", "Exploration", "Earth"], "long_description": "Turn your space into a planetary observatory. Planetary Vitals brings published science and mission data into views you can pick up, arrange and explore.\n\nEXPLORE EARTH\nFollow wind at different atmospheric levels. Compare temperature, humidity and satellite maps on a globe or terrain tile. Stack ten installed July land-temperature maps from 2016\u20132025, with dates and sources visible.\n\nTRAVEL THROUGH THE SOLAR SYSTEM\nExplore 34 worlds in an orrery or lineup. Switch between readable and true scales, investigate interiors and rings, and examine 25 textured spacecraft.\n\nVISIT MARS AND THE MOON\nWalk or fly through four installed Mars rover reconstructions, with shortcuts to detailed areas. Survey the Apollo 12 lunar landscape from above and browse documented landing and impact sites. Also step inside NASA rover panoramas.\n\nMAKE IT YOUR OWN\nBegin with 27 presets, use hands or controllers, arrange floating controls, change themes and enable optional narration. Explore in mixed reality or an immersive environment.\n\nThe installed surveys and datasets work offline. Internet access adds point forecasts, space weather and archive imagery. Global winds are a dated bundled analysis; the Moon survey is aerial and each Mars reconstruction covers a finite area. Sources, dates and licences are available in the app. No account or API key required.", "short_description": "The Solar System on your table, built entirely from published measurements. Walk on measured ground at Mars and the Moon, stand inside NASA rover photographs, and watch Earth's winds at eight levels of the atmosphere. Thirty-four worlds, twenty-five spacecraft, nothing invented."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/ap
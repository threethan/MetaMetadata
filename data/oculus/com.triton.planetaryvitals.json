ri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821796_1088199163993599_8504765071078781288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0oWQwqANhoQ7kNvwEhywFI&_nc_oc=AdpI-q1pJOx3awX94K11fopa-tihzV6KSkv9e0DNOU9nVyae8kWglXl2r-DRbN5sgM4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjcm6V-ke5E9plnnk13ghpynriEY-zHnfiDnmrIG-Bow&oe=6AECB327"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "28323548477328708", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823310_28323548507328705_5476976617868162782_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdHD1pqGhNEQ7kNvwFDri08&_nc_oc=AdoIWI8oiNV6Fe47oOGLpuQRJxvzQWRD9QpXcvUEgKyyl4Yx8OLvxxVpD6BUHwvLH7w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-_gkY7sIBlwZyJhqBkEyt0_eiVfGTFxPJx21vAV5piw&oe=6AEC8607"}, "display_name": "Planetary Vitals", "keywords": ["SolarSystem", "Planets", "Exploration", "Earth"], "long_description": "Turn your space into a planetary observatory. Planetary Vitals brings published science and mission data into views you can pick up, arrange and explore.\n\nEXPLORE EARTH\nFollow wind at different atmospheric levels. Compare temperature, humidity and satellite maps on a globe or terrain tile. Stack ten installed July land-temperature maps from 2016\u20132025, with dates and sources visible.\n\nTRAVEL THROUGH THE SOLAR SYSTEM\nExplore 34 worlds in an orrery or lineup. Switch between readable and true scales, investigate interiors and rings, and examine 25 textured spacecraft.\n\nVISIT MARS AND THE MOON\nWalk or fly through four installed Mars rover reconstructions, with shortcuts to detailed areas. Survey the Apollo 12 lunar landscape from above and browse documented landing and impact sites. Also step inside NASA rover panoramas.\n\nMAKE IT YOUR OWN\nBegin with 27 presets, use hands or controllers, arrange floating controls, change themes and enable optional narration. Explore in mixed reality or an immersive environment.\n\nThe installed surveys and datasets work offline. Internet access adds point forecasts, space weather and archive imagery. Global winds are a dated bundled analysis; the Moon survey is aerial and each Mars reconstruction covers a finite area. Sources, dates and licences are available in the app. No account or API key required.", "short_description": "The Solar System on your table, built entirely from published measurements. Walk on measured ground at Mars and the Moon, stand inside NASA rover photographs, and watch Earth's winds at eight levels of the atmosphere. Thirty-four worlds, twenty-five spacecraft, nothing invented."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/planetary-vitals/privacy", "developer_terms_of_service_url": null, "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/#contact", "website_url": "https://nebulytic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1307307489131938"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4482648328730054"}]}, "baseline_offer": {"id": "4482648328730054"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789482000, "status": "PUBLISHED", "id": "4482648328730054"}]}, "liveChannel": {"nodes": [{"latest_support
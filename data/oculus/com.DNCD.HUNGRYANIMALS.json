oQ4j&_nc_oc=AdpQdZ53vanJifFBsx1ZLs5E9MflGxQFZYoTpXkjR_748by6OwhEdLB0T9aPMqHSaUs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOx5iR7mTomZUcGijCWUMnr01JNp66T33gFIQ49UvdCA&oe=6ADCB873"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2lPFB-V5vEQ7kNvwFPHLf9&_nc_oc=AdrWu5jIr34MFLrk-mnOhzc6mnaRpQzEzB-Mg6KH6nyHs8zIesq3V65cghoBBnC9-VY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNmnXEYyiyGWdC_pW25huSs8eHJG31Y_EFAXBTgqsMEQ&oe=6ADCD491"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0kcGm9kFRsQ7kNvwHxafmM&_nc_oc=AdrXjJJJRaUrqRMKbD084oVq4DQ6KJEzZL__uzCFhM8pxiHSHRjDujWuvDe6rgLT_qw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIA9fb77huDOIQooLuRxtCunlwtoW9CDF6HVdTKtH-xg&oe=6ADCD0B1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXkCoLhMT4cQ7kNvwHDTypm&_nc_oc=AdqvcIGBLEm8EanU9SjwaH0BFFJ6EYNR6Bt0-PBJ26i-Ba9VwlEKrjLvLKvG1TSOBSY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOx37tXrXiwz9HEFCWAi7lPlqKLEQ_euZSILRJB5fbNQ&oe=6ADCD50D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUiCTb0uZY0Q7kNvwHv4-0i&_nc_oc=AdrXfQltq6ZbAqxbuViujJF77h7GFvWma0RX9E_DcPcUyfUr3xuanE6QuVz8cvd5mOo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXye5zetmwkKusTXL7ompk25OgMFjDi1FEAtqj8fPTmA&oe=6ADCB624"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscd
EDn7&_nc_oc=AdpQA5Z7X0J-4GIdpVXpp6X-6cw1ECr7XqPwkPlqm5FqNnQQgRaoAZ08PJT-LG-1GVo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQHDawP_d-ahcT214CAuBnIQ8p7P_PmO7DSaKpG3tU4g&oe=6ACB94F3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ik0qw1qWnXUQ7kNvwHQlAna&_nc_oc=AdoW0NfrlBXflwFT4lP4RH2tGqEdyTN4P1fmS9PO3WbMCetZo1_XOGz70zsj-Cob-uM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM1ZX_SmmPw9EH38yJS2AdbMlCviVaZVP4n2R6OSLkEA&oe=6ACBB111"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rl1L2NFSgtQQ7kNvwHJDejl&_nc_oc=AdqDLVGl7JhQw4Y780Se7cp_yocBNu5Fcnnh2Qyf8jh4MIkfiu0ApKnc2BAc8ieoyNw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYlj78lWBTEb6rNcaRLX0nGuUWfGKw7WZ3kN0gXxQq-Q&oe=6ACBAD31"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v25RvYGy_UQ7kNvwGcZHcv&_nc_oc=AdqDu95nGu66Fd8aEuLWKgapzXXHd1k9fVIEcHNTJizRzitGN7DTRSejKt8RYjlDfFg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMya7VcpySu4NKid8w_eGBviv9obkJIdRdoAsvBTb2PcA&oe=6ACBB18D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6LETR95DaQQ7kNvwG8Nagk&_nc_oc=Adr7DXTh1nJRvU1b6A_-2wLQzrRKzft41A0Ya6j_OVl3ETo-WeFBPnxrS1s6l8g_8Do&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN566MfJdRKwlj7Fy_mif7U3HKYnMwAKXe2aG33n75B5A&oe=6ACB92A4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscd
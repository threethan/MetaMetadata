-hkg1-2.oculuscdn.com&oh=00_AftKTrZmro3j2KlIMZJeNquMzdOQPy9tYZm15rMardI6hg&oe=69A1A1F3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNU_lJ-dI1sQ7kNvwG5qEmz&_nc_oc=AdnZ25OD_JgnGaoTGivpI7yVke3BlctCXOtGivIlhQ4LQc5t6LVjzYtAbVimMJ4RJCo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvxvT37btl-JCdINdspIUEpyL5WOsteWLqvRx-7vlj-QQ&oe=69A185D1"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qySV6CxUWLgQ7kNvwFxYJEo&_nc_oc=AdlITZEEfBY2sGcG0ZH-YkeiDS53vx6dJ8DencOpEX6ity0yy6QtJfOjcsIDX5YU5jM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftUgIL4gphcZb9bHaDGi8AMeT-vw0Qt2CHnIemyC1_L7Q&oe=69A181F1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdBrOM9X_nsQ7kNvwH5OHj1&_nc_oc=AdloXnaOp7eNO-BS-cUoE1J8fPyAxxhzTfCKPdGvyZ-eLy2XTZlZc8M7FhSefTqxdPs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft4jDsmApDHokFyYO5VJqpmkKZktCWrg19RgwEhqXmYBw&oe=69A1864D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KB3ZWkuax8Q7kNvwGU3sxN&_nc_oc=AdkwYLEg35UZ3Q4t-iqD8nIiY4rqQgXU-EN5-kqDxHANMjczAE9PzZ6lVwOHJPEQFWQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfviwZ_8GmFZO5beSu4M7ugxqLIyG9YyIIpgrmWbdKabTA&oe=69A19FA4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974625_471409947982144_8958720854361894118_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5tbJeTcGx4Q7kNvwGqQO0B&_nc_oc=Adk
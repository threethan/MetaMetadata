-sjc3-1.oculuscdn.com&oh=00_AfsnQSgO82K80PbrZen45GivD_NCG17U0tNpSJwq16-JGw&oe=69986773"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmzSFI7w6xkQ7kNvwEp4y7C&_nc_oc=AdnID_mdSpJx92OFm67bD_Gk0hP4aQOdQw17Xlv-Uy4FXz1N19TX7FVK3Ybf9b5be04&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuBujLCrQF4fVJWIdbCTE9qbZFXQXsCnZcKC3Tsv80-Kw&oe=69984B51"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wjQQFYkqPsQ7kNvwEa_6Dv&_nc_oc=AdmFCZs6vkS5nfl4XxB_bawJH6IqKWJEgl_QzhmJRW1oOkKeUn-fFtHOD9O1GvSliKU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afto5QV_rBi7HhGLXv_3KI0y7YY_Qz60ovdutK719lArKA&oe=69984771"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iXfKrLwtwcQ7kNvwE_Z2Mf&_nc_oc=Adl_w-sLgwg3JkUIxPL85lZaQpELw59TeaALhhGn_n9Zp8SMCjI3JO86SYxnVxOPL8s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftmXd-yadYqJHX4dXmkYOUcPA53CY4YzL0BbZw72u_hcw&oe=69984BCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Px0Vl1h7HwcQ7kNvwFShNF5&_nc_oc=Adn7cmnOdLT81Id6v83XeErVmTPPsA6X9ogmFF0LrEYhQmxRGJJIAKIry3X6Q_5bRVc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs9iOxDsiasvdP5Uc4z71SlojbnufvLhJkbkWpIeGRMSw&oe=69986524"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974625_471409947982144_8958720854361894118_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRzWHm6ZxA4Q7kNvwFxbWPc&_nc_oc=Adm
0.png", "id": "1037598403772651", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974530_1037598407105984_2894653620458275853_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3rhI9kZRTcQ7kNvwFJJvAx&_nc_oc=AdqU9tiwkn5FwGzbkIoVkEQc1SoU3lE2SMB7pCuipO3x0GkXM98Rfymnp-ssp58Sf5A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaeUhzeNtAuoDgp7o4sW4sum9osp2IGYikAFUMdXtpJw&oe=6B032C33"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ku0mbMCgPeMQ7kNvwGYNEWh&_nc_oc=AdoI8Fgve1qLwOkvtJgHY4MmyhdhkA2v10v67F8FYi0phuwz-gcMtbFp-XsGoiflynw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG3g6hlacPSlagsumMIQk67WdkI-S_TRMuJ5X6fpGz6A&oe=6B031011"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLsKCEXIYLEQ7kNvwHjrbBD&_nc_oc=AdrGO9MO3zWb-Tl2EUOCILruwKiR3ulVX1eiMTWgeNJvNLKnkSDvejQmGyNB_9l8vWY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3AjsZLC-S1T1X5d4WI2aSQDxB7eKr4vcdYJ-M2IGciQ&oe=6B030C31"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rybictcFx8Q7kNvwFOjV0g&_nc_oc=Adp6rwQYyltVZgZqXui8ATPYq9MsmPz0EbXaPVXjv737TbW7EkPhlsIykH6W7Cj-pak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv3IvPjX_N5veHGXhNXOyddD4xZArXX1nNBKrpgcMbvg&oe=6B03108D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCXywumlfHkQ7kNvwFxHle1&_nc_oc=Adqre3k2sYQMfzxtoc7YIjflrQGpBrqenPxJ9WtgYBXxXywdaU7chTVy2DzG5lzEHSo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPunOlBR5Wj14GG1UQavexqWiQiduBKAQIa3iIxcy-TQ&oe=6B0329E4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
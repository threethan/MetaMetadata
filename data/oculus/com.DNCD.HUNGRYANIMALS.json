thb6&_nc_oc=AdruhEb5X1YwP0xFbm31ax3o2Tvp7H_b2OlrPgBoPSd8d8ZyCdL5afafchc_pNAD8Rg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zzaM7N_Lq6HCUQmwmWYrpnVyBqUqMfw8G86OkPJe08w&oe=69FF3C73"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXuieN93y3UQ7kNvwEn5EC8&_nc_oc=AdrQ5fF0Rr1uEE1k3l_LrutGmkgD54j4AMYkKNkxzlgjeDkJyGLrn8oCkKJTwQHdHW0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7idsM0dGYs28GeTr3j8Ha_zuLlv-LaiuEeasjGVKChhA&oe=69FF2051"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39fq9cYwQKAQ7kNvwFdGTzd&_nc_oc=AdpN8TUHyx4bmCPkhm7kxPxV42DcH7fs7QOIRPxZAst1Ig4W_-lMfGZE2s7QCM194lQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4B9s6Rt5W4gqqdGaWbzc0qV6V26nZlSqdCP08kf2_fOg&oe=69FF1C71"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yu92ubpttI4Q7kNvwHmUHr5&_nc_oc=Ado9VFpvvYKLRJB-2pRVX-r81KXepWa_QESpvBR1GygMzMYIdFjGtdyP6NvGx2rPCXg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gRIaeapjI68y9NIQPvUJJ87dwYyazsQBhgh5GTD9sCw&oe=69FF20CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SB95kIKdgC8Q7kNvwErrmw7&_nc_oc=Adq0n9xs1Pa3q881N7HGuPfpPntFwtpm03xs8kKo_AArCV-D0G_NdphR_w3e8VxwBkw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gW5G19PeIDv5yiBy2-yRYrp7pl9jUC9QqXZYBgCRYAg&oe=69FF3A24"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscd
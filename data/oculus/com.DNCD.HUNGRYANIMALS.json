vwEgvFq2&_nc_oc=AdoLj0bc5mqDqeaRwL0v9XXqXZxlDyd2Jm_dDgKKdSCwzWLW6jbHQGvjAP-DsSDjuy8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WiIQmIQmRpxijdc_qnlgAY3euxCqkhQnsgFc_J3s1zA&oe=6A369B73"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjB3q-J6mnwQ7kNvwGO-wYS&_nc_oc=Ado7PTANrZ3oZBE5V4bVG4yE5QAxant40wRiGzWFdhZMB6CWDKR1JT3H6oDaX5CDLaA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98qAmmfI-_wySebzUvraqIaUhApxDCi8gzlEQPkQPI6A&oe=6A36B791"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoSL0q7834UQ7kNvwEeabGl&_nc_oc=AdowtJ2t7JNcw4aweMY8zUzCqSlU6HcK4thkyyvgDivaadRYasXVWsDLQKsbQlFkmMQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JPQVyqS1HfYjJXlKKFEq0aC3lp4dzn96oPY1_HE8VTw&oe=6A36B3B1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9vHl1TbnysQ7kNvwGno4YF&_nc_oc=AdoNVKgNWFKI3bApk1WYgbpw1xL-fuIWr1HJYuKltCylO1DOXkNVsGyGyYixQDyix6Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oKSa2CWybWInToTy7z0XHWUte8jMfjA6NI18gkdAiHA&oe=6A36B80D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mW7uu6XfNx0Q7kNvwGMMSXR&_nc_oc=Adp9eARgvapMMk_WCmtkxVfniWre_oeAFzpAAynN5UfZAuyxXqKLOd5KH1J30tz9O9I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mSrPw9oG9JtaLs44S4J2xF5du7iNEBUUwb6qmujQtjg&oe=6A369924"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oc
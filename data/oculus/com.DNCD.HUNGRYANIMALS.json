cJkq&_nc_oc=AdpWfJ3ruDXKXXEIBcvsOb1XfMSIIDyYxSs9vBpNyam6ybwEDbFYOjKJBANqtBy7aKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT83y59FQx5RMUJNp3aHrRKCBor-LrowFFtieqiuGJgQ&oe=6A734073"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Im7thV0l86wQ7kNvwEWYSK0&_nc_oc=Adof8p_j7vOqloWZhYZtlkD5hVKPw0BnJA3TpJRPUdV60LrLLjvVPcyfwCFmazqRRC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzdPpd-Y68VDYzOS77in3yQjNilc9xXn01Ya8NWepjwA&oe=6A732451"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7U1GjCUX0ZgQ7kNvwGNIQ_D&_nc_oc=AdqfjShGlCL9wMm8AghdezShwgqDLV_s4yVYG7FrbwnGaZD5zDJAslR2S-MoAL0AIAg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyfZF4DsVkMGlnWRwRN6-TDxxRL2UVQssW1aJ6ZT9LLQ&oe=6A732071"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vymx3Jvzet4Q7kNvwF3cY14&_nc_oc=AdopUzm3BDv1mXQiKKK1VfVhddjodcZwMUZtKeA-1xzpXR7qVr634a2_QdKrllXbUqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7WxcraPovjQrGN7IrCajsXwPRXK58jvoWjgpJxPhCwA&oe=6A7324CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sk4yuLztYe0Q7kNvwFjEXVK&_nc_oc=AdpHz-izfitqU8Zl5HqGT03TkaAvl5q2JgqUZKTkA9Mq2D5aRYC3mYhbihUzZ-mpb2A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXLbmXEmzEYEnxFLTe3pJcU-6Jlpl9jhGLLGtFp2uYXw&oe=6A733E24"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscd
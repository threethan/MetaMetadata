IfPa&_nc_oc=AdoEta-bz6xK-pWGRzJRQZ6KoK6z5b_LN7-rGY1lb9zK9IUSM51RvuON6xBaZPjx1uI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7ByYOv5J9OyuCGvIgf_SyF5lJvedz_R1HYJqHNdtRug&oe=69C7DD73"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YM4Qy8TKs4AQ7kNvwElP4qH&_nc_oc=AdrLnktBQ9nrQSqnAuVh_3OmNrzAmggXIpKbbWB4BNj_dRZKYGb8CiKjgkcgmiKCRqY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpcwmJSl7hG-bKPDJ94rMmABz_Cxfh-yrOPpmkRL_I1Q&oe=69C7C151"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbOAnc0161EQ7kNvwHoZ0zI&_nc_oc=AdrNeJ86aQXXN06k0eMMvHMAUDw84LnOwZGqNcZxUN4k39RmdOWJEyRZTgNvq7z1OmU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPl8eNxOnQppq5K1V_Rkpg9YDaaavagHrlKWW1OjLyVA&oe=69C7BD71"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10YXVUtMOCoQ7kNvwENQKS7&_nc_oc=AdqAErs8D5CXejKsy8V-AsD6GOzjlFKxPy9Os2jdbYfAEoAlGNK2Mmky5MiceXvpcmQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZGkIxng_n-SubhYtLf3z5E3PAFdUs4e2Xu_7s7I50cQ&oe=69C7C1CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pf9w9pcyfwQ7kNvwFsJjcF&_nc_oc=Ado1bZAzmUSxB2zxQMeHQpJHMvAN25AqDxLPuguqL9QmmDmOvxE5ggeJjgIY5HtSI6w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRqA1JaVJodJrgVdvHJIlDHZJr61ZsMYYipk0DACeuxA&oe=69C7DB24"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscd
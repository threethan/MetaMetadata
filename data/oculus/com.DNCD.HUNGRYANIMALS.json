vwErHz1f&_nc_oc=AdpD1sOH4aSNXpK2JESsdfTR7ccyFiKYL3Ig0TbRwm_5cHOGu8xDfveOiF1yv55lxjs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIt0miaUoY9ysunnUSteVfrKTygFm5FfIcEgr8VslUuEg&oe=6AAE93F3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeDNjhZP-wEQ7kNvwFpLl2I&_nc_oc=Adqxkltwce2Hy_GzVZHJycWC7ztitEhnueIVkZ1M6Yezxq5X_3Mp_alXnmyL1jIibeA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0jm-6T-WlND7dbEsJQZgVVh9pLhikLC89ajoNVNOQnA&oe=6AAEB011"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CffCVUpB1fYQ7kNvwFd7xl3&_nc_oc=Ado0UeyaNODLnHUVv9SqxzYhIjFZpwLkT6hDPBmQPCgrtV4PK5RLj8RewutYIPKkLws&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbPm49hbgQ1EpN_CWU0LC5zTfchBco1GBTBvN3bPpEVw&oe=6AAEAC31"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ec3N68IdY5wQ7kNvwGW32ir&_nc_oc=AdpSY_5XBIP-OccTfqTe7J3PvSz9HzNpkEzOPwy3lPKnYROouW5L5aXyRKT3C1hwTDM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsF6W8FeHvcEBWuIE0QPmIRCNOIdFf_9SZvO8rQPF75g&oe=6AAEB08D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xY1kimfHNNEQ7kNvwHnMmms&_nc_oc=AdpSP8fn1G-gaztzS74WUZoWJV5Cafr5aTw6JlwjzjatMAVfrVyIhyOPgUmGZfxB_Gk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJL_oZwv1rE9GJfpwK4fx4-KLxYtxkHPwSsMv5Nd6Nx3Q&oe=6AAE91A4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oc
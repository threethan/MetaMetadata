QRZi&_nc_oc=Adr-l6e9YhEXKjW0_G1Lov-5Z0v3Rb8jPjbUI_2k7XLMuFByLwvZFG3FINZ-ShE61H0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5gqrm2mJjMQT5Rx4ZOCbii6U4M0P66nh5D1vfa9E7zA&oe=6AB28873"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4t8p9NjPygQ7kNvwE16sXG&_nc_oc=AdqUmJunu4P9IA-mOihiyw2dNT63GDkG8H46VhvVE2u5QEF7lU-fWP_DR5DwaJbOiA0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL25uP-Cniyf_PMYRee-_vT1v-uqKRQMiBZA50WQM0n7Q&oe=6AB2A491"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDnBqW34Q9sQ7kNvwFluL3-&_nc_oc=AdpI6788hTII52pyrb-zrg4Nr1RKjI4o8rc9HQf6oywcecJBm0-70hxE48yQ4hrbxWg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKov8v0vyKVchmpmBATiEbxBB54Tn02896RsBnxPJtIgQ&oe=6AB2A0B1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khbzXsxZFQ4Q7kNvwFp-A-i&_nc_oc=AdrYt0bW_WHxAji7Plo32V-OR3O5lFjsSU_9ysILql9Z7h_GVBRNdmwO6Ed3_HcFad8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIlpBZXiUWvS8Ny9dJY5MV94aTlp2F_mOmA6qhE69AQw&oe=6AB2A50D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-fJsLRzvnkQ7kNvwEdMq4a&_nc_oc=AdqQF_BMaBDGyORNRhr2BwTTbhh2PI_k0ps-_A1nOPaNlwQhNbLWzCnAY9B2J2TBiNA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAjjrX6cNtkzyi55yHXh6p330KYm550viVqijdtxXXOw&oe=6AB28624"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscd
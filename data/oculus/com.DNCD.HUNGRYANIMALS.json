0.png", "id": "1037598403772651", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974530_1037598407105984_2894653620458275853_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAj6QWWE_7UQ7kNvwEKoltE&_nc_oc=AdrHIRGrOF-iVIUAJYktSrK-7RqAQJoWrqtsDHku-0vpzCzBeMKKm2KNL3fQUPOyBNM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkebuiRGoB99xW6XB7jOvvuOSua-ltOYdqptnBLzusdQ&oe=6AFC94B3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LyVjFJj3spEQ7kNvwG4xmt4&_nc_oc=AdqenCpGJJ_YkRvlg7GW8fDj3ySmQySUCmOWjrqO7dWArGubw18hh-SMXBNCMu9MFbw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0j-Jsk0izPuU3mesu1U6RElsUEvHB7ByuKX5bx5KTAQ&oe=6AFC7891"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqlO3SCgNxoQ7kNvwF6RbyT&_nc_oc=AdqZ01Mfrw1ba3BWrszIib-XF4a6xFPL0GJVCl3xoGwmGgYqFarO6sA7aLENBbrC3Rg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoAH7ljOBvRl9xHsywUNjEAgRIYvff4rxy96u6kNgD-Q&oe=6AFC74B1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZEQ4w3egvsQ7kNvwEbvw07&_nc_oc=AdqMPK-8ZK4iiFSG1olvIF5mE44Ia4RZi76DJLiMCE15WXAhkLC44ht4_nFM9Mih6jw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkywY_qljFPSjZXBkNTvK3tWr8qHGa-zuVCeozTIl5KQ&oe=6AFC790D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVN4QGoq2KkQ7kNvwHa2hGw&_nc_oc=Adoy_y07EeJSDrZRYjA3yrGxY-5wyoMNq_6bwarjCf6sdqK9t_H8ytXs2q4D1YmxsT4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuZ5cVbtGGyqaB3b6vyBJm-Fh-b5DY-Px4GTqFvipYuA&oe=6AFC9264"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
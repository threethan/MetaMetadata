1gjd&_nc_oc=AdrFccj_gFXmkc_g7bgia76ccG-C7hd4Tno-PJpNEYfZUuqn---WHfv-JB21R267QvI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtMcfLwDmvsvv9FrJDUAQDFVuQwq3Qo_xOa0F7qP0ikw&oe=6AC8F1F3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTeh2vJTLncQ7kNvwGK6dOe&_nc_oc=AdoPApmRy_fp1QDYto1FMdGlgqp2XH3WAIkNoQ6X41aq21BXHWzo1bxpza-kiraC6-4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZD7-Fk5MC2R-G4s_vd-7I_RacnXNiHT5O0-Krq_SaWg&oe=6AC90E11"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16MA1x5Z7VcQ7kNvwEYf-AB&_nc_oc=AdqeZhni5padmsjLa9zYRDzr_sQIuXr7Gn1tpNq0h5QN9xlraW7WZgkDjlWNAuw7OtM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpQnTOD7d6pOTFc8_4aZcgvRH3fS-2U2IR-w_4EsTcqA&oe=6AC90A31"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v25RvYGy_UQ7kNvwE8asSr&_nc_oc=Adp88mYtryQShFdvkuO-GRYeWLByLnX9D_qGPLjUKnKbiON_bGW7ypJDaQoGzZwLoiY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1hLsO4GFuEqt4D_cvxrWxMoyOHEVnCODy5zirHcJJfQ&oe=6AC90E8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6LETR95DaQQ7kNvwH98AKP&_nc_oc=AdrvWXTON_wTDyyaoBQH7bU7p4Qk7L9_cy_VUHDpqiOBkvLhsulVXqdWS1oxYumSMeM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPfO5I1JpZlMOpYbsGCB1WS-4K-D2bo0939otk4_55Tg&oe=6AC8EFA4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscd
gL7w&_nc_oc=AdovX_srNsMuFVpDMB3sfeE9k1HCB5r0UbpI9Aa2Qe2K4ggNx48KC9wXm_Z0zSkhc0A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVe5-9iluOU1FNWizvzhJx8evlP76XLACfJJA7A3B-rQ&oe=6AAD4273"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeDNjhZP-wEQ7kNvwHqdVw6&_nc_oc=Ado0UAn--2_lz_SI-7MRG4naA9U-s8SRIVkXlMaqCdg2V04MBo7ro2rPx_DifA5AaOQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYlPtuJQ-37n0eJ-tjjbpNyX54CabHTHTyHD_FNmVbRQ&oe=6AAD5E91"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CffCVUpB1fYQ7kNvwGsP4bj&_nc_oc=Adq2XXTFq6DGUZGWP-pt5hK9iTbx9tWXAi8D7FT5NhikDfQWh-mSGIEk4itcDXSwbmo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeOEOmVPaS4F-nQBl0KjgvWm1GbDe3AwVRv6XZP1IE2g&oe=6AAD5AB1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ec3N68IdY5wQ7kNvwFDcJ3u&_nc_oc=AdqfS00bdxh1p6UxJRCnTmFendcm4sywRd8RnUXECui09wvhLdyYQAeiARXzBX2Q_u8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyynyj3UmEEDWuowDhG8sWBNTlZrgI7Z0wUw5sUAH7Kw&oe=6AAD5F0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xY1kimfHNNEQ7kNvwFIea9o&_nc_oc=Ado3mQCLTsjs9FREAMGBusqXu9e4AwqQJOCZQ2qJD5XP8z84fjRDUVXzU2s76zaI6bw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoLz7SreweBcUJ2mqE4bKs-2NZPQTqP8WBAsXSGCYt4A&oe=6AAD4024"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscd
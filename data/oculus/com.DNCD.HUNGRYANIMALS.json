_Q1b&_nc_oc=AdqsFDO7ifC77WrelAJCTZm8fgEjx7jq0C7lXeVjdjmRuGpxkiaZyrnYhUtviWNMRhw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GISPEu-3kBs8jj0xczfceBuQNhhruXihdnK8Uv-sxSg&oe=69E0E9F3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b33TskWC2HAQ7kNvwFMgmBi&_nc_oc=AdrHfCgDA70RiFTWYDCuL_UV6hPsVkrmUfhLsNfS1MKtxTQ3FlMhbvlWrSvOY7gib3M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iSSOrszqPRsuV5VJts_7c3TDmvhRnZde4zISWo10GEA&oe=69E0CDD1"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdLLKD_8o6wQ7kNvwEsDOpd&_nc_oc=AdreTyXSmI-DDx9mYa3AauOjTFU8dbWaAfPucTXfCqU557BGK6qkh71N7OE7yQJvy_A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GQ2U-xZ6E8yjvKaOOs-V2nALSvzRfIJoR6o8h5HZ5DA&oe=69E0C9F1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kep_mDAaYh4Q7kNvwG6ATT8&_nc_oc=Adr_BwlwovGyh6DjE0RtSovJ5fH8HTe0M4BT3TjudT7z1SreSJ0Z4augLD87VbdcePo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LsPW6uUrXlh7Mmb516WIvE0zaND-tGUs9na7_xht0rA&oe=69E0CE4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGzVK7fuVZAQ7kNvwEbgoeK&_nc_oc=AdrvunGGkFhF-ONZYn5hnJzaNnp4EshfxuC874vl42UtoNXWguwzH7WxjuDZry6TTwg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af001JYtHDkcqQ4NMPwvqrn6ouBE2CcGIOjTlVQYsHwj1Q&oe=69E0E7A4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscd
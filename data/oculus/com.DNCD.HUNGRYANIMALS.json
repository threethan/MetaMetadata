0.png", "id": "1037598403772651", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974530_1037598407105984_2894653620458275853_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9RhwwAF5ZgQ7kNvwF_JBr9&_nc_oc=AdohY6Z3DxgLgXbv_roMJZj3CS65vZNv5kPOzwVt8nX3Qjp7eZT8Pb5SvGm6YQq3MoI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUNA927EgNB6c3nzMVFaW7L4yREe1v8GPJuT3mCc-fjIw&oe=6B0F09B3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fr7Z5Ib8RtUQ7kNvwHCSuj7&_nc_oc=Adr76ZzKU7VSd85kzxRGtZtxNtm0p9jJgUEI32vv_bj-SAC41l5SJJoJY2o-QBbX3Yo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVQaHMGecjl96360kvi4q6R59jnKAoph6lBYqNlpRJP5w&oe=6B0EED91"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmo2qgdDfncQ7kNvwHvMuyI&_nc_oc=AdpXR3osFvQDGHa9bwpsT2-vMsUnXL4L83sHPJ-74Q_fBrDP_E4cMHBwugWze85T22c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWyoTi9Vv9Yp7mR_tY-QAe4WMfi7cAj4ioC_b0xnulmkA&oe=6B0F21F1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIY8binZk_AQ7kNvwECUw3_&_nc_oc=AdpH10i0JjQeC3QN5j8N1mHsFyfrEu-EnN9MxMt15-SHBnN-sfiuCPbyWWKEufLqzoo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWA_JWm6sEhAU1D4a9omaU-GuW2Qzr7YmCS_HU1STrEOA&oe=6B0EEE0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkn4mn2PtJAQ7kNvwHSvrob&_nc_oc=AdqjyPWkmSgWBEit6Nzt_8vks6-xTJPeCoyAdy1mFfsYgLdw9NMRj_wvg2PRHIrWSAk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9CWebR5fURHYzn3JdUpaaf_sCNLRsyzSfGK61xec9pA&oe=6B0F0764"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
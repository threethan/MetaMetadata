-iad3-1.oculuscdn.com&oh=00_Afs6RJ_PbBM47T35H_V4lNT8NghFMaZhMPE9E2q6perGTg&oe=69A2F373"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9AtKb_rA2kQ7kNvwH3wR0j&_nc_oc=AdnDcDb39gcfCye57JVAPkUPG1-A3A4_jdRgiT-aa_gsI8VtMG4ji3UamnJyIUgdXKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv5JgsXvHYBN7RSDMixd2rFOXjdi_vVtI6p8q5Mb_hAXQ&oe=69A2D751"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZkXdDut3y4Q7kNvwGnTG2P&_nc_oc=AdkQCMghchb0qciACxV4AFBf-RFXTO_-Jnz6hqTr3-GaLrZuWYgWF4rd_EGnWz8om9c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu9ksYaw7CdWsoNHsrZcHtAW4yiSOo5XybAa0xiDSW6uQ&oe=69A2D371"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdBrOM9X_nsQ7kNvwFkGzIa&_nc_oc=Adnl5_Q_ntT5O59GsBZKkGv4XM-aRq_6Pyj_sje9bVUVjV6bKthfT3vLJb5JiKYYfv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvJo-T50gc2D9Tj2NUyW0y5jF3NKzkoaaaQKG8xE2Ue9w&oe=69A2D7CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KB3ZWkuax8Q7kNvwHmQZWe&_nc_oc=Adk-b2rWaS_FaW0yLv3bu3M972HYHeSstsn05k5kn8wt3mQsc1huQNr7nBKHy64606E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuVrNs5QobzfugqXltQ7SlfUQw2mqZUprxOGoXBWx_WcA&oe=69A2F124"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974625_471409947982144_8958720854361894118_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5tbJeTcGx4Q7kNvwHeHPer&_nc_oc=Adl
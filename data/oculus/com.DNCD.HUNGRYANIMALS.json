0.png", "id": "1037598403772651", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974530_1037598407105984_2894653620458275853_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAj6QWWE_7UQ7kNvwHMAIRB&_nc_oc=AdquHJl-MvTUFgyh1hmnUmEfGxCn25YuEt6JflO2SlI2kjfE8uIsOpzlRvGE_OODw50&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWpdwrQlx5GMSp8CGnY7mHQZaXhVu4hWnGHFSKmQTWeA&oe=6AFEFF73"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cPrbpRuyLEQ7kNvwH1bRwo&_nc_oc=Adqq7so8m8MHPlJ3618DlVyvXMF4IpkkW0FSIn_U46GPTxu8Vc2ZsEzM1w19AAZW2Xg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYLmJBNECSZdq_WqesuZhjeeGVmhodcn43M9LJhWCtFA&oe=6AFF1B91"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzmS8UzQEQkQ7kNvwHl6tPC&_nc_oc=AdoZsH4ZA5c2_OXmyFZAUII02APbRChE2QfK5pc1xjEot5Pxz12zlG0Dkqor72VwhPE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVNP2jR0iXY-Kho6pXuSox8J0rB7QFSy5kK2E0NkrGfA&oe=6AFF17B1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZEQ4w3egvsQ7kNvwGTW-OZ&_nc_oc=AdrCZlyd0D_fU-ez2zS-Rro4Jp3TkqbLwOn-re-UI75VUPM18pRNyc2-YCo7tQuscqM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZo7nWAbx2EFMyRRVDhNLH6XM-GxCd344uZoS0Er4aCg&oe=6AFF1C0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVN4QGoq2KkQ7kNvwFLx3DE&_nc_oc=AdrgIFcPNeTgvEcgiRYP5HWB6Ogqgf8ygPCeKDcHgQYic5OwOwwc9QwfweZsGjMnHm4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWAd3YE9EmnxlX_zzhpQUmBPJP3PXHS-AtDtAn1KDijw&oe=6AFF3564"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
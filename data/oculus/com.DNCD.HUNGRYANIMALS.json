0.png", "id": "1037598403772651", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974530_1037598407105984_2894653620458275853_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdpioiEuuSIQ7kNvwHVBoUs&_nc_oc=AdqCKpJHEgbLDStCpYTv1x25KPXwXWkg30bWqwBx8eMvdk4sdceDtlaIq659WlvBdik&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp7iz0DXzM8M3Wu5N70ASd54D58-5lLunMB4WqSOZsbg&oe=6B087233"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXEgLDLQ45MQ7kNvwHguuCD&_nc_oc=AdqXaAGzAwmrl8oz87OM5OSjG8KkuFDBcSLR3qFPzYNqZ1W8JybtucbeEYS8ZNJLEbY&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjUMJfEeDb-s3wQwhBUZJLxfVoP6CYreuYqCGjI4XLHA&oe=6B085611"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHbLJ5s_ZFgQ7kNvwHjpliO&_nc_oc=Adp-sTLH26nMVF8j9SHqdaWVfBXmAD4meXn3g-0N6VfO1s2zRJdQBBlBCTKUPKxIYF0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgWuFkeV_QKnbFcf1UcVH94d12D4cfW8ZYseBRWkN2JA&oe=6B085231"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8WRZDvBmG4Q7kNvwHHKYWr&_nc_oc=AdphAqKzdwcUPGSy7mg7H9FMwEWbxN76v6DOabSqRchJlkGvLunsiS11MfQ8v483A4c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB9JNWjLwbC5u54_vgVvbY_ScMXY7Csz-1wJMQtbCgmw&oe=6B08568D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeePUTXqAGoQ7kNvwETUEAK&_nc_oc=AdqqMa0Qn5qhwWbMiaa56G_6ZwKmT-D5vF0XKl6z2o67L-NHPwKhVfrssvaR-V9dSFo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH_jGlFgqsS4jQtIkM2Nq8Rxd7vjY56hBefUGCJXqpYw&oe=6B086FE4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
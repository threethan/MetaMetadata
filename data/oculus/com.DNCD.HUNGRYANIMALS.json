qVnX&_nc_oc=AdqLQ5Z5jBNuMNpvBfsn85AJOf3j-rSXF4Ys0hLlgNYvAzDS_JGmkS5-Nr08r5iPS-E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OPDb9ZWRpIKtpHTmcLz4PZNh-nPnJD1A1_5GZLVWPHA&oe=6A451BF3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJ2fG9aWpvEQ7kNvwEunRmc&_nc_oc=Adqgd96MWwOu4Aq76DCr7H4rA37o3F4H6NYq3XOzTXELu4MKM0_cU6VqMoacyBWJIps&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b-Gtm4zcJrAetSyz404jAE8zuygPeG0ArLd2B-G-Htw&oe=6A453811"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQbLlDTHsI8Q7kNvwEGvncv&_nc_oc=AdopRyr2RwuOdauSpOA_vQqzA1iBDVD-y2At7V3si0zZOVpbuUnWdrEKKrAOgTmtwCY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NzBJDeThLaxFlxwDT_cEIRznpIajstouLcCsCpzPV5Q&oe=6A453431"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kkgrc9XToWcQ7kNvwH-4Htm&_nc_oc=Ado3vYywAX6t345O5-y_XuOstQ69HFGTm3w_6saiwQhXALuKihsYOdw5PYGdDS3UqlM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EUFR67jlsuTAFcnwTrUn_0VXnF8CxImJbT7uQc6jEkw&oe=6A45388D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B51W0AG_rfoQ7kNvwEsag2W&_nc_oc=Ado_cJ6xQwKYIPASy1NllaJA3cIKDQHTgd4TeNQYCi1bXldxxjDfOsAyXB0-K6U1RpE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o76q94hFiZRcZUplA2KHxG7uypgOZxQK_NgRIYns9aw&oe=6A4519A4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscd
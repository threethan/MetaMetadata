_nv2&_nc_oc=AdqGzxTa8E1YRkpykdLBuw8Y_wL2UZY7KreQ9Fl2cxqbRtgUbrcuROOQyjrzpPiHzEo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k39LAyaLNTu-zbuILrqrwT4igGbEtEH-HhNDsORmefQ&oe=69FB47F3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pl2-7yqskPIQ7kNvwEvgIx2&_nc_oc=Ado6GPZLD14g3ny6tJttbff1cXYfsPWb9LRqb8OSYXVHeejuPyaebv4e7bpwI5_1PNk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HfsWNVeldjMocogHJQT5XEaCLCkJ2zwAvhUqVe7hZ9A&oe=69FB2BD1"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7rP1ibliXQQ7kNvwHHZm6X&_nc_oc=AdqH_5IYn-cKUpsNFe0uvDMn-1zF011HiHL0EF7oJ_rsk1_tKwarWFvvANMOTYEDP7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5akpYgK_RDTD2h1VCCcOzPXOfefapdtJ_woWKYCGQTog&oe=69FB27F1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLXi_PQAtqMQ7kNvwFGHkLf&_nc_oc=Adpl-6KV5DOrbWtc4jaLh1GRFUq16cdN7pctlABhuewbsck-xB3UEqD-UZOWcYLy62Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50LV0mKeql-51KH17yg8cBIKymPATAkVTybBsrgFwi5Q&oe=69FB2C4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPft2Xbe_1UQ7kNvwGHO2xC&_nc_oc=AdqOEncC_8IAb-XuCXdJfNdbZ5uZECGMIk_b77pX-RaMAPNPSV49eYk0-1rR-LEHXig&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PduZUAWtRSqWq6tByDzd5mDWCtfy7nZt1SQ98KcBdmQ&oe=69FB45A4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscd
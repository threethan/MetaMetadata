xKar&_nc_oc=AdodvGTk4WG66_JK84SDTA8Y8Gen2dW5J7py9hWYBF88aVPf9ZVRArRMu9K8QuZfXGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANU6RprMY9MBLTW9CoPg66UQVPQKs34_1ZEE7jIUqLTA&oe=6A4BB373"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGuqKT3UEWwQ7kNvwFQmAeN&_nc_oc=AdoArhmFj-b848--j5p1TNf2rayPuQMl_UoNgaVG4og00IFKDJYL5to02eaQ1KM3jBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj_TM2FbTHLl0zMsxd9NeL-rpDvbz7nfQ_KHcrabHOUw&oe=6A4BCF91"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7YcKkdCD0sQ7kNvwEs3fD9&_nc_oc=Adr12IGUUDW0pvmOmlReb-DdQdPC36nI0tkZobYcUjS_LYmxT4qTtiNZYViYRWzH1o0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH2UEYWYGyj_WFCziaxN7UWMdR__bmFTP3abR6URg0Kg&oe=6A4BCBB1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfryEeK5o8wQ7kNvwGke064&_nc_oc=Adpbt6VMnzlgYWHmXKPFQ0qQ565-kSgsxxg8zxJJGCXnrqpU87ANTOvxcrkdX3qnES0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDm4TcobORGlC2s3AB9wLWagmCQEMKdaBtNZzcNN_Jdmg&oe=6A4BD00D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvP3TFnZZU0Q7kNvwHaz0Eq&_nc_oc=AdpuwABXKZ9d4mPH1Y7U0DK2KCWN4DMQR_vvkONyqjQbm-NJiAHVKMGAp7FoeR2WLjM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtvmv_rXsCzvYM12Rf0A4m2seZTG391Gezon5Ug7AO4Q&oe=6A4BB124"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscd
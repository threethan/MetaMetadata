b5g642oKApiodSXKrPugGoeRKGdK-v-asH_p2wYAApN3A0vRk4fSyk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyoRkZRQiCFrgCtK82KuavBpnm8huTtkDd83egcac6nbg&oe=69AC0DF1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEaZJtW1lx8Q7kNvwGL4jok&_nc_oc=AdnHJnLelDnnnl1BAlZepywGBEA-6KCm_eOcJ7eT4eU-NGhpKq-AExXSU_iYy9_C_sY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfykUES2HZjsmByO3ErwRoEjMv3tuJ_NfIv3jWYzUPqbyA&oe=69AC124D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pCmWQfhdFkQ7kNvwGu1PJU&_nc_oc=AdkDfYmP8GBqq8F6-qU7anG4ac5U3quD8_I3zLSCKFrLpKHoeVpsi3sxAB6h89aT278&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwAIyu-0pp17l00uMUpxYIGVytDH27WHc4CCGc4Uiedaw&oe=69AC2BA4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "954728751871929"}]}, "baseline_offer": {"id": "954728751871929"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1649349600, "status": "PUBLISHED", "id": "954728751871929"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7062303610511116", "version": "1.0"}, "id": "381680303772935", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7062214083853402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7062303610511116"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "381680303772935"}]}, "change_log": null, "created_date": 1646131678, "id": "7062303610511116", "version": "1.0", "vers
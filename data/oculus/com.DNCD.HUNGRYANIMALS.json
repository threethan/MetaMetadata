xiHJ&_nc_oc=AdodIMGpySG8c_mzuW_f3tDXlH9I6xBkMyciy8AR6ms9THRzC49op3V2YdIO-0Tp140&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWx5iC7Uu66fDurAWP3MGTyApiMcjx7_ahvnzZedvw0Q&oe=6AF07EF3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6VG6ZBzgE8Q7kNvwEAvRi0&_nc_oc=Adp55AVv_O6fEOv268vy1uKAUi6Uoxdu2C50NsdXN_1ZIM_smJGFCyg-QC-nm0ntkSI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4lThNl_Gdf694E29Uiaaa0H85Ywc3eSNZhj35hcJAIQ&oe=6AF09B11"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsaviCuKVzYQ7kNvwEpMAa7&_nc_oc=Adp_JIfQ59FkNlV_IKNJ8bXVfN0cNbB-Pz92eA0dxRTvZvwx5npWkK3T0-G05aZ8uiQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCBHuo_vDiK1FJjSb_yU2q2K3IpOa9qKyMin5-22w66A&oe=6AF09731"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITX4wRk9MLUQ7kNvwGc0Nkh&_nc_oc=AdpA5avST5FGN7uYhgo5zdO_XBTbOVyOxAbfV69YQhUTDhoQ3wfxThrn_QBZh6w2pwY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWZ0zlISgVqAfSlq1eDQpZD-el0PyPgKhhubyu8CcelA&oe=6AF09B8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVe7xKpBuiYQ7kNvwG2NuWh&_nc_oc=Adqviwc-xNveLhBbvpXQaQZJPCmNDUDDRbZIXgfpcECce9ypQd7bzF_iSUIXnq5N4mE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRP80ZSz5ox-IiQfY1ZukEr1Qpo6aPxra5BS-mj1ZQUQ&oe=6AF07CA4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscd
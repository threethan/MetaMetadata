0.png", "id": "1037598403772651", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974530_1037598407105984_2894653620458275853_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3rhI9kZRTcQ7kNvwG5smn1&_nc_oc=Adpe-rK-sdXG5bIh_8YOonZh5hHFHtlZUrAy7ygSWUlsvXA2YBJuZJ7RE84EuC-kTaw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn6GJ1Al6dsEt1sIGys2kxlVKf_ObPNainsTb7eWTd1Q&oe=6B008933"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cPrbpRuyLEQ7kNvwEZTj32&_nc_oc=AdrGCgJPtrt8PpiC96OmraQQc1QE_F6nO-wmaLkUmwRDoViHdIxyGrNGEx87YZ1vtAE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSWfcM7lRECyF0CtCnDgvZw2ei6kgqsnS5TafBa0kUzA&oe=6B006D11"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzmS8UzQEQkQ7kNvwEGGYxB&_nc_oc=Adp9micLc59bJeTqr4ol2V6adyKAADpiNQV5zlffX8RSdgHgNY2AMQgsklf9n5XthVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoEsUEQkbNZ8pd0Hpoj5OOj3WRSVE-l3Wgp4DEFpX1LA&oe=6B006931"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rybictcFx8Q7kNvwEZ3Sve&_nc_oc=Adrg1fZeMzjnfF15GkNKZsTrYIh8nLHFgrjKwEGLWl7FRoFroNVRHaxaizQ6WX_6eoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs8aSXPF_rBgw_vEkBqroeq0GAFJpE1UvVoCAo181Ygw&oe=6B006D8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCXywumlfHkQ7kNvwEE9Twn&_nc_oc=AdoLzls8Y6PAefTZR2_LJc3UEDxRULhyfCdqXjGRwsvXT2eDEJynKbighLYnaXqCA34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNU8aucxXLx_W0MZOxSDeLZydGOuUNtIm75HDfmNYSOQ&oe=6B0086E4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
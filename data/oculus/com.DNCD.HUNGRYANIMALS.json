u-QB&_nc_oc=Adp_jxIkj4Y5PzVfSlT2QL09DnEZ4B4cPvqPQTQ-CXWL_JNo9DrFRfoTokBGyeAyLDk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7PshRlRlGdVmcYo3pAHd5-t4FdYODdIn4bnCSv8eP3Q&oe=6A68B473"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOD_bC9QlyYQ7kNvwEAjjEV&_nc_oc=AdoxYfaqiIWAMIyaZmbardocikuFhyS4ges1kUhF4CkKXs-vCmxY0PAfybVVYmvCf4w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiBc04hpF7u2n1i7ejEg7ibNaR704bYRMiXCTnQNO-NQ&oe=6A689851"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XG3koTkYInEQ7kNvwHwPRMY&_nc_oc=AdqA28DxwNhnLZuCCgN6D8nW6w36V9QC-9i0fGZc-N_DYENA7qoH6ZuizUcCudITraI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCszu7cTJXqc4zaWzFIoyXOPLvYyiw6qQGclNm3sVqnHg&oe=6A689471"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7BMNV-JsmIQ7kNvwHq8EEJ&_nc_oc=AdpHTDkN2_3wSjutXD925J65J_63qU-tHhT0Y0WfKo-wzB5f8tmS1g_0B_6G1zcImTI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGRGwVCe_vEc0N-UwUkhQTamu3jp04JI-VVlwv7fHXyw&oe=6A6898CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bfoz7tIyUTYQ7kNvwEOa11f&_nc_oc=Adq_lO8_6Vs0cDS9eBsBcaP2akjlWgYKhnRII4sVF1x3lnlZo9fiix5gCjaAhFhbQ4o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPPXARzspCcpz8l41YueuSkmARVTqa4uex6U_vxA72oA&oe=6A68B224"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscd
rRII&_nc_oc=AdpK0QEqK-Ft6w9aC-w9WIjh0_Dca64130rvpcPGy81-pFJHzkUdBuC9FsCSr2p3TzQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3abxnhecyyBAp1c-CjkGgE0gG06qADOEYHX3Ei4SJ_8g&oe=69D7AF73"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pa0AWLxP71YQ7kNvwFSWUyS&_nc_oc=Adpy8mZOXeM7zMwy44k-ZgAVZRRte16bQocZ0MMOESnq3_UBo8L9G-MI4Dw0Dz97DpI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KT9W262WGeMoSYxEXJOEFSFPDDCTXr3P9q2MYYEdYQg&oe=69D79351"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fE-HyZlUbhIQ7kNvwEv1Ugr&_nc_oc=AdrAu8_WS6LHYoXlRJ5h-CCXhZv8YnCJpXKgIRA9GDb53H6TH8EznEIEIx0tQIAFDtk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eZL4E4vAJh3W2yzsrG3eFcHj8UrTw-K43BMuV8DpyrA&oe=69D78F71"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMDjWee5pegQ7kNvwEpMhes&_nc_oc=Adq_y1dgW3u6OLo1jxP91nxCD4sguhMzBygXo4djL5foxB9Hh7cM6OD4gafv9ogjz28&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0S1CPdRuWl9cl_ftz7DKihTz6qmk0Em_kLu_G9bitO6A&oe=69D793CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEHdX8zi1NsQ7kNvwHINwB5&_nc_oc=Adp0cIH5DD2Llisw0V-Dgt2f2vqV0es31RXXddHPKJgNxtJ_HnSvPAGq8v44cIL3Xjo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21LBeAwmVfBgwpVogdSMdgSmJXrIGqjbg9N4PavpTESw&oe=69D7AD24"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscd
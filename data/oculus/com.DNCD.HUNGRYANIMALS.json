XM5f&_nc_oc=AdoSC_3sqG9UZ_Iz4ahKgvSLgZPocy6UYNZGKkaDFakuxUDNCdocruxOHH5m-hb1D3U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMkRYeyo1oC8eSg0v3HJsVnoNlxl_7jgn0Sg-V5z4NOQ&oe=6A5A33F3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03nWVutQ-1IQ7kNvwHI3PDC&_nc_oc=AdqMjlDlN4QyrhcCoBi8Ryuo7cNjebyYcjbPcl_DP7Fo5Jy2M76RrCodbMQr70AOWto&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmxe4ZuUbZgP7Mh7DYNc3yY3XHopoXscvqM3lWVykGVA&oe=6A5A17D1"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-vbIqMqsBcQ7kNvwERzgSV&_nc_oc=Ado1jdXyTF1PmlhDOoU7uzJDX3w2mD8pbKU50i3d6PH3H-HXbC27B422RVAJnIXfu9I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1QBV0bK6lrknKV287k3IiaYCXmaikuDeqdS7EPX6vrQ&oe=6A5A13F1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGVdpvV6Lq0Q7kNvwH7pIAE&_nc_oc=AdrH9YD8wGNDL7cDIThya5Mp0zSDKge2vvYj5wa08Dae9VWjJXD3ubn-NH75384vk5g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVh3jcK2esEDtz65m4ExV3YMousbid6Ysn4WuftUzflw&oe=6A5A184D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8D9GwVn1mkUQ7kNvwEXcGly&_nc_oc=AdrVr0iSRb39Ks7smGGOpOYYY_-h9FgtLzyK9MyD4qkJoR0GDIhkLYBMGhfOkd7Xa2c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU5TkzhjR-NjKsDtF0_mCIegmJGVm_TXQWuYDvIhCJ6A&oe=6A5A31A4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscd
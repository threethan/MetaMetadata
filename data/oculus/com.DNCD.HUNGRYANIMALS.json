QNQQ&_nc_oc=AdoCY4M1k_iv1wWCeCUwrPWCgREyEwDBuoVxoVUXHZcOq2VS6JDeGQ6ks2dKW7nC0NQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85ionEOKk92PivlXR32-hbwpYqUO4MbRms78VReYbpZA&oe=6A3BE173"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMizHcMC6UUQ7kNvwEPEh54&_nc_oc=AdpcdGM9yiwil_omv7_H9u4Rf_tKZgXWSKhzOHssJun-y7P7gspdw5HVO1JlzLL52hE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cbM7-cRB-vUC4iJYVlBxxSDhfCYP3pipIexiy74dmNA&oe=6A3BFD91"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6Jfd-63dycQ7kNvwG155Re&_nc_oc=AdrRHNtlk0c9rcvTr2NeGTI7-5do6oKQpPiQgQiZyf3Y0iSIHJgW3Aawkj11FLn54xQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dcMmOp7VNisceBumY4Q3xdHJscBxtsvkoRtNAeEQ86Q&oe=6A3BF9B1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZGSzzy9oakQ7kNvwEN22y3&_nc_oc=AdpZZ6Px8jW80qbqYge6sKP4IoJN7w64coHd5n3PawO7-1b7gwy2hZOsqHT7YXk7mZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MtWra4rAQHhWaCQwbkS5qn6JABO8pcYGALj8SRl2Nlw&oe=6A3BFE0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOKM7wf19z0Q7kNvwFgDDMI&_nc_oc=AdphpM3jtzCFcrIhMFyUHJgQhZ8ke_iJ4SzR49mlbsdLQv-m2S2K-E2-rjXUNMdfezs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lqidS1E0r71OgJxINaFhiw8A-lLg3PgRVV0jhDT8wgg&oe=6A3BDF24"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscd
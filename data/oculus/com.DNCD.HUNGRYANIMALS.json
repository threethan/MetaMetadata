K78s&_nc_oc=AdoTPDtYFV4xq68Cz_PzWIs3qGZIXohvTny6Z1jR_s7j44KDftXwERmMrmQQt9_tJq4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2s1d1pyeX7wDVjsc-hPhhxNcv0GdoVQrCId9Db6YNlw&oe=6AF9B973"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3blQsHnmHToQ7kNvwGUo9eh&_nc_oc=Adq0wBstUaiibd71rBTwTtG0FkhAauC7ck_K5gtbcRxvUP2oEVY7a4OHTJnYaOfFuLo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTN2FOpwwlJS1G1Nm55P8YF_fqVExde_9whnk881h_dyA&oe=6AF9D591"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbR-2ApAWnUQ7kNvwFAdM_p&_nc_oc=AdoFxGuqzHft97BYYnREGyGSx-P4OcJ9hdN-0dWnYpSSa993QzSDGZBl_ExYan3yZug&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdy5OXiTB7w6EC4AHGUGaUU1jaPg-VywHr9728pnNISA&oe=6AF9D1B1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHydRIDHKD0Q7kNvwEns9Wy&_nc_oc=AdpBQ6FNtOzCgi44BeLRDZXjlwxNHjy4TdXvjPm8DIAsv7C325K8-qKs559h2Z7-334&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjug_GcNWOdq_waXRJcVf-PqaWhAsmzIAtb53U6hRxDg&oe=6AF9D60D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYUGqv5A2xYQ7kNvwH5SH3w&_nc_oc=AdqieUWrPx8iL673fkuY1kVT6IYLSizpq7-aI7_Y6T6aSvi1gKqtB0LF6OUVAchIC9I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMvs6KcULWBAgzif8MoUvM9Cjj7jcqeeo2N0MiKBumgA&oe=6AF9B724"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscd
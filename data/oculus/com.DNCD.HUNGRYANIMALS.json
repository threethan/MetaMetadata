6EpW&_nc_oc=Adp0ETodVXT2Vq30mHH66yp4KiOlePm_XX_Kj_RxQp_1ZxkAof1bU8AysWdhOJ35ZZE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOb8Pq07D9e8mdu9fWaDV8OZ7IzI-A87atoLige1BVbuA&oe=6AC7A073"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTeh2vJTLncQ7kNvwHAwI1S&_nc_oc=Adq3cbHPQ4FYdUo1Ju3fEJSKoRzVp0dJBaobU7rzGLhTC_nfvcTsd_IWWDnKxeZzQKA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDUA3dg2XB36AlUdKPu5v7QOJgaDVJJQJma-WcS_ojQw&oe=6AC7BC91"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16MA1x5Z7VcQ7kNvwGaM9QG&_nc_oc=AdoRQrkpu176S419dSoZQiCR6I2T5kt0yCIY9dJX5BUEqcPnJ4U40RmRLcWdvA1bSQE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIE0WH2CGQPV4-6YOXuxaxnYyLICOGZHP7px3H0h1GcA&oe=6AC7B8B1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrJKpvZszEcQ7kNvwEdh234&_nc_oc=AdogokkdXWm8UZM8rqmUHdUPVfs2rtaivnkgpkI8Jdgf2cQV_5hMOQeY9JOl1e3aanQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEf-jh0yMrarx-NAdBFbdz7_xplSZEB99eloO8oKLauw&oe=6AC7BD0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkFdm4xslMcQ7kNvwFGWTsQ&_nc_oc=AdpJ85JvhL_Osz2Uoa8xkD-R8IFe5VkTaB1Z0YzyZutPa0v5vU0PsHqtmu7NjtCLfcs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpyvCjnoOu7n7ybZBCFWPgC_NqVphWN77o8n77lwktgg&oe=6AC79E24"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscd
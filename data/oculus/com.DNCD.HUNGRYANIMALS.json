bzib&_nc_oc=Adot1TxUlMUmYxxq5HC9V43oaVWj6DeE3ZyqSS-YCKUtpNuln7-flp5Q5XrDXAlJmx4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gkXpe59yoEpHF_v0cbAZFSXMHA7wXmuzODdr7P831zg&oe=6A33F873"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwtpAxrhzugQ7kNvwG_2At_&_nc_oc=AdpHG8ttwVesuIdKW0-YgA2AYvEHqzMi3N497_t1T0zQQvJ8yHY41p8Bwq__bZAZlvA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81QG_vCgeoj8sn-olRjs0u6M4uJimeoXVAmbj1Hg6Aog&oe=6A341491"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEkQcIoqX4wQ7kNvwGf6yqs&_nc_oc=Ado-du56RP1-edFn6qzxgdvW9EtvuDeMWyrfmZ1rrp_LGudNiK7qBC2JHNCYAseP99A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lHeMq8CvV24inS2rC2l9LtHNngC6OTAcIeG4CZAKxrA&oe=6A3410B1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gJepA7qViYQ7kNvwG9INb5&_nc_oc=Adq1qxAv3z3tOwrWt46dig8Gh98Lk8aWaRPSiCjCpFH4r5vj4l-i4xkCYvlmJHAdAsE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iqAca8v45g7ORXY9T4ltgnb1dkPQtmNq2ZWrRHWOj_g&oe=6A34150D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGdZJI9YC4YQ7kNvwGIPG5e&_nc_oc=AdqFeYcewKppZze5Vfvl__k1Wm1Y08R2OocI42CsngKB2D4K74OgHC9E4V5uUaWG4r0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9698kpdNTSuP9tx0yj_UHu-kJLuiXMtBDWQSyvbyiYYA&oe=6A33F624"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscd
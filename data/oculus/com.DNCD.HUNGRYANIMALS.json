-atl3-2.oculuscdn.com&oh=00_AfvccwgyXBQ66Eqa1KCs3b_vBiHFrrZXQNQrXSWrJBGnfQ&oe=69A59673"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9AtKb_rA2kQ7kNvwEnWg11&_nc_oc=AdlDWk4YgprKoeRcCw563SzOLialGJrGe-kGW70W_F2ZlDE8Y1GnArmZg8pc9K-FLZc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsvsX6mk1l-lEmD42RIHjmW9Mr1uo48jLXEgRqRkkcC8g&oe=69A57A51"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZkXdDut3y4Q7kNvwH0fyal&_nc_oc=Adk7OrntW11igFXnpR-uZJvX-wNJrmMgNiElDcwOzT3rLpXt4xkxC3XplO79vYykUs0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afsb7OUB7-yfILdXnNL_LbkpKFnrYoJwMZozA0q7bIH0sg&oe=69A57671"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhdK1n7sENoQ7kNvwE7CY2y&_nc_oc=Adlf7u6GK8ulUMf4YB34TW449qy8qX04hfRreh8p4Jlq2EZKbDc56xfgF4wBUbGXLCw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsgyW5cZq38ksAnMli4dO5ikT-hQiIzMPQiyUpuJJ-Q3g&oe=69A57ACD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieiGM9MPEfEQ7kNvwGj9nW0&_nc_oc=Adl0hxKRR7_1NdMOJbSfrZLZHCz8m3GLUwqYJ74C-9JsJljy3L7RAWMbfdw04Qo4nKk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvaxdyEEKKArNFbBpWFUIvFjo8iqFvT7p3lob3ZZBZGLQ&oe=69A59424"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974625_471409947982144_8958720854361894118_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iK9Gs-ZQzK4Q7kNvwEORHWk&_nc_oc=Adk
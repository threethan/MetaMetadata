wm_T&_nc_oc=AdoG8KhSIT79U19EGrE25yidapNTguPXneFbYtNmldvjAaQwv3clKyDZYelnS1prYcI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH33rlfmblBqTugL5Db6mkls5oBQjo7u68q4t1IFhXMPw&oe=6A882033"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoiB8lBMc3sQ7kNvwFqxlHH&_nc_oc=AdqgXx-W5TrUkajALMWFaUT8mqUoNiAUMWfM3m_-Gwau7LPlR5psVOka11Z9SntOwiM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7wUnS7tVA56N7wnD2nmETX1sHk4CSvV5aZuNDPocxfQ&oe=6A883C51"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Vn0ZN42fUcQ7kNvwH59cCV&_nc_oc=AdoqiktfGpdesri9tTFuvJEKV0VxtzZ4kDHM0qKEwAyOYHqxDmBga_wDqClh2fsD4J8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsi9nesthCVbVx457ex3Ke5OFrriLqmGOyqH5AAyvUBw&oe=6A883871"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyOnu50-HqwQ7kNvwH9Yhqz&_nc_oc=AdoDPSHUsg74MC_YxbffA7Tuuu-voEYTNY-oUbfPn-d7L1PWaV_ZGn47SSr_cksfQUs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZBgTacf_XNdBmsilA0KSl-XVn4M3ZptH8-sw2HJGFLA&oe=6A883CCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSgi1yVXYeYQ7kNvwEFnIUU&_nc_oc=AdoS8kwrKxIjyJyHg10_BsI0pJS-izOPFmDUBFgW5BNKuDe3mseanVRFJcvQ5mxizTg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH15MvNUS89OC4teDMUltEpvOAhEBbt6MbHc1p6Ip6ZEQ&oe=6A881DE4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscd
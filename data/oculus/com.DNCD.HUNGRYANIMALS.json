yrvF&_nc_oc=AdrchTrSq1de7MJr5wMmn4VIZU1KMcVGluodpW2AOqYdRGDaOO-SzQnpErNcYfLceu8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W5xh6303ocYMFoQVLAt_9c2YxvIXW6BoS2YPUdMez-g&oe=6A2D60F3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCgzE-Bnm5QQ7kNvwFDQo1B&_nc_oc=AdrG9I_fYnVgFu06xyyLaK8PuPq3x1ac5Gg6GGGtuH0Ee14XI-FXvvE6QXjBXfoP9Ro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aewT5CS7iclLWgwdIq4tFJikqtwKU4yPZoJKttCgy_w&oe=6A2D7D11"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHULpfkNOAwQ7kNvwHFfVJD&_nc_oc=AdrLvWULbcEZ7MkgI5PtiAEpKwfARmu0xWNQVkpmtVuDPxMZZhxPWE6wMCD-jYIcNBE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hyz-q8Wj8gqYLern1OdnZvAI83dZknZKJQCgykkymiw&oe=6A2D7931"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OkFa03Y7K4Q7kNvwG3HzTm&_nc_oc=Adpb8IdXM24D7IGqAQbUA1w2-7l3P2nuT_m9HiVkVCGxDzBzQTzoBMgpet8C77tYPpM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AuBREmx1wqjor5OAe21W1lD3PAUm1Jaeayq1pz0NLYA&oe=6A2D7D8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2gC0JtGhugQ7kNvwGOBXV9&_nc_oc=Ado5Gbbk9QR6hv6gEokfuyFk5J0DJ3EmzZZVwsdqSicSVpKhRm2-2DE8j2oEX0hiv6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PEuGqvMnQDTMvNJ7HgnY5mlZ9i-IraBeSLdQFEwPOvA&oe=6A2D5EA4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscd
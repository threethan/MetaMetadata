n1Bf&_nc_oc=Adrbx23dy7iZY1f5bmkRsiV5oojCXNZAdUB1oUTN5-WY6AxKTWK95klYe1eRTbCGZ5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FVJIhU4AvNaxWiZ-z6it_7iakWjKU6DHtr5slwx997A&oe=6A296C73"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lqko0k8Ss4cQ7kNvwGRRBHG&_nc_oc=AdoiHtWrV7BjiNC0bLW1FSq8fnA8svIFJIgu99ne52ZY4wHarpqXQsD4v_4EZb6Imuo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Vgc8GcAXcFfpf8o3LDg_z042T-hTZSOzdH0-z9u53Tg&oe=6A298891"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0XN8Egn5TAQ7kNvwFKJdaY&_nc_oc=AdpcgW1CP3W2Dw_I7dmhrAcUIHAtFzI2IbWRWdkGggYcXnjQcRWR91CgtYDG45B5ioA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mfgp_7c_6U64062GDRCo9Gkat-U24oQRjeuyCXXWS6g&oe=6A2984B1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9dbJotxK2YQ7kNvwGv37S6&_nc_oc=AdqovHivtTOugSkjo7yvHmO8yWohM58On5fuh_CjWd1tEYNBT1iIO_0a_xkMSZSqGQw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RnUYodoFyGBNvsKLvEKWb6PvB4DUubsxOIbEJLHqo3g&oe=6A29890D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsY0HOWs8OEQ7kNvwH6zr18&_nc_oc=Adr1vXOwRQ-WICOlyZvo4T3c6KnMmDmUkdpBEAdO1u27-sMIWe3nLClIZ8-3KY1I64M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xKyOwVFdaJ5hMuDlccx4KxU97vgZN5V62B8OKJKtU2w&oe=6A296A24"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscd
acae&_nc_oc=Ado-AIppaHpdlAesry7aL8LoYt8d_gk8n3idpPdXjM76ZYGj3-24KPBgAOKI_GXOCsw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQXFvhDpEdsvBQXE7u2ud6M-xId3-7Mi2hlemSwFAlfg&oe=6AA55973"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJPixw54ra0Q7kNvwEpN7dZ&_nc_oc=Adr_fL_vqP59LmaTJoqS1PGyl_3LYkuEjbi6ix71IN6BB7jloEn-9tWzUjX6tEcFKew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHN3vwxr7PEeA8y2XHDrB5g-ILHfvwqUfCj4ehkowVQw&oe=6AA57591"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHi_kpPhIVIQ7kNvwHFZ52o&_nc_oc=AdrwFOy6cLPrOuv4Cd6ailhiOmua0oACDQfcSQH0bPwCIKFDoLDFtpCsBs8MsVHYBaw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0o6yGofv809kJvxt9nzlki5H0OxucORHS3LMmrWt7sg&oe=6AA571B1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWpHaI4ClOsQ7kNvwHRVGAt&_nc_oc=AdrgeiiceV64crBxe3-AFlXIrClt1OopRJYnEUvhdcyNVMBOpuGzzqMevDGTm6hHEsQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBccFH843HoCrT8XyJITYA6KIggPuaXT6lKiXhPHspoA&oe=6AA5760D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SBA_uFgYQQQ7kNvwF1u0n5&_nc_oc=AdrSfGPA_q19U1uAW6t65gMo8jelsZrtAE5f4Aml1itot8F87zvEvBfv37O0-u241Bk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSA2HDKNOsp5abmXRfibyI9VwVBYIiIx-92LwvxaTLkQ&oe=6AA55724"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscd
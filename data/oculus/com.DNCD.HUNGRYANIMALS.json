6aNH&_nc_oc=AdofchIWWBHdEDj52IzU_cHatMf-0BU_LGrmcXeI4xtKY1TsOKXOPdkqjUx8jnIu4qI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPsgCrdil7MBha-_AWiSTRZe4-dDsYdcUttDOT9xBnCw&oe=6AB67CF3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7F234kGQDMQ7kNvwHPCbXD&_nc_oc=Adqn-J0quMOXB6kyZZiqY1zlYxRlrqGYqEx09BLBPIzGQ9IHh2aLNPf5BYpIgWKiqYo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmZkEWa0e2VFOtmwr7CTaTaYjrJ_-HUyQJTWEciBdnaA&oe=6AB69911"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBhjqhrK0S0Q7kNvwFaV5hS&_nc_oc=Adpl4Ftnlgzk_hwBKI-LbPA3rCnYAdDT1ilxBPOFFE12ruUXahDxULRHpN8U5uPr6Qg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-yI1qGafEOAxPThRUjGpc96GP7ZOlnkZLZwN678OrhA&oe=6AB69531"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9WmT7AY9DkQ7kNvwFFCXYP&_nc_oc=Adpr1B0zAp89NUh6f8CgyuMyG-a4U50L7J5OTXi9uiTWmr_8dGs27ZyJEzCXyYYumfI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqLk2Y6RNXUeL3UlX5KaLmYa3yvCGWXSAJ2SVvYw223A&oe=6AB6998D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_rzSt2zmHgQ7kNvwEtGjgB&_nc_oc=AdoTAH26nKdVzAn14edyQWKXzS2DyXDve1wUwp4qHJWgHwkL9riDG0cASU-da_dITa8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJt5XvTD_77t--9wm4zYbRA0_MbkYres1hy0GkqN5VH3w&oe=6AB67AA4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscd
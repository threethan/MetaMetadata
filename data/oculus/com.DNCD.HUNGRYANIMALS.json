8G2f&_nc_oc=Adqh262DRU67hsyV_Q8JG1lxGUfYIAgQlgp4jZl91O7SRZeuhANSm6o9XxusXdnR0xs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMssXZFtHoxZKW4Zk7-pk4nv71m6GK9JU-B1Od0EBO_tw&oe=6AD0DAF3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbZuFidK4sAQ7kNvwGPSsoI&_nc_oc=AdqMheV36Qkxh6fq5vEjJbS8RpOO41WYRgfTRdFnF5k5hernD2JVm3XxrDWe4i9VODg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo4H68pB2V5eadLXaghJIsHxrU-5NiCXYRmGmLq1mf6Q&oe=6AD0F711"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZJz6zG91AYQ7kNvwFkzVEz&_nc_oc=Adqa2zWSUVTOdjy9DuibHgTuzuFK_XM_itHGpUsSDiatBuBsYoRYJ_UAproPNfqulsE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOa-8d27lPrXt9g1X0pTgp8opG8HMNrq5amPjC-Ehvmiw&oe=6AD0F331"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nPXbzGu4KwQ7kNvwEhWaib&_nc_oc=AdqGUKT3Q_zglDnvBLskQRUG-J22w5vHLP0P2SaeNlovvE8rJ98uLM4nvGFtTtNBCcA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoxMCLftSxTJuNiTpA0WaeSONO5v8nbXClY3jCZQ0thA&oe=6AD0F78D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIXyruoDdeUQ7kNvwF6f_jQ&_nc_oc=AdpuUKaupcXJ9D5_Bk5G5toRMCKhWx0fvSbdFrk-zpJHAlTXHDIySRsQYzSIhrRTpq8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEx8yFjbshxT5jzKgARedRHD5O958ixed65lXglxcR0g&oe=6AD0D8A4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscd
psh0&_nc_oc=Adr5ju_gjG2hPQM5-VBUp3I8iFzWc62XvdnK3GjRa2p0D13JbLnUrBlZ-9zq6XsPgY8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wJ3wi_zGnyxutzjqa731a8r8OlsZ1L_HbGgVdQvBlPw&oe=6A47BEF3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJ2fG9aWpvEQ7kNvwG6zqHp&_nc_oc=AdpaWbXccvpo5W7n3jygJRrUeiEyg_EafrWWxhn8003k1its4VherPZUJaBDqSz1ZDc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l4KZVJtSENBXd-GSzQsY9G4lfGdGUtXvTxl1gvyCXUw&oe=6A47DB11"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQbLlDTHsI8Q7kNvwEC0Ooe&_nc_oc=AdrMGiUhoOaFnmv0Q8-CUI2GvV5ppGMZO_zRSg7cLrSIL0Md6Rwi8Aw522rm6fcQaZA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RCaGPEoaqnyZNNtiaYLsqIzNEl_RYKs8LRnOaDKWIdA&oe=6A47D731"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k44gqq-OfJYQ7kNvwGRiSgX&_nc_oc=AdrK01GLWmm6jpQ5X6laDF9PrhJvQs4fntijmSoX0KoR1lwEySjM_Xr497_JN_5Hl0E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cqMz9mpo3fBKRa0U9mdyLXNs1aBnzLbJG3GdUCt42Nw&oe=6A47DB8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3F6eIrFjYMQ7kNvwEQNP8K&_nc_oc=AdqLxJKex5xaqfvvoaZfwR9I5pdOxHCafhbNGBJBvbvhw7Mbjhac_-438pG8Hz2GIDA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BLnpv622hVpKt8xtNctiSFIShT3FSjxEf1HMw36B5sg&oe=6A47BCA4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscd
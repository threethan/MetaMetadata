PW7q&_nc_oc=AdpXC9C-dWwrSP_wXTfGWmY_X_K9ct1xj59AZ6u-ysmSAxtHXf1Q9lVfvhU4o5m1rV0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bJkBGkbpbUrJnzVbc21tUIu6gEjkvPYTol7rXUp-JGg&oe=6A2C0F73"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lqko0k8Ss4cQ7kNvwF38H_U&_nc_oc=Adop8Nz_oFZ1zkTiACiPlb0JXpg4kA2gSYa-FW_hhxAac01gOFRofKinZxWLiJtzhMk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eKY4GQVQd1iCvxSVUc4BOXTZO6Tt-7vKLQgu8dUH9EA&oe=6A2C2B91"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0XN8Egn5TAQ7kNvwEviWPF&_nc_oc=AdpGaRyzXTfAqlZAjaPkSK85_D_64csRiJZZK6modYKAOjRDX8_KpBQp_7l7Cb3nJAk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Uxeu-cQg_WroE7wksuP7h-I6yeOGsjAdknZDv5Ng4Kw&oe=6A2C27B1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OkFa03Y7K4Q7kNvwGAsuQd&_nc_oc=AdrERTqSAwkH0EbAvyeN1OAzsQKTWPBGrB3eh3BLHg40_pfm7oy9k9j1WJIISvmSCOs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8PT46RaTguCRiVy9JE6QE5_06a8BwFldlJA6rE4sD5w&oe=6A2C2C0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2gC0JtGhugQ7kNvwFd2B44&_nc_oc=AdqedCxbHTpUCt2VhXLVlIHVY4dEP37QBea8bzXntqoeLKrVeTcYHSKjR4ovZjImoho&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Uju0Xh6HnVMsZ_O8j9X4U_1l9_2VCZ9vDpW24_g5mCg&oe=6A2C0D24"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscd
vwGecZd7&_nc_oc=AdrWLTp2ujXZvqmvmzIwOQ_bt-nbw4yPuBNHeQpwjz6wTz3i3nazR98_Mx4eBjlknxg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK62BoGleptZNjzusPm2eC0bBNQVQBhRSgP-CUa1rSyA&oe=6AA94DF3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjEsT3JCehsQ7kNvwHcKEi8&_nc_oc=AdrrKf19lzK8-IvdHBRm9XRWCRZo4H3j3MnDN95CpVLCOSrHJlhqnA29w8dUgsvR2Y4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhA-NaK0vciYTrPqzMAEnEpBoVMoYfA7IGeCMMu3Lyhg&oe=6AA96A11"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQ78kwxDMMoQ7kNvwEWhCsC&_nc_oc=AdqsgiSht8KV3oGphd4pwg9XMNE-0-exCjkOw0qbW__9nI21CUE8fSU3_0qyt31-31Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLprAo2lx7D8AX3OF-ic-knNnMuV97uW_jLQI9GF_lcDw&oe=6AA96631"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Teq0BvN-_ngQ7kNvwErsZAs&_nc_oc=AdopEYiYzErekV7XQmuiGrJ-Wi6YjOCDxnFIYyPhTA2AgrGk5XXw5VlGmTlbCrQUrjs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyC9Usm6WNoNTvQhE5p_uwiEji3sDhJE19FmwkVtumbQ&oe=6AA9324D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_wU2J7qzc4Q7kNvwE4D02h&_nc_oc=AdoQd8S8Xq1DmpTjihB1yv1LtCEGAK8AUuoTUu1Q4E0La81ZWwjCTH1F_vcMTBziYLU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJvflyZMKc08JaziLDAGyvZIzYrGWXdBRymdJWGx7hlQ&oe=6AA94BA4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oc
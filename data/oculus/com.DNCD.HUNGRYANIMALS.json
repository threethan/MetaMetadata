vwH8Pykg&_nc_oc=AdobYQGpfN2VOgCzZpbEFoJFyCTDBJJPMBGFkylgou02VVDz5414SZb0R4GvedGBm3w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-up5be1PGx-TwXUjzcAaX6oifIgpupzK4Z_xvgJcOkw&oe=6A11B173"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgnT8PP1_QwQ7kNvwE3mavR&_nc_oc=Adp8S1dvHf49TYvyI1Ci6-YuUpq5Aor3z68jgdniuMaT973GtyyLyXBM0Iqxsy6f6Zo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gdxl79v-oqlAyBZNQgpL5-odMchZ-MQyAviYffDRYpg&oe=6A11CD91"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbqeNgn-OKUQ7kNvwGZGR2L&_nc_oc=Adq8w2MDPFrRDLIDtBep5ZVFRvmQThFhTgOSNFPC-11MjGp50Lz4sSiqH273OizOqWk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73DDEyt88-bLeMEJFbUEyKSBwUAq116Xcw5Z3_SI_QfA&oe=6A11C9B1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUTz_igkqnMQ7kNvwHl_WNS&_nc_oc=AdowVqBn6_DZ0ocLb9fttYBO6K9MLByrCtNmJly2OwJaC8shvV-bwXgovuGfFMx70-8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yrAH_7C3XAm5_Nomht73l_pymGlUUA8e6SfQZzpVRQg&oe=6A11CE0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKjX84h5KoUQ7kNvwG5Bji7&_nc_oc=AdoFAQqz9quvsA8yMs32rOdZDmFnRDcoRcw93BuvkTye-x4A21D1IL5CWvMCi_Ir79M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uqVjF9Utm2VON7jho22y0AIVukjNplfoUawgF4dHeDg&oe=6A11AF24"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oc
0.png", "id": "1037598403772651", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974530_1037598407105984_2894653620458275853_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdpioiEuuSIQ7kNvwFoAj9s&_nc_oc=AdrwjduiVJdskFuf2Jp0znE03uJT7n7cbki2_3tl3lpxNHZvDvlxt9X-vT10zfJIemI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2YdNxUrFrZLdZ3HCqwRqmJeYjiVXfb19qhehuWktGwQ&oe=6B09C3B3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXEgLDLQ45MQ7kNvwEmnnxR&_nc_oc=AdqV6d_tdgNQh3dSAqt8WVRfb-ptXogavYUQ7i_G6kIztrsgrjnB2ydPm7jv_qCDi0s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4Hi8X3uMk-mz6f4apFmF31xI2GX4Km2kijqXNXrVOGQ&oe=6B09A791"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHbLJ5s_ZFgQ7kNvwFf93cH&_nc_oc=Adq7St7KcC1b_SHFFWqASFv16tZ5m32yuRapsBLOwDoZleTlYoad-axdIJNkN7YwGXs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoqxVd-OCTVSFaGKUhMNt39lVv0_QAPlaTp-9muPPN2w&oe=6B09A3B1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8WRZDvBmG4Q7kNvwEI7gob&_nc_oc=AdoxFATEH68FmjhF6wJi7Lbfq6vBk81ajAGlHBXdQAnibzMN6DiTa5QL1teHHYQIWuA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJQv_iimSGFOWGxUPGKg6182b3g2UDuDWwfh0wpmes0g&oe=6B09A80D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeePUTXqAGoQ7kNvwGJn5F0&_nc_oc=Adrzl7BaiK5N_2wH_YqA-FmSRQJSspIkHL46H_S9CB6ylMFBzgiyGKFTJjGh3sBSc3w&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU2N4IQ_IZ2Dtg9IWiFIFT6-QyzCgA6qNS0SIb2TAbJw&oe=6B09C164"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
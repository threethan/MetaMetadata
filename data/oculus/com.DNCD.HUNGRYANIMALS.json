by9j&_nc_oc=Adr2tqwn3WYipntDbcfyIkEJWRRI0BDQsCV6XzTQJR2ylLL2AmW7opzGz__jBu1Hjxk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcQD68ZqR4VI1TbYx5LgdFmfPrmBLTiLvZ9mp2LZP_Ow&oe=6A8C14B3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vy3RTUmQ98EQ7kNvwG4u7tV&_nc_oc=Adr8QyhEKdsLdu6B6wPFVcGFu5R0P6pO7k0pEFR6LS6Cb2LxnUeIemDn7e76uBzErbw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGINLECVcBTSpL9HzloE0kEaw6Gl2MoQKCRa5ZRSW46AA&oe=6A8C30D1"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5vur05LmSMQ7kNvwGfXEhf&_nc_oc=Ado6m4XV0Yt2do9ICHBQH7c5D9GBpJsTf45a7fQSl0wuDDFfwf2OTpiiXvhWC_bvtVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA3rbizVzclvGyTNJLTD8QhLdqGkbyM-V-5icBgmGuLA&oe=6A8C2CF1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3ltBOc3Jg4Q7kNvwFQjjd8&_nc_oc=AdpHiiP6qkCLIk1D3QH87AYOufptIrKzRhVCN6rEuaZ1zhJFVz83n7h4Xw59W8e1Cks&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwRZrmODKcx7Dp1QzMEL7BBtLE-_2IlzDjIQ1PwdDSjg&oe=6A8C314D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mw2rCUeuxCYQ7kNvwEuYdiS&_nc_oc=AdpZlP3QWbsCC3M5V_KtzY_Ew0AdJPfHTLHmoak5pZVGaQgguKmqIzQqe3DUd8VIN9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6HhMN9zsu7qmWzMd5Ey_t3wjiNikzaAiloOiYwFW8AQ&oe=6A8C1264"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscd
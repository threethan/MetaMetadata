fUkc&_nc_oc=Adpl6JO4R-n4fotaH-chftBe0yxp6PNEX6fVxG71dV57oP0iapXLnpmfMbs6b9HcTac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDliU81yzaThT-LcbWUGJXD0nU8hHMvmOFzqDc6vkdO7w&oe=6A5E2873"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVsapRWqMWQQ7kNvwEAfXWn&_nc_oc=Adqhn0aJZyjtw9O40L3-TFgR9FBwibCvMd-5e6s14Dt0vdjE_B0OOxR5fhivbXj3JVs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDipAEVvbPL64bfTD5UGun3Eon84AoSYUsgjqzuRvMJZQ&oe=6A5E0C51"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zik6Mb3xJi8Q7kNvwFcEUiz&_nc_oc=AdpZ8lAfFVfPqddk7kHvbNcNY81sN6J-MctVh3fM0OqP1ZZBxHFXZ4xzvNxPFPuZboU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjkqEfuTrWrZvhWPCoDr8B9A_Y6DP6D7nbNP3RsKY_oQ&oe=6A5E0871"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTkTD1OxdH4Q7kNvwHHp1WP&_nc_oc=AdpTFv__Pp8pZyDJkQ7u-OaPHUx10-tUP9ssZXjZmmAkFwjLHakzCAzhtFXMe688rJ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUBQKSvy40HQshD5ssQsz2ll6an-kStDgwYugPx3iauA&oe=6A5E0CCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpitE3q_ygUQ7kNvwHOgUb9&_nc_oc=AdpcAJDVMG7biTf8Tf3EqQUeohzZ3QTbErHdAknXvwEyZu4sZtrtDwYqMcmdzfDARHY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtEKUHnLSxK8gXH9doyb_n4I6cVU1BiWhrrFrRzfdDzg&oe=6A5E2624"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscd
NzEB&_nc_oc=Adq3VLsrizpWmn4nZ-3wFvUdYhD-wlogAi1Nt0aKdMpRvHCsERwp6QYsqixZD1a7qPA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ffyWQ7tutLE7nE__ynEN_mCLlhMF6Vx78SKDYqSfnDQ&oe=69F601F3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMkSqp2rgk0Q7kNvwEZKYTV&_nc_oc=Adophzsy-szD_xMUJm_tDYt9aj7TyOR9wZr4D_dD-QjPowanfTxs8zh6Vbkd6ziHieU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bZzPRWfPuY6DEMKiEGvrJNlvIywU7EkoeKAeAUyDHpQ&oe=69F5E5D1"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gj7ISqOZJ_QQ7kNvwEpYBgZ&_nc_oc=Adr6ks-hrUPWjZWjBUUXRNsGZdAf4EQ72_8HGgHHAJyXBXwEVTY-3x8Vx0jOlsjWIP8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2U4vhQ8oQ1GOzbVCr_lWKKwf7QID9jg2-KZ6p8y6UFIg&oe=69F61A31"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpMrF0xKKtwQ7kNvwFsRR3D&_nc_oc=AdpJzlHbbdSV9jS78e7ow6MquIw70aZT1OOUMSNfWvfYa2Weo77Bw0RGyPC1L0c6S2c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-HS9OLQfvbaJf9cIgGbwhHUYvABc1q_aa9H2rkSz9kw&oe=69F5E64D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWMbhQSVCsIQ7kNvwFtxKXa&_nc_oc=AdqRhqtt6YPvaoRYGd8AWNLEOWQ-MotoLjqHzNX9Zwy1WmmR0mmyIexZ5QswjFaGT6s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OzkXRj0jxykKaJPAwG5JTjDGGVeQGUs1Xcu7CQWLbog&oe=69F5FFA4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscd
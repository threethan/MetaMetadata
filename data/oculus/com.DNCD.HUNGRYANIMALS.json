KJ9m&_nc_oc=AdqVo2l7G6u4N_ZjxXvljI-jcQ_TaGwNnoLJVvrjhqETlmgk-4YF5Lc_hsTWvsFeigk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGL60k_7OfHOEJ9duW5UmvRP_tK1wHTqWrU9FNdWLaQQ&oe=6A915AB3"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=188t-MOVf2wQ7kNvwGNIrlf&_nc_oc=Adrs72jUx2fSaq7Sdy1IBG-vPUmxylpj_Yj-afDh9GR0z8rnUfeDuBf87nuyhSBO9E0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGZcJtZH1NOhda7_fDw8wxNe4AUAZpFwMA_uDUcr77MQ&oe=6A9176D1"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpK6w16opD8Q7kNvwGghJRb&_nc_oc=AdrR8-Q1krAZiYh2Pu5RGb28PT_ueNKZ_yzXhdo2Lx7mK8Z1D1zy7f-FQTVenZFqYfk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx5jKwNtj0tfZjeu5m8GaRLI3R8Msu1UvetzHIMtX2yw&oe=6A9172F1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76aQpJuKXP4Q7kNvwEsKqIl&_nc_oc=AdoGYRll724jxdd6drfSiRbn0YAq0F-3evr8-CB1UVKcwkI5yOKxzqvYMKSLFgJ5B6k&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_5L19wh9IZ6jsn_X7p0Sqmb3ZOM6Dv6Gpx9Lhxr03aw&oe=6A91774D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rai2mcaCDa8Q7kNvwEfXTI3&_nc_oc=AdrXl20mAzUHwKNHxPGOZ-lt2tSM0nUNrbtoOlL-Zrrog6zdxd8YSELCne3MVsZ5DCw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvhsX_5WmatfsJX5HtQ8daBybmgP08e7zEk6I9ye62sw&oe=6A9190A4"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscd
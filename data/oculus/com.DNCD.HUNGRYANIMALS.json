6y_r&_nc_oc=AdpJ6k5LTeyOogovgyzpBeZB15mgs2BgjDT3cmz4LkDEeM2QYLBlQ92wrmTyt6BBTKo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hyFf5FiFyKxnxKPflb8fec0sUMMsy48eueGuCkTF5nw&oe=6A412773"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTQeC-K3IfMQ7kNvwECqLMI&_nc_oc=Adq5mH5UwylIJF0Odck9Gxn_NDPGDmXqj_IDII1CnfzPsc7r24408BK-W5cCEmhAUSw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V_oqCLArsClfwAvPu5sYBcJbX2BxVH09PHKVb1V8dfQ&oe=6A414391"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtKgh3aeBqIQ7kNvwFlCgzO&_nc_oc=AdqCc9wgu6Cn9L70CyktNPTO7bkKRfwnv4CtL9RpujIZT9TuGSvBZZeK721IjOrvuno&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b5HF3uV_7XPos156tqh0yhInm511M3W2hy5dZo7Luyw&oe=6A413FB1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLEknKzmxVgQ7kNvwFTMJnh&_nc_oc=AdqKCFVkSO8ZEHFW7_G58bn57zXnD845aCX1W5MVAlxdaGnv6PiSTiiEqYX7gkNXYpo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fEnbCAZejQsOeNUYEc4JI6MVdAw_Zl4V6F0nu24Z4gg&oe=6A41440D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bG_J_WzjvmAQ7kNvwE0jZlj&_nc_oc=AdpMBysTeq54hmT5iSXRpNdNtGCsZgELo8aFD9f0MIqPs4SjTTA3K7-wM5WPEJ6KMcY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93d8v0A_X6NHERvdi_TFZ2_ATI9Ky6Kf_3zkFHiWuqkw&oe=6A412524"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscd
jtW6&_nc_oc=Adp-EZ2F6QTvqShDZTPB-S6qZUlOvDrDsYaxd24ouK60UxuKThfJWIP79Jb89j2Ijrg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pg0ByiZcoRJzwFVTgoANrdMQ_OgsGGPgMjRhbQ0u_YA&oe=6A16F773"}, {"file_name": "KakaoTalk_20220309_222724197.png", "id": "930692430982733", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974897_930692434316066_3547052793781096432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hK8qgb1OV3MQ7kNvwHu_6NS&_nc_oc=AdpshgPc3X0GNfT7x9vVdAyIStQCvte8xq_5vBb0pQgRu1j_ewoXjQLen1joKPgmt5s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7czI43qG8rP2WR14bGY2yrDJd2nGBWD6uF2CUgKjnXng&oe=6A171391"}, {"file_name": "image_006_0000.png", "id": "658219365449240", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974583_658219368782573_3559489188620225389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxUfLodhAxMQ7kNvwH9prsD&_nc_oc=AdofK4F30trQIsCYt6Z_AIxZv9faODi11Q9mi1zc7Qvi9HAPfXao0SGEfZJ19zPPfqo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NZT9C3gSZNiutDXtUcZmAb601_3zURgjvx9AlVUJ0IA&oe=6A170FB1"}, {"file_name": "image_018_0000.png", "id": "498717328333196", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982666_498717331666529_1285084098225979527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0MtaiNX2cAQ7kNvwEXE5tk&_nc_oc=AdpirecS0-kZVRFx9ikVgbx5IO_SY3up1FBrnIjqP4KjRxRo4dIgZ5gVQhYDmuo8yzw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6N0_11IibIfYmgZjW9okCmuZBcY_E-QhvoiGg13Cb9pg&oe=6A17140D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub300\uc9c0 1.png", "id": "757777595187469", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974523_757777598520802_1227036748488949140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFROmo-Vr5oQ7kNvwEftslO&_nc_oc=AdrID0mbLSta6B9eq1yqSdVDHm47l6H8RcF1A-Le1QSnaf-s2ghBWSKn2K-9LQEYKKQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Uun4Zh6k1khHCYr2Z675GjMRHqdfw2I8C6v4aaNIPkQ&oe=6A16F524"}, "display_name": "HUNGRY ANIMALS", "keywords": [], "long_description": "This game gives you the same experience as making donuts in real life. Put donut dough in a fryer, cook it properly, and make delicious donuts with glaze and topping. If you have coffee orders, don't forget to give them coffee, too!\nShall we cook so that animals can eat donuts within the time limit?\n\nCopyright\nhttps://jieunlee.tistory.com/314", "short_description": "Give donuts to hungry animals! \n\n1. When the game starts, the animals come in turn and order donuts and coffee.\n2. Put the doughnut in the fryer and take out the doughnut using a trigger when it is properly cooked.\n3. Use a trigger to hold the glaze container and sprinkle it on the donut.\n4. Put donuts on a topping plate.\n5. If you ordered coffee, press the top of the coffee machine with a trigger to make coffee.\n6. Place donuts and coffee on the counter and ring the bell with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jieunlee.tistory.com/309", "developer_terms_of_service_url": null, "publisher_name": "jinnycorn", "support_website_url": null, "website_url": "https://github.com/Jinnycorn", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507216277568324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscd
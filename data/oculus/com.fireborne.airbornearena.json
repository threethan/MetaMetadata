_7207781005312725636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxA6wNb64cYQ7kNvwGrcnrl&_nc_oc=AdnWewKj5rFBm3FzH4ksXVU_BRDpXyALL798p_YcURMccjc0nAVnUQqIiwm2_Jbe0eI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuG0DptnBjW3nWX9w94BxVTMPG7EyeZbRSWIzTBAUJMKA&oe=699F06A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "390295323510339", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222943_390295326843672_2612760363654697910_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYAvVGF7WVgQ7kNvwGhw5s1&_nc_oc=Adm5gPJccXRtMuKbiDHOfVroR9nPJAh5rPSwp9-0oZaZG8-_fl7Nr0L3HXok5qjFYCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftpzXcqrj5qdRa1rXI2oc5KYlHH3Yr3zQ5jODPdbXX9BA&oe=699ED8DD"}, "display_name": "Airborne Arena", "keywords": [], "long_description": "Airborne Arena is a VR racing-shooter game where the player takes the role of a hoverbike rider called \"The Prodigy\".\nAdvance through Rider City's underbelly's ranks by racing the campaing races or hang out and challenge other riders to multiplayer races and arenas.\n\nUse your body to control your hoverbike and shoot at the other riders using different weapons and special powers to give you an edge during the race.", "short_description": "Airborne Arena is an intense and action-packed VR racing-shooter game where the player embodies a hoverbike rider in a 2058's sci-fi, dystopian setting.\nFollow the single player campaing to unveil Rider City's story or race against other riders in the multiplayer and arena modes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.firebornegames.com/inicio/airbornearenaprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Fireborne Games", "support_website_url": null, "website_url": "https://uruguayvideogames.com/game/airborne-arena/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category":
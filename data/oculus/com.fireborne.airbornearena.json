_7207781005312725636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BAla9zFF6QQ7kNvwEmDWYP&_nc_oc=AdkVTzN_T3sG6DJ20S4ESSi_aui7lqbygQlfJp9y07HjX3hrmmrEYdFAU53D3OT2oqM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu-zVM6Ff0M7yPLCFVDzUsII2CDgDRbE7cro0UFwgLVrg&oe=69986F20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "390295323510339", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222943_390295326843672_2612760363654697910_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbE_p3Hv2ukQ7kNvwG81DdT&_nc_oc=AdmbhYMsSMMbbJMApSA9G-M3k45dKlzjZUlkRju8JltpmarbWDrFC-IYwbXLFrQ1OLk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuPNV5uiXxAqGk9ofiKZRC_o96OsNJminYkUAlaj0h3NQ&oe=6998415D"}, "display_name": "Airborne Arena", "keywords": [], "long_description": "Airborne Arena is a VR racing-shooter game where the player takes the role of a hoverbike rider called \"The Prodigy\".\nAdvance through Rider City's underbelly's ranks by racing the campaing races or hang out and challenge other riders to multiplayer races and arenas.\n\nUse your body to control your hoverbike and shoot at the other riders using different weapons and special powers to give you an edge during the race.", "short_description": "Airborne Arena is an intense and action-packed VR racing-shooter game where the player embodies a hoverbike rider in a 2058's sci-fi, dystopian setting.\nFollow the single player campaing to unveil Rider City's story or race against other riders in the multiplayer and arena modes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.firebornegames.com/inicio/airbornearenaprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Fireborne Games", "support_website_url": null, "website_url": "https://uruguayvideogames.com/game/airborne-arena/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category":
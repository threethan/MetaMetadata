6843672_2612760363654697910_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_U64DcCQsr0Q7kNvwGtaYZ0&_nc_oc=AdqveXeQ2vufuBZe2oLnKY1d8YOd4KDcqzU0A1mFXarp2zmSsUv95oWpvshVFtp4fYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbxvqqpRd0xTjpJO4o3KIZadyr2J6fsu_8PVGzfGzPnw&oe=6AFDC01D"}, "display_name": "Airborne Arena", "keywords": [], "long_description": "Airborne Arena is a VR racing-shooter game where the player takes the role of a hoverbike rider called \"The Prodigy\".\nAdvance through Rider City's underbelly's ranks by racing the campaing races or hang out and challenge other riders to multiplayer races and arenas.\n\nUse your body to control your hoverbike and shoot at the other riders using different weapons and special powers to give you an edge during the race.", "short_description": "Airborne Arena is an intense and action-packed VR racing-shooter game where the player embodies a hoverbike rider in a 2058's sci-fi, dystopian setting.\nFollow the single player campaing to unveil Rider City's story or race against other riders in the multiplayer and arena modes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.firebornegames.com/inicio/airbornearenaprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Fireborne Games", "support_website_url": null, "website_url": "https://www.firebornegames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "RACING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "
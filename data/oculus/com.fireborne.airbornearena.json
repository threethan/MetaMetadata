_7207781005312725636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxA6wNb64cYQ7kNvwFZWGjq&_nc_oc=Admm-zmhhoUL3dHEZV10zncABHBkpVgyiTCdt65Yc7xxu5yhW2bjK8g-ZyuAnOAhCmQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuviI0rqhrNiO6ZTuyFE5_pr0eWYpzOKrMAg5Yl8Mtr0Q&oe=699DB520"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "390295323510339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222943_390295326843672_2612760363654697910_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYAvVGF7WVgQ7kNvwG1ySld&_nc_oc=Adl5ia0ClsWbKor3oYI_n1eEisBslLvvDxwkLEJ6rWeCW9GL7eM7KDz4DGzaS44oPfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuP_kkwFESJcEBN3ntyDXv8Fhdb4z-S0xS0QwN7wxbzMA&oe=699D875D"}, "display_name": "Airborne Arena", "keywords": [], "long_description": "Airborne Arena is a VR racing-shooter game where the player takes the role of a hoverbike rider called \"The Prodigy\".\nAdvance through Rider City's underbelly's ranks by racing the campaing races or hang out and challenge other riders to multiplayer races and arenas.\n\nUse your body to control your hoverbike and shoot at the other riders using different weapons and special powers to give you an edge during the race.", "short_description": "Airborne Arena is an intense and action-packed VR racing-shooter game where the player embodies a hoverbike rider in a 2058's sci-fi, dystopian setting.\nFollow the single player campaing to unveil Rider City's story or race against other riders in the multiplayer and arena modes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.firebornegames.com/inicio/airbornearenaprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Fireborne Games", "support_website_url": null, "website_url": "https://uruguayvideogames.com/game/airborne-arena/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category":
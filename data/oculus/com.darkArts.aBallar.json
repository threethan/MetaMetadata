pEU8KhJrA&oe=6A8D9125"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta Store Trailer Cover Image.png", "id": "1300214654860421", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499308961_1300214658193754_1853983184810536688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=julxF-046VAQ7kNvwGayhad&_nc_oc=AdpxWtD5OaIBzXHdhMap_QMLVbsX3Iv0gucIMJMoTJoJlLNHG-vN78fq50iRog59GIA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm96Q4kq6PyVZY_p1FOarO18KhJcNt1GcMz1RmKwDSVg&oe=6A8D6A48"}, "display_name": "TRIP THE LIGHT", "keywords": ["dance", "music", "salsa", "Rhythm", "partner"], "long_description": "TRIP THE LIGHT is a mixed reality partner dance game. Move hand-in-hand with AI-powered virtual partners. \n\n**Dance the night away, anywhere, anytime**\n\nLead your virtual partner in Salsa routines, complete challenges, score points, and rack up combos. Move through stunning environments or dance in your own home via passthrough. More dance styles coming soon! \n\n{714282657974411}\n\n**Skills you can use**\n\nLearn partner dance skills from virtual instructors based on real-life professionals. \n{1474684393979194}\n\n**Master new moves**\n\nPlay \u2018Mirror Me\u2019 mode and challenge yourself to follow solo dance styles like hip-hop, line-dancing, club moves, and more.\n{1419510242502363}", "short_description": "Dance in AR/VR with a virtual partner! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://darkartssoftware.com/ttl-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dark Arts Software LLC", "support_website_url": "https://www.darkartssoftware.com/", "website_url": "https://www.darkartssoftware.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUI
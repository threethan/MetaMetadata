-embrace.png", "id": "1024535272801320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303488_1024535279467986_4212120968405144186_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYjOUItqSkEQ7kNvwHPHWXJ&_nc_oc=AdpXwjpe6__h_2Y5QV8afg4JSf7wbZu7UL7cqV4AVf8joz7LfKPNlaHDnQY95pf6dkM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_w3bIKGV1YAYxS3HAtWHLJySMJk8RQ-TSRfFx4OD0cA&oe=6AE5F59D"}, {"file_name": "_PDP-_0005_EDIT_Fantastic-Combo-v2-002---2025-06-27-fantastic-evening-2.png", "id": "1068341524757302", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303100_1068341528090635_2046124901406434735_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yv8KF5CuI9kQ7kNvwF0AQsx&_nc_oc=Ado15LqzvygtWRsvBv_DQhw2m0ot3u4ZfSapfMkeYn9vPPIYN8GjHYPBkghtqK6UlgY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDr0AITldova0DYNlf5KXZ8qB044xI9lGlKXI2uzuveA&oe=6AE5F2DE"}, {"file_name": "_PDP-tripthelight_02_01_12_51_23_night.png", "id": "1480611099772677", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305328_1480611103106010_6352588032113488545_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oYNjxxQLYwQ7kNvwGeTxy1&_nc_oc=AdqGBtgqSyXDPJkF3aheP4MN1xtkY-UwJT53NYwBAcKLa8wFnP-nMnX2JGeIKxRLjI4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfqAlBwnJuXG2hM-gDY7dwd50cV_zJ9wgcZayhY_NdOA&oe=6AE5E5A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta Store Trailer Cover Image.png", "id": "1300214654860421", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308961_1300214658193754_1853983184810536688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qG80jho8_QQ7kNvwGU_nDi&_nc_oc=AdoZKY_rh-5DopVz-Wb2Uh7dKpL--khDCeqBeCiZuM_tDkgYQtOS0Mo7FuQUXVAnpeY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpypy9-35xlBDyAEt2L93M02jtPzp62Tr8qGWIBfrdIw&oe=6AE5F708"}, "display_name": "TRIP THE LIGHT", "keywords": ["dance", "music", "salsa", "Rhythm", "partner"], "long_description": "TRIP THE LIGHT is a mixed reality partner dance game. Move hand-in-hand with AI-powered virtual partners. \n\n**Dance the night away, anywhere, anytime**\n\nLead your virtual partner in Salsa routines, complete challenges, score points, and rack up combos. Move through stunning environments or dance in your own home via passthrough. More dance styles coming soon! \n\n{714282657974411}\n\n**Skills you can use**\n\nLearn partner dance skills from virtual instructors based on real-life professionals. \n{1474684393979194}\n\n**Master new moves**\n\nPlay \u2018Mirror Me\u2019 mode and challenge yourself to follow solo dance styles like hip-hop, line-dancing, club moves, and more.\n{1419510242502363}", "short_description": "Dance in AR/VR with a virtual partner! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://darkartssoftware.com/ttl-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dark Arts Software LLC", "support_website_url": "https://www.darkartssoftware.com/", "website_url": "https://www.darkartssoftware.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8025476804223580"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1579350140491408"}, {"status": "PUBLISHED", "id": "883089874610766"}, {"status": "PUBLISHED", "id": "859642860182868"}, {"status"
/491821954_1405962204603139_7377972666397604695_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8JKoceOUm8Q7kNvwG4w1FA&_nc_oc=AdoMj2jxVS_nJlGxAa87zLFPAXGvC5_mZocf0rrg9j1W3fFxjvF0xIlBTzb47Lfu92g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkvDS1NzzlnYti6qXjFhhT_wX_uEhW3Iad1WCPZFML0Q&oe=6AC915AF"}, {"file_name": "MRC VikingPrincess.png", "id": "2109714349812476", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821725_2109714353145809_4128189869370312735_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nt1dGhYuINsQ7kNvwHAM-37&_nc_oc=Adob8I7HWPfSJq1G85lbaixG3FBXfHrOkX3IdIZgR-4HNJtOJCkl4u-HizheOzVwqCA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrqTaEfr84vRLiEhagYyYthCJQS4gtxNgcDJp0eHdVmw&oe=6AC8F533"}, {"file_name": "VidSnap2026-04-13-06h41m07s663.png", "id": "1882709839074003", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821796_1882709842407336_6625391635382291711_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imXzXV1KDcQQ7kNvwFuHH4f&_nc_oc=AdoFYjYUgsAG7uSpsdwk7J41XIOsKrULbzMyGUH46Ww-W4jSHgfCWVeU8ISQPXb1Bq0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNAC98GiLgKP1zW0dDgSrf3UwQnC9huQFc59SjHX-bmg&oe=6AC90C90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_CoverArt.png", "id": "1512480266713498", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499310896_1512480273380164_8753646035768523332_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EoNUw3JeeAQ7kNvwG3FNlv&_nc_oc=Ado-eZ04xcV1_krcxGfS0K8YRHGYR7ElzkZawta8imI0rPXpucil7RaaOnqhAxBiUiU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc_7TT2gv2bwLlk7tkuGJjeMZrx8GVj4MLxD1y8qGVcQ&oe=6AC8FD04"}, "display_name": "Trip the Light: Let's Dance", "keywords": ["Dance", "Rhythm", "Music", "Game", "PartnerDancing"], "long_description": "# Step into TRIP THE LIGHT: Let\u2019s Dance \nTurn your home into the hottest dance floor in the world. This award-winning mixed reality game blends music, movement, fitness, and pure fun into one unforgettable experience! Trip The Light makes you part of the performance, every session gets you moving, improving, and smiling. Loaded with depth and surprises, the more you play the more you'll discover.\n# \ud83d\udd7a\ud83d\udc83 Partner Dancing\nTake the hand of vibrant dance partners **Vironica** and **Za**! Show off your real dance moves and create your own freestyle combos!\n{25991475793794760}\n# \ud83d\udd25\ud83d\udc63 Rhythm Challenge\nCan you keep up with the latest hip hop, k-pop, funk, pop and other dance routines? Challenge yourself and your friends for the highest score and longest streak in Rhythm Challenge Mode. \n{25220900847578961} {823828200116847}\n\n# \ud83c\udf93 Salsa 101\nLearn the basics and master salsa skills you use on the real dance floor! Take your new moves over to **Partner Dance Mode** and light up the floor!\n{1443883220803579}\n\nFeel the beat. Move your body. Own the floor. Let's Dance!", "short_description": "Turn your home into the hottest dance floor. Learn real moves, tear it up with a virtual partner, or crush the hottest choreos in Rhythm Challenge! \ud83d\udd7a\ud83d\udd25\ud83d\udc83 \n\nA rhythm game, fitness app, and dance lesson all-in-one and 100% fun! No experience needed! Whether you want to get active, build confidence, or dance your heart out, this is the game for you!\n\nYou are the performance, every session gets you moving and smiling. Loaded with surprises, the more you play the more magic you'll discover!"}]}, "developer_name": "Dark Arts Software", "developer_privacy_policy_url": "https://tripthelightgame.com/privacy_policy/", "developer_terms_of_service_url": null, "publisher_name": "Dark Arts Software", "support_website_url": "https://www.darkartssoftware.com/", "website_url": "https://www.tripthelightgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
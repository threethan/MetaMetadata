/491821954_1405962204603139_7377972666397604695_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jy6qWvfms3UQ7kNvwGAycih&_nc_oc=Ado2lyvgmMYwA7WHY0u3jimYXk2V2IleRhqyqYJ3nQvn4He8x-oUoisRRrdaJwd157Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3rgCA6ZuowYwESMRZ2CjmHe1JSonotj4421gK8a_h4A&oe=6AA7E7EF"}, {"file_name": "MRC VikingPrincess.png", "id": "2109714349812476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821725_2109714353145809_4128189869370312735_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQXli91ScykQ7kNvwEIvz_l&_nc_oc=AdqctcEvPYloSL-fazttLSCzI23OVhdDEWgnUl-Uv5ZF2NmOujBw9BnO4tx507-iWPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxFA0mHos3wo6pyu-eXu-HrzDP0cabWES9VeW_cEJPwQ&oe=6AA7FFB3"}, {"file_name": "VidSnap2026-04-13-06h41m07s663.png", "id": "1882709839074003", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1882709842407336_6625391635382291711_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O9KmT_njZsQ7kNvwHAOG7G&_nc_oc=Adr0HsQOLTwBTmQC52LTve-WG9MPDndn6Cv6DOjMRa4z6AO2f8XxOMeZ0nY5qRY1mik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPyZfYzit8PUEaccA1qsVxV2F9ykXWoJSvjvbzxjJLBg&oe=6AA81710"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_CoverArt.png", "id": "1512480266713498", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310896_1512480273380164_8753646035768523332_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8RDFzp9JDEQ7kNvwFIemxE&_nc_oc=AdrDLLJKJ6Rev-R524OqtYaORxqVgwHUc4nYvpodWUNMLQfcP5oFHs8Ovu-Ldz_mGnI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy8M7SpZQEfSd0bQO1qcOyFPbGE1MaPPbT643lh0lP6A&oe=6AA80784"}, "display_name": "Trip the Light: Let's Dance", "keywords": ["Dance", "Rhythm", "Music", "Game", "PartnerDancing"], "long_description": "# Step into TRIP THE LIGHT: Let\u2019s Dance \nTurn your home into the hottest dance floor in the world. This award-winning mixed reality game blends music, movement, fitness, and pure fun into one unforgettable experience! Trip The Light makes you part of the performance, every session gets you moving, improving, and smiling. Loaded with depth and surprises, the more you play the more you'll discover.\n# \ud83d\udd7a\ud83d\udc83 Partner Dancing\nTake the hand of vibrant dance partners **Vironica** and **Za**! Show off your real dance moves and create your own freestyle combos!\n{25991475793794760}\n# \ud83d\udd25\ud83d\udc63 Rhythm Challenge\nCan you keep up with the latest hip hop, k-pop, funk, pop and other dance routines? Challenge yourself and your friends for the highest score and longest streak in Rhythm Challenge Mode. \n{25220900847578961} {823828200116847}\n\n# \ud83c\udf93 Salsa 101\nLearn the basics and master salsa skills you use on the real dance floor! Take your new moves over to **Partner Dance Mode** and light up the floor!\n{1443883220803579}\n\nFeel the beat. Move your body. Own the floor. Let's Dance!", "short_description": "Turn your home into the hottest dance floor. Learn real moves, tear it up with a virtual partner, or crush the hottest choreos in Rhythm Challenge! \ud83d\udd7a\ud83d\udd25\ud83d\udc83 \n\nA rhythm game, fitness app, and dance lesson all-in-one and 100% fun! No experience needed! Whether you want to get active, build confidence, or dance your heart out, this is the game for you!\n\nYou are the performance, every session gets you moving and smiling. Loaded with surprises, the more you play the more magic you'll discover!"}]}, "developer_name": "Dark Arts Software", "developer_privacy_policy_url": "https://tripthelightgame.com/privacy_policy/", "developer_terms_of_service_url": null, "publisher_name": "Dark Arts Software", "support_website_url": "https://www.darkartssoftware.com/", "website_url": "https://www.tripthelightgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
/491821954_1405962204603139_7377972666397604695_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BmdOORnvd4Q7kNvwHnie-e&_nc_oc=AdqMyARQu3N_PvM9Du30RQOqjZT58y_pWNHafanhJmJMASCZbGR2HkLBsv8tOf5vO4E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9rwX6A5uKG48GYWaP_DzSuGjMWIAEjPSV3B2SF595tA&oe=6A81AC6F"}, {"file_name": "MRC VikingPrincess.png", "id": "2109714349812476", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821725_2109714353145809_4128189869370312735_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiWCsw4nMkwQ7kNvwHWzkQO&_nc_oc=Adqf7XnfIlQD11b2o_F1kaxGXj1H9r7JYyB2TUMoyMsc0IDh2ZJ2a7mPviBWr-k3DVg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGteGW6ZaBTJSSSDc0Fn3fEBtk2sfIuuSnNE_8ytl1qjQ&oe=6A81C433"}, {"file_name": "VidSnap2026-04-13-06h41m07s663.png", "id": "1882709839074003", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821796_1882709842407336_6625391635382291711_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SyXcNr5Xf4Q7kNvwFk2swk&_nc_oc=AdrSYG5HP2tZ-3xnkB23iyIpLlMzn7Eiu9YJ_itVhVAFzO8mIrXFK24BTSWG8qZNnq4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqQK8sFuRfIzQM6xv_pYTdvbTGO-9bqWpYMLTCjEhrnw&oe=6A81A350"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_CoverArt.png", "id": "1512480266713498", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499310896_1512480273380164_8753646035768523332_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmQfBb0tkD0Q7kNvwFJstgs&_nc_oc=AdqDAe0o5VxYb-1YEvCwCaAuGraN8potLrjmQASPywj-Knyxyswtrb6EuClCybBQ5HA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoEvEWOw2LPr7hK0qY8LtxzL9PNVzaO17GTut1KFbJ8g&oe=6A8193C4"}, "display_name": "Trip the Light: Let's Dance", "keywords": ["Dance", "Rhythm", "Music", "Game", "PartnerDancing"], "long_description": "# Step into TRIP THE LIGHT: Let\u2019s Dance \nTurn your home into the hottest dance floor in the world. This award-winning mixed reality game blends music, movement, fitness, and pure fun into one unforgettable experience! Trip The Light makes you part of the performance, every session gets you moving, improving, and smiling. Loaded with depth and surprises, the more you play the more you'll discover.\n# \ud83d\udd7a\ud83d\udc83 Partner Dancing\nTake the hand of vibrant dance partners **Vironica** and **Za**! Show off your real dance moves and create your own freestyle combos!\n{25991475793794760}\n# \ud83d\udd25\ud83d\udc63 Rhythm Challenge\nCan you keep up with the latest hip hop, k-pop, funk, pop and other dance routines? Challenge yourself and your friends for the highest score and longest streak in Rhythm Challenge Mode. \n{25220900847578961} {823828200116847}\n\n# \ud83c\udf93 Salsa 101\nLearn the basics and master salsa skills you use on the real dance floor! Take your new moves over to **Partner Dance Mode** and light up the floor!\n{1443883220803579}\n\nFeel the beat. Move your body. Own the floor. Let's Dance!", "short_description": "Turn your home into the hottest dance floor. Learn real moves, tear it up with a virtual partner, or crush the hottest choreos in Rhythm Challenge! \ud83d\udd7a\ud83d\udd25\ud83d\udc83 \n\nA rhythm game, fitness app, and dance lesson all-in-one and 100% fun! No experience needed! Whether you want to get active, build confidence, or dance your heart out, this is the game for you!\n\nYou are the performance, every session gets you moving and smiling. Loaded with surprises, the more you play the more magic you'll discover!"}]}, "developer_name": "Dark Arts Software", "developer_privacy_policy_url": "https://darkartssoftware.com/ttl-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dark Arts Software", "support_website_url": "https://www.darkartssoftware.com/", "website_url": "https://www.tripthelightgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534",
g?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqE6b_1s5YQQ7kNvwH3D1U5&_nc_oc=AdnMmDprcIVQEDrdqWuIbARauB6ZidMAUEo627X2_nEszuKaXplY3_4YaGM6wSlBTRE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_jQASy3JYnDUVL8_Kxtlu4TX5gmTejDNJUTTwI0Nbnw&oe=69B68F9F"}, {"file_name": "7.png", "id": "872651422238408", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618440_872651425571741_3312462819371935088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iXVsHxe0pMQ7kNvwGS7H0u&_nc_oc=AdkkieD3EKZOzkjg-L2-TLsKPRUv8saE9HMmeNSIpDF0zLUAYkA75FMcrhvHx4h2-mQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfINZ3qOEAZBy5H1j11jfxMMRvBjZQ7Pgij9KOYY_6LQ&oe=69B69CB4"}, {"file_name": "2.png", "id": "1932413717649133", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296278_1932413720982466_8303083921635932164_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfapyN-9-tQQ7kNvwF5cZHg&_nc_oc=AdmubRgxfeOpfGFwcS62GKoUBnzkP0RF6LoEBNCyXTuMsWX5fQC0BUmb4-8X7XvkIu4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8ByYTRCAoARSTA7noeMNzFdd6PVnbI1yQhMFTPfWNng&oe=69B68D16"}, {"file_name": "8.png", "id": "1405962201269806", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821954_1405962204603139_7377972666397604695_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otRGsr-XczAQ7kNvwEdzFNe&_nc_oc=Adm6Lejk4O2XxBOdDYPMh0q2-C18zir6HXnTijhJS2B5wj8XgDlFjDFrEGw_AUjdpwk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZ6-4RlnPQ7ZN_6Bt_iMNDD-1AhIZAU9d7dRs_7Wy1kA&oe=69B6A56F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.16x9.png", "id": "1306155384684359", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618093_1306155388017692_1719654057201523313_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rG5Cl63HKy4Q7kNvwF2pRKK&_nc_oc=AdkaVm4b6-8nsPgofGwWDunP7TMBB2pBvctcMfhDlc4vQiKodsEaJlA5is5JeV_VkOA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvdiPCA86DkupYuB5TVzOCz_1PsyBlypkhfwv7s4SlYg&oe=69B694D6"}, "display_name": "Trip the Light: Let's Dance", "keywords": ["Dance", "Rhythm", "Music", "Game", "PartnerDancing"], "long_description": "# Step into Trip the Light and onto a dynamic dance floor charged with music, movement, and magic. Take the hand of your partner Za or Vironica, and burn up the floor!\n\nLearn the steps, challenge your skills in hip hop and pop routines, or take the lead and move hand in hand with a partner on the dance floor. Feel the music and Move Your Body!\n{1606137550430074}\n\n# Partner Dance \ud83d\udc83\ud83d\udd7a\nStep, slide, spin and learn with a partner who follows your lead! You're in control, try out flashy moves or take it easy and practice at your own pace. Build up combos to pull off special moves while your partner encourages you to show off!\n{25991475793794760}\n\n# Rhythm Challenge - Master new moves \ud83d\udd7a\nPlay Rhythm Challenge and master hip hop, pop and funky routines that really get your heart going! Find your flow to a high score!\n{25220900847578961}{823828200116847}\n\n# Salsa 101 - Skills you can use on the dance floor\nJust starting? Take your time with Salsa 101 (with more dance styles to come.) Your partner will walk you through the basics: learn the rhythm, feel the beat, and visualize the basic steps. Easy-to-read visuals show you where to put your feet. Go at your own pace and learn without judgment.\n{1375304867610748}\n\n# Join us as we build\nWhile we\u2019re in Early Access, you become our partner as we expand the experience from the (dance) floor up. Early purchasers get access to the First Dance Edition of Trip the Light, which includes everything you already see, plus a free update to every new feature, enhancement, and style that we can pack into the app between now and full launch!\n\n", "short_description": "It's the big February Update and Love is in the air!\n\nMeet Za, your brand new dance partner and first male character in the game. He's ready to burn up the floor with you!\n\nPlay brand new hip hop, pop and other funky routines in Rhythm Challenge and new Brazilian Samba music in Partner Mode!\n\nChallenge you skills, and dance hand-in-hand with amazing AI dancers, and learn the skills needed to dance in real life!\n\nNew music, new routines, new outfits, new FX, new dialog and more! \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://darkartssoftware.com/ttl-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dark Arts Software LLC", "support_website_url": "https://www.darkartssoftware.com/", "website_url": "https://www.darkartssoftware.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25326165417061450"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618444_3925778307717382_4364303680772362738_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4LHDLVozFEQ7kNvwG7-H61&_nc_oc=AdnWIUIOCK65X5WfJaIG77xpj9bKt7vk2rOjOMtHRbo_5Rt2pJGQ55Fk2AeTJLE2Nio&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzswfAPaDE1Xb11BDn_m8FhR4mPgZzQw3MixYm2bybHgQ&oe=69B6939D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Trip the Light: Let's Dance", "platform": "ANDROID_6DOF", "co
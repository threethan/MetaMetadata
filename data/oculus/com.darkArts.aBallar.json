090635_2046124901406434735_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLc9g7FUmKQQ7kNvwFoStOS&_nc_oc=Adoq9gPpdSjDJl0VKK6Htm1m9XZzwU7DUYsY-h9HA3GY4_tEiBUbEbxjgXQ8HPVnGWk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLE8zyrwJeMcikR9VpzPyk3EuRvbPkxRmFf0s1W2m90w&oe=6AF9B95E"}, {"file_name": "_PDP-tripthelight_02_01_12_51_23_night.png", "id": "1480611099772677", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499305328_1480611103106010_6352588032113488545_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEAtdsagwnQQ7kNvwFwnO3F&_nc_oc=Ador4nWaNVH5WwYBxI1Y8EldQ2JddTgeY_OwzFTgd0UDT6xevNr8wJMolMopwxsEtCA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtV-pyhnOHZU1Is4g631xCJ6CvyFbyijufmPnyjmE0MQ&oe=6AF9E465"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta Store Trailer Cover Image.png", "id": "1300214654860421", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308961_1300214658193754_1853983184810536688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnUoAR4e3_gQ7kNvwG2jRoJ&_nc_oc=AdqHivU-xKxEL8xekqu3q3yr9zXlxgJq-hUwhAGOS2r0RbxYeRnHMm-1GxUYna49xwI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbJLAFeltT7nYH2PHYkW9ghQeJD5NsQqLwAzYnAwiN3g&oe=6AF9BD88"}, "display_name": "TRIP THE LIGHT", "keywords": ["dance", "music", "salsa", "Rhythm", "partner"], "long_description": "TRIP THE LIGHT is a mixed reality partner dance game. Move hand-in-hand with AI-powered virtual partners. \n\n**Dance the night away, anywhere, anytime**\n\nLead your virtual partner in Salsa routines, complete challenges, score points, and rack up combos. Move through stunning environments or dance in your own home via passthrough. More dance styles coming soon! \n\n{714282657974411}\n\n**Skills you can use**\n\nLearn partner dance skills from virtual instructors based on real-life professionals. \n{1474684393979194}\n\n**Master new moves**\n\nPlay \u2018Mirror Me\u2019 mode and challenge yourself to follow solo dance styles like hip-hop, line-dancing, club moves, and more.\n{1419510242502363}", "short_description": "Dance in AR/VR with a virtual partner! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://darkartssoftware.com/ttl-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dark Arts Software LLC", "support_website_url": "https://www.darkartssoftware.com/", "website_url": "https://www.darkartssoftware.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8025476804223580"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1579350140491408"}, {"status": "PUBLISHED", "id": "883089874610766"}, {"status": "PUBLISHED", "id": "859642860182868"}, {"status": "PUBLISHED", "id": "1200246748933049"}, {"status": "PUBLISHED", "id": "1537105834202660"}, {"status": "PUBLISHED", "id": "1262465245900708"}]}, "baseline_offer": {"id": "1579350140491408"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787337360, "status": "PUBLISHED", "id": "1579350140491408"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25522079024136754", "version": "0.97"}, "id": "1046763573605633", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "
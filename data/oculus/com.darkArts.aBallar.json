71-25/491821950_714080401472136_9111481687640657841_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5w7i0cYk5kQ7kNvwFrIsLl&_nc_oc=AdlhkgP4p4tMQNMbiHLRucIhP0VMNVh5PTwDlIzqWuHaFPn24o2d5JxnuccHaHJy_r4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfueZBj-QTND9s2HUAiZebhpB1xB5diuRhvRaYfAYnKwkw&oe=6999B287"}, {"file_name": "_PDP-_0005_EDIT_Fantastic-Combo-v2-002---2025-06-27-fantastic-evening-2.png", "id": "1068341524757302", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303100_1068341528090635_2046124901406434735_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OGXbbkqOv0Q7kNvwG8tMvt&_nc_oc=AdlWdfAvCLl4wkIFu2WZyIJCfXUKlvdeOWBSDgh7CPzgyA4xAxW9mD577zJ5YaUmi2M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftpCsI2Av2UJMVjvLZinZGW-uWmjsTc1FOFaNAeBp2s1A&oe=6999B8DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_CoverArt v01laurel.png", "id": "1972440816953291", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618293_1972440823619957_6209845615445652049_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCrxFfXeUqoQ7kNvwEXUSlu&_nc_oc=AdnjGaSz0tXXbuxk2BvQveZ87-jMxK1DMs1WY740k2vPiZsWb6VMVDhgceP7UB8umno&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvPJYjtIaQJTvxiZm_vq2McWnR9cQkfBaNw5x6X5ugoaw&oe=69998D21"}, "display_name": "Trip the Light: Let's Dance", "keywords": ["Dance", "Rhythm", "Music", "Game", "PartnerDancing"], "long_description": "# **Step into Trip the Light** and onto a dynamic dance floor charged with music, movement, and magic. Take the hand of one of our vibrant dancers and move your body!\n\nLearn the basic steps, challenge your skills in a rhythm game, or take the lead and move hand in hand with a partner on a magical dance floor. Feel the music. Move your body. Dance!\n\n{25991475793794760}\n# **Partner Dance** \ud83d\udc83\nStep, slide, spin onto an ever-shifting dance floor with a partner who will follow your lead. Take some risks, or take it easy and practice at your own pace. Build up combos for flashy effects while your partner encourages you to show off!\n\n{25220900847578961}\n\n# **Rhythm Challenge - Master new moves** \ud83d\udd7a\nPlay the Rhythm Challenge to prove you can master new moves with a tempo that will really get you going. Find your flow to a high score.\n{1375304867610748}\n# **Salsa 101 - Skills you can use on the dance floor**  \ud83e\udea9\nJust starting? Take your time with Salsa 101 (with more dance styles to come.) Your partner will patiently walk you through the basics: learn the rhythm, feel the beat, and visualize the basic steps. Easy-to-read visuals show you where to put your feet. Go at your own pace and learn without judgment.\n# **Join us as we build**\nWhile we\u2019re in Early Access, you become our partner as we expand the experience from the (dance) floor up. Early purchasers get access to the First Dance Edition of Trip the Light, which includes everything you already see, plus a free update to every new feature, enhancement, and style that we can pack into the app between now and full launch!", "short_description": "Step into Trip the Light \u2014 level up your dance moves, challenge your rhythm and skills, and move hand-in-hand with a charming, responsive virtual partner in this award-winning game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://darkartssoftware.com/ttl-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dark Arts Software LLC", "support_website_url": "https://www.darkartssoftware.com/", "website_url": "https://www.darkartssoftware.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
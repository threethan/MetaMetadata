-25/491821796_1882709842407336_6625391635382291711_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl52jMemMlYQ7kNvwGjFbxY&_nc_oc=AdrofqUE1cJNSbtm11tMFl94X8KfhkaptU4G0MB3CtfgeASBHIp1B_y5vSu49hayrQw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0RcK-Er70u02qNTQPFj07LX7i_OiB-D4DhNZUQ1mFHPw&oe=69F1EFD0"}, {"file_name": "8.png", "id": "1405962201269806", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821954_1405962204603139_7377972666397604695_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VDKOVJIA00Q7kNvwH2R_wg&_nc_oc=Adrp3EBybO6yj1n4R0wxIZMHBvUPFDoSirvHU-jj-KquhW--0P3Acl6jUqHCe2Cdcxc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0DGPhi2A49JWKS1pNzUt_kqKQUG239SB_hM0tHzVKpjw&oe=69F1F8EF"}, {"file_name": "VidSnap2026-04-13-07h19m42s428.png", "id": "1544622277027496", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819281_1544622280360829_6684291732160745077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLvTSSVeYBUQ7kNvwH6g9Xw&_nc_oc=AdpOde7v0k3FD1_KUu8457bYfMLDcB7Fhrn6IbTAMDqAgdDG31GPqso9A_S0IzXOUX4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0uLjqfrRIe4xRcdran2Y4HQnSie3m3JptFDL-qox0UwQ&oe=69F1E806"}, {"file_name": "_PDP-_0012_EDIT_t_ripthelight_02_01_15_27_07_tracksuit.png", "id": "4025189244446869", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824307_4025189247780202_8865293223675616245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8trleRtWFNgQ7kNvwHw5YrE&_nc_oc=AdpT48MfQwQ_nBuG7orQ7kdfLTY0dG-6ibKcKFAP3hc4G9h8JOOaYc0P0RvwDfGYPJ4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2fsWHNPHjc1Gg-uv_0yzl1PEUqIPRNwZIi8zedxYQuMA&oe=69F1F123"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_CoverArt_Orange.png", "id": "883680964688071", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499301053_883680968021404_7531996023294846777_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8kWOjrDy8MQ7kNvwEqYKGi&_nc_oc=AdpLdlMIwxsc7uowkIdRuQ7DLPvckWzYjXkaAL4ID-G9Ui8rkuvugtBkPo4mrqJp3jg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3LcSv4LMwjzfk-n1dyNh3bOURD3bXbJ7FoxYX6UNySUg&oe=69F20794"}, "display_name": "Trip the Light: Let's Dance", "keywords": ["Dance", "Rhythm", "Music", "Game", "PartnerDancing"], "long_description": "# Step into TRIP THE LIGHT: Let\u2019s Dance and turn your living room into the hottest dance floor in the world. This award-winning mixed reality game blends music, movement, fitness, and pure fun into one unforgettable experience!\n{25991475793794760}\nTake the hand of a vibrant dance partners **Vironica** and **Za** and learn real moves you can use on the real dance floor!  Whether you\u2019re mastering the basics in **Salsa 101**, chasing high scores in **Rhythm Challenge**, or showing off your own freestyle combos in **Partner Dance**, every session gets you moving, improving, and smiling.\n{25220900847578961} \nUnlike traditional rhythm games, TRIP THE LIGHT makes you part of the performance. Dance in stunning fantasy worlds or use passthrough mode to bring the magic right into your own home. Your partner reacts, follows your lead, and helps you level up your confidence on and off the dance floor.\n{823828200116847}\nPerfect for players who want to have fun, get active, learn to dance, or wow friends with something completely different. **No experience needed**\u2014just bring your energy.\n{1443883220803579}\n# Feel the beat. Move your body. Own the floor.", "short_description": "Turn your living room into the hottest dance floor. Learn real moves, tear it up with a virtual partner, or go for the top score in Rhythm Challenge! \n\nPart rhythm game, part fitness, part dance lesson - 100% fun - no experience needed! Whether you want to get active, build confidence, or dance your heart out, this is your chance. Own the floor!\n\nUnlike other rhythm games, TRIP THE LIGHT makes you part of the performance. Your partner reacts, follows your lead and levels up your confidence!"}]}, 
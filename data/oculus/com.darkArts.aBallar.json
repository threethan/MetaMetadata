ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9QnVtqxqm4Q7kNvwHHJe5W&_nc_oc=Adq_Xm444rst7gJNMkfgS_oJDZH0-_H7R-bHxXdzLVmQtmqM3zgy_ROd8ysK7mo27xM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V7OCHQNCF-GrmUaKb5_PSR1ehtE2V68XeeISg1QjokA&oe=69E62A14"}, "display_name": "Trip the Light: Let's Dance", "keywords": ["Dance", "Rhythm", "Music", "Game", "PartnerDancing"], "long_description": "# Step into TRIP THE LIGHT: Let\u2019s Dance and turn your living room into the hottest dance floor in the world. This award-winning mixed reality game blends music, movement, fitness, and pure fun into one unforgettable experience!\n{25991475793794760}\nTake the hand of a vibrant dance partners **Vironica** and **Za** and learn real moves you can use on the real dance floor!  Whether you\u2019re mastering the basics in **Salsa 101**, chasing high scores in **Rhythm Challenge**, or showing off your own freestyle combos in **Partner Dance**, every session gets you moving, improving, and smiling.\n{25220900847578961} \nUnlike traditional rhythm games, TRIP THE LIGHT makes you part of the performance. Dance in stunning fantasy worlds or use passthrough mode to bring the magic right into your own home. Your partner reacts, follows your lead, and helps you level up your confidence on and off the dance floor.\n{823828200116847}\nPerfect for players who want to have fun, get active, learn to dance, or wow friends with something completely different. **No experience needed**\u2014just bring your energy.\n{1443883220803579}\n# Feel the beat. Move your body. Own the floor.", "short_description": "Turn your living room into the hottest dance floor. Learn real moves, tear it up with a virtual partner, or go for the top score in Rhythm Challenge! \n\nPart rhythm game, part fitness, part dance lesson - 100% fun - no experience needed! Whether you want to get active, build confidence, or dance your heart out, this is your chance. Own the floor!\n\nUnlike other rhythm games, TRIP THE LIGHT makes you part of the performance. Your partner reacts, follows your lead and levels up your confidence!"}]}, "developer_name": "Dark Arts Software", "developer_privacy_policy_url": "https://darkartssoftware.com/ttl-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dark Arts Software", "support_website_url": "https://www.darkartssoftware.com/", "website_url": "https://www.tripthelightgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25916501448027841"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499305194_1639165440714765_8616494497718023300_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXLuEkduV7IQ7kNvwEk8Onl&_nc_oc=Adq2AZQr3gScqAdo_ts4GO0rymg9ES5fTpRJ5Z6-nvHlsAtCf08g2G4Q89zzYFXRE1E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08RLVHG_4dw7O30ZhtUfNYAvD6JfU4CzNzHtO0UBLIcQ&oe=69E6252F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Trip the Light: Let's Dance", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "i
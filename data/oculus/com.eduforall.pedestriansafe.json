=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HiqF1ir21AKYhci-nDQtcdgd_1mBk6C1ECb0DqhNfyw&oe=6A3D27DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoN2NbEU4v4Q7kNvwGoqBII&_nc_oc=Adp9-7Tw3sX-LrmGQ1-7hS_xc86rK3VTQuhVaSkorG37kb0xh3PAYlnlPcVUYRURKy8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DNwqe4c463OmxWMeftNnuPGyC0vifbVAC8kOd2sB9Tg&oe=6A3D485E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hkjuPfjHkwQ7kNvwEsImTx&_nc_oc=AdpFeLNanZgzHWVCuJYMBpK8xSvGJfBy0j--A3N_txVCyJhLqj7VZR11GY9kR_uT3zM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uJt848qkwDgroqdYVNryUCi4dGmsIJsVF3xQt_jROXw&oe=6A3D308B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROxTB583DFwQ7kNvwErirdZ&_nc_oc=AdqGj-guVZXTmOxVYvjejqQysviyiKd0_wzI5RYzX-Ys05_G0eXXz5Cj2HUZXFW0K_U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9H6BDgMahqajX231tQaE_XDOFojwSlOfwpHeVuMUy_gQ&oe=6A3D3C26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RugduKfz5rEQ7kNvwF44fJy&_nc_oc=AdqPdBV-zgOD_Tt2l8Ity49HVwCqCklpBuJICXxfk70gs60BrqFmgkhfXSV5yLhV_cY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LRiGtwR7PBQlnfLjyMTqSnOOk3PJ_5Z5883ET-jp67g&oe=6A3D40A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHML2uXPOpQQ7kNvwE4U9Zw&_nc_oc=AdqLe-GGyUHOo6geu8n6BJU4jka1aNP0tD7SYsKEWp7XUOkvEYPksFNPw5XvActNnyY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GXIyQ2i6edMyv6jj9hNHZGkryjqqkvODKF-F1edJxZA&oe=6A3D2D9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ny5yQ0z3ASEQ7kNvwEXYrVf&_nc_oc=AdqRWkjC8pRjl4X-5uzf4bUT7FPq6fZ24cJO_UWqs7BHGBpXIK1XM5IFHVfdjkFy6Eg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tx8bKZOtcjWxNYwHoK2xtWJMvZByakLU_dFB
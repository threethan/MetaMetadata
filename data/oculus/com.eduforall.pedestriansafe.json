=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H-eTTjTQbbv7o6X56Xchvfe8UISbLYZh2swLt2npcEg&oe=69FDDFDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TVUlzfcgDoQ7kNvwHRhgLa&_nc_oc=Ado176rWU7aY50I9MeMYoWIGOrVylTKbbAmZFVJe1an7T6cXK7klWp_SIE2bhXz3MJA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63kOJiVFW3-ZGwp-c1dc41aKpydLvI2WgQJ7nIS5P5eA&oe=69FE005E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG1VsUuvsc0Q7kNvwHMIK7V&_nc_oc=AdpGwhbLv6cDbL8xU42r0r_lyI9X_OAPxErvU3M63hKWsmdEeKOn8W2j8nfbYWW4KAU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BL44au8phtdgMyU0poDv-1KBukRBN2XQh5nq2gZpTXw&oe=69FDE88B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxJKFatY4cEQ7kNvwGINvk-&_nc_oc=AdoasZR0RF-d9VezkTwpLezSvTyfRxa-VHuk6b3U65BzMPeZrlyv3KWuAYH70QVaDHo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rAIY9tSUmHnvUIfKI8FKhx69yS-dTOLW5OTyIMjguLw&oe=69FDF426"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IS34QyRfRTsQ7kNvwFjuFPx&_nc_oc=AdqHu0bn92w5BaXmU2G76oBmXPfFmmTIClqIInTpL3qOKI7DU2KwxrSubaGJavL78SU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DNz6Qzjh7DGDyO-Yjdg_Gs74zE08cY1OP3NtPSiVIeQ&oe=69FDF8A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uFikz0lpSgQ7kNvwGbcDc9&_nc_oc=Adpsmhx7yBTcWifxgHyQtq5jkQp7uaPMnOvqkTxpdVwE1lo5H3EEtPv5HbnHiBCn_0s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L3RZfURd1BeC9c4VQ1Au0PCM903ywkfSy64GUzCXXAw&oe=69FDE59E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2jqcWMCIqEQ7kNvwHpqnfe&_nc_oc=AdqGpHf-B5_oVPjHpfhVs4k1zBxpdC8NoZBSz-ZkEo6-Dpn_D34phNTgiAgtoWaFS7c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZjVsU2P7cTVP60ic6xMsgjnRDCKn-Gfj5ARI
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0a2_kGK9KuhknhQceJmXAe45M2PUDhndwdew5f__uCoA&oe=69F7485D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVkweA1drhAQ7kNvwHlD6zu&_nc_oc=AdqCyMTTCYSCxRtaIY3f9UpPuVNiVI4wdVy_eq4O6qXyeORP706_ODywHQXE8y-XVys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0CGBFXtYv0vO0a28YzQpMilNjhe5XMsJfqPrN4yT9X0g&oe=69F768DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvNHwxNBTqAQ7kNvwHQ8F9a&_nc_oc=AdrSpwp6wciK1ej_TaN5DfbyB9ndbspKQq6HzA7r7S6jJ4rwXeYnZA9U7tzFwbMAAxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3rOfbwKLiirFeuljiFK57IC3N28_YUz9cayaWsuTiadw&oe=69F7510B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EADzIoiLvDEQ7kNvwE6dOHC&_nc_oc=AdoAfI8NMNE4tdQn9ALnL082baUJIt9CCvC_a1p6RQDrdK19VT2iNf4o-BbuuzZhDrY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wu-czvWZJzqWkwFJd0cfN1ZNHoI8pzvhFQ3sFf_qOFQ&oe=69F75CA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NyWcPXnOmwQ7kNvwEZdJ6G&_nc_oc=AdpDs2zakp9hWV2wlEeTl8VXpCnPoqGIG0S44YwX7LpvRJnpcXrUpia6clr8GiL0_aA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0vds0OUPpZdQGqQLzNBJUmO7P8M0BuN5cBLuSSyTg4Zg&oe=69F76124"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEg-ONjjt4gQ7kNvwF0CAqG&_nc_oc=AdpnU512-DAafl3GJidSZ-0aD0n5SaRwirynu3hSyOj8pL_7labmv08AsDGtuu6C9n0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qQO-9s1HpyNKmNuGIXEB_M00Ki2vbDlHT_uXxHjBsuA&oe=69F74E1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HggUYS1aacoQ7kNvwHisYQY&_nc_oc=AdrZ3OZQgrVii0JIz5rSIErj3mmEVTQO9TAhuVF0WfMqXj7F1YitQCRFQDTTmDx76r4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2v7Ut0A5GvTQhQGy4OYfblZF-lMixHAuut_EY
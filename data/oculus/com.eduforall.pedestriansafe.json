=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AKMmJcDsgCizPnVNCU_GEowoZgcg-hOMam5G1S7hC_g&oe=6A2D55DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7gXqGVnZOcQ7kNvwEUmbFY&_nc_oc=AdpK-K_swYfKQfDhQH3NIC83cn-h_dC2NyLLDW3bA3Ujcb_QKxYHwZUpc-iCCENew98&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9C-78r8yiyvzVHPiczYCb6sA8mglUS8ObcnwyRpeRDjw&oe=6A2D765E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8479Cq6bTYwQ7kNvwHofauq&_nc_oc=AdpLoBOVoXSNK7On_2BCAiUl0z-T28SSyfcBO6qsMb_hKwn2oMwf1Ds-70QcKcchClg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NsR3RoRs-U2TIkPX5Au9__Ne7PfYkrBvn_QsxJ4sCBA&oe=6A2D5E8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69orrKqya54Q7kNvwEqfbyY&_nc_oc=AdrrmoxovGByr1zKeyooeBRRjvlqr2n-LqHwdKhJBQbrGX46YcJfJBS-MojrDhLc6sI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wb8Lj6gAk7KMIMGakSxpbCszP_hn6XME54dlI9mSF1w&oe=6A2D6A26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If-HQwbdDa0Q7kNvwH3bTqf&_nc_oc=AdqXZK-SJZ96WBuOj97dgfohLkro8J5MdxJ5J9w6oEuBamhEUEJ1jD9jBgg4o90Qoh8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9An-BSvEHW2QKXgIa2GKEyMub87TCtAdzpB4j-qBMszw&oe=6A2D6EA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Q74XnxHbnkQ7kNvwE56GRh&_nc_oc=AdpDcJX6U8zo1OzAteTPiC5NXs06f65cB4xwfElg3lMKrR3jBslP3vd8YUoRxcwEd3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-14vAf-pm0Q6IyB6CAZZYtjVXIvbgKIQ5woXLujt_4MA&oe=6A2D5B9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfEJovZ6YtMQ7kNvwFkQaPB&_nc_oc=AdoX2VSVlWf2OKkiT0m_mye-uG7ayr08XbuFxMBFN0DRvqcO9kwtboOMa9VHDc-wJH0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RmZ7t2OiLRWRUbwyEB6pWqpM6GQT3tZMoPBO
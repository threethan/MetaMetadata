=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Bf55qfow6yX1A4IyQPgPzIlmiAY_-2FacWTmFOg4pgg&oe=6A29615D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqjeP6sbuX4Q7kNvwEVW1bt&_nc_oc=AdoWSCFDgl3fhb7ck0_gY_mn-sDS-gA6ESsJ4M5J1ghU27xwDAjq0MVc-v-s9__GwOA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9___pQhQD-x8WEFoaDHVrKy9dhlzgwVxtarg0TSm0UjA&oe=6A2981DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Jd3_XdWjkYQ7kNvwHqPSRG&_nc_oc=AdqkJ0aTVJq0rjkRGT2A2kJCQlIuZ_AXnGXrMry6nJh8BfFPIkcPoKz6nsh_g8Sexbs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c5xmIaiMe4pt3ZBzbbAt8_Dig3jqw3IOGlNFXbc0M6A&oe=6A296A0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CO_NowD_Iz8Q7kNvwH1no8i&_nc_oc=AdqXHkIxoZuM9ddwZpg5r6XgahPqc9CwODTrBsS_lyKRX5XI_zHezJsEsql8IuOhbMg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91Pm3rvhUADNcaizy7vAPxIaO17Jgt99oysJqeSkUq3w&oe=6A2975A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiwyNUP_WhUQ7kNvwFZkOyY&_nc_oc=Adpx3SGSlJLhLHCYyqmU_KwAm9GjTA518XgKCAfz7hPCvGNd1OAE-jAkYKmU7jdKS_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p2wUls3mhec7w9LYAXwz7o-aLFmRM8AxGpaQb87Inpg&oe=6A297A24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zxk0TdLiytMQ7kNvwFTcAXF&_nc_oc=AdrRx9pRy46YHvqMT5ZdeK8FSFvSK_Td2oty1fnsJMxpn0cmlnGJUYgjNMcobyFZqvc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89krGPV1ybfrsUQHAdIRMDrID-YX4Pf0no7onX9PPicw&oe=6A29671E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avnjqaYj55oQ7kNvwFrYetC&_nc_oc=AdrlJjxhMe7Y7YrooVgokMnMVJTGzjBU3UXKZkNp0o1o-fOvHiGIzhXIsivDgL7c_aU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8no3lVXzqS50Y_aAHGu1UUW6YQTg8hdSW4NJm
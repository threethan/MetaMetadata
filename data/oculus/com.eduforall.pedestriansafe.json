=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPDRVVccefzPLwkuU6SknpbJPJ_lGRIWV9E5ImpOymsQ&oe=6AF7439D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xcjt4_yT48MQ7kNvwFPFNwO&_nc_oc=AdrothvQbhtYRA1ncgzUI5jtuSjBc9sJJdCn_gELBUAVGT5rGH9E_n5b1krNoOE-T4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVcVph7uowsJ3kGIdoTSLzwnkU97qiCYLuphVZGEH_zQ&oe=6AF72BDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLCRVfefISsQ7kNvwFPHPqk&_nc_oc=AdolZmLQOCJWAHviXmRP5pLHaXuC_HiEvWp-0TfUg1zm4xWItNiFYkCkXDGH-NX6yCA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0Bzp74JTU1XJmsCFWuiDsk82FzOWfjkUxiyHORV_tCw&oe=6AF7140B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkLtHBA-jhoQ7kNvwED87vq&_nc_oc=Adpf-qaxAciRbGI5XscTP-NHyKkl2s9IUcH6JTybKP-sOF9HDQPx-g9PgntrlUGnq1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1fLWf1Hs1Hy3sVVRd0TYuT6TDT8rHtIcyDW2hR-vaxg&oe=6AF71FA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4K0iQ5YShe4Q7kNvwG6PV57&_nc_oc=AdpdT8oaf0-cWNyuhJ2ZdCaiHVmJ59MZ2lmGI3yuC44WJqwQOUqjwN93hLvtJx8Fe1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSSZY-tHqRQMOjF143nJgUTIMviYKnqg9rs8IdaFIUpg&oe=6AF72424"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0QPy-Ff4T8Q7kNvwG3_RuI&_nc_oc=AdrF0wAmUnf7J_mGQ7RszuS9OyZWOTl3Db2nXui0_6i80xism7AjIW0sHusxG9nQvjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZTTlnPfJ6R2tIkrzM17YXsQdLWgwOX5JEd5Mhq6czhA&oe=6AF7495E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvSJcXPNITcQ7kNvwH9fNdB&_nc_oc=Adpc-o3EfXdzq1HmyMY35Zxj2-XeLMGR5hDYoSVM8wUUj4Qe8ZliPoS46ISaZ-BjOO0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyDpR68wp4pArwEqUSgW2J3SIGQdxjd_HhSbT
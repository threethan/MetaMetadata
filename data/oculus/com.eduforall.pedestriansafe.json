=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBMnH_3EMc4blwkL7DU80BjrXS3obZr-wp2bUNAbvA0A&oe=69C923DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29J-2mbKqOcQ7kNvwETCg2n&_nc_oc=Adow0aVz6s_6j3QOXzGeuPXh2EKRZmVPp-t3mG8VgRHxHOhKZsDaJTjYjfsPBSSGjjQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUosf6o5TY1y3HpBEOIwa62KXi7F2PwMaRZbOZ9bHNoQ&oe=69C90C1E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tB4utyUkXPkQ7kNvwFk-BX9&_nc_oc=AdoQxPKeTUETX16pwJ1qulBmyTbVrXn-eUTT_3DJ8RA3WoFYJKC_l59pZZohfKornAE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3d8O9PdryzqdjI3xljFbaduXEFuXaHbkX6-Ls8jfT1A&oe=69C92C8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pofJCYUQ1f4Q7kNvwFNUmYX&_nc_oc=AdrtH7j2Ga6_6cTmt3xevjieX0KNRfrSI0MB0VtkENk5wwwzXnzCDTVcGB7hA8v8E0Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-1cx2ANK4lJXpH6aV1h-_Swj4uW9heMMTSIjk2T_DLA&oe=69C93826"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmGek2QesLUQ7kNvwFn6Kd5&_nc_oc=AdrbcE5wZV4t1p8U9hHTKJ-WMypM9Wa_1wJZb_KWTD-WRlsaB8xlFZ6egYvkC-lGscw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUywx0uF9SNBKGWzoupmkTIeVkLt8eOTaR8jLO1RfcFA&oe=69C90464"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgCzG8mq64YQ7kNvwGCeF6G&_nc_oc=AdqavSqXy6yN9yk7YJ15cWKNtrMRllxfmb3s6USQbbm-d0Ir2652A6sezEDs80V4UdE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGhNUQbDSfSS0RrvzEbAkUaFSdmJ57xQHoIDBP1lL_yA&oe=69C9299E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwFMIvPY1qYQ7kNvwHTV54n&_nc_oc=AdrxYKjRqBp8LwtkCYBScClAwdRIHRc6GYxswX65-r7wfunIuZNGZGYF0ZyZV2AfhiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwDlah9S0OzGNuGDmlJcpiuai3cNkkAZ9GlI2
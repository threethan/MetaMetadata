=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYV-UrUjt_Ds4pWdWVr5p6ytm-h9ZRUzUcL1JaKA_GWQ&oe=6ADCAD5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aK_x2mCoW1YQ7kNvwEllScB&_nc_oc=AdrEHpsChn9NKlKgKHo7sUJbzEpL-y1IBPtXJ-HMLiKz0yRkcMFgdkjHo1VsQqUypw0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOUE1jZSHQP5IPv7HXlnXOTr7a_gZPhBuHXmM23-jsoQ&oe=6ADCCDDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OT3kpaZlnkMQ7kNvwFJJAgx&_nc_oc=AdomVN98bWGhvU7GpDG-UrUuKdWvQxI1T189MbdAhQ5hin5y5Yj2acw-3-CFfjdjlLQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpdfQdFexjQLMOUW3xKUUKESZC6VxuOuQoKxc4x21Y3w&oe=6ADCB60B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jDVoDGECqEQ7kNvwELcPsp&_nc_oc=AdoC5z8LkLkOPP9GoWpwWFIVgUdSvS73eZAiBwt2tArsvdLCddqCENSAHnkDIiDhYPo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxxT_SvX24iay_AvZ8kAHKJYqBov_ZtBI51qC-2omnNQ&oe=6ADCC1A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P69IidUOFUIQ7kNvwFabAE7&_nc_oc=AdpsSmgfrT6pGbWUAqZ8yputC3vnhSJPwO7N3hWhvSdTkbYcp-8eQX39xF8QLDBi9lY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3DuRVcLFDzpM2ZUTAS3YEhOSBZy2ZCHA0-57dk9083Q&oe=6ADCC624"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsUhCA5mqMEQ7kNvwGD1wOR&_nc_oc=AdqWDyZkCg9PPokg-ml_NhzzU4pH1nd9ARR7P5Z7D0Smq3BmFTPWQAPWAqdniSyeJ6E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6SZmX4jkU9uttGtnjEEuktzAXm_fPHKt5Lbgr5-uGeQ&oe=6ADCB31E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLFIiFJyH9oQ7kNvwE4lBGm&_nc_oc=AdqxgHFudyNoDLlbFXHTQroBMrg1IW5cNZHm9XYpO0NphTffxeO3d8eNCBgJykaY_00&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiIFaEPJm4QJscbtyksITr80LiAEssibfq5W5
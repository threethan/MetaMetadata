=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwCgBwteAb1mgCN2ekmOZpamv2KJMEmONlHeGZrHYQsA&oe=69CD185D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3e3fMB-CztIQ7kNvwGoPjdm&_nc_oc=AdpepJfaiyPSnlk1qPvybdnekQy0QStYtrzLv7HeQ70Pjry7-nav7T2t0CDBwvgs6i0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzG3J-TziuWT4xoO0RLviPIxwC1r6p61OugBsmtCSIYQ&oe=69CD009E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoGr6Ueb_aoQ7kNvwEa9ZVU&_nc_oc=AdpICnE-wYJ71EKAR1QNwXeY1u5CQ3DxNbSHc959d7k6xryZdKlUXCRMkf75pdJn2dQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afygwt5cLuGXIoJpQ8FM_dAV4YliQNjvxZIOonk5cDdzQA&oe=69CD210B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abo69GzWIpQQ7kNvwEcyopT&_nc_oc=AdoBuGDUFMN3--E-LTBtOgD61B-ztApBpUyjBYZZMx5J3rm_DlTVP1jpwuL5lAMB0r4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzk-h0YE_NZUN7mXSmVG4P8gHH0DnV22P_kQwsrVYZyIw&oe=69CD2CA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3oq6ScciekQ7kNvwHbJ9Q5&_nc_oc=AdoutB_iF39VfT3Xk2Oh20mp6EClphNlKYWjIbi5J9bBDqhwHWcl_x9FDtx--MLRFng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWo_qXCWaxghzt55_PoTnshZHmWFqyv3QBUpw2UkVfmQ&oe=69CCF8E4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmlrmPIcMGcQ7kNvwET5R8V&_nc_oc=AdprSz_fd-YB6h-hEH2vUvcGOy3K_He1CqGhHnoqJmymHsRAlqQAjcqDekGzwXqPBOY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyySz9emMrib2qg8d6vobWnEukQRcAowju_Bhql_mwq4A&oe=69CD1E1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rm_WyO-4hCoQ7kNvwHGp0Rs&_nc_oc=AdrxppAwCElxEHC5APkQxLnZhOb6RVNKnQsK5dhCm_DtnOMq0U2X6FlfYdOVl40fsA8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOWuOGrs2sit0z-d-2NS6om9ucRoJ-qmiCuTK
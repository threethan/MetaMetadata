=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6L1Z2XllHOicmOn5mBf-QAflMOQARB2WdoE-feYIt5Q&oe=6AC2879D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwFJrhlEn8gQ7kNvwFGDcC2&_nc_oc=Adptv9oUdX6hcU7_rswdlfFpjv-4ACjy7f49mlVX7xE92rUbFPTIuT0K7UkKJr2YvlI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVvmnEB2g8Vu7wE-LQ7rwBaNDEeyqst-fwMT6rIH-9WA&oe=6AC26FDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsRb6e3ILNgQ7kNvwFmlZtJ&_nc_oc=Adr4qtr4pbvY7GGDw1TKUShR4tPQnLAVwR52Nw-Vk88agWqFNIGFLNU_v6XEXD7HD6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy0ijK6zH1wqRI_aJcuEOyDAY6IOZ5MNCLmepm_WnZ8Q&oe=6AC2580B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edOQPkGMrzcQ7kNvwE_ljpm&_nc_oc=AdqWJnFodyq4zXkQjzahoCiNBQLYcdEySVq2_9Vj_1gIh8W25n37lsu_m7qK6J9wU9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIkcfT4HPE1g57lw3L_6EyBv_nggiWhRNNvqkqO8nRkw&oe=6AC263A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8bml5XYqvYQ7kNvwHwIVNu&_nc_oc=AdqgPGVW2pKQ59rZqt1LQO0JWqrNOhV4oSzx8KA7bncm9tyf9wwPgwHTJRTRRjB8Coo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0XS9go41p1_glJATB7mQh0n0hH60NfSGcKEwAMYavpw&oe=6AC26824"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hq-Q3iUDIkAQ7kNvwFuBrH-&_nc_oc=AdpyktT2JoX8AhFLsPAQnNbVMTsGeb7SWAhEii1j0UVuhWTpKMHkOCg9DwYHUqMfUVA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTUSWbSkfaFcYuDghzLKUZZ6QNhyCkYfnfAOaULtRH8g&oe=6AC2551E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWNIvP8lNFUQ7kNvwGqvruA&_nc_oc=Adr9uzqLwfcFgixNq753-1rUkbjKVKVmyasIuponv0BAW3D4SKy48YbdhyjqGS-Xt50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr91xZJzhaz2TiJro0iRI1iV97h5-kkVF6uLt
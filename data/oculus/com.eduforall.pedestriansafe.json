=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8xCMrMNMEw62fdqpMwHC2kWB6uYbWPOGLyWQgo9Dt6w&oe=6AE5E7DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDn1ywF1wlUQ7kNvwHgJwPl&_nc_oc=Adr552PvYKjG4o63hygYx9L8QMcxCJbTU_KVoRzCccuUEuR0DdmAg10s_GuVZhn7hGU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTqzIAtTlpPpW5m5OsYUKqVnRD5XqS-yNhlezVUL0fhw&oe=6AE6085E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsFss_FVh8IQ7kNvwFIkpiA&_nc_oc=AdqJBLauQHIs1V_E2SYt6x4SWVQbPVeATVcoOkLU3ni8diB-lKuRncBenvr_NYOQjiI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgWIwNC3SW0v0JiqfWherFlnnwlJLDfJMmi8ytrTV3ew&oe=6AE5F08B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYVX87H9LWEQ7kNvwEdfopK&_nc_oc=AdqHivqNvhUc7HAiJJUPGjf-U9wW3ZSmPes_UmDWZTSs2_Zb_5CN77BcoXF_E1ovQ7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMo8tHMgT9pyWz4-rlqNne4nVOJEJ_ObJmVEJah9INOnw&oe=6AE5FC26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GchW2wY77K0Q7kNvwHWLcbT&_nc_oc=AdqxPdUF-f17gnMO_0DHwklmZTHNr-eEh7JxLW7IRRxkAiImiWHNkjaWUR3xADX8WSI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7COsN4mOtoQooUHpRG_iFyFLllhvaT4uzBWmQHu0yNw&oe=6AE600A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYJT9gXkCvsQ7kNvwEiPpva&_nc_oc=Adqd3VbhP4Wkq3lT6MF_YUmz6kRnXRLh-mCFnTDN1xz0ceB1AszuTqttya7bSYSb-Pw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEBrdtJ5lpn7VBRf1V7p964MzpuqPnG4CuHfHvmSPRJA&oe=6AE5ED9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ly8JjDyBSzIQ7kNvwGg4x7L&_nc_oc=AdrmBYDwI2v3iXwV3ucTwtfvcIsWfdZgbeRkEaNzt8To1b9gy3EmVu60GmIVid2o7-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4an5lqXSX2ZwjGXk7vTWODwiJY2AqzZcZlu1
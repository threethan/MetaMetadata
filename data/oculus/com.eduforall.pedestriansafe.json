=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3mJLaNbYjCP9LSRMrGhXPa3R4aDkTgBs4oPQ4fO_Sag&oe=6AEA149D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxqMhz25gDUQ7kNvwE_Gjvk&_nc_oc=AdoBoiHO8AsEKDBXdRf6hMXuQvd8LREqxWp078AhZfxUpZLhasryyjBudUcRzaQuM6g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgd9O2rIqsdOUkznPT1CzXQC0KwquR2t8Od-emR9Ff8g&oe=6AE9FCDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvgESfIjTDUQ7kNvwHuJUeJ&_nc_oc=AdpcjgIpVsACvLMtt3SE_NmPXhhQrr4OTaixcFcJCapSnQAnoCa4zMEQejZ5bYVncgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuZiJOQjh_wPd4OanvF6g1t8EZXQbSspM3_63zI3QidA&oe=6AE9E50B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m60MI22WcfoQ7kNvwF4fHTL&_nc_oc=AdpE_grOzxnHfp9_iBTLvwC64geDsxmDkc28HjegxAg2mK5OJaYt9Sp8BMRZz3KRHxQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMJ9Pdgx53svxLz3X_THD7yyG1ALAIdTEfnGfTucAvBA&oe=6AE9F0A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p68jwS7s7FMQ7kNvwGZP6fb&_nc_oc=Adqq3EPWkr53bBLSlP-J6wXnkQIDP3r9UyiKgZ9QQdni5eQ_xBPBbRMHlTh_3AKo-mQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7xLSJdWkEsXKMHBbfZr8oDKjqBBSpNlDcuVZ2u40nTw&oe=6AE9F524"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Bt6RH9kQmYQ7kNvwFIPYBQ&_nc_oc=Adp3iJ_EyqYlKHIBKqCHjKDStvULZiVbXNi8AFl_2KYp-GtKiaBKLB8QSEVH--TxN5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsxEo4qlA2p6ctYJJIpwk8dS1X7-RcGZSq3beF3m8aLw&oe=6AE9E21E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IELIb0eu2wsQ7kNvwFM4_QT&_nc_oc=AdoWaN_dTV3CtX8F8QpJ2BNYYBdyz_WzHuF5-0UeyhjwJw2dTGNDJ3VNtw0DPkuAJnU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgt3Fhh2qJBmB7w3EslHQsI0sNEHl00HIgoSl
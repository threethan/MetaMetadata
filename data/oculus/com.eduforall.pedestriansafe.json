m&oh=00_Afttxaeg1L25GlG0EtP6HpmXYQn2tW7JFDeSlC4ZvHdsNg&oe=69A17F1E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b65rECM1emgQ7kNvwFUJitU&_nc_oc=AdkFF3v-XWFKKFbS0W6JMEkTBcoZJ5GkCpQSS7n_vz50hrErTpHztBNn_Y0lc9CRkfg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvxKaY9XQ6KKk55YhlTSISssAoI3qwUiU6q5AffLuZwiA&oe=69A19F8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcTw4q6mawQQ7kNvwER8iy5&_nc_oc=AdmOxSabUMQYYVWWqhq4aFeCuyJdKPe4tnk0yx3YPiyDIKs7WLEDtQ4Tg1eziMDZU4I&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftPiNREfIcBTe1tpHZRMnu0nERUaerBq_eBnDL1tfl_cg&oe=69A1AB26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AI2DsHqY2BYQ7kNvwE3a80G&_nc_oc=AdnY21zz9CQDM-yYj8HJj0ea1lJ5NRSXUsVbcobAJtwrUOHbcMge6gLQbC71XZmHPKM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afuj8lNafepHMZqgaaz3GgbWm7h8cCR3M9gGuI2gbSOxHw&oe=69A17764"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4y-7uv0LzQQ7kNvwFkyzmc&_nc_oc=Adnog5KPA7Qv3vm9YPJSD3qlUl21G0eXmrtM0AdwMpyzdAg5XnCe5mWrtj9XA5uNr4g&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsmndoC2BeKuXWiPkQY7jLNBHH7IchmUrd3K0fLKStMTA&oe=69A19C9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A96fiO6tvmwQ7kNvwFzRrEo&_nc_oc=AdlFs7urOkLYFtpudTahZcjtPaNvAa214kUMAcvRytMt5IUfWLDBHjmEZDAiNboGFKw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsG44W5UTCWo3g4J1qfLehQ__wsuBao8jFs-LDH1Jrtug&oe=69A19A84"}, {"file_name": "[\ubcf4\ud589\uc790\uc548\uc804]\uc571-\uc544\uc774\ucf58.png", "id": "1843110519761474", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974788_1843110523094807_6196787795280771349_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBjCZz1lePcQ7kNvwGAbEDd&_nc_oc=AdmGldqH-nZ98MCClQd2UTleZD0fEzhcJuzG36FWKx93QMJXE-iMHA0pDIOF6LUNDzk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuFKUzdrxBxBRui-Huh-ms-YVn11K1hopqLDIGg-rKofg&oe=69A1A9B4"}, {"file_n
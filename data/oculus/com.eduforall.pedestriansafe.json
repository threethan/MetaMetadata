=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbXyUuTWnj4e3LkXRPPg1bd90e77XyrEt1YuQQV45doQ&oe=6AB27D5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=at2si43P1EkQ7kNvwH_tJb-&_nc_oc=AdoWMqh2-ax3yjBtJcdNpVKFqrTaYKn2Gz8F_Kf2ZOV6W3JFfsxiI21362h1wU_pxys&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEtJ9tRqM2wXpS83F9T-KLXxcLurYk43zhVh6pXwSWrQ&oe=6AB29DDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1G6-e_fa36oQ7kNvwFebto5&_nc_oc=AdoT-X4Q3f02vr2EIK-aS6tVFPETBHPV8BrqXa141WUl0h3NZND4ptgX30uUdqO-Kuo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUY1azW2ykoxYy98l3FUQ5sGcICyv0UQ20dc5Kagr1GQ&oe=6AB2860B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHDpeG5wWbcQ7kNvwEdyl83&_nc_oc=Adr6UON0jl5BH1lLIG15975Lz0VnekGfm9AapgqEjhnP-pvW9FPuPmqGMt4uI_E67vU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPLPAMoFR98Y8q9oyJNc9sqsXOesW-gOK176Ca_ZKJVA&oe=6AB291A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdTyybwCmdEQ7kNvwH5kLlU&_nc_oc=AdpPElyS-CpRB6E6vicVoGGyIkD1YcFmZgyLxhlXvmMSX3FIcSgKgTaAoOu500YMtjg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBFBA0T2Jn962Rvrmz3LguuA2fUJ7VUADP7TXWfVZfRA&oe=6AB29624"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWGVsT3Cn-kQ7kNvwFkUqga&_nc_oc=AdpfJ9t0UbxGkIokCvlolqBnKyLHQmjuXW30LOPVSguU_d9XCbepBiveZooohHpnNbs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFOCpuF0gDr_3gy2ZTR7jLBoFhMF1WxN8H6iwpFmFHPQ&oe=6AB2831E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OVvbwDH09gQ7kNvwG-OhZs&_nc_oc=AdoyirFAo5QoZr1kt9JNRWKNDshhpRCn303ZWw4KSU42ILvFGvtwqUPXwQhkXdBQ2Xs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwR4f-tztSZN-l5jgjNJLA7vIwFwBG097tS1t
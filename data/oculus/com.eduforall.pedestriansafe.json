=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7P0bZZTT7a-rz5skFigiBHEBVUleca5_g1PwtLyPcNQ&oe=6A5CCBDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ftsfou3soYgQ7kNvwFwI-tw&_nc_oc=Adrs3CPl9NzoL20Brk5p3fIfgQK-D5URTNsNUkKRU4YNcgf7A9uPA2NWCulhvFjHGTI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5HyaEyFA0AApoqWGk1hODwYGtU0bEK7_gLsIxLqkx9A&oe=6A5CB41E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaOIlG2Ps_YQ7kNvwHnisNs&_nc_oc=AdqNcsiVTJZGTv1l7sVrduh-vtCZQGucfQf5cKM-W5WfbioVIdKWtlAPYmHoc-_tWdM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJkyOjcN6FzZhfiaQQi1ISS_cZlGNUZlhy1Ho50ImFrA&oe=6A5CD48B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzgmsjhWV0gQ7kNvwFa0lfC&_nc_oc=Adp1u66ZM9mAnXt1DBwmcDQ9xj8jPRoOwy8boBlTZTVnIvDm3QkbO36ycGncJrBKQZ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBV1I6ekVuutFtNooyBHaTPWBMrtm0yCS3YS3Sx0AkDyA&oe=6A5CE026"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zx1cOztwozUQ7kNvwGLUPej&_nc_oc=AdoYqZ2lnnBhK9U1NhE6CcJu9OZqe-TjgH-DQXgNv30A-Ks9vURgdGFxORXNbpD0nLE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1YzC5teJ-kkW_XLLzoq6hQ1UTOhu5ljIMpl18s1qSIQ&oe=6A5CE4A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcKQFezTSjgQ7kNvwG_dnya&_nc_oc=Adrtu9L9XmkeaXRUMMQ6uT2gZmcrPnTjVZ2cspWrle58b-7pi4LUKGqsCraVSGy2Kfo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiMNfZSJ-IMXS2zfHjPT51_0yODe8MK6K1IIDao2cg-A&oe=6A5CD19E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5K4sBooRkUQ7kNvwG7ok7Y&_nc_oc=AdqwOTXV98Gr6Bhv9msJlaTlLp0gZkSauYzLlKRzR0ud6JMq9Nin4FohIGTJloD0eEM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGrf1m-0s-gMohNrq-PZDqRGiszVeSkgANUdl
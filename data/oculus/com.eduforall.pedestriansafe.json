=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjiDj1Z5e6OCSaeVI98FiH2wExlOPH2hqPcSrJr1Dwfg&oe=6ADDFEDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aK_x2mCoW1YQ7kNvwHcmAlo&_nc_oc=Adra34QwtQ_Jj9ObdVn0YCeF7N9D-IWCw8SIltzBOzIWUYkfIedgW3wO2TLIN6daiYI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcPCvf_EfqLkKbWv4uWQ3oNi81a_RRZ9gG1kWyi1wa3Q&oe=6ADE1F5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OT3kpaZlnkMQ7kNvwEWmtD9&_nc_oc=AdpQ7aVudoEc7QfO2TBdjtG7a75HK9cdFfFFVyWJgi7C7r5RqZ5gd53HdCnhXbJJRXg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-S8fEiOUuCPJVxHicS12R9OSs2FWZ_cDDPtC8fDkDzQ&oe=6ADE078B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jDVoDGECqEQ7kNvwFxXety&_nc_oc=AdoR9f7eb5OAg28tnTwdDUTvvtj2z4SGwwbQbehr7788BwNHn6nnUqtziaeWxPlJo-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMisr9-PotOyvXdxAXSeUBiSN-Ns5B-L2fpEZZghXw1w&oe=6ADE1326"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P69IidUOFUIQ7kNvwGDu6wd&_nc_oc=Adr5U4uMaILjNhLgIPX_3SF4_xHa-AnMh64PRaGBqO16AQp8vz0GETZUG6VTsvF2O3k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZRy24bO1jIul4Ypkae4Spr85eiKCDM_YCBw-PW5h40g&oe=6ADE17A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsUhCA5mqMEQ7kNvwG_jHf7&_nc_oc=Adqh1o0MS_Mj6FVfpKIxH_F5mRYUmoWl59B4MVIuJ25ySHuB6dPG6U7JGAMSnVj-r4o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfnUINwNKiRZQ-bii5ROfdvRuZn04ca2FodR6pt0hqSw&oe=6ADE049E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NONfnUNk1pMQ7kNvwEHAM3v&_nc_oc=Adrx6ZdpiAmhfs10fqPfMoN9-DI1dEQAZ2bCkJotmgGDIbJQmwxMz3EN-07EbizTai4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPAKaMZt-Qx0nK91_vfWy0I4z0cgX89GWwPzF
=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwZlN66h_QDnCRjtVu38g4vD7YIhuBQ8x27GyZXO-UaQ&oe=69CBC6DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3e3fMB-CztIQ7kNvwGEcNPV&_nc_oc=Adr3fR5WTMfpZ21bxEmef5antLIpvZwzZLJssUTmiwNzDpQ3pfooV95m7QenzuB044M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9lFxcJRoIBV8L9B9PTw-Codbamj4s-XCdXRk7Jfv7GA&oe=69CBAF1E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoGr6Ueb_aoQ7kNvwEj6Wbm&_nc_oc=AdpDUG4uXTKWLqNUiCQw6UXK45jJVr-W7qTw0sveKRlJ9eQ_pETk1ALoICvTaY5-Wms&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDe8VYaPDWPhb1AII6uzuL9REqWCsCnV8Z6dqeK7cM8w&oe=69CBCF8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abo69GzWIpQQ7kNvwFU5wVz&_nc_oc=AdoBHxU8277KFqIMiTymun2vOA3zEk_3dzMUWIy1vbwLpPw2gXUxtHOgeo7a3yrN64E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDM_9SzJ4PnHJDGqy_p1TqYjAzPDjQhXR09xPxEkhTtQ&oe=69CBDB26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3oq6ScciekQ7kNvwHCB2I2&_nc_oc=AdqQfD_ZCw3G4fEBmDn0j_sI59I9XBSSFb3M_PG95geDzYVYkMFbpduvJnRBDzWC_hs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-JidUU0IAjAI-HjL3zz8oWPj6X1tD_NYXT_pcIBm5bw&oe=69CBA764"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmlrmPIcMGcQ7kNvwHOkfVr&_nc_oc=AdrbpE8AfG9sNiJe9SQnbI-GGZJXnvjkDOqWvLsaGxBBoc0cUBJap9JRUOavlj1IuMk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoBWCxLza-i8L0UhSzYk-vL-fgHOfBZNgJwc2BD0ZCjw&oe=69CBCC9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rm_WyO-4hCoQ7kNvwF-Plls&_nc_oc=AdqLrpMHETYV34wQnZTiJlYYjcNCzauE2wTkTxhuHbk29f6qKDCkkSOuO-B15t2tcpI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGBYFNGzbP5c43LQYPm3d_ZXS93FM7kJpFa1u
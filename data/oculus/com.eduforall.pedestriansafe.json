=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6BSnqzkHDyBml4vriFNRNajkvlY8OpIFS4NQf47HVwg&oe=6A69FADD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZC6Wzs2x9gQ7kNvwGEte_v&_nc_oc=AdqI9vdA8WohmQtUM21LtJAbrXEUNmtB3Q7xu0mHTATkN6RllYft0hDn6s1MGtvLL4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTS_QIKLwQKDsbsCUBhYAa_Dor4eSOY4EGxT7xuAxG7w&oe=6A69E31E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJFLdobXPLkQ7kNvwGvOx2Q&_nc_oc=AdqylgTKZxP7EQ767_NpCVFphDncjI770BSfvT-11cUEw362SSox8OhcJfhDzd7QwmE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw1SVULrSXyJOzgJWUbow8dVOfVMyKlOEvZaXFHrWFTA&oe=6A6A038B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l09cjsqo32MQ7kNvwGDCjJ8&_nc_oc=AdpnN0012bRuQGpruAuZ9dPx6VprNHStQvrxJL_OkX5ThBKYqHDlz6SpMkUisszJKDA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_488ZwrZXJzJlCN5ruaywSOt-NECX5AgJm3DjlMFepg&oe=6A6A0F26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2HNEOfNaZgQ7kNvwFBmV8A&_nc_oc=AdqukC7ILp943xlz4gJ3pVxE5aH8Xqe5Cda5cGbkNQgOlOnYAn1aeqN44gmjN0EPHAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUShlcknGcHLRFGKbt8e5NcJAWndOtGdBcKq85Yth99w&oe=6A6A13A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsU1rFl-BMYQ7kNvwFW8r4q&_nc_oc=Adp-XxaY27saJHElcm8O6sbNTLIfjzDBWxpa9VlybBr8Yc8IHn67Aixhn5lKY5Zx46g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpH87viS663oQ_VR-h855tcEF0k-aviHnEnIxIotxq8Q&oe=6A6A009E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qRlkGvk6kkQ7kNvwG4eG9P&_nc_oc=Adq171Dfzf7fDzPGUvW4A5KxGVIIzFvO9fjIpq2--zTPaPMjQkxOczbDYasnMZRbiZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfo5-Iyv0_EwFJszEIViiOLn0e7hlhIVEtF0h
=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWmq_iE8USuBdG0WROva9ZfpaWNVBWKlJWSj1kdX58Eg&oe=69C7D25D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29J-2mbKqOcQ7kNvwFq9dl2&_nc_oc=AdqMi1elk8bk9FazgGlt6vQWM3VM3-zkN-Y7OtpcQWvxmLLuFUTvi4djXcOcoyQOv-o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwvL5lzR5fs2dxxfbTj2bC_6ArLIoljpW-Tigg_835emg&oe=69C7BA9E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tB4utyUkXPkQ7kNvwGMafi_&_nc_oc=Adol3zmEl5t_d6KwCG06PfYJaaYh3OkHp7-CMwulhCLyeL-ymN6Q5PiezTJemNakWEo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLHZ35a7qtc_VVqry7lMcLO6Av_khfIU_IOeSgg_DO6Q&oe=69C7DB0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pofJCYUQ1f4Q7kNvwFI1Dq8&_nc_oc=AdrBQUeEkQbsEhNJCtas4rhbJCblxKyTDU83rQI6qnydGqpQB9Q02zIHdPSfj_VSRag&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiW21nlPW5OgQ1yRs92V10vV2s6djDcY8ZYxywogmODQ&oe=69C7E6A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmGek2QesLUQ7kNvwFb2QLX&_nc_oc=Adpn9P31oKVr4zK8mLYmGveRkwbK_agCenadWy7q2MwM3tawo-jN4bi5r6fNf7OZxY0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx40HbtE7WRumOySsC5DI50OhQxtrTzssXTSb3FaO2Flw&oe=69C7B2E4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bzkiNpiVAkQ7kNvwHGTank&_nc_oc=AdqhEiG3hECMHPSwMtVDBDDoidAot1vvAsivx8JCZLb1pWUskBj_Oi-ZpaOJtUejbJk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5GRYoB0Z3GJLtZDIH2SAyu6o5ryM_BvDlPg2zDGXZkw&oe=69C7D81E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwFMIvPY1qYQ7kNvwEYP_1r&_nc_oc=AdofBw_t1eWJMGPZVbv5C4WJBDGBWI3VnKWVL_6l2FwzlV2d5mRcHXFEKXeBy-tHORo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySNB28MS01RIQ7X51xEam5SAfTIWXWIwaKEsk
=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgzM6nAT5G0nwW47g6aeq2DiEN9-AMkQUnidvmDqGAmA&oe=69D10CDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikVhj2QBS7AQ7kNvwGbW4M9&_nc_oc=AdrRGpEuGEDbYGAYEmQxLpLJUm45fyFEQJW6_R_BmSKhJDuL1kHzNohooi0hjOSrxKk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhhJCI95Qsx3B_Rut8B5TL0Oiym8yt0MM2iTx0YIKC1w&oe=69D0F51E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3nVkBJ2M3YQ7kNvwEy0It-&_nc_oc=Adq5qOVA6Zp_vyPdULmRY1r2gyVgbyzpQlCugMcvxkHuwAESL7aK461yKwchGvvCpfA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybbpTj3MhuYCIGcaQqEg1gHVB1AWT2Bt4HA9QWtMBY0Q&oe=69D1158B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eniuAYXuEIQ7kNvwEMSbqL&_nc_oc=AdqOTaDl99bGez7iAsY0pALtl24rexupSSqQG3402_wxo02DS6xanmIH9VtGTQ79aJU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3vrB12mcRRIiCGWUjJ13CJnPQLmqnKF7DrfE0KUvxmg&oe=69D12126"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYhI6086nDIQ7kNvwF-z_cy&_nc_oc=AdpzTHFZkYBGg1GmcOuFAP6YexKC7e-Wdt_3HMgtT-Xtu3Yt0co6y_DxZmR5ljT2PDU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOle8WHP6DA-9NqHhimRjfmEmFQT2126oKusYhJSKl_Q&oe=69D125A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTZnvZhCe7MQ7kNvwFPBkuF&_nc_oc=AdrZgcB32ggH1LtI7qrqpZfDwwsxKJU0Z8TY3Yo1sK1P9_51UC5DOls58JFfdm5sWI8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-qpLc1fkkkQahOyd0u5ua0QJYJL7cdko1vyGUA5eN8Q&oe=69D1129E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfOh9Ub6yMYQ7kNvwGHoDDf&_nc_oc=Adox_H20uvxgT4s0XWApk2rNXtv3fK1OSj5ul4wenESHRqrIWHHlv6DOkcP06its27U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwk7EMb1jsKSVAmnsrpThSEbTCy7qlabcKLj55
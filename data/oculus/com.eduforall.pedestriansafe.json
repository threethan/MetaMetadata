=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDm9RyboYe1btiWpjdXFMi0tV1YiWidFTBLjrXNJos5Bg&oe=6A4BA85D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-x3qXXaJDwQ7kNvwEnRVFT&_nc_oc=AdpoojXpAENkJTonwTUDFSqwEdg_YXH1mOBi93iQs9Lz_sInPft3xac7E3nJMjleqqw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuL5DJj6hzsP5hHOP_Gpqhpt1l5TWZhFn1HVbyKCAEXw&oe=6A4BC8DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeSF33nqni8Q7kNvwEacH-Q&_nc_oc=Adpbobn5Vs2qGGbfFsvPLxbAIOaOK4gYZFa6SsymPFp8Y0NuiTD4t404NJRHDuEXBnk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtOsq2-Ohj_gVtDNNSlQJzR1SFLCHwuU0a49KXYtBBVw&oe=6A4BB10B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlHnrh9uIyMQ7kNvwEexZBf&_nc_oc=Adrz3q14KWLB4HXYqmOlGgCLCjap8I0I1KVqxv_fG_V7CUyiaV-vNVA0tT0hjHZ2MpI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU2cnZcYC0MSnU_KFXOGjRmPdpNwYpBOX-V8ZxbXeKHA&oe=6A4BBCA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-N29v5CNyywQ7kNvwFSWsyM&_nc_oc=Adr3Lrf8uhahWAkznoPD69_f57etNSeOKMGa5lcEVytLF8UolkRaXuZkxsiScj119Ok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC09whHK0PUyfLTHWzCcPKMSFPkTSnON8eCKmc4ngOUhg&oe=6A4BC124"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOz-P9fzG7cQ7kNvwGoOmQM&_nc_oc=AdqmqVj_6sh5gENjUYZ91On2hHE8MD6ZUXB7aOt7V70i2Ae_DQzW-A-Rdof6YXbUhxY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqu9Z8ZgMj8hrfZonDKeCoa5Y7rSLXejOofe09vU3mhw&oe=6A4BAE1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ck4ltXYgyggQ7kNvwGsKxC1&_nc_oc=AdrFNVgJJb6HwJsBWst9xmZpF88r9noL59Bmsxen41kYV0DzY1QiMAxUl6qh102SC1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0C2SukptuXz4whBqJJe6Kcdf5MvfbMJVnTzM
82121187132_8308184151168799368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1_FOYupaygQ7kNvwE-foFE&_nc_oc=AdmLaHp9e-r81KCn2MigiHG_2jT31K3oniHX20kXN-0gX4f0pmLLzBPXU6k5RCc6c6o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsBDgmUsNEZuNH6GCiOGGVeNw2cV45RLGNJuUKyeSl1Tw&oe=69A58B5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBLEbgCR6zIQ7kNvwF0-hbK&_nc_oc=AdnumPaNV7CdCAYCJwz_acgetwFO6n_kry4xRmirmMDg_2j7vumUU2KCRk6cWaZMz3U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsrLmHV-7qLPVn3ZJHs5QzTbU6xlI0S0uadE7G9Q_AgBQ&oe=69A5739E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuzcfR9-KYEQ7kNvwF2AIsV&_nc_oc=Adnz4pY2c7Coqce98VM38bIzWQh0Upc3MAsS3F5MjlEgkbUgExf6ETzx-A58T_coXNU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs4-Hj3CN954qYTBNeh7VqNUwOL1OuJIdDPWYXs5D1pvQ&oe=69A5940B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoD2b3aVjBgQ7kNvwEhuHU1&_nc_oc=AdnDMHiq6Cuys78wCeqhj0WGX9uiEWSYTmdu62JB1MFUYvcHSCn4hp5Gfug2U-c8VbM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsaOfrJJv7L9LeuSb-OGZzSIFauA-B-mw_jmr3Xeu5r1Q&oe=69A59FA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ts4_1gUk8ZgQ7kNvwH2Mfw-&_nc_oc=Admci2IHWhqC41XdPi4olOLs-YhnpBywO7dI266jD_8W41fcuMo8NCHOlJfXP00eG_E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu6LQdPE7nSXSGMoDhPvCP_UgTk14Oq8lGrAqcsc-AH_g&oe=69A56BE4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}]}, "developer_name": "Safe_vr", "developer_privacy_policy_url": "https://www.eduforall.co.kr/SafetyEducationpedestriansafety", "developer_terms_of_service_url": null, "publisher_name": "Eduforall", "support_website_url": null, "website_url": "https://www.eduforall.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OC
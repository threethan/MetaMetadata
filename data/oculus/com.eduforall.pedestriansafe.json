=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoO5QKWUHVkVnggJ6DzBsIZ3bPNL-4zyqGsxMBA3Yr_w&oe=6A98579D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwjhKzw7NF0Q7kNvwHidO3w&_nc_oc=Adqo-ltXxvaWfG8bn-3LK27-EPFwLdMD5IVpY8TgVvw0ovdMCEf9fXeRgACoGY3vjyw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ38Q5YpdWRLZ4CckIIv0fzUggMmxZq3tQAyidkVf7xQA&oe=6A983FDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_uG6iL3UjkQ7kNvwFsV0Rf&_nc_oc=AdrYGGlpGs-fC8hTqAzMZ4p3C0aBtaoryCIWqD0aVN5WcdScP75mXbYYI69lbKiqJ54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgQLt2iHWMr48SDzD-0p9lc_P95ysdi0HXj3ompXfvcQ&oe=6A98604B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSD9tkx7hNEQ7kNvwGDZlik&_nc_oc=AdosIBo79nth8N38l6MVUNyXxUKfql1WaE2i6bhMuTTqNegZ1YVLpPRN-6uf2coQB30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIqjV4FZBWB0BuhivJ02tWO5WK7aQD-olMlzWTxsDHQg&oe=6A986BE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAYAHfCtn4EQ7kNvwGgXN2p&_nc_oc=Adpgoo2j129uSDrZgYnBHJA7Y9JgR-FxyFovaF3XoZ8ZGrKVS1Pp4UAkhWlilmiWKFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmr1rbfyIk0KUVvUY6X2WLWPWo0zjeLaHKlnfHARRqww&oe=6A983824"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36BwrCm52XAQ7kNvwHnSY9I&_nc_oc=AdqCg8pcD84x1y7jfW68ZRpqi93QCOMC3K7FI8sjn1aBrQsTfKm8Qg2_BajgIokY0ww&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW1_4r6n7bJ0eiaCl0acpFYbZer0eDz5seBaTpQkZ_VA&oe=6A985D5E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2iZFCfAbhkQ7kNvwHymSoD&_nc_oc=AdrOwLqVetSoHqk1jHiPkZ1klPj5dsPJLqwl5ClQ89MYGYPWdkqA348eULQzWRJuzb4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbwsJLCIuPsXZoSpg_Lxik-FHtbAQ0jvGEZNx
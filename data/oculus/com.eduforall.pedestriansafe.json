=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfgKPp1RRPEXoh-JgcPmP_D_EK6fH-y4I1EvU_ObvNqQ&oe=6A49055D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lY3iWrgwabMQ7kNvwHJNJNp&_nc_oc=AdoggpHmGDxGplL4orTvfC03hKv3nUDHH1uqtfcFwRss31NW8oRBN7Tbi8OnUNEIvrE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDfVuLGB6Eho_htTP650OyOcbPevjZqcfOlxmiY2ph5A&oe=6A4925DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxohutogMgUQ7kNvwELL9Hc&_nc_oc=AdrUgIsN0cUveu8SSQJrUv3oBwjG4s0TD01r6nc_8xexBPyYO9TQt64CwlQQtzfBIh0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeI7GmY8_ewXzl6Ksd6Q80RWldSgrhZHawpVUwA-xrpA&oe=6A490E0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlHnrh9uIyMQ7kNvwGQDEFJ&_nc_oc=AdogO5pOP3B-XUQhJ3cCv5rZnAnR71XUtu_pss-DZiA7DqeZv2E6xamfwZKASpU3F6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLEftL9EDOtwgMSez-AJXqo_peYPzR6pT58DEdI0mUKg&oe=6A4919A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-DKAbH59loQ7kNvwHLqZpB&_nc_oc=AdpvrSOR8hnuO0IiRH6JTzR8ckr7XcMFErEhejQIV-nIDRL2sjknfCjrNk3uD8wdK-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfHmkZ81Kj46oEFpZAi9hsKEu-Bln13EuqQnowSv1TcA&oe=6A491E24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-706eI7nmbIQ7kNvwHH3aYO&_nc_oc=AdqEVeeyh8SevfHyDQNjy7Q52gROjGP1zRb0kf5Kfo6X6euINsn2Jt1zhVcfjuMo1CU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZvflOH24K_5UUPtZaEUa0OEH9SpKJT3tdjYVfnRsLQA&oe=6A490B1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0qmL_DD988Q7kNvwG-AB8e&_nc_oc=AdqoQsm9A0rIwxIa-eGEcON9kNFkrIcI9Ry-9dio6YpchT5G5ko7QQFj7U4kEOpFU6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4-I1GSgfn1OAJKv9Gs_68wyoDS9Z0fXrxWz6
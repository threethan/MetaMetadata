=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uyC52B3DUZckNG8StgTfEw7xx1O0gpkcgtBeBkkKtrg&oe=6A1ED55D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8s4OcjELzfQQ7kNvwG56viR&_nc_oc=Adrpx8n28xiuiRi025Zw8YooQFpFBQEcO0P1B6SnPJNsFxqFmD-HGxRZRKrhMJfP-PQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bVlmDBenfGq5Ma2x0jGTDIW_wre1BS2OgnOTfq9ljWw&oe=6A1EF5DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdqOdbW3ZmwQ7kNvwF5kplK&_nc_oc=AdonVl2-PrkhJduRRRT4I_BHlFwzBGtvTRXt2GdiN5mNeUpydtAOyOuK-anLVe2sktE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xo88aHbRjRXVOkErNxxbp11TfJK5CF4oNgDitcXyfTQ&oe=6A1EDE0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2Ds0cOOueAQ7kNvwEKo0u3&_nc_oc=AdoV04ebeMWJ5LjY5QApdx6NWsuxnj2qqxaBTilR2F9_QmoCPPvlaOyuEN9rpNeCbsU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jcPVplzjYnDd59XdbA9cpiQDEttsqzcWAWlsb6JQR3A&oe=6A1EE9A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cQwJwWm3fwQ7kNvwGrVfA6&_nc_oc=AdpPYh3LcjccZljmyTKGrIpPxmzKOC6NFepSRItt9WwnY5UEhdq2b6_F8166CJYe5BA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LL1eo0ABkGbE__fnKGYQ_NV-5w058jS1t6TvgYBYOCg&oe=6A1EEE24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFqM1hajD-QQ7kNvwGNThPn&_nc_oc=AdqLsbvMwpZ5FbPdC0UXdO0SzqlRPh04zAjv8weGRo-2ii-3YnGhGRA19lLrvySVyz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tEDOiB34mjAhOzvAbyTU7XhfztS7F9rdsPmYKaEukOg&oe=6A1EDB1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6lF9YWh1hIQ7kNvwF9ppo5&_nc_oc=AdpxxOZV706lLr9bzFvmdBr0ZXTT7Q2U4QqREKI6gMXfr5zdOFNZDAIaIywXvBT0gvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af736EiGgdsThC4jqxPT2efag0ALGfkOWXjwHoR
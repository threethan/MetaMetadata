=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PrLAKRBw6mV1KTEZDSNssqu_ZjBNmzfauoaElIxqmwQ&oe=6A09BD5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fADDDR-jPKYQ7kNvwHbGZHP&_nc_oc=AdrgCOh_bNi2_9TPLzpFAURhCOg2yjf3A-d_aH0Ewa6yABXXi8DVl0GRWXTxxMOM7Tc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AR3MGpyn8rs5GXP4n7EmlP6vRbrZ30uMP2PTGX94r7Q&oe=6A09DDDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xnthWPTSkAQ7kNvwGxOVlJ&_nc_oc=AdpmGB9y4KL8pSY7dNVRIAyR9e-qdrUjkkr43umAEEQPZyhEK-G8sq9NDh2p2w-lGZg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cZr6foHADg1x3b7qba-E9jHGbdb_5nW_6yey4gDMaWA&oe=6A09C60B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkWgX9_TkY0Q7kNvwFR6FSB&_nc_oc=Adr5-0uY2F32A_lWb6IV8kuLJFddn0fBsWjOKyLeldFebYMrXRq-9WB5zbTkHyHJl0c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4k4lgEJXgtWwbDx6DIbSf0yLIn-dFUWTDSkxO4aGT8QA&oe=6A09D1A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaO5y8T6bKIQ7kNvwES9hGH&_nc_oc=AdoyaW3uhtJitr3KGQviBRfNYKg6ldHpxjexIjJ0LooD3qoJpb9HBmGuTPDlQ8OTcGU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4O2GtlW9aNfZOy0PaEUmQ4E11dT1ymCxlB-i2_rCMspg&oe=6A09D624"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fuCR0tv3j0Q7kNvwFqSnb1&_nc_oc=AdrFF-QZqa4neNyLYUTx4khTiS1BBpwC43ndv9MtxzzxHAfO0AsJ-wUpdu9d_6ktbss&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70qUQvTUh_kQ-MBFPQF5-lZxtNONK8_sjmvoUAaQaKGA&oe=6A09C31E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tmal5QhbihoQ7kNvwHVZ_gf&_nc_oc=AdrPpfgsI6AQhFwsgnbAtH45XdtM0_XW98yuRbD28XVLnIvxQGPX6gjWZtFV-8Skp9A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41m5xMyqnHVPRwvAJjABP8AYn3M8_QeLowyIo
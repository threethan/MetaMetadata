=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT80D35Fml10Dgf3cusitVFR6SyQjbFzjKMO440mw0cGA&oe=6AECB79D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2mq5zwEVG4Q7kNvwEaHiGr&_nc_oc=AdoVM1aOMrjpp-Ity6jxQQYI6JQQQ9_Vhjh-V2IK5jfJPIcKlH-seFBvOYlUJiWemVA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc2Z-fdebhHSoyX5BFLET4SlIYW0ruUze-uMpVBlzjyQ&oe=6AEC9FDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ms4ZSZ6WRIQ7kNvwFttGwg&_nc_oc=AdpD1aavughlQo21Yplo0WIINRYXOYuqInBPpOmeBX19ZakZbgp7nGoY7YxuMwR_baM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbAAK7zIzHyVdddGr9MEcPZmVW6DVxiyUO-_6rXZquyg&oe=6AEC880B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDyrlqijjCcQ7kNvwEDqkKk&_nc_oc=AdpMJT8Gq31NJ986NZA6g84cGvsj965EdQo98QOwE2Cv301y9lu95y-PJ9R_fZKIJrE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWWcnW8qSYbgUGsySEg9TlsHLwRud9vVyMjjrOGb6DRg&oe=6AEC93A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GufnENamdGcQ7kNvwGov2c-&_nc_oc=AdoXqXzijd-1OGbJqauMxu8QvXzTJsMlqUAYbNMhSt3lgn0DQz8IweC3JQibgNKvEhA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw9krGkkBPid8QswaDy0wHKHdTfRS8sUQJhP_pQ8i3Og&oe=6AEC9824"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg-jLMIEFUgQ7kNvwHGF06v&_nc_oc=Adq13ffFAQmAsg-LI305-J99YW0bgo91bsDcyKEeeaDsYsr0FqIclm3Iov1GZ_kskHM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyt5GxaYoVUo_4SOZlWJr2GdDdPofXbLxM8gSY6kQSSA&oe=6AEC851E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IELIb0eu2wsQ7kNvwFlLcoF&_nc_oc=AdqRoGakCluFXVs0gVKYJJnbdKvxjUHx1jsicFLrXKSsj4vlQGkwUEypCxI0A4dxEu0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzq5iPx_v_ksk9on-32FQYAuvljB47n-KACTK
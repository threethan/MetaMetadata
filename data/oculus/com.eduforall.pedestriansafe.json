=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1A5a6jFIeXH3-CQa0nHYHqvTW-evKLDhExC1a9OVqeNQ&oe=69EA195D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KMHJFooNLUQ7kNvwEIXKG3&_nc_oc=Adqrc76pLXyBuqPOw1e71kozSCzN14CTAyr3-W1wit5W1IaIaauxDQNwM-eVdaIFdaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cYIz-rQNp7dljqOGs8m1C7CPrmQm4AvGDRjT5et-35g&oe=69EA39DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWRAa9lL1mUQ7kNvwGLfQNV&_nc_oc=AdqIInWASTbLmMukfWkm0b0ftOVceU5-wYqTn7LmD3tDlWV5gxFKp1AyFUqi3mTp1yo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SN9V_pWDkVPcKEduUx32quhpZ-VWB2jDNPJbKkvMAxA&oe=69EA220B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BYs3UrcC_UQ7kNvwGzgzhq&_nc_oc=AdpIYPf5SvQ1wvnjEfFW9barDD3PhQEjPyyQQkXryshaxRpP2KUi-3dhCTtWMb_mJ_E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0m2XqBm8ZqwznljGIbd_uR7ZNBstDbEPKrLrHbTlu5ag&oe=69EA2DA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZWEN3vPEzYQ7kNvwEKvpKA&_nc_oc=AdrlbVLh0EPB905yQQHZHshooOhgyYplN7KFbuCN2G6rZu_G70R68WP10z74GmkWimg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IaYzcIGYB9ZZ_JeYTnfSnt4SxHR3qOKXJUgpDQp2ZmA&oe=69EA3224"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIH5HkfT0_YQ7kNvwGDooNb&_nc_oc=Adpa6cerCLb3FrKNkKva7qyGEgOlJFsflqWRChWN36y1g49IJS4BoEK4F6tAAB79uRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pg9AcbqX1r56UVf74Xc7VLaHlHT9L8trTcclcEw4v7g&oe=69EA1F1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDtluVyKfdkQ7kNvwFeDEk3&_nc_oc=Adp1yfmAoUYSiK50GYQBttClZTC1lnD0U67xSMp2rcyoCiaMrQbphxSxsGmR13wbVN8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tkz4AT-Mk8MKsVLIneWJJBQysHIYcIgJnHtf
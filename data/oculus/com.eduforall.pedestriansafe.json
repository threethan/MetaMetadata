=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ0q-_1V_w_DDiPYY3eoZHYXl62MJk9rZY1O8X8Iry4w&oe=6AF1FD9D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drHG795AwpEQ7kNvwHWCmXt&_nc_oc=Adr-jOPQMUZxCas3ngXeWzuVwVTsOTvy5gOpxvHL_iEKYpLIkwFSjfZhW_Go8ZGIDcU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScd_bVj9OAPeHYDIYi_OTLBrZdcGhrc651ILe9-hXAAg&oe=6AF1E5DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBNY2IH8mjIQ7kNvwGntxQg&_nc_oc=AdpqZNGsS017QoETIed5_XK0-c33mFSg3groiFrzMpFKGfmF0VWNi8jUPi1PXkUhH7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR98jT2BeJfXSVDssQuPdwAd8uAzRc4V5PItr1iqeGEng&oe=6AF2064B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu-gs2XEjSsQ7kNvwF6OOgz&_nc_oc=AdojpSnirmQwpiVMA7UVQImfTsjD7oieGo47GsNkhRrmNCL9CipIdM8JSArcevo7uvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRBGO7-h4zjRnxUOprlJgauAXxP6vvzNLPLbB0lamF7Q&oe=6AF1D9A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2h0-1UBeGQQ7kNvwHzFhiK&_nc_oc=AdpJrayfii61E1mfMPcAxb8MMrq8rTf0haKSeKprCGc-nzsKERsrOxDDqD6FjyG_TEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZNgrEg5VM3zIDXygUKCitPQXZsMX4gDCRnSqAqflTXA&oe=6AF1DE24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHdYfHEntkIQ7kNvwGf6I0B&_nc_oc=AdrOicORVzJP1BukwZrDmA7_j1K2P47OAnkxoceTP6P55T7wolDWoAQs3NO5bciOu4Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU1L8Xq2V7sMdK9R7SwC74Dl7BdOUE6LlVOM4Ej91a6g&oe=6AF2035E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guyHRNIZwWIQ7kNvwHyw14r&_nc_oc=Adq-Vpvmoid6VYxRYaIqHLcQ7lP4nsQuIbmlSITLAJcUHM6HRwjNGTK0g3b5yi7HAe8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh3Q0UHSXrQP35qqzEuKogJcR4hue48GORXw-
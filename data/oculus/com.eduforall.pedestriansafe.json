04182117853799", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031599_1104182121187132_8308184151168799368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34hGJ5fWof8Q7kNvwG9su10&_nc_oc=AdqWO7dwb2mY26aid9AelrREGK-q0M9Jw8XCrZz2pAGi591fsV9B1LyJN4iaXb80Dp4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2C2d6Qqvz3xjhT81zm7ot-KPFGU1U9E9C-cAgd2arHdA&oe=69F2025D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOZ846yBXG0Q7kNvwErRlrx&_nc_oc=Adpo4i2hcagnN9aXPVTLMXyV9MCh-XIKq4BZ7mbkz91EXY4BVlAyfsPT7aTgIEfWz70&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af35yK173OXboCIShX2nzgWswtI2CZ41hUPPZ7Sp2zHyKA&oe=69F1EA9E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiVN309qPwwQ7kNvwEkmJ90&_nc_oc=AdqExoe2abwp80jKMUBekqCtlLQeGSZ9eL0G7Eth_Bk1PdaftvsSAUl4lD2AKGMwh9Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3KttofEcd6taGllP3sPZ1OZPIcoG3GCB66owCmE65Vgg&oe=69F20B0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ls2ynLq163kQ7kNvwG-R8Hy&_nc_oc=AdrqiM3P4EJOHHj65-bk5APV3q6mlSb0AFHY6oVHWVhW5fFxm-1GqlBle_TNpm5LeZQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Z3PyLfbJ5teH8ql7JlYOLvl7jk0YfFB9zVRixTWN_oQ&oe=69F216A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTyv9fYOaY0Q7kNvwFdiB2P&_nc_oc=Adr4kocjdya3J5Y4JQyBtUo_cgZrcAxIGesbrXwdo50FVXj4UL3KrMinxz8XG3mKfvc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0xHxpOY4paZf9UoDuyIsT_9vxp3068T9QKaoqwPdrbPw&oe=69F21B24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}]}, "developer_name": "Safe_vr", "developer_privacy_policy_url": "https://www.eduforall.co.kr/SafetyEducationpedestriansafety", "developer_terms_of_service_url": null, "publisher_name": "Eduforall", "support_website_url": null, "website_url": "https://www.eduforall.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "r
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-r_uKz8EnMuFtRUKcfc8JJJwnAbVJyGqjK3nGhE0Law&oe=6A7C6FDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAxZc1xj5QsQ7kNvwGXrar6&_nc_oc=AdomNt9thaI0O9GKli6L9LyPMb4Gf4e_g4izszXwxnEx8zGqxISJghdb0tNux_3PMGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtDDLILS1Oa15Te4TGEGofiQ2PIPV_5N0AZLLZ0Jdjvw&oe=6A7C581E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vZ69QlPWkEQ7kNvwEI1OF1&_nc_oc=Adq4A5I2Dy9oAthLLWOFlOHckJQyw3pPNc7Cx3SusrGRhKFtE362PegIqt87bqeS284&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnTQ9RdKJMvyVwtWRF49qqF9TeCL62vD9u8F-xBVR8ig&oe=6A7C788B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVmHanBLuaQQ7kNvwExB2Yg&_nc_oc=Adrzud9bjyNB637hNgZ-Zbc0BJRoX-5eDBLv0hxfBCJyNTi8lHQGDI98CYgK-bgu_8Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOIt9kaSWGNJ8oRcB1sfIWiHXzJ0FCk7Ff3DYLLgD4Nw&oe=6A7C4BE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyoiZaXCBIgQ7kNvwFzPYbh&_nc_oc=AdqL6I_PG1n8Z6U6D_ZYTdoz_mM31kehIwRsI_j7tP-X_ReYT2tSAikg5Ak5wBgXbvU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtEFeh1zyER7GGlkEkI31I6XZSHLn_pxxZ9cxpUX-SNQ&oe=6A7C5064"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9ymGTWM8ckQ7kNvwEveFZ3&_nc_oc=AdpZkb4BEbcP4c2S_p3zMtf1ae4UFZ5llpGizP_sNgY-aDQ4-rUm4YK_Me-RuWNIJlk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl9qkMQVRAaoDQ41IDr0mIPyhwsAd4NHfo6EbaUAbPoA&oe=6A7C759E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAzu30mndQAQ7kNvwErWul4&_nc_oc=Adp262jkGYAIluqi8JvXIxyQqZqBUI0R284VbnaOTduoXAFINedv35MDzIe65yk3PmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiDT-G2SsJzsL_o3pVIpbw8iMq-0hPlaydfn_
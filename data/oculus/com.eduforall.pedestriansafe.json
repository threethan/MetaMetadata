=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJneARqPv1qxt6DbbCLOuqgqxsiHQ32nyQeIB9jriRERA&oe=6AA54E5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKNxNSZRaEgQ7kNvwGdOL2o&_nc_oc=AdqVeMclyn_7u57Au8DKv_SfQnnOz76_Aig0JtgUOC9QGQerBLOXgiQmGt3KZGwZCtE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvGx1xzbrNPlxPy5yy13NVCLWHdhOUdFaJ5OiSwFWrAQ&oe=6AA56EDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hs3nnUB1HkgQ7kNvwEcj4rT&_nc_oc=Adqpt3_UPmS4dtx2-ndgad5LKLS1iy9VezpAXjspqDjWMpi124Kjqsr3VADrGlEoXVQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsQMXWoDXhUxIG7CuTcujUXBVWGX-eU5coeeyzLKH7JA&oe=6AA5570B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rg9KR0YWrJYQ7kNvwFHlj08&_nc_oc=Adrv-B03FTd5dI94zBgJLOLUlK0LL6OGluB5mcU4ZMwwjtuXFVdLFC8QQi0N8cPRlD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6rUnyg3Dp6JjmesspHVxzub4DrnTxlDednEZdYt0-Ng&oe=6AA562A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iMYBodjR3QQ7kNvwH9iiQE&_nc_oc=Ado3q1bDxCSe2D-vR43G8nJnDN0ljNKFkbY2q_X010uy-kEwHzWMmCCzFWc3uXHcaSc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJniAHgQ_oTme0CKmJ7zrYL11XUSYSBGyR0CX_t5-w5lQ&oe=6AA56724"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gp3fILMNVUQ7kNvwFN57nx&_nc_oc=Adp0zGZ4og6ZFmIQ9_1-ReQLiZsn8_rWj9uVW9Mnieb8xHN31EUHM4R_F9Ot6T8JjtY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKHnpZWZWeGFjFV2FopdKQdU451rmrDOQQvdsds6IBHA&oe=6AA5541E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IGhjapy3WoQ7kNvwE2T91y&_nc_oc=Adq7D7BhidS2nHMRReerTm6Vy93MFG6qjny1aPLDjxn2Rq2dMm_RiAIznxCzx0rf834&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI52frWM-X95WhirhEV7V9NA12xBGp_P9U2QhW
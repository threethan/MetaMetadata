=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXp0i_V_NSvRa3fN0u1sdDnMdoltabfpEob5byEDVP0g&oe=6A56345D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbJQp49iODcQ7kNvwFdzEw3&_nc_oc=AdqmK50lYmlLElxc6KgRFOgA1pDz3JfUPJXeyz9ImSQ1_mH_djQEUfWa_HjOoTwRuWU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0sMDnFLMClH3NUDvBVVILWWzjCC00EO4vJIlCF4TqUA&oe=6A5654DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVYvbncA0d0Q7kNvwEAbhu-&_nc_oc=Adr6BaiubWje3xWTO2WJVeyOsEzNqubMAoa_oPVNY9_4fygDksl9fPyWx3J6mAn8hB8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAn8RSBgugsLIs588-wHPrWS7uE6XOLOIA7b9TE7TQzmQ&oe=6A563D0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cGXrn9-3t0Q7kNvwEAqcRC&_nc_oc=Adr_bFh4C5Hx-VT3RPTcH_OKUDbogy7IcCK2tAZlRSK7sWunk8gr_MVJJSrw4U3n934&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnczv44-nvWjSI3aXvQiH7y_MXONN3EJFiWpwMKZLvtA&oe=6A5648A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTEcTV2WdVAQ7kNvwHgoc5J&_nc_oc=AdqqUreSY-V9sG9ZSURNiCYiLoTwYtdrCJ_3HBodbtRnZa-QygD8eh_nazs9BEcPHQE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC3jHMux7XaP2bA5gZO3eYC66cJVmRs68h6ytg6NjY9g&oe=6A564D24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPqnEHPQuGAQ7kNvwGySHTF&_nc_oc=AdqejpvZ0ZKLTqhtHX0MnO8QuMO-2il-DUoBzH4KEWIKnMPFLoNGjOWqRJ8Ro4i-mw0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPxiY6m6Mqu5z3qv1yEkJPXjXeHu6JxfS1-jwcLQ197Q&oe=6A563A1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTD8SXAJicEQ7kNvwHtIS5G&_nc_oc=AdqFO9Rs_IxQ4azziSX7lKf8V97oH-N1U2jQUhWu5e6OK-_UrV7k762XlYELigRWI9I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpjcRX2qqS7BBKtLiiBTqVQrPyb-EFf-E-UrH
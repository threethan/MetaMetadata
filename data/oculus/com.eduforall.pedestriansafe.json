=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HGvZzVIN8TKa0RzgfXJTC1mMYMpuwxC4mho2JO9hv_g&oe=6A1D83DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVgKNCQHrp4Q7kNvwH-2qUC&_nc_oc=AdopMI5bxUo_Wdgs9Gkl9Of9RMRzg_fS9VIjwzQckAKEI5YfQq19UjudWpYtQZCmwec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CGO830-votP37WGlI4Kvp210LOU0fEhR6p2u8HO704Q&oe=6A1DA45E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWRuXpZCUDYQ7kNvwFbPobZ&_nc_oc=AdrmrOG6hASfheBFeDdW9yRlFF6OryF8DekTRaH1egRoVy-8N3Azcd_qYAVjt32o7BM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xlBBaqc_KVZeJQ46jsnXGKQuz3cIGe0ZoJUr-Sx8lfw&oe=6A1D8C8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2Ds0cOOueAQ7kNvwGsE3gR&_nc_oc=AdoBb7k6F3ToU8KbbxAQBAoIfid7AqIp-DtAgJqU_TrHsRwcyRhLrP-E1U9jJa9gEOk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47v6uDcdqjJ8mCNcJuF07BVSD0aT8uTVeA7MEe4o4RRg&oe=6A1D9826"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHCGznYYDOwQ7kNvwFHNnOB&_nc_oc=Adokpqbnc7bi4XKinmmIMGCRh0bSNgp2Zn0bhBSwRM9hTR1-AxkV_UG9v81F2dB-WOE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WS-cgWsXf1V16AR-3gn4Yl4hZUQBAsz-0dHige8Nl2w&oe=6A1D9CA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKAxG6M-O9UQ7kNvwFY9ycY&_nc_oc=AdpYdBnrqrGbLH7zFhgcMe4WBm8b7_TjBwFwMdhqIkDGD7BocRygrlM-NcUFUnfRNyI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OenKTWjLDTPPeL_rBNV38JCk80DVpU8ZvnE-aSvRP8w&oe=6A1D899E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6lF9YWh1hIQ7kNvwF-uqWD&_nc_oc=AdrApzewGxLShR5CQ1sy3vmFO4IAahrSCXAaUBSc87NzWmAfTX0WUOm1oYG9vFViD4A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NYU0mMgraYLvbL7jkeFoqoaHgwGipLgzjzkL
m/v/t64.5771-25/75488379_9195068527253294_2668161467724780624_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vvLn6eUh7EQ7kNvwGkjRMQ&_nc_oc=Adln3q0ZWSvdxbi2_EVJb7El4GK1auaD0cEuhT66JsNk3JfpHStznr6UZVgLEd2y6M4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvU8RKjP9x_Jde-LQmkO5M9p6l4k0tShalD9bCFOFJ5Ag&oe=69A2F7A0"}, {"file_name": "4.png", "id": "985683270137264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035392_985683273470597_5682883843199344465_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j74uPBye3yYQ7kNvwFos7pI&_nc_oc=Adm7rxiglmjFbt4lxiCqVK2fxH6petHl5DBu584KCCDFq2u89v5pY_4eJGDWotUTqCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfthJrsrx-m_4Vsm9iz_hkE7Gzfgd30OThtAwwg7x0QkSA&oe=69A2D219"}, {"file_name": "5.png", "id": "1412420799735316", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974471_1412420803068649_7767631581415265926_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GB1Xdt13NU0Q7kNvwFzTWR1&_nc_oc=Adl4i1mRahDO97Zltx4wI5GNbq3rWoEETWtWORDPwFCiBM0ADSb4nmZcgvHSpl7okjQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsCgBmxqN0gB-XiH2Ca1WBTA_heaxQi_EQav9L5UKKSBQ&oe=69A2C7C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2484960861698447", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974521_2484960865031780_1569075632799989806_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4F1zQTPT6DoQ7kNvwHdQelh&_nc_oc=Adl_9EytNvP6e78-n6hhMozX1fX_T1V3a1yVrYIYS5mA4juGjoY2MkczDf16CI0r53I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afun7Psh_jHSOirt6lfieve7YpYjNdX1aX50vuhyORgT9g&oe=69A2D0F6"}, "display_name": "\uc548\uc804\uad50\uc721 : \ubcf4\ud589\uc790 \uc548\uc804", "keywords": ["\uc548\uc804\uad50\uc721", "\ubcf4\ud589\uc790\uc548\uc804", "\uc548\uc804\uccb4\ud5d8"], "long_description": "\u00b7 \uc0ac\uc6a9\uc790\ub294 \ub300\ud55c\ubbfc\uad6d \uc2a4\ucfe8\uc874\uc758 \ud2b9\uc9d5\uc744 \uccb4\ud5d8\ud560 \uc218 \uc788\uc73c\uba70, \uc2e0\ud638\ub4f1 \uac74\ub108\ub294 \ubc29\ubc95, \uc57c\uac04 \ubcf4\ud589\ubc95 \ub4f1\uc744 \ud559\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\u00b7 \uad50\ucc28\ub85c\uc5d0\uc11c \uc548\uc804\ud558\uac8c \uae38 \uac74\ub108\uae30\n > \uc2e0\ud638\ub4f1\uacfc \ubcf4\ud589 \uc2e0\ud638\ub97c \ud655\uc778\ud558\uace0, \ucc28\ub7c9\uc774 \uc644\uc804\ud788 \uba48\ucd98 \ud6c4\uc5d0 \uae38\uc744 \uac74\ub108\uc57c \ud569\ub2c8\ub2e4.\n VR\uc5d0\uc11c\ub294 \uc0ac\uc6a9\uc790\uac00 \uc62c\ubc14\ub978 \ubcf4\ud589 \uc2e0\ud638\ub97c \ud655\uc778\ud558\uace0 \ud589\ub3d9\ud558\ub294 \ubc29\ubc95\uc744 \uccb4\ud5d8\ud569\ub2c8\ub2e4.\n\n\u00b7 \ud6a1\ub2e8\ubcf4\ub3c4 \uc774\uc6a9 \ubc29\ubc95\n> \uc5b4\ub9b0\uc774 \ubcf4\ud589\uc790\ub294 \ud6a1\ub2e8\ubcf4\ub3c4\ub97c \uc774\uc6a9\ud560 \ub54c \uc190\uc744 \ub4e4\uace0 \ubcf4\ud589\ud574\uc57c \ud569\ub2c8\ub2e4.\nVR\uc5d0\uc11c \uc190\uc744 \ub4e4\uc5b4 \ucc28\uace0\uac00 \ub192\uc740 \ucc28\uc5d0\uc11c\uc758 \ub0b4 \ubaa8\uc2b5\uc744 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\u00b7 \ub3c4\ub85c \uc8fc\ubcc0\uc5d0\uc11c\uc758 \uc8fc\uc758\uc0ac\ud56d\n> \ub3c4\ub85c\uc640 \uac00\uae4c\uc6b4 \uacf3\uc5d0\uc11c\uc758 \uc704\ud5d8 \uc694\uc18c(\uace8\ubaa9\uae38 \ucc28\ub7c9, \uc8fc\uc815\ucc28 \ucc28\ub7c9, \uc790\uc804\uac70 \ub4f1)\ub97c \uc778\uc9c0\ud558\uace0 \ub300\ube44\ud558\ub294 \ubc29\ubc95\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.", "short_description": "\u00b7 \uc774 VR \ucf58\ud150\uce20\ub294 \ubcf4\ud589\uc790\uac00 \uc548\uc804\ud558\uac8c \ub3c4\ub85c\ub97c \uc774\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \uae30\ubcf8\uc801\uc778 \ubcf4\ud589 \uc548\uc804 \uc218\uce59\uacfc \uc704\uae30 \uc0c1\ud669 \ub300\ucc98\ubc95\uc744 \uad50\uc721\ud558\ub294 \ub370 \ubaa9\uc801\uc774 \uc788\uc2b5\ub2c8\ub2e4.\n\n\u00b7 \uc774 \ucf58\ud150\uce20\ub294 \ud55c\uad6d\uc5b4 \ub0b4\ub808\uc774\uc158\ub9cc\uc744 \uc9c0\uc6d0\ud558\uba70, \uc2e4\uc81c \uad50\ud1b5 \ud658\uacbd\uc744 \uac00\uc0c1\uc73c\ub85c \uccb4\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n"}, {"images": {"nodes": [{"file_name": "\ubbf8\ub2c8.png", "id": "2069319833533263", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/468725195_2069319836866596_8946935124449417766_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdMK9OPj-twQ7kNvwE_OGPD&_nc_oc=Adkkln-EQoUenicNxumhu3Mv3JV7VwTFHS_wCQGe3aaZz8i_dDtP-oduewNDHvjvUxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftuSa6KCUJXfH9WXKuBdngSbHjf4SuSQ2f7GuyDSaH0Qg&oe=69A2F26A"}, {"file_name": "2560.png", "id": "1958144254664663", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371508_1958144257997996_5402494376169652053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4loxvW_UlAQ7kNvwE9FoNZ&_nc_oc=AdnPXoBQGkJKgohWMVxSR2E2PrwPNbutLVytAMHxcNqpYjkVk0EKZdLs_Ab17GKF_KE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuQsf-LSUxsqTtbmvwGqUqGJy39IpyVLVOBWVQRK1xfRw&oe=69A2E672"}, {"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "1274294210494308", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1274294213827641_4508473815298717681_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCMHXI7R0msQ7kNvwFYiT3C&_nc_oc=AdkvrGWMU0wQyYo2Nqto6237CB2wxkQc9a_J-nRBiTT5b-OOJHMozx3KDbBcSo-uxbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsnST3bBkfWjcx1d8rMZqnqRGI6oFMDwyXaK-i7Kz0LmQ&oe=69A2C8BF"}, {"file_name": "[\ubcf4\ud589\uc790\uc548\uc804]\uc571-\uc544\uc774\ucf58.png", "id": "1260787378515383", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974471_1260787381848716_1546754576997205911_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ms0Pazh_fO4Q7kNvwFQmdkX&_nc_oc=AdleioPVPaSkDEXFk4aDcRBIeyC5_6AReGQcgaWezQwE7H2lWq8siEkxlEUrC-rNwjs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuSIlBceq8-aHvmiTSJTORLXUrbDJQp8kgOB4SGQ3KIpg&oe=69A2DBFC"}, {"file_name": "512.png
=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YEgLMXOuH2IAt4W0tXqkSfykZgWku-kmAnB6jM7yydA&oe=6A159ADD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9kiYjGt8uEQ7kNvwGmhEkl&_nc_oc=AdpTbgODd71FpY2c-oEqg0NufEeXq5HNxcN6M6LyLuRGcUFZXIclMn_GJZxq_-duNY0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-wP8yzvq9van0YxdZ0GZKe58L0gO0ZhcQeYZJ3I4HQg&oe=6A15BB5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASvhPbJt6a4Q7kNvwHxV9Y3&_nc_oc=AdpsYK8a2-9dHz6tQQZ3UKYql4-PcsskkGtCFUZGvjEXlEjJrgq2OC8Xw7mQX4QSN9E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6O_zQSi5PoTkOnh9gswr8mxVcF9AhwU8gDoj6rjJ0oRA&oe=6A15A38B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9UaG-Gb96oQ7kNvwF8Me5y&_nc_oc=Ado0B1TYfrH1l65JgNzfgZEFTbgmUkyb10ErUX-0K89OSsyfWpHW8-yJ1Z0jdgnN5RQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6H40tjZPSopuMbj094vWDrqKjF3JwzO0xpDMAEABfgzg&oe=6A15AF26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQdmdNFxF0UQ7kNvwEFxZI_&_nc_oc=AdqCPn5CbY9ywoYcrdS_B4hWHh7nYRXcNU29qWzFn8rWseJJpZV6531ky_zuA2VpDbA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qe80Dpt-EUs9W8KVrhpuipQNJ0UPxlELa92RM_SHqxQ&oe=6A15B3A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OpqWzxsSqAQ7kNvwHbhQwW&_nc_oc=Adosl91ymy-qDxD5YcBT6bAdm6Jbjd3Kj72ri2aHAccLhyCAlqZ1_oiHcaMPSGZa6R8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f3hTJ6_4jj-Vfu7U_VS1GUNc3K_qKqgateyIl_TpPdw&oe=6A15A09E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhMiQEOk-5UQ7kNvwEiEG5-&_nc_oc=AdoxLqfzxwfZDA66nrLdL9fbkqFgm0JiYnAv-3Jp6oGm0YOBKZsdXl5L7HniQCiG5jA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YW2bDY92UfSpVOGz2JPo0b0sOa8WgGhW-qME
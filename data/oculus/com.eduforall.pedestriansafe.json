m&oh=00_AftBZg7maNK9ilpEFKVg8zf5BDaIXfpGnBdlwgEUY8fD8w&oe=69A2D09E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b65rECM1emgQ7kNvwHKsu6S&_nc_oc=Adn9XXZOm3yY8E_Y504YGjJPAk01YKkk7eoTsa9FAXRnsewn3KL7uUIxYflO39vrjR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftrMocr_kB3HNI3RuN0Qx4IRKzWSJqjLPwjoumtmKzshQ&oe=69A2F10B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoD2b3aVjBgQ7kNvwFCUx-_&_nc_oc=Adl1SnwC0V3XLNOtOzd3iti6c4COvb2C4qXWAQ7OgTpbIVcneyuaNI0WskU6VOlWQCA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvgX6UcIPEUSTRRW-Q8TenPJg1XHC9W5-irLXzv68ASLw&oe=69A2FCA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AI2DsHqY2BYQ7kNvwHhagT-&_nc_oc=Adl-4LuRcqq-gh6NflvRXLajM7KDpaL94u2WlIPv6zn7ZXkoJCdrbA869VnQLZ_c69w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuxKwoGxzajax0pDUg2Nm0vafxQ-YMPvC6SSrs7HUFzMg&oe=69A2C8E4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4y-7uv0LzQQ7kNvwG_3Dxk&_nc_oc=AdkjvvIww2d4uS14K2ls97q56PgxQVT02JyWdARuZDJceRNIclnVn1AoF3uwpNERRWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvMcsX7YX38826yMYA9qfSihy3d1DQQfYXHv0sLHXQQtg&oe=69A2EE1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbWdHHyU-yMQ7kNvwEftviS&_nc_oc=Adl3at5fsasXLWvkhNPGL3xbEVPGcnJc5CEOAJoU1OQ2B73hZcwIOPkmXIlKUjmImBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfskzgK257eQ1SXdC7JRJyRe8t1hxqCUiZMuJME8gWfwHw&oe=69A2EC04"}, {"file_name": "[\ubcf4\ud589\uc790\uc548\uc804]\uc571-\uc544\uc774\ucf58.png", "id": "1843110519761474", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974788_1843110523094807_6196787795280771349_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBjCZz1lePcQ7kNvwGHnpLd&_nc_oc=Adm1P2l2rNG-gr1n1zKK-K8kfdyT644b7GWizCyXqi0PRtyMCrSiby1gfGQ3o332fj0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsWRpBuzAX8MU3Pgjs8U-ErogSgjhluoGTTQEQh982TCw&oe=69A2FB34"}, {"file_n
=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmM9zqAePyP4-0f_fyjAVO8id4hwrS5S1wMQJiF4vr8g&oe=6A6DEF5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dflOe5_R9EgQ7kNvwFqEaCN&_nc_oc=AdrmDYAzl1OxAeA3FmczDnO9UMocQiXuKcLDk_re4o3nsXZB3IDVrezIJkKVRTMu1vA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCykRrxJRoW_UIt0ZFauhknc_czjYsPf4eYsWei-jBEaw&oe=6A6DD79E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlOwoeJH7pkQ7kNvwFK8dAV&_nc_oc=AdogXpRB08OxvUGTwO1cu2EW1WLii3TOO08b_GlUpj8ahokfpJaDp4z8aPGPbI3TkI4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAavPNhPXACQVPsoIjCuLyc3DEtaFsQvZxM7rv1lffhLg&oe=6A6DF80B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3pGisubMyAQ7kNvwGJDdqT&_nc_oc=AdpRbIjgnCVU1LCZz9jZo2iW2VaEW1b2HrqWBHoEfdnugLrGLRh1ZuE-GW8OJ-Xke78&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAffW8gGdpZ8V3ybHh9ux_gasiyqaVA8tkNc6sAo9Uh_g&oe=6A6E03A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M78GTJThhbsQ7kNvwFdYoF9&_nc_oc=AdqAAjwkJ4h_LiQGMdVhVIgcTs9yrR_mgMFWVClpu-uxFWWfAhowmLZidjc5lAm35q4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3E-KK7akSapgjCmsbXBAivXrIBypozYLdtqcZEdiaSQ&oe=6A6DCFE4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNvIZggwkroQ7kNvwE3Xn5L&_nc_oc=AdoV68bNqw6SAJYlad924LlJLkHhk31jbJyxqsy0T2aRz0Yv2Eu4HnQVd4HRIo7oaqw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0a4HNNbgkErGi1S_xKikE6kivfIaeyb8CU85Wnf6CIA&oe=6A6DF51E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKdkQMR0ls4Q7kNvwE6bOqN&_nc_oc=Adpr1t9aqvGAsN5Rk1I4cRembVCm72o4TjDzYTkvo8M4JrwZIUvPxYvaUIztOnn-PRs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWqoW_o2gdrJa7y6fPaCz8vDYYgq2sX_ceIF2
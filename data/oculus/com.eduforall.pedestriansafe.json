=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eniNn0RACAhrPNZEVnq_J5sEgeZWggUBkZf3q67GgsQ&oe=69E381DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACyVvFFzkQsQ7kNvwE8i_G2&_nc_oc=AdpZBm60SGM_T2_-1iZXrmZfjbkpM0jogmOMOTwfi-iA6JOlXj3kZVwor_qk0Z3EzhA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FLu0dPowgLdZ87kSiRFuVa7v9QEe9uzK3bNexXcxlrA&oe=69E36A1E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNiophht1wEQ7kNvwEtB61O&_nc_oc=AdqASRTGn-gk4iGvU2pN3I19M5jYzRzu-aw1GoGJ9u4QQy1hSI-_dhNdNlZD2lzVd_k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jPOIxXoSNHzw2hXtpbC_-kDwNmL1VcSN8j9TAewYQKg&oe=69E38A8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uFj-de6hloQ7kNvwG-fkEn&_nc_oc=Adqwo95tKEtHwom7xtXxmopaX0Zv8Z5WTdUFbenJrmmKlTMbg2X2zQpqHeq5ZILT67g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19aLNSpnWfv5EKEfTprVeiSdPPCGmV5fz1LboYWobOvw&oe=69E39626"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9plZaLsglgQQ7kNvwErTZSS&_nc_oc=AdoXib5rGRF0ch4IaRDGlX5Dn9z5vglPRTs-TmoltEvU7zyOKIxQdjP2nPuBXw5qrgo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZM8inW7ejf-yrNUb1_u5_rB20mE3XQNeZ9Df0pSYjqQ&oe=69E39AA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnnixvwtEQgQ7kNvwGeXACu&_nc_oc=Adq0oDq5COIZOW696rst-4zsdbaklGCSjk9iFsFAqjfISl0d3wCq-6SUarmevb8D7YE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VsEIvH25fKpHZCZGZtDDce2Wuy522jvM0Ayytrg4b2Q&oe=69E3879E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cti0P006YIIQ7kNvwFMy5aZ&_nc_oc=AdoBTM4hKRMFsa2XWMpy-SeJXbjYVZ9m8FHqJzc2tgWAesH6GGYgxBhzPkI0azMG5S0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19adMOOBbE2U7uPERfg79CX-PgI8v-rQpBCns
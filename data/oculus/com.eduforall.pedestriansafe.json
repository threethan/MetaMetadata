=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mMNcnaT5KfsY_y1BgVQt3-X4sIICFoi8rY0BufkNADw&oe=69F9EB5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVkweA1drhAQ7kNvwHx9lnU&_nc_oc=Ado6U_LyBaDlSR6rQpHZ3MYHhSwydY17YdahUGrQN-rVME_iKVdtHhDsi9lIT2fgbwg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Jgw9IBvdbWcoMgw7svlyADTNODV4E8ltweKU13SCGMQ&oe=69FA0BDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvNHwxNBTqAQ7kNvwGGw-97&_nc_oc=AdpPFAij5H-JUFE2DScwbxvBsaelciYb5S48f0dBlxZ62VuuaPkCw3XrPdWRmv6OFJw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RpAJ7fC10ylPXlzRl79rmHxaZvaePw6HGdxe-r4nHvA&oe=69F9F40B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RufRHMum7QAQ7kNvwEvIdUT&_nc_oc=AdpLez-B1D1m-zySJQ6ixfDqi8n5PpNvcBnKDrypRLVFmwCAJtHrqUY336xihMtPrIk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KMWHopu3DcAamOGjDu0j-Kkev0sKPcK8ma-IXFJXVpg&oe=69F9FFA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NyWcPXnOmwQ7kNvwF0tIoR&_nc_oc=Adq5tzMLnKWNFebwW4B9fUgr5FHT9vlfYezqdiZIAnXUFB9nJyp2LIMbY9AE8RYCyPg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nUckfVkI-mkf9xZyEr6luBRF3uOxV1ue7NFhP8U8fkg&oe=69FA0424"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEg-ONjjt4gQ7kNvwG7HdS0&_nc_oc=Adp42j7gWTLxyk1zXRtzSVZo-AeKFX3ixDwuUmFeHtQBJ6c7dRahq82cvV156G0Sxgo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lPL_fFoFFaeJ8kNvzNIqVIu-IloHyPF08YqiD70ah3g&oe=69F9F11E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeRkC-WoNgIQ7kNvwHfK0cv&_nc_oc=AdoEVB0Q0OfcIJdOxrh13JzgFcvIr2vWikGhyc4y1ehh_ofnCbqkIai-YaqF5gOfNf4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P6TI2UErvVnbOWFxbLUe9YO5Z-DQIfCWx9T5
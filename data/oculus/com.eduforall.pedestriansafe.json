=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MMEYZNrxUo7MvQjGl8d0ImuXE7KiVxszJwjRrGS3A2w&oe=69D3AFDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQNm-3rk-1sQ7kNvwHW5NUg&_nc_oc=Adr_-NMk-gFRf6FwpQe6XzcFf7rohZc5oCrMHYKRGY9HEqCRB5e1k2Li4FhOQe8NaT4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2U6ZnrWgu9G5AlZQwp_YBDrbJC_a-TGnBYvDxUrcQaxQ&oe=69D3981E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYEw5d_0kiAQ7kNvwGhK_fG&_nc_oc=AdqQAGOmKE2h-WPjSrreUIP5OJ0RHGmippKorynWBBZOvZEpOnLQcSJ105jrVorh-JY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15Pbhnyw_G8gBxYlaGJgkcDwl6TLu7aTo9E7QGykHnTQ&oe=69D3B88B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fU3vcbLllEQQ7kNvwGttG2h&_nc_oc=AdriHmR1uBX9x_EP05hlg2nriYoBSz98YPCUsobrTFid7XwO7GgXjfhX0vPSjt_4_AY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cW3iQBO-AXLuKNNQW-tqA5TgY0xiHlW1R8CXcZrpOdg&oe=69D3C426"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUxUAxFz1JEQ7kNvwGIWK9u&_nc_oc=AdrHBW0c_ymPx6Z-Glm825eHme7yYKQQbVvKt_8BDKGe5xj2rAKsA0rNvp2_RYibez0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wT0ww-q1MXn9Q1WyBq5s9leWHLhHXaTuR73X-qaW-CQ&oe=69D3C8A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yjc_kPBiA8Q7kNvwElHamd&_nc_oc=AdrPikt0ZEj_q9l6k5GT5RqtJPAW9r_g_MlPwq4H2Ms9qRNbSnQh4fAUST2fSM9kJCA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VIYbV9ncav-12_Dk5pCooSVNekyJpXQQvIhQllJAfFQ&oe=69D3B59E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bn3bo7kGtjcQ7kNvwFpqE7-&_nc_oc=Ado8SxAEUxrKtJLGX9w0yYph-Z01Xm4jyobsOe7whhlr2BKskDaEwi7VWz0GdbZCqLg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CrOJyH7J49cNob3Yyz2uvoNipGbtJ-d9OhAw
=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Tgdw8-UYZKhXBCqQNKwLNvmtj1_AE9R1-i31rbQo7uQ&oe=6A0C605D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4z7h5OF6YMQ7kNvwHoMPZg&_nc_oc=AdqSSx2tdO2F_lE1UQxYnDX6ipJx-eMw-vUC6AOceJjYsG2bOxBS4CSoajOGOiCEu4c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I1R_bd6141qyfXEs_WRSAW366ZUH2zxBUF7VfBZOPlw&oe=6A0C80DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gt3c4Y8zAKAQ7kNvwE_IHCg&_nc_oc=Adqc8CZ37dl6Su1GZUhonFWILv5cRyJwVtC5KjaWK2MGsnkceOYz_1LmxzWp7cWHLAs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a8X39F7o95a8OfP-0tqU5IubzK_2G8WmB0To3GTUefg&oe=6A0C690B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkWgX9_TkY0Q7kNvwH3CVc1&_nc_oc=AdrgUTFv5mMShmjbKc0G91H-qrB1RQJNsB7B2_ipWSP9k-gBjGlOLmqqPMIhCr6DJU0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Dt8C0xJsNj_aMqHhZdLb3lFSb3AsU2YvWQl6OZQCvxA&oe=6A0C74A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqiTANyMDiMQ7kNvwEO1dIB&_nc_oc=AdoXMQ4IG40zqKEC2XVL02_1SG_4GMi0GA24vJqvrL6Bo4Im9de8BycQ8FI6iOKrQMw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iCAMz88j0Q8aURTRPp_At1L91moog46HqYbcKg9987A&oe=6A0C7924"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axnrd2YEp1EQ7kNvwENeIGa&_nc_oc=Adop7joE9uuqDLtha7cT_6ygDKOsf4ZySAJEPbZKKv9YZwtScSCgtM12daWjd5cwQ6k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4k-fM_jfcHmIMqTFf_BrIXKY-UqPhc0XjqxmMBVDHCfQ&oe=6A0C661E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuGNPn30GqUQ7kNvwG44IeZ&_nc_oc=Adp-3NzsgkDlatxJ6D0GBoKrLuHEEcVmFCTINElJmzeukECnMWQoMWQAo8qqNZs7OqY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kvJ_4sdiJ9qsvT_mU0edQAHfvtTRN0K7TraD
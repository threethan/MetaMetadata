m&oh=00_Aftmfo2ZF6JS4VWCPobP5N8B9QKmtMKUynVErWAg7FPmhA&oe=69A6C51E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuzcfR9-KYEQ7kNvwGdiz8x&_nc_oc=AdkwAYnCgopEJztcawrhR1Tujhia39w8jIn_T6j0BJLF9hJK6I1d8DjzlnhFUKy3n9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs-y9ha_AxplhIVMjlcIbePfd6caH9lY0QWDvxKW5o08w&oe=69A6E58B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zGb22p-I-4Q7kNvwG4UpmC&_nc_oc=AdmBcdwV64fM_E1bcLpcz0qrYMjnK5NqT2NW_fPTKjGJew1aVCiF7JXa9nO75sOkdAw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuNMCNeR8mV9IYKkbOihT5BOH37_e43BNfOyvbDxa4b4w&oe=69A6F126"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ts4_1gUk8ZgQ7kNvwFw-SK3&_nc_oc=AdkDJQaGtuxFSASGTKe_M0FnFZkPxr5EfBR9usePeVfDmlzkwH5Tc8VyjAj0gly6wlE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuyOMqhcAUsjzEkpZ6W6EWlZPiyuTlu70zJ5pDiOEUlnw&oe=69A6BD64"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxYI6uU9aNkQ7kNvwGN4tot&_nc_oc=AdkRYJ3L2RPTYoqFKS5PKUzw9MEbCIclysYydqgf2-jRTewV5tBmoA_49ljC0tddF6g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsq_G4pdoGp4cbkNtYl0x9HE_Lhw8UK9adLRFARITtuGA&oe=69A6E29E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKzz6nb4XzwQ7kNvwGIdbYB&_nc_oc=Adn1VknqzWuu9nTWD9R3F1D0BgVJ9CzCwtuyDVINf1GPRXNRLDIgmAqOepPSo5JKBFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs4LAEcdEbcvvovrjgs5BCQAXVz7SBHpJoqXM3dfwsSnA&oe=69A6E084"}, {"file_name": "[\ubcf4\ud589\uc790\uc548\uc804]\uc571-\uc544\uc774\ucf58.png", "id": "1843110519761474", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974788_1843110523094807_6196787795280771349_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqhHBuVSGeQQ7kNvwESKd-k&_nc_oc=Adn8xvwfuI55d1t8JX5UpCXmMvkGejn_DqlToO8Nc8uprqGLVqpFySWgccVnRmTG9f8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuze1EY22ZuiA6WlRdvWuTT6zQBdzvy0_bvoW73cE4tAw&oe=69A6EFB4"}, {"file_n
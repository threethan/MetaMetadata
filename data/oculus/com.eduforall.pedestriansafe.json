=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLd2Hco9_ejcIUoC_ovr9BYQqpKv0m00al4bYL0pGqkxA&oe=6AB7C35D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Euq_IcZuGMQQ7kNvwGqrkw4&_nc_oc=Adqr_wi5ZyJnE76vCf-I0cH7Gp4-eJZtMkvAXu_gkh3K3WDKAo2-0JDMEFnHDrV2_tU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU0T2FX4_pEvibfK6eQ8HqAAw5UbDVZNhVgz2X2pmtUw&oe=6AB7E3DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvd5iamh0LUQ7kNvwE_hZn1&_nc_oc=AdoAfkvr4jfm42Byj7NY99KaEvpKr1XyxN9BelUlIYHHbRpx-vNCsY3V52GwK1hnx4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeGiwaw9w3kT4yCZ6hgeuzP9ZJtxBi0RMMpurstG0Smg&oe=6AB7CC0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93f2rugDFBEQ7kNvwG1F55F&_nc_oc=AdqmM4NVWt_tPAuA85E3TBbj8lY02HoezBjNSXluVNvD8NbEkY_y0K77KuCBcUx0yZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnSEy04Z0_NNzEO5YV7Ns_fpWoEtgjsVi6wk3qNaFxyg&oe=6AB7D7A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpzxRj4_kr4Q7kNvwH4fq8K&_nc_oc=AdrxC8zPpMAkiEIeObOtrBDs11E2pg4BRr94ZJqqN_FDANrYZedmhNKrNQYKFCJMEB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa5WRW_ycUkkGx4cE8m_IqL8HkZ48K3-p29BlK6xJ5AQ&oe=6AB7DC24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huKBnwxxHigQ7kNvwHg0kYk&_nc_oc=AdrR4aYNsw8QnWz82JY_1l1Zvz-qlnAHxAYmxBl7AHivNAMpAUpKDQfe4l5YJBLuuMs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCe4hZGZKZNVlbTZ_UyPOcSBxaZCPq9pioBDi5loRBZw&oe=6AB7C91E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYMnDZFeM2kQ7kNvwEMQYJz&_nc_oc=AdrSlEjw1O4WJ8iOGhaJzsdEN1mtWzHIIkrzqvNuTLrw_4YkwBZFeo1FTx5Ro7s0fzE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPRtoY7XQiKYTd5oGHFdxIix97u-q9XC6Ik1o
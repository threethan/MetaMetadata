=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EMB5VPbDXNBKrzJBHqGrkPmgJEdCmx-gNxZFZrepd1Q&oe=6A3EB19D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjIE8_TC2X8Q7kNvwE463Ef&_nc_oc=AdqWN0HaifiV1Dh8qrOn0gv-M5xsLyJSn7otqS4Wdg_YFRLfdhc-lCkssi_jtg9MRgI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hjddKViK1hOHupm0Duxz2rBXWMLt53srB7ofHC6OwMQ&oe=6A3E99DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaqOWXpkqpYQ7kNvwHUR9LO&_nc_oc=Adqk5Byd8t3c67u1_jqvXOD5FF_Mg5P7zJ651NffxBf746yw2xWSv7b3UOgVDOfuJKM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jA6smYJATmvk0iTCfynhUnQW7VNdaGZB6WlEtlvWvmw&oe=6A3E820B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROxTB583DFwQ7kNvwEIkYfb&_nc_oc=Adros3Db2xBhWUTBc1RD45AKTn0nL-RLvqvYcrIhbJofndK3cxpdeG2TlflrJgwQlfg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mVrCVAYyLnqhWz_EtY6LAoSBtDe780QKYLRjzvUYJ3g&oe=6A3E8DA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbrU7tR2ciQQ7kNvwEAmahX&_nc_oc=AdosphuiPAXloZ9nMjwE45WU_jXdaEDZyyDleZM0l6Id4_z9qOkr4pfy_x5Ctn7LgxY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Uwe-07jj4oZdaUTv1ixhGXZtIBED98zpbYJlsj41HtQ&oe=6A3E9224"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbn2UoZL8vQQ7kNvwEW4Xx0&_nc_oc=Adp--XNuOBUIbq5KeP4tNLGpDLeKupeDQb3AJ2aPBTUbqqZ0cyT656doYOr0nK1xxu8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5HpSdvlqBQON5N-A9tCKut-V4hvUp1dR8AsQ8qqf7bg&oe=6A3E7F1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ny5yQ0z3ASEQ7kNvwGsCmoF&_nc_oc=AdrSvzADcjqyRhtSAxqvYFQ1PXHcauzD6mFNbYdEFWXu46cLf9XhO-rtay-8Y7SiNCQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pA6wFA9uD1sgIg468GAYO5gp3PGczl0ava33
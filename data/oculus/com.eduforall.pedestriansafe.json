=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5x9cxwNrHeSkfZo9ayTfhDQ4Mt2ato10tTK-eTq7025w&oe=6A071A5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fADDDR-jPKYQ7kNvwFQ_gJ7&_nc_oc=AdpZi8A-cMGWRD4B-dZWK7r1ZqNOJDPnwoN-ooDbvOoUoAjklay_Xyom889-FFWcpHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EMyemRqal7o6Qn__tQVZPZM5vDAY6BFWpdgr3DxWJRw&oe=6A073ADE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xnthWPTSkAQ7kNvwFvzPqH&_nc_oc=AdqqkIrEpFl5pc4tmZQs1tVtcOGX_NJq40lzLr0j-rrL5_2Cki8C6zII9qo9DnalJg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jfEfokrSqF1hOl6Jf3itBJ0zOvs3YjJVG_sGqFanWBg&oe=6A07230B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPWlV5W631IQ7kNvwGuXIv9&_nc_oc=Adqa3DKZL8pMUhGxAph_woDcx1rg1DO1s4dms7oHGW9SWcSsvFR2yZuF01iadmpv-Z8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_QaOmxkagQ0EEwaxAtW7xGpmFvZuBtUBUSL6nXrXn_w&oe=6A072EA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaO5y8T6bKIQ7kNvwFa0O3L&_nc_oc=AdrMY17Ndlt6InrJSqR7rifIAz0iZdESeWmKy-4Zd7vLv0wiE6toUsLQom-LqETWoWI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LmDgFU3wylYmq1tRc3hrcwAuKYlziYmHW7GpbX2CZRQ&oe=6A073324"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fuCR0tv3j0Q7kNvwF8Dn7-&_nc_oc=Adp-saoXOie0oqKl0xAeOmUFbgGliW8lsW10_aAoM214wtX9QdGyKNw9uqhxX1SDnDc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67avnuob1v-rr7xkFm6R-Nl8kxBP9C-m5OJ_N2Dbxzyw&oe=6A07201E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVw3Aj3Eo6AQ7kNvwFB4AZl&_nc_oc=Adr3NSRVVYFWIkQcae1v_KwMmpFj3eAUASbzIEVEqZhY5nnKAz3dS0xFMvW07k-uQjg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77cKS1n_Vg1ZPHbdXDlSUxGAwcJ3E7Z_5HVdx
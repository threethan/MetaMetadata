=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-mbhLMDBZi6AIddEqnmUaCj7tTgI2BKmkwje1CBDKUA&oe=6AF34F1D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drHG795AwpEQ7kNvwFHCyf1&_nc_oc=AdpNycA1Dmyfa264AKHmrPUheQpkLRkeF9LMJ1kYrmRdlZ-jxh3ss2QGJe6Wi72d4hg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQip15XzG-G4cDknlyHFcqnKoAoxkdsiFQf3GjhE-q1Zg&oe=6AF3375E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBNY2IH8mjIQ7kNvwFo_uxT&_nc_oc=Adq7iJJpA4AwwIfe_LiDF0u_TIGB5XupOFcrsF7MTctKfHSjIuSF3ifgVoBZfRYnwmI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXUJCm0NDSp7SMtxA0OylinoSUefApclZ-ZlvjasW1uA&oe=6AF357CB"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgTXTlbFnKIQ7kNvwE3QErA&_nc_oc=AdqJc3a9zO5HP2J8X3Dnu_-DA_WJiiL121kz1Y-93AalBE_A0Wore7-ZNhBSrgjyKMQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpIEuNKWqU7hRQK7vOZ0_3UX8TLJ82aEAqbavI_sJ-2g&oe=6AF32B26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2h0-1UBeGQQ7kNvwFlk4Xg&_nc_oc=AdrGOzvS-HAxodlCN71ZLjHe63sei6IYa25doLSItJ9H9Tq9y4RiAs8bXx_8vEXxsBo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIw8PY3DUJdjSWvz3BoGCn-F2t-751l2CS6_w044vj0A&oe=6AF32FA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHdYfHEntkIQ7kNvwFk4XQV&_nc_oc=AdpuR7USpkGhGOrleKsgzBJl4EG2MrdlrKcHQnB9lStAE4umFQbBDWuWv8hhGY-BQ5g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT08U-S6QO-4HR8LymZgFtobygX1ifG_dbByT2Kr2M5OQ&oe=6AF354DE"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guyHRNIZwWIQ7kNvwEtbUDT&_nc_oc=Adru935rfur5s1yEbxD5yWTMvS6op3tDPgW7OJCJJPWVv9_J04jNbhc6P2eWyzieIns&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlslDY4U-zDFpVsJ43dkb-gnL2HCMhIuDu_1w
=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDC-tKv4cU8cjr6Z7a1OM860LMLb5-zko-eHQ6pw1kTA&oe=6AB3CEDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=at2si43P1EkQ7kNvwGrQqi5&_nc_oc=AdpirciQffHaoePx3BAyYi0_tez0uihCTuviI0OU-sS3oBqi70e3tMhkzFtr0-bBGWk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgSGsyvLvU5fS0Ncb9BixHGrB_4kl-zSeyWvl29Vh3DA&oe=6AB3EF5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1G6-e_fa36oQ7kNvwHVmb1r&_nc_oc=AdqZ8FmZKzYGSJZdgKbuX6I9eUzajeZNxQ-z_WMoqKUPOfx6tlapF_3MAbyG3de78Vw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItclUFXS9wMNNtaQSXJF1utul3uGY83X3-Dp8ma5eovQ&oe=6AB3D78B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m00yRae_nG4Q7kNvwGp3-1X&_nc_oc=AdryaQVWtnX_BOH8r4Ely_Z1-mvuX5N4cdk8yuLzdB9lvXth_kSZxayxIGjnvdqEgMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8KaWQmdk3XFzTMGU8BGCS9_cGtf1opFAeUfO3bEGvuQ&oe=6AB3E326"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdTyybwCmdEQ7kNvwEMRD3R&_nc_oc=Adpt_NkneiGH50AIWzz1kb2XgKA8PXPhDk1vykKZS5CccXtdqqFDGwB1iDQK7suKgHY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKjqAOgQhvkRIjmoXphjrfGeJ-fuNXl79IF9IdrY8udA&oe=6AB3E7A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWGVsT3Cn-kQ7kNvwFUQECR&_nc_oc=AdpctAUlXETgkvYa609GN7n9BKpt0q6wWAOzYiHrR1ZauAk-rnp3uxhHi81yb4nMhgQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtzMWjV75jPE9rZ44DkbOMdkmPbd87O1dlg_m__iKl5g&oe=6AB3D49E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OVvbwDH09gQ7kNvwHzIvo-&_nc_oc=AdofWt7AlR2XbKgUJtvy_B5bS0UqmycmcGeuWg34wwANx1BOlFc3UfwjUSsGWj0GKfA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ6BCWlCEqc-R31FcF3GLVAPBXsWL2Uj0nLws
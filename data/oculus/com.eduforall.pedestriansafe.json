=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdrN8LfqiSzAmbJEF42ZnYjXFFu7IBycxEtEvIZW5r1w&oe=6AE0A1DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKJreDJqvxwQ7kNvwEOfIRq&_nc_oc=AdrC-6TPeLB7X_vlwBwuwDFxEMA8heI7swWNBeuukgkeD1PLnj1pRwPbnBliMe46vQw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODY6gEjY14KHDvL7hMdZ9qyMQ-t3z2McOdSEU27gvOBw&oe=6AE0C25E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bP2BMmqnVO4Q7kNvwFuuO48&_nc_oc=Adq1KxA1krmOH-l2sykIFlvraSb0fzVhoLGmnrvr0boStlnJXYeOQ-nhB0XXUlpM7ts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-mNhcUuCwCtoXiE7t417cS9qzoqPcBtPFFILre3NLZA&oe=6AE0AA8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxVpXXKPz8IQ7kNvwFPO4zN&_nc_oc=AdofEyk3JeMjrCL2dI6mzgTHgrp75s_GvwUNnId3OBeqej6hOrrDdDz99_GYtkwgxTA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRJ2dvozwxuDpdS2nfUs5Onnf3t92XSXtAmG-Ccu-uhQ&oe=6AE0B626"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oX2me-8vlrUQ7kNvwHQ7apa&_nc_oc=AdppszwwDUAGEIZIQQseOWMyWXjTa4HviVDQ54ODUS9cntCNL4eSWHPoMHzG-A8eEFk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI5tYIR_cuJ_xZeYcYpqwc9gQSD-83cbnUzB1xlzEz9A&oe=6AE0BAA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FMwq1COvjoQ7kNvwE_kHXE&_nc_oc=AdpC2as4oIU6due6G1vRNJ1K7Na63BMDqbQPHTh56B7L8GB6LWrB_JcHwjy-bYWEwW8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFNkXyNc8oxMkG4UmKQr21GnN8NuZS36BbOrFdn4r96g&oe=6AE0A79E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NONfnUNk1pMQ7kNvwHSF96E&_nc_oc=AdqjNs6CEvirDogi1OkNt9qkCi00oFtQ442gMqxonVw2g77JcL5IDEInH43ZIR__nlQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1OBPM0o4B1MfbwAkMvyOqSf5JTzyxz3WF31D
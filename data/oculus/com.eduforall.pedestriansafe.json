=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTffS1Up-uerQ-smQOg4ly9SMDniDxAHpwgR7KvamV_8g&oe=6AEF5A9D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2mq5zwEVG4Q7kNvwGx7Oul&_nc_oc=AdpTgvt1-rB1RmJPpXKqQCeR-9Vy4I0WYVaqiAtkyJJCg4MfQmc0ZSm7HJ7Z1BJbosE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBRFW1WJZpTys6WEq0GXjZtwUlw7Wa6j_Rf-oChKxRxA&oe=6AEF42DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ms4ZSZ6WRIQ7kNvwHvFZm9&_nc_oc=AdrLEz_CawK3q5tmfmReUoLM6VFqRocX2APfPX6c8krUAP_w-Fhfm0D73I0XuYraaqc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl802ZhNM6MDXtQN6pq1KtytrgSrJaRGg8obMUt-zz0w&oe=6AEF634B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu-gs2XEjSsQ7kNvwFtOHUI&_nc_oc=AdpRF2jhacad_hpW6JVyo2pQlhklYLK9uZLu3RianH07m16_3XxZ1qcQTxK5Yf-SV9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_pOcvdQDkpLf24DlYuNfWVnqPrnrbV4fkRjwxirltcw&oe=6AEF36A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GufnENamdGcQ7kNvwETpco-&_nc_oc=AdrG6g3C8y4UM9MrFwW7VZxDk5CSW-JLe7sBoiDcKszyR6JQAwMqFPnhw_DjmhGFOeM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaRAtTiCOZWMlJRKXBX9sjJI0wvDZmSwtkwhu_E3Dmkw&oe=6AEF3B24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg-jLMIEFUgQ7kNvwHy0am6&_nc_oc=AdpVlESzYcBK3X60Q8UGKbENY6uDmryTd17b_l5zKaP__xFR4j1wwC1pgAAR2JmrrcM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF4gkDc71HeKyAFrHJLhnZwvXoI_Mu-enYQX1wol5lAQ&oe=6AEF605E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1TjS4vuJVkQ7kNvwED3hq1&_nc_oc=AdoOaWK92fREEN1IEe9ni5L3GPfdACEhM9SvaRbELeF01z1i2H6wLFCZOg8wXqbo_q8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwaPbKG-7G01i04FhNQREbk0EMY7hITxfYK0q
=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOnKwwM_trF_GCu8xwFHV-zgZIPZbTxxZDuHEufawDiQ&oe=6A9970DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voxm-DOX3IYQ7kNvwFDqHRD&_nc_oc=AdrrLo9NCl_Rf6smdp-7uUEf3AyxvSOmomcANWXEOrmYMUHZIHwJqyJOwUzDWjCNE_w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL32ay5g_qPU3tgMslRroMklFpeUJz7iCB7RR7lcTC6Nw&oe=6A99915E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eV3LckADXXkQ7kNvwFYoMvu&_nc_oc=Adq05ntHOqm1lfAU5DUw38EXHmboTg4fe0Qw7vpsJ_TG6-ep4_TxhgWrKKCrzEAwLVo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfWbTLwTnMyTFYZEz5q81w6A_88ANHOV834qNSXAMGsw&oe=6A99798B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSD9tkx7hNEQ7kNvwGXWgzY&_nc_oc=AdrF6_01kMj-t8R5X-Ft3lEYS2WS3602us1I_BMxcn1FB4d2f8LDWS4IEFgMSBh6aSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL_TxPZG-kfYtr6RJWNv92agMtRvp4cjvCA7Lf_XRLQA&oe=6A998526"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSaU3I9CyPYQ7kNvwEAMK18&_nc_oc=AdpvpUyWxHq0Gm_0GAJDz0kfj6bOxUZpITM4zOEQGLedj_amRU8Svz5YMZIC56xxd8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN2-8kKCrj7XvIXB5tBJxBGecX7O5bilgy5qqKwrbaYg&oe=6A9989A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJED8Abaa04Q7kNvwEd-V11&_nc_oc=AdpBA2DGg3zzTFXZuaozOz9uhjdSqspKOy9b27vZFkXgoZt9uOo6ZFL-PdZhbxX37as&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvmFRkJGR-cLdRqsMqCR_utYCJl3QOfAv4rmpuxWHsPQ&oe=6A99769E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2iZFCfAbhkQ7kNvwF27Umu&_nc_oc=AdoTN-P12J-qLTTQt8RH2ZX3qxtANFKUExxN1trFEyy08aI82ufhH_lyAFZnJ8aPyGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMy47vI5AaZeHfiSVXOQkH09fZWzav5OAplbz
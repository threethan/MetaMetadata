=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zyojQM3QcgBqVdbnQDu7VBzrskFsDvQV7PLlLtKsWxQ&oe=6A4510DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yk2Ltyhb85UQ7kNvwGw21vK&_nc_oc=AdrjkqFjrcpDPHb9sMXTQ0B9VlfXwbLQLAgzPhSSseOiD-_jqM0G453zZQcLBxfLtn8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af957yK2wLzDO_G9cUhO46agG4AVE3ZtdVF0R2U10IWJoQ&oe=6A45315E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A55dZoSQnkcQ7kNvwEpQFKl&_nc_oc=AdpU9QMJVFvbz6wuYxF-SM9i8rmpLxzJLsq9yBsAl3BFlgpmbERATYNWUnsqkm8ZsxY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nem43Jg0cyO_g9DJw_CPiTuHahmFs1N02QfGENhe51w&oe=6A45198B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiSt3ertANkQ7kNvwH3n2zU&_nc_oc=AdoTC_kXTD3W1hEDz-y8yQm_To8M22-XWHCinxtGt3rIMdMTmab_fFNT8Xl306fRxxM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dnOQEy9KzBRdERaSPokbEeH-QK22xsFZSLgJvWar4fQ&oe=6A452526"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7JWKc_cR2IQ7kNvwFmwdwI&_nc_oc=Adp7gUKXMhkHRmRbolNzZCmSt2lYDQP7QN7HRV4qUCpSkmPKRJFC6CH8OhkSaTGtrqs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B0sITCBVPFQgVupqf44OjHqBCJd1EY8Jju0RzFQ_-Gg&oe=6A4529A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSKdw99Os94Q7kNvwHPYab3&_nc_oc=Adq7lJ-sdA81BtvIG_z6t8b75zYQZ-BYhjceIS4axddOCU6zYcbNP2qhWK7BpzHLE70&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7qBlWsfzb5RENv7DV-9Cj5JdoG5vqxYE_wb0YQPvF2g&oe=6A45169E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vMbBI_xoa0Q7kNvwHr7dSF&_nc_oc=AdqGJ4IB6IEBSiOOHzqDKLdY_lRKUiljp1PzXzNariezprQlbR7Z8nWZaKx3dGwv7g8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dzI_AwaBNWrOI0GJRmMqMSsUvG6ULW1jP8fu
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_CZEgf_oogVVRbAda-P2xK8WtXY26WkzoGC-PfYAPKA&oe=6AA2AB5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYE_-zICU8gQ7kNvwF7by9J&_nc_oc=Adp9SoiGQIkZTZdhVR7I4fSgCT14EQZ3P5UbMwvVrh3PEU1YEs4dMy2vulLHgueT7MA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWXTKuTA-2YjyUUQ9cCPwBJclVdDTfuFob2GUnrG7HaA&oe=6AA2CBDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIy_cAp6pcQQ7kNvwG8Ys_l&_nc_oc=AdpcDqUSNNpAthrxMSxuw0U1U61NUyLVZf4HRT_EPTLLYXNTBvWjiP6hgSgvKVXgVKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwagkca_QEE3msByK02PcxJ36ys8Ft8ooL7VmlQ-0Dtg&oe=6AA2B40B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVveOM_Y3ycQ7kNvwGEKbAZ&_nc_oc=AdqP5At5RKgSyi6Z7Pxi6_UstY4Sv1NowFcDHXRmDj-R2lFl8frAVrtku44YB29pkU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtjsy_ZDg6Z1E-3fxzsqrpyEhnnnhtyeeEKX7UygIlNw&oe=6AA2BFA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrNUDflWtkoQ7kNvwFMR75s&_nc_oc=AdoZ7Vh0lsoiyMC7tP3xY4X8Nmf4z8cSx8W4Ljg4IRDAGf2Q3uPtwVL2APYUlA5QRy4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2v_Gv_zppHUQvzvFrHTqEEqeFT4I_TRIRj_RhNaZbgA&oe=6AA2C424"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwer3U5IKjUQ7kNvwE16BOF&_nc_oc=AdqOoyNkCKnuV6qAdyicp-_GLvUEjyaQ2GIO0328hQwpzPvZJlQX7XDvShLnMx-6qls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAVqgVTB-uZbAjJyfih2M4mdEJ3L_UJfWwrQvdRaLa3w&oe=6AA2B11E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IGhjapy3WoQ7kNvwG8aqmV&_nc_oc=AdpgrzrGKAsoGvVepdc_FSEdY_mGmYLpYXFcu_ZlS5a0eSiH8PBJEyLb5cu8OqL6FhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKekX7_ZnB1CzQa5s3L4avUEFh4kqanJ2nFLhS
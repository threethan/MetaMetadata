=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4TXUfLZd-_FnN72iaAC_Ew2qOY9BGL6ANqHN4lHeENg&oe=6AE7719D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDn1ywF1wlUQ7kNvwEVTRbE&_nc_oc=AdrV1EQ2r8x_xyzd0aspORoPikyXxLgywBT-D5oPOpLfK3VYipMdm9orfwvYy5bq-Sc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe4mcSvCkMVaMJji0Dn4lwkyxLv8qjh3031XnTLWBdHQ&oe=6AE759DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsFss_FVh8IQ7kNvwHPNTw_&_nc_oc=Adp0MkmuYHLmDcPpdrebp9TaHWoZbDKcDiLvjpMevK43GhwwGxWIr24H7dt4ax_OD1A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaFI74JnvIkia1eF9Gz0l2u7xsnET9OVxBg9wr7Ja3bg&oe=6AE7420B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m60MI22WcfoQ7kNvwENnWB4&_nc_oc=Adqu582mqMY1PvFSoXrmLiwgaVbkqXSeABNv-MFbq8gh7S9jGRa7UqHiHCZ-Fnf4Ayg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ33nDHWJ1tsAJsL_OI6SoOHhDyPF3cwL4lLJWXE1YXKA&oe=6AE74DA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GchW2wY77K0Q7kNvwERVjxb&_nc_oc=AdqACE5RlebtYw6kWWndZqCfQMPSWCRIEmMtYu5jVSMe1X_efwlN9YbOGSMsWDQKRaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqgAe1ASzJUZNmlp-wwxerj4e9_4NMUSUL9_fqpgjcHw&oe=6AE75224"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYJT9gXkCvsQ7kNvwEobZPM&_nc_oc=Adr0W23VKT9MjgIyP7pHxuek4B4bYdC14Qb4R51nWj1d0MxidDWt7kdRUdiBV5K98RI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHb0UURivNk0Cq55V2fGeuNjQWI0dcpUI3IdfMO_W-OA&oe=6AE73F1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ly8JjDyBSzIQ7kNvwGlt_84&_nc_oc=AdrrYRn9W5u3G7ZTvTZ0no9r3Tid1nx7m9fS5YguwUfYOAjbWZU2sALhIicNx_fiv8k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYPl1J2nzLclhV_iY_LIDeVsfSeUM9Uz3dY5W
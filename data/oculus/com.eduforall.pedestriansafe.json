=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Eckkrs68P8ME9b2q7s9L-u8Aj4ho4jDBwwX2LBPorSg&oe=6A33ED5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGzGZIlfZVMQ7kNvwHpcd4x&_nc_oc=AdrcFMolTgJLd5reALd3yV9bS_X8r3YWzsm_fPYehsRBGKwtmso9yH99catHQWqvEVw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gMgQF_z8d7YC_FJDMGUfR9flM6UWgZ4phJ1_QEaUR3w&oe=6A340DDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JszVw31F888Q7kNvwGwW6ig&_nc_oc=Adp04hTpDTEciRLdR5F3TaZA92gbQYiUTSMqOQZq8A7IUSjFANfJngy_SmhDUCB_zyM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aWgaAkahQRBwdWFZcNsf4bkqkbRV9euqm7Ob03u1uwg&oe=6A33F60B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOfmG-Y0hxcQ7kNvwHXUfWG&_nc_oc=Adq7NuS3DS3FlsnQF0CcIDtm5FyD0p2UeE3fVmZmM72t7YJxCZhA2-F_xErLUU1LhNQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81DWvIud6X74J0KRuyPfHeNqfSv1bGHniBnM9Sd8n0lQ&oe=6A3401A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0zlSMSYEjwQ7kNvwE9UfmA&_nc_oc=Adpgy372WufPl1Ti912Izudb7jGv6LjjdG6g0Qq_y9UDC9_hYol0Aj5NAzKZxZ_4zIc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98089CZVyvE74zW1eLrttbPNbNXyvH5kHexIZQzbiWzQ&oe=6A340624"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Stg--Zm-zxwQ7kNvwHt6iUE&_nc_oc=AdpVaX98hizwk3axD2iBvT0lZtpTu-bHWOLG1xyC5sl0TyktyyZEUc9BhU2k2W0asis&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aGOJZa6YOEYxk6Tku1wf0_QMy0NFWahHLvlENSizbGw&oe=6A33F31E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PVsP5Agg9UQ7kNvwHLBysq&_nc_oc=AdqHHiO5Iqd4g5QfP8bG1HdUaJDdf52i-2IJGU4cz4jwJTL6xFo4pLvic0rHMzKhivg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xh4bwvfss7XkmhzoVkTGq_ZMSoMD9SYw6fFL
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PW_3mfV7Q-OW_cczPZmrf1rpXcPLNXfNx00rvitQGcQ&oe=69FC8E5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TVUlzfcgDoQ7kNvwHc34y2&_nc_oc=Adp1A_x4gbiYTBy_F0VT7KRiVoAOxfMEN4tEtzuFSMCr6zYs-lmvO-x3CZQyv0352gg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BVjbdqHWvqvaojoqfTFeybmZaqYZZujWi2dt4kuJPkw&oe=69FCAEDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG1VsUuvsc0Q7kNvwEpgyi3&_nc_oc=AdrNq_x9HbeX0mxLKt6hkCzGaWNqdROiZEblMZ9BHvrfbf1m5uQSRa6WsXD0WQpqapw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wwFX0CXAluFtRLdkNXOtpBBPExqp1BG0t_tIq6eaczA&oe=69FC970B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RufRHMum7QAQ7kNvwE_lrlL&_nc_oc=Ado3wnuqFq975bape7kwmxMrdkwSKOLkqkmW32FJlbX-UccwmuCw4s8thpIVHwQ1row&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NFsEw3FFNI134YBVJ9TLvhBrAA6h5omW8bwsg_phtAg&oe=69FCA2A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IS34QyRfRTsQ7kNvwETG7By&_nc_oc=AdrVlpN8r5d2VCzYmnZmtP-vu1LoJAYqkx7JIEav1chThqm92MgFgpE7egJG8sinHtg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-thNAFS8jvkEvppKIo1daMreox6SpVz9GuKX8Fp4QnQ&oe=69FCA724"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uFikz0lpSgQ7kNvwEoGIhq&_nc_oc=Adox6CpJH_y0W6rJ_mnLUqwvy0YK--5AFeVcMeUm9LdaG7q5KLDFhNc8QSukR_QHLVE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hyHLvmP1bjs1Uh3sI6hfA2rvNn1gjK7wBgyMq4UwmsQ&oe=69FC941E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2jqcWMCIqEQ7kNvwGoKtxe&_nc_oc=AdpKE4Zim01A4jLddcpVNOSgoeDnm9PvCEkoWVIAfmA6DsXGDgDZL5O6l39MAIMApAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51j4Gmtr7kJCMsly06hH12C7AD6wpuRzlEFwn
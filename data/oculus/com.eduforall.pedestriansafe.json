=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3YR6HdeZPu_uFb-TJZCvjgx0DCLymsgmVCh4p0Crgbg&oe=6AC643DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fP_Mjelc2w4Q7kNvwH9Kc75&_nc_oc=AdrotF-J-7qk2y5VdnauSoYVZjU9YIkM4B_UPNlV8y9mhH6vs-tIaDf5Vx3ZsR1_W-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZ_boT20UPrHR-YloVhyjxls8DrAllPMDcGvSaZwUCBQ&oe=6AC6645E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgEzoPc6UbkQ7kNvwHKPW45&_nc_oc=AdqmlzdOaeORmg1IdEUMEzI9jGaRvwJMzfWnNx1VZu2pu1UOP3vI0PhMIenUDKQ5HaA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNREHrRoWo9cK4sNnRLagAMzE_gVImQrRonOFs1oRyWmQ&oe=6AC64C8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuxS15Lad5gQ7kNvwHLBAw1&_nc_oc=AdpZVV_vMpZYtIC0aYLHmDv4bQ3PtDlNeSC5FAqirfi5eY0EqrIQ3VSOLXckLHnAn5U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtVVxAGEPeX1PnD-DNLYlfDH3XP40zNd1FpGPZsoROQA&oe=6AC65826"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1THXgTNsWkQ7kNvwGNtpn0&_nc_oc=AdpVtOXpztmXxR-gMCwv5jKpa2UofAd_7CqzSbNoP7Pm2M67a81z7qeTJ9KfLTnimJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIscyoYW_tEvlo4QrmO3HCnVT_RmTVqb2UkeMsmyMHjA&oe=6AC65CA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U54YFWW2RccQ7kNvwEOBppY&_nc_oc=Ado_exFSoj7ahhDJDHyO_4t8f2jK4ehO79LKlvTi01UILjZ7mMk-IluHNsKiPhLcoDA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6-AHmbjDXqjB-4REHoP86JBMF8pHwHj-9fKpi_nJ1hA&oe=6AC6499E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsOZyuyA_dQQ7kNvwGV0DP7&_nc_oc=AdowO0YoTBC_g65TYkJZ-GEXTm532hMK17iI3_BDS0fjXUXwdKISMO5Z9yHXzVepC_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPP4clrEnaFQKnJVnF0_uFQSVdR7g-lNfKdAvp
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DQooEjgsIOr0ACu10E_3wpnMzkdjFKKA3bGKA63juog&oe=69ECBC5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIK4yYV4y5oQ7kNvwGj11W8&_nc_oc=Ado4vGgDNtqIN_tXQLDCh9QA-bYlV6QWsP-kldDX1117laLaJbfnR7VB7mM6yrczYRw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af050FMiLRZQX7iOuW9GZP8TnM4zmiSzOU4pdj14-deMaQ&oe=69ECA49E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZZtab-v3ywQ7kNvwErnGUq&_nc_oc=AdpeuA_RIzNQqTQi5167s2hHWEX4DutJV4M1Tm_hyiFtP0yI5PsZBpDbnOk4Polr628&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t-pzAEwdjQ9uWTTRvDiglaBgnWZ6VC2CNklT_vzXR9g&oe=69ECC50B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BYs3UrcC_UQ7kNvwG387c2&_nc_oc=AdpqpEODQbhJya51_0FWltHKOv_EEdGv1bZv5p9-BSY2RGq6n9qw4GQWWNJsc4rW098&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37weUGQ38SSAajc6bfeuQtdcfwWlkNYlqta_uKqTT1JQ&oe=69ECD0A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQuQdsSXnqYQ7kNvwHmD1aP&_nc_oc=Adr6oFUzITG0eGvxFHqfs2RtUimSrH4T6mhjWjvsETuf11usyIzbuX7tYPdj9BWodl8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gMti4ovgsp1Fi8Z2fhtojkyeyDsb4e7KxpW9fP5_IfA&oe=69ECD524"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGTe66On5IAQ7kNvwHANApQ&_nc_oc=AdqTg4zA1luPCqA7u2ismoGMNv16Vkt97vnOw5x9-KHYlq4H_A7bZqJEDVhixC_KSIg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fuyOlkWIaAiI2iQjLYdGDmaQg0aEJ2F-IJHo2p6VROA&oe=69ECC21E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDtluVyKfdkQ7kNvwEC8WNh&_nc_oc=AdoOhQioS2jrAe5iVTtZ-9BS_A7Z_A5VQ1efqADeL2XMbtMseJIaKMchnCFVsateSP8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zBQuMT7LAMgigM3lfXP2eq9q0e1ixAvQWtIa
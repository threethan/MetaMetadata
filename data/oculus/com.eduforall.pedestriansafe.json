=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1f503ho7PB3D9I3vvrZJkwHRZjQYwtucoA4rD4GntXw&oe=6A4E4B5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ig0-o-LYSOIQ7kNvwFfDSw9&_nc_oc=Adp9Ms49qLEmqc1Zz2rMglFVIP0pwbQo1_d9ibZcwEbqlsvi-icSl3L5tIFFQsDAKnM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1mcX5M6Y68G6w-CDeCVl__JgPWt7Sr0OecK_1sOWisw&oe=6A4E6BDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5VK5NMx01UQ7kNvwGtGYSS&_nc_oc=AdoGdEDWJGkZu0Q0z_kMH1xwHBi7kpsFN9jUu0BG2mAtJ6GJHjSFIhOW6io0fcaFUE4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqwbtJvjcdy3Ap3ZjYNH5G2J6u78YobuFt1tw6yLxIkQ&oe=6A4E540B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxRdygOQXsIQ7kNvwH2CksC&_nc_oc=Ado-ijN-ss4FFQpPkO93hJullJOWjP5A-2jh5ecw34KgJOVXkcD-Xp_dMSlWFpVzKcU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxaRETt5z-YAnGKTAkDFjVRyA4OjKXx0bPGNztqudBpg&oe=6A4E5FA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O51vKN6dWEcQ7kNvwEWfjYP&_nc_oc=Adq-SQeildEtMDvgcmeoDeagRW6eTr3pbgG1_JsENYVwenR2X9pgrebAmKf5B-Jb4XE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1-D45Nzqme5LmqyxxhAajJD1wuQN5aH8j0NPp5iiigw&oe=6A4E6424"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yl1_o64iRyMQ7kNvwGjaUag&_nc_oc=AdqThoxA2vgOSQeQKckGZZpeAzgWCXrNt_ftOkdotPD_tJCfPGkPvfJqNBf_k9nem6k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiCX182sAGcNQDYWyxXAYCCU7Uu98YuMxv3SniGekMvg&oe=6A4E511E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ck4ltXYgyggQ7kNvwFGTkH3&_nc_oc=AdrknrCe7WgWEu1YK_E3ofo15KFB024vSPK0P7yWX6xtVHE6RYCvpUBlmJP4fkLBdro&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHWsgkMChzcVkvdGiVn37PfW4JzgiBdhSOsdB
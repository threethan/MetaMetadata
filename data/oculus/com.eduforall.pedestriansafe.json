=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxblLtEB4JMwTg7vYszy0sIHzCrJvRDk0CN91C-LwBqQ&oe=6AC7CD9D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fP_Mjelc2w4Q7kNvwEwnb6P&_nc_oc=AdoUpKsUe_C8Sg7A6akQ1VFSC0yNhpztN2flRmZ_6yR8Z0DnAdMuvi9CWepnSbC9zN8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMejaIQ0coYEDq_yZlJWNeZEGbgSxbkuHe0jmWsqSyMtg&oe=6AC7B5DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgEzoPc6UbkQ7kNvwHmo5Oj&_nc_oc=AdoKyXUjh_52nznh1bSb0h8Ti4VWQdlbyBJlaQ0HJI0BrymmLSlobIZ3hQiFA7zkAq8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUrBC1eDAPrd_Yn7NNgb3LcPtmGPqTo6USjAkL7kk4tw&oe=6AC79E0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-GO2cAyrWAQ7kNvwEdMLDF&_nc_oc=AdrqtVHUP4l1qQ34Q80iD9QZ8kW2m8_01bHDxVobBXIVEwNoL7Dbv_lf8Tte3M1FcMQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTvnerLoen9jm_45CspQfgk2DaIwQn6KYHsXPj6SOcNQ&oe=6AC7A9A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1THXgTNsWkQ7kNvwEET7f4&_nc_oc=AdrPLjPDYd7VUMgNM8jt8kX83WXgjPduIcaouE2sxg9PvTjIo1QYMDPsRc5tsidsnVQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGCkZDDY_ot-Yjbo_SiophrDThGlldvRsyrl4fOB5iFg&oe=6AC7AE24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U54YFWW2RccQ7kNvwGafgDy&_nc_oc=AdqKk3A71vjByufbwnnaN5OMI3SIVcAEPbIMkPV5BJmhwkQyiGC_i73vzy6UoRNafiY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNF7UGTdPi-tu97iZC0ZCHC-NBgH271pUFc7OcuIB7vvg&oe=6AC79B1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsOZyuyA_dQQ7kNvwHgZ7Gv&_nc_oc=AdovUtHIr-Ux4CEfpeCsyGDgWLOth1s95SmTw_9HhG_bqC92g6ekzhUJPhzbghPt-OM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOepNN7Px0hTWwCgUnqI4DIUQE_CGFQnGfrJj9
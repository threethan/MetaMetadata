=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WZ5ubh1gPvAEAfuexZljHzeLroM7HaiBbUsNyS66scQ&oe=6A198F5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3N2iFsw-3QQ7kNvwEs-N1p&_nc_oc=AdpKmZEZ8NUDiIPZroLNah7hUO8qVWMQJlRm8iBzeyULpOfxa0EWtAuzppgWCewNiLY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qHnN_UcS7nPO-EIdNzTWLST4BN_419eivkggWqNKFbw&oe=6A19AFDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_8dsca8RF4Q7kNvwGpZZa6&_nc_oc=AdoeFk9KJAbNEkXJBKgSA5UkAPJYa9mz7509ivIEHMVC8908utU8ww8DqVhCaMPdjCM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MxU1Uf-Aw7BHA0Q6vQ48smk3H89zRz8g72XnSZMCwgQ&oe=6A19980B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDRBsOHOQCcQ7kNvwEc7ozV&_nc_oc=AdpaFHQNM4Vg3D54AYPgmIc0HJAlpfOzjtNJ5LMoNYGuFSax5nnHUL6W0Cll0jygvZA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BVQQSRJS58iuOhgWMNYoMLKGv8GaldLsF5Totp21zxQ&oe=6A19A3A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOzWrmbo7HIQ7kNvwGcxFmH&_nc_oc=Adpa8fsOzqFDccKtJPzP9rJs-1F9gWE8faqrRO4XAGDmCPIQHI2mTClzAd9DRN0VryY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pct_ostojhC5NiE9ZFr82GVU32EHnZ6pETdtOb_aVww&oe=6A19A824"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sal-1dYCLBAQ7kNvwHnVhys&_nc_oc=AdqK0TH97CS-QpjFCyJWBwzmuwxJyAYfcBmIJWaLoDlHPPiFX4keKGhug-r6kigagU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TJMPHiC_m-undgU_8rPg2_c_8z69z5R2lSkAbOT2tvA&oe=6A19951E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIhi6IyLZ6oQ7kNvwEYWgPf&_nc_oc=Ado_m5uToOHzXb8nIRLkNyA_3_QxgrNvda85wqmQ0b2kZCFiEiX83lyw4OOOmJCYM2M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xe7XTd8yPM-A-BiVRAsI3p7rOiMVYfsUNw0f
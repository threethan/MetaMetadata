0_AQQsa30rsm82KGW6bzdL-vCxfVR2MBBtysBT_UDrzFLbVQ&oe=6B0086CB"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtoGGHULAnMQ7kNvwEG94ix&_nc_oc=AdogkrNEBsCGNxXo_yubFH7nu_RcJyqUBDSuOLiKAUPKiW_5Vxntz4Xh_y_HvF7TlpY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQubpZjFhiSsIdx0E_OMENZTlhE9V0n3m2plNV4692iBw&oe=6B005A26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrzTVvsOX5AQ7kNvwFJTFT7&_nc_oc=AdqfLzHMf1D0mbtdFj1d4llR2Y6DluNk4WfMKe0HdW4qcTuwhGYnXlOZs8intvzN_9s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9XokixxMkz_n4apdFcBHbFuRBeug-LqP1jnM1MaLfGg&oe=6B005EA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}]}, "developer_name": "Safe_vr", "developer_privacy_policy_url": "https://www.eduforall.co.kr/SafetyEducationpedestriansafety", "developer_terms_of_service_url": null, "publisher_name": "Eduforall", "support_website_url": null, "website_url": "https://www.eduforall.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8961223140623005"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_915182504077870_1386444174546070015_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPQ6z20COHIQ7kNvwHCOOm8&_nc_oc=AdocIoEoF6B7eDQx4ts8Ag7xFGIdAlI3QjDLZH-OgvEzIVEDpqXbjgnWAdgY6Dj_Oa0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx7rMIV96RtgngdgvVhk1ojRMWzV0QJy7l30muGQIjxA&oe=6B006BA5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Safety Education : pedestrian safety", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Simulation", "id": "33152918813227
=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKRX1yrRNKYOuH7RbZ6ikynAHgH6ghIyVwW7SDftKB4w&oe=6AC1361D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwFJrhlEn8gQ7kNvwFH0f2Q&_nc_oc=AdrsHEP2tj3N_0GHNIveF9MCghA8u2Yq-GAmd_uo-sPAQVE1YVw2I2AXVlt95PgSWG4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmvSTYsxHrulqwgtRi_Z5Vh2D3vak3APklDQtzQahwIA&oe=6AC11E5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsRb6e3ILNgQ7kNvwEpS97X&_nc_oc=AdpgiY--DP5vw7nHCfFKN-53SF71e8gmBw8vYgq_Vi1-yB7Qb_gszQg9G5PT6mGiFtw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8XNqOA5sZtYYGJfxQCoywMfVRcg-EBI9QmYMib40ypA&oe=6AC1068B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edOQPkGMrzcQ7kNvwFKsi7o&_nc_oc=AdpLc3_BwTbJbO1wcaXJO0ijFJlQShhrobfXda-294T9RA6FLOeitfKQDZGm72jIlKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6UF1MRQjJh8QIt_A1Ee0f_g2oILN8Kw-7PUOQB0hDPw&oe=6AC11226"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8bml5XYqvYQ7kNvwGrg_IC&_nc_oc=AdpPExspGG5pV6NMfUyhV9VkfQ3O1YOV-rIb-brnqF7KI0TCOirL6LrqPbJwEvGltBw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRebPjWrKi0XLEOQq3b5ducH3cON9khf-dNKc33FKH5g&oe=6AC116A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hq-Q3iUDIkAQ7kNvwGbxXvH&_nc_oc=AdqjxbaUl7BfqCpIgjMHiv1fGGG5skiwdOa-yKO3V55sHJGEkUOojhts1tqBiRLx2eQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6ycKMBI072ES67vSrRd1Ghr35qcUObX0Kzw_sziN-sA&oe=6AC1039E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIckXrDI658Q7kNvwGII0NE&_nc_oc=Adp6WyBCvRjPPgsSJARZKY8DZyIZgj2aMHQ7N3Kfn_hKuUmlKWXnctcmIm8yg7hsuKQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUpic6fi-UpbFeyFDd9JjSqCIbcQmIrT0cCFx
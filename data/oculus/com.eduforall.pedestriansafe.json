=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2LuWc-ou6KdVkTSvbuuBxAh__HQpKfvVg5HYhMaQgzA&oe=6A9C13DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voxm-DOX3IYQ7kNvwE5x8wo&_nc_oc=AdqsyQOtkY3JEqtuN6LDhStaAxOIhVSU_LAeo8aUanXhZ3Mxvn-kUS7KS_jCioHSeOc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlnfH_RmunB2w63nV9iKZCc3JC_YfnH4bP-o0lmJgfkQ&oe=6A9C345E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eV3LckADXXkQ7kNvwHATFQ2&_nc_oc=Adoq2wy-vB9LxMEqECH4Pyo7DrkX4M5dbi-QKvWqUMfmm1bQECXOD1yJSbkbBC2u7DE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjqUHRek9yK22Y14YL9ELDTaJ9TTA72yPhTQZ3Rv4QRw&oe=6A9C1C8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wYIUEXqC0EQ7kNvwHYtQm7&_nc_oc=Adod6kPErOGenuEHg4dn8_YpWjrgbRH83im8BjJUeG7MRDwZtuxgSY06LYDZLEcVnV4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5gqJ_bGUxq_sa04RwMTheaNK-inSdYpD4LSmAJv3S4w&oe=6A9C2826"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSaU3I9CyPYQ7kNvwH1FpNl&_nc_oc=AdroKEAGU8sVLfc08ApHDcLKUOmDqMFWeoQTt_n-RjhyX9WDbbFDzkIiY2Ob6OnBKzI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLuFZjPW-rmDnAAumE54NNt86llnur10MXdwgIboohzw&oe=6A9C2CA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJED8Abaa04Q7kNvwGuB_n0&_nc_oc=AdpNY1Q1gYRiykGU2lH_Z6sZGtGDvktzJ_zMrrDkJLnpvNROoAJfCE8s1sHDsQZj3xk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-XSjDQcaWs3wwL_2gai09Sqao-21TqVa2RBK1w_YbOA&oe=6A9C199E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noetHrjVShYQ7kNvwGMPcDT&_nc_oc=AdpP7g7Heodx8bEeKkPkY6WWYdDSGlLO4-KXTnPwxxIXIKtqL7tKuHSwGmkdZy_3Spk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ51PC2LERXOmFdwPPfqr6gUA4nOvmiDcl5l8D
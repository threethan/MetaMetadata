=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgiOb0eLR1TJYvKUifYhZTJ5BvHwnES-qaPTZajdVIYg&oe=6AABE5DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZT6TDlWcQhkQ7kNvwFq0CZf&_nc_oc=AdoTgRF2s7xxQDxhsUKPG2mPAZFrfF4RXRFIoxZYKmQ_SS5nduuGVOnIKcAG3OqNZIU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCMI591pjIXNd3rqBMooZ2gt3e0Lp72rDn217E3c1pgg&oe=6AAC065E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTZttuXdp-YQ7kNvwEMmefk&_nc_oc=Adp68jUssICNgU5D7Z8-n1L7euuocX0EenqZxSKVokiEm6EzQ97qeWUp0gnRiBcF3-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0pYGpXMFN17GT-HfwvvAEzN0_ZTS9TFoQyR3SOJH8-Q&oe=6AABEE8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0M6lMR4xAzMQ7kNvwHGDuO2&_nc_oc=AdqJxwx1OXSbMWH-at4kRXnjxb9LmK_2lY2oUVoKEbljhzTvQiS-QQXQnHtyXsvn8lg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSV1JcnSJRY-0arnd7wzRP-HWA2sAAudKFMXi-9Ez9Ug&oe=6AABFA26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmXRfQ0Z6C4Q7kNvwE-l_U5&_nc_oc=AdrGb3WIbS8sZNq2LpwMiufAceOr3h1rzMQFrjEFyhkdIwY0cQs9SqXZeWOKjHdYM4o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiIPcQ9yDnaSj6VcMi8RJ4bEz0OJoiTv8hM5RwlkeNDA&oe=6AABFEA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqA69el1xUQQ7kNvwENFFI7&_nc_oc=AdpSUvd9FE5ce0Ui4n6eYpz8rLub_w4MZwvm2JmNe8iRQ4gVjq0AbLDwdSh3UBfzzkI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNjZGdqMU1pubvux11epuQ_lRJy20_G6DV1Z6x2jnuDw&oe=6AABEB9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cy6d4_Vhh-MQ7kNvwGPqZG-&_nc_oc=Adp8Z_6DNlk5ei-AHXl5eYj7OmPYvST5rBoofYWrNg5u5Kn2WGP2PmQTHllFZUlhfqk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJOoQt2Www4K3HnqVQK63tbPRPGtvGvbjctbf
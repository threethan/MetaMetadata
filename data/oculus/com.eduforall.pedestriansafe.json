=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Hq1bvNg6mI-RxSaBdVql8toKeTyTt3LNekN0n4GuiJw&oe=6A0325DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3sZ7ACCjkgQ7kNvwFV80Tb&_nc_oc=AdphKU0k6jD38wMlxmms2N5mPlNC0F_fxnG4HwE2M6jS1UjVHoO3YsoTlUPf4HqY3OQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qcQ-irVOciuOv19AOoJk3VdUK_LhvqLcP0IkRMzTY5w&oe=6A03465E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwJLZa9k0fUQ7kNvwEjXk4a&_nc_oc=Adovp1SlvUbX9wmAWmKtkGdnt2WdcIZnBCFUQkCPJAa0S7jhTdqYikzL5HwS0JF_e0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43cSZPIU4kHSO0A8KHGJmhihY6cyeSBHx-xAkEth3Knw&oe=6A032E8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoCwqbnNSA0Q7kNvwEPxD_F&_nc_oc=Adr0xW0GW6PDeDpG9zKCuBEFLh9p6fTqSzPvtNwUItTksfKJqR-MpuwzpgHxI6N-A7c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Bon7pMuFx6aeSI4pATgzheEI7qq-0Q8eubLjou3IOpw&oe=6A033A26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBNuI5cBoDEQ7kNvwHhYj6Z&_nc_oc=Adr1fWq0von8WWbqXdIXStQ_LoOIQ9GqqajiSUdP_Id0zfLVtngjlsWmUF3jMWbncKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af566SWfQSokwxYP4nPLyUaVBC4JN2JiaKNv_eWBxCVQAA&oe=6A033EA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zj_ZTAsbrOgQ7kNvwG0VSbn&_nc_oc=AdpdGA2_JaZfp2Lm7zv3uupVtLsHhTp0Eg69QPegaxgErUtNE0C542XOibdqNEdwYvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rWF0zmSI4Pwgpdtvjhfq5bI0EYUBJa6PZkeMp1nzMYg&oe=6A032B9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CQLxfaHQ1oQ7kNvwGowrvF&_nc_oc=Adob4meAqaORU-MrYe0gDe5sYYtXrJe2cEv6Xdyx21FfW9WgwCiNcoEnvSZlSwxBCHQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6z68usItZSUEj-Qg5rlYlzBFrWA28UQ97d66I
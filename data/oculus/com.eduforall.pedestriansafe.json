=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EAkTLIBtG5SbhIE2afXMuXyuHgbMAy7J9NANpNhqg4Q&oe=69DCEA5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXaCUMooNF4Q7kNvwEWC0Oq&_nc_oc=Ado0W6EX-rKmc4Nrblv9lLWAj7tTUSqBqFLBR_JhMv_x1u7sxCmyXl7n_5UeOOBc3rI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FqXSeJDxnfBlPs_xMPJ1llpwIRbhpx84UKblXwvXiwg&oe=69DCD29E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7bdwEH46LwQ7kNvwE-SaDS&_nc_oc=AdoT6NEWCz9gmyhUUi04H4VtQzQ2g-JtlC21nlrsf0jKUZaLIf7TPRovgeHVDlcQKS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LqN55A-CyOQBhYcmnKCuUiYLwSUU92v-fU6ej14W2YQ&oe=69DCF30B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEv8nFB8cD4Q7kNvwEobEAl&_nc_oc=AdqWVJLWTmQl5Yz655yJerBBE9JjC1G8jE6_Rn_DHg5IOLhdBz9SFPDJG6_QpFURfM4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ncNgR6IOLlepe0YGmwk4UQTtRqaNYpsR38_IjxnLeiA&oe=69DCFEA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28NY8n03j-4Q7kNvwFn350X&_nc_oc=AdqAKyKVNoalUvGXiMi_Mt5XOpPTA9CEBwtqsCEB7fEsfknMSDURBkttFDp28U9xG4Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35B7e6XzOHH6Jupghf427pLK0l1W7D_JtmIkpIY2dAmA&oe=69DD0324"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V7khqmPQGsQ7kNvwGe08-A&_nc_oc=AdoOp8UxdPjna-y5Re5CxZYm_arqIyohvEdzPor68U5t42APd4pl1eaoSLpoRR3bt3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2j768SveyDPpet93gDtva800OX5nV7aLhc9fmweV0XCA&oe=69DCF01E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOygr6nqtIAQ7kNvwHWZ8YT&_nc_oc=Adq6F0NjYPY6Q1vqPUwdMWVRFL_qAgXXrcfdT4GJkm2CLkn_R1Dc1d-gvvkxAaiJ4Vo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OWf55yJdkhfzewfpQVmxjPqyjPkXe6Ub371l
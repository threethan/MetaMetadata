=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48GzJbL076WaaKPFGLdH_fcqvry8VkWGvpguS6ydSNSg&oe=6A1AE0DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVgKNCQHrp4Q7kNvwESJKfD&_nc_oc=AdoSHBzmbMo2cjvNq4VEoxBd7reuTy1aUjJs-FhK4UgJ4oCtvnCHW8EC7NtRQvkRuNk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RjTqbRlyLM5nXRK-orkix8WJeKfaT_bBqc8K3mjSO5w&oe=6A1B015E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWRuXpZCUDYQ7kNvwGZ71tT&_nc_oc=AdqUVu3uoCRLxGys_gK_aQS3OsQT8rl8lwEMbG_zWFbcsvQMY_Gjp-oJyWrQ8d1zRLw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kx6_X2j0BfW30XimyL5f58IkN0nmGBIBesQUrau7-HQ&oe=6A1AE98B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDRBsOHOQCcQ7kNvwFyRgtl&_nc_oc=AdozbFBMHIpe0Dovcb09w3Kd2P3QFj6_1EBU7HXVZ1ZdmskZgJRGG1kExfcwluZ_RrA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_7v_EXeug9_RspH7Qghc75WGhTQke40IgzH3s88Mz4w&oe=6A1AF526"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHCGznYYDOwQ7kNvwFDU5Me&_nc_oc=Adp0ehj8qHnl26wk9P1_hQ1n7hlVeoTyWENOqUrQFjyVRRjLceVrbPXeofaLo4eKLL4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lL5UUgqi4l2cEVkG2Hl57OwE8l2KXEGF0-aOcKpywfQ&oe=6A1AF9A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKAxG6M-O9UQ7kNvwF6KlU3&_nc_oc=Adq_1rbG8JRigG1N_aWPK0_OSlUOyc0GR2k0ZELKNb-sBD0Fah0jvxmfH2sao2LI-B0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vfrCdH79WNspnEZ0lD9wV7PODPN1YQLeecnlqxB9t2g&oe=6A1AE69E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIhi6IyLZ6oQ7kNvwFWV6j9&_nc_oc=AdqlRh7z1x9wrxFS6ha8APL-0hWH7jv7qcgMjJliDQLjKBdTsCQVfVLLU9VF-yuYp6g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vhNjC996SnGVww8A1V4CemN8lPcPxUvWHtW9
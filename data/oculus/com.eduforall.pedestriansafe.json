=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoZKylemrGLDGeVdyS4B0tN70YqT7HAb1dOvt-lm8RIA&oe=6ACE651D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Mju-6SY3FkQ7kNvwFDkLOB&_nc_oc=Adqh3_9WsRTnlroCp8ubWf2W2H3zRKRBy4HnGQWRXhUxxiUdEEenZ-9bl8XeliLg_qg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyVQI6bjVNdhtLqMAQHdp1etwRsjFKpgoHNn6cSAVvSg&oe=6ACE4D5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdxjHPzd_owQ7kNvwHmVS0C&_nc_oc=AdoPX0S9oOtIEPJatlQkhlO8yFhAHAtSFrPYJUZdzXacCM9PYrjEC-TbqZrKZmAQch4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeUvgueFteieebqLeTcuTbfuJ8VIpdzdUyKvnT312POw&oe=6ACE358B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2xvswNfCfAQ7kNvwFfMKNa&_nc_oc=Adp4ECDLM_hh5534Cx7uaGYwga_V4GgBMvTcsWnhYf85_C4KVPXQcUzvN26JV6bJnRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfxYjTgpSwomqO5b8ZTGZR1E9ZrliarF2XRoS0QQAzsA&oe=6ACE4126"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ABA7YQK0OUQ7kNvwGOy3In&_nc_oc=AdpCizxQ0d0v6TDZbMfXuuVgtprw1tcB9DhIELQsYdcjnghjkOshdj5WwaR_FEfV4Gk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZFvXEZiZVZasUviiyj8ZhV1PErb9D_DstPZ2NqMQZow&oe=6ACE45A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tx9YqrWwitoQ7kNvwEyZ8n0&_nc_oc=Adri2uC4a1OP9WEwVeOR7IBI1QDaSnZsNuH16rEbAc_QQCoWadT4gP9cBabYPmfAuHc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfsPfZKONBxMfb8vyrt-4BYVwgKYI_sApQdVCcpvwpNw&oe=6ACE329E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=265hnZtttIMQ7kNvwEFnn1u&_nc_oc=AdrwoxmSfdMkWMIKaD0VcE5p61-VLrsPbS5HJvDQ7sv6bEWndGVweT9zHMSLdxj4VEk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWk6tIhDAMg10a0JrfT0Oq1bADEyVMktYr5gG
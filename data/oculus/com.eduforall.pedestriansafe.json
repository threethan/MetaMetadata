=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ50A9DKDLrArHLI5lj_OIYnAqNg25Rg26M-17yU2iaw&oe=6AAA945D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZT6TDlWcQhkQ7kNvwFBp0tp&_nc_oc=AdrEg-9WnLtXo2krcZtRz0GbCHYrRPQ9wyF-aZX92NqaGueaj57kWORT0gNyzPkeonU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-qhsW4Xpqy_D2s2geDLNa2BrI7hcFRoCnzWClaKS_Jw&oe=6AAAB4DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTZttuXdp-YQ7kNvwEC1bwX&_nc_oc=AdqSDVJPdjGMaLECfx93UB1EMaD9sEdklVgyG_ZMDkooerk_BCCD6OiAcdJVgsqqJ_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcpjfy5IgXTAgmYuJiQYT1__229atW_5OZSNh25iz8dQ&oe=6AAA9D0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVvWuoWarMgQ7kNvwEZpubL&_nc_oc=AdowN2l_lAicssR9RTESPAIxxAHljFkvZhNVz7T9ndC-sCxkldRMNHpYegNaXMrR__o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6ln5VC_2NbrWVoHVQ4miyK_6ySC8oWOoBUUInZaF2xA&oe=6AAAA8A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmXRfQ0Z6C4Q7kNvwHe3Jhi&_nc_oc=AdrJNWQtNria5R4fWXP5LtY-OXijnFbWL-fvbelmd7LNK7tPlDCOZcj2kaYNSpXJqYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzSBsddAYizu1bGAsT19yr54yaEjpKBiAO32_S_e_NBw&oe=6AAAAD24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqA69el1xUQQ7kNvwGpO6aw&_nc_oc=Adq0kEc0jdMXXm_3CN6PsOvpw4ZZFzlA-LNSyDQROSlJEIDWRfs4uTMVZRHTQxwuFrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEbm8nOrpZNGWYYF5DolM25ooQK5P-KGnkmhFRuV1BBA&oe=6AAA9A1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cy6d4_Vhh-MQ7kNvwHmbc01&_nc_oc=Adrg9gE1Yow8gvPLvzXT4pxY-1h22eKLIpg1UEnYdPiYW778pQ0_4DKbcMswsjY9nYY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpS127ujDjzLlfznkMVOTWZN084pnmeAwecTd
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeOF8iYwDPgX5-YZNI4byA2FGxTLjkEDtm3fQExmgoQw&oe=6AF5F21D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xcjt4_yT48MQ7kNvwHueBtc&_nc_oc=Ador17mqnCXvtOYw-cVGNtnwsnDcLHy9HsG7ykCAfK1flcK3OudK4tfFniY0EARx_LQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-mvyx1Euorusd1BDqR7ROZ6ubbhBTvSMJ_QwtwrntsA&oe=6AF5DA5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLCRVfefISsQ7kNvwHyib4X&_nc_oc=AdopsPBKipGdaC9KPHQ0Z8fpLeoAnh-oh20SqtVvwHSe4s6NpllScB6Xl_XDdPxmqoE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMUzSjmPnTnKOFkRvS_yGnS30akg6T5ndn0Q8yFrk7Wg&oe=6AF5C28B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgTXTlbFnKIQ7kNvwEnPOlD&_nc_oc=Adq1uQ0ti1J-IR7pR_cR2xh8jKW7xE0glropd1yFmpyARKHrPMEv_7FHL3T9K-3g1To&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzaW_R-JY_uM6AzQ7T_C5uMpj-lwoTzYN-v1FIRU77Vg&oe=6AF5CE26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4K0iQ5YShe4Q7kNvwFNOtDc&_nc_oc=AdoHWwGPNxKloSnuuuVLJ2ubC3KCUD_21pgsVM813_gav6JLOwR1ieC4IYkRaCcBSX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8oCYWtzE2bq9GjL4JwPgu-OVUB5UuNY4ApYyDjZhIMg&oe=6AF5D2A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0QPy-Ff4T8Q7kNvwGiL-l1&_nc_oc=AdqtF2kkklUNJIKr6v7XG3aroQ7qWfVz46symFJL3LWWivsF-8qEajvpnYwdI6IcimM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQqB2mjBUmqDeEuUd0mnp5r47IYkKGwAi9JOzOWZahWQ&oe=6AF5BF9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvSJcXPNITcQ7kNvwF4B5jj&_nc_oc=Adp5S6_oDsEDrkGNO2KyMDExibhZlxGHYG43R5dGOP5HWz-m8WLYffgQu0tsegwkkHo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1Qx-3t-WYI4sP0PlEbCrIu8EStKjGy_sYTZE
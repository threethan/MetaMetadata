=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5v_TGnQOtmI1ubBXPDlqook4wAD-kcnXVsP_ymnhwEbQ&oe=6A05C8DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3sZ7ACCjkgQ7kNvwEF7mMd&_nc_oc=AdpgwZmpHgefppVow0t28JUZG0IQhomdqw456FuyUSV3FuPEk905LSiWdJTiJ9xg_BE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Um6p8I7spdMflSZCrPI4Vm3noZ_wLJdRYT-chn1Umgg&oe=6A05E95E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwJLZa9k0fUQ7kNvwFcSfF4&_nc_oc=Adq0VxV_fp3mICOj4CeyOxvLNuV6Wb2ziOwPnhBvFyqLf13TRClpmDfhTsxOkEzQjrY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wKwIUBSwnrN94u2K-qFAf7pJtxdx2a1f5ZcMZgDDnYA&oe=6A05D18B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPWlV5W631IQ7kNvwGTebjc&_nc_oc=AdrMZWNly2rOO9SlZ2NGq-UsSowwe6WmUzBUwPHN-7z7RPRstVWNvxLcI2UhDl__LcU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tPmCVV8TnsHJHCpngWx3mN0UOw90bPq6ldIi0NtollQ&oe=6A05DD26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBNuI5cBoDEQ7kNvwGOMq0s&_nc_oc=AdrOV7UFq7sxKVLfy2uErrhvzIlJrvTBzl2Lu9cXjUrH48f_7cLkFBDcKTNNBGaVZjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77lsjxqZCBdH0eYLzDd17SLRH7zmovLykZv8Xd9UhyMw&oe=6A05E1A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zj_ZTAsbrOgQ7kNvwHtIKzL&_nc_oc=AdpYw8XjxlaLp-Yun38ciaYp6C0n3KlOWNiiqnHo7zLITYJ_ASIou7yW4ORbCXGoXz4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62fXv6f_6m4xifx6rAlIShoKNhFadNdwGrgOHaqGVEGw&oe=6A05CE9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVw3Aj3Eo6AQ7kNvwGAtnDR&_nc_oc=Adoqn3Ts7n1hgVbk0jHzIG9wwNvmLZs4ck1nlM5XSRwGIIx1XJh8LQ3x0nkk9PR1m_o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VHZHfyrIo_0SxVM2qt1CcPHrAICjd7-e9pp1
=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8fkfLq3uDqB9iDr1NFSem2HEZJlTHZvmrrlmqnZnxgg&oe=6A71E3DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OKwO1t1O9UQ7kNvwEOo7_h&_nc_oc=Adq0ypDvJZ8tyShx2ZlZQx1nqkMWBpcPU9AZ3oA2EQDLvwSgfpfYLtraBuaFqea6DC4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj6bwWRCWaCqksioFAfpzp09K52qgXBjKt1IZOq4eSng&oe=6A72045E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxjITCD2uoYQ7kNvwG7mvau&_nc_oc=AdpwNLsf0fIH9TeW1gKPYvbYCmIXoqZ0ENIoayNzDQch01RDP4HTDrICPaQQhxUvYYs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvsqa0PB4st_2E5GC6K-lBsbnKpA1pxlNcCl2L-7MFyQ&oe=6A71EC8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UI7IqI41I0EQ7kNvwHovdOr&_nc_oc=Adp9g-2Au-MlAMzCS25fuDBpwJGzDhvu9hJTRt7aLruqABHkXcHwzONetBdPqx4l85A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJO7Ay_MC0u78Aa6lGgCcmQc2dXa68fHHAr68y5WrCwg&oe=6A71F826"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0b8NDzRDRcQ7kNvwEPNgO5&_nc_oc=AdrXTM8CuiYhrRF7lREz_-1litk-7GlXyrWlW2xyl05313yAnZjkWUUkhKvx76s0K10&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGkkDvbANSvYvpwpkjeBaLVvE9TftnPVbS3Eyyay849A&oe=6A71FCA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0ZpIUt-2OUQ7kNvwG--hQb&_nc_oc=Adp88Kb1l4G-v1OkikHDqKmqSFKRZQO7qE88vOElUoiMJrnkYgzktdgCSFOtwAqNQVg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiWUFQpl1IDz3sFHAmTltqYm0n0QSQ9IR2Iuha4j7oVA&oe=6A71E99E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzwHrZE4O_QQ7kNvwE8neAA&_nc_oc=AdpgUoueKQUt_EtMuDZVO8RZzZ27RoptWIx3to4vxHiCFyF2IqBfJCxpge8MMszEuv8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-BbJ2KXRlxuxuOcWG2pwZK0Ar49AEHdH335O
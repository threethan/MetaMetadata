=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaRiBGIo3Dlq6K3hF1Nk89rTmGhjBN-Tswco_cHo9Y6Q&oe=6ABE5ADD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNy6nAE3It8Q7kNvwHr2443&_nc_oc=Ado_mEbHSTJUYK9CF_hU3dSCQoNo-anKE4Q9D-hkgqN0UjtEUpBuwLK1ngQQXrwNMww&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzIKz2R-HYwdmV5teg4QEo_uM3IZ-JgP1dKfwRNBZp3g&oe=6ABE7B5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCX9nA9eO3YQ7kNvwHKeyXh&_nc_oc=AdquMMS8vLiL6H5uShnlb6nykxugbejk0nUqBDcUx4n6laHNN280KRCIsdMyqwbbX7c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkAJBADS9HktNYmUb07S6x1DErl_9fdKjPARfGV1PTkA&oe=6ABE638B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-XCY8X1_jsQ7kNvwE2s-28&_nc_oc=Adp7EaewfBETWKmvZ4u3Xq567SyfhsaC8BibQVOTBeT-mO9_ZACz3ZwCJgZpQhJdwiI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG-hdGLRGU7kfBKpQ6oPA6FYzVzjCZvvrRqNngFwxc3w&oe=6ABE6F26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqmlaP_rnaIQ7kNvwGaulQ_&_nc_oc=AdpjYkUS_xS-1-X8tfJTO769N3ykRrmmxv11LkyUeMj4EAc_EoGgYyT4ZEMsrKQjgpg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfcGIelJn2suRkGOX55teiEjv9k-1np32nz5p95bIQqA&oe=6ABE73A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r834xC0UgvEQ7kNvwF_WbXs&_nc_oc=AdpmaURMbgLfyigU6CQXaOxC9kM0eimF4PhsWKO59_FfHod51_Gju2GNb1F6JdLbD7E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1fCKQfhKfTFdqVyy3i3WCR1LAl2GRkUmu-4GlbZcHKQ&oe=6ABE609E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIckXrDI658Q7kNvwGGQOcV&_nc_oc=AdqcxrE0jX4tbO_e4aS7CmJRPT8NG1xxM0_w0J3Dp7lkrdg_6D-Gbw2SpB2EEyeAkl0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwPpquWF2dFWQOe9rGDVirEDnk97aIDpJ3LkA
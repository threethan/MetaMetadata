NffmU4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCgFp-FZo0FtFZumfxpUi-hMn1UfmeNDotam56jKiPug&oe=6B01B836"}, "display_name": "\uc548\uc804\uad50\uc721 : \ubcf4\ud589\uc790 \uc548\uc804", "keywords": ["\uc548\uc804\uad50\uc721", "\ubcf4\ud589\uc790\uc548\uc804", "\uc548\uc804\uccb4\ud5d8"], "long_description": "\u00b7 \uc0ac\uc6a9\uc790\ub294 \ub300\ud55c\ubbfc\uad6d \uc2a4\ucfe8\uc874\uc758 \ud2b9\uc9d5\uc744 \uccb4\ud5d8\ud560 \uc218 \uc788\uc73c\uba70, \uc2e0\ud638\ub4f1 \uac74\ub108\ub294 \ubc29\ubc95, \uc57c\uac04 \ubcf4\ud589\ubc95 \ub4f1\uc744 \ud559\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\u00b7 \uad50\ucc28\ub85c\uc5d0\uc11c \uc548\uc804\ud558\uac8c \uae38 \uac74\ub108\uae30\n > \uc2e0\ud638\ub4f1\uacfc \ubcf4\ud589 \uc2e0\ud638\ub97c \ud655\uc778\ud558\uace0, \ucc28\ub7c9\uc774 \uc644\uc804\ud788 \uba48\ucd98 \ud6c4\uc5d0 \uae38\uc744 \uac74\ub108\uc57c \ud569\ub2c8\ub2e4.\n VR\uc5d0\uc11c\ub294 \uc0ac\uc6a9\uc790\uac00 \uc62c\ubc14\ub978 \ubcf4\ud589 \uc2e0\ud638\ub97c \ud655\uc778\ud558\uace0 \ud589\ub3d9\ud558\ub294 \ubc29\ubc95\uc744 \uccb4\ud5d8\ud569\ub2c8\ub2e4.\n\n\u00b7 \ud6a1\ub2e8\ubcf4\ub3c4 \uc774\uc6a9 \ubc29\ubc95\n> \uc5b4\ub9b0\uc774 \ubcf4\ud589\uc790\ub294 \ud6a1\ub2e8\ubcf4\ub3c4\ub97c \uc774\uc6a9\ud560 \ub54c \uc190\uc744 \ub4e4\uace0 \ubcf4\ud589\ud574\uc57c \ud569\ub2c8\ub2e4.\nVR\uc5d0\uc11c \uc190\uc744 \ub4e4\uc5b4 \ucc28\uace0\uac00 \ub192\uc740 \ucc28\uc5d0\uc11c\uc758 \ub0b4 \ubaa8\uc2b5\uc744 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\u00b7 \ub3c4\ub85c \uc8fc\ubcc0\uc5d0\uc11c\uc758 \uc8fc\uc758\uc0ac\ud56d\n> \ub3c4\ub85c\uc640 \uac00\uae4c\uc6b4 \uacf3\uc5d0\uc11c\uc758 \uc704\ud5d8 \uc694\uc18c(\uace8\ubaa9\uae38 \ucc28\ub7c9, \uc8fc\uc815\ucc28 \ucc28\ub7c9, \uc790\uc804\uac70 \ub4f1)\ub97c \uc778\uc9c0\ud558\uace0 \ub300\ube44\ud558\ub294 \ubc29\ubc95\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.", "short_description": "\u00b7 \uc774 VR \ucf58\ud150\uce20\ub294 \ubcf4\ud589\uc790\uac00 \uc548\uc804\ud558\uac8c \ub3c4\ub85c\ub97c \uc774\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \uae30\ubcf8\uc801\uc778 \ubcf4\ud589 \uc548\uc804 \uc218\uce59\uacfc \uc704\uae30 \uc0c1\ud669 \ub300\ucc98\ubc95\uc744 \uad50\uc721\ud558\ub294 \ub370 \ubaa9\uc801\uc774 \uc788\uc2b5\ub2c8\ub2e4.\n\n\u00b7 \uc774 \ucf58\ud150\uce20\ub294 \ud55c\uad6d\uc5b4 \ub0b4\ub808\uc774\uc158\ub9cc\uc744 \uc9c0\uc6d0\ud558\uba70, \uc2e4\uc81c \uad50\ud1b5 \ud658\uacbd\uc744 \uac00\uc0c1\uc73c\ub85c \uccb4\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n"}, {"images": {"nodes": [{"file_name": "\ubbf8\ub2c8.png", "id": "2069319833533263", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/468725195_2069319836866596_8946935124449417766_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zq6dCeGLtgQ7kNvwFTVoUQ&_nc_oc=Adp2ZvBYi8yKY3T9kIoO5DN0yBUvY2-qaFZ-i8ZIXZtNZiI27PliWEpY1yAj3ZGf-ek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIwQvFNniJcRHdGCeC_kTnPF2RvdmmsSwLNNcNF4-TUg&oe=6B01D9AA"}, {"file_name": "2560.png", "id": "1958144254664663", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371508_1958144257997996_5402494376169652053_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwOEF5gJr5IQ7kNvwGVkNaZ&_nc_oc=AdqBHE9yRbF25zBLeTtdBfzr0fC2zOqgS8bunlXPf9JShDdmqZnbVGz1My0mDrpqUlU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRx1rTXUA8wWm0lCJEHB0NS0lz5Wk3XmX29sdxjp5IIQ&oe=6B01CDB2"}, {"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "1274294210494308", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001696_1274294213827641_4508473815298717681_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUb-_UP63PwQ7kNvwFs7I9y&_nc_oc=AdpcRAQL6cn28VShvyYfdoc_URaukfrCsBB0Std-1MFGT0NIK6VSU7MI8cCkZ4GVOkc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscd
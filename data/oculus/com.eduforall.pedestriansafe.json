=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeH72btpKXPZ2OIXbH2d6Ti7sqGSvE8_TVPDDjzePNvQ&oe=6AF9E69D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3m7DSQQhblsQ7kNvwFCYLqA&_nc_oc=AdpLqMEk6c58opf3K7acOTRU8W4Q7DreHP5OQwLx86r7g3cWaj-tCsXtUkXecQxZbHk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXATznHrfOVm9yia6eb8nL0pB876oTXFjbVCVqiCWxng&oe=6AF9CEDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bG6QNIfZ3PMQ7kNvwHf6GRr&_nc_oc=AdpG---iy2h_E1YD8flwbiU0EJOr8dW786gRLzvQBP4Wf0PcUPzTHUs9HrbAizMDQY4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMcYYcdtIgN0NnQ_yO8cSUVNaFJ1DCAR_2-CCVcZLAdA&oe=6AF9B70B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkLtHBA-jhoQ7kNvwHAIBkv&_nc_oc=Adqx0pRl7ptANXKToJGzNhqrhCXCPsLCDriIgyUvLAttdRiA5EU6Ubbvz4kT7zGRq0Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtv0tm51AWtLK1ohphzCoMM9jxYeNZwRMxtDv5cvYZIw&oe=6AF9C2A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XdcBRtBmjUQ7kNvwHxSDev&_nc_oc=AdoKupb-OfZpByXbwGwThaSwKPP4Ev8Q-vxmaibADsvuXWznwn3MhSGAe5y_OXN3aPQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN7ThJL_6GTUKjCuGHwMQJiXuuU6x1TemcyRHHA67WyA&oe=6AF9C724"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMfgSUGeaNkQ7kNvwEiox-3&_nc_oc=Adorh8v3VbwuuskOHsGgPiQPQ6dfc-kPOE46Up5sI49NR3PIsfuw3TU80_JdpL06ck8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkX53X0vPePM4FhTWwMhVjorUGIr731FZRjhRJDc-Yaw&oe=6AF9EC5E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd7OJrFISqkQ7kNvwGXTgea&_nc_oc=Adq-zZ6waWZ3aSitLy9RPKkwrscIEyB-zkmFVVY1mmabEG8-WBLC40hfAPQVOyJTbgs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOUwEtEHxYeCLShI_YKFw8tDPSQfTjOsYjr1O
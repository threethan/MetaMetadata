=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvpGuRziAgWHtFyt44HTQKUmQMZoN9DKBx0xCnP0EOiw&oe=6AE88ADD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxqMhz25gDUQ7kNvwFgwHyt&_nc_oc=Adozx0aYVrYkY3dQgeM4zEVWU7blEn-2FiZxZugy_50blHlwk3Atwa2u7XbCT7sZV00&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlblTLVitZ0nrE9iO1lUrb_VYiEyzQCMfua-i1403I0g&oe=6AE8AB5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvgESfIjTDUQ7kNvwGHsE5O&_nc_oc=AdrhKpGt1MHIDTp-eaZfsVl9tN_muBnrB6RLoWwGG3goNNogA9SCaSe5Zil3oCRQI2Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEEVRIXYkC8ymFDSrpeI5Ynz1WgkNSLrBvy-WjP4Xrzg&oe=6AE8938B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m60MI22WcfoQ7kNvwEVmbe6&_nc_oc=Adqqg3WsIEIiidpE21oNJEAYVYy2wK0kT_JpNkZ4pzjDvypBLtwPoxftfu66J0MQ_Es&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtxM5-V1iNpD47cC3OsP9k0NHEekNeiRO2usxnJgeTwg&oe=6AE89F26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p68jwS7s7FMQ7kNvwFCA5UL&_nc_oc=AdqQur2uQwPGtzwR8EP_ZfwiMa_w240Rij9iwigRfwBvODDZu3vv55v5oY7VSq_nT3A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHwKeEfCjSApdwMls9u0HWMTG9Mgl_n2qH02O9UKLTog&oe=6AE8A3A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Bt6RH9kQmYQ7kNvwHM9JM1&_nc_oc=AdrktvNS6GqiNqWLBQ91RIixNyTEjj8uhWyRCPSFxZOMX8gT3tOhSfAyAs_1CURJV8U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHlPPM9XLCidIN70xdiMsCD1cFKNaJXjr6pcM2BDjuSg&oe=6AE8909E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ly8JjDyBSzIQ7kNvwHDJ-CZ&_nc_oc=Adp4WW8AhxZxGzy06ZtG0h4sJxrRhuL0hsFs39heJCyZyx_yuKgCh0bRsOO5fv9-cNI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdwy7c_0Se7XaFZ85DzR36cse4pila5DS50IF
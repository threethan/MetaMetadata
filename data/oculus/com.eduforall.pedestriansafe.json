=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlD502jhCsHsFt3vGWEhojF9GsFx-YbgT7yHDlViHV6Q&oe=6ACD139D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Mju-6SY3FkQ7kNvwE-SGKj&_nc_oc=AdofM2CXlUaFSaQ_KNTfV_u-hQBAMqsWIYOkFCUFarNE56y-7NR90dCLvTr9JEVr_qk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFLYDQ39YSqKAyN3OccWTUEPZWc9dvUDKIi2zjr84bXg&oe=6ACCFBDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdxjHPzd_owQ7kNvwH-nKJV&_nc_oc=AdqQiYvhGDlUU1hLD1G2vXJ5hcEl7Xl6qrwB4TkRq73yeFEwjaRU46hBS5GatsS1vU4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwwOdmoVEMwk41Fej-9153ZGYLEnKb0rHuvcTe2pNJ5Q&oe=6ACCE40B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2xvswNfCfAQ7kNvwHrox9X&_nc_oc=AdrIsE0rGARxQ2oQWrkcKbNesHxQHqfZDQrBVMWEiwQPR7RUKmFHKDrBYNjUkQt7p7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaW0rI27nfG_xMKV6KHEpQZiTKrJUSntbpnfbiUrSgHQ&oe=6ACCEFA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ABA7YQK0OUQ7kNvwGFBWZd&_nc_oc=AdrPs4vxhGQF3cW7dmvpHwee97L2GlVJXG_OhmM_83_545UVymepWzchlY0d47H07HA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO22O8BBwe6z965iCRByBu8o7ddmup8nkjXC8bpaln7gQ&oe=6ACCF424"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tx9YqrWwitoQ7kNvwG8XTMJ&_nc_oc=AdqmM6ZpB4yPFoNUnipxPQ0jevlAKfUBPndmLTfiCimoX_xBvhgiCVSZEU-2ndnJD8o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1C5DjSDV8ScMo9z1h-rQYtJ3KJp4N0In5IpXHXFHRag&oe=6ACD195E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CKFQ6gVZt4Q7kNvwH6ReHV&_nc_oc=Adr473-gK9dbVg9LezHlcG2QmOIT6ECBm40-grjFPORDq81YSQi3JQPh0I4EBQljQmQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTpgZ2IM_E--FoaMSBarSCjdlHE4H83T_JSbd
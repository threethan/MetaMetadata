=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP55QwCSfGkWITGJV9nioD15a8BCfcYFIc613B9foL4hQ&oe=6AD3AB1D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kYbtGDfb0UQ7kNvwFhVIwp&_nc_oc=AdpxyvcqQmEjE-nceAeXuXbB9_sbptmul2vvXuvwd7i0hvC_7ENxprmi0mz5jF6fGTc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdvEUbhwNG4QzD_Wndfvw9TaeYnV_XhF2mK358utOzvw&oe=6AD3935E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJ-rvUxnj-MQ7kNvwEOBQt5&_nc_oc=AdogbhKnIwONOpeVyuFaMEVAKRc1Jf7rRj_-MQLAuQgQtTe8t4--MJm0BGVoKPX85EQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7JNdgAjduaOjK6RTd8ysUns34kP57zrdPjZvNSerpoQ&oe=6AD3B3CB"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ju90AcE6qyUQ7kNvwHcpxec&_nc_oc=Ado_FN3aliuSLghEKQqAwB_YziqETiPppCRElFtrVq3WxQYFr-LGJtkAc2dKS72YrA0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiwKCkgt3DacVxoej38NTdjwgRl_4saTi_Bh0pDOp4Kw&oe=6AD38726"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28zK-P-5IpkQ7kNvwFhjglM&_nc_oc=AdoaVHjYcX3OL96h3lq2lD1tqaDel2o-8rIZn63qBvzmv8WxTZz7qUxNAJJNjhd_DMQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZ_9ltyPhwqQdsjsl_bie4LAz29sYmujdNIVhnBl1rpg&oe=6AD38BA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcAhXuyRTyYQ7kNvwEiAv2n&_nc_oc=Adp7dW6C7X35h7H4l4a9MEDyzI8MMHGg7e1Nw2hoVyFjqU4fSv9mtBlrkflh4xrGVt4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMU2aW0_ieuLpp51J8hLGyjT-3YoKK8TyvpDoOkdlCFzg&oe=6AD3B0DE"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBwGpP2G_5gQ7kNvwG69KB7&_nc_oc=AdogLVUPs62jryWTAXKfBoWd26Rev6-lBq7SGv1PoAEAwAT0cewi78HpI3wu20XFwI0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0lmXZnK39C3bjDDRXq_Lxxkzy62HfhzWP9tk
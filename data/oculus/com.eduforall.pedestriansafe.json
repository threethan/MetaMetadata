=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1O9z9PSJskG8tRHWF1XZrFYbY3H9xB_yiM6GZ8-r-1wg&oe=69DE3BDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXaCUMooNF4Q7kNvwFav-Mv&_nc_oc=AdotEOhkkXar-k8ayvhFGPpPniscUJnHnGShyz5hIgHVz49WcH7nhYXG08A9PDX_cCE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uKfAgeGtLPIIUyZG48onM5V3cVrO_vaoNXiXf9lIZzA&oe=69DE241E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7bdwEH46LwQ7kNvwH4buOb&_nc_oc=AdpHzHkP8fyFzytjcIdDYJjIFdxsAiAMIj_cA-w-L8a9fKfj1JeIZdv7wkTuSuU9rOU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32anoUSidyIhF1d-uexOGuDh9bQcMpL91vCzs9yrlA6A&oe=69DE448B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PARVRPDjibgQ7kNvwGKPiIH&_nc_oc=AdoowVKSywjEXjkxJIzJILFLNPmj1YOMGyN0uAhppZnMPfDjFEb8A8ESnB2PTjAJZmI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2G89kLSTOScvPLnZXusAPXN4_DZ6_6oRMEMtkVFrBwKg&oe=69DE5026"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28NY8n03j-4Q7kNvwHBlhKl&_nc_oc=AdojMDz_NuicDpANB7SVpPs6gXM_94pSg1NH5XiNJ2xsgrEe9x9qtwxy7088M0l6lcI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hMkuO_GNaXwH4jqFs1jjnac-NwViB3VXqmcBShgoGtw&oe=69DE54A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V7khqmPQGsQ7kNvwEnTjo2&_nc_oc=Adrln7fv_NjKbL-QjuLqcsdV91YvZqM2-U8VrWkwzmIScHvoZggtPrMtwoa6iX0Taxw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03bpN4z3KC8ShC9VTzY9GJxoC4UgZ3ybqDx30l8T3a8A&oe=69DE419E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LzwufupMWwQ7kNvwHsyISs&_nc_oc=AdorTwExgvhi4Rhn_pZRitm0aaSO3CagMurUOBlZtl_OKNtg-e7AHJ4JkIF_mHyko3Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09TzOKtEnIvYOaIs-7n-j9ciUMZrvU-5XWHQJ
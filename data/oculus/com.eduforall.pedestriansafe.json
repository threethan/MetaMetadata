=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2H4huwPzKKPtIN_UFvudo3tCoMDsSKxYdSYKkZtCzdhg&oe=69D652DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQNm-3rk-1sQ7kNvwF8KpX4&_nc_oc=AdoEysO6WPrtEZ2kg9C7qAxdJ4jYtr8R9czx1qFFfWOeQuAhIBlZtud23MZ1820X3Jg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hET03zfnCG2gLMqh2UTbyaYSXYZAuWAGskpnSPbE14g&oe=69D63B1E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYEw5d_0kiAQ7kNvwEQ7zQZ&_nc_oc=Adqk0w1BntpWRU6FN7zQbK8kSpwijY5efYbL5G-F0RKVr2BKaYgtTuSYWCWdsFrcq-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kGV3oAmFYstw7KD_h081XXT8A3wzSm28SFa3pv6XNSw&oe=69D65B8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r60yBc46r3EQ7kNvwHBbO0S&_nc_oc=AdqPPrFvNKazIKITsu9OB4DR29WD1-qZVQHVcQPDxtskrMHQcadZejJPLGI3OaabvBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UI2KojWjRQaYTDfrWRp81VBK2e0vJ9qJnk87DXANwNA&oe=69D66726"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUxUAxFz1JEQ7kNvwFLX3tr&_nc_oc=AdqHs6JDbdhCNJ0ESkT_mtvzGaEwh4Dx-RXaSXzT51ISRdleDzPRNjoaUjlunUICQrI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03GBQyVwXDo8IXrLDHkeMbUjBLw1KBOcypBjFOAw3JjQ&oe=69D63364"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yjc_kPBiA8Q7kNvwGnUbY1&_nc_oc=AdpkrNNgPnnQqd4ZStUkIwBApQz0yOS9JovLLMdzhOsn7hcxSqVxrfvQGn65QAVRzUE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AycP526B-CT0kH88Bs2KKv6e--VE7YSZAtr39rLdHoQ&oe=69D6589E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3TdFYYyqfUQ7kNvwEP73VM&_nc_oc=Adou7JK2B02DhU2wmlincbahvAV-ZY7GcKLI1m2OtGA8chWVvRkH5bMiVEbySbEZ0Qg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PhiVJpMy0cYoZzqX24iaLzO-RIE753Khwr6P
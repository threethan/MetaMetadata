qESOgGK9E8Qw7HyCQ&oe=69A6BC47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2484960861698447", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974521_2484960865031780_1569075632799989806_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8fm_cI08foQ7kNvwFBsZ7_&_nc_oc=AdloUQpVk9zUBvEZpA3xRdZ2hjk6kjbZTT7ERJkcnV4nU4Xy0Z-XfcfgYBwqaE444R0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftaO9p4IJw2ChI1XLQLJCJEQ9joTBxgmYioHOr_1HA2PA&oe=69A6C576"}, "display_name": "\uc548\uc804\uad50\uc721 : \ubcf4\ud589\uc790 \uc548\uc804", "keywords": ["\uc548\uc804\uad50\uc721", "\ubcf4\ud589\uc790\uc548\uc804", "\uc548\uc804\uccb4\ud5d8"], "long_description": "\u00b7 \uc0ac\uc6a9\uc790\ub294 \ub300\ud55c\ubbfc\uad6d \uc2a4\ucfe8\uc874\uc758 \ud2b9\uc9d5\uc744 \uccb4\ud5d8\ud560 \uc218 \uc788\uc73c\uba70, \uc2e0\ud638\ub4f1 \uac74\ub108\ub294 \ubc29\ubc95, \uc57c\uac04 \ubcf4\ud589\ubc95 \ub4f1\uc744 \ud559\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\u00b7 \uad50\ucc28\ub85c\uc5d0\uc11c \uc548\uc804\ud558\uac8c \uae38 \uac74\ub108\uae30\n > \uc2e0\ud638\ub4f1\uacfc \ubcf4\ud589 \uc2e0\ud638\ub97c \ud655\uc778\ud558\uace0, \ucc28\ub7c9\uc774 \uc644\uc804\ud788 \uba48\ucd98 \ud6c4\uc5d0 \uae38\uc744 \uac74\ub108\uc57c \ud569\ub2c8\ub2e4.\n VR\uc5d0\uc11c\ub294 \uc0ac\uc6a9\uc790\uac00 \uc62c\ubc14\ub978 \ubcf4\ud589 \uc2e0\ud638\ub97c \ud655\uc778\ud558\uace0 \ud589\ub3d9\ud558\ub294 \ubc29\ubc95\uc744 \uccb4\ud5d8\ud569\ub2c8\ub2e4.\n\n\u00b7 \ud6a1\ub2e8\ubcf4\ub3c4 \uc774\uc6a9 \ubc29\ubc95\n> \uc5b4\ub9b0\uc774 \ubcf4\ud589\uc790\ub294 \ud6a1\ub2e8\ubcf4\ub3c4\ub97c \uc774\uc6a9\ud560 \ub54c \uc190\uc744 \ub4e4\uace0 \ubcf4\ud589\ud574\uc57c \ud569\ub2c8\ub2e4.\nVR\uc5d0\uc11c \uc190\uc744 \ub4e4\uc5b4 \ucc28\uace0\uac00 \ub192\uc740 \ucc28\uc5d0\uc11c\uc758 \ub0b4 \ubaa8\uc2b5\uc744 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\u00b7 \ub3c4\ub85c \uc8fc\ubcc0\uc5d0\uc11c\uc758 \uc8fc\uc758\uc0ac\ud56d\n> \ub3c4\ub85c\uc640 \uac00\uae4c\uc6b4 \uacf3\uc5d0\uc11c\uc758 \uc704\ud5d8 \uc694\uc18c(\uace8\ubaa9\uae38 \ucc28\ub7c9, \uc8fc\uc815\ucc28 \ucc28\ub7c9, \uc790\uc804\uac70 \ub4f1)\ub97c \uc778\uc9c0\ud558\uace0 \ub300\ube44\ud558\ub294 \ubc29\ubc95\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.", "short_description": "\u00b7 \uc774 VR \ucf58\ud150\uce20\ub294 \ubcf4\ud589\uc790\uac00 \uc548\uc804\ud558\uac8c \ub3c4\ub85c\ub97c \uc774\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \uae30\ubcf8\uc801\uc778 \ubcf4\ud589 \uc548\uc804 \uc218\uce59\uacfc \uc704\uae30 \uc0c1\ud669 \ub300\ucc98\ubc95\uc744 \uad50\uc721\ud558\ub294 \ub370 \ubaa9\uc801\uc774 \uc788\uc2b5\ub2c8\ub2e4.\n\n\u00b7 \uc774 \ucf58\ud150\uce20\ub294 \ud55c\uad6d\uc5b4 \ub0b4\ub808\uc774\uc158\ub9cc\uc744 \uc9c0\uc6d0\ud558\uba70, \uc2e4\uc81c \uad50\ud1b5 \ud658\uacbd\uc744 \uac00\uc0c1\uc73c\ub85c \uccb4\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n"}]}, "developer_name": "Safe_vr", "developer_privacy_policy_url": "https://www.eduforall.co.kr/SafetyEducationpedestriansafety", "developer_terms_of_service_url": null, "publisher_name": "Eduforall", "support_website_url": null, "website_url": "https://www.eduforall.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8953687328043253"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1314072930037432"}]}, "base
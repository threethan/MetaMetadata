=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENoxYT6r9U_pwdvzAN11RfyoILaPD-KrH6xOw8ehN71A&oe=6A942ADD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9UGdbT9SSAQ7kNvwFKG227&_nc_oc=Adp-qVSWEItT8DGk8h7iDNPtlzu2D0cRVXmDZP305b3l-FC278tp_dipC8mY28v36wM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6A11ZsEEX-BW2kwIZ507aIrAnxsf-GLnnmobQyg-hZA&oe=6A94131E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bObAmNgHK8UQ7kNvwFMcnT9&_nc_oc=AdpU6jzrCh3NOF5BJ_YYaTtvrhF2UTORmptjc3Exnb2DDjU3KnAuXC2SLKgpbXVli7s&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7f_6MeGy4v_BjrSTG5EvFCB3GBVpXuGkAQp0e9fksZA&oe=6A93FB4B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQMn-t0D8TkQ7kNvwHij8qV&_nc_oc=AdrdARtqz2D6HJWTg27rot2iAMzLHzLvet0dr0g4Kp9KJDIYbow1tOPKymj7HErZZk0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-DYs_iC9Rg_b9fUihYO_PHDQGWsRwnuLe1QLHM2YAPg&oe=6A9406E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhDvTnSo4BUQ7kNvwHNhotE&_nc_oc=AdqYeLeihGU7Mg1FkGJIpmXTdNRgFFmi9oH7RgnkysWwEUczKgsWV4TtIS-kr5YWOvo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYNR1bmuKq5V51EYL8pSISG2t7QWhTgwiCZj6Ow0XnOg&oe=6A940B64"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8EBWAZwcQMQ7kNvwElSKG0&_nc_oc=AdpPVXSHQ5BK2kpEKYeujt9bdRh0o58uZZF4Boafrc84YZAu1w51mN8B_acc77YD8ds&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVhsvrkfkn129BegLqdtuw2VmIOfyXCynkq6zNiuJWJA&oe=6A94309E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XplpPqW1-bUQ7kNvwHbXMvm&_nc_oc=Adp4_95MvHd0pNZK2dLmE3rGtASYTJ-0MCorcyqt9hM0INimu3VDhJt6Hmcue9UC1YI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeZnEtMyo_zmOoGNuM1ZwZamlcI7JCnhFqj-d
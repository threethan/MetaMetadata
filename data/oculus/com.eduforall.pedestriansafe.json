=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXPBUiGCxB_UJ2AWu6Uw0fr8_i1FKb68TI8HBZuRYjlw&oe=6A884D5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG2DeYlq684Q7kNvwGnC7V5&_nc_oc=AdoHaiOUAAwleLMOQUVSfOeqosU9ZYIioOUMjeZ51n8oIICzvRgvrW7EVCkMytZ3hmo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEHLw2GOZMCX8Tam4UpA4nE_t1wdCL-40C8jKsQY73nQ&oe=6A88359E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTE9MB3g9JgQ7kNvwFDoful&_nc_oc=AdodI8_Fc44VKMIbHVHi7msXQ1HAeRZwv8BejjK3cdMiDHwPBQvKgaMUK7wxhNA4yGE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmRtcQcqNF2GwnXnN5fKp30y7I3U6Ra_pejrRo0mZqFA&oe=6A881DCB"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTxYuhqFF3oQ7kNvwG_xc0c&_nc_oc=AdriusQHa8A2spfGvwZos1KKJq_cFffOaquLmIsoCBLP6pzM-Bo5CGOMBSieRiSbpbk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZEvWtQR4WFqhoZljRhFS42QqzDqtureqR_b9-dw-W-g&oe=6A882966"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5K2OuXmBrSMQ7kNvwF05PVC&_nc_oc=AdoQBeTHtly6XG38r5PkTKM-24b4sJmX8PL-QtCxiNpSCAsV-u1L1Gj8YQT__waq0VY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa8cNW2W4lB_o1TgMxGAe7scHXXg2oA_kdorLFjwDTNQ&oe=6A882DE4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYJSgGckuaEQ7kNvwGyno7x&_nc_oc=AdqJIPts8KhwZd-Qgh824pCyGKl7KPNjAK8ER0Xzi20jMrADo-XLFB8y5NmNWwnaNg8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeKukNlvVas4hyzd09lh1g8hIq0ZKJyN-XijEEIBYsCA&oe=6A88531E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGdc8FHnoO8Q7kNvwFntLco&_nc_oc=AdrSSf6ElhrMBUKao1pETuO6Aya72R4meQ5JjvFNZOCTkDX-DNl4PqlLwTC06fUG3Wk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVgZfUwBw8hFT7HgNBA0py9IEFlMMZPs6qUd5
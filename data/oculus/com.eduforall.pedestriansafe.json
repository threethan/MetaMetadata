=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ2U5VW82-iCGqJz2kjWRrOZdlpKrNNyP2iOfhxGGrBg&oe=6A8C41DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCwdrCrRqvsQ7kNvwEugmoE&_nc_oc=Ado9Z8Cyvpt8PbQ22MWJL_N1KAwgQf8v09AqKtRbG7cGJfZY8Z3T_awyp8FdKiXLjaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2jW9l8qG87G7MNwskBsDAl6z6RTC1mEvCZRCllHSP-A&oe=6A8C2A1E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCK1Evxk4zMQ7kNvwFD4zaJ&_nc_oc=AdroYdWiWhjUIjPzGYoCkgvytcXYPeXF1jaQlF5d0N1r7iSo4NfTRENTO2_5Goy_Ye0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD0iaxvBvcBiq8-EgDTq1rWwIFNQFpHIgWu0hmcSGCtA&oe=6A8C124B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2BJB1Byu90Q7kNvwFIpv7v&_nc_oc=Adr99pfJOoN9nzOLd6OgTpBggIri4LTRR3FOqUM5jyOK-LHE5aPjtcmnCHv6DX1Fm8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsbV4niUXjYoXUo6XjTAtQy5Y-AcILo-NdE96glawghQ&oe=6A8C1DE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLDAF80Nd20Q7kNvwFs2f0W&_nc_oc=Adodx5v-OvjYe25WweM85HAql2RMTBCxmN9k6g1f3KXDWVhj8Yvd0NSuBF3RVsb0eb8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIun7DAE92Ibnztqpa2rFjP4Z-B-7SclLQepoeNXaV0w&oe=6A8C2264"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1QDrZ5c4fwQ7kNvwER0Yup&_nc_oc=AdpgTvYKJf22LwX0faMPkGbswqXg1D1B8jzi-0iu8I7Cgl94jqxfg74WxDhiIoTQO20&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFQqRu8yzpD5iX-XyG4QXk10LbgMeWJExEAuP3ZSwbDA&oe=6A8C479E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSQDO50Nt10Q7kNvwFosX43&_nc_oc=AdrjkaKfKovF33hOxLVEjZDGEaci0tIUFtt3q9W8jXG80PH7GT3Xq9c4OhYcBA1fxAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsfiUhrtipqdNl--wpLBXYL3ZOgQwR5-3cpqH
=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0S_ArLtz-MJKxc9aURYssO3a9evMZORFcsn1ykv9eMDw&oe=69D7A45D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1hXuvYm0vQQ7kNvwGIwzCh&_nc_oc=AdqHmAD9fdLoHxPOgt-VQ0OcnW3at1xXlnrGw386vkKQszZ_brVwmI6F6fjsC2eM6_I&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34lv1Pw_wiaLr6a033_nImCkN6ysinjtKG21TPUrgKlA&oe=69D78C9E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4B7eMaZiKwQ7kNvwHR8Dg_&_nc_oc=Adqgv94WrhJAudsiFVnmQGwVEcijDS4kbDqj5bcJxT65a1NmsxIkDhDgDIaqEVtB7qM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18L5kam6tO_Mt-rGlEzcUpnh5rZLKdTdPmbZI5k33knQ&oe=69D7AD0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r60yBc46r3EQ7kNvwFAHNxM&_nc_oc=AdrYt3iRhL6yB8_H62EDvdJkbJ0mZcKFIbyXwvCLv0sZopFve8XL-0HgVjcSQncQjS4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cQOAduW8rhjHGPCaPqIcwTDkKXxSyA1V83SouYUMa5Q&oe=69D7B8A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaO-N7Nbzg0Q7kNvwGqjF14&_nc_oc=AdpN8Xv1AixkWKcSkOa1u2sBRpdNM3iEp4VH_qawFz19OuJb5Cv1NH-ngdBsrnvgH3g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0M86L2mu2Umfi13GHUsdr08gen6tSvgiIDMH-Od2SeJg&oe=69D7BD24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCRzsOs-8ksQ7kNvwHEtrQH&_nc_oc=Adp-EV7j5THANuHsVttwJGPmNTgVOQdYJ2c4Ew6SfgJLnFIVyefH1LRrOtVf4Vq6qco&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15091fkVk7lCN-SQwZK2vqeAeQNn_rHnwe33HNEZszSQ&oe=69D7AA1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3TdFYYyqfUQ7kNvwE3KTTE&_nc_oc=AdqqY0N4qvyjOPPXOOo4B12geJ8lSp7v2CsdtiLKQo3afeCt0qLoXrXFCmvrRx8vPxU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RF-SR60ayIBpUFeELs4ysZwlKNfN6L9RTUoB
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL_bj3qrC_9hagRlK3X7I6027xzUWklZVjzhgxxRaC2w&oe=6A64B4DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsuHXa-ZPdkQ7kNvwGa488Y&_nc_oc=AdoQEgoTrwOcuyvjb2wbDpXV0zyHS7wC73Bf55Mq6plmyPBst0HKGvUFEVggzb51hLk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0rWiQ2XPvxjjX9TJ3sClZbjKBBiRUgjuJzPcPGwyO1Q&oe=6A649D1E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01cHuNzcYQIQ7kNvwFSRWo5&_nc_oc=Adocc1B7HCPXy0IoeVLcnkvA1VrlBbWlkPnEGLOvw6MoHyu82eQX1RW7GsOo-KQHyMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIGEKynC3NUzfObmdsMZSjl5J88rmH1YqIj_E6VZedYA&oe=6A64BD8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udyVMA0KzW8Q7kNvwFbqfsA&_nc_oc=AdqrL84NbSgY4eT9ApV22l0AaI1RpJpinIXllld2wJ0ufVTAd5Q5x7lDclLCi7S0IHY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6Si3bCyE6pCaSCYT6azjwEJU5S3v3LDeNi21I3XQr7Q&oe=6A64C926"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0M7hnjDHikQ7kNvwF1tBn3&_nc_oc=Adrf9WsmsiHNZrgpiQ4U6lJ5Gjl5aBY5-HLYkvZz2nIcv0wunhlzr-plyVMq_MFRctA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCDmrFOOO3hWFl_85cUOQtpHMLMFxoLkk0AsxHcvjBbQ&oe=6A64CDA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bk6JdyoN-w0Q7kNvwFqxa1L&_nc_oc=AdpvwLjc07youNkhHuessNn-BRHymlfOyTcAmX9JXE9dOsol30e8JHHSAvxNNgT_qb8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2sy05lPhx7Ub-Yb5PeAmTcrPsjrCyY1j9cqIgJON2eg&oe=6A64BA9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaqV_F9yWl8Q7kNvwGx_pOg&_nc_oc=AdrKOX2H9nM7UWeS3mvq3Zw9DCozF8NQaAEnSvRvFhv4o1LKZpkIwQxwzIbnjO2SAT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAX_j67O0mRxCW_Z4zo9t6jv5qSc0lAH7tAlnL
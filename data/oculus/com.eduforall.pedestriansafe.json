m&oh=00_AfvPOagnUHdCzo2kinVh2jK2rxq6LlZVy3psUJjcaGlkmw&oe=699C391E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3x0G5oYvHaIQ7kNvwGKx5wc&_nc_oc=AdnQ5HpItU1PHwRKKX3tcFlTzb5F9lX5MXSrdxuRauTCkTvGUkySOIWPgmqqNDxA3bs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvUAR_Z0kt-disW1V7SVwQ-74skUSEWT7Ko6Ja7F1QtaQ&oe=699C598B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvpbmUdMQNgQ7kNvwGqe4b8&_nc_oc=AdnfbSdVDkSdqbUubvDa509iEjbNLzGZNc7u6HmnWt-coNLD6uR69Q5ora0sa0GqYNI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftnsZb0vIywIlql_4pHEH8PPFdhvew8HPegvpl3cm8zTw&oe=699C6526"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=munmAOYTLakQ7kNvwHGB77g&_nc_oc=AdlPJ-07nTpVScB7b2tcrCCAWe7-HYo-NWdsMZManI0KkUNZKw-8uaIWwc2s3PWA7tU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu57wpm48qd3c2cW9cRSF1bljMmaXVUaHhrpqm3MMepAg&oe=699C3164"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLfsLn4HdpEQ7kNvwHjjx7J&_nc_oc=Adl_wHmx1JylDSdNacutilOXYXzWkQfQ8ENZkmqDGfJbr4j-CD4y6T1mNWF8tC_B6DE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvcnytKFAIQNbuHxLvAxQuNdtvGLoOkZSpNFPpaww-KHw&oe=699C569E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yCkHyPiiwQQ7kNvwHZ3Az0&_nc_oc=AdkQw3FEhAliKIefQx1A8vPhi_PvqBryW-KUVvv9ropifawuK33pRXpWdG-x3vNswxU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftVY0Z83RLak6y7XFNaKK4SgMmEwhK6Wq1BsjXXVHPbpw&oe=699C5484"}, {"file_name": "[\ubcf4\ud589\uc790\uc548\uc804]\uc571-\uc544\uc774\ucf58.png", "id": "1843110519761474", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974788_1843110523094807_6196787795280771349_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wASdz61e9EgQ7kNvwG__6Jf&_nc_oc=Adlpihyy2MR40OHMsPdFEFTvHsMkQ_HYQLXwRNhYnM1Z-vBVRuf7Al44ZXOJf_aJ5YQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu41oSFV-cEr3Xn83OUlZrpRi9TEVkG5OPVHQD2jel24g&oe=699C63B4"}, {"file_n
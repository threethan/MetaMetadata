=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77tizl_DglUk8LUbbvUgd3gOXB4urJE5Rh642O6f3RwQ&oe=6A0082DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyFwfX88alQQ7kNvwF-RNxP&_nc_oc=Adpg6ORZqzbsLZ48TJ4mekMv6y_vwfW7b2iLmPqmgLJWB6imRw9xnaynm4ioFKaQwQI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LqGpA19QegktYmdAu6wxUZJuIT7kkiuR6YzunA0ZVKA&oe=6A00A35E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=un2L6BYAjEcQ7kNvwF9Dvnd&_nc_oc=AdqzRjZgzBWYFWnC3iBnLyyZj6oY1J4czAly_MtDZVz8O27T4Ke0mpS_VmgtsKwISjU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GsGoz0hsVAIL2akTe1F4WtXm7WHWYO7Y0yGRsG5ze6g&oe=6A008B8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxJKFatY4cEQ7kNvwFdS81u&_nc_oc=AdocvQu3lnW2ZfkD7d8AtSEsjnPZR8avqH-ou55Uj1uP2VViWpnZv98TYqPzFEkyLcs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dJzHN6To575IBfobJERS6OFJNRYWdhVHsFh0mHlRjqg&oe=6A009726"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EURNhUHX8nMQ7kNvwFiMoZj&_nc_oc=AdrW-ZyXR_6wRu8NVjWRHOSkc5zXcgaUJ7AVADkF3_4huwSYEyIQYBRfrQc8PGwRGxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4x_cXNYhI9aVHRvILGJv2_IsxQvZiiuYzoMWFw2FIdGw&oe=6A009BA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lCRdNFIaP4Q7kNvwH4KmGM&_nc_oc=AdqugfxcGXIoCVYtlE4uEp9lP-Gf8qBPlzVI14BK2aVKsrnmnm8WDtwxhsYfgkeQy3w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z547Wl6j2oJK1LvvpRUpvXzSFsN3RyyFTPlQ6L5kImQ&oe=6A00889E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CQLxfaHQ1oQ7kNvwH7Opv_&_nc_oc=AdriezTyiJRy5_C5nfg3LIn4ihrRhu3Wsa4vuMI4pCtteRRY4Knw4x_q7YDRnbHgVRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W4dJZ1B-w9b9aJGw_q0ZEf0H-4ydBBHJOIeV
=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7BOo8Tb7LCShJmwpi6lSZXdehMTDBvXRgUl5jC6adqA&oe=6A5B7A5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ftsfou3soYgQ7kNvwHvKgR1&_nc_oc=Adrs8D8FykE5ruN56LYHyrvEpQTJCmCsMmxI8QpIyXbp6OIL0wz8kA53A4aI61lRbbw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3MUgAesSxMGOCAxUJfVWkLuWaLpYCxbHcxWXi2ITz0w&oe=6A5B629E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaOIlG2Ps_YQ7kNvwHLzaOk&_nc_oc=Ado90wr0q83Wu-Va5es7alhZVkuKLaz72PgyB4W-1tDMdb7IOaUGpSQT2gHPR_loMjk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG-T6aDfzV01ECJRQOagT4biFyWg0KlUYyqvJRjolckQ&oe=6A5B830B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSwXvsjOMQQQ7kNvwFbABRc&_nc_oc=AdqsKBl1sTGx_S417pAejt8vFOp-jFCLFOJ15vw-QiigYwqY5zvO33xi4kIv-t3kqD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsbMCfQK5tg4iWLJqg15YAYCN3bNXSIx-7wZ1fGyJO4A&oe=6A5B8EA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zx1cOztwozUQ7kNvwFzEHjr&_nc_oc=AdqMEe0TXkmrNFvtS2NiHb-THhtMpRwXHDugbEGJW27jearKGoIRqyxWlF2VlsJ-GYU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADC_u_2YF8-5gdXxwNxVXi8ICobix7jBv5Mw8F-mQVZg&oe=6A5B9324"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcKQFezTSjgQ7kNvwF8GLHr&_nc_oc=AdoZUE9KygPXQ17iE7tM6MGmgCrAv8RD3SSHXr4yBysy-hFlS0HeiK5CNeDLSWlaz8s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_3XiCRrUB44TnxXR2VeaNtN5RtnYCkfZfdZLiq5s_wg&oe=6A5B801E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CS1qkxY73wQ7kNvwF6zXQB&_nc_oc=AdotFYE-lpgzuNQf4PGBuFs9lfVwaKwrTlSkDJ5hVNkcQ8ullRLn10KwzXhhckZjQtw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoyY0c62TB8tdlF1Lf5O96YVeskBt3NhvbnKv
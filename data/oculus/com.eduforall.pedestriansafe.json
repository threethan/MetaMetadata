=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5Neu9xKYUgYG3rhGLMcqOlZnHSJ1zd0zMrGxSvrm4_g&oe=6A7B1E5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAxZc1xj5QsQ7kNvwEEoYou&_nc_oc=Adoxjaeczs5JM08-Tgg1CQSP8yWoIgXDXv_wWN8dM1e5Z1hcUMV8Bk1KIyo6aNtCrG0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi0qJO1ZVhY1QhGPyqt9sSvS79h1z3SCI-yifssFqdzA&oe=6A7B069E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vZ69QlPWkEQ7kNvwGlMDde&_nc_oc=AdpyJI-KMdz3kOKAsaSZ3d1gdi0keph6E9qpCEK1BfuHTZtQemWYeX553iv6vvU6REI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6PiPy9IBL7IcQ0iu8LhFAojG4fOI8lXNUzyB1atBpbg&oe=6A7B270B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuZaIHcMS1MQ7kNvwGOFxw-&_nc_oc=AdojLdVRjM7AbRFDu-Etg3F_mhACtA3M-3rN_sVcl0BrV50sn6A6BMsirohdl1q9OCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPejovl3W5Wl9crjzBkK_v5ERRXFEcj8uCOJUW9eRrVw&oe=6A7B32A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyoiZaXCBIgQ7kNvwGVEPl1&_nc_oc=AdqBX9fpn4-QDcstlRpAUGtT2gpf1HlbYBVw60pqPMUjQsvjfDdUetW3roEKDOxGoX8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGu69SPjkeu6D9AMbwNrzG4sbr4ZEdlneVpWCSa_s115w&oe=6A7B3724"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9ymGTWM8ckQ7kNvwGvoSR9&_nc_oc=Adojq0NsrojlrV55tQoxhT0ECa9YpwugBnCnwQw7pLMcGIRY7n0jm6fltZvuWJLG740&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMIrmr242QapXwFMiCKBUPFfFZDzK1QwL4YzfqkEHhDQ&oe=6A7B241E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaHLzcCUyrgQ7kNvwFSfrl0&_nc_oc=AdpgFjofdGCnnllH5K9OJd2M9VJ5aeLViw3utSwJwbEGm6vYQKnSmXRFPRwstJm64Qc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEwlXoc_a8_6I8m4QuydRkswZb-GuR9m5NeT3
=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMotJ8OVPpMDnPH7zOjL_awSReOHDOTDDxFMnec8c_pXw&oe=6AC8E6DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBYNeopi-S8Q7kNvwFAGB-U&_nc_oc=Ado-0SPRYG-3t0A-r5wyW1qjOZVwnAl9lIQyxVHxD3Bk9JYTb3BesJVO41vzgvkWJj4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIk4BMCj4CM1qQK6ZIDzNgrmjRJLkYcHtlMp9AZY4qog&oe=6AC9075E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG1NbqdMcLIQ7kNvwFBEd2m&_nc_oc=Adog3MU3jD7T3OwLdSZdkakbakPuduIdasR9vra1WiB0a9VXA699qeEdEZ7V0EW4yNY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWJ4qOaM9_T1yIpbVC8d-4Ah3qLO66V_MNvk_36UFhBA&oe=6AC8EF8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-GO2cAyrWAQ7kNvwFW57IJ&_nc_oc=AdoyCWcse3Mg9AbbsixSydeMMOg1rwRc8HvTj5S0iYO8Uo4dDH9BhzDP6rrMm9jV3Tg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIkLrgfz0w4qBWpk2COXl2UOQ8OgTDHClnABnwDTJUyw&oe=6AC8FB26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=libgFlOuFNkQ7kNvwHyYQxL&_nc_oc=AdoExdJ8m2PcyctXtATUvGc4qja6wMH1eB1O9AjDBrha_IS_JG3QD3GdxHkH5EP3w1w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMELl1ilbxTQtgAVCyUZorLst1Y_P399SzJ44ukg5gAWQ&oe=6AC8FFA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFDhrmyT8D4Q7kNvwF46UnP&_nc_oc=Adqq29vm7YQWLmkjyL-50oOA76iVKbmCWyGf5Ilv6qiGloos0Wrvz5tVUsxW9PgxQKw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkF8Cfis_S2ZfZsYePYYAHveImU0mk6lS49pKQJg2qjg&oe=6AC8EC9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsOZyuyA_dQQ7kNvwF08XY4&_nc_oc=AdrnkBxyTvzRnwJiWoNdIQgGiEeDexTB3GWmss1uEuCzhgk82LUBZlBsIUkJ8LjL6gs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOynPaiXNU1qcc9_0rA-Ck-vadz6BXUeOLr96X
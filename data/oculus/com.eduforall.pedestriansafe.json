=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVx_RknJKtkUVne7aeI6VN-YJlPncfnWoKKBOEYK-qsw&oe=6A523FDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x01Q04O6DXUQ7kNvwGwxiYJ&_nc_oc=AdoF8cHsMimPOLkNS0rH8icxHbemey0bo300hxrSGA0VGOciZ7h_LJsazMqqUn0bL7A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0E0mlEYgwL0OFvJXHhMpYw2Ju-7yC5QVt_ECxhK9Vww&oe=6A52605E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr0wvKiMEVgQ7kNvwEAxA3g&_nc_oc=AdoVN8uX1RINCwXQYOpE1LITl0fWyLYxs0nvSQO4sxCpyDTADY4q84w3RTAIgfi5d4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOgIVX3NolnL1K52eX_aKg5Zn_E0z-ihn1-45efxXTjg&oe=6A52488B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFykuBQrsnIQ7kNvwGcnpjJ&_nc_oc=Adq1HiL9aGEdA-aaZRyxHYqgZunUHLiD_kRM5JESl0qLmS-n7NitVFPH_IzxI2BBRiQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBMKOSYTio1ZCbVTfaDOV3GcS2c8AqRHACgIEKVP_FZA&oe=6A525426"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AtbAVLacWcQ7kNvwFUy_MQ&_nc_oc=Adp0iEvlu_gvbJ5JiRZC4s5eWsHJdnAcnHZC3fazE3c0-AkofloLA7zz6qamFw85hyg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABXMnH1bJ96l-9ky-eXjzu58xuQemBmo9jeT_onQb-FQ&oe=6A5258A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkoxjNqUB_cQ7kNvwFpYN3u&_nc_oc=AdrPgHAqHq3sPkajHH52EsvQu6jaY3EFwEihUr1xCPTYcnpKOKdt3f2C6MxWt8Kr0WY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9HmLjHHDyplOyjg9POI_6s_znnIivKJJcz2tvnIfkuA&oe=6A52459E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfLteVpDP1EQ7kNvwEaVDyr&_nc_oc=AdqAefZjqVMaDvltKryZMWo-IlBp6FyvheZEi1Lqz6u2R9gyNDs88JSQSE31q20ykXU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1U1CDpdvYb19XZqhiB5J4hUFAFrxagmfZDOx
=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AvoEawqxgzuU9iBAVaOdQOCrvlRGkEBTCgQ8rV7Cgeg&oe=6A21785D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8s4OcjELzfQQ7kNvwHJXag7&_nc_oc=AdoegQeel_wmyyA8HYUIhMAdVX2KNyzFU_eGaej8hEScO6J1CYoOTAzrxTw1vzCDsXg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R3lkDZIUG1urlazp-ExUrvUIhYzN3fzG_BP4w4Omx8Q&oe=6A2198DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdqOdbW3ZmwQ7kNvwFg3oOW&_nc_oc=Adr3hNYNwY7IA9SS30j2PFHqKMnvOdUtpBE-T5vDUjhaLJnn1yK-CrITJes9uNi6J_4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_r6k3NYd7joNv9MlrsZNg4f_9MyybCjfhF62onN5xgrQ&oe=6A21810B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8GFF51qmhYQ7kNvwEyZAu8&_nc_oc=Adocg86cADbB-DxqLLsBWLaDjffl3JxVM-ejSdXidDEiJ_DR5_NFbRHAp-UtQqwZH0Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A--QpSlgVUFeA48x6mi5ia6bCUxB_PtIPjR8yivfcYQ&oe=6A218CA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cQwJwWm3fwQ7kNvwFEeUdm&_nc_oc=Adp0fC3_23yz1vLZUCeV5V0y6Z7F1cHbrZrGeF5qMj4_NBCjozVh2NViS0Ac9eOExZ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94elwLIrlRLqa9fNvP0DEE7_rLp4ZjCkW3CppFy5qlCA&oe=6A219124"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFqM1hajD-QQ7kNvwFsky3j&_nc_oc=AdpUbHoQLCa66bt5tW03cXP3Ai4n8Mw8kIruoNrJslkHFdsIDoXVLafmnNX76xMrZA0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ne3IMW6N8pnx6UZyLsr_aph_XUHYm7IXbgdsEi8yXqg&oe=6A217E1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SN7Kwq4fQJcQ7kNvwHZVjb8&_nc_oc=Adp7cIKLi9bl63k4drVNbjkapMdM2gIUbONjYqLBFdiMQeuZyxNZSRRh2qfYcdGBP7M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ErDp-1PJxuc56twePcNTuWsabr4k9GkqvhL7
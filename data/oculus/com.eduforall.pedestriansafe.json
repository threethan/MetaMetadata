=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxku9M0vu6CS1b74jL4GfP___h_y1hAMOsxkXgP7Z9Zmw&oe=69CA755D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29J-2mbKqOcQ7kNvwGxizMj&_nc_oc=AdqmLtbprCTrRTcb31jGWkD0tMMz34SwBUaQOX-O92rBhnbW28Hj7U4KnsZIF-XQw4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBdnhu2k0gSj65ma1cr1rzNvVOExPIFexsW0t9rQexqg&oe=69CA5D9E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tB4utyUkXPkQ7kNvwHPqMtT&_nc_oc=AdrA-E2ZzGJaz2oPU8w4FygXZstMexV3DgiCcdFm2_jnhBY4XkEU9BfsJIIMDSqsdHM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWXCrYcQyasoE_krJwQOENjX8Wp8XnwOIRIsqxqTGZ6w&oe=69CA7E0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abo69GzWIpQQ7kNvwE9pIf3&_nc_oc=Adqh9lP3CSO8RELkOxE_LYG81PXhs0Jld0WuRMu36dJuXYh4F089JRHmVGudj_Ih3Y8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyheK9jWeho3qOlX7cuyMOsqfh9y2jiA-mv6cdPu_3_SQ&oe=69CA89A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmGek2QesLUQ7kNvwHnBJnJ&_nc_oc=AdoNEUlCEhlbkqw7B8RAiHd_V9oYAw-MR1EgSLehYBq73x1Ae7CtMUHwzpplLXPPNcY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTbuaEiEGHUIlX4aaZoFLJsjyBv_pRHxBy5xrfOFo39w&oe=69CA55E4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgCzG8mq64YQ7kNvwHaB-GX&_nc_oc=AdppmlO2obZJPz36NLtWmjdn-bfeq2QMgwJsL-KSlHZ20x7mgIHqbvzyQY4343p8Wf0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybRAgQPm7C_D-ew5MseTf57AX4DLfv0v4GCoHScvajPQ&oe=69CA7B1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rm_WyO-4hCoQ7kNvwE9e115&_nc_oc=AdpZUQuVrCAitturpQoKWfjTSSj2ORIFPcexYnHGLNgVLR8MMH98QqTDAc0dKI-xJP0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1tdnEXDPvAMdQD5LWZt3yngxV9_EOPkcg-a4
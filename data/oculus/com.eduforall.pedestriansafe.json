82121187132_8308184151168799368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWDrMJDlxsgQ7kNvwE9tVgq&_nc_oc=AdluJZo0yhGZ25M21tO7B_T4PBcRD30Ap9Fr08nCLCYwiWo7Thlx05HzwgRFwopaRPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvdPRmmbVrB5XqeuhKstBSUL7UucYN2KKqbtUlmjG3Rtg&oe=69A6DCDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBLEbgCR6zIQ7kNvwEIu4ce&_nc_oc=AdnrDH90PavN8OkTVtOJ1eb1FM4p4UQBWxR1RoLCrdux3aCRsCMKLIAlLy4gzWP7Qo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftmfo2ZF6JS4VWCPobP5N8B9QKmtMKUynVErWAg7FPmhA&oe=69A6C51E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuzcfR9-KYEQ7kNvwGdiz8x&_nc_oc=AdkwAYnCgopEJztcawrhR1Tujhia39w8jIn_T6j0BJLF9hJK6I1d8DjzlnhFUKy3n9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs-y9ha_AxplhIVMjlcIbePfd6caH9lY0QWDvxKW5o08w&oe=69A6E58B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zGb22p-I-4Q7kNvwG4UpmC&_nc_oc=AdmBcdwV64fM_E1bcLpcz0qrYMjnK5NqT2NW_fPTKjGJew1aVCiF7JXa9nO75sOkdAw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuNMCNeR8mV9IYKkbOihT5BOH37_e43BNfOyvbDxa4b4w&oe=69A6F126"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ts4_1gUk8ZgQ7kNvwFw-SK3&_nc_oc=AdkDJQaGtuxFSASGTKe_M0FnFZkPxr5EfBR9usePeVfDmlzkwH5Tc8VyjAj0gly6wlE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuyOMqhcAUsjzEkpZ6W6EWlZPiyuTlu70zJ5pDiOEUlnw&oe=69A6BD64"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}]}, "developer_name": "Safe_vr", "developer_privacy_policy_url": "https://www.eduforall.co.kr/SafetyEducationpedestriansafety", "developer_terms_of_service_url": null, "publisher_name": "Eduforall", "support_website_url": null, "website_url": "https://www.eduforall.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OC
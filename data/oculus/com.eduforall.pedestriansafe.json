=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEyBxa4EWAs1g3pmDVBq8bVTt_HD-3lCgGmupjQwotZg&oe=6AA69FDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKNxNSZRaEgQ7kNvwEmjYpU&_nc_oc=AdoRoMCAzBpIgYMhEOxnbANCU3ZPC2CpVbfZxkpogwRVY_pOPuzG1EjhzXw47JOGBYw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7EZx0xzdNBOZtBpS7ZwWKzn_zKtyKJ7Gxf13RuIpEVA&oe=6AA6C05E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hs3nnUB1HkgQ7kNvwGs9lzk&_nc_oc=AdrvYbeYTOwHFEgePp3Hyj5bMNOpJgTgPE2MxKuHm-7breSgDDCw-c6ae8Rm400b9Vs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpwv8pGmtWoo5LeEGyh4dFtztZ-ekoSZuss2z6UbLdEQ&oe=6AA6A88B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rg9KR0YWrJYQ7kNvwHKDGJm&_nc_oc=Adoz_yyqt8_n966D8bsnBGVhoktTJq2GnjGL_JRB6CxfjHH0VBipkzEiZk1n4NaChPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeAKvHPWQ92EZSHti4s1M2_7hi-9rZ4360MubooNHyMw&oe=6AA6B426"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iMYBodjR3QQ7kNvwHEQVbe&_nc_oc=Adq2xaj6N1MZhZYhTkB4BGJGC0eR0pKNyGPbPQR2L_AxANDn7_-PzGRjFYDYbOCqoE8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgT3MwynLDL04pekbBLghIZ1g0XzpmRcX2sk-N0B911Q&oe=6AA6B8A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gp3fILMNVUQ7kNvwE5XCYW&_nc_oc=AdrHtSnz19TjYLJtazkP0rs3Yu4e_f-yb9ngIK833gNqc__nSY6grEYV3sKO25HUPZg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSWMZ73RDbgrL4Ehtl_YGFIN8UjbHdAPrtftju7T1wvQ&oe=6AA6A59E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rV2UzsDnQEYQ7kNvwHWIjmx&_nc_oc=Adp3luPeVPRGLIb35KsCwlIUE6KuiCKsziPhjhYshE0kNIrSwCDxVK8tXiF5o7GpAR0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsB4mosRUUWT5prNU9TodrQPUIf01gs5U7g4d
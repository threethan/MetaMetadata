m&oh=00_AfuvcvMvg60wnsm--sUpyHd5hl-h9ZqagivNay3qX2RLYA&oe=6998449E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEISuEZZFUsQ7kNvwEkXDgA&_nc_oc=AdnQDSwMf2T9l2SVs_STUA-6xhaZnUBQ3rzXISVtukOcpsXSD5QvoUQHTzVGQcmx6eo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftLhu6EWt43hF9tqG2tqZrulwlKQ0l92a_A2HTH6QnkbA&oe=6998650B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ks8l-c-9uq8Q7kNvwGc7AvG&_nc_oc=AdmNlSo7zLji-17uYqN7nwuZXqehRrKi0vy041-Nf8T_jRzjfljYxzdAdT2eqiASOpw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft1wJRJLncF2DuO3rgu0xbFtzu_h7zwNak8vRMa2851Dw&oe=699870A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcKM9fvi3Q0Q7kNvwHVyShY&_nc_oc=AdnhELaQ0flpTXCXok2HfP2dLdUwcT9fKhmfsG1ayr6UkE4Yc5EQA_HcZpKo6BoAKx0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsjQZr-TvdwIqOxFpqkglXS4S9M-VtsYaesaoZLeifa5Q&oe=69983CE4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLfsLn4HdpEQ7kNvwGWcwfN&_nc_oc=AdkxGGYCx9kGhiDIKcEZuzOaIRd4phTkKcKWwSYveO-h37uwWx1wLevKruxYXMw4160&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsKmTLE8KemoIJQPq5v4Mxg8e5d7ZybjERdspd9Sc6Cog&oe=6998621E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bf-vz3sL9N8Q7kNvwHCbXTR&_nc_oc=Adm1ctK4mZ-gDd6l_OUnoEQBt-1POfzKkM506VEgJmi3oHXpaLkKQGIDrpX3-3O9XaQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvT6AxmC10ARl11U3aj0lV-tbLWlqzOZm6AdRPMeFDGow&oe=69986004"}, {"file_name": "[\ubcf4\ud589\uc790\uc548\uc804]\uc571-\uc544\uc774\ucf58.png", "id": "1843110519761474", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_1843110523094807_6196787795280771349_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvLM_8i2FxgQ7kNvwFJSKpQ&_nc_oc=AdlQ4Sunm9nZgM3TpjlBVwUBQBWNff0EoT3n91rut2BuxzTco2qu8T69z0HAIOr2lPE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuGIxSI-psGit9n474IVBKavSSYjSd7h1NZf8VKmBFqEA&oe=69986F34"}, {"file_n
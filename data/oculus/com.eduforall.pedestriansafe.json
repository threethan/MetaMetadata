=1-7&_nc_sid=6e7a0a&_nc_ohc=-N2P1gWWc_QQ7kNvwEP7avU&_nc_oc=AdnhvVQm0Z7CJxdNqNyBUkvAABQ5Us5UNuElAOJwqMSI9PEBDxwuj3CxWuWSOKzxrP0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afze9D7hAdMpMGZMuCahIQkcs0NvbE0PnyqLXTm6oi99aQ&oe=69B53DE4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}]}, "developer_name": "Safe_vr", "developer_privacy_policy_url": "https://www.eduforall.co.kr/SafetyEducationpedestriansafety", "developer_terms_of_service_url": null, "publisher_name": "Eduforall", "support_website_url": null, "website_url": "https://www.eduforall.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inter
82121187132_8308184151168799368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWq99aGOssUQ7kNvwGdwITL&_nc_oc=AdklRDtMqVK7UwAReA3I4KcldJ6xsODkgcvtwdF3F4rYLhsfqq-ZEtwofPI97vnv410&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsjwTu1Gp-ZxdB-qp4pGyQScoPTgt4PzgRv96nJUvAPIQ&oe=699C50DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuXxhgeppyQQ7kNvwFioqp-&_nc_oc=AdmN6FUv532oMhTHc2aAbUhtIpE4nlXJymybd5yd4E4N0OmWf-e4CEiX8twfBkmAm0Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvPOagnUHdCzo2kinVh2jK2rxq6LlZVy3psUJjcaGlkmw&oe=699C391E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3x0G5oYvHaIQ7kNvwGKx5wc&_nc_oc=AdnQ5HpItU1PHwRKKX3tcFlTzb5F9lX5MXSrdxuRauTCkTvGUkySOIWPgmqqNDxA3bs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvUAR_Z0kt-disW1V7SVwQ-74skUSEWT7Ko6Ja7F1QtaQ&oe=699C598B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvpbmUdMQNgQ7kNvwGqe4b8&_nc_oc=AdnfbSdVDkSdqbUubvDa509iEjbNLzGZNc7u6HmnWt-coNLD6uR69Q5ora0sa0GqYNI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftnsZb0vIywIlql_4pHEH8PPFdhvew8HPegvpl3cm8zTw&oe=699C6526"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=munmAOYTLakQ7kNvwHGB77g&_nc_oc=AdlPJ-07nTpVScB7b2tcrCCAWe7-HYo-NWdsMZManI0KkUNZKw-8uaIWwc2s3PWA7tU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu57wpm48qd3c2cW9cRSF1bljMmaXVUaHhrpqm3MMepAg&oe=699C3164"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}]}, "developer_name": "Safe_vr", "developer_privacy_policy_url": "https://www.eduforall.co.kr/SafetyEducationpedestriansafety", "developer_terms_of_service_url": null, "publisher_name": "Eduforall", "support_website_url": null, "website_url": "https://www.eduforall.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OC
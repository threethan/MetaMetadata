=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLbiehhYUyIkQgpz463_iAHr_kve3_XcOh3PBEmVyLxg&oe=69C680DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9Ju3xtCSygQ7kNvwFT1-GU&_nc_oc=AdpnE6xmq0GXMmo8Ij3ZuXzZJ3fxzApFxuL3sxHWGq4wkmNPiCtBFOCs5hNNT7Aifdw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAq6Q370Ec7olKtkzbYXyNM4Qpm6QrKsYDKT85g8lpDA&oe=69C6691E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuzDFg40eVMQ7kNvwFOEaIC&_nc_oc=Adop0s36vMqhQfynFBH9GppTVLAtJSKqsFhIrtDqcZ_o1k8axUHTg216J5je6NbSJBg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3MTu6trk2w12DoQFTe2WMi-eBOXsGlc9KQ3oWECkbYA&oe=69C6898B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pofJCYUQ1f4Q7kNvwHI2sQ3&_nc_oc=AdozB7CoPmZmPG9k7p3LKLQOawyucJXEvAydOd6BxXuIsRHRIYyEUSIn_JQJ95OJobs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqiLfhSVuaSOVutyfG-BPy2JzIc_cXe2-oy2-XTWedGA&oe=69C69526"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBXVxmsdtPAQ7kNvwFYQLX3&_nc_oc=Adp7hIKY7a0vfOuodD9Et8L5pzbmeQ7FLzSUD43S4DCLNBQ6urLMSdkpU-ijun-Fft4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqPABHGgwq1NsFVaF1w53CSOIQDbUBCTmBxOXwR1LcCQ&oe=69C66164"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bzkiNpiVAkQ7kNvwEN0V7U&_nc_oc=Adrdd9aHbJuwNZckfcWArTR7OGGgVLYnUmQAobM2Svg0YZbgiQIUDMrRgVtlNz2F_T0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3ZT2vUvji8_ASonXmuh0WimhQhB97jDjWj3A6pzlR0A&oe=69C6869E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwFMIvPY1qYQ7kNvwGKahAD&_nc_oc=AdrZmwL9vFBP9LUsUtzlstv2WEA4T0RUwm9N48p8rJiBz38FDDCxaQfOXdM6w_5Q8Xk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxgN7SCwjC7inkIQwgi_8VrPRzE5WgR10EgPq
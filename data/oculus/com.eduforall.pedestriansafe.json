=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxcmy1lJQOAbG7yt6NNWKFH4VnRCp3bgoXpsF6MQHgVcw&oe=69CFBB5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikVhj2QBS7AQ7kNvwFvKtZP&_nc_oc=Adq489PHiflKcQsxc2wrrBKSiDUlaT54CkbjB76yzhXje0sasJHC120Nma6JciixCII&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxme90nwavqJX5XhP0MU4dBoXBuAZngibcEwRZbLhzJng&oe=69CFA39E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3nVkBJ2M3YQ7kNvwEzXPhQ&_nc_oc=AdrkFoTnQqWcu5fzR7DAsy_US07zTUeAVijkktFmsXHMRhOw8oIor8j2voL5vl2EFi0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7fOqnAcZvEqRRDQaf3es0RS9Dpj6baUwmePdJEJ09ZA&oe=69CFC40B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eniuAYXuEIQ7kNvwEhGEII&_nc_oc=AdrqKeQAHY92DKgoS6qLpPmec3h4VJGbfC1kj62nbIPDDAJHG2va9PDb4fXPAQPM4ws&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVIvRV-RhYDotDCji8TNtdiayrzrSoWYElFRzxTj8FDA&oe=69CFCFA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYhI6086nDIQ7kNvwG_lhsl&_nc_oc=AdpYIgq1XFkbNHybsEGVA5-YwJisJVrv9zYVcYzaDZ0Y4adG_4O0tiac2kMf_InzEVg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSMVVUvVOGINbJT1N5FG0OZoHCA_rYOOhn3ff1DB7-3g&oe=69CFD424"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTZnvZhCe7MQ7kNvwFLUa_p&_nc_oc=Adqmk_OAnjjTBTttuwYOVZpsn5NsveVOfFFRz1nL3E97NmkTrLXlWPqRQEbWNqV0nxg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqeD6pxa0z-OMSuPuHRKTzowxADsZI1SD6XDTY3tF_5A&oe=69CFC11E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfOh9Ub6yMYQ7kNvwFfRKYS&_nc_oc=AdqLdeX-_TVHs3_S_bCQWlhcnpPqjU8btddTVKfYFldjQuABsXKqM8u9830kS_KfJBM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfznDWCkVsFZoY4EvcOthiIRR-8Yd-W3GmfipVW
=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HOVF40G18y38I39lgmHZUrQCinoc-RK1Hr5UzE_nDtw&oe=6A3A84DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoN2NbEU4v4Q7kNvwGOGPAn&_nc_oc=AdomqPrfpal2juRH4MNXw5IgAVj_ok0mGKzXBe2GVH3vixP7Pcx8kyTOiYxwPRV94xo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8clH6SqByhLxcm1V1rzr_jEr95RVGHgUZYe0bv0tJ28g&oe=6A3AA55E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hkjuPfjHkwQ7kNvwEg54kT&_nc_oc=AdosvMkIQtAwEmKQMiAQqz7WqJkI0TW1cugRkpMfk5saiJHAUGsDaPnAsLy1xWwvU84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9S6jLPy3lHMKBuBn747vXR20Bq_qMLvzyiz9dtX688eQ&oe=6A3A8D8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38S86eVWaigQ7kNvwHPXAGV&_nc_oc=AdouqCVh55X_if2z4B3JuDlDTzd8McpkCmG20AhexKuHABrtyYPxoUBCWOnJnHqusj0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_n3otCxL-WlYbS6pfnzHzUOnAfnGlnTUiAJuu-8Mhucw&oe=6A3A9926"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RugduKfz5rEQ7kNvwGaCfAj&_nc_oc=Adp2831_xzmVchApbJ9TOm5BAY5Vt5rOOrQmbt13m0qXLKaC3Fhjs-1ODSymtChJOEQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HrZzu09ALgIxyf8wdK26nRnME-7XBD2eVBMcN2JvtqA&oe=6A3A9DA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHML2uXPOpQQ7kNvwFk2u_X&_nc_oc=AdqlO6QZUVESev34Jwg5wUKPjeR78bHppWTAIhYnQ7zx1SA7GcAkacvqKWttAvdgsHA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gie5BNNmFhf__wRTDacaG7EeUfyBOcGp_pKdDtJIVzw&oe=6A3A8A9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3q7UzHgYVgQ7kNvwEdedVs&_nc_oc=AdoiLzwZsWvUSGHRZtAF-p78BNIXLYnp9TVUTklY5xojd7QKho8J0oaS6-TpxuX0rd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nPvY9JfkqrR00fM2M6C0ep7K_OuC2taLEMQ4
m&oh=00_Af2VJFtduOF3fu8xbt_XYlSBu-OfG42Xs2_bjG3JsQHupw&oe=69F0D15E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiVN309qPwwQ7kNvwH65vKE&_nc_oc=AdpLa7gCDYawv-YQbEiJxjf-OEptecvo9-zwe1e5fTUHi3Ds-9WFL9YfJYHDG2QbETg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1r-gqyR63U5TiXICNtzpES9R3F5wF0CE-alGhmXm79yA&oe=69F0B98B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBnS9m8hPvUQ7kNvwEyrJMJ&_nc_oc=AdoHUpVuJwh8bqvUZrVDuKXPCPKozK20sz3CebkxKdCA0KNAUSfIAlLOEgbifWEOyG0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2eIxbY0a55tmBDoPBTzslp19NNnwt6X6CzQCVLNF1cZg&oe=69F0C526"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTyv9fYOaY0Q7kNvwHXRDEw&_nc_oc=AdqB3seZHAxjs_ydvSje5fSJ7zxpNHfGEF8PC01G2tmt2N0TEk4uxQQXH6A2vqhEfa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0whk_VPQ5DOyJI4ap5lP4Y_KOTFFCUBn8X3WWXn-Q0ew&oe=69F0C9A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdGKNSQiOscQ7kNvwHzFB0k&_nc_oc=AdqHfK2IbudVg_79KqS5w4-sA8xa1xsw6mzJ3RkfcxD5Y94b_9oDtdNrkxsoaSgfP1k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2WEg_yTrLchAQkvZBxLYkjEQbeAoZpvjsBVoIKaFp3uQ&oe=69F0B69E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAbuwoeB9SkQ7kNvwFcV_4x&_nc_oc=AdpnWZooEQgKocsAGVKT5Xh7adqfTdu75tPUmPSqld1-Vr_C7SJ59_nwlOxdD8c-XLk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1B1d8IQTJrIjmfe77qUMKPP0-IQuPuyFuoNf8_AvlU1w&oe=69F0B484"}, {"file_name": "[\ubcf4\ud589\uc790\uc548\uc804]\uc571-\uc544\uc774\ucf58.png", "id": "1843110519761474", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_1843110523094807_6196787795280771349_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aO8i4utvYB4Q7kNvwFmMfJn&_nc_oc=Adr13ReEctxRwVrvaX9dwzuy5j6dZSUBSWYxswOvTMHEY5NrOEm40EicDKgEMFZj6jk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3kOyfd7Jlv-oM68JwLeiTSapIC4IhkOmSd6cLUnRlbDQ&oe=69F0C3B4"}, {"file_n
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J2IId3VxZdRzFxeWJ8Unm0E4VyCDfWeP6UzvQiFzdiw&oe=6A37E1DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XY3ASaHO0LIQ7kNvwFjrWqk&_nc_oc=AdpJM8HakG9FWCUistMe3xR8nT4IS-odYbwfBY7P2NJL7v6Tv3FS3GoZec93wZCVsYA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TT97ZnALns8_fLXeu5HK4Zk8vMWedsiTKFQZss9D1VA&oe=6A38025E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDEYXHaztsYQ7kNvwGW1eaj&_nc_oc=AdprL9uc7AWk0cQ5xDafSjUEO1YoVFjxXn3x3zshGM_Ja2psm5PJawjJK0Sz2deO1qE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BekFzSF_0CLx6Bqi6IsUIlLNZ8WVUmV4GLjKE7tP7CA&oe=6A37EA8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rDopmLUhocQ7kNvwH3EVO6&_nc_oc=AdqBsyrTAEUGXmR--DvbfohuZafodjoQbyXIDZh0GGRMv0gA-3xOb7wcAr8-4p7pvH4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hcvO2Pjfdl19uysYNx_R0rgrT7sNvUgyZ0L1hfyy6lQ&oe=6A37F626"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9XNsIpgeFEQ7kNvwE-qP2r&_nc_oc=Adpc2eDu8BjsdX1JO6IYnK2RyVMBz6Om_J_iaEJBntS0Kt4bgHRDPs5EXZ8z825A13g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vtG5QiB8vGQsFO6qO0n6P5NnRyOUjneLpMH0PXw7mJg&oe=6A37FAA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_ulTzHGBZYQ7kNvwFQAyo_&_nc_oc=Adq4MiIIFwdfnZaZmXtplnKc-QxBXLx-foXA7JurQqDxff6C3_heRxGTwaF_y3LqLB8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wtDYT2ZoSCJa4jp4RQaEit-WWhiolfx0fRYjidhANDg&oe=6A37E79E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3q7UzHgYVgQ7kNvwHueMYP&_nc_oc=AdrOf_Ab4JUEPmDYt4mrNiPFM0pfS6uKf5EU0wGtZ4_108sQbYhkx9pAJ3BrnItC9dM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ocUSDY4M8aYrlP5y3n8LVXPVgOI2vH1wSNTw
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5EH-YTFCMi6SAMYV55yiQOx_JOM4R0BXgx9N0SlCf3Q&oe=6AEB2DDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxqMhz25gDUQ7kNvwEZwPYW&_nc_oc=Ado6yI7d_Iz18q5BSJFgfJbObOJxno-OgwKaYVHD69aASOZuyKHrAY-21ZMRSSWLlYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLh6-srTar5jltZ5_KSBatWrdQXj4-61LnHc_WxqD5JA&oe=6AEB4E5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvgESfIjTDUQ7kNvwH_k7N1&_nc_oc=AdrhiHnJ7-CIMfI4V0Mqcxtsi8y30_6VQ9nbS1w6DFRJOZSh6PcUqKmwFirKP5x2fmA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4bALwryPKAJKi7ylb3AuMLz_lXdthhIVq5RN7D_yNxg&oe=6AEB368B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDyrlqijjCcQ7kNvwHwHEvU&_nc_oc=AdpXRm608kXdgrA38GogD4xfMCcAFv1vYEcglPHZ90htaS3LBmGxiHb_STFGu4Cnu18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjLZG5cU6_fXTvDOS-RclqOD45wAuDz8tpBTm9MbqAGg&oe=6AEB4226"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p68jwS7s7FMQ7kNvwEIjlBY&_nc_oc=Adpz1k9ILmIQsjk43WiJNv-CSc1GN6ZkhRPUAH_1B4_URSeyACA3_s_hN3yH3cHqzO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLd_6V2Ks9ytIF4pXteheuDBdHONp-rFYve5080e7uPw&oe=6AEB46A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Bt6RH9kQmYQ7kNvwE5fLmn&_nc_oc=Adr5p-V6Z8-R2It4vhcVE8TQFFp_JOG1klVzWFqiwVbLHgpFIEKbi34TK3utWTHz9A4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSiNdmvXpvedtaxth4p158GKl1OGj3RlHxalU1uSkP6Q&oe=6AEB339E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IELIb0eu2wsQ7kNvwE3noD5&_nc_oc=Adq8BcPl4z52GlW_Fdd5prW8qL50TlV950Yudje9-LCW7jlsPWyTiSldIaIEfdEIMZ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmiYaWkEQRd_22ftVaugLOwpfaR1OIT_JyWnI
=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyXq1yFZFBoG2BiPfigECLmzlw7GiyEJpZAqj8R2DauA&oe=6AF4A09D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xcjt4_yT48MQ7kNvwGF94pI&_nc_oc=AdocxjiQVl4rpoiFDtUt2mKYGkHBHysubWt6QGyrrzNHhSghrRnELu1JwjR5QNecGt0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcke-GwILL9Ll8oPPQGgn31V0_OSl31b8Xi6rhMQrCwg&oe=6AF488DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLCRVfefISsQ7kNvwH56QkW&_nc_oc=AdrT7akWlv4yE7pRpuARSEdlz6S928UI0tM9k2_UhTz5zE4D3gjzzqZ8jXyaiJZ_7Ow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRFnqXn2N2nXTykU1G2CDxC4YbDFatOLwyBNFRM6m3uQ&oe=6AF4710B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgTXTlbFnKIQ7kNvwGlnj5i&_nc_oc=AdqDc6ho1ea2O1jQEzGuN3d2WAnMGDf1eUU-aXaALQOG8jJQGY2qbFeBTUslAy_lJtM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBnddgldDaYJxiLo0r0dVw9nwo5o87MCosIne6ZgP4hw&oe=6AF47CA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4K0iQ5YShe4Q7kNvwFrrBzI&_nc_oc=AdpzQ1x0RKFOYyRXLe-Kjg8r8A_hINuqs7h_auO8bcy5_Xr3X3z88NifOu8M69c_AV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWMpKmPH2jYETNIlTeJ4VCD3VujBP6ULIgPDpDF20jHQ&oe=6AF48124"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0QPy-Ff4T8Q7kNvwEQ0Y6m&_nc_oc=AdpPITLoKp-J3STAXGFt7xBWxCBTY9LimxKpEiaWo8QGSQxDJ6sW_NzZlpPlb3ZLuaw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqQKkQepBDYADBqZqqxZuce3t0tUl8QdTd95pyz1cMNA&oe=6AF4A65E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guyHRNIZwWIQ7kNvwE9ABiQ&_nc_oc=AdrT9J6JSXuUF8wegKrNwY82mg6tmCyPWomL8GgOCX1pvRYih7Vlps7cWNl8XxqPad4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6sg5yHDB2jgSch6w3FhLZVhlzF6jVdtOBi0K
=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWUpRRvUSkYNNqM9pYLt38BidnLMUFioBiX5xCXNo7bA&oe=6ACA709D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBYNeopi-S8Q7kNvwEzVyio&_nc_oc=AdoNuZp4IixPsjsfGYFYu1j1Z2SjvtQRhwYJrretX7ue9gkmTDgSPcg9uw3uNHwdcBI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6kP1f5V1M-4-4UI6mfI3lUPGBFO2bAG49axWeIRiWtA&oe=6ACA58DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG1NbqdMcLIQ7kNvwFcccTu&_nc_oc=AdrlpWNHeDAr7TNL680jT0avvYsfjtntYkg5UmXSa5DDSNXIX7eR9UTfzgdQQOB0J_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2I8p2j1akefOE3p5_CAA7FxQfNT3i6-I8DqoLR8OB-Q&oe=6ACA794B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-GO2cAyrWAQ7kNvwFbEUxR&_nc_oc=AdqY9FtA-A2B3yjWNDUN24FthxhWc-QriBvTsB_iJjxaRrJ360oFT_M6g4zqcCSPFpQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvPDpn71mMmm1JYywP1Mq3iRky6xmuGgDGRL1DZp8I6w&oe=6ACA4CA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=libgFlOuFNkQ7kNvwEyJU-X&_nc_oc=AdocA1gj5xhis8E0bZYQClX8TpckAOgSpJiGIv0ib9w7qbb1iYTGnre8PMzUJq_KarY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPid3RW3b3XfFygOLzY72hOMRIMbxxgH3rchIc3rzPssg&oe=6ACA5124"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFDhrmyT8D4Q7kNvwEeeYlE&_nc_oc=Adqgd5SOm53iLmFgNY3WVP-9WnEaQQv7PjK30HaWWK5kfOI8fvgNvKoRtam12J-FZoM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrr_ikFW7tKbeUgkz_SK8IDgASuHvIdrKszIsIlbzPhw&oe=6ACA765E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CKFQ6gVZt4Q7kNvwEEhSGY&_nc_oc=AdopQeRyUvLl-quZGYZ_RXQ_QsRWiiaimUexQTIDGdgo0-V88xYxT7xxGUDD_Hgj-1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWIIiPIpFiha0_w8jGfj1RyqOkXHrKVFwBaMO
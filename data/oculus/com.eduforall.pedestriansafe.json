=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kbdQg678wQEcmuBnUSTry7WsXftgr-ZPQOhJ6s7aWlw&oe=6A329BDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGzGZIlfZVMQ7kNvwFSousF&_nc_oc=AdoCtLNjjfTD6GvQcXIhfnN-Ir29iEMhTzBb2bBXf6DzSqEVDG6FU_CGBV0DL3_WucE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6fHnmqBtMPl7XFDTThnOpqVNISeaNhP7l-YgyqJXCJQ&oe=6A32BC5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JszVw31F888Q7kNvwES6mFj&_nc_oc=AdqfyDxL0YEB2J4_t9hvvpew1TFy_5Ee8K6JKozSHXcAu-B-c9xh2YkDVVYAEjg8B5A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_17b5MznCnBiKSxqq228Ngv7sNA7XmKdjc3Ue5NGR6_Q&oe=6A32A48B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOfmG-Y0hxcQ7kNvwGxEXYM&_nc_oc=Adpo0UNhF24nmmpCXU1XOY2ZNap6wwnPLu22o93xmgXFU1IpFsaOiBCS0n6JjJPpACQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nB-7Ivb_7rh3FmOAh_sKIo2780b0RvQb2wjKXv1VyDA&oe=6A32B026"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0zlSMSYEjwQ7kNvwGG9CDD&_nc_oc=Adq26-ukEW9VdpoTGH7cX04kEYMieUU1PSecTujqDo77Vp51VujadyIg9humFDqS55A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TBS_79azLkjTTYokTI9M21rWcsXgCa-voLoliDxIVTw&oe=6A32B4A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Stg--Zm-zxwQ7kNvwHt_ETo&_nc_oc=Adp327slneWiLNAUp7nk6QdeZMHleSI9mBIZc8aQlsYnNaBLBiTZkrfy6x1CSCeYDw0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hAG106jzlHWXNU1nvXqD0zGS6_CNMAqizNoPUXQNlMA&oe=6A32A19E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioPXm4P41G0Q7kNvwH1Xkj7&_nc_oc=AdqAfR68dXMCy2l137wFz-Dn887_OhNfrti1-XzxLfdlKzQ_B33gE9ldbqXRW29do2E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8L2NyDmkauJayL04PVvy7oiXmMzjzy9foKg7h
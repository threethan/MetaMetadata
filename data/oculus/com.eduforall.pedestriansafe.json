=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0Ayw6rxYJ8M3UmQKaKKioZV4z8wsrsNE72JVHQx3gRA&oe=6AC4F25D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fP_Mjelc2w4Q7kNvwG3zqHh&_nc_oc=AdpAPoVfLg9suJqoLWVAdOWQ4q9qm8JjzJAfWIaD9NAeam3AIwywdka7LqHt-i1vgN0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp7K0dtNhPbWodZFn5ndeL564jqM9Bq285M495CZjbnQ&oe=6AC512DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgEzoPc6UbkQ7kNvwGrR9I6&_nc_oc=AdoLK3chBsTO_nTFSVptk6ib-vgui8MWA2_kCOXIIIMHbxU7eIzIuLF5RMPPo1YwM5k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPspweYjaVbaD77TJ5kBiUP3yhK-24A02XkvObfir_Z8w&oe=6AC4FB0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuxS15Lad5gQ7kNvwGPHQYK&_nc_oc=AdrT-iQ1siWpHS7K-OufEZT8ZhqVjCadb4VXEM5h-DfGqN3e4BU_qLzjSDyTB6T5SAk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4yKQihsnwUjNvG86F6aZ2nR6XdMJEYqiKm-mjlBIEkg&oe=6AC506A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1THXgTNsWkQ7kNvwH7KUFI&_nc_oc=Adqne_pOd3Nij5n0gno82Fu62OIokpnWoNjl7aO_YdrlzlVIcYfyNseKzFWI5qsrAfE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNot4yETbqpBhnIm-gRspPbOfyFG4MD6pDYJ-17mLk43g&oe=6AC50B24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U54YFWW2RccQ7kNvwEAOv-q&_nc_oc=AdqS5iANg0stPTV-8dvuMPxecklwD14b7MSDLH56A2kL9UxO1n-iZGyE4blgDjVxwKg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI4YANGHVvq8-3Y-FlbA2_FHw-kyy0YCn2uRjYnD7GSA&oe=6AC4F81E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWNIvP8lNFUQ7kNvwHuzYp9&_nc_oc=AdplmdG5u8miHNohrYnhvUKfDo7owS3ZMH2Jwaj9-Gs0MCukHXwclqAOI4WUk1do9A0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPm2oh-evAYkWH-lzKZQ1ut0tz7luIeAzWz8EX
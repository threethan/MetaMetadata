=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByAiDZRmH-FS4yoCBWJ5kaKYPXGg8dWA_9TKceC0R-VQ&oe=6A68A95D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OieZNhAjxgIQ7kNvwHHAN2b&_nc_oc=AdrdMLFxI7YkS0R6lEmmYLZy9E451EHncN4nq-3J34NlkQHankHXJt5f4GegpIt6N0M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8Vr_yeCboJOI6uBFRaqY0sIc_RS1wWMduyfMJ1WYUCA&oe=6A68919E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMgZWVz09r8Q7kNvwGUW6Ge&_nc_oc=AdoNwyme8Br5EJ4k0cwxFItzCHMBXPT93PTOYXzcL3Gs5ZLgyaZUd1LOxLTPLbO75-E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq2CmLBJSYfuu4aVDhdwsCTWl8T6L0YHt9YFhyDiZvLA&oe=6A68B20B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l09cjsqo32MQ7kNvwFovs0Q&_nc_oc=AdqhAaDDZV7ga4piPhAE3er_RGGx8N2HNFSk7J4waGAwggwHDQfODHa7H218UZ5Knjg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMuS0lzMNjgQ-z46cufZ4XTxK7xZnOLFzrfiKYvui2IA&oe=6A68BDA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1pcHxh_PtQQ7kNvwFObv6L&_nc_oc=AdrYoxmum677Q3PHNAH-Xl1LwatEhvBJ7RXi34qtNUzXiH7ZEaZdZTWkRP06Xl-MECI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNcHOSlaohoDuyW8NJKkNb2kGbCSPTftIRr5lenb0rDQ&oe=6A68C224"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaZ8pbU-AccQ7kNvwFqLnrR&_nc_oc=Adr8s_0iYjD4AENZ-CNGshE8rCCIXwXqQUqi4dZmb4ch80q44xiOAjO0SxpLyULmZhw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAto1SpmsYn3AQ82si7E30ZA7VPjlOd5ZO7_WEG80zWEw&oe=6A68AF1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qRlkGvk6kkQ7kNvwGsOGCY&_nc_oc=Adpvoto08eFHCZOBeb6yn6WU_GlGSuY7FkRMyryra49vqrFOjmncUQztDcG-7Sg5hSg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxMyOfhMgyok1QlFdfFFig-kvWprJsYngeYzE
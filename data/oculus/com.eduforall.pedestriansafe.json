=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8t0RSKt30nuaO2047HnPw6TjsJcS3yZjWNrYwXEHLZmw&oe=6A280FDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqjeP6sbuX4Q7kNvwEGNHpt&_nc_oc=AdqyVxKrCMY04l5CFOFu7o4t4NmHlo2LhaFolhnZOB3Zycr_vQfbnWNiQ1N7jLomnlI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FBqPdRAUH0VXyFH9HpsypCY5LbOgOqrpebNc2bkjxIw&oe=6A28305E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Jd3_XdWjkYQ7kNvwFBw80k&_nc_oc=AdpOoXEWlJSFXxyMXBvEIZG3yTRMmqgx2T_Ql7lpeSyaJeZnhO26WzunWXng6lsFc8M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0vm2FB9LZZ_gH7J9oAnToqCyZpWsN87IzxekpLUmUnQ&oe=6A28188B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iryaRDU8AvkQ7kNvwEjKcAl&_nc_oc=Ado-YcVSs7oZ10uMkkuGudNdtHAfulQlSsv5V66vJhnFdJtqViVU6RKWkRr4wyX7Pjg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cZZIsfmjQe1zi6TXWWUF768CV-mrYzfhZNZA_mpCOpw&oe=6A282426"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiwyNUP_WhUQ7kNvwG7m_h4&_nc_oc=AdoTsy7tJxLp7nFncN_KSWiB3yU3cPzMP0kRABPVD4N2AlBCh-rdoLdxbFrlJLiZzKE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xkNbbp6VOlJJ-V8tTo85k6XC9vSgzUuoYlHVXrggLFQ&oe=6A2828A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zxk0TdLiytMQ7kNvwFNqEmc&_nc_oc=AdrIlAOv_hzg9oOm4BXoweUVX6TeXTvCJafnq9OdOCOw2GlpOvTRGTLovlo5Y8SXMpg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9USx3PCvpUIIHIq9yy5BGH7ZprgGaN4gXqb-FSBWRd7w&oe=6A28159E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avnjqaYj55oQ7kNvwEJocJk&_nc_oc=AdqnPtIiMQNxC_s4I48QIT278v2tCzLcS9ZjAxNXFqJBj1wTQ5ViluaQCpZtZ3VwMt8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I0_6uRbi-PCduq_F0Eve2OEb_-FnRn_CTvt9
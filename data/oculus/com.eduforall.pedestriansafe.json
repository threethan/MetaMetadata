=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ImXnjxV7VbtZYKPZs95PFfmavmGQVtHmO3V65TpIhdA&oe=69FB3CDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TVUlzfcgDoQ7kNvwEVRM2h&_nc_oc=AdrnB0-kBnWMvJHqI_QeLW9WEornaT72686AzTTZwy8tkNLFN6H4fOZumgaoxrqOa4o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GIwIWD-o8PmGqIP8p0STKG8PhAuBiEMopINUL0GCvlw&oe=69FB5D5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG1VsUuvsc0Q7kNvwGUlMEm&_nc_oc=Adpz4yaStbPNts6C2-Rc4We0PkNF3f8yzCrGEKyshYoa8pyxCEg1zSATMIKWxlZ9HaQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZXEk_74fF3dMcsASDu221z_KX5X8vHTOmmEGEYHrKLQ&oe=69FB458B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RufRHMum7QAQ7kNvwErupFG&_nc_oc=AdolD6Ep4N_VHNyrQS3A3DYBrFEx_OcHyzhBl1FOCUGII-Nliyf5M-SLYkJRuikotYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qE0a1FQKWM_Dl6Frlrzk94mDM49YIIWrlyJfxmzRlwA&oe=69FB5126"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IS34QyRfRTsQ7kNvwFmp-l2&_nc_oc=Ado61Gr-h05grwKfQWRI9cWrKVKpEwK0hTpfxv_RdCyCuDBJozh4bqFw_UlMuJ_6BZ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kVM7vmWk2LstnR5FmLuPpsd_kAALWR4aPjLm8949j-w&oe=69FB55A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uFikz0lpSgQ7kNvwFxhgW7&_nc_oc=Ado1ewGF1QwlOZ6-Bw8N3yhdB05mMO3QlNNPf5JuIJcjLu8ykx5zJDeQrxYK15blEAw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VMj-0k5pIY4kOyGhGylxhEBLRPLC1KD5-rDEGk61BUQ&oe=69FB429E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeRkC-WoNgIQ7kNvwFKSaKb&_nc_oc=Adotuf-7SVeZtI5m1YcE10cHOF3sXU193ToifJ-MkdyDfuKSG7eSm-kxGfBZIfUkbDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JJtAhdX0CmSeim30mfktSW7cbt882E9r_-LW
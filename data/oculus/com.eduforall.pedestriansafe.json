=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DECip7zxTRKL1V3t1hi4Lab9BHYkKs2ZRxdjWFDfc9w&oe=69FF315D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyFwfX88alQQ7kNvwEanWwk&_nc_oc=Ado-XmyZf-I4C1Qy0uGEYEVFg70CFyFjI_pdprSOgyBh2wEIjj0-AnTVNvvAbQPTt3I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o-E18Az7gOiViS-BGSVUlk-n6DLLp5hPOx9BjSeruRg&oe=69FF51DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=un2L6BYAjEcQ7kNvwHDFaxi&_nc_oc=AdrfiQjPxKthrMOE0jcrqna1jyQQ3mkqXQONR3gDksj6q5Xq3Bi5qnVCEyNpB4XEWOU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5r7MfkDu40WU29cTyilQhfc24f8fHmhET89rKFf1rxFw&oe=69FF3A0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxJKFatY4cEQ7kNvwGSbgIo&_nc_oc=Adq3lZHwB6DTJ9AI-p2AsRcv8-BDE0ZMl7GCazHcPH3VxII9Kr9lWj2wAvfEecMeTSU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af681KOVmc5jcr5NVagfaree08bwjG0DEvh2B_zcJUkHiw&oe=69FF45A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EURNhUHX8nMQ7kNvwEffYmC&_nc_oc=AdoBQq-MGVycHjp0kbfQCyTObzoVct7wK9EHPTp-d4nHqJlEbTGmL5D5mTwV-tIOys8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44-AUIGKg__DN-8b6Ajuhc7q9cqDPs4TcliRB-jGHJlA&oe=69FF4A24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lCRdNFIaP4Q7kNvwGYYozX&_nc_oc=AdrIIRsAHgex4tfkMecsvo1RZFvNUwRjrjWbCRTiOfWieGOHH8z-2Ju4NmafyBPG8Bk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6N-8HPA2ksUmEMOdlx0Y1Dv1ZIcPqlZ3XVRCwStB2tSw&oe=69FF371E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2jqcWMCIqEQ7kNvwE3b0Mh&_nc_oc=AdpQCaQ74lDdfpBUNZG3l-tUU3sLN2J9buuYigYCwnRc0JzpGY4a45DZwYgcPWTEK9c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lT3nOPUxlGnoEkCfVlmgV1FmVNoVZ0pXXx_z
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfHSs-8s76DDcRKid4pRIgsJJAn6lbRvJV5mDYu7V5Sw&oe=6A7F12DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XsgdrVEzQoQ7kNvwGyf0b8&_nc_oc=AdoLGM2xR-1XYuWYv1e4DbQPs20fXLpxslt8h8EJOCpjj_eNP90kkdhR6OyJznCfQF4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnrf3zgsA0XJhOEGfZXL6XQlD4l2zEMU_7nfnSoBYdMw&oe=6A7EFB1E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bptCknkFSecQ7kNvwFe7ZRX&_nc_oc=AdqTPYKQaEi1Xt47JKiwJMUHsBYqYpNKtTU_WQ4dMa1AFyq5pgH_5QI8yJcxedhXW5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYdmh8RfopgzdNzwmkrhfPq2UC5t0n_GfTyR1uesVMDw&oe=6A7F1B8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVmHanBLuaQQ7kNvwHkwQ_9&_nc_oc=AdpA-Kp1NYWm7CWONXK_D7yJEcMfFgdHwWefGEFByNUKE38bsr_ZiUsCcm9GGVBxO-U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrKyBd149eMEfoB5aoEXHGiStDNoRrQZ0IFm2Ty3CnoQ&oe=6A7F2726"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UONkbIK8qB0Q7kNvwGNfbRR&_nc_oc=AdqgRM8PMUBkivbySCh3By1XYJbxHCWfjdlGLmtZkGZwq1DL_cP98IF1rhxWwQa1hJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtcGcIo29oT3kVFeysyNA6CPygt-M8QbDCCycU6D6mzw&oe=6A7F2BA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3XSlKbdR0cQ7kNvwEcBmKS&_nc_oc=Adoeg_S4p98-vlB8LOg4kDWA_Fqi5DIFxKnowY0rHIE3jTKebN3XajRLuH3rx1amXyE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlfTiatoZ6e1N4_JLpdRf59LPH2-2MSh8e9k9ABLnwTg&oe=6A7F189E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAzu30mndQAQ7kNvwEY0wFu&_nc_oc=AdouAK0W7mNC-yrDWBxLnPHnkFjhR6AGfwOfTglNxd541NBwyFSJHX4mGBHcs2pw2d4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPXmZMMSpHVjf7IbnmYSLiWzQOXk0kS4PYfo9
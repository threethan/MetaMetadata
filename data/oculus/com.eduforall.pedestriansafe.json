=1-7&_nc_sid=6e7a0a&_nc_ohc=CcGvJA3SVHoQ7kNvwGG571x&_nc_oc=Adncuu_8-2wlKu7CCs_PFihoSauYWeq3169kevqhZ66TOfFERj-ktGzRtkwYN5sy1i8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFFXFa7h1Dq3afP1dtWZggIplf9e8yDHigy5oi8OieJA&oe=69B93264"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}]}, "developer_name": "Safe_vr", "developer_privacy_policy_url": "https://www.eduforall.co.kr/SafetyEducationpedestriansafety", "developer_terms_of_service_url": null, "publisher_name": "Eduforall", "support_website_url": null, "website_url": "https://www.eduforall.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inter
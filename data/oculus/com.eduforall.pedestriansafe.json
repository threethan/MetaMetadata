=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlV_vUeWURuv62sfbSuOH56eah7U7loT1oSOA_t6wlmw&oe=6AB12BDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=at2si43P1EkQ7kNvwEFZnis&_nc_oc=AdqEMxCRFp1DWvOV_rbcawWMvhbmQtYhm9wVZf5XCTu1ruY7rFlm7I6aSjejhqa5n2M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyYJEvVHYCUjEtnRfS33lhK-CmkzGj4p9i_wyqRJ8wfg&oe=6AB14C5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1G6-e_fa36oQ7kNvwFuRJ5N&_nc_oc=AdplJzU1dnvgHwNtvzsn9ect_JS1ZHFmJiJl3a4qyCWLXqToSCSxc0yOYxcHeNOnE7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgJb_4pAzeB0o6Kx7_BudgHTFql6IMqS8bVGj1ARuO6g&oe=6AB1348B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHDpeG5wWbcQ7kNvwEwZ-mB&_nc_oc=Ado-9hNdvYrqTOM_7ffcZhJp_zbnJktDkdHA9US8jiOX0rW3vBG3eEPZNO9MY6ndIUQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4WZwxG0WnQAhjpGUessBi8UoTDdZtPdYAh45qBsGmMg&oe=6AB14026"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdTyybwCmdEQ7kNvwEgu2JI&_nc_oc=AdrAGtfrdqBSXNx1hNLfda490MOKJpzBpH7hMBR17LXKsTwu3YL2sY5hOPfCsdcNjWI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItZ1Q0bSt0P5SduIF62VEeuEOgbcjgcEv4U9C9PSwsTg&oe=6AB144A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWGVsT3Cn-kQ7kNvwFgJ4_5&_nc_oc=AdqxqfAhIZdv5fCiOZ5R1FLOMh9qrsImedqGGHRF6ZXNFDQvtpQh_AMB8tG4uNoytXA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWO9_mDl7uc7GoZMmXukInDAyTmsaPZYRYk6yyoLyI9w&oe=6AB1319E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vBAxKMvTRMQ7kNvwHCcW0m&_nc_oc=AdrMgj_sWdcuc8Yerg2TcjTX7p4mIvcxc4Xio9CeVGcuOm9nGjRRLyq7BzbV_ZLIFQ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPUMv-d43Cb3gzjkjkPMQmmuLSjUoT_1XqYcA
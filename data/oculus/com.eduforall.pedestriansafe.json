=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIVCgGCBRbUykxipZnwF3xbsTaWzQv-l7TaM-SqQ3IUw&oe=6AAD375D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvVPpvw3QA8Q7kNvwEWeki0&_nc_oc=AdqYUBoAijwwc_m4p-rqpkn7iwfnyiWssxzcj_uh47xecmEC7kt04vCPEXjPa_HTA48&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJBwjoRwx9neco-w8J5J4sUnac4c5ISsHq23g4itUGGQ&oe=6AAD57DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0uN118Enc4Q7kNvwHL63PL&_nc_oc=Adqr5C30GuMHIDqMEKCRY60B3d9Fr-KkhSwd2MDIF2naFO0gvub_EcEBti0WnS_3fWw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn-dF-Vn0Sx6vGmQrm6_SP-_MdejBt26-q5A3x8k20Cg&oe=6AAD400B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0M6lMR4xAzMQ7kNvwHyeqmZ&_nc_oc=AdryuD3DAWNxDsL-zCRt1w8-CaAy1DDQh9vyDe6P0ek_LpyGpFoz4BMQ42gOKT-Gykg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCffi8AWD9U4az5VreFbODMgUp-SOyQL6hHQ0JZiCgdQ&oe=6AAD4BA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdj7g86dqbEQ7kNvwGQWsdy&_nc_oc=AdpCVa4i2TkCJ97jVY5bu2LdKKEtzIh6_bQ187jsmxygw9GnJcAmncQsI-aiYLB-w9s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF3f3hbV9yaS38oxvKGixJKzw__AK4HOhd8onD4SIq-Q&oe=6AAD5024"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIx5r7VAvAoQ7kNvwH_dflh&_nc_oc=AdqdIDTKC8s-pSUIeU961ggaxN958Iqn2BODSTFrER_AtiozYu9XYWcH65NZzARRuA4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjyaPo4mDDQCkqG_s39BU1vEznDSMheZjjvE1gdmCOpw&oe=6AAD3D1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cy6d4_Vhh-MQ7kNvwH3V0xx&_nc_oc=Adr-8uhjAjWunpbcMIPcT0KQvWqtd4UJNpLowykcjQQL9eDz5Dx_TvSHt4LZ3yZHgLY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0S6uK6sqR1op43ZB9-kujYC8zi6rSKJRlVsf
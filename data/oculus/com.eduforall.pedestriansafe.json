=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a-SqkWHHCF6-FD9iRAozwupgx_ATAN6A4g2QfaFB3-A&oe=6A0F035D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2DlDs-zhfQQ7kNvwGKv-Zt&_nc_oc=AdpBst8vmZ0l1S21hyz75Znbqt2wfgc8IpFY1e-_oFYv-4Vxm5FnHt-2Mcee33z0r9E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J9l3-uprM7stJ1gdGqK-fCS4baSshHqv17Q62SVCrKg&oe=6A0F23DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddTb565X2PAQ7kNvwE7j0t1&_nc_oc=AdodvPDcrbhqQ9usLX35TVF6txVbnhrY4DjWcFXVOssJBKMZaYUZJGn36vVDP2JeDq0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bdudYP30rM2ZVklmcfn-CBYSUUr0DobZ7Ia9cKqOy3g&oe=6A0F0C0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJrBmalxgekQ7kNvwG8zi6i&_nc_oc=Adq9KtbuNGx3R2sUDj2rzoEFbE4nS5HctsH6mfxdXtOZxlL0XmLd3QsqPQ3NSDz1BD4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PTJq8rvbO4S4p-uGX2uBCUYeRqDHaCG3rNHRZZhcZTg&oe=6A0F17A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4FV6txTD3YQ7kNvwEspdsY&_nc_oc=Ado0Q1bfansLZb5v2SfDSyudfOKfdU3RWo1ltkCbDXDG-oDgsHKwbfdFG-FwpR7NO-Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48rCcNG_xnCd6BrU2c7q92WkNnGzcRs-gGKzAYbtUvmw&oe=6A0F1C24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3JAU8bivXkQ7kNvwGBQcRV&_nc_oc=AdrIHWfd8lmyKvgydY7XbqYAHnz6a-g05JfiELVchRyLZ2ceXsO4UmhmHKdzg3upOQ8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7B3v0PZp78UEReLaBKjDLQMehZKlVY2tWMQH8kYtAovQ&oe=6A0F091E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuGNPn30GqUQ7kNvwF3bMHK&_nc_oc=AdrdDXmtFUHGMkTvFl3Xc3G9A0ZAJtsmYETJpvHnFH5yvZViVHm_mOH-b1zarQ_Q2Fw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GmlARzIxvDFD2a0G_MD09jREZlvNBjkWIU2T
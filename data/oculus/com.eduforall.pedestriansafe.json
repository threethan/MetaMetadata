=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRzHu8s7f-avMEDLgN2p_nGGCTvBbU5Qpl16yPn2kC3w&oe=6ABBB7DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNpXygzmWCUQ7kNvwHgR9kU&_nc_oc=Adq_KC36UwfPNv1cTO_RhhcGseIg61LEFsKFRAl7YWdfi4CjcXuEdkayssCevut7VsU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF-dteGRkFXlM4D2u4Kd6wMCIsuqEygfGsY5Lkam9iJg&oe=6ABBD85E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WB2NPDe24eoQ7kNvwEXgXeR&_nc_oc=Adp60RE1vST9ar1BzuN555aeur4Zx4didugd3crosNN__EuaSTPnhj_BdNq6eDwQcHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9_sd2NLVOFEBLiXBAGtDqj9bujc8ZFtMjQDEKG90akw&oe=6ABBC08B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-XCY8X1_jsQ7kNvwGohaMm&_nc_oc=AdpH-ua1q_OaIrsAM1wqeLiVyT-pCJ94WUgf9D2INFPg7WO0xch7q-kxfMfVrOdyC5I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK062nhX004UVmUx8zepR1zZxXGxDZ1rbd2FpA_0MVsXA&oe=6ABBCC26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxUrC6YEAHUQ7kNvwFQ_Khh&_nc_oc=Adr_chyxetv-Mr9iv6f87JVKoO_v-j0W_nelnTkZpwB1tFtdSYvbhY9ZkmDf-poxW6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY7yijjGagQ2XZw78nW_m8NF1VWPfTE_ycczy0AOYGZQ&oe=6ABBD0A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0csZbbSlclwQ7kNvwGvhQ1B&_nc_oc=AdqCvAOyHrMdN9HnwKLOll0PpHXOG5vRwI0HB9B95Oh2BQk-XbrJbbwdAK1srTLtpB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPe2acTYjoM04eADZNvrOXGgSZzFBMV5LuSX_Pe0UHiw&oe=6ABBBD9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKk1oWnj2hAQ7kNvwFjb9UY&_nc_oc=AdpvWD6kfVC4WE9Ly8jBdWs8YtQ0ss1uAjpOja1Xtt51ne6V8oMUqVoes3BTYyirV1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxpxW25VjBLtYlVDzy2JsTeTmGa44ANfd0q_r
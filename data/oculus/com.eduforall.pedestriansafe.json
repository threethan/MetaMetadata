=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JPKHF3EaNvNPwS8QhUJmWMcoUsYXtX0_95auPWOv1yw&oe=69E2305D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEA8rBB_lqEQ7kNvwESl-eR&_nc_oc=Adqqzq44N8h1LKCGIrbF9_KT3mdOF6fr4iGgQrRbjcFnT3rCoPSE8q_d9-B1L7BtSU4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lLgyY4Ssefmd-kGNBNcO1ffO73H0lBoTH1BTZN98NFg&oe=69E250DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUKryDl3pjwQ7kNvwEwJiho&_nc_oc=AdpcOvkNItZio7YL3AdH1zT-G1e8CoMt0LKk9DrBMn8iiLl1VVij8vfR06gOhnemeF8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xsrbj0eqFos9GheLNV8MD3FMeS3hGiVR6K0Nj4ENUXQ&oe=69E2390B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uFj-de6hloQ7kNvwGJgFKL&_nc_oc=AdqVbrDxz5ZDTiTqW6PX7EQoFyQS29fs74oSc2YzUOaiQ8RZApZ40vmSkHoht0NGzpo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZSF5C3CgOMR9jwtFuzJshiQG0SxP-PZ3jgI48LHVeBg&oe=69E244A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSbGfuaJzzkQ7kNvwHK43xV&_nc_oc=Adp4DIy1BCX-6xCR1XPzQhB7JK1tWDjic33UqarBPXe3YJEPoSbt_v4ixTf14CI4_ko&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zmo3FGe4-VSFfhFcmqyP1O7LA_TRo3AMNSXlnRBGa_g&oe=69E24924"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLcVQv67_tcQ7kNvwEr4cAt&_nc_oc=AdogdX4lZeERPz8UeX3CLOvFnAuQK6WmnTSVPExrx9sFAiMWEAg1jUQoco6Ui_p-tPg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07bg8Nj0j8DJoGoCuXNkSF8r1VVLYv3KecBnODHXsCiQ&oe=69E2361E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cti0P006YIIQ7kNvwFFh6o1&_nc_oc=AdoyhIAjI5GYZHqebZIBuAbbdYvrPqesbTZC4SdRpw9DgsOU789tY6OhhVrWKoZHrvc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MgEq2PRO6jxQ0X-5MhwoXgyz3xJ5qV0kw1Lf
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_XpYa8SIqXFc63qX-qQulAc0EIhI2an13HjuesuRmXA&oe=6AB5205D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Euq_IcZuGMQQ7kNvwF4TOjL&_nc_oc=AdqBuWHHHsiZJsv7G_VPARUQEEAl0fx8xyRITLqa4r7gdIBFpttIRi6Xl7P6Ra1ewKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH0GCdawo_uNfLrua3aXGZGVwlhbA4ECW1HIJz_AoCRA&oe=6AB540DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvd5iamh0LUQ7kNvwFVWs4u&_nc_oc=AdoNGnCmn6l1CJbmj5-hsZ5pgkTESfiM21WX5hfrbUukL-Nn6aVrvrsw8cni6mAnYyA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCgmt3j7A-I-1tiMzcl0SMkh-tyhrmhpnNwGydFecdrw&oe=6AB5290B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m00yRae_nG4Q7kNvwETFR_M&_nc_oc=Adp5oAGz3s3IPGQajyPrI_78karD82rPpDnrvqYUl0fhmXvOEt7nqd1_YlZxKYwtahg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7Cx99l-tgJffDXsV1_SX0NMrhzDbApx85eAHsZ2iCLw&oe=6AB534A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpzxRj4_kr4Q7kNvwH8aq1M&_nc_oc=AdqlpqD7gEKGUJCxYgROwN-pCHguUz8CMr-hXMsecsjmue9cmyWYlir0hg3UgWFKMM0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfcbCUX1XR-A5LsZqOUHX9TczH106wjtOHCF6mXw0n7A&oe=6AB53924"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huKBnwxxHigQ7kNvwGfd8nd&_nc_oc=Adpk5pI_AfMtMYX2CjGduB6ekbIJJXyMrs1bSVSr288kqNWRNOLPGhfx6Mpn4Nox78A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZePdSqRJisf9v9JOz-vPqS7_iAKCqKTAZupjIRvW1yw&oe=6AB5261E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OVvbwDH09gQ7kNvwFpMvzW&_nc_oc=Adobk3xtHz6GnoKvVTLO2UX87rvZzSJikQuzZuoohoGNZILc_k95RDqfQIAvbw6f1RU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1kHfNBKeyDpTzlyJ4sR2QhDBzrvCW_3gvJZg
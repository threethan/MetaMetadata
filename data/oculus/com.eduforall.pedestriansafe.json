=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAE9coGBxRRWHG31Hvt8rRqrCNI-gJhWum1yRg4uTtXg&oe=6ACBC21D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBYNeopi-S8Q7kNvwE5O16C&_nc_oc=Adp1HtourpjXdV3KC2CJC_z0J8Hco-yxwlK2SeDHqywJBAvgcCwFoXdh-V0y1r7CwNs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4rOitxogEen7k37S-b6AkdsVlj8oGrScDy3uwPB61og&oe=6ACBAA5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG1NbqdMcLIQ7kNvwFy1xxI&_nc_oc=AdpxsKTY7QMkEeaepvmqdtTskg8_MiMbMV-w2Sz5jY0ZWFzGiOGwENzAy1xPw-V7C4o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-694WIa-vBas5llRLDvvi8f0CPVJy3r0n-UQY239gNQ&oe=6ACB928B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2xvswNfCfAQ7kNvwFJ69k9&_nc_oc=AdpRSP3PG7VbjDedeR2QImRMupPsbQGTEXf1ohYfmZYK_sSljgxFXkfs6kHWvA2VPDA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM09aZHVjknrpR1GC4jAIUpvH7TXhXVKBLhaIcL9WJXIQ&oe=6ACB9E26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=libgFlOuFNkQ7kNvwFmQOXw&_nc_oc=AdrzwPIOOw04CRdiDmxajKqucptz7z3tWL_YV8cgxL-YSA2BVgXhbRybZ7baib11WS4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-qIQN2U2e4BfsWFLCKX5SEFDD8F2ekK9a8mpLvTsLQA&oe=6ACBA2A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFDhrmyT8D4Q7kNvwFLhc1U&_nc_oc=Adqy7hicBX2Vp_fB7N9gXad182QxZg2EAd5Gegjn27jWPvDKhKYMgJEf3UAsqJQk9YQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPx7wi9CSsH4KwcBxXpTONnst34bEoBySbjM3WsBsMloQ&oe=6ACB8F9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CKFQ6gVZt4Q7kNvwGalnQY&_nc_oc=Adoj7pSLryijNOf0kQu03Ls-vz1VrcwHQnLCDni3soB4u05XBEB-wxVQBG037xV0P78&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOchAeTouUgdjwFiEx5a9MwbhYjh11APub2IZB
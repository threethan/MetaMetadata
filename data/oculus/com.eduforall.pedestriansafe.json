=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxFlPKBjZ55mtS8z0ky_YcFTNU9VZ3bgQe9ykaHFy3Ew&oe=6A50EE5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ig0-o-LYSOIQ7kNvwGfMOfE&_nc_oc=AdqzIM3nv-xC0-s12p1qGyiGZt5JapzMyZx96hnzAZJbuGXvbHZFynXpkrHZXaVYZFk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDawrJTc5InQoPs_cMhh1SJoliaTH3PPlO2A1_mVcY2hw&oe=6A510EDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5VK5NMx01UQ7kNvwGX9_tv&_nc_oc=AdoALN4Idj1Lfo4pZucr_wOfUpLPvANDnTgje0zbyvuSoeM7i5buuxz-3dTXOFX3zLI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZqXAtwfqwYCGZmKTznDXyiEg_5VQXAeiMoNP3LQkA8w&oe=6A50F70B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFykuBQrsnIQ7kNvwHnMICW&_nc_oc=AdoT7Flz-RdJ06g2EMqhPJMVof5cAui41iIvaKCadt1ZNdxKk-2UMzC4-A-Us3zlY-0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqyD7wruujcvfbfN8xB_zEWisikCpWT9YoBMrpwCCoAw&oe=6A5102A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O51vKN6dWEcQ7kNvwGB9oDq&_nc_oc=Adoxo9sExtRwFM4E6LYCQxJFJIHkJRifYh8aKJyW6LQAdMGgJ-nX8NzKZSgwJITr6YA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbLyd381Zju5MKIZnRJ5k0_g8UAW7t8_VmY7k_pwMNdw&oe=6A510724"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yl1_o64iRyMQ7kNvwHWYEP_&_nc_oc=AdqZOSOul-e4ekTVNu-8gw0Ic1l-CHvViO2D4Tu-k8eUi8p2LrTmbSvARBmaZ-yQr5E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2brF6Ywe1qUhzs-DzW3F1dg39CLT1hZUQ07vYSGjl7Q&oe=6A50F41E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfLteVpDP1EQ7kNvwHm_-ke&_nc_oc=AdrHLwC616BGYU2XU2KtUuBogNoVyFKeyQ41f-0XhAyNx8VfoEwQD0K118qXRoxdGtE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_BZt4kLU5ufM8E4EdRsBvHCNWEwDdufpfoqW
=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBgyhK36QUME5I6B_BvpcFMCCchtzFT1aqILLfquDZUg&oe=6A5A28DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ftsfou3soYgQ7kNvwHpEcyL&_nc_oc=Adr8tWRMQIdsAoiIeDcA6yLImF3iP4LOScVfE92w6C1AW4FigN-zpAhyzyB__MWmxDE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBX2dcbvoCnBGnwPc-H2yHbWGpYXXvJEZlLrlOgYTNb2Q&oe=6A5A495E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaOIlG2Ps_YQ7kNvwEmBqmF&_nc_oc=AdpM7l3dTbIOevgjhUhhNWHGnPGic0QcXJtPu_phacjoKGs-BbPcLRQ8LstTbiwE8vI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZwuGI1W5vmmHWkatteL55hbcmDyk5uICG9o0WFF75Ow&oe=6A5A318B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSwXvsjOMQQQ7kNvwEAz6Hr&_nc_oc=AdpsHFzrMkLLTRxc0bVNYCcdXeinID3QnxS9qA67HlDZAirTROz9S328rJKNMSIbc20&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDefO1BNUN9ASte7ScIOzdJsJWLQxQpgR_4KZK2FWbnNg&oe=6A5A3D26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zx1cOztwozUQ7kNvwFOMeWJ&_nc_oc=AdrkIYR8krHTnRbm52CLgTs2T_Jm3qivqhAYQaoapfmS6FQPMTftTgAO2RAECGfQX4A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuO-dI6w9p8-9MEWFBACcjuEmsZ0nx8j9pYcjFe-W4gA&oe=6A5A41A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcKQFezTSjgQ7kNvwGLrMau&_nc_oc=AdoC129Pis2BwKeFhnxwNAm-udJsX6BNotnut4YbLHef8ZHdHcRS1YZa2yilUIkZGDk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDyvkMrFYV8qtUk0hifAoVsUCVQa2_xHffCEhmg4rfdw&oe=6A5A2E9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CS1qkxY73wQ7kNvwHxFAxp&_nc_oc=Adop92x4fUMK9_IW04mZSyFMw-AmYYgaFADiCQwxKFw6qJu5iGCp4H0wg9XkI6ql0u0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrtncgS_nlVT9v51YwF05qbVVv8VyLwneriR_
=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af658t7q3r8lcDNjXjr_MMxwo6UjIRNSC8bSXvHg2vdsyg&oe=6A1054DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2DlDs-zhfQQ7kNvwFOjN0e&_nc_oc=AdocFb73M1EghExXU9Hh93SXXJneAp4WCMVQtzbESGZGfQJx_Z7R0RqGlhCUXi4R39s&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wZkJjkxgyprGvq-JBbM1nmCPVuTKWQyBeZN5NsvkLTg&oe=6A10755E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddTb565X2PAQ7kNvwFblWqm&_nc_oc=Adr8AUi31JQWgWKxWenU4S24JKJNG90qz9B3jniowKLYmXiDZexgDrY6szcPQId7dYU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4m0GydZjepdIWa0PDi5XAl7dCcYl9QHqLU__Y1E0GkdA&oe=6A105D8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJrBmalxgekQ7kNvwEfNmYK&_nc_oc=Adqe1TdoKAT_UXdk7gFjYPQoRtkKu9KMXZYrq8XvNehzYMpIYxrm-3j2PPJZ0gTqr8k&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76EffM7YemPA-qRWeQDJhluxcJkGujKj7UZvEgTZVEMw&oe=6A106926"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4FV6txTD3YQ7kNvwFoKkTG&_nc_oc=AdpVuh7xTL8R6IcrZhO5RG9CHAbRB-C01FQX9oSf3Z0UoEHiQ6juhZX71ZiWCwSsK0c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M-nFVkgOOO1J1zOJOLlt2TKEYtq-fgRNqYcX9hsds0w&oe=6A106DA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3JAU8bivXkQ7kNvwHEkSiM&_nc_oc=Adog7eGOntB7nXgW4-Xjuw54AQu8CBU7JD2cq0uwAF4VMqNaZ3RlJzbZwrSMJFVUJ_Y&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5j6FrtfTgUZ44dLoeSjBzHLGAR1EGxJrnFsKLaxwyU2A&oe=6A105A9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuAd0UzAjpwQ7kNvwF_bhQ1&_nc_oc=AdojPoeQqmg_n8vlRizWw-oKv8grpL9tasedLTBZcFf8pmXY677Iz4ZwtfhEX9x52gQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LZzf53e6TrTmSIcBWXHTirLSWtfHJG5aHIjc
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG0er0H40fFjHpcOXrqrdnN7HT6XlkHuaqVqclZnPo0Q&oe=6A4F9CDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ig0-o-LYSOIQ7kNvwGm5lD2&_nc_oc=AdqmYzcl2sY6MuJaZ-_hnMoluD3Y36Vy84b4kOjeRqXe-6awihMCGr2bq5Y2OTCUHmQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDassN_w-qJudejecXfMQ3cgsbIBeh2sCZA9jbEzxbT7g&oe=6A4FBD5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5VK5NMx01UQ7kNvwFK60XB&_nc_oc=AdposLdpD23AqD6uuNNXpnP9Fu07B5IdLt7Rp-q_LTQeTsi4Uri_WzZ9sRjAaiJAavI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqJujzyyZ5uqPPSDjCcg2_tTDGt0rDx7zm4AfWnuk3YQ&oe=6A4FA58B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxRdygOQXsIQ7kNvwG1B0A0&_nc_oc=AdqLrw3sMyTdu4dtyjg0vJlQCvi1q3_15TnmFlr2GaQE7BMkflTK1xTlUMAQLfholxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDD3fSqFnajGPedvvPn1aqqhrlkPFxm7lXEkViNsDviFw&oe=6A4FB126"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O51vKN6dWEcQ7kNvwF_SGPA&_nc_oc=AdrJBJSWfDIazDJJ8z-oWoBEnfn6U_kqAGXCEwkjUYC-3K1EgH5YWZZwBo3Zl-vwSTI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsHuldPXJiU3MZz4UwnpyvOn7H1py7RKFczI-45mXUfw&oe=6A4FB5A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yl1_o64iRyMQ7kNvwGJwCfh&_nc_oc=AdprjSgonDsqR3OkcWmuQhCVqnLQIBfmIEzEPdRKlm34vdAYVx5mpdw9v1CGxWcYKu0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASzimu8WkRGmu57Eg5OufOKOpl4t--e0JtwhtMnDkjDQ&oe=6A4FA29E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfLteVpDP1EQ7kNvwHd8DTY&_nc_oc=AdogtodSVs2J3e-VafB3ajxtYvtuGEjpjTT7Y47HeRbYPfvW6RrL4MkL7wQezk1H2DQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbpCKcr_U6RviAbwgPI12f_sjl7AfwRxiAbn_
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZL_XCDEHkh1yTQEXcIjBODHyLMoPkaztziun_exK3AQ&oe=69DB98DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXaCUMooNF4Q7kNvwGTgc_h&_nc_oc=AdruUMwYdN1KNrleRLYYUVekmKc5sZ4p6ExH8JMnSZFTsMJUQBihTOVzdaCaUNkRSag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fPI4t1uNlxGUVWUQeBltfz-hYqD6wlaKBIc71-1Yf-g&oe=69DB811E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7bdwEH46LwQ7kNvwGIvFRm&_nc_oc=AdqlpUj-gOuglyZb7fWpZIWwikCZMh-Pk_-pXbgeYx0L1KFAqVgzCb_gvE0vQDVV6U0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Yt6-kuZcjfPsDPP_c3muHBIBOBw9hGWlp8nXkK-TkQg&oe=69DBA18B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEv8nFB8cD4Q7kNvwGDjX5U&_nc_oc=AdpjRG1RZHRGa_QPagw52GPOrG0MngMSchszURW7BqF785QEV5MaQqg2q5WEBcTLrYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1t9wDzNPAlN7NfuT123MAhwEOeyA1t0SKnSscXCg4_qw&oe=69DBAD26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28NY8n03j-4Q7kNvwGBmRdA&_nc_oc=AdrpiGye_nAnf4_UOV4W65SBblgQb1ery61xr-Sp2Dhs7yZsWokRONFMXFLChkm3k3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nOYUNysXaBedwK6vsdINY2ktyZO-xd65CMJTc7Gn9ew&oe=69DBB1A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V7khqmPQGsQ7kNvwGDV3Sy&_nc_oc=AdoyFyF6Qt0087ODPIdi1euGTK3zCbeyjZYPoIsDsC9EaI1eWDWWDBTfxjCm4RLFFik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bXdN871PvPKAN9LlRpm9utauOGDFVWY7egsDhWVMbog&oe=69DB9E9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOygr6nqtIAQ7kNvwGvpjg2&_nc_oc=AdqlGLFUpvrJFo7GuyM0lQy8o7hO-inDofCYUwC6HLQuCln825XpsIds3-DODkXwtHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LowiNCtf6vhdaWSM4q20Ocux2EAyy2r7dp_d
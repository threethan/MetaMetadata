=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvAdwwV0PeWKR5YNdywztwKZeqOP6Oh9FTATXvE8PWtw&oe=6AE4965D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDn1ywF1wlUQ7kNvwH9yQVM&_nc_oc=AdrLsnb8COhn4utxM2FaguEN4TUoO8hoawiHhJrXQDlcjPpSaw9omnJ2_fD-FjOFSfQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKk6o6aoQLfUAAXbYmmA5XtxlNhoKcECB5z3X-EYtNqw&oe=6AE4B6DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsFss_FVh8IQ7kNvwG0dkfq&_nc_oc=Adr7fNWG3I05wg7x8DEuZbt_cdoQjfvb_JrxDCzyf311cBJ8RHtFTy3tN63A-KATHQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB8hICNNpJlyklxaSHJgohBhVL-eSiCQAEuC9mMMiT1Q&oe=6AE49F0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYVX87H9LWEQ7kNvwEPahtu&_nc_oc=AdqgWw4hLknkkDSfJXtl0hI7b23hCmu_MveoF8bSYKWBlNFlh0pV85W7AtpNa6yYPwY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPq-2hwP4q8OpiJ7guX_BT2vtUBd4RwSrCiunteRULsCg&oe=6AE4AAA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GchW2wY77K0Q7kNvwGSs-nf&_nc_oc=AdoRCGnSKObhqLW4RaNOO2iS9udTK-nS05pfs_luBGHeMafxxG8r4yM1w9qcNhVgOQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDsRrzFU71EZwxC6SJoesswvkDDOcCerBrKbaCE5DLGg&oe=6AE4AF24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYJT9gXkCvsQ7kNvwHGfGBr&_nc_oc=AdpG3PifuvPp4kk-4-uHD3_yZ2tDuYRNi-PR19q0CeoCejKSGQnKZNQwts9rCqAIM_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXBsJmkETCbVjKfW5pYgBMjRmtOM4pB7nhuAIox4U59Q&oe=6AE49C1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wo3s0DrQKLcQ7kNvwHLQDSX&_nc_oc=Adq1jNEMsxcHKTWo7QZ0H-43BBNXciNiFbmvmjYH-I1L8fytiZRKG0_qarsDkp6suEs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwN4YZCXA4nvZUJvlHvxH-eE8sg4Zjh4B3s0O
=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPp0pfSVB9zTfJFQZeyHxYsA-B2SG9QYPQeocrbl-tGw&oe=6A899EDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG2DeYlq684Q7kNvwE2zTjP&_nc_oc=Adpo4AAOkAmpRAMaM-HTSFcHBHqlls-eZ0Pmcl4x86XnpMudtyGCpGBGCWBkHI39KM4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOGWcITCBCAunVGYEUTO1kba6HSMbMDPSCAtAT0EVBNQ&oe=6A89871E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCK1Evxk4zMQ7kNvwGAnsC1&_nc_oc=AdrVbf7o0yFA1fWkWmHlfWgSLeVX7LrlOIWzG8IHxo0walioNMoTTridFgZQATrzkC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBuk_ty-Hh2pJ2gi_84AxHVxpA-vW71u2jxjHlnc3nJw&oe=6A896F4B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTxYuhqFF3oQ7kNvwHyf2A2&_nc_oc=AdohtOcP2QUM7zN5Wjq3_p_d2NYfIMLjFTa54YAw7Lsw_BqpnLQOFJ1xMpZBScoaps0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHczshHN27IVUnikxUAGsrReeIbNgsuizTJCjHM3Ueq4w&oe=6A897AE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLDAF80Nd20Q7kNvwFzfqHX&_nc_oc=AdoB9bdtwBCNmgDH2O1UDwCIgvN35uwbvXVuN4fd9aJ7bQUvadEk5YgXSuXxB35CKr0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRpGRhSZy2_sk0-x6Np5qdIOqt1ncMstNdRKqpsY70Kg&oe=6A897F64"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYJSgGckuaEQ7kNvwGKueHS&_nc_oc=AdrF2Isi8p5YuClmV89-dPBZQkCE1IScYMwTABaXCKktB1skD2aJuamwlYJ-LPQuogY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqqsnMkoNwIzGYEaQtqTgnTZTYmusdOK5KHYVOm-ookg&oe=6A896C5E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGdc8FHnoO8Q7kNvwHfcKHV&_nc_oc=AdoeSCP_9NNrFBna5RR3UpjTtEN_olSXtD1qOIq-lRDQ9edf5r5TURH1W4ZooN78iAI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn1Dwo5XmIunD_ZR27UMQT2SZ4d2KonTiQx-n
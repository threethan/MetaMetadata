=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKNcIP-SwMggHWh3ZcDQRk0GxCQGddH9gf8ETB6tOwuw&oe=6A4CF9DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-x3qXXaJDwQ7kNvwFdG8CA&_nc_oc=AdoqsmRA8iBQhZnE82sXx9ZadHknQ2eLEyznbclSPTWrEK7xCdWov6uMYHnOWhELPK8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcjyFCni4HWk_F2q5lc6Uvp3j89D0eqweEhDWLEi7Gug&oe=6A4D1A5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeSF33nqni8Q7kNvwHm2P7K&_nc_oc=Adp9iseboV2WZsZIgcD8-XbTgaotCX2YUoCYKrRVPm1fThrPtOWii7AxOsCuNt0E_XA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuvozdW7isB7IkIff-9mTSzhy_02vDmImkFEBzke0FiA&oe=6A4D028B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxRdygOQXsIQ7kNvwGHa_xK&_nc_oc=AdoJHKh_NW-sdAiPUyMo3XKZFFgWkPk5ENoHDfYDpoBCE_Xrw9xCA9_hz_OR8nKcwx0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4BzJhDOdDrwjAFzg0tpMgYDhMQuQk5Q3MO-B6hBTW6g&oe=6A4D0E26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-N29v5CNyywQ7kNvwHmY3W_&_nc_oc=AdroLSkBzMXeKHEKU5MqO4BPMlL8hW9k1NtCEw2BqusY2-3lrCZW56rtNJBzS2Thh1E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbyO2a3UhSfNHa0R6uiX4J0ctN-HVGXxVSY6_ZHt5rWA&oe=6A4D12A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOz-P9fzG7cQ7kNvwHJMAkd&_nc_oc=Ado3sis-wGf16VlsiQhX7hPB-kNnJZszBiuh7_W7_FCyWZVYJ_YpFhz9yOQfMswr0YA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLyGajOi4_FHVAUzjBT7mR5T7g0LztZ8Zb2R_ayxOxww&oe=6A4CFF9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ck4ltXYgyggQ7kNvwGDHe05&_nc_oc=Adqa3a8Rv7tlj1RmYQAIySC1jYj__cPmKXU-s2MW3UFeqselGirse7vhW8oK-47ezzI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDx4UPuaD-Id6jVQJ3FBaXKv6wQGmSRjTd0XVN
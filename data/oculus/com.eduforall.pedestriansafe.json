=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mPvOBrO4_8-EodLXOwabdWNUIL9jwhu8PwsCrZSvitA&oe=6A2EA75D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yqje6aqSPtQQ7kNvwEJ9APe&_nc_oc=Adrm5i3tcnhe4D3oHkZvmHS-S-bHdTriJ5M2AosRqDHKlalnT2nqNnLJ3nkMd1hqXFQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9L-AXfYlUPQPCFt_R8BsDKo5iuqscWtg02hQ8FxZPhgw&oe=6A2EC7DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Df2f44SWh4sQ7kNvwEbN3mU&_nc_oc=AdqvY_pCZPX9jaRhMwb8OlmV1tInHhMoD-TmEm80NAw6jLuoYzYL-NLhuD6g6r3ISUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ys7VEv5Xvz6vPAXloGJ_zLxJa18METAjhGEnSeTuPTg&oe=6A2EB00B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69orrKqya54Q7kNvwFj-U7I&_nc_oc=Adqr-yY1Bph3qD_ixMW2PTMFW7oqAdCsOZMbHQcQNwDiNh_xQzIxSyFfO0RP_twWe44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__x2zpqWABjLbyrFmosLyTOR5bb52fr55-r8VTYWPU0g&oe=6A2EBBA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqejN-Lgq64Q7kNvwG4poYm&_nc_oc=Adq-VwAxWpEbx_Y2EHBCinC8t9FWEV1Dhj86DTTdOnBQsG9wxQKOdi6oY-kkD_Rr254&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94iH-xRNGMp_WHa03a53GQO2uT1xXU3eS1jkUhBFE0CQ&oe=6A2EC024"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ft6s6bQjxMQ7kNvwFIAkhd&_nc_oc=AdqdbUzWlTCZFsp0TFH7yThnWk6c6I-yRpn8EmsX2CCIrcJp-P8LRVzA3OIGBVIXk1o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9V-UhBEQk1rK5xLUl3LJilZOzwouKETlNlekc9VKXL9Q&oe=6A2EAD1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfEJovZ6YtMQ7kNvwGYXpbA&_nc_oc=Adq5qbLaUU-umSyGrJA6U81RlmcNFAuliALsqAvtTtJ9RX1qBkoun7UxCMUxVIlMKEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XQGb0gGp2jeIgzmu0Cb_KP37825Rk2ACFDzN
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJmNui8ciEIgrePTirrP23PUwmgU_Z9Dki65BNZKuGRg&oe=6A75D85D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdrHOc6vxW8Q7kNvwG_uwZ6&_nc_oc=AdovJD8gFKYz_h5wRgMdE8Xmf9sUKLuR45GqiDwRqyW8XO7wPATrJh8Y1pDJqS2HPlY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBpFoF3I3Ku2A9u1WtraO98AxqSr91Na-Mb6IRuTrCPg&oe=6A75C09E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nl-vwjnU-BIQ7kNvwHZYK7K&_nc_oc=AdrLIV3V23IM7FXNR2cG2xiXlMsTeP5tmqOfx51tpEVgkOKHtIHSJ3Y0W886PnMJm3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIJUyqX31gqcY1bIoPpz4TKZfWwZIu9IXavtNkkwPtAA&oe=6A75E10B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G55GeW71HMwQ7kNvwGJPigW&_nc_oc=Adqb7dy9plfbMdrewSiQ4WhrDQNmCADmp-z9jFoab5Gk4Bto-ctzghCGkw2iLlijiwg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXiSglHEirhX5Bmrt-lQwm2_l46RXwNlb_Xr6bpNzK5w&oe=6A75ECA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmlCDVERP74Q7kNvwHSPAey&_nc_oc=Adq3_jv0KkaI9SgX1vlp1nXRHsckkxU3WqdznSOJL0Qsl6iAuPxIDhMm8cEoW1NYwgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGq4yhj7VgbTNwBXXcC7l3MhBY3CeKfVmSmFO4sz54hNw&oe=6A75F124"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svyBQSP1KvQQ7kNvwEPhMaU&_nc_oc=AdrH1Cp0gjLodO6XLBiqF1F39k6fqUVL7cmaBDvcuFwy3kwK5Ep_6SDRdQo1r7WUb9c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_aidLjAQprv19jYvF2hsuUlIAr7mDvhoRJOU24L0wnA&oe=6A75DE1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMXi-7x0ergQ7kNvwG6ZZjM&_nc_oc=AdqfiCHrAdF-4_nx1SscSn7FM_4UChJg3NWrU-_EGdsiCcwHDdkpKzyz7w-_xYio1sk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKrdJhJ7dQnZnmeLlru5KiRPTHdsEUhBENFhF
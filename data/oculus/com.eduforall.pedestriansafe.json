=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMnqpB0NG_Aa-IqocrxtpWVGkUWLsyteE1Sll0SYuHJA&oe=6A54E2DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x01Q04O6DXUQ7kNvwEFOJWa&_nc_oc=Adqr0y7z7Fa2aFeVmaO8rm8pmElNYQgGiXOVcbNJu8ScGGS6qVIMV1jA65y0bH9A9H4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDT2pktR4pG-jeyr3lcCCpYTXBtlzYXPQnGupC_N7sogg&oe=6A55035E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr0wvKiMEVgQ7kNvwHnMVBo&_nc_oc=AdqvI1PKQv_MiU4kix6MqX-9n5HGvSKZeVvotYlopShuWnYxdRJ4YeQWhfZdaDZky_A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsvnFmMdaox4shnR2iB_dpeA1toioaG2kuVtCxipmTzg&oe=6A54EB8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cGXrn9-3t0Q7kNvwFvNsu1&_nc_oc=Adqa_UgqFrkAnR4XOwYG_yIxpIT8WSWgvvX2WKIBVpXn9bB2euQxXOqqWZJmzLdr8Ao&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVAOlqz1uHE5uhoY33wbU_ninBpwI7r_ccxqB7brBGzQ&oe=6A54F726"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AtbAVLacWcQ7kNvwH270GT&_nc_oc=AdqhqfufXok7IMt1D5xGdJ39ejOgCU3BTa-KXjl7M2R9rrtZupUHnigfbru9rGvwVpg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCanmZKCKACSGsqmTMm7i5SREOZMIfY4auruxhCOU86FQ&oe=6A54FBA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkoxjNqUB_cQ7kNvwFyvYB2&_nc_oc=AdoCyNKEC1qEFJPrXWZR6WFWtuwN0cZEPwTKmUpP85Jzp3JmjGIVCIkVwcaQt-tshcs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNJVJ-wsxB8lSY4_mpDabD0JKORj5nUz3JO0TumwjHkA&oe=6A54E89E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTD8SXAJicEQ7kNvwEOFL--&_nc_oc=AdqfTMqLGIKVDTT7WvlxtoTAE_zuwxGUVCBNOPuLUrr0o_cRmBExuQUy2glart1YDgY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiLje-zeSsCgnoSSWXWnD26Qf87NG-MEdu6Tj
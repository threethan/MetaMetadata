=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeVd32UjBgtqwqGlamTL5bcRxxINnblUuAcE9TXGLB3g&oe=6A66065D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OieZNhAjxgIQ7kNvwGli2Dn&_nc_oc=AdqnPhXsNWL9BYIZEQ5ziEeJ0H9MIBYzaSuPUtMeF3ZJXst03Tbv8e1z5TrSa9SK91M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsntGaV5iBV7gL6JRI0zbHbjJifoqIQ0klak3IToh7UQ&oe=6A65EE9E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMgZWVz09r8Q7kNvwFq-D6t&_nc_oc=AdoZvXPbrMucpbj4h2CvFWvBSWv69_qOL9pXrXgpyKO3QEoU-vLq9RW6mkG4RrH3Kns&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_6x_vukg_f7WP9kfqPMZpR8BDZLfCe48W6cmOZ-kP_w&oe=6A660F0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udyVMA0KzW8Q7kNvwH4TCNR&_nc_oc=AdpGOl1kkSzS3MgZhaMgR7-plhqJ_YCpYgZeyZgFN767UZ_KauxK--lGU7YiNd0DJ10&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRwWDqDMwyT4k-06EwydggbHgiW8PnFUhYuOOReRicMg&oe=6A661AA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1pcHxh_PtQQ7kNvwHt7zCZ&_nc_oc=AdqX73Jh_4PrVHabuvM4ERPSH5w8hSM3eK_buLDh2TOsr6Rd3TIrSOfM0W8yND3QMGg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBY3d9TnzPR7Y3psuS--FcCnYEE6LpU0n3d3-GHw7NXvw&oe=6A661F24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaZ8pbU-AccQ7kNvwHsCP7M&_nc_oc=AdpFnyyD7MdPa9piR3dJz39hfvCFN7PUhNKnvB7D7Lxq5DF_z1f5_A-liIxQ9OmNdzY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt9HcpGBnn_QvjxJQJnqJYd3E7r_TRo4iZTAWXZYUcqQ&oe=6A660C1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaqV_F9yWl8Q7kNvwFLhkky&_nc_oc=AdpJgpiLXpYtBa28YPgEQhAHhc-1SX9bN1psqo4YQOcqBtztFjlhT8eEjwVk66RurOg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1xTxvMmiL0eHrgcOncZ0RJbPjzXvlApLmVzg
=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDceUGggzQRAxRfpCI0AKf14sXSZNSTD77a2v6SLJb6oQ&oe=6A4A56DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-x3qXXaJDwQ7kNvwFoA3h3&_nc_oc=AdoYZuwCnBmMGIwwx3knZPReoHL91UmOwgM9xVeW_C5kR0oCBBeZhCol6de5TbiJW1o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvS3XSOERE_po3XRLpq5IX80ZdWbRuBq6lcnzcIogvlQ&oe=6A4A775E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeSF33nqni8Q7kNvwHIGZIJ&_nc_oc=AdqC4ozgg9RfCdF3RPkqeKX0WR7aP6rZjrAC906AGlpbSETHDhHh83h_Vglryvvjb6s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0uLZ3-mKIP2nS5G_9O0rHG9DZfFO6UN_j7w1ktimw8g&oe=6A4A5F8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlHnrh9uIyMQ7kNvwHZ_RW7&_nc_oc=Ado-WEXqNEfX4I6h92f8BXrcmIS6YDGlJKl2ubotjYqebRjejI_KUvahBIK5ftp3Be4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtEoXXOsal-RP9uy4nEyHR2afeKlQ3yBAjEzfsxZQu2g&oe=6A4A6B26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-N29v5CNyywQ7kNvwEtKCEu&_nc_oc=Adolte2xMWgrCSZ9G4APnKOM9FksOXOtbkI17vzFust_W_gnVJWa1vWJek1i01-LWPE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDewFqp8pC1y1Ne-oHCwCqio0K5OpSe7NS9mPiboNJfCQ&oe=6A4A6FA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOz-P9fzG7cQ7kNvwEntj4g&_nc_oc=AdpFxQhQZl8jpsuVaahWvKO1W6kT8LjmoOlig8PIqkeDEGhDF-bxkuN4nuynh9VE6R4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzvqqIj7NGieoEgxYCtSPbX6Nbmo-R6V0KutywRoR-jw&oe=6A4A5C9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0qmL_DD988Q7kNvwFuf8HS&_nc_oc=AdoGOxWMrTGZJOEvaoyOAdCaRjyMtw8NnZM3_8uKfxlFZ10ymnBbPMJ1VmPMdQuuCms&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC735t2ph9NwsjSKz3FoVoLWI8hbTFjMFsohgQ
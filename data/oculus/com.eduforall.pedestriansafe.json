m&oh=00_AfsrLmHV-7qLPVn3ZJHs5QzTbU6xlI0S0uadE7G9Q_AgBQ&oe=69A5739E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuzcfR9-KYEQ7kNvwF2AIsV&_nc_oc=Adnz4pY2c7Coqce98VM38bIzWQh0Upc3MAsS3F5MjlEgkbUgExf6ETzx-A58T_coXNU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs4-Hj3CN954qYTBNeh7VqNUwOL1OuJIdDPWYXs5D1pvQ&oe=69A5940B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoD2b3aVjBgQ7kNvwEhuHU1&_nc_oc=AdnDMHiq6Cuys78wCeqhj0WGX9uiEWSYTmdu62JB1MFUYvcHSCn4hp5Gfug2U-c8VbM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsaOfrJJv7L9LeuSb-OGZzSIFauA-B-mw_jmr3Xeu5r1Q&oe=69A59FA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ts4_1gUk8ZgQ7kNvwH2Mfw-&_nc_oc=Admci2IHWhqC41XdPi4olOLs-YhnpBywO7dI266jD_8W41fcuMo8NCHOlJfXP00eG_E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu6LQdPE7nSXSGMoDhPvCP_UgTk14Oq8lGrAqcsc-AH_g&oe=69A56BE4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxYI6uU9aNkQ7kNvwHgP-jo&_nc_oc=AdnU9U0H5qTlYRHt6eWSZv9-tfkGryzfBuaXZmiserXxS-BagSPJtMUpqjQom60m2hw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsRz2PZhbRKL9vU8PiIY5yTg3Wkq0W2AvmDbRbAjjC9yw&oe=69A5911E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbWdHHyU-yMQ7kNvwEjUCQ_&_nc_oc=Adk6rUsxRiTHk74D-hGfupzRJkyAwTAuNTAw79xdzyMyCsWGyBpkgv4u10Sd5ffqqzo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv1J3x-mD4W1AU-lNPNqSQe3RkqaDKD71uXQWWPVJZiyA&oe=69A58F04"}, {"file_name": "[\ubcf4\ud589\uc790\uc548\uc804]\uc571-\uc544\uc774\ucf58.png", "id": "1843110519761474", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974788_1843110523094807_6196787795280771349_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqhHBuVSGeQQ7kNvwFpo028&_nc_oc=Adk8-u-Ba2Gjk-k95XbXP2mxKpbw6rtAU9yP7QjLhuWGMY4-4uGgO6c-pB36517N_h0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvAsqrb1y6V91uOHq3KotVFWMGmVUkRBMkhgEezURXwZA&oe=69A59E34"}, {"file_n
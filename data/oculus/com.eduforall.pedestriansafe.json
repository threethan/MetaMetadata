=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWYv8gijFcIe-tjqJVnSVUGj0NqXAOJP8KKQv4kPrT_g&oe=6AB671DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Euq_IcZuGMQQ7kNvwHVeu5j&_nc_oc=AdqWuj63Nfy41BM9LgBuMgjSPOW_7ixcMkpan3LHKxm-mJPrrARV9huUa5SMFyN3VSA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWvN5QcYPfkn5rDrzKagiSl3QQxpnI0kRZocJ5fcY7lQ&oe=6AB6925E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvd5iamh0LUQ7kNvwEYL6Gq&_nc_oc=AdqPfAEk8AsHkW6OqgeSm3YXc3Z1jWFj-FkT0zjYpv06CS4BJoX2REEUiWU4nYOVvJ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxhd8VQTGdxCgBoDrMPq6lAQEa5hKE5ZMholgfZR-3Dw&oe=6AB67A8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m00yRae_nG4Q7kNvwECe7sj&_nc_oc=AdpxR8RxFf38evlWhKmkVYH77LWPkLQDkCjOTxhpL9i0ha0S9RNObw2D4IFJh0P2KUc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGDg0oFoDtinHSq0Ny5U_Gc-PbIpY9L-5ExkuRZydz5A&oe=6AB68626"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpzxRj4_kr4Q7kNvwG767Fq&_nc_oc=AdoEu_0RZM83BfQPLoDbbsS0MGEtuip2BYg5Vv1euarqy8m81_ClG0FQ3rqNuyvZGiE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLNh9ndBD3FQwyBnpoDfemjsEkRzGPrN-4Xi56IWy7-g&oe=6AB68AA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huKBnwxxHigQ7kNvwFwXQua&_nc_oc=Adoz51hMkrZq0bTm4NsgKc9QloudI915PvT0x8pCxP2bX20mPHh1r9WDgl4Q7t95mWE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdq9yPseTarIYH6grsxvrYDQ9br0KR_n-5a5UVG8A3cw&oe=6AB6779E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYMnDZFeM2kQ7kNvwGKD1bv&_nc_oc=Adpo6swKcN1mrZXYkEirkLL8uIhaWNTrC-kdPzElMr2-T2-sYaUez2lNBEwm3l-SF9A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXeWOsLwYrrLgZTFks3FTluu6aVOZP0NhxD5q
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8hSleq3N7FginsWhsgfJr4irBTXmUI6nx3aDBQs4Uaw&oe=6A5E1D5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoZs53FkwJ0Q7kNvwFsl-Ny&_nc_oc=Adpm8WQF91inB4Hl3WsuVzhWXN4RnFouw_RgDz5isPreq2hmAIspmshGTO_b6yZio_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrhbWddSyMsbKo6aq2CMeJ3r_gZE_jseBEkNq-Y-Nwpw&oe=6A5E059E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F24ip8ECP70Q7kNvwGChkzu&_nc_oc=Adp4FP_oR1-DCXfd3Wf3mA5gUyq0t38q0uxqEp3_fwGFNjnJYWsieh94v8SF-ZRX5EA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBW1pTG-eEAkITSNb3nyOXNIoyjNimszLvtELrND91taQ&oe=6A5E260B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzgmsjhWV0gQ7kNvwGbCHCt&_nc_oc=AdpOUgX0SNzvIqIPtya_xeWWmu7ZyFbWkSLB5gFwXaA6jPpefr2GbtuDBl5MJB6Hmqg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQgj_WvSlx81atlumtvyRW9BwM4-VdGehSQYHkZoJnkg&oe=6A5E31A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUG-gkMoyZMQ7kNvwH4xRGG&_nc_oc=Adp2SImlS7l3tnqzCxcvuIDOZ-WYcCv6uNCSS3hunsSQPxU-bwTHxthZ8Ys8UoP-9Sk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0rsTGalc5vQSb5mmXplVvzftgRu3bbKvvdzvomAr6YA&oe=6A5E3624"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TspJ0wOZbs8Q7kNvwGbLgrn&_nc_oc=Adqkao18OHVvi7HLRNyBCQt_m931mUMCKumNKf-61YBEh9TU4nE5jSnocMRYPSE9AFg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8Aylf_he3dMNu40UU7Sw6ChZpBJENqqC0WYPJWeCF7Q&oe=6A5E231E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5K4sBooRkUQ7kNvwH4seZj&_nc_oc=AdrdZwnno1gqwE0kEpLHrs0X7ZAnxrV6SZvzsTe8v7sHc8l6BpPX7g7JqBjpuEno_8Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnlKNI-F3dFb1p3-B9NHNc6ngKLaYRSV5gmf_
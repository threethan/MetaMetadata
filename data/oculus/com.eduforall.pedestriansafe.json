=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuEzfDPU45YB0lpUQmmyVB-qURfBv_7yY0SFi7qA7ImA&oe=6A53915D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x01Q04O6DXUQ7kNvwHpak_o&_nc_oc=AdqB_rYZNRgU5wPEZohYBSDmyb53k4R25xN4SU-CrG6Fg839C49pI965-Brua8cbFh8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFJ_3vdyjD8XVKHU9A-MlYnjqpTXslpfnd8LjfgDjleg&oe=6A53799E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr0wvKiMEVgQ7kNvwFBnbqw&_nc_oc=AdqGh4bS9B_rzhwvDL3Ng_wH0CTLUAghQkwO3C_5HlmbZIEoWHYO3E5AAGv9AjM3Cx8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfUaGkE22wHhDo-Jt44dzTcvAF_LwrkmRRi1vq0QB8lA&oe=6A539A0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFykuBQrsnIQ7kNvwFK7lJ8&_nc_oc=Adoqk7FnyVGcLoB-fU3q7gFLOZtvtQnJgVxFtdXc4F7algEB8Zfy-E9IFTID7bIjCnQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_swbexi3abLfc8t5uijl0g-gtSooTqFnku2KexOStZg&oe=6A53A5A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AtbAVLacWcQ7kNvwEo6hZj&_nc_oc=AdrHu58VrTGCeEQcY60SRjbNsVwJFt7gCcShBkMm2RHg7eyNqmJ4MLV1YQ3dWBFNCHk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAS77ppT71WCahX1I_6HwkAznHJgnURwsgD97ezU3b2tA&oe=6A53AA24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkoxjNqUB_cQ7kNvwHIFX1Z&_nc_oc=Adq0A6dqCyvDO8TFc02WkxH5ht739TA1Hh99dNMarG_hesdrEH7VoP9IOpdTBPYI34w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhuAumtLnbSKAhrNnAwlSG8jN7Slc9mhDZd2_FjlX4ew&oe=6A53971E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfLteVpDP1EQ7kNvwGnC24B&_nc_oc=Adqt3HRWgBkZLF0LjD2PCxuGVSp_2IQupxjCUrOuxf3Q8o9fDr3lnOG2M706oi1iE5w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDs35moHftNMT2nuUAF-lZ9dTqzSA4aogftaez
m/v/t64.5771-25/75488379_9195068527253294_2668161467724780624_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-az4uO4yaHoQ7kNvwGkDa9J&_nc_oc=Adk45XhhzuFv4lRTfcNMrVcFR6SDmiJaHk4O38J2GfLCu2MysU6hjofhBD1zI62p6Cw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftejdixnK2dmZ6rU_1CP1Ers3kozocMc3NE91oFFoG_hQ&oe=69A1A620"}, {"file_name": "4.png", "id": "985683270137264", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39035392_985683273470597_5682883843199344465_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j74uPBye3yYQ7kNvwGDVeWG&_nc_oc=AdlY0uS7Ct3_DNmkbBaezynyW_D_bV7jRw7USiSAHNLkt0b9Sdvl3lB76uwj83qgpVQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftEBI1ZCWKqFf7uBOPg1454S_EB7gsnK9T2FfOubLZNTQ&oe=69A18099"}, {"file_name": "5.png", "id": "1412420799735316", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974471_1412420803068649_7767631581415265926_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GB1Xdt13NU0Q7kNvwHQQ1C0&_nc_oc=Adnlx_js0_vwP0UOk7Z6ESwAEk6JmKIqcgZdoerwuiPI2hIWzFaURr6HJelTg4flANs&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvCGKL0rt55yKZ-4vRqWlh81aRglLxAxF-y51jOMDaW_w&oe=69A17647"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2484960861698447", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974521_2484960865031780_1569075632799989806_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4F1zQTPT6DoQ7kNvwGdQ8rB&_nc_oc=AdmlLbciBvZSn_emktaH7DvDxpmTtk-uir3jmAc-jOu-Oda0SaO2QWxDzoD4T1IZLh0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuuInRp5Nnb_G5JaH7X-v6eRQDvwmGM8yEe1lJibyJvJQ&oe=69A17F76"}, "display_name": "\uc548\uc804\uad50\uc721 : \ubcf4\ud589\uc790 \uc548\uc804", "keywords": ["\uc548\uc804\uad50\uc721", "\ubcf4\ud589\uc790\uc548\uc804", "\uc548\uc804\uccb4\ud5d8"], "long_description": "\u00b7 \uc0ac\uc6a9\uc790\ub294 \ub300\ud55c\ubbfc\uad6d \uc2a4\ucfe8\uc874\uc758 \ud2b9\uc9d5\uc744 \uccb4\ud5d8\ud560 \uc218 \uc788\uc73c\uba70, \uc2e0\ud638\ub4f1 \uac74\ub108\ub294 \ubc29\ubc95, \uc57c\uac04 \ubcf4\ud589\ubc95 \ub4f1\uc744 \ud559\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\u00b7 \uad50\ucc28\ub85c\uc5d0\uc11c \uc548\uc804\ud558\uac8c \uae38 \uac74\ub108\uae30\n > \uc2e0\ud638\ub4f1\uacfc \ubcf4\ud589 \uc2e0\ud638\ub97c \ud655\uc778\ud558\uace0, \ucc28\ub7c9\uc774 \uc644\uc804\ud788 \uba48\ucd98 \ud6c4\uc5d0 \uae38\uc744 \uac74\ub108\uc57c \ud569\ub2c8\ub2e4.\n VR\uc5d0\uc11c\ub294 \uc0ac\uc6a9\uc790\uac00 \uc62c\ubc14\ub978 \ubcf4\ud589 \uc2e0\ud638\ub97c \ud655\uc778\ud558\uace0 \ud589\ub3d9\ud558\ub294 \ubc29\ubc95\uc744 \uccb4\ud5d8\ud569\ub2c8\ub2e4.\n\n\u00b7 \ud6a1\ub2e8\ubcf4\ub3c4 \uc774\uc6a9 \ubc29\ubc95\n> \uc5b4\ub9b0\uc774 \ubcf4\ud589\uc790\ub294 \ud6a1\ub2e8\ubcf4\ub3c4\ub97c \uc774\uc6a9\ud560 \ub54c \uc190\uc744 \ub4e4\uace0 \ubcf4\ud589\ud574\uc57c \ud569\ub2c8\ub2e4.\nVR\uc5d0\uc11c \uc190\uc744 \ub4e4\uc5b4 \ucc28\uace0\uac00 \ub192\uc740 \ucc28\uc5d0\uc11c\uc758 \ub0b4 \ubaa8\uc2b5\uc744 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\u00b7 \ub3c4\ub85c \uc8fc\ubcc0\uc5d0\uc11c\uc758 \uc8fc\uc758\uc0ac\ud56d\n> \ub3c4\ub85c\uc640 \uac00\uae4c\uc6b4 \uacf3\uc5d0\uc11c\uc758 \uc704\ud5d8 \uc694\uc18c(\uace8\ubaa9\uae38 \ucc28\ub7c9, \uc8fc\uc815\ucc28 \ucc28\ub7c9, \uc790\uc804\uac70 \ub4f1)\ub97c \uc778\uc9c0\ud558\uace0 \ub300\ube44\ud558\ub294 \ubc29\ubc95\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.", "short_description": "\u00b7 \uc774 VR \ucf58\ud150\uce20\ub294 \ubcf4\ud589\uc790\uac00 \uc548\uc804\ud558\uac8c \ub3c4\ub85c\ub97c \uc774\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \uae30\ubcf8\uc801\uc778 \ubcf4\ud589 \uc548\uc804 \uc218\uce59\uacfc \uc704\uae30 \uc0c1\ud669 \ub300\ucc98\ubc95\uc744 \uad50\uc721\ud558\ub294 \ub370 \ubaa9\uc801\uc774 \uc788\uc2b5\ub2c8\ub2e4.\n\n\u00b7 \uc774 \ucf58\ud150\uce20\ub294 \ud55c\uad6d\uc5b4 \ub0b4\ub808\uc774\uc158\ub9cc\uc744 \uc9c0\uc6d0\ud558\uba70, \uc2e4\uc81c \uad50\ud1b5 \ud658\uacbd\uc744 \uac00\uc0c1\uc73c\ub85c \uccb4\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n"}, {"images": {"nodes": [{"file_name": "\ubbf8\ub2c8.png", "id": "2069319833533263", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/468725195_2069319836866596_8946935124449417766_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdMK9OPj-twQ7kNvwGDfKP7&_nc_oc=Adksh1fct66M-bUovMAY0zIgMpH7j2fcy-lO1hENFsn4XlYV2JUfh8iayqMcAu4U2-Q&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftgoTKY3W3MRgXPmydrFmK-39sMz8SG6o85koVtalSYmQ&oe=69A1A0EA"}, {"file_name": "2560.png", "id": "1958144254664663", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75371508_1958144257997996_5402494376169652053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4loxvW_UlAQ7kNvwF2pRNc&_nc_oc=AdmMbLPce3S1PWT6meKL1ukfZVa7Q8IBXJnH9gLTEM31rVFJT7eDdvLsm054m2FLeMY&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfunG7ddmPW2jODEDTxnbuQFYfmyhDI-4NNhZ6UBB6gC-Q&oe=69A194F2"}, {"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "1274294210494308", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39001696_1274294213827641_4508473815298717681_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCMHXI7R0msQ7kNvwGWyPzb&_nc_oc=Adk4oNDCY2yYlrym2G681p6ZGsQfpCrvBeCoPX32bRP2vBgfHHq7YGSbTbt1OS9mvEA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfstC0xlrNavXZOoQ56nC-w71TB6Vz639jD5kIEQ3jOxyg&oe=69A1773F"}, {"file_name": "[\ubcf4\ud589\uc790\uc548\uc804]\uc571-\uc544\uc774\ucf58.png", "id": "1260787378515383", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974471_1260787381848716_1546754576997205911_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ms0Pazh_fO4Q7kNvwHbzbV8&_nc_oc=AdlM9LH7xdaOQrHYXO5livWn2FyJIyhuFuy5Lgo7evu4P6kTonRDm9k7nJUNeIBlukc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfssfRDjr-sJD7id3ujyXoZnhhMADi1kWz_a0gE2R41J1Q&oe=69A18A7C"}, {"file_name": "512.png
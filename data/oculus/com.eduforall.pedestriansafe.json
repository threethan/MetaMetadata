=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJujYjkGTZxlzzOm7eBt5heHdXtG-EgokdIAQOplHIhg&oe=69C3DDDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9Ju3xtCSygQ7kNvwHgWJfY&_nc_oc=AdoLVHjp_QaxB7NpL1VfkSD4nJ-bk7Vq_iS56L2aOL-7h-Fb3gAMg3DDQ62azkBFktI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQAvGJ7wRWy3jQPhileTwgZ7rSy4VOTCa-Xh0iq6nQew&oe=69C3C61E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuzDFg40eVMQ7kNvwHNV3rY&_nc_oc=AdrkBsSo2Kh1Eb9s-RUwy4yMuv2Yror7fWKL1rffS4UX6D1OyKUq2gTaOLSbcYyPFPo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz20TrFnhp2jl-4V_d-W6VSsipDRTcC2zHd1uBmJ77hYQ&oe=69C3E68B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTeW5njJUZoQ7kNvwHySVxf&_nc_oc=Adq4-2Lq-IOnakSEtw9OiTBQyY9ZU_C7edoAvRzy5GIBDh6fEffpgHGO-IlQ_8H0LLc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNAyYVaEqTU2nRstKRC9ctfKPUbHWR4uX1zpZ7s4ccXw&oe=69C3F226"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBXVxmsdtPAQ7kNvwGhug7n&_nc_oc=AdrGk7r6nvs3MK7-r2PIJ8NZWgkvWAKNbUVB1oWSGl3_ymIp-Dec7lJxAfly6omrxes&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWHkFtIKuS7o4YhU-jfVPU25JwiDDS-p6WvM_dFnjW1A&oe=69C3BE64"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xAylwJ-SC4Q7kNvwHO52SS&_nc_oc=AdqMQeEw2dlp0mdyksEqXlP4GSe8oXDOLo1lA2McwMKGG_q-OhcyBzvM9R5B9ixvKL4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_9VmLA-HxQZxgB2cvX9fvJKMmunWZDpfnO_PkkfThPw&oe=69C3E39E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtUgOCpGF6sQ7kNvwE4y5Sw&_nc_oc=Adr7dCl1KmzbJQOMX6fbVDdTI-BKnC8tgkaD7JdNoncHpNE3cfRL1hcV0G-n6qjD1rI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7jIrbo3dQQC2zAH9Jnl4-q7_K2HSvJfJIFax
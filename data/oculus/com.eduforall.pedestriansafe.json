=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25jjAbFtNsSbFQLg7rCnWpP5QifTMnEQMmnvvaOdlfyg&oe=69D25E5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikVhj2QBS7AQ7kNvwH22iT9&_nc_oc=Adq-QkfwkothnIYrkyR6LIGHdgEsnP32ZMFd_07w-E1kmSean0nk0UF5UicpSrahtCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20ZDrcisQokOb-RsBgTk1A607eZg8iLvJ7_Z0wHAEBLQ&oe=69D2469E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3nVkBJ2M3YQ7kNvwGmMO9Y&_nc_oc=AdqpjHuB1XS_-OIR8A9LIg9lsr_8N9A5rCR_ZlEMKA2f_D7q2HzxkrSAS7FZa5TSg7s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21ipkubYovOfCsmhfj7GrLCSvrN1scxvrEEt-i48pYyg&oe=69D2670B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fU3vcbLllEQQ7kNvwHgQx-Q&_nc_oc=Adouu1Xft5nekYXOBSdvYFjU892117yfwd9qk97t5OyNJu4IRwHQ2D973FhUY3As7TM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25C9lD1fOAHMO03UWJMpJg36EiBPJPhwV3_DFcdlzLgA&oe=69D272A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYhI6086nDIQ7kNvwEJb5rz&_nc_oc=AdrxjmxWg07JKP0vHZWil8m2hKaMfRjhY9ET2OpacT89VVDaX4JhIsn0etCOyYuJXHc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Gd_jzVqCwMsxU_DOpdMPsZTFhtQ1gQnxd6VMQ6oa8Cw&oe=69D27724"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTZnvZhCe7MQ7kNvwEnhycZ&_nc_oc=AdrZJ9QkOzPG-WJn8QK4-3Hvsabl1s75pHWL1OEenTYSM4eSMPD6Gl1R9iWdGJMYvM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RuOBTzdy6oOljMWOOlY4MxtsgQbv_DVQJhkNb2Z53nw&oe=69D2641E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bn3bo7kGtjcQ7kNvwG7zT34&_nc_oc=AdolYx0HPg33DTdoeSvDsgLYGRDxMwb7lq78Mj3dldhak-4UjZvOIFPb91gJTK6xfIQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tJTS68A529UaKO1batnCyGZwZxm01WWjeNXH
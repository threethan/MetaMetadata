=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jm4i0bVTaUnuCtrxMBgwCjUENphUptfvm2j_urbBR3Q&oe=6A241B5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7tv_SxhrlYQ7kNvwHYOqIn&_nc_oc=AdqO2-fvbTSwS7_xQ0tnzWxZXXqOvSTXagxxpG1weq__LxmHoN0sZbY3RK7OpuBJDk8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zAVPqULgHGaOfcaMI1NDZGvDXtNmXDrh2tkHr_VRGeg&oe=6A243BDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKgb1XyX5ocQ7kNvwGDW9-a&_nc_oc=AdpSilK3QV6I03FJS-gBGdU6IhqOn1wSHo35nsk7q_8wMEoUKG-Tj5gsEMyFkOvg1fA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mAy2IVGZ3kzYZHgtifWK4Z0zDNil3raN2lbB1cTMz8w&oe=6A24240B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8GFF51qmhYQ7kNvwHz2U7z&_nc_oc=Ado7RwRdqG6VWyYFYMLXlleVtBgfIck40ABy4C-78SAQuZjXCa1sFEW0ND9JyjdwdZg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nbo3rU3nvjms28gRxz_UiH4NU697xWL5gIDsJGmkM2g&oe=6A242FA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5qdTOZOTM4Q7kNvwEKkjRz&_nc_oc=Adow87DxbBDLwrKo6FANKCbC4SwH6Q0m3G9xxlajkJAnlw3n4ToH-pZ7_KdP1i5S4SQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_No8JOsWglt42dCgiLIvM0ACpssmCl4LFIBknjSCkCng&oe=6A243424"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqP7eCHihKgQ7kNvwFRIcrU&_nc_oc=Adpm1EzYnEsE84HScPc1cwp_ptqJZRCh6-HxPjbeBzxX7FNDxSz9z1_9mKdzx0gtZ1E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EV2v_iEEerFXlB-MDq9TjOXvbT7k8E_zdka-iho3Hng&oe=6A24211E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvDR1kh1nSgQ7kNvwFuIq3f&_nc_oc=AdrC2bMfovuOkQWiVf2Z_LyX0NLblGoMxN0f4Qmo10ROxeH4BSjmSadLz5EGeRqXvMo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cRWLsmuUuPCGxYukAAmg0RR5FA014OOVvc5h
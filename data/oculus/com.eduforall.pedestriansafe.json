=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WZIXeso8Kk49CcnHBz-L6txRmvS7tuo1pN1Yc1_F6UQ&oe=69DF8D5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEA8rBB_lqEQ7kNvwFqPjMc&_nc_oc=Adq1pQdr0ELBKkH6dSfMHdt2Ng4yTyMBB8y57x9nfI94sTiROqU_ieC4AUvTrj7wMq8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dYaQ-TcIjAPjx-pd86uewa0QxREtfTbil7u66ZTL8wA&oe=69DF759E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUKryDl3pjwQ7kNvwFJN561&_nc_oc=AdqvmQ9xMY9T-Q4TRJZJkmh58jr_BV79ihVLVo2BFfQQ4sWArSAwlH5OURbSEzpbVyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14iixc0YEBq_p_jWwr1E5aZkatLjunNpkFEbaL5WNFxQ&oe=69DF960B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PARVRPDjibgQ7kNvwFJSHTe&_nc_oc=AdpSHJQV7xvQVV8pQt81q7b0cVJI5eXlZ_6ZH-98HrSnu2jnR2OhUst-CuuP69OEL7s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EqJSch2w-Tmg6hdwT2ZP3ICxzSiC2MNEK5r70gfoULw&oe=69DFA1A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSbGfuaJzzkQ7kNvwEVzR4N&_nc_oc=Adr7mrQnqOAsiMg7jGkckwVhtkN3WQFkTfzQ6n8tH7pI8ElCo65jP6rAlm2EKs6hkV4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29Cz-4OMLmfeFknvUzXyx4FGBwA55EbBonQDECUmoSdw&oe=69DF6DE4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLcVQv67_tcQ7kNvwFCjKxx&_nc_oc=AdrNTvqBPwg-DmS6R59tdU4PHfOlX8c_Blpl5ScMDOVg397b_2SbIv6wcyl1ttPe46c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19LGBVZEaYfOvYXzxyOnLWcZcwxEtbH2VRPD1dyGdajw&oe=69DF931E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LzwufupMWwQ7kNvwEIEjs3&_nc_oc=Ado90f9z0H9oVM88HZUugcL6iQE0TIARkVKo7YnciIoHBut_bcyevT_365K1WG3Efe0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06qH0p5mSqeP1ujnbk8QimhsBUUEKrkV-fFOS
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ-3TmQmYLBJ3M_sWhwN3wjZvCxkC5odDTPXganwr9WQ&oe=6A787B5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdrHOc6vxW8Q7kNvwGkaPfm&_nc_oc=Adoc3UPN7HaD8AJ93nkDtuswSB_cJH83Te9hi-fKLK0br3VFQqnRO-DykKHLRM49vlU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJGvHzdmn-tmeslLWk8yhKcasQdQ7GLux1VPvQtp1T_A&oe=6A78639E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nl-vwjnU-BIQ7kNvwE3-SpR&_nc_oc=AdpGZtbno58uSmnktcacaVqWjEVJa9bpd9l1DIKMR_N6ByuOA_aQq2-dJPDjV1R_Tso&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdsGOw5vuhfgr_Zgp3RY_m5Fnr36sTjlawUKMciBn0WQ&oe=6A78840B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuZaIHcMS1MQ7kNvwFMkOnI&_nc_oc=AdryD5ZQbKsAVjd-DlbPxdElHiKhkNb_5BZydEZuiMLbMWr54XysXVmAC810DRu4iMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJvsmxw7I4wDE5R_qpcWPuEhwazeie88F8rNDSiMC_Ig&oe=6A788FA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmlCDVERP74Q7kNvwH3DBF7&_nc_oc=AdqPm6IFpozMY-884AwUAw4xK8jMi4D5so9Yhu51y_V25Y1S5nt7zJ8OWuOplvBIH2Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFU6et34wRpJ4HiwbSGNi5NcMUpEFkeV9nVUsyIAeWdoQ&oe=6A789424"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svyBQSP1KvQQ7kNvwG8duzV&_nc_oc=AdqSnMRLbqz5ulY_1f8qMgYm_fLHr-mwXjppxZGr5CzUSMHOsBjZ6hIkARdKPoOEZyE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqPXGE7IRAWUq1hdoSRcL_yk8p00ucCPQt1UhjJvzlDg&oe=6A78811E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaHLzcCUyrgQ7kNvwGAn9MS&_nc_oc=Adq6WP4fp5Nw0bQ1BYBY93U5XFR2nQUEKc1dAuAjGmOVPaDC1nQ4xnuB-saIVXkTVf4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwhJUqDRJY4uJVg0IQTWN9aMpg1fyHJvsYMkQ
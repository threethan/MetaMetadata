=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_E0Z1TOhlmXu4hZBdQUxGWZeHjqsNusYAaz0ZKEiDUaw&oe=6A26BE5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqjeP6sbuX4Q7kNvwHl58R-&_nc_oc=AdrWh5kETMTJQBFxZSOIcopqJpYda4cOImIxp4-5i0qSNNSCchxbtfG_F02isKaaSvQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90amDSfBrjlyRMdXgEInOghDryRCOGRzHe48Eolx7k9g&oe=6A26DEDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Jd3_XdWjkYQ7kNvwHPo4gP&_nc_oc=AdqWQg9uAa7vghw2cAuIc8ZisGbqfCtU9LZKSv8ki8G10h5bD9TsdEg0nczLNO_A4bI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JyMZ-nvhzubNIT54POcWG5M0HVyute5kbFLlqV2hvDQ&oe=6A26C70B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iryaRDU8AvkQ7kNvwG8oOkC&_nc_oc=AdqejTE9prw6UvQClAhXoR54UB3d-8ELXfFcqIqQrUKInLGAbIxAw9HTZ8r-pXfY4Zc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lfQw8LY8Cmgy2Ec_pOzA3cmBgDGlTrXfkPgDJWMrhqQ&oe=6A26D2A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiwyNUP_WhUQ7kNvwGwJ_vd&_nc_oc=AdrnLmlL_svlBmn1Bxm2BhkaGGptX6fM0pVYKQDIRCv9G_TP9y0ktS7SoZVgHUwY4dE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Qs-xc9TmqARWSu4rIhmUmIRF2XQRTYh2HAQ9gtVOsjQ&oe=6A26D724"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zxk0TdLiytMQ7kNvwHBd18y&_nc_oc=AdqjnER3yBWLUcazdRDTEhbGz2atx8bEuV-S1gdr1chyO6ffFT9gn20iIx2-oMYhBV4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84g0t3AAxAXUpwJt_uq01AcgQgGeXIfiz6p7vIXHBm0Q&oe=6A26C41E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvDR1kh1nSgQ7kNvwEHqlff&_nc_oc=AdrQhkd633JMyBWbQ8P9hFKjV5XADBLh2_G-kRvCORRVNjEn70haBoX-Uc5JLiztNHs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PCqba3gaVDmurf3sZ53rWv5_b8b6lAaoHcDn
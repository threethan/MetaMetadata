=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CpYsHPWBPVR3tNK37ueHMECbTg2B2jaxfdZWk1So6Bw&oe=6A2FF8DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yqje6aqSPtQQ7kNvwGhgsx_&_nc_oc=AdpUhtMBDN_HCSn4GvyXV9n35CNAD3OGbpnSBQxP1nAtKrIK8iVGrmf5en_3dZbkO1A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9O9NW6lKDZy-5Xl7-MKZ6F9iJI4KI7-TGcAD-2W7UxTg&oe=6A30195E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Df2f44SWh4sQ7kNvwGh9Opw&_nc_oc=Adp87a8GtygNZg2Z0umEeifk0atDXS3kswRK-CQZ4ktVFAc_BxJSMz6dcj9SyEM_Dhs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gnJchkf0s1hD9d_tPC3eRbOoDNf0Zbxfm-IC_ahj9yA&oe=6A30018B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69orrKqya54Q7kNvwGGHfbu&_nc_oc=Adp9TeExjCsJI4VKMAFjsHSiSHAzWWw_UcJ6TNq1NhZpNsHbQtscJgX8j_Q8OqcFMWg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fBZJrPiEpOUtEwZfLkg9WPRqx37FZ7cDBGua9U-HrRg&oe=6A300D26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqejN-Lgq64Q7kNvwECHfjV&_nc_oc=AdpupGEFMh3-ODSGxFeOLLP8ts7ILPiUvryXvkaHysM6DU8yMNBKC4gRez0DZv1IPu4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HMJ6LDuk1kzU5sxSe-xodLvtEpNunYwekPpgG8JeHog&oe=6A3011A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ft6s6bQjxMQ7kNvwGKucFd&_nc_oc=Adr-NQKG3cNov5ZDr_fssRt-hgxP9kVHhCFrNciF2ZLiV1Wvc4zNyUBjG3gZCihop7Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sVjKharoa7gBNm30Oc1kxiKum62AS4VhT4dRDYCdP5w&oe=6A2FFE9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioPXm4P41G0Q7kNvwH5rAho&_nc_oc=AdoLaYXSQAm1f9QMMN0G_W25AiPvwsIzeaQ4vFlOEORG5ozcpm_EahyKDCgIOk1-Yog&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2DpZAT8dPX-ovNgQzxKtkLc76wquzjj8Jx_z
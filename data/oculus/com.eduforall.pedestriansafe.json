=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8AgyWBrSdOD8q_Zh3FGunCjwsYfqlZkhZJSybHSlrxQ&oe=6AAFDA5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvVPpvw3QA8Q7kNvwFNzV5F&_nc_oc=Adoe_1Y3BCnEr5rn-LnfKWC9MPo6iAomXqoJzFY_L401_GCwRyslM0I12VsF27JatCA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoLRaYTBrqv1udWvk4E7Ux1FOsAgGblpMk7FwvbKFLRg&oe=6AAFFADE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0uN118Enc4Q7kNvwGVKk55&_nc_oc=AdplwANFpb9gnhA6FNftK4g0seWuKtbIBbQL_66qUzIS4tIcZcM6ssGcdRyfquNzNX8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb2W39UOfpd4j6V3RBlkeGZZq0xdWRhDtgYMLqpuASyw&oe=6AAFE30B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHDpeG5wWbcQ7kNvwEjngtR&_nc_oc=AdrNHSzI3Qhigc_X8xE3Mgf738YJDRv5oY-ETQFpDa8mcAPrXkah9BxpEfRcir0hkNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuGgHUIHM8m-vt89rNs29FhwN3lAti_cARu7RziSFx8w&oe=6AAFEEA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdj7g86dqbEQ7kNvwGBc9xc&_nc_oc=AdrRkxdWgQuvYJSuf02Ny7Fp8kVsFNS6jcXrl42pv_kWDhjIE3j1Z__UMUILATsYRrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNx7XFcfL4kOyZXct-gOIkF30PCsVgOfzqZwqsf7q1-g&oe=6AAFF324"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIx5r7VAvAoQ7kNvwHtcKla&_nc_oc=AdqyDvn4ARXhWtFFX-Q9jR03ORL5RXpfO_o2FREAGTX-9cXiWrQhK4vRnADUxuV4lD8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGL4tG-jMTpT_IchcwOJEnWSvoX0aE2nN4mijJcbtHHg&oe=6AAFE01E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vBAxKMvTRMQ7kNvwGdqzJ0&_nc_oc=AdqVAosSS_x8e2zkZ13subpOs6Ocz7ggRnZtOIdmLE9GD7h6JzvkypKqS6MRTjvofrM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUKEGUdWDZNCxx7bQHz5QilbU49gDVm9rF_JJ
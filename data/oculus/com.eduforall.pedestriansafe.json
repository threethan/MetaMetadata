=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8si_kFxNzAeTBEI-0VkGU-VJZCQpIjcFjOwM3SaaLDA&oe=6A73355D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OKwO1t1O9UQ7kNvwEf_ooS&_nc_oc=Adrg-pL3bfHioiw0PynIV939RoRaYR5OXJOE6N6LI5-ujVADWg77mgAEekMGDcFtxoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErNlnkge8GW3qydafFNq0F3VVmXyoRX48HR6TsXbVGow&oe=6A7355DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxjITCD2uoYQ7kNvwEcMzKe&_nc_oc=Ado3rNKNLCR-Yi5RanYk0R14snIwJrm_ToDf-rMsp0UpKLPrPGlWXJcWlCPcBfvmuwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4j4rh-PvXyRWc08Vvbui21QSVUvr0A6owygnqj5X6fQ&oe=6A733E0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UI7IqI41I0EQ7kNvwF-dMSd&_nc_oc=AdosV-4Fc7JwTKjzf6E_KgCDLvGA6QgzwxBpOvtokyLR8iF-IQt5_zm0DYfWlc_H4VM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGTMA6PR4SsPCVbia41aTJUZz4YvHeizdlx7N6loQp_A&oe=6A7349A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0b8NDzRDRcQ7kNvwF3X8LI&_nc_oc=AdrKJgiqdwx8M_FMV7NmHuyKEXpc8zCY2Fbbl50on8KsB0glRR4RQbiX2SAJisQkeno&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWZGCYKXHuKNSkiYFDgnidOs_vnkBGNtksBMA4x68OPQ&oe=6A734E24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0ZpIUt-2OUQ7kNvwFlI--p&_nc_oc=Adrt-soT9-flqZTZwx2_VY0LpUCwinVRkYv-wyTuFcqvG-aTKprzKzrwk0dry0aq46w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0JTmy3zrbU5V0G4YTYWysNah69iMxtjEsgcPb73nhuw&oe=6A733B1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzwHrZE4O_QQ7kNvwGpOSJp&_nc_oc=AdoBTqvpP-sB6LdVlp6OI0F7yW2ozNtPoS4izbxCJwlRh4SM51HOEy2qt5nlCkHLKbw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpIQZG4YbEnqgDD09oEGatfL-IWTMNiElA6JQ
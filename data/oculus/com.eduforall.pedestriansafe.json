=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHbIsOBhrAhFRpiAm0zJyZ3tYYQeIFA8UraghC5W2jMg&oe=6A9D655D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09o5VseXMkQQ7kNvwF_gMhH&_nc_oc=Ado7UZoFWk6U6Jy-GIcUYS_ABiS6XZAIhq6FQt-5W7DNtwWPcryEZMd9Imf-79te5QI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1rmOqzscgn2Rch2KRG94o7bJa9FR4sx2hGPAlqfr7Xg&oe=6A9D85DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Erj4MYvnMkgQ7kNvwHwzDw1&_nc_oc=Adq0ifwEbzU6cccwt_BJgo9Oyb3TUVh5R8ZNaH5CXbprr2Lda9QT-6uq38wAvMCXmv8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoSzMTBmDIE3fOUj2azNrf45zbAYhWn-Uzpts31_6xzw&oe=6A9D6E0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wYIUEXqC0EQ7kNvwHbfJjU&_nc_oc=AdqMWS80xui9fQnY4A0RpM_TfHLT_baTAvv1fbVinTrN83W7n4cpfy3k0Tsd3C9xacQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5Yx2eySciYq7N_947QtAdIlhTeosm5JLs-b2YntUyAQ&oe=6A9D79A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NqtcAUQlmoQ7kNvwFpQuP2&_nc_oc=Adoj3crLJTfwki7qxUE4jxK8PrTKV-4xnU-Gemy6r14y8TsE3Ulqv6-clho4wTmank4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRrg9_3jLag5fFUW0BJewsJIuONfD_jAmVcgSvH5ej6A&oe=6A9D7E24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXofBYhVefoQ7kNvwH6qW9Y&_nc_oc=AdoVLmBqETYX4bPrwnQcEjsbOgj0YrJrcYU8Qtqke26FPHHq2YZCl-ZU74941p_yHFQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfyTQsh6VeBYIfkDZID_cu0nVTLWhChMGO_AGpjjJmIA&oe=6A9D6B1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noetHrjVShYQ7kNvwHBX5_6&_nc_oc=AdpRUSnXd71C3jNEG9s6-cxsNgInEiuni9KVfj56kj95HWXYh-CgDSh_Tdu8z0MBT74&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5hwta_1Lm50_0Nz4KndGf9DFkMPPgZw3a7UA
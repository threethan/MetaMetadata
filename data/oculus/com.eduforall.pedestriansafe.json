=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JuE8-gfdGX-InW1oOOmJG2FN1fk6RO86akJf373diMA&oe=69E0DEDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEA8rBB_lqEQ7kNvwGa-cs3&_nc_oc=AdqOF_pnE3I3n5PzfU9HR4NC8JIVJRpSD7zvJnr_9v1uPBP9APwHJKnD1WdmgxzzDqA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fQ9cf-0nZ0ZmQ7VFuaql2m4Pgi4aS7wNfeBKSbr5rPw&oe=69E0FF5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUKryDl3pjwQ7kNvwFmbhOi&_nc_oc=AdqzRReytaLqWNCYFAO4Vsh_2J-7ybC1zk6s7EDZTPdIP_GUVynFzaUmCVWHNx0YXvc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wufCXAjxR5_cmgt2ZHM-XPUeUGT663-3xK7ZdvctcYw&oe=69E0E78B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PARVRPDjibgQ7kNvwH9fi_X&_nc_oc=Ado3fYK2tdh0A-JRmTVOTz0z2PtzsCr8BhszFI_D9eTgNiAHuQN-CLusa6bHJU0YXZk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qop1uzZjrtsw3YPcZ-0jOUpdTdxz-p2aVojY2aRZNjg&oe=69E0F326"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSbGfuaJzzkQ7kNvwG72A-r&_nc_oc=AdpqwQUmuO-QThQZUt1fZwKs8DwoV68pphZSD7O6T2SzicE4nCxUOGsQifp4K_G18Z0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ibMK81r6z9toe4lO8-o11--hui6jbLacZotPmYrbUZw&oe=69E0F7A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLcVQv67_tcQ7kNvwGueKWf&_nc_oc=AdqCizc0P3VF8VV0jPGWTkZfYkXivR8s1hwQAY1neUIUk24NAWV8gC92NyNznROVxWE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DxWXt5gq_SrOrEFL7W6hEnW1LfIgiYs69XMcnS9nzBA&oe=69E0E49E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LzwufupMWwQ7kNvwG6LD-L&_nc_oc=Ado4caD9Eq1Aq3GlZcRwLtvMvOaWbtPr4Z35eTQ-CnqU0BQlN6J1OPAyNApuEr9PyJY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2J6RJbAKLlq1aAzZGMAiSjrxW1yux4fiOnAtv
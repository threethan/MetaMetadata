=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1xkP-NvA4FlDSYBf3RaQhI_6g-i4ed8EB4kQyv_oufg&oe=6AEE091D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2mq5zwEVG4Q7kNvwFWSD0y&_nc_oc=AdrClRE1r8wZBUjHNpgu5qjv4dinbhxFp6Ap8k1vq1ccRB1TejOBFgoJ1I0SgsxV-iE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDAbCGSvhDt6nQ9q9g6zBte4ORNjuviiSY3BX2Ds_6wg&oe=6AEDF15E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ms4ZSZ6WRIQ7kNvwEhNXL9&_nc_oc=AdqVk0R8iLqajmipdjZq8pCkvntQobI6Uw9SQUHa8uaqyRoTv98i_ELU94YB1eij33A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxwEMryMWgS3ECuLhiN_gxhsU6DhjaSp2p1Nc04HGE_A&oe=6AEDD98B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDyrlqijjCcQ7kNvwHmY56r&_nc_oc=AdrcVRpI1OalM4AxgBTEuprqwFpyRbBt1u1v3KSrpaWm4QoF-KXNQq4e77KEJG2yw_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3mExtdBkIIN2P0nlJsU9qHo0onqgYkYXvbYILvIgmLQ&oe=6AEDE526"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GufnENamdGcQ7kNvwEMmumH&_nc_oc=Ado-A_PiY6b1vPyGk0mLYDBj1jHGhYccx76WHtby198nd7uRP1EEXzh9ASOCzVx2s9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF9aQv4lFPLv0dGNNRrziinx3oc_HZI_tkmiPZ-rxT5A&oe=6AEDE9A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg-jLMIEFUgQ7kNvwGz5OdS&_nc_oc=AdoGAkqoKHG_MU283pqHlaK7v3T0CxUfcIC0FdRY0BhU_ubO6jIudFzZHQkBJWiyoQQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSoQC8sAZm5XDzaCeAqGPklsEM04DN80qbD00mKHW4jg&oe=6AEDD69E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1TjS4vuJVkQ7kNvwFJUdp6&_nc_oc=Adob3x9nAVIJLC5xC_uB3q2AqWj_zUDbokGaac3kF-tJM0TeyvudaXOaZz6Ne-aKOtI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHlHMPsezNIiZLjkZCiUDH4GE8I-gG-4HQ-ek
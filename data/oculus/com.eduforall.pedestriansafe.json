82121187132_8308184151168799368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENqSuT7G0RMQ7kNvwHLOqjW&_nc_oc=Adp5-k2CoyYwEm-tP_RFN3g2nqBWT847QS3MzJmxrkQLRC__rnw1-dEth4amsAnOL-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1HNDyCyKwpeaHhy1RBIVFHJXvbgVWTkZYJrPw6s0vEXA&oe=69F0B0DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOZ846yBXG0Q7kNvwEdg8Kz&_nc_oc=AdqGQarkvzS1xIckOpGJvP5GgyWFLsSFQcBhHy5APbqByMA-tnW7lhGrc-YK44zSJeQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2VJFtduOF3fu8xbt_XYlSBu-OfG42Xs2_bjG3JsQHupw&oe=69F0D15E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiVN309qPwwQ7kNvwH65vKE&_nc_oc=AdpLa7gCDYawv-YQbEiJxjf-OEptecvo9-zwe1e5fTUHi3Ds-9WFL9YfJYHDG2QbETg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1r-gqyR63U5TiXICNtzpES9R3F5wF0CE-alGhmXm79yA&oe=69F0B98B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBnS9m8hPvUQ7kNvwEyrJMJ&_nc_oc=AdoHUpVuJwh8bqvUZrVDuKXPCPKozK20sz3CebkxKdCA0KNAUSfIAlLOEgbifWEOyG0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2eIxbY0a55tmBDoPBTzslp19NNnwt6X6CzQCVLNF1cZg&oe=69F0C526"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTyv9fYOaY0Q7kNvwHXRDEw&_nc_oc=AdqB3seZHAxjs_ydvSje5fSJ7zxpNHfGEF8PC01G2tmt2N0TEk4uxQQXH6A2vqhEfa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0whk_VPQ5DOyJI4ap5lP4Y_KOTFFCUBn8X3WWXn-Q0ew&oe=69F0C9A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}]}, "developer_name": "Safe_vr", "developer_privacy_policy_url": "https://www.eduforall.co.kr/SafetyEducationpedestriansafety", "developer_terms_of_service_url": null, "publisher_name": "Eduforall", "support_website_url": null, "website_url": "https://www.eduforall.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OC
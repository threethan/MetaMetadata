=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBw-Cv2YdFus2wkh72Y5IvFQ_zswuA9WXmrJaQjCk15Q&oe=6A90365D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6R-fhL6SrYQ7kNvwEIC2O4&_nc_oc=AdrQmUMZWZ36MWer8f4ejF9b7PwUVSCjyzUNqIPc6EyEaCne8-fQT3KLnunWFS7zaMQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8-OOGaGVP261zocSFsZNoL03JLW-GSgX8WcPBXe604Q&oe=6A901E9E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sa_KlnAadQ0Q7kNvwEJGBIW&_nc_oc=AdqW7hd7cU3YKprhe8_062HWHV4U-T1rhE-ELBTVCxjprcHZX5SIE0Xf8wFUTOcNUMw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGeVuUMhEcLDpy1gF4_DFBiZ2L2i-pt2UcS7GLaB9Zhg&oe=6A903F0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iF9dzyrWGPYQ7kNvwHKdX_Z&_nc_oc=AdryrKgY45qR9mfi3puUSSpA74zzAIFSgBTsLna19ZMKeUTUbLHFDnUQ7Cq0PR6IWAM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVMTJahLQy9HhAcKhw1uZ9Jd0hp9NIUDS_4I8JzQBPYQ&oe=6A901266"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a56nyFawddQQ7kNvwHUa-50&_nc_oc=Adpni6axq_EhFLVX_7aoQBoAc59FOlyvCjEq_e2gTWYW00kVQ__nHnIL8dfzEu98l-0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAE7ITfPQhrW-WPD6Kk8qUlWgyIkfZM6-AGjKhVPaeXg&oe=6A9016E4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bjpz6ehpp_wQ7kNvwFmpKzr&_nc_oc=AdoYuilcpTsqMNEd6KFHZ8QJ5srHvFLNqVwr5LLau2BDkWLx6hhqXSlwUPMV1ZbV5eg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMm4AH0g6dVnEePoG-Wedt6Xo3Zpmj3_BrBz39Nurn2w&oe=6A903C1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7engJtRwwIQ7kNvwHULZWs&_nc_oc=Adpj7rm9CIyhJELFLAa4wh0VwkU5yC61OdrppvfRQuzuRwWpXTdb8fKi6BNV00vjzJY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH90SOSJkHNPQVM4qbra36JyONgfd05RagFMJW
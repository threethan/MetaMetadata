=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_bvPEo7XnrPfoZ8KE20DmJZQUArT9rl9-U2P5lZGC7g&oe=69EF5F5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOZ846yBXG0Q7kNvwHfkpfx&_nc_oc=Ado3v4rh40pn0S9Sgoa5WdmjHQzT8c-CyqmrEKQVfJqSpKEaB6h_gg8MMQwPjdVGqhw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SjkjIiOl8qRiFYIV0Bm61ZYpxDV5eQkKlwsx6sEIJkg&oe=69EF7FDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiVN309qPwwQ7kNvwGezvqy&_nc_oc=AdoY3NraIJiAqcZSKsppwAqslN6agvYdhZEp8XcK-y8EhFu5_gTXELUn1Lw52ebZ4fo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09zpEtUyP_4fEmqylr__K1qk0_U5oCjMnLFPnhk8xEcw&oe=69EF680B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBnS9m8hPvUQ7kNvwFQ5onZ&_nc_oc=AdoMOJoOirksIiBCeF5YlUaOo6pPBE4xEmmg4_IzjQleua6D4cZkyJTSWI_ZrmOaro4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2kr8-bsIm0h_vf3Q3CmJhxZkdY9KrUfZ-8e8Gsi8z4Vw&oe=69EF73A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTyv9fYOaY0Q7kNvwHkw2Cp&_nc_oc=Adry1aY2eaB00L5Y33cVtE3Fv-__uuIYKUf6rDad7qSTBt5G6Iv1NY4ay7Dp15rYXdo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1a0wsybeNoZGU3jes0z52-Y0mj7q1vXhRaY--js7kmWQ&oe=69EF7824"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdGKNSQiOscQ7kNvwEBIQyk&_nc_oc=AdpnBs7Br4Vl2IOOEuS5ZCXoY9elyfwZaRsPoj1guxbohx6p4v4cXJhGh6CWvf5OU-o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2P96Lv6mkUAh5g-Voahbk2YeOm2GHtMo4e9A7cfeiiYQ&oe=69EF651E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQ1ja35QlTcQ7kNvwHzhWkE&_nc_oc=AdpFVFc7C32UZvoJHLO7e1I0YL-2_mhbE8w4TKT2t5KArvy8_Wd3RpmuOzfNFs-2NSo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3uglFl1F0lnuWd0V3qpFapO_06fmdNPpgtdL-
=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGx1_ywztT31cK8ehxGq0sXjoEzr8cKjMhslTJcnzYoQ&oe=6AA0085D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09o5VseXMkQQ7kNvwESoMqU&_nc_oc=AdogyNST-ifwbzGuk3NoRWQ6HuGV46LKLfpIRHWw6M4-5xblPniDgMGDg1IifQCCU_c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdcoKB8u1rKg1kCvPjstHFDNEUkDWR92LHIeTkJw6GSA&oe=6AA028DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Erj4MYvnMkgQ7kNvwERaYXG&_nc_oc=Adp2BxhlynNoISC2lDAoR13oxQjtiX2hpTVyllpMGdBXe13n1er5XYHJlES6kIOmI9Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJo5KbpHSBRBV4hgAmhOIo7wdktX9TWIhUWnNFbeSrWtw&oe=6AA0110B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVveOM_Y3ycQ7kNvwFOe67Y&_nc_oc=Adpi_rirxxwuUmH769B4t81b3wSkcPViMyAk7HXfsHyFdYKfchlDaJ0-SCoYMprH5zA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrLN29jATJBvEEVDLApbOVgVPIHIa020E_5YR18Y6PoQ&oe=6AA01CA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NqtcAUQlmoQ7kNvwEhDQwr&_nc_oc=AdqRvHYINW7Lw46VtCBjPxhQyiw1IV_Yi6TqOIwuhBgeQaqIgn6VIfOQgxNC_1voBYE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzU9Sc07FQaTasiiDSKBc7RW6dPWa7zGNqWTR98KPGLA&oe=6AA02124"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXofBYhVefoQ7kNvwG1xHb1&_nc_oc=AdrVR9Vpop5gMg1dEFRu98OO2zF1VZP16SnIxtwfMWxcc338MD1gQKN0VRjutxyeLhw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5uIvbMpo1J5gCVy8MJYTNhBxpfir1bnDfLvOSMyisxQ&oe=6AA00E1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6PedVkVCRMQ7kNvwF_vROw&_nc_oc=Adq6DULcEOjyj9T6fDsA6Nm64cHgm9czXcwrtxwwHIdhu9dJdlsysEEhLcuKP9lxpO4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfbGccECIhF-WUF9eoT9aRNxZ0srOgk1VYOfC
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SGHATL6hEPrsQsUtPuOSqj_2xocSmbaFiremdWrWRIA&oe=69E4D35D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACyVvFFzkQsQ7kNvwHgkq6_&_nc_oc=AdrVxlhtZlWWBuHkk7K4CAPOvbd7ysPVIytANN6Q0zNUVD8fjHld06rGnkhFX7pL0do&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31kD3J7J-DIrBM5BBjBHoPZavx_0jLVx89tOEOB0iiZA&oe=69E4BB9E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNiophht1wEQ7kNvwHZAMJa&_nc_oc=Adr0sWiSFxAP2GoL2XHXGn4H4okXWqRzPc_VFf0Sw_9h4Ygwmex8v_tfGzK09WbCsWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SxZ7b5tlLCGIs0xB47gdHCI5nEEOTOmnGPIBtHxeJHA&oe=69E4DC0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uFj-de6hloQ7kNvwF0-UsG&_nc_oc=AdpcgFSPUl3IUb0PPi-amTqbP0giH1GiFENhYs10OYLOqWAvzZzAds9z116lA6X_mWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pjYgbpMDsOp9mQQozOWKH1tdweHWQX4lCzODD0eQhJQ&oe=69E4E7A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9plZaLsglgQQ7kNvwGUBQ7I&_nc_oc=AdrPGaz3duXu3qiz1NrJW5qPYMVMa-YotH278ajeAZ0sRwXbRHIz-CQx5jlVKg6fqe8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j0q6rh85Un-q-xKOGfRpFfo6iDwUTEU_YA45RDpo9tg&oe=69E4EC24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnnixvwtEQgQ7kNvwED-uKD&_nc_oc=Adr3dH6_fuGnJGvVwDP7V3ylS2jB5pL5plhjiUE-k_zX96XB8apk2GachxNvU33WIEk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21ngGPC-Ut3LK_oOAVbNAc7AQl6Uxc4BJ8qpD9AB8VLw&oe=69E4D91E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cti0P006YIIQ7kNvwGMZNJw&_nc_oc=Adr_ImPnF46pyeTNsV1kN_4kpJfEOW3RinD0gjmbA68JhSZFoC2Ez0KLJ2gKOco9ZKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ONsgw7wO0pG2CXJubUV1iVmhQfpxm1SpxmAt
=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uK3lGifIsXf2zium4XkSKeZmHBVZa3qSaMHTWPf8tQg&oe=6A12F7DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9kiYjGt8uEQ7kNvwH5pHrw&_nc_oc=AdobIZkssMgxJO0qEGRucFJFtqpRWKEEaJe0GN7ArUvb6b0BKbnQNcmRS9Oqje8jmMc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TMKIaO8MFJv98cEC4T2BvDA9nWjg7PrDSArBsR70dTg&oe=6A13185E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASvhPbJt6a4Q7kNvwFt7bRp&_nc_oc=Adr7W1sWtLFLT8wzWeHh8X6qaGmKVseqwVQYafyLrW-Vimx1apDyuAvnSV0nPXidmv8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CnvkSy7g_h_uq_VZuU2SnMmcLfzoOU4gZkUf9k-Fqog&oe=6A13008B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MItIaIWqd_0Q7kNvwFa1R-R&_nc_oc=AdpwXEEt1ofNdOnHNovpvoMBm92w5RcpzYThu9U-AtT5YzOe8ZdnIf5eekVPJj86iBE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7poVYijIAjhlZtDqEdzTh7zDt0k91qFzMWiGuKWaAB6w&oe=6A130C26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQdmdNFxF0UQ7kNvwFV2pcN&_nc_oc=AdqSzAr5nBXqkal925xPWmo9pP7nJnfR6afhai8h2KkWsdIGAjYQQEOb2_qQBaSMMA0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ir7Y2RLXAEPslixaGt90n6LrqRy7CN0A2kEmF3H8sOw&oe=6A1310A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OpqWzxsSqAQ7kNvwFTmbq3&_nc_oc=AdrHFVi8-e-aSpsGdC1Nc_IZXMVt7Q3tGgJHb4v07VQflbXq53RXqKt1LOtdBzhENI4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60yGWfbyYllW1QK5KxV0bL2QC3zb_df5BQznwjIIYbNA&oe=6A12FD9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuAd0UzAjpwQ7kNvwEGXr-n&_nc_oc=AdoO-K2YYC5IrWlSs2lIPDu5IJEVMHRtExBWohgQD5qCHBNfJkNS8DLuxj4BSrkrpcQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i1swvg22yGui6jqUE6VJDV2WFgR2Yb_MSA14
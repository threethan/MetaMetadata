=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqunDUmjOAbMS-NKdhRalVP2QgUmuzjVq7o1ogigFHHQ&oe=6AC3D91D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwFJrhlEn8gQ7kNvwGKVCdY&_nc_oc=AdrhDGBOzKSycBJgYOMWIsIB6MP6Ej5Ahdq4W4xN-7iBkimgGhEb8fkZzqRsJ9Ziu3w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODxrO9d5A9FudzxofQ_h1R5DA3ztPct99h6_BcoCVapw&oe=6AC3C15E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsRb6e3ILNgQ7kNvwEGUY71&_nc_oc=AdpcSU3br-TPVEnMGlVjLj6lCkVhtf7k6rBEx4lL5lKiXSgHy1CHbSzEM-2FGD5fcEg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxwINW4tKEQZ6y6Qki1p6F9I5jxs01lwVMkK0yVY7ugg&oe=6AC3A98B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuxS15Lad5gQ7kNvwG_XT2j&_nc_oc=Adr08toSfMGiaMnGtAPFiaWL7c9dAMyIqyIAiDs4JDjd6qgJ7637-GRYoDBwhZJ13Xg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmenoShZwVJV_u_H72Qkv9l5VhEUr_j2H2YRVU5flPmA&oe=6AC3B526"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8bml5XYqvYQ7kNvwEWHRVj&_nc_oc=AdoLh85FsN9Tb0A1Zw-rbRAbudwuXpJENfhbJUYi6zLDqjWtwVToZb0SwO8ZZdh49ks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNtuIJPUNz01Uour1iv5SFJIr0mh34aoy7H0DV-tSpVQ&oe=6AC3B9A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hq-Q3iUDIkAQ7kNvwEzRW-A&_nc_oc=Adp8W0EY89UjZUlDArBYGyircYtdGAQW27lujqM5k74ZkPKI7216mojrQ-XDT0Ezkvw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQML9Ur_WAgmKmzRoel3-N1uDH-62aHd_qjBnPzbZAHIlA&oe=6AC3A69E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWNIvP8lNFUQ7kNvwFxr5Oe&_nc_oc=Ado5wxrdEq0KEVWpiHdrVUGH3Y0ni6ZzzNz4My3N5P5rE4dZwnBpKceSeXYNydNd71o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP94z4v2ZDgROcHi1KFynCemfuLJTE7glNL6qh
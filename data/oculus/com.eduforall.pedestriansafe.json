=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mWq44DPjCTtxjRoEVVUN-8rE4c5gNUIphk1wHkhzhKA&oe=6A256CDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7tv_SxhrlYQ7kNvwEscUuy&_nc_oc=Adqvo-gSz4nypFP9s_-ytpos3tgiD85k-quZdk2c1oD7dwgm4ENxk1D3yrUk_UfkLio&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JMKblw8Rn_sQ4CBO8AfGosFuacvoyCPmO-92dsAhIYA&oe=6A258D5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKgb1XyX5ocQ7kNvwGKPpds&_nc_oc=Ado03-jIqUKdcOFcEERiJ0smfCNjJGRXZY-NSdEq79B-pkuoGklwMIWa6gAGfNjhD34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af969DDa2ruyzvEPiCSiDEI4ctTuYxJxMJDq5Vl38Yetvw&oe=6A25758B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iryaRDU8AvkQ7kNvwFOBZCN&_nc_oc=AdqMyMWZf6wUrwWw3Wl-mq8N0qw0kcR8Xnu6U-ZwWKkyyu9KF3JxexvK-Lf--BCzveQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NkPxNLRkwt-0g2lRx5pzE3cTA4ChmWMoerjR4R7oimw&oe=6A258126"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5qdTOZOTM4Q7kNvwGAHmXj&_nc_oc=AdpMAqM21_G9bEvyz0hJDCwkoSkJM6oypwV1YAcyuslNSkeUYcfvvT_YC68OUrvBhr0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SZTOOmJ5rmf6G1UVRQPZuOPyq9OWpN0R2_iUzquQnLw&oe=6A2585A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqP7eCHihKgQ7kNvwEjXbJe&_nc_oc=AdoyUcIobxI09C2-ljBoETrHvB47dpfhRhYVLgsWOGNL-YQwjov-X5A3En2DA3dGiso&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_ZPjAKHbPbsq3t9z5Takyf5CheaBJXxBS44rZRIiCyg&oe=6A25729E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvDR1kh1nSgQ7kNvwHOuJjQ&_nc_oc=AdpuwbjXEXPaoFs-vDfJbQKe0oYZE35cqgzjSOVMyW9oVZONxFf2X20M81xjNeK03N8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z0nvdjj9H4UIMbXHbYSFnRdPuIpaxXm-dpLF
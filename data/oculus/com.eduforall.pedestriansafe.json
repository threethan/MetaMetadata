=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyZ6k20W0c3yYtm5kviKKyYbFXT-b_WXBZmgcoX_1iuw&oe=6A92D95D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9UGdbT9SSAQ7kNvwEsKe8g&_nc_oc=AdqmzcNNVE_GmIQ8GN8L9SbMWDV5YdDUEE-DZNo8hkqQhnG-OQa240Yn6kMIOyXQ8iU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx8ADmi-tlGAKmibvAO7l0zy8ipPjzhLjKKYvA-yYysA&oe=6A92C19E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bObAmNgHK8UQ7kNvwH99h6F&_nc_oc=Adq-4jutY45IibGKOxQ5Bell6x78_L9oLp9WTBGly7vwdnEOaAu7_V8Bvx0UdyQbR1A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1pALhpF3uU66pcwsD5JLWas3qqsEoSM5knDN9561LbA&oe=6A92A9CB"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iF9dzyrWGPYQ7kNvwEI365u&_nc_oc=AdqoEZyGM8Sgo3m0ouI1PGbz4brhBI6S2Gn693cegnOM-rMBmfuZWh6NFwwpLwyYifY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkNSoE7RNUdR8ZuZDJR6prWoHZCI1hUd0BAtRuPP6d8g&oe=6A92B566"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhDvTnSo4BUQ7kNvwHOoJvE&_nc_oc=Adqs-gwoWCXoJbdNsOy_CwQQ0R-rl5Wz1Yime2s2deZw8dY2zspdLZhBA4rUPmtCv8g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM76jPxbhZuBxIfdG86lGYF8w8JCVVM2v8aN7-Iz9qng&oe=6A92B9E4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8EBWAZwcQMQ7kNvwFBnBhS&_nc_oc=AdqsUFwJbeh83Q1De46gjiriy4SvzLQIDfBh5DRMbGvAzCiadooC1W5IoqjakmYC7xI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjKG0czZ94er8Vufh7eUrz2JGKKuJ_AATaBCcofHa18g&oe=6A92A6DE"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7engJtRwwIQ7kNvwG6NswQ&_nc_oc=AdpRMQQqJGaNlPuJ2kFwEW0p5jzxb5x-UAb-3-ZDTSv-wgdE5sqw27E76eShWcbiyW0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYXLSz8xuAk6f5D_MKgmvqo9EeoDNs6m39yMT
82121187132_8308184151168799368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SB1E_4XQwrkQ7kNvwHIIeTY&_nc_oc=AdlE-7NUYvUqL2H-8MCNzwr5yoLrlL8Ble86GBVvm6tRE7ohqTWy0EM8-n9BQMxj5-U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfureqHT5kBnkliudZBHAk8j3B9t21unJ9TViiQtxx9QPQ&oe=69985C5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl7LmltwIcQQ7kNvwEN8olv&_nc_oc=AdlOWFxhxW6uW94lLVPkwxl6k7QK2tXM5APpajWa9xb-mRsw9FAv0wya_SiAyGRmceo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuvcvMvg60wnsm--sUpyHd5hl-h9ZqagivNay3qX2RLYA&oe=6998449E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEISuEZZFUsQ7kNvwEkXDgA&_nc_oc=AdnQDSwMf2T9l2SVs_STUA-6xhaZnUBQ3rzXISVtukOcpsXSD5QvoUQHTzVGQcmx6eo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftLhu6EWt43hF9tqG2tqZrulwlKQ0l92a_A2HTH6QnkbA&oe=6998650B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ks8l-c-9uq8Q7kNvwGc7AvG&_nc_oc=AdmNlSo7zLji-17uYqN7nwuZXqehRrKi0vy041-Nf8T_jRzjfljYxzdAdT2eqiASOpw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft1wJRJLncF2DuO3rgu0xbFtzu_h7zwNak8vRMa2851Dw&oe=699870A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcKM9fvi3Q0Q7kNvwHVyShY&_nc_oc=AdnhELaQ0flpTXCXok2HfP2dLdUwcT9fKhmfsG1ayr6UkE4Yc5EQA_HcZpKo6BoAKx0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsjQZr-TvdwIqOxFpqkglXS4S9M-VtsYaesaoZLeifa5Q&oe=69983CE4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}]}, "developer_name": "Safe_vr", "developer_privacy_policy_url": "https://www.eduforall.co.kr/SafetyEducationpedestriansafety", "developer_terms_of_service_url": null, "publisher_name": "Eduforall", "support_website_url": null, "website_url": "https://www.eduforall.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OC
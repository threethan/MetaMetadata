=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06nYOO5U-mXe_IPNKcKgALji79np0z1yt1om-kSLGvFA&oe=69E7765D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KMHJFooNLUQ7kNvwE3UlRS&_nc_oc=AdqrmklG86-o-595r3vFKKilqWH4pa44VBNIm8MhQQJQ-Gt24Waj_8RYOLYsNYEJP7c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24ENzRzz0xUAKRTERj8G3H1R5-jKENxE_8VNvNTitW8g&oe=69E75E9E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWRAa9lL1mUQ7kNvwGC0teb&_nc_oc=AdpqaNwD55uIwbsZuteURgPY57gy6HJqigmkg-yS3PJL2j3Hr5bOpkVQDC3U8x2XJuY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bW9bcyo_ezRylSi8EwrejC6SOaaeZWuM4MLOUwALjjQ&oe=69E77F0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzLnD-N2GOoQ7kNvwHKlO1b&_nc_oc=Adp2eTnlTdDI332_7cKl3__aHv8VqW4E3ees2qYeu-Kf80PinkrXuPedQO3xz3ZM2XI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13oo8qZdMFaP6ska_WhyEsI3Ri68dZ-AbhYdbTGHLtjA&oe=69E78AA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZWEN3vPEzYQ7kNvwFxCuTO&_nc_oc=AdopmPJI6eBlCShg_1vJQ7GIYwMoPJRvSGZg1-fvlSPiAJGePb6RvXckwimR2QeuMpw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wnavkxQ81ynep-UiWhxU_6HQ6CA56gyFqDt8_kyKNow&oe=69E78F24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIH5HkfT0_YQ7kNvwH4WjEv&_nc_oc=AdreURy8UGJHwUGH-zQr8hEUHIcObt6vn7hnziUiNQXldCEBjVcH1iLP9OMlEJYIXkw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TV7p-XeWKAJuMaGxWsF2UP6_E3E8ORK02L2XfCsEAuw&oe=69E77C1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3r0MTOT7u2gQ7kNvwHgaQde&_nc_oc=Adr0aWGhUytw0WkpRN4Us5WhE38kVD56JEEpwfVf-983cHARXYBzos0Er6j39t-YwaM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2are8j35NiSVWCfSmRKiJd_1-1sidKN7VPUJD
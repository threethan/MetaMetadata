=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVwBFEpV76mLcokspESuiBSMuoQ5gmw0KUZYv1ZX3Kfw&oe=6A83075D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLDDxOY_Bb0Q7kNvwHMgaZ5&_nc_oc=Adq0gvGE34xBKmgM7K38JnRFAWjIuSfiFHx3wGtaz0NIywDsddDtxMkrCSvySyOE2K8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5gBQ2EA_52GbSoiBtXMzU64RA_5leMHoIHgYaeXMbAQ&oe=6A82EF9E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5cI7U7KiPgQ7kNvwGmwNx7&_nc_oc=AdrtZeHPdX9uYmZVyhjM44VC9Hy7zQlGIsMOYUsrSSpBLO9qj7wWtIK0IfQLl13DvGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVJ5PyjS18p8U95zx_SnxUy_7x32LdDSJXoPuS23nyBA&oe=6A83100B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5etut_cr8UQ7kNvwGDjSQ2&_nc_oc=AdqYQsl0CNeh149cJShTys8Ut1StBD_mA72RvaY9-gP9HZhkknAqpyl4NMSBviea8k0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ0QqWHrrnW8bG2HJkUiTnRIFe0beq0MEalAFWvPkPcQ&oe=6A831BA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6ewQYmfPrMQ7kNvwGvCVKD&_nc_oc=AdpBlq9cs_yfNPE0jgO6DBM76XrU1_hy0JB_wUb0uk6s3UTvrbkZOhjJpBZI-YLUYA4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETDBu05LXteViMSkIS64XXsY327XFBHhI1UiG_mmHu6w&oe=6A82E7E4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_OlyqKqo5QQ7kNvwH8Cpxj&_nc_oc=AdqITOSzBpvX-6NuLJUsBRmASd9uXOWk1HidIWObfU8j8CHrMxe_PWLL1mP5ViYnqD8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmAg0fsluTWogLaUSgxZ96q5SWkhXzXl7DF-o1i7If3A&oe=6A830D1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8La026Sq_8Q7kNvwGT6JPd&_nc_oc=AdoxEs04Khjs0j6MkX4aDXcgJqgF4ndn-GR121RhlwcPpExmy7fIhRiUvBe6IP_bW5g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvY9B7jOn4_YNawUIE7RPJ5ugDjP8o9vc549N
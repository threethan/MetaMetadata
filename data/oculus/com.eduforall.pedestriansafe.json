=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nYvygPDBqdrTKDbugwAA07lmAOwc5KNl1O5Awl3mP5g&oe=6A086BDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fADDDR-jPKYQ7kNvwHUPA3K&_nc_oc=AdqIs0g4zABZuc4h3sTaAbWqnsGj9ve9xpifiBZNqx3XeUBMatCKRLGInCt9JrALeV4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WOwIBxCoQRweeTAVBRBNUDYjuKIq5NrT3xNwi3aFz2Q&oe=6A088C5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xnthWPTSkAQ7kNvwF_D79v&_nc_oc=AdrlAwBl1bjwry9TO6Qu1EKr_NcDfAlKm9b0iFXbt_sEZfFfh98eVZtVBLDZXHrXu8o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UKpxUBRhes97f0CzvplvwIbYdW0hnyzu5DiRMCfGv6g&oe=6A08748B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPWlV5W631IQ7kNvwFMP68Q&_nc_oc=AdqwT32RKh9gXkLrcJzSUlyc1_svuyAMLSLIoouOvyuUIClYToQeuJl0OjwrZ0zT0ck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vgXl1bsdLwL08HzFysbV0VJGI9qFblcRajes3wnJ74Q&oe=6A088026"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaO5y8T6bKIQ7kNvwHa5Qhm&_nc_oc=AdqTj0yRT62uVmWXV77uYOmWRAJtlmlX8wBaUqBHpxpipLzsj59Myq7DHM9M6qAa3po&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yevtT3inTrcM98Mx3UfwmGGIi0reaWRXIzdMBGoZdaw&oe=6A0884A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fuCR0tv3j0Q7kNvwGiRTgj&_nc_oc=AdqRUvGQLaMiFdVGsdBJfi_4APl38hWBcjbl7cwEEuAtKh7Qy-oycnXe4ZKFxYfsWyk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jYCA7hVCqJlWI-tEfJaKIe5sWxb8vzptj5mHm7mRPsA&oe=6A08719E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tmal5QhbihoQ7kNvwF_NVTu&_nc_oc=Ado5dHtXNPjTzRWotGZWsvO_z-tOktz3ckS8R_ozXYxKd2D7P9l-bwlxhR2vwbkRQyA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u6rxAs9HNfFdvPxDxlDG37H0dxP7t3do9gWv
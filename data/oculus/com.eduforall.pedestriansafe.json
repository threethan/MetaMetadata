=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QiTgLebC1Ap0fozcLTh4knTAOLOTRzw7OwBptdZ8DeQ&oe=6A183DDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3N2iFsw-3QQ7kNvwEvb2-b&_nc_oc=AdqfoMdOOuRfFWzyc0yAXv9ROuQctNe5I88XI6M0pMERO4nilM1KmTDuDr5HjTF9RYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6F64VhCg-TKcDMy3GlwTfyyCc87MsUUXUr148Xpqf4WA&oe=6A185E5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_8dsca8RF4Q7kNvwGcu3X3&_nc_oc=AdosZYOEIw54Xt0y2orRpRWQIWqGWsVRLoMKT60Lwi28oDMTsRidOmP4rJL1VQrb-Is&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XfJ9tpPCHagUNwifRgyaL8ZeZ9oaj54zq9Xn1Zqu2tQ&oe=6A18468B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9UaG-Gb96oQ7kNvwFZQ21X&_nc_oc=AdqqDLXJB7ZW6uLznQvP0ZbDDjfm1AjE0rLdVnuvviPg5_c0JxmKznrjH7hN1bnW_a0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6clEZG43Z1A5uMjIKwatsHtQI1wHCG6AICTgCCMo8-aw&oe=6A185226"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOzWrmbo7HIQ7kNvwHI7QmL&_nc_oc=AdpokMFcXyvSEB0TFQhlGD4WTF0C1fmq6FB-Z3xjwwX5I9fBEtDpvUv5l2PwP5vyM1I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wRXfhvlu-MMu9lku1Y2zrQsnqoOasTb0jhKr-xabhdA&oe=6A1856A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sal-1dYCLBAQ7kNvwGLfxtt&_nc_oc=Ado5aeBC9-zsG-wTdQnPIQynNoM406jA1giTENJR9NA0Ejd-8oRKG9l4jL3cSJIUNXQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CIAhPGYXuUWqJyasbKD3-vWJfxdtqK3tPE_ADhVIbnw&oe=6A18439E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIhi6IyLZ6oQ7kNvwEpBdkW&_nc_oc=AdoPcrTmZTqKAv9BNum761Gchj6kSXzhp88zQ3kV_-0EvKzDIlX5VY1xeR78WOPKTJ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pXWhXRntzhUR17FveBAiu8CICQwU3TcC6NKZ
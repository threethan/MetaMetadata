=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJJvLwHJmtxAZ5gAxwgiFugXAR-agZ7FVF82I400QLVg&oe=6A63635D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsuHXa-ZPdkQ7kNvwF_-nJF&_nc_oc=AdoL0Hib9LyE7aSRaHxX7Oul-2R_hgdf7Z7tUmsmFwzScdblTebNx6eV53lMFUIBw_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0h_Vq0Iic-2pmqXbDiiMlS9_XGsxV_g_HGiM4mXtXeg&oe=6A6383DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01cHuNzcYQIQ7kNvwEBfFPu&_nc_oc=AdrY3rVdD08DQGo94gLTTs6F_u-u02CiR8QzzD0DZ0wAmb75LmSO8sKbotKZTJfPaD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARc3NVaz8vVj_p9fO5B9t8hjEbtwkxklOyv7BMYRhaSQ&oe=6A636C0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnaDlGd6scAQ7kNvwEULi0P&_nc_oc=Adr_Ng1-6jB8wClzc9Iq7NIWKqza_G10uZ1reR5h-vxv_ZtFKrIJVjKIu4BMTvyBttE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpY0FCdgIFOpzC-8dgMwjuAY5w3S81hey7iuMQuhnGRQ&oe=6A6377A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0M7hnjDHikQ7kNvwGw39Di&_nc_oc=Adq7jas3s5uzupNh2ApvH3s8VaDMJ7fcAfTk5n0jjBdCFXeFTVcFVAPCNRCx5o7VUws&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD51ogts7Z3VvZXDfa69oqvDWxdaOS2asf4hLDsTkplFw&oe=6A637C24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bk6JdyoN-w0Q7kNvwFxaWEm&_nc_oc=AdobcBuYFyausxjkGnZiWGdKeQSB1dzkQMBb9XZLQAgSOFxXBM09LHZnsXNjKcA4ysw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAY-Vxuhm7WHTaePOy4-MjS4v1Eu-9avXFYhYceYjGikg&oe=6A63691E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaqV_F9yWl8Q7kNvwHsBV_r&_nc_oc=AdrMXpTjDaaXOrJFdeKHz0bnYUmO-OvcI_wP4tsqnHJEiLeQd65kDobI6t-vawIVOuk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI8eiWNakO_g_seOvQEfYcGNAWUvbgOBbJEso
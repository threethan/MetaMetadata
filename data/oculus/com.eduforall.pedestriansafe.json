=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NB4qlX4V1BxCxNOpbQPA1nWXUL4_X21Uz6u9yV_KBDg&oe=6A426DDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yk2Ltyhb85UQ7kNvwHBsEhr&_nc_oc=AdqGJKZBpmzoVtuJkwWm-ag177TwilDbuGZaJ7psvrkQNmJKycjClQWGrEnmHBHbKos&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HOYt8smMw3Hm5BODksKpe2wEIqakMHTJhj_taGWHTZQ&oe=6A428E5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A55dZoSQnkcQ7kNvwEPJ8zH&_nc_oc=Adqb2kEKB4hEXAP3STC6-uLs2cKChv6nnVRTujWoybU43YYvxB4zL1IIOcaWOYpdpkM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HUwpSV022jqBugBR9HcibYfGfHSZYj1auQF7mlQCcVw&oe=6A42768B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qOZ0VBfSzoQ7kNvwH50UtZ&_nc_oc=AdozMkDbcslIXf5jxiT2J2DI5bFOJrbsmrtzDBZhknjxKRkScWKre1Chj4Wh1ApcmEM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rZDQpa7UfyKWTBGedFe_3YWZbCQ7PMM92wIk-rlzu6Q&oe=6A428226"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7JWKc_cR2IQ7kNvwGZ3gkV&_nc_oc=AdqNOOr-MDcox-rfNhFQBa7MZ4SZ85pu7JuXufhzpXxWDY3mB5UCjYnzaDbhzfuII-E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qbWVF5O6-4EuCei8giCfy-aLZcRJwidxaOPv8bGiCnw&oe=6A4286A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSKdw99Os94Q7kNvwH3O_lj&_nc_oc=Adrk8P13rS6ovgk1_cuIjcl9uTCHEhk0VnWbReFiw6sV71tKspUujA_lukYVNd7J5-Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2pQoxRqsjwbm3yWDkkFP4ADeOdqhH65eISgsvvQVqiw&oe=6A42739E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAnOeTqYOswQ7kNvwHIBfjn&_nc_oc=AdrbhOuBIBAVUf_zapWdayCwBGnucth9fXR8lX1uMW76P0fOc97BQDBdwLJlwJfUJFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V5RsYFWNh4W6KCNThrfJPhpDEnNPY_maBboS
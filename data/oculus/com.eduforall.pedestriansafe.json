=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BZPoWJDApLPkdS1lSAqaVIdgY5t856LWJl1arzfc6Lw&oe=6A43BF5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yk2Ltyhb85UQ7kNvwG_JyiB&_nc_oc=AdqbGb5SkGjvWqBOBuTmabzJRCjonLjUP-1VrmbBDHrIPzPeQPyTbyW0w9yFcwFRbUo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OzRb4hbMr1bTkiRfS1bhWvc6WbtEvOigFLMOPYgaZXg&oe=6A43DFDE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A55dZoSQnkcQ7kNvwFZZm2M&_nc_oc=Adp4h6KnCa9aScFGk_5Fe3Bnpf_Rdmz9RxtwmxTwMYOlpO3NNsEKAeVJwSYVbaXsRDQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Y6g3T9VfcfZN38xrtDXrwwh-U0O4jPmEK6tl6xiTMRw&oe=6A43C80B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qOZ0VBfSzoQ7kNvwEPoA1A&_nc_oc=AdpH0QdTkHqSx7owS-sbU_YvK65aYR9ozYFPQGDOR-HcRULhZzrQJ-mAKj-dmEtQiuk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VrXNoR1OZ1P4pL1FiuHVoaOHc2eqwktsDfEb3qtPZvg&oe=6A43D3A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7JWKc_cR2IQ7kNvwFNprX0&_nc_oc=AdofilYBZnAWmHP6jXVo30fK39HrZ_BdwGguhlfL-gVlCK7sWaGWgrjIdSNFWGhpOkA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ndXDDLE707E9-E2RHuPZ8byQ6nm570U9kXtqPKGe1IA&oe=6A43D824"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSKdw99Os94Q7kNvwGIbDNo&_nc_oc=AdorI76_6gUjf_K6wMTG7v_TnIfimIFZ6385jIyN5R9IA2muL4qUqcK3-crb-4FoqSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85mgNuA1Ri0ATBOI5PfDuE_1r7tPBAx-3tZJk0q1pHtQ&oe=6A43C51E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vMbBI_xoa0Q7kNvwF84JuI&_nc_oc=AdoB4JMiAkqYiRfGQYh9WgViHgbaV97FiJpSTQA1paScALKO3KavDAt0cxZ9m9WWJ98&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-G3Q6UQ_l4zPCmv401CoTq4k1b0yiojq48tJp
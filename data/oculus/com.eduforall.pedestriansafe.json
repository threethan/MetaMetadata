=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJXCKU3I2pqujTi1lrSRD6NQ5a5G21mjPRKpQ0GAbZSg&oe=6A9EB6DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09o5VseXMkQQ7kNvwGKhHmv&_nc_oc=AdrcqZfOGDkrHbV6kW7WhZYl2gnEquXW30vRN3lcGQZrNgYZFDaASYeD081Tk7UGaEM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1uBRqLnAkFZzlZmTXvB_HqpTRILEsWT_OWa9ambyFhg&oe=6A9ED75E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Erj4MYvnMkgQ7kNvwHxWeSF&_nc_oc=Adq2HLb4l8k69tS0G7A201XAipp_olBt5q2Q6-REnEfwmUpdiW5R9E1_FuTTQJswFBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdEviy3idXpS7LeXSp1T-AiUsaJ9sdylPV7Zew1hdLbQ&oe=6A9EBF8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wYIUEXqC0EQ7kNvwEfKurg&_nc_oc=AdrHkMZZ2JKkljwThYPSY7VxN-UbU2tvRoAyjpwR6DpZTPfx4AHf0l5x12C6lKhz-bk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQvph9Ad_l1jIOL0ibjOmJw1TfLeHYR0qLVtWvRFvIUA&oe=6A9ECB26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NqtcAUQlmoQ7kNvwGBgrI9&_nc_oc=AdqLdre76lufApZp9BG-bZgbAb4CmikFzILxVaJcM3gZ7i2CqHFoyyuWkaZNDA1QMFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMWROwbGItPYQmeeew7YBeEB7rKw__Ju7Yv110DX1eyQ&oe=6A9ECFA4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXofBYhVefoQ7kNvwEPJHff&_nc_oc=AdrxLz9YBgpaqiCb9bfZtgoxpp0RL_PuQmQqOreh3bv1kooHORS52ASBb_zQH19igvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBFUQjd8nt8aowVoq_MEuQ4LKe6fi-pE7t5VvJv6492w&oe=6A9EBC9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6PedVkVCRMQ7kNvwGRInZf&_nc_oc=AdqWDIbh3aMVPrdh-EYWMGclcIYw-wyQubrkKOKzXX4B36TQ-LiJC_9wsb8VomYdoQc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImMgWmv-uE811pb-1WRmpGvuQDsMBeju89x6g
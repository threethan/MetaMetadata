=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHU5_EmG5ohG6rbo05piGp1K2CZY7DnJiBd3JEsFkkSw&oe=6A7729DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdrHOc6vxW8Q7kNvwEWn1-G&_nc_oc=Adpe9FYGN1pS-aZMyDveGsBQiSDJyeELlUWuVQvrP5rTS60ObtyRViHLVQIXnsuO8bM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_Epwho-K0pkIZY8jM1I52dW4uCsayRSLnRXblrGUspg&oe=6A77121E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nl-vwjnU-BIQ7kNvwFaS8q-&_nc_oc=AdpLIiOC5IddEv7HW7-SkPGZAM-Oaw4lTdxcfNiiRI16HpgLyEW-uuJ7-VsDSciqt54&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExrqvzY8c0rzYV5unHg045ndSEknnWkip98ffsfgpZiQ&oe=6A77328B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G55GeW71HMwQ7kNvwFLfSCH&_nc_oc=AdpNABzQVoIpO4UyxGZCfMvrctBQ4wfrO-jQsLuUV3d8RHT2xLjTHFxs5a3CYFUUeOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSyIBz8hTU2NaMTNe8cF0Sx7NRGLBKwRxLwlpBmey--Q&oe=6A773E26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmlCDVERP74Q7kNvwGOUiTf&_nc_oc=AdonOc3P0_EmMIIiz8jccQN0V3HCMPdqjsaJPq3YTEYbiX2PDIa4AMjm7rjqpyMYjBw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7pWXoZsRFeMvbDpKteXLa8aO2n737Gw3gyhCW6AFVMA&oe=6A7742A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svyBQSP1KvQQ7kNvwGmR86G&_nc_oc=AdqiycR6wdOAimE6RahfPhd0cL0mW1WQnwfW2dw566cpK1RXfWsMmrnUFnlChfUOk7k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUrOMMUVenFsaK2LSmSJOpbK2z5vh0D6Z16SYd6aFEOQ&oe=6A772F9E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMXi-7x0ergQ7kNvwGtuc7W&_nc_oc=Adqnc1GS7df9nTWI9PXLBvosbBqsWs9EAsoEDiF2jCENzeEp8YLXXgNxw3ybUQr0-2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_5ahY8bn6G4hnhyyci4whbVwSA4dGENxq1-l
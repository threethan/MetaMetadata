82121187132_8308184151168799368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGoL_wcZcwIQ7kNvwGs61RQ&_nc_oc=Admpu13k2FwhBruTbWutYLfD5InLH8gFFommyaqcDYdkrpp-JUNRl0By7cU4wAiNxMQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvAqc1YYZdJXQ-lk_8TthcaA-12u9qnw_jFr3Xz7KgUrw&oe=69A196DD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dg9c3vpUkA0Q7kNvwFl5KJT&_nc_oc=Adm_k7_mqEecFBOT426njR-ECbvEuyQm7_tWe8uTHwmWFlUywAjcKE-kOgwmmhhKO08&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afttxaeg1L25GlG0EtP6HpmXYQn2tW7JFDeSlC4ZvHdsNg&oe=69A17F1E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b65rECM1emgQ7kNvwFUJitU&_nc_oc=AdkFF3v-XWFKKFbS0W6JMEkTBcoZJ5GkCpQSS7n_vz50hrErTpHztBNn_Y0lc9CRkfg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvxKaY9XQ6KKk55YhlTSISssAoI3qwUiU6q5AffLuZwiA&oe=69A19F8B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcTw4q6mawQQ7kNvwER8iy5&_nc_oc=AdmOxSabUMQYYVWWqhq4aFeCuyJdKPe4tnk0yx3YPiyDIKs7WLEDtQ4Tg1eziMDZU4I&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftPiNREfIcBTe1tpHZRMnu0nERUaerBq_eBnDL1tfl_cg&oe=69A1AB26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AI2DsHqY2BYQ7kNvwE3a80G&_nc_oc=AdnY21zz9CQDM-yYj8HJj0ea1lJ5NRSXUsVbcobAJtwrUOHbcMge6gLQbC71XZmHPKM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afuj8lNafepHMZqgaaz3GgbWm7h8cCR3M9gGuI2gbSOxHw&oe=69A17764"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}]}, "developer_name": "Safe_vr", "developer_privacy_policy_url": "https://www.eduforall.co.kr/SafetyEducationpedestriansafety", "developer_terms_of_service_url": null, "publisher_name": "Eduforall", "support_website_url": null, "website_url": "https://www.eduforall.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OC
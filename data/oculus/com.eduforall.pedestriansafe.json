=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETZBe5wfsNGO_huj7DUYiDeyWJPnMUnhmRSc8KbUk7xQ&oe=6A86FBDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG2DeYlq684Q7kNvwG9_LTi&_nc_oc=AdqaPOUNK7soi6ZIvEN1Tyg7dvpS8_4_7VhyqlEXHsc-fXCSCgXHBsuKbcWe1sYR0os&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgL9v5qdAVbNbJsLGNlCHINBXnWJ3OCXZkriYTvCsMag&oe=6A86E41E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTE9MB3g9JgQ7kNvwHdQB2R&_nc_oc=AdoFWgUYiu2KGgIHs0c3XMUJmlIAQQssaHalWpTAgYSZxHu3DGahSyKEV8bIEm5uosY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI5F-fmx9Kv466Cmn8-I_tavSogSaEFKlWBsgIxunlOg&oe=6A87048B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZbgit7xqXwQ7kNvwFCJg4Z&_nc_oc=Adp00JU6f4CVXGsBG1TbFB2_FVH63ze4OCLN_cj_aBbRcyhi_H-5H4E5FPTsGd2hFYo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFw3me77hJOq-2_iXg24fp0ZYqWd9AaFsMdMUxitV6s0Q&oe=6A86D7E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5K2OuXmBrSMQ7kNvwEr29KJ&_nc_oc=AdpUZwXv4fiFRCRKTMwdmmgO8-OlcPgMF3z1hVowQ-MkRrnVKNfAFK_oVya8P2y8Iu4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHprnNkSkZljdrBhLmfxIWB83x7C26dcHtbN2S3P1XNA&oe=6A86DC64"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYJSgGckuaEQ7kNvwGGfxQm&_nc_oc=Adq1jNiEY2U-2ORJILpOON6WMrDfLjNZ8BX4yGc9ZFwTC2rLp1v9jSMik1WFBEgEDco&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuCz7mlPw86_OhPce_KmsoSZjRx87gMaz0son01Y7qsg&oe=6A87019E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkRJ3XFyqeMQ7kNvwFyddcl&_nc_oc=AdpLb2Tc8wX8dqWk2-RqsUHSGiwgcFTvKHExmt1-VgO_l2f0AzIKkQnGS_4hs41BE3g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVPqIJ8K6QmQFwn94OqYH4TF3BGVphTrLizBf
=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0MkV4IeVj_HoJ7jMsPgLy9QhMbC5h4BiG5nw201pUZsw&oe=69F4A55D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AN_tWXlz-s0Q7kNvwEXHDcT&_nc_oc=AdrZzGd0Svn9FV3_nNzednGQrTPlpVKhAOC7loAxJP1bXP5mp-5AA-M8QpRNquW-wK8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1NRa1qilnUJiFQE_GxbNv0h5ESJxteBEcYxPyIol6yWQ&oe=69F4C5DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUNexMDoAdkQ7kNvwFX0M5n&_nc_oc=AdqSL7768B_-ZCfS2HBRkH5RU1mhSRh67YujmwpaXFc2tomEqrOXYDq_dXiMH_huPQQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Q87sZTsD5mPXjkLF9CA4KP3aJQT4nCOKQ63PUawWbEQ&oe=69F4AE0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ls2ynLq163kQ7kNvwGIh48w&_nc_oc=Adp3ALWU_a22a3O-HalhzHZcyy_ktzfg0_yzojuuw2pdY4Pw51h_sdtLtlk37Q_mWMw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af061TkLivWMw4Hi5vqwpWUCwi9GLRv0ekj_wQ5qFmz1YA&oe=69F4B9A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj6f_nzYOzwQ7kNvwHps1oi&_nc_oc=AdpqGSNq5fXcJ4kJNgbcM4vk7b-g6CQmyxD_KUtlbZEktv7wdNAdc2kJunh6dBguULw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0l_82nRCaI2WXs5PaUSx7k9i-3zMbaOsnujiQtlUrc4A&oe=69F4BE24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN8JH1YYjQoQ7kNvwEO_0zX&_nc_oc=AdoJ_MyYqaVkqqX8Dr350UtoIJ38-mk2UHxmLA_lcMYC7w01wXfQgt3GoIqAm6OhwhA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1pPtqmmZoeOflbyeeR6Zi1BYgngy-2iM1Z0M1P5Etk9w&oe=69F4AB1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HggUYS1aacoQ7kNvwFscrSf&_nc_oc=AdpMHVXnzjoW8wevAWSoxZ7WzXjiKCYjgrdWcbD8muCdoHa80MokSGJ60mOu2rwMSMs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0VUUOkCKKSM0jb4j0shWRMcRhk4aw5vaBGaPS
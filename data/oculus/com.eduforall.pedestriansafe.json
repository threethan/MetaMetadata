=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af810WOZB58X8QxW5J8YhaBYZRbZdpi7UwUIFs2Sq5toYQ&oe=6A2C045D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7gXqGVnZOcQ7kNvwG6n_2z&_nc_oc=AdrvHQgJ72MdtMuYshe7yHB8chVfmjUe2PrUY_4MQnYHqthJIMq6Wi6e6EI75qWH064&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YDSUWu2uCp74zpp0vq-oVQaQI7Mc44iAalUZ_JoJ7Yg&oe=6A2C24DE"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8479Cq6bTYwQ7kNvwEyUFeI&_nc_oc=AdpFwGR3GUap7STRzrZTx1D7ZoBtc1d9DZxuzaNRZuzAW06KbCtAzBe76CoQGOQjSKM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84NaPjbOPtJMR5CSxAg3oZtyNEZNioB8oFC919zOQGvA&oe=6A2C0D0B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CO_NowD_Iz8Q7kNvwFk9nFN&_nc_oc=Adr45N-4C68TGvFEepfu5-ov0wlE8dL41U2R7ZFaR_071NUY1XQ6CHXbMlOP9qkOWg0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CbKoPwZu4seOrGx9cmwa6XJTIRk9U6yOkXGuXoRKygg&oe=6A2C18A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If-HQwbdDa0Q7kNvwFpcR0D&_nc_oc=AdpUrYS3vLQApoq--_lSMARCii5HLP-rmoJ_MqEduSObz2pzb1vYIfaAxErMQ1cLzg8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aQ4-QbPYJ6zhvXq5ucBaCG_gcwIHBstSLYh7Ous55EQ&oe=6A2C1D24"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Q74XnxHbnkQ7kNvwH3mllf&_nc_oc=AdpT4tSaFyoSSVg8uUTP0RHlPk-jzIPO_KFC6Y0TGFb5EZx5RJV9HoClgPlzaZYQBP0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__BqLSuUAKq-YjJaUd8G6GyT6ohmw3H3aef6NVuQH3PQ&oe=6A2C0A1E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfEJovZ6YtMQ7kNvwEPxxX1&_nc_oc=Ado3uQu6Ox8tg6cOE4X4GKHrNMaUamUVwQof9E4Xo6LcYABd-7nht3t9tb5Pie0doJ4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hboL0-G5Y8JK4Zk3KW8X7iW_lGVzzuozBsAI
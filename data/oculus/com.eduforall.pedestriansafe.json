=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxuo64-TnkbbELO7WPD28QFgp-1Q0D67u_mBJ7wD1dQQA&oe=69C28C5D"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRKZxwHGw54Q7kNvwFcG_Fi&_nc_oc=AdqZdUr3Pv3U1hmloLNGEPU6rfhMXRHxjpyAGFgdLooL6bAbPEXEzsYDSwpoc8Q29vE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGNaNDtZol0kB_xqJf8aEYyqquIvoYUgNnMmpQGDDONw&oe=69C2749E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0snRftuPXu4Q7kNvwF225Qd&_nc_oc=AdriTvVnwkYsU86ec9fpgSLtVOtq1gtxdiymMu0gJMiscMas5wHuj3PBs-ZNDxC5LKk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjBh567mpLFiCQXRJtG2WJGED4m8kv5hKRo9oufOEyxg&oe=69C2950B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTeW5njJUZoQ7kNvwGroxgO&_nc_oc=AdoS1xxgM6_jtHraaYdti6mj3uusJY-LJ-qkc0XM_8YZqby7w9qSiF2Neg4FnS3zzvA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEi2FwC-xM5tAlHcEBZwLCRKDSLBrQfQxRxUAotPt2zA&oe=69C2A0A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8Ergo0v19AQ7kNvwFMxr5I&_nc_oc=AdqSkdlpUueJKvHn6OBJlKUN7h-44OE3lk75-80YFywFg4zklVvlCHNikkYZxW3d0hE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYzGN36raoLYjY11_OwtcHpe6FXQeV_bB47FdqoByByA&oe=69C26CE4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xAylwJ-SC4Q7kNvwGFBKuc&_nc_oc=AdoeH1PIgSc2DoZAg2PgaExvpuTYEmU0WPSUMvIRWQvwUVMODNVDZ_VkpCKc7k6iM2I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoOghVPzZAQL8dLgaKpjip0Bmt1QNTNy1EC8SY9mvuNw&oe=69C2921E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtUgOCpGF6sQ7kNvwH8u7My&_nc_oc=AdpOdHQ0lJ6imFoBwOln7IfgHbqkm-KZWAZV7VFTBxhN5yzBc4zfvepLa6w1UEzlx-4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwx7vNkJwcSsYpShFCuDe93Rr9X6tPCB3m2zrR
=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvdK5JDCyVTh57aPu8oSuaYuqgNiD8IqzYskCkZ6oJKQ&oe=6A6C9DDD"}, {"file_name": "3.png", "id": "2461595804232362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031647_2461595807565695_7312593327459399954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZC6Wzs2x9gQ7kNvwHnB1iz&_nc_oc=Adq_XqZnZ4z_I70B3VMBfh0dSlxHNb_v6n1jApON9DkU5beCb337lqUsT8waIUrK8ho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALyA1gmbAjI991s18rEJoy46if5tyYGVgdq8loRecB2w&oe=6A6CBE5E"}, {"file_name": "4.png", "id": "1532780807260214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_1532780810593547_4496627260495206957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJFLdobXPLkQ7kNvwH8D1in&_nc_oc=Adprt7hP8n4dHfj-9xL4Tsf39CERhhVipsOSh-U7bhCHXAdJ_v_CoyY83LtSwbF6TEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv3Fl4yxeQ3akIxjKTxM2k1x8zX-uFjFkwrYLp1Sl-7Q&oe=6A6CA68B"}, {"file_name": "5.png", "id": "1558754441456808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610707_1558754444790141_3345257285943944599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3pGisubMyAQ7kNvwFaHXua&_nc_oc=Adrs-sUjkrYWnqgEACCWV3khERRngcN71ApqzyJnmbwlTMJqpAFM4LfN93LyiPpYnms&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsujjir1NHbdDmbusj-oLWMB3RKJ5cuHlRx6ubCOXMJQ&oe=6A6CB226"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1324206032115249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1324206035448582_6075238338129945421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2HNEOfNaZgQ7kNvwHEEkTt&_nc_oc=AdrxXnut6V7mILeCaTtL7plPigisSCXiWhaE7au48sYZrI0C50GI3N9uuiEQhP9K4Dg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCVrpkCHiOgtW7O8jiZEOhrnboV2nkdL5BE5fP6NP3Hw&oe=6A6CB6A4"}, "display_name": "Safety Education : pedestrian safety", "keywords": ["safety", "education"], "long_description": "\u00b7 Users can experience the characteristics of the Korean school zone and learn how to cross traffic lights and walk at night.\n\n\u00b7 crossing the street safely at an intersection\n> Check the traffic lights and walking signals, and cross the road after the vehicle has stopped completely.\nIn VR, users experience how to check the correct walking signal and act.\n\n\u00b7 How to use the crosswalk\n> Children pedestrians should walk with their hands raised when using the crosswalk.\nYou can raise your hand in VR to see me in a car with a high garage.\n\n\u00b7 precautions around the road\n> Provides a way to recognize and prepare for hazards (alley road vehicles, parking vehicles, bicycles, etc.) close to the road.", "short_description": "\u00b7 This VR content aims to educate pedestrians on basic walking safety rules and how to deal with crisis situations so that they can use the road safely.\n\n\u00b7 This content only supports Korean narration, and allows you to experience real-life traffic environments virtually."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "3829924980657084", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_3829924983990417_5067615512458623107_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsU1rFl-BMYQ7kNvwGKNsj5&_nc_oc=AdqvZNS5pbqnJDXNngK-v7Blopeu7rLXuYlBB5vAtyfR3N8Ad31O5z2g3NRIwQV6xEQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDe7v6akCKntawNIJ3Vzjed7IQl46OiPgUT8exY8K7AA&oe=6A6CA39E"}, {"file_name": "512.png", "id": "3494991350803915", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_3494991354137248_2434228208731481886_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKdkQMR0ls4Q7kNvwHhyazC&_nc_oc=AdqImJi-QTGBynaOHXXg__y7d6UXQLqVD3YlJL085yfJUjVny1bKwQa64ciepaIjuu4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGKUPb0tYYsaFXyRGqsBa5r6joK_R8h2LGtQE
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6z7FwqkA3kQ7kNvwFYPCs1&_nc_oc=AdqSQSOMyzXBTxKjMINEh5KdMWpUpXnzuAFdKzSotjOsuZ9ka35zicjA-IbQj_n38KQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgwp_Jqnwp_VZyqGwttGSk8g7JodfX5pwjjnT1NSR8Cg&oe=6AFDD556"}, {"file_name": "3.png", "id": "9195068510586629", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75488379_9195068527253294_2668161467724780624_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEtO4MFPAUgQ7kNvwE4jME3&_nc_oc=AdrqQ0CgeNBkh_bdqu2s2j91BYoIGH6i1Jc7UVb11MTuPJGd769gaGaZgVnsic8Xzjs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLguR00RbCT8FfyBqNYEMLa5fVAdIgFa1CcRge17rw_g&oe=6AFDB220"}, {"file_name": "4.png", "id": "985683270137264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035392_985683273470597_5682883843199344465_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdBPlckQaPcQ7kNvwHUHcNb&_nc_oc=AdoZMngqLDW69t7TG2YDAMiV3JYt4jHV7Gni1ToWE_tnZxiVlhKm3DP4lvHdV4IYikM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5GAuiRBhA1PtgH3OQprJ9A8_uhzcZMFoXKz6p2obGXw&oe=6AFDC4D9"}, {"file_name": "5.png", "id": "1412420799735316", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974471_1412420803068649_7767631581415265926_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P63JoqxctJ8Q7kNvwEYkBHC&_nc_oc=AdqLl0l4CIJcLDHt__vSAF2Gs1OF0qKJ83-hQhFQaBkJ_i-9uQxhXpqCGyyAtpesFcc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ60gDcafos-FK4w-0EEmwwVcKiDCLU0kteY1QzqHPjUQ&oe=6AFDBA87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2484960861698447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974521_2484960865031780_1569075632799989806_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCeQFOFlrOEQ7kNvwHoBIxY&_nc_oc=AdqzUWHE3EsUiftnFLlHxun_qEdv5SIxcCYfWOiv8_QK8g7kcKps7EY-k3ScU1mMjmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS89CNLd4u9_wEXsc6xw27F-ZaoCZ3pEROQpjO9ldhUFA&oe=6AFDC3B6"}, "display_name": "\uc548\uc804\uad50\uc721 : \ubcf4\ud589\uc790 \uc548\uc804", "keywords": ["\uc548\uc804\uad50\uc721", "\ubcf4\ud589\uc790\uc548\uc804", "\uc548\uc804\uccb4\ud5d8"], "long_description": "\u00b7 \uc0ac\uc6a9\uc790\ub294 \ub300\ud55c\ubbfc\uad6d \uc2a4\ucfe8\uc874\uc758 \ud2b9\uc9d5\uc744 \uccb4\ud5d8\ud560 \uc218 \uc788\uc73c\uba70, \uc2e0\ud638\ub4f1 \uac74\ub108\ub294 \ubc29\ubc95, \uc57c\uac04 \ubcf4\ud589\ubc95 \ub4f1\uc744 \ud559\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\u00b7 \uad50\ucc28\ub85c\uc5d0\uc11c \uc548\uc804\ud558\uac8c \uae38 \uac74\ub108\uae30\n > \uc2e0\ud638\ub4f1\uacfc \ubcf4\ud589 \uc2e0\ud638\ub97c \ud655\uc778\ud558\uace0, \ucc28\ub7c9\uc774 \uc644\uc804\ud788 \uba48\ucd98 \ud6c4\uc5d0 \uae38\uc744 \uac74\ub108\uc57c \ud569\ub2c8\ub2e4.\n VR\uc5d0\uc11c\ub294 \uc0ac\uc6a9\uc790\uac00 \uc62c\ubc14\ub978 \ubcf4\ud589 \uc2e0\ud638\ub97c \ud655\uc778\ud558\uace0 \ud589\ub3d9\ud558\ub294 \ubc29\ubc95\uc744 \uccb4\ud5d8\ud569\ub2c8\ub2e4.\n\n\u00b7 \ud6a1\ub2e8\ubcf4\ub3c4 \uc774\uc6a9 \ubc29\ubc95\n> \uc5b4\ub9b0\uc774 \ubcf4\ud589\uc790\ub294 \ud6a1\ub2e8\ubcf4\ub3c4\ub97c \uc774\uc6a9\ud560 \ub54c \uc190\uc744 \ub4e4\uace0 \ubcf4\ud589\ud574\uc57c \ud569\ub2c8\ub2e4.\nVR\uc5d0\uc11c \uc190\uc744 \ub4e4\uc5b4 \ucc28\uace0\uac00 \ub192\uc740 \ucc28\uc5d0\uc11c\uc758 \ub0b4 \ubaa8\uc2b5\uc744 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\u00b7 \ub3c4\ub85c \uc8fc\ubcc0\uc5d0\uc11c\uc758 \uc8fc\uc758\uc0ac\ud56d\n> \ub3c4\ub85c\uc640 \uac00\uae4c\uc6b4 \uacf3\uc5d0\uc11c\uc758 \uc704\ud5d8 \uc694\uc18c(\uace8\ubaa9\uae38 \ucc28\ub7c9, \uc8fc\uc815\ucc28 \ucc28\ub7c9, \uc790\uc804\uac70 \ub4f1)\ub97c \uc778\uc9c0\ud558\uace0 \ub300\ube44\ud558\ub294 \ubc29\ubc95\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.", "short_description": "\u00b7 \uc774 VR \ucf58\ud150\uce20\ub294 \ubcf4\ud589\uc790\uac00 \uc548\uc804\ud558\uac8c \ub3c4\ub85c\ub97c \uc774\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \uae30\ubcf8\uc801\uc778 \ubcf4\ud589 \uc548\uc804 \uc218\uce59\uacfc \uc704\uae30 \uc0c1\ud669 \ub300\ucc98\ubc95\uc744 \uad50\uc721\ud558\ub294 \ub370 \ubaa9\uc801\uc774 \uc788\uc2b5\ub2c8\ub2e4.\n\n\u00b7 \uc774 \ucf58\ud150\uce20\ub294 \ud55c\uad6d\uc5b4 \ub0b4\ub808\uc774\uc158\ub9cc\uc744 \uc9c0\uc6d0\ud558\uba70, \uc2e4\uc81c \uad50\ud1b5 \ud658\uacbd\uc744 \uac00\uc0c1\uc73c\ub85c \uccb4\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n"}, {"images": {"nodes": [{"file_name": "\ubbf8\ub2c8.png", "id": "2069319833533263", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/468725195_2069319836866596_8946935124449417766_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXRJqgFZJUsQ7kNvwH5ZUtA&_nc_oc=AdrpxPpnqgKt_Lry_mGkcalZ19Uc3ztIqtspHuYmx-ncjfx9GdTXlzH5ZoaRm1W2-hA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUgQhu1x89gELXFamQcXyfYo6MS7-Su393aZ8gaeQuDw&oe=6AFDACEA"}, {"file_name": "2560.png", "id": "1958144254664663", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371508_1958144257997996_5402494376169652053_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTu9p64tY3gQ7kNvwF2eZgV&_nc_oc=Adr0PZjRXu2pY_QCkBkpnqxAAtNL1wBEQUk3yOKcCd1e3EoTwi8vaAHD4E0R41CXu2E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR_YZCXm87-wb7IrQ3_Ra9hQAmKmaZAm8imTUFs4AbBQ&oe=6AFDD932"}, {"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "1274294210494308", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1274294213827641_4508473815298717681_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MH2NNl7TSkUQ7kNvwEJvjmG&_nc_oc=Adp3BhJfkzRcV1hoKv5IzBxTgCaJlzPoqJyNdFEuBGT4HqNGmIXce_aSvhfUcXDdVAc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscd
02_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIYekW-_6pkQ7kNvwEE5efa&_nc_oc=AdqsNRVoN__hw_weCC2iAymG1OqiaWNA1LFXPASIZPvhyvKXF5NeLHTV2wVbHZTepmo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXm2yDkVgO6L8m467kO7oJA60eLLGsqurxk2H9fLJB7cw&oe=6B104BBC"}, {"file_name": "3.png", "id": "1763890834687508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313107_1763890841354174_2573991785950929148_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPA_o68Zio0Q7kNvwFBiKjz&_nc_oc=AdpGow9gzhW55nA7lruXqj8s3UmI_vR1HE14RMTf98ovbefyu4ZJSdYnwIKOu8eA93s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWYXAXf25v6XYkDinVF-sFCOs1rBHRCy2mFWyu0tQGuIA&oe=6B105FBC"}, {"file_name": "5.png", "id": "923235420757069", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314351_923235424090402_1624071682450215148_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebqJMM0mFC8Q7kNvwGXWUiR&_nc_oc=AdoTgaDTBegJnfd6WZO2rREpv6lU22UoU4OqR695y44yjebb3HZO3PCS0I_zR4gBq2k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUBhf_wby09MjmCjRs9m_Nmgn_df9HNPHcMeO5ZWBfDow&oe=6B105A22"}, {"file_name": "2.png", "id": "1720550119681779", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604317775_1720550123015112_3796674808789375874_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZUAIoz8fggQ7kNvwFZeuys&_nc_oc=AdqM-2clwckF6sL0cmhGvjXP_xrnh3W-xF5xq2yeKOLwfyxHAVKVWGlzxgTJH1oplkA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVyqhDRUEhFwGWjEdDBkag0T436s2_UUcfTtm8Lqshwwg&oe=6B105093"}, {"file_name": "4.png", "id": "1175808108305782", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604360590_1175808111639115_8837808567241599339_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3CKSyz46REQ7kNvwFAMMyp&_nc_oc=AdqaNyWihDy4dG0z7f6TyjbkObWywJ5k8riuP_67DuT3_5CyYHwDAaBZ6TT3-ZlJDSs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV9pt7AdpSROgzdmgn2HCzcm2qo7YeAh-Oi3COnie-xpg&oe=6B103621"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula Racing - F1 Track Car Racing", "keywords": ["F1", "Formula", "Racing", "Car", "Track"], "long_description": "Get behind the wheel and experience the excitement of Formula Racing! Take control of powerful formula racing cars, accelerate across challenging tracks and compete against rival drivers in thrilling races.\n\nPush your driving skills to the limit as you navigate sharp turns, maintain control at high speeds and fight for the leading position. Every race is an opportunity to improve your performance, challenge your competitors and work toward victory.\n\n**Game Features**\n\n- **Formula Racing Cars:** Get behind the wheel of formula-style racing cars and experience high-speed driving.\n- **Competitive Racing:** Race against rival drivers and compete for the leading position.\n- **Challenging Tracks:** Take on exciting racing tracks and test your driving abilities.\n- **High-Speed Action:** Accelerate, control your speed and push your racing performance.\n- **Precision Driving:** Master sharp turns and improve your control on the track.\n- **Racing Challenges:** Take on different levels and work toward becoming a better racer.\n\nWhether you enjoy formula car racing or competitive driving games, Formula Racing brings exciting racing action to the track.\n\nStart your engine, take the wheel and race toward victory!", "short_description": "Get ready for high-speed action in Formula Racing! Take control of powerful formula racing cars, accelerate through exciting tracks and compete against rival drivers. Test your driving skills, master sharp turns, maintain your speed and fight for the leading position. Experience the thrill of competitive car racing, tackle challenging levels and push your racing performance to the limit. Start your engine, hit the track and race your way to victory!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/next-bit-games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Next_Bit", "support_website_url": null, "website_url": "https://sites.google.com/view/next-bit-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1496138463578935"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824318_1855076315848032_1100631260345543025_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaW_Kck74OkQ7kNvwFJRVH2&_nc_oc=AdpvdrwVzf_bP4mUrQCMg1elYsDlJdgum8m4hkG-aZ7v999o6vLDcq3_qMuB_uw2v0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6PRY6Ryt-_jUCpF8YLFp4ySJiLRqZfhk261lXIAJnZA&oe=6B1068CD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Formula Racing - F1 Track Car Racing", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Racing", "id": "673385183287495"}], "release_date": 1794770460, "lastRevision": {"nodes": [{"id": "1496138473578934", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pd
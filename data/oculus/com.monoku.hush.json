ng", "id": "1294417838542898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617847_1294417841876231_5928415731341617569_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xn-FArxK_XIQ7kNvwHjvhv6&_nc_oc=Adr0WY9LuDeVN01NVSLlZQeYYLI2ft2QG1oeUcrEqnWx99gsQMHiODmJYFY7QVSFnPI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSY7kd4wdBgK5yEsTZblvIbzc6RM-1gW_gSQ11XwiGT1Q&oe=6B0DCCE6"}, {"file_name": "5.png", "id": "2229779550840869", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821952_2229779554174202_6511026865358061585_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKbE8XtabosQ7kNvwECWTdG&_nc_oc=AdqrRqymFaJeTDkzLa61zUGCgUlupjM2_qoNCIbJTVIlvwOm_nehjFr-AG9LroLCdhA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTDJ_bX2zdP3FsaHAyhEuykeVwTfOoiSMZHZyU3L3zX2w&oe=6B0DD042"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title_2.png", "id": "678037235337998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821193_678037238671331_5022801638769779347_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SW43E61sYq8Q7kNvwF-zsVk&_nc_oc=AdoTb1POcF1rHz32bhUilyhxSSAVsqSFDFmiNxJINp3XESV-8wNzRs_Jb1Lp3HK7lBA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQiY4yVWY-0-sgT9sCU-ow9oegYLCz2DyedaiAWhtlycw&oe=6B0DA384"}, "display_name": "Hush, Humanity", "keywords": ["Hush", "Puzzle", "sobrevive", "escapar", "humanidad"], "long_description": "Bienvenido a Hush, un mundo tejido de luz por los enigm\u00e1ticos Lumirios, seres que extienden su resplandor como si quisieran ofrecerte paz eterna. Todo parece un para\u00edso suspendido en el aire, perfecto e inalcanzable\u2026 pero incluso la belleza m\u00e1s pura puede ocultar sombras. Cada plataforma guarda un secreto, cada encuentro una revelaci\u00f3n disfrazada de bondad. Si te atreves a mirar m\u00e1s all\u00e1 del fulgor, descubrir\u00e1s que lo que parece un sue\u00f1o\u2026 podr\u00eda no serlo.", "short_description": "Bienvenido a Hush, un mundo de ensue\u00f1o tejido por los enigm\u00e1ticos Lumirios. Su radiante para\u00edso flota en una belleza perfecta\u2026 pero incluso la luz puede ocultar sombras. Cada paso puede revelar secretos disfrazados de bondad, y lo que parece un sue\u00f1o\u2026 quiz\u00e1 no lo sea..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hushgame.co/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MONOKU SAS", "support_website_url": null, "website_url": "https://hushgame.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_VE", "en", "es", "es_MX", "es_CO", "en_US"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25165856333020060"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818916_1534578851034026_7034960872791721193_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDy1Ap0VvGgQ7kNvwEzVefH&_nc_oc=AdpexGaUcYHUvVKNvO3io7ztzOaipzQvgOReKEA_PDYUuEDKfJYn98oniBQ1zXSYJWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSeM_P0-19IXvPnnw3AjrO7uMINGi8aTgedxGBcj-ApXQ&oe=6B0DAF58"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hu
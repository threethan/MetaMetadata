ng", "id": "1294417838542898", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617847_1294417841876231_5928415731341617569_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ce37VivtniIQ7kNvwF420dZ&_nc_oc=AdrxScrpL_rmuyuXZnYRCZBNt5mBUHet0lXwzFsuZDaalrZla1A7lpkvdA7toiaI7og&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9mtMIsR72Hu-cdvcJtNAftzLXRMZHggWHfj4gWRdW6Q&oe=6B05ABA6"}, {"file_name": "5.png", "id": "2229779550840869", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821952_2229779554174202_6511026865358061585_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xP6xugS3NH8Q7kNvwHYJOOa&_nc_oc=Ado2naz12CMVJTBW5xZ8oKpeIbuk70KlLau8Hf2Lcde-lnnVXe4XfLGqavbBQD1ET-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0nIvpaRA_qrTvEbc0Fxqni2fiKGZ9nj-b7OHl1VqP0g&oe=6B05AF02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title_2.png", "id": "678037235337998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821193_678037238671331_5022801638769779347_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xdikw981OGAQ7kNvwHNNK3C&_nc_oc=AdoWExXNEDqPMRa7tWSSr_B5-4KPW7YAeE5BeDaH1d-AmmAFvpAzCaBZqrTXqfy6bBY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ20Nt8z9zVUoVJO4Y3gfaGM1fuK6Fd-jwosc7mj7elXA&oe=6B05BA84"}, "display_name": "Hush, Humanity", "keywords": ["Hush", "Puzzle", "sobrevive", "escapar", "humanidad"], "long_description": "Bienvenido a Hush, un mundo tejido de luz por los enigm\u00e1ticos Lumirios, seres que extienden su resplandor como si quisieran ofrecerte paz eterna. Todo parece un para\u00edso suspendido en el aire, perfecto e inalcanzable\u2026 pero incluso la belleza m\u00e1s pura puede ocultar sombras. Cada plataforma guarda un secreto, cada encuentro una revelaci\u00f3n disfrazada de bondad. Si te atreves a mirar m\u00e1s all\u00e1 del fulgor, descubrir\u00e1s que lo que parece un sue\u00f1o\u2026 podr\u00eda no serlo.", "short_description": "Bienvenido a Hush, un mundo de ensue\u00f1o tejido por los enigm\u00e1ticos Lumirios. Su radiante para\u00edso flota en una belleza perfecta\u2026 pero incluso la luz puede ocultar sombras. Cada paso puede revelar secretos disfrazados de bondad, y lo que parece un sue\u00f1o\u2026 quiz\u00e1 no lo sea..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hushgame.co/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MONOKU SAS", "support_website_url": null, "website_url": "https://hushgame.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_VE", "en", "es", "es_MX", "es_CO", "en_US"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25165856333020060"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818916_1534578851034026_7034960872791721193_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dohca54xZvsQ7kNvwHfbtQ3&_nc_oc=AdqpKeAg0hcid0sPFGVG23kh5HYglXxVHOOE3djEnnqtdJam9yLxVhOa1p09kKeA11U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5RCyN7pB3DbFTE2KIA7-WhJdPk5jITZyQTjJNjMohpw&oe=6B05C658"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hu
pNL8wejpzzbWscrYeCTR0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz218O_Z1r4mtK1scYuFF-bF0RIAlXSaCUiSBFBy12HQQ&oe=69BFD442"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title_2.png", "id": "678037235337998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821193_678037238671331_5022801638769779347_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZy5h9dYOpAQ7kNvwFQh3_k&_nc_oc=AdkFe5GOuLb10WAOjt3WsmXu0sChOAkiTHrBwV1El2YqRdmH7eM3ff6rlsuSIDbhVNo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxW430SRYB-W0bsewrW1wyry2kxH9dSRv8RNCuvizJwZA&oe=69BFDFC4"}, "display_name": "Hush, Humanity", "keywords": ["Hush", "Puzzle", "sobrevive", "escapar", "humanidad"], "long_description": "Bienvenido a Hush, un mundo tejido de luz por los enigm\u00e1ticos Lumirios, seres que extienden su resplandor como si quisieran ofrecerte paz eterna. Todo parece un para\u00edso suspendido en el aire, perfecto e inalcanzable\u2026 pero incluso la belleza m\u00e1s pura puede ocultar sombras. Cada plataforma guarda un secreto, cada encuentro una revelaci\u00f3n disfrazada de bondad. Si te atreves a mirar m\u00e1s all\u00e1 del fulgor, descubrir\u00e1s que lo que parece un sue\u00f1o\u2026 podr\u00eda no serlo.", "short_description": "Bienvenido a Hush, un mundo de ensue\u00f1o tejido por los enigm\u00e1ticos Lumirios. Su radiante para\u00edso flota en una belleza perfecta\u2026 pero incluso la luz puede ocultar sombras. Cada paso puede revelar secretos disfrazados de bondad, y lo que parece un sue\u00f1o\u2026 quiz\u00e1 no lo sea..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hushgame.co/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MONOKU SAS", "support_website_url": null, "website_url": "https://hushgame.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
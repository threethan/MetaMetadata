 EXPERIENCE TODAY?\u2605\nFLOAT through a world generated anew every time you visit.\nLISTEN music arranged and composed especially for you. \nEXPAND your perspective with spoken observations.\nWATCH strange creatures doing their thing. \n\u2193\n\u2605 HEALING: Experience an instant feeling of wellness\n\u2605 EVER CHANGING: Never experience the same thing twice\n\u2605 INFINITE: stay as long as you like.\n\u2193\nWhen you need a break from your own thoughts...\nFLOAT IS ALWAYS HERE FOR YOU.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://floatvr.io/legal?tab=privacy", "developer_terms_of_service_url": "https://floatvr.io/legal?tab=terms", "publisher_name": "Brainswitch Labs Inc", "support_website_url": "https://floatvr.io/contact", "website_url": "https://floatvr.io/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5724090884302402"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "861060700205613"}, {"status": "PUBLISHED", "id": "679697837107180"}]}, "baseline_offer": {"id": "861060700205613"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764351000, "status": "PUBLISHED", "id": "861060700205613"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29032866856320085", "version": "1.0"}, "id": "318436670849
-25/38974897_794174735213402_5658923504426439013_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Kryj7ZNHScQ7kNvwHub1z9&_nc_oc=AdpQNHtsqZM3NK56RsIsVR4p25D3Tb4fdHsuj0eOXBtVWqY7T6gv4Tkc2YKIsqiCM-o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzbPrW5vooMAY5q6GWiy30v-kgdTZd5BS8AZTeQNkvf5Q&oe=69C27ACC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vidthumb.png", "id": "419702353686012", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031447_419702357019345_1078684321555486491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ooI8SfeMasQ7kNvwHf-Qom&_nc_oc=AdpvpvwdB_g91s5oXTzwPiyi7nKa_tV4ECuETVPaGFyZlqdRmneVCWN-hmgSAdHLyU0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyF2ePYH2Luu_gCsXqTSTGPVyBxckdho4UiG8TD87I6ug&oe=69C274C0"}, "display_name": "FloatVR", "keywords": [], "long_description": "\u2605WHAT WILL YOU EXPERIENCE TODAY?\u2605\nFLOAT through a world generated anew every time you visit.\nLISTEN music arranged and composed especially for you. \nEXPAND your perspective with spoken observations.\nDISCOVER rare creatures and interactive objects.\n\u2193\n\u2605 HEALING: Experience an instant feeling of wellness\n\u2605 EVER CHANGING: Never experience the same thing twice\n\u2605 INFINITE: stay as long as you like.\n\u2193\nWhen you need to reset and recharge...\nWhen you need a break from your own thoughts...\nWhen you need to just BE...\nFLOAT IS ALWAYS HERE FOR YOU.  ", "short_description": "\u2605WHAT WILL YOU EXPERIENCE TODAY?\u2605\nFLOAT through a world generated anew every time you visit.\nLISTEN music arranged and composed especially for you. \nEXPAND your perspective with spoken observations.\nWATCH strange creatures doing their thing. \n\u2193\n\u2605 HEALING: Experience an instant feeling of wellness\n\u2605 EVER CHANGING: Never experience the same thing twice\n\u2605 INFINITE: stay as long as you like.\n\u2193\nWhen you need a break from your own thoughts...\nFLOAT IS ALWAYS HERE FOR YOU.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://floatvr.io/legal?tab=privacy", "developer_terms_of_service_url": "https://floatvr.io/legal?tab=terms", "publisher_name": "Brainswitch Labs Inc", "support_website_url": "https://floatvr.io/contact", "website_url": "https://floatvr.io/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5724090884302402"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "861060700205613"}, {"status": "PUBLISHED", "id": "679697837107180"}]}, "baseline_offer": {"id": "861060700205613"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764351000, "status": "PUBLISHED", "id": "861060700205613"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26433689659571164", "version": "1.0"}, "id": "3184366708495127", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5716140881752678", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26433689659571164"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1773796925, "id": "266324734163
0W6XlTxMmgE3r-ZEFy9fmL6B-PUoQWwq6bFwMkS4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuM0H-xV_GFaU2_VyAPikJePjzglgl971J9K9Na1q6pvw&oe=69A4284C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vidthumb.png", "id": "419702353686012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031447_419702357019345_1078684321555486491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfB21J4iuB8Q7kNvwEeOTOw&_nc_oc=AdkO8mtY91JyHnsLUgfXH86QUSl1RsICFeO6aBry_mJ43XkajZH-n7YlbzTgG_lIb5E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfszFvWsYqFQ8STPhaBIw7kWlnklFKJOufdxbjSUF5VTnA&oe=69A42240"}, "display_name": "FloatVR", "keywords": [], "long_description": "\u2605WHAT WILL YOU EXPERIENCE TODAY?\u2605\nFLOAT through a world generated anew every time you visit.\nLISTEN music arranged and composed especially for you. \nEXPAND your perspective with spoken observations.\nDISCOVER rare creatures and interactive objects.\n\u2193\n\u2605 HEALING: Experience an instant feeling of wellness\n\u2605 EVER CHANGING: Never experience the same thing twice\n\u2605 INFINITE: stay as long as you like.\n\u2193\nWhen you need to reset and recharge...\nWhen you need a break from your own thoughts...\nWhen you need to just BE...\nFLOAT IS ALWAYS HERE FOR YOU.  ", "short_description": "\u2605WHAT WILL YOU EXPERIENCE TODAY?\u2605\nFLOAT through a world generated anew every time you visit.\nLISTEN music arranged and composed especially for you. \nEXPAND your perspective with spoken observations.\nWATCH strange creatures doing their thing. \n\u2193\n\u2605 HEALING: Experience an instant feeling of wellness\n\u2605 EVER CHANGING: Never experience the same thing twice\n\u2605 INFINITE: stay as long as you like.\n\u2193\nWhen you need a break from your own thoughts...\nFLOAT IS ALWAYS HERE FOR YOU.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://floatvr.io/legal?tab=privacy", "developer_terms_of_service_url": "https://floatvr.io/legal?tab=terms",
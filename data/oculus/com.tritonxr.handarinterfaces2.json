aB7OKA3nM9doPCcoqrwnarv06mYw&oe=6AF745ED"}, {"file_name": "310-STORE-Screenshot-10-fan-codex-2560x1440.png", "id": "28445602368422037", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673751957_28445602371755370_8457169254014586060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yv_dcfOmpJMQ7kNvwGt-_7f&_nc_oc=AdqUdVJN31RCS57xr_dc2BCSLY36bww85SghlqccqqMRk-k21KAd7v1Wqi-P1E9Iya0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-NTbdvNVe8K3YDrRKW_rrtfmOS9QcN5fvXA5mIyHjJA&oe=6AF74982"}, {"file_name": "313-STORE-Screenshot-13-echo-rings-2560x1440.png", "id": "1767729281119716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_1767729284453049_8213461626693697385_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtonbpzaKrAQ7kNvwGzCwmD&_nc_oc=Ado6xdqtJbGN2ZcE7UUd8m9SL9HDIeGZqpT4wdhpUe9PJiIHz1lTdzMazjrB6peLtqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAP4LLrmbKFq1c2uQ-fofEOeXvSA4PVCd1frG-JZ8X6w&oe=6AF71893"}, {"file_name": "306-STORE-Screenshot-06-lattice-sleeve-2560x1440 - Copy.png", "id": "1769853984253567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830441_1769853987586900_4763548852505824157_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rZbthYlQykQ7kNvwEKDCmz&_nc_oc=Adqbil8drkU4bkyl2LqISeumPGY6h-pyvLymnu7Bpda4020I6AOIDbu0JKVzqog6-FE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZbNCtOXlgbfIHYh_WRyJgYc77_1qBrUP3Iy1hP-my9w&oe=6AF72100"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hand AR Interfaces 2", "keywords": ["hand", "ar", "interfaces", "control", "passthrough"], "long_description": "Hand AR Interfaces 2 puts instruments where your hands already are.\n\nNot panels floating in a room. Twenty-three separate objects, each drawn on the palm, the\nwrist, the forearm, the knuckles, the fingertips or the space between finger and thumb \u2014\nseen through passthrough, in your own room, on your own hand.\n\nThey have nothing in common but the hand they are worn on. A Victorian brass orrery sits\nin your cupped palm with the planets at today's true longitudes. A sextant drawn as a\ncyanotype blueprint takes a sight off a real star. An ocean runs in a glass capillary\naround your wrist, simulated wave by wave, with foam where the crest steepens. A tapestry\nloom weaves time down your inner forearm. A soroban lies across your palm with jade beads\nin superposition until your fist measures them. Stained glass, liquid chrome, spun copper,\nwashi paper, gem crystal, fungal tissue, aurora \u2014 twenty-three material languages, and\nno two worlds share one.\n\nWORN, NOT HELD\n\n01 Chronos Loom \u00b7 02 Aether Orrery \u00b7 03 Prism Chorus \u00b7 04 Void Sextant \u00b7 05 Pulse Cuff\n06 Lattice Sleeve \u00b7 07 Mirror Knuckles \u00b7 08 Caustic Palm \u00b7 09 Drift Dial \u00b7 10 Fan Codex\n11 Gesture Reliquary \u00b7 12 Singularity Iris \u00b7 13 Echo Rings \u00b7 14 Tide Ribbon\n15 Stellar Loom \u00b7 16 Parallel Pane \u00b7 17 Quantum Abacus \u00b7 18 Mycelium Mesh\n19 Aurora Ribbon \u00b7 20 Archive Spindle \u00b7 21 Helix Gate \u00b7 22 Agent Perch\n23 Caliper Hand\n", "short_description": "Twenty-three instruments worn on your hand, in passthrough. A brass orrery in your palm, an\nocean around your wrist, a loom down your forearm. Hand tracking only \u2014 no controllers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/hand-ar-interfaces-2/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/hand-ar-interfaces-2/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/hand-ar-interfaces-2/support", "website_url": "https://nebulytic.com/apps/hand-ar-interfaces-2/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type":
7egt&_nc_oc=AdlJffRcxJurUVAEVGGypNRBSmUA2BlT1vL6SQO-uw4mHpTuQngO33hdC4l2qYBrY5w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvkojhJVDb6H6xJW5FWI1gre0_zIk7JJAs7v0-ew-x9Uw&oe=69A03C73"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9Uzh-Okv44Q7kNvwEiXJ8n&_nc_oc=AdkEmS29Vq_9_l0MzJ48mHPr3--iXfDBLECMMuuiBLwlGo-vsKfqd0fevvxOksqVMUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftIgPa9C2aecW7UQJB-7kTpSFE7JLfh7P2xTngkido2eQ&oe=69A05974"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hx6tSD8ZDoQ7kNvwHBsodY&_nc_oc=Adm9VFFee76sx2tIyXkyHCfX5MSoh7bPXZT1FYrNIGqS8I5NcDJGRJD5uAwQSB95scQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuQk5XlB475DIz0EXHhvs9JfSvoOXb7_VxNduF5-0PFCA&oe=69A03727"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcuHIaaDSIsQ7kNvwGoxYuP&_nc_oc=AdnzV5165VTY4GBvQoNVxjHkcgMnO3J64NJsCXgJ1Hr27Nw7JGA7QBDDTvR3dKZxt9I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsKIKmrLPBHlPXWhe-AkdG7YJJudoOSMWetQ1UYry_VXA&oe=69A0453E"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JHrX4D7jkcQ7kNvwHT0zXl&_nc_oc=AdkJ-qtcI9_g3VZ-ufCUSai3XmNJ8cfC-8F2OVg-8PHEBD0N8AG0GGzMoXyrRlR-Dgk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsKWHUIqdd4AbK9JBB0BKDK_yKlnEOX0icsAZ5EWX_ZRQ&oe=69A035C5"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pgHXwWIvh0Q7kNvwHY_vhS&_nc_oc=AdlVSyh0ENma60mbVFX3nJPNfJk_A62pWq5QlKPTs5NYeO7FkMAM0kf3FGIk4JK4-54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh
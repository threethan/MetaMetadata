tga5&_nc_oc=Adn95SDpWoLDMdK6HpLgsAbK-y7sXvOMGT2AbV1OFH5QEjTzbnpKZBSyl1493u_VBSA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs6JJh6GDU93-xr0QdVPrDqKMBcyFiiJ0cPonUmq-ARQg&oe=699EEAF3"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxoyPNQyEkYQ7kNvwGd8GYo&_nc_oc=AdkRYTB3zHHRQomNf5s4bLA2jV8plFmhNpMsZzhldsr8SXtGl-9AQcTUl76_R2hUAUg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsq8ATxtnoS1nvVhH96t4Db6MEpRBECn7hiUaIZP7T4Qw&oe=699F07F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hx6tSD8ZDoQ7kNvwEdKNZp&_nc_oc=AdnFLnI5t5wpYdCshOfBmOuJl_S0BcDGZ_yRynhIAH-Db_x-NtYpab6oEwaDX-o0rqI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsNZUmeD23hJQ07eKeHm_U5CRss0UzyGqbPd78Jj1sKsw&oe=699EE5A7"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBVU2uExQcUQ7kNvwEEJhft&_nc_oc=Admwe0_p20awmcDcB1YA6Y6RuZmXq0R9PRAlxSMyi8R3pvJdXgs7RYRq8OzC5hp6HfA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftNrNMFcK5yChYvYRJovkz3UGd4ub2rsz4bOkvgzkcj0w&oe=699EF3BE"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anLGKf48it4Q7kNvwFckT3m&_nc_oc=Adk0L6E_r75dN0jGBwicGs544fk7byKAaEIPF1RhPMjTP4eYkzKe3GJocjNqeUcn-oc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftJ6vu2a8dyT9JDhi9D-ArUNmpzATDzK2Co1vXf0CtmSQ&oe=699EE445"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l15PaHXXPesQ7kNvwHZPUeh&_nc_oc=AdmsHVkiS9IBZH8GKCOkZJpgmBLIncXSTBJZYheIh3u0mSK7826jIRk3uP8NufruqJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh
GSWg&_nc_oc=AdkP4XLEx5VeSLJpdGHBj20wdd-u_AsFz4kD-m8xu-gLWeRxkf2O6pa9nWJklWPzuDU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afte8d7Wd8LfNEYuC6M1mSTet2wVcJFsWb12V-hM7T-W-Q&oe=699C47F3"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxoyPNQyEkYQ7kNvwEqn-w3&_nc_oc=AdlcxrKoPGbAKBKvNbj4uZ0zjGTZx28UDNainxeSg2-0Q_jktARoOktvryv38gU-Nsw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft63kD-VBBU1f-aie34DkEhp6TrXbV-bpWUeBx9azI6NA&oe=699C64F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wriszs7BkG8Q7kNvwHql_yn&_nc_oc=AdnXwYR0nfAqrt82I5Xl90g_CwbVvxl4ukyjcRs4nDbZXv9hsTWT1Bf1FR5iSl7tgG4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsancP75z91Ac76a1zaPdP8Qgy6CK5K8UUYJXnKGATJqg&oe=699C42A7"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBVU2uExQcUQ7kNvwHCcmDv&_nc_oc=Admjb-esgfUWnwVGJDU3907R_C8kEkbRX-8Gd0slXitivE5EhrLJrUqJGOAlidcZaNw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvN1BjEgxb272Id7iNkqSmGBSl5oiII-mgk2T2MtK6RwQ&oe=699C50BE"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anLGKf48it4Q7kNvwEEWreW&_nc_oc=AdmpE2sgykJUtr002-vN6I9Tg9JwE6CfLqUK6qdiP9jnMUzB7Dk8uyT-unjsioW4jqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afslxm6MxXrhs0gD2-YlGnpm1GdlCKKsmYyaqiR9Ek4oZQ&oe=699C4145"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l15PaHXXPesQ7kNvwEtgbWD&_nc_oc=Admp63qMvy_eI3zjnhW1CPVYUVyIDp9X3oRFMMeNkYJxfl3kTOWL4TUwslYb7lo4BGE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh
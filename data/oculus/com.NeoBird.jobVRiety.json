75jU&_nc_oc=AdqSUiuKFSXeaFKwfXSpj5pkdTfQFny0yYEZf-RKteK6rfB_fl8t31SJV_Vuc2uQop4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3Rn9wZMSH-mgh6UajRaec-blzhZa2JDjzMPUoNB9oSvQ&oe=69F0A7F3"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovMeX2l7JAYQ7kNvwFCvSEs&_nc_oc=Adod08pLmay1DzVDhs0e-efk-9-Dcn2vtgN1OlZL63awr5Z4b0JK_Z-ohz3tXExMACw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0hMDeMb8Cywqxse-odBHQRcW4r2l53ErVM1BLV8HgPAQ&oe=69F0C4F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVvqWehj2rAQ7kNvwEV8AiA&_nc_oc=Adp825_OmUiaCwfzXO-a7KGygsZm_Ixx4okDu0zWfQswfpBl1GV0tWQL0tH2EmcnkRM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0TojKR9MLPxETxKjgxvVmGFePPjYjhoZzHXna1C5YIiQ&oe=69F0A2A7"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4i-BC1p2Z4Q7kNvwF1mf0U&_nc_oc=Adp_p_0T-mVNNIE_hQCTw86Dc8FZhBODjT39ZVlcbUFX9Pu_3z8LFGfh7E1rp5OuGO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2Dg1XlmogQ1EaYgQ4SNUDxJbt4k_-GMkV9X-Yt_trpZQ&oe=69F0B0BE"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZZ_3ReQ7HQQ7kNvwEvFAva&_nc_oc=AdqzvFYgN-Qq26mKV9F-b-iOyf67FqF_e53X0SoeLI4tlUf4MOVKPGaP4rQguYlS57g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0xxT3Sua6ARrDSucH3HV4leNMDhHhk25XFc1-k-41oOw&oe=69F0A145"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KX_fB6w-DoQ7kNvwH4kxfi&_nc_oc=AdqRrZCOR_XOYWJkN1a3VyhviDtYFoSSxe_mmxXsUoQq7V6msy6V7upJUjaC-9C4670&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh
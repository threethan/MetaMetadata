CBcL&_nc_oc=Adk4xmhxYJ5o5Qc0hmdWbbHNeZT1fFDM7ecPSHEXCzqJltOPVDyunVhx4Lve3zFdF7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftiQSVx9eB5tvKzBu9xcuu1pIoWoK_2tNQlaVkj59yFqQ&oe=69A2DF73"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9Uzh-Okv44Q7kNvwFUTdGo&_nc_oc=AdnSKlOfJU8kBLAX6PFSrEa-_1fB6EzWzvrIdLa7tJspQNYhvDD4EWKHeh8HTVscnTM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuxfeZpd82mZgbuD901hSv0ebpC4tkBjfv9vzm8AnXh2g&oe=69A2FC74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyRFQWZRzpoQ7kNvwEizDpn&_nc_oc=AdmLot48wg77OjS9cZVTGXUdEJIHgUuLoZLk7OItqIct416Tnxea99fOjeanyxjzEAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvD5pqABgd519CbgkEDUE8hEGTVKpQuLDr-c3bu0gftKQ&oe=69A2DA27"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcuHIaaDSIsQ7kNvwFDt8WC&_nc_oc=Adn_uo8pkd3m7nRhJzS5eS7Gqn0h4hcu5m3E7tsTSn-PvXdIJ0XgucwRTBkzj5rD4iM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsOkiPK0n8A2oNpkbFvaveXmy2Y9QWgTdhSjyAZBslqtQ&oe=69A2E83E"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JHrX4D7jkcQ7kNvwHSQvoo&_nc_oc=Admqn8e3VCuzpzjuYmVbYymIQf_wCKrVCOnAKGwlfJLOMtVM2742Wwt7sVVYSYRi3kM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsD0k_vt4cySryITyCmva8EBQyAIbk-52csHYESEdGl5A&oe=69A2D8C5"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pgHXwWIvh0Q7kNvwENKU1Y&_nc_oc=AdnkKdvib00358CRS4PBatMhMb4kYZaykcdSl2kTJfRZIpu0vZz2o9g04yCKd1Glzw4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh
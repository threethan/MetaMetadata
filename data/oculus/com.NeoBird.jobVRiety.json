L2zH&_nc_oc=AdnDzTl4G4Q1JrlwnCeM-kJFcvuzLApi9KLWIdjd1oCByxPo-d6EqBOhF1Q0FJe47uk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvlYrckKa85tOX0JF2vXgOyXdMiwlb0tzX7dsOa3k3slg&oe=69A18DF3"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9Uzh-Okv44Q7kNvwE0lqQE&_nc_oc=AdmnS3xYJexFCO7Apr2OkCjpCA-B3LpoIMfVpFhmuqbfjBmv9UHbZQGjczJJYfoqin4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afsj6QEvTQ5dfzRqCVSVw1PeiqOicB0lVqhr4jwoBdX7Zg&oe=69A1AAF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyRFQWZRzpoQ7kNvwFn6uw1&_nc_oc=AdmX0i-oOQ54fDrw0IG7qqWQ1b0eEAziaIw8uEgvV5dp-bGWhR6kIpfmwocPrB1iz-M&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afvko5-6jfbWxBSi0hUYa73nAkrnQ2f5UDlqjNr8kmz5wg&oe=69A188A7"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcuHIaaDSIsQ7kNvwEL51xU&_nc_oc=AdnhKz1sBrZpWgD5p8VldHCkSflHV7th1AP5lmw991VgqUfd60B86cSUKYJIWMaKFXU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvcQtfmRtO9E4V8_E_eKAimI7nLescfhT1_P7JnZXatfQ&oe=69A196BE"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JHrX4D7jkcQ7kNvwHPyv2U&_nc_oc=Adn1AsRV56_s-44HqR75jJAO4K6LrVkEOuGZZY1S9BvEFWGpffBzRmhxqLtBqSV-iDY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu7zoD1xW7P1fw3DSDYRZ9LfNdtimxXOeQesoPV0jjZpw&oe=69A18745"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pgHXwWIvh0Q7kNvwEKGCq1&_nc_oc=AdmS7fVjpEYV1aZvgkO1G2JclUm6Xf_NIQLBUyXN-11IvOgqs9_i4CcinOP_fwEBhdI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh
KGAN&_nc_oc=AdqGByIhfvKuJ2X-L0QEQV9PABAhzWhDo4pPEllRZIXMyYxOhyFcM5VdNmxmtuSg_5U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0gc-ub1eMsyrbSNh47DzC6x_xI3LAEU-jWXBsWt-oSEA&oe=69F1F973"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovMeX2l7JAYQ7kNvwHFZevG&_nc_oc=AdpkpL7uxS8tw38yd2CBDFlp7d-NJ5l-FyZxzOXngxcE4OltqMzShixn5NU-890BEu4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2Fnn5xpPeyOYNx5e8njgtu_xZVe7kOGObBgmO3khTXaQ&oe=69F21674"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVvqWehj2rAQ7kNvwEG8HFb&_nc_oc=AdqsYmd1r4cKfKjdpESPa4y4Rdx2drRa5cVsYhMGAdkc2lnuDTI_s9wzjax04mcvwgA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af08hDZJnhYIEHgOir-1R63AQdeAVzyZRUYttMSGBc2jmQ&oe=69F1F427"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4i-BC1p2Z4Q7kNvwH3TNDe&_nc_oc=AdpXETGjvHxUyLDwGwgGNRVZM4iXtI9KRbtkiXE27H2wXbi6C0j7LhVeGHQsT4fDuk8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3A6m3I2Ge3C8WBuHJCbTyyzS--ZJswle1aAnL_PeYEpg&oe=69F2023E"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZZ_3ReQ7HQQ7kNvwGZ3Kww&_nc_oc=AdrDorElsfZBROM8ttgTj7N-_PNLJ0fq7i7mqAwznG3iVore30fHenjCLoMpkgZeYQs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EN_Yyg3xMHiHxQktxYNjToafYd_BADtLCXCGuqQ9XgA&oe=69F1F2C5"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KX_fB6w-DoQ7kNvwEK7gM_&_nc_oc=AdqwedsxA2xmNqxDKOWrf_a4wnioIe3rVxRM29vk8-E5Y7cxRfQamimR_zEI5QUKsDg&_nc_zt=3&_nc_ht=scontent-atl3-3.ocu
&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgbDm17QOuLhSneU_WvYdAluPbQ2jX7Hj9X1YgHjNJMg&oe=6B0458C5"}, {"file_name": "screenshot_4.png", "id": "799354715822877", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_799354719156210_266327153727456801_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mG9AoJb2SsQ7kNvwFE8f_5&_nc_oc=Adqj2-xZfddHg3MHxTf1KiwRmxGHlvYNRkC2WE44mRUK4nu-4jVc25oKJt4k5DTIv_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSApipyk5gtw6S1bPgRRzEQWGppJzr363jSYVwxZffDUg&oe=6B0469B3"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyMC72GRejQQ7kNvwHHEkSJ&_nc_oc=AdoRucq9YoX4rC793xJ9I29uKeAlTykx3hAc3x-uf-lFFasdETrLHiyy53h7MuGvksQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT4laatJ97t0AT51qvo9of6g_K8jtfXRqHUcrdyZjk7Q&oe=6B0486B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyqZQoAkTLMQ7kNvwHLEVxH&_nc_oc=AdpPfrdjjvfbJK6D_LN9AfTW379q5E_3NzWq7z0GvCt_ZE6lI3AYkgwEKZb-WZukWHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThzD0kz-16J8y8BXZbwdQMBHywrdnCQKiEA6j8hVIWNw&oe=6B046467"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARryVHIKHxkQ7kNvwGyN5ac&_nc_oc=AdqOdnW31VIj0yPuqeap9saOAqQ2dZwgFuExVGwr5MjYB2QdPvJlHYBfRq9w1tRJESQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHsSMSS2_LBcR6dP4tpcu-_KQaahITNcfpFQ5BCi1NsA&oe=6B04727E"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugXNiOZ9jKUQ7kNvwGleMRq&_nc_oc=AdqBew5MtMMigx1F2dNZnS4WoxoNECimX7Vbm9pHyIKLrQFmQEdbrGuiYtTCn3NS9wg&_n
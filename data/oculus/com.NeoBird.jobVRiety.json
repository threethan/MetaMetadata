asy navigation and interaction \ud83d\udd79\n- German speech + subtitels in English for international Users", "short_description": "Experience career orientation in a whole new way with jobVRiety: In this interactive career adventure park, you can playfully explore various professions (optician, retail salesperson, electronics technician - automation technology, mechatronics technician - refrigeration technology) and try out typical job tasks. Whether it's technology, healthcare, or skilled trades \u2013 find out what you like most! \ud83d\ude80"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meramo.de/jobvriety-datenschutzrichtlinie/", "developer_terms_of_service_url": null, "publisher_name": "Meramo Verlag GmbH", "support_website_url": null, "website_url": "https://www.meramo.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25407425038920810"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epMHMnBuV-EQ7kNvwHbm6El&_nc_oc=AdoIgeBecEcpPuYQ7_LCztQAxU4RP-Z97q37_QvrXgF5ZxE4e1aT0sAKPEffQOOQrwA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-Q-gipCQ01VNw8D4Wv5uBykZlJCNmAYKkmPF7YYl2AQ&oe=6AFDDA
-25/491824292_799354719156210_266327153727456801_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6p5vAlE2ZQQ7kNvwEvY7Xn&_nc_oc=AdpEhMiWXfHdb_lr4lrbw87P8AZdDbjsfyTqFknPS7XBfqe6E22X0Ow8dMv7LvX2xsw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBG0sBk_-XrEmUDjgIFqrz8Qzl4qgv3hHtoqse0Tmcq_A&oe=6A6F37F3"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zI6oj7AyG48Q7kNvwGArDSp&_nc_oc=Adrshml1pNY-7GeJVJ-yxuXGZG7DVYy4bGEos-_0vs9HNb7OKfMJHG0pZUUCgxU42EU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjXgMcBdFWLYDslOMK6lgqpHNbAst54FDA6GG7jI-UTw&oe=6A6F54F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnzEcF_wwwAQ7kNvwEghnpu&_nc_oc=Adre5O7dLcyj_mA5FDdVKp9eXkc_ecLqpiAHfL6ogSiZa5ZZ8wXSfGPbE-rlRDjl45o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKg22QRdg30PW31fv7zAvsuOiu8jDz6S7SGNgWA3QwYw&oe=6A6F32A7"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8O3olfTV8MQ7kNvwEKAWQ8&_nc_oc=Adr4Eo6W0YSzZJmYejoFcox_WACM8IHEaUzhvEBj6-28T-3IN55CTfI0R4YufNUrXE0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqGOprWtWUHCmj6OiieHs-cCrX0cO7O4kEEDl4wsZBQg&oe=6A6F40BE"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-ZZOTB7RloQ7kNvwHLWcrX&_nc_oc=Adp3abgJ7bMA01_gYMYA1IGvTiuxmaKIHL14yEw7Aj8RUuiQX8_dsv8vxDCymUFlXdM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAUhmUsj7EvpJAWZSgEtbqLMtoXIN8tZBZZ0bKPMCNuw&oe=6A6F3145"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=
v/t64.5771-25/491824292_799354719156210_266327153727456801_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OojCRk24B1wQ7kNvwHpLOf2&_nc_oc=Adq8ec5p14JMnB1zcXgGTVZ4ohlajFwsN0ZFR_uMz5UwWNNcNUmJILQKaTztTgEGm48&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ksVhM03WfERLter9NxO1KsXnH2Cv6XnzFDwsK5JH7Ww&oe=6A119D73"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IB8iKIBPmPkQ7kNvwEbXMjk&_nc_oc=AdptpCnvRkQ3eCA8wJpcruE_usw_S1Snz_zkdxHAbzEZEmwupiFW1u_HoQbRVTdp0WY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60hXdPlFGHEnE2JB9qwjY99F6q4PRKBTmy-sIKNG-FcA&oe=6A11BA74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsMLPr03R9EQ7kNvwEPCsEi&_nc_oc=AdqfCaPmwgS13PMon6zti_ZMyISVHhV8ngKWnjuekeWXrw1KIIqJvwk6nDhrcfx7wEY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af739n8sr1yC47cN7o3M4EF-_LUx6lzRgYMS2Nj7kmiwXA&oe=6A119827"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9RK1DlzyPkQ7kNvwEcGPy2&_nc_oc=AdrNAlXjW_WepRj2HtS7EKj5a99R0qJNwAMXc8lzS6vR_jmQPnygHcdkbeHpqroxx9s&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66EDn6lQm4zTfIULRiZJUPevtTr33MQUjxNjJBHfYRpA&oe=6A11A63E"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZm6HuV7q1cQ7kNvwFKm5zh&_nc_oc=Adr9SFPLP37RcllBDwvM3Vrp3E1NP7c41er97qqf0dlPWOXA1WbKBwO6Ce4dtyoV7Jo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KBtyw3E-LFyZn3AYqpck1Dx8s2Tr8rrJuvcQWsRV8Nw&oe=6A11CF05"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548
l, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "1740232476561271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392000_1740232479894604_1157582874974344537_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plAyL9y59lcQ7kNvwEFR6zn&_nc_oc=AdomxeR9GsVCCjH2KLo9_H0NLTHnoSMelNhf97EYUX4cICU7cnncrP2SFrcDA4lBmvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K0rMsKLD9NN34tYVjNSTGcgmixCo0g7gxWsJYGjJCcQ&oe=6A073EC6"}, "display_name": "JobVRiety - the Careers Adventure Park", "keywords": ["Training", "Professions", "Careers", "Job", "apprenticeship"], "long_description": "Experience career orientation in a whole new way with jobVRiety: In this interactive Career Adventure Park, you can playfully explore different professions and try out your first job-related tasks. Whether technology, healthcare, or skilled trades \u2013 find out what excites you most! \ud83d\ude80\n\n# Discover Professions\n- Optician\n- Retail Salesperson\n- Electronics Technician \u2013 Automation Technology\n- Mechatronics Technician \u2013 Refrigeration Technology\n\n# Features\n-  Interactive Career Park with mini-games\n- Explore various industries in a colorful environment \ud83c\udfa2\n- Virtual Internship: Take on real tasks from different professions and experience playful learning \ud83e\udde0\n- Intuitive VR Controls \u2013 Easy navigation and interaction \ud83d\udd79\n- German speech + subtitels in English for international Users", "short_description": "Experience career orientation in a whole new way with jobVRiety: In this interactive career adventure park, you can playfully explore various professions (optician, retail salesperson, electronics technician - automation technology, mechatronics technician - refrigeration technology) and try out typical job tasks. Whether it's technology, healthcare, or skilled trades \u2013 find out what you like most! \ud83d\ude80"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meramo.de/jobvriety-datenschutzrichtlinie/", "developer_terms_of_service_url": null, "publisher_name": "Meramo Verlag GmbH", "support_website_url": null, "website_url": "https://www.meramo.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25407425038920810"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78v-cMbaFA0Q7kNvwG_geeS&_nc_oc=AdorSOJucdXG3nF9Qka4Iha_wEILk67j88VHXOMrnlg34uV_GuTnuBMyMU8LLbzkQbM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C8BLna7ru3wI24K1FSq7jVIZWgTbvABHDrYIVwhSe7A&oe=6A071A3E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "JobVRiety - the Careers Adventure Park", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1747295580, "lastRevision": {"nodes": [{"id": "9105481852875054", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9105481779541728", "is_first_party": false, "enables_in_app_ads": f
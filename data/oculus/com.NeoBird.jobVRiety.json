-25/491824292_799354719156210_266327153727456801_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kR4YzGzUrEQ7kNvwGiWI44&_nc_oc=AdoJ6SFDd1mML5YfN-pGM-tkkRL7nFWgN5tc7bxzn2yUwNMyxp-oRLTu7LGnR3CbDnI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTriWPhv_oWKVA-0aa1k092hpGw06ubRrSUeUkSAF8MIg&oe=6AF497B3"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pF8x8qjaFC0Q7kNvwEQ-D5M&_nc_oc=AdqSfnAy2vGCaNpz95OtNs-SnHAHF6XJT-2DbBIhEt4dJcQlUkwFcUxslzMtJGM5vAc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHCMVwixGllJsyE2kFAuRJvXh9JJitbDRebFqpFGjZKw&oe=6AF47C74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8B0xiOy9EooQ7kNvwFWGC-b&_nc_oc=AdqAjQF4mtzZsMcbmhK5_Ubb1oCEbwinTInxnC0XWNFBqSdrubsu_5a8blZXWDW1w6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc6w_EfW1jjl1cSSxBb5XtdtONL5NQ5JT7BVqTWtpJzg&oe=6AF49267"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HS933s5KhksQ7kNvwEXlz_H&_nc_oc=Adpy4Q5UR1YmwaGPeXd1RP8GLnblRA-QOhnBEA3aoVFXjO3C8GiHYAtgro8CU6Mi5KA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3DBjk5NvGKuH7oKJjP0b4v6-hxwsRm6__HpSXpggYOQ&oe=6AF4A07E"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzCwGlVqZvUQ7kNvwGP27zG&_nc_oc=AdpwYUZxtZ9EmadkXooFe-mpAoXtnZmvKD09R0lfop9BhZXJpDX7Akch0rQcy9ILONk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQThMmTXiYBfF6RBdU9nT5cuAUKkaNX5bT3vCnXnEF31A&oe=6AF49105"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=
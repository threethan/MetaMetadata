UVQ0&_nc_oc=AdmQVu8FX8nngwXElKvmPE_s6wJRBesq9DS-nnTCYSCjdL-WKWVwFziF38prr6FlvOE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftNpaBEkCM_SVNMp9F-2AvOQhbU8wVqhPDLVIdinkr3KQ&oe=69A58273"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6CAeRVmmYkQ7kNvwFQrzsc&_nc_oc=Adnoh7rXJTaHYHn4-I9xr9YQimImcMBLN3xQ5YJGJREXD0eE83T75ZxZ4YdkvBnyUTQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftJ7reejmYjo1EVcGF-LjEV275J4KV075OfVVAoNT_3XQ&oe=69A59F74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAUeOLWX_o8Q7kNvwHPsisT&_nc_oc=AdnbLn2KBp3qY232FQwlDxSONb0DF0LCYfSn3bD3yDu_wO8wb_iaIltI_kkt4_U3DCY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvQDTVu1dwGvmxDAyaXLV06CLd0hUD7AMXDs22eJPAavQ&oe=69A57D27"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HqxcShQ9noQ7kNvwF0_vbc&_nc_oc=AdkDD3ez_wXxQogvEsjsSEp-8f3yVbWn1voTHhA7OZSYsYAjoqznXGcDILgBEp_h34U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuHIBZAZsYuN6xJ8zGcatvBTBLXnlB8GAoB1IhBsAF7DQ&oe=69A58B3E"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11pj_yhmCIAQ7kNvwHJMu3f&_nc_oc=AdmVj1qZ0_4EznmSXlbZF6JSPKsOK4igowp9fbx--mwNULhmD4ymKOrWX4nuTywIRRA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afu0SdrvGn1FnNOFZjcNDBYXWOy3qJKGdr8oWLquIx6zGA&oe=69A57BC5"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQi285I8F-YQ7kNvwEXwQ3c&_nc_oc=AdkTWBKsr_ukY_5-dxO2UMaFFw6-P0zIEzh1FecU9qqgzPzOx12yZ7aIj_j7oLe6tj0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh
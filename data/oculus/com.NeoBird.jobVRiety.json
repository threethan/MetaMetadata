fMpP&_nc_oc=AdkIIpfmKO1ErJ1-mkk1MYT2tY4zEzv83_i2q_yRlrbSQcI26PzWxmcwhgUktLIJ1Ss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftDJ9y374gczamXMsBW0VjnhQXWkriVM_V5ZPE544oRYw&oe=6999A4F3"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wM-Zww09AJsQ7kNvwFXzn4K&_nc_oc=AdnzHstDOmpbt2y0SS4f5wjEiSu4glONPUxsur3-S2fhEmWRk-VLa_JJyQ3UX7Fl-Xk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvmA34muIR3p3Y1cLnnDYNiX2JLSdQuINQIy2ZBh3X8DA&oe=6999C1F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wriszs7BkG8Q7kNvwF65P9G&_nc_oc=Adn_m9ey9wTS0yHCwAMM1FNiRsCwLtHFYRfKqhagYUKWsSD_N0FxflPQ7yQgss7pAeU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv_ySrqTy7CcF8k4e_tDjJT7e06vGqfVCShPvgFFNYqOQ&oe=69999FA7"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z961YFxoIn4Q7kNvwF9daFh&_nc_oc=Adkl33rX5v2-DEPaJ0sJmIIlIrBRaAUXRKyAiwD8GjZxl2D6BhVtjamW7vnlXR6nrp8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfunzpLdJ7JwKd9Ggcx2RN6ZKKECL-k-uiuqRfEuf0_HQw&oe=6999ADBE"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOn7yBsRU84Q7kNvwF822jq&_nc_oc=Adm1mSwxfZu5Mwi6n-4pcf-nlhNojtz2gcag5LjXgAOUk5x0M82q06fVdcHdmmX5SNU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv2t7HkQu-M4Ec75xmMVCbW--0ttvphhJZFRABTK1QkxA&oe=69999E45"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtW5cOdlFgcQ7kNvwELY4F-&_nc_oc=Adkw_jok-qxz47Zvh7hKvszm8xoPSeyeyQRhaCuxtgT3JxB7Q6LDY3J9nS8TcjSWdhY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh
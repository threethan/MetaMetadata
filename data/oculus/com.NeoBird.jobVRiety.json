ramo.de/jobvriety-datenschutzrichtlinie/", "developer_terms_of_service_url": null, "publisher_name": "Meramo Verlag GmbH", "support_website_url": null, "website_url": "https://www.meramo.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25407425038920810"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oemY73VoaPYQ7kNvwFnT5de&_nc_oc=AdqvFvETmjvQI_SX8e2VJ3UoJw-InEU7hfqOskststIWYM8IM7D5pthUgJHEnmJ2LYA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vqFALUld1OsaVxpWGy-8zBH9GCLdGWin1yUlKzOM7bg&oe=6A411C3E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "JobVRiety - the Careers Adventure Park", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1747295580, "lastRevision": {"nodes": [{"id": "9105481852875054", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9105481779541728", "is_first_party": false, "enables_in_app_ads": f
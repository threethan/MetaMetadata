v/t64.5771-25/491824292_799354719156210_266327153727456801_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hmk3Vh5TaIQ7kNvwF6yihC&_nc_oc=Adpd6njkdBXr-ke55TgdciGYdzl4k2W0VkyxTQr7of6mJibHUyz7MTLU-ksDQQARiCY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZg4pyMtGITa8eYNm3T0ZW-3Ppx34qMv-Tdb8jL2wDPg&oe=6AAE7FF3"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ovH_LGvaOYQ7kNvwE1mHSe&_nc_oc=AdqBKM7kC8XIi-E0XBND2vlsX-mAlAlLTLTCcr3hflXJUPimtlwPcDfopnVQex4CQfc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-aHUb2rbxJhJVHl0wXLpbEh9fMJEHdQq6G0Zpt0J6Gg&oe=6AAE9CF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDyyjjlWzLAQ7kNvwE8TZyK&_nc_oc=AdqD6dEe7PFpGl3oi_D5JPTU08jlUPw719a_KGiLgKaAka2pJOiqUxZMVoFuxXhwwWA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlgE1w5dA-uL3U3jKqZHw2ZCTfriPrLrfXeNNVxTtkcA&oe=6AAEB2E7"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6oZQLrieHAQ7kNvwFYDsBi&_nc_oc=AdoCUvx1I3F-ev1LIhbFo4J0YJP0UOuWt0PPtkC7zOOj-X9ZUeCshrJG5ed1CPjA7Cc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0VW-Y7NoQpTblz3sZ3Hz2iHauYnsuTzwMipJlgL5XkQ&oe=6AAE88BE"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6wIurfZr3gQ7kNvwHhYieV&_nc_oc=AdrOn5E4q_0s4BibJXtccm8pMeT82FyLC4MAyhnegag_rIdkhEJRIRqMkGJhpNFXuY8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXaZkKDb-X_HGzIwHLxC4-5omrazC6zOYPfq1CHNAyFg&oe=6AAEB185"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548
v/t64.5771-25/491824292_799354719156210_266327153727456801_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxVA6ew2KWUQ7kNvwHURZMF&_nc_oc=AdoXpOFTQEow4j-KpddPaRurpIDN0txOOr4Zi9-Vo0qdOqz1I8V-KZMZclsBAjNZB6M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qhq850Wz8MxBiKYuK5nWsDgTVr4fo1uoWL0kW1ZCs9w&oe=6A3962B3"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wuj8tVgy__cQ7kNvwG829At&_nc_oc=AdrkG9eo7ykIm-xfwQcwDfjJiiRsPENFPfKr4N6LMSseKyS3eJ850EaYJdXys4kPAg4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-owb2VaiDDn6ojgT0m144jiNoHEG6XLQnM_zEXaEZmLA&oe=6A394774"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBtdYEPgWVUQ7kNvwEfWj37&_nc_oc=Adqla2TsQpXZBs0IRuMshvN4uWLzwf0gtd8TjAKxOgux-SeM2vYFmyPYRotJN9ZX1GI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yxK2RH2BnOrujE1KG0HeFSwkDcFsmF4yP24JfSeGLGA&oe=6A395D67"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GozdVaf9TQQ7kNvwGW3GUy&_nc_oc=AdoxtODapDznw79PT1GfoJw-a7JFIxYjdtq_vQFj9G4zEV6bGwEPWYBkX9JXXpKNz9o&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kacG_6Of_3t2GFSkt-wrB-t0naGFwCPY7HMo4FVH4pw&oe=6A39333E"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cb3WRr3-aWwQ7kNvwEMrto1&_nc_oc=Adq8c546scqNFImoO01YdRvVMOY6WXadh24qU-9AUnS1D50_8fKxAuQVWH9GRD2MvCY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8piLMZz3PnD1lhWevoCjLvw1NstSFn8_JZmP5roVWRGA&oe=6A395C05"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548
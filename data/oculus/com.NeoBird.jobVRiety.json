&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQusvg3kILX3mUYMBVGMYhRBLS8B4HcHLDC41kVrYzb5A&oe=6B06FBC5"}, {"file_name": "screenshot_4.png", "id": "799354715822877", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_799354719156210_266327153727456801_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mG9AoJb2SsQ7kNvwGoi7hk&_nc_oc=Adq0FLVisAsI6yYDHt4e4BrQ7Ctc89ywCRRxqd11ZJg9g7AlDILNcgPRe0Tmwzq3ezg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY3eLRgSZKYZyrkGHRrxOLcGQrxJR0u97NpKy-3JkZWw&oe=6B070CB3"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyMC72GRejQQ7kNvwEq1rAl&_nc_oc=AdrZeBpnkmuCZavG350oXW7zuOnSmJXX4S4gSN0YTGjULImFPl8Tb9u3HeLoDtmVYiU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSeYvMrSL9Fz8h5YsnatJ3vI5q2X1qmpdW_-e66EqVBw&oe=6B06F174"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irXz3afNBzwQ7kNvwEUmZ-o&_nc_oc=AdqqaQagNnJ7pWoqVp5k9kzAgktX1EqEiA9PhWEXRGw7whQtiJ3EkhOnFVQ2vZJs980&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDhx2mCemXt2k6Vx48e560qrLeLXcN1CloAmCwgCuOrA&oe=6B070767"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARryVHIKHxkQ7kNvwHI7Pkw&_nc_oc=Adpgv3tTB0kNZC_BvpScRsBtzaNxZCKRrQH8IplY1sCDD8PIVZ3KKzZoyy6YLwNsYjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd5aB1Cipxi7kg8OEvLn_SG_yK8nZPxyaC6np_EDNOzA&oe=6B07157E"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugXNiOZ9jKUQ7kNvwHRIkuM&_nc_oc=Ado0R5EUWTR7IGTDdc3UqPz2zjKfm-sIy5whqi5bcuAjheFUl-r4HKtPefJ9Y7jFbXQ&_n
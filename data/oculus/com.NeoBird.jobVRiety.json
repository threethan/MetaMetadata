-25/491824292_799354719156210_266327153727456801_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXMvTj38r1IQ7kNvwEC3Wig&_nc_oc=Adp3nH6NdKuIO9Oz0SO9fKHTrJhEXHfBG8uiwigBR7nwGEv2mBs94uxmbqzK90yWTS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkkrUuLBN3h5lUFh7KOm0Oym2y89i6q1KsX3mmudfD2w&oe=6A4B9F73"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNF4PV0d4f8Q7kNvwGvoZMs&_nc_oc=Ado0hYyANsKVir7Jov69oGxhM5xiy7ZHjDyDsdFw_jUxQbH1yh32PggM2sYurxm56O8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRYyxjom6VNmj-anWehseYTFKVxzOzq5L9J4UmaNMHaA&oe=6A4BBC74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVtNAS84EBwQ7kNvwGhpzci&_nc_oc=AdoCY-MZMI22Wq4n5SIPrc0_a1f-6RWzJix2fwsixcFiO1QS9erkK5teVXZfA8v8ryM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAuMt1NN8s3ghtzreBMxOyBq-1LOh1xVjtSWHB6msJSw&oe=6A4BD267"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HR29lhsh1_YQ7kNvwFtsESv&_nc_oc=Adqq4YzX9ABmYSU1o9o-TbRuaXxks_P15OjkvKZJeVjIOdsWVPFUerJCbCWVRb7r62g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEfEnqddnsqabS4whBzbbtY6BM2vX5hx09q1AGbzisXg&oe=6A4BA83E"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MssCUjNCnO4Q7kNvwH1Rrp2&_nc_oc=AdqezqaKMV6lM75w1g2Ik6sMVF5_Ci4XbdzYQ3zeDqhsS1qSs5nY_MR_xgTz6BOvzAI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFPxsSAiWXcFh-ygMjD_M0sVfMiiUp7pRIVxajCHoHWA&oe=6A4BD105"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=
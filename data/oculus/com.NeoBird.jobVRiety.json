-25/491824292_799354719156210_266327153727456801_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGPNknMwaS0Q7kNvwGTeOv8&_nc_oc=AdqrmSgwV3uvaFI4bfsl-DGXU3jsRFgHgP74ceRMfd-Z89b6l9YEYrLNxInGHtyDFzk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWygThOUC4NsWDh0tgAPzMlaYPR50q0tLx1-m0-qBNkA&oe=6A86F2F3"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-fxcaf4rIUQ7kNvwGK6AZO&_nc_oc=AdrR0_T2gW0Mc0Go_7rcYJpQe6Zlc_AfnLnpBOvr6_XnsoYrXN1emjFQKi7WcPEDSX0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqh7SyGgqLvvDhR6ucRJoQpOQFgQFP88AYaFIzFl2vtQ&oe=6A86D7B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo1B-35db_IQ7kNvwGxJDZo&_nc_oc=AdrK8dehj0kU0dMayKtvN712_MINBx0toz4Ro1GEyI9PsvByFJG_nXdnqJNr5jdYUdk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR8eoDxhV9CnrO5vKNrQiDZYU7693RROSVTZWm52mx3A&oe=6A86EDA7"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxOwuhCO_gUQ7kNvwHelgaz&_nc_oc=AdpRaoL9NkZRuAZP8g2Gp-xX5mg4OWlHR4nwAJq4I_bT4ESnuJf59MRhO210GhHew44&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEc1wcJSMF-BVVfg5Wnk6uNnJXzHF8D_KZgj1mAzHDLQ&oe=6A86FBBE"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWpBMvP4flAQ7kNvwH_KiFj&_nc_oc=AdqSVxBv72BhzfwMrmZorx2ubvHIll9XU2dEgCiB9e9i6FZ_HWIdclKV_ez4gHWJ2bQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyFpYFDwvu2dSef5LA6dB-u4vXrwRQG_lpGHzfY6-GJA&oe=6A86EC45"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=
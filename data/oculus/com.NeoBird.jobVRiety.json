awiv&_nc_oc=AdkHWuX_WhgjdaLwJrKAm6HtACfuyoXLKJS0Oqb7LlXFh_X__QKkUemgzyyGUTmFz1o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs_pj9p-aronWh292abAU_OTcrJjNjZ-AIQM-xzBDH58Q&oe=69A430F3"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6CAeRVmmYkQ7kNvwFyGnNq&_nc_oc=Adl-fD-QPG_2ZY4cYa_M8Fzbyu8LACmAj7M1SiYbuUwAVp7-aPkCNaIDVMuAVlQtm34&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsYdvlQCdvxOQORrk5hsY4dBnrzuSZc8XueO0PTPC7Y7g&oe=69A44DF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyRFQWZRzpoQ7kNvwEn42JO&_nc_oc=AdkyAz40wNZCVEYYRO_SFFfrS_WwsMJWihVfGB2ExCkCBPHbPW0YM8xPtDKQG20zXNw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuaCpAmzjqL4lmm7OPN6ORefDifREI7xtRWZ9pXvMw2sg&oe=69A42BA7"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HqxcShQ9noQ7kNvwGJRiJs&_nc_oc=Admz5OBHADHYcoqt5wXNUaTgYp9asK0nX8pHzJ-CQXHZkwUEK06lLhcetbyB5WCt-PM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv9otwOakQ6IefUM94r-nmXWfBJ1YwuXhYDGFWrXakA1w&oe=69A439BE"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11pj_yhmCIAQ7kNvwHw0S4E&_nc_oc=AdkjtoK2Z3NQRbtEUsrfl7I9crXiHm81t209xpYWKVAA6QEU2ww4UFLGvToBu0A5ZUo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu8DUF5vXMEM0puoiY4_jjvUAJGlazU61udJ3dNJzksFQ&oe=69A42A45"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQi285I8F-YQ7kNvwG7C0AM&_nc_oc=Adk4-nx6tqHAeiLOk-sT21ii-93mr6B2jRiu5T6yEuGEYGD97a5yyIGHyjF0-GFVcIY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh
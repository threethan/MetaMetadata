BBDz&_nc_oc=AdkMZLgH5UO8SqTYrwH3KS7YPMgrDZGc6q1uXoUa74qkfA_LEay1fqaozvAmd4COp9Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvShCpGM5DLO_8MJri50eTbzjVVMyWFQ3ZYrsN6Gc6VmA&oe=699D9973"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxoyPNQyEkYQ7kNvwGdsFml&_nc_oc=Adm3aaBKHN3WM-7EpfR4kXKfyefmI-prpJenWCHKL_c2XI0u4dnNY07duHGdcDvSPwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftjvaP44Li97moKUoYs2wnFTClnK0sYFr9pETKvagxfGA&oe=699DB674"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hx6tSD8ZDoQ7kNvwG5_xSz&_nc_oc=AdkB84cVcys8BHixUebzLMLLkM69NlM7IwU1uSLI_Sd7JBfo_u5V6ZTrQVihens3Kj4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsZiyIXV7Y6uaHhkViiwRVon-A3M1wWMxQ5yrOZ1PogOg&oe=699D9427"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBVU2uExQcUQ7kNvwFLYDBd&_nc_oc=Adm0aqTh4E3C7SAX7z3hIruESIQTdhWBbwPPUzpHHgZbqJNIb7XMaQNDtXn1Y1TjZ8E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftka8_3pgvOpYjoJ8SXSS12xqu9xm_WrNb-cFlu-EBx6w&oe=699DA23E"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anLGKf48it4Q7kNvwGfw8E2&_nc_oc=AdkL3c_BiC6rfQ1iCcoGQ2SHo4PBPLMMG0_5fy3e-EvMXdpwHkid-aXqUjicyCGxMVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv4Kp8DIMr6qg38bUKSigYi2HljIxoPcQmjJaq2Oideig&oe=699D92C5"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l15PaHXXPesQ7kNvwE3Th-i&_nc_oc=AdmurNP3u6v7jtQXm8Jt6_XHJCFGpUvhEY8h0Oj0Frl3KmV4KZIYe2xtGz9Wru3QFuA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh
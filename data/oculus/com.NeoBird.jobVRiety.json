-25/491824292_799354719156210_266327153727456801_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2Qa2er8sgIQ7kNvwE74O9C&_nc_oc=Adphs6bMw5DKdZrpAAzAtNXHm8mAby-aNt3Vc2x-odhSY6bQm-nP9phKg-0KKw7xA-Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSJTCiXfX5N8yhR1UYk1K4-hw0NRZF_hV2aSk5cJStFw&oe=69C3D4F3"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_YJbJtOG_UQ7kNvwEeKITs&_nc_oc=Adrp8FdnXIqn8O5MTbMogygOHIMEXwJTlZZeMW5--lqepT9_HRBCvt38W6U_ZvhXTQk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGLgw2t9zCZnw75bwO_MnorzRfRUx19KsKNSw0tOhQAA&oe=69C3F1F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjYJugkmp4MQ7kNvwHCzkgX&_nc_oc=AdqoHAPd972ygOiMyx1zYHzn1bUfKHE3leR_O_KSY2ieiY3a7FbVG8l8rOJwDL6FxQc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7c39fqtdQ0nIwau6QJ1GSsiEut_Oh-7sZYmQuhcYaVA&oe=69C3CFA7"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Bl8v9AwpvoQ7kNvwHkOTiP&_nc_oc=AdpMYYsJOQUx5bxh202JqmU8cyr_f6zXKKH9Mah13lJ9V_u-PArxcZamDrFoohtT-YI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxpf4eUZRyKyjY10bsGTnsKP2PKD1eVjrOqY89GMA-yFA&oe=69C3DDBE"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8TYcl04GYsQ7kNvwH56TO-&_nc_oc=Adqbg0-gHjImWXZHcBh_XkhdWyVx2RcD6d_mKR63X4we_V2r8W5HwNS5bWlwzGB_tlo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwiAlILR2aSduKlboZHKM0clQ8fEOTJTcMvHo2OrNwfJg&oe=69C3CE45"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=
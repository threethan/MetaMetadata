-25/491824292_799354719156210_266327153727456801_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lx9qscS3pSAQ7kNvwFYLKwQ&_nc_oc=AdqHFwHQ1OLDk_vXZd4mcjQc-DfKWKB8yziQj2GuGP9MN7ydJdf0xLaZrACmmC6nThs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnD8RT4iQVBiNGJH_oQ8BeKTtr51Y9EoQ1jCJRt7XNOw&oe=6AB7BA73"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBg2DbmNlzIQ7kNvwHAFZzJ&_nc_oc=AdpOd9I39kovGN2vO3IgiwEuAV5cc6Fzwb4whkJnZVZWWYbbL1y8DckK_Bt5OEPJKWQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRJwXyYBCbTgKUrMb-kZ6xFBnELe_IxMsNZFZQFOXQbw&oe=6AB7D774"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZMh0b7ai_sQ7kNvwEccrqU&_nc_oc=AdoSNBf6V8lFGiws6WA_iP4CjkHu3X-S72igO8cIvo0oIZds58kYGuyJzGwl-xyelt0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoQ0kN_HmWPkNygA8iCI07j-sTd0BTt8r9UQZWRfbMSw&oe=6AB7ED67"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jS0y06v_HvYQ7kNvwFbN8P6&_nc_oc=AdrTKqRMdft-m7bZGroWtUf-jN11gLQH9C1bYCiaITkZ12igmgX0Wz8OGQqwKpoxaxU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYjI8Jwezm_aCLeVKmpqVToRfHZavTrQ0lQOzQPNEXsw&oe=6AB7C33E"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL7SkAzm64gQ7kNvwGaKNdr&_nc_oc=AdrzuXIifaLjGNPD8Bgs-5wTCqFZtkfyt-JWq86lN4HmQhJeoDe4cHj-Os_vCvXMMC0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPF6vQVo2KGDVd3X-lusxG35u5UMikWCzaKkwVq4vTkw&oe=6AB7EC05"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=
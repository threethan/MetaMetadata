153727456801_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IHdKVhhfCwQ7kNvwHZYppn&_nc_oc=AdkHgWU-8Owy_Jesx-4_mh9lPEtHJuXoWHM_y3DSs4Cv9YntdOSnlycGGI0FZ7zaWk8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzh0tSRzLXDjDL89vsTp13CSyt5rG4-8sa6hqXF1IQ0yw&oe=69BA9A73"}, {"file_name": "screenshot_5.png", "id": "804247851972545", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821568_804247855305878_2474466975200600916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKKIjtbHJs8Q7kNvwH04CXk&_nc_oc=AdmxkjYTF4pYhEPifWE0eCTk2abkuKRouDGfeZyActterBhG2DeBqLqL6OH8UVJ7h7I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxtFZitDOnft_8FQS7aMV-4AWWckM7O2eCb_xrNmWwk2g&oe=69BA7F34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_2.png", "id": "24741075092172429", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820325_24741075102172428_4760804442095102480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eS8hvlYDWHAQ7kNvwF1bS8A&_nc_oc=AdkFA0h20apGjhFCoxRepY4QiRCXOc6f08dBS11NFepfXRq8wev5Y6Zr5iTUQp_RoWI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfypmQK0F1V1_weR4gcG08KVVxslr66AYHXxz394U3-yhg&oe=69BA9527"}, "display_name": "JobVRiety - dein Erlebnispark der Berufe", "keywords": ["Berufe", "Berufswahl", "Berufsorientierung", "Praktikum", "Ausbildung"], "long_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80\n\n# Entdecke Berufe\n- Augenoptiker/in\n- Kaufmann/frau im Einzelhandel\n- Elektroniker/in - Automatisierungstechnik\n- Mechatroniker/in - K\u00e4ltetechnik\n\n# Features\n- Interaktiver Erlebnispark mit Minigames\n- Entdecke verschiedene Branchen und Berufe in einer bunten Umgebung \ud83c\udfa2\n- Virtuelles Praktikum: \u00dcbernimm echte Aufgaben aus verschiedenen Berufen und erlebe spielerisches Lernen \ud83e\udde0\n- Intuitive VR-Steuerung \u2013 Einfaches Navigieren und Interagieren \ud83d\udd79\n- Deutsche Sprachausgabe, erg\u00e4nzende Untertitel", "short_description": "Erlebe mit jobVRiety Berufsorientierung ganz neu: Im interaktiven Erlebnispark der Berufe kannst du verschiedene Berufe (Augenoptiker/in, Kaufmann/frau im Einzelhandel, Elektroniker/in - Automatisierungstechnik, Mechatroniker/in - K\u00e4ltetechnik) spielerisch entdecken und erste berufstypische Aufgaben ausprobieren. Ob Technik, Gesundheit oder Handwerk \u2013 finde heraus, was dir am meisten Spa\u00df macht! \ud83d\ude80"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare_1440x1440.png", "id": "2448391595528830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824609_2448391598862163_943533169723644988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9AJfXssM-cQ7kNvwF6X-90&_nc_oc=Adlnm1fjfnCk9TcCrZT-H_blCgRLwesiv3i3IGTOVy4cYZZ6NcvHjXxZfXXFrikK7WI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxcaFciCBJoWWUAt0IrsCFkeaCQ8LPN_Vks2uYLJ-GuwQ&oe=69BAA33E"}, {"file_name": "JobVR_LogoClaim_rgb.png", "id": "1748084809102207", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391924_1748084812435540_6618933153218592214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKhWnVv7kqsQ7kNvwGHAF4N&_nc_oc=Adk-5jYJMBURPEEiWT1QyY4vwYXe3BdNjy7tnupuz0As_2dsF1XyYtoleeNxF9Ts8is&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxfsKdpRrKVEUplpt8a9FZ7itG25Qw18LBhRrrlcUII3w&oe=69BA93C5"}, {"file_name": "CoverImageSafeAreaTemplateSquare_512x512.png", "id": "1437850287583522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822001_1437850290916855_5164054200507134548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6EtFSQySN4Q7kNvwGvIP
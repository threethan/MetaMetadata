9137894400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwImagJ2U7QQ7kNvwEvslhE&_nc_oc=AdoGe1I1hSAoTge2xrAGOjY7S_n3MMFKMRiCYsELL_2KSwpAxmz9kO6I1sjyIo6o2zk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLr09Nv92vE4ncMqUlJuDcMtJsje7sCT_oeizqAd9szA&oe=6A8588B9"}, {"file_name": "migrated_image.png", "id": "493037751365994", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162732_196472760900561_6610591444690272256_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFZd5M_q-VgQ7kNvwEPlzi4&_nc_oc=AdofIC9l-fhBHSgYQBf2x0ugbS7ZJQU0xaA3loxjMzGRN-McsNZwXyOYfhCxBFFbV2g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHELM3fPrbZQTJWe08_La6FKDWy7d85DqJnuOWM2Okkew&oe=6A85AB16"}, {"file_name": "migrated_image.png", "id": "225079392229120", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162763_154010635329653_3959959009393377280_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLS5oihaG_wQ7kNvwGZmSxF&_nc_oc=AdpAm68CjthWb4rWElKRsTBw9-IOB78Z-tIMESNbEgFjDUMfJ4naehVbzhuRPzzeNks&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFo0MFwt_8DGeP5ah702f0-vW3vN0YBue8Gt6blOUeShw&oe=6A85A876"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wild Wings", "keywords": ["wings", "flight", "combat", "fly", "wild"], "long_description": "Wild Wings brings you action-packed arcade aerial combat. Conquer two unique battlefields,  feel the G's as you master three time trial courses, and become the ultimate flying ace! \n\nTake to the skies with 'Hands Free' flight mode or connect a gamepad for an intense, classic arcade experience.\n\nInspired by Hank Caruso's Aerocatures, Wild Wings breathes life into these incredible combat machines!  Take the controls of 13 unique planes, each with unique weapons and skills, and take flight.  \n\nUnlock new PaintJobs, Decals, Paint Colors, Teams, and more!", "short_description": "Fly, Dive, and Destroy!  Wild Wings brings you action-packed arcade aerial combat. Take the controls of 13 unique planes, each with unique weapons and skills, and take to the skies! Out maneuver enemies in two different levels, race through three different time trial courses, and more!"}]}, "developer_name": "Dicewrench Designs", "developer_privacy_policy_url": "http://dicewrenchdesigns.com/wild-wings-privacy-policy/", "developer_terms_of_service_url": "http://dicewrenchdesigns.com/wild-wings-terms-conditions/", "publisher_name": "Dicewrench Designs", "support_website_url": null, "website_url": "http://www.wildwingsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "345270993945250"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162766_1345484952241626_3585351274641489920_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_6DU2x48-cQ7kNvwFfNX8L&_nc_oc=Adqv1tgTu8LtkzkN1waKpjOKf1bJIQrmhKSckcAXZRzkEBLpiNsd7jN78VZQ0C2Y_hE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1XlMfycdqsy3ezfc5Zy1QMTuwMehNuemh13661mdJcA&oe=6A85B00F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wild Wings", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1523516400, "lastRevision": {"nodes": [{"id": "547010678842540", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "
ifferent time trial courses, and more!"}]}, "developer_name": "Dicewrench Designs", "developer_privacy_policy_url": "http://dicewrenchdesigns.com/wild-wings-privacy-policy/", "developer_terms_of_service_url": "http://dicewrenchdesigns.com/wild-wings-terms-conditions/", "publisher_name": "Dicewrench Designs", "support_website_url": null, "website_url": "http://www.wildwingsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "345270993945250"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_1345484952241626_3585351274641489920_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=si_j_dm6FE4Q7kNvwGpztDB&_nc_oc=Adloh7dew0WoprHjwxNPv4IanVrTEsj1Bl9VlEJg4r74QCL6NZrwYfFVbxJosBrUsqQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsqQO5lNr7I9BsBH0cpkvlqgl_eoC7PgXmlNiquaNYO0g&oe=699DA80F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wild Wings", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1523516400, "lastRevision": {"nodes": [{"id": "547010678842540", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1161174933903621", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "194808347757642"}, "iarc_email": nu
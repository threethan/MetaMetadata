IYy7H3-MX0AZv2e9rLXOVMJvzA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa3inroR851CEvNp7GLX8MVaytu0Y65-Mfn_1AWAl57Q&oe=6AAC10DC"}, {"file_name": "migrated_image.png", "id": "141894077199692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031393_1915025241936151_4470904914679169024_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQWCo8BvVxoQ7kNvwETo_bS&_nc_oc=AdqEMVq9ouZds7mYDontRkq0AZUwTgK2sxbszRFvwm9QLP3ysj1SRQXpcLlp7wqDky8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIziz9QPkK3Gh0Z39hm1jGCsN7gIHONlqPaMBUn46tK9w&oe=6AABE24E"}, {"file_name": "migrated_image.png", "id": "969632360135507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974719_557104284812169_3235244043390681088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrNO2n09mqwQ7kNvwGb_DgV&_nc_oc=AdqVSGyAhWB8G5qNiYXeEGN06j89XfJ_hdafQzeI5IPxux45irq7FQLKjXu4eO2Zm6w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh3_LAWAWe70DAuZNobM1gNiwnvC9ndS9aePEKrQaCLw&oe=6AABF295"}, {"file_name": "migrated_image.png", "id": "204530224148189", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974861_2038196229809514_6481838989559988224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sey2TRSCgEQ7kNvwFxbZiH&_nc_oc=Adog90xIkubaVEcNt1LbWY0p6stkEQH0V_XLvnSBzofor8kzc33M5xzhof1RyqGzPA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhIeUsMZwph8ojdwde_ncfydsFGOpJO5uHONySSy864Q&oe=6AABE3D6"}, {"file_name": "migrated_image.png", "id": "231856657953981", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982515_1202827069876585_3787854185169420288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yj_oltdX53UQ7kNvwHzvJx1&_nc_oc=Adp8KPWvKNFpNFk5_b6BKtifPcX592vPEXBb7pE5JwpbyC8CKfg9xYEGItWEaQRgA8M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq18AqWwInKnk9CyDz5n2gszjhE_LhuV9duavqF-sQvQ&oe=6AABF0CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Creed: Rise to Glory - Demo", "keywords": [], "long_description": "Experience the pulse-pounding excitement of boxing with the cinematic thrill of a blockbuster movie as you become Adonis Creed, fighting to establish your legacy in the ring and beyond. \n\n\u2022 Live Your Legacy: Challenge both your body and mind as you experience the ascent of Adonis Creed from undiscovered underdog to world-class fighter, all within an immersive universe inspired by the Creed\u2122 films.\n\u2022 Multiple Game Modes: Choose your path to glory in multiple game modes: story-driven Career, customizable Freeplay, or minigame-based Training.\n\u2022 Online PvP: The fight just a lot more personal. Set up custom fights with friends or find your contenders in crossplay Quick Match.\n\u2022 Feel the Impact: Phantom Melee Technology mimics the real-life effects of throwing and taking punches in the ring, such as the out-of-body sensation of getting knocked out or the strain of fatigue during a long, frantic bout.", "short_description": "Do you have what it takes to become a champion? Follow the ascent of boxer Adonis Creed as you go toe-to-toe with the world\u2019s top opponents in this intense, cinematic boxing experience. Featuring new Phantom Melee Technology for impactful VR melee combat, you\u2019ll train, fight, and win like Creed."}]}, "developer_name": "Survios", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Survios", "support_website_url": null, "website_url": "https://survios.com/creed/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_
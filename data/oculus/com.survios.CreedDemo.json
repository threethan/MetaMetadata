PaqbtbEQ7feGisN8f3z0vI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43IbxXkQ8EDjdYea46m_1-4h7VXsnKV6El1OGegbmzRA&oe=6A19BA5C"}, {"file_name": "migrated_image.png", "id": "141894077199692", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031393_1915025241936151_4470904914679169024_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIpb901sCpYQ7kNvwF87PZJ&_nc_oc=AdoY28l7qDcCljBTyLngQ878P98qUZsHrtqJmZOpx9L0AhypR1DE1jLHPVizii9LrdA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PWU3T3Wlrj8VVDY_NAa9s1UjeKAE0PZqXY_f3-NPD1Q&oe=6A198BCE"}, {"file_name": "migrated_image.png", "id": "969632360135507", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974719_557104284812169_3235244043390681088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nRJzCZ646IQ7kNvwHi4tDJ&_nc_oc=AdrT3-vWZqncRiVjhnsasOrAeBqErLzpYdem-buslk8tTtM-Njiur1aC7uINzFbiWHQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WLqSx8nEEkNz1uoS7yegWQ_8P1BKxtGC77BGnWRBnhA&oe=6A199C15"}, {"file_name": "migrated_image.png", "id": "204530224148189", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_2038196229809514_6481838989559988224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-elMhnlXNUQ7kNvwHJvJ0D&_nc_oc=AdrsFH7Ita6E4CPOjp1O_2TogTWONy1O7I3CaRGAybe8VM2gVW0XD_oLPMbWu0YUlI4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tHi1tFtAULMOj7b1SAXu66VLd8PVfmndAClWtUzHaBg&oe=6A198D56"}, {"file_name": "migrated_image.png", "id": "231856657953981", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982515_1202827069876585_3787854185169420288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaNH1rwngKQQ7kNvwHHtJi5&_nc_oc=AdoSrciIdyIStZ0xfirmZZyPFWhZQJzu3qg3vfAB9gyAV0KIB4KkjgAKcF0CS6Bfbgk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GQBWpxxu8KuOV3VxX5_RbT4ytkA511Qip-lSDByvO_g&oe=6A199A4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Creed: Rise to Glory - Demo", "keywords": [], "long_description": "Experience the pulse-pounding excitement of boxing with the cinematic thrill of a blockbuster movie as you become Adonis Creed, fighting to establish your legacy in the ring and beyond. \n\n\u2022 Live Your Legacy: Challenge both your body and mind as you experience the ascent of Adonis Creed from undiscovered underdog to world-class fighter, all within an immersive universe inspired by the Creed\u2122 films.\n\u2022 Multiple Game Modes: Choose your path to glory in multiple game modes: story-driven Career, customizable Freeplay, or minigame-based Training.\n\u2022 Online PvP: The fight just a lot more personal. Set up custom fights with friends or find your contenders in crossplay Quick Match.\n\u2022 Feel the Impact: Phantom Melee Technology mimics the real-life effects of throwing and taking punches in the ring, such as the out-of-body sensation of getting knocked out or the strain of fatigue during a long, frantic bout.", "short_description": "Do you have what it takes to become a champion? Follow the ascent of boxer Adonis Creed as you go toe-to-toe with the world\u2019s top opponents in this intense, cinematic boxing experience. Featuring new Phantom Melee Technology for impactful VR melee combat, you\u2019ll train, fight, and win like Creed."}]}, "developer_name": "Survios", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Survios", "support_website_url": null, "website_url": "https://survios.com/creed/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_grap
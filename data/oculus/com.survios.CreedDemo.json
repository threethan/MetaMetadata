l3-1.oculuscdn.com/v/t64.5771-25/38974861_2038196229809514_6481838989559988224_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZqpBjKdfDIQ7kNvwEFLfns&_nc_oc=AdrYAseOiX4wzbXvhdkzpRuslQdPSTckq1GDzSin7Eb3eiOIqkG9a8ppzzj5XS4qGq0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8uXLJmHCWeOcTZrPTw2o0c2T3qGRK_U8970s_Lj92eg&oe=6B0B4056"}, {"file_name": "migrated_image.png", "id": "523695041681100", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982515_1202827069876585_3787854185169420288_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWoGocRzcXIQ7kNvwHU6mS5&_nc_oc=AdpOQL7m2VjRQuunwlyd-34HzDLwApmM8AimACBKr_QSUYdTBst6bHT7ftevcDrTDG8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1r55-RP_JxhKyqUJt60W1oOqBnjOAdCy84PRQdfNvSw&oe=6B0B150A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Creed: Rise to Glory - Demo", "keywords": ["free", "games", "best", "demo", "fun"], "long_description": "Experience the pulse-pounding excitement of boxing with the cinematic thrill of a blockbuster movie as you become Adonis Creed, fighting to establish your legacy in the ring and beyond. \n\n\u2022 Live Your Legacy: Challenge both your body and mind as you experience the ascent of Adonis Creed from undiscovered underdog to world-class fighter, all within an immersive universe inspired by the Creed\u2122 films.\n\u2022 Multiple Game Modes: Choose your path to glory in multiple game modes: story-driven Career, customizable Freeplay, or minigame-based Training.\n\u2022 Online PvP: The fight just a lot more personal. Set up custom fights with friends or find your contenders in crossplay Quick Match.\n\u2022 Feel the Impact: Phantom Melee Technology mimics the real-life effects of throwing and taking punches in the ring, such as the out-of-body sensation of getting knocked out or the strain of fatigue during a long, frantic bout.", "short_description": "Do you have what it takes to become a champion? Follow the ascent of boxer Adonis Creed as you go toe-to-toe with the world\u2019s top opponents in this intense, cinematic boxing experience. Featuring new Phantom Melee Technology for impactful VR melee combat, you\u2019ll train, fight, and win like Creed."}]}, "developer_name": "Survios", "developer_privacy_policy_url": "https://survios.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Survios", "support_website_url": null, "website_url": "https://survios.com/creed/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "670855300613839"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974533_594524501052727_4580651439444983808_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHz7fnnJlXgQ7kNvwF2_Kvv&_nc_oc=AdqcsQZieoQ0_u3pWa3jzvw06MrWWZWN6r4v1SQtCGSCR4NPu1nieEglpkpYiY7KttE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNttvDrJIU5EomMS_ptIVZfdr6Mnw73_NkNvD2azt4kg&oe=6B0B459B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Creed: Rise to Glory - Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "cont
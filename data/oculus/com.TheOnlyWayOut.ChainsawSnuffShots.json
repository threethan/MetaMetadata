&oe=6AFDE4DE"}, {"file_name": "Bez-n\u00e1zvu-1_0004_5.png", "id": "1184683170069780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312401_1184683173403113_1561051355017769369_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osYpKJhDJhgQ7kNvwGngoOY&_nc_oc=AdpYH-RA-5i3pu9pU7VsV7CrQuzS1HvFDRL7syePIBs9dzOJUMJuGbJBhtcDJAaRzCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRye-bK5GxS313QovmgMDrgc-tcagAlpO0GEU-RJ8wISQ&oe=6AFDB170"}, {"file_name": "Bez-n\u00e1zvu-1_0008_1.png", "id": "732512702540089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830460_732512705873422_1033820181828734633_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpqpk9xPEZ0Q7kNvwE36D2r&_nc_oc=AdqN1JCVUy6r4OMvKIX4pMJHDXtXV_DF1uTJpOxNBm3mwfgIl31gatvo3cI0cmEReag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG5ZlIlqan6eDIa_l_AWxYqIyKP-K7ZccloC_B6wVYPg&oe=6AFDC3AB"}, {"file_name": "Bez-n\u00e1zvu-1_0007_8.png", "id": "1180778763826203", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499335497_1180778770492869_4870207745196420608_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ow2lGB-ZlAQ7kNvwHS6pke&_nc_oc=AdqOqIqBkTVN0_FJwdJTTZTCrb-rCLrA6m2gO-HQwq91tFZZPtFpPcZASetaxzaeL3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFSepgi7pDrML6Xa4v7_7QoakbJX0f3sT3rCLlIjfyAQ&oe=6AFDE39B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chainsaw Sn*ff Shots", "keywords": ["vr", "css", "ChainsawSnuffShots"], "long_description": "Trapped in a deranged killer\u2019s domain, you must outsmart the nightmare. The chainsaw-wielding psycho hears everything\u2014every step, every breath. Use tools, stealth, and your wits to survive. One wrong move, and the hunt begins. Will you escape, or become another gruesome trophy?\n\nThe madman never sleeps. He hears the creak of the floorboards, the rustle of your clothes\u2014even your heartbeat. Scavenge tools, hide in the shadows, and pray he doesn\u2019t find you first. In this hell, silence is survival.\n\n\n\nKey Elements\n\n\nThe enemy reacts to any sound, so you have to be careful to be quiet, or at least hide in time.\n\nWith a camera, you can see better than the person who is hunting you, but you often need to recharge it or look for new batteries.\n\nInstead of a classic escape, the game will also offer side secrets or hiding places for new tools to use.\n\nThe game will also have multiple endings depending on how much you explore, find new places or ways to defend yourself or progress further.", "short_description": "Trapped in a deranged killer\u2019s domain, you must outsmart the nightmare. The chainsaw-wielding psycho hears everything\u2014every step, every breath. Use camera, tools, stealth, and your wits to survive. One wrong move, and the hunt begins. Will you escape, or become another gruesome trophy?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/a6e09633-ac52-4bb4-a6a1-72b3759fd9f4", "developer_terms_of_service_url": null, "publisher_name": "The game contains scary scenes and a horror environment.", "support_website_url": null, "website_url": "https://www.youtube.com/@towodev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_mode
fyAQ&oe=6AFDE39B"}, {"file_name": "Bez-n\u00e1zvu-1_0000_Image-Sequence-(1)_024_0000.png", "id": "1674695776702044", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303976_1674695780035377_3099606608143063842_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ytWUQFfm4IQ7kNvwEKODo-&_nc_oc=Adp8bmdBO928_DPdESrB9mW1z1VppvV2Ho9P2CaeIVg3YF1Tp4mt_KSsPqWpJ3AsXuk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmCiC1ju7qSxERMhlPbsQzNhY01vZiyik5dqkQMQP3iA&oe=6AFDB249"}, {"file_name": "Bez-n\u00e1zvu-1_0003_4.png", "id": "1985109535591126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299808_1985109538924459_3315362642904556923_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cg1RV4SsJeYQ7kNvwFD3Mab&_nc_oc=AdpUB5gGCQnf779isie4Nz2fp3yWyk2TVRbbtX42Q-8dsehoqljdnppwpXpeUIYb_jE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsVsuat8sJU02vbpQ418gbetENF1NkXQqUdhIbp52hCA&oe=6AFDCDA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-1.png", "id": "1128869353215563", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604293968_1128869356548896_2742063807569109245_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_UMLTx4w_QQ7kNvwFeENPl&_nc_oc=Adr--0rhqWvEVGf2T1Ho9glmausU3Y7M24MJz7u19jCc2S3ZuNvOmYOv6eThn9xfPlI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh6wrGG1_0LnMuFJpw6fKGAJK5np82NgPwrrlywGFmMw&oe=6AFDC8B7"}, "display_name": "The Last Escape", "keywords": ["the", "last", "escape", "thelastescape", "horror"], "long_description": "Trapped in a deranged killer\u2019s domain, you must outsmart the nightmare. The chainsaw-wielding psycho hears everything: every step, every breath. Use tools, stealth, and your wits to survive. One wrong move, and the hunt begins. Will you escape, or become another gruesome trophy?\n\nThe madman never sleeps. He hears the creak of the floorboards, the rustle of your clothes: even your heartbeat. Scavenge tools, hide in the shadows, and pray he doesn\u2019t find you first. In this hell, silence is survival.\n\nYou can also play Puzzle Mode without the killer. Make sure to escape before time runs out.\n\nKey Elements\n\nThe enemy reacts to any sound, so you have to be careful to be quiet, or at least hide in time.\n\nWith a camera, you can see better than the person who is hunting you, but you often need to recharge it or look for new batteries.\n\nInstead of a classic escape, the game will also offer side secrets or hiding places for new tools to use.\n\nThe game will also have multiple endings depending on how much you explore, find new places or ways to defend yourself or progress further.", "short_description": "Trapped in a deranged killer\u2019s domain, you must outsmart the nightmare. The chainsaw-wielding psycho hears everything: every step, every breath. Use camera, tools, stealth, and your wits to survive. One wrong move, and the hunt begins will you escape, or become another gruesome trophy?\n\nYou can also play Puzzle Mode without the killer. Make sure to escape before time runs out."}]}, "developer_name": "TheOnlyWayOut", "developer_privacy_policy_url": "https://sites.google.com/view/theonlywayout-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Venzo Labs", "support_website_url": null, "website_url": "https://www.youtube.com/@towodev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
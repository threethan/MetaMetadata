.com&_nc_ss=7f20f&oh=00_AQSiPxzCZs93pbLBJZXIrC1pGne2boKAJZMrPEtWFutpLg&oe=6AEB4EAB"}, {"file_name": "Bez-n\u00e1zvu-1_0007_8.png", "id": "1180778763826203", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499335497_1180778770492869_4870207745196420608_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FBZvSJifvYQ7kNvwGZIVG0&_nc_oc=AdqmX_04EbfELq3zBfqtCVzpWajAUA4AUZ3Un4JWZnMzGYu5_oNsiFU1wT2V_CE5_y4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIluiSx4nkDk6kVcmEz6m1vAfXS6YERz7VGyAdvTq5SA&oe=6AEB365B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chainsaw Sn*ff Shots", "keywords": ["vr", "css", "ChainsawSnuffShots"], "long_description": "Trapped in a deranged killer\u2019s domain, you must outsmart the nightmare. The chainsaw-wielding psycho hears everything\u2014every step, every breath. Use tools, stealth, and your wits to survive. One wrong move, and the hunt begins. Will you escape, or become another gruesome trophy?\n\nThe madman never sleeps. He hears the creak of the floorboards, the rustle of your clothes\u2014even your heartbeat. Scavenge tools, hide in the shadows, and pray he doesn\u2019t find you first. In this hell, silence is survival.\n\n\n\nKey Elements\n\n\nThe enemy reacts to any sound, so you have to be careful to be quiet, or at least hide in time.\n\nWith a camera, you can see better than the person who is hunting you, but you often need to recharge it or look for new batteries.\n\nInstead of a classic escape, the game will also offer side secrets or hiding places for new tools to use.\n\nThe game will also have multiple endings depending on how much you explore, find new places or ways to defend yourself or progress further.", "short_description": "Trapped in a deranged killer\u2019s domain, you must outsmart the nightmare. The chainsaw-wielding psycho hears everything\u2014every step, every breath. Use camera, tools, stealth, and your wits to survive. One wrong move, and the hunt begins. Will you escape, or become another gruesome trophy?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/a6e09633-ac52-4bb4-a6a1-72b3759fd9f4", "developer_terms_of_service_url": null, "publisher_name": "The game contains scary scenes and a horror environment.", "support_website_url": null, "website_url": "https://www.youtube.com/@towodev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9851155494937495"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1222828212389912"}, {"status": "PUBLISHED", "id": "711186154985129"}, {"status": "PUBLISHED", "id": "2088944741602300"}, {"status": "PUBLISHED", "id": "1762657547996905"}, {"status": "PENDING", "id": "1807749870182241"}, {"status": "PUBLISHED", "id": "2308425299606910"}, {"status": "CANCELLED", "id": "850413574097931"}, {"status": "PUBLISHED", "id": "1309991520740829"}]}, "baseline_offer": {"id": "2308425299606910"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1807749870182241"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24759347927025007", "version": "1.2.3"}, "id": "1041036050972264", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": 
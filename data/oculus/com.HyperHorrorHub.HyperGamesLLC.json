es something out there.. Don't Get Caught."}]}, "developer_name": "Hyper", "developer_privacy_policy_url": "https://docs.google.com/document/d/1rVaCvb6ct6CIy1-_SRd99pjqx-h67LNUooY1UxIhJ7g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Hyper Games", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1O_Lr4jORd5JYUIVmm_hRAy4pFtqUkoo_83S94ynkjNc/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "30201342252815041"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491820983_686623534221442_171524266749271366_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3eY2XaC0b4Q7kNvwFBqT2k&_nc_oc=AdochypcTha3EB39MTqDg1w670c4NAauy2X9DTcrx5fiUUGKKT6n2nddn5g-hFm-t10&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgtizuacvA4zDv5YFfnEzIEAr4gWcy0-m7yeyj3WsZwA&oe=6AA401A2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hyper's Gorilla Horror", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Strategy", "id": "275
AQSNiSz4KBArLd8TN_2kfbP_0UKRFk8SWeYOX6XFTvy2yA&oe=6B09B7E5"}, {"file_name": "bigger (4).png", "id": "265652726490981", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566692_265652729824314_5695845829740283875_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5juJvmY9YjYQ7kNvwGdF63Q&_nc_oc=AdqCz8dW5jCAsu5sVngev9J2dXnJ-otrVZE-uid_5kzg12ecJ-9mKeg2zUo_uXZ1byE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1qHbxwqKpWfDGSM3TtQjayWH3Js2KHh_o4AKLkOcdhg&oe=6B09C307"}, {"file_name": "bigger (5) - Copy.png", "id": "308835395448259", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974713_308835398781592_6606322769711002305_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xJ4uh_alxsQ7kNvwFTfCbY&_nc_oc=Adp5EccoIQfoAcu-EJn_e477MuJQ0YPFhjRRCPMuYajJ9dWN9FDhsGh6XaQn__GqlOg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTloDL4r0cVvT3izlz6dwuaJmb41-2AzF2ja1pL6whjNw&oe=6B09AEFF"}, {"file_name": "bigger (1).png", "id": "1763623760777555", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75422385_1763623764110888_1043137388471848513_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyoUuDe7y5IQ7kNvwE9fhBG&_nc_oc=Adofm-lBWdWwotd_a-Af-1mf54NM5ym2vzFmkPpL1Qaz_pNQ6sGgrSoy-89WKAO6AH0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST8oROAhUS-8GUC2LnsqSMwh1qPQO-rMzLMzXxoQIxhQ&oe=6B09CCF7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpos", "keywords": [], "long_description": "Step into the immersive world of Chimpos VR, a cutting-edge virtual reality game that brings the excitement of tag to a whole new level! In this thrilling experience, players find themselves in a vibrant virtual jungle, taking on the role of mischievous chimps with a unique twist \u2013 the game allows you to either be the tagger or try to evade being tagged! \n\nEmbark on an adventure where speed and strategy are key. As the tagger, unleash your pursuit skills to catch your fellow chimps, utilizing the immersive VR environment to outmaneuver and tag them before they escape. On the flip side, if you're the one being chased, employ clever tactics to outwit your pursuer and navigate through the dense virtual foliage. \n\nBut the excitement doesn't end there! Customize your chimp avatar with a variety of stylish cosmetics \u2013 don a suave tophat, wield a colorful popsicle, and more. The possibilities are as endless as the jungle itself, allowing you to express your unique personality in the whimsical world of Chimpos VR.\n\nWhether you're a VR gamer or a newcomer to the virtual realm, Chimpos VR offers an exhilarating experience for players of all levels. So, gear up, and get ready for an unforgettable adventure where the jungle comes alive with the laughter and excitement of Chimpos VR!", "short_description": "Run away from the silly chimp taggers, or tag other chimps! All in Chimpos VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimposvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "coleorsmth", "support_website_url": null, "website_url": "https://sites.google.com/view/chimposvr/home?authuser=0", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6779173002165619"}}]}, "scheduled_offers":
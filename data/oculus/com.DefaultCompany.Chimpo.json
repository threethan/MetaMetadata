305_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVJ2e7JZ_ZUQ7kNvwHeNJWG&_nc_oc=AdkvD15qyzsMdNSSt5JZIwpLHcdXUMR_zDih2sK4qBkjMx6GhUsUWmHRHi37jIEGLBQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7Si4rN9yc-SsnRBMOlgkWdKKgCFrSQFZipM5hgC2vag&oe=69BA99BF"}, {"file_name": "bigger (1).png", "id": "1763623760777555", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422385_1763623764110888_1043137388471848513_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUgMFPREZIIQ7kNvwGTfPD5&_nc_oc=Adlu8BuMi5TgRhRUE-N0E80jPT6_jsIiPt1VHFGOlZPihAB1gzIW3_Y9bALo1tXswTE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwt8d4HMnTMNKX20rK3iPLSTFKHSQTinP_LVehu0uuAxA&oe=69BAB7B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpos", "keywords": [], "long_description": "Step into the immersive world of Chimpos VR, a cutting-edge virtual reality game that brings the excitement of tag to a whole new level! In this thrilling experience, players find themselves in a vibrant virtual jungle, taking on the role of mischievous chimps with a unique twist \u2013 the game allows you to either be the tagger or try to evade being tagged! \n\nEmbark on an adventure where speed and strategy are key. As the tagger, unleash your pursuit skills to catch your fellow chimps, utilizing the immersive VR environment to outmaneuver and tag them before they escape. On the flip side, if you're the one being chased, employ clever tactics to outwit your pursuer and navigate through the dense virtual foliage. \n\nBut the excitement doesn't end there! Customize your chimp avatar with a variety of stylish cosmetics \u2013 don a suave tophat, wield a colorful popsicle, and more. The possibilities are as endless as the jungle itself, allowing you to express your unique personality in the whimsical world of Chimpos VR.\n\nWhether you're a VR gamer or a newcomer to the virtual realm, Chimpos VR offers an exhilarating experience for players of all levels. So, gear up, and get ready for an unforgettable adventure where the jungle comes alive with the laughter and excitement of Chimpos VR!", "short_description": "Run away from the silly chimp taggers, or tag other chimps! All in Chimpos VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimposvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "coleorsmth", "support_website_url": null, "website_url": "https://sites.google.com/view/chimposvr/home?authuser=0", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6779173002165619"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "330773156240829"}]}, "baseline_offer": {"id": "330773156240829"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1701123984, "status": "PUBLISHED", "id": "330773156240829"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7435458243203755", "version": "0.8"}, "id": "636733355041126", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6779172988832287", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinar
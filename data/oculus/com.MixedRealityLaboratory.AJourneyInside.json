GeDEhy79bo1IwbE6raulDgtBB6Ym3R4tbcFwy5Bxnw&oe=69AD8614"}, "display_name": "A Journey Inside", "keywords": [], "long_description": "This app requires you to lie on your back.\nIt is designed for experiencing in a gallery, supported by an invigilator, however if you intend to try it at home:\n\nSit up first, Recenter your view, then lie back and press A on the controller and enjoy.\nYou can press B to reset to the beginning.\nIf you need to experience it seated, you can use C to switch to accessible mode.\nThe experience lasts for around six minutes.\n", "short_description": "A Virtual Reality Poetry Experience by Lytisha Tunbridge"}]}, "developer_name": null, "developer_privacy_policy_url": "http://paultennent.co.uk/utility/PrivacyPolicy-AJourneyInside.txt", "developer_terms_of_service_url": null, "publisher_name": "Mixed Reality Laboratory", "support_website_url": null, "website_url": "https://www.nottingham.ac.uk/research/groups/mixedrealitylab/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "818264876380866"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982563_1021645965665990_1004027455445836091_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvcPr0T9al4Q7kNvwEL876y&_nc_oc=AdlpdWfT63X_-I8UGmkcKYVU0DR-7coF666x8EQ4k7GYXrLhLcQW1z8K7JUySrWAhRE&_nc_zt=3&_nc_ht=scontent-ams2-
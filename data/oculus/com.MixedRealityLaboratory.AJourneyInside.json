t 18.35.45.png", "id": "801217975080707", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75395596_801217978414040_4203367446114383156_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3j2Fp_71NDcQ7kNvwFZruGg&_nc_oc=AdpXlYwL-JIK1-j1cHqRJYtLNm2e0e4wAC56rSgqncb00FUe5tFZwIFlfVI_iRcShZA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxkqmy34-nEkX9mZPiW1Fyarhi2dPrcoF5aVxkA_0wOA&oe=6B09CA54"}, "display_name": "A Journey Inside", "keywords": [], "long_description": "This app requires you to lie on your back.\nIt is designed for experiencing in a gallery, supported by an invigilator, however if you intend to try it at home:\n\nSit up first, Recenter your view, then lie back and press A on the controller and enjoy.\nYou can press B to reset to the beginning.\nIf you need to experience it seated, you can use C to switch to accessible mode.\nThe experience lasts for around six minutes.\n", "short_description": "A Virtual Reality Poetry Experience by Lytisha Tunbridge"}]}, "developer_name": null, "developer_privacy_policy_url": "http://paultennent.co.uk/utility/PrivacyPolicy-AJourneyInside.txt", "developer_terms_of_service_url": null, "publisher_name": "Mixed Reality Laboratory", "support_website_url": null, "website_url": "https://www.nottingham.ac.uk/research/groups/mixedrealitylab/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
-vuxZwdEgQ7kNvwFZSR-b&_nc_oc=AdoNUyXO5KGervgQGdbRtRcQszMwOONwLXj0VBLLHOXHUigh6-MggaVCY-qBCqUgsWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOrJ6esBZiBdHdONJU2g3ykO2VUWaqifu32jzB5HWdHw&oe=6B0060AC"}]}, "id": "2037764473601517", "locale": "en_US", "screenshots": [{"file_name": "CEBUS MiniGolf-7-SC2 2560x1440.png", "id": "2898166337199752", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295661_2898166340533085_6797391979187378109_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfamrTIzSIUQ7kNvwEZEkfG&_nc_oc=AdoJGPz6feTabrCqeE0yCRPHnwmDc5A7qYpWn9RnjWn0LW47NQ39z9hnIhey820uZGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShswuIktFRrz_nmlXAbdWWe74XlajYhZO1MRXLsRNCZQ&oe=6B0088D3"}, {"file_name": "Untitled-6-SC1_2560x1440.png", "id": "710873975262138", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827725_710873978595471_4844635543382100909_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEcp035iQYQQ7kNvwHJWzKv&_nc_oc=AdpFZ9WTYsdBzt06yniuO_xnZPi4vKhWr1r5WxPxIVAFaJkZM0cJVkDIuH9ZHBPmiJA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcPnB4LVizpS26qNK3GpJIP96hcwowMXnG9Q2rZgv52g&oe=6B0083C1"}, {"file_name": "Untitled-9-SC4_2560x1440.png", "id": "24284559741203341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827703_24284559747870007_1728458674463017053_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hM-AA4thUS0Q7kNvwE54cfK&_nc_oc=AdrwyuoYGAknDvWSgQoeBBN_XmqaxheXOwhOa2JbI5M5SAfLZyAPbwN-ttnM1PmXxSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFVj6nN1GVeYOwh1FDqg8gdSWqoriefYnOjUo0lMhYIw&oe=6B0067C2"}, {"file_name": "Untitled-8-SC3_2560x1440.png", "id": "4148687502078455", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830021_4148687505411788_2130807848854402687_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fpkgz3vrhhEQ7kNvwE1fLHu&_nc_oc=AdpFuGZPW8Nj9OgVONId17SgB-XmYJctg2_3D_7gbRJKdqvyOUKn33M_7BQ1R5TpKs8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLbNaVom0wIEQh6dHwUj7_eR1av3RV0tE73ftTAb0GUQ&oe=6B0086FD"}, {"file_name": "Untitled-10-SC5_2560x1440.png", "id": "2163063214163227", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825050_2163063217496560_3945081202565340583_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSumRkAEn00Q7kNvwGGNoBB&_nc_oc=Adp-ufHfflSCnWVa0mvsv-U6G-e0CXYcCGFVtnNEn_7acS4hR71KITOFNKwyD-QRQo0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpt058VwpsMptsmBEiaErVrsrwfESBALJattSb9YosXw&oe=6B007F85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Thumbnail (2560 x 1440 px).png", "id": "1067554828799111", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831382_1067554832132444_1820042300100226778_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVfoLu7NtNoQ7kNvwFQi3dB&_nc_oc=Adqw3TKYyx0Mv2-zo2RiEDaTngypyvGwmXqw3LZ38TMHqS6Aq4zzpEKtiLoa_6wHMSo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJr5cQzTIkqQzB83DN16pdK5F5ZemWZktjJyCs9GPFdw&oe=6B005F59"}, "display_name": "Cebus", "keywords": ["monkey", "tag", "multiplayer", "horror", "onlyup"], "long_description": "**Join our Discord for news, sneak peeks, and community: https://discord.gg/rwCWTW3xuJ**\n\n# Explore Different Worlds\n\nEvery map brings a different way to move and play.\n\n- **Forest** \u2014 Climb through the trees and find your own routes.\n- **Ice Map** \u2014 Slide across slippery terrain and control your momentum.\n- **Cloud Map** \u2014 Bounce your way through a world in the sky.\n- **Beach Map** \u2014 Slow down, explore, and hang out with friends.\n- **Zero Gravity Map** \u2014 Leave the ground behind and float through zero gravity.\n\n# Take On the Game Modes\n\n- **Lazer Maze** \u2014 Dodge moving lasers and put your timing to the test.\n- **Glass Bridge** \u2014 Choose your panels carefully. The wrong one sends you falling.\n- **Only Up** \u2014 Climb a vertical parkour course where one fall resets your progress.\n- **Horror** \u2014 Explore dark areas filled with suspense and surprises.\n\n# Make Your Cebus Your Own\n\nMeet up at the **Mall**, visit the **Shop**, and unlock cosmetics and tools to change your look and how you play.\n\n- **Size Changer** \u2014 Shrink or grow your Cebus.\n- **Grappling Hook** \u2014 Hook on and swing across levels.\n- **Mod Menu** \u2014 Try fun in-game extras and settings.\n\nMaster a tricky climb, race friends to the top, or hang out and show off your style. How you spend your time in Cebus is up to you.", "short_description": "Run, climb, and swing with your arms in Cebus, a multiplayer VR playground full of gamemodes like mini golf, only up, horror, pvp, lazermaze, rock climbing and so much more"}]}, "developer_name": null, "developer_privacy_policy_url": "https://villanstudios.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sora_vr", "support_website_url": null, "website_url": "https://villanstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29653398707590517"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499626806_221136813608938
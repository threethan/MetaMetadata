 "1110331655244965", "image_type": "APP_IMG_ICON_FOREGROUND_512", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619602_1110331661911631_9134180739597739341_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkRFhE_TpDAQ7kNvwF3_mod&_nc_oc=Adr00duzjEp69Q3dLMCGp4Kgu9m96enttTMGWCR6oXXP-pAH-C98itKj3F9n0WrQqog&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRijCQjQBr9DcDg7PXDO2OIi6XwyA-IMzq0jh5CD_ni1Q&oe=6B099B2C"}]}, "id": "2037764473601517", "locale": "en_US", "screenshots": [{"file_name": "CEBUS MiniGolf-7-SC2 2560x1440.png", "id": "2898166337199752", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295661_2898166340533085_6797391979187378109_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvgL6FeDPmQQ7kNvwFs5o8A&_nc_oc=AdqKKx42tk7SG1mjhluhm289tycz4AOfu3st4oRPRPkcvIKAyue_jRuvbFeFnoqSm40&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXNOBM3O4OsOtL8p16Ar5Sg_EuQ3Igu0bIIB9xp8AhtQ&oe=6B09C353"}, {"file_name": "Untitled-6-SC1_2560x1440.png", "id": "710873975262138", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827725_710873978595471_4844635543382100909_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKSz-qKZVtYQ7kNvwFjPfFa&_nc_oc=AdqLW66stKSTi8I72joSYufF5k6rHUZr5bNpQYbotJGoUXbPoW7VUOfj3OWaJa_bq2Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaTnkUhQwydoVcYLbvMMJKxnoDIhNmTyMhgV_jFZh5iA&oe=6B09BE41"}, {"file_name": "Untitled-9-SC4_2560x1440.png", "id": "24284559741203341", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827703_24284559747870007_1728458674463017053_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKXa2v2_bR4Q7kNvwEssQzl&_nc_oc=AdqY9iihHBGG8dQIdfmAK7Q2MlC0ZIpWBCiuGy1KPOVzGacwSbcppw7NLkwA3m8EmbU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTUpLAav2OazdX4ZOoddf0LOjUIl0N2fKUNa8cCjR-1Q&oe=6B09A242"}, {"file_name": "Untitled-8-SC3_2560x1440.png", "id": "4148687502078455", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830021_4148687505411788_2130807848854402687_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeZDTISNDKoQ7kNvwHV3vkP&_nc_oc=Adp3TXLadcYSi6B9wh4ciZOdluDpE10x4pQNEDfPPIJ7QLRd_5BVOzaDFfwlH7MWDeY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgunM5G77HLBcWqUBXxBGjP10qFcTGCuxivvpE3dWUNA&oe=6B09C17D"}, {"file_name": "Untitled-10-SC5_2560x1440.png", "id": "2163063214163227", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491825050_2163063217496560_3945081202565340583_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szdRXY0ARJ8Q7kNvwGvKjmv&_nc_oc=AdpEWmGXbP1IKZhX103tKUy1S2JaXgZ0ivTEMwnoF7s13tqhEId3o7jEYoOODeTc_lI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkxWLVUYaXrG1CFNsP2lmyK79elSypazsBqdjvgnZrKg&oe=6B09BA05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Thumbnail (2560 x 1440 px).png", "id": "1067554828799111", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831382_1067554832132444_1820042300100226778_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHKe9fJveeQQ7kNvwEO2gHr&_nc_oc=AdqM4_0PuwZUUTMokjZtUfP_cooqS04dZVWx1B1IXT4bQj7l82SzqytUrTicNLRskDw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKXxKoRv12RmdCRGYOsph2KxVlmjZEijnxhkovjS5FCw&oe=6B0999D9"}, "display_name": "Cebus", "keywords": ["monkey", "tag", "multiplayer", "horror", "onlyup"], "long_description": "**Join our Discord for news, sneak peeks, and community: https://discord.gg/rwCWTW3xuJ**\n\n# Explore Different Worlds\n\nEvery map brings a different way to move and play.\n\n- **Forest** \u2014 Climb through the trees and find your own routes.\n- **Ice Map** \u2014 Slide across slippery terrain and control your momentum.\n- **Cloud Map** \u2014 Bounce your way through a world in the sky.\n- **Beach Map** \u2014 Slow down, explore, and hang out with friends.\n- **Zero Gravity Map** \u2014 Leave the ground behind and float through zero gravity.\n\n# Take On the Game Modes\n\n- **Lazer Maze** \u2014 Dodge moving lasers and put your timing to the test.\n- **Glass Bridge** \u2014 Choose your panels carefully. The wrong one sends you falling.\n- **Only Up** \u2014 Climb a vertical parkour course where one fall resets your progress.\n- **Horror** \u2014 Explore dark areas filled with suspense and surprises.\n\n# Make Your Cebus Your Own\n\nMeet up at the **Mall**, visit the **Shop**, and unlock cosmetics and tools to change your look and how you play.\n\n- **Size Changer** \u2014 Shrink or grow your Cebus.\n- **Grappling Hook** \u2014 Hook on and swing across levels.\n- **Mod Menu** \u2014 Try fun in-game extras and settings.\n\nMaster a tricky climb, race friends to the top, or hang out and show off your style. How you spend your time in Cebus is up to you.", "short_description": "Run, climb, and swing with your arms in Cebus, a multiplayer VR playground full of gamemodes like mini golf, only up, horror, pvp, lazermaze, rock climbing and so much more"}]}, "developer_name": null, "developer_privacy_policy_url": "https://villanstudios.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sora_vr", "support_website_url": null, "website_url": "https://villanstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": 
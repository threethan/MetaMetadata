PA-gplYS0nxi157Wj3B4w&oe=6A636901"}, {"file_name": "Untitled-9-SC4_2560x1440.png", "id": "24284559741203341", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827703_24284559747870007_1728458674463017053_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7P1hauH-M0Q7kNvwEIFg9D&_nc_oc=AdpNd8Q86t_gYitSn1RRAgQ-DTPmOtCdkuLtfI-RlSJkGsTyG2EvLkY3U40tA41AntM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCFVgVkBWOSo2fqgSmVOsCevtprvAwlozz2nECNiW4MA&oe=6A638542"}, {"file_name": "Untitled-8-SC3_2560x1440.png", "id": "4148687502078455", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830021_4148687505411788_2130807848854402687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIxje0CidusQ7kNvwGFSsta&_nc_oc=AdrqkDAKAD59XlmVai7Fs824Xto97D060oP74b9tAclEZHNIzS3IgVXR97UGTY32jEs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWhjjcUiVUjYqwc-JwKWSkX1Kc0qWA-vQtBVl66dUuXw&oe=6A636C3D"}, {"file_name": "Untitled-10-SC5_2560x1440.png", "id": "2163063214163227", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825050_2163063217496560_3945081202565340583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oG4xFzB0l2MQ7kNvwFsS9OP&_nc_oc=Ador7tUlnReg2GGIAv4jJV8LvSW-0JWUEx8K1NhEfCjHCrknmejIU-xpiVFx1KYvXi8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZEPy7MMXNw6x71krqj5R2RTL9J-0ggida43Qyrdg1hQ&oe=6A6364C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Thumbnail (2560 x 1440 px).png", "id": "1067554828799111", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491831382_1067554832132444_1820042300100226778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Et4ChFpp7lcQ7kNvwGSDE6t&_nc_oc=AdpQvCHTSSxxEh0omCuch6wrSQfhz0LrvHDq82lcOb3flssz6cDEvoqyXs__VR4WM6g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAQC2J8yMe1t08fVQjBwjvNw2lLoo3bmDVyO-9Dsthuw&oe=6A637CD9"}, "display_name": "Cebus", "keywords": ["monkey", "tag", "multiplayer", "horror", "onlyup"], "long_description": "**Cebus** is a fast-paced **multiplayer** VR game where you play as a creature called a Cebus, moving with full **arm-based motion**. Run, jump, climb, and swing through unique, challenging maps \u2014 each with its own style and mechanics. Explore the Forest, slide across the Ice Map, bounce through the Cloud Map, chill on the Beach Map, or float through the Zero Gravity Map. **Play solo or jump in with friends.**\n\n## Game Modes\n\n- **Lazer Maze** \u2014 Dodge moving lasers in a skill-based obstacle course\n- **Glass Bridge** \u2014 Step carefully or fall through the wrong panel\n- **Only Up** \u2014 A vertical parkour climb where one fall resets your progress\n- **Horror** \u2014 Navigate dark, suspenseful areas filled with fear and surprises\n\n## Customize Your Cebus\n\nVisit the **Mall**, the social hub where you unlock cosmetics and tools at the Shop:\n\n- **Size Changer** \u2014 shrink or grow your Cebus\n- **Grappling Hook** \u2014 swing across levels with ease\n- **Mod Menu** \u2014 fun in-game extras and settings\n- And many more upgrades\n\nWhether you're mastering movement, racing friends to the top, or showing off your style, **Cebus** offers nonstop fun and freedom.\n", "short_description": "Cebus is a fast-paced multiplayer VR game where you run, climb, jump, and swing as a monkey-like creature using full arm-based movement. Play with friends across maps like Forest, Ice, Cloud, Beach, and Zero Gravity. Jump into modes including Lazer Maze, Glass Bridge, Only Up, and Horror. Visit the Mall to customize your Cebus with cosmetics, a size changer, and a grappling hook. Master movement, explore freely, and stand out in the world of Cebus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://villanstudios.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sora_vr", "support_website_url": null, "website_url": "https://villanstudios.com/", "category": null, "comfort_rating": 
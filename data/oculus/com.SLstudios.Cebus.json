Golf-7-SC2 2560x1440.png", "id": "2898166337199752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295661_2898166340533085_6797391979187378109_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcajYa3dIW0Q7kNvwHICAOH&_nc_oc=AdqPON7ZNi2BAT-0FsEEXOSKr-hjx6IEo_rjrnoudYnSSerDKE9vdOW9HICtX0Hd2uQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0dZ-ckuEV6YCg8eiix-ll1iVAwKr0foShWzCfm1MD-w&oe=6AF89FD3"}, {"file_name": "Untitled-6-SC1_2560x1440.png", "id": "710873975262138", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827725_710873978595471_4844635543382100909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwgLJylmYQIQ7kNvwHUdZho&_nc_oc=AdrL8_EoEtG5jJxrn-pBJwpcbDD3gMjtTl8mDyCXTW-zOm3NsTPgSzlheQibLiN8z6E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6aybu0wJ3Vig_xudER5snhWRALjhtrL8ZPGtrfKhskA&oe=6AF89AC1"}, {"file_name": "Untitled-9-SC4_2560x1440.png", "id": "24284559741203341", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827703_24284559747870007_1728458674463017053_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hGSa1oQuOMQ7kNvwEa25qf&_nc_oc=AdqKRQsKKaAU64mO3pYHylTxMcVcblMZ6jeYp7T6sBy8cMxf3o8TzHGecz4GygK1qyI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqYYBjinSj8lKXM5DaWnjJQr8Y58SYNl5kcK0VsGxS4g&oe=6AF87EC2"}, {"file_name": "Untitled-8-SC3_2560x1440.png", "id": "4148687502078455", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830021_4148687505411788_2130807848854402687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpwedpkD2TgQ7kNvwEZ-xBo&_nc_oc=Adpv3yKVQU6JQJPYNT_sbNHXcq5Ga510zROebHkcavCOQIfcrzqPqcPFjd9UbRoqRvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO3aNucfnzlivwmP2ao3v2R0R6ocdS48DBGLon_P2slg&oe=6AF89DFD"}, {"file_name": "Untitled-10-SC5_2560x1440.png", "id": "2163063214163227", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825050_2163063217496560_3945081202565340583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hJBedhfzKoQ7kNvwG82bex&_nc_oc=AdpZUAGzUNe0pIC0BMkt2x2C3VetGyQ-dsdynM14BIgfClQ6HGwKrn2gNRaZ0Gi8Kww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1rNj-azdIPZJJG3ehSShPFSeYwtkTAEjjn4HHRzV0PA&oe=6AF89685"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Thumbnail (2560 x 1440 px).png", "id": "1067554828799111", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831382_1067554832132444_1820042300100226778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHAoqlj8Yw4Q7kNvwHx0w6j&_nc_oc=Adq8Q9MV76YHvOBHhdmXwEy89s9WaOp4sxL3ymfEQacnX0xEiVl5gSgZYjz4k9DnWJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpspqdXqVwR2gFmSSNIgu_bw1KC68dVSlKqAF4juIyjA&oe=6AF87659"}, "display_name": "Cebus", "keywords": ["monkey", "tag", "multiplayer", "horror", "onlyup"], "long_description": "**Join our Discord for news, sneak peeks, and community: https://discord.gg/rwCWTW3xuJ**\n\n# Explore Different Worlds\n\nEvery map brings a different way to move and play.\n\n- **Forest** \u2014 Climb through the trees and find your own routes.\n- **Ice Map** \u2014 Slide across slippery terrain and control your momentum.\n- **Cloud Map** \u2014 Bounce your way through a world in the sky.\n- **Beach Map** \u2014 Slow down, explore, and hang out with friends.\n- **Zero Gravity Map** \u2014 Leave the ground behind and float through zero gravity.\n\n# Take On the Game Modes\n\n- **Lazer Maze** \u2014 Dodge moving lasers and put your timing to the test.\n- **Glass Bridge** \u2014 Choose your panels carefully. The wrong one sends you falling.\n- **Only Up** \u2014 Climb a vertical parkour course where one fall resets your progress.\n- **Horror** \u2014 Explore dark areas filled with suspense and surprises.\n\n# Make Your Cebus Your Own\n\nMeet up at the **Mall**, visit the **Shop**, and unlock cosmetics and tools to change your look and how you play.\n\n- **Size Changer** \u2014 Shrink or grow your Cebus.\n- **Grappling Hook** \u2014 Hook on and swing across levels.\n- **Mod Menu** \u2014 Try fun in-game extras and settings.\n\nMaster a tricky climb, race friends to the top, or hang out and show off your style. How you spend your time in Cebus is up to you.", "short_description": "Run, climb, and swing with your arms in Cebus, a multiplayer VR playground full of gamemodes like mini golf, only up, horror, pvp, lazermaze, rock climbing and so much more"}]}, "developer_name": null, "developer_privacy_policy_url": "https://villanstudios.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sora_vr", "support_website_url": null, "website_url": "https://villanstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29653398707590517"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499626806_2211368136089382_5268929153364270355_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlkS3i9kQgYQ7kNvwH08xOV&_nc_oc=AdoOrBnTqEj_nSZy9M_eJ9zcCq9BH1jJtHcRnbnx968xrAJFy_mz9dEg2z5c50lmTuA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr-QAsmhwgbHmYe3GTDDv_JxvmqymN6aiNFrNP1KkrFA&oe=6AF8AADF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cebus", "platform": "ANDROID_6DOF", "context_category": {"conte
vC7GwYJVmG43dMWSARzdQiOjHq3lnQ&oe=69CD171E"}, {"file_name": "Untitled-9-SC4_2560x1440.png", "id": "24284559741203341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827703_24284559747870007_1728458674463017053_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJ-Uup_NFVMQ7kNvwHy8xrs&_nc_oc=Ado1IjMWRtYcygLHxivALYHIb9EVxTMjsrbxcav9f9Tb1VcSCZ-voYg9cXKLz8GO9s0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPHqS77jRLRH8xBTWP7-FW_oUqsGt2Z5vxM1quAxspEA&oe=69CD0202"}, {"file_name": "Untitled-8-SC3_2560x1440.png", "id": "4148687502078455", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830021_4148687505411788_2130807848854402687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TSSYYOVhVQQ7kNvwELHlpV&_nc_oc=AdpNgLVbGDBsrJh6cPUUsZ-NTPvoMbraQ9mlnepEx8dx4IxG65d0mRmF1GfOIs_cV8M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdHrPlTj0WP_wWbVIfxnKZEs-ou9LGUV3F7-C2-CzPiA&oe=69CD213D"}, {"file_name": "Untitled-10-SC5_2560x1440.png", "id": "2163063214163227", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825050_2163063217496560_3945081202565340583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PR8jj1CS7oQ7kNvwFyXmep&_nc_oc=AdqsyfRihvo7P2oETO9-LeRBy9i7yszdxrzNk-JQ0GY3qduiQc1XTYK61_dbOuNM5gM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_kVww6a2PzYGKRhBOMZjeOYc7WmyIqUxeShyx7GbAIg&oe=69CD19C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Thumbnail (2560 x 1440 px).png", "id": "1067554828799111", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831382_1067554832132444_1820042300100226778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=718Ma3uiST0Q7kNvwEnkB09&_nc_oc=Adq-oIHJfaQMpVfHerMyl9c4BPEYUt91tzeKaH9SWiOIbdttP13jPzn0MjbMH4dYgu8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyh_XKBjsFwLzcRzUc_UwXVKrSfN7_zkBEHDdbpUWYKag&oe=69CD31D9"}, "display_name": "Cebus", "keywords": [], "long_description": "Cebus is a VR Hand movement-based game where you play as a creature called a Cebus. Run, jump, climb, and swing your way through a variety of unique and challenging maps, each with its own style and mechanics. Explore the Forest, slide across the Ice Map, bounce through the Cloud Map, chill on the Beach Map, or float through space in the Zero Gravity Map.\n\nThe game features multiple thrilling game modes to test your reflexes and creativity:\n\nLazer Maze \u2013 Dodge moving lasers in a skill-based obstacle course\n\nGlass Bridge \u2013 Step carefully or fall through the wrong panel\n\nOnly Up \u2013 A vertical parkour challenge; one fall resets your progress\n\nHorror \u2013 Navigate dark, suspenseful areas filled with fear and surprises\n\nWhen you're not exploring or competing, visit the Mall, the social hub where you can fully customize your Cebus. Head to the Shop to unlock cosmetics and tools that change how you play and look. Get items like:\n\nMod Menus (for fun extras in game)\n\nSize Changer (shrink or grow your Cebus)\n\nGrappling Hook (swing across levels with ease)\n\nAnd many more fun upgrades\n\nWhether you're mastering movement or showing off your drip, Cebus offers nonstop fun and freedom.", "short_description": "Cebus is a fast-paced VR game where you play as a Cebus. Explore maps like Forest, Ice, Cloud, Beach, and Zero Gravity. Play modes like Lazer Maze, Glass Bridge, Only Up, and Horror. Visit the Mall to customize your Cebus with cosmetics and powerful tools like mod menus, a size changer, and a grappling hook. Master movement, explore freely, and stand out in the world of Cebus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://villanstudios.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sora_vr", "support_website_url": null, "website_url": "https://villanstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", 
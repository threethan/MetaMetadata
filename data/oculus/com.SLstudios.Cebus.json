Golf-7-SC2 2560x1440.png", "id": "2898166337199752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295661_2898166340533085_6797391979187378109_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcajYa3dIW0Q7kNvwFDa2eP&_nc_oc=Adr2LKwciL5OevX-LUk-64QIp4oKaXj6HXnnQG7mmhCMVubMerHtrbjMhyIUs__zFmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjLPKdPSlJ7Xd2EAJHmPLjtN7fGw5yTx0wJr3KkrrJ4g&oe=6AF71613"}, {"file_name": "Untitled-6-SC1_2560x1440.png", "id": "710873975262138", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827725_710873978595471_4844635543382100909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwgLJylmYQIQ7kNvwHlVuCe&_nc_oc=AdooZjd_oChoHaa1hnyPGA30gFATdP0QUE5l0wc_1Qt6W3xbgNXVKapR_XEyIAy0UC0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAKwOqUcuXUIoDjgDkjgQp10Wt9H3ewekNM2_pGIrOTw&oe=6AF74941"}, {"file_name": "Untitled-9-SC4_2560x1440.png", "id": "24284559741203341", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827703_24284559747870007_1728458674463017053_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hGSa1oQuOMQ7kNvwGSrwEN&_nc_oc=AdqdDLx4UL9opRpV9H8i0r4uCprfF62JAsCmpJL9r2Wxbh5UhKT1mtAWfx6L7XNWa2Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa1p3uH3gO0QnlYUhZAX0i6tEIgw4Z47EYDN1xs_bw9w&oe=6AF72D42"}, {"file_name": "Untitled-8-SC3_2560x1440.png", "id": "4148687502078455", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830021_4148687505411788_2130807848854402687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpwedpkD2TgQ7kNvwHc0Q9h&_nc_oc=AdroGjcGibC9YnONj--XFice9qJ2GA5ga0rh-BWF6dp2TnVGa8ULfajkkvo5Aj-Gc5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSsdn6a7mpnTnB4CzXo_FvJZYuioVjps5mjeyx6PqAbA&oe=6AF74C7D"}, {"file_name": "Untitled-10-SC5_2560x1440.png", "id": "2163063214163227", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825050_2163063217496560_3945081202565340583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hJBedhfzKoQ7kNvwFUda5c&_nc_oc=Adrcaj2a0uJicu4RJRWua0zsrq1T2lMOLIFdhcyqsrK9-ylXMA8_vMxoFFN4LkKmBHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQMoBPD9fKFbrMzh06LI0sdbK69btNZvrTmOyPEHXDkQ&oe=6AF74505"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Thumbnail (2560 x 1440 px).png", "id": "1067554828799111", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831382_1067554832132444_1820042300100226778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fguWBnH3xkQ7kNvwGGemnV&_nc_oc=AdoKPy_RLFqmJrk5GadVAZW_maNTWO1fFF3j5QHGtcyHP7bnVxtQ8ThLsSmYIhgOFN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3vdmGAv7aXE98jrF_XlTEBB8NFi9o40FYTKepjyp90w&oe=6AF724D9"}, "display_name": "Cebus", "keywords": ["monkey", "tag", "multiplayer", "horror", "onlyup"], "long_description": "**Join our Discord for news, sneak peeks, and community: https://discord.gg/rwCWTW3xuJ**\n\n# Explore Different Worlds\n\nEvery map brings a different way to move and play.\n\n- **Forest** \u2014 Climb through the trees and find your own routes.\n- **Ice Map** \u2014 Slide across slippery terrain and control your momentum.\n- **Cloud Map** \u2014 Bounce your way through a world in the sky.\n- **Beach Map** \u2014 Slow down, explore, and hang out with friends.\n- **Zero Gravity Map** \u2014 Leave the ground behind and float through zero gravity.\n\n# Take On the Game Modes\n\n- **Lazer Maze** \u2014 Dodge moving lasers and put your timing to the test.\n- **Glass Bridge** \u2014 Choose your panels carefully. The wrong one sends you falling.\n- **Only Up** \u2014 Climb a vertical parkour course where one fall resets your progress.\n- **Horror** \u2014 Explore dark areas filled with suspense and surprises.\n\n# Make Your Cebus Your Own\n\nMeet up at the **Mall**, visit the **Shop**, and unlock cosmetics and tools to change your look and how you play.\n\n- **Size Changer** \u2014 Shrink or grow your Cebus.\n- **Grappling Hook** \u2014 Hook on and swing across levels.\n- **Mod Menu** \u2014 Try fun in-game extras and settings.\n\nMaster a tricky climb, race friends to the top, or hang out and show off your style. How you spend your time in Cebus is up to you.", "short_description": "Run, climb, and swing with your arms in Cebus, a multiplayer VR playground full of gamemodes like mini golf, only up, horror, pvp, lazermaze, rock climbing and so much more"}]}, "developer_name": null, "developer_privacy_policy_url": "https://villanstudios.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sora_vr", "support_website_url": null, "website_url": "https://villanstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29653398707590517"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499626806_2211368136089382_5268929153364270355_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlkS3i9kQgYQ7kNvwHHnPhN&_nc_oc=AdoxH_fjxy9lFW6ZFa6qTJa6-gKf-BMwUdeSc4nx8PUV8jCiK4HG6ytkounWQBp3fQM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREgbJdbpwhChgO8x1tpycuGrytBhU5H6K7M03JMN-mkQ&oe=6AF7211F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cebus", "platform": "ANDROID_6DOF", "context_category": {"conte
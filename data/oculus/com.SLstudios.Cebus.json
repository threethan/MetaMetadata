UXqFB4O2CSx6WvEj7tl7g&oe=6A451681"}, {"file_name": "Untitled-9-SC4_2560x1440.png", "id": "24284559741203341", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827703_24284559747870007_1728458674463017053_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCY3hKuJfzUQ7kNvwHrV5LC&_nc_oc=Ado7ygagJDnr2KeYB0EpZm_M9-W9XUQc8oplcUaIHXKe_EtC5imXZ9CA0R5rCVh0iA8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91KpntxxPxEK0fQ94REZeRkTfwsxvciqnvsmO1HxRW_Q&oe=6A4532C2"}, {"file_name": "Untitled-8-SC3_2560x1440.png", "id": "4148687502078455", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830021_4148687505411788_2130807848854402687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uwklC8NCj4Q7kNvwEXzYFK&_nc_oc=AdrjgiKnalKXtEAOxpQF4rnVkGJMskdZ9jiJyavLKmFSlpLPx7LwGtBoksIl_G_Voto&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jueBMa6P-IXj-SI7tYi0pcPMQ2bh1EgVm0yUICFV9pQ&oe=6A4519BD"}, {"file_name": "Untitled-10-SC5_2560x1440.png", "id": "2163063214163227", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825050_2163063217496560_3945081202565340583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-0rqVXGIQEQ7kNvwGaivxZ&_nc_oc=AdrMre5Bdl9aGijp0DpAo-yDmtV-3_Ah4xNSgF33mBWux1bnzugHrvoIEZTmxjPM-3I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Zv81_a-_S2eUPPTg4EJjf6PAxTWrmm7WJ2rZUyQ7Dqw&oe=6A451245"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Thumbnail (2560 x 1440 px).png", "id": "1067554828799111", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491831382_1067554832132444_1820042300100226778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTzax8zTt_wQ7kNvwE2z45j&_nc_oc=AdoxfenEpq2W4WCVvhKIYyWpPGelZ1a167zc2LBpXMV9_juAZ3YfTiyvDcB7XgSjmyo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PKvLg2UDLkbCqcIfHV-udMliZR67Ti781PrsjbsGy7A&oe=6A452A59"}, "display_name": "Cebus", "keywords": ["monkey", "tag", "multiplayer", "horror", "onlyup"], "long_description": "**Cebus** is a fast-paced **multiplayer** VR game where you play as a creature called a Cebus, moving with full **arm-based motion**. Run, jump, climb, and swing through unique, challenging maps \u2014 each with its own style and mechanics. Explore the Forest, slide across the Ice Map, bounce through the Cloud Map, chill on the Beach Map, or float through the Zero Gravity Map. **Play solo or jump in with friends.**\n\n## Game Modes\n\n- **Lazer Maze** \u2014 Dodge moving lasers in a skill-based obstacle course\n- **Glass Bridge** \u2014 Step carefully or fall through the wrong panel\n- **Only Up** \u2014 A vertical parkour climb where one fall resets your progress\n- **Horror** \u2014 Navigate dark, suspenseful areas filled with fear and surprises\n\n## Customize Your Cebus\n\nVisit the **Mall**, the social hub where you unlock cosmetics and tools at the Shop:\n\n- **Size Changer** \u2014 shrink or grow your Cebus\n- **Grappling Hook** \u2014 swing across levels with ease\n- **Mod Menu** \u2014 fun in-game extras and settings\n- And many more upgrades\n\nWhether you're mastering movement, racing friends to the top, or showing off your style, **Cebus** offers nonstop fun and freedom.\n", "short_description": "Cebus is a fast-paced multiplayer VR game where you run, climb, jump, and swing as a monkey-like creature using full arm-based movement. Play with friends across maps like Forest, Ice, Cloud, Beach, and Zero Gravity. Jump into modes including Lazer Maze, Glass Bridge, Only Up, and Horror. Visit the Mall to customize your Cebus with cosmetics, a size changer, and a grappling hook. Master movement, explore freely, and stand out in the world of Cebus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://villanstudios.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sora_vr", "support_website_url": null, "website_url": "https://villanstudios.com/", "category": null, "comfort_rating": 
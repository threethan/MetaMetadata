gATgceO0_vkmJr5J8O8lEd2KJ4b-Vw&oe=6A37E09E"}, {"file_name": "Untitled-9-SC4_2560x1440.png", "id": "24284559741203341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827703_24284559747870007_1728458674463017053_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTYzd5yNe4EQ7kNvwGhXzQe&_nc_oc=AdrxE0VUxkIRIZIrRqOS6bKnDHmSLAvIHzUts1-0msG-V89UypXovQCWaTNo0eKBns4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tlT8tUqmMIcLcgY9AOseRITJdsiQeqBPTnD-KqpM2Pw&oe=6A3803C2"}, {"file_name": "Untitled-8-SC3_2560x1440.png", "id": "4148687502078455", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830021_4148687505411788_2130807848854402687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8wCsJN1jgUQ7kNvwHrw_1x&_nc_oc=AdoXiMa1bgNjODHCeQRwcCJcDv1WbbcjbF2gb3Eac-n9V-0PVQFcKYgFRz9U8dfG2es&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sESqFF1QSnBU5tQZ7y1K2NgHjAP9iyCpMewuOX5K0NA&oe=6A37EABD"}, {"file_name": "Untitled-10-SC5_2560x1440.png", "id": "2163063214163227", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825050_2163063217496560_3945081202565340583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E16iiE3qSMsQ7kNvwHCNICT&_nc_oc=Adq_vnP15UmDcD0c9Rr2299ZLHCdynL7XpeRm97dXBeEg6UkuSZC_tIsFMxWwWLuuL4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UO6jG4yd-2EnDhRyERUvtmJGEzhqm2MZhrXxO1x86QA&oe=6A37E345"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Thumbnail (2560 x 1440 px).png", "id": "1067554828799111", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831382_1067554832132444_1820042300100226778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gslf_PRpV7UQ7kNvwGp654U&_nc_oc=Adq3cI4olhWYIuGldLV90vjaMUTQnTqNJje6uPWrKqfWUrudmoL7tsTPR0FztQIIt-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pTgr4rS6_5ia-W7bwkJA758xT5Q0n9K7vDGBuDZoCvw&oe=6A37FB59"}, "display_name": "Cebus", "keywords": [], "long_description": "Cebus is a VR Hand movement-based game where you play as a creature called a Cebus. Run, jump, climb, and swing your way through a variety of unique and challenging maps, each with its own style and mechanics. Explore the Forest, slide across the Ice Map, bounce through the Cloud Map, chill on the Beach Map, or float through space in the Zero Gravity Map.\n\nThe game features multiple thrilling game modes to test your reflexes and creativity:\n\nLazer Maze \u2013 Dodge moving lasers in a skill-based obstacle course\n\nGlass Bridge \u2013 Step carefully or fall through the wrong panel\n\nOnly Up \u2013 A vertical parkour challenge; one fall resets your progress\n\nHorror \u2013 Navigate dark, suspenseful areas filled with fear and surprises\n\nWhen you're not exploring or competing, visit the Mall, the social hub where you can fully customize your Cebus. Head to the Shop to unlock cosmetics and tools that change how you play and look. Get items like:\n\nMod Menus (for fun extras in game)\n\nSize Changer (shrink or grow your Cebus)\n\nGrappling Hook (swing across levels with ease)\n\nAnd many more fun upgrades\n\nWhether you're mastering movement or showing off your drip, Cebus offers nonstop fun and freedom.", "short_description": "Cebus is a fast-paced VR game where you play as a Cebus. Explore maps like Forest, Ice, Cloud, Beach, and Zero Gravity. Play modes like Lazer Maze, Glass Bridge, Only Up, and Horror. Visit the Mall to customize your Cebus with cosmetics and powerful tools like mod menus, a size changer, and a grappling hook. Master movement, explore freely, and stand out in the world of Cebus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://villanstudios.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sora_vr", "support_website_url": null, "website_url": "https://villanstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", 
kNvwEOXWhk&_nc_oc=Adr566JHCowfY67QyuvHSPTBtgxxwzFCXgcU9VPQtFC5OtIaSGZ-vfNPpwx--8643xM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsPovi0NGFC9jtrxXOJ1a1vjllZlNEiuTYKQwslhFnaQ&oe=6B086FFD"}, {"file_name": "Untitled-10-SC5_2560x1440.png", "id": "2163063214163227", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491825050_2163063217496560_3945081202565340583_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOPFglXBVioQ7kNvwHAkiKI&_nc_oc=AdousZYVlHBqa11urGStNCIOd6eG3Skmpn7F0dUPSHFCiICK5dXAUGzkfhCLkSAmAbc&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-NvTNIRWHsZgfiVYQcRzDlQtXoWDju33S4QF98DHyHA&oe=6B086885"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Thumbnail (2560 x 1440 px).png", "id": "1067554828799111", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831382_1067554832132444_1820042300100226778_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHKe9fJveeQQ7kNvwF4Ypjy&_nc_oc=AdoCux6-5XSXDW72ssn71rVBRkM3X8-vwlRSd4PAcX5orhkOCty0vaDiS9LEKcQtfck&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLTYXeJBHrc4jaBTerGOwCC_3K0_WCUvm2XRlRNvNMzA&oe=6B084859"}, "display_name": "Cebus", "keywords": ["monkey", "tag", "multiplayer", "horror", "onlyup"], "long_description": "**Join our Discord for news, sneak peeks, and community: https://discord.gg/rwCWTW3xuJ**\n\n# Explore Different Worlds\n\nEvery map brings a different way to move and play.\n\n- **Forest** \u2014 Climb through the trees and find your own routes.\n- **Ice Map** \u2014 Slide across slippery terrain and control your momentum.\n- **Cloud Map** \u2014 Bounce your way through a world in the sky.\n- **Beach Map** \u2014 Slow down, explore, and hang out with friends.\n- **Zero Gravity Map** \u2014 Leave the ground behind and float through zero gravity.\n\n# Take On the Game Modes\n\n- **Lazer Maze** \u2014 Dodge moving lasers and put your timing to the test.\n- **Glass Bridge** \u2014 Choose your panels carefully. The wrong one sends you falling.\n- **Only Up** \u2014 Climb a vertical parkour course where one fall resets your progress.\n- **Horror** \u2014 Explore dark areas filled with suspense and surprises.\n\n# Make Your Cebus Your Own\n\nMeet up at the **Mall**, visit the **Shop**, and unlock cosmetics and tools to change your look and how you play.\n\n- **Size Changer** \u2014 Shrink or grow your Cebus.\n- **Grappling Hook** \u2014 Hook on and swing across levels.\n- **Mod Menu** \u2014 Try fun in-game extras and settings.\n\nMaster a tricky climb, race friends to the top, or hang out and show off your style. How you spend your time in Cebus is up to you.", "short_description": "Run, climb, and swing with your arms in Cebus, a multiplayer VR playground full of gamemodes like mini golf, only up, horror, pvp, lazermaze, rock climbing and so much more"}]}, "developer_name": null, "developer_privacy_policy_url": "https://villanstudios.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sora_vr", "support_website_url": null, "website_url": "https://villanstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29653398707590517"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499626806_221136813608938
xWXOA5h32QtoKKJJykxOec6PEocco5C9N4Q&oe=6AA57042"}, {"file_name": "Untitled-8-SC3_2560x1440.png", "id": "4148687502078455", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830021_4148687505411788_2130807848854402687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QQhbJJHVz0Q7kNvwE0XBFs&_nc_oc=Adp9m9HWnRW3NqMfsZ7oFu6Yq0U1lgEe6RBK8H4fh45GARg5UiNilzCyIn-Lm7MzLXU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUCjLgU5mY26NG15nWC5IOwmEEwNNDGnq5NWj8wXxHFQ&oe=6AA5573D"}, {"file_name": "Untitled-10-SC5_2560x1440.png", "id": "2163063214163227", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825050_2163063217496560_3945081202565340583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tqKY40GjLgQ7kNvwHZ-gVi&_nc_oc=Adrv9u7WUqH91Sf8rA3yCSGDW4j7RfGTm7phaKfnV4YmXBoT_--J5kcSHv0segy4crQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUf-sEk0d1z8Q13P26J6FWKF_fKdgreW5DPjr4f9TBVg&oe=6AA54FC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Thumbnail (2560 x 1440 px).png", "id": "1067554828799111", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831382_1067554832132444_1820042300100226778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYTJn99ElNQQ7kNvwFt3k9g&_nc_oc=AdrEMCUwLb_I4buD8667KvcSqzy_HRkTvyyq_60PLmBkTmzyoxjB_Mtjy92vtMP1OQA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4PPeVmSbMq-buQZ6qheTwvKxqauSBDWa6N9NROEibZg&oe=6AA567D9"}, "display_name": "Cebus", "keywords": ["monkey", "tag", "multiplayer", "horror", "onlyup"], "long_description": "**Cebus** is a fast-paced **multiplayer** VR game where you play as a creature called a Cebus, moving with full **arm-based motion**. Run, jump, climb, and swing through unique, challenging maps \u2014 each with its own style and mechanics. Explore the Forest, slide across the Ice Map, bounce through the Cloud Map, chill on the Beach Map, or float through the Zero Gravity Map. **Play solo or jump in with friends.**\n\n## Game Modes\n\n- **Lazer Maze** \u2014 Dodge moving lasers in a skill-based obstacle course\n- **Glass Bridge** \u2014 Step carefully or fall through the wrong panel\n- **Only Up** \u2014 A vertical parkour climb where one fall resets your progress\n- **Horror** \u2014 Navigate dark, suspenseful areas filled with fear and surprises\n\n## Customize Your Cebus\n\nVisit the **Mall**, the social hub where you unlock cosmetics and tools at the Shop:\n\n- **Size Changer** \u2014 shrink or grow your Cebus\n- **Grappling Hook** \u2014 swing across levels with ease\n- **Mod Menu** \u2014 fun in-game extras and settings\n- And many more upgrades\n\nWhether you're mastering movement, racing friends to the top, or showing off your style, **Cebus** offers nonstop fun and freedom.\n", "short_description": "Cebus is a fast-paced multiplayer VR game where you run, climb, jump, and swing as a monkey-like creature using full arm-based movement. Play with friends across maps like Forest, Ice, Cloud, Beach, and Zero Gravity. Jump into modes including Lazer Maze, Glass Bridge, Only Up, and Horror. Visit the Mall to customize your Cebus with cosmetics, a size changer, and a grappling hook. Master movement, explore freely, and stand out in the world of Cebus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://villanstudios.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sora_vr", "support_website_url": null, "website_url": "https://villanstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
lf-7-SC2 2560x1440.png", "id": "2898166337199752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295661_2898166340533085_6797391979187378109_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6uS20Rf-gYQ7kNvwE4sZP8&_nc_oc=AdpLDZJYz3EOLWO2QqvocD9wvXysVmFqjNuBuLIXBzdKRYHQjGL1Yhm6_y8vt--MSRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEGRRlYkZ-FW2Zizr-TUM16BcSKZezovzvIrUi1fPa5w&oe=6AF5C493"}, {"file_name": "Untitled-6-SC1_2560x1440.png", "id": "710873975262138", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_710873978595471_4844635543382100909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwgLJylmYQIQ7kNvwF7Je5G&_nc_oc=Adr7iIGX2xzX19kYQf2HBbPXvFs6nhy60wrSInRFuqxIqjoOrv_ST2RTmYX6W8PNm0M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0QqUHVuc5RMZwaRm9lQq3Bb8lauY1ZzlpoAf3IPfJOA&oe=6AF5BF81"}, {"file_name": "Untitled-9-SC4_2560x1440.png", "id": "24284559741203341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827703_24284559747870007_1728458674463017053_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hGSa1oQuOMQ7kNvwEzJMNl&_nc_oc=AdrXjpeB76HbvaexmFMwi_pFLODqEILB3EYDX9T-ytPkuKgSdyqQToyvyxls-s9hTrs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRACando5PJMh2VSKHRP2Wymb8ERAVNyt7vjX7pfWLOsg&oe=6AF5DBC2"}, {"file_name": "Untitled-8-SC3_2560x1440.png", "id": "4148687502078455", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830021_4148687505411788_2130807848854402687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpwedpkD2TgQ7kNvwFOTWG_&_nc_oc=AdrU7MjkGhoruO592skwijhuF5H5roUp2Cir93T7N0QSqkNRvUA2TsDQ3N1dXCyULEs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQys9m5i5-Ce2EEnoGhxzOGWIpHBNUxEjgDwEYjzRSW2w&oe=6AF5C2BD"}, {"file_name": "Untitled-10-SC5_2560x1440.png", "id": "2163063214163227", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825050_2163063217496560_3945081202565340583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hJBedhfzKoQ7kNvwEizSjQ&_nc_oc=AdoIv2Gryj2P7heETyhx2hUF3iN2Sqe7mPClWnjK782yL6gnKrlDlHiZWVy3LNHsu5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4lpn1WnuD4ulNdd_OsixDbvKTgydFd5oDA2x80h0FVA&oe=6AF5F385"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Thumbnail (2560 x 1440 px).png", "id": "1067554828799111", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831382_1067554832132444_1820042300100226778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fguWBnH3xkQ7kNvwEm9tEN&_nc_oc=Adr-cjHB7I_j2tii6YKnR67a1bFSNKgbYrL0rxxxpxrWRShJTnqy9CLMW5CfGhPDxco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMp9pCrvB4_Fvkl_lYqevsGrU0FM1tyC_j6JBA-n7jDQ&oe=6AF5D359"}, "display_name": "Cebus", "keywords": ["monkey", "tag", "multiplayer", "horror", "onlyup"], "long_description": "**Join our Discord for news, sneak peeks, and community: https://discord.gg/rwCWTW3xuJ**\n\n# Explore Different Worlds\n\nEvery map brings a different way to move and play.\n\n- **Forest** \u2014 Climb through the trees and find your own routes.\n- **Ice Map** \u2014 Slide across slippery terrain and control your momentum.\n- **Cloud Map** \u2014 Bounce your way through a world in the sky.\n- **Beach Map** \u2014 Slow down, explore, and hang out with friends.\n- **Zero Gravity Map** \u2014 Leave the ground behind and float through zero gravity.\n\n# Take On the Game Modes\n\n- **Lazer Maze** \u2014 Dodge moving lasers and put your timing to the test.\n- **Glass Bridge** \u2014 Choose your panels carefully. The wrong one sends you falling.\n- **Only Up** \u2014 Climb a vertical parkour course where one fall resets your progress.\n- **Horror** \u2014 Explore dark areas filled with suspense and surprises.\n\n# Make Your Cebus Your Own\n\nMeet up at the **Mall**, visit the **Shop**, and unlock cosmetics and tools to change your look and how you play.\n\n- **Size Changer** \u2014 Shrink or grow your Cebus.\n- **Grappling Hook** \u2014 Hook on and swing across levels.\n- **Mod Menu** \u2014 Try fun in-game extras and settings.\n\nMaster a tricky climb, race friends to the top, or hang out and show off your style. How you spend your time in Cebus is up to you.", "short_description": "Run, climb, and swing with your arms in Cebus, a multiplayer VR playground full of gamemodes like mini golf, only up, horror, pvp, lazermaze, rock climbing and so much more"}]}, "developer_name": null, "developer_privacy_policy_url": "https://villanstudios.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sora_vr", "support_website_url": null, "website_url": "https://villanstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29653398707590517"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626806_2211368136089382_5268929153364270355_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFBe21VxCEQQ7kNvwEvm2Kh&_nc_oc=AdqTUrfW5k6fvP-Av0A8XO_p4Ozm3PTrcDjGDnDA8r7koe4C0xOxnOjFteydiXSJDu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZvO2v5vmPZvrYlkz3gs3W7tvxKMh_PFSfVVaIO_uU-w&oe=6AF5CF9F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cebus", "platform": "ANDROID_6DOF", "context_category": {"context
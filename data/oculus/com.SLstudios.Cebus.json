559741203341", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827703_24284559747870007_1728458674463017053_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AlkOz-koSkQ7kNvwHTYku-&_nc_oc=AdmGOE-R8lCLA7jAn6iZcnXP7jPzBq5aAEo2UkthyiveQ8ILSFW87I-L6k0b6-B8O5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsq8EbF8jnAFodNftZbPQfn4lT529TD-1ckjIH2Yu9f2w&oe=699D8C02"}, {"file_name": "Untitled-8-SC3_2560x1440.png", "id": "4148687502078455", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830021_4148687505411788_2130807848854402687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rn7c5SImSOEQ7kNvwEfY51d&_nc_oc=Adnf_Sh4gfDyp2Bu2ATwPLRIrhunzoGu-bqrdwIzmhvJDdEi22kOt-4p-MnzHf1uauE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvFMGlPjecDD9p94ODunhoZSzquSr6mg-Kv3jLxCUFnww&oe=699DAB3D"}, {"file_name": "Untitled-10-SC5_2560x1440.png", "id": "2163063214163227", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825050_2163063217496560_3945081202565340583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opJ8Geye6voQ7kNvwGgc7QQ&_nc_oc=AdmMBke_O3htcANFOStfC0zPAyMF3vzV0jox5Q-Xbt-UoDUnV-qFi9ebhETs7R_ZMF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftLtSQOBmuy4wP1MeFwwWVOFVkiuClCm8iBVR66GhM_8Q&oe=699DA3C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Thumbnail (2560 x 1440 px).png", "id": "1067554828799111", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831382_1067554832132444_1820042300100226778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-z9WYv38R-wQ7kNvwFqvJkF&_nc_oc=AdmvJEAX4mO7JIRn27AZHHARP8dLSx8jzg6lxMyL11DHIJNkJL8Q62hLZ4Ljx19kMTI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvnQ1lDOgbwpJAZkBWrc_h_tqD3tulJkuRlSt5zvcyPjQ&oe=699D8399"}, "display_name": "Cebus", "keywords": [], "long_description": "Cebus is a VR Hand movement-based game where you play as a creature called a Cebus. Run, jump, climb, and swing your way through a variety of unique and challenging maps, each with its own style and mechanics. Explore the Forest, slide across the Ice Map, bounce through the Cloud Map, chill on the Beach Map, or float through space in the Zero Gravity Map.\n\nThe game features multiple thrilling game modes to test your reflexes and creativity:\n\nLazer Maze \u2013 Dodge moving lasers in a skill-based obstacle course\n\nGlass Bridge \u2013 Step carefully or fall through the wrong panel\n\nOnly Up \u2013 A vertical parkour challenge; one fall resets your progress\n\nHorror \u2013 Navigate dark, suspenseful areas filled with fear and surprises\n\nWhen you're not exploring or competing, visit the Mall, the social hub where you can fully customize your Cebus. Head to the Shop to unlock cosmetics and tools that change how you play and look. Get items like:\n\nMod Menus (for fun extras in game)\n\nSize Changer (shrink or grow your Cebus)\n\nGrappling Hook (swing across levels with ease)\n\nAnd many more fun upgrades\n\nWhether you're mastering movement or showing off your drip, Cebus offers nonstop fun and freedom.", "short_description": "Cebus is a fast-paced VR game where you play as a Cebus. Explore maps like Forest, Ice, Cloud, Beach, and Zero Gravity. Play modes like Lazer Maze, Glass Bridge, Only Up, and Horror. Visit the Mall to customize your Cebus with cosmetics and powerful tools like mod menus, a size changer, and a grappling hook. Master movement, explore freely, and stand out in the world of Cebus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://villanstudios.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sora_vr", "support_website_url": null, "website_url": "https://villanstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genre
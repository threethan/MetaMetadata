 "1110331655244965", "image_type": "APP_IMG_ICON_FOREGROUND_512", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619602_1110331661911631_9134180739597739341_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvS4lK781JcQ7kNvwEJOJPF&_nc_oc=AdqewMumck2k8hGPMao8NeuiRdn1vRfc502ZH7S9BzHciJGRpyLKcwqTLKxd6O0eGIA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVTCBlAEqif85qCjTZHo-Jnuy_KGbDGG39EaWn47eWtXg&oe=6B0F196C"}]}, "id": "2037764473601517", "locale": "en_US", "screenshots": [{"file_name": "CEBUS MiniGolf-7-SC2 2560x1440.png", "id": "2898166337199752", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295661_2898166340533085_6797391979187378109_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWS6YUGHi_cQ7kNvwGirrEE&_nc_oc=AdrZbXht0iXPnPO0HAhDeDLFqrmqsvnng6DlyIK_8KdX_uh9426ujOQjpiayiFPAaKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWmp9gM3yHMGX9-6YDRYUO1-6Yl9F815Zcq1ST_-P5k6w&oe=6B0F0953"}, {"file_name": "Untitled-6-SC1_2560x1440.png", "id": "710873975262138", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827725_710873978595471_4844635543382100909_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pLCiqojjnMQ7kNvwGUdRQj&_nc_oc=AdrzkjhquJmoqhn95n3YB2tMs-tklwJGegrnhC2WvxQJDc5KjXPVIv_9sl0dBze42xw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW8jCXiUs7aTo6sDSS6XGQ8BHg41z1Q_YcpZGa9MMYDFg&oe=6B0F0441"}, {"file_name": "Untitled-9-SC4_2560x1440.png", "id": "24284559741203341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827703_24284559747870007_1728458674463017053_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZLBDcJBW0sQ7kNvwE8z1og&_nc_oc=AdqErIRds8cU2tdEo64Y-RfLv9hhw6AOWVXdj0zP7IlTjwThyOEfVpvTHroBmoj-pxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXRaq9yb2T5d50J3F40G7YTBYw-UNEj5PrsoDOoSJmWyg&oe=6B0F2082"}, {"file_name": "Untitled-8-SC3_2560x1440.png", "id": "4148687502078455", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830021_4148687505411788_2130807848854402687_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wv3cDNIxUYUQ7kNvwFMGpql&_nc_oc=AdrImwUWAzpewunjIB8yGxL_I-nzljPFrX8vRe4oim6SCJOYqKMu_dQ5QAJC3070nV8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUkQOwOq1D-pDeMq4eojZkTd0tWEarTLkmg24fYPCTGpQ&oe=6B0F077D"}, {"file_name": "Untitled-10-SC5_2560x1440.png", "id": "2163063214163227", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825050_2163063217496560_3945081202565340583_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PT1yFnDKyDcQ7kNvwFJpue8&_nc_oc=AdpnGYPR9eKHTM8tXf7WH2R3wS7j04Av1Chcgsn3O18jt5ZErGftHm-Phg9cQKGapMo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU_LVOP0dYRe8WQlucni4bUDjYlUjefM9-dwogpsJ-low&oe=6B0F0005"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Thumbnail (2560 x 1440 px).png", "id": "1067554828799111", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831382_1067554832132444_1820042300100226778_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQjYO4wpNcoQ7kNvwH6cysh&_nc_oc=AdqZSQlJ7ZIGAsnU5cKoavfJBMr6scD24cZaFGef3bP5aw5hs40CaTvJtS-53qY3-w8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVOXgCBKff0EyeQO5S4T2zRaO5hMigZp49U9OMDKAk_uA&oe=6B0F1819"}, "display_name": "Cebus", "keywords": ["monkey", "tag", "multiplayer", "horror", "onlyup"], "long_description": "**Join our Discord for news, sneak peeks, and community: https://discord.gg/rwCWTW3xuJ**\n\n# Explore Different Worlds\n\nEvery map brings a different way to move and play.\n\n- **Forest** \u2014 Climb through the trees and find your own routes.\n- **Ice Map** \u2014 Slide across slippery terrain and control your momentum.\n- **Cloud Map** \u2014 Bounce your way through a world in the sky.\n- **Beach Map** \u2014 Slow down, explore, and hang out with friends.\n- **Zero Gravity Map** \u2014 Leave the ground behind and float through zero gravity.\n\n# Take On the Game Modes\n\n- **Lazer Maze** \u2014 Dodge moving lasers and put your timing to the test.\n- **Glass Bridge** \u2014 Choose your panels carefully. The wrong one sends you falling.\n- **Only Up** \u2014 Climb a vertical parkour course where one fall resets your progress.\n- **Horror** \u2014 Explore dark areas filled with suspense and surprises.\n\n# Make Your Cebus Your Own\n\nMeet up at the **Mall**, visit the **Shop**, and unlock cosmetics and tools to change your look and how you play.\n\n- **Size Changer** \u2014 Shrink or grow your Cebus.\n- **Grappling Hook** \u2014 Hook on and swing across levels.\n- **Mod Menu** \u2014 Try fun in-game extras and settings.\n\nMaster a tricky climb, race friends to the top, or hang out and show off your style. How you spend your time in Cebus is up to you.", "short_description": "Run, climb, and swing with your arms in Cebus, a multiplayer VR playground full of gamemodes like mini golf, only up, horror, pvp, lazermaze, rock climbing and so much more"}]}, "developer_name": null, "developer_privacy_policy_url": "https://villanstudios.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sora_vr", "support_website_url": null, "website_url": "https://villanstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": 
xOvNZ61yDZ2owpMsCe82JCHjnAQHyCtJn4Q&oe=6A844282"}, {"file_name": "Untitled-8-SC3_2560x1440.png", "id": "4148687502078455", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830021_4148687505411788_2130807848854402687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwQpAfhe_aAQ7kNvwFA3Txz&_nc_oc=AdriiIDa3NjyACeWjnSxQsfrVKgfZanLvWzMrSHeazZTQ-lE39jRgjTlewwSquYijhI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkUCnwTcM3_sfzPN8tV7ix4M2m7JRJFD9fiUXa161Hog&oe=6A8461BD"}, {"file_name": "Untitled-10-SC5_2560x1440.png", "id": "2163063214163227", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825050_2163063217496560_3945081202565340583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmH-pgciwXEQ7kNvwF5iUU1&_nc_oc=AdqH8aigyjH8cLOyOU0XVtknRGrgp7EMI2PtAy_djXvLyfM7t6YUmdT5h3UbigQ4Y7E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaAFERzZmknMGGw99gnIiC7iYbICrtNeYGMcRvi3U79A&oe=6A845A45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Youtube Thumbnail (2560 x 1440 px).png", "id": "1067554828799111", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831382_1067554832132444_1820042300100226778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmW5iAxZwN4Q7kNvwFAoVl8&_nc_oc=Adq4ep9BeMFi825XK7CIAanzHGCXn3z5-t8uz57CBS9-P53wuV0gZwIR3njnnJ4INCQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNS_VdXd_DyaID8w2jcL1wc1Oq360lexivFGlre6sA7Q&oe=6A843A19"}, "display_name": "Cebus", "keywords": ["monkey", "tag", "multiplayer", "horror", "onlyup"], "long_description": "**Cebus** is a fast-paced **multiplayer** VR game where you play as a creature called a Cebus, moving with full **arm-based motion**. Run, jump, climb, and swing through unique, challenging maps \u2014 each with its own style and mechanics. Explore the Forest, slide across the Ice Map, bounce through the Cloud Map, chill on the Beach Map, or float through the Zero Gravity Map. **Play solo or jump in with friends.**\n\n## Game Modes\n\n- **Lazer Maze** \u2014 Dodge moving lasers in a skill-based obstacle course\n- **Glass Bridge** \u2014 Step carefully or fall through the wrong panel\n- **Only Up** \u2014 A vertical parkour climb where one fall resets your progress\n- **Horror** \u2014 Navigate dark, suspenseful areas filled with fear and surprises\n\n## Customize Your Cebus\n\nVisit the **Mall**, the social hub where you unlock cosmetics and tools at the Shop:\n\n- **Size Changer** \u2014 shrink or grow your Cebus\n- **Grappling Hook** \u2014 swing across levels with ease\n- **Mod Menu** \u2014 fun in-game extras and settings\n- And many more upgrades\n\nWhether you're mastering movement, racing friends to the top, or showing off your style, **Cebus** offers nonstop fun and freedom.\n", "short_description": "Cebus is a fast-paced multiplayer VR game where you run, climb, jump, and swing as a monkey-like creature using full arm-based movement. Play with friends across maps like Forest, Ice, Cloud, Beach, and Zero Gravity. Jump into modes including Lazer Maze, Glass Bridge, Only Up, and Horror. Visit the Mall to customize your Cebus with cosmetics, a size changer, and a grappling hook. Master movement, explore freely, and stand out in the world of Cebus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://villanstudios.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sora_vr", "support_website_url": null, "website_url": "https://villanstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
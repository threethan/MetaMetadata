771-25/499618910_735298105821131_6865452378848535531_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDef60WTTsoQ7kNvwGh41F7&_nc_oc=Adq2hVv9vlt3FS4gPAPJ0VjzFOYSiKh2-iEZGGAJETl2SHeJox6YSV5Ye3htHirGPCE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThW3Bygman2Tr9nulD5gJQOfWLkYIZMawH6-g1VWegKA&oe=6B005663"}, {"file_name": "38974760_486506190218931_2595422867759830827_n (1).png", "id": "576144548894139", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305328_576144552227472_3816120294572523148_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39LFytqBQy0Q7kNvwFGbsfV&_nc_oc=Adoy8512JzLKpHockxemfKP1XSQe9OtQlXBnjJ6XKKx_LtuyOlSrPNQEMwL_8LbnzYM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzmE5ZSpivrd6PqTpcaKTOJFFTm5di49QfYdFhyC05xA&oe=6B005A7F"}, {"file_name": "38974759_686191586421358_586197441273951352_n (1).png", "id": "1288235796153082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618102_1288235799486415_5443564301097503418_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-rwqTmgiwAQ7kNvwE9RqBt&_nc_oc=AdqaLu69GKUWmBRgUoCzyH3yYOFbi0VhqpV41em_6ALxp10RBpBCFaeYkX6zmst6Xfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoaVxYFG5014rp4cA366jPV1V8M5K5pmzdgD1NiZMHlQ&oe=6B00783A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fish Taggers", "keywords": [], "long_description": "Don\u2019t let the name fool you \u2014 Fish Taggers isn\u2019t about fish. It\u2019s about fast-paced, physics-based chaos in VR. Run, jump, climb, and tag your way through wild maps using only your hands. No joysticks. No teleporting. Just raw movement and skill.\n\nInspired by the viral hit Gorilla Tag, Fish Taggers brings that same high-energy locomotion to a new world full of intense chases, creative maps, and a wild community. Whether you're the hunter or the hunted, every match is a workout \u2014 a
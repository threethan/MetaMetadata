771-25/499618910_735298105821131_6865452378848535531_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwCIfRvZt7IQ7kNvwG9Z11V&_nc_oc=AdpCKgawdz6UDk1IbxHS30uKBdtZ76rsSVAwwNWT4i7_2XvqfV70bE6FKu1V_bh97jk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3WgXckBLbfkm3Zsb1UqVZCuhHR519oK8TifMxr4Wc4A&oe=6B05D4A3"}, {"file_name": "38974760_486506190218931_2595422867759830827_n (1).png", "id": "576144548894139", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305328_576144552227472_3816120294572523148_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7NEIQWLJDUQ7kNvwFMkEi3&_nc_oc=Adoz5lY5BjQmqi-Xs_pe622rSIu_LzHFg9TMyUWWM5c8KHxebcjjuMSu7qGwNMNwBLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1nJZc6ze73Dj7v2IUCXgqXXABNhviERraSfxdfLKexw&oe=6B05D8BF"}, {"file_name": "38974759_686191586421358_586197441273951352_n (1).png", "id": "1288235796153082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618102_1288235799486415_5443564301097503418_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-G5Knq2EDYQ7kNvwF5PRAR&_nc_oc=AdpB6G_7n6wiyfCLX8lx_vwo3XGv-SNMqsU0BJyf7AWU9esJxgQTwn6fZLUCC1Apf9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxQ1oGfQw4O3xHaTEH70tWTePz5CPmx84qgYe94n4Mvw&oe=6B05BE3A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fish Taggers", "keywords": [], "long_description": "Don\u2019t let the name fool you \u2014 Fish Taggers isn\u2019t about fish. It\u2019s about fast-paced, physics-based chaos in VR. Run, jump, climb, and tag your way through wild maps using only your hands. No joysticks. No teleporting. Just raw movement and skill.\n\nInspired by the viral hit Gorilla Tag, Fish Taggers brings that same high-energy locomotion to a new world full of intense chases, creative maps, and a wild community. Whether you're the hunter or the hunted, every match is a workout \u2014 a
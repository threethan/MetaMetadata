771-25/499618910_735298105821131_6865452378848535531_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHys_Kin844Q7kNvwFLiUsK&_nc_oc=Adr8qdkLTW9C6QCnDukOdDYCnV9GDtcBCVcW1Zv01QL_5LeHkHFGqyAvV4fmjc8SkUU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWVgTfKpBuUS6aIbe7YnD7jgUbRFJNSHdOTlt9A81wRhA&oe=6B1060A3"}, {"file_name": "38974760_486506190218931_2595422867759830827_n (1).png", "id": "576144548894139", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305328_576144552227472_3816120294572523148_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU_aKKySKroQ7kNvwGipQX7&_nc_oc=AdqJXN3j0GxGS2ngsYSke5PnBdvqmJ633nfag6d9O27kiUouCwmG4hSZMMBawOnYWhg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXgBVgu87oVAoIlhNZimyhwdMQn5dZFgJxjfdFUuxQBgA&oe=6B1064BF"}, {"file_name": "38974759_686191586421358_586197441273951352_n (1).png", "id": "1288235796153082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618102_1288235799486415_5443564301097503418_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DO4afpo2wpsQ7kNvwGctKEB&_nc_oc=Ado4VJbdw90Ipj68sKhG5BKIxvDymFVBUJJEni4YhgLpwju4HmAt0K9MGvhC_W1gWOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUckZUlDl8y8FMrWnygvnst7HVCXyNe5hYEgfcwAK22fg&oe=6B104A3A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fish Taggers", "keywords": [], "long_description": "Don\u2019t let the name fool you \u2014 Fish Taggers isn\u2019t about fish. It\u2019s about fast-paced, physics-based chaos in VR. Run, jump, climb, and tag your way through wild maps using only your hands. No joysticks. No teleporting. Just raw movement and skill.\n\nInspired by the viral hit Gorilla Tag, Fish Taggers brings that same high-energy locomotion to a new world full of intense chases, creative maps, and a wild community. Whether you're the hunter or the hunted, every match is a workout \u2014 a
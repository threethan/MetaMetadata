771-25/499618910_735298105821131_6865452378848535531_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHys_Kin844Q7kNvwEcrUqF&_nc_oc=AdrNzYndsAg_8eFamsRIMjla5mRFSkhUKeeHP13ykOLFM2wbsQIFphgGsWkQdVzzIJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVrsaMzADBxRV_YzQPM-2A7whgQsORIrHJmleQTvH6wcA&oe=6B0F0F23"}, {"file_name": "38974760_486506190218931_2595422867759830827_n (1).png", "id": "576144548894139", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305328_576144552227472_3816120294572523148_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU_aKKySKroQ7kNvwFKPJ5B&_nc_oc=Ado33KUttucabxXiIHMYShNC0XZ0mUTVJsrnycAV8dbn0RgZHcnAxXogjapAPAoXv9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVHmRWQrgYWOlsHmX_yhr16Pxv_8VtP85T7yv555fQYrw&oe=6B0F133F"}, {"file_name": "38974759_686191586421358_586197441273951352_n (1).png", "id": "1288235796153082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618102_1288235799486415_5443564301097503418_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9i4Bcf3rlUQ7kNvwEPMVXv&_nc_oc=Adqbu8reYtj7dAbbHbXnFnyYO89dQlamNynmnHOEpuwixKIDgE1thUCO9OYmP20vZKA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXyyO4Dgm-N7874AG4pSfgPMO23VlWr4PKlTQdOouFivg&oe=6B0EF8BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fish Taggers", "keywords": [], "long_description": "Don\u2019t let the name fool you \u2014 Fish Taggers isn\u2019t about fish. It\u2019s about fast-paced, physics-based chaos in VR. Run, jump, climb, and tag your way through wild maps using only your hands. No joysticks. No teleporting. Just raw movement and skill.\n\nInspired by the viral hit Gorilla Tag, Fish Taggers brings that same high-energy locomotion to a new world full of intense chases, creative maps, and a wild community. Whether you're the hunter or the hunted, every match is a workout \u2014 a
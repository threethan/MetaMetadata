.com/v/t64.5771-25/39031363_3799300956816173_8349423332005623250_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65JdHnuBKGgQ7kNvwETGuyo&_nc_oc=Adq-1YKtXMRxRPbxQA5YDBu63s978B0sGYjo_iCIpf5Eg2WtPpx5kAi_TVqF1uin27s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjOL_ekX6OliWXKZT72_ApXVPFz8uhAppFptKQzzkm8w&oe=6AF87830"}, {"file_name": "AppLab_Screenshot_ShootingRange.png", "id": "4054617317882145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_4054617324548811_4995769338990133684_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2o4a7u7asgQ7kNvwGX0Olt&_nc_oc=AdrHa-G749ONi-wrmfrKXVFIfwsWroTSoVVhnqDBLQFhiqTDsd8OGS6r8fybWZ0dMBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsDbTn5ev7H6OAJ7MNqeCkdcykyZlk-ENRvIe1Ch8jPA&oe=6AF89FAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverImage.png", "id": "475331950140577", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003281_475331953473910_5793785037792038702_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nu0yYxwM9jgQ7kNvwHUTF4j&_nc_oc=AdpcXzcNIyuI4kPRs4diftRQvUizl9URxagyJyi0BJXDF8DdTHGZ5zIIsZFV4CBmoZQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgvJTwsHfUQoP8Y1RY-5YhPU0twWZcsDEOsBCb73Chow&oe=6AF884FC"}, "display_name": "Aim XR", "keywords": [], "long_description": "Aim XR is a 8v8 fast-paced multiplayer shooter. Highly social, chat with both teams anywhere on the map.\n\nPlay online with people, or play offline against bots. Jump in a server and play immediately with others. Create private servers to play with only your friends. Try ranked 2v2 matchmaking for a competitive challenge.\n\nYou can also host a LAN server, and play with users on the same WiFi network.\n\nYou can also play sitting down, by using the height adjustment slider.\n\nIn order to maximize comfort, tunnel vision is activated when moving via the joystick. You can disable the tunnel vision via the Settings menu.", "short_description": "Fast-paced multiplayer, run-and-gun shooter. 8v8 players. Highly social, chat with both teams anywhere on the map. Jump in a server and play immediately with others. Create a private servers with just friends, or try the ranked 2v2 matchmaking. Leaderboards on aimxr.com."}]}, "developer_name": null, "developer_privacy_policy_url": "https://protoxr.com/aim-xr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Proto XR", "support_website_url": null, "website_url": "http://aimxr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27939753718946243"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974797_216435416866968_8970725105350432957_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eStAcZ7SR4sQ7kNvwFQNtnE&_nc_oc=AdrKwiXYcSJ-Fl8SH6Q_8o10dsXAdlC8syRaQMr98fQ41SOEDO28N6QmzRCl0npbjd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfbiIDa29nW3D4_BI5AEdbNmZaha94WLl_feRcFAMhWQ&oe=6AF898B9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Aim XR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "374
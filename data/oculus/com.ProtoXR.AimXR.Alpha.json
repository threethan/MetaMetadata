29BC"}, "display_name": "Aim XR", "keywords": [], "long_description": "Aim XR is a 5v5 fast-paced multiplayer shooter. Play online with people, or play offline against bots. You can also host a LAN server, and play with users on the same WiFi network.\n\nYou can also play sitting down, by using the height adjustment slider.\n\nIn order to maximize comfort, tunnel vision is activated when moving via the joystick. You can disable the tunnel vision via the Settings menu.", "short_description": "Fast-paced multiplayer, run-and-gun shooter. 6v6 players"}]}, "developer_name": null, "developer_privacy_policy_url": "https://protoxr.com/aim-xr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Proto XR", "support_website_url": null, "website_url": "http://aimxr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "996214791321887"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974797_216435416866968_8970725105350432957_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5InYUuPhycQ7kNvwG--t5v&_nc_oc=AdkZovD--fepcMvoWU-NJN41yPeoNl5YGZcWoTv08SwzXz_D3sLFQaEQajyQ5jJ7yNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvr_4FShhcpk31_4afzShGS3_nRMJUnF7tKMGoHepqHxA&oe=69A43D79"}, "is_concept": false, "is_
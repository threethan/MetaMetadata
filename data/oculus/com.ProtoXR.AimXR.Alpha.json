2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQW3XQPmo5UkZfr04n6SLhaa9tCQGejDT6ulDHAfpnMQ&oe=6B087196"}, {"file_name": "AppLab_Screenshot_AK.png", "id": "3799300953482840", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031363_3799300956816173_8349423332005623250_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MThmzo7RZwQ7kNvwHv6Ftj&_nc_oc=AdrDf0ESMrjx0aH_3l8GjyjnBfszHBhh1HlhfBeKMhluCe2Rm5ChY6ab1E4P1sU7iQg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTwVsaEOY3knDGxA2-B-xDF2E3k4H75PWIqF2OTL3kwg&oe=6B084A30"}, {"file_name": "AppLab_Screenshot_ShootingRange.png", "id": "4054617317882145", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982584_4054617324548811_4995769338990133684_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5njhim6oBVgQ7kNvwHcl5S2&_nc_oc=AdrwEgNJU5OOBrWJ5NTOfL1TSJSTkXQ33IbbkiXS1RfwjoeD75Eb0PzS8NZRHHfeABw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnpbF2bjYuvMezvQK4Y8ABFrgfuD7dNVySDcTspV6hdA&oe=6B0871AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverImage.png", "id": "475331950140577", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003281_475331953473910_5793785037792038702_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ldz_bnXkmMwQ7kNvwFnfXYu&_nc_oc=AdpNWRmLg0tvifo_t8oPZvPkotp0r8S1hdyBA8EoPfT93B1XLF9ZgfS7eq4b7OvwOzE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUbkHvVAtd0dIbppL8_ByqTjZGuk8tmecDinHXb4x_Fw&oe=6B0856FC"}, "display_name": "Aim XR", "keywords": [], "long_description": "Aim XR is a 8v8 fast-paced multiplayer shooter. Highly social, chat with both teams anywhere on the map.\n\nPlay online with people, or play offline against bots. Jump in a server and play immediately with others. Create private servers to play with only your friends. Try ranked 2v2 matchmaking for a competitive challenge.\n\nYou can also host a LAN server, and play with users on the same WiFi network.\n\nYou can also play sitting down, by using the height adjustment slider.\n\nIn order to maximize comfort, tunnel vision is activated when moving via the joystick. You can disable the tunnel vision via the Settings menu.", "short_description": "Fast-paced multiplayer, run-and-gun shooter. 8v8 players. Highly social, chat with both teams anywhere on the map. Jump in a server and play immediately with others. Create a private servers with just friends, or try the ranked 2v2 matchmaking. Leaderboards on aimxr.com."}]}, "developer_name": null, "developer_privacy_policy_url": "https://protoxr.com/aim-xr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Proto XR", "support_website_url": null, "website_url": "http://aimxr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27939753718946243"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974797_216435416866968_8970725105350432957_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evy-pl-cWlUQ7kNvwGUxWrh&_nc_oc=AdpUizYOX4ZXjQn929CDTuSxO9CToaL9pft8MLuIH5Cu5huK2dFvE9CqQCbECAwntqY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYlV__
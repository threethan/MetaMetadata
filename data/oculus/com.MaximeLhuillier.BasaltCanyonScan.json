t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63qAfxfgRdEQ7kNvwGnzt5C&_nc_oc=Adq0rpEuA-_W3FLhqkyPUPY82DOiFmvtMf15Dm7zk5l6oyPb_c5a6rO9QMQbpqrZWQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fm0CJ5iOA6n1SSMkGhWU5ZbEb67pNfqySkPkitkZGFw&oe=6A2D596D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tECQ-tO2YAsQ7kNvwFcCHz3&_nc_oc=AdquilWC-AyYdDGDzgGTZdfAbJpq5PtiGWBaOYgXycdrbSoWIKnUD1juOx_btzLyI_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YW-tDkkLzi3czr3fzpwTMDXICMf_l6Ukj4N2HFw1SHA&oe=6A2D5084"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDAsBoY1Fu4Q7kNvwH5EzvC&_nc_oc=AdrRb3FnHZZHNVaIRRt1FoDpi3bpJpmd_SH_BHDTS2O6PLKxL2OecqlzluvOA4ASO2U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oZehg20w0IEj4hL66Zn1xnHf-ey9RBYP502TvxOXxWw&oe=6A2D58D2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAGisw2QAK4Q7kNvwEJ4ws6&_nc_oc=AdrP0bL74j-0r3ttjuQBlOYE_uqhSG5_Pt9kzGRQ7ce8vTP34LQTy99p3tuIHlgL5po&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_RbMGHUKYhMQDh2u2Y568ksCmlmWEcoXvSBryyutsEw&oe=6A2D5705"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpelxiZ-I4AQ7kNvwFhGQBn&_nc_oc=Adq_mDtuFQQh-MNZ4oOHyyOaNyYK9jcDQb66dIhiPVyaBaPvc-VXT6vWrNZC_bhvZKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8shPYSXDQjzpBbnjN1ZhjaDOSqHKEzDkC-3Gqtu2Cw_g&oe=6A2D6B22"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
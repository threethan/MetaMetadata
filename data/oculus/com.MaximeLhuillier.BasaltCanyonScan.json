t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7tAJq5MoFkQ7kNvwHGDLd3&_nc_oc=AdoCfDNhzz6bFZHnYCE14wJSGAB4uLkxXJ9EnsJgRVS3e_LhEww6FGNwZR7qvMeEyhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1hadMSlal747Kyvs6nYmAoRkEsWNTwjNhRlFE9CGN6WQ&oe=69F89D6D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXv7bKcLaKIQ7kNvwGoYbS2&_nc_oc=AdompKhu2cV0PW9V8L_PwVLnqDyZB2mUg5yCv156L3BEKVHUE3Wmk-oTIVkqRSUnXy0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37674zxVy4VtiUYEA-4OMoirn6Q8bXqkcKF7dxcGfc0A&oe=69F89484"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUX8cckywWQQ7kNvwEkeqxw&_nc_oc=Adr-3CZGs0w8ngeD72M-4R84L-d1I1-ptvAFDNjfEvgGwmRNyLS7cTGnHxtsa3jkSCw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1DasQ8gqoNF7Hb5ra4BsIBd5vwuevVMwEsCmB9h1UrQw&oe=69F89CD2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-3da1871agQ7kNvwEaLGUu&_nc_oc=Adqibv2NHfRftufuXn0Lu026vk-yvagzR-heQgJaIIzg-0R-ds9nMPAID1ay99VLLJ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0731Rr99bEaEgvPelMZB0HCcMc9JtWhGFbNwCBkAtQLw&oe=69F89B05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2kdA00RSTEQ7kNvwEsXOFs&_nc_oc=AdoNT8X_BGcV4NhS6ErBnk6G2Y0tz1G54_8phxX3Npb6dfYJw_f9S550-JmGPQlgJWQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_gY5z9wnNM7AlJyYJ98vJ-oRFsZbWo8TyB_bZ6zWpKw&oe=69F8AF22"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
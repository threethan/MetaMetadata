t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faUc0gXZPCsQ7kNvwGozCbg&_nc_oc=AdrlepBZ_6yJ09W0TyNQAEKfYPonPkh9TLLCoInk7usWg9cUmVXM5SPLCXzL0YZwELc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItasjkUFF-HuhYRE33oEkvsOID3kehMaRgWUIgxFnTVg&oe=6A9D68ED"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bybo8OsbvlkQ7kNvwHrhWDZ&_nc_oc=Adodg0gFGYBhwGVf940hAkOyX7UwvGn1d01vq0EMvA6BHkm_rch-x3WbLeww0jaHkN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcgXsqSB6RM7vWb2da0wo7jg9tbib8RNzC3iKlU9KD6Q&oe=6A9D6004"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcK65bt9f-cQ7kNvwGwpGtp&_nc_oc=AdqX1hFFmEZFGJ-kKA4CRVhQ7eX6YA2Tt0BWkrpxsuzikN3_8i1l-kf-7OyHXUSPWGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY2S02k20Phd8Awy16FCjWfiEiJGGD7ibVZC5Gjsctkw&oe=6A9D6852"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxKF2PAxeJoQ7kNvwFS4dVB&_nc_oc=AdrH_enZLRWcc4wlZ1WToSMrkXyczJllCIKpWrVnfzWkfRj5ex4AEPo_BuzcNkDrheg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXaG3p1TP28Nze67dLQ_dgTFaNiWa-Aje5XPKmdzYLBw&oe=6A9D6685"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dswNlDVj9asQ7kNvwEIA8j-&_nc_oc=AdrBw32iMDWKIDTlRj80fY3A3BERpeTppJrX-kIUiywB0Ie1r9wynN6wMFZg60_172U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmTixdywO0CIKDkg370YxrhNMn6vu5mCVxVhBTDxzarQ&oe=6A9D7AA2"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
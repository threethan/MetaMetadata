t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAZk6L0uX-MQ7kNvwHADVKo&_nc_oc=AdrmXxIXMCwZoHcTeSvhd36oBi7qrELczKx6su1RN3Cz9g8Uf6uByiWt2amxPmDmvNw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJA6gXSugsoJ7IiWeSGn9bfH6KheNtwtbvApQYblYOXQ&oe=6AECBB2D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lc1buOZmdeYQ7kNvwHJousO&_nc_oc=Adqv79wFz4P9jHAJpcwyHUeY8z2Fx6PW0kBoarIMSnaV6UsWAZpT29AOa7nfD5W9T4E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxNJfYWFiePDTGwE8S0gIDxPs2yqKYT9MPlA7qfPbo4g&oe=6AECB244"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F91Ya1y0WQYQ7kNvwEaJHjT&_nc_oc=AdooxzOFvXL_-1ghnM99phqIak2rPf3Ey2f47Yo7G5ourDNh972NGRvDBLnnqUZ0zhY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTKJ1ICpvSnhUNMmDe6vzsQ-WOlbxDfDFTKuC06fDziw&oe=6AECBA92"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZrg0mHUgjIQ7kNvwGNe0Np&_nc_oc=AdorkpRKRNxz_9rAPd-kbwLgDQzNblGfkLlJ5Hw0e1NN1EKfOEpQxQZXUTR1Y5g92ew&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxo8vlI9oFbRCM8Bq2PCGbM80-fZh3cp_dtAXOoCDsRQ&oe=6AECB8C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfd90-8_wFsQ7kNvwG-2NjE&_nc_oc=AdpOci_keFE1xmGN1rmUrgXOFUx4-2fZVAVgANozM15BJ4X_Ew5m7ViA_5GVqjzEoYA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQNXbm1KvU2mrNQNM1vJSdk13Y566KnwRekBOkNF2fdw&oe=6AEC94A2"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
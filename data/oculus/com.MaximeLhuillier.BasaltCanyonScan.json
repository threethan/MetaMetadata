t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63qAfxfgRdEQ7kNvwHnBbXs&_nc_oc=AdrZVkMmDtxLZ9HNZ4Ko5iCEQUUSJiYkeTstodcXnzybq-Gv-YFanat6r82-N2PXq9M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2_9ONb3GnZN4nUbDmUjW00fky5ZqziU-yv73eMWIPFA&oe=6A2EAAED"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tECQ-tO2YAsQ7kNvwGzG6Od&_nc_oc=AdpFKkBYc_a-iXGiA83HRRJ4LuBP_iI6typDAfCF2ljvvKn6vN0DrHUoG_qxEPRad8Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zDC32yXBZudkob7cHC3nSHd6Qj4zHroB_dZmXeUbPOg&oe=6A2EA204"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEamyjyBDNgQ7kNvwFSVgt6&_nc_oc=AdrobsHaGo2zE5yjni2PtZFCwAXxtAnkg88_78swTXk442p620l1LdMMyQTtkztUrQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HAJE_5RFsTdx3HK11883151Rdh-X4NT_li3SBgh5K1g&oe=6A2EAA52"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAGisw2QAK4Q7kNvwGVwcKN&_nc_oc=AdrjK-Bh5OX5f0f86Y7T5XnXOXKImPcXxL-EmDY0HCdNZgRRPYDt9_Aq_-EcMkaO84E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ip_JCh9_jDa4EbmxP6ydl-dgpIjhPQSXG7VxAxpFoCg&oe=6A2EA885"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpelxiZ-I4AQ7kNvwGTPhCb&_nc_oc=AdpuZasbnKzcGueEjxGM_moue3kkLVa3Yb-tibuSPtFzhwCMk0lcDfUIahY0JY40QNQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZTUPlHYdF62a1Ey6Rk_1qvDR73ZTdli0R89rOIMHTvg&oe=6A2EBCA2"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
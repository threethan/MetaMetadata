t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXT1w9ARW5sQ7kNvwHzllwI&_nc_oc=Ado7vE9gcQkQCe4yclnzUxKKM9mZIAW9NlX1lraCMv_lhVWXHkoCdIJhMP851XFODSk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3d1il839usFCwfRdJqwgxiC8IftUhXoXKQuaZjkloXQw&oe=69F4A8ED"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsztL6Zuz3EQ7kNvwEhz85w&_nc_oc=AdqFw6Fi02nZf2Pd3s008XlU0lRBMmXRRxSsmqHq_ppgWlm8u1RL9q0lfeggAHoTXP4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3j7tAlShwKk0US4oUQySnTDiwZiopyhO14BRVY5r6I2w&oe=69F4A004"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ST4xoMDFhmgQ7kNvwHG2HMJ&_nc_oc=AdqntRN7camj17Df3kMsW72j4kTHYxiUsEwvYotIFiwJ-awTuZBkG59Aggu4ERlecd4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1LG5JGpv95hTY2YD9JexM3lGrdQoKFJcdMnKPbunKiMw&oe=69F4A852"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxDY4oBNTcIQ7kNvwEJNPeK&_nc_oc=AdqvvnVhpuzuoEL4whq0qQ0o8I7_sDMOFX8JQi4mGSuFr2fwCFWZaGDrQn16Ki2TbKM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ZkUun0SHvaTm2sZWa44awfFppZe9JHWiIrT3NkxJ0OQ&oe=69F4A685"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evnYSKGiPFUQ7kNvwEAqXCC&_nc_oc=AdrLIlxnKtZSMkLAiNrn5DMgrVAW2kFk6ErCZ7S4dEz4X_pzn5gRB9iMGpMpP84GNgw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OmahUbWNV3MBJf3tGxs5p7W2FHW4A8FWOqY0cj7PZyA&oe=69F4BAA2"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
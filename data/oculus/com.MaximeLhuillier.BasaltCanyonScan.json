t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5pJch7R2BcQ7kNvwGgfrI8&_nc_oc=AdowgELgpE2ob62aBVw1UGckjCv9_Y1KdFMzLQ9iRkw5ZJfpwDmkzn2mNjMpCbC-Afo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pxhYlM77iO6g_pkNOrjm0u5QaCWfJ5iFlDlpSq7XK-w&oe=6A0F06ED"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAhvncMPZNYQ7kNvwF5GMw9&_nc_oc=AdoIv4yT8nuevGDXwaAQimj16mOxpDX0_BONphiz8HnIoulvzrXbe0qEulhMYJjlROs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fjtebwVpk05FR5Uf0WZdMek404LQgQtKt8VwHG8QAIw&oe=6A0EFE04"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMm6i1lzvdcQ7kNvwHV6eq5&_nc_oc=AdqFE3NVA417w5DCTqdscMhN1XTJ5d4NCpzD0M5cPxeY-17-IV8O1Qbgt6sTo3W-z6s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50UcK-7auUjcqsAsg8Pmbh9wZ14yA2WH4wsF3Y6yuJwg&oe=6A0F0652"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAtEqM00SusQ7kNvwGTpCMT&_nc_oc=AdpZF9XxqKYb0LN2onHypXWBWTMU8BLmfC1IsPVf-sunx4WqzredzzAwM6XF-S7H8wI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Su69FRCQJL8eCnY-ExiKT5LJjEJZWWuC6cfGn96aJng&oe=6A0F0485"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vo9__fuARpYQ7kNvwEPULMZ&_nc_oc=Adok9jIj6HJV36lQkNhu_31YgFszHSAHtEWqzQ8M3PQCzxPfyivkn4wHkEjWscHMGWo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48RmmLjPYluy8iZYreCk81JY76WllkWpM1wheI6sFREA&oe=6A0F18A2"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
eXKxPdDklKS2u0GKIdkjA2HBb1UAoKMCkxdH-XfVOAqT8-A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afsq0kzbUH7Cnu7CP89BN5vKujIzjno-kvf321JuNCHzLw&oe=69A9836D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMwIoVxj4d0Q7kNvwGz5Vrj&_nc_oc=AdmQUYOxCfZfe_RijYRGnzheBEVugdC0hS2kiyQ-elRa3DZH2IhxBWrTDAYG2z6fMvs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft3E-lRO_puen1xCsEO2dNM7Rdio7FcC8KRGRR5NAFuLA&oe=69A97A84"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWw8Dd-GF64Q7kNvwGKqWM9&_nc_oc=AdkL665soEL0UWvN3JrnQ9C5HzObAAHN_RbMWrTy-Dm7D-4nZDBlQW80m4UH_CNpvC4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfucPspPo2bYP6-tAq2KlUmXnIO01CxgUGVzgelsJp6nPw&oe=69A982D2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5mHgmioFt8Q7kNvwGHm4s2&_nc_oc=AdndlX9U_V_nCrYD7R8o76JNiS7ErgIyTYSNW7CumnGPN4z1KcXeoLVfOCpNvUTP-yE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsBsLZkmZIWhpAxwpWZC6870Ky3Q29shc_B30Sv3GZM4w&oe=69A98105"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qC5xmL_tEKYQ7kNvwGqnBRI&_nc_oc=AdkMR3vxfnURMEkkoTDVA7wxJVij51IxIkT5e8YfT0QAGepA-JhPv9JmnYFHbxMl8_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuwyI8Row3HoDC8Pb2ueAmlQg4ACzXiB7U1RCc3Zd7lSQ&oe=69A99522"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended
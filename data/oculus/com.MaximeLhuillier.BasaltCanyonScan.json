t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkciVna6JswQ7kNvwGS_DEQ&_nc_oc=AdqUlmKNPrA4Uf_XZ4Ao0JkGWQzowxrnufP_hbmTn0URk9WZ4se3QXqsJeH6a1AU1cc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_j2Ds0S02hH8K9WICN86852QrbP3H3d9AIM8YdwnrA1A&oe=6A28136D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsAleLJ4_5AQ7kNvwF2VGRg&_nc_oc=AdofQFZSFT00p_tDk4i-rVzgK7YjUtElg99Nmodzny9F1wv2iRrGfsSHuhabxwR5ry4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_liecbNJvIZwi31XBuMYOPtCAGAMti9kMdmNBDRy7jzg&oe=6A280A84"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3z45tyy4jFAQ7kNvwGMEw9h&_nc_oc=Adon2R5wjZKN6T8f5Mpv4dkLDn4enIGVjEEYQwiL3tyq0pSeRllnYbXAGn21vTWXGMs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Fa4tSYhOq96DAeykkjY4mYa1ysUcWG-Ivk4zyNzxCJg&oe=6A2812D2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8gDDgMBfbgQ7kNvwHkfB93&_nc_oc=Adqfb4hpItGPKtsUbc8_cjy-kbwLmv_7f85KYOV1POXaGLbJy9j10498jXEB2Fdg1vk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DBaDRofrcsKJxUU1e06nfN6A2bzIO-KCZr1WI-yIR5A&oe=6A281105"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzH123eTgw4Q7kNvwHOcwSK&_nc_oc=AdrFTPjiofYyKMMCmfgiskphlrSAeXgqbiEKR1qruuGPhY3akFdxjB8eiya1QjSrMvY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z-X_wi9Lt_7uSlev69_4ZuapNcJNRtkYBf-j6Oe6ZSw&oe=6A282522"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
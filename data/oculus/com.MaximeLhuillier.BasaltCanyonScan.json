t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6klBZaIICMQ7kNvwFjTdNe&_nc_oc=AdptyxfTsGgeQELSo1lILOqDplEVs31CvNL2GhsDbXa7HxoqU9uNyyiQsIMsGmCFSTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANC3syL3rMPzvXXVLQw0Q_PKsQdPtJbByW2M2cEXfexg&oe=6A6DF2ED"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9UvLNEeXOgQ7kNvwFCrOcq&_nc_oc=Adrlhzb04q41iKuARzfKKjxyC487QRZ4YaMcdII5sXSU2milTh_p-hYMV0py1a01WOw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCx3KSC3yaf51AjuP-zA3XkqzkCqI-S_uiXGQtvJQYK-g&oe=6A6DEA04"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7i_5fX1U2MoQ7kNvwEEiWGz&_nc_oc=Adrw-QvvwVahiJQkgVZO3GvB6ZqleKGfYNwVreQX908GVXFF0A9n6vEK5M-VzbxB6ko&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSYfZfh2Ig5Pw2ajXlKzwgvnyzgrENfxL_gzRIwijK6A&oe=6A6DF252"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LARJdrqVgbkQ7kNvwHzccte&_nc_oc=AdoeieWf70dQLwtnQ4dKLcY3QJll7aiNaUtSxfug9tAjGMTRckfqy2gkRBLl4-jwWJU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsoNc1mj0n6J9HAHcvTSltJclvPnR4stbVw83cVArl6g&oe=6A6DF085"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kjgf6ozm3Q4Q7kNvwEo3c4P&_nc_oc=AdoxREdfKKoCIlVjFH4nXjziYTYu0A5shHNBVswk2MES7RucNHiw-hBJgGi9qGnNCDs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOL7WoqJt4XXphso62ntZ5-I63Tab2lb7t2x36xG2JSg&oe=6A6E04A2"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lnlkMEFc90Q7kNvwGPAYks&_nc_oc=AdrgFrrFalfAwTKPMsg00DnJKxbwr5q5ccUktUMoAVvJ_bsJDMpbNMYKGE1Ev1duzMg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGidX57pWXixbxDegI4LWMZUVBqwgv3er2uHIDEm0XBRg&oe=6A8AF3ED"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKcoFN2q2iMQ7kNvwGveOM7&_nc_oc=AdoIjiZbV5BQh0D0yAuj-GcBnQhyPf9sDUstzw_UvxjES-2K3o7qqwnJSGOAuLOIDzE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5FBRicWaYb_oEORngBDcq3b_sUHrNOYxGjS561XBoLQ&oe=6A8AEB04"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDXuoghHldcQ7kNvwEb5gFv&_nc_oc=AdpQhXmO3HGWVf3lL1GLrWaioNhiwSq1Z4U--xcklXqqnFaEZbMsDYS1YvA4KGagk7M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFam5S_nMP-6Pgq3lUesKjGUEvLnhMRlnzeTgmWsN_aAA&oe=6A8AF352"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXZftjERGhIQ7kNvwFutBq2&_nc_oc=AdqDnU0f6X7sCilscDeAWcUudafBzqjRJ_mZdOP6UUdIty9ESUpufnYoWWqDiwU4Gvs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4lCxzX9Zj0GY9zG8t2tu1j1lnzVJegPYuQBCxMcwZvw&oe=6A8AF185"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZhI-irHatgQ7kNvwFsQ0D6&_nc_oc=AdqwocuFwVp07tmG6dpE5O_67kcKOGqrIrVjTtIgmGaX6GpC36BHk8wTnq5N_P-0ojA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGa2SO00kDcTGxVssiRGXiOQQQPJJLTMApkr_A8aQr4A&oe=6A8ACD62"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCSxKP1MIGsQ7kNvwG4Umkg&_nc_oc=Adoh5wusBLeXYPhaymyg6fiB6XhyFZ5kMsaumElnnh3CuvDeWWN5qwYdQqxbHlXLIjE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCmUI18At1DSFBaOlOGnIC_dUPEA98BGcPfwv2v1EOjg&oe=6AE88E6D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybt8WhcUXq4Q7kNvwGRDBAo&_nc_oc=Ado385p7iXctBELcE6pzH0yHpKl3uiB_MyRSuAuRFs2z242BKgqxFqZ8WEhmjfnJJcU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfp-jAfCUOR1KD10Y0MTxUxmQym1AotqFsKszdotTryg&oe=6AE8BDC4"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91_b_ATCUVgQ7kNvwGcHibh&_nc_oc=Adp3flIpwfaiawM2-8Mjeg8u6yX6Ue-pcGCzjvLQryKEpKqddM0SfpCSBb-jVQYifDM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTea-CAB36OPVNhwUgX-zEWU6_JMrQ0QR_jvPcyEi33XQ&oe=6AE88DD2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSBSAjIuXCgQ7kNvwHWMDPl&_nc_oc=AdrxXhgSWIrX5t4fpVH3bGfKQAhj8DMjfN0G2HHZHvtOHjyZNFZkx9CVwqzGsZ29vi8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUK5Bat5_OtDnTxG1gbdudtTBbKXVVAB1VCimH-hEuHg&oe=6AE88C05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D384s2xo7NkQ7kNvwE0ezHe&_nc_oc=AdrUEnzuIEY6kNc8WCROvIqGOI6WihXnGG601vPydPTAeLkI3sL0evNzbJofXxHJ9O0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY67KfIryEKY3sxYGhBUYZ1GSSCQCMW2bEwbN7eB6p0A&oe=6AE8A022"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDj76Il2UNIQ7kNvwEyUzju&_nc_oc=Ado0FXMfKPWZ9--5yCtj_2C9e6QoB7w7C8oeXVRjosfXfAic9peKG2ZtY9ALhv-KMDo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N_bGIgnwAsbNbqZ_RA7xw25uRTfUU4NaINGOOttZomg&oe=69FDE36D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UG7In7POJkEQ7kNvwEROjYz&_nc_oc=AdpBesePt6p5xYcgY5SZ3nc1deIs0TVrGwqF-UukBOiV9BUkX1SC-5_o0dYDjW7T8Ic&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tHfudAm1x1YEwb7hm7w7Wv4tVLOYzvOGDuaWhV7rzsA&oe=69FDDA84"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpJ2M9DcetIQ7kNvwFaUmEf&_nc_oc=Adrc7Lntu3GMoBNxuiKPQL8imgnTJb7aA8duE3ATMZWZVrzHqCGhNSBLzjuU73SM9rI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mbStWE83Lz9H7ToJjfibhUuXucQBM7pC0XBc-f2Ihtw&oe=69FDE2D2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M9JItiJkYMQ7kNvwGvYFEm&_nc_oc=AdqrFx0FVfuHGtZPepj7Qnw5ATAYCp_PIIWfSN5WbIstAzK5VghUeSz6Ar_DvsXGncM&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m1oRHpVQ0n41B8tVm7-F3-2xPWYAzDeRTD0ZwQlT0kg&oe=69FDE105"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkJH9Jpr-34Q7kNvwGTZa1e&_nc_oc=AdotLeOeOE6hP9Y-2VLnazNfynfYUVt4RB1fxkvoR3e9mGwLNWdtDNzCA0TTjHKUKc4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53nuWKKXplZertRe4fO_Y7RNQkbV5PYR6ehwt1c77Kyw&oe=69FDF522"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
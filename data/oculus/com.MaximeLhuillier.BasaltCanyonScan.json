t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOFruDxjFREQ7kNvwGIKkxp&_nc_oc=AdpEUO4z6uEbjTezSfqNDamHHNhyhoToq7B1oPVbBKlA8NJ0B-lSwvWwHniS5VcKaSM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TAXKIdYUCT4xuWbQlA-d44E3mQiM49FV9ELiN0NeJAQ&oe=69E8CB6D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fj5PiwySisQ7kNvwEMu9t1&_nc_oc=AdpBnxL7Mf0F9ww6JzvQ0Qb4cQ56coihQS6rtnj31YVWfOd5JDN005SmfV12YjwAST8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Yr7zyeAelBt5F0qhxUy0Rjxv6LFzKYodjBvauTISiWw&oe=69E8C284"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3YLrO-6OH8Q7kNvwFAXl6d&_nc_oc=AdoV9gPhozeIh20Yg6jj856gCNbr7MkplKKOxkWlbSS8MuByG9hFYItSiDIusy8dOus&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26hvpmkWgS-kYfAQbEuPATI6fjSX_Ks0yMoEIGUtlTZw&oe=69E8CAD2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkxlA-ahGhgQ7kNvwHzmXOA&_nc_oc=AdqzbrHnRrBslf3_f5FJ-tp9-t4Yc-6egvjgFYt35WzyBvfHY6wa_7MwyTlsBohiPDo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JmY16Bx_pY2yTLETuo_AuEQ27xrmNFF4jPuyX4Cc_SQ&oe=69E8C905"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8CtFq3wGbkQ7kNvwGBikYD&_nc_oc=AdqQmo29AV6SnfefmyxCHjDnG7xbdIpDfBPHz1AYvz0T-BIAZwDUmOwkadzmj-yDx_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19ur8WqZds5yTGYpjtwvor4s3lu9zTW8Nhe5L96lYI0w&oe=69E8DD22"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woFhWATAnWgQ7kNvwEutu6I&_nc_oc=Adri1a7GxBq0xUE_NmFjv6agtpzolbOz7YpMzc1GdyR3AS0PprwKYcqr2GTACIV3mJU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1B1w18ez4rSFif9l8zusDn9eJwrBmXpOXB0Rwabf4jMw&oe=69E6286D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w468ZhM0BM0Q7kNvwHHUiN8&_nc_oc=Adol2YWnIVWOdmIaIWZH0CmNKq30ZSG2CJ0tLx5u50xB5EiN8l8v5UhsnfZW6-mMf8M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1V1OQ9nAB2aI33cT99dKrtxfaqrUqrkHzu-tcDcl0Lng&oe=69E61F84"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0K8d-pHCFBkQ7kNvwE4WcQD&_nc_oc=Adqe8xpAqbYQqYuCwZSwLCRTNjLARXY3_LdffkOQmnB_O7ggE8ZtaPyhSAHt_15Z_k8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1F53N69oJA-P5Vb7B_3UUiXGTh3XxIz7Hfwc3M3-qOmw&oe=69E627D2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gni1FAQuuzwQ7kNvwFdd_Oe&_nc_oc=AdozUiPTJWU-UzEyHPwjQGYdo0muQ5PWARIc-3l-yC4GE_OK4uDrzwAEKgfGW83JfOY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XLs72fSFw3PpU0SfKBB4sSLYmqEouGvkNWV_blsDP1A&oe=69E62605"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8CtFq3wGbkQ7kNvwHY1vqB&_nc_oc=AdpKeYf4SvxTzHfOAEq0Dmv-mx2HyZORjZC1j0b7ISbsvfLQWIQxEuxCZcQ-Ptz6Jz4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vlxmw6ZLozZzYe7v87XR-RHUo8BBw_iKBVqoQMaxdyw&oe=69E63A22"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
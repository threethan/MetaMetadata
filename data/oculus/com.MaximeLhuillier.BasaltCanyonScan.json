t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSW-CnwRnNUQ7kNvwHerDsC&_nc_oc=AdrpMcgty8as2-DGIquQHBYsllPJU8ysg1jI0AXlwWO86p25-9gKtzn9Zbes2oeJqsI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6ryW7OZRME9FHFsr89yJ5Ze44jOvGHbJGKD86Z9O7Bw&oe=6A5A2C6D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCopHVL5mBkQ7kNvwGCYJBY&_nc_oc=AdrnloPRRw8AOlDBtd9cKM1P2u6DJFiZgZ9O32ffpvL4bp22U9YvMMg74w0s2fPySZM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAyWo92qBHdeVHoM8XDB-v0g5LLvNhAawRZFomM22nGQ&oe=6A5A2384"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioBUbE25GpUQ7kNvwF_op-Y&_nc_oc=AdpnL5z3LpgdXN1kgMkfIRprxebHsHybd89ESl_dkanca5IQcLuJP0_O3_O37dnbPCQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB43EEbIYIjN2zBLYyApTiquAic4rXptFmSi17I3kNZZw&oe=6A5A2BD2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTbJ-9N01nwQ7kNvwHk_cMi&_nc_oc=AdrFTE1cQHKERhcyAgq3Wv1U-dMLQaXDvTwE-bNmkTPs6i3J9qe0C7rLBsl8-gyfH_M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMDh_J1k5nbaWPCNTjGw3ZUq0VPHF6960nrMS9OYgcWA&oe=6A5A2A05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyTSwI3FvswQ7kNvwFXkZvR&_nc_oc=Ado-N8JLYo_-RbpFh_rAEQblqEmtJYR2NGiMS1chQz1PsfVH8PxvlBBNUB4aLwpvC00&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp7mkXrBI0xlAfGX8hFTTjS8_CzOpE_CLnkdVYixHm9A&oe=6A5A3E22"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
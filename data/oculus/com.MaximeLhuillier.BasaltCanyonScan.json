t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7tAJq5MoFkQ7kNvwGmNLDJ&_nc_oc=AdqnIt1jEJZxn4igFv4o1SiVFEtekdubDCj_nViz80KYQgU-sQv7tUN7lBb6AHFsFL0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4D61v6Tgfu8e0lkzt4H0q6ljalUMLDbjDv3Q-0PxYR4g&oe=69F9EEED"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXv7bKcLaKIQ7kNvwE2nAZ2&_nc_oc=AdoFN6rqx0Bq-9xxQB_5rtKJkL-kPualhSon-vFE1scq4qo_NVJ_xWsvkswN5TbKMkc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mktwTnFQjmu5wzyKA_oQfgzMqN2zDxN0dkJH5Num8jg&oe=69F9E604"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUX8cckywWQQ7kNvwGyVi0h&_nc_oc=Adp9YR8a2YC_lk2-vuyjQwTrPh06DXtsPlaoqOCzV2iaPwb8usuPn7P-tS0-4YNeN1Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4O1bLrDqlwaihuYSM4eoWsabhMh5LVSVuygPONWUKVvg&oe=69F9EE52"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-3da1871agQ7kNvwFkvrQj&_nc_oc=AdrG3o9BgtrUSytRU5hfPaY9x4bRL9awEhC5ISgwXY5XWPG4sGcM7pjZ8KpdzJ_OnKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WmfMipnnGCPHrTeQ9Wl328bR1AKtwSZ5vIFTlcbD33Q&oe=69F9EC85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRanoxVP29kQ7kNvwEHlQaQ&_nc_oc=AdpERg-fv_JlSsONzBhrifXZHi_1-LxXBkDfknpF--RgeAM83ZFDWWo20M_6t2AafAk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fkAWGeAVuQvm_6jRUGPOx5GP4xuactxBnBiJ5W8sfxA&oe=69FA00A2"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
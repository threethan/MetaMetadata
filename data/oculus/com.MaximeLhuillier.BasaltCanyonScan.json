t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8lNY74LRWsQ7kNvwHXZczW&_nc_oc=AdpASaIL4DQM7k46xQKR8kfP-uX7qIoabSREdvYeC_sDvKrmn9pEhvXkELMEfKCEXas&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ck6mRLqCSvl-GcKfguzvJWuy_j1BPMBtJZ33ARgzIOg&oe=6A45146D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUmn-7xeLzMQ7kNvwEeIIfd&_nc_oc=Adoi64sDRwcS3dPEoNvtieX4D5KryXz0tvFxIgWGwinPJF8N9qDg1DHaPU4-Ql55Pp0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GudVLvj9EHum02jmInSfEGqTg6PeIOA1xYZRvohdu6A&oe=6A450B84"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGxVAMVPxg0Q7kNvwGnEydk&_nc_oc=AdpL9L2JhF2stVfxDzVWJcL0_hEmcXgSbRt7PHa2HnZMu8Am7Sjx61Kc1Plx3lmJArU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DW5svkO_NPaKuEjbAu-Be9UBf1V7ub-hz1YWS7g1Rwg&oe=6A4513D2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0X_AqwOFCAQ7kNvwFzvGt-&_nc_oc=AdoMVVquFgtsfhh5aLzQgRA-o0wBj8mM0G_v0dyZ81vCW0Qi0lU8DA3wO6Ma-8dODig&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92ryiWr9zCD7GSTlQL_wehPJws9QsaCrX4CBrAG16W3Q&oe=6A451205"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BRZbmKObZwQ7kNvwE1UjoA&_nc_oc=AdrVJyYjIP2TJlMhrWyPkSYDwXulo5QVDqugnUhbCDmLFyYSiYaGu-PVlu-UZmIN0q0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wYNTi91QNEArgVIDZj6hRoD7n9fTbLdwY8k7X9UFd9w&oe=6A452622"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
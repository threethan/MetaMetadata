t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGvdEKnkTf0Q7kNvwFioFjF&_nc_oc=AdpeWPO5hn2aVW5NiFAGrgM3wesWa5a8up4ZoPSWLvXiDqd41nqpG9QW8PKyLXF98pU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1rUtolaRk-y_HWK6wMV7-TcDO_IOJSiXj3mN2qiyroQ&oe=6A942E6D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuPvZxGYXWsQ7kNvwGWKInY&_nc_oc=AdrQ1SwzEGc81pwdtpyf_4ULudW6_Bilp2R2ROzLCvHWyps_KLBl0JxpZZoxvZw4UB8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFUq8wCiqtQesw4l6I3ot4B9R2Vf8_39DFhGr_BrxROg&oe=6A942584"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyI15X0NMaAQ7kNvwHD3fKS&_nc_oc=AdpsLwQ6_DaRhKQijIYR8EcVHrMiNxaci673euRn7q-EcD3h9WMaltFhjfDTc23xDOo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjfjHjV6rjmAfijeX2SCj7Kkmiy-pMKkV-vVDLtJfeWg&oe=6A942DD2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYkPQcOC6Y0Q7kNvwF5m2AU&_nc_oc=AdoDnAZn4a76J8YgY8c9a8Hct9-uH_pqd3NCFKFEYF6VVk-mEckSLxa0fMHy0KNnldg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElLsQfe7am9uUbBc5eh7ZBiPAHmVOzSbOe3D5N73O8Mw&oe=6A942C05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExLW6EflPr0Q7kNvwHlzjCe&_nc_oc=Ado2w6Un2wAWkZOT3ogIQPrYkwr0KEUbKAghfJ2ijc_w8pyFIp-GZsrLNAkBFjEK_IE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1P2dZghT5TMvei3Sjnh2lWyQCBUqjkRPAYOj1M43yTw&oe=6A9407E2"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
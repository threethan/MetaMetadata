t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLjxkCglasgQ7kNvwG-pC_L&_nc_oc=Adqyue5MZDXUfHBa2FrUO1hiVWVt1gyKxiQI11clgDI4TKa9N8f3mIbD8wCWDBK3h5Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iwUuSOlimJa75_BfxOkpXjRYXHonFfEBoukqHDp0NBA&oe=6A3BD9ED"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1074Lvz82sQ7kNvwEV12H8&_nc_oc=Adr7gxVcdn9RTBCxnvJ_zBwm9xiglOpMHHS1xgDz90cg3iOFisk9dO_y7DJvG251HqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fHcD6tbGCxvOc2Tj1m4i6u3bDhWm9LazHmIYu-rJxdA&oe=6A3BD104"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1h85prGX7sQ7kNvwFQMjT3&_nc_oc=AdpGYiPZsOpSKqpUZLtZUG5OuNeva2sDV7PbXcRhuYqT78YOs4A_rOUp_LK6QFMs4IQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_csiOXNybZg8vJJU5_E_gaqHkcE-nNeLIjfAocOryBwg&oe=6A3BD952"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=014sfdRyjy0Q7kNvwH7lu3-&_nc_oc=AdomTZIwNpVxjuBGl3VN3WENPbcNoZvcX3hReQNsGYr_h1R6HoINhWwINeh35iaGFHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83Fx8sJAqLkWZzi7t7f7HMLvadx10hOd5XJKjSERiEMg&oe=6A3BD785"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoKMnzRshaYQ7kNvwEaapB-&_nc_oc=AdotCu3jMAoiicGM3m0aiqrhnrxEOVNn7hoFdzc-iuAFKGNL1V5q8sSGuWphXbR1vgQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HYswjjr7eUTINTMEHgsig6iXGOMDo1rB5F-Qd8GOefg&oe=6A3BEBA2"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz0aodSYPEcQ7kNvwFzBGlp&_nc_oc=AdqRb-PE1MYC9ZpoG3Bjn3yhk0mvmGJmq2aIDkYTbMkBZtFdgZTKLr8R9zEtG7ipvzw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNYLoLt9QgX_3hPJxUTMY6H4pCJ7LTKWi678bJ_p6bBg&oe=6AF5F5AD"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JVT7JJaScUQ7kNvwHEwqGJ&_nc_oc=Adpb2c9oNIC0tN7HHr6n1HJRtKKQKzn4xIb3Fd8fgkShuhv4kLvSOzIIJkMcH_-DsK0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-DYYZ5IFExQjyyhxzSpA2s5SvoFnuMm84ZlijarqsIw&oe=6AF5ECC4"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXf-NynplMwQ7kNvwGI2Ssw&_nc_oc=AdrNlzRX4SNnC4Ery55eD_7FVRt18hSCDZ4Wj7sI0W0yrs44TjYDwG-txsqsJAn7CW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7S8MKytG8sPl2EWT8Km6Zc-0bNC-ld3BD1uIn-SEW2w&oe=6AF5F512"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jkbYylYbYEQ7kNvwEkNRii&_nc_oc=AdpEZoOE8aT92VEdThL-2qmbR9syJmU4CC6ujKUQD3xes6nUYzXnJhiWx_sghIJGNf8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5ADXPTyXySKA5XGR_hu_0qMadksrc4iNZdE2osXTOdw&oe=6AF5F345"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5hYaQ6wjkoQ7kNvwGGVmZ2&_nc_oc=AdoqQz4R0tUzrzrM3nbTdJnCvasS2UK1OGzaKfF27krhPlOb7Ms1EG4XvWX-Usvl7hw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmFd-YALtIAYXS1FI40VNC8TaP4uZ3ukkUIKcvbghIdg&oe=6AF5CF22"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaX_b3M14AkQ7kNvwHwzOf1&_nc_oc=Adq6jZgJ0U1Z5BN1o4BcplA5fT-DwaQtLVApMxlGDVVOUDfSwxlKgoSt_79K4-WsKiw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmjOMYFNVvmC0ReX4oZaJqnWhxbbKUYiRJCIXuLPaqFw&oe=6A7C736D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4p2aHHS4moQ7kNvwHKShAr&_nc_oc=AdoJ4aoNuOJok5VanNXCGatCQRwmr_pijSV2X7iXrIbhJOG674npHDfweInYyF-KUQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwM7jkNtg9-UDpNlU7C89-LHhgnjR3_CZnZ7TW3NVUeA&oe=6A7C6A84"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmn_qh1WX1YQ7kNvwE2Mgul&_nc_oc=Adrcz-DhCLH5kEcXDVoeV-yfAYWwwWZCu99rn4IkofG4hoG4foFQVJkxXgNmrbVg6mo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_sr3z2ePquuedTuX_PMCzEJYdDh7o8rpZUI1XbWZw2A&oe=6A7C72D2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kF61Jwm5qGkQ7kNvwFYORpa&_nc_oc=AdoCskO6t_7F3yHzYjGPgXLfpftL2WVT3XM156pM4CddxdnpCfsdHezd6aTzeRC3bLg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbTYiAO5QC_Z2mgRy6erjEJ0StlSI9_ukeGzF--0kf4w&oe=6A7C7105"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0gxOzuAVlcQ7kNvwEi_G8H&_nc_oc=Adpws3T9X2qpRmbiUvLCQWlLlsV1jblQ2cZFctGSPjD--aP9ZgNvm_aV3lmQRh10oCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSER_CXoe760Z73_6w_qMN87qBda_apWkHW8HOG4Nzhw&oe=6A7C4CE2"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
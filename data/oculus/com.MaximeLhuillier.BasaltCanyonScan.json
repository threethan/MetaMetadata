t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5pJch7R2BcQ7kNvwFJxjB8&_nc_oc=AdpyB24cgaEeo5fwAb-Wrjr8zBq5CDo5i2oHkC6sxbTyL7MTDFH1-RhvH3wGQO5Fpd4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Djh8sH2X7Kia5HTdeWnjbINpmotw-8lBfSDPY4Tht8g&oe=6A0C63ED"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAhvncMPZNYQ7kNvwGEwHWb&_nc_oc=AdpK9Bcr_bJrC9sc1b1l1ue9-d8Hfb-Rhvb4Yhsm2ro0ngOXAsPDH5VquZ7v0hKw7og&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hIGzHsziTs14dRutOahNgn1E56-HvYSCv4d0uMroOmw&oe=6A0C5B04"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9tlt6FfPngQ7kNvwGOcjtu&_nc_oc=Adq5J2vrqocHUyKV8Q2nr8FG97f3xowDSQ7pq2pvhKYcky1MBezr4Xicb5JKdl0Gpzo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QsBaZK8rJNDr1qTKsikZcXjYXtgylMtJBXARd0vBdog&oe=6A0C6352"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAtEqM00SusQ7kNvwFPebdD&_nc_oc=AdrG3LwKNJCErKyKy_aCvJ6JKCPWmFOnBCsO7F7KZXi7yArfrd6To6xn9rdU9sxXJ04&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4glkH-aiA7rJ57BKObBFU3x5Rv6l17V-bk2zyOjXE7TQ&oe=6A0C6185"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9I2nC0VL3QcQ7kNvwFgzhqF&_nc_oc=AdrSn1TSghXxJKi7p2grIfed7p3bRdAWjgLEswPYsUNB_yuKizCsjYW2VQo6McLRdlM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OjMd1YUTKq9xQ3Z2oLJbG1XkSjbTCZpbRfR6Ath9omQ&oe=6A0C75A2"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
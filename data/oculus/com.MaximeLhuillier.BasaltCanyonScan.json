t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pK8GcaezA78Q7kNvwGrfjkn&_nc_oc=Adr28m0_QQ9WiEkgkDb8H1EJC_yULTgKhcKL8WtC3HTuwzhbArWKEmUN4bffAG2b2kY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGVs389TohBZJbQkvCZMi5YRQBG8jQOe5y416YOli8aQ&oe=69C9276D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bkhLeXTBeUQ7kNvwHF0O8Z&_nc_oc=Adq2Bwljo0822PFJ78Y0Iv58TmR0JvPQU6yEsNcr0m2FLxyYwjowoy6GiA81IY2OhZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdRG5QR-pveNLrJDtOyfA849tBlGkD9aXZ3Gou_W4qXw&oe=69C91E84"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7U7qdFRdEYQ7kNvwHurr2K&_nc_oc=AdriRTf1S5zQ0-xcZ4zlTdrl_4b37LV09qnpBFTlNuDKLHRISo_vPUBu0Rzow98b3p0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOr3vD9Pagb2luvzWqibvSG7rtKIyzvaRafAmsPBI7lw&oe=69C926D2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0xvvEEZ1mkQ7kNvwGx6w0k&_nc_oc=AdrSq2sLOJP0sn3xgf2Licch0NwyfG1axAB8uG6z0hrc-OP7yGX3FGvRVHu3SDCOLxo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJ1PNHgosUpdGxko-aQSPaya2I3u3QH7xZ9sbT_kMwRQ&oe=69C92505"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGnNigChTlUQ7kNvwG6D7v4&_nc_oc=AdpjpVzxD3tiDXdSinGGAimO-G-oMkjgBJg8p5xqdhtKpCWYWIpKrTj7b51Z0y3ahqE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYyAWevAIwJfr7ebvNNuQIGpWEca3MeVzYKLG0VmOrfg&oe=69C93922"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
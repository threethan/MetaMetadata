t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExA1avvAFj8Q7kNvwHYdoQE&_nc_oc=AdoKNW5pjpTnjoR5UNfWNIU9IjtbfnOm57jDKR35OrfynlbJ39_NKrA9l-2-Fib1rtI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7Lya0x3g2IB_67Ax4A6XKHHCZ1k_EBq5JCtckZCELbA&oe=6A9741ED"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LccpmTycUiEQ7kNvwFOqXDN&_nc_oc=AdrQCqtQlSwt0k1zl3E_8PAvFc7N284ZRX_6flPNgzaYhxW539ZJPgwTBiq5RajIsoA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcv686jf_txFMgzwARET38bYp3SP5H7X-88GWZkVzKeg&oe=6A973904"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USxil0Sun9sQ7kNvwGKfJgm&_nc_oc=Adom4bPhIiVou6ZeGRuiD48TQfBADEfckbuJNgPDFjsq5CbHmM-g-pgnVVTF_lKlCTw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGv9okgABEiuMD9dTBGDfD85dNjQzosnRMvkyGkdu6koA&oe=6A974152"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tiu6IOMxmT4Q7kNvwGI8uqq&_nc_oc=AdqGBUEkbNK1E_bd8YQEQ6lUocDZa2ceiuxXnANLv3MS9wGxFunNbG9xJ7GLMwklV68&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeMZQXuTUeA9RltCa2h3ReOtNttnZyaK7GUM56CrjXMA&oe=6A973F85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExLW6EflPr0Q7kNvwE8J3GS&_nc_oc=Ado8419qBBA_65eHjMkwW54NVMd3EkW0cJQWrhtEkQdnts-WKTnF2t3zRsG8fjmsmqA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFr7VkTzVFrltd3zB2Yz2xXVBbihGVZeMN37Jph0prc2Q&oe=6A971B62"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEnfhZAOqzQQ7kNvwHFjiYC&_nc_oc=AdooyzcUXrtp_4spKEtpuBB6Q0_XMf4jGZrE4UipFFucCwFWc__YYHOQDFHAo6eGg4M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8qGba_nHtLTfdwtOOYfJ1x-m9tYgi2VJzOk_eeR8rOQ&oe=6A5CCF6D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqPCuyTKPDEQ7kNvwGmssZv&_nc_oc=AdrkVSEHvgjeI0JBKn6gqwT8_Ocs0dAap7G4zs4o52okG8HgyvLanEL_1n8hkekLyts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO4opJlvLHoKIA3W0H_T9RNsPBdIUrlcnBHAWmc33zrw&oe=6A5CC684"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioBUbE25GpUQ7kNvwHIYN1Y&_nc_oc=Adruif50mE9xdcHc8eSi9e5OpD9LGSy2caaU7tyxbNMcZ16IWthyaWeDpQPTgWkpGVE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMBEH4GJII59kpQppNM1MgGIuD9sN9oxeBGI7_4an5Mw&oe=6A5CCED2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXMK_vsjcK0Q7kNvwHzkDMC&_nc_oc=AdpKd9TZyWjf5ovWgSblgyGKbdO9W6VQTLfhghbwUn8XAHuUSc-GrMDJNxJ3lGJHW_8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6F2muGSFNl9g5LnTOXT6orc3wAAFv_jQ7-frtT0A4fA&oe=6A5CCD05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHLmL2FBtZkQ7kNvwE6f8hR&_nc_oc=AdrBNG_oM7IHmEGFMz_xq2Hkgt887QaIfojSVBNwje8AKF8Hl0QEPAZMn5veZFtaglM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1pvH85qho8w4CSmXv11z1ghRubNIJpuUp7dwbYiFYHg&oe=6A5CE122"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
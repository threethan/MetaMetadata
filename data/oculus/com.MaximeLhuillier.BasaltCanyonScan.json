t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnCcPerV23YQ7kNvwHErPQL&_nc_oc=AdpsKrEqXXVi0KAMMCcZtoca3EvaruA99L2lRvp_M5IjytjxkyloLNUk9NqARCifrI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk_0GTL1Tmr-P1ng_1aqytY00v9Xmu_3--n4fEap1kZQ&oe=6A69FE6D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYgq-Wa_yzAQ7kNvwG1ulgh&_nc_oc=Adrpr-IItvbpkb8GybY0JwSiKCC_59OYTUQyEEffXVMheS06NFk79vwU8LTC14PZbVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB60UyUa8TLCjOMgJ5xsb8Yn3Co6jk7Pwt2xlLt0UEEgQ&oe=6A69F584"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMHlwAAzn0QQ7kNvwHSdJDm&_nc_oc=AdrLmGpMPI8OwAPffXnTQKv8X4qvjS8Aj8260oKeTODSDBUD5CiQm4YIJIDrOWdV3No&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPIROsyLk4N-pGhU9C-8JPpY7JpbVBUTMaKE9OJrKIvw&oe=6A69FDD2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhAhFVpeZNgQ7kNvwHQcUC9&_nc_oc=AdpJ9o_inBG7-He5hixMws6jUgrIXL2x3yxzTqO_ophm0jrvpjzQ6ZeBhV6_4KJOL70&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHHbBi5wzMyfaz-uFvfcWtITuLTGj6xvBvQTzW7iZPqA&oe=6A69FC05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j75W-DmdvOEQ7kNvwHhXq8A&_nc_oc=AdoSynFB4WmMJLudGjQHuHDPyosJY8UMIjHuecVNMRK3PKmpQauCgsLLuPjCFgW_JRQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJGgzeIq9AhdN_ScS_5FVCOjNF-CHsXytUiQZtougAng&oe=6A6A1022"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
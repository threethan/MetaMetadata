t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_vjZsuicgEQ7kNvwHAV0Aa&_nc_oc=Ado5DlcFgPs5aS8LI-A2f1KwFME8RDHBWm9GFn1tFjuirYL-qFgEHMjxNjG7OI6gVMw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH42FPjlb3EJ1jHDIAKTdooNaYWKFfRxgCOV-cTr3JqQQ&oe=6A86FF6D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkIzK9NX5yEQ7kNvwHnXAcY&_nc_oc=AdrFO-Gw5YTQLJfihHw5hyd7DQ58xEOB6orY4dGimCex-XjBb7wR0VBJsRFlszE5XXM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFV5N-5_S6pxJDwt-gqx2HpE5FNMxPtcdrvawhzyyJGOA&oe=6A86F684"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrXBLYFH5DsQ7kNvwH9jjf_&_nc_oc=AdqWiELvSVzEDXVB3U54V36LYUpwvUJjzMp_dvT6C2UFvlrQqIX64bVrM3b1Vmvv0eA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGju4MdqccJ8k-o5D6eke1tagyDdhTSl3FllLnTDtQJcA&oe=6A86FED2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwihOoRpAM0Q7kNvwEVeSzf&_nc_oc=AdpIdJmP05-D-RCyrTzMq5Ck2iJNs6NwlB3iEL1V2cCo0xvpR991hlAznrowHCLuJsk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb4bgwHxXZ8ZmKn-YPLKBkcinC_-KDAe82Fgd8yqCG5A&oe=6A86FD05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OG9SgRaJ0x0Q7kNvwE6qOUj&_nc_oc=Adrx8p9s279_hFElIJPJVWvkSLe0LFveO7IL_HITsEaEsrt8QtHfLHViYHYvX25axi8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMjr5LVf-YC7F2LtuWmDn6n7yZbhkzBoSgddOHjLiSjQ&oe=6A86D8E2"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
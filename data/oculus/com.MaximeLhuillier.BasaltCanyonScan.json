t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dY4ByHEpXA4Q7kNvwEj2s0A&_nc_oc=Adp7W9jmaZu2p5dq-5KG3NarsZKWYWObaRPDZzA4X-qvokpTJzkaHdKXDyVhmX7Gupg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Y3wX6x68UerDZezNtSp7UaKUv9CTOZngrU6XwNmirBQ&oe=6A047AED"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7isy9uzIEKUQ7kNvwGeRbo5&_nc_oc=AdqqCPioIrQsr7WgBUJVyJE8_h8SI7RPjovC3WupRtZhDr5jEdp73WsoyV0pZD5vpqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MimTBLH-iD7ryfd_2Vbla-236kw4IjecDkB-eqmOuCg&oe=6A047204"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgxt-ZM2Uw0Q7kNvwFYVKB1&_nc_oc=AdoEW7RegeEx5VEW80nssMLB0VDrdP4TcND5cb6QPA4sVkxglbsuVE-EUV7lqZXigRg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dbTaQ1x40nUbh2xdMBLmvr5GJlIAnIWRrSP8kgEwP_A&oe=6A047A52"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8Dw_26yLacQ7kNvwHOrw3j&_nc_oc=Adr5OJPxyh2eHx9FUszaNNErc_rqFEtE9V4PpGYLlV4rDQnI7A_9e8WuztC3qJvBJaQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ckgQIEBA1ertPN8F1_GKdTtDsM4A7iQ0J6xZ0zn3Nsg&oe=6A047885"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzHpeirGzJ8Q7kNvwFoNev0&_nc_oc=AdpNDEw3AvQ7hU7NaEiMaDyL-JaZmymdsNi0Ai_Eamu00GKkyQUQoMiSZ2w4KS0GWUQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y2Clo526DWn0T9XCxr3-YnVC55Py09t6vEwk7vHUAQQ&oe=6A048CA2"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
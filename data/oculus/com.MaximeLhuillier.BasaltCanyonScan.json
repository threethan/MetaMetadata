t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCSxKP1MIGsQ7kNvwFd4Dzc&_nc_oc=AdquICeYT1XLFPCFknzy8So5-8-647OTahNmaF6E5MzVo-7gwwX-JakczI6vWzdii9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlnsE_WJ--wZTpxeMW6KUEwtlXJgUe3aJU7beV_MRLeg&oe=6AE73CED"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybt8WhcUXq4Q7kNvwGcDz2B&_nc_oc=AdpQQPqx11SLBsDUJdBmQV-ijWfayRbHZPLGaAG-KE2xXqZ-HNyzOu-mEfzz5Febsy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ0Sx4XXCVqnPVpPo-QEobf8lZpn9aEnoeiLzFaq6cqg&oe=6AE76C44"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbcEHQ0HdUIQ7kNvwENjyUR&_nc_oc=AdpRDRkNegJ8QzEeGcr_I0sgZsbx6r1-dFyn1eSGhzhecdhnYyZPjxPLgnFbdkvXhy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvQ9DADvPSlOS9cduR1aEgC8gLbRMFw_uvkkTJp04AZA&oe=6AE73C52"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSBSAjIuXCgQ7kNvwH3_pdo&_nc_oc=Ado9JLQr3Fv5xLks5LBTu4i8ns7pzyxLsskstaFiD7yLHlN4DWsZk3C48-HlciIi5-U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUn503lVOj9D5ryEMNxuTc-vqnq-5YbmIdtfPXsaM70A&oe=6AE73A85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D384s2xo7NkQ7kNvwE_qQd2&_nc_oc=AdoCNB-9GQimgsyaHC8Cz-RcNOMJLKAIwmKdgFlBI6GauZ2gi8Gfcx0jlF8-NG28Ohw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWinEZhzabtgJutophQXkNNsMu9wKCzhDy0cwH1WrRqA&oe=6AE74EA2"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFtuSMDGqJYQ7kNvwEyx3le&_nc_oc=AdprfocM-_xLJKNDRw2htlUgmUrE4CyQ9FdOxm4vEWYw1Jmq1JtsCiSoW6HsAnVH1Fc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af838_nsQxsuoUDtcNXdgNApaKhf_ul_cCBntqI0BgZ3Ug&oe=6A241EED"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvalrl69MN0Q7kNvwEEzGU4&_nc_oc=Adr0GmvKbwFAcUH2XAzMwKfcj4edPvCC1maoVH3JiHKeBdVAl1XeskhHDO7YjfQvpik&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HhYVrf3_JaekHk3rVOpRs2T7Fq8cWMWJMKilQC2lSlw&oe=6A241604"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2Tm3mwaT44Q7kNvwG7S8s9&_nc_oc=AdogOMxsF7JyixxWc82XYC2VxGWkjZInXFEpWd0qmFW2tFrOKjaDzsdE8t-cocDjUhg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-rOjUrZguHHjtWSo6GEuqs_GCo29bUeBTdLYFZGtXfw&oe=6A241E52"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDb4C5SBbSkQ7kNvwEjSYfx&_nc_oc=Adrn4NPxK4KaiuYNnQdU7b-fi7rCIMOVO2T60vq8Vcw6rMpmfwTNNFGTU36Kgo7ZxZE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JizsP_BVWamZGNiWI_kGX7ukBBh4gWSVOLqjIbeovkA&oe=6A241C85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkocupsXLhwQ7kNvwEhfy-W&_nc_oc=AdpuWOnh728n13EhENfCTUiI_Y_kl_b8Dyd3S2MRb0hK149fSfGNfioRaIDwpqcfjPA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B1TL6dKokh9jM5yYcu7ybi4pRQVxRU5O0ee4TW_DDKw&oe=6A2430A2"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
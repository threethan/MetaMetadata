t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foxFgdPe-58Q7kNvwF5edXV&_nc_oc=AdpM3QYAGW1NnSCRrraU68qCBqQdced0psYC6CFlkVT-srXOdFRe3eYORPnP9o4gX_M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VTZvewKT_ff07gK_PgQZl2H5FLlaF2TZlMXVjYhBStw&oe=6A1C35ED"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SItEvnYlelwQ7kNvwGSSChp&_nc_oc=AdpLudlxgMxshsy1YmH3HrrEjab2YhlxnyEmmqo9JDbcZxXgpftKK7YNDk_F5I93H60&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af436quCiVDuc84DaFRvlCr_4BWWqf392yaSl9cVhT0tWg&oe=6A1C2D04"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xoaibfl788YQ7kNvwFDRFRe&_nc_oc=AdqkWl9wNE3b-DFdKJ0QMILvcJnUrsronN5rWmfji42dKU8VDQo4Kvb-3G6_jmSIaAQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55Vn6KEE8qU8b3MsuIsQw3nBGYqgzlU1GqcKDQhQmkNA&oe=6A1C3552"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ipwo6favwQUQ7kNvwHDtWOt&_nc_oc=AdrGJExv-7xUsZ_bY6s7t50NtiEo2LRjYjbCp5x5Es3frrw_RmsXDRNElACZTErnjXA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QAyOTxAaTGKKLMpZuI_XsvSsp6ZW0gNhM99iJTtoiag&oe=6A1C3385"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JL4wfyCl2_0Q7kNvwHeoeOY&_nc_oc=AdqjEHtyt7Zu06i_N00E98VZEHsE_t32gR4qQKnbuGZr82qSgyW5jORSCganP20Ebkk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5neoaDMKgRS8GnK1w7HDr9mCV3esMZLxJLeERXXHvLsg&oe=6A1C47A2"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
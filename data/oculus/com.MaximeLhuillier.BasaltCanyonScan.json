t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faUc0gXZPCsQ7kNvwHc9Auh&_nc_oc=AdrXtYSUrnFqT6QkYLcA2OJ8Ab5htJORGbl45LpMZM0icgglg7WH_SJJzCnwHYh2nj8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK94uXDVpINQ6IuDBCp8OGNlNoueCGQqA_j-G2WGFjew&oe=6A9C176D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bybo8OsbvlkQ7kNvwEVyODl&_nc_oc=Adp9wr6JWI8YHqjQkVfeP3opZoamUbZr4Ba0qwkIlNc45GiBcuIa1MyGOVpRnkkCWoY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2zhEZiQ82MSiXyILsFJIMtDakaxTI2DjCezFItZQL1w&oe=6A9C0E84"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_wZKubcb7YQ7kNvwEnY57R&_nc_oc=AdpO2agh5n_Jm-atDaCu72V-iJakzrbbD_Al_fadEtFf8q5AMYhlRtbH14XYicShaEI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm8C1GphJAPoEhnoFq2mz0MEldKDZvSZIPrt8vhKDvsQ&oe=6A9C16D2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxKF2PAxeJoQ7kNvwE0fYRS&_nc_oc=AdoQueoNUoUsxZv-Yz5Td6QC2vKIy-XGSxUFr-qN9GGpiGdMIAnTyRP75IV_UDKBPxk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtAuZTgwA_EsS2zH9BkcP6-TA_N4Mu49jK_XkyagLd7w&oe=6A9C1505"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dswNlDVj9asQ7kNvwF81z75&_nc_oc=AdpMxPxTk_w7xQ47hx3lwD7uVFN7jGL8XaBqdaQZ40mxFejonRqJ7Y6PMQoOMIFK2EM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfcfNLzCTJM02VTbSQQ2SqEcfESAMOiIN0MZnNQoFzuQ&oe=6A9C2922"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
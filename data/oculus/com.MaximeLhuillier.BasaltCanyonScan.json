t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cN-IyHbK6b8Q7kNvwHnhXv6&_nc_oc=AdpFeoG4BxPTrQQTYzpvaqD00HzJhCXGzVRLfvvAhP1LTiTN8ZXGdqyPlqRw1tRErS4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zPx6LOs8x6A6xsJxpmXjKK3TDo9KrXq8R2GXk0O0bCQ&oe=6A10586D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkBu9ppV24IQ7kNvwHqMx7N&_nc_oc=AdpXKj3tKhs9eJzBuEaiuS-EqfPvTOeCRK9YPVAAXm1YHO3u3-Moch3nO-Yotz1TYic&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xpY4eJL2c3Hpv-TGBd5usqjzqxnMZtCoLI5iHRx9FMA&oe=6A104F84"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMm6i1lzvdcQ7kNvwFC0rXf&_nc_oc=AdoNpwzlPBJgPWpntD2pFgdR5vf-issnGGxaB25CMi0MWy01QiKIBCnYK6CNUVDGkRM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a_scHrCgIj6yyPJhCgf101Y53S71T9zje9TIK7HWcQQ&oe=6A1057D2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mp5PIM7hSxkQ7kNvwFt3wpO&_nc_oc=AdpIvOh8mP7PheZFfHHtnyqa78tiamTPo3_x_Xko3JeioUacbhNWi6vC9krwEpcVUuQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r_rwzgi0i8oabIY3JJUQfK8Tqd0VqWgtJvm5tWL6wig&oe=6A105605"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vo9__fuARpYQ7kNvwFLgWBr&_nc_oc=Adr_dRTQ8Z5WyTKVDKZV4LE0Ne1ZHpoUXkc5j6KwrKYJ-4T2tRFkEwQGZWJSyPvv8Is&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cRZQbdDY71fLd5gOFD3RdWiEHSCxJa1YYIpxd8Ft4fg&oe=6A106A22"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
t=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJKZ30q58FEQ7kNvwHOgj4w&_nc_oc=Adp44A0768bUS4e6zJDm6JCRVa8e7UyfcIOYN6hL4UrefcRcrxQDTp2e-N4vDtKP_Mw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YvwQirqj4qmYS3hKou2q41htZWVAthGjRcj2gl5B5sQ&oe=69D6566D"}, {"file_name": "Screenshot2.png", "id": "474009487932966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035330_474009491266299_1456643477844227164_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OgNee5wXd8Q7kNvwFF5pdi&_nc_oc=AdribW7qbYKbNpAuz56sd3NojByriO8fgqPoe57oz6bGB9FaxXj8h37zAJuMgKwSJn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VCHw2NV70tCZYYk-qOD2FhxHiW0pL66kNMjixPVfqSA&oe=69D64D84"}, {"file_name": "Screenshot3.png", "id": "479919230355261", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75604733_479919237021927_3270815822813629402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foM3aelYca4Q7kNvwFl9x57&_nc_oc=Ado_OagsaCr1QHA9g3LZtHjJ6f4cdO7NVHOe_m92zIssn9tWokGUa4HFvMwcAc6_4qg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IyO9wr6mkEEKps8V2Fo35VjVIeRTfRNORHP2q6fVCMA&oe=69D655D2"}, {"file_name": "Screenshot4.png", "id": "587095653146814", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035330_587095656480147_1944626692418926411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IonXIUW-Xl0Q7kNvwG-SXIR&_nc_oc=AdpoF9FApTYm0cATu11oMqyLK9YmjgA8tsphQJLKvulTuN05FgQUZJJClg4s8s_PIs0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0K3HEEL2_E1is7C0-9Pf23AHwI90-5S1yrnZCT14quRA&oe=69D65405"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1279312729273224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031422_1279312735939890_4968861642343199335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWpNeiQTGX4Q7kNvwFMV6u4&_nc_oc=AdreuQ8cOSzjicmCd7Tvm9aYj4Q38NRAG7mblyMxo1McGOhYlhMbJ07a10CChn_8JIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2woh7YEKvLYN8t8PZ6Oo7_Y9LXla3wblBc19FWI0_zbQ&oe=69D66822"}, "display_name": "3D scan of a basalt canyon", "keywords": [], "long_description": "Move like a pedestrian in a basalt canyon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a basalt canyon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 800 meters.\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
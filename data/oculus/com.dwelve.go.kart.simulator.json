29211922725", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624619_2552229218589391_8856913185806480622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3T_mIwElrPMQ7kNvwGY76Wn&_nc_oc=AdosSfMHcf27sI0Z2Z-_LWH4sMOo6Etpqk4nu35ZjyzFiqGeBGhBs3UeEd_D32YqCzI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdfzC3oala5ple6nrXMmgEJxHywQshIjs_szlbbOlVpw&oe=6AF5C6BE"}, {"file_name": "2.png", "id": "2123022338315076", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628893_2123022341648409_8862326268233564177_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTYID9OyjPIQ7kNvwG0c0YL&_nc_oc=AdogCmnISeiyq6hAOOVadS5ymTGovIT0YTHprd1o-WQJM_GNj6AC-XlwE3fj9WPGdSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAhvF3oH_wj9MFwBPwQLLkW8aCMCJfe6PYA94PBuM6zQ&oe=6AF5DC76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kart Rush \u2013 Go Kart Racing Game", "keywords": ["racing", "kart", "go", "driving", "track"], "long_description": "Get ready to race in Kart Rush, an exciting go-kart racing game packed with speed, competition, and thrilling track action. Jump into your kart, take control of every turn, and push your driving skills to the limit as you race toward the finish line.\n\nExperience the excitement of go-kart racing as you navigate challenging circuits, accelerate through straightaways, and master tight corners. Every race is an opportunity to improve your skills, sharpen your driving, and chase victory.\n\n### Features\n\n* Exciting go-kart racing gameplay\n* Fast-paced kart driving action\n* Challenging racing tracks and sharp turns\n* Responsive driving controls\n* Competitive races and finish-line challenges\n* Engaging racing environments\n* Fun for fans of kart racing and arcade driving games\n\nStart your engine, take your position on the starting grid, and race your way to the finish line in Kart Rush!", "short_description": "Jump into Kart Rush, an exciting go-kart racing game 
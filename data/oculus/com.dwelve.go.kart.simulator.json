ent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHznClshW8Tpl9x0xWr-JmU2DqJilbgikRgt4XDPMrGg&oe=6AF1DD4F"}, {"file_name": "9.png", "id": "2149171646025725", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_2149171649359058_6259775908436039323_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qg9_93MYeC8Q7kNvwHaS5ot&_nc_oc=AdpcD6RJJdVgJu9eP04TQhl-ZyUOaIymKZdoZZEGYE2pZVvh3zV1pRBPIoqZQH_dPxQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUn4R4HtZJ9KqkiPP4cmE0JFUOr3paijHehHFSXfBQPA&oe=6AF1E8EF"}, {"file_name": "11.png", "id": "1080716998044129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831964_1080717001377462_7240540571710568517_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEpL16uqZIkQ7kNvwE6xiT-&_nc_oc=Adraj8So4WnEZM_3HseyMT7oBJkmazhag8KhBoB4iAwSEtiqWMLEcoSN46TnoKy0kz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxd0OzeYNd5K-yPldcKLfz4CHPYKXSi53u0p5Cut1aVg&oe=6AF1D82B"}, {"file_name": "7.png", "id": "3171405089735461", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596149727_3171405093068794_9095459004173797039_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pht0aK3JjLwQ7kNvwEqNSV0&_nc_oc=AdopuIAD8UB3XBFJskq8hSe8RedHJ0UNqihVeldzNJt3rmibSb88rCnPRrqBnErq0_k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMsB-1Z1Sc6WPZQzC6-sDQ73hkISWJwlzyNJn16S5f8w&oe=6AF2075D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kart Rush \u2013 Go Kart Racing Game", "keywords": ["racing", "kart", "go", "driving", "track"], "long_description": "Get ready to race in Kart Rush, an exciting go-kart racing game packed with speed, competition, and thrilling track action. Jump into your kart, take control of every turn, and push your driving skills to the limit as you race toward the finish line.\n\nExperience the excitement of go-kart racing as you navigate challenging circuits, accelerate through straightaways, and master tight corners. Every race is an opportunity to improve your skills, sharpen your driving, and chase victory.\n\n### Features\n\n* Exciting go-kart racing gameplay\n* Fast-paced kart driving action\n* Challenging racing tracks and sharp turns\n* Responsive driving controls\n* Competitive races and finish-line challenges\n* Engaging racing environments\n* Fun for fans of kart racing and arcade driving games\n\nStart your engine, take your position on the starting grid, and race your way to the finish line in Kart Rush!", "short_description": "Jump into Kart Rush, an exciting go-kart racing game where you speed through challenging tracks, master sharp turns, and compete for racing glory. Start your engine and hit the track!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://uafle.github.io/dwelve/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Dwelve", "support_website_url": null, "website_url": "https://uafle.github.io/dwelve/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1416726221513834"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2149607862349262"}, {"status": "PUBLISHED", "id": "1085170260892662"}]}, "baseline_offer": {"id": "1085170260892662"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2149607862349262"}]}, "liveC
ent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw5BIJrYDW6pdZoRiiEyVqj_4Z8PgMyA4n0gpnzSDBsw&oe=6AF5D1CF"}, {"file_name": "9.png", "id": "2149171646025725", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_2149171649359058_6259775908436039323_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtGYrOFn4voQ7kNvwGy3v5c&_nc_oc=AdrH_nM4Z4-AkLQ6vi2T1SEj2UQX9Nmd4EekvQ888zo3dZUwLVaMKIaborPtS-LJ48M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYAFpuJwEB-R1kGq12Y7VQsM4EQ-xstW3pKbjsICNzxA&oe=6AF5DD6F"}, {"file_name": "11.png", "id": "1080716998044129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831964_1080717001377462_7240540571710568517_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7zAAH-3jX0Q7kNvwG1xm81&_nc_oc=Adpl-lasarxviB_Y7iQRI4J2qCUIDDSie_ecdGWuA2Rh5wEiTUmwTRH_rgCrohIClLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLL49RIw41FlAmqzyT2BSehxoda-TkPW7aVGNs_kFqRg&oe=6AF5CCAB"}, {"file_name": "7.png", "id": "3171405089735461", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596149727_3171405093068794_9095459004173797039_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMK7uoNEv2EQ7kNvwHaplrm&_nc_oc=AdpWoS3k1C2le8EqMG5YMCqZQ5J1jXiau4wY6rJKYrYJ1ayffOtaeCYlriYR6B4bfMA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8TgJZtYwNn1sKbutwmloecq7s7BWOOpQxmIYz0GHL9A&oe=6AF5C39D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kart Rush \u2013 Go Kart Racing Game", "keywords": ["racing", "kart", "go", "driving", "track"], "long_description": "Get ready to race in Kart Rush, an exciting go-kart racing game packed with speed, competition, and thrilling track action. Jump into your kart, take control of every turn, and push your driving skills to the limit as you race toward the finish line.\n\nExperience the excitement of go-kart racing as you navigate challenging circuits, accelerate through straightaways, and master tight corners. Every race is an opportunity to improve your skills, sharpen your driving, and chase victory.\n\n### Features\n\n* Exciting go-kart racing gameplay\n* Fast-paced kart driving action\n* Challenging racing tracks and sharp turns\n* Responsive driving controls\n* Competitive races and finish-line challenges\n* Engaging racing environments\n* Fun for fans of kart racing and arcade driving games\n\nStart your engine, take your position on the starting grid, and race your way to the finish line in Kart Rush!", "short_description": "Jump into Kart Rush, an exciting go-kart racing game where you speed through challenging tracks, master sharp turns, and compete for racing glory. Start your engine and hit the track!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://uafle.github.io/dwelve/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Dwelve", "support_website_url": null, "website_url": "https://uafle.github.io/dwelve/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1416726221513834"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2149607862349262"}, {"status": "PUBLISHED", "id": "1085170260892662"}]}, "baseline_offer": {"id": "1085170260892662"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2149607862349262"}]}, "liveC
yIZfyLvq93jgTQVGIRO4iiPd6yI9ysDDN8yDgwHHgMQesGQm1GE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRDQ6qcrDPjZJ7rp48musCQYU9NEGPnmhTs_CZnNoUtwA&oe=6B0DBFEB"}, {"file_name": "7.png", "id": "3171405089735461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_3171405093068794_9095459004173797039_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bfv46u_WRvIQ7kNvwFuCSdn&_nc_oc=AdpgpVj_u6bdR3LE3oGj3h7Rd1H-qaatAfGqGp7mvu2lm62gnkFuxf6fhVz1dO-uCWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTbTS8enpow1tN96hNQgj9vo9EvpUINLH2jUW553Avi7g&oe=6B0DB6DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kart Rush \u2013 Go Kart Racing Game", "keywords": ["racing", "kart", "go", "driving", "track"], "long_description": "Get ready to race in Kart Rush, an exciting go-kart racing game packed with speed, competition, and thrilling track action. Jump into your kart, take control of every turn, and push your driving skills to the limit as you race toward the finish line.\n\nExperience the excitement of go-kart racing as you navigate challenging circuits, accelerate through straightaways, and master tight corners. Every race is an opportunity to improve your skills, sharpen your driving, and chase victory.\n\n### Features\n\n* Exciting go-kart racing gameplay\n* Fast-paced kart driving action\n* Challenging racing tracks and sharp turns\n* Responsive driving controls\n* Competitive races and finish-line challenges\n* Engaging racing environments\n* Fun for fans of kart racing and arcade driving games\n\nStart your engine, take your position on the starting grid, and race your way to the finish line in Kart Rush!", "short_description": "Jump into Kart Rush, an exciting go-kart racing game where you speed through challenging tracks, master sharp turns, and compete for racing glory. Start your engine and hit the track!\n"}]}, "developer_name": null, "developer_privacy_policy_url
6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ee0ehbEnimUQ7kNvwGBzXf-&_nc_oc=AdqGFqfn-HV5LFjOUYxWfoH4pSkGxyGmj3kuRuKV3HZXncMxwZ77QIUCc3BothH37EA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLljE7wEHbvDHUjQxfXZ0sDY5dFAoTXNbLWa6fjJ0WvyQ&oe=6AABEE9D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOZ0o5JYzpYQ7kNvwEf-H1K&_nc_oc=AdqzQyrJ3K32aKGvIeu8h_V08RxzaNbdcYUc0QvSWUYW2PKiQr8D5wmyhr1LJSSfcpE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtmPWwc4PlCzBGTGNf644htLqNR_3HI60CiE9R1TaEqw&oe=6AAC0774"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BEsZjuecYwQ7kNvwGYbKfn&_nc_oc=Adoq4rAxJoJZu_nrU5wOCqw55YzVigdJ4b0MVJfjLJq6sUmvMYQurLErV5-zZgSm_8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRJoaTLyDg-fSgZc0IsQE7OKJoiuYOqS98vVD9o5yJIg&oe=6AABE660"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILWNoAA425UQ7kNvwGbtG2U&_nc_oc=AdoCjiBFFWuLBiQGmHJpLhiX8lFwFDoIC96CQk0C40FnvHUa0W-EDS9oqapYMP8QyI0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOr_LcvMOjG-7yrwlJbgxmMFhqfglmxQSgc-F2xCfHKw&oe=6AF9B71D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yf-F2TC9tIUQ7kNvwFUHFKI&_nc_oc=AdrIwH3N4t6n2zM9YsUpnGZL9TIXvfBnrtrGIok0MQEEq8lkUfEwczq_5FD2vrtNj0c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNayIXA4tUdI6CH6BeSS7opjnzhFWoY3wftJbswq8IXQ&oe=6AF9CFF4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shthOwlxpXEQ7kNvwGlSYI6&_nc_oc=AdrxuuZTPBLMnT3iGE65o9j31to0-hTfu9fM2-oKycuZm-pio0hFmA7yHCsocje_88A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzoHNQ05J8YiVXbllM32vwUlByKMDE9zJnxzHaYK6F5Q&oe=6AF9E720"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
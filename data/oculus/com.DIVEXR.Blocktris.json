6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLCH-jOzwOEQ7kNvwE3MJfE&_nc_oc=AdpGNOVqpWT5CrMIq0OMuQD8CDVqWDT4kTcQNgSDrRK_4mOLxREZHRxfm62K8ylpFHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPXFmYwg4APtxA_8sLVqzHs8OwbXpvFSccMDZQa--qgA&oe=6A9C1C9D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJZa2KW0ZQcQ7kNvwFs-1bI&_nc_oc=AdrnPkSgWY-JwmxyRMXC9mmfY4kr6QOy7oi2TG5MT9smCC41celniONgFYmDzOeSo6U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ42m589BSJw-cu5NNFk7MffZyytCuQfnE9CZjh4xZkMQ&oe=6A9C3574"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9zGnPyvVGwQ7kNvwEsqxLs&_nc_oc=AdqakRPUyAWGZZLB4azSGQSgQ-QB2AMxipdGrNJa1tESIygaCVTTe0C70hOKYiQwVJA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3MP17p45EOtADwOjHJz28zsj9OBMOukZ5HP0YrrbWpg&oe=6A9C1460"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PjgJ79d2bMQ7kNvwERILPa&_nc_oc=AdrAF6And60Tjl2ZCtSORvbDcjrjuG91lYUHnqTzAkGtIS7M0mBgOEAj9R8vrORpbzo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYkkJmTmkHoVLstHn3KNTbYdNmgGAMZDKVCdUAvRvOQQ&oe=6AA0111D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-zzA1n0BO0Q7kNvwG7A9YY&_nc_oc=AdoEhov1O5IGxjlSztgA7eidRNO-tPOm3W7cyARcZQW5Kw8Dvcqw2zmzZlrINRdZHFA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJERHilSHBnRtkZF0mfiwwHM--8mB0TnE5lqCvdR9BVNw&oe=6AA029F4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILn4PhPeyiIQ7kNvwErNN0a&_nc_oc=AdrcqHxyIzVvRzlROxnmtZbluSF9BK8QLHAZ5tZPtbeu2e5ZHifmRBc4EH7ggRpDFyQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItp7gnMLicVgYsH5kpdX6Sz4b-sj0shxxJlR_X12y8hg&oe=6AA008E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
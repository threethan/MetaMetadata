LqGX1vp1KS5jg&oe=6A8D72B6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7nkQhHcVGoQ7kNvwGfhBkz&_nc_oc=AdoK8KYN1cpjKlLxBpT-miZ5cSURqKC3xGvRbwzshSQKkeeyCyuke_mK9Rq5hidxXvs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe30tFiqPri1G5OS94zVPazZLEjGGeJGC8vE0RnpKhDA&oe=6A8D9C1D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yRZQhkY1tIQ7kNvwHDrMm9&_nc_oc=AdoC80EKHR2dowhv51E2mmRUQdvwvEIjonBWShOOX0mLjwPNK2wEgG00HVbWxId9upI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQfyD3QyD960CKe1iNRaagQUi-PsYxzLNr50aMk3RgzA&oe=6A8D7CB4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rNLYEITrmcQ7kNvwF87d4r&_nc_oc=Adry1puiRTEXPTzc44LrUKZsWmMnTThoYC_x_glQ-el-2VDM4XcHRMNyyMAKbXsTyuc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcj5FOgW85NmDImoUR4CgjxtkwXCU-Y3pXm7dNRHS6fA&oe=6A8D93E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\nFeel the thrill of snapping the perfect placement, the panic of looming stacks, and the satisfaction of carving out last-second saves. \nIt\u2019s the classic block-stacking vibe\u2014completely reimagined for VR.\nSet new highscores, challenge your instincts, and discover how far your 3D puzzle skills can really go in Blocktris.", "short_description": "Blocktris is a fast-paced 3D puzzle game where you rotate and place falling blocks to clear lines in a fully immersive VR space. Easy to learn, hard to master, and endlessly addictive\u2014feel the thrill of perfect placements and rising speed as you chase new highscores."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/blocktris/%ED%99%88", "developer_terms_of_service_url": null, "publisher_name": "DIVEXR", "support_website_url": null, "website_url": "https://divexr.co.kr/table-party/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24860132527001832"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "904209955666047"}]}, "baseline_offer": {"id": "904209955666047"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771822800, "status": "PUBLISHED", "id": "904209955666047"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {
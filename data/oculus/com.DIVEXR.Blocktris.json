6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89fYilviUukQ7kNvwFsUNT2&_nc_oc=AdqgK2GOtF_l1syVP6PCucwHxmFhiLP_XSbIu6Af_9PL35CdxIxlPR5xX4F96-HqLc0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6f0hizfHOlIy4V6jeJmIRQADSanj1ylcRT4zkLrzI4g&oe=6A709B1D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tNiJyu2CO0Q7kNvwHUFVyu&_nc_oc=AdrPQDJckP4Y32Mki95ZMYEBHrua-4zMcvjh-0d_Cy9vwPqb9rHf0LlXnOhtdFg2o20&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdxdumoktiV8huItUcoSHKMjVMl9zcCFjja2p47XaOwQ&oe=6A707BB4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwg8bnnwqZkQ7kNvwGHi_Du&_nc_oc=AdpTNGy4NleowYyWvAkaWQmdYSyBeSWMKbH-89jBiBZ9gnq2fJSxjp1gYe8UwNMtb7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDeQvjzBrYTpQl_8tWJRbdYHMop-eaYwSRsbtyraeBZg&oe=6A7092E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
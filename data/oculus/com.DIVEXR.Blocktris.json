6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLCH-jOzwOEQ7kNvwH6Eh4J&_nc_oc=AdpNxYd43oPEdJ29dGU7cg-sp1oFE8r08K8aczGrA80gQaRb3Ep-6cHATKkJS1PnXiA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAwdRqiQwrc7iW0e-ZNxViLOEaHDxY0_uo4H13G0BSOA&oe=6A9D6E1D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-zzA1n0BO0Q7kNvwHG-xwm&_nc_oc=Adqi-FhliGymSPdb_Qx83JynxaT_Z-nIzEo7jdJADcBkmPE69Z13iv-nI1u2ZiO-j68&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKH1b0Sy2mSc0JKN-JBJS_Ug8VKlhLrjRqVTdjbOwRXRw&oe=6A9D86F4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILn4PhPeyiIQ7kNvwEfUuQo&_nc_oc=AdqDfQ08jisAXtj-7WDAySjsBgbO8Q5WL1GNbXwsNsSnNXBjJEVMvdO3t-wyLL77D_c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoDiMzArrKmbx5KxFTtiRlFDf46Qhvm3lVGynDo-LIcg&oe=6A9D65E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
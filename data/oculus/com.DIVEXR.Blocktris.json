6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-177YARNngQ7kNvwH_Hpek&_nc_oc=AdqnL5gYhl_wNnt0UU79GlflWEcHOiGTir1sfrF2k6nuyQWwmDw0lyD0tYNGK2oVorc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJy7YoeOxVCYHk7L341dKDN-L6X_xTAl7m4aJk9UlVvwA&oe=6ABD121D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzM_HvsDhWgQ7kNvwFNMbtB&_nc_oc=AdqPJN1ma3EH5IN_hAAhfwtTSoG_SQYuG0wfJW-cG0GlC7-spIkPwLsJJXJbp7lhPgU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTQ8jFJMkjypTxjRJpSEX0OF9013QW0oZcECQH2L4hQA&oe=6ABD2AF4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPhufFTbnLUQ7kNvwG6Y_G5&_nc_oc=AdrV8AeZ1lQlENR25nCKkKCT-rRzNRRtcYjU_lGRIwVh6TvrZSONYNaNa0_c-7b9jmo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXZusL8TKCj2ptNbNQ2G0U1cMig_wPA8WXwLby2nvVaw&oe=6ABD09E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
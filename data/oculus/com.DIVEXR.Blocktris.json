6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LHVYosLIJYQ7kNvwH9JSEY&_nc_oc=AdoEGVdY9yaBd05DkIn5QIUmHpj_ZJqAp1sJEHhtXbaaMjFjJT192D3KOG_RWB2ZLHA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNB6LTmfoTepHiRNJBf2DGLqzhp9bPPUQxincupfOQzOg&oe=6ACF871D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ou2vMDK-JGoQ7kNvwGKpqrr&_nc_oc=AdoKIw4ziNYJGZeV582XtceYR7WKTZeS6JhcUQITfAE6nz9nAhI4gxVbyuiCYV8__RA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx_ItcxYmy6s62ev3Oc4PBVJs6yLpC5OJwl7JCbea8qA&oe=6ACF9FF4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeXGfJKAB78Q7kNvwHKv667&_nc_oc=AdoBatjsEsV7Ta1foYdeH6lzd3KJm4UBaFQMdTmKBb7QX-x0zlYyvKA-BfrKHzjGcEQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_ikhuvkNVzYcy2FG3D5oHs_yhMTkd-6el4P5CPFLFKg&oe=6ACFB720"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
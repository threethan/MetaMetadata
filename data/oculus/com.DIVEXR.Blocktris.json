6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtLNGYKE-zsQ7kNvwFmi1SP&_nc_oc=AdrBVzRzycxfBufRq02QidLFS6Cz3Nu_dJL5tb6nRW0Jcr7YKv28dmeMB8XxsdNi3yA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5hil35U-YPFDR_3105uu93qK9doCxzZRLHaJLnLuEnw&oe=6A5E261D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsPOmZ5iCUgQ7kNvwGDxmCG&_nc_oc=Ado52ZOpNeVwL1fNXnND2uNppR7YqNWlMvQaDsiRMokJ65XvwS_Fs1o3xhi9Pl-SCRs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYNfmn1-0eHk-fVs_E_eQqHR97cKLnyCvzonZl3lNjoA&oe=6A5E06B4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUALcvq03_UQ7kNvwHK62dh&_nc_oc=Ado57Kb6Ocgt4_tS-8EhbKt_aAMsS7StPqVlbVLZA-qdGx4UjH7Ep0LCHTB3UYJd7lw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA__XO8qSHnW_9U1jU81PTD1WVvkKQZ0Sr6zeOYfn6bOA&oe=6A5E1DE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
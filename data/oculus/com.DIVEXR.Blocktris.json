6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omqR7XUOO7QQ7kNvwG9e7PR&_nc_oc=AdoFwflmiYCZnT3HG4hbezmEg6cvLte8N7DTqNIKHzfmWJz-B3G1Yvdu-X70QnUSTiQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q3GB4ZM3Lbjii4CoqcoSOmkaNqAnc1BYgEp-gbhUwPw&oe=6A2C0D1D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33dUJE-rGTUQ7kNvwHhYZu6&_nc_oc=AdpX8prdzDDMf1wFhjZyw7cW3vgVBofBQekpuwVUTEN9HZ44ouhYAiS6yuNO22XocN0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dCPTWmNukwn9mgwjqN5Q0AA3nSKbAm1-DKJ-AqXxMhQ&oe=6A2C25F4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfz4OEBQb2oQ7kNvwEWwJ5B&_nc_oc=Adp0952FCASLUL_eSxxAqyTL3OQYdHcrkKld_NtDTKASP_OmTdMbajNWx-bYdVhyf0A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Kf-_E30R0aVrl2XN2_bFl5FYp-sPvb2AE3OjQqNNP-w&oe=6A2C04E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kt77Nz3owrsQ7kNvwHiZf33&_nc_oc=AdowrgWyiJ8Qo1PAac1086G9v7jrxXiCuTfjD_SXBrvuB3cc70ssRWP277NrzVp9Wow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK7LqqYVqyYYFyPmOAmqcauPv3K2IMtgOVZtT8_6uapA&oe=6ACB929D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWfhyaRaH2cQ7kNvwF9qj7I&_nc_oc=Ado6lXCOWsFbTAJa1GAsqd7HLCqpaLgisCGZQHBWf-uXcI5rx4Ru9K6kknLoe2DehvY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmFT7LWIoUG7vXCrAFVAE4XwcV-LaTD9syqfZMQZCCxQ&oe=6ACBAB74"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbAOA3YUj6QQ7kNvwGwrArF&_nc_oc=AdpQ1hEZgXXBpL1fwYJzSnmvMuhCS9-vlRJijo3ZBOmnHwPX5NVEFBLpw8Gm-TKTxLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOy1jyoi8l4DB55xE_XzhzqjBGGtydUPTAM7QtnHEiECQ&oe=6ACBC2A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
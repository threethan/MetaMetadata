6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=La89m45_x8cQ7kNvwGXnJ6D&_nc_oc=Adpf6l__6oOYzTkQpmxmGjr2ch301y1l1UFvngsQzbpq0yjoUDJN9sjFSgKTVjvzGzQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oDMn3fvmq8OiVmNd-RyyASsfTzQzyFUV-upyQK89J3w&oe=6A05D19D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMCGquhnQXkQ7kNvwExpvCk&_nc_oc=AdogqoJRvcYOOi_UIKsdOFzi2gTL-uj1uXwMnw3n00HIfM4jtO8JgESMIXnhcRR47KE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63CrQCTeL-ZWpzfPlOac1csXaHJD3iVOlWnyE9LdjbFA&oe=6A05EA74"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKwciNpLwmUQ7kNvwG5Dgcr&_nc_oc=Ado4o3Gvq51R_tpUnaOJrmwbXNqTY3edHsaappD5PYQ0LshotM3AsBWJIPb9-y_VguI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TZVELhGL-fps_2KtI_KMsgf_11c61J2ydsBAXB5sN-Q&oe=6A05C960"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
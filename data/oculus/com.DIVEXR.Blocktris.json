6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoRWlN-hfJQQ7kNvwETXld8&_nc_oc=AdrquogY_4EEMiUUPqVDBDsqKvRzn2GqE3ckbnEVZxr6ggqlbN97tqgqqQ7fVVa11bI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tdmBzqti2ZIZFAI9W2SIEY9vo2FktONCXsxbBE2CHEg&oe=6A21811D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WX7RxL5wTOIQ7kNvwFofFVR&_nc_oc=Adq8m5-Eus8NTdH3IIRX4q_jW36ZlxZycN-CYEqkUZN9rp8pAXTM-i2f03JM7CnVbkg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Y9S6w_I6qKWRLNghkQlLg3DpOruSiC0b39IwSUasreQ&oe=6A2199F4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7yAt4H8C_wQ7kNvwHxZSMn&_nc_oc=Ado0l7zBcFNMLaM3iYaxGvy75fLG1v2hcafnjLJW17_YXhkpx05vmvJZdFagkSNSWuQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vH_tcW0IOAEX6RBzOBmJpwHAqpEVZMsTEWIFPuyjBzw&oe=6A2178E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3z7eR7EdcIQ7kNvwFG7oRg&_nc_oc=AdqSe-aPw8VzEJtdPj4pW8kNzCczEZRRKGnHLZA3BSefDTzIzO6uHbZdUz8MVHkFRIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4mWzQeIPiRCH4BssKLD7AhwPIjC7vbcuwaot-0wZmow&oe=6A67609D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3g62n_mv6DoQ7kNvwGJAtfp&_nc_oc=AdoVs9m5zXs1jEoqrxxn7rp8vT7-l8gTYG-_nZe4UKzVWOYtm9WpD2hJEund0ZrczfM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2pPy31PwRcSnNz9E8k_T6YVgMa2uCWcj3Kw7uZtPTkg&oe=6A674134"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_QiV2kIQBkQ7kNvwFGIar3&_nc_oc=AdqQIWRjzzt3jKwrKzwq8qD1nsuC9HlWBNjbMQ3XevYpM7RphtIqtmwitARqgCxZxbM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIfTfMwD2ifpWWtiHl9dxKYZdmPQFfrpDu4g-_2ONAfg&oe=6A675860"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bj8GPDC7Mk0Q7kNvwHEraaU&_nc_oc=AdpSQ_hxkf98gjTtjKt99x1vb5WvaEUNzDeVb5h1m7UhXAnGIu6sQRyR__dcGGJsXiY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYnUzlnytJlglMuHdBLPgTo_OsI_RzBixGBcQGLeCovw&oe=6A68B21D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3g62n_mv6DoQ7kNvwGY08E4&_nc_oc=AdqsEi61-B8bP4HLapxQ26UOgrgUSnW9s7MmClpR_pIAtkm_nPP6Q4wwzi-5ynOwMk8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPau5601mUKBdqbHaFuOuxA7JRq2l9MpyqviSHBuslDg&oe=6A6892B4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_QiV2kIQBkQ7kNvwE_yH53&_nc_oc=AdpqEsAhk6Lx47QcThefN8r0gMK0MiltfGKhqTl8lgYAwTP7yHJn4p9_K8POVa2MEN4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPB9a2VebbRm1axj-Jd272qjq108EnOKG6X3IjekVSuQ&oe=6A68A9E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
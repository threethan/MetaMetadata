6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=La89m45_x8cQ7kNvwF93Fly&_nc_oc=AdrgiHH0IKCSiK7FdWBAbOsjtIY1PPllMeq4q27FFmf3XuQJ9h7JlZN5r4nTULQPGFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hPNUmHKg_lDM_NPpPAQtDe-Z8fpWXL-VmEG6lSjliTw&oe=6A08749D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvwE6D1btV0Q7kNvwGGhgNZ&_nc_oc=AdplpRoU3pmk_l6SBTYYPggG3gc439Av9Fh2PPsN8U2Bmmd1tDJmtwcHFZWpWsScuXk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hVpWJknsoiCWRNpCOOf1hAI5gxg42-9bWhrZ0xAJ7bQ&oe=6A088D74"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvcpWIXAO1gQ7kNvwFHWJX1&_nc_oc=Adqd7sYp2ALOjFPxIKYWhkOA0iQcCDyXxGG9EbpDEjgf8uATDiZpic_pLszr3tCcliI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tnUB7Sdr261yjOwQjKyG-ybuTWV-pr6csYJM90sYrJA&oe=6A086C60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
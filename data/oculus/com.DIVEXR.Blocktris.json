6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pwYm-tu2dMQ7kNvwFpBl3n&_nc_oc=AdoX2HXoaUo4lYxpXOFRBLH9WGZgWsKZzkxTirALSf2Jt3aCayWFZS1-RdtyIfgidXM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpVACnA0lAiY-fUZ4McnrWeuHI2exoSknhUCLQsj4Lew&oe=6A86CC5D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DThCekld-9wQ7kNvwGBQiTu&_nc_oc=AdrOCiT5QHoHFyWurCw-J2n8UBaceQWkpehA_mMpYD7qajqveW0k0IJDVHae7h2ZUSY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9hdpKhGNtascqc_p8O2-VqsJ26CKbdrRYDevVfI7OOA&oe=6A86E534"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AAf19eGRwAQ7kNvwGKGBpT&_nc_oc=AdrZhW5LdlkM4Iki41_w7tElNHWuZVJ4gQJ5PcuE__0J-eEiM1h-7sjKqKMuUJB-68A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFw7sjMv5HSW_-7kD65yuYXFG2d2C6v4kfsmpPVK4dgpA&oe=6A86FC60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
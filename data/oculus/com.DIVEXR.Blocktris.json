6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9xtdqn4aB4Q7kNvwF8mRKr&_nc_oc=AdoGiyi5tpKvdrt112EhB74JPInNdesj1_GJcJB1BQFUEPiMVFuFJWE_0Q8mf9cXstE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3K3BvbrUxRfzCjoeFR7lkIIenH0biNsnRrw5Ap1afYbA&oe=69F7511D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMSshBKlq7EQ7kNvwGXCQdz&_nc_oc=Adpwgjmg75Ky9m_NjDpvKwYsvkMbPqX7kEpZqN4LTY6G2WSnnVngt1_I7WUQGhLAkzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2wc-v9ODfeJSNdqapthtSCMVEgRkwCSsdLmhADd6cnTg&oe=69F769F4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ez2VlGpAyZsQ7kNvwGi55hD&_nc_oc=AdoMDpcUN0ncguhIo8_ZfC8GNFZ-ewUCIoXw_RTx5zHuSPFNP4cLDOlyAI-lkTsAeBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04LgwASDIegk4hTakiUPjZpTpaBYM5smy9aMJtIMcYmQ&oe=69F748E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
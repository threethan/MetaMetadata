6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zqvx9KBfFBEQ7kNvwH5e2wD&_nc_oc=Adqn39X8Vq31QIsKQHy9ngRO35_XGoioFW-o5SLUkE8VIJtaP1M_BEAFbZyTvupCZhc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Hiva3CPqntmFXm0EfMWnZyHGPQrckugJK8tjLA3il3w&oe=69FF3A1D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aOM6ehDMbUQ7kNvwE99U1D&_nc_oc=AdpjFycSlTbhpN3R9oe75-uQP9eqaaYI0af4-6U3svJ9l_vkLxS_vLKUuJ6T3BYEne4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lVAngWUXjkUv0_oGmhtsqCIL8Op7j4sPkbZZNiCK34Q&oe=69FF52F4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQ-6pmwHkz4Q7kNvwFnNJaP&_nc_oc=AdpGpStfdY1I7ZYIOkCcldwxvAGY7AaFH9VMcVl4c04hotuXrz8T6VKzb0_1SUc7ywU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af504Q83x3_PkBkp6btI5YmY5tkuEBkPjSglvZ6fKvhcCA&oe=69FF31E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
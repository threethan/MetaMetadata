6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0k_cuajS7CIQ7kNvwHd5o5P&_nc_oc=AdoQl33Ft_hK_l2_bpQcY5Hnhga8DUzVd0FjpgCVYl8RGfi001Eme9o_4l3xHMuJCas&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BMOjRxzIoKK1uFtXEQJnRrJwfJY0uV1cfT4qePkqstw&oe=6A0F0C1D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJIONlBlHacQ7kNvwH-Hz0y&_nc_oc=AdpSskee3dD6Me7WtPXPWHApkqttj6SEWC4stknFnnYdsM7rRFi8vIEpCeElilUUoSI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64sX7L1KBnN0cDClRbq0KTMV3DyD0dHuWeohKj0asVXw&oe=6A0F24F4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0Mct_-bkykQ7kNvwHqTI9S&_nc_oc=AdoXRY2OFQNzgeJ1A2jCrHrOEUT97grahD58qK2DvqrWaXZ-BYEdU7g25gYp58q9ZTw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c3yDUVP_UcvrMpcdJUHGlPvymAYbHuMRT48doihsE7g&oe=6A0F03E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
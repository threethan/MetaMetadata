6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iprgZtJcZ-cQ7kNvwEnfjmZ&_nc_oc=Ado6482CYXJcEitTaSqTWcdg9PRDh1_B7BkAGfvuc7Nl_tTra94KTdn16gFQsGIVcI4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuZMQfB6z1pb6maCNc2hYIVf63ecfNGJ6pB3mAJtEBJw&oe=6AF4711D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LNt1IEym6cQ7kNvwG9xp-u&_nc_oc=AdqwThqcLcGlsj_L4yhlhYi3zvm1jz8XDobqmlia57FxmpRmfStywAtP799yWUtbra4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ3nEgtNAZbILa3DTFrYrn4ahLIOGyfq2GUeSSuRoPGw&oe=6AF489F4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwWqKQCz0wMQ7kNvwEyAso4&_nc_oc=Adp_6eigQGHm49hpm8MV33W23LXSc_zU6lY1UD7KF399A3AQEdmsCO82La86ub1Z5sw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf0F3C-xhywP57AmUGVoM_32SM9wmzhPNcBDtof67s_g&oe=6AF4A120"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
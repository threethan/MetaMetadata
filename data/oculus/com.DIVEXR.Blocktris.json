biwnGpnVvMbBg&oe=6A073BF4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvcpWIXAO1gQ7kNvwEKRj6A&_nc_oc=AdrlIr-yZheYeh-cAopiG3x82DKNGQpcQi5TpuS1ltdZBtCgKGI1oQbYVWCzIXSEf54&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TGm1H9AOeR5cckQC9Wweh5B2UhSoDlV6w5S0KvM56mQ&oe=6A071AE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art.png", "id": "1656228502196655", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499295547_1656228505529988_2278581726178933183_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_WNHijjBcEQ7kNvwHpE6LX&_nc_oc=AdoWteuqr1-O5s2l_5Xxuqc5eWCu6n6jGD_lgw_S3_hCe9QYOZyZOXfu21gX6G5N9YE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Eqmr1g6vf0MhOdtUYG1Kh8CBcYpcGfjW_B9hC_myjQg&oe=6A070D8F"}, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Awaken Your Senses with Blocktris!\u26a1\n\nSatisfying block-snapping action meets high-speed puzzle solving.\n\nEasy to learn, hard to master, and endlessly addictive\u2014feel the thrill of perfect placements and rising speed as you chase new highscores.\n\n\n{941107781792755}\n\n**Feel the Flow of 360\u00b0 Action Puzzles.**\n\nYou can grab the blocks and the platform, spinning them freely in your hands.\n\n{1660597168447102}\n\n**Find the Hidden Gap.**\n\nTest your spatial awareness by hunting for the perfect fit.\n\n\n{826497357124422}\n\n**Complete the Lines, Pop the Blocks.**\n\nYou can strategically stack your blocks to build up the tension, then trigger a high-impact blast that shatters them all at once.\n\n\n\n{1377924340774688}\n\n**Chase the High Score.**\n\nClear out the blockers, keep the board under control, and push your score as far as you can.\n\n\n{1290897786230471}", "short_description": "Blocktris is a fast-paced 3D puzzle game where you rotate and place falling blocks to clear lines in a fully immersive VR space. Easy to learn, hard to master, and endlessly addictive\u2014feel the thrill of perfect placements and rising speed as you chase new highscores."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/blocktris/%ED%99%88", "developer_terms_of_service_url": null, "publisher_name": "DIVEXR", "support_website_url": null, "website_url": "https://divexr.co.kr/table-party/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25820499240965151"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618264_839759718454170_6660924529576981723_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=il1c-f4Hg8sQ7kNvwELoPgP&_nc_oc=Adp1pAe1iZ_uiwJupPWt_l-_upntGJ86Z2Jcwy4quZX2GvHidWoSZJvQ1CmRq6Kf0dA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Z45u2NelN8YSiP18LyIl4rXakxOTO4rYiuQxC8hPfTA&oe=6A073B94"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Blocktris", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topic
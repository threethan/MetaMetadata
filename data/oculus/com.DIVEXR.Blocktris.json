6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIioy-cEgqQQ7kNvwHymkU6&_nc_oc=AdoYwldLWANdmUy9_TILkG4m3rcr1djMMcHsH_kMRDZzMPj0BOf2ddc3xOYb_VI6qSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cBGQOJy1zr1Cxqe8cK0q3e24kiHx1B9gsjVV4Hdl76Q&oe=6A28189D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMgpXmh4RwQQ7kNvwGYq8dl&_nc_oc=AdqyaqBX_Nt3b4ounrQkgaCF9P7eLjjOViO57LPdzpvF1zynip-ngaGE_JV89GVBfuA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ljGx2ZGnPfkcvdbqz2zFJptd4EMDGNtIcp_u60nxnnA&oe=6A283174"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gxLUG6RENEQ7kNvwH3i2ID&_nc_oc=AdqxOWI_BWiLBU2TBueAzM0ZdAciB3-zVEJevRoG61KFtty7wSt9rDE3A9JsQItu1Iw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_zurKGwcLweY4NDJEesfbZoL6ULllgH4b2ge6YD5Q-Q&oe=6A281060"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3z7eR7EdcIQ7kNvwGFDHdZ&_nc_oc=AdrlsJKDVA7I2_rt52EohkZMfZHkhlsnuhIs_dqtJ5j8GGJ5dAk49ENK3oWgDvFOuv0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9Z_2iObLOHSd7U8CqBNp1G01ZlL4WPLsVpN8_tm3xzw&oe=6A660F1D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3g62n_mv6DoQ7kNvwFFLzY8&_nc_oc=AdqkvHm5t64DnwodtTRJfaSYYmHJCKctZkgZlqrZa3Gs7es7SZQGwvWjzt3IbgjkUbU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzulM6g_lgKTJUDqw5PMEp6Y8qjEzSrnlqHQ8ccI4OjQ&oe=6A6627F4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_QiV2kIQBkQ7kNvwGdRGd9&_nc_oc=AdogmGUNikELasjeOq2dmMkLtV5gWK2PFJdy6czW3UnxcSG4ZpYteXh9vlJrTdQxitY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDrbvITpXiYIrhh1c1kk7Osnc3Qt7Myt9naAvQNyg8iQ&oe=6A6606E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
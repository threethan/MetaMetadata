6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKCUdaa-_GYQ7kNvwFFzCUJ&_nc_oc=Ado9-tZTQOGXdcsKq_ZPte7b4wc1jyIuVqPHOT4ht07VPSSuRRWzW_2h7xZ9TDMDgYM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0xRFlJzaDtv73hkxl9R3-6UuR_OZfijltl1fsopzYiw&oe=6A45199D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GkzejVZVQAQ7kNvwGyrYzc&_nc_oc=AdpBX0bpR5LiQbAUn5BWcPgBixgQ2g1WJt5urwXOrYvzaIEgEUD7ibEY4p-NfGWuhuI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XGsW32IGGvnFx8lWz9bnRTl34-BHIE5ZAWtKzQ2D8tA&oe=6A453274"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQ2uUlsyC7MQ7kNvwGRVr2y&_nc_oc=AdoBxdoCnSVQBHOSrPWnPkJuB2c8W1T_Vd66CHbUe6ke4vvqoqpRPvdd2X6YzG0wUT8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OPahx57MJkFGcEiKHLeJSw77JGff2ZPMpe_ggt4H4yA&oe=6A451160"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBtATai7GdwQ7kNvwENFu0A&_nc_oc=Adq8HF94eo9QYy1qLB0FxxyIabCpGV4GgwA-DiEWgUTUCJ3p6pmSEOqraYTH1B_p99A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIU8rdv7UCWry1vQcByUKRhhHRBwGIZfH5QS1GhdP3mg&oe=6A81BE9D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRFz7DE1ickQ7kNvwGjM4lG&_nc_oc=AdqeWYjjfEApe-UZRH_pVOq4ZcViKLMtlR-2qSjA4VOM7F9g1j9Mr2zvW39fLG0wSKE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJukwGFqtQVZeXGaGQy61jvF4VycyLIHD3n78T3TfRug&oe=6A819F34"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXJ8ovpxpEAQ7kNvwFH_QHj&_nc_oc=AdoapV9MgPvQeWqoKxx6wvXI1AA24Pk7J8ssCcSajrULGs3qfV4M1ETUwpoiBfIkpjo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzNlQNt9Ltm1SqIgfoH0AgVPK2mY9PwJPIZrKDsYt5EQ&oe=6A81B660"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_aEhTHak_IQ7kNvwG8R551&_nc_oc=AdrZYGbpQdCc_ULj2YHExHCSP0IdrzdRoTGh0Mq4yhlZqLOY0iPeI0yYhdr47HkJ1lA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--2f_AnnPsVAhTedo23CeIA9WCyhOfxskT3CEBFwrgaQ&oe=6A35479D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNUvu9EQmocQ7kNvwFko4qu&_nc_oc=AdpGfyBeFjjvFQpPNdsJ_KT2IeFHTG2tE5wqTVxwBm7LWKJA3SppjgD-CNigu0k6yXo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pHauxEo5i9N1JZQToyewn4vgXvgrB8MnfqI_4voVk7Q&oe=6A356074"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYTAtc0kS3MQ7kNvwE9SRWX&_nc_oc=AdrLe_AsdI6WrsnM2aN-vy1RdFaE64toPfVCF2C8azQyRxuOdFRaRpxc6kEwBrBsV-U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ktWI7yQOWNcuzp8VHUtocIIGuYliUn5TsfQgLgtmpBg&oe=6A353F60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmvUI1T9uxMQ7kNvwGq1CB2&_nc_oc=AdrLU0FmwM2DozJUiy4VyU8Xgjm9fNzc9dQRFa2kTWwCNuEswR2MFhBjgw9jwTHTPj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5OkKfE-GYq6ZfKGPaXJMgkvsI3jKl0mFQOHMB6eOlvQ&oe=6AC2581D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vC4-CdIUKS4Q7kNvwEYHLzR&_nc_oc=AdqXV2aAoYy0cVm2aB8B6B33128roslvc99NlydF8gp3cMaiH4fZcNh3hwFwGR4-4qU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO48bpL7j4VVMBd7TeP0LSDKhmf1lHSAXIJPX9SZr3Og&oe=6AC270F4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXZYsm-9F8oQ7kNvwFBGxk_&_nc_oc=AdqpYrOJBq0ai6pgSwKDsggf5H2JlE1HSaoI-AZtvL8Udz_EQAbpSoBBzYkdsThboMM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQisPkyqwCAyDCPr3V43I68l37uiRDcSRhojJoKV9cdg&oe=6AC24FE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
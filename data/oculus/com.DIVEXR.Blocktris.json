6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KLu9Un8SH0Q7kNvwH51lwh&_nc_oc=AdrRyjN_APqiW0oVkDboW2Iy9QTTsdJ84YTBiQtIR_JcB0Wz5v6duIGjk__fAAvGGu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXCPBnJXA4Lq1GH4SDapfY_SRm15ac16lQFmKvJ1rsaw&oe=6A52489D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogWeo4-D08IQ7kNvwFYxaRf&_nc_oc=AdomgZWCM7zfmLaI4j8RDY8zTMHIAEM6Fv31LzGuyySk1Cci-fgPrbta5PokdmRwaMc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4OnWsyrEEt1R-j9tubBCvGMzZua_3x7Z3DjvALPmgng&oe=6A526174"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiC8rWJzKOsQ7kNvwFoL8Jd&_nc_oc=AdoLVZUpIezH_QHuszmj99Q--PE4CtRTCh6Xrdciuep1YFtbQQaxw-a2VRADEGbvLQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9YosB9xrkNkCckTsGYXLp1S2Lh77GaNoKf4urvr1NkA&oe=6A524060"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
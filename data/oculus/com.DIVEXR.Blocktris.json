6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvBxTlTRQ4kQ7kNvwGDjQo6&_nc_oc=AdqO4bqHn2qvGZ6EaOKT_qGMMIRh-dm9RDX6GPckAKDizut9YeLNWEYboyYqoBLNBBo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zGp7HXklQN_piBjmLk3le3d_1AFS5id2ikIBac16wdg&oe=6A0C691D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3423d9-KkHwQ7kNvwHC60dl&_nc_oc=Ado-N1Sm-54mRMHzIVsK48BaoN0rhBBQedklJRhikvQJPZUBMd1XNOMS9kfdVNUCTZU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t5LSB0bwDk77RR2e-GmvRKa8XNmwE4Wxstcq84zPlVw&oe=6A0C81F4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N82O6j3gF54Q7kNvwFwrr_y&_nc_oc=AdrApBYVHU0k3K5ZyXrtOHe8XC-PE_t5lM5nhA8ITkGqHrB8HYUSQE_p4vNVmIym2os&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nN5UQDA4WRscBG7T6okAR1AhEZsLsh71IqUQk4nGRhw&oe=6A0C60E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
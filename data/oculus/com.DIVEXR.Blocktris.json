6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3z7eR7EdcIQ7kNvwF97N2o&_nc_oc=AdokmMAfYLRTKItOJ3tJluFNeA11g2DTsEVC8k-t6paRfZUGzujCWFA3WYScY3WnNPw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxFxmKu31jjh1WaVKSqNWTv5o2VZ2jtcB2TtLVykDVOg&oe=6A64BD9D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TnSyTYL1OwQ7kNvwFb7aR0&_nc_oc=AdoK4uqBNtDZVlUb8HrY7YhbLH1kmBrOBOhhkWVQCR6ZQFZpAlraf3CM1QdtuiImHdY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLmiwr298LxXqx4PBj9zRYUULpoWf6qy5S5eSOAgfETA&oe=6A649E34"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbUWn0W5m8cQ7kNvwGqTJe0&_nc_oc=Adp4NI_IXQcfCpuZwTLlUCIoeXv5bMllKNnZyTFuWE4Jmyhtga1Bc8BmO99qizswqn8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcbSamPa5jT5pzEm58CVeXo8oX6498QuYRFL4a5X8jdA&oe=6A64B560"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
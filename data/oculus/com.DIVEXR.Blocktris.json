6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kt77Nz3owrsQ7kNvwHkElkW&_nc_oc=AdoQUVb5emEQbDBXEt2xdZzjDbaC2k6YP-WfqvOBoAXdAtxzZn-BqlEfODiyNEB_xYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhm5SN4GHo2Qu360H6wUpnFUy4QYsMWU__LydQfoCTVw&oe=6ACA795D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWfhyaRaH2cQ7kNvwGcn0co&_nc_oc=AdrcDdlEgylPbdCOMxYT49K_yxhl49nka-P9U5quidO12qea_NnXs9v-yyXqiTAGDK0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTW8hM0GRkoYBUm7vri0EuoTp4OPe1ip19U8nwrIi3_g&oe=6ACA59F4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbAOA3YUj6QQ7kNvwFB1EuF&_nc_oc=Adq39a_glZB1e-8m127Ku0FplD2_Jql21Y2BFkYRT2dkfASwHWlViKoWw9NQCfiy-ko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4jIBZOyGVQj8kjb-Vyi4E-pj0hh9QcUeWZfrdCcbIpw&oe=6ACA7120"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
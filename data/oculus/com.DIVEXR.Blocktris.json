6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRR4OxIiULgQ7kNvwFVafZ8&_nc_oc=AdoIrY8kJ5Fw6g0e-o2T8z60dpiXtzDNH_0itChcFlb_bYasOaVsuyv8bnhCxZmi0PA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a1wU5XJHxw0D6H5d5599vh4e8a8MIePz_2GvqyzF_Hg&oe=6A296A1D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMgpXmh4RwQQ7kNvwExSW08&_nc_oc=AdrknXUwcJFpdw6DIMRgHrSod2rUP_A9KBVvy1OT8BptYPFsckY4vI1iD7okzKOQlws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nUnNaoIiN1942PjDhDgN9Sfs9Q9j1JIn4XWBzjKPeyw&oe=6A2982F4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gxLUG6RENEQ7kNvwFk_2w7&_nc_oc=Adp9UizsBv-sgWWASjmHDrJx9Z2x_CvkYYvuajbb_0zEwe1ZiZUdEKr4HoLV9yNlDrg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86fMPBwM-QYAIbYntFoG-QTxFrrcDLaXnH_VxTM6pm9g&oe=6A2961E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsx9wXAeMIgQ7kNvwEytyaN&_nc_oc=AdrypfsUit9lytjK5Zm0-YqLiIzHMdyOkSVG_9TGcr1i_Ft3S9WNj-ihnzXjaeJfbMs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfhughdToSf3qKvsEwIJZdbDzn1UWKpO2fziyRKIMPFw&oe=6A99799D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJZa2KW0ZQcQ7kNvwEQ4hSI&_nc_oc=AdoY49zrK8HSvnWn5I5do64-2FV_JaHGv3R2h4EJlcMqTSYZwtV7TLSWaD9dVQgTbeU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKCgBWHFOOarvPdJz2gWfKYT3NmU0qWJqvxJHC5ubQMQ&oe=6A999274"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9zGnPyvVGwQ7kNvwFvk_Sz&_nc_oc=AdrAKzySt27ty4MQiGINmm5_IPHvo36PrGXwI3FggR6eXlLRrS6_9IHP4J8r4MJFYEg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI86oZevrq5B4h9CRkhCBZUMuIa8Tz1k3I_HJm-lqlVTw&oe=6A997160"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
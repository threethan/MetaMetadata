6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gs9Bv6c39X4Q7kNvwGd0EhQ&_nc_oc=AdrV73COjuviga3g8Ua11JBQO0jJJwMdNHG8N19NFOll_Yn8RPqqNkny7GvGE2Y3atw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvl7Ud04AIE8htrPxHMgdxbcgLcMNuiYAikq130E-aiA&oe=6AEF635D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wp3ANG9s1jYQ7kNvwFsMutK&_nc_oc=AdpsMovxtfdMQfo_2VNh1GhGdo4zeMPWeTv9-lOCDCLdM89TaRoGHbh4s-cQnKJgIjw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjCr2d5d2Bpe_N4HI2ZFkwKoH-C1IZcG_4XXIdNO2fvQ&oe=6AEF43F4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lUuonkBKxsQ7kNvwEhtXj3&_nc_oc=Ado0NMShY0yLC64p1x-GWkMEIwadVHUnyAkeM60JrFup3z0He_7oo6RDpiUhyTvsZrs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ65eF9oKaMnUrrriy_F-3MWKXa5S-xrh9yS2aYkpF1A&oe=6AEF5B20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
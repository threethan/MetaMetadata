6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lScjI_X9tzUQ7kNvwGZ1cjK&_nc_oc=AdquI1T9S5TAvyZ7WvitEewGu4dB8pSuuKIXCcwV780S42804bwjh56gc3WJkuaLerw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGztjOV32-fuwg91fr4vzA1HkEzs9cnIdgtVxmFfExGw&oe=6AB7CC1D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLB5aUmGqfoQ7kNvwGq7fpw&_nc_oc=AdpuH5UK-g7Ezs1EKk-Z7WP-zekQ3JiXS5JLk8Ug47B_KmoxUIfLJS4IE1QBar0ssR0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFcNeYFefd8vgeTuUqJbcV7HD10OTf_ieRYDvbG1CH2Q&oe=6AB7E4F4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cewxlnrWwCwQ7kNvwHpAx7Q&_nc_oc=Ado8WlUu-pLzQCXvI01y9o3YUHH9woRxTe-CyC71IoK28U7QpRswH8tD99mMe1YJKmI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJINtZ7Y-OCZuvUgHO1fMW8aK4XSQCafWgYHOGaTavhVw&oe=6AB7C3E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
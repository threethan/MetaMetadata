6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvBxTlTRQ4kQ7kNvwFGem6L&_nc_oc=AdpLaFBYh4NCCVOZ0Xv3eu_4RnnuKW_Pf7D0MVcFO95hhQdrVtXLeNK23-OpSiFQHFo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Seu4qn_RHeJAf_uLW-At4GKVAxDCcJcNEqGiSyx5KOw&oe=6A0B179D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3423d9-KkHwQ7kNvwH2e7Uv&_nc_oc=AdrLT1mWaXc8oar7yoTSNGJRec59LDiGdYgztwjsdYQhRuEZRkdS3BsE0jjXWXVy-nU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iPZmQ7A6CrLjxbGpkqhvl4pJ6--FfoMwk040S8oMvsw&oe=6A0B3074"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N82O6j3gF54Q7kNvwF5JvHx&_nc_oc=AdpTBJeSK3qg7E1wVFt_FyWhKxBGFEftIJkLOSGW8SpSZ9Bx7yOlGcsFrdIIXB-MK9I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6b06NCrml4P0G-Vn03SwvOXPXWCECCvwb4G26KUn-bWQ&oe=6A0B0F60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
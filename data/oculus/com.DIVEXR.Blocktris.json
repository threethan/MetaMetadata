6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAIMTHKoNBsQ7kNvwGaRbww&_nc_oc=AdrMWuS8vc6YhUuI_88fnboeLPBXo7eEfz2JkAWC8B4qW4L2tU5w-rhvOjkrXvCVnzM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjAALRZldOCUSYxZNHc6ygbhKOBEc59PjsU6g4M7K-kw&oe=6A75E11D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4C3tS9g4sAIQ7kNvwH-jEZ4&_nc_oc=Adp2fY1IqwXP5YIue2-irbRJ7tACuBNib7qawFPZlDzeL3Qkmmljffy9S5XewT-S-3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELmjr0_dvnOvOOmujT0IRdKkEIVZCiEVCMswNBPwbvaQ&oe=6A75C1B4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0O6QBwZ2KEMQ7kNvwHUUyKb&_nc_oc=AdqRnljLlHF7t3yfDG1o2J-YJef31K0i387KMv6j4bckaMPZEnEvL45Chvrxsn3WSyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcPTHTKjXKw3FH8XWgt55ZCBYstcfXD0OOHPW-8hT-_g&oe=6A75D8E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
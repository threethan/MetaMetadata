6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kt77Nz3owrsQ7kNvwEx7-9q&_nc_oc=AdreJKIXbhKPQskeTJXSv0MQGmkP7HLurN8J6HZPRc5cyG6CGAsVU0f_0eAMuBKQRIs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhcjS87H4uqqFpW6Bzff79HNOKM4TPVp3x_S7sIJKapA&oe=6ACCE41D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ou2vMDK-JGoQ7kNvwFuVV3I&_nc_oc=AdrMYE2X-RY_veYQyuqAvY4SYH57krli9ECEBao8qKwzPG-SnP6TgCq66xo-nwp2D-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8mpJQ4Uli66pbn6nVWSj7vyVbb-gw-Er9iscqQPtOsw&oe=6ACCFCF4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeXGfJKAB78Q7kNvwF8-QrL&_nc_oc=Adq3jI0wMyqbIH0rBkqg2uMQtW8CQmFxB1JVXgMhgal4JIvsGRn_FEMu1Pbmm3zwhd4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9Xe-R_b7C-c3dC4iw3jwMcqZhat7hydJcyN3JfBD9cA&oe=6ACD1420"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
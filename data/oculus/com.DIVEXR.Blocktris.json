6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_lKSkfcAhUQ7kNvwH6QsYk&_nc_oc=Adpp3qqoqk4ziaHeJVtG_h_L41oF8ndvYG21yV0MJfsdWM0Kk52aQMJmlz1z8z1TOmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PAanTJzVOQas24PLv6rAc8OpOOkzQ_n0YDsVJ2sW4Kw&oe=6A47BC9D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzcJbmh3sNgQ7kNvwHeQH2N&_nc_oc=Ado3JfzNOgoAaDlf3prGwzKQuoXYjVrkZ3_c12bj_DAaIoJw4SZ1EF-8NtYQmy62rME&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QLj3nMmkt8zufmdydYiFOtli0DYIWwhtlMBsyR1yB8A&oe=6A47D574"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzwNGZ3E_mUQ7kNvwHqWI0p&_nc_oc=Adoy7r_v6zkB_e5Y016yBz2csOplM6mVXeNuG5rDZkEM_rJEAWGW55gs7a380mF7wSQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LujiUGNzeFjgxQBYqIbA9ukCslWF1zXrgekyhNYqnGQ&oe=6A47B460"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
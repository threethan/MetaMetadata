6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PjgJ79d2bMQ7kNvwGELkHs&_nc_oc=AdpPg4c3wrjzTxloRZRNqZVqhUgFY1lyUGYa_qBkEuHzrMu5ss5jcvJrUL41LBu30YI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKu2DA6hUqXViwFq7MnqxYysS1oOiW9xKCo5-eJwy3ybQ&oe=6AA2B41D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bs6Xvi9iaTYQ7kNvwHkXgcl&_nc_oc=Adr6QiSIjb5DK-5lvxZdFzbflWFCt3MoKzroyK10EEV9_Xv3sH1-1cZ7BUun8PtxjI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI13_0QI7GmgYuGPYTc1yCzI2mjU17w-xX3kB0BLCN_tA&oe=6AA2CCF4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnPs-ITojM8Q7kNvwGpL8zt&_nc_oc=AdrZLgghgkqttiIl01yTPIsMP9KItg9ETN6X-edbdUWxnwx2eqOOdsHGzbR_QUynVYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfIe2IT_Ix2ku1XIEMgtZlE9VSwozC_d5gPiQP_MiqTQ&oe=6AA2ABE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\nFeel the thrill of snapping the perfect placement, the panic of looming stacks, and the satisfaction of carving out last-second saves. \nIt\u2019s the classic block-stacking vibe\u2014completely reimagined for VR.\nSet new highscores, challenge your instincts, and discover how far your 3D puzzle skills can really go in Blocktris.", "short_description": "Blocktris is a fast-paced 3D puzzle game where you rotate and place falling blocks to clear lines in a fully immersive VR space. Easy to learn, hard to master, and endlessly addictive\u2014feel the thrill of perfect placements and rising speed as you chase new highscores."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/blocktris/%ED%99%88", "developer_terms_of_service_url": null, "publisher_name": "DIVEXR", "support_website_url": null, "website_url": "https://divexr.co.kr/table-party/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24860132527001832"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "904209955666047"}]}, "baseline_offer": {"id": "904209955666047"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771822800, "status": "PUBLISHED", "id": "904209955666047"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary
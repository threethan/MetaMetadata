6"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBtATai7GdwQ7kNvwHEGAI8&_nc_oc=AdqF66w0jx3ktN9Ii3LgdFMqgdGZrw_yA7YSGoRAa811-mTfA3HBzoyB09mlMrGLTQE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyceGreoPIzmEvpYbx3t7YMYzKAXQXD25ekuXg6uJzxg&oe=6A806D1D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIZv7spEXrkQ7kNvwEW-2GZ&_nc_oc=AdpKQtKsLOwYEmtHebGiqAJwKGdj66VGBMqyS2UHzDiXdNA7w0cC9_RK_GY_1p_uoL0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyKTfMs1BYZTIcmzndJZ0dnUCiPS_ZG-CwS-yosNOe3g&oe=6A804DB4"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PE0C4MH5yfsQ7kNvwHCfQdy&_nc_oc=Adr6WFDRnI-Sf5xRs6sJLOQv_sflxHEZ9ptN28Rb3GZLKziY0OCEUKIJVrekprcT03w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg_0LDfkEI4nO27mvkNKZ-PKDhvztoM-mvNtH-kIt4Dg&oe=6A8064E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Push your limits and set new highscores in Blocktris!\n\nBlocktris is an immersive 3D puzzle experience where falling blocks, quick decisions, and spatial awareness collide. \nRotate and place each piece in a fully explorable 3D space, clearing lines while the speed keeps climbing and your heart keeps racing.\ud83d\udd79\ufe0f\nSimple to learn but tough to truly master, Blocktris blends intuitive rules with deep strategy and a dangerously addictive gameplay loop.\n\n
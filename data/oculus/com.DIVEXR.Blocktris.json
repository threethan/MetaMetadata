kNvwEtsrzQ&_nc_oc=Adpw7KgEuXHQBwfBRCC4k51YJecpOE84BoBYjqJGmmdoNkl2RL2bSvcr-wcd50nwbbk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTTW4IO4fQdeECpEZjRfV9JglXp8HL2EsOEXN8Fk87Pg&oe=6ACE4476"}, {"file_name": "Blocktris_screenshot3.png", "id": "1954858398411944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619588_1954858405078610_2312369734479224176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LHVYosLIJYQ7kNvwHvc70Z&_nc_oc=AdrPSKPLuuKoqX4MBsaPKVVsyByWWRdMutlsKlBQ-KXzpOAXY_UbVHrkIuxBaIYNNfU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN__U0mJ2-_PEMmSTgGM_CgxbafOGoH9zoeQm2JXZJpag&oe=6ACE359D"}, {"file_name": "Blocktris_screenshot4.png", "id": "814570061456403", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618293_814570064789736_152338307182283668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ou2vMDK-JGoQ7kNvwG38qLH&_nc_oc=AdoQDMsqLIRnsXyzirCaQFUoWMlLBJlkCc5mM-GQjJoK6I5nDnb3BIzJoIGj1_duG1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVyAKw-BfiCM4hgIG8dBYbxUhkbwuEKCokD7yhR-CG0w&oe=6ACE4E74"}, {"file_name": "Blocktris_screenshot5.png", "id": "3832847133684021", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619148_3832847140350687_4259946231422621126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeXGfJKAB78Q7kNvwHvwZmq&_nc_oc=Adrz6Z2TceY-SywG0WD1aSXn6RQTAV658a16WD44ldwI3Gj6tPj2VKHoJyfIdaEHvQ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8qm0EMmcMp3oddOJI544iPScvLSusk1D50XoamAeisg&oe=6ACE65A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art.png", "id": "1656228502196655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295547_1656228505529988_2278581726178933183_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anp19Sn1V9AQ7kNvwGwxoI7&_nc_oc=AdqDFLxwCO7bTaGzBXvzP_iBc1_DGHr9RPRXTL24i3G_HvxQ93AjFGGmM-StPW6eBEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk0m6DprTKqVVv0runMGW4Hfzn9_iGD6tIWZn0_URa3w&oe=6ACE584F"}, "display_name": "Blocktris", "keywords": ["arcade", "blocktris", "block", "party", "puzzle"], "long_description": "# Awaken Your Senses with Blocktris!\u26a1\n\nSatisfying block-snapping action meets high-speed puzzle solving.\n\nEasy to learn, hard to master, and endlessly addictive\u2014feel the thrill of perfect placements and rising speed as you chase new highscores.\n\n\n{941107781792755}\n\n**Feel the Flow of 360\u00b0 Action Puzzles.**\n\nYou can grab the blocks and the platform, spinning them freely in your hands.\n\n{1660597168447102}\n\n**Find the Hidden Gap.**\n\nTest your spatial awareness by hunting for the perfect fit.\n\n\n{826497357124422}\n\n**Complete the Lines, Pop the Blocks.**\n\nYou can strategically stack your blocks to build up the tension, then trigger a high-impact blast that shatters them all at once.\n\n\n\n{1377924340774688}\n\n**Chase the High Score.**\n\nClear out the blockers, keep the board under control, and push your score as far as you can.\n\n\n{1290897786230471}", "short_description": "Blocktris is a fast-paced 3D puzzle game where you rotate and place falling blocks to clear lines in a fully immersive VR space. Easy to learn, hard to master, and endlessly addictive\u2014feel the thrill of perfect placements and rising speed as you chase new highscores."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/blocktris/%ED%99%88", "developer_terms_of_service_url": null, "publisher_name": "DIVEXR", "support_website_url": null, "website_url": "https://divexr.co.kr/table-party/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory
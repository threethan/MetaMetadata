.com/v/t64.5771-25/38974850_3525950357657678_5409943578556829102_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-sBysSWBOQQ7kNvwHElJGU&_nc_oc=Adm3TlorPbEqy7aHhOSE9OjnNFafKPESaSczc2iT7uV0FtFjBCbIp5mDz4wS9lK7_90&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxW-9houPrZnVzfPxtEeNGteiY_kXKdEogKrRQxR5tOvA&oe=69B16564"}, {"file_name": "screen3.png", "id": "938036503969558", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974482_938036507302891_5237292872038322952_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3Bhk0x7KYgQ7kNvwFdMpeO&_nc_oc=AdlBblOkiC6xP-3a1F7yKCiSXU0MMwSBgqpIePx5uzx1iGB8eq1VJ7wkp4b5Kv7Pkjg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_U6A2lJvkSgUO4FNvjCxmV0VSBfbUQdMgJBs6N4vkdg&oe=69B173CE"}, {"file_name": "screen2.png", "id": "1736955740074848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75608439_1736955743408181_2986097100654603621_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KA8LwQoihIQ7kNvwELEGcC&_nc_oc=Adlk10ja5irXqNjyd4EA5NnEwbz8OXkxMVXM8X2W95HDwdrGEZSwVs9d8UpdEEnM2U0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyqskrs78bLJ7vEGzpM1kHYmD8TYLjwJjwK4gCPharx_g&oe=69B1477A"}, {"file_name": "screen5.png", "id": "201768446167810", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982569_201768449501143_4812328122162335373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5Ht5iOCThsQ7kNvwHPh9UL&_nc_oc=Admw6kyMeZ6v3aE10hXhlD0PlBm8VS4uu75Wqb21Z_6AVXxCwCAoVsncURXNP8Fy-GU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWJC1q43U8-W08DbbjEE_keBeF-s1dD9hgUUA0pNp1cg&oe=69B178C3"}, {"file_name": "screen4.png", "id": "743197550940901", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982675_743197554274234_7472920820463675506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wm8Ri0Uc5SQQ7kNvwHUeTNA&_nc_oc=AdluyZ8Wn5PfVyzgY6je9bkRA2jl5QMbaCCyosy2Lm8K2WlSTDYPAb6DJmxhlcEyY38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2EgOqvSeOPPMUjaMj15rent0WzIpcGECtnfGjdW0ycQ&oe=69B14E0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1012042806807242", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031310_1012042810140575_8276748851544752544_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WYB9FiVcTQQ7kNvwHE_owM&_nc_oc=Adl97nmqfpjSTarVOL1eHAM6dVSsGKrL0ftqv6EWxxjmlyImSdcfcXpDYVc-vjZ6lzU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHKNmuKMYW2M215JAtDrpkanteWPoMHy-ddOj3q_d41w&oe=69B1618B"}, "display_name": "ShootPoint: Lost Worlds", "keywords": [], "long_description": "Dive into the adrenaline-pumping gameplay of Shoot Point: Lost Worlds, an addictive arcade-style game that will put your shooting skills to the test. With a focus on fast-paced action and precision, this game offers two exciting level types.\n\nIn the classic levels, you'll face formations of colorful cubes, each representing a target. Your goal is to eliminate these cubes as quickly as possible, racing against the clock to complete the level. Can you master your aim and speed to finish with the fastest time?\n\nFor those seeking an endless challenge, the arcade levels will push your reflexes to the limit. Brace yourself for an infinite stream of cubes hurtling towards you. Your objective is to shoot as many cubes as you can within a limited time, aiming to maximize your score. How long can you survive and accumulate points in this intense arcade mode?\n\nGet ready for an action-packed journey where accuracy, speed, and quick thinking are the keys to success. Are you up for the challenge? Aim, shoot, and dominate in Shoot Point: Lost Worlds!", "short_description": "Immerse yourself in the fast-paced action of Shoot Point: Lost Worlds. Take aim as a skilled shooter and blast your way through challenging levels. Test your speed and accuracy as you shoot colorful cubes to earn points. Can you conquer the classic formations or survive the infinite stream? Challenge yourself and see how high you can score!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://shoot-point-vr.webflow.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "Future Classic Ones", "support_website_url": null, "website_url": "https://shoot-point-vr.webflow.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2266100263588574"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "334117018938162"}, {"status": "PUBLISHED", "id": "1462247014560082"}]}, "baseline_offer": {"id": "1462247014560082"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1689778800, "status": "PUBLISHED", "id": "334117018938162"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6844144835597953", "version": "0.0.7"}, "id": "822945922595722", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6734838203195284", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6844144835597953"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "L
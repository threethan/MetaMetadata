.com/v/t64.5771-25/38974850_3525950357657678_5409943578556829102_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAXgaVtp434Q7kNvwHa-uFn&_nc_oc=AdlMZjBVZkxQqW61nUarKWS1ASU53LVVOP448NmmsDbeUfx6mFftiiQhktcdGo5Iq00&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHkXh6Nx43do9LymmDqjpb7oEVnr1TP0dlppB8ouERLg&oe=69B013E4"}, {"file_name": "screen3.png", "id": "938036503969558", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974482_938036507302891_5237292872038322952_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3Bhk0x7KYgQ7kNvwGxP2vQ&_nc_oc=Adl2wD6YEMqjm0fcBYp2pcVWkDCU5H6UibFaOfWBow_wGQjgYsDoId3_Mqa81mBxIRQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoA1EZXQzTDp5UW6RaI103_DtN0Zd6PyJrZI3wT99x2w&oe=69B0224E"}, {"file_name": "screen2.png", "id": "1736955740074848", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75608439_1736955743408181_2986097100654603621_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KA8LwQoihIQ7kNvwF4bV_R&_nc_oc=AdkowbgE7L1BD8CVadZ-49JCxUDjUZuIkrAoweL_bIEwX8pfjwZW7NeaCVzi5zAbQ6w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhW45eLqesL8LHovSDqFnuV3q3G4satvoPiPIk9OWTJg&oe=69AFF5FA"}, {"file_name": "screen5.png", "id": "201768446167810", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982569_201768449501143_4812328122162335373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5Ht5iOCThsQ7kNvwG93SEx&_nc_oc=AdnmNOG2lY2m87mzAx5dNPMCNPTg_Ss3tMZ6IzkLF5cQAvdaZwhp7Qtn3SgmLgdNjf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzrGXV-yAgz6pwTYAW3NQoeATEHVoj23CfhT9SlBDoPRQ&oe=69B02743"}, {"file_name": "screen4.png", "id": "743197550940901", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982675_743197554274234_7472920820463675506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wm8Ri0Uc5SQQ7kNvwFZrZ0f&_nc_oc=Adk5iwWhc3fzx_awOnMJkP08vPHF_8a3kO5odfruljrhFtDZjJuMcrX9WTGN2JZEECo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7k4yPygWDhu4R2-Ml4zu-AEPbEBXymOuRwfKV1vVzWg&oe=69AFFC8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1012042806807242", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031310_1012042810140575_8276748851544752544_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WYB9FiVcTQQ7kNvwHVVoc6&_nc_oc=AdmnybTtwcz2H61uOwRlEQxowrGqLjcRhTf1n9vLvmXl527myxkuU3ECtdcA_mYkGM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQMDGm3DdEZGniet9GNgeVEeNLV9TQQmSAo-L3Q_QrYw&oe=69B0100B"}, "display_name": "ShootPoint: Lost Worlds", "keywords": [], "long_description": "Dive into the adrenaline-pumping gameplay of Shoot Point: Lost Worlds, an addictive arcade-style game that will put your shooting skills to the test. With a focus on fast-paced action and precision, this game offers two exciting level types.\n\nIn the classic levels, you'll face formations of colorful cubes, each representing a target. Your goal is to eliminate these cubes as quickly as possible, racing against the clock to complete the level. Can you master your aim and speed to finish with the fastest time?\n\nFor those seeking an endless challenge, the arcade levels will push your reflexes to the limit. Brace yourself for an infinite stream of cubes hurtling towards you. Your objective is to shoot as many cubes as you can within a limited time, aiming to maximize your score. How long can you survive and accumulate points in this intense arcade mode?\n\nGet ready for an action-packed journey where accuracy, speed, and quick thinking are the keys to success. Are you up for the challenge? Aim, shoot, and dominate in Shoot Point: Lost Worlds!", "short_description": "Immerse yourself in the fast-paced action of Shoot Point: Lost Worlds. Take aim as a skilled shooter and blast your way through challenging levels. Test your speed and accuracy as you shoot colorful cubes to earn points. Can you conquer the classic formations or survive the infinite stream? Challenge yourself and see how high you can score!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://shoot-point-vr.webflow.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "Future Classic Ones", "support_website_url": null, "website_url": "https://shoot-point-vr.webflow.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2266100263588574"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "334117018938162"}, {"status": "PUBLISHED", "id": "1462247014560082"}]}, "baseline_offer": {"id": "1462247014560082"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1689778800, "status": "PUBLISHED", "id": "334117018938162"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6844144835597953", "version": "0.0.7"}, "id": "822945922595722", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6734838203195284", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6844144835597953"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "L
c_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDONbqgCTEL-cJ8f27CI4eV-cVOeF0UOC6V9ONF7b2F-g&oe=6A54EC68"}, {"file_name": "Screenshot1.png", "id": "535099376239105", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393858_535099379572438_533949098123749719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LamT7_FS6oEQ7kNvwFXXs_7&_nc_oc=Adop_yk2Ci68_jzVt3EQFL1BSReHJ-XWIz2cyn4bOxlSsZA8-lud4SOWfAvwp9KJwvY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIZ42kN3VX0ctb0rBlBkghu2mgROgbcJhb_5mYnSh2Sw&oe=6A5505C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gadget Blaster", "keywords": ["puzzle", "shooter", "chill", "casual", "arcade"], "long_description": "Step into a serene virtual world where challenge meets relaxation. In this immersive VR puzzle game, use your hand-held plasma blaster to energize a variety of innovative gadgets, each carefully designed to help you solve engaging physics-based puzzles.\n\nWith a calming atmosphere, soothing soundscapes, and thoughtfully crafted levels, Gadget Blaster offers a unique blend of mental stimulation and tranquility, providing the perfect balance of mastery and zen. Whether you're solving puzzles at your own pace or reaching for the top of the leaderboard, every moment is a chance to unwind, think creatively, and immerse yourself in a delightful VR experience.", "short_description": "Shooting gallery meets platformer puzzle game - blast your way through a variety of physics-based puzzles with a chill vibe and intuitive gameplay for all players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gadgetblaster.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VectorSource LLC", "support_website_url": null, "website_url": "https://www.gadgetblaster.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
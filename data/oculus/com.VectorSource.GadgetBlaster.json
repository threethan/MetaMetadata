, "id": "535099376239105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393858_535099379572438_533949098123749719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbszLG6w0IoQ7kNvwGUcjPd&_nc_oc=AdkXYnEBm9OiBK5xZJ5prqqIAd9yzLAJuqPwhgYeCoW9CtufxPeVBQddGN_zBQkcKks&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft5XQuQg3fo6ZiC5x7bvuQHrLnIMC4iYITz18gG774V6A&oe=699EDE88"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gadget Blaster", "keywords": ["puzzle", "shooter", "chill", "casual", "arcade"], "long_description": "Step into a serene virtual world where challenge meets relaxation. In this immersive VR puzzle game, use your hand-held plasma blaster to energize a variety of innovative gadgets, each carefully designed to help you solve engaging physics-based puzzles.\n\nWith a calming atmosphere, soothing soundscapes, and thoughtfully crafted levels, Gadget Blaster offers a unique blend of mental stimulation and tranquility, providing the perfect balance of mastery and zen. Whether you're solving puzzles at your own pace or reaching for the top of the leaderboard, every moment is a chance to unwind, think creatively, and immerse yourself in a delightful VR experience.", "short_description": "Shooting gallery meets platformer puzzle game - blast your way through a variety of physics-based puzzles with a chill vibe and intuitive gameplay for all players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gadgetblaster.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VectorSource LLC", "support_website_url": null, "website_url": "https://www.gadgetblaster.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
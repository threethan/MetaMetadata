ng", "id": "950049733763048", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391980_950049737096381_3217244151556211237_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybWlus81HEQQ7kNvwHIqUj3&_nc_oc=Adoqj28GR5CHR7fW7WO-2lZZBdSnlJpsXOdhdgOoyo19R_WhoXpLTFUyy8SyjjKFzfA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwN9BPZhfU31AD_pTNA0I1BBuj_YTu1g49qQ-jmmlrPw&oe=6B05CDA8"}, {"file_name": "Screenshot1.png", "id": "535099376239105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393858_535099379572438_533949098123749719_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeVKQe-MIRMQ7kNvwGBBOvf&_nc_oc=AdqRNi5POzNyEfnF2Kjws6a-lyXPxnPGOnr5RahlTQueQ92dEpLNBBmwp44MA1K97gs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm0x7xzFossn_DeIfQoi0rDP5usWrC-rYQ0W2-TI60aA&oe=6B05AEC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gadget Blaster", "keywords": ["puzzle", "shooter", "chill", "casual", "arcade"], "long_description": "Step into a serene virtual world where challenge meets relaxation. In this immersive VR puzzle game, use your hand-held plasma blaster to energize a variety of innovative gadgets, each carefully designed to help you solve engaging physics-based puzzles.\n\nWith a calming atmosphere, soothing soundscapes, and thoughtfully crafted levels, Gadget Blaster offers a unique blend of mental stimulation and tranquility, providing the perfect balance of mastery and zen. Whether you're solving puzzles at your own pace or reaching for the top of the leaderboard, every moment is a chance to unwind, think creatively, and immerse yourself in a delightful VR experience.", "short_description": "Shooting gallery meets platformer puzzle game - blast your way through a variety of physics-based puzzles with a chill vibe and intuitive gameplay for all players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ww
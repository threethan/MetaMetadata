cdn.com/v/t64.5771-25/39031634_151481317791462_2345747732445713978_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3BmCvgmz9cQ7kNvwFQvyu9&_nc_oc=Ado_aFSb34-HYiyUGiAStqVXPldpFunUkJ_pGYhJjjYqkuKKW_QG4l1KWk09tKaahJI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI4VGbzl0QaRy7rZC959F6n72GHqH1AtDJKEUXNzX21A&oe=6AFB3E61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "In the Shoes of an Autistic Person", "keywords": [], "long_description": "Developed by a research team led by Marc Lanovaz at the University of Montreal, this virtual reality app aims to raise awareness about autism in the population. Its purpose is to put the user in the shoes of an autistic person in a situation that may seem trivial, finding a dentist\u2019s office. According to a study conducted by the researchers, using the app may improve attitudes, knowledge, and openness toward autistic persons. ", "short_description": "Developed by a research team led by Marc Lanovaz at the University of Montreal, this virtual reality app aims to raise awareness about autism in the general population. Its purpose is to put the user in the shoes of an autistic person in a situation that may seem trivial, finding a dentist\u2019s office. "}, {"images": {"nodes": [{"file_name": "CoverLandscape.png", "id": "3550175668548555", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982640_3550175671881888_4146585134630804611_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiLvmZW2Ph4Q7kNvwFxvkpX&_nc_oc=AdqrCTupT-Nx60Q7fCRm6Rjav1GWmwNwZ5h9Xshx9bPpc2_IQHLqxTIaD_aohmgkruA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1MmR_5e-pHLOpmqPEY3ADIvqGmVW-YXy8eLKuuQHAGQ&oe=6AFB3B17"}, {"file_name": "icon 512 x512.png", "id": "736014468129418", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974452_736014471462751_6665077
cdn.com/v/t64.5771-25/39031634_151481317791462_2345747732445713978_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTKkeg88V9UQ7kNvwHAoAUP&_nc_oc=AdpADoU6X7H9kYSlhTJMk3qXx4B0wFb9M2DuukQ0IbaWAWnCoLQTywl_i9-raQTOQPg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUWiyDUkeRE-I8TA-PEfiO8m-oYRRxy7_MzJUjdHEFMIg&oe=6B105661"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "In the Shoes of an Autistic Person", "keywords": [], "long_description": "Developed by a research team led by Marc Lanovaz at the University of Montreal, this virtual reality app aims to raise awareness about autism in the population. Its purpose is to put the user in the shoes of an autistic person in a situation that may seem trivial, finding a dentist\u2019s office. According to a study conducted by the researchers, using the app may improve attitudes, knowledge, and openness toward autistic persons. ", "short_description": "Developed by a research team led by Marc Lanovaz at the University of Montreal, this virtual reality app aims to raise awareness about autism in the general population. Its purpose is to put the user in the shoes of an autistic person in a situation that may seem trivial, finding a dentist\u2019s office. "}, {"images": {"nodes": [{"file_name": "CoverLandscape.png", "id": "3550175668548555", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982640_3550175671881888_4146585134630804611_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0wlziDXEWwQ7kNvwFdtKsA&_nc_oc=AdqqPbi4-WMCJ7LyAB2xd-YCxJgUBx5o_3o3T9CSJevbw4xhi9EgSz2RhR3eOeV3-vo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVv0xvDurUK0AHPAXK0UxfoA8jBVUmNWKd1VatVYYX-Zw&oe=6B105317"}, {"file_name": "icon 512 x512.png", "id": "736014468129418", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974452_736014471462751_6665077
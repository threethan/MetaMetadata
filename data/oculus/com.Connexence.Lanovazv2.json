cdn.com/v/t64.5771-25/39031634_151481317791462_2345747732445713978_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3BmCvgmz9cQ7kNvwEGia0x&_nc_oc=AdoiLFS5gQ8jIIZlG1ZlsAZDuN31bqPZaSnNEQe7LnkRI3NPH_-HD0D_4ppmwW9cGsg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPyAdEm4JPHX-ad3yPUOBH7rhj0AUAIoGpmJ0A_Uq7Lw&oe=6AFDE161"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "In the Shoes of an Autistic Person", "keywords": [], "long_description": "Developed by a research team led by Marc Lanovaz at the University of Montreal, this virtual reality app aims to raise awareness about autism in the population. Its purpose is to put the user in the shoes of an autistic person in a situation that may seem trivial, finding a dentist\u2019s office. According to a study conducted by the researchers, using the app may improve attitudes, knowledge, and openness toward autistic persons. ", "short_description": "Developed by a research team led by Marc Lanovaz at the University of Montreal, this virtual reality app aims to raise awareness about autism in the general population. Its purpose is to put the user in the shoes of an autistic person in a situation that may seem trivial, finding a dentist\u2019s office. "}, {"images": {"nodes": [{"file_name": "CoverLandscape.png", "id": "3550175668548555", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982640_3550175671881888_4146585134630804611_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32fqG1Kp_WwQ7kNvwGFsDny&_nc_oc=AdoUZtXA0CKR1qn-b5gOUwqsC7qbBLaXDIeWrD_TAv0L190xSp_F-nH6hfdX5Cx-o6Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeXKIVMWK_HG-ak1L2NUiqtHdU_PAmPo_ogX43tYX5_A&oe=6AFDDE17"}, {"file_name": "icon 512 x512.png", "id": "736014468129418", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974452_736014471462751_6665077
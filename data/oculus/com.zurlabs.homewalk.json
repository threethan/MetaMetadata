com&_nc_ss=7f20f&oh=00_AQTjO9e3zYgXtpcTBwyFy3MezhnRY0LDaalhQnu7kQ3D7g&oe=6B0079E6"}, {"file_name": "3.png", "id": "39775245362089294", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827601_39775245382089292_5759835075749763163_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2J9mdmWN7AQ7kNvwE2mYFm&_nc_oc=AdpOc0NJ3fBxyy6aptwuTdXut8vhDjuDf8-GxKbg7SZLEQssGH5-HPAkI56vpcemuMU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8m_PENMOaChkJqqKPRjqiQDud5pb2hv0Jkgg1pwVb2w&oe=6B005BA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HomeWalk", "keywords": ["walking", "treadmill", "fitness", "exercise", "steps"], "long_description": "No treadmill? Walk your home.\n\nHomeWalk reads your Quest's Space Setup, plans a loop of long, straight lines around your furniture and lays a light path on your real floor. You see your home the whole time, in passthrough.\n\nWhile you walk, a screen stays in front of you: a simple browser with six tiles for the sites you choose, for shows, podcasts, news or your inbox. Time, distance, speed, step and calorie estimates are on screen, with a chime at every kilometer (or mile). Levels, badges, daily goals and a streak keep you coming back. No controllers needed.\n\nOptional leaderboards under a nickname, no sign-up. No ads, no tracking, and your room scan never leaves the headset.\n\nEarly Access: HomeWalk works today from the first step to the summary, and we're shaping the rest with you. Free during Early Access.\n\nSafety: clear the floor, walk rather than run, and watch your surroundings. Steps and calories are estimates.", "short_description": "No treadmill? Walk your home. A light path loops around your furniture while you watch your shows, catch up on news or answer email."}]}, "developer_name": null, "developer_privacy_policy_url": "https://homewalk.zurlabs.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "ZurLabs", "support_website_url": null, "website_url": "https://homewalk.zurlabs.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1318544288017285"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1132770909709849"}]}, "baseline_offer": {"id": "1132770909709849"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792764480, "status": "PUBLISHED", "id": "1132770909709849"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1375384305666616", "version": "0.9.5"}, "id": "2613339502441929", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1318544284683952", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1375384305666616"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2613339502441929"}]}, "change_log": "A faster start: one welcome screen, then your route, then you are walking.\r\nYour first walk opens with a short guide that points out the numbers and the browser, then helps you find a walking tour.\r\nQuick buttons and ideas to find something to watch in one tap; sites open in their mobile layout.", "created_date": 1794805216, "id": "1375384305666616", "version": "0.9.5", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1318544284683952", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1375384305666616"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2613339502441929"}]}, "change_log": "* Send it from your phone: Share media from phone to watch while walking. \n* A short tour on your first walk, and a \"come back tomorrow\" card with tomorrow's quests after each walk.\n* The walking screen stays on the horizon and follows your turns smoothly. Pick what to watch, then tap Start.\n* Distance counts improved.", "created_date": 1794340966, "id": "1364557360082644", "version": "0.9.4", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1318544284683952", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1375384305666616"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2613339502441929"}]}, "change_log": "* pause music automatic when walking ends. \r\n* Choose whether to share anonymous usage stats.", "created_date": 1793279407, "id": "1335086339696413", "version": "0.9.2", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1318544284683952", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1375384305666616"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2613339502441929"}]}, "change_log": "Early Access 0.9.1: gentler walking screen, screen size setting, a route found automatically in any room, more accurate steps, and media pauses when the walk ends.", "created_date": 1792703175, "id": "1322143057657408", "version": "0.9.1", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1318544284683952", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1375384305666616"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792520338, "id": "1318561614682219", "version": "0.9.0", "version_code": 1, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
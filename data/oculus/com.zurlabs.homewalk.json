", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1318544284683952", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1392471963957850"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2613339502441929"}]}, "change_log": "A faster start: one welcome screen, then your route, then you are walking.\r\nYour first walk opens with a short guide that points out the numbers and the browser, then helps you find a walking tour.\r\nQuick buttons and ideas to find something to watch in one tap; sites open in their mobile layout.", "created_date": 1794805216, "id": "1375384305666616", "version": "0.9.5", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1318544284683952", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1392471963957850"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2613339502441929"}]}, "change_log": "* Send it from your phone: Share media from phone to watch while walking. \n* A short tour on your first walk, and a \"come back tomorrow\" card with tomorrow's quests after each walk.\n* The walking screen stays on the horizon and follows your turns smoothly. Pick what to watch, then tap Start.\n* Distance counts improved.", "created_date": 1794340966, "id": "1364557
, "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HomeWalk", "keywords": ["walking", "treadmill", "fitness", "exercise", "steps"], "long_description": "No treadmill? Walk your home.\n\nHomeWalk reads your Quest's Space Setup, plans a loop of long, straight lines around your furniture and lays a light path on your real floor. You see your home the whole time, in passthrough.\n\nWhile you walk, a screen stays in front of you: a simple browser with six tiles for the sites you choose, for shows, podcasts, news or your inbox. Time, distance, speed, step and calorie estimates are on screen, with a chime at every kilometer (or mile). Levels, badges, daily goals and a streak keep you coming back. No controllers needed.\n\nOptional leaderboards under a nickname, no sign-up. No ads, no tracking, and your room scan never leaves the headset.\n\nEarly Access: HomeWalk works today from the first step to the summary, and we're shaping the rest with you. Free during Early Access.\n\nSafety: clear the floor, walk rather than run, and watch your surroundings. Steps and calories are estimates.", "short_description": "No treadmill? Walk your home. A light path loops around your furniture while you watch your shows, catch up on news or answer email."}]}, "developer_name": null, "developer_privacy_policy_url": "https://homewalk.zurlabs.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "ZurLabs", "support_website_url": null, "website_url": "https://homewalk.zurlabs.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
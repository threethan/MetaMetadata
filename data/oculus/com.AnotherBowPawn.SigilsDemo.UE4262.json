3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJdq0KgcdlS9omCg2Eezd9Pu3SREjgK0wIE0zUtyh7Cg&oe=6AA408BD"}, {"file_name": "Sigils_Screenshot4.png", "id": "1553883395889964", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491819239_1553883399223297_5014755524618931531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awlU4ezizpkQ7kNvwHthamU&_nc_oc=AdqsfpejRvyInzeD_izj09WYtWqjtBs3gaTbEplSiRzOWitO3rlRxqtg78ojvGPXZb0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC0-5PATDre8-t3qe0CwPc7hw7rAs0kYI8yL0TRDUxCQ&oe=6AA40BE0"}, {"file_name": "Sigils_Screenshot5.png", "id": "1224985633055817", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821568_1224985636389150_7726596738901074431_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0x5BoQfbGAQ7kNvwHsEDnG&_nc_oc=AdpiBHZaz8kSvpaGFgbm5hsByUooB45L0tqGoV_8bxwxKSihPUIXuNV4NprAWYqgYjs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTJpI2QE-rRcq_60t6pK00FscI9q7Q_tt4zXl2_165EA&oe=6AA3EEE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sigils_Trailer_CoverImage.png", "id": "923868949996336", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491821704_923868953329669_4376257153732441700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dgnJ5WrAigQ7kNvwGbNj0q&_nc_oc=AdqR_vSQjvztURIxtvs7hwmgQlMPpaSW0Yp-uPBVImxqDGkLd5RZr2HcTSoAHrrVnWo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzWd5f2MuFeUy2Z-fwKSKGk_dK1FxYw0yCLhjfR_Zr-w&oe=6AA4042A"}, "display_name": "Sigils DEMO", "keywords": ["Strategy", "Action", "Magic", "Dragon", "RPG"], "long_description": "Fight your way through a fantasy world filled with magic and monsters, using your sigils and druidic dragon powers.\n\nUse physical motion to generate magic energy by punching spells, or slashing multiple enemies in your dragon form.\n\nEnter your spirit form and take control of your primary guardian and set it free when you rain down destruction with your magic sigils.\n\nCollect dragon eggs to obtain the power of all the guardian\u2019s and boost there power from crystals collected after you defeat the corrupted elementals.\n\nFight your way through 4 difficulty levels to master the Dragon Druid\u2019s abilities and become the ultimate protector of Gaia.", "short_description": "Sigils is a strategic action RPG with ability driven gameplay and roguelite elements. \n\nAbilities are powered by ancient sigils. Spells and action based skills are activated by selecting a sigil that defines the ability you use. Whether casting magic, firing your bow, or triggering movement based actions, each ability begins with a sigil choice. \n\nTest your mastery across four difficulty levels, each designed to challenge your understanding of the Dragon Druid\u2019s mechanics. "}]}, "developer_name": "Sigils", "developer_privacy_policy_url": "https://bueloekke.github.io/sigils/Privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Sigils Studio", "support_website_url": null, "website_url": "https://bueloekke.github.io/sigils/default.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27105215382467232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5
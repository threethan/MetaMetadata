tent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGXPGYv-sQGzoSouqJiKaPftTidfqXPI9Q2XX922vmdg&oe=69C92FBD"}, {"file_name": "Sigils_Screenshot4.png", "id": "1553883395889964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819239_1553883399223297_5014755524618931531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhPilFZawaoQ7kNvwEmZxSH&_nc_oc=Adp3zy5FqruRNiML9zeYuCuoQOT2rSthbe8KR0l12fzNbsbGmVYkViXbmFlysrEso6s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbESu5z3JoxiqUxHC5EAhiiM-V4AcNX-QrICYPe5ybwg&oe=69C932E0"}, {"file_name": "Sigils_Screenshot5.png", "id": "1224985633055817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821568_1224985636389150_7726596738901074431_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7t0j_cunrkIQ7kNvwGJuT7y&_nc_oc=AdqThCJxU_BeLuU5Ljp5HHGzAAqq23s8uEix-7LnfGM8bO_Nqlf5m0uTwLsq9gtgMtU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwD0Qnk_bU9uiMFTAQ151U3ozVwfn5b1y4Exp7h6lOqVg&oe=69C915E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sigils_Trailer_CoverImage.png", "id": "923868949996336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821704_923868953329669_4376257153732441700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WWdLiHY4toQ7kNvwHHLcWd&_nc_oc=AdoOgOBPJKXQdXT235dvYUFEa16VCUsEXqq51nZm3uola41CKOsgxki6s8ucE9Y8Dig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1o1TpdwnbfV8HKEN0jwETYRk2m1bTUdYtOIY3247tyQ&oe=69C92B2A"}, "display_name": "Sigils DEMO", "keywords": ["Strategy", "Action", "Magic", "Dragon", "RPG"], "long_description": "Fight your way through a fantasy world filled with magic and monsters, using your sigils and druidic dragon powers.\n\nUse physical motion to generate magic energy by punching spells, or slashing multiple enemies in your dragon form.\n\nEnter your spirit form and take control of your primary guardian and set it free when you rain down destruction with your magic sigils.\n\nCollect dragon eggs to obtain the power of all the guardian\u2019s and boost there power from crystals collected after you defeat the corrupted elementals.\n\nFight your way through 4 difficulty levels to master the Dragon Druid\u2019s abilities and become the ultimate protector of Gaia.", "short_description": "Sigils is a strategic action RPG with ability driven gameplay and roguelite elements. \n\nAbilities are powered by ancient sigils. Spells and action based skills are activated by selecting a sigil that defines the ability you use. Whether casting magic, firing your bow, or triggering movement based actions, each ability begins with a sigil choice. \n\nTest your mastery across four difficulty levels, each designed to challenge your understanding of the Dragon Druid\u2019s mechanics. "}]}, "developer_name": "Sigils", "developer_privacy_policy_url": "https://sigils.studio/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sigils Studio", "support_website_url": null, "website_url": "https://sigils.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2691890164460465"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26463044706684306"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819239_1590138935649514_4934027115026592527_n.png
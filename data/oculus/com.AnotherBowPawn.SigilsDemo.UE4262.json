042456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982453_358453423375789_6200493142914047639_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdAoFYQpSXMQ7kNvwFnB4jO&_nc_oc=AdnGsXepbJJgXgveAcdrfmVVcKrNYBgJBfIFq9zzUf0NtR1s_QOhKEJSEblD6cqcQh4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft1Sz3v8OHlEponI-T32Zbh2PMe5WH70hMlXymueN9aAQ&oe=69A96F75"}, {"file_name": "Sigils_Screenshot3.png", "id": "850342790156206", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001670_850342793489539_8903931807220071004_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2m47v6CRngAQ7kNvwGoRe4e&_nc_oc=AdkkxD-YPnIwhrFTDSb3_GwmI9bZ6egeR1yRlHdhkPm5okjrvius1unto9hGR4uWH94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv1ka03O8dg33Rkt3GAG8q1EJK1vNKKspDCR3WSnA8i_A&oe=69A976DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sigils_CoverImage.png", "id": "1153631758938934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031344_1153631762272267_6012782483585075551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJ_853X-U8oQ7kNvwFxYy8i&_nc_oc=AdlpjYQq62WgGNIf_HT8LmpAAmpI6dQ6O_0KMNFzyO3EkcTqHKNnDuLEYzYQ2jbx5uU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsadMv-UHwD5xFUZpNsRJI1Bl7OunTrX0RpIwi6ePG5Jg&oe=69A97188"}, "display_name": "Sigils - DEMO", "keywords": [], "long_description": "Fight your way through a fantasy world filled with magic and monsters, using your druidic dragon powers and sigils.\n\nUse physical motion to generate magic energy by punching spells, or slashing multiple enemies in your dragon form.\n\nEnter your spirit form and take control of your primary guardian and set it free when you rain down destruction with your magic sigils.\n\nMake the right tactical choices to balance your mana and energy levels, using your bow, magic and motion, combined with sigil and guardian cooldowns.\n\nCollect dragon eggs to obtain the power of all the guardian\u2019s and gain strength, stamina and endurance from crystals as you defeat the corrupted elementals.", "short_description": "Sigils is a stylized Action Strategy Magic Cards adventure where you create powerful sigils and grow stronger as you progress through the treacherous environment.\n\nIn this demo, you'll be introduced to the abilities of a Dragon Druid, and test your strength, courage, and cunning. \n\nSo strap on your headset, grab your controllers, and prepare to unleash the dragon within you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sigils.studio/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sigils Studio", "support_website_url": null, "website_url": "https://sigils.studio/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7306221032793294"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "756435406341687"}]}, "baseline_offer": {"id": "756435406341687"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1700780400, "status": "PUBLISHED", "id": "756435406341687"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26229183373403775", "version": "1.0"}, "id": "837924324681573", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "An
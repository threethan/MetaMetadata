081_905431378698169_8594389436188506314_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHfvVm_CcCYQ7kNvwGf9mLz&_nc_oc=AdrleSDQgL2fnH2Y1K8j3MA2xNy6CrsaWv-R8LDmimak_swwVPSKyIeXgwcX9X502S4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQJ2t7_jLc-W3ihjYrdf23X4w5hXzDxZKodYW8ijGueCw&oe=6B0C677D"}, {"file_name": "Sigils_Screenshot4.png", "id": "1553883395889964", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819239_1553883399223297_5014755524618931531_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdZvotz23S0Q7kNvwFGP83Z&_nc_oc=Ado1YMOj8cfhABT9AENHSCYIOHCMw6NBYiTHpuKfVsV75ahQZhdYl7gTssAlKiNuK8A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSIWVPFpPcfiwRg7NGwNEP-VYBcTVvlCQt5EF35SCpeCg&oe=6B0C6AA0"}, {"file_name": "Sigils_Screenshot5.png", "id": "1224985633055817", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821568_1224985636389150_7726596738901074431_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRgSdqZDmqYQ7kNvwHp8BBd&_nc_oc=AdrJI10GEpzSMaJ71rQ_rdK8tl04BgEBnPNy2JB52u5Bibjk-aVHmfPhbYeA7hRd3R0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRXn7HQx5i6MlCLfoMWyhAPGqGbgbWMc6SbJ2f5ygKiUQ&oe=6B0C4DA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sigils_Trailer_CoverImage.png", "id": "923868949996336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_923868953329669_4376257153732441700_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqeVMS4BifoQ7kNvwFXNnn0&_nc_oc=AdrfB5mZqifz-6oi6Hd90Dfp5nuIVgrXmtM8-D3ZpAfIFW4hbY-7PQOzvcjjpd1sPH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqDFw1DyfAh5RIEqLLq94HCzxPsmUljdymzOrTmgLUKQ&oe=6B0C62EA"}, "display_name": "Sigils DEMO", "keywords": ["Strategy", "Action", "Magic", "Dragon", "RPG"], "long_description": "Fight your way through a fantasy world filled with magic and monsters, using your sigils and druidic dragon powers.\n\nUse physical motion to generate magic energy by punching spells, or slashing multiple enemies in your dragon form.\n\nEnter your spirit form and take control of your primary guardian and set it free when you rain down destruction with your magic sigils.\n\nCollect dragon eggs to obtain the power of all the guardian\u2019s and boost there power from crystals collected after you defeat the corrupted elementals.\n\nFight your way through 4 difficulty levels to master the Dragon Druid\u2019s abilities and become the ultimate protector of Gaia.", "short_description": "Sigils is a strategic action RPG with ability driven gameplay and roguelite elements. \n\nAbilities are powered by ancient sigils. Spells and action based skills are activated by selecting a sigil that defines the ability you use. Whether casting magic, firing your bow, or triggering movement based actions, each ability begins with a sigil choice. \n\nTest your mastery across four difficulty levels, each designed to challenge your understanding of the Dragon Druid\u2019s mechanics. "}]}, "developer_name": "Sigils", "developer_privacy_policy_url": "https://bueloekke.github.io/sigils/Privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Sigils Studio", "support_website_url": null, "website_url": "https://bueloekke.github.io/sigils/default.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supp
=8&oh=00_AfzUn3mKN1w3w4CAH1It1lV5DvCNZB5OaEdFJBUWkzqwzw&oe=69BEA3BD"}, {"file_name": "Sigils_Screenshot4.png", "id": "1553883395889964", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819239_1553883399223297_5014755524618931531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_EMPpF8agkQ7kNvwHVgyQO&_nc_oc=AdkP7fIRaiDdV04xVk73oXZ3Pmfw1RIEnGdInd2eDLMmNI83ws8fxb37HVWJDO6c_K8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8NbFvhTUuztimEDBhrvppN0EYmEfD3OO_8dIpQKdrfA&oe=69BEA6E0"}, {"file_name": "Sigils_Screenshot5.png", "id": "1224985633055817", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821568_1224985636389150_7726596738901074431_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeCAeZDCbVEQ7kNvwHQB060&_nc_oc=AdkTCKJebnjRRUUBsAjBvzTjCwkld4I3iuFipDavdwMszS0Y-KDa708_EoTIb6wQ_qM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWCL6p06Yr-woguCn5TDMEC7CDxbIp6OEi64PFjsRUdw&oe=69BE89E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sigils_Trailer_CoverImage.png", "id": "923868949996336", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821704_923868953329669_4376257153732441700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3ptyV7RMfMQ7kNvwHNuY0P&_nc_oc=AdnyZ57g2diuUYmvcJ13UxBreJj_WCL6F-m2Ts0mM4-GTLoW_2dB6NDaSbE8wb1NtIM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzavDHKZdslzuHkcJMsLZrDM1bvrdhx-nEzgsAsb8gkKQ&oe=69BE9F2A"}, "display_name": "Sigils DEMO", "keywords": ["Strategy", "Action", "Magic", "Dragon", "RPG"], "long_description": "Fight your way through a fantasy world filled with magic and monsters, using your sigils and druidic dragon powers.\n\nUse physical motion to generate magic energy by punching spells, or slashing multiple enemies in your dragon form.\n\nEnter your spirit form and take control of your primary guardian and set it free when you rain down destruction with your magic sigils.\n\nCollect dragon eggs to obtain the power of all the guardian\u2019s and boost there power from crystals collected after you defeat the corrupted elementals.\n\nFight your way through 4 difficulty levels to master the Dragon Druid\u2019s abilities and become the ultimate protector of Gaia.", "short_description": "Sigils is a strategic action RPG with ability driven gameplay and roguelite elements. \n\nAbilities are powered by ancient sigils. Spells and action based skills are activated by selecting a sigil that defines the ability you use. Whether casting magic, firing your bow, or triggering movement based actions, each ability begins with a sigil choice. \n\nTest your mastery across four difficulty levels, each designed to challenge your understanding of the Dragon Druid\u2019s mechanics. "}]}, "developer_name": "Sigils", "developer_privacy_policy_url": "https://sigils.studio/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sigils Studio", "support_website_url": null, "website_url": "https://sigils.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2691890164460465"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26463044706684306"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819239_1590138935649514_4934027115026592527_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_si
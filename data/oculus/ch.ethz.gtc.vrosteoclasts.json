NaRd2hqDRL0omGxPr2TI5RgS3oF0y4Hg&oe=6AE1E651"}, {"file_name": "Screenshot_3.png", "id": "4658923904338513", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_4658923907671846_7180308108519961373_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyMQzR5fGZcQ7kNvwHBTNc7&_nc_oc=AdqozEYft1u32aivAX-_MVfcPYau6EyVzquGkqiols4XL5iH5ZQ1cAOl4hELVr34Snc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOzzst35ytroDs4fWmtd1SFJoAxcWLvFWAmL6B_j8XWA&oe=6AE2071F"}, {"file_name": "Screenshot_4.png", "id": "4733722350236957", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825305_4733722353570290_2795585806824027270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fr1O8Qr0tw0Q7kNvwFsaESs&_nc_oc=AdoXaZkPKEEYWCZiDH_Np4OihRd0owQ5q1DQvfEALAbQydFX1kMg4Lm4HVYb9IqXd84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU-gsXjNQOruaIKZu0aCMIAqrCGPiWBBf30_T11WJsAw&oe=6AE20C5A"}, {"file_name": "Screenshot_5.png", "id": "1924631691842670", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823949_1924631698509336_536828953524723168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSOdIpNMPc4Q7kNvwFKpNYy&_nc_oc=Adrytqi0NEJip0F88yha6Z06lGUjvSEVx0AIzDkzETZfoTKE3rOLOmzG8OcwW8ricOc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRM-UjWX2vJTp9Te74jO5NA8tGLzdkZ34G3ILY78CBSw&oe=6AE2092D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Osteoclasts", "keywords": ["VR", "education", "biology", "medicine"], "long_description": "Playfully learn about the process of bone resorption in virtual reality.\n\nVR Osteoclasts draws you into the microcosm of human osteoclast cells right above the bone surface. You will find yourself at the level at which an osteoclast precursor cell appears to be the size of a hand. Then, you will investigate the bone resorption process from all sides by moving around the scene and interacting with cells to learn more about their function.\n\nThe game is 
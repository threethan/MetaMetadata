2795585806824027270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fr1O8Qr0tw0Q7kNvwFsaESs&_nc_oc=AdoXaZkPKEEYWCZiDH_Np4OihRd0owQ5q1DQvfEALAbQydFX1kMg4Lm4HVYb9IqXd84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU-gsXjNQOruaIKZu0aCMIAqrCGPiWBBf30_T11WJsAw&oe=6AE20C5A"}, {"file_name": "Screenshot_5.png", "id": "1924631691842670", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823949_1924631698509336_536828953524723168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSOdIpNMPc4Q7kNvwFKpNYy&_nc_oc=Adrytqi0NEJip0F88yha6Z06lGUjvSEVx0AIzDkzETZfoTKE3rOLOmzG8OcwW8ricOc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRM-UjWX2vJTp9Te74jO5NA8tGLzdkZ34G3ILY78CBSw&oe=6AE2092D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Osteoclasts", "keywords": ["VR", "education", "biology", "medicine"], "long_description": "Playfully learn about the process of bone resorption in virtual reality.\n\nVR Osteoclasts draws you into the microcosm of human osteoclast cells right above the bone surface. You will find yourself at the level at which an osteoclast precursor cell appears to be the size of a hand. Then, you will investigate the bone resorption process from all sides by moving around the scene and interacting with cells to learn more about their function.\n\nThe game is developed as part of a research collaboration between the Game Technology Center, ETH Z\u00fcrich (Marco Ketzel, Pascal Maillard, Jascha Gr\u00fcbel, Fraser Rothnie, Violaine Fayolle, Robert W. Sumner, Fabio Z\u00fcnd), Center for Dental Medicine, University of Zurich (Bernd Stadlinger), and Medizinische Universit\u00e4t Wien (Reinhard Gruber).\n\nWith special thanks to Quintessenz Verlags-GmbH and interActive Systems GmbH.\n\nThis work was supported by the Foundation for Research in Science and the Humanities at the University of Zurich (STWF-22-011).", "short_description": "Playfully learn about the process of bone resorption in virtual reality.\n\nVR Osteoclasts draws you into the microcosm of human osteoclast cells right above the bone surface. You will find yourself at the level at which an osteoclast precursor cell appears to be the size of a hand. Then, you will investigate the bone resorption process from all sides by moving around the scene and interacting with cells to learn more about their function."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gtc.inf.ethz.ch/research/augmented-and-virtual-reality-research/ar---vr-osteoclasts/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Game Technology Center, ETH Zurich", "support_website_url": null, "website_url": "https://gtc.inf.ethz.ch/research/augmented-and-virtual-reality-research/ar---vr-osteoclasts.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1067350299599906"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_1849571569548831_3107744035503047912_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8rhO_svPx4Q7kNvwF9hdF9&_nc_oc=AdrDoqJrWwSIcGbAKI4WXZLYapCjnjJjJ12EAvSUl0ZcUYeWtuF6WHW8bNlL9T3c758&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnIZrYkph_g-9rYt0MddJEMPYY6FDGKLJZH-066xgmRw&oe=6AE1FD08"}, "is_concept": false, "is_test": false, "is_trial_of
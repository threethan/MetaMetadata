.png", "id": "1014625854715948", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311597_1014625858049281_6346166344892589546_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iepzuaPBCSEQ7kNvwGtbO7A&_nc_oc=AdrC6VDw0EFJ6qTl87AcSyJsukkFgMUXcX1MCzgdX9EcpoC3qgPBqUpW3Pd1nmghFNs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUYIReX7Bmq5BjEoUtbu6kAY57fSrFwXvL3pTSSvyJZQ&oe=6AEF5B21"}, {"file_name": "camera_capture_3840x2160_20260706_160513.png", "id": "2571532299956322", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307470_2571532303289655_6880651531088220828_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4frOb-RutYQ7kNvwEg_vgp&_nc_oc=Adq1wglMirOtxfSzjp-4-Oleyf8pqGj1qbdRuGC_vP0RS-BFZ75N8NL25hX368ewb-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmhhvLylGp5OnN_MnBRWllJrdlGntvufn7l8OxsVp7zw&oe=6AEF5FC2"}, {"file_name": "camera_capture_16x9_2560x1440_20260720_135021.png", "id": "2289053365167719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310817_2289053368501052_6616901415842243543_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33H_RROAdnkQ7kNvwG1UVHC&_nc_oc=AdrLd-xmnpeudsoI1AfeWeyS3LnIWAy95xxFK6GZ4goXt2VolgY3eDk6XjZ0v6t-HMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz234-JvASetY_8t9I8vFUrk3yqr6mprsZpuczCjYP1g&oe=6AEF599F"}, {"file_name": "camera_capture_16x9_2560x1440_20260720_135559.png", "id": "1004844422261746", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310734_1004844425595079_3807339465953784570_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txfhywy0SWUQ7kNvwEcYRCS&_nc_oc=Adq1Z9KBrQ_qXRJXRh1eie6eypouVIyKKFHvnlD5qmRXf4JhtjACjmVzG9pQ4VtVH3c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSRs1fI6wSv0MoEybiyJm-J8tSaFNPS2jx99jSuHYbbw&oe=6AEF6670"}, {"file_name": "camera_capture_16x9_2560x1440_20260720_135914.png", "id": "1363528545920484", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_1363528549253817_3225693979558956252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0VbqgfeTUAQ7kNvwHMk73C&_nc_oc=AdrTjKm30_VZWBKjwG-fD2TV25voiKHNX64K__8IzHwkUgkWGMmsGsj2eMJ3YtLjJ2k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbQhhYOc00kc4EaGODYw2irxmICeAvlfJI8r40AuRfvg&oe=6AEF3D9F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Traffix XR: Cities of Tomorrow", "keywords": ["puzzle", "MR", "city", "cozy"], "long_description": "# Build the roads. Bring the city to life.\n\n**TRAFFIX XR: Cities of Tomorrow** is a relaxed mixed reality traffic puzzle for Meta Quest 3. Connect roads to landmarks, keep traffic moving, and watch a miniature city grow around every route.\n\n## Shape the City\n- Place, erase, redirect, and upgrade roads.\n- Watch homes, towers, bridges, and subway links emerge from your network.\n- Build across plains, tropical, desert, and futuristic settings.\n\n\n\n## Solve the Flow\n- Read traffic in real time, fix bottlenecks, and rebuild freely.\n- Erased roads return to your supply.\n- Clear rain, sweep snow, and blow away quicksand with natural hand interactions.\n\n\n## Made for Mixed Reality\n- Build a living tabletop city inside your own space.\n- Play with hand tracking or Touch controllers.\n\n## Creative Mode\n- Create challenges with terrain, roads, landmarks, props, obstacles, and custom goals.\n- Test your map, prove it can be completed, then publish it.\n\n\n## Community Maps\n- Play featured, recent, and undiscovered maps made by other players.\n- Publish your best creations for the community.\n\n\n**Build a city. Solve the flow. Share the challenge.**", "short_description": "TRAFFIX XR: Cities of Tomorrow is a relaxed mixed reality traffic puzzle for Meta Quest 3. Connect roads to landmarks, keep vehicles moving, and watch miniature cities grow around your network. Clear weather hazards with natural hand interactions, unlock new locations, create your own challenges, and play maps made by the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinitygames.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Infinity Games ", "support_website_url": null, "website_url": "https://infinitygames.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8880506765305464"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4097517440554509"}]}, "baseline_offer": {"id": "4097517440554509"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792083600, "status": "PUBLISHED", "id": "4097517440554509"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28861166266812885", "version": "1.0.1"}, "id": "3247645878708732", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8880506751972132", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28861166266812885"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3247645878708732"}]}, "change_log": null, "created_date": 17931008
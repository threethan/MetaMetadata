=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4NIDwDV56I1xGforlDVi4jL7LdbV_6j-jtz-Mlxa_0w&oe=6B0051B0"}, {"file_name": "camera_capture_16x9_2560x1440_20260720_135914.png", "id": "1363528545920484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307451_1363528549253817_3225693979558956252_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdyEh5TKDj8Q7kNvwGOG-5p&_nc_oc=Adq5v7q0qAO94WNiMJmu38iuekZ9tIxDIcT_1EXGQq2jJF10D4yaW47ydSrTK_m9-Eg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmpUJuBnyPzloDJ4iKixZlimHCBze1LuV-ZvlbIp0qkA&oe=6B00611F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Traffix XR: Cities of Tomorrow", "keywords": ["puzzle", "MR", "city", "cozy"], "long_description": "# Build the roads. Bring the city to life.\n\n**TRAFFIX XR: Cities of Tomorrow** is a relaxed mixed reality traffic puzzle for Meta Quest 3. Connect roads to landmarks, keep traffic moving, and watch a miniature city grow around every route.\n\n## Shape the City\n- Place, erase, redirect, and upgrade roads.\n- Watch homes, towers, bridges, and subway links emerge from your network.\n- Build across plains, tropical, desert, and futuristic settings.\n\n\n\n## Solve the Flow\n- Read traffic in real time, fix bottlenecks, and rebuild freely.\n- Erased roads return to your supply.\n- Clear rain, sweep snow, and blow away quicksand with natural hand interactions.\n\n\n## Made for Mixed Reality\n- Build a living tabletop city inside your own space.\n- Play with hand tracking or Touch controllers.\n\n## Creative Mode\n- Create challenges with terrain, roads, landmarks, props, obstacles, and custom goals.\n- Test your map, prove it can be completed, then publish it.\n\n\n## Community Maps\n- Play featured, recent, and undiscovered maps made by other players.\n- Publish your best creations for the community.\n\n\n**Build a city. Solve the flow. Share the challenge.**", "short_description": "TRAFFIX XR: Cities of Tomorrow is a relaxed mixed reality traffic puzzle for Meta Quest 3. Connect roads to landmarks, keep vehicles moving, and watch miniature cities grow around your network. Clear weather hazards with natural hand interactions, unlock new locations, create your own challenges, and play maps made by the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinitygames.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Infinity Games ", "support_website_url": null, "website_url": "https://infinitygames.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8880506765305464"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4097517440554509"}]}, "baseline_offer": {"id": "4097517440554509"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792083600, "status": "PUBLISHED", "id": "4097517440554509"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29115841851345324", "version": "1.0.3"}, "id": "3247645878708732", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Ap
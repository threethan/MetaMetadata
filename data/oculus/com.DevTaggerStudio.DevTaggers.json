7a0a&_nc_ohc=9lSvHu5QmagQ7kNvwF8bpoq&_nc_oc=Ado3bB_OZulrDy2RTMQ6q_kpr8oePcbhHfex5aG4UT1h30e_4gpjXBoLiHYsuQ45fpM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36zbiSOLpWoOqg7HvymIWxT8pntNsdiLVkRYrLX__oPA&oe=69EF5849"}, {"file_name": "screenshot 4.png", "id": "489987630747768", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393432_489987634081101_2952735557075214163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXQQQw6GatQQ7kNvwHqqnEx&_nc_oc=AdrE1facRt1cuyIJ066IAN_ySv88F_XXjywIIiTk9jbB8AS_3oUPowo8avLjtteEibM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0d0VDl7us7v70QZQjwER4y58a9j8dBgIg0jdJxdIoxOw&oe=69EF611D"}, {"file_name": "screenshot 5.png", "id": "551839430839103", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393841_551839434172436_1429876863287871716_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kfhHUuOKocQ7kNvwHJbmhU&_nc_oc=AdpzKXR1Qa5rPcNp3kW2G2DU40pCDQPX1bjE9GiZ8tJX89Oy-6OT1CbzKDYmfTMRbY8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af226_pAswQsKccwGnD7s4W4lQm1GDHr5FGjxvL_x3hy9A&oe=69EF7034"}, {"file_name": "screenshot.png", "id": "597609976773004", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393956_597609980106337_368173124181767299_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGggXqxPq2sQ7kNvwEhSjbf&_nc_oc=AdoeuJaK-j2sUZXpHZeYRViv3E8QsrWcVqTudmc9SGSj1ohN0FMQqrOvnNQnCvr-Vms&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0GNKscNd8oyJp4V3A1IrjwniXG1OWeD-EJDM-3gXD7EA&oe=69EF56A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DevTaggers", "keywords": [], "long_description": "DevTaggers is a multiplayer VR game that puts you in the role of a highly mobile, agile creature built for speed, climbing, and chaos. Using only your hands to move, you'll run, jump, and scale your way across dynamic maps designed for pure freedom of movement. Every surface is climbable, every ledge reachable \u2014 it\u2019s all about momentum, skill, and fast reactions.\n\nWith up to 10 players in a lobby, you can dive into intense tag-based game modes, parkour challenges, or just hang out and explore. Whether you're dodging chasers, mastering tricky routes, or showing off your movement skills, DevTaggers offers an evolving world of community-driven content and nonstop action. It\u2019s not just about playing \u2014 it\u2019s about moving.", "short_description": "DevTaggers is a fast-paced VR climbing and tagging game where players embody agile primates in a world built for creative movement. With physics-based locomotion, you\u2019ll leap, swing, and scale through immersive maps designed for parkour-like freedom. Whether you're racing friends, evading tags, or just exploring, DevTaggers delivers an adrenaline-fueled experience for up to 10 players in a vibrant and evolving multiplayer playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/dev-taggers-privacy-policy/cc43d6b1-d059-4c3c-8145-d76aaf8e87c0/privacy", "developer_terms_of_service_url": null, "publisher_name": "FCSFloppa_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/devtaggers?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9501196919971935"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offe
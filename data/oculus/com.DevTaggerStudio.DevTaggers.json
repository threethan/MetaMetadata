3391937_872594144994095_8438727113640948039_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdfgldoSXdkQ7kNvwGdM9F_&_nc_oc=Adq3sDh7f194BrH59h-ANcF8EWJlYBKA5WqMatZByyduAqKJYRrhtCKdrM-gIwmIoNI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMAId7CAz6t4mRZZrYQjmDX8gds6Gy3NJBoI5RQN3tBw&oe=6B09B4CF"}, {"file_name": "screenshot 3.png", "id": "718150547202522", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473393425_718150550535855_7492364163913027237_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDzKBS7dqVcQ7kNvwHy4eaz&_nc_oc=Adpme0vGSPKbVmB3rr__dZwVK82BIn7f9Jk_6moRfpb0FJvuNjZdAK5l_Kaw-W4CKnI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD1JTHARzAgS9nuosSrYmdVDOgsCP75xj04MBcD7J5NA&oe=6B09B189"}, {"file_name": "screenshot 4.png", "id": "489987630747768", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393432_489987634081101_2952735557075214163_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FnW-yip9FMQ7kNvwHx2fpa&_nc_oc=AdrQoMmIlyFreTX5BTP_6p2UBLLnb5zqUjKJkK-Lb5aX338bJm9-lqPAIC6spQG0AW0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfgkRkKnB22OupiZm9ka7OoQDtqs_GjqSTiMBczDh3ZQ&oe=6B09BA5D"}, {"file_name": "screenshot 5.png", "id": "551839430839103", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473393841_551839434172436_1429876863287871716_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjG-_9ObjUEQ7kNvwG1vCHY&_nc_oc=Ado9lN55OTXlRhzhYH02zXlA_yjBjo3Fo8ZZgfz5ChZlwJdB4Oe-XkAvd1BzqBwZQYE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHEUpmPmRE4XkTKBxiV11paipQrkNBURoWSaIi7pdsRg&oe=6B09C974"}, {"file_name": "screenshot.png", "id": "597609976773004", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393956_597609980106337_368173124181767299_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fg4P72zyK6MQ7kNvwEUmEz3&_nc_oc=AdrHEMweNJ9RWAqO6FSn2EVWraDsa_KyRM2v3WpafYIxO0eu_uS6unWy2os--7xiz9o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTqYksmSNC8WGemq4NXUAH3kSw75sufKWw4lyP9KK6bg&oe=6B09AFE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DevTaggers", "keywords": [], "long_description": "DevTaggers is a multiplayer VR game that puts you in the role of a highly mobile, agile creature built for speed, climbing, and chaos. Using only your hands to move, you'll run, jump, and scale your way across dynamic maps designed for pure freedom of movement. Every surface is climbable, every ledge reachable \u2014 it\u2019s all about momentum, skill, and fast reactions.\n\nWith up to 10 players in a lobby, you can dive into intense tag-based game modes, parkour challenges, or just hang out and explore. Whether you're dodging chasers, mastering tricky routes, or showing off your movement skills, DevTaggers offers an evolving world of community-driven content and nonstop action. It\u2019s not just about playing \u2014 it\u2019s about moving.", "short_description": "DevTaggers is a fast-paced VR climbing and tagging game where players embody agile primates in a world built for creative movement. With physics-based locomotion, you\u2019ll leap, swing, and scale through immersive maps designed for parkour-like freedom. Whether you're racing friends, evading tags, or just exploring, DevTaggers delivers an adrenaline-fueled experience for up to 10 players in a vibrant and evolving multiplayer playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/dev-taggers-privacy-policy/cc43d6b1-d059-4c3c-8145-d76aaf8e87c0/privacy", "developer_terms_of_service_url": null, "publisher_name": "FCSFloppa_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/devtaggers?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id":
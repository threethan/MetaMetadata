3391937_872594144994095_8438727113640948039_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdfgldoSXdkQ7kNvwE68sI7&_nc_oc=Adr6W0Pd2U8Gn1IV855_mOBgTo8Aq2eBGojaGtl2TQeYJSiGiYV0obO7-W9Gt9a41tk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvBMQOJMX8h-7HmOPmEYifd-JTKTXjj0FfDD_MZ6zFUg&oe=6B0C57CF"}, {"file_name": "screenshot 3.png", "id": "718150547202522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393425_718150550535855_7492364163913027237_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPYXs5Mk5gUQ7kNvwHeb5cK&_nc_oc=AdpJUm75voqzVni4djPe5yoAyMfX3a5W0e-sUxUTFLplP9CUubQ_66KSG3iQovmeUjI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTRUj1kWP7Q18B6CPOdO9zhqKJ2qMoo1NQFG5peY_pHEg&oe=6B0C5489"}, {"file_name": "screenshot 4.png", "id": "489987630747768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393432_489987634081101_2952735557075214163_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FnW-yip9FMQ7kNvwHILBJ7&_nc_oc=Adq1o3lt_SItKwBsyvoAhPw3g2YXCvLDt4hBBwFGvoArkaCfXZIBL--tLoxrVahnB0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQFS0szzzF41dNDiMqk4ls0_R3rtMq8HKXOTn75kIFv3A&oe=6B0C5D5D"}, {"file_name": "screenshot 5.png", "id": "551839430839103", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393841_551839434172436_1429876863287871716_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4uznE6F1p0Q7kNvwFp1V1_&_nc_oc=Adp1z8yeMTsNKuSN3znt4-bNOgoVeTOGEpTpvt-PUbRzvamW9EQ6wW_FMxlXU0IOF9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR3WUnjNEuXYE6gJac3Bbr70rls-w4h8m_Cd-JeWAfMJQ&oe=6B0C6C74"}, {"file_name": "screenshot.png", "id": "597609976773004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393956_597609980106337_368173124181767299_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TASGfmJMAgQ7kNvwEZUwhh&_nc_oc=Adrycz9nBThNQCo3vCNn6Xbg1ZiI_5yQlH6k8Mkq_PuC6WxRaMN5bFBn1URby9dNUn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9f-pp_r3G3bwFggsBhGftqUS1mm2M7Ap4-y0V6_P8_A&oe=6B0C52E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DevTaggers", "keywords": [], "long_description": "DevTaggers is a multiplayer VR game that puts you in the role of a highly mobile, agile creature built for speed, climbing, and chaos. Using only your hands to move, you'll run, jump, and scale your way across dynamic maps designed for pure freedom of movement. Every surface is climbable, every ledge reachable \u2014 it\u2019s all about momentum, skill, and fast reactions.\n\nWith up to 10 players in a lobby, you can dive into intense tag-based game modes, parkour challenges, or just hang out and explore. Whether you're dodging chasers, mastering tricky routes, or showing off your movement skills, DevTaggers offers an evolving world of community-driven content and nonstop action. It\u2019s not just about playing \u2014 it\u2019s about moving.", "short_description": "DevTaggers is a fast-paced VR climbing and tagging game where players embody agile primates in a world built for creative movement. With physics-based locomotion, you\u2019ll leap, swing, and scale through immersive maps designed for parkour-like freedom. Whether you're racing friends, evading tags, or just exploring, DevTaggers delivers an adrenaline-fueled experience for up to 10 players in a vibrant and evolving multiplayer playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/dev-taggers-privacy-policy/cc43d6b1-d059-4c3c-8145-d76aaf8e87c0/privacy", "developer_terms_of_service_url": null, "publisher_name": "FCSFloppa_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/devtaggers?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id":
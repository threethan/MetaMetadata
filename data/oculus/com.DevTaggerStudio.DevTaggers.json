3391937_872594144994095_8438727113640948039_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sZecT1C94UQ7kNvwF_7tHp&_nc_oc=AdrQYCWjFKrQaTWvK3VeSnM3ghe7_ofNloSXzsAPD9CDXIAM9gw7gu40r4nCDeSnetQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxy2vAdIormWAPx5LCH9GVTi1RXBC1no9R2W_cPgkddg&oe=6AFB344F"}, {"file_name": "screenshot 3.png", "id": "718150547202522", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393425_718150550535855_7492364163913027237_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzHSJKFfFcIQ7kNvwEPmV3M&_nc_oc=Adrzh565BY0fCGFdy-75kH4TM5doxhj9hcBfsQ_z8CSgIKWfJvYfnP9H6sQEvd4NE_w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEs8sTRJgIUF5IJiyvjt_pSqqYpKb4g0E_IjJachH_5Q&oe=6AFB3109"}, {"file_name": "screenshot 4.png", "id": "489987630747768", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393432_489987634081101_2952735557075214163_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZBBsyN6FKgQ7kNvwFjsewv&_nc_oc=AdpC3I4uqqOkr8Oqf3jt65mKvSDEqVs2fGyUYHj__iMZlQjmIYObMEdtRw9-AUMjq5o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQblrorYRh5NS1B3lvDY6iDYgEAU26Kdsqc9VhNc9ghvg&oe=6AFB39DD"}, {"file_name": "screenshot 5.png", "id": "551839430839103", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393841_551839434172436_1429876863287871716_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TX9-5s9bZ6EQ7kNvwEWyKQ6&_nc_oc=AdorEulHIhnguHjruUkiAYyXsxIlGele5eFBozTDtzX6uYa2FFq-47Z4N3vBpu7_1X0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv2dPuJxNqcUbE4VH1oz7yggh8nBsSsa6oczEb9bEJyQ&oe=6AFB48F4"}, {"file_name": "screenshot.png", "id": "597609976773004", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393956_597609980106337_368173124181767299_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAGaGuv1VlEQ7kNvwF0-C0_&_nc_oc=Adp-M2KqEE35YEPFFb75Q8hKtSUbTX6f0f4KkEgLDcwq8MJIDhZ8B51y9Oyi4ZHx-Ek&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzLLACwM6fY4faM6XbhQJBhzFFJdIGELocLJmHmYHVgQ&oe=6AFB2F61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DevTaggers", "keywords": [], "long_description": "DevTaggers is a multiplayer VR game that puts you in the role of a highly mobile, agile creature built for speed, climbing, and chaos. Using only your hands to move, you'll run, jump, and scale your way across dynamic maps designed for pure freedom of movement. Every surface is climbable, every ledge reachable \u2014 it\u2019s all about momentum, skill, and fast reactions.\n\nWith up to 10 players in a lobby, you can dive into intense tag-based game modes, parkour challenges, or just hang out and explore. Whether you're dodging chasers, mastering tricky routes, or showing off your movement skills, DevTaggers offers an evolving world of community-driven content and nonstop action. It\u2019s not just about playing \u2014 it\u2019s about moving.", "short_description": "DevTaggers is a fast-paced VR climbing and tagging game where players embody agile primates in a world built for creative movement. With physics-based locomotion, you\u2019ll leap, swing, and scale through immersive maps designed for parkour-like freedom. Whether you're racing friends, evading tags, or just exploring, DevTaggers delivers an adrenaline-fueled experience for up to 10 players in a vibrant and evolving multiplayer playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/dev-taggers-privacy-policy/cc43d6b1-d059-4c3c-8145-d76aaf8e87c0/privacy", "developer_terms_of_service_url": null, "publisher_name": "FCSFloppa_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/devtaggers?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id":
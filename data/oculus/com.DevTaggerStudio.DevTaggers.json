3391937_872594144994095_8438727113640948039_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdfgldoSXdkQ7kNvwE8B6zd&_nc_oc=AdqJWbGVe47TCGf8RQNiXYkfilkdqIeELXxM_8wrgRXyBeKJfTfNe7Y2vneebHbQm7A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRwEAE5Xw55XEIOVTPajDzjjA0q39E_eRDCJQc0gbsVXw&oe=6B0B3E8F"}, {"file_name": "screenshot 3.png", "id": "718150547202522", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_718150550535855_7492364163913027237_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPYXs5Mk5gUQ7kNvwH0LvYC&_nc_oc=AdooUqQSDmrgeAK5o_GZ5tgUda9bV7oPdx4UiOrkXpD1eeMYWQKx2-j82LeK9HWjqlo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQsBYS8zCW-9IPjVvjZ25TWL3x9-uTYkiyc46hTnhsJVg&oe=6B0B3B49"}, {"file_name": "screenshot 4.png", "id": "489987630747768", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393432_489987634081101_2952735557075214163_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FnW-yip9FMQ7kNvwH8Jzfp&_nc_oc=AdrwYz7INMHYxKD07ccDfJ5N3VwCzqPUhVdmUD5YU_XraulMSqB3l0VOfDGGS_bnDvk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSuqpYMhyKHL1HkStysAYxqudWk1q-5mOcpHSkCz6CouA&oe=6B0B441D"}, {"file_name": "screenshot 5.png", "id": "551839430839103", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393841_551839434172436_1429876863287871716_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjG-_9ObjUEQ7kNvwHoEkXz&_nc_oc=Adqx3CBbI-7FlGuDZDXAXpuXG-bQWQoLHf6r3tRVJq3QLS82Kr3yMn2hBpy8aD77msI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQaOX38aZPq8_PKJyT1ZIkutenJrbujRdBQq9bldNkmsQ&oe=6B0B1AF4"}, {"file_name": "screenshot.png", "id": "597609976773004", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393956_597609980106337_368173124181767299_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TASGfmJMAgQ7kNvwEfEkR1&_nc_oc=Ado6YiYo-8FxrPyCtF3ka_mEJAAv93Z9BLkjcV6TxoFyR9UEoTHRb2MFKdFu0khZZto&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTRUdwR6Tpx-vwMoy5kT15Cjr75n_skibBFHvJpHuJKHA&oe=6B0B39A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DevTaggers", "keywords": [], "long_description": "DevTaggers is a multiplayer VR game that puts you in the role of a highly mobile, agile creature built for speed, climbing, and chaos. Using only your hands to move, you'll run, jump, and scale your way across dynamic maps designed for pure freedom of movement. Every surface is climbable, every ledge reachable \u2014 it\u2019s all about momentum, skill, and fast reactions.\n\nWith up to 10 players in a lobby, you can dive into intense tag-based game modes, parkour challenges, or just hang out and explore. Whether you're dodging chasers, mastering tricky routes, or showing off your movement skills, DevTaggers offers an evolving world of community-driven content and nonstop action. It\u2019s not just about playing \u2014 it\u2019s about moving.", "short_description": "DevTaggers is a fast-paced VR climbing and tagging game where players embody agile primates in a world built for creative movement. With physics-based locomotion, you\u2019ll leap, swing, and scale through immersive maps designed for parkour-like freedom. Whether you're racing friends, evading tags, or just exploring, DevTaggers delivers an adrenaline-fueled experience for up to 10 players in a vibrant and evolving multiplayer playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/dev-taggers-privacy-policy/cc43d6b1-d059-4c3c-8145-d76aaf8e87c0/privacy", "developer_terms_of_service_url": null, "publisher_name": "FCSFloppa_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/devtaggers?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id":
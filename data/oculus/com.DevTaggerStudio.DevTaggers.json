3391937_872594144994095_8438727113640948039_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxNxtYos_B0Q7kNvwGiD7tM&_nc_oc=AdpO1A2iYBuiEbO30slD82Ly4jM9baxPxfTDtZySCfb8dhP2m2g_QVx6I_JHCQ8sYPQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLQRLkqCsxRUykAreYxQQO9uFwYvfpXsxzJLerElsFbA&oe=6B05C04F"}, {"file_name": "screenshot 3.png", "id": "718150547202522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393425_718150550535855_7492364163913027237_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAe74D3VuTMQ7kNvwHMDbqA&_nc_oc=Adr0-7mI3WNERPtZNojRgSr59jJxQB4N5I3oksvnppIjs0f7uPXCS1qpkRvlA3oaknE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn4xrREJiMUNdFvlpLwsd09XoYnFIPVdRwlXOjjL6tUA&oe=6B05BD09"}, {"file_name": "screenshot 4.png", "id": "489987630747768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393432_489987634081101_2952735557075214163_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsFbyYwCtRUQ7kNvwGbvhrr&_nc_oc=AdrEW6WUFqTUGLjBFF0K2dgKYVgRxS7zVqlhjvDyzImcPMiDIMPPUBXtpBix_OPoSIY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvPKC8vx4X0hKN9IG1-TBjsiyNq8SNi_dkiwsIr6uSiA&oe=6B05C5DD"}, {"file_name": "screenshot 5.png", "id": "551839430839103", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393841_551839434172436_1429876863287871716_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHIOjAHz1lgQ7kNvwF1IeH1&_nc_oc=Adpvi0obD_f0A5N91HVfiZNgq9bgCidUi2fWrHncNP-QzSblc7vO36-FAr3kJU93SU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIAx-PUBUoDhaLxLszLGU9EnBUInggCsKOQ_Ght_nVCQ&oe=6B05D4F4"}, {"file_name": "screenshot.png", "id": "597609976773004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393956_597609980106337_368173124181767299_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQlHAcWf9esQ7kNvwGs5UiE&_nc_oc=AdqUcc2khYRXDVTxOrGLsmhkWZsmCvfVy_FS0sds9pf7yQTMxJ_zApdjbR4v2gBSxnE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa_bkvMAqiCFtgqZ4eUk-hPP-WF4Z6FuFUJtm5cOZcXg&oe=6B05BB61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DevTaggers", "keywords": [], "long_description": "DevTaggers is a multiplayer VR game that puts you in the role of a highly mobile, agile creature built for speed, climbing, and chaos. Using only your hands to move, you'll run, jump, and scale your way across dynamic maps designed for pure freedom of movement. Every surface is climbable, every ledge reachable \u2014 it\u2019s all about momentum, skill, and fast reactions.\n\nWith up to 10 players in a lobby, you can dive into intense tag-based game modes, parkour challenges, or just hang out and explore. Whether you're dodging chasers, mastering tricky routes, or showing off your movement skills, DevTaggers offers an evolving world of community-driven content and nonstop action. It\u2019s not just about playing \u2014 it\u2019s about moving.", "short_description": "DevTaggers is a fast-paced VR climbing and tagging game where players embody agile primates in a world built for creative movement. With physics-based locomotion, you\u2019ll leap, swing, and scale through immersive maps designed for parkour-like freedom. Whether you're racing friends, evading tags, or just exploring, DevTaggers delivers an adrenaline-fueled experience for up to 10 players in a vibrant and evolving multiplayer playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/dev-taggers-privacy-policy/cc43d6b1-d059-4c3c-8145-d76aaf8e87c0/privacy", "developer_terms_of_service_url": null, "publisher_name": "FCSFloppa_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/devtaggers?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id":
7a0a&_nc_ohc=OlyRL8iCtO8Q7kNvwEuAS0b&_nc_oc=AdrqW0lq0ctMejNY3W0FObLaEum6TiZoTJz04w_d3fHWXVgFn7h8C9fz5jQOkDpKC8g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSt9j77x3qlP0GTCDengP91gBTmXvNclZ4RBQdWAZSwOg&oe=6AF34809"}, {"file_name": "screenshot 4.png", "id": "489987630747768", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393432_489987634081101_2952735557075214163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_eNA9iPcUwQ7kNvwEgUOzA&_nc_oc=Ado4a7xyXoM-v0EpuzbIXKmWErtQRl2TPcqeio4h7A49xkOhgdaiPq6REcr1pWINr_Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6M3X5UrA8oUgwVBpXnPzcki62Qz7NorzlwQzV8Qixvw&oe=6AF350DD"}, {"file_name": "screenshot 5.png", "id": "551839430839103", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393841_551839434172436_1429876863287871716_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcnRwlGKEcIQ7kNvwE6skH2&_nc_oc=Adqgp83zuW75ZHuOuVgkUHLO-Z_o_NtMKa4DFSlZsbHmxYAX3zpouTh6cowidHxYaA8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRua5LDmmbea3mtDo5NA89RIwSGfvDO9O4ebuhlF7YRWg&oe=6AF327B4"}, {"file_name": "screenshot.png", "id": "597609976773004", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393956_597609980106337_368173124181767299_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J10_tsygpKgQ7kNvwGJghAl&_nc_oc=AdpjZq9a-Fgbf6XqEI-F0NSVKVPquRk3JeMyvCYoA3e_f71Rm8H2wL_oj2ONnsrtYBw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQ6Tf0xDsU-Sk-LuB6aG4-3rJ_Pnbv1gdbyCyz4Ry46Q&oe=6AF34661"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DevTaggers", "keywords": [], "long_description": "DevTaggers is a multiplayer VR game that puts you in the role of a highly mobile, agile creature built for speed, climbing, and chaos. Using only your hands to move, you'll run, jump, and scale your way across dynamic maps designed for pure freedom of movement. Every surface is climbable, every ledge reachable \u2014 it\u2019s all about momentum, skill, and fast reactions.\n\nWith up to 10 players in a lobby, you can dive into intense tag-based game modes, parkour challenges, or just hang out and explore. Whether you're dodging chasers, mastering tricky routes, or showing off your movement skills, DevTaggers offers an evolving world of community-driven content and nonstop action. It\u2019s not just about playing \u2014 it\u2019s about moving.", "short_description": "DevTaggers is a fast-paced VR climbing and tagging game where players embody agile primates in a world built for creative movement. With physics-based locomotion, you\u2019ll leap, swing, and scale through immersive maps designed for parkour-like freedom. Whether you're racing friends, evading tags, or just exploring, DevTaggers delivers an adrenaline-fueled experience for up to 10 players in a vibrant and evolving multiplayer playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/dev-taggers-privacy-policy/cc43d6b1-d059-4c3c-8145-d76aaf8e87c0/privacy", "developer_terms_of_service_url": null, "publisher_name": "FCSFloppa_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/devtaggers?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9501196919971935"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offe
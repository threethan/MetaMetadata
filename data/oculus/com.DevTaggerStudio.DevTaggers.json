3391937_872594144994095_8438727113640948039_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lh9ddQFAJ58Q7kNvwGI4vWY&_nc_oc=Adq6HiLctYahoG3bBhhcN3BnHTpJtLhEUDCsWM3U43qWGxy1a4p6eumfv4Rj0bI0NDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsTB2s2AGfhiZAoB8kwTD2OkWK5LxANnY68u3zBrJMgw&oe=6B046ECF"}, {"file_name": "screenshot 3.png", "id": "718150547202522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393425_718150550535855_7492364163913027237_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAe74D3VuTMQ7kNvwEp89I8&_nc_oc=AdrshXm3SMtN4sZbCy90NuHXBx8BsaMyGUgDIqvJ7Y6dTEDwUS_yP2NwB3OA5nSppF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP1gcss4VjcoRY70kN5LVZ_jqogivPuSW6epIoKNdwaA&oe=6B046B89"}, {"file_name": "screenshot 4.png", "id": "489987630747768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393432_489987634081101_2952735557075214163_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHU0asrS7RsQ7kNvwGI2Mo_&_nc_oc=AdpVR0WW84KIo4adhnXRfKY-kcguVFw2mc7RUWksa18wkAt1wIBvPYiJphsDM9yXGHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvOIXuNh163r7zc-HOSq7IKN_nsi1R6Pi52zWDHpvHoA&oe=6B04745D"}, {"file_name": "screenshot 5.png", "id": "551839430839103", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393841_551839434172436_1429876863287871716_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHIOjAHz1lgQ7kNvwG0ZMfe&_nc_oc=AdqWqFSfijiui4E7M3BB7U2yhABE2JxLA8-XzIwXZg7O3kz-NqM9HUZbcBggxFn47sk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzVCAT-3tG5CHlNI9dPnjZKFE-mywe5G99ABzoWAINUQ&oe=6B048374"}, {"file_name": "screenshot.png", "id": "597609976773004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393956_597609980106337_368173124181767299_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQlHAcWf9esQ7kNvwFdY2yG&_nc_oc=AdqPiA78_RXTP_n88SZYw2WunwRCAg_lGp26rcUp4lLNNcJdWTyYqQppe70x9ynyLo4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAXkz3vEZPkCKvk5VEkIgGrPJtvOOv-ZvJ68sSGDkpJg&oe=6B0469E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DevTaggers", "keywords": [], "long_description": "DevTaggers is a multiplayer VR game that puts you in the role of a highly mobile, agile creature built for speed, climbing, and chaos. Using only your hands to move, you'll run, jump, and scale your way across dynamic maps designed for pure freedom of movement. Every surface is climbable, every ledge reachable \u2014 it\u2019s all about momentum, skill, and fast reactions.\n\nWith up to 10 players in a lobby, you can dive into intense tag-based game modes, parkour challenges, or just hang out and explore. Whether you're dodging chasers, mastering tricky routes, or showing off your movement skills, DevTaggers offers an evolving world of community-driven content and nonstop action. It\u2019s not just about playing \u2014 it\u2019s about moving.", "short_description": "DevTaggers is a fast-paced VR climbing and tagging game where players embody agile primates in a world built for creative movement. With physics-based locomotion, you\u2019ll leap, swing, and scale through immersive maps designed for parkour-like freedom. Whether you're racing friends, evading tags, or just exploring, DevTaggers delivers an adrenaline-fueled experience for up to 10 players in a vibrant and evolving multiplayer playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/dev-taggers-privacy-policy/cc43d6b1-d059-4c3c-8145-d76aaf8e87c0/privacy", "developer_terms_of_service_url": null, "publisher_name": "FCSFloppa_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/devtaggers?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id":
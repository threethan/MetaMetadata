7a0a&_nc_ohc=9PsPh2qvj80Q7kNvwFQWNX7&_nc_oc=Adp_RkwqpsXREBiDA0uvrIn3smbQ4-orZ89CSJ6waYGZ3q56GzHl8jwSnl9BBSQfC0A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01fV5qFlD1Kt-HmCqy1PIF1sOSs19GPn0SYFCq2h5GHQ&oe=69F49E49"}, {"file_name": "screenshot 4.png", "id": "489987630747768", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393432_489987634081101_2952735557075214163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZ6vW41ORZcQ7kNvwGpC0OJ&_nc_oc=AdpOcLEEjZNrS1CLj6kLNW52L4-cpoY2pwo9r0hC2zZqLzhjoFuLC5KJ6nbx7p_8-UM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2aDPG_V_N1TMWnjFLh3dO5C6Xb8N-kJFZUZRVD4jVaxQ&oe=69F4A71D"}, {"file_name": "screenshot 5.png", "id": "551839430839103", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393841_551839434172436_1429876863287871716_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPd7qZ1Mp2oQ7kNvwELyyAT&_nc_oc=AdrcEGUN_x7ASmeM05tm1satahEX8Mb-yOq1GmGc2A1AG_TrFZ6EDArx-WF3gK3n1-E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1RiweKItoeJT1KzrGzNDMdDFNaJXQrDbdEIgbjjwlZUg&oe=69F4B634"}, {"file_name": "screenshot.png", "id": "597609976773004", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393956_597609980106337_368173124181767299_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-S4Q6wb_jzIQ7kNvwF7rtzo&_nc_oc=AdoIGubqusWPo8EN3srxZPcdLG3b9r6FYC4d16swek7DYrNpa3z4WoaTGLBQ32RDnJk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0wzlxbSqXzDY9rBP1hBh_UWOwrzgk4M_8n4n8KJdDcMw&oe=69F49CA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DevTaggers", "keywords": [], "long_description": "DevTaggers is a multiplayer VR game that puts you in the role of a highly mobile, agile creature built for speed, climbing, and chaos. Using only your hands to move, you'll run, jump, and scale your way across dynamic maps designed for pure freedom of movement. Every surface is climbable, every ledge reachable \u2014 it\u2019s all about momentum, skill, and fast reactions.\n\nWith up to 10 players in a lobby, you can dive into intense tag-based game modes, parkour challenges, or just hang out and explore. Whether you're dodging chasers, mastering tricky routes, or showing off your movement skills, DevTaggers offers an evolving world of community-driven content and nonstop action. It\u2019s not just about playing \u2014 it\u2019s about moving.", "short_description": "DevTaggers is a fast-paced VR climbing and tagging game where players embody agile primates in a world built for creative movement. With physics-based locomotion, you\u2019ll leap, swing, and scale through immersive maps designed for parkour-like freedom. Whether you're racing friends, evading tags, or just exploring, DevTaggers delivers an adrenaline-fueled experience for up to 10 players in a vibrant and evolving multiplayer playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/dev-taggers-privacy-policy/cc43d6b1-d059-4c3c-8145-d76aaf8e87c0/privacy", "developer_terms_of_service_url": null, "publisher_name": "FCSFloppa_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/devtaggers?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9501196919971935"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offe
3391937_872594144994095_8438727113640948039_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lh9ddQFAJ58Q7kNvwEVXc7O&_nc_oc=Ado23JdXlg3hYJnXyT23t0KcITSmXicX712xz93hwCul3zCvjA2feTU09p7VgPJujTM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgZVqQJQWpfAQxWliOOeqOB_qXOzsKYkt1pJnPTRMZQw&oe=6B01CBCF"}, {"file_name": "screenshot 3.png", "id": "718150547202522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393425_718150550535855_7492364163913027237_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m194Dr4h__gQ7kNvwH-uG9N&_nc_oc=Adrb6PECyzk2b-MSASdNVWwvqs4fjIBxhans3ANgEtHXyjrWg3dl0ayoJQ2mjE9b1xE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0cowFnS6LbJR_9fwjMOUFfsNwf04sDYnVzLfPFXvlGQ&oe=6B01C889"}, {"file_name": "screenshot 4.png", "id": "489987630747768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393432_489987634081101_2952735557075214163_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHU0asrS7RsQ7kNvwHhfFyp&_nc_oc=AdonNqam9rMZiN0M7Oct3CzYFCRntGxkPmmtndXkqxZcI5vtY6-McYkUvDE08JXiMSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoo4OWfTM0uHtEOfaFnDsfbZ2S6FYQn-CoxQrj1_wHsA&oe=6B01D15D"}, {"file_name": "screenshot 5.png", "id": "551839430839103", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393841_551839434172436_1429876863287871716_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VT0HdKV9CFIQ7kNvwFrLUbz&_nc_oc=AdpzY_9KU8u1aFwcBCWi6zzpa_irMilpzhvcZXGKPp5rarPbVw1dFwkjJdCmS03jjlA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY_ivzKMD4gIzaH_V5iERWkuK7abaG9U0609bddoJVhQ&oe=6B01E074"}, {"file_name": "screenshot.png", "id": "597609976773004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393956_597609980106337_368173124181767299_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrNlHL2cHqoQ7kNvwHfahMM&_nc_oc=AdrHO1emsCTg0GjA1Q31Iw0QiufJghVHztudiPi56T7KtisoCFzg3ba4CdE8NiQbDC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZAfAGfadXHDUFhSnwrICQOSc-KZDhaccJ0OltcIOtkw&oe=6B01C6E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DevTaggers", "keywords": [], "long_description": "DevTaggers is a multiplayer VR game that puts you in the role of a highly mobile, agile creature built for speed, climbing, and chaos. Using only your hands to move, you'll run, jump, and scale your way across dynamic maps designed for pure freedom of movement. Every surface is climbable, every ledge reachable \u2014 it\u2019s all about momentum, skill, and fast reactions.\n\nWith up to 10 players in a lobby, you can dive into intense tag-based game modes, parkour challenges, or just hang out and explore. Whether you're dodging chasers, mastering tricky routes, or showing off your movement skills, DevTaggers offers an evolving world of community-driven content and nonstop action. It\u2019s not just about playing \u2014 it\u2019s about moving.", "short_description": "DevTaggers is a fast-paced VR climbing and tagging game where players embody agile primates in a world built for creative movement. With physics-based locomotion, you\u2019ll leap, swing, and scale through immersive maps designed for parkour-like freedom. Whether you're racing friends, evading tags, or just exploring, DevTaggers delivers an adrenaline-fueled experience for up to 10 players in a vibrant and evolving multiplayer playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/dev-taggers-privacy-policy/cc43d6b1-d059-4c3c-8145-d76aaf8e87c0/privacy", "developer_terms_of_service_url": null, "publisher_name": "FCSFloppa_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/devtaggers?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id":
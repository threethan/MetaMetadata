3391937_872594144994095_8438727113640948039_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRBtPjf1QMMQ7kNvwHxoMZx&_nc_oc=AdogEsIx2KSAFXhoBKoro0Kss14pV2YbfoMLolKZt-sG3-nPrwEuF7bn8_3MwI2Eppo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVPLbMTQ9dHQloJfNtmDB7G-A7_S-e_fPjzWYxzv4Bw6Q&oe=6B0EFACF"}, {"file_name": "screenshot 3.png", "id": "718150547202522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393425_718150550535855_7492364163913027237_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGtdUGjOOvsQ7kNvwG5rbpw&_nc_oc=AdqxdaLYxfNBS4h9LGm-wz1eEB8EVa4EPM5yJeOVTfpXFuilatQ7MTich_z9r_3Ir2k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU3ikyv33ZOB-bpx4FGfexooBLAsM2AaG8J4_YH6XWdEA&oe=6B0EF789"}, {"file_name": "screenshot 4.png", "id": "489987630747768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393432_489987634081101_2952735557075214163_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huhyeRHJ4-MQ7kNvwFBPgjH&_nc_oc=AdoIT4Be1h_Ow8H_zN3yKhySBpJ8SJPUkfSq3AFB1q3DyDbxRcBuewIocFb7GOzLEH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX2SVyjYjZcYGsM1yxwG8GbEdk91dMboRE_qtzCLf_KJA&oe=6B0F005D"}, {"file_name": "screenshot 5.png", "id": "551839430839103", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393841_551839434172436_1429876863287871716_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4uznE6F1p0Q7kNvwHXHiYS&_nc_oc=Adrc_7XHAkeiRXvDwIR_aeT9JvJoGhnpKSyYPzCd6M4pqDTfKW4i6BhG22usJl2L37A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUlEVFAqVLsHqwYsO0iD5Cy6qczuW4z-HQ7DUAtl59oHQ&oe=6B0F0F74"}, {"file_name": "screenshot.png", "id": "597609976773004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393956_597609980106337_368173124181767299_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7Ehtct5fx4Q7kNvwG8q4E-&_nc_oc=AdoodpuxX_9NPYjT8pOn_e9oayRNQe5a1sL2NLze4WKChZg1KUsm17bPhXmsllGr-30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0whagSSNyLTz2KW2CoIh1bihnzEawUT6H_z0SmRRx8w&oe=6B0EF5E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DevTaggers", "keywords": [], "long_description": "DevTaggers is a multiplayer VR game that puts you in the role of a highly mobile, agile creature built for speed, climbing, and chaos. Using only your hands to move, you'll run, jump, and scale your way across dynamic maps designed for pure freedom of movement. Every surface is climbable, every ledge reachable \u2014 it\u2019s all about momentum, skill, and fast reactions.\n\nWith up to 10 players in a lobby, you can dive into intense tag-based game modes, parkour challenges, or just hang out and explore. Whether you're dodging chasers, mastering tricky routes, or showing off your movement skills, DevTaggers offers an evolving world of community-driven content and nonstop action. It\u2019s not just about playing \u2014 it\u2019s about moving.", "short_description": "DevTaggers is a fast-paced VR climbing and tagging game where players embody agile primates in a world built for creative movement. With physics-based locomotion, you\u2019ll leap, swing, and scale through immersive maps designed for parkour-like freedom. Whether you're racing friends, evading tags, or just exploring, DevTaggers delivers an adrenaline-fueled experience for up to 10 players in a vibrant and evolving multiplayer playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/dev-taggers-privacy-policy/cc43d6b1-d059-4c3c-8145-d76aaf8e87c0/privacy", "developer_terms_of_service_url": null, "publisher_name": "FCSFloppa_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/devtaggers?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id":
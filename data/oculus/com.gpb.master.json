AFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GPB Education VR|AR", "keywords": ["GPB", "Education", "Learning"], "long_description": "Building on a reputation as a trusted source for educational content, GPB Education is entering a new chapter with virtual and augmented reality. Students can be transported to places and environments without leaving the classroom. These types of experiences also help students make more authentic connections to the content and learning objectives. With a whole new level of immersive learning, this GPB Education VR/AR app allows students to explore the plant and animal cells, as well as sit on stage at the Atlanta Symphony Orchestra while following along with the musicians and conductor.", "short_description": "Students can be transported to places and environments without leaving the classroom. These immersive experiences help students make more authentic connections to content and learning objectives. The GPB Education VR/AR app allows students to explore the plant and animal cells, as well as sit on stage at the Atlanta Symphony Orchestra while following along with the musicians and conductor. With this new app, GPB Education is entering a new chapter with virtual and augmented reality."}]}, "developer_name": "VISYON", "developer_privacy_policy_url": "https://www.gpb.org/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "GPB Education", "support_website_url": null, "website_url": "http://www.gpb.org/education", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "MEDIA_PLAYER", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [
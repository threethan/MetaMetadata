scdn.com/v/t64.5771-25/38974569_781030398944220_6485381384096448512_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV7FXdTOPOMQ7kNvwFEkh3_&_nc_oc=Adr1sLXvVWGBtg5D_1BU8NnurbFukS1KM6u8PdjPBYQ5rjGM5vCNssbTo2MiHYkZZJg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV4lN6YSWrX_9B35I_SfnjcHb9wSgszQ5BCgBAOEL2WQ&oe=6B08693A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GPB Education VR|AR", "keywords": ["GPB", "Education", "Learning"], "long_description": "Building on a reputation as a trusted source for educational content, GPB Education is entering a new chapter with virtual and augmented reality. Students can be transported to places and environments without leaving the classroom. These types of experiences also help students make more authentic connections to the content and learning objectives. With a whole new level of immersive learning, this GPB Education VR/AR app allows students to explore the plant and animal cells, as well as sit on stage at the Atlanta Symphony Orchestra while following along with the musicians and conductor.", "short_description": "Students can be transported to places and environments without leaving the classroom. These immersive experiences help students make more authentic connections to content and learning objectives. The GPB Education VR/AR app allows students to explore the plant and animal cells, as well as sit on stage at the Atlanta Symphony Orchestra while following along with the musicians and conductor. With this new app, GPB Education is entering a new chapter with virtual and augmented reality."}]}, "developer_name": "VISYON", "developer_privacy_policy_url": "https://www.gpb.org/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "GPB Education", "support_website_url": null, "website_url": "http://www.gpb.org/education", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": 
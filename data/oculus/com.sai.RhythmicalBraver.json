8ULAsCd5DVe7TB9QiojqXKUivUdg0Hrzg&oe=6B0EF692"}, {"file_name": "SC5.png", "id": "1017938776162661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001703_1017938779495994_1820718737238088692_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1f7ZVxHAzgQ7kNvwHsUFTt&_nc_oc=Adp1zCNdRXrBB7tC78YlufrfWNBuqVva_tgMNcMUUzrQ8N3Vwe07ytkdX-vcnXpBtyY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWyo7mZkeFqO36MbeEbuy6h5LwpEKgKaUNK5ZOxzjuGEg&oe=6B0F0371"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sam.png", "id": "1072509907201774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75298470_1072509910535107_4002595090700372441_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFG1lkvSvJ0Q7kNvwFwRvrO&_nc_oc=AdrVMe3ODtOlgr9SjbsiSRj8eytd1iHyixUwZG_TuzJEQqEP7LQsQHgr2mNIMIkQYvg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV42nGxyK2ytmuZXZjbSMpViFRjgOvDBUQLg4O3mcd27w&oe=6B0EEECE"}, "display_name": "Rhythmical Braver", "keywords": [], "long_description": "Operation Description\n-----------------------------------\nLet's catch and gather the stars in the stage by hand.\nThe score increases with each acquired star.\nUpon reaching a certain score at the end of the song, the stage is cleared.\n\n\nStory\n----------------------------------------------------\nOnce upon a time, in a distant and faraway world...\nIn that world, blessed by the abundance of planet,\nHumans, animals, and even monsters lived peacefully.\nHowever...\nDue to the recent influence of a comet, the orbits of the stars became chaotic,\nand the blessings of the stars began to gradually leak as \"pieces of the planet's blessings.\"\n\nYou, who possesses the ability to see pieces of the planet's blessings., felt a deep sorrow.\nIf things continue like this, the peace of this world may eventually crumble.\n\n\nAnd one day, you make a determination.\n\nTraveling the world, collecting \"pieces of the planet's blessings\"\nReturning them to this planet at the Temple of the Creator God.", "short_description": "Let's travel the world while enjoying music!\n\nBy progressing through the game to the rhythm,\nyou can journey through a fantasy-themed world.\n\nLet's advance through this adventure to save the world,\naccompanied by wonderful music!\n\n*In this game, the scenery of the stages varies for each song.\n*In this game, there are no differences in difficulty levels \nsuch as Hard or Very Hard for each song."}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2023/11/privacy-policyrhythmical-braver.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2023/11/about-rhythmical-braver.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7503606636334915"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1763155571414093"}, {"status": "PUBLISHED", "id": "1782613219750282"}, {"status": "PUBLISHED", "id": "1032516412565746"}, {"status": "PUBLISHED", "id": "921117570981032"}, {"status": "PUBLISHED", "id": "1588973252442968"}, {"status": "PUBLISHED", "id": "1360182668668276"}, {"status": "PUBLISHED", "id": "1505554144119188"}, {"status": "PUBLISHED", "id": "246062778656552
m3OpltNqTk3P3GXcndw&oe=69AAB7D1"}, {"file_name": "SC3.png", "id": "3032089680258254", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031387_3032089683591587_143134853724301701_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARQt2D1kdh8Q7kNvwHyte7b&_nc_oc=AdndmJZj9pz6-Uvfm4psM48dnPH7jitW8xgz5gxmUKXb4BVAPsHjhPcE36refkD1j6Q&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwB5vaG8j2wjB4z__QsTp0mxiO2mtVtQh-l5rPOYtv0SA&oe=69AAE458"}, {"file_name": "SC4.png", "id": "729845128475077", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39036623_729845131808410_3644146741633056572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJ3BDOGnez0Q7kNvwH-Acqr&_nc_oc=AdntLYM_s6HgGH53JBAkWB4P7o0kBPd1mfwBJCmsHhkw3veMfjJknAdXGCU88jIBQts&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfziZx7jghWiXUv3ovCrMAZ9wz0CxN5ukPw7YIAGATXQcQ&oe=69AAC952"}, {"file_name": "SC5.png", "id": "1017938776162661", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001703_1017938779495994_1820718737238088692_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVRF8VoIHPsQ7kNvwE_7tHE&_nc_oc=AdkBF5lg-J8yFWqkZDuTH5Wfn9ll04NHfbFcKe6JZa7enuTm2JXEDorv8xO9-3h7CmQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfywI19W2q-fbJVnQU1lB4PyooYmwkVVXzKnXc2onf_Exw&oe=69AAD631"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sam.png", "id": "1072509907201774", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75298470_1072509910535107_4002595090700372441_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-O6y9dKjd0Q7kNvwHc60u8&_nc_oc=Adk97bXJ9sS4Ayk2yh4mO37m_ULOlx-CmWP9HZz-LzQO1cjCOt36bbDv2S-RnqQvUl8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzbPRkuWfOrAoT9jlu3LdLMhhSZy5OHh222VC5H6_z4fg&oe=69AAC18E"}, "display_name": "Rhythmical Braver", "keywords": ["MusicGame", "Rhythm", "Journey", "Healing", "fitness"], "long_description": "Operation Description\n-----------------------------------\nLet's catch and gather the stars in the stage by hand.\nThe score increases with each acquired star.\nUpon reaching a certain score at the end of the song, the stage is cleared.\n\n\nStory\n----------------------------------------------------\nOnce upon a time, in a distant and faraway world...\nIn that world, blessed by the abundance of planet,\nHumans, animals, and even monsters lived peacefully.\nHowever...\nDue to the recent influence of a comet, the orbits of the stars became chaotic,\nand the blessings of the stars began to gradually leak as \"pieces of the planet's blessings.\"\n\nYou, who possesses the ability to see pieces of the planet's blessings., felt a deep sorrow.\nIf things continue like this, the peace of this world may eventually crumble.\n\n\nAnd one day, you make a determination.\n\nTraveling the world, collecting \"pieces of the planet's blessings\"\nReturning them to this planet at the Temple of the Creator God.", "short_description": "Let's travel the world while enjoying music!\n\nBy progressing through the game to the rhythm,\nyou can journey through a fantasy-themed world.\n\nLet's advance through this adventure to save the world,\naccompanied by wonderful music!\n\n*In this game, the scenery of the stages varies for each song.\n*In this game, there are no differences in difficulty levels \nsuch as Hard or Very Hard for each song."}, {"images": {"nodes": []}, "id": "600209885791092", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rhythmical Braver", "keywords": ["\u97f3\u30b2\u30fc", "\u30d2\u30fc\u30ea\u30f3\u30b0", "\u65c5", "\u30ea\u30ba\u30e0\u30b2\u30fc", "\u30d5\u30a3\u30c3\u30c8\u30cd\u30b9"], "long_description": "\u64cd\u4f5c\u8aac\u660e\n----------------------------\n\u30b9\u30c6\u30fc\u30b8\u5185\u306b\u3042\u308b\u661f\u3092\u624b\u3067\u30ad\u30e3\u30c3\u30c1\u3057\u3066\u96c6\u3081\u3066\u3044\u304d\u307e\u3057\u3087\u3046\u3002\n\u661f\u3092\u7372\u5f97\u3059\u308b\u3054\u3068
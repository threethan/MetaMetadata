m&_nc_ss=7f20f&oh=00_AQDqkxxAKIIyWGTfw3RE_bRzLeE9rNmLzmc-yUTt0KriIA&oe=6A5A4791"}, {"file_name": "SC3.png", "id": "3032089680258254", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031387_3032089683591587_143134853724301701_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UI821JnrSqwQ7kNvwGtdasY&_nc_oc=Adp73GsKAMlwSr-BXo21gd2HuVXyqgkq4Ry4JtOFbisIv4etul6WDsVJo7jTD_j-p_M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5FaRdfKiDns7d1um6xuxDgAlkVP8B3AqrEjfBzsz-Ew&oe=6A5A3BD8"}, {"file_name": "SC4.png", "id": "729845128475077", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036623_729845131808410_3644146741633056572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AskAkb_uW3EQ7kNvwHjNhTr&_nc_oc=AdrEnKmxxOp9_J_7jE90m46fYFFzXVz2rQkwMzW0eKcH82tNPi5j-6brQwXC1IwBoRI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC060QZew3VviBb2uz5JpxarJcTxFQjHnCggT8hXWmQFA&oe=6A5A20D2"}, {"file_name": "SC5.png", "id": "1017938776162661", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001703_1017938779495994_1820718737238088692_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-P7AKE3OkQEQ7kNvwFnLDkR&_nc_oc=AdqHu0aOHHYnwgUDV2qIACBVAoK0NgUZSOXmpAk3lzl7dNERVYiYYBVGGTU68pqe7RA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwSqN-39XlZU81JlERv3I7DuoA85aYuCjRb88-YO4AQw&oe=6A5A2DB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sam.png", "id": "1072509907201774", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75298470_1072509910535107_4002595090700372441_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7kBPzpMyTkQ7kNvwFfgDTJ&_nc_oc=AdqelyOr0vbpPxqshhdlI_g7iUfxMQp-WSulDPZmcNmnepztOKyoXqLhS0JYtSMwumo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBS1HzQ4TnGWXCoDMSwqaXBmHOtWV6JCV6SnrOBXXHZWw&oe=6A5A190E"}, "display_name": "Rhythmical Braver", "keywords": ["MusicGame", "Rhythm", "Journey", "Healing", "fitness"], "long_description": "Operation Description\n-----------------------------------\nLet's catch and gather the stars in the stage by hand.\nThe score increases with each acquired star.\nUpon reaching a certain score at the end of the song, the stage is cleared.\n\n\nStory\n----------------------------------------------------\nOnce upon a time, in a distant and faraway world...\nIn that world, blessed by the abundance of planet,\nHumans, animals, and even monsters lived peacefully.\nHowever...\nDue to the recent influence of a comet, the orbits of the stars became chaotic,\nand the blessings of the stars began to gradually leak as \"pieces of the planet's blessings.\"\n\nYou, who possesses the ability to see pieces of the planet's blessings., felt a deep sorrow.\nIf things continue like this, the peace of this world may eventually crumble.\n\n\nAnd one day, you make a determination.\n\nTraveling the world, collecting \"pieces of the planet's blessings\"\nReturning them to this planet at the Temple of the Creator God.", "short_description": "Let's travel the world while enjoying music!\n\nBy progressing through the game to the rhythm,\nyou can journey through a fantasy-themed world.\n\nLet's advance through this adventure to save the world,\naccompanied by wonderful music!\n\n*In this game, the scenery of the stages varies for each song.\n*In this game, there are no differences in difficulty levels \nsuch as Hard or Very Hard for each song."}, {"images": {"nodes": []}, "id": "600209885791092", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rhythmical Braver", "keywords": ["\u97f3\u30b2\u30fc", "\u30d2\u30fc\u30ea\u30f3\u30b0", "\u65c5", "\u30ea\u30ba\u30e0\u30b2\u30fc", "\u30d5\u30a3\u30c3\u30c8\u30cd\u30b9"], "long_description": "\u64cd\u4f5c\u8aac\u660e\n----------------------------\n\u30b9\u30c6\u30fc\u30b8\u5185\u306b\u3042\u308b\u661f\u3092\u624b\u3067\u30ad\u30e3\u30c3\u30c1\u3057\u3066\u96c6\u3081\u3066\u3044\u304d\u307e\u3057\u3087\u
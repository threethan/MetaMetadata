m&_nc_ss=7f20f&oh=00_Af_0y742Fc-lkLwvmJ8qwrEYOwi7zLQUzQcov4wTAKAa9A&oe=6A428C91"}, {"file_name": "SC3.png", "id": "3032089680258254", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031387_3032089683591587_143134853724301701_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ye4YLUh5e2QQ7kNvwHk3Bza&_nc_oc=AdrblJ6cY1FjIl-kpnZszOjsV_u8GuHdjAJZR3B9SnQqdglSuTYl1CC361wd_Seo9Wc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZQAiUSZQfzHAZdKanGRsI6spdaod3QLgrj8RTFolEbA&oe=6A4280D8"}, {"file_name": "SC4.png", "id": "729845128475077", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036623_729845131808410_3644146741633056572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0Lw5qkFcRQQ7kNvwE0VIaC&_nc_oc=AdpEziZKvkMeaR_CEYinXEeH8hYg6ZOZt6WoDaah6Lx02MvvoZxUvnLaz4hIwOoyRZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cpXMrp43cvVckhTTwZQURfn9MHqX7U6jcBqTmfap8Ww&oe=6A4265D2"}, {"file_name": "SC5.png", "id": "1017938776162661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001703_1017938779495994_1820718737238088692_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mhrDeQ1LKIQ7kNvwEXJ4bA&_nc_oc=Adqo-33ZEqn7nEqkZ8LZbFteyjQ6Ktk7pdwy48C-pLHHnDuO9QhOik0JqFyT-brwwhI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88R24KpSQWXkcVRLULj4uZDNppf6pYlHhI_xHaghE2UQ&oe=6A4272B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sam.png", "id": "1072509907201774", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75298470_1072509910535107_4002595090700372441_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hm5_DPI6UnYQ7kNvwFKwwRO&_nc_oc=Adq8CyPP-z1x52hBJc4L30mMWojiJqb4a0Et2_xAvDdGrmGN3IcTiVWJlkvwWYZehB8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_G-lbl-YGjKX9xvWIAnG48OJgarZ98o5qXWDD-OQPOvA&oe=6A42964E"}, "display_name": "Rhythmical Braver", "keywords": ["MusicGame", "Rhythm", "Journey", "Healing", "fitness"], "long_description": "Operation Description\n-----------------------------------\nLet's catch and gather the stars in the stage by hand.\nThe score increases with each acquired star.\nUpon reaching a certain score at the end of the song, the stage is cleared.\n\n\nStory\n----------------------------------------------------\nOnce upon a time, in a distant and faraway world...\nIn that world, blessed by the abundance of planet,\nHumans, animals, and even monsters lived peacefully.\nHowever...\nDue to the recent influence of a comet, the orbits of the stars became chaotic,\nand the blessings of the stars began to gradually leak as \"pieces of the planet's blessings.\"\n\nYou, who possesses the ability to see pieces of the planet's blessings., felt a deep sorrow.\nIf things continue like this, the peace of this world may eventually crumble.\n\n\nAnd one day, you make a determination.\n\nTraveling the world, collecting \"pieces of the planet's blessings\"\nReturning them to this planet at the Temple of the Creator God.", "short_description": "Let's travel the world while enjoying music!\n\nBy progressing through the game to the rhythm,\nyou can journey through a fantasy-themed world.\n\nLet's advance through this adventure to save the world,\naccompanied by wonderful music!\n\n*In this game, the scenery of the stages varies for each song.\n*In this game, there are no differences in difficulty levels \nsuch as Hard or Very Hard for each song."}, {"images": {"nodes": []}, "id": "600209885791092", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rhythmical Braver", "keywords": ["\u97f3\u30b2\u30fc", "\u30d2\u30fc\u30ea\u30f3\u30b0", "\u65c5", "\u30ea\u30ba\u30e0\u30b2\u30fc", "\u30d5\u30a3\u30c3\u30c8\u30cd\u30b9"], "long_description": "\u64cd\u4f5c\u8aac\u660e\n----------------------------\n\u30b9\u30c6\u30fc\u30b8\u5185\u306b\u3042\u308b\u661f\u3092\u624b\u3067\u30ad\u30e3\u30c3\u30c1\u3057\u3066\u96c6\u3081\u3066\u3044\u304d\u307e\u3057\u3087\u
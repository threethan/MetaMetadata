hting", "Action", "Survival"], "long_description": "Pirates Plunder is an open-world pirate game where you can use your ship to explore a multitude of unique islands across a vast ocean. Engage with enemies, collect treasures, and convert them into gold. Heavily inspired by \"Sea of Thieves,\" and striving to become the top game on the Meta Store. \n\nAlthough it's new, hundreds of new features will be introduced soon, including multiplayer functionality so you can play with your friends! \n\nSo, set sail and see what awaits you!", "short_description": "Sail into an open-world VR pirate adventure, where you can battle enemies, explore islands, and seek out untold treasures from your very own ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cliffside-games.com/about-7", "developer_terms_of_service_url": null, "publisher_name": "Cliffside Games", "support_website_url": "https://www.cliffside-games.com/", "website_url": "https://www.cliffside-games.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27707416838901691"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1631583774456428"}, {"status": "PUBLISHED", "id": "1292558241889300"}]}, "baseline_offer": {"id": "1631583774456428"}, "is_approved": true, "firstOffer": {"nodes": [{"start_t
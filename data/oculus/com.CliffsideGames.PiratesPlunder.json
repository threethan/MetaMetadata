hip."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cliffside-games.com/about-7", "developer_terms_of_service_url": null, "publisher_name": "Cliffside Games", "support_website_url": "https://www.cliffside-games.com/", "website_url": "https://www.cliffside-games.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27707416838901691"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1631583774456428"}, {"status": "PUBLISHED", "id": "1292558241889300"}]}, "baseline_offer": {"id": "1631583774456428"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1734800700, "status": "PUBLISHED", "id": "1631583774456428"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28908041598839203", "version": "1.6.1"}, "id": "602755032288160", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27707416815568360", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28908041598839203"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null
hK2CuJiX6chMA6lmOaDgpJckBpEK4W2rU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGAagwOyeKTeFrmS4wp8RGw5FPKhkns88rza4TWaa-hA&oe=6AC66168"}, {"file_name": "Snapshot_8.png", "id": "1915142342392059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302843_1915142345725392_9173270462332693013_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gc07IXCn8jgQ7kNvwEWi0rn&_nc_oc=AdoEL-X7J_yXtj4qSi7LjJJl9xjjfJY6LMnG2jspVMDoLUpbbKYjuBthe1dpYryN7uw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu3bxOEQk9NQmnrvh60pAZeuLdB-7F-D979rdRdNg_KA&oe=6AC667EF"}, {"file_name": "Snapshot_31.png", "id": "1850005255912854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308089_1850005259246187_3194764543321268639_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfLdEId5jksQ7kNvwEjpuGa&_nc_oc=AdrvJs4dfGM2j-KtP8CzlTgnwnxYPyoI9UJ-bf8pdsuS23KSTm7o-z1ME9oQeaP_z9M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIAjTIZV8EzabiWZGmFg9beYatjCSEZzXy39lXTXf1Aw&oe=6AC65F19"}, {"file_name": "Snapshot_36.png", "id": "1980750192679175", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308166_1980750196012508_2859128966951146827_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TY2USKz9T70Q7kNvwH5JS1v&_nc_oc=Adp3B8Vcxs6A0kauPfHQkIwItTy10ByAARc1GFLWhlE2uESKP2h1H6zqQkiT6Nt91b8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQModPWRzirPLXcNbS-aLtP-lRINEvX0-XnlZkaiL_MgmQ&oe=6AC66551"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SBS Demo Landscape (1).png", "id": "1086778596517835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619098_1086778599851168_3123375735114416235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOxlqSoYLq8Q7kNvwFDaZof&_nc_oc=AdrAK9UNZ1VI64bHelGEOypA4wfUGD5cC5Kdx5RAD7_dVSj0pgTVl8L9IK3f_6IuksU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNp74x8mUd_ZJNunmQqzGRmwp3njE6T8snxbRc_UaLPjA&oe=6AC643E4"}, "display_name": "Scared By Squares Demo", "keywords": ["Horror", "Scary", "Maze", "Mystery", "Liminal"], "long_description": "# WARNING: Do not play if you are scared by squares.\n#                                   \n                                                                                                             \n{562244923578218}\n# Play the Free Demo Now!\nYou are a prisoner with a life sentence and one last chance. They are sending you into the Cube, a digital prison of perfect squares, after reports of dangerous irregularities. \n\n{1120006612811192}\n# Find Out What's Inside the Cube\nNo one will say what is inside; only that someone like you is expendable enough to find out.\n\n{1203389781594726}\n# No Turning Back\nWhen the door closes behind you, there's no turning back. Only the dark cuboid corridor lies ahead. What will you find?\n\n{763682149896389}\n# Thank You\n... for your voluntary participation.", "short_description": "Are you ready to get scared by squares? Navigate cube-filled liminal spaces and use your senses to navigate and survive in this eerie VR exploration experience."}]}, "developer_name": "Siege Industries", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.scaredbysquares.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
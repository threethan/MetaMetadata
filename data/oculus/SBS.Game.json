68639_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90Tn5I_PL3oQ7kNvwER1nsD&_nc_oc=AdnLRlko2fIbApJpII_DGTtlL6Kze6YAxkfCqpPrr1b3obvyNCbh6sH9b5kZU7J-MLU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft9B7meilA5a8Bl66N_Ylih3RDZIaUokVm21P97kiSpmg&oe=699AE259"}, {"file_name": "Snapshot_36.png", "id": "1980750192679175", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308166_1980750196012508_2859128966951146827_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-JZIrGOjG0Q7kNvwH7T8za&_nc_oc=Adn9_jnkfSiYI-TimwiqHp5ieNQdGIkV6uEoRH5C3m-5WaYQRcjov-FPF9qiJEu6OBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afswa7yiIxhOaQkT549mLkcEUZ9RlpPxaBhLV6JRjUO5-A&oe=699AE891"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SBS Demo Landscape (1).png", "id": "1086778596517835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619098_1086778599851168_3123375735114416235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUrmEqOvlfcQ7kNvwFt_ZJf&_nc_oc=AdmWXL-KZNziVOgnvT35C2qvV1VFr-E3m5aao88l2woMxmsZ5G6RZzYHF8w0xmw3ElQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftuVNdilU9fUEZ-54gtyKS6TDHGNwwPCUH2VY0eesdOHQ&oe=699AFF64"}, "display_name": "Scared By Squares Demo", "keywords": ["Horror", "Scary", "Maze", "Mystery", "Liminal"], "long_description": "# WARNING: Do not play if you are scared by squares.\n#                                   \n                                                                                                             \n{562244923578218}\n# Play the Free Demo Now!\nYou are a prisoner with a life sentence and one last chance. They are sending you into the Cube, a digital prison of perfect squares, after reports of dangerous irregularities. \n\n{1120006612811192}\n# Find Out What's Inside the Cube\nNo one will say what is inside; only that someone like you is expendable enough to find out.\n\n{1203389781594726}\n# No Turning Back\nWhen the door closes behind you, there's no turning back. Only the dark cuboid corridor lies ahead. What will you find?\n\n{763682149896389}\n# Thank You\n... for your voluntary participation.", "short_description": "Are you ready to get scared by squares? Navigate cube-filled liminal spaces and use your senses to navigate and survive in this eerie VR exploration experience."}]}, "developer_name": "Siege Industries", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.scaredbysquares.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24821389447499481"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824583_758968317039382_4210948597119901141_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clizB1sjHxsQ7kNvwGF6U5O&_nc_oc=Adn3lGhaFmhlOa4j_cbuBYVQZhVKpa5ZvYfUDZjk00NGMqFpUMh-6A61CgncqL9Uihc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs5qnkNWLHVTw1lpxhzoPahG9D7M3AOrC28bn-453CAoA&oe=699AE7E4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Scared By Squares Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "con
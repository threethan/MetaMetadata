5-1.oculuscdn.com/v/t64.5771-25/499308166_1980750196012508_2859128966951146827_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWkEFbImfe4Q7kNvwGndWaR&_nc_oc=AdokTiXd4vb1qTxhxd5aWAvjuvNE-2hjAe45Uyxh1UyJ8Narf11sBpJhqJK9vjzngyk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyB5lzWxqAYz9kA8U0meXJdTd5Pu5BOSjTWmSDRxwqzEQ&oe=69C51891"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SBS Demo Landscape (1).png", "id": "1086778596517835", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619098_1086778599851168_3123375735114416235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTIvYVbU0N0Q7kNvwE5_YJH&_nc_oc=Adro0yZPAKFs20zJ5rfbtImd-Pb8W0txCQvS29fPd4-Qs6AMfoieYq6UGdIZVEtpDeg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzaFt98mQDmB7ST4JmQUz7_gNkx9SKlXupIoe2ovBqd3g&oe=69C52F64"}, "display_name": "Scared By Squares Demo", "keywords": ["Horror", "Scary", "Maze", "Mystery", "Liminal"], "long_description": "# WARNING: Do not play if you are scared by squares.\n#                                   \n                                                                                                             \n{562244923578218}\n# Play the Free Demo Now!\nYou are a prisoner with a life sentence and one last chance. They are sending you into the Cube, a digital prison of perfect squares, after reports of dangerous irregularities. \n\n{1120006612811192}\n# Find Out What's Inside the Cube\nNo one will say what is inside; only that someone like you is expendable enough to find out.\n\n{1203389781594726}\n# No Turning Back\nWhen the door closes behind you, there's no turning back. Only the dark cuboid corridor lies ahead. What will you find?\n\n{763682149896389}\n# Thank You\n... for your voluntary participation.", "short_description": "Are you ready to get scared by squares? Navigate cube-filled liminal spaces and use your senses to navigate and survive in this eerie VR exploration experience."}]}, "developer_nam
_PoVwFcaTGrVbMQOVcjj_KAaMWACLicSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5K_91-4S7lEfRu8hxuEi0BXO0NlO7HOJ2Iy_-d0Xc71A&oe=69FCABE8"}, {"file_name": "Snapshot_8.png", "id": "1915142342392059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302843_1915142345725392_9173270462332693013_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrMdcsAg8-cQ7kNvwFyZReS&_nc_oc=Adqcvn1yb0loJiwYVinRE2u5Eo9ToTdYDAG30cw1M9OOIcQko3RiJl_4NWpk4VFwWcI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qu5o8wbbdRnpkuAyPVgFFF0g6199ODDVb5EQQOkC7TQ&oe=69FCB26F"}, {"file_name": "Snapshot_31.png", "id": "1850005255912854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308089_1850005259246187_3194764543321268639_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aN36WEuTEB0Q7kNvwH3JspP&_nc_oc=AdrCFl75GxyQ7C0DvSW8MzzeZ-K65Qm6A0rbbfqWaccOQtMS3g-YVDmPuOndCtS5ilw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vGxDu9OWhd00XYK0ogKCfNsumYq6wBagF6pKVOj7UhA&oe=69FCA999"}, {"file_name": "Snapshot_36.png", "id": "1980750192679175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308166_1980750196012508_2859128966951146827_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGxpQfxJ4s8Q7kNvwFPYhC1&_nc_oc=AdqDdaTW_Dr4gNQym1ZJd5jcw6G7BZWS4eF_bQqcl4Kzs_gLevrCKm3MgT3xxEBI1rk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A7OSnKvNq5tlT_uAxOM4IoCXKS7WCBKJef0lIpzN2NA&oe=69FCAFD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SBS Demo Landscape (1).png", "id": "1086778596517835", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619098_1086778599851168_3123375735114416235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwnSc_0buicQ7kNvwEIj4tv&_nc_oc=AdocVbF-donvheDFTM7fl6QHalvI3hTDX0Vycz7KUMsweErykDv1kul6KOP2jZI3WfM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YCvo_86ZbSYPw-3yy6-RdIdk89xk17lOWX5A0PGMlcA&oe=69FC8E64"}, "display_name": "Scared By Squares Demo", "keywords": ["Horror", "Scary", "Maze", "Mystery", "Liminal"], "long_description": "# WARNING: Do not play if you are scared by squares.\n#                                   \n                                                                                                             \n{562244923578218}\n# Play the Free Demo Now!\nYou are a prisoner with a life sentence and one last chance. They are sending you into the Cube, a digital prison of perfect squares, after reports of dangerous irregularities. \n\n{1120006612811192}\n# Find Out What's Inside the Cube\nNo one will say what is inside; only that someone like you is expendable enough to find out.\n\n{1203389781594726}\n# No Turning Back\nWhen the door closes behind you, there's no turning back. Only the dark cuboid corridor lies ahead. What will you find?\n\n{763682149896389}\n# Thank You\n... for your voluntary participation.", "short_description": "Are you ready to get scared by squares? Navigate cube-filled liminal spaces and use your senses to navigate and survive in this eerie VR exploration experience."}]}, "developer_name": "Siege Industries", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.scaredbysquares.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
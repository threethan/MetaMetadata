uQ1P8A8OGTmkg9MzZ6J04j99WAbeyUqgA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAb2oyB3xy4ndLCXwC3w-6L3z4Q7ho7g_t88jKCJbnZgw&oe=6A6F5E68"}, {"file_name": "Snapshot_8.png", "id": "1915142342392059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499302843_1915142345725392_9173270462332693013_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0Ae6UZucbAQ7kNvwFF2eVz&_nc_oc=AdpYK9bd4BQiLZEa18LlzWN-ZVgZ3cALnLG51Y1ToacnQTQj_xSwtpEtubDDs_GRO5c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvXWY9NNvczJIHwxKESTNg-Kf-cyW4COmZoweo0vMN7w&oe=6A6F2CAF"}, {"file_name": "Snapshot_31.png", "id": "1850005255912854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308089_1850005259246187_3194764543321268639_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DMLgcsAwm0Q7kNvwFwhAKc&_nc_oc=AdrRI81q1WlU4YaAOAssS1tDcX1lgNBK2x6n7FvG5_u9D-542ShvAqWPQiBACOwg460&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYPWO48BEM1tXbUz5N1Fpu7I9aKPhrO95R4Sn8u6VS1w&oe=6A6F5C19"}, {"file_name": "Snapshot_36.png", "id": "1980750192679175", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308166_1980750196012508_2859128966951146827_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hie6fZ97UkQ7kNvwEj4avC&_nc_oc=AdpxWNDV8-DhwSFQAEra8l2Czu2R5DemvtyOrivH0EiyJNENRRhjrM4bVYnsv46slCQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB4AX9be1cXSHuduzw1vUh5ffmc_-hY2rq79nLLSLbUg&oe=6A6F2A11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SBS Demo Landscape (1).png", "id": "1086778596517835", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619098_1086778599851168_3123375735114416235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elipN9HCcOgQ7kNvwEDba7G&_nc_oc=Adp85tWLVXp7KlI_kslHhT_vp1OrDor9g6Y-SBxAu1zmJDYCM0RfyfC4jzaU94sxLzw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8IWQjawvdyw10U8OiWnQuntZbObuX7MBh6kkIWyZLCw&oe=6A6F40E4"}, "display_name": "Scared By Squares Demo", "keywords": ["Horror", "Scary", "Maze", "Mystery", "Liminal"], "long_description": "# WARNING: Do not play if you are scared by squares.\n#                                   \n                                                                                                             \n{562244923578218}\n# Play the Free Demo Now!\nYou are a prisoner with a life sentence and one last chance. They are sending you into the Cube, a digital prison of perfect squares, after reports of dangerous irregularities. \n\n{1120006612811192}\n# Find Out What's Inside the Cube\nNo one will say what is inside; only that someone like you is expendable enough to find out.\n\n{1203389781594726}\n# No Turning Back\nWhen the door closes behind you, there's no turning back. Only the dark cuboid corridor lies ahead. What will you find?\n\n{763682149896389}\n# Thank You\n... for your voluntary participation.", "short_description": "Are you ready to get scared by squares? Navigate cube-filled liminal spaces and use your senses to navigate and survive in this eerie VR exploration experience."}]}, "developer_name": "Siege Industries", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.scaredbysquares.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
eG29ay4RQ_xEY7EiKSF_alzcONDQQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftD6T_JehxhwSdKzLTwNSCUsyMGy2rQhN8BEgXZE4I3Kw&oe=69A02859"}, {"file_name": "Snapshot_36.png", "id": "1980750192679175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308166_1980750196012508_2859128966951146827_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYyh32rgTSMQ7kNvwHX3j8V&_nc_oc=AdlJjaOX0p3Asi5GvqlCp999t4anzUx-0Bl50fA8QQxkrGWRQ8qiWOApvoHq9wKRq9c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftxsyDvnYJFE0XKq-zFSgUu8JmdxRebRRSsOPYIV5_dCg&oe=69A02E91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SBS Demo Landscape (1).png", "id": "1086778596517835", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619098_1086778599851168_3123375735114416235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFE2Zt7nqvYQ7kNvwF1-DRP&_nc_oc=AdlcY7L28gmHhARFcw0kEWym-i8qKunyY9yeeGGaVWBiZfiELbIr7anVQ2Xf1VHeHGs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuD2q8rnCaSrBG6j22pRsgkV6bPk7-nZ9IVg60G24oBCg&oe=69A04564"}, "display_name": "Scared By Squares Demo", "keywords": ["Horror", "Scary", "Maze", "Mystery", "Liminal"], "long_description": "# WARNING: Do not play if you are scared by squares.\n#                                   \n                                                                                                             \n{562244923578218}\n# Play the Free Demo Now!\nYou are a prisoner with a life sentence and one last chance. They are sending you into the Cube, a digital prison of perfect squares, after reports of dangerous irregularities. \n\n{1120006612811192}\n# Find Out What's Inside the Cube\nNo one will say what is inside; only that someone like you is expendable enough to find out.\n\n{1203389781594726}\n# No Turning Back\nWhen the door closes behind you, there's no turning back. Only the dark cuboid corridor lies ahead. What will you find?\n\n{763682149896389}\n# Thank You\n... for your voluntary participation.
459"}, {"file_name": "Snapshot_36.png", "id": "1980750192679175", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499308166_1980750196012508_2859128966951146827_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93mdAxguxpsQ7kNvwHKSpvf&_nc_oc=AdmYZiCFYdzWawMXoE7zJlElr5KXfW_SjxbjsAyKrrg_oOD8XgiC2iBmn9XUcIcHpUg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZtDFcbnzuoe24YCWXZyyzHj8yyjE_QD99xIlGEx83bw&oe=69AABA91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SBS Demo Landscape (1).png", "id": "1086778596517835", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619098_1086778599851168_3123375735114416235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hrhKjbgEAkQ7kNvwHga7SC&_nc_oc=AdmkiH5RF5tYXTgQNqAqCgwitl3shSWmE_YgAxg9TKkQPlTlQ1KKoxnC1YpyXINRxjQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0PbM2xnGf6ILt_3S2jwJQNyZ4iNKA528otZA180Kdzg&oe=69AAD164"}, "display_name": "Scared By Squares Demo", "keywords": ["Horror", "Scary", "Maze", "Mystery", "Liminal"], "long_description": "# WARNING: Do not play if you are scared by squares.\n#                                   \n                                                                                                             \n{562244923578218}\n# Play the Free Demo Now!\nYou are a prisoner with a life sentence and one last chance. They are sending you into the Cube, a digital prison of perfect squares, after reports of dangerous irregularities. \n\n{1120006612811192}\n# Find Out What's Inside the Cube\nNo one will say what is inside; only that someone like you is expendable enough to find out.\n\n{1203389781594726}\n# No Turning Back\nWhen the door closes behind you, there's no turning back. Only the dark cuboid corridor lies ahead. What will you find?\n\n{763682149896389}\n# Thank You\n... for your voluntary participation.", "short_description": "Are you ready to get scared by squares? Navigate cube-filled liminal spaces and use your senses to navigate and survive in this eerie VR exploration experience."}]}, "developer_name": "Siege Industries", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.scaredbysquares.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24821389447499481"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491824583_758968317039382_4210948597119901141_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuXszse_MjEQ7kNvwGzSdV0&_nc_oc=Adm7PiU2-RlcsDnRb60gjMjg9wyNbNUbA47xBFhJat4Q7nnqQjdi5LB6oUJ4vk-G8OQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afx5qhQCpVN0qYydT-DYY4IfBvIzQ8eA0W_wNhVMBVI3Jw&oe=69AAB9E4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Scared By Squares Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "r
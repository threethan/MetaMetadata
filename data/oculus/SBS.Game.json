_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "775200121590685", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820953_775200124924018_3529343865576917726_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaOq5QQ7waQQ7kNvwFR3wWs&_nc_oc=AdmnN5m-stuL03LLPIW2pBQMp7Sy-bMyvJopKuIfFtD1fkX_9iCV_Jm918zqcnvc-6A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjCx9pyQsi6r2vr-7upn9G81wZzS8JO0_jnULmHMJWNA&oe=69BE9DA4"}, "display_name": "Scared By Squares Demo", "keywords": ["Horror", "Scary", "Maze", "Mystery", "Liminal"], "long_description": "WARNING! Do not play if you are Scared By Squares\n\nScared by Squares is a creepy VR exploration game where you navigate liminal, cube-filled spaces that feel just a little too perfect. Something is off, and it\u2019s getting worse.\n\nAvoid roaming corrupted cubes, uncover hidden anomalies, and try to hold onto your sanity as the world slowly unravels around you. Play solo for a tense, immersive experience, or explore the unsettling halls with friends, if you think that will help.", "short_description": "A creepy VR exploration game where you navigate liminal spaces, avoid roaming cubes, and uncover hidden anomalies in eerie block-filled mazes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.scaredbysquares.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games LLC", "support_website_url": null, "website_url": "https://www.scaredbysquares.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
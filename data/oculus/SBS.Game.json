rgPitfmE2CnorC3stpjxm7g19Ncs0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvFjJV4NE3XUBdEyBnbZCKKgEieL9uCaUs4i71ch40GTA&oe=69A2CB59"}, {"file_name": "Snapshot_36.png", "id": "1980750192679175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308166_1980750196012508_2859128966951146827_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYyh32rgTSMQ7kNvwE9Dkwp&_nc_oc=Adn_NEl8POGCH4AtVZzIBnSv32oMs6cJNV5lgbl29xjOtTlFdA6h5UQBAqh5lQUcCPo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuXGSkdS0gEnLqY8y-ZIJcZE9fv8vRl49YLEPOp3lsqng&oe=69A2D191"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SBS Demo Landscape (1).png", "id": "1086778596517835", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619098_1086778599851168_3123375735114416235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhhGF-_miBIQ7kNvwF_nHP1&_nc_oc=AdlgTOyipR6kG2qM11gr7QZMjUVsySj9LmcSb5e5uELuV00MkkFbbK4PeAgJufGERCc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvqjuaFj_U-73qX2RepZ-WwRA_9eYOhEuUQpYHHj_vywA&oe=69A2E864"}, "display_name": "Scared By Squares Demo", "keywords": ["Horror", "Scary", "Maze", "Mystery", "Liminal"], "long_description": "# WARNING: Do not play if you are scared by squares.\n#                                   \n                                                                                                             \n{562244923578218}\n# Play the Free Demo Now!\nYou are a prisoner with a life sentence and one last chance. They are sending you into the Cube, a digital prison of perfect squares, after reports of dangerous irregularities. \n\n{1120006612811192}\n# Find Out What's Inside the Cube\nNo one will say what is inside; only that someone like you is expendable enough to find out.\n\n{1203389781594726}\n# No Turning Back\nWhen the door closes behind you, there's no turning back. Only the dark cuboid corridor lies ahead. What will you find?\n\n{763682149896389}\n# Thank You\n... for your voluntary participation.
zNRRANGp7MSRyO4jeQt_7fTy2F9Gw&oe=6B0DCE91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SBS Demo Landscape (1).png", "id": "1086778596517835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619098_1086778599851168_3123375735114416235_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6vPiM8UiM8Q7kNvwFITnTV&_nc_oc=AdpJlby2JhooEj30ru3EtkZ5HMpYBH0W5evILWBAm4gBUEk-lxgQlTQGpqGWSSWSkLM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRtIPIV5yq_4UAwqay32wDjZcIMj4U0oJtP6FsphupFYg&oe=6B0DAD24"}, "display_name": "Scared By Squares Demo", "keywords": ["Horror", "Scary", "Maze", "Mystery", "Liminal"], "long_description": "# WARNING: Do not play if you are scared by squares.\n#                                   \n                                                                                                             \n{562244923578218}\n# Play the Free Demo Now!\nYou are a prisoner with a life sentence and one last chance. They are sending you into the Cube, a digital prison of perfect squares, after reports of dangerous irregularities. \n\n{1120006612811192}\n# Find Out What's Inside the Cube\nNo one will say what is inside; only that someone like you is expendable enough to find out.\n\n{1203389781594726}\n# No Turning Back\nWhen the door closes behind you, there's no turning back. Only the dark cuboid corridor lies ahead. What will you find?\n\n{763682149896389}\n# Thank You\n... for your voluntary participation.", "short_description": "Are you ready to get scared by squares? Navigate cube-filled liminal spaces and use your senses to navigate and survive in this eerie VR exploration experience."}]}, "developer_name": "Siege Industries", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.scaredbysquares.com/", "category": null, "comfort_rating": "
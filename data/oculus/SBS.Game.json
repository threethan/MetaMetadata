wSGaohpYEu98wK9C5Xj9VmLN-5Zmbpf7c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBF_1mBttR699HyI5FXZNWcxXJGKjovTmblgU3WAPRDBA&oe=6A6CBB68"}, {"file_name": "Snapshot_8.png", "id": "1915142342392059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302843_1915142345725392_9173270462332693013_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpQchfHvz_QQ7kNvwGrrNmu&_nc_oc=Adp7EMfihC7m55cKm40Ka_dQoHOcLo2UFp4_F0D_AbYTtVoMSBMXOTb765mfZCo19qo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuj9kshKXVgubYcusYuKck2QBCU_Cuvdh2zxJcbg0AEw&oe=6A6C89AF"}, {"file_name": "Snapshot_31.png", "id": "1850005255912854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308089_1850005259246187_3194764543321268639_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTqDboNWktAQ7kNvwE5h2gm&_nc_oc=Adr836Fao2pkqf6nfUCsIf6FK1oI7ipiffTn-OiK1mara_XiF0RP9jmZzbdBXORzYMw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFaL88M7fxo7gTNmsricW5jGQ8TJrl3Xq6M3sEeGeUag&oe=6A6CB919"}, {"file_name": "Snapshot_36.png", "id": "1980750192679175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308166_1980750196012508_2859128966951146827_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iu91A-6WnsIQ7kNvwEvFS1b&_nc_oc=AdoI0QVmberuV3eP3nw-MZkuFGtNqol2-PLzc5hyBQjV8Nal-G90ipG94FVc7OZ1SS4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEwX78RlyTXkTBa0tAuvRVF6SlhVBEzH2Drlh9pKgnJg&oe=6A6CBF51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SBS Demo Landscape (1).png", "id": "1086778596517835", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619098_1086778599851168_3123375735114416235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elipN9HCcOgQ7kNvwGE4DOQ&_nc_oc=AdpkDsQ7zYsybc2hmDjLU20K3XFPoArIJDkMLNJt6rIYn5NyCTb5DoQgN8SP04GF_3E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJuJFN79rGXkd_CNnax7mGzePDsKYzS9Ke-r58ze6nVw&oe=6A6C9DE4"}, "display_name": "Scared By Squares Demo", "keywords": ["Horror", "Scary", "Maze", "Mystery", "Liminal"], "long_description": "# WARNING: Do not play if you are scared by squares.\n#                                   \n                                                                                                             \n{562244923578218}\n# Play the Free Demo Now!\nYou are a prisoner with a life sentence and one last chance. They are sending you into the Cube, a digital prison of perfect squares, after reports of dangerous irregularities. \n\n{1120006612811192}\n# Find Out What's Inside the Cube\nNo one will say what is inside; only that someone like you is expendable enough to find out.\n\n{1203389781594726}\n# No Turning Back\nWhen the door closes behind you, there's no turning back. Only the dark cuboid corridor lies ahead. What will you find?\n\n{763682149896389}\n# Thank You\n... for your voluntary participation.", "short_description": "Are you ready to get scared by squares? Navigate cube-filled liminal spaces and use your senses to navigate and survive in this eerie VR exploration experience."}]}, "developer_name": "Siege Industries", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.scaredbysquares.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
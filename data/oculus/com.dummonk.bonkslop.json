{"file_name": "store-2-factory.png", "id": "1000345199614941", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624583_1000345202948274_3714007804450407580_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Epihibron80Q7kNvwF6DL62&_nc_oc=AdrI7kZIHPdiKAGyJ_hr0Vn-ja20cZl-pDn6Udn1qKcegphj_VbD8gbYmiJBzHvpcaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUv7H-7FImRSwZxizPU2QBY4UAOTqeTUQ4kkOTnjH9qxg&oe=6B0F151B"}, {"file_name": "store-3-robot-shop.png", "id": "1668313561395617", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628454_1668313564728950_3842695006588611594_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDS9KfwLZToQ7kNvwFHvkXl&_nc_oc=AdoQ0K1c3cUVKh1TdyQbx4TScwVSDGgMkal4JfgDKLkpEj5iXlyPuaVyd5kJcdN8tKI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVALgietSb5pazd1P3j_il8ZJPvKkNDdzmbwiJw1yiRfg&oe=6B0F0C73"}, {"file_name": "store-4-friends.png", "id": "1631513835420536", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619369_1631513838753869_4313290777978830439_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fROANfjrkDwQ7kNvwHxNvc9&_nc_oc=AdpCGkO9rPIx_7i0Ej5l7QEL7-0IBF_QV8W76Z6WV2JYg9ffFA3qiJNuSLpGCEyEKMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU6lFeU0dkSF7JyC4BOVHL42QE1ZC-su0ih4Kxi4GzIzg&oe=6B0F159E"}, {"file_name": "store-5-rebuild.png", "id": "1628295938993203", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620630_1628295942326536_5880039889540522475_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZBfy_PMZGEQ7kNvwFtns1U&_nc_oc=Ado_rbETytHpDVQN1WHtCyIY8BV1O5KVZaqrpirjCrD2grplHgusXSc8YD8DdsfEkWU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWxDh9plIlxQj5wlagKAwMI0ruzf3Q8Yq9JRsDiG_dG5g&oe=6B0EF271"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bonk Slop", "keywords": ["gorilla", "multiplayer", "portals", "robots"], "long_description": "**Move like a gorilla.** No thumbsticks: push off the ground with your hands to run, climb walls and launch yourself through the air.\n\n**Bonk everything.** Punch friends and monsters, grab and throw stuff, ride shopping carts and tear walls off houses.\n\n**A whole world to mess around in**\n- Bonk Town: shops, houses, townsfolk and a bank\n- The Mining Cave: dig ore and gold, sell it at Dave's Shop, buy better gear\n- The Forgotten Factory: four floors of deformed monsters and loot\n- Giant robots, a Titan, and a showdown boss fight\n\n**Portals you can see through.** Become a portal-hopping mad scientist and open seamless portals: look through them, reach your arms in, and walk out somewhere else.\n\n**Play together.** Online rooms for up to five players with public matchmaking or private codes, or play solo.\n\nMade by a solo developer who is learning to code.", "short_description": "Swing your arms to run, climb and fling yourself around as a gorilla in Bonk Slop, a goofy VR brawler. Bonk your friends across town, mine the cave for gold, survive the Forgotten Factory's monsters, pilot giant robots, and hop through real see-through portals as a mad scientist. Play solo or online with up to five players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dummonk1403.github.io/bonk-slop/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Amazing Gorilla", "support_website_url": "https://github.com/Dummonk1403/bonk-slop/issues", "website_url": "https://dummonk1403.github.io/bonk-slop/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "1983294882347338"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2579583032545599"}]}, "baseline_offer": {"id": "2579583032545599"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793399460, "status": "PUBLISHED", "id": "2579583032545599"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2030911707585655", "version": "2.78"}, "id": "2359923834780302", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2030911707585655"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "FIXED\n- The ritual countdown no longer skips ahead when a player leaves during it\n- Tower event timing now matches more closely between everyone in the room", "created_date": 1795646284, "id": "2030911707585655", "version": "2.78", "version_code": 133, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2030911707585655"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "NEW\n- A cult tower has risen near spawn: fight up three floors past the Gatekeeper, Malvek and the Maskmaker\n- Break the rooftop ritual device before the 25 second countdown ends... or find out what happens if you don't\n- Something huge is waiting behind the ritual. Beat it together for a big reward", "created_date": 1795630450, "id": "2030742997602526", "version": "2.77", "version_code": 132, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2030911707585655"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "NEW\n- Wind-Up Gubby (Bonk Toybox): turn the key on his back, set him down and he waddles off. He squeaks when he bumps something\n- Pocket Fan (Bonk Toybox): hold Trigger to spin it up and blow Bubble Blaster bubbles across the room\n- Ore Basket (Dave's): carry up to three loose ores by the handle. Tip it over to empty it\n- Be the Monster: The Twisted has a new, more detailed look", "created_date": 1795570480, "id": "2029994934343999", "version": "2.76", "version_code": 131, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2030911707585655"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "FIXES\n- A fix for the flat black squares on robot suit hands\n- Be the Monster: John's hands now line up with your real hands\n- Half-Robot equipment desk: pressing REQUEST KIT no longer shoves you back", "created_date": 1795507403, "id": "2029137427763083", "version": "2.75", "version_code": 130, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2030911707585655"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "NEW\n- Five new items in the shops\n- Bubble Blaster (Bonk Toybox): pull the trigger for bubbles, hold it to blow one big bubble. Slap a bubble to pop it\n- Glow Boomerang (Bonk Toybox): flick it and let go. It curves out, comes back and leaves a glowing trail\n- Sticker Stamp (Bonk Toybox): trigger picks the design, then press it flat on a wall or floor to leave a sticker\n- Pocket Stool (Furniture Forge): trigger sets it on the floor, pat the seat to sit, grab the handle to fold it up\n- Crank Lantern (Dave's): turn the crank for light and hang it on a wall hook in Dave's shop or the cave\n\nFIXES\n- Fixed a slowdown that got worse the longer a room stayed open and the more players were in it\n- Buttons, shop baskets, dropped items and carts do less work each frame", "created_date": 1795494932, "id": "2029003847776441", "version": "2.74", "version_code": 129, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
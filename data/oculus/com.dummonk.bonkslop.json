{"file_name": "store-2-factory.png", "id": "1000345199614941", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624583_1000345202948274_3714007804450407580_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nau3DSIgr7oQ7kNvwGqkByn&_nc_oc=AdoSk6h_2iOKKm1lkzTFHGUod7t10gJwKG5404gui2hJm-cF7sdUOHqLzFXTpCVYe28&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBPrF2vsHK6CyQDF2Uno1bgUAkJ3erqN_Y1HO5TKfUuA&oe=6B09CF1B"}, {"file_name": "store-3-robot-shop.png", "id": "1668313561395617", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628454_1668313564728950_3842695006588611594_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBO5FYU6ox8Q7kNvwG-zp-7&_nc_oc=AdpDX9DYtELLqkqKtwHvTrJlHRqofS5AZwkAvYbqe854Dtq7aGAMEAV5co2ZdAf60RU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVQYSmK7f6FHzONw1zdZrNB8DDffuqzFkMMafhYNOLKw&oe=6B09C673"}, {"file_name": "store-4-friends.png", "id": "1631513835420536", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619369_1631513838753869_4313290777978830439_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oRGZCTD8mMQ7kNvwHXXTi3&_nc_oc=AdomYhgecUfUiOShaLjWEaTDyme08WMDEgiC7zPJ2yPa1rdjfyfzmqJddxETeYheA24&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHGEev25cUXzNJclg4698u900GUzuVbh7L_TFuWxb1FA&oe=6B09CF9E"}, {"file_name": "store-5-rebuild.png", "id": "1628295938993203", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620630_1628295942326536_5880039889540522475_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBzAyHSMzBcQ7kNvwHSYfaq&_nc_oc=Adrrnu9MYaXgBqSQWEjCr-uJmZUWOUic7SalXrQ7H_fyH6NrqXT-CxFxjIXdlsSsi0s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8eaCD609NpNsiurhilN-JkL3krao8KT2TYSs2yHWMPg&oe=6B09AC71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bonk Slop", "keywords": ["gorilla", "multiplayer", "portals", "robots"], "long_description": "**Move like a gorilla.** No thumbsticks: push off the ground with your hands to run, climb walls and launch yourself through the air.\n\n**Bonk everything.** Punch friends and monsters, grab and throw stuff, ride shopping carts and tear walls off houses.\n\n**A whole world to mess around in**\n- Bonk Town: shops, houses, townsfolk and a bank\n- The Mining Cave: dig ore and gold, sell it at Dave's Shop, buy better gear\n- The Forgotten Factory: four floors of deformed monsters and loot\n- Giant robots, a Titan, and a showdown boss fight\n\n**Portals you can see through.** Become a portal-hopping mad scientist and open seamless portals: look through them, reach your arms in, and walk out somewhere else.\n\n**Play together.** Online rooms for up to five players with public matchmaking or private codes, or play solo.\n\nMade by a solo developer who is learning to code.", "short_description": "Swing your arms to run, climb and fling yourself around as a gorilla in Bonk Slop, a goofy VR brawler. Bonk your friends across town, mine the cave for gold, survive the Forgotten Factory's monsters, pilot giant robots, and hop through real see-through portals as a mad scientist. Play solo or online with up to five players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dummonk1403.github.io/bonk-slop/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Amazing Gorilla", "support_website_url": "https://github.com/Dummonk1403/bonk-slop/issues", "website_url": "https://dummonk1403.github.io/bonk-slop/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "1983294882347338"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2579583032545599"}]}, "baseline_offer": {"id": "2579583032545599"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793399460, "status": "PUBLISHED", "id": "2579583032545599"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2027895437887282", "version": "2.71"}, "id": "2359923834780302", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2027895437887282"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "NEW\n- Something new happens after you beat the Robot Vault boss. Be quick: you only get 15 seconds", "created_date": 1795399279, "id": "2027895437887282", "version": "2.71", "version_code": 126, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2027895437887282"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "NEW\n- The Chess Patio: a roofed patio beside the spawn house with a chess table\n- 1V1: press 1V1 on the console, then each player presses a seat button on the table\n- PLAY BOT: play alone against a bot on Easy, Normal or Hard\n- Squeeze grip on one of your pieces to pick it up. The squares it can go to light up. Let go over one to play it\n- Everyone in the room sees the same board, even players who join late\n\nFIXES\n- Squeezing your fist just as your hand arrives now counts as a punch\n- Pull your fist back and punch again without stopping first\n- Someone who moves into your fist gets hit\n- One swing hits one thing: a body or a wall, not both\n- A hand pushing on a wall no longer dents it\n- New punch sounds and a tighter controller buzz", "created_date": 1795373846, "id": "2027625737914252", "version": "2.70", "version_code": 125, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2027895437887282"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "NEW\n- The Robot Vault: pull open the vault door in the middle factory building and go down 36 steps to a hall of robot pods\n- Three robot mini bosses, one after another: Fusebox (pull its glowing fuses), Glitchface (find the real one among its copies) and Airlock (hold on against its wind, then throw a robot part into its fan)\n- Then the boss: a gorilla who kept upgrading himself. At half health his drones heal him, then he upgrades with a giant arm cannon, an energy dagger and a bigger core\n- Fight him alone or with your room. Everyone sees the same fight, even players who join late\n- He drops three pieces of his gear you can wear for the session: Twin Laser (left forearm, hold LT), Finger Cannon (right index finger, hold RT and let go) and Ring Armor (hits on your arms do 25% less)\n\nCHANGED\n- Two Mining Cave passages near the Gold Seam Chamber take a new route", "created_date": 1795310831, "id": "2026838801326279", "version": "2.69", "version_code": 124, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2027895437887282"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "NEW\n- Punching is remade: squeeze grip + trigger to make a fist and swing. A hit lands when your fist really touches the target\n- Hooks and uppercuts count, not only straight punches\n- Hits feel harder: a stronger controller jolt, an impact sound and a burst\n- Everyone in the room sees the player who got hit flash\n\nFIXES\n- Punches no longer miss oil barrels and other solid targets\n- No more hitting through walls\n- One swing is one hit: no second hit when you pull your hand back\n- An arm the monster tore off can't punch. Your other arm still can", "created_date": 1795155906, "id": "2025049194838573", "version": "2.68", "version_code": 123, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2027895437887282"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "FIXED\n- Be the Monster: tearing is much easier. Arms, heads and bodies come off after a shorter hold and a smaller pull.\n- A monster's grab now works even if you squeeze a moment before your hand reaches the survivor.", "created_date": 1795146835, "id": "2024952011514958", "version": "2.67", "version_code": 122, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
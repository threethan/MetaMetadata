{"file_name": "store-2-factory.png", "id": "1000345199614941", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624583_1000345202948274_3714007804450407580_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uofbazESprMQ7kNvwF2n2Zn&_nc_oc=AdrE7oe2P8RFDvdvbEYcNMRoQqwhttyNVGk-eh1bsW4sCSbPcbLtX2rEZcJ3yUPizS4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR23vrJByuDVnZoYHjIMpRbQxAP9c-XTgvcoB592UNFEA&oe=6AFC67DB"}, {"file_name": "store-3-robot-shop.png", "id": "1668313561395617", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628454_1668313564728950_3842695006588611594_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhAyLAP9mfkQ7kNvwHMyQuU&_nc_oc=Adpi6rfDAYbq0pbc5mxqI0xYgNgsuzOh-IiXTd0zZlHCZ63sTz2nuLaKe_5WYfwNsiQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStXkGTNb8ZoQK9zaa6JsQ9HufpECr52HrNVK6nBd_yuQ&oe=6AFC5F33"}, {"file_name": "store-4-friends.png", "id": "1631513835420536", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619369_1631513838753869_4313290777978830439_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VXcN1YPhugQ7kNvwG9XlUu&_nc_oc=Ado0l8USouzgnxtkzLLzQScEgDLoqZDvLmBAAmW8dRWvH9cmX4koykNTHg-oA1j6yVw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI3q5jFW8a1t1cCF7R3izJKo6yUIk9pTWiu5x8wNhN7g&oe=6AFC685E"}, {"file_name": "store-5-rebuild.png", "id": "1628295938993203", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620630_1628295942326536_5880039889540522475_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKCnb0Ychx8Q7kNvwE5ruQ4&_nc_oc=AdpFXprqrhZRpJP2B1AGn73a4xwDAvPRG-DVzZAwvJjdODckc39KhouiKQSet1IkOgs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLhrHE_wmahwCfk3fbsHsn2kn3bh7ONSpFMs6582LMEw&oe=6AFC7D71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bonk Slop", "keywords": ["gorilla", "multiplayer", "portals", "robots"], "long_description": "**Move like a gorilla.** No thumbsticks: push off the ground with your hands to run, climb walls and launch yourself through the air.\n\n**Bonk everything.** Punch friends and monsters, grab and throw stuff, ride shopping carts and tear walls off houses.\n\n**A whole world to mess around in**\n- Bonk Town: shops, houses, townsfolk and a bank\n- The Mining Cave: dig ore and gold, sell it at Dave's Shop, buy better gear\n- The Forgotten Factory: four floors of deformed monsters and loot\n- Giant robots, a Titan, and a showdown boss fight\n\n**Portals you can see through.** Become a portal-hopping mad scientist and open seamless portals: look through them, reach your arms in, and walk out somewhere else.\n\n**Play together.** Online rooms for up to five players with public matchmaking or private codes, or play solo.\n\nMade by a solo developer who is learning to code.", "short_description": "Swing your arms to run, climb and fling yourself around as a gorilla in Bonk Slop, a goofy VR brawler. Bonk your friends across town, mine the cave for gold, survive the Forgotten Factory's monsters, pilot giant robots, and hop through real see-through portals as a mad scientist. Play solo or online with up to five players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dummonk1403.github.io/bonk-slop/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Amazing Gorilla", "support_website_url": "https://github.com/Dummonk1403/bonk-slop/issues", "website_url": "https://dummonk1403.github.io/bonk-slop/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "1983294882347338"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2579583032545599"}]}, "baseline_offer": {"id": "2579583032545599"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793399460, "status": "PUBLISHED", "id": "2579583032545599"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2018177155525777", "version": "2.57"}, "id": "2359923834780302", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2018177155525777"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "NEW\n- Bonk Industries has its own building in Bonk City.\n- New You: three armor suits.\n- Five new field tools.", "created_date": 1794533096, "id": "2018177155525777", "version": "2.57", "version_code": 112, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2018177155525777"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "FIXES\n- Touching a ramp while gliding no longer stops you dead.\n- A hand resting on the floor no longer stops you when your other hand finishes a stroke.\n- No more hard jolt running up the porch ramp and the factory stairs.", "created_date": 1794442265, "id": "2017083958968430", "version": "2.56", "version_code": 111, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2018177155525777"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "NEW\n- Dave's Jobs Board on the back of the shop: pick a job, drop the items in the crate and get paid. Cave Ores (250 coins), Vent Salvage (500), Arena Recovery (750).\n- The spawn computer now shows how many players are online, and your FPS.\nFIXES\n- Small fixes and polish.", "created_date": 1794435477, "id": "2017022642307895", "version": "2.55", "version_code": 110, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2018177155525777"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "NEW\n- A new secret is hidden behind the old vents. Find the way in.\n- A new boss is waiting at the end of it. Bring friends.\n- Promo codes: a new PROMO page on the spawn house computer. Type a code to get rewards. Each code works once per account.\n- Meetup sign: a sign next to the spawn house computer shows the next meetup in your own time zone, with the lobby code to join.", "created_date": 1794423937, "id": "2016902098986616", "version": "2.54", "version_code": 109, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2018177155525777"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "NEW\n- Scoop water from the Bonk City fountain: hold grip with your palm up, dip your hand in and lift it out. The water sits in your palm, wobbles and drips.\n- Tip your hand to pour it out. The stream splashes and makes ripples where it lands. Works with either hand.\n- High Shaders in the spawn house: daylight glows in the windows with soft light beams, soft shadows under the furniture, and deeper wood grain.", "created_date": 1794289380, "id": "2015279972482162", "version": "2.53", "version_code": 108, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
{"file_name": "store-2-factory.png", "id": "1000345199614941", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624583_1000345202948274_3714007804450407580_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uofbazESprMQ7kNvwGhLZyl&_nc_oc=AdobtRGjv-9wCsS8CUXVwmrWdUEBkDPCziuSizWDr2Y8p97AjJr3-Rg77v-APNnNuoo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeH13z16Qs2x2QjHmY6drRWpCNQJMhtNoqRgPpaDAlQw&oe=6AFF0ADB"}, {"file_name": "store-3-robot-shop.png", "id": "1668313561395617", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628454_1668313564728950_3842695006588611594_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhAyLAP9mfkQ7kNvwFwCgWT&_nc_oc=AdrQMr2c-Tce5sLmwgm_2ad-sOjVFymCzHljCKVc6XhrxFTB9PmPcJ5IGGeSJECYhlA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRzwkqmgZW0JTFvbDnkFa7iAqqbo0CCZn9mC_6tV4tHw&oe=6AFF0233"}, {"file_name": "store-4-friends.png", "id": "1631513835420536", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619369_1631513838753869_4313290777978830439_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VXcN1YPhugQ7kNvwF91mQY&_nc_oc=Adr22Ro8gXVr0oWKl4CZphC0qx-8pV8GCrtS2kQ4nZ1OKH7kXgKYqbB1jIsl13wxSbA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUtT5ONVFVVlpPd3G8d2oe3ReQHwxfUx3t2VGksR9-9w&oe=6AFF0B5E"}, {"file_name": "store-5-rebuild.png", "id": "1628295938993203", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620630_1628295942326536_5880039889540522475_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKCnb0Ychx8Q7kNvwHPw3l7&_nc_oc=AdqKC9TeOgVymufQWBP1RUF4ZwOLsZ4XKJq9qQjZrcTVueib0PxXFYqJ3elWI3ByjCM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRprxhuaAp3SsZH0d9zkRXKf7PmQyMWJG_ikDXjMnfczw&oe=6AFF2071"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bonk Slop", "keywords": ["gorilla", "multiplayer", "portals", "robots"], "long_description": "**Move like a gorilla.** No thumbsticks: push off the ground with your hands to run, climb walls and launch yourself through the air.\n\n**Bonk everything.** Punch friends and monsters, grab and throw stuff, ride shopping carts and tear walls off houses.\n\n**A whole world to mess around in**\n- Bonk Town: shops, houses, townsfolk and a bank\n- The Mining Cave: dig ore and gold, sell it at Dave's Shop, buy better gear\n- The Forgotten Factory: four floors of deformed monsters and loot\n- Giant robots, a Titan, and a showdown boss fight\n\n**Portals you can see through.** Become a portal-hopping mad scientist and open seamless portals: look through them, reach your arms in, and walk out somewhere else.\n\n**Play together.** Online rooms for up to five players with public matchmaking or private codes, or play solo.\n\nMade by a solo developer who is learning to code.", "short_description": "Swing your arms to run, climb and fling yourself around as a gorilla in Bonk Slop, a goofy VR brawler. Bonk your friends across town, mine the cave for gold, survive the Forgotten Factory's monsters, pilot giant robots, and hop through real see-through portals as a mad scientist. Play solo or online with up to five players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dummonk1403.github.io/bonk-slop/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Amazing Gorilla", "support_website_url": "https://github.com/Dummonk1403/bonk-slop/issues", "website_url": "https://dummonk1403.github.io/bonk-slop/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "1983294882347338"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2579583032545599"}]}, "baseline_offer": {"id": "2579583032545599"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793399460, "status": "PUBLISHED", "id": "2579583032545599"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2019451012065058", "version": "2.61"}, "id": "2359923834780302", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2019451012065058"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "NEW\n- The Lake: a new lake west of the cabin with a dock, a rope bridge and a chill platform hung on cables over the water, with benches and lanterns. Reach in with your hands, but don't fall in!\n- Owner Super Strength: 5,000 health, and lift and throw players, town gorillas and robots up to the Big Robot. Only a Titan can pick you up.\n\nFIXES\n- Super Strength throws use your swing speed like the robots do.", "created_date": 1794637601, "id": "2019451012065058", "version": "2.61", "version_code": 116, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2019451012065058"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "NEW\n- Creator Menu: Level 3 creators open it with the right stick. 24 filming mods in MOVE, BODY, FX, CAMERA and STUDIO.\n- FX: Glow, Rainbow Fur, Smoke and Sparkle Trails, Confetti, Fireworks, Spotlight and Hide Name Tag.\n- Cameras: Orbit Cam circles you, Drone Cam hangs behind you, plus Selfie Stick and a Green Screen only you can see.\n- Join Studio in one press. Freeze and Launch Guns work inside the Creator Studio only.\n\nFIXES\n- Joining an empty Creator Studio with its code works now.\n- Mods show to others right away after you change rooms.", "created_date": 1794626107, "id": "2019312018745624", "version": "2.60", "version_code": 115, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2019451012065058"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "NEW\n- Content Creators: apply on your watch (SETTINGS > CONTENT CREATOR) with your channel, a Bonk Slop video and a Short.\n- Three creator levels, each with its own look: the BonkCam, the Pro Creator Rig and the Bonk Industries Director suit.\n- Level 2 and up get into the Creator Studio, a private room for filming.\n- The creator display inside the spawn cabin shows what each level needs and gives.\n\nFIXES\n- Bought items are yours for 1.5 seconds before anyone else can grab them.", "created_date": 1794620939, "id": "2019254942084665", "version": "2.59", "version_code": 114, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2019451012065058"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "NEW\n- The Orb Station is open in the Bonk Industries store.\n- Five power orbs: Strength, Speed, Bounce, Magnet and Shield.\n- Unlock an orb with Gold Bonk Coins, buy it with Bonk Coins, then use it for free.\n- Hold trigger + grip on the orb for 2 seconds: 3 minutes of power, then 2 minutes to recharge.", "created_date": 1794610825, "id": "2019144922095667", "version": "2.58", "version_code": 113, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2019451012065058"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2359923834780302"}]}, "change_log": "NEW\n- Bonk Industries has its own building in Bonk City.\n- New You: three armor suits.\n- Five new field tools.", "created_date": 1794533096, "id": "2018177155525777", "version": "2.57", "version_code": 112, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
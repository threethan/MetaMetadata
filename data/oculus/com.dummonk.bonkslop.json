{"data": {"node": {"__typename": "Application", "id": "1983294875680672", "organization": {"id": "1342517213091778", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1983294875680672"}]}, "id": "2130465564530896"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1983294875680672", "release_date": 1793399460, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2025049194838573"}, "id": "2359923834780302"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1983294875680672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2025049194838573"}, "release_status": "RELEASED"}, "id": "2006156233394536", "version": "2.34", "version_code": 89, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1793467133, "id": "2006157796727713", "is_initial_release": false, "name_with_fallback": "v3", "pdp_metadata_with_fallback": {"version": 1, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1983294882347338"}, "release_status": "RELEASED", "id": "1983294875680672"}, "id": "1983294882347338", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": null, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628456_1626656235774220_8887951922540114656_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7-bZ7eEsMkQ7kNvwHjpHXB&_nc_oc=AdrF34hfgK0dzAlUis-7KTljJopvQSYnglhLSyD8RVe-i6ZrcMWrA9VvoApdjKpexoE&_
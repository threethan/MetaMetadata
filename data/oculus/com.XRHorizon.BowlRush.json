376006803991516_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgLHlDF_E_sQ7kNvwHo5wky&_nc_oc=Adq-7H_V3hwDNpIxhvcHXhNIfWWHh0pdhbsCGtuROFGfjtNI97cDXKEFzxtvpdAfbNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IHIU3l9qjtKPlP6ZI4xYaNuJd5ZVfGZZtHtggaF_c1A&oe=6A47DBF2"}, {"file_name": "ScreenShot 4.png", "id": "1437253277970878", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618069_1437253281304211_1545233088993632901_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=791mldrBzhMQ7kNvwFEC7dC&_nc_oc=AdpYuENuM6tIvlc-1wr0m7co8KbDVaI4LTd7haUzlrH38_R_U6Jix_zjDO7uHuubwuo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N8V7mtxdnZU9DuEeoi3dxPm1cfDcLJRZ18wqmYkfmXQ&oe=6A47C0A7"}, {"file_name": "ScreenShot 5.png", "id": "1349029149966618", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619148_1349029153299951_4920316539364818275_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYvUy9O0cKkQ7kNvwG2VF8j&_nc_oc=AdoY5xo6zrtlhg5pXacVXWYtmoeohLXsK8f0wIuCTR2wwUWuKuAqStTd-6busqJ__7s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nk-yDPUspx6zHPdxEV4KPtU4FepiEWaZ8fnr8Bjqr5Q&oe=6A47D729"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "2618630518494513", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619148_2618630525161179_3443301477918799219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLkAmZgHogkQ7kNvwG33jZN&_nc_oc=Adp1HJPpTxfvYh3dxqEYnUYcgCi6idJRxVsjKWzaPDDz7i0saokP05r9L5sGL9mFbeA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L1spBOO3_tstUeE3qTyuGrBVhDtv3hSwtTmXD_agsiA&oe=6A47BE77"}, "display_name": "BowlRush", "keywords": ["BowlingGame", "BowlingVR", "VRBowling", "BowlingSimulator", "BowlingArcade"], "long_description": "BowlRush delivers a hyper-immersive bowling experience set inside a glowing neon alley designed for VR. In Single Player Mode, you can sharpen your skills and challenge yourself through a full 10-round bowling match that captures the authentic feel of real bowling.\n\nStep into a futuristic lane where the atmosphere is vibrant, the physics are realistic, and every roll matters. BowlRush carefully replicates ball weight, speed, spin control, and pin reactions to make every throw feel natural and satisfying. As you play, your score updates in real time, allowing you to track your performance throughout the match.\n\nEach pin knocked down earns you 1 point, pushing you to improve your accuracy and timing as you aim for strikes and perfect frames. Whether you're trying to beat your personal best or refine your form, BowlRush makes practice engaging and rewarding.\n\nKey Features \n\nFully immersive VR bowling designed for precision and realism\n\nNeon-lit futuristic alley with dynamic lighting and visual effects\n\nRealistic ball physics and authentic pin reactions\n\nStandard 10-round match structure, just like real bowling\n\nReal-time score tracking and performance progression\n\nPerfect for skill-building, practice, and personal high-score challenges\n\nPut on your VR headset, line up your shot, and experience the thrill of the lanes in BowlRush. Every roll, every strike, and every point earned brings you closer to mastering the game.", "short_description": "Realistic VR bowling with fun. Strike, compete, and master the lanes in BowlRush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/bowlrush-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": 
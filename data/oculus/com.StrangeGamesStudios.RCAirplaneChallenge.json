1129934974951", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974602_461129938308284_6704955552584234771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsjctcXgbXgQ7kNvwGEYou1&_nc_oc=AdqPoHKYZqoXjpxSUmVCOga3Nx_8eE8cTbqtNArRbQLNc_cZkvFzd7xlNp5BTTI8otY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24ThC8fkgkLGaBqo25Ndl6uarMEkz4Dwdcg34jQOrBrQ&oe=69D8DE3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen3.png", "id": "824237555172669", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974764_824237558506002_1703130294890072998_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7F7yuu-gInYQ7kNvwHbdsLO&_nc_oc=Adp9i1SHG5_F20sc5X9NzWoL--AF6ZMhCMcoTHJ-iDbGogiXwOqPZyOHVdDIsOmJuTw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Eh1xZrt16PWb9stiK2ZBONKCSciYPh5BxEun_2I9vOA&oe=69D9020F"}, "display_name": "RC Airplane Challenge", "keywords": [], "long_description": "Fly model airplanes in RC Airplane Challenge in this arcade styled flight sim. Fly by yourself offline or with up to 32 other players in online gameplay. In addition to free flight, single player features the following 4 game modes:\nBomb Drop - Destroy as many targets as you can in this timed mode.\nRings - Try to fly through as many rings as you can with each new ring becoming increasingly harder to hit.\nBalloon Pop - Pop as many balloons as you can in this timed mode.\nTime Trial - Complete the course as quick as you can in this race against time.", "short_description": "Fly model airplanes in RC Airplane Challenge in this arcade styled flight sim. Fly by yourself offline or with up to 32 other players in online gameplay. In addition to free flight, single player features the following 4 game modes:\nFree Flight, Bomb Drop, Rings, and Balloon Pop."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.strangegamesstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Str
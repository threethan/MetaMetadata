1129934974951", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_461129938308284_6704955552584234771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjNxjFZbotMQ7kNvwGqdpAK&_nc_oc=AdoE22-mKjQBp02na6LXLdsd2uay8UGLfsoMWHI4fUBNdWrl1bQWK0I3y4eAlLtNTmw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g23xBsM_22xlhHGp3aC_K0-psWo9Re75mMpCaTQs3cw&oe=6A3AA57A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen3.png", "id": "824237555172669", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974764_824237558506002_1703130294890072998_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bcj4YIFOKJIQ7kNvwF_ImzR&_nc_oc=AdqHxYQ35c3zHVKsRq3gvMtezUxD-sO6W4DhXZlzalyJg3m5KVTt-sQUXwaWzWaxHKo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nSg_DFA2KnGDC_h_uqxp1aFk12ohUE-dHOZUsaZmgwQ&oe=6A3A910F"}, "display_name": "RC Airplane Challenge", "keywords": [], "long_description": "Fly model airplanes in RC Airplane Challenge in this arcade styled flight sim. Fly by yourself offline or with up to 32 other players in online gameplay. In addition to free flight, single player features the following 4 game modes:\nBomb Drop - Destroy as many targets as you can in this timed mode.\nRings - Try to fly through as many rings as you can with each new ring becoming increasingly harder to hit.\nBalloon Pop - Pop as many balloons as you can in this timed mode.\nTime Trial - Complete the course as quick as you can in this race against time.", "short_description": "Fly model airplanes in RC Airplane Challenge in this arcade styled flight sim. Fly by yourself offline or with up to 32 other players in online gameplay. In addition to free flight, single player features the following 4 game modes:\nFree Flight, Bomb Drop, Rings, and Balloon Pop."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.strangegamesstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Str
1129934974951", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_461129938308284_6704955552584234771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0yBBpAapJsQ7kNvwGpv37_&_nc_oc=Adp03rnWGWZPgfDTRRcVOZ_dTLmErETvh5Jzvt6yGMUtWJTzDA24f2GNy79X8jH-bH4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32_7Yt8RiALhppaQY0_rO7URdlpFVNKLBE7Khvztar-g&oe=69D246BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen3.png", "id": "824237555172669", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974764_824237558506002_1703130294890072998_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuVFLVIwS1gQ7kNvwH5-c5F&_nc_oc=Adr4D5BbjYJcPwe7XKq__SYaIScn3rTGUCr1FZ4COqr_97jkY1-qW8Zxti5dFa4Q-r8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nZdjwfshIY09NWY9ionXxWW7S5dnI7OhTqV3PzjqbOA&oe=69D26A8F"}, "display_name": "RC Airplane Challenge", "keywords": [], "long_description": "Fly model airplanes in RC Airplane Challenge in this arcade styled flight sim. Fly by yourself offline or with up to 32 other players in online gameplay. In addition to free flight, single player features the following 4 game modes:\nBomb Drop - Destroy as many targets as you can in this timed mode.\nRings - Try to fly through as many rings as you can with each new ring becoming increasingly harder to hit.\nBalloon Pop - Pop as many balloons as you can in this timed mode.\nTime Trial - Complete the course as quick as you can in this race against time.", "short_description": "Fly model airplanes in RC Airplane Challenge in this arcade styled flight sim. Fly by yourself offline or with up to 32 other players in online gameplay. In addition to free flight, single player features the following 4 game modes:\nFree Flight, Bomb Drop, Rings, and Balloon Pop."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.strangegamesstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Str
12px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkEFWf0LqZ8Q7kNvwGMSIsJ&_nc_oc=AdqKg_49n3JOa54b5Ewj30MEA1RmCYEpfI8IiUsjxrOcLcwQTzE_4fXXDEfMypdEjNc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVY0VFfai8awiAq6cSumT53WsCLOp7SU7w5WCun7XLKA&oe=6A901AA9"}]}, "id": "1787317635973475", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUscO7rNqEUQ7kNvwEtMFZc&_nc_oc=AdoAgKB9ftqthrsQm5jjnIIpZpS3LPoeYj0C7IYR6zk1if1Gi9IRqIF5m8zT6aBhfAw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuKpnYn4YaUkOtDLqkV9YSCq9usmf4e2XBmmBag5C18g&oe=6A9034E5"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uh2zvaQhmi8Q7kNvwGxKP2G&_nc_oc=AdocXAQVMFKKoqNxqEOO--uNG8bXMt9eb_3CBkizTM7YjDao9A-AeD9Vfu_gEDrt7mA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFakv0_AZwozscK8YbYxwp_h8Cbb6YGvqoAKgJn_1zxtw&oe=6A9013F1"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMfaHsS0S3MQ7kNvwHgROC0&_nc_oc=AdreNPxLmGg28gOWWM7xHCwmQaguwLcfba5_uiWl28rlcm56vVaNgWKaYcTVeWDWBKM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmTvmPKsMyXwXrNTTQtA-FUGl69FOKM7K7egJExukq5g&oe=6A9023A3"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSKgMbKT3Z4Q7kNvwFAcvZ-&_nc_oc=Adqd0KsGlI1t21kSRA9f7GHVcU2S_66DtF2DS4y2t74R5z8U9-5dNKRAyVPGSwyspkg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrM_ygftDw-ODnE4J_bveFQHM0-2I68kXXugUyqkJpTQ&oe=6A903F4A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJpifo4OCOUQ7kNvwGiuOKs&_nc_oc=AdoPvMMxRqmOxIzaMt8rwng_T0XhGICgJHKGEeUUXaWrgTQ4KkqNIcdW1h7kuFv_ARY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqkzvMQX1s8FQLgk8vPlIgdGTY0tu1o6sg6lxW-c8kPw&oe=6A90229A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n**Use Cases**\nSuitable for education, exhibitions, events, and other scenarios where synchronized playback is required without network access.\n\n**Experience**\nShare important moments with your audience at the exact same time using a QR-based playback system.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}, {"images": {"nodes": [{"file_name": "Artboard \u2013 5.png", "id": "3862485207215612", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618264_3862485213882278_6983363211996585407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BO8EeW0fQAIQ7kNvwH85arl&_nc_oc=AdovP2AyhJKwRokpJwnE6Jxs57g0m7J6MGXoDtSd8KFkc-fQpCI1Ku_mODN0IFWwlyI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeA756QlWEEdPuHCLL7lM3HY8xMd1rexlmaCqdCBGDmg&oe=6A9035AE"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "1135616805161792", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619148_1135616808495125_8615746792926765700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXNJT9EDsbIQ7kNvwF6hk1S&_nc_oc=AdoSY571fdiRvXEyyIN8n3MrvuSGf9XU1kOl03xY9dxAdAArdGYTb-YRtD_ZTEmFgSc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq8J-6bVOAP5sccDWd1KLe7BuY0Z2W5NqW6-42i90uZA&oe=6A9009B1"}, {"file_name": "Artboard \u2013 6.png", "id": "814564234364013", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618274_814564237697346_1085994346422534066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgZfKLoDNNQQ7kNvwFXjShS&_nc_oc=AdrSneqs-8amLxOFpoFxouFbr91b_Cj5LEHbGi_HEmoNpTU2-Yza9iKSjLa4OqGmfgY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV8wUu2-XK26qrYaN0z3HeD33rQREgwYsIT8oIKvBxKw&oe=6A901BB3"}, {"file_name": "Artboard \u2013 2.png", "id": "789635813561471
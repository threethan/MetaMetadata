12px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t999LTH1DnMQ7kNvwFJGs06&_nc_oc=AdrSUWdw2gifr2kLCZ9q1HOFmvS1gxa1o19tNF_rZwuRKbsRVIGurS70IsBPzihhc4Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1ZVfEOK82gonJe-KulDIzGg5iSpqgwrIP6tTJDHsvdA&oe=6A68C5E9"}]}, "id": "1787317635973475", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0a0pmER88RMQ7kNvwFhVvFo&_nc_oc=AdrDhmqExRntU525p_qGvYD5xGLL63hOur_xCimxbS7a-g6ayk_rqvTu2WXm4MsUsIg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3ayMioJR7NZPVPU3P2Wnbh1ZVud__xM3RwluCmsCzKQ&oe=6A68A7E5"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AKZ_--FxMkQ7kNvwGDf6BK&_nc_oc=Adoal8stHqnkBlh3WIPssUprt7FtzFPJKIbhXBxKIaGBWrH3eYpSbdTlHZQ1TqunajI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqeYJc5doliekkjwLvp6IADMuPvZ8moJ6tx8cbzFwdDw&oe=6A68BF31"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sV9a9NB498Q7kNvwG8zZOY&_nc_oc=AdrWtuxWJ5eetz2WuC7duiEoI4Hf32XR62brzP9YYkYYOpH7Tce-lVAwKX_WMMRyBQ0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB20M41qqqu8lwZzifhm347704_a6lEDDqAXpNBZDOWBQ&oe=6A6896A3"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKZBNKFDDWEQ7kNvwGpjySo&_nc_oc=Adq1xORiq92DXekDLt8sRJqkPXcO2sjw9j9Hwf5j-XUIVTb5suPDvqjHn-rsgRWWeOM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdl07UsxqNDAWj32ATD_jTQnK9fkaN97jlvF4SXxRHWw&oe=6A68B24A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJdFPkhIb-IQ7kNvwGgHNca&_nc_oc=AdoD5fD4gPm8kQMj9Gelx2n34AsH0rA2jHavo6XY649yz_ISdfrMK4PsqxOdBPnOfrk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGze-pJj_8CRZdQz0tnIwaO0yiUQgwMPm5d-zFlbA8Kg&oe=6A68959A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n**Use Cases**\nSuitable for education, exhibitions, events, and other scenarios where synchronized playback is required without network access.\n\n**Experience**\nShare important moments with your audience at the exact same time using a QR-based playback system.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}, {"images": {"nodes": [{"file_name": "Artboard \u2013 5.png", "id": "3862485207215612", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618264_3862485213882278_6983363211996585407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEa3iBxqX9sQ7kNvwGHMUF-&_nc_oc=AdprClCy7n5aBLFrzt6bQw9eR4z1Hi4OjII6d6pR47yaTdvsBJavYSie9qdH3rycRQY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjtcrFZKVWU_jGSPKH6IjTCabAZweBIYpqHMlzEbBiKg&oe=6A68A8AE"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "1135616805161792", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619148_1135616808495125_8615746792926765700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLUvgbUciLIQ7kNvwEDSlhx&_nc_oc=AdpuuZw22_Q5B4RtcozfD8_JJhV0FfQJYvW0HgmZyErpMIt_Haxpq-F-xaGqKFRp1Hk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9F4nEs1u9zTUEBkCKXDHc998F3OMqV3LKguTFMIwgCQ&oe=6A68B4F1"}, {"file_name": "Artboard \u2013 6.png", "id": "814564234364013", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618274_814564237697346_1085994346422534066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjBD_UjxLLoQ7kNvwH0q0hp&_nc_oc=AdpqFJ8cDBY7J2Xwybj9PkgcHMB7kEcqk-DwDpZRL5koHeJkauGuqVhBAepq8GIZM3I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYoI9r2Fmx71MH6oI-51aSO2FgmlLR-C4Nglc9ekvFJQ&oe=6A68C6F3"}, {"file_name": "Artboard \u2013 2.png", "id": "789635813561471
7310998480", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rSskTBv0fkQ7kNvwFPf0tj&_nc_oc=AdqGXswiQG8auQ2_57oyIvrcNKj0hRq-Z0seWOHOL-1mczFwImuhtxpUgPmi2qifvwo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp9MJAFxqWMWrwIUITX0gpJdoG7817vfJNhUjdMoA9YA&oe=6B007CA5"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-44EXpL1QJsQ7kNvwHNbnu1&_nc_oc=AdpBrpkX3kVFOgWDaAvxSUD5LKMPZzJlF2ZOXKSEn5UtCPSdOV5bs8i9qM_b08hd7yM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRkaicOTozyIyhUlSFbvfisPlDltwVZU9t0JJQ4SIOBA&oe=6B005BB1"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSYfJml57BMQ7kNvwE5vlX-&_nc_oc=Adp4JNL89IBt7rCei9tMAKQy71OoqhV3JWmJ2ipKTI2QcZHtQf7pyr_LPrZ6eWaFzd8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLjWt83Hvh2XBbSRuuqBYJa5CAhUs_TjwRooju8mpi7A&oe=6B006B63"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bb11bXW8qJcQ7kNvwEo8TFP&_nc_oc=AdpX_tgX65DAl_ZRaHi00ycmhwijvwhxCa-pl29Y4G_ba3kO2-Tebm35kW0gIWVIaBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVenVLOMidy71bYkjAtVOnOBxKtkYS9x6xpnA-dEtNWg&oe=6B00870A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHYa2z3IsVMQ7kNvwFNi0qO&_nc_oc=AdpvCirW1GGIG8bh7YLJ_TkvDFJhUM5yObLquTdM1eTLSO6UexpnrF-7NjQ5atLtP3o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcn8UiahHTLdHBBrmQZTMYW93JUOIuEi4xI8xpF-FEFg&oe=6B006A5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n## License\nThe Store price covers personal, non-commercial use only. Any organizational or commercial use\u2014including events, training, facility operations, or customer experiences\u2014requires a commercial license. Contact NeoRealX before purchase for pricing by use, devices, and duration.\n*Applies to purchases on or after Aug 28, 2026.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neorealx.com/QuixPlayer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NeoRealX", "support_website_url": null, "website_url": "https://neorealx.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28906519578934891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617831_1275302853907408_308330225284587646_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryIr93CjX0EQ7kNvwEkA4Od&_nc_oc=AdoiqOMSVA-VkL_FcuUNICUs6OqRAM9dOOwSsq8JckylkW5k1J5byXec50DOOsjg7Ts&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTy-ZZc9MGtN00vqXLnW_R0-LHD0bxGbNQL06ibAazdWA&oe=6B0088BD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "QuixPlayer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1758506100, "lastRevision": {"nodes": [{"id": "25271372679116284", "release_type": "SCHEDULED", "admini
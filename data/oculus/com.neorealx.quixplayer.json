12px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcl8PHmTyu0Q7kNvwEnk2ab&_nc_oc=AdqGDlU0bm0qIs5ddZN-guybx9WediWDf_UqZgUBZbNoit4GnGdG6KDxOvLu_TU2NKA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaWhTzzkNjSxhWriGsLHNFr7VgbU8hM8ZQRUqklEMT2Q&oe=6A622E69"}]}, "id": "1787317635973475", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_44bhH4cFncQ7kNvwF4zo-b&_nc_oc=AdocQCVoY0QyclUnXPJq0PDryNJfuzHeHqFfZoAS-WJn9nIPBYjRsX816VtFfM7ByY8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxRnzuSLQ5r7heE7DFs0GDu47Ab37AQz9Bg8N9NaI79w&oe=6A621065"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEx2prw9VHEQ7kNvwHnUoM2&_nc_oc=Adrq2K7TBsk9uaiPfmRsHoI2z1SZE9N3ZQOHt--abH38QMupSvdYt3mcgUi_pNyoXcQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmQm4I1h7lD5F0Q7PaOsHp-tYElRBr_h1RlOj6cXEtdQ&oe=6A6227B1"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxxNG0NfjBIQ7kNvwHNl2Ug&_nc_oc=Adov7M9q54r40pWJfvSNYsa9QxaW3mt8rytt1R6F3xmVKojlUS7o5XBZ1iNVuurtKfs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5nX__wicBZwq6B2n0bIxeLS3do47Ib-URs20bXpQ8Jg&oe=6A61FF23"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-tBx4_wDhkQ7kNvwFrz5aE&_nc_oc=Adr9Dw_qvC7oegllp6JnGBZmNRSNJlU2r0FeM1hnT7pCTlVkcOLcXvtRJSgepgiQPjQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQNC1wo5rkt1T_UpieaQAMZM6PjiyiSvKP6u99wl4lfw&oe=6A621ACA"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhqfgJvieNsQ7kNvwHLDPXc&_nc_oc=AdqEkDdZQ6qVH1BuBwiq6i1MBNrusdt44_GQ1wDJz7xpwJ1LxO5VzAQMkvDUxYC2V_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgPuuMi9PnoQZzTp26mFmgUTVLokaUyr13UsFWMnc5bw&oe=6A61FE1A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n**Use Cases**\nSuitable for education, exhibitions, events, and other scenarios where synchronized playback is required without network access.\n\n**Experience**\nShare important moments with your audience at the exact same time using a QR-based playback system.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}, {"images": {"nodes": [{"file_name": "Artboard \u2013 5.png", "id": "3862485207215612", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618264_3862485213882278_6983363211996585407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsDFK6x-b-IQ7kNvwHUbbz_&_nc_oc=AdqZvgK3D3e6SukSuEBqIdCtav1rFhr4Fv3ikTTvwhAeIegztfNuFIXAxKv8oDJmcYI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmZfMn8C5kwNEtQI6W8NhRSe65JJVktJDdvQSsj6TqCg&oe=6A62112E"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "1135616805161792", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619148_1135616808495125_8615746792926765700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7jCT-5d3CAQ7kNvwHMIXKF&_nc_oc=AdrPccSucetlssJToL5yUhXeCn8nTnz55Z36d4A7t9i_t02TEANKGyIPZeoSM-U1N7c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFLBoNZhrxU-d5WdonqhB2qMW7Jr59FL-ZNlu1sPVlJA&oe=6A621D71"}, {"file_name": "Artboard \u2013 6.png", "id": "814564234364013", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618274_814564237697346_1085994346422534066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfXrNfNou9oQ7kNvwFvjTdq&_nc_oc=AdphnG-YkcTtIljss5uDj9I3Mfbg75ce_wGMoXVqrnOpvpfGoTsYYT_vbveR9Qd5udA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAK0bxUr6PwMg9N3FcBnQfPE_nhDu4qNW1Z6x_aVHa1BQ&oe=6A622F73"}, {"file_name": "Artboard \u2013 2.png", "id": "789635813561471
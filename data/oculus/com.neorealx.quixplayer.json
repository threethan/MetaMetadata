12px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPji8BzdpFoQ7kNvwGCxTLq&_nc_oc=AdqqMqieQh4vg_RqE3wYsQa7rGRCI_Pkw2n1zl9-jJIsia6FxVc1KL810Wc4yiisYUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9G2gTBsAARdAIhXDfTLU32h7ih7UpScJSZ1b48x0qkrg&oe=6A3FE769"}]}, "id": "1787317635973475", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opRKnCoGO-kQ7kNvwHRc94p&_nc_oc=Ado4rc4PJCGx9zsYvaI7uTQHnaE6avdsR9alc3naRYXuyvFwdLRlKUqZjHytO0zM_lk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xDQb_SUXGNKsBBT9YxEKbJTCIAaXYCKgGHCS7pKB7lg&oe=6A3FC965"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEDbLUaxXWEQ7kNvwFLCgBG&_nc_oc=AdqKwZSxmiDyQ9jpLyDjxEddoOGfrkkLPxyr2MdQ10u7NqQNtgIF-mLWy5PjwvcLtXk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xx1UgZsikcpw12tr0-8dbe91gGomD9y6gYqpPCCvAbQ&oe=6A3FE0B1"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ko06J64aDcUQ7kNvwGWx1hO&_nc_oc=AdrWb2jhjcMJH34JoD7uyr_-pZJPFcO49ojMEg3oCXKN_6r_HTKBdG-_Qbr1TSPC_wc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cIo5IoBPEZ5riOs-SPg7Q4ab-vppkzRan-GQnYUU-MQ&oe=6A3FF063"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0x9rMn9TssQ7kNvwFGleQG&_nc_oc=AdqvMqUuQ08Kl8ArbMXMtzfszBlXh4ubvlYxlPcJN92Gq4gAMd5Nnvax3azDx4SLRoA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PcrWB0L-t-NAEISn8eOZXl5r1yRJWdCKvqYviCgVXkQ&oe=6A3FD3CA"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guIvZO00OtcQ7kNvwHMfC7F&_nc_oc=Ado6j_acxlnGaC3shGsOFYbgo_dhpyOXIAGfYRPpjIaBg7OCdveR6hylx1X1nGHnKeA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8im4fk_OKCwDHb2H2jctSytinSqiKU_-LnKkG9xhRNSQ&oe=6A3FEF5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n**Use Cases**\nSuitable for education, exhibitions, events, and other scenarios where synchronized playback is required without network access.\n\n**Experience**\nShare important moments with your audience at the exact same time using a QR-based playback system.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}, {"images": {"nodes": [{"file_name": "Artboard \u2013 5.png", "id": "3862485207215612", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618264_3862485213882278_6983363211996585407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bc8FpsucMo0Q7kNvwE9uHU9&_nc_oc=Adre_jbLkoxys2UkS8FbxnnwJ-gqzgI8AkzAGoJTmzy4jpToNU2cK3Y4LEKXfeoyqXw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-p2C5XB8cu04P8fuMhpjyqEsv74e1eyNRKraBj7YP2AA&oe=6A3FCA2E"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "1135616805161792", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619148_1135616808495125_8615746792926765700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lY6gCh1jAGUQ7kNvwEZj8WB&_nc_oc=Adq3QhPBQSmqQQr55vF-VUdLVcb7OEM6jrAKErrCQ06oIps7m3nq5jP1trDsGtsYFBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eMuXM_Us5gjZvjNbmTZCUoHmWbzVrHjxyG9HwfosuDA&oe=6A3FD671"}, {"file_name": "Artboard \u2013 6.png", "id": "814564234364013", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_814564237697346_1085994346422534066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAbjjpbsIAQQ7kNvwH_y1nd&_nc_oc=AdpucsLO6AnWlpEZelt2WeZA5_6QH7tA6-qXgXm1vko_E7nRLJNYffP5fn9975sLhm8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OSZ1PSLHWGn1dt1gdqsR7Dg6AfpWVzwqr_mUcV-jcUg&oe=6A3FE873"}, {"file_name": "Artboard \u2013 2.png", "id": "789635813561471
12px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_Ktm2bXigwQ7kNvwEBGuUT&_nc_oc=AdplIgbKiNUZ-PlWbmrf_vYDwGFehyrdFw22YZ4JvBw3Lc2TiNtXqQiPJE-aoaJG2fI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELV5qeK1up1fqY0mmz7ccVo3qso27oDGOsAp3wAnm8kA&oe=6A898329"}]}, "id": "1787317635973475", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tObdwa8sPUAQ7kNvwHamkvg&_nc_oc=AdoUyTgdOfu0GxVhB5h2HhUphNwx79nBjYdibKfypa12BGFdbeX7VRwJ0EWEOAO7_40&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAlbDoYhzS3_8EX4Xl_uHOX_hlhB9RNFSfDoUhVS6EiA&oe=6A899D65"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptZC44QXfEwQ7kNvwG2Nt6J&_nc_oc=Adry6ktmzgIKQJQ1jGWHPzrM0WjG09f5DO6oIjTjAE5hVIVN4MwzaKBz_BoLDkHbNYA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDnv99tGcB5MQ-s_BQOp3P69aEm5GlLwzKAADSKoyNIw&oe=6A897C71"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAzuPxQ20o0Q7kNvwG63T6K&_nc_oc=Adpfgh8Nj6YtAxk93xenFcd3wTyXdnGC77mR0w8GakrW9Jo-qia9wMyYRxPvvOllRp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrPEqiIPbKXBDVNF7TMTz4zDBPsfyqeLG7oBoePvcpPQ&oe=6A898C23"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfOlMpxYEokQ7kNvwEolyBG&_nc_oc=Adr6Y3w6SH6wnlyLuzbTbi7hn9XuBzUNhAJmTay2cRI1nnVpjpTO2QS5l3CJhUkX2iU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk8y4S8hUrl5AOWSrG49if57IBCIzqCanO9NFa5Id54w&oe=6A896F8A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRrQ8FNSRT8Q7kNvwFlDeth&_nc_oc=AdoRdvhQIb9UJ4_KAXz6GQWvfh4y5cvgOaB7HrWhcV8kaQ1N_AVjV1gNc75dbm4Dzkw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdGkUF9YnpyXj9IxcYcOiyynco7PvUzGBuXWCuIQjzOA&oe=6A898B1A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n**Use Cases**\nSuitable for education, exhibitions, events, and other scenarios where synchronized playback is required without network access.\n\n**Experience**\nShare important moments with your audience at the exact same time using a QR-based playback system.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}, {"images": {"nodes": [{"file_name": "Artboard \u2013 5.png", "id": "3862485207215612", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618264_3862485213882278_6983363211996585407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWbD6FLnszMQ7kNvwFU-XgS&_nc_oc=AdreEX8MBLHSnD43bBdP_eEH2LATtaoydKfeKjMJclEAVyo5jDdtwLhAKX6F5LVg3Xg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsXscWOQQOD6Mcy3JGt6WIb1rUwDotp8SBx9hF_BPqVA&oe=6A899E2E"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "1135616805161792", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619148_1135616808495125_8615746792926765700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfAh970d9VIQ7kNvwGF7EY7&_nc_oc=AdpANOg4nHrpsBH0M9pLGlolPkxONahOlsyYLRxK7XEfvFxDujBU2iYuE6ri1tCHDkY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbc3ATAFWPCWALvsFwWqzyTIsGqbY_niUsxBoWOpSi0g&oe=6A897231"}, {"file_name": "Artboard \u2013 6.png", "id": "814564234364013", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618274_814564237697346_1085994346422534066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t41lPL_19UQQ7kNvwF7ghJE&_nc_oc=AdrjQUDBlpDwUFoCa9JmJjUR22_LAcv78kLgsD-WWdI7Azh8hmGG9IrTtSCjEcoPsr8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7afB0KJa78NSQvURrEhQZJmNCRa6r23Me3D1sdcq3PA&oe=6A898433"}, {"file_name": "Artboard \u2013 2.png", "id": "789635813561471
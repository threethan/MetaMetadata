12px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxPiup4Hc6gQ7kNvwH4ZkiA&_nc_oc=AdpFesv8ULV0_DffAbuqh5Pzo4x9HyFttCbhMrrUIiMZpwKuoWpzRYv9mpdraM48eFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENxBMFz2MMqbSVPvX8tTpuOqFZq2oUaZg0qZy3dYnymA&oe=6A95D129"}]}, "id": "1787317635973475", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8Q2yVwknnwQ7kNvwFZVpyu&_nc_oc=Adr0sDApiQpswwmOnYIUrX1vzv5xnIm-osRi34gxsGCsD87k-kTOTRZ-_uAZ8N-Vwlc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuUKM_UNMw7QBveE08vpAYRwQ7jRz4pm_nP2FRDS9mjw&oe=6A95B325"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02tswvy8DRMQ7kNvwFU97Y8&_nc_oc=Adq0sL6x02G3WTtZ2bvVPVV50EyJyGnz4pbWHip5SskExRw6V-95tg63PyCKq9dHZDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMjCUsTI5Ge_2CSQYWF-o96FVTAKKvnTlKnFPzWPUszQ&oe=6A95CA71"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3ydw2ynRPcQ7kNvwH6uwCn&_nc_oc=AdrwbM4TBMbMHXDG-0WD1kyW4wCYLIYrIceAm-XfFkbuHME1tTW9mI6CyBr1fiNF9IU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqxL303F0wgBjFYcbIYn14XvkoPwcyGPPoWmwTJtUlzg&oe=6A95DA23"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9Dmo_H-gFwQ7kNvwF-pqGd&_nc_oc=AdrQMfMzzvouXN9VzHVi4gcY71tRVvNPWCGVd3CtZrPHRSyaWJ2fv7nOViZgfWmCmNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGG-IRJkvaXL_EA8J9GaSAktPzpseJ-yXfxAGcRnzjQZA&oe=6A95BD8A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgku1fZlCGgQ7kNvwFgtZIq&_nc_oc=AdrpsqHfMpRfvDp-9xngE9kqnziWzLCXdzUN6mYLMqRbNZ_ywredJ7Jj_q-_OACfVMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbmdCokrOOQB8qExvBtw1sld9Dggyg6R4-J01JK9GFZw&oe=6A95D91A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n**Use Cases**\nSuitable for education, exhibitions, events, and other scenarios where synchronized playback is required without network access.\n\n**Experience**\nShare important moments with your audience at the exact same time using a QR-based playback system.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}, {"images": {"nodes": [{"file_name": "Artboard \u2013 5.png", "id": "3862485207215612", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618264_3862485213882278_6983363211996585407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5iqe2CDnNcQ7kNvwET_Gur&_nc_oc=Adr-o1wdff8X4ohZlcZmXOvnNoGCShFpd_jC13YY6SO_QMkVmLIFkKGnfsRWvC4Prls&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkQ9z7-OMcBpKGb8vqaoWw4bWbPj0hh-p1f6Ru5oiaPg&oe=6A95B3EE"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "1135616805161792", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619148_1135616808495125_8615746792926765700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTpDFtI5q78Q7kNvwF9jZTd&_nc_oc=AdrxaeG9543DaFvU02CLONQy3j9_VdR2tPjKuT0RUhWsOvmsvNcLznEqDyJ0nELr3kE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8DDcdItuMpnurWP2Vx2VJpBkqTSpDxPbBMwo4J13wXg&oe=6A95C031"}, {"file_name": "Artboard \u2013 6.png", "id": "814564234364013", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_814564237697346_1085994346422534066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXuU8lwa2P4Q7kNvwGSaMLN&_nc_oc=Adr-hriwNQr_yFCAdo58e_rAYrqUuQppFb4f4C0muLMNLq4AFa-FztVrl0xdV4u6-dE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJeVdGWAog0ivsrYNoJacnDFE-ClYngJ99Wvud78ZbqA&oe=6A95D233"}, {"file_name": "Artboard \u2013 2.png", "id": "789635813561471
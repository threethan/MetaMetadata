12px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xB-PQitrkoIQ7kNvwGNmZav&_nc_oc=Ado1cx4DJtaBFXnEutjGpg_xzh8yi6tHTC6ylm_DFvPczQ2tVps-C2t7nRUXabc2yts&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk7XpjCdPvz95-7xF0gmjFC5JegF4LM-ZdbczgVCCPzQ&oe=6A5650E9"}]}, "id": "1787317635973475", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQ7DEgtJG3MQ7kNvwHvA1I3&_nc_oc=AdruRWaTV_PU8mKvnwRp_bQUsBJQfYU719dKfypZcXSip0Cefm6TomwCrOCJqBn9qV0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCahEA2yCtWpqOJXrzXfL8OTUa3zpcTugyu0S2Yjqw7pg&oe=6A5632E5"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hi4y8WpqsGUQ7kNvwErCqP9&_nc_oc=AdqFcYxbJxAKJFpO9Fx_3UYGNOn-vpvjL8NtF1_qv_tOcxUlrlySqFZ2Pp9j8DMv-vE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_-EtJcig6ejiaFQKckMHK6hBmoMrUxmylM9To_JQnZw&oe=6A564A31"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WeA5aLppigQ7kNvwEJT1Vw&_nc_oc=AdpSAuZdHLcHz3jh7LIujnNKLerfQKBWwfmQf-4phPsmzr2HYx6Uk2vHLmDG6GEGjZU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx1cyLXRW0ASwc7_5O_--gLv3UkD3KDhL1gPpVjO0OzQ&oe=6A5659E3"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cePoOgsxrU8Q7kNvwElR3Pd&_nc_oc=AdpNr3bWP2Iw3vkOJzziMo47_SG1Oc_A_ViOyjd7vlzQeykB_73opiL0hBkKRIjM_R0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6ZMMIX737sjhYq_plXRnRLlCevtw4BL5gsockh_uwLQ&oe=6A563D4A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1fvZz5VlacQ7kNvwEb7G7b&_nc_oc=AdrA_IRjiL7A8CLYLaPJE1IphZXrdur_wy1zUe1OPEpqTTeudwNRArxy1Uj4UXzUbWA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwNcdgAh9_cN8TXERCFa340baoxR9JvPsWWK5KICY2KA&oe=6A5658DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n**Use Cases**\nSuitable for education, exhibitions, events, and other scenarios where synchronized playback is required without network access.\n\n**Experience**\nShare important moments with your audience at the exact same time using a QR-based playback system.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}, {"images": {"nodes": [{"file_name": "Artboard \u2013 5.png", "id": "3862485207215612", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618264_3862485213882278_6983363211996585407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUG7ItZ7YcoQ7kNvwH5DtOd&_nc_oc=AdqOw26qU1S2fbfeXqoyjkHUkzKj13C7SZvIAX3UW07482EQtr86bh2BSsyIYGLYj9E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUb1SM1IUyet-MJqboD3O-y_V8bfMr4UH9HD_tjFs7BA&oe=6A5633AE"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "1135616805161792", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619148_1135616808495125_8615746792926765700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoeC5ZRi4FMQ7kNvwHLCEiu&_nc_oc=AdoS9M5cVFwEPsSJV_F185LkxcZxAG8MNOol7tH2q0uv6GI3VBaqNQCiR67JGDlusyg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAqayljENDF7B0i8l-BULipmOasA6ddufrf5fsJkR_VA&oe=6A563FF1"}, {"file_name": "Artboard \u2013 6.png", "id": "814564234364013", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618274_814564237697346_1085994346422534066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVmBRk4t0PwQ7kNvwG9WVWB&_nc_oc=Adoev8xhxrSLa8Er9bMRufOccCgUqK0Th8l58Q6-n0VOJwgb2zjvT90d-KsEfAPY5uA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCo-qxhQV3v23B5cl_BZ6SxHtDRT-gVwEA3q1u2NTHjhA&oe=6A5651F3"}, {"file_name": "Artboard \u2013 2.png", "id": "789635813561471
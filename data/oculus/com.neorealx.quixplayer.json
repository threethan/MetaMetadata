12px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odNDcPz_RhYQ7kNvwGcEY01&_nc_oc=AdpoxLv4K5YUya58X_F3Hgu-dmuoHyKIlNTapkflPkxVd2PBFm3b188NRrUd3aKuQbc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8shVan-uO9iSyuv__5AN6SPh1Wlg3vOwh0LNxE3bgmaw&oe=6A452D69"}]}, "id": "1787317635973475", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyfBtdC1hskQ7kNvwGZO3iG&_nc_oc=Adpsb8WUvN5a__BLe0LUVG9pdvKd0JyfYv3WcLcO7_0DZ5D6LJUaH-m0h8eF2szj2r8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VodgfWLiOAtsSU3jTmiIaq6tlCfO28YmFmvGyUwHK8g&oe=6A450F65"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hv5MyGurXM4Q7kNvwF4NEwe&_nc_oc=Adrj0VMs3M3tklhiBg7qoyjmL83l6PHcdkG08jKG-t-ttUxVUblrUQQMGnh_9C0BN9k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kryC5C1DZB0KpyYNltiNluInQaxbV0nw2J4YOMaTcaA&oe=6A4526B1"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ym1bG7Z3g00Q7kNvwEN04ZT&_nc_oc=AdoV5NL99QoD52WqNztVtc9kifWUM0X8RnNrQyPBCUbaStxccqi62z4l1RHBZxGeGhg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hE_AhCBDJWpmWf9NnyxCKW-uG9mK7RGJcUJVKyWXzLA&oe=6A453663"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5GABmZu_akQ7kNvwEAdGi7&_nc_oc=Adqi9UXdEtulrdgGWtuangRWdAu9L5cL-EpUWo0yFK_T7umnj4ikUU0pHwDDKaGGJzI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94G7jxplAqiZViv6z_OdIa01_S1R9pw-paIY_uxhqPyw&oe=6A4519CA"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIioXpUGqtIQ7kNvwHOGPkP&_nc_oc=Adrqn1AI4kExHNINm2MAUiR0h5m8o8WwiOQc_XQOltkYqdBP8sXahDMiXOB6fyGSaik&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af861AzKRLuzeLTBOgYR2GUkbe032Jr4Poarg_tWv0fKdQ&oe=6A45355A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n**Use Cases**\nSuitable for education, exhibitions, events, and other scenarios where synchronized playback is required without network access.\n\n**Experience**\nShare important moments with your audience at the exact same time using a QR-based playback system.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}, {"images": {"nodes": [{"file_name": "Artboard \u2013 5.png", "id": "3862485207215612", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618264_3862485213882278_6983363211996585407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNC0UNHFtCIQ7kNvwFx12Xs&_nc_oc=Adofrf1t60SyNzNnOm5XYrSqpUST0C3a3pHPCNAZ7J02gFGJOxQXOXtL88Ki7IJnFUg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1umzfL63yHx0tThiskCNw8Me9KeteezEXPzaMxWpotw&oe=6A45102E"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "1135616805161792", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619148_1135616808495125_8615746792926765700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2DyC3XvE74Q7kNvwHQark_&_nc_oc=AdpMeo6sil9NgCD2KhsNadKi5KQVcEWuX_TX_H3UOdZLILnu3oo0yGkIoLB7nettZdI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Dg-mknsGP_6WxpS_CQ8DFovh4dbHJK_eX-2b2ERl0YA&oe=6A451C71"}, {"file_name": "Artboard \u2013 6.png", "id": "814564234364013", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618274_814564237697346_1085994346422534066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQKqDB7axKAQ7kNvwHzdPeX&_nc_oc=Adq-j3LAi55Maw5ndb6z7viA-ZpFP07xSpJUTUIxLF2bcRpyB92AEWynTAW_HM7b0uQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NgYgSGpy4D_fYtH_0M_ZIKkb2oOFQtDzlvTTe2RIkYg&oe=6A452E73"}, {"file_name": "Artboard \u2013 2.png", "id": "789635813561471
12px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChMgW135OL8Q7kNvwHNisX-&_nc_oc=Adpx9LHwyIgx5Nwp_sN8p3O7_g7w6rbPa0ylGcxSOZf0zprLY1vY6nmD2_88arSBU6k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKzmXZhOhYQuHJz6hPmPm78CLWQiG2YkQmAIgTx_dj2w&oe=6A58F3E9"}]}, "id": "1787317635973475", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQ7DEgtJG3MQ7kNvwGiR_Uh&_nc_oc=AdpmpGi2zleTYJQClX15uEPGtEmsLSgHD95FRH2CwxJcMDPVMJ4hSsw3Yfhnb-TfXfU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9rHUiFEmwqFIBg64lzYf4YwA9NPuRP_aWk1MMi9CU-Q&oe=6A58D5E5"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peIaKMtycT8Q7kNvwFMNVww&_nc_oc=AdoG9Zz3cf0c2-OwrMgNWD58f38VRQI-po3h3Qk_YWdeZ-czxjHIStK96uyp-sMvx50&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvZgP5XXtk96Oo8lkCJEd7jw1nu9yCMj89mI9YPZuZyg&oe=6A58ED31"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WeA5aLppigQ7kNvwGyEB26&_nc_oc=AdqwIkvp0yIp-tVAowjpzxW5PTQFPaowfxt0Juf74HUXWP8HUWmQ_OhcYrGSxtczSjc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtQTjpLjLnuN2JKivvOMNKlRzG5MabHuAbWmrzO_UiNA&oe=6A58C4A3"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cePoOgsxrU8Q7kNvwFRGETS&_nc_oc=AdpbHaxhFk3s16Xf56FZaltHQ9v99ElyIMY-N71aKZDGPAiPg0QtbDP14JTt5kBDsok&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDx8XBlCnGpwuuKbe-E_twblXym2Z43dZ9KW5FPWsxY9A&oe=6A58E04A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVlpfZ8iwtUQ7kNvwF5X3yx&_nc_oc=Adrneu6YDe_rs4kWc-z821yPD13J1L9VqBsbz-flS6mezMt8syw0S80Yq5rBqXGB27c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBa_rHuFLdb4cwKeugzWZJ_LwVfB2u6TaLoX2_BdQZWBQ&oe=6A58C39A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n**Use Cases**\nSuitable for education, exhibitions, events, and other scenarios where synchronized playback is required without network access.\n\n**Experience**\nShare important moments with your audience at the exact same time using a QR-based playback system.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}, {"images": {"nodes": [{"file_name": "Artboard \u2013 5.png", "id": "3862485207215612", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618264_3862485213882278_6983363211996585407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtO1k74TukwQ7kNvwG5pqHl&_nc_oc=AdpaRc3xXNJiq1BHZ2Z5x58a7jyTGKjxdCEbJ8qtXEtj0jp_hvHv9e_4U5jdEfhRo2w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRfoB1rC0ZAPBrfSJVonq1ZZoiCXTJw5V2ROwk2w9upQ&oe=6A58D6AE"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "1135616805161792", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619148_1135616808495125_8615746792926765700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoeC5ZRi4FMQ7kNvwF7927W&_nc_oc=Adqjo6KViQ5gEbVzNVuRm4QjvF48-rV3OZND9W5BZGPUHAfhzBaTAnhkUDPcOFDaptk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnNfrKrkK6oNfEASSuDdEmH40aRvHnM-ykMjPu4asV3g&oe=6A58E2F1"}, {"file_name": "Artboard \u2013 6.png", "id": "814564234364013", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618274_814564237697346_1085994346422534066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edzf-VkuMrEQ7kNvwHJTk2R&_nc_oc=Adpn8JzMgKG_4YQI4a_5ha012HZ07pjBrg5pIZxawZ60XXGV6VqeP9cPBy2OKgM4wyM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlk12RUGB5qCU042TLbTUNDsLZxaKBJ02F-jbVdSjM0w&oe=6A58F4F3"}, {"file_name": "Artboard \u2013 2.png", "id": "789635813561471
013 f \u2013 1.png", "id": "810326608136812", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622211_810326611470145_537147900053482059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfG7apRcSWwQ7kNvwHC6XFQ&_nc_oc=Adqj_XmMOm8nMsrkHtHCZ9PfK0xtfZgXRQYbRkKwX6p85xCPSJ3FneK_1dxYAstAmc4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bKjWpH_mSblMP_xoyRkLKGRBxWqGuyJshjqOXVJj-yA&oe=6A0729A0"}, {"file_name": "512px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXShv5OEVIkQ7kNvwGMlwvn&_nc_oc=AdoBb_XzwkZEEHhM7JxCQqo24Ed1xCwGJPwnfcimMKO17TKHqRIWlGLNQbEZG29WzE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yfqGZrqCBmhyVbr1sTiLMIF9rO5_VPgs40fW95-vmTg&oe=6A0736E9"}]}, "id": "2604341496584827", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgKxDVLOQEUQ7kNvwGLzYDD&_nc_oc=AdpaAZDRFLkRweLh50BlKcALy5Sg9ToZJ52XvfgxVBvJTLRIruqpjlwfac9zgUjHc0Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aj-gOEX1o-XTSKuAMUyGHDoxyJoIZWl9gUKGvgMc2ag&oe=6A0718E5"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oq_G0fAQnOcQ7kNvwGLn0ra&_nc_oc=AdocmQlUmJItQGbfxUE76yc4HKoPgp8Z4pNnkRZDzYflZY-ktTlrBnKwQSeNr91OkCo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72xIh5rIkaxRLbjX3XHk3g2RvziWQoPuvad7R03I9jYw&oe=6A073031"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVUfQesGHbwQ7kNvwFd8Ixl&_nc_oc=AdpwV56Au7X3wEpSvQaQMTIY7pYNHHjEFU-KROv8yl-s6_11eZELkC4SeikNagHrlZ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69hqM6kzpKrHQA7by0IDPkzy6aT4uBapGoDgceuZOc_A&oe=6A073FE3"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2dwKuvY4HwQ7kNvwHOgr2p&_nc_oc=Adp-Ed8-zqbJwLe7TAJPvB6QDrN49Xp2RxqRFDr0of_PuIUXaL6EkPOb3pg06Zap0KA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51ioc6i4D4--epCja0LSnzynF0SY2wWIpyQpE_HZqxLA&oe=6A07234A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aU_YZrlYWrUQ7kNvwF8PArp&_nc_oc=Adpj7S3hEff4j2Rzkkx0DJNe8-8e2iSidOhooqXt6D7Fn5eXEQLh9cxZjbhQzDXKknM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pk_IhBa51yclYGJRoDo0JwUvpjyayShDTDZgoZGUC7A&oe=6A073EDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "QuixPlayer \u2013 Control 180\u00b0/360\u00b0 Video Playback Easily with QR Codes\n\nQuixPlayer is a VR video player developed for Meta Quest 3/3S. Without relying on a network connection, you can synchronize playback across multiple headsets simply by scanning a QR code.\n\nMain Features\n\t\u2022\tPlayback control without internet: Start playback at the specified timing or condition just by scanning a QR code. Works reliably even in environments with limited connectivity.\n\t\u2022\tSimple operation: No complicated controller actions required\u2014just scan a QR code to begin the experience.\n\t\u2022\tThree playback modes:\n\t1.\tPeriodic Time Sync (SYNC): Example TRG:SYNC:5 \u2192 starts playback at 5-minute intervals based on the headset clock (e.g., 10:30:00).\n\t2.\tRelative Countdown (REL): Example TRG:REL:10 \u2192 starts playback 10 seconds after scanning.\n\t3.\tAbsolute Time (ABS): Example TRG:ABS:110000 \u2192 starts playback at 11:00:00 AM.\n\nQR Code Format\nIn addition to playback timing, QuixPlayer QR codes can specify the video filename, video type (360\u00b0/180\u00b0), and layout mode.\nFormat: TRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={None, SideBySide, OverUnder, SideBySide3D, OverUnder3D}\n\nExamples\n\t1.\tTRG:REL:5?name=Video001&type=360&layout=None \u2192 Plays \u201cVideo001\u201d in 360\u00b0 monoscopic mode 5 seconds after scanning.\n\t2.\tTRG:SYNC:10?name=DemoMovie&type=180&layout=OverUnder3D \u2192 Plays \u201cDemoMovie\u201d in 180\u00b0 over-under 3D mode at 10-minute intervals based on the headset clock.\n\t3.\tTRG:ABS:203000?name=Concert&type=360&layout=Sid", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neorealx.com/QuixPlayer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NeoRealX", "support_website_url": null, "website_url": "https://neorealx.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interact
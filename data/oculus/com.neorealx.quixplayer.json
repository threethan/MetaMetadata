12px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CFrqKEBwIUQ7kNvwGd1Rr9&_nc_oc=AdrFGaqHBZ_MmZMOGa8609Yml-0-i_mZ5kiAo5yR6gQTuz_qb_3Zhdait4AixYqHxbI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTk_n8tb6UJCi0rv5QHQKtW-fC-0PIq7tD8YkC2DVFVw&oe=6A5E39E9"}]}, "id": "1787317635973475", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFEvS6DMJ3gQ7kNvwG_vUGX&_nc_oc=AdqttZq6O54s7mLyVxkMuXzpJj5zzZzoyUlWbFF9Tk2-ReCeKsuiZ_VzVfWzlFsyrVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrIffThp5xpzsPSlRMkONg6e1yznIAJA8tTH0OdPb6ew&oe=6A5E1BE5"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3V1U_eC_aFcQ7kNvwHW4rPT&_nc_oc=AdqHNvyA6L3hjUDHHFHB8c3RONTXEKNr1nUENWXJUkXUE0jF0g-uzF9b37du9d7dCZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSMAYEbc5N0nwhPmWP2zwv3XCZsxpxZTbs1J57gzVbRQ&oe=6A5E3331"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqqRDI8PG0sQ7kNvwHFdIRX&_nc_oc=AdrVfwI_meibf2Z7k2dored5qoItWB_kD4jR156rUH1SFXLEAFNHkOgjWZLv1ThCwKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsOrYTF6zAWNWSyjqcQGslkHtim0XmRbQLLOf7cb3B7g&oe=6A5E0AA3"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZWmnLSuXKQQ7kNvwFSdiiS&_nc_oc=AdqLH6dsPPCokNHz4JaZ8WyVvJXR9fNBsuw6J40jFRPgkt55ZcD7exL2lsOCx49LPI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArLcwwVqASD6hOavgenXP_9l3lOAVgJhssKfWxN5rFeA&oe=6A5E264A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Lo_VS3NUr0Q7kNvwFRUtcF&_nc_oc=AdrwefT7b4rGSIPNuJVlOrSa-3YuewzcWjdJXynxvBvrM7pW0uy1L9n_HFn8zKrq2p0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkpin7nYE36ZugnUPiNM8m69QR_dqPa8ZPS8HpMXwm-w&oe=6A5E099A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n**Use Cases**\nSuitable for education, exhibitions, events, and other scenarios where synchronized playback is required without network access.\n\n**Experience**\nShare important moments with your audience at the exact same time using a QR-based playback system.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}, {"images": {"nodes": [{"file_name": "Artboard \u2013 5.png", "id": "3862485207215612", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_3862485213882278_6983363211996585407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZjKyR9VyBIQ7kNvwEbKUPD&_nc_oc=Adqi7aP3xu1hu7ItHqqwn6MEXqZJ88t3vGnar7WS4rW6IJRmIeE2DTGfD0VzzU-pzNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKi_SQE7y_FoC8lpZrmRXUTe0YZO2er9JXCIxGRy9xrQ&oe=6A5E1CAE"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "1135616805161792", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619148_1135616808495125_8615746792926765700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucNMQga37FwQ7kNvwGt2l-l&_nc_oc=AdrLMuiw9iY5ZAhpV7B_6inj04bi7qrJuM7TlF-mGzjP1Dm6p1Ds3lAcDEL_YNPcpq8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIMSIICr0zVmMju75eeHj0FWQTnvA-H8avIm_F4LVJkQ&oe=6A5E28F1"}, {"file_name": "Artboard \u2013 6.png", "id": "814564234364013", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618274_814564237697346_1085994346422534066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgrIATBXvugQ7kNvwFcq_1V&_nc_oc=AdquonohATLdMMgUzCKL68duRBHORFNea2_2pktYDgEDuR9_wrADW7tI6d0O9kEw8wY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqvCSNRn5kepZdmHkYufyBAwv_nff1eSl1VyPJJaMFYw&oe=6A5E02B3"}, {"file_name": "Artboard \u2013 2.png", "id": "789635813561471
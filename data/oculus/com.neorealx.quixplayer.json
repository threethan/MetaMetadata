12px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xW_g4fsns30Q7kNvwHG1XcR&_nc_oc=Adp72eRI7wDM_DNUDJUMopPfCfyw5BiwsQGPlHV9aFTOs3Eg9-1zeO1iTnvykrr4NIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkKv-rf5nkd3y7Pl1VLvlQTLx1cJYYa_-7yVMbf4c5kw&oe=6A4D1669"}]}, "id": "1787317635973475", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZjSWiITfE4Q7kNvwHmyylE&_nc_oc=Adpv5tLG1gOYx5tld2yOTUbET8mufQcNJoLp0kzJsYQiGAz8DH9FgzG2jKKENEF5aIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpxKaa9WFco3QKQFgPvXjyYx2bUxke64SsnfOMSWrKcQ&oe=6A4CF865"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0uv4fiawKAQ7kNvwHjaibM&_nc_oc=AdqoQfIU17_0dc73IH_0f90Gjk_Bg2amoHLTebAV72bFxLl2WzFLqkQUMEIBa2uNHeI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwfwrWo_VWmgFpFnoCSEFhhSDsTqBjo2iYPrDIglcGJg&oe=6A4D0FB1"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCbhDcVJKj8Q7kNvwH1teMB&_nc_oc=Adq_vEYYbB0JVYfHnBqO75RUnCxPRvcKhmhtvXn_hMaOV_iYJuGZb-QQY4g3tgCm6Yo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBG4Lo5pB5vdllp1M0_HKoZNkFzIsfRFoeqXxJwHKoOxA&oe=6A4D1F63"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InjTPkUriPUQ7kNvwH_p2KY&_nc_oc=AdrSEH0jcjqvzbvDDcpn3vDpeLeo8IHOAf5RYKpLxsM6Qq8f-krEskQlsejapAC-MS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBifXMpaU6qJ2wwICAKVZUNy_7oSjFLK0avptLflrWIxA&oe=6A4D02CA"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZUAZppiYIwQ7kNvwFshne4&_nc_oc=AdpoGI4RiELUQKcWjW_iWHLSeaRFdJ37mh3Jn_T0DMb_rxZT-AWfCiKVnLX2ATSgdoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6lIqyKrFwUDLH38Bx7eXABvG9agtiC4jNb95TzIhuDg&oe=6A4D1E5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n**Use Cases**\nSuitable for education, exhibitions, events, and other scenarios where synchronized playback is required without network access.\n\n**Experience**\nShare important moments with your audience at the exact same time using a QR-based playback system.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}, {"images": {"nodes": [{"file_name": "Artboard \u2013 5.png", "id": "3862485207215612", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_3862485213882278_6983363211996585407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Htge02727BkQ7kNvwG0ucjV&_nc_oc=AdrLH8f9En-cFtIeaUVqXTCowDvTRgL6Zw-MsO2nzcM0CBInLQoi3iFdKrJiSRGQrU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7k25_RnZljdWmv48RXBQsxp05r17sz8H4W3Q96sdn9A&oe=6A4CF92E"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "1135616805161792", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619148_1135616808495125_8615746792926765700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ap_tr8zAp7YQ7kNvwG25l6Z&_nc_oc=AdpOj7_XjdwZaiPyWahJ3FYmwZLkc69nFsS9lXx4CRx8kuUF1RFENkFSoybD51S2wVI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMxem3mcRy3NudBggn6vepDCYB2AFW0qAG2Us2nlZDuQ&oe=6A4D0571"}, {"file_name": "Artboard \u2013 6.png", "id": "814564234364013", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618274_814564237697346_1085994346422534066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98kcIJdpHxAQ7kNvwFIH5Mh&_nc_oc=AdpjL1ISQE8qskCGY5Fcl6287PpdATuqL8JoXqGFW0VFxLwuxG0vChS3cLwRm6xp9RY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdaSlkyhJYTkHf0TBrCo3GdFIsc9vKzvQcmS4jIPG91Q&oe=6A4D1773"}, {"file_name": "Artboard \u2013 2.png", "id": "789635813561471
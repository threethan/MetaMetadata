FhX4Y88M2R0S93Yjr_FPO_dGnUeE0W6U-k0nQ&oe=6AAFD8E5"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3E2Orpu22MQ7kNvwGqj0UD&_nc_oc=Ado6xVISzf221NEIOzvDTRWm_dmVOH0P5assQ-psKIHsFqq7YCtdbHNTngwqx8W-yv4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa1ETQwkY79kaXQ9K_AuDgluiuWx0vNRThV9cC9_XstA&oe=6AAFF031"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxK4DW8WP-gQ7kNvwHnehhL&_nc_oc=AdrJgwLfGvqN1fBuvgssFxgg8H-X3H1iAMrduK0ypdP2jKGV4owHix4XiUPKKWFbPJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS4GK1CdJgMBjj79giXxufdSxnVfPPO7bokXIbC5uXGw&oe=6AAFFFE3"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TP1583dyBesQ7kNvwHSi-3o&_nc_oc=AdqmkRRCbIM6IzlgjFbeRXANgvGDLLsAvbo_x8AnV01MsGIK0W6v5sCli5BP3a_8W54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0qJxIX1NOgoWot7NMBGqZ8Fewgx2_pDLjcirMACpSUg&oe=6AAFE34A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOISc7OPZU4Q7kNvwHXe0wX&_nc_oc=AdrWpVgdY7_B9A2OSWHX8f1nE07oNq7IR824k-hcs-q6yrUhv2ULT2TD788mrD6UCgQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIcdKyPMV28gASxUqX-3OlpXxn0aeUftnfBlipGUwpXA&oe=6AAFFEDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n## License\nThe Store price covers personal, non-commercial use only. Any organizational or commercial use\u2014including events, training, facility operations, or customer experiences\u2014requires a commercial license. Contact NeoRealX before purchase for pricing by use, devices, and duration.\n*Applies to purchases on or after Aug 28, 2026.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neorealx.com/QuixPlayer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NeoRealX", "support_website_url": null, "website_url": "https://neorealx.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
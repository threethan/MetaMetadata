0a&_nc_ohc=tY13Yjw6mwgQ7kNvwEuPZM7&_nc_oc=Adp90f_1ZkDTNdhjHVUbAcYANATFnjakpPy3n5i6aKA0wYL3_PHhsNJB3Zaqwb8GFlE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnlp647ZiJSck9D68iMtk89VcbRXWZqmTqGUB-UMeiSQ&oe=6AE4B2E9"}]}, "id": "2604341496584827", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQQRcc65Cv0Q7kNvwENBSuF&_nc_oc=Adrf8Mr0K3FK3J4YPZtRz4uD6TiAMoAvlc4dXLYflfU4gS-hQb3O7UT8U0Mo2-mm4fg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSCwcBEfXj__MopfEB44AYIr2epQWGCbxcW3i7nejwhQ&oe=6AE494E5"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUU9jgJ7sBgQ7kNvwEjlnOH&_nc_oc=AdoD84Mxowc9Jx0w5MhmeYC_2qLLIuPGthKkswW7f23DTKMGsLS_N2K0VdIuyg1ajmE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfcG5ry33Hn4GcUJX2OOXZpsOSkN3s5HiCroDRLQAxoQ&oe=6AE4AC31"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G68txJierRgQ7kNvwFj1Ez1&_nc_oc=Adqg4doMJ_c7zW3PosZ_JmW6oJHXlhQHmN3SrMdk0yyknJ7YcD9je2Gzhzjq_U4ISwE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH3wZPruq2GSknSQAP2S-oGB7w2aOnikUjP1DoVRg6_g&oe=6AE4BBE3"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srWem30Uf4MQ7kNvwGTXACb&_nc_oc=Adpza9LNaCIj3PnC7wsXW3OtYv9S2uFImUocVHywZsrCGnYEYGLYhVMnpEYghuadhoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsGyvmVVJw7WnUs1bgvgZHpoBhD8onJMafARMMKspopg&oe=6AE49F4A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIrNt7pFlJIQ7kNvwGiUr-U&_nc_oc=AdoJ0oUxd2Q9u4etvtBfIV4VseS8ur16WzLTrkAzjByb-k0vdzYx6t874w9RGoO2xzk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOazujYZQEz_YixRcepN7Of5eJCzdSVzzOV3PFtGN0pyA&oe=6AE4BADA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "QuixPlayer \u2013 Control 180\u00b0/360\u00b0 Video Playback Easily with QR Codes\n\nQuixPlayer is a VR video player developed for Meta Quest 3/3S. Without relying on a network connection, you can synchronize playback across multiple headsets simply by scanning a QR code.\n\nMain Features\n\t\u2022\tPlayback control without internet: Start playback at the specified timing or condition just by scanning a QR code. Works reliably even in environments with limited connectivity.\n\t\u2022\tSimple operation: No complicated controller actions required\u2014just scan a QR code to begin the experience.\n\t\u2022\tThree playback modes:\n\t1.\tPeriodic Time Sync (SYNC): Example TRG:SYNC:5 \u2192 starts playback at 5-minute intervals based on the headset clock (e.g., 10:30:00).\n\t2.\tRelative Countdown (REL): Example TRG:REL:10 \u2192 starts playback 10 seconds after scanning.\n\t3.\tAbsolute Time (ABS): Example TRG:ABS:110000 \u2192 starts playback at 11:00:00 AM.\n\nQR Code Format\nIn addition to playback timing, QuixPlayer QR codes can specify the video filename, video type (360\u00b0/180\u00b0), and layout mode.\nFormat: TRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={None, SideBySide, OverUnder, SideBySide3D, OverUnder3D}\n\nExamples\n\t1.\tTRG:REL:5?name=Video001&type=360&layout=None \u2192 Plays \u201cVideo001\u201d in 360\u00b0 monoscopic mode 5 seconds after scanning.\n\t2.\tTRG:SYNC:10?name=DemoMovie&type=180&layout=OverUnder3D \u2192 Plays \u201cDemoMovie\u201d in 180\u00b0 over-under 3D mode at 10-minute intervals based on the headset clock.\n\t3.\tTRG:ABS:203000?name=Concert&type=360&layout=Sid", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neorealx.com/QuixPlayer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NeoRealX", "support_website_url": null, "website_url": "https://neorealx.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25295327580054127"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1160843999233625"}]}, "baseline_offer": {"id": "1160843999233625"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1758506100, "status": "PUBLISHED", "id": "1160843999233625"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28051490567771134", "version": "2.1"}, "id": "1494108852005209", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application":
013 f \u2013 1.png", "id": "810326608136812", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622211_810326611470145_537147900053482059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVuCKLivuF8Q7kNvwF3oO46&_nc_oc=AdpztflLYUNh634A23mJy7-RPuVfEMir8PweBi2lwoEMpyuxi5kh1LbkP8sx9S8ZzCs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-PLZuNpmKi0zIea5TckNgdpBRX3dNpmwNImtt78ZOog&oe=6A1458A0"}, {"file_name": "512px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5qmCpjm1ZMQ7kNvwGW504s&_nc_oc=AdrHBRez0KjUDr2SE1oBwkqK1heacoNd5yngAdQ6gGCOhByPJ2oFHu1c4KWBPcRHAl0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z4W3cPyFe8JrrZoNMSsNTS4DNt4EGGPyImF2p-qcwPA&oe=6A1465E9"}]}, "id": "2604341496584827", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkfW0YnTg4gQ7kNvwFcLXOt&_nc_oc=Ado4ZbdVPySVq9rIwlq9SW4V6bQdE4pCOtZfCLfq_jhP8KOFmU2CLJR8XC6gWilgRic&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rsFR-Rla8yLeYE8UrQJrzm60gmyaXE9sQD1uKOP4asw&oe=6A1447E5"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAYieWt3qYAQ7kNvwHj1UL6&_nc_oc=AdpZViaIdKPJ-hc2G08oU09Jj8Vr61l9nrotBhFzTsW2nvox0VQMeLIzzcal5JgndIM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c4kNY9w3PRwM-e1WW45mZD5kyAnrnql_-ea8k4eLJaA&oe=6A145F31"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWIEBiKeiN8Q7kNvwEn2NT_&_nc_oc=AdpU7BkcuSGtdsx9CuhJGTdlPhw3nR3e3_6sVhGA2Lo4OwTR8pGZsp5pbamoLMEVIOM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rk-iuKxHC5gv844BhbvukETYQc_pQfxWKNQT3zjg9gg&oe=6A146EE3"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C89QBW-2gO4Q7kNvwEmqo56&_nc_oc=Adq5tSso087juR3FP4ZwAuiJq0InDnOUIEkPJmjIAnCvwI8Uq8d70xSserabx830A6o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tqCJDuftvHqH5ez0nK0_JpcfIhKo9i12ERf__zD-0UA&oe=6A14524A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58HT8uZHrB8Q7kNvwF0Ml1X&_nc_oc=AdqAsyQB53AcYqaMZhuTYQaJOFy8E-IwdeRUX7O7zk0FNr7eUYhGx9VeAcKWnKO4BGk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af727EQJLzs1CjjOgYP1D2nSKd7D0fvZu6tVgwsfhID2CQ&oe=6A146DDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "QuixPlayer \u2013 Control 180\u00b0/360\u00b0 Video Playback Easily with QR Codes\n\nQuixPlayer is a VR video player developed for Meta Quest 3/3S. Without relying on a network connection, you can synchronize playback across multiple headsets simply by scanning a QR code.\n\nMain Features\n\t\u2022\tPlayback control without internet: Start playback at the specified timing or condition just by scanning a QR code. Works reliably even in environments with limited connectivity.\n\t\u2022\tSimple operation: No complicated controller actions required\u2014just scan a QR code to begin the experience.\n\t\u2022\tThree playback modes:\n\t1.\tPeriodic Time Sync (SYNC): Example TRG:SYNC:5 \u2192 starts playback at 5-minute intervals based on the headset clock (e.g., 10:30:00).\n\t2.\tRelative Countdown (REL): Example TRG:REL:10 \u2192 starts playback 10 seconds after scanning.\n\t3.\tAbsolute Time (ABS): Example TRG:ABS:110000 \u2192 starts playback at 11:00:00 AM.\n\nQR Code Format\nIn addition to playback timing, QuixPlayer QR codes can specify the video filename, video type (360\u00b0/180\u00b0), and layout mode.\nFormat: TRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={None, SideBySide, OverUnder, SideBySide3D, OverUnder3D}\n\nExamples\n\t1.\tTRG:REL:5?name=Video001&type=360&layout=None \u2192 Plays \u201cVideo001\u201d in 360\u00b0 monoscopic mode 5 seconds after scanning.\n\t2.\tTRG:SYNC:10?name=DemoMovie&type=180&layout=OverUnder3D \u2192 Plays \u201cDemoMovie\u201d in 180\u00b0 over-under 3D mode at 10-minute intervals based on the headset clock.\n\t3.\tTRG:ABS:203000?name=Concert&type=360&layout=Sid", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neorealx.com/QuixPlayer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NeoRealX", "support_website_url": null, "website_url": "https://neorealx.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interact
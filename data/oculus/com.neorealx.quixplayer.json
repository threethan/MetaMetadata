12px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_Ktm2bXigwQ7kNvwF2YcaR&_nc_oc=AdqVujTREycdBa-fHE4mKv_CSrLDXWqlMNwtMse2cu1b3ovfQNHIJHJGx7r2bCxa2ds&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8QsNawor5zg6jzoG68EwRFZtuml6yq4ne05Nk1pNDEQ&oe=6A86E029"}]}, "id": "1787317635973475", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJD2GYmi6V0Q7kNvwFHkTll&_nc_oc=AdoJWuD3C1LIX7w7fbPyvI_tD16pVnubuwE8McrHfoq2tnnTgQ-f9OOtuLgthV3Sa9M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExgmDXBa1E2MofyytbWvREOb8Cpan_ugUZFn_FbwiTuQ&oe=6A86FA65"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Bi2uYpNO-oQ7kNvwEg-f8y&_nc_oc=AdpBjqo-IAP0KuGFT6JQvtEPiDAkKfGhFUvxFMYdiVXR1chqLDjXpnnMjF0GpIOOy5A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOMFTyf4K_ps5ANz7uzbQhrEvwfUk3I-8NCxP8z-B8Xw&oe=6A86D971"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUGZN7EWBvUQ7kNvwFBp8D0&_nc_oc=AdooGLBHqTgivecR4LJNeH1T55KqZIYo_ujWEklSvKmEtiKLaR_ZIj51K4KHXEvrQOQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERGfrTFWHBf3_Ll11B3nSrA45lfyQovGUr7mJ_p_slSw&oe=6A86E923"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzh2NKnvnRwQ7kNvwE2rZyl&_nc_oc=AdqGdJFGfjjLRPLvqbPJ4ICkNFAclGvtpTcpgPTPwIBBpRCVh3fTk4VVTbjRG7B1bw8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxkraCsG_pP11zH1iD3ysp3wpr8NOHaCzLoqndtlNHyA&oe=6A86CC8A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRrQ8FNSRT8Q7kNvwH2SdCy&_nc_oc=AdovVXk06-Ii1fP0QpQMHCKUxY000bACVoA9r_tfTTGt6RQEyXBD4TlHoi15YyugvBQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnbFoN2EzNx5Bp5Am_oyaYKRRdVan1x9mpuXk6QqwW7Q&oe=6A86E81A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n**Use Cases**\nSuitable for education, exhibitions, events, and other scenarios where synchronized playback is required without network access.\n\n**Experience**\nShare important moments with your audience at the exact same time using a QR-based playback system.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}, {"images": {"nodes": [{"file_name": "Artboard \u2013 5.png", "id": "3862485207215612", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618264_3862485213882278_6983363211996585407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwsXqOWh8ZoQ7kNvwGeq655&_nc_oc=Adq93gSajsMXuVoM9lxCoEriG2sYOOuCXPIuTiPyA62b57OJOeB06aLrtgEr_MBieCQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoh5PiPlo51-GYpMGEZVPtypdtnSxUzSamZpeFXJVY7w&oe=6A86FB2E"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "1135616805161792", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619148_1135616808495125_8615746792926765700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqOSzTFN9UcQ7kNvwGpBBtq&_nc_oc=AdpymhqA-4IhO3TTWImnnIes5GlKS0GHxa5fje9GSuQ4nwbURL-_P354kYShZqNFCww&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWKJBqCzOnty_aY3yN8JA7p80nj-suwTJJb14JO-L94Q&oe=6A86CF31"}, {"file_name": "Artboard \u2013 6.png", "id": "814564234364013", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618274_814564237697346_1085994346422534066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t41lPL_19UQQ7kNvwED-PbA&_nc_oc=Ado6uzmDlkT_3z57-1R3Gf2FwKaxbU-Ujiphj25726MBOQv9z5Zvy8RZp8NHqo6Wgf0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ7lOGfebEpYFEIKGuyaFly0PzgkB7MsQEeShJmkqxuQ&oe=6A86E133"}, {"file_name": "Artboard \u2013 2.png", "id": "789635813561471
tSoNekJdyS3n9-NE_9tZRaLwIp50TGrbDx5PA&oe=6ABBB665"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3mbJEpA-pgQ7kNvwFW02m3&_nc_oc=AdpBQp1YCCy2unPqXH04pWHoWg8wG5N7YzC9xdZ3_52fiWtaehn_nRqdxohgiBaDh8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIZ5qvFNZvjo-arl-fW5SR7M8ndizuhh3yAnbjyTGOKA&oe=6ABBCDB1"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7IIXz1O35kQ7kNvwHkYt4M&_nc_oc=AdoM0qb-BdBvn_1kqUePYP1u20TQIp8tbNAmqWQvFaVeObTd1POZ5Y7Io6t5ZUBc-b0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkr-ncxvF8QOI34vZbnPY260Q8fx2WHx1_0JnTzmjeSw&oe=6ABBDD63"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2ao3-lveFgQ7kNvwEolrCh&_nc_oc=AdqAhnJdQenFHFwvWgxWbkvpxn4YEIB9wIDq-KIenr5t1AKxsIT9CYCWT1VoR5-Hr1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ70dWx8JEIS3f81tOpVpWdtk15EGFeS_KIW-V-iG0i6w&oe=6ABBC0CA"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fICzLG7o3A8Q7kNvwFzVmqh&_nc_oc=AdoZLvQS6ArXvyL8hyQQCPujOClXjRaVKpDyaj6esOCUe2eXqc0fSCVROfdDVg65EeE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQZNH-ur8TJIDoE1mOvMPKw0hA6Y6pGmd9SbeJbKEeng&oe=6ABBDC5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n## License\nThe Store price covers personal, non-commercial use only. Any organizational or commercial use\u2014including events, training, facility operations, or customer experiences\u2014requires a commercial license. Contact NeoRealX before purchase for pricing by use, devices, and duration.\n*Applies to purchases on or after Aug 28, 2026.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neorealx.com/QuixPlayer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NeoRealX", "support_website_url": null, "website_url": "https://neorealx.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
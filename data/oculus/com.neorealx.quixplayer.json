12px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xW_g4fsns30Q7kNvwEFbuu5&_nc_oc=AdrKXt5RXBlRd3DIATSLQVEUwJphX24FvviwnbiGeMM92knEM-RMmS432iQ8KnX7E-I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALmJ5AJc84YyPiifD_4OW7mbJAfwd-diEB5u6NBUYwLw&oe=6A4BC4E9"}]}, "id": "1787317635973475", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZjSWiITfE4Q7kNvwGiu4NL&_nc_oc=AdqDEHZARG69yxJeMOxvhZfMaxEqqQb7hJ12zPpNy2pamH6AEqE9HVnSgdLLVIV7-Bk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUzvi9qYxpfOxXkIFM0mur7iIZFYtT306Gj3ucqfc-Tw&oe=6A4BA6E5"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ukrv9N_ylREQ7kNvwGmUPFZ&_nc_oc=AdqO-M_sj3_q2tmQZOTcJVkGIz43lLxa9SyFxiOfHb5UI9nAawvYu4eCRu1bGXjR6oo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHdqb-9q63l-CHqUP22QgAM3kaaNVvWAWBMqKrI9LC8g&oe=6A4BBE31"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCbhDcVJKj8Q7kNvwF-TX5Z&_nc_oc=Ado5rAF3m6IQS4PPy_BtkXnYdcjUMdHlBkGoMICqtfNqAxJdXf7SVV1ym3S-UEJsgDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtchM6LJJDNQjx7q7OQ0zAzkgtiLrfqA5OcuFWQ4k0Rw&oe=6A4BCDE3"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InjTPkUriPUQ7kNvwFE8LJn&_nc_oc=Adp9GjFWyhQw-yrus7BsvZIAaF1eXavmpw48RSVE5lefx-pNIxph1GRGdsOArXPW3eE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMKXLrFeN5XtheP82POvWVG7X9cwgKqVcJmHngmR7vqw&oe=6A4BB14A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZUAZppiYIwQ7kNvwFcqiuz&_nc_oc=AdqrWfZwD6B_vXTAGjcSjI_rK9tvXu8BGgu9cuVlMpjMPO9kyArh-YxPSDRGIOjVIAY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCh9tLxviqnyXok-8V89ubQ0B6XNzUYkXCbXfUIW05wQQ&oe=6A4BCCDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n**Use Cases**\nSuitable for education, exhibitions, events, and other scenarios where synchronized playback is required without network access.\n\n**Experience**\nShare important moments with your audience at the exact same time using a QR-based playback system.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}, {"images": {"nodes": [{"file_name": "Artboard \u2013 5.png", "id": "3862485207215612", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_3862485213882278_6983363211996585407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs9B9qVZmTUQ7kNvwG3xGIj&_nc_oc=Adqx4lanFE6qh6HW8_ilpbMklqV2DSLRJ4aENiJghuypNRtSo4TF4f1ohUpdWIu3fA0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZIqbLXj1-vgr9aBeoqhxbMcF9C2dDNfu7P0GQOAmHCg&oe=6A4BA7AE"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "1135616805161792", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619148_1135616808495125_8615746792926765700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ap_tr8zAp7YQ7kNvwGRQyYL&_nc_oc=AdrA0mBn5Zl-ZTN0DR1z8W69W5NtCkBm4xOl6JHU5u1C0Sl-Uw15GwNoLFcH3PY-GbU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBepPhtsL0SX0VQlZ6tMOxBMASGnf9FtI6CITzz_WMwbw&oe=6A4BB3F1"}, {"file_name": "Artboard \u2013 6.png", "id": "814564234364013", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618274_814564237697346_1085994346422534066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98kcIJdpHxAQ7kNvwHCi5L6&_nc_oc=AdqsBLAnwXLjqYDsSNH_m-70Y1hDwXflT76PLTTXAfkM53zbh29ZzVyEC73hFdn8abQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcpF4b_7zstL5nBkrnEl2yGrn3rNutqEv-1URD25_WQQ&oe=6A4BC5F3"}, {"file_name": "Artboard \u2013 2.png", "id": "789635813561471
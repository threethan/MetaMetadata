12px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6H5mvGd5RIQ7kNvwGKvF40&_nc_oc=AdpE1Ank2F9-XtOiS40cer7bNdnlrl968aQDHbLpQc4-6MuA1wPPAZMmRujhDWypk9k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgCYEv9vYZd1AiN4ATxroi5-gIB4jXD-QnpzfoBiZe0Q&oe=6A79B129"}]}, "id": "1787317635973475", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IggELtHfKgEQ7kNvwGhpBXd&_nc_oc=AdoqGVDaNca-NJOKMeLZ_U7mFnrYbzG31xQCpV6T3qWQ2D-HsDW5qhTUdzeVWI8BB-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDNSTEliffr_GJjdLZJNnOBNidj5zAY8oNhQgg-yBxYg&oe=6A79CB65"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SleXkNY-9cQQ7kNvwFcojRL&_nc_oc=Adp0Nky5FGJ3bwluTx1bPX9wxI4Z1VpUwn_ZHLpvP6d-EXoNZ3azdAbBZZzg8tTqGsU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0ojGBRYPDy9dNMW8532gOv86c9lUDfnZ7-ZToqzy76g&oe=6A79E2B1"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EQyV62fwSEQ7kNvwFQ7f85&_nc_oc=Ado5XsGvLD2pAZJhiaBCm5jxmfeRtsMREnze1QcoszTglOTG13EhE6TbjEHSt3u_NkI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXQwAsz-6uvGyLVRjLHsIS5WhJPXKjGAJJAjNd09fRYA&oe=6A79BA23"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jM9vGvvLLIIQ7kNvwEBkYQl&_nc_oc=AdoqvkBBUEWutCW_9u4BVcjEBK6pbJV4U4sYQnMEiqajgSHAIKgd-AjpuIG8VPVUUpw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFyWZggJITjD9sNW8E0zOJ3KSwQ5ryPfsDNpxPRXLK8A&oe=6A79D5CA"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-sGRWiZeSAQ7kNvwEbKWbn&_nc_oc=Adri5Dq83s6M-DtQGOcQCbeZgEP_JVDlHWZVLPKrTeAxrxk6ua_aTkW0ngbTJZ6CZPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXBbGaSxjHilzELbZBoWs1M19PrMOhoh068Go0ijLq3w&oe=6A79B91A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n**Use Cases**\nSuitable for education, exhibitions, events, and other scenarios where synchronized playback is required without network access.\n\n**Experience**\nShare important moments with your audience at the exact same time using a QR-based playback system.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}, {"images": {"nodes": [{"file_name": "Artboard \u2013 5.png", "id": "3862485207215612", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_3862485213882278_6983363211996585407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LI5GVbuaQrUQ7kNvwEkoYk8&_nc_oc=Adru9zEaq-msMSbgrEGKIHubx70_CQ17QeClGELopjVByocQmK0r__zejNCa5IRll0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd2d--yXli_-6HbdpG-v08XadXBpDts2HNWSmmik8q-Q&oe=6A79CC2E"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "1135616805161792", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619148_1135616808495125_8615746792926765700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlnvtTpsg0cQ7kNvwFKWd_b&_nc_oc=AdreAHq1Zg1kWRpA81S3lQ83ovI_J6B-w5wLulR-zbZ7XbPi8SB2hWWZRgKv-UxM24k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEI0OC5iifJAIIw2vgCOYgjKpUFh7m0BxuzQKp__ryGdA&oe=6A79D871"}, {"file_name": "Artboard \u2013 6.png", "id": "814564234364013", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618274_814564237697346_1085994346422534066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fj-pV_oJq_YQ7kNvwE9iWYI&_nc_oc=AdpZoJxMvvx3xiOIT5tjpHyWLlAFkdzo-YcABqX5BIZwR-sEV970gw4Xmpk7uktKMzA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8vUC7dayTWD3KMKAJ2BVMMUTVaarQRAOuXvbAEdsVMQ&oe=6A79B233"}, {"file_name": "Artboard \u2013 2.png", "id": "789635813561471
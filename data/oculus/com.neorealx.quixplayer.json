ame": "512px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLsOvt9w-XUQ7kNvwHotCD4&_nc_oc=Adpbspr3BeejuLQ8mr4O5p5q8bgXkfiokEwf-zv2TQofwf9b88skEbVvhvHp6jhH_nQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrjE2EFq7IzEn6Kax1ypS1jHFM6_hqoEqrQ4NsM5UOjA&oe=6A8D77A9"}]}, "id": "1787317635973475", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUscO7rNqEUQ7kNvwGEIVH1&_nc_oc=Adop6LZfhWHjQKj4rSFOzSx0Iq4hMbLTfNy0ut_1u3_mQ-Y88Jpxd5ec1UWVCtzKvjI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsJaMvECmKi43GTVvV3aM1FBn_oJUDSEimNrOyn5zbxA&oe=6A8D91E5"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmCE6GdNSxMQ7kNvwFwLbOP&_nc_oc=AdodLMajzEwBU3Et-DHQ4UyqYxFASvlftSc2HjNg7VJCZaq1VLj-fCo31VqvoeJ7Ym4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcvkEIG7n5_0Ac0NleNk5SAjiJ2Gg-kISz_W-JDawQVw&oe=6A8D70F1"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMfaHsS0S3MQ7kNvwHEGsCw&_nc_oc=Adob1IYCvcQ3ME0hAZ7yVBWtmmvPOFKFWzIzlsU3hcQ9ffuM9A05JnTT5SDbOnyTdxY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCxsgDcKR5VbIDRpcbN3iy_cwsDbJ8CbD96vgg2sdkUg&oe=6A8D80A3"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSKgMbKT3Z4Q7kNvwE8XHC1&_nc_oc=AdpCpVa57xt14MVatAAJL0eLk-AvfIjBexdwenwW3c07ZAFgCEyHzYORbc8y8uZBaEE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEp80jr0fo3nA9PyDdJD4kJbUtRcqXITFFyM4g4D8cDUQ&oe=6A8D640A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izQUi3rf_hgQ7kNvwEDHSQ1&_nc_oc=AdrVBu4VMnQN1VA6FJ51F8hOTVk5y4OaLOkM2tHCoAvvKAB54hxxnjuF6k4LeP1rj64&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6TigoxsWaJB-tnyb3BW6GaUQ9-7dLhJNth16F5XJhxA&oe=6A8D7F9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n**Use Cases**\nSuitable for education, exhibitions, events, and other scenarios where synchronized playback is required without network access.\n\n**Experience**\nShare important moments with your audience at the exact same time using a QR-based playback system.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}, {"images": {"nodes": [{"file_name": "Artboard \u2013 5.png", "id": "3862485207215612", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618264_3862485213882278_6983363211996585407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWzKvxSEbEEQ7kNvwEdWAox&_nc_oc=AdprHJFcsPO-Q9drW76ZxwhE3vEtZ6_DKb3Hhs40B1q8U_BjAVQhFD_3rdbPO5qF1zs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJaxKR2Vc0qH_3IRjutx5d7_bloqNSp12T_wIUu_rUxQ&oe=6A8D92AE"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "1135616805161792", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619148_1135616808495125_8615746792926765700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXNJT9EDsbIQ7kNvwGyrqkW&_nc_oc=AdqfiiwpBgp8MM2KdGrTIuAzqFq0_OUGENRIab6-PrGiIcOlElj971z7QDGll2TGB1o&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG85ZQUQPsz9j5JuRCTr78F1Imw3-5CMfKfw2VCasZEHA&oe=6A8D66B1"}, {"file_name": "Artboard \u2013 6.png", "id": "814564234364013", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618274_814564237697346_1085994346422534066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOHE2Yn_UewQ7kNvwEqr9dG&_nc_oc=Adr3A45fI1VD5mAL44pYYHtAdVqM3cgouvkCC4phU6IUsYFt_Y-z-coP76plpefPn0A&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7cnaLWjR5WnMuHmmN5z9f3OGWsguh4ZIcNO6WnADBeg&oe=6A8D78B3"}, {"file_name": "Artboard \u2013 2.png", "i
12px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0l_cXTHFGQ0Q7kNvwH-cOSO&_nc_oc=AdoyftkpHIRKT4-HBx3mKxiiSsSM-GdFbIeuZdPqY0Fh-mZAC2MaC2Y8FC6b5HxTO1g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQD5uCQbRGNPLJxTryF1rEMnUU6W9J1CHfCohi7I9P-g&oe=6A8048A9"}]}, "id": "1787317635973475", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEBjQ5LhBLMQ7kNvwFbSpFJ&_nc_oc=AdqDZGpVwa9BRNeZooT3PlTsma_7nsSoOopSO8OcJ_GPIIvModBz5KaWCfYD8R52-iE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA-vao3_KD_e_V6gKjlMTmHj_DZaR75adIfKyYtWWS5Q&oe=6A8062E5"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1kLhczfJv4Q7kNvwG02Yai&_nc_oc=AdoN4o-XI5MTEYdG2gJ_ju7vOHq8AvZMQoEIPgmuFaHzdUAOzsLFAn0kg3AVfAb3NdA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGXz3UrNAtI-Ylnl3xpwvyCuPM-QaFOXOjY-vPT5kDjw&oe=6A8041F1"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJnJfQSZWJsQ7kNvwFze2DX&_nc_oc=AdrxT0fmltR3dnHrws8Ox8Qa8LNl5049lKrMMuIFtk3Bkc5CyL3rOd3gZlXwDqcOMDE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFinYv0ccBnb3v2MzSTnnIaYFgoCkMkTxL-OrWgkJW3Cw&oe=6A8051A3"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eF1Wj9QBGAcQ7kNvwGu5Q2V&_nc_oc=AdpSAThlLKyKLU4QjyWAG2qotoJut_naqka62wd9GIL6MsqqSDIkCdrvVLc3wRoedOg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj905GAkvvXW1OWJFzu4v7Pb3NWKUD_MdOxKOXToRV7A&oe=6A806D4A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hq-sd5VbE08Q7kNvwGVwKjT&_nc_oc=AdolVnSa4SqT0jXgQN6IqTCOCb8BUPP4cAOVbUZ1_5bgeh_9N12TlXdoFfhIo_3NUPg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5Df9C-wdq46UbtIJsq3GV2rlAYU1UzJ2tjALJz2GI2Q&oe=6A80509A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n**Use Cases**\nSuitable for education, exhibitions, events, and other scenarios where synchronized playback is required without network access.\n\n**Experience**\nShare important moments with your audience at the exact same time using a QR-based playback system.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}, {"images": {"nodes": [{"file_name": "Artboard \u2013 5.png", "id": "3862485207215612", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618264_3862485213882278_6983363211996585407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W67tMXUTVVUQ7kNvwH-dRGQ&_nc_oc=Adou7XePykKU3gyMfKF7wobgTNGeDZMeoaGSMu1qHS_CFVFZGJvHzwYoIPMZE83xJgY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCoAaCLEpXvrYvhtEDlZN1UZoBgUjgwRr5LjOTAKN0jQ&oe=6A8063AE"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "1135616805161792", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619148_1135616808495125_8615746792926765700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkAN48MicJ4Q7kNvwH6vraf&_nc_oc=AdpEHPn_DjB84UWcBtpqoYjdkNyUI3w0tHeamRcSWYFS1z0c7ObrYX7aUpc-OLzRc-o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFv-1M3o4dDCnIxPD00ZEtIfmpi5nhRRh703mWPh26hcg&oe=6A806FF1"}, {"file_name": "Artboard \u2013 6.png", "id": "814564234364013", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618274_814564237697346_1085994346422534066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUW3YfYr5eAQ7kNvwHS_FNt&_nc_oc=AdosWmabNoUSWDSPJ1kbaZxxXRVCwG7iveuj6uBafVQ3vZRiUhJQQdB9MNC_0Bbk0Sk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtnCxsOY3uw4DF3pVDP7HYjC0tW9yeccXtnJJkpiC2KA&oe=6A8049B3"}, {"file_name": "Artboard \u2013 2.png", "id": "789635813561471
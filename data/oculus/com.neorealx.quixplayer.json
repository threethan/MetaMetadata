12px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZB-BJELhIOIQ7kNvwHwBYJC&_nc_oc=AdrWkjFiBsQVecICl53pv-YABZ-BZUb94fa68i1Zr93YeNtm-PNzH9W1q3tXiMJh9VM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCB_H3Lk-_hHwMa0bMltdFy-YcRlt3XQnQQNacHnboY0Q&oe=6A6CBA69"}]}, "id": "1787317635973475", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyHxB13X5f0Q7kNvwGJscIX&_nc_oc=AdqM2zHj67Lb8ECpK-m_ovD_kbemqGHamJZxRr4oIIZkeU1x9smtwgvOosYu_xuEp2g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZSgx-L_ExMpmoQbKAadppeyqsswHaZaYebQTAktX5-g&oe=6A6C9C65"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tq_3j_LVrEQ7kNvwFc908G&_nc_oc=Adr6l5zGU5JFsmlM99FHx5ppcK3qCX3159dWVM7JPE-kLaMkgiggUAz7eDdUbVRYv0I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzUyXCEI-1y13N7gR0DCAFx9SY0dCloiYA8evj04t6Jw&oe=6A6CB3B1"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXM5Ii9HGF4Q7kNvwHSRXa7&_nc_oc=AdqQRsSzwxL3znmDHwrDlRan1qiuzSk20oIdLMZPE9F-7zyga7bBXnMcc_WDcjL9SxU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjj5T6Cd1YEkKTRb2LX2jHp05ZoNpwOn-GourMVxnWtg&oe=6A6C8B23"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lwer0OKSrkQ7kNvwE41AOs&_nc_oc=Ado5T99eac1pHtNcAyChhlHg5tADa1Li3dvaS9DECZVyfbiFgEAHnQNHsZcenyJ_aLM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABImizZ_TMrox7aY7vvCJuz0_WUrVEywDxar83_N6X_A&oe=6A6CA6CA"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0Ri77_yXNEQ7kNvwEmSn7E&_nc_oc=Ado5mKvDv25N3n5eBAU7j30HRwHzczBSlDPHyUb4JGObFxmR47obeMuopQjk2YSJYoU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3wvZhbG0n8sLkyvUTqrc16Z-fLNARAjhory0mHIBeNQ&oe=6A6C8A1A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "**QuixPlayer - Control 180deg / 360deg Video Playback with QR Codes**\n\nQuixPlayer is a VR video player for Meta Quest 3 and 3S that enables simple, reliable, and fully offline synchronized video playback.\n\nUsing only a QR code, you can start video playback across multiple headsets at the same timing. No internet or local network is required, making it ideal for environments with restricted connectivity.\n\n**Key Features**\n\n**Offline Playback Control**\nScan a QR code to start video playback at a specified timing or condition. QuixPlayer operates entirely offline for stable performance.\n\n**Simple Operation**\nNo complex controller input is needed. Just scan a QR code and the experience begins.\n\n**Playback Modes**\nSYNC: Periodic time sync based on the headset clock (e.g. TRG:SYNC:5).\nREL: Relative countdown after scanning (e.g. TRG:REL:10).\nABS: Absolute time playback (e.g. TRG:ABS:110000).\n\n**QR Code Options**\nQR codes can specify video file name, video type (180deg or 360deg), and layout mode (None, SideBySide, OverUnder, SideBySide3D, OverUnder3D).\n\n**Flexible QR Code Format**\nTRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={layout}\n\n**Use Cases**\nSuitable for education, exhibitions, events, and other scenarios where synchronized playback is required without network access.\n\n**Experience**\nShare important moments with your audience at the exact same time using a QR-based playback system.\n", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}, {"images": {"nodes": [{"file_name": "Artboard \u2013 5.png", "id": "3862485207215612", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618264_3862485213882278_6983363211996585407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAyO-6evifUQ7kNvwHyi3cz&_nc_oc=AdohU1HETMhY180etUX-Zh_Lg1GXvLjNK8AIFYTYoJGeJVOkItzaSvc6VNXvVLFwtaY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHY-kEzZsiTpA-gsnic2swzLpo0ARMI5Zl0rv_XNkRRg&oe=6A6C9D2E"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "1135616805161792", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619148_1135616808495125_8615746792926765700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Axi9B7pVOh0Q7kNvwFMarY5&_nc_oc=AdoEtAp9UGjsvdEGy3yaqy0JXa40rYzo7cqMn6ypRTWH-9vYGfcCeeYWsN3iclBSff8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcGyZraEM4gQ1GntQJAd01COF-SLk7HynVn_TxIVmiAg&oe=6A6CA971"}, {"file_name": "Artboard \u2013 6.png", "id": "814564234364013", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618274_814564237697346_1085994346422534066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOQD8WSC_CUQ7kNvwHRRE0T&_nc_oc=AdoXVd_tlPMG3bJf-rpPynOVgQTZEXnF_V2QaHDmvDVbGzerYC2FcigPyIV1kuvqH7Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAnDAYsic6jNUuRbsvmlDIGj1xOeJwx-lnbtE_mfCE1g&oe=6A6CBB73"}, {"file_name": "Artboard \u2013 2.png", "id": "789635813561471
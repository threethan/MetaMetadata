32px \u2013 f \u2013 1.png", "id": "810326608136812", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499622211_810326611470145_537147900053482059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7ZNlVxG74kQ7kNvwGL6Dtj&_nc_oc=AdpR_Z_S8F1BU3ff59GYLBYzkGdrz4tXrIFiXLWtssWXa91s0DSGwCx_NqY4eyU3NCs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S1fD5tPsfqRgzGMgdKeKk8s2lg_L5-uwNOsmZlWEcog&oe=6A369FA0"}, {"file_name": "512px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_HFVba4fLYQ7kNvwH_P8So&_nc_oc=Ado0tprXwBsGZXnvBdrHcsSci4BJUl5c1xgeqCGRd-RU-nQkBb7kPolAA--QBxgUpV0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UPEQAcst4flaecoabD-XRUuVSkoxbLWBLCXzUGOyKNg&oe=6A36ACE9"}]}, "id": "2604341496584827", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HK_oHcHTQOUQ7kNvwG42JuU&_nc_oc=Adp296Rv76rGYG6IhY-h-6Qz3rNfYdJmFISyQ-F_xtoUlfEA6uZ1uzVOT7_Z5mUMu0I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WsXWRQyG5wtSkS-GW-H3j9Ajqpyo502u53-6lwcrZng&oe=6A36C725"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbK116od6LMQ7kNvwGMIC2g&_nc_oc=AdqlIfKyhsRnkAYa_Lb-Ov2wxQKhieOdlJR4vLF1H7M1QTw4OPtXP7SmpWPC6HyIOi0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jK6f5DoYFEP6iSvg5WWxZJiuQ-pNaq7Q-XJMCMcPEUw&oe=6A36A631"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSrvdHYzVxwQ7kNvwGcL4LY&_nc_oc=AdrIsgV7aRNcAtvEUtkkRvDDvkhyRekDe3o7WEV-zuz6n-xUpNbPV-kL0hJ5j5XxxwM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1rNgY_YobObhfXJydmUpKiHM5bvsznOrfS6qgsuztdQ&oe=6A36B5E3"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4Jw4xutWtoQ7kNvwESF9fC&_nc_oc=Adq5jtldRlOthSR-kNgOjltRSJlyW2qTSFgz39u4g-hp1Q5doaYaOmhKL9Q_r-w8gKo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Mb0LNg1be3_2_6g5OfFjov2t8EZw9-zwNkrf935wpiA&oe=6A36994A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeYhCowFe2wQ7kNvwHPpjHD&_nc_oc=Adr70hSacJCoiV5Q1HC-8oBzQiTY1L6c7lmMuHZzzFn_89Scd35CZdsw4Vx_zwBtLLk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TELdKY4mWnQFc03Lz6i9UZaTg1LVoacc6HBCXuqzZIg&oe=6A36B4DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "QuixPlayer \u2013 Control 180\u00b0/360\u00b0 Video Playback Easily with QR Codes\n\nQuixPlayer is a VR video player developed for Meta Quest 3/3S. Without relying on a network connection, you can synchronize playback across multiple headsets simply by scanning a QR code.\n\nMain Features\n\t\u2022\tPlayback control without internet: Start playback at the specified timing or condition just by scanning a QR code. Works reliably even in environments with limited connectivity.\n\t\u2022\tSimple operation: No complicated controller actions required\u2014just scan a QR code to begin the experience.\n\t\u2022\tThree playback modes:\n\t1.\tPeriodic Time Sync (SYNC): Example TRG:SYNC:5 \u2192 starts playback at 5-minute intervals based on the headset clock (e.g., 10:30:00).\n\t2.\tRelative Countdown (REL): Example TRG:REL:10 \u2192 starts playback 10 seconds after scanning.\n\t3.\tAbsolute Time (ABS): Example TRG:ABS:110000 \u2192 starts playback at 11:00:00 AM.\n\nQR Code Format\nIn addition to playback timing, QuixPlayer QR codes can specify the video filename, video type (360\u00b0/180\u00b0), and layout mode.\nFormat: TRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={None, SideBySide, OverUnder, SideBySide3D, OverUnder3D}\n\nExamples\n\t1.\tTRG:REL:5?name=Video001&type=360&layout=None \u2192 Plays \u201cVideo001\u201d in 360\u00b0 monoscopic mode 5 seconds after scanning.\n\t2.\tTRG:SYNC:10?name=DemoMovie&type=180&layout=OverUnder3D \u2192 Plays \u201cDemoMovie\u201d in 180\u00b0 over-under 3D mode at 10-minute intervals based on the headset clock.\n\t3.\tTRG:ABS:203000?name=Concert&type=360&layout=Sid", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neorealx.com/QuixPlayer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NeoRealX", "support_website_url": null, "website_url": "https://neorealx.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "u
Q&oe=6ABBE01D"}, {"file_name": "Artboard \u2013 30.png", "id": "1356961489376362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619773_1356961492709695_577836601385385244_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B561FpHt4PwQ7kNvwF49PWb&_nc_oc=AdoOm0xmsLqrWGvHbo5k3PViuy5gMfNVqy33KsrqnUIUvHtX6Th-T36pPvbhLJTw4is&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwBj0PwI2mtbumaQ9c-wbHDCdCOc7l3nItID9SlneQdA&oe=6ABBD3C9"}, {"file_name": "Artboard \u2013 3.png", "id": "1285376826097509", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617831_1285376829430842_6656877102644666653_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-3qVsoqBEIQ7kNvwHUAMX0&_nc_oc=Adrr-MIONpjmSz_ourMeKAJt3vYyCnv7tQjoIjbPrFE54wQR1Z4fiOG_9kc74oIm_iw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDQLAavJ9x7sabXN2v5OjmV1UnDsPMHkarxe74gwNNIg&oe=6ABBCE27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360\u00b0\u52d5\u753b\u30d7\u30ec\u30a4\u30e4\u30fc", "180\u00b0\u52d5\u753b\u30d7\u30ec\u30a4\u30e4\u30fc"], "long_description": "QuixPlayer \u2013 QR\u30b3\u30fc\u30c9\u3067\u624b\u8efd\u306b180\u00b0/360\u00b0\u52d5\u753b\u518d\u751f\u3092\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\n\nQuixPlayer\u306f\u3001Meta Quest 3/3S\u5411\u3051\u306b\u958b\u767a\u3055\u308c\u305fVR\u30d3\u30c7\u30aa\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u3059\u3002\n\u901a\u4fe1\u74b0\u5883\u306b\u4f9d\u5b58\u305b\u305a\u3001\u30b7\u30f3\u30d7\u30eb\u306a\u300cQR\u30b3\u30fc\u30c9\u30b9\u30ad\u30e3\u30f3\u300d\u3060\u3051\u3067\u8907\u6570\u306e\u30d8\u30c3\u30c9\u30bb\u30c3\u30c8\u306b\u540c\u3058\u6620\u50cf\u3092\u518d\u751f\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n\n\u3010\u4e3b\u306a\u7279\u5fb4\u3011\n\u30fb\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u4e0d\u8981\u306e\u518d\u751f\u5236\u5fa1\nQR\u30b3\u30fc\u30c9\u3092\u30b9\u30ad\u30e3\u30f3\u3059\u308b\u3060\u3051\u3067\u3001\u6307\u5b9a\u3055\u308c\u305f\u30bf\u30a4\u30df\u30f3\u30b0\u30fb\u6761\u4ef6\u3067\u6620\u50cf\u518d\u751f\u3092\u958b\u59cb\u3002\u96fb\u6ce2\u304c\u5236\u9650\u3055\u308c\u305f\u74b0\u5883\u3067\u3082\u5b89\u5fc3\u3067\u3059\u3002\n\n\u30fb\u30b7\u30f3\u30d7\u30eb\u306a\u64cd\u4f5c\n\u8907\u96d1\u306a\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u64cd\u4f5c\u306f\u4e0d\u8981\u3002QR\u30b3\u30fc\u30c9\u3092\u304b\u3056\u3059\u3060\u3051\u3067\u4f53\u9a13\u304c\u59cb\u307e\u308a\u307e\u3059\u3002\n\n\u30fb3\u3064\u306e\u518d\u751f\u30e2\u30fc\u30c9\n   1.\u5468\u671f\u6642\u523b\u540c\u671f\uff08SYNC\uff09\uff1a\u4f8b TRG:SYNC:5 \u2192 \u672c\u4f53\u6642\u8a08\u306e5\u5206\u523b\u307f\uff08\u4f8b: 10:30:00\uff09\u3067\u518d\u751f\u958b\u59cb\n   2.\u76f8\u5bfe\u30ab\u30a6\u30f3\u30c8\u30c0\u30a6\u30f3\uff08REL\uff09\uff1a\u4f8b TRG:REL:10 \u2192 \u8aad\u307f\u53d6\u308a\u304b\u308910\u79d2\u5f8c\u306b\u518d\u751f\n   3.\u56fa\u5b9a\u6642\u523b\u518d\u751f\uff08ABS\uff09\uff1a\u4f8b TRG:ABS:110000 \u2192 \u5348\u524d11:00:00\u306b\u518d\u751f\n\n\n\u3010QR\u30b3\u30fc\u30c9\u30d5\u30a9\u30fc\u30de\u30c3\u30c8\u3011\nQuixPlayer\u306f\u3001\u518d\u751f\u30bf\u30a4\u30df\u30f3\u30b0\u306b\u52a0\u3048\u300c\u52d5\u753b\u30d5\u30a1\u30a4\u30eb\u540d\u300d\u300c\u6620\u50cf\u30bf\u30a4\u30d7\uff08360\u00b0/180\u00b0\uff09\u300d\u300c\u30ec\u30a4\u30a2\u30a6\u30c8\u65b9\u5f0f\u300d\u3082\u6307\u5b9a\u53ef\u80fd\u3067\u3059\u3002\n\u5f62\u5f0f\u306f\u4ee5\u4e0b\u306e\u3088\u3046\u306b\u306a\u308a\u307e\u3059\uff1a\n\nTRG:{MODE}:{VALUE}?name={\u30d5\u30a1\u30a4\u30eb\u540d}&type={360 or 180}&layout={None, SideBySide, OverUnder, SideBySide3D, OverUnder3D}\n\n--- \u8a18\u8ff0\u4f8b ---\n\u4f8b1\uff09TRG:REL:5?name=Video001&type=360&layout=None\n\u2192 QR\u8aad\u307f\u53d6\u308a\u304b\u30895\u79d2\u5f8c\u306b\u300cVideo001\u300d\u3092360\u00b0\u5358\u753b\u9762\u30e2\u30fc\u30c9\u3067\u518d\u751f\n\n\u4f8b2\uff09TRG:SYNC:10?name=DemoMovie&type=180&layout=OverUnder3D\n\u2192 \u672c\u4f53\u6642\u8a08\u306e10\u5206\u523b\u307f\u3067\u300cDemoMovie\u300d\u3092180\u00b0\u306e\u4e0a\u4e0b\u5206\u52723D\u30e2\u30fc\u30c9\u3067\u518d\u751f\n\n\u4f8b3\uff09TRG:ABS:203000?name=Concert&type=360&layout=SideBySide\n\u2192 20:30:00\u306b\u300cConcert\u300d\u3092360\u00b0\u5de6\u53f3\u5206\u5272\u30e2\u30fc\u30c9\u3067\u518d\u751f\n-------------\n\n\n\u3010\u5229\u7528\u30b7\u30fc\u30f3\u3011\n\u6559\u80b2\u73fe\u5834\u3001\u5c55\u793a\u4f1a\u3001\u30a4\u30d9\u30f3\u30c8\u4f1a\u5834\u3001\u822a\u7a7a\u6a5f\u5185\u306a\u3069\u3001\u96fb\u6ce2\u304c\u5236\u9650\u3055\u308c\u305f\u74b0\u5883\u3067\u3082\u4e00\u6589\u4f53\u9a13\u3092\u63d0\u4f9b\u53ef\u80fd\u3002\n\n\n\u3010QuixPlayer\u3067\u5b9f\u73fe\u3059\u308b\u4f53\u9a13\u3011\n\u5927\u5207\u306a\u6620\u50cf\u3092\u3001\u4ef2\u9593\u3084\u89b3\u5ba2\u3068\u300c\u540c\u3058\u77ac\u9593\u306b\u5171\u6709\u300d\u3067\u304d\u308b\u3002\nQuixPlayer\u306f\u3001QR\u30b3\u30fc\u30c9\u3092\u6d3b\u7528\u3057\u305f\u65b0\u3057\u3044\u518d\u751f\u30b9\u30bf\u30a4\u30eb\u3092\u63d0\u6848\u3057\u307e\u3059\u3002", "short_description": "QR\u30b3\u30fc\u30c9\u3092\u304b\u3056\u3059\u3060\u3051\u3067\u3001Meta Quest\u3067\u7c21\u5358\u306b180\u00b0/360\u00b0\u52d5\u753b\u3092\u540c\u671f\u518d\u751f\u3067\u304d\u308bVR\u30d7\u30ec\u30a4\u30e4\u30fc"}, {"images": {"nodes": [{"file_name": "Artboard \u2013 2.png", "id": "24660504556909224", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618251_24660504563575890_6648582444465504751_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyQxqpGePZ0Q7kNvwEFqzH8&_nc_oc=Ado5w0bdWoEO6S71mKfY0601m8av8IdRCCMAo45wWwvymE64MRQrXDCVAiuIQt0Info&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6zs7OosoEw5gYtX27PzsdIes5gCXcIADpmR-FdO0vGA&oe=6ABBDF48"}, {"file_name": "Artboard \u2013 6.png", "id": "1493168561822344", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619836_149316856
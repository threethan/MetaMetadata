_ohc=uQRWRjW_wJsQ7kNvwG6x_Wx&_nc_oc=AdqWvMo8nXM17U-kiUG6NYB7RYbLbxA0Icdi4S1RgTp8Hmy7oHG54ugn8zBXYVO0ACc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoCZSedhkSnvh1ra5ZNSIg-GZVFcYv2WlJ-unPUSvWXQ&oe=6A8D6A60"}, {"file_name": "512px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLsOvt9w-XUQ7kNvwHotCD4&_nc_oc=Adpbspr3BeejuLQ8mr4O5p5q8bgXkfiokEwf-zv2TQofwf9b88skEbVvhvHp6jhH_nQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrjE2EFq7IzEn6Kax1ypS1jHFM6_hqoEqrQ4NsM5UOjA&oe=6A8D77A9"}]}, "id": "2604341496584827", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUscO7rNqEUQ7kNvwGEIVH1&_nc_oc=Adop6LZfhWHjQKj4rSFOzSx0Iq4hMbLTfNy0ut_1u3_mQ-Y88Jpxd5ec1UWVCtzKvjI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsJaMvECmKi43GTVvV3aM1FBn_oJUDSEimNrOyn5zbxA&oe=6A8D91E5"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmCE6GdNSxMQ7kNvwFwLbOP&_nc_oc=AdodLMajzEwBU3Et-DHQ4UyqYxFASvlftSc2HjNg7VJCZaq1VLj-fCo31VqvoeJ7Ym4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcvkEIG7n5_0Ac0NleNk5SAjiJ2Gg-kISz_W-JDawQVw&oe=6A8D70F1"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMfaHsS0S3MQ7kNvwHEGsCw&_nc_oc=Adob1IYCvcQ3ME0hAZ7yVBWtmmvPOFKFWzIzlsU3hcQ9ffuM9A05JnTT5SDbOnyTdxY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCxsgDcKR5VbIDRpcbN3iy_cwsDbJ8CbD96vgg2sdkUg&oe=6A8D80A3"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSKgMbKT3Z4Q7kNvwE8XHC1&_nc_oc=AdpCpVa57xt14MVatAAJL0eLk-AvfIjBexdwenwW3c07ZAFgCEyHzYORbc8y8uZBaEE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEp80jr0fo3nA9PyDdJD4kJbUtRcqXITFFyM4g4D8cDUQ&oe=6A8D640A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izQUi3rf_hgQ7kNvwEDHSQ1&_nc_oc=AdrVBu4VMnQN1VA6FJ51F8hOTVk5y4OaLOkM2tHCoAvvKAB54hxxnjuF6k4LeP1rj64&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6TigoxsWaJB-tnyb3BW6GaUQ9-7dLhJNth16F5XJhxA&oe=6A8D7F9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "QuixPlayer \u2013 Control 180\u00b0/360\u00b0 Video Playback Easily with QR Codes\n\nQuixPlayer is a VR video player developed for Meta Quest 3/3S. Without relying on a network connection, you can synchronize playback across multiple headsets simply by scanning a QR code.\n\nMain Features\n\t\u2022\tPlayback control without internet: Start playback at the specified timing or condition just by scanning a QR code. Works reliably even in environments with limited connectivity.\n\t\u2022\tSimple operation: No complicated controller actions required\u2014just scan a QR code to begin the experience.\n\t\u2022\tThree playback modes:\n\t1.\tPeriodic Time Sync (SYNC): Example TRG:SYNC:5 \u2192 starts playback at 5-minute intervals based on the headset clock (e.g., 10:30:00).\n\t2.\tRelative Countdown (REL): Example TRG:REL:10 \u2192 starts playback 10 seconds after scanning.\n\t3.\tAbsolute Time (ABS): Example TRG:ABS:110000 \u2192 starts playback at 11:00:00 AM.\n\nQR Code Format\nIn addition to playback timing, QuixPlayer QR codes can specify the video filename, video type (360\u00b0/180\u00b0), and layout mode.\nFormat: TRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={None, SideBySide, OverUnder, SideBySide3D, OverUnder3D}\n\nExamples\n\t1.\tTRG:REL:5?name=Video001&type=360&layout=None \u2192 Plays \u201cVideo001\u201d in 360\u00b0 monoscopic mode 5 seconds after scanning.\n\t2.\tTRG:SYNC:10?name=DemoMovie&type=180&layout=OverUnder3D \u2192 Plays \u201cDemoMovie\u201d in 180\u00b0 over-under 3D mode at 10-minute intervals based on the headset clock.\n\t3.\tTRG:ABS:203000?name=Concert&type=360&layout=Sid", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neorealx.com/QuixPlayer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NeoRealX", "support_website_url": null, "website_url": "https://neorealx.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25295327580054127"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1160843999233625"}]}, "baseline_offer": {"id": "1160843999233625"}, "is_approved": true, "fi
nc_ohc=iIMIVRyfWQkQ7kNvwEad9yI&_nc_oc=AdkOOo5Vom3P0HwloIk_wqYjM53pj5j_7EEAvwq81eajpW3p08WEZUh4cMkHdkrc_co&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftGGOXsFZSpHyYOR6a7M2Gm6J3pzzuOhizSvZO0nNSZlg&oe=69A96D23"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvJ1jbw1HwoQ7kNvwFwoW_u&_nc_oc=Adlr7LbZDFBFFHNEy9F8udiFUNqd8uJ6ZXBQVuMDKRPJGrJw0kQn4TMifUjh63fJaGg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs_5kAI-M-b9EqN2Tsqrrl558-EOw4exKx1b0dsNsPomw&oe=69A988CA"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGxFPmf8sB4Q7kNvwHxAo0J&_nc_oc=AdmoXZFKVpy7-hIHq5ATCXT7VpB6l8CYbP7-5kQ_Dj63p8BtUuYp5APCroSa_9yKcv4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs_SHwWrf4w681_qx16Wwk6sYr8GfMVAkWxBxt4EGTKyA&oe=69A96C1A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "QuixPlayer \u2013 Control 180\u00b0/360\u00b0 Video Playback Easily with QR Codes\n\nQuixPlayer is a VR video player developed for Meta Quest 3/3S. Without relying on a network connection, you can synchronize playback across multiple headsets simply by scanning a QR code.\n\nMain Features\n\t\u2022\tPlayback control without internet: Start playback at the specified timing or condition just by scanning a QR code. Works reliably even in environments with limited connectivity.\n\t\u2022\tSimple operation: No complicated controller actions required\u2014just scan a QR code to begin the experience.\n\t\u2022\tThree playback modes:\n\t1.\tPeriodic Time Sync (SYNC): Example TRG:SYNC:5 \u2192 starts playback at 5-minute intervals based on the headset clock (e.g., 10:30:00).\n\t2.\tRelative Countdown (REL): Example TRG:REL:10 \u2192 starts playback 10 seconds after scanning.\n\t3.\tAbsolute Time (ABS): Example TRG:ABS:110000 \u2192 starts playback at 11:00:00 AM.\n\nQR Code Format\nIn addition to playback timing, QuixPlayer QR codes can specify the video filename, video type (360\u00b0/180\u00b0), and layout mode.\nFormat: TRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={None, SideBySide, OverUnder, SideBySide3D, OverUnder3D}\n\nExamples\n\t1.\tTRG:REL:5?name=Video001&type=360&layout=None \u2192 Plays \u201cVideo001\u201d in 360\u00b0 monoscopic mode 5 seconds after scanning.\n\t2.\tTRG:SYNC:10?name=DemoMovie&type=180&layout=OverUnder3D \u2192 Plays \u201cDemoMovie\u201d in 180\u00b0 over-under 3D mode at 10-minute intervals based on the headset clock.\n\t3.\tTRG:ABS:203000?name=Concert&type=360&layout=Sid", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neorealx.com/QuixPlayer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NeoRealX", "support_website_url": null, "website_url": "https://neorealx.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25295327580054127"}}]}, "scheduled_offers": {"count": 1,
content-iad3-1.oculuscdn.com/v/t64.5771-25/499618910_805096248722404_4370860386888983465_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KotCg4jlqEUQ7kNvwGBZTz4&_nc_oc=AdoqoRaC8iZ9uN3TxHExUkMk6ftZi1LBN4mQkmR6STpAtD-qYp4qNxi_tf08sjXvstk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxAEDeI4NdiVcueuOktnDXeceQvtdgnucxBhdKvVXGqg&oe=6B006F72"}, {"file_name": "ss3.png", "id": "1725154228143711", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_1725154238143710_4738714612090861266_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6aENGk0q_YQ7kNvwGz5Fwo&_nc_oc=Adrmg4xfFKL8SLXWgBy_ep_4hJlIq630-CwfibTZrdtciikuj8C9Yaq2uYJ4FD7iA6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcreKhkTXrYRaKaWAuNbkR0rnZxhEsU3TxLqQ-b-Ssvg&oe=6B006E1D"}, {"file_name": "Artboard \u2013 30.png", "id": "1356961489376362", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1356961492709695_577836601385385244_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYJWm56T4UMQ7kNvwEdfLZ_&_nc_oc=AdoomIFOJyH4MiD5UAlPTHEMNiZrp84bkCe00arQBCicrXyVb71TY0y7ThCrzZYv3OA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe_8UpGEiMcYL2K3GcS9k50QhDTa1TiLRPyTt2ypEJ1w&oe=6B0061C9"}, {"file_name": "Artboard \u2013 3.png", "id": "1285376826097509", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617831_1285376829430842_6656877102644666653_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gftHFtkIDXoQ7kNvwGanMG0&_nc_oc=Adq4KgD2wEzt0BzNb0vajC-nODiWTQo8-MAdPeXu3DJtsSVhl0Cntl7-0sHJGGft9WQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6sLeyNgYDsesn3tenZcA9IRYxcZ13WkSb-pdE5Qo9EA&oe=6B005C27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360\u00b0\u52d5\u753b\u30d7\u30ec\u30a4\u30e4\u30fc", "180\u00b0\u52d5\u753b\u30d7\u30ec\u30a4\u30e4\u30fc"], "long_description": "QuixPlayer \u2013 QR\u30b3\u30fc\u30c9\u3067\u624b\u8efd\u306b180\u00b0/360\u00b0\u52d5\u753b\u518d\u751f\u3092\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\n\nQuixPlayer\u306f\u3001Meta Quest 3/3S\u5411\u3051\u306b\u958b\u767a\u3055\u308c\u305fVR\u30d3\u30c7\u30aa\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u3059\u3002\n\u901a\u4fe1\u74b0\u5883\u306b\u4f9d\u5b58\u305b\u305a\u3001\u30b7\u30f3\u30d7\u30eb\u306a\u300cQR\u30b3\u30fc\u30c9\u30b9\u30ad\u30e3\u30f3\u300d\u3060\u3051\u3067\u8907\u6570\u306e\u30d8\u30c3\u30c9\u30bb\u30c3\u30c8\u306b\u540c\u3058\u6620\u50cf\u3092\u518d\u751f\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n\n\u3010\u4e3b\u306a\u7279\u5fb4\u3011\n\u30fb\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u4e0d\u8981\u306e\u518d\u751f\u5236\u5fa1\nQR\u30b3\u30fc\u30c9\u3092\u30b9\u30ad\u30e3\u30f3\u3059\u308b\u3060\u3051\u3067\u3001\u6307\u5b9a\u3055\u308c\u305f\u30bf\u30a4\u30df\u30f3\u30b0\u30fb\u6761\u4ef6\u3067\u6620\u50cf\u518d\u751f\u3092\u958b\u59cb\u3002\u96fb\u6ce2\u304c\u5236\u9650\u3055\u308c\u305f\u74b0\u5883\u3067\u3082\u5b89\u5fc3\u3067\u3059\u3002\n\n\u30fb\u30b7\u30f3\u30d7\u30eb\u306a\u64cd\u4f5c\n\u8907\u96d1\u306a\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u64cd\u4f5c\u306f\u4e0d\u8981\u3002QR\u30b3\u30fc\u30c9\u3092\u304b\u3056\u3059\u3060\u3051\u3067\u4f53\u9a13\u304c\u59cb\u307e\u308a\u307e\u3059\u3002\n\n\u30fb3\u3064\u306e\u518d\u751f\u30e2\u30fc\u30c9\n   1.\u5468\u671f\u6642\u523b\u540c\u671f\uff08SYNC\uff09\uff1a\u4f8b TRG:SYNC:5 \u2192 \u672c\u4f53\u6642\u8a08\u306e5\u5206\u523b\u307f\uff08\u4f8b: 10:30:00\uff09\u3067\u518d\u751f\u958b\u59cb\n   2.\u76f8\u5bfe\u30ab\u30a6\u30f3\u30c8\u30c0\u30a6\u30f3\uff08REL\uff09\uff1a\u4f8b TRG:REL:10 \u2192 \u8aad\u307f\u53d6\u308a\u304b\u308910\u79d2\u5f8c\u306b\u518d\u751f\n   3.\u56fa\u5b9a\u6642\u523b\u518d\u751f\uff08ABS\uff09\uff1a\u4f8b TRG:ABS:110000 \u2192 \u5348\u524d11:00:00\u306b\u518d\u751f\n\n\n\u3010QR\u30b3\u30fc\u30c9\u30d5\u30a9\u30fc\u30de\u30c3\u30c8\u3011\nQuixPlayer\u306f\u3001\u518d\u751f\u30bf\u30a4\u30df\u30f3\u30b0\u306b\u52a0\u3048\u300c\u52d5\u753b\u30d5\u30a1\u30a4\u30eb\u540d\u300d\u300c\u6620\u50cf\u30bf\u30a4\u30d7\uff08360\u00b0/180\u00b0\uff09\u300d\u300c\u30ec\u30a4\u30a2\u30a6\u30c8\u65b9\u5f0f\u300d\u3082\u6307\u5b9a\u53ef\u80fd\u3067\u3059\u3002\n\u5f62\u5f0f\u306f\u4ee5\u4e0b\u306e\u3088\u3046\u306b\u306a\u308a\u307e\u3059\uff1a\n\nTRG:{MODE}:{VALUE}?name={\u30d5\u30a1\u30a4\u30eb\u540d}&type={360 or 180}&layout={None, SideBySide, OverUnder, SideBySide3D, OverUnder3D}\n\n--- \u8a18\u8ff0\u4f8b ---\n\u4f8b1\uff09TRG:REL:5?name=Video001&type=360&layout=None\n\u2192 QR\u8aad\u307f\u53d6\u308a\u304b\u30895\u79d2\u5f8c\u306b\u300cVideo001\u300d\u3092360\u00b0\u5358\u753b\u9762\u30e2\u30fc\u30c9\u3067\u518d\u751f\n\n\u4f8b2\uff09TRG:SYNC:10?name=DemoMovie&type=180&layout=OverUnder3D\n\u2192 \u672c\u4f53\u6642\u8a08\u306e10\u5206\u523b\u307f\u3067\u300cDemoMovie\u300d\u3092180\u00b0\u306e\u4e0a\u4e0b\u5206\u52723D\u30e2\u30fc\u30c9\u3067\u518d\u751f\n\n\u4f8b3\uff09TRG:ABS:203000?name=Concert&type=360&layout=SideBySide\n\u2192 20:30:00\u306b\u300cConcert\u300d\u3092360\u00b0\u5de6\u53f3\u5206\u5272\u30e2\u30fc\u30c9\u3067\u518d\u751f\n-------------\n\n\n\u3010\u5229\u7528\u30b7\u30fc\u30f3\u3011\n\u6559\u80b2\u73fe\u5834\u3001\u5c55\u793a\u4f1a\u3001\u30a4\u30d9\u30f3\u30c8\u4f1a\u5834\u3001\u822a\u7a7a\u6a5f\u5185\u306a\u3069\u3001\u96fb\u6ce2\u304c\u5236\u9650\u3055\u308c\u305f\u74b0\u5883\u3067\u3082\u4e00\u6589\u4f53\u9a13\u3092\u63d0\u4f9b\u53ef\u80fd\u3002\n\n\n\u3010QuixPlayer\u3067\u5b9f\u73fe\u3059\u308b\u4f53\u9a13\u3011\n\u5927\u5207\u306a\u6620\u50cf\u3092\u3001\u4ef2\u9593\u3084\u89b3\u5ba2\u3068\u300c\u540c\u3058\u77ac\u9593\u306b\u5171\u6709\u300d\u3067\u304d\u308b\u3002\nQuixPlayer\u306f\u3001QR\u30b3\u30fc\u30c9\u3092\u6d3b\u7528\u3057\u305f\u65b0\u3057\u3044\u518d\u751f\u30b9\u30bf\u30a4\u30eb\u3092\u63d0\u6848\u3057\u307e\u3059\u3002", "short_description": "QR\u30b3\u30fc\u30c9\u3092\u304b\u3056\u3059\u3060\u3051\u3067\u3001Meta Quest\u3067\u7c21\u5358\u306b180\u00b0/360\u00b0\u52d5\u753b\u3092\u540c\u671f\u518d\u751f\u3067\u304d\u308bVR\u30d7\u30ec\u30a4\u30e4\u30fc"}, {"images": {"nodes": [{"file_name": "Artboard \u2013 2.png", "id": "24660504556909224", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618251_24660504563575890_6648582444465504751_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LE-k2v7PO6oQ7kNvwFyMbVv&_nc_oc=Adp2gD6thjo22fEPQp6zG-QjIaWT2xwMklBULFW0fykyYfDG07sIiWKBe_VI4xe7gdM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfBd9tmiZjYuAcX3v3yvpMBTmaiejAaotfjnj8Xh83SQ&oe=6B006D48"}, {"file_name": "Artboard \u2013 6.png", "id": "1493168561822344", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619836_1493168565155677_171453577557791775_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FuIyLCzGh0Q7kNvwFzCJVw&_nc_oc=AdpoT9CYkSWFa8pFOYKr1Q5n-Fjvmzog40SeMw-rZXttsdV-skqXO4q9OsqjK_PRUdw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoXbaL3PTcpncKladu3tusTAee5wjVuFujJm-g3upDgg&oe=6B007248"}, {"file_name": "Artboard \u2013 1.png", "id": "1474890657197475", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1474890660530808_8207080709372318308_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zunpgM19w5QQ7kNvwHV0xTK&_nc_oc=AdpiNqdHwVCU5YZEQqBFeZhXoYWMseb91fPmmFEv_JnjW1bIxlx4MoCm7ERfTmhvM3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLumr-2opywC00EfrWA9ORUAq7ZmDlW7Ss_xjUMVY6PA&oe=6B007633"}, {"file_name": "Artboard \u2013 5.png", "id": "1275302850574075", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617831_1275302853907408_308330225284587646_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryIr93CjX0EQ7kNvwEkA4Od&_nc_oc=AdoiqOMSVA-VkL_FcuUNICUs6OqRAM9dOOwSsq8JckylkW5k1J5byXec50DOOsjg7Ts&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-mKw0U4EX3zDVuYwFI3k1z49kdjkpuHTR3DMqT8uKTg&oe=6B0088BD"}, {"file_name": "432px \u2013 f \u2013 1.png", "id": "810326608136812", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622211_810326611470145_537147900053482059_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MC4eSIklVBUQ7kNvwGOxnHg&_nc_oc=AdrMxXIGU57DEbQxQ8qjadQ3kSKohqF7DYuqwF5uKcKhrMc0nFvy7khDspLlSH1YB4o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfbwekuLIBIg3EC_7qO2lunlvc-1K93fRsI0GlZelVUg&oe=6B005520"}, {"file_name": "512px - default.png", "id": "778838408071247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619174_778838411404580_99165002600147688_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjBtGrxF4jkQ7kNvwHtJJM9&_nc_oc=AdoEMD6uFQIvr4uJNE2emdOx4JWyyDX3hBxjhnhGK_33m8Kx5YybhG3iVZ-8zxu-0WA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_OOGrafSEUKOjmtEXvz7J8AjoinYshuD2yKMSFziUMw&oe=6B006269"}]}, "id": "2604341496584827", "locale": "en_US", "screenshots": [{"file_name": "Artboard \u2013 4.png", "id": "2017838142378122", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620444_2017838149044788_1312728301972872413_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rSskTBv0fkQ7kNvwFPf0tj&_nc_oc=AdqGXswiQG8auQ2_57oyIvrcNKj0hRq-Z0seWOHOL-1mczFwImuhtxpUgPmi2qifvwo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp9MJAFxqWMWrwIUITX0gpJdoG7817vfJNhUjdMoA9YA&oe=6B007CA5"}, {"file_name": "ss2.png", "id": "788271410826590", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618442_788271414159923_2750812522125241492_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-44EXpL1QJsQ7kNvwHNbnu1&_nc_oc=AdpBrpkX3kVFOgWDaAvxSUD5LKMPZzJlF2ZOXKSEn5UtCPSdOV5bs8i9qM_b08hd7yM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRkaicOTozyIyhUlSFbvfisPlDltwVZU9t0JJQ4SIOBA&oe=6B005BB1"}, {"file_name": "ss3.png", "id": "1834336527161494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622211_1834336530494827_5000098833448038100_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSYfJml57BMQ7kNvwE5vlX-&_nc_oc=Adp4JNL89IBt7rCei9tMAKQy71OoqhV3JWmJ2ipKTI2QcZHtQf7pyr_LPrZ6eWaFzd8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLjWt83Hvh2XBbSRuuqBYJa5CAhUs_TjwRooju8mpi7A&oe=6B006B63"}, {"file_name": "Artboard \u2013 30.png", "id": "817942420570190", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_817942423903523_2579781587199864330_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bb11bXW8qJcQ7kNvwEo8TFP&_nc_oc=AdpX_tgX65DAl_ZRaHi00ycmhwijvwhxCa-pl29Y4G_ba3kO2-Tebm35kW0gIWVIaBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVenVLOMidy71bYkjAtVOnOBxKtkYS9x6xpnA-dEtNWg&oe=6B00870A"}, {"file_name": "Artboard \u2013 3.png", "id": "1476300653694267", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_1476300657027600_2840025129162091773_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHYa2z3IsVMQ7kNvwFNi0qO&_nc_oc=AdpvCirW1GGIG8bh7YLJ_TkvDFJhUM5yObLquTdM1eTLSO6UexpnrF-7NjQ5atLtP3o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcn8UiahHTLdHBBrmQZTMYW93JUOIuEi4xI8xpF-FEFg&oe=6B006A5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuixPlayer", "keywords": ["360VideoPlayer", "180VideoPlayer"], "long_description": "QuixPlayer \u2013 Control 180\u00b0/360\u00b0 Video Playback Easily with QR Codes\n\nQuixPlayer is a VR video player developed for Meta Quest 3/3S. Without relying on a network connection, you can synchronize playback across multiple headsets simply by scanning a QR code.\n\nMain Features\n\t\u2022\tPlayback control without internet: Start playback at the specified timing or condition just by scanning a QR code. Works reliably even in environments with limited connectivity.\n\t\u2022\tSimple operation: No complicated controller actions required\u2014just scan a QR code to begin the experience.\n\t\u2022\tThree playback modes:\n\t1.\tPeriodic Time Sync (SYNC): Example TRG:SYNC:5 \u2192 starts playback at 5-minute intervals based on the headset clock (e.g., 10:30:00).\n\t2.\tRelative Countdown (REL): Example TRG:REL:10 \u2192 starts playback 10 seconds after scanning.\n\t3.\tAbsolute Time (ABS): Example TRG:ABS:110000 \u2192 starts playback at 11:00:00 AM.\n\nQR Code Format\nIn addition to playback timing, QuixPlayer QR codes can specify the video filename, video type (360\u00b0/180\u00b0), and layout mode.\nFormat: TRG:{MODE}:{VALUE}?name={file_name}&type={360 or 180}&layout={None, SideBySide, OverUnder, SideBySide3D, OverUnder3D}\n\nExamples\n\t1.\tTRG:REL:5?name=Video001&type=360&layout=None \u2192 Plays \u201cVideo001\u201d in 360\u00b0 monoscopic mode 5 seconds after scanning.\n\t2.\tTRG:SYNC:10?name=DemoMovie&type=180&layout=OverUnder3D \u2192 Plays \u201cDemoMovie\u201d in 180\u00b0 over-under 3D mode at 10-minute intervals based on the headset clock.\n\t3.\tTRG:ABS:203000?name=Concert&type=360&layout=Sid", "short_description": "Easily sync and play 180\u00b0/360\u00b0 videos on Meta Quest by simply scanning a QR code."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neorealx.com/QuixPlayer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NeoRealX", "support_website_url": null, "website_url": "https://neorealx.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_
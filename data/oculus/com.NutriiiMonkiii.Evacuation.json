dMBGHsbE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqwYrRSOStGdxemmSC4pwYOAl3UqsHB_k-mYB_hTbsbg&oe=6AFF19AE"}, {"file_name": "output-onlinepngtools (4).png", "id": "8494761303925594", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974756_8494761307258927_783120194762073620_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QSV4MUE79oQ7kNvwE-Usah&_nc_oc=Adq2_8gn9bz9T__9tQFX2wAMbfZRcOLVnDTM8btFtPxtMD4ZktkLuYzjBixl1-eyMqM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR13OdkjT4_mJZ-8FGfaoSYHS5Z-dEiaT9jZnWvH1QzDQ&oe=6AFF113D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Evacuation", "keywords": [], "long_description": "In Evacuation, you\u2019re trapped in an underground research bunker where a horde of genetically enhanced monkeys has broken free. As you navigate the dimly lit corridors, you\u2019ll quickly realize these aren\u2019t ordinary primates\u2014they\u2019re highly intelligent, aggressive, and they\u2019re hunting you.\n\nArmed with limited resources, you must make your way through the maze-like bunker, solving puzzles and unlocking doors to escape\u2026 all while trying to avoid being caught. Every step, every sound could alert them to your presence. Stay quiet, stay hidden, and try not to get caught\u2014because in Evacuation, survival is a game of cat and mouse, and you\u2019re the prey.", "short_description": "In Evacuation, you\u2019re trapped in an underground research bunker where a horde of genetically enhanced monkeys has broken free. As you navigate the dimly lit corridors, you\u2019ll quickly realize these aren\u2019t ordinary primates\u2014they\u2019re highly intelligent, aggressive, and they\u2019re hunting you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/evacuationpolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Nutriii, Monkiii", "support_website_url": null, "
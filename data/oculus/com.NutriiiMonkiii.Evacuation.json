_oc=Adrg0ic2sg-iXyAuupotxHoZ2fdY4ewllGoIv5-eLZQjzKkBGZxG8KhniYRlT0TCfRI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YYbyCGLUXWks9Es8ztCLFdoWyyb5tDw5BbMobzSF09w&oe=6A185ABD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Evacuation", "keywords": [], "long_description": "In Evacuation, you\u2019re trapped in an underground research bunker where a horde of genetically enhanced monkeys has broken free. As you navigate the dimly lit corridors, you\u2019ll quickly realize these aren\u2019t ordinary primates\u2014they\u2019re highly intelligent, aggressive, and they\u2019re hunting you.\n\nArmed with limited resources, you must make your way through the maze-like bunker, solving puzzles and unlocking doors to escape\u2026 all while trying to avoid being caught. Every step, every sound could alert them to your presence. Stay quiet, stay hidden, and try not to get caught\u2014because in Evacuation, survival is a game of cat and mouse, and you\u2019re the prey.", "short_description": "In Evacuation, you\u2019re trapped in an underground research bunker where a horde of genetically enhanced monkeys has broken free. As you navigate the dimly lit corridors, you\u2019ll quickly realize these aren\u2019t ordinary primates\u2014they\u2019re highly intelligent, aggressive, and they\u2019re hunting you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/evacuationpolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Nutriii, Monkiii", "support_website_url": null, "website_url": "https://sites.google.com/view/evacuationpolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "int
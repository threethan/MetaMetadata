71_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZLxYAMUXA0Q7kNvwGf-W03&_nc_oc=AdqTAGN2SFL3Ni2e8CdHe5YN3pjcTidxxId_8oLXDH3Lx2e34MNcLLIS1DayR7OJiU8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uv1nSD4Z6Hf9PEFxQ9CFJgZ6W7E41_QrKpDMYs38hAw&oe=69E8B6AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled472_20251016042159.png", "id": "811214087956943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307315_811214091290276_7842851838914439370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHglmlGa9BoQ7kNvwFLmLox&_nc_oc=Adr8W39aJzNK2zB2tRPeAjlMoLfaDCFqSOYNgbenQvppb9yMtsnv917ze-6qlOv5H5o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18A4GpwLrrAzj_x1OpftQzN7pDyDB1B4vj79p33qpmkw&oe=69E8D973"}, "display_name": "Gibby!", "keywords": ["Monkey", "Horror", "Monke"], "long_description": "\ud83d\udc12 Become the monkey and dive headfirst into chaos in this thrilling VR adventure! \ud83c\udfed You\u2019ve found yourself trapped inside a massive, mysterious factory filled with danger, secrets, and monsters lurking around every corner \ud83d\udc7e.\n\nExplore sprawling industrial halls, uncover hidden rooms \ud83d\udd0d, and master your movement as you climb, swing, and leap across the factory using pure monkey agility! \ud83e\uddd7\u200d\u2642\ufe0f Collect bananas \ud83c\udf4c, unlock awesome cosmetics \ud83d\udc85, and customize your look in the in-game shop \ud83d\udecd\ufe0f to show off your unique style to other players.\n\nEvery corner hides a new challenge \u2014 will you outsmart the monsters and escape the factory, or become part of its chaos forever? \ud83d\udca5\ud83d\udd25\n\nGet ready to climb, explore, and go absolutely bananas in the ultimate monkey VR experience! \ud83d\udc35\ud83d\udca8", "short_description": "\ud83d\udc12 Become the monkey in this wild VR adventure! \ud83c\udfed Explore a massive factory full of monsters \ud83d\udc7e, unlock awesome cosmetics \ud83d\udc85, and c
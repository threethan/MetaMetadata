71_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FltbYsLzBMQ7kNvwGm51FY&_nc_oc=AdrFuDTDvfTtNjm7HNhDkMA_cFfV0Wsr-6UUOXbfjH-m3_RRda0wAtKKvnJNF2Bg2MM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uTemX7pvhGlBmiT1HO08vIyy6o8M0h9TRUjVAROqCtA&oe=69D7932B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled472_20251016042159.png", "id": "811214087956943", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307315_811214091290276_7842851838914439370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQjmy3bBqCUQ7kNvwH8ItFL&_nc_oc=Adon9Uui5ARwUqdlMXe60uCJm6HZ-FTb3DC4v_3P5OGvCyb0eu8-rq0wOpIWb17Q69I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tEbiSJmNcu_k0uMM2Q1psooH3mfWrt3Qwb-k6Y_tRzQ&oe=69D7B5F3"}, "display_name": "Gibby!", "keywords": ["Monkey", "Horror", "Monke"], "long_description": "\ud83d\udc12 Become the monkey and dive headfirst into chaos in this thrilling VR adventure! \ud83c\udfed You\u2019ve found yourself trapped inside a massive, mysterious factory filled with danger, secrets, and monsters lurking around every corner \ud83d\udc7e.\n\nExplore sprawling industrial halls, uncover hidden rooms \ud83d\udd0d, and master your movement as you climb, swing, and leap across the factory using pure monkey agility! \ud83e\uddd7\u200d\u2642\ufe0f Collect bananas \ud83c\udf4c, unlock awesome cosmetics \ud83d\udc85, and customize your look in the in-game shop \ud83d\udecd\ufe0f to show off your unique style to other players.\n\nEvery corner hides a new challenge \u2014 will you outsmart the monsters and escape the factory, or become part of its chaos forever? \ud83d\udca5\ud83d\udd25\n\nGet ready to climb, explore, and go absolutely bananas in the ultimate monkey VR experience! \ud83d\udc35\ud83d\udca8", "short_description": "\ud83d\udc12 Become the monkey in this wild VR adventure! \ud83c\udfed Explore a massive factory full of monsters \ud83d\udc7e, unlock awesome cosmetics \ud83d\udc85, and c
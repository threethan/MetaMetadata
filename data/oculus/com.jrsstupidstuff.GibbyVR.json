pqCSqCWAXAMZwnpEpDwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsIaOWRKAzFrruVx20Noj49lyQuo0XMK_lyuVJiPSktyw&oe=69A6CBAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled472_20251016042159.png", "id": "811214087956943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307315_811214091290276_7842851838914439370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iD8v0s6lyCEQ7kNvwGVAWah&_nc_oc=AdnAOK46vduv6bcgyPTC7TiLP62qU6pKCrizzdDg9E4OWt78NFXCuFTj8cijP8ZlC_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvgy0FjJJ7yHpE__XCrRIfeffegiLvdF2P3UCfxvObIpQ&oe=69A6EE73"}, "display_name": "Gibby!", "keywords": ["Monkey", "Horror", "Monke"], "long_description": "\ud83d\udc12 Become the monkey and dive headfirst into chaos in this thrilling VR adventure! \ud83c\udfed You\u2019ve found yourself trapped inside a massive, mysterious factory filled with danger, secrets, and monsters lurking around every corner \ud83d\udc7e.\n\nExplore sprawling industrial halls, uncover hidden rooms \ud83d\udd0d, and master your movement as you climb, swing, and leap across the factory using pure monkey agility! \ud83e\uddd7\u200d\u2642\ufe0f Collect bananas \ud83c\udf4c, unlock awesome cosmetics \ud83d\udc85, and customize your look in the in-game shop \ud83d\udecd\ufe0f to show off your unique style to other players.\n\nEvery corner hides a new challenge \u2014 will you outsmart the monsters and escape the factory, or become part of its chaos forever? \ud83d\udca5\ud83d\udd25\n\nGet ready to climb, explore, and go absolutely bananas in the ultimate monkey VR experience! \ud83d\udc35\ud83d\udca8", "short_description": "\ud83d\udc12 Become the monkey in this wild VR adventure! \ud83c\udfed Explore a massive factory full of monsters \ud83d\udc7e, unlock awesome cosmetics \ud83d\udc85, and climb, swing, and survive your way through the chaos! \ud83d\udca5"}]}, "developer_name": "jr's stupid stuff", "developer_privacy_policy_url": "https://sites
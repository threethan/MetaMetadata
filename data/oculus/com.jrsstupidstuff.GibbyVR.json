5821971_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tB9UyjgCv1EQ7kNvwG_cgFB&_nc_oc=Adok5JVr3ZMA-3Dn5OQ3age80Ds8-gJJspOrvIzSFl6m9iGeHzwkHwnjLmQjHCBFy_8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_k1E-CAKLyQVbrNORxTLJ2s9cyga4788aOF_gnnMKCNw&oe=6A36B76B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled472_20251016042159.png", "id": "811214087956943", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499307315_811214091290276_7842851838914439370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL_3hN0gs2IQ7kNvwHHaRoU&_nc_oc=Adr1eewnKrOwQQlq0nbn1WYTUP2tACY8-oSqmhXPwyT_6JAFrctjdfUZLFimPx9tVIo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9O44X4heDZZRoHfTwcgMPwSMCofr035dr86fzGkirt1g&oe=6A36A1F3"}, "display_name": "Gibby!", "keywords": ["Monkey", "Horror", "Monke"], "long_description": "\ud83d\udc12 Become the monkey and dive headfirst into chaos in this thrilling VR adventure! \ud83c\udfed You\u2019ve found yourself trapped inside a massive, mysterious factory filled with danger, secrets, and monsters lurking around every corner \ud83d\udc7e.\n\nExplore sprawling industrial halls, uncover hidden rooms \ud83d\udd0d, and master your movement as you climb, swing, and leap across the factory using pure monkey agility! \ud83e\uddd7\u200d\u2642\ufe0f Collect bananas \ud83c\udf4c, unlock awesome cosmetics \ud83d\udc85, and customize your look in the in-game shop \ud83d\udecd\ufe0f to show off your unique style to other players.\n\nEvery corner hides a new challenge \u2014 will you outsmart the monsters and escape the factory, or become part of its chaos forever? \ud83d\udca5\ud83d\udd25\n\nGet ready to climb, explore, and go absolutely bananas in the ultimate monkey VR experience! \ud83d\udc35\ud83d\udca8", "short_description": "\ud83d\udc12 Become the monkey in this wild VR adventure! \ud83c\udfed Explore a massive factory full of monsters \ud83d\udc7e, unlock awesome cosmetics \ud83d\udc85, and climb, swing, and survive your way through the chaos! \ud83d\udca5"}]}, "developer_name": "jr's stupid stuff", "developer_privacy_policy_url": "https://sites.google.com/view/jrsstupidstuff/policy", "developer_terms_of_service_url": null, "publisher_name": "jr's stupid stuff", "support_website_url": null, "website_url": "https://sites.google.com/view/jrsstupidstuff/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24796072470003992"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1405160301613447"}]}, "baseline_offer": {"id": "1405160301613447"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1760726400, "status": "PUBLISHED", "id": "1405160301613447"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24873779462233292", "version": "3"}, "id": "1269304701547101", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24796072453337327", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24873779462233292"}, "release_status": "RELEASED"}, "binary_release_c
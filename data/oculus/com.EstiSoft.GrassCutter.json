6LDXZXZr0HdKIatg4Po8S5gY1HYOoal57CG4k3lQRRtA&oe=6A01DA39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-11-15 042018.png", "id": "1346100966357195", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974796_1346100969690528_149688723562945724_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8l_AlIrMmRQQ7kNvwG7A42r&_nc_oc=AdqmEdVWD-BdrbGkh-ZMEVOjplFBgW9GuSpo8yfekCUIB1M-gs9u0TykfGZbV_w7s9c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bI1AnIvic0UvNjNWFTWfC2QU8Qu8CXHhbq31U9r39IA&oe=6A01E04F"}, "display_name": "Grass Cutter", "keywords": ["Satisfy", "Comfort", "Runner", "Pet", "Grass"], "long_description": "Enter the world of \"Grass Cutter,\" where lawn care becomes a VR adventure! With your Meta Quest, take control of realistic lawn care tools to groom, shape, and master a variety of lush landscapes. Whether you're navigating small gardens or expansive green lawns, each level offers a unique challenge to test your precision, strategy, and efficiency.\n\n\"Grass Cutter\" offers easy-to-master controls, allowing players of all skill levels to dive into the relaxing yet engaging task of lawn mowing. Use upgraded mowers, clippers, and advanced equipment as you progress through the game. Customizable tools, dynamic environments, and immersive VR visuals create a realistic experience that evolves as you unlock new levels and challenges.\n\nExplore different biomes, each with its own natural beauty, from simple backyard gardens to sprawling parklands. Show off your perfectly groomed lawns, earn rewards, and take on tougher tasks as your skills advance. \"Grass Cutter\" combines the satisfaction of lawn care with the immersive power of VR\u2014perfect for players who love relaxing yet rewarding gameplay! Step into the green, and start cutting today!", "short_description": "\"Grass Cutter\" brings the relaxing, yet strategic task of lawn mowing to virtual reality! Step into lush landscapes with your Meta Quest and use various tools to trim, shape, and perfect each lawn. From easy beginner levels to challenging expert lawns, \"Grass Cutter\" offers dynamic gameplay that tests precision and creativity. Customize tools, unlock unique landscapes, and enjoy the satisfaction of perfectly manicured grass in immersive VR. Get ready to cut, trim, and master the art of VR lawn c"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/grass-cutter", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "644354873106712"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8981574918532066"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1472408587952750"}, {"status": "PUBLISHED", "id": "1974501710115920"}, {"status": "PUBLISHED", "id": "1141829991257642"}, {"status": "PUBLISHED", "id": "1226292618904076"}, {"status": "PUBLISHED", "id": "3723774594433108"}, {"status": "PUBLISHED", "id": "1161635812101564"}, {"status": "PUBLISHED", "id": "1116838233169160"}, {"status": "PUBLISHED", "id": "482645184173367"}]}, "baseline_offer": {"id": "1161635812101564"}, "is_approved": true,
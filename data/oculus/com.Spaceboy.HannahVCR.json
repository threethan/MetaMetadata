IMkZS7UaABQeO_QqYRpulo8w&oe=6A707CE7"}, {"file_name": "VCR_CAP_Meta4.png", "id": "964451815768974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393450_964451819102307_1953955235393449221_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2faEzlGIV5IQ7kNvwH9MH-7&_nc_oc=AdrpwqwpmYnTR01Nw6YwY9vhJEZf967UOvp6LBqg3St3Us1Q0HKF8-CEvPHvtyAQ1Fs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU8CjUnYCrLCnFit_aP87ZNjLLt55Hoy_zuqjwN7nqUg&oe=6A709BA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "H_VCR Meta.png", "id": "4001759743438865", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491826687_4001759750105531_8922539482725892767_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iblC58nzBoQ7kNvwGXKRO4&_nc_oc=Adq7aD4HY5CjI_FbvShDbEj_dFROxvN0EblB5DVmnTKO1b8tDgljb8qTGuwC8P12_7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJwmmq84-uxyITNPFSUtdNJdEEU9AzGvYjIYte1x2S8g&oe=6A70923D"}, "display_name": "Hannah VCR", "keywords": ["PuzzleGame", "VRPuzzle", "VRIndieGame", "NarrativeVR", "IndieVR"], "long_description": "\"Hannah VCR is a narrative puzzle game where you manipulate a VHS tape to change Hannah's destiny.\n\nEach colored square on the tape represents a part of the scene. You decide the order, and Hannah moves forward alone, facing a world broken by memories, abandonment... and the search for a lost doll.\n\nControl the tape with your own hands in an immersive environment that simulates a forgotten room.\n\nWith a retro aesthetic, immersive music, and an emotionally charged design, Hannah VCR is a thrilling experience filled with mystery and the things that never fully heal.\n\nRewind. Change the order. Maybe this time, you'll manage to save her.\"", "short_description": "Hannah VCR is a narrative puzzle game where you manipulate a VHS tape to alter environments and guide Hannah on her quest. Play in VR or with traditional controllers and explore a story filled with mystery, nostalgia, and broken memories."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1qtlwaMrMKecJUkwqiCgoZ85Q_L6prWxY/view?usp=sharing", "developer_terms_of_service_url": "https://drive.google.com/file/d/1y7NdvCxdhCizaFQNCWhnMIA87JChw0fq/view?usp=sharing", "publisher_name": "Spaceboy", "support_website_url": null, "website_url": "https://spaceboy.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25576227022047996"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393511_689034673521214_8965126676689998011_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZU_FQnN_L8Q7kNvwGqiK2a&_nc_oc=Adq7MypZEsX-Qcfj6H-ujI1fZlTuPu7Clc4rjapuzOf2ua45uoL7dJbXUEYjUHecJIc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXytTh0wamj6zcHmGSXBsyu1NCnhwvq8Off3Rv6MB78w&oe=6A709994"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hannah VCR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1750954680, "lastRevision": {"nodes": [{"id": "9307081862722437", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9307081836055773", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "690223423379990"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2055869681571586", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hannah VCR", "keywords": ["hannah", "hannahvcr", "vcr", "spaceboy"], "long_description": "Hannah VCR es un juego de puzzles narrativo donde manipulas una cinta VHS para cambiar el destino de Hannah.\n\nCada cuadro de color en la cinta representa una parte del escenario. T\u00fa decides el orden, y Hannah avanza sola, enfrentando un mundo roto por los recuerdos, el abandono\u2026 y la b\u00fasqueda de una mu\u00f1eca perdida.\n\nControla la cinta con tus propias manos en un entorno envolvente que simula una habitaci\u00f3n olvidada.\n\nCon est\u00e9tica retro, m\u00fasica envolvente y un dise\u00f1o emocionalmente cargado, Hannah VCR es una emocionante experiencia llena de misterio y de las cosas que nunca sanan del todo.\n\nRebobina. Cambia el orden. Tal vez esta vez, logres salvarla.", "short_description": "Hannah VCR es un juego de puzzles narrativo donde manipulas una cinta VHS para alterar escenarios y guiar a Hannah en su b\u00fasqueda. Juega en VR o con control tradicional y explora una historia cargada de misterio, nostalgia y recuerdos rotos."}, {"images": {"nodes": [{"file_name": "Portrait 1008 x 1440.png", "id": "30281630421436577", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824218_30281630438103242_7351932138311403668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MRxqVPam-wQ7kNvwFtpgZf&_nc_oc=AdojdZFqQgkvJAb0NVL_A36iKweNO7gUZJl5N9bsS_8QvhzdI5p33VOikLJUX62xZu4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7
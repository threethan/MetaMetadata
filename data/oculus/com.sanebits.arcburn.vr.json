91402342289986_6499119548598935277_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ODBBoTBf8UQ7kNvwFB1vQ1&_nc_oc=AdqgCI8wN0a7pmY11EqBCoJeIriQPT5ZYQTHUbnygZjcjipmwYYLTNW5A67HdJTJ8xM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUJQYw-a4z63yMf4xQ9OTiEBsq-tKiIeHtFqoPMfcIB_Q&oe=6B0F0161"}, {"file_name": "08_screenshot3.png", "id": "1693460808864308", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_1693460815530974_8537990840904425097_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80Bad4KgvZgQ7kNvwHtX7Mm&_nc_oc=Adq675bVictfzovsrRGWL1wKNRanmHPPeq4ZcrITKs2Axuz7V8-8guteYKI3IbfCmg4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUzONA77HokPKSCTTv7d186F29FZHjYABVLp1n4MByCBg&oe=6B0EFF4F"}, {"file_name": "09_screenshot4.png", "id": "1603312794348170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821796_1603312797681503_9085868723716594101_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRCs4_gNF6UQ7kNvwF9Q74f&_nc_oc=AdqgcReApJIRd3BHsL1U-180R_rpZxDhyhwW-nPRxrapxqHABciNJdU-10vAwq1fQOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVuuCsmlWed5zeLpDPsQr5aJUY5pBfvPo6UOoCrnNInLA&oe=6B0F0FD9"}, {"file_name": "10_screenshot5.png", "id": "28905013922503166", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_28905013932503165_6210233573206013727_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtkevGtyM3UQ7kNvwHon3wz&_nc_oc=AdonI6ptAIPe3Vzrvkpv_R_1XSwLJy4d26uGEJudfH1XkSFsU-8mpPrEhbHCq-aJlTw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWSCR27T4yF7pUs1nVBuI5Lfr94ux3TNfTHBIzcLsIpJQ&oe=6B0F0A40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "arcburn-trailer-cover.png", "id": "2303903080406864", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_2303903083740197_4983030497415458413_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4BsOovtdigQ7kNvwFomERp&_nc_oc=AdpfnygBDPE87CFthoo98MCz7ioKEqyav8SwpFnoWYxKnhh6mH-5q35rn_cFf69wdLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU8BHYiD7wyFPh86NdOtN81S9uKKTHgVT2jc814CxKzXQ&oe=6B0F0507"}, "display_name": "Arcburn: Neon Combat Racing", "keywords": ["racing", "combat", "cars", "arcade", "multiplayer"], "long_description": "The Night League races after dark: twelve cars, six cities, and nine powers you use with your own hands.\n\nDRIVE IT LIKE IT'S REAL. Close your hands round the wheel and turn it. Pull it towards you to brake and kick the tail out into a drift; hold the slide for a burst of speed on the way out. Hands or controllers, seated, with comfort settings that keep your view level whatever the car does.\n\nTHROW, DON'T PRESS. Let go with one hand and the power in your rack floats into your palm. Throw it forward at whoever you're looking at, toss it back over your shoulder, or squeeze it in your fist: Seeker, Volley, Pulse, Storm, Mine, Nitro, Repair, Shield and Tether.\n\nEVERY HIT CAN BE ANSWERED. Seekers warn you and can be shielded or shot down; Storm always leaves a lane; nothing is a lottery. Pods sit where you can see them, and the crowd's Hype rewards dodges as much as hits.\n\nRIVALS WITH A MIND. Sixteen drivers and eight champions race, hold grudges and fight each other, not just you. Beat a champion's three crowd demands, then beat them one on one to take their car.\n\nSIX CIRCUITS, EIGHTEEN LAYOUTS. A night harbour, a sunset canyon, a hill town at dusk, downtown in the rain with a figure-eight flyover, a sea cliff at golden hour, a steelworks at night. Every Grand layout hides a shortcut.\n\nRACE YOUR FRIENDS. Up to eight people on the same Wi-Fi or online with a six-letter code; computer drivers fill the grid.", "short_description": "Grip the wheel, race eleven rivals through neon city streets, and take a hand off to hurl lightning at the car ahead. Arcburn is combat racing built for VR: throw a homing Seeker at the rival you're looking at, flick a Volley back over your shoulder at the one in your mirror, squeeze a Shield into life as the warning screams. Career, Quick Race, and races with friends on the same Wi-Fi or online by code."}]}, "developer_name": "SaneBits", "developer_privacy_policy_url": "https://sanebits.com/products/arcburn/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SaneBits", "support_website_url": null, "website_url": "https://sanebits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1429814602660908"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825345_1692956765500984_6479669871278768042_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZ4dOvHbIGkQ7kNvwEzhbOI&_nc_oc=AdrRDMK-uAiwZtgtE6juPHwKuRMidIGBotvrkxFIcXiAGFpyJqtUYemcchFL8m0CBhE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUR5foALlI84sZQyen3dkTG3qo8uRTeaLzSm1HcPhGHjQ&oe=6B0F153B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Arcburn: Neon Combat Racing", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27433260359255
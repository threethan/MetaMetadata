e": "Fall Awareness and Protection Simulation_Screenshot_05_2560X1440.png", "id": "3446672745646973", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974756_3446672748980306_367115319469976451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1q5AIPbBWYQ7kNvwHARsSh&_nc_oc=AdmayLHDarySH09Gbs1X7sB3tp0R_9hHmWQCO1DMX7u1AadZDTw0Hyozm-zZmd0WwsM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyi6AGbWKqtGJCf2hNnxdw_lv0YhxgQgkg9o-o3RJ_HDw&oe=69B698B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Fall Awareness and Protection Simulation_Screenshot_05_2560X1440.png", "id": "567398785304356", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031501_567398788637689_402884592315520920_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bh-nBeNGUL4Q7kNvwHDvM9y&_nc_oc=Adl9sFXy6wScnx_6t2pq7HV13CNZ0uISzb3ZlKGCncEMV_kMMfMa8dFeoyT2ekUu4bY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMK6tAtmfm9I_2-4i_Lf6QpJPJle88c1XkixSwgJpNJA&oe=69B6B0D1"}, "display_name": "Fall Awareness and Protection", "keywords": [], "long_description": "Falls from height are a significant cause of injury at worksites worldwide, many of which can be avoided with proper training, defined processes, and safety equipment. \n\nThe immersive Fall Awareness and Protection simulation begins with an overview of height-related hazards, safety equipment, the five hierarchies of fall protection and their associated levels of risk. Next, participants are asked to match risks and their descriptions for each fall protection hierarchy. Finally, the simulation places participants in a factory setting, moving freely throughout the environment. It tasks them with identifying potential fall hazards, from unmarked holes in the ground and broken equipment to observing workers on ladders, scaffolds, and machinery at height without arrests or restraints.  \n\nGamified elements include identifying ten potential issues in five minutes or less. The simulation provides instant feedback with either \u201ccorrect\u201d or \u201ctry again\u201d responses to encourage participants to reconsider their choices and allows them to revisit any part of the simulation as often as needed. \n\nEmbedded learning outcomes based on Bloom\u2019s revised taxonomy include remembering, understanding, and applying. \n\nBenefits include: \n\u2022Realistic 3D tools, equipment and environments \n\u2022Interactive activities \n\u2022Transferrable skills ", "short_description": "Falls from height are a significant cause of injury at worksites worldwide, many of which can be avoided with proper training, defined processes, and safety equipment. \n\nThe immersive Fall Awareness and Protection simulation begins with an overview of height-related hazards, safety equipment, the five hierarchies of fall protection and their associated levels of risk."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "163166120110434"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "Andro
-25/38974716_250925157616958_5880822238227289952_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0z2qHzXmPhMQ7kNvwERlOxw&_nc_oc=Adof6qpZNWUut9pXlyNkqwQIqXCQV_WaPk00lDe6FH-0OPooxlDjy6sh1VAaVbinoHY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgn0ukUafN0AB0CpGbpYUkwo_8BB3eiSO5i1o5TAi_kQ&oe=6B086154"}, {"file_name": "Fall Awareness and Protection Simulation_Screenshot_05_2560X1440.png", "id": "3446672745646973", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974756_3446672748980306_367115319469976451_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OhNN0ISC5wQ7kNvwGkcual&_nc_oc=AdrviqVJcDOn6JOuB-I6qWLHQ-xUAjgxyT0En1PqYfrNClkTNBSw6BK6T1PhBnVjOkI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz51cRZF6WGQHf9aY93o9EoJOZK7NJOdfV1qXHWMyuMQ&oe=6B0850F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Fall Awareness and Protection Simulation_Screenshot_05_2560X1440.png", "id": "567398785304356", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031501_567398788637689_402884592315520920_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVy_NTodwmgQ7kNvwECkhcg&_nc_oc=AdocC5Ydf1Kx_jVXi3vZjiOxf6VJnv98BIQPTvP13MU75k6IveO13QVk9_K4aSjnPx0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF3ulXdvt6p48lYktDMn2aIRuw-D6ATa-u43i8GttoMQ&oe=6B086911"}, "display_name": "Fall Awareness and Protection", "keywords": [], "long_description": "Falls from height are a significant cause of injury at worksites worldwide, many of which can be avoided with proper training, defined processes, and safety equipment. \n\nThe immersive Fall Awareness and Protection simulation begins with an overview of height-related hazards, safety equipment, the five hierarchies of fall protection and their associated levels of risk. Next, participants are asked to match risks and their descriptions for each fall protection hierarchy. Finally, the simulation places participants in a factory setting, moving freely throughout the environment. It tasks them with identifying potential fall hazards, from unmarked holes in the ground and broken equipment to observing workers on ladders, scaffolds, and machinery at height without arrests or restraints.  \n\nGamified elements include identifying ten potential issues in five minutes or less. The simulation provides instant feedback with either \u201ccorrect\u201d or \u201ctry again\u201d responses to encourage participants to reconsider their choices and allows them to revisit any part of the simulation as often as needed. \n\nEmbedded learning outcomes based on Bloom\u2019s revised taxonomy include remembering, understanding, and applying. \n\nBenefits include: \n\u2022Realistic 3D tools, equipment and environments \n\u2022Interactive activities \n\u2022Transferrable skills ", "short_description": "Falls from height are a significant cause of injury at worksites worldwide, many of which can be avoided with proper training, defined processes, and safety equipment. \n\nThe immersive Fall Awareness and Protection simulation begins with an overview of height-related hazards, safety equipment, the five hierarchies of fall protection and their associated levels of risk."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_
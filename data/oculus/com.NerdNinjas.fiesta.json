25/75236135_2031267680707727_2585493404226985048_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjzpIC_-GgIQ7kNvwGjoQ_i&_nc_oc=Adk6T0CWK7a5q07JWA4EujghKs1HsOLOqFJk7fNkQbkl_522vrh5fdkNP-WExpq-gmo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwPqDHlt8r1N58isl5F4qvHppmiOleB_d49bCdN5hCZGA&oe=69AC0BF1"}, {"file_name": "lvlup7_screen.png", "id": "561072036820067", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982492_561072040153400_4764172211212182058_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lmFty7HDxkQ7kNvwEIgfwj&_nc_oc=Adn597inw9Slz_wqHULUic-yILUa5kuR0eoSlK74-SqPjcsjxvrAIiRg5_nYGpCPjMY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxxissjBL56td8tGJam7sR0OZLuQW19fy7bCIhjgXLvAA&oe=69AC31BD"}, {"file_name": "stageselect_screen-psd-updated.png", "id": "1730809570830065", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391808_1730809574163398_6793358176867589963_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abf71og3ejwQ7kNvwFWlcGk&_nc_oc=Adnrj6wMxqoMc9G4tVTCRB6TFFj1zSNs-xD4R0NtxurS_ooVjOkP1nPJAY4A4vxtv1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1H9faD5GNUqa5VltEgP-lb5DIYV__RcdLK9Situ2RWQ&oe=69AC2236"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AVATLABLE NOW.png", "id": "645289134528788", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_645289141195454_2607582684761721988_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtjkANkVgmAQ7kNvwEt7_Iq&_nc_oc=Adl7lFMIg3-TyFvuHvrNpGsj4FeQgVdB4Be-YSDsc-2n0Q4Xnsqmfx21nWtxVhx21cM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxTPOBsSs3zXypHAURGed9vX9DVPtcBIjNJwjDSlqSWYA&oe=69AC26F7"}, "display_name": "Rogue Pi\u00f1atas: VRmageddon", "keywords": ["roguelite", "roguepinatas", "roguelike", "pinatas", "action"], "long_description": "# A MULTIPLAYER ROGUELITE SURVIVAL GAME\n\nAfter a birthday party goes haywire, the world now faces an onslaught of endless swarms of angry pi\u00f1atas! As the last line of defense, you are humanity\u2019s final hope in the VRmageddon. The mission is simple: survive the party apocalypse or succumb to sweet defeat! \ud83c\udf6c\ud83d\udca5\u2620\ufe0f\n\n{636001679327519}\n# FIGHT AGAINST ANGRY PI\u00d1ATAS \nTons of unique pi\u00f1atas, each with their own behaviors, actions, and a few deadly tricks.\n\n{946766064204489}\n# CHALLENGE EPIC BOSSES\nInsanely big and monstrous Mega Pi\u00f1atas, like the OctoCat, will test even the most skilled fighters.\n\n{1190546266190657}\n# UNLOCK WEAPON EVO'S & GADGETS\nMaster both melee and ranged Weapons and enhance them with Gadgets to create new Weapon Evolutions.\n\n{949634053912176}\n# PLAY SOLO OR PARTY UP\nRally on your own or with friends as Kit Bash, Roxy Riot, Paparoni, Mamagyver, Lt. Gran, or Max Magnifique.\n\n{1186744323041823}\n# TAKE ON UNIQUE STAGES & MISSIONS\nEach area has its own stage objective and also offers new dangers and opportunities for mayhem.\n\n{1153162626554173}", "short_description": "A MULTIPLAYER ROGUELITE SURVIVAL GAME\n\nAfter a birthday party goes haywire, the world now faces an onslaught of endless swarms of angry pi\u00f1atas! As the last line of defense, you are humanity\u2019s final hope in the VRmageddon. The mission is simple: survive the party apocalypse or succumb to sweet defeat! \ud83c\udf6c\ud83d\udca5\u2620\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nerdninjas.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Nerd Ninjas", "support_website_url": null, "website_url": "https://www.roguepinatas.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "
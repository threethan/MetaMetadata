ame": "6.png", "id": "1266001797771897", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982715_1266001801105230_959370726133312774_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-r9UVNyksBEQ7kNvwHQzy6U&_nc_oc=Admv1JeC_eeyIneLNz_NAJGVOr2acfwl-XC_zthbyz40OjtDmqmg3eqdN-IPyCkrazU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzeIb2Bt6i_DBu1rz_YL2eJtc97Lrmo8JdIv5NiGPcPgQ&oe=69BA9B4F"}, {"file_name": "3.png", "id": "1873208323158475", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031508_1873208329825141_1779798513655927515_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX47ZJLuRS8Q7kNvwH0aBCb&_nc_oc=Adl2K182gr7fhJHnkxsSnCuRVw238aiTKLWVi1Kl4aaYpRTDdRp-7dfjSzAU5YSH6Sc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfweUO9HKbWQPdgUPV29u4hl3JeMaU8QV81N9-s1qrtioQ&oe=69BAA632"}, {"file_name": "2.png", "id": "884875963588999", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982687_884875966922332_5575197405599009106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeiBCMVwgDEQ7kNvwE-Zy_a&_nc_oc=Adl6SKHJbHGzo7sAT-GJt-U2p54Co6XzWn969Ev_mXcmRL7U-PqHmugm_5oLWQmGpp4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3Jl2S3ahOfW3vGLGAqVnJvi0_EDGiLW6nYy4QhV7dQw&oe=69BAA9C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rogue Pi\u00f1atas: VRmageddon", "keywords": ["roguelite", "roguepinatas", "roguelike", "pinatas", "action"], "long_description": "A multiplayer VR roguelite game. Your mission? Survive the party-apocalyptic world, bashing your way through waves of invading Pi\u00f1atas!\n\n18+ Pi\u00f1ata Enemies:\nThese pi\u00f1atas are somehow thinking, moving, and growing smarter - each with their own enemy behaviors! \n\n6 Characters to Choose:\nAs one of the few survivors, it\u2019s up to you to answer the call!\n\n6 World-Ending Locations:\nFrom your local neighborhood to the treacherous desert, each area offers new dangers and opportunities for mayhem. \n\nWeapon Galore: Master over 150+ different combinations of attack through weapon evolutions and Dual Wielding.\n\nOnline Multiplayer: Team up with friends in an intense cooperative multiplayer mode, where you'll need to work together to survive the relentless onslaught of pi\u00f1atas.\n\nHidden Secrets:\nFind the hidden Ninjas and other secrets in in every level by looking high and low.", "short_description": "A multiplayer VR roguelite game. Your mission? Survive the party-apocalyptic world by bashing your way through swarms of invading Pi\u00f1atas, where every swing could mean survival or sweet defeat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nerdninjas.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Nerd Ninjas", "support_website_url": null, "website_url": "https://www.nerdninjas.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1006395617474681"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2115330405896816"}, {"status": "PUBLISHED", "id": "1454879809593897"}, {"status": "PUBLISHED", "id": "3334128536752172"}, {"status": "PUBLISHED", "id": "1321261835713061"}, {"status": "PUBLISHED", "id": "1062986946050763"}, {"status": "PUBLISHED", "id": "1339277974038676"}, {"status": "PUBLISHED", "id": "666934715711297"}, {"status": "PUBLISHED", "id": "97399
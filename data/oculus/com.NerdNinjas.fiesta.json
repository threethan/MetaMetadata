q_8p&_nc_oc=AdnHcN3lcLCWQukVIAgHDpAPq_vDZ3rzDMac-wnOEvos2OWeCgg4AtiKUIGoDCmDBEY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs1ECn_RX16m50bUiFeyg4c5ZKJxyRKcLyvaLdBaf4AYQ&oe=69A6C5F1"}, {"file_name": "lvlup7_screen.png", "id": "561072036820067", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982492_561072040153400_4764172211212182058_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAtXYxk4qSEQ7kNvwFq99eM&_nc_oc=AdnSIYcNqneJR5LD7nKjHeQqSisZinQ7ALN3j_5Uz0c0LfIZ1miuQYjgfR1xcnffVhE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs7ko6-VAJK-FqcldwJiV2k2VCKwDkiVDvfLoQSWA4BmA&oe=69A6EBBD"}, {"file_name": "stageselect_screen-psd-updated.png", "id": "1730809570830065", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391808_1730809574163398_6793358176867589963_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qu6X49y1HkoQ7kNvwEXbQr_&_nc_oc=Adm9H8PXnpU8wgLVDub4LYJAMbCUyVnoDAb1BrKANfrGhQOqC0mB8ZnQPIPkm9SIWiE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuerJoRbRhz2QJsf49Qih-bX-He4pHKROsLjdOh1qu2kg&oe=69A6DC36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AVATLABLE NOW.png", "id": "645289134528788", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_645289141195454_2607582684761721988_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Av9cQg68y98Q7kNvwFeeKEM&_nc_oc=AdkyZ5MImp4L3cb6qwcDfTX1Mwi5D7fDRx5nYbp685K6U9l3tTrw2sKEX7zyci6sSKU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu0_FcFMBvlXol9PC1jGb_ecnYSI4bSI3sqmFeYQ96HzQ&oe=69A6E0F7"}, "display_name": "Rogue Pi\u00f1atas: VRmageddon", "keywords": ["roguelite", "roguepinatas", "roguelike", "pinatas", "action"], "long_description": "# A MULTIPLAYER ROGUELITE SURVIVAL GAME\n\nAfter a birthday party goes haywire, the world now faces an onslaught of endless swarms of angry pi\u00f1atas! As the last line of defense, you are humanity\u2019s final hope in the VRmageddon. The mission is simple: survive the party apocalypse or succumb to sweet defeat! \ud83c\udf6c\ud83d\udca5\u2620\ufe0f\n\n{636001679327519}\n# FIGHT AGAINST ANGRY PI\u00d1ATAS \nTons of unique pi\u00f1atas, each with their own behaviors, actions, and a few deadly tricks.\n\n{946766064204489}\n# CHALLENGE EPIC BOSSES\nInsanely big and monstrous Mega Pi\u00f1atas, like the OctoCat, will test even the most skilled fighters.\n\n{1190546266190657}\n# UNLOCK WEAPON EVO'S & GADGETS\nMaster both melee and ranged Weapons and enhance them with Gadgets to create new Weapon Evolutions.\n\n{949634053912176}\n# PLAY SOLO OR PARTY UP\nRally on your own or with friends as Kit Bash, Roxy Riot, Paparoni, Mamagyver, Lt. Gran, or Max Magnifique.\n\n{1186744323041823}\n# TAKE ON UNIQUE STAGES & MISSIONS\nEach area has its own stage objective and also offers new dangers and opportunities for mayhem.\n\n{1153162626554173}", "short_description": "A MULTIPLAYER ROGUELITE SURVIVAL GAME\n\nAfter a birthday party goes haywire, the world now faces an onslaught of endless swarms of angry pi\u00f1atas! As the last line of defense, you are humanity\u2019s final hope in the VRmageddon. The mission is simple: survive the party apocalypse or succumb to sweet defeat! \ud83c\udf6c\ud83d\udca5\u2620\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nerdninjas.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Nerd Ninjas", "support_website_url": null, "website_url": "https://www.roguepinatas.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
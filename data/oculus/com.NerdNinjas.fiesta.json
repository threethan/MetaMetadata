25/75236135_2031267680707727_2585493404226985048_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxLLjTsa1nUQ7kNvwEaVKkx&_nc_oc=AdkxAcTU3lGv22yY6a7YdxYJAz-3gzUu6H2_1fVpe6pu76tf5xq1tf1NA_Dqm6cWy10&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDG5MyMVk7Rd6z0bgozhAQTo4KpL6tnpM9Q1ed9C9Hfg&oe=69B697F1"}, {"file_name": "lvlup7_screen.png", "id": "561072036820067", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982492_561072040153400_4764172211212182058_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-dlyzFbF2UQ7kNvwGTj1Gs&_nc_oc=Adkz1pN9D0itkuBl11Z6cAlPdtXcM-M8ta_9H-m37aHFagO5Ror2EOExGFIsx84tAoo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMyh8FrvT3bL6Td_gG8sic5iGBGsazmZHr92H042q7tg&oe=69B6BDBD"}, {"file_name": "stageselect_screen-psd-updated.png", "id": "1730809570830065", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391808_1730809574163398_6793358176867589963_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5WoP02juMcQ7kNvwH4ueJ1&_nc_oc=AdkwwDtZFDQgnHJYKwk5UkUUQRGEysX-7yU4lWM068NJirhRq1U2S9RuEHS31J00YBw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXvAsLhXGaccbs9Rfxwi4qS8DtuOcuO8KyRZ8C9vnFGg&oe=69B6AE36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AVATLABLE NOW.png", "id": "645289134528788", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_645289141195454_2607582684761721988_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMkeZG6Yf2oQ7kNvwFI3llc&_nc_oc=AdkexXnW39M2_ioltA8LV1DiIZ_BWrT6RypdFN40nuRxvIBF6BeuaucEXUf3fINqyGg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrvrysmOx_uk9N04y6OOSN5rdKYCwLgjfxO7a3Iy9C-A&oe=69B6B2F7"}, "display_name": "Rogue Pi\u00f1atas: VRmageddon", "keywords": ["roguelite", "roguepinatas", "roguelike", "pinatas", "action"], "long_description": "# A MULTIPLAYER ROGUELITE SURVIVAL GAME\n\nAfter a birthday party goes haywire, the world now faces an onslaught of endless swarms of angry pi\u00f1atas! As the last line of defense, you are humanity\u2019s final hope in the VRmageddon. The mission is simple: survive the party apocalypse or succumb to sweet defeat! \ud83c\udf6c\ud83d\udca5\u2620\ufe0f\n\n{636001679327519}\n# FIGHT AGAINST ANGRY PI\u00d1ATAS \nTons of unique pi\u00f1atas, each with their own behaviors, actions, and a few deadly tricks.\n\n{946766064204489}\n# CHALLENGE EPIC BOSSES\nInsanely big and monstrous Mega Pi\u00f1atas, like the OctoCat, will test even the most skilled fighters.\n\n{1190546266190657}\n# UNLOCK WEAPON EVO'S & GADGETS\nMaster both melee and ranged Weapons and enhance them with Gadgets to create new Weapon Evolutions.\n\n{949634053912176}\n# PLAY SOLO OR PARTY UP\nRally on your own or with friends as Kit Bash, Roxy Riot, Paparoni, Mamagyver, Lt. Gran, or Max Magnifique.\n\n{1186744323041823}\n# TAKE ON UNIQUE STAGES & MISSIONS\nEach area has its own stage objective and also offers new dangers and opportunities for mayhem.\n\n{1153162626554173}", "short_description": "A MULTIPLAYER ROGUELITE SURVIVAL GAME\n\nAfter a birthday party goes haywire, the world now faces an onslaught of endless swarms of angry pi\u00f1atas! As the last line of defense, you are humanity\u2019s final hope in the VRmageddon. The mission is simple: survive the party apocalypse or succumb to sweet defeat! \ud83c\udf6c\ud83d\udca5\u2620\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nerdninjas.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Nerd Ninjas", "support_website_url": null, "website_url": "https://www.roguepinatas.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "
culuscdn.com/v/t64.5771-25/38982715_1266001801105230_959370726133312774_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cicKxB8W6i8Q7kNvwFVEY1l&_nc_oc=AdrJ6hixyajXe1yn_ksNI9tavZEYrem4fKwfz_kuUbd12P3LPowxPLvU3xMmUu5OTN4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3fzcVP7rat0n8x9RF8BxuX8rw3gOilrmdw5MWRZqaYEA&oe=69F1FA4F"}, {"file_name": "3.png", "id": "1873208323158475", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031508_1873208329825141_1779798513655927515_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9CoPyma5IAQ7kNvwFCXjPn&_nc_oc=AdqWP-pP5YiEthCxL6UYV5UfHsX9nFPC1hjVtL4SWwtp3nQuaShKnkyj4nsNoJkpuGQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SrgIJSQPt8FQ8xseaM6cESYzdS5mKbmD83sVkTLhSHw&oe=69F20532"}, {"file_name": "2.png", "id": "884875963588999", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982687_884875966922332_5575197405599009106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yg8CKBWVAUUQ7kNvwFxD5Qj&_nc_oc=AdoXlrbZPr8uHKXgCKgresXeRUL5X3H0e6qJFcumvhc1Gs_X8eRiRAoyUZgAv3TsFxo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af299w8YDInobnW6I8YEJYH6gpF4I7TvJm2X4zurEHDZ-Q&oe=69F208C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rogue Pi\u00f1atas: VRmageddon", "keywords": ["roguelite", "roguepinatas", "roguelike", "pinatas", "action"], "long_description": "A multiplayer VR roguelite game. Your mission? Survive the party-apocalyptic world, bashing your way through waves of invading Pi\u00f1atas!\n\n18+ Pi\u00f1ata Enemies:\nThese pi\u00f1atas are somehow thinking, moving, and growing smarter - each with their own enemy behaviors! \n\n6 Characters to Choose:\nAs one of the few survivors, it\u2019s up to you to answer the call!\n\n6 World-Ending Locations:\nFrom your local neighborhood to the treacherous desert, each area offers new dangers and opportunities for mayhem. \n\nWeapon Galore: Master over 150+ different combinations of attack through weapon evolutions 
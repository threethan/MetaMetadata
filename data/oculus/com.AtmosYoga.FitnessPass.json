9E5tcuhamtFV1juE5UYGwt2pQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nso0giCMz1UcTQluQEf2LVZ93rmsDoRMUhr7daNXS3w&oe=6A1EF383"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1633581560919413", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823259_1633581564252746_6579954187090524915_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZfVgIG8sm0Q7kNvwH7_YMa&_nc_oc=AdpuOGI-bNQbt7SL5VsTJj41cY4dUde9gkL4dEw62NuJq-3kG8Ds-kpIpXja6P-wkIc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U6-4eUBsn5DXJFrWG6KLYhKc-a24qQyZEI3ABi_aezg&oe=6A1EEE3A"}, "display_name": "HIIT Studio", "keywords": ["HIITWorkouts", "Workouts", "Fitness", "Training", "Health"], "long_description": "Welcome to HIIT Studio, the premier mobile app designed to revolutionize your high-intensity interval training (HIIT) experience. Whether you're a beginner looking to kickstart your fitness journey or a seasoned athlete seeking advanced challenges, HIIT Studio offers a comprehensive suite of tools to help you achieve peak performance.\nAt the core of HIIT Studio are our diverse workout libraries, featuring hundreds of exercises that target every muscle group. From bodyweight moves like burpees and jumping jacks to equipment-based routines using dumbbells or resistance bands, our app ensures variety to keep your workouts fresh and effective. Each session is structured with precise timing for work and rest intervals, scientifically proven to maximize fat burn, improve cardiovascular health, and enhance endurance.\nWhat sets HIIT Studio apart is our roster of professional trainers. Choose from multiple certified experts, each bringing their unique style and motivation\u2014whether it's high-energy pep talks from a CrossFit champion or calming guidance from a yoga-infused HIIT specialist. Follow along with high-quality demonstrations and voice cues that make every rep count.\nPersonalization is key in HIIT Studio. Select from a range of immersive environments to match your mood and setting: train in a virtual tropical paradise for a relaxing vibe, a bustling urban gym for motivation, or a minimalist home setup for convenience.\nDownload HIIT Studio today and transform your body and mind. ", "short_description": "Discover HIIT Studio, your ultimate HIIT workout app! Dive into high-intensity interval training with a variety of exercises, expert trainers, and customizable environments\u2014from serene beaches to energetic gyms. Tailor your sessions for maximum results, anytime, anywhere. Boost energy, build strength, and achieve fitness goals with guided routines suited to all levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lnk.bio/hiitstudio", "developer_terms_of_service_url": null, "publisher_name": "Atmos Yoga", "support_website_url": null, "website_url": "https://lnk.bio/hiitstudio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26329751093382814"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "958233086969704"}, {"status": "PUBLISHED", "id": "2050971129016956"}]}, "baseline_offer": {"id": "2050971129016956"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780340400, "status": "PUBLISHED", "id": "958233086969704"}]}, "liveChannel": {"nodes": [{"latest_suppo
&oe=6A47BB8F"}, "display_name": "Monster Simulator 3000", "keywords": ["Monster", "Simulation", "Fight", "Action", "Kaiju"], "long_description": "**Go big and unleash chaos and destruction.** As a kaiju monster you\u2019ll smash through towering skyscrapers, throw tanks and swat attacking drones with the goal of making each cities\u2019 polluting power plants go boom! \n\nThis early access release includes:\n\n- 4 kaiju monsters with city-leveling powers. Breathe fire, climb buildings, hurl stones, or bite through debris\n\n{1118877345845616} \n\n- 3 dynamic cities to rampage through, each with escalating difficulty and unique challenges\n\n{930017872069689}\n\n- Hidden mutations to find, for surprising advantages in battle. \n\n{1077483440525861}\n\n- Power up by creating destruction, finding and eating humans and more. Oh, and look out for human cameos as you unleash chaos! Choose if you want to eat them or set them free.\n\n{563099633145292}", "short_description": "Go big and unleash chaos and destruction. As a kaju monster you\u2019ll smash through towering skyscrapers, throw tanks and swat attacking drones with the goal of making each cities\u2019 polluting power plants go boom! "}]}, "developer_name": "Dark Slope Inc.", "developer_privacy_policy_url": "https://www.darkslope.com/legal/ms3000", "developer_terms_of_service_url": null, "publisher_name": "Dark Slope Inc.", "support_website_url": null, "website_url": "https://www.darkslope.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_
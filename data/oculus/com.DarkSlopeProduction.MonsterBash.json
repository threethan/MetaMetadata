-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw2Q7hQHVLS1nqaONV3ipZTLN9wiTNiEExt3YCo1JCWQA&oe=69AC0A58"}, {"file_name": "Select-1_0003_Select-5.png", "id": "540878265590678", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001703_540878268924011_7632827374374231383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_BFwLVcg4sQ7kNvwHfV2QL&_nc_oc=Adn2lvj_7YXp8kbphtFa7CWG01uRoKKMwEGUI1wdl_n5Sc2NGtXukCgJx85vEFmNwO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyWH9gs72NKl7BNW844G_x1Idr63S6aZocA17nXXmetkA&oe=69AC2A4D"}, {"file_name": "Select-1_0002_Select-2.png", "id": "1294026171943194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031437_1294026178609860_1824051935372087529_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzFpw8usfJ8Q7kNvwESHdTD&_nc_oc=AdkRbTdFQN6-1NDUZf9SooKIaI92Pw2zNOKvzRPTIrmp15tGJdWJZbjdtS9-CjgHlAE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx86wYWHzNIrY21Eg3WGAZun3s3lYVV9QFkYUpkmM_6bQ&oe=69AC22B3"}, {"file_name": "Select-1_0001_Select-3.png", "id": "1220057072623343", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/228001694_1220057075956676_7783257490804439238_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5o87hpqEmQQ7kNvwFkSljI&_nc_oc=AdnT639UTxEG7yHVRoM9aNwa8dfzJy4yUVNDp4d5yt7cxmky4swzE23ypM-TXUzXyTw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwBSZkB_VqYcqD4wplnZ7PrHwqhu9n6_VLBmg5vkLo65A&oe=69AC23D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "546637514850681", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_546637518184014_4052343998138358150_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjXd1HiQcHgQ7kNvwFadNaD&_nc_oc=AdmLrifhZ_Iru20F-GddAEvyDJwhIK0zWn_xieSMVyWUHPUjEpzHF0hIClCtcMmJUxo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-CtB13lZRKhFRFmqS5PJqIEFOAGGt4mN_x1HwDj8W-Q&oe=69AC2A8F"}, "display_name": "Monster Simulator 3000", "keywords": ["Monster", "Simulation", "Fight", "Action", "Kaiju"], "long_description": "**Go big and unleash chaos and destruction.** As a kaiju monster you\u2019ll smash through towering skyscrapers, throw tanks and swat attacking drones with the goal of making each cities\u2019 polluting power plants go boom! \n\nThis early access release includes:\n\n- 4 kaiju monsters with city-leveling powers. Breathe fire, climb buildings, hurl stones, or bite through debris\n\n{1118877345845616} \n\n- 3 dynamic cities to rampage through, each with escalating difficulty and unique challenges\n\n{930017872069689}\n\n- Hidden mutations to find, for surprising advantages in battle. \n\n{1077483440525861}\n\n- Power up by creating destruction, finding and eating humans and more. Oh, and look out for human cameos as you unleash chaos! Choose if you want to eat them or set them free.\n\n{563099633145292}", "short_description": "Go big and unleash chaos and destruction. As a kaju monster you\u2019ll smash through towering skyscrapers, throw tanks and swat attacking drones with the goal of making each cities\u2019 polluting power plants go boom! "}]}, "developer_name": "Dark Slope Inc.", "developer_privacy_policy_url": "https://www.darkslope.com/legal/ms3000", "developer_terms_of_service_url": null, "publisher_name": "Dark Slope Inc.", "support_website_url": null, "website_url": "https://www.darkslope.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTIN
-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSK2zM-LymtD8mEQoCQQOzOvmBcdXC7X2JhYEVLMj2tg&oe=69BE7F58"}, {"file_name": "Select-1_0003_Select-5.png", "id": "540878265590678", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001703_540878268924011_7632827374374231383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMA4em6pX6IQ7kNvwGk_kte&_nc_oc=Adm9JK4d9_bHx1peIcHGB4_vSJa5sCYTbgbXQOcSTjutdqVD94tYQLc3opopymGT03E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3S3SXTWpNu-cSKig5S2VhgPMrk5bN1X0ldpnAz7AHdQ&oe=69BE9F4D"}, {"file_name": "Select-1_0002_Select-2.png", "id": "1294026171943194", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031437_1294026178609860_1824051935372087529_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXdFCXE5Rl8Q7kNvwG16QrK&_nc_oc=Adlo96wGea0LMzTAhGn6KtTqmTdoF7kEwU2qIIny92H3-iFAiTBHX-Wt4p9DC2f0iXk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKqLor9efxJldPsxQKdUGHFJM3WJvBD0fasE6TpbvYKw&oe=69BE97B3"}, {"file_name": "Select-1_0001_Select-3.png", "id": "1220057072623343", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/228001694_1220057075956676_7783257490804439238_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDe0iMg2UpwQ7kNvwFDnhRL&_nc_oc=AdmGebPRj6-Z4PXAPLDU6V1VlTF-w_Fwzb8kKZKzsjZ7vas1gSy1ICh1LfzM9uG7hS8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyrk-Y3wfPGNYNx6srw2-_Gnuy8jLVnrjJ_C0RQ7ppcdw&oe=69BE98D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "546637514850681", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974499_546637518184014_4052343998138358150_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUjtwpxAe24Q7kNvwFYbILq&_nc_oc=AdlU1NQElD7AyfUQVZ6hfjqy0Y2-65Gx3686AKpIY8-WC1WoFKlTBsVT9atN0eBQfmk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpiJwsMzHe_GhTswFhSbeSOoHnTBl0Wl7NIAGZeohAgg&oe=69BE9F8F"}, "display_name": "Monster Simulator 3000", "keywords": ["Monster", "Simulation", "Fight", "Action", "Kaiju"], "long_description": "**Go big and unleash chaos and destruction.** As a kaiju monster you\u2019ll smash through towering skyscrapers, throw tanks and swat attacking drones with the goal of making each cities\u2019 polluting power plants go boom! \n\nThis early access release includes:\n\n- 4 kaiju monsters with city-leveling powers. Breathe fire, climb buildings, hurl stones, or bite through debris\n\n{1118877345845616} \n\n- 3 dynamic cities to rampage through, each with escalating difficulty and unique challenges\n\n{930017872069689}\n\n- Hidden mutations to find, for surprising advantages in battle. \n\n{1077483440525861}\n\n- Power up by creating destruction, finding and eating humans and more. Oh, and look out for human cameos as you unleash chaos! Choose if you want to eat them or set them free.\n\n{563099633145292}", "short_description": "Go big and unleash chaos and destruction. As a kaju monster you\u2019ll smash through towering skyscrapers, throw tanks and swat attacking drones with the goal of making each cities\u2019 polluting power plants go boom! "}]}, "developer_name": "Dark Slope Inc.", "developer_privacy_policy_url": "https://www.darkslope.com/legal/ms3000", "developer_terms_of_service_url": null, "publisher_name": "Dark Slope Inc.", "support_website_url": null, "website_url": "https://www.darkslope.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTIN
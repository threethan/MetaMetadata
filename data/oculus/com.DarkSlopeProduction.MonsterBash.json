-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz6tZZMS9711AteCTnQYM6x1yN-cSG8q5nPVXcMqzF_hA&oe=69B2A1D8"}, {"file_name": "Select-1_0003_Select-5.png", "id": "540878265590678", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001703_540878268924011_7632827374374231383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZRRJr23q-EQ7kNvwHcT5UP&_nc_oc=AdkNz2I4E4ppsCDbNMBTMie3B4USEe-amhw0XbwkV6ECN1lrf5lnUhTWwDaciruLBWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwjRQIJO_e1zLWIeHk7fbHuTUzPAvGitvQO3y82pktdUQ&oe=69B2C1CD"}, {"file_name": "Select-1_0002_Select-2.png", "id": "1294026171943194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031437_1294026178609860_1824051935372087529_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-9www9MapwQ7kNvwF4Fq4T&_nc_oc=AdmPDfBenqXDrcE880IcQaoTjg_-6fHYBDVmd60G2tGRjUVKukMRvj1yu7fDCmn0pAk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3duUxkiWSf7dTv_x3ZQ_mGpcmohW9zYzl7DzNyN66Yg&oe=69B2BA33"}, {"file_name": "Select-1_0001_Select-3.png", "id": "1220057072623343", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/228001694_1220057075956676_7783257490804439238_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgqUxAfySzQQ7kNvwFGPUpN&_nc_oc=AdlS-ZLZNeitqgql8hj5PjlCq0pDJPk_QGxAYs2BE-gKOfOQ9Pt61YBITMD0Be07dw4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxNll6yC9iqPRKoXnnUBPvoElHIZXG29Hle3JKHs7Ogow&oe=69B2BB53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "546637514850681", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_546637518184014_4052343998138358150_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pElgmwDy0X8Q7kNvwF4nPH3&_nc_oc=AdkDeTxi7lOu97tdNFQQLWBuuxZ6r5OyUTcqUiPzkmb0ZygJkWesCrtOnRJVKlizCkI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz72lk79o36K19AmP6YQ3VJjWys_WmZnLgcG3oJcZf1wg&oe=69B2C20F"}, "display_name": "Monster Simulator 3000", "keywords": ["Monster", "Simulation", "Fight", "Action", "Kaiju"], "long_description": "**Go big and unleash chaos and destruction.** As a kaiju monster you\u2019ll smash through towering skyscrapers, throw tanks and swat attacking drones with the goal of making each cities\u2019 polluting power plants go boom! \n\nThis early access release includes:\n\n- 4 kaiju monsters with city-leveling powers. Breathe fire, climb buildings, hurl stones, or bite through debris\n\n{1118877345845616} \n\n- 3 dynamic cities to rampage through, each with escalating difficulty and unique challenges\n\n{930017872069689}\n\n- Hidden mutations to find, for surprising advantages in battle. \n\n{1077483440525861}\n\n- Power up by creating destruction, finding and eating humans and more. Oh, and look out for human cameos as you unleash chaos! Choose if you want to eat them or set them free.\n\n{563099633145292}", "short_description": "Go big and unleash chaos and destruction. As a kaju monster you\u2019ll smash through towering skyscrapers, throw tanks and swat attacking drones with the goal of making each cities\u2019 polluting power plants go boom! "}]}, "developer_name": "Dark Slope Inc.", "developer_privacy_policy_url": "https://www.darkslope.com/legal/ms3000", "developer_terms_of_service_url": null, "publisher_name": "Dark Slope Inc.", "support_website_url": null, "website_url": "https://www.darkslope.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTIN
ovide access to additional servers and enhanced performance.", "short_description": "\ud83d\ude80 Secure and private VPN connection for Meta Quest. Connect instantly with free access or upgrade for premium servers. Fast, stable, and built for Horizon OS.. \ud83d\udee1\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ustreamingvpn.com/privacy.php", "developer_terms_of_service_url": "https://ustreamingvpn.com/TermsofService.php", "publisher_name": "AxureTech", "support_website_url": null, "website_url": "https://ustreamingvpn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24783581898006446"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2055471211767049"}]}, "baseline_offer": {"id": "2055471211767049"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778879640, "status": "PUBLISHED", "id": "2055471211767049"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25986252901072667", "version": "3.0.2"}, "id": "259309887143258", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5486059328185325", "is_concept": false, "latest_released_bina
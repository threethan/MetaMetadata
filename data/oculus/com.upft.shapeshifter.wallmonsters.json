=69F75B31"}, {"file_name": "result.png", "id": "898435236182173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619450_898435239515506_1929314706789456380_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOe0C_RYf_YQ7kNvwF4OJ5l&_nc_oc=AdovY7jZpTe1Ibpal5BOiTa5RQ2i2XExEQO_eQNqyrvi0fYIERuQzfQxBfbv0oOEaGc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2OutBEwmyKupgSAaRKe-gH_tWPrYneN9tExgTXV7bHKA&oe=69F73C67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1563253174945477", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619159_1563253178278810_4504840969696443324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5YUVD6rhjkQ7kNvwHkKny3&_nc_oc=Ado1aQmr9tL2kSMEzcbcrsrS_E8DQKqaOj4vgwwKXqdXHEXlAM7bBDa4nR71kjLyjVI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2t6DQKs3pMO5sV9djhRNn0cLRa7f0iISyDHiuEd_WDRA&oe=69F740DC"}, "display_name": "Wall Monsters", "keywords": ["Wall", "Action", "Posing", "Monsters"], "long_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n \nChoose from three difficulty levels: Easy, Normal, and Hard.\nUse your whole body to overcome every Wall Monster!\nCan you withstand this relentless onslaught?\n", "short_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you re
=6AE9EF31"}, {"file_name": "result.png", "id": "898435236182173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619450_898435239515506_1929314706789456380_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EB6Y-yPtC1oQ7kNvwHd-Cps&_nc_oc=AdqXSLFjxRdkmjmVYLn_40DZ16WULC-Dwg4nPP8U-4Fn6aWlbFRsV9LPrnkPGrxnhQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7suvLvGHDolTnlSsavZv6OJA5GQ0h8t_Tn4goljY5Ew&oe=6AEA08A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1563253174945477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619159_1563253178278810_4504840969696443324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qTI4EdUbLwQ7kNvwFeUJvT&_nc_oc=Ado017WQEaRIQjwYAPeOAEgIYf6FL90RPEjNZnuVqKJy9uHUSrj2-Qn6sOmTbLsnn_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWQI4X5liAXNJmgLXV3H-56yg77Bmau31VqBH3VmFHxg&oe=6AEA0D1C"}, "display_name": "Wall Monsters", "keywords": ["Wall", "Action", "Posing", "Monsters"], "long_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n \nChoose from three difficulty levels: Easy, Normal, and Hard.\nUse your whole body to overcome every Wall Monster!\nCan you withstand this relentless onslaught?\n", "short_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n"}, {"images": {"nodes": [{"file_name": "AppIcon_512x512.png", "id": "1963167287862669", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619187_1963167291196002_8623706016118764924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7Pnhj8CGAAQ7kNvwEFbjfN&_nc_oc=AdpK6DbnZsqqlzmUC8gvMFBwx3GVQrz7HRw-AA1YpXx8J8c9kKFVDf0Kitx8y8D1b18&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStEksUqS_NuMM2VWhZ5nBXHX6ovt5EPLCPVREttK03mA&oe=6AEA0FD1"}, {"file_name": "Cover_landscape.png", "id": "1414701440178062", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618277_1414701443511395_2798405465944603676_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMNTbqJ4zRgQ7kNvwFwndfv&_nc_oc=Adri5-WVDBNzVcrT52syniIC1qM1_Jd3UvZt0S8PxzJn1lFcFQO99O424s55g_JglUA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMM9lW1QfXKavHLL09QhtPM24Zb-ITa4Bk1Kypxc8DgQ&oe=6AEA0766"}, {"file_name": "HeroCover.png", "id": "1291863762221604", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_1291863765554937_9147686361582286101_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZF7lnOpUMkQ7kNvwHFvKS6&_nc_oc=Adqtf66O4Tb025QiC9Z4vhtN2maERPAoDYGzs3nemkCxfKQHWJvPRtWDAaqwyVpWWnI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK9YPvcptOKthAvBXAogCF3i16oHWPmpENyUAa1OxwfQ&oe=6AE9E6E4"}, {"file_name": "Logo.png", "id": "1148963270414958", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308222_1148963273748291_7733004916691207047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJBhMLVE3Q4Q7kNvwHD8BPp&_nc_oc=AdohRFwnWR8zqQD-Vz2f2Vxy5MXembvd9jyhW3rDQa6TV80FcUhywPpYEXD_Xk5fCWI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQqXkFeuJpwY
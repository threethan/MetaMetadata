=6AF8A7F1"}, {"file_name": "result.png", "id": "898435236182173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619450_898435239515506_1929314706789456380_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoYUo0_s2qUQ7kNvwGXAEs6&_nc_oc=Adrh7RUaBB0RK1RfNIVDf0t7BS_jGeZA9h58Gr9LZ_4-M65mtQwm256r9IHiZquPBlM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv26gpEKSQZKgUfVeIw9lCu1SK6CZbTjG0FKbJslqaQA&oe=6AF88927"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1563253174945477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619159_1563253178278810_4504840969696443324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_DP_9CfmnMQ7kNvwEUd4L_&_nc_oc=Adr689_Bqp5Ig_g5E7gjptpvAweuQi3sBe_nm8y-K3aGVdEwBKbnmmBFNzND4knTzwg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUYrdptQPwqC_0WcpF2xuUty3mI7Dhtfq6GvHTiVMijQ&oe=6AF88D9C"}, "display_name": "Wall Monsters", "keywords": ["Wall", "Action", "Posing", "Monsters"], "long_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n \nChoose from three difficulty levels: Easy, Normal, and Hard.\nUse your whole body to overcome every Wall Monster!\nCan you withstand this relentless onslaught?\n", "short_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you re
=6AA6B2B1"}, {"file_name": "result.png", "id": "898435236182173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619450_898435239515506_1929314706789456380_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6-tjhadHqMQ7kNvwFQqOam&_nc_oc=AdrnsaSPrA4ZqRTTU6Ge4zLK7Lvk2M-NcD3We4RlO4MtFuWZwLncKEtVxv0yyjC5wBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPTC313VPVb41F73C-TM9_gWq4mbIQJugs7iMkToU98g&oe=6AA693E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1563253174945477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619159_1563253178278810_4504840969696443324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyOqxqZSJPAQ7kNvwF8jSFQ&_nc_oc=AdoytsY0V0o-GyoklJUiWjQxYn1Dual_WiFvj8XGTwhu-GWstXYbCKasKyh7UbKLACE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3DrojHCz_xxpYIXPFyaWtLM24Z5nyA5yqBC4L_gPB7Q&oe=6AA6985C"}, "display_name": "Wall Monsters", "keywords": ["Wall", "Action", "Posing", "Monsters"], "long_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n \nChoose from three difficulty levels: Easy, Normal, and Hard.\nUse your whole body to overcome every Wall Monster!\nCan you withstand this relentless onslaught?\n", "short_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n"}, {"images": {"nodes": [{"file_name": "AppIcon_512x512.png", "id": "1963167287862669", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619187_1963167291196002_8623706016118764924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjQM5ioPJkkQ7kNvwH8Bp1c&_nc_oc=AdpxxttUktQyuHx2vmzSi9q93-UXgcxEJ6uVO_2sLAQEwG2-t4XkYWccQ24hCEd33gs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcFWRXPFr9wc5R4Us6uLdgTi2DSyXPvXU-tK9rHn4W0w&oe=6AA69B11"}, {"file_name": "Cover_landscape.png", "id": "1414701440178062", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618277_1414701443511395_2798405465944603676_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWgNLpPtWPYQ7kNvwGbk5us&_nc_oc=AdqGqEew1iUO37ytOEZoUjqze-b-L-w7soZVswOeHbvvzP63tZ8-EH0tiKpHVVEfJQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwriaK5kaSPsXfhqymOcP6910ghv5Y4hGCiO_NVnLCKQ&oe=6AA692A6"}, {"file_name": "HeroCover.png", "id": "1291863762221604", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_1291863765554937_9147686361582286101_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7OYka_T_6IQ7kNvwE-mZ4E&_nc_oc=AdqC6ETOvCUCJbGtu34oBYiDEWIaGtT9j4ypxG5S1eY5RestpseghnOq_f0otNLvyd0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoXDsTD2UnjhD0QMhipSQ_hJwl-0_WHk1QIq-IdezXHA&oe=6AA6AA64"}, {"file_name": "Logo.png", "id": "1148963270414958", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308222_1148963273748291_7733004916691207047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZcJtzPx8wYQ7kNvwHZQ9Ab&_nc_oc=Adord838T2L1zEiysbuADtpBSnUIOSPsbOkHKokV7pk93ZbWOfQ0ojCl_asdBVvR7oo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5AdE_RwrhGH
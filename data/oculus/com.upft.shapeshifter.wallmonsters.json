=69CD2B31"}, {"file_name": "result.png", "id": "898435236182173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619450_898435239515506_1929314706789456380_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YI0p2F0kBj0Q7kNvwG2ISet&_nc_oc=AdozWx3Jsd8QEP8TNlxspf-gdSzfef-pt0FLYFQJVX81vacRh3NO_4Uk7jV57JnqW2E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPPpINIY0rsr5PgBCjq8tEXEtOUPkCKOB7PJKUCC-8aA&oe=69CD0C67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1563253174945477", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619159_1563253178278810_4504840969696443324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyUURY2i0mwQ7kNvwGjGrVJ&_nc_oc=AdrpiZClgTquoWh5o9eLL497jXxAHkiAcNZvLlOeMRbssqv5bsCPhiGB_V-5Zfg9WgY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwO86DT-eh-r64kqDZjkZCPDKCa6ZSCr9bDc2YUim7gHA&oe=69CD10DC"}, "display_name": "Wall Monsters", "keywords": ["Wall", "Action", "Posing", "Monsters"], "long_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n \nChoose from three difficulty levels: Easy, Normal, and Hard.\nUse your whole body to overcome every Wall Monster!\nCan you withstand this relentless onslaught?\n", "short_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you re
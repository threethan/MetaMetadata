=6AA16CB1"}, {"file_name": "result.png", "id": "898435236182173", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619450_898435239515506_1929314706789456380_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=na4o4uKSIZUQ7kNvwGK6INx&_nc_oc=AdrR7VLvA-1UAY3zPmz0uMCMLdbfPnwzvXdf51GL3TP9ozlpIaKtzaxov40NWddc3wQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9W7FE_rhimBSRKZMYxp3uOE6pfs3AKikMVmPeDgFniQ&oe=6AA14DE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1563253174945477", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619159_1563253178278810_4504840969696443324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LR5q6KT_EP8Q7kNvwGg5PQB&_nc_oc=AdoxMro0AY06HSiA_dwb-5kWywKL_P4XWOR47iW_IjS1WGEqXyQzjr0aePYajz4Pn8w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMiN6WCPYp5Vfl5AziZVUJd_7s74rKsZrj35ZUtvku5A&oe=6AA1525C"}, "display_name": "Wall Monsters", "keywords": ["Wall", "Action", "Posing", "Monsters"], "long_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n \nChoose from three difficulty levels: Easy, Normal, and Hard.\nUse your whole body to overcome every Wall Monster!\nCan you withstand this relentless onslaught?\n", "short_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n"}, {"images": {"nodes": [{"file_name": "AppIcon_512x512.png", "id": "1963167287862669", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619187_1963167291196002_8623706016118764924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NShv6pX8OsQQ7kNvwEjXuHp&_nc_oc=AdrAJDgAaq5gmbAxa1n2HeNXG_uXPdye-AfOybLuV11eXf8z-DgjXYoqQBymRclpwG8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaoXlUr3mf62xaNrMq-oaHgFNavvvZmdQvvWRdd0H0IQ&oe=6AA15511"}, {"file_name": "Cover_landscape.png", "id": "1414701440178062", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618277_1414701443511395_2798405465944603676_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXKp6Id-iUsQ7kNvwF0au3W&_nc_oc=AdoBqgUCjCk-JWW0pyrH_z7tbYJX9vI3XxqpF3AMNIgIlSACR6ESIqbXOtDAcRk5gJo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoVqx9I5-yoESrTMnUhrg78VeEHOfpGG3JCOoHU3OZcw&oe=6AA14CA6"}, {"file_name": "HeroCover.png", "id": "1291863762221604", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618484_1291863765554937_9147686361582286101_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in4BP-SejFsQ7kNvwGkuJjh&_nc_oc=AdpwcYhhK8VzJBA-Jqo7NXwGEVuK788bF8zxLC8oNAonecQuHDcY8scn5KiqTMz3nnY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_-jQtyvnHXAbI-82Y3A_HxEVnVCj-b7Aq6IDroSPiSg&oe=6AA16464"}, {"file_name": "Logo.png", "id": "1148963270414958", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308222_1148963273748291_7733004916691207047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LY1c-NepUY0Q7kNvwG3bte1&_nc_oc=AdpQOmaQEyJ3E9fmLwEDW0KeBZkcMVdiUpMGWFILx9S6duTvcn0YSeFNyR8V6Bp1bUM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNIABX88fFGY
=6A1850B1"}, {"file_name": "result.png", "id": "898435236182173", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619450_898435239515506_1929314706789456380_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJ5HUa9i64gQ7kNvwHF-RYm&_nc_oc=Adqqp-ZW3KAfg-ML3K4yQvXp2qJRSSKXMyApyUvuX_uVq4rvPGEtoXcbg8W7OONkC2g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oTVGhnn_m12iCxISxa6FiXCdh-K1ssxwQEBsNmn5blQ&oe=6A1831E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1563253174945477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619159_1563253178278810_4504840969696443324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LX_2-8wJkqQQ7kNvwHvzLZ7&_nc_oc=Adr1B3mf7aybbKiVqXayq06MaM9xwU1amD2SHMUTGRLTYvf51RbU0Uk5a0GDz3MNNuo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nKiZ1YwoA_ie5oemzjv6HHiVoKo7Ysxj6xSoW6HvA7w&oe=6A18365C"}, "display_name": "Wall Monsters", "keywords": ["Wall", "Action", "Posing", "Monsters"], "long_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n \nChoose from three difficulty levels: Easy, Normal, and Hard.\nUse your whole body to overcome every Wall Monster!\nCan you withstand this relentless onslaught?\n", "short_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you re
=69D7B731"}, {"file_name": "result.png", "id": "898435236182173", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619450_898435239515506_1929314706789456380_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3g-4lv792kQ7kNvwF0XXqt&_nc_oc=Adqa0Cf2LGza3vA_fKyqA_orPXhXBTWAzRIP5TdL_XK0ySJeCcZ5_8IF7V9f2q2FR94&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Of5IZMnWt4v8glA_AFj0YayUJQuJ0W1CMtqKqb2sMXQ&oe=69D79867"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1563253174945477", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619159_1563253178278810_4504840969696443324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOexcxVnMtgQ7kNvwH23trD&_nc_oc=Adphg7i7KG6P6-YDwXdheEeLOVhO3fIuqnsQVSmsSR3kwikyiCnFHX3q4cLKgVzVEFk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QrHQgut_VYYyQpeo6kB_8KCngPlsKjxgekGKAKLuVmA&oe=69D79CDC"}, "display_name": "Wall Monsters", "keywords": ["Wall", "Action", "Posing", "Monsters"], "long_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n \nChoose from three difficulty levels: Easy, Normal, and Hard.\nUse your whole body to overcome every Wall Monster!\nCan you withstand this relentless onslaught?\n", "short_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you re
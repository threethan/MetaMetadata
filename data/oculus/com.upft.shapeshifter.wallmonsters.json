=69DCFD31"}, {"file_name": "result.png", "id": "898435236182173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619450_898435239515506_1929314706789456380_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCzPLyd16KgQ7kNvwFnNw9L&_nc_oc=AdoOOpcES-SJgoVeLr2m1JiUVzFnu7FKxb-ZixyIB21MWhzTmHiiq3GYqPi1JIoCLww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Dx2wDmxR9piZvy55oE98R5sgL2woquxVXmrVTeIDz4A&oe=69DCDE67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1563253174945477", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619159_1563253178278810_4504840969696443324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tX-2Cz0-0AQQ7kNvwE0yg6h&_nc_oc=AdriIWcrl5EyyDdiwFLLkYqlk3m_mlhJTRa_GYQa5_n5jJlGk_YWiSuVYMKDfFcrCHg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ibJ_YKPMsaozBwVxMlZ1eFFgyXplxTwu4XG2BLe-ZaA&oe=69DCE2DC"}, "display_name": "Wall Monsters", "keywords": ["Wall", "Action", "Posing", "Monsters"], "long_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n \nChoose from three difficulty levels: Easy, Normal, and Hard.\nUse your whole body to overcome every Wall Monster!\nCan you withstand this relentless onslaught?\n", "short_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n"}, {"images": {"nodes": [{"file_name": "AppIcon_512x512.png", "id": "1963167287862669", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619187_1963167291196002_8623706016118764924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ap_O62AAra4Q7kNvwG-1-5s&_nc_oc=AdpZkjZxPy6zlcXxWCXJD-IzdihSzKnOEY0dCfPn00d1AAwqp6hlzMs4ZJvwCmBDwe8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dqTqk5H3gN3OJMImH2qGSMBRem2ZXUjVZEGQeInvWsA&oe=69DCE591"}, {"file_name": "Cover_landscape.png", "id": "1414701440178062", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618277_1414701443511395_2798405465944603676_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YS0FHvwOZh4Q7kNvwGTkPqe&_nc_oc=AdoH78rUJurQSiLSY-rWpRZ5qd_YM_bnGSckgOI16Z2wf0SCrnv2YwIZQEArVX2MfHk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GqcR1oU7SnYoGtE3Cxh0QEJ0n0-tD9toRsR8P65lFng&oe=69DCDD26"}, {"file_name": "HeroCover.png", "id": "1291863762221604", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_1291863765554937_9147686361582286101_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TI5OtkqEYz8Q7kNvwH3s_p7&_nc_oc=Adq4HV7QKFcocMi5MCUg3UdruWy2A9x9KuRq87pNiHoErHYSD2o6e3umGeijYuQskvg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07FfK_biucpSyDfTsw1H6ZB8Hj3LvJaIHZL0P4-_I1fQ&oe=69DCF4E4"}, {"file_name": "Logo.png", "id": "1148963270414958", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308222_1148963273748291_7733004916691207047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ggm8BddKbc8Q7kNvwGjGXbJ&_nc_oc=AdqDgWmVnaQek0TyKaym8-ogNJKv7c9IahFa3_AmBB4UXbhoj_TpTehGfHu8nXxhiI0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Bt_bOb6hyIb
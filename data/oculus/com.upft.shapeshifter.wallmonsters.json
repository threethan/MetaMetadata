=69E24331"}, {"file_name": "result.png", "id": "898435236182173", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619450_898435239515506_1929314706789456380_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuerIXuAQCQQ7kNvwEpQECJ&_nc_oc=Adp3ieMYO5kgi9OqKz1t1YZhIxCXyNfUNcWkWwNy1F_Kv1ozrCrWDYZ4ltFQ72aVcPI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ajbjyT5gBTDHbpNLOtLX02TdnV9Ju0l3stxJpIyasMg&oe=69E22467"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1563253174945477", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499619159_1563253178278810_4504840969696443324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKbWyHAYNusQ7kNvwErdeb6&_nc_oc=AdodoJkln68GiT1z3Yy2ztpLTil_kqrBwJvol8X4TREezPdvEFQl2GuQCex81JxMuEo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gY1o9KiLY0Iyy_4bjrR-2veVW5PdkrTMi6CufO9km1w&oe=69E228DC"}, "display_name": "Wall Monsters", "keywords": ["Wall", "Action", "Posing", "Monsters"], "long_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n \nChoose from three difficulty levels: Easy, Normal, and Hard.\nUse your whole body to overcome every Wall Monster!\nCan you withstand this relentless onslaught?\n", "short_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you re
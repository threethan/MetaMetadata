=69FDF2B1"}, {"file_name": "result.png", "id": "898435236182173", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499619450_898435239515506_1929314706789456380_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KutAnepTacYQ7kNvwGsw4hx&_nc_oc=AdqxC0nkvbgKxpt_jq52g0nWALXNmZ9DITE2ersDF2wcpZ4H0FVydDDZqdY7geEmX0g&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nU1mNvbqUkQpjxshuG7kpYulFbZT0KCd218mWCv9mPA&oe=69FDD3E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1563253174945477", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619159_1563253178278810_4504840969696443324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meicU-M-RiMQ7kNvwGaiTnk&_nc_oc=AdqBD_RWGkqz8mcSHIXNSIpTtVk7owPn-mdRMHO1R2kWtUESJ4wWKD1Z9YtVySaYhY8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lpmXHviLSq4NqR49MwK0UlXUW2EsWpkLnDx2eesKuTQ&oe=69FDD85C"}, "display_name": "Wall Monsters", "keywords": ["Wall", "Action", "Posing", "Monsters"], "long_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n \nChoose from three difficulty levels: Easy, Normal, and Hard.\nUse your whole body to overcome every Wall Monster!\nCan you withstand this relentless onslaught?\n", "short_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you re
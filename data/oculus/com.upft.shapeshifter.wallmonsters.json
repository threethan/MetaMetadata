=6AEDE3B1"}, {"file_name": "result.png", "id": "898435236182173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619450_898435239515506_1929314706789456380_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeDq562UsLkQ7kNvwGCdxcZ&_nc_oc=AdpesYY47FwR9qGDXNOh_8P1A50fbmTDhAEKXmnAQwgo0rwuO6d5Nwm-FIKQaYWvvH8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_hlqROIZ5jjoW0XmVWTXmmF-6KinG8aAFtoxY-6FP-g&oe=6AEDFD27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1563253174945477", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619159_1563253178278810_4504840969696443324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYkWqzQJyy0Q7kNvwFNUm85&_nc_oc=AdpiaMnPBBQ1dSKx7_bfehuXQeaYMmPDvzakhj3BJjqoW1Sr6b-wK5zhx_ZL-lXqm_k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVXDEEk4PtD8rd81VV5WLt-J45UWF8RpnuVOWmE23uuw&oe=6AEE019C"}, "display_name": "Wall Monsters", "keywords": ["Wall", "Action", "Posing", "Monsters"], "long_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n \nChoose from three difficulty levels: Easy, Normal, and Hard.\nUse your whole body to overcome every Wall Monster!\nCan you withstand this relentless onslaught?\n", "short_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you re
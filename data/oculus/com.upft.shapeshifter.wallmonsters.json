=6ACF9131"}, {"file_name": "result.png", "id": "898435236182173", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619450_898435239515506_1929314706789456380_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkckgThiWk4Q7kNvwErWPnw&_nc_oc=Adpc6qhVeclc9NexAN_64K4uTpcP6zIpFklq-U1hcg2dwQWzSdM9HXeaFDs7S7HKXYs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBSOMqIfbasQ8ovXAl4oin53o3ctzC53XxToqhhwxPBw&oe=6ACFAAA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1563253174945477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619159_1563253178278810_4504840969696443324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bavi7SdNelIQ7kNvwHu9XrG&_nc_oc=Adre_hokcE7Eybcr2mIrNkVocqmha4eq_1a62SxuvKJSJlMwrg-GFQd26rkxuRbQoC4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmw_TQG_vWCi38Arp0ilMfb6XJsSQRSvMpBxMPKCQPJA&oe=6ACFAF1C"}, "display_name": "Wall Monsters", "keywords": ["Wall", "Action", "Posing", "Monsters"], "long_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n \nChoose from three difficulty levels: Easy, Normal, and Hard.\nUse your whole body to overcome every Wall Monster!\nCan you withstand this relentless onslaught?\n", "short_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n"}, {"images": {"nodes": [{"file_name": "AppIcon_512x512.png", "id": "1963167287862669", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619187_1963167291196002_8623706016118764924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MseNK65c8QkQ7kNvwEryiBQ&_nc_oc=AdqkUzGoUo1Js7e7sm8Nm_p-GzZus0rxUlSfz3viACI4GaIciWYNlKyaGIh_6qUuib8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjQvqga1902wGDExoyIcnf5eQBZ6cUzz2njadzfplucg&oe=6ACFB1D1"}, {"file_name": "Cover_landscape.png", "id": "1414701440178062", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618277_1414701443511395_2798405465944603676_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t39jAMm41moQ7kNvwG-4BXB&_nc_oc=AdpJAlCePXW8qd8jQBJK6b7_p3oRZbKahjQ-yV0_QbwCR8CbOa99aXIxftqXDBLSams&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqVy5dImHZCGwYyC9dt7iXOn863lg_6JZhY1FVEKf4aw&oe=6ACFA966"}, {"file_name": "HeroCover.png", "id": "1291863762221604", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_1291863765554937_9147686361582286101_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGz2kRNjZYAQ7kNvwF8qb-Y&_nc_oc=AdrtcjAhWkhHnQVmdLEylFsZnDaGAwAa4pm5EZb-k2UkLWUYgUBaWhhG58Z07xN4K38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmwL-ry2XjHm-fwzhbg0rZdXTUdJV6MpD_9BnHF-nmjw&oe=6ACF88E4"}, {"file_name": "Logo.png", "id": "1148963270414958", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308222_1148963273748291_7733004916691207047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tnv-NONfxcUQ7kNvwE5YHFn&_nc_oc=AdoW-bunydyWQva5u9yKh0b1rIYCS6q0cxLvkd8om9huRJmqRhS_blfIRCjBnHHhZb8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMO1PqX2_Huq8
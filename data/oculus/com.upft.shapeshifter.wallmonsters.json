=6A0C7331"}, {"file_name": "result.png", "id": "898435236182173", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619450_898435239515506_1929314706789456380_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUwcXFF4JMIQ7kNvwHU8x7Z&_nc_oc=Adqwm_zSTKC24EiovLQGxi4ZUqmGWl4ETlRwgxDWjjiHMuRNnDyUMdfzSr70d-37_aM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uRxF2LUXAC0eN3K_wOX9Cz-Kb_w-UpFUoMARc4gSVOQ&oe=6A0C5467"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1563253174945477", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619159_1563253178278810_4504840969696443324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13BIN0BX-XQQ7kNvwEfenHL&_nc_oc=AdqTUUi7Gyycuby2CiF0DgoC7gN_lqOmmqUnPVDOTTWfk8p0_KrfYeHi6w8w8hZiHk8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ibNPQi0JoI31OA70up-8tjX_FoDO3TO7bu1ZeHp2i0Q&oe=6A0C58DC"}, "display_name": "Wall Monsters", "keywords": ["Wall", "Action", "Posing", "Monsters"], "long_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n \nChoose from three difficulty levels: Easy, Normal, and Hard.\nUse your whole body to overcome every Wall Monster!\nCan you withstand this relentless onslaught?\n", "short_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you re
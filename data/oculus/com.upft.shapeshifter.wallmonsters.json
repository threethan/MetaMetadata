=6AC8F9B1"}, {"file_name": "result.png", "id": "898435236182173", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619450_898435239515506_1929314706789456380_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPvhBK2qX-gQ7kNvwGkssMS&_nc_oc=Adq5ALvihkUGc_HFsubPPFpzbBDVXTRv31qxjei-JNzXhkhckw_aOn_x44yotyWLTSE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi57cpOnSSAbRr_wbkZW3q-gm3FpcAB0PIbW5JPD7guQ&oe=6AC91327"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1563253174945477", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619159_1563253178278810_4504840969696443324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpEiwHRpxbcQ7kNvwHbm1KC&_nc_oc=Adrd8jQ1r8-yr2le5gmDlnsQxFNBb5Ohg3Cy10t52_9X9MzO9HOZuz5nNnlqM9m6faY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeLLY6WoL1vfKz1gHbKctY3LmsgycK9rzSL97mZ4rYuw&oe=6AC9179C"}, "display_name": "Wall Monsters", "keywords": ["Wall", "Action", "Posing", "Monsters"], "long_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n \nChoose from three difficulty levels: Easy, Normal, and Hard.\nUse your whole body to overcome every Wall Monster!\nCan you withstand this relentless onslaught?\n", "short_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n"}, {"images": {"nodes": [{"file_name": "AppIcon_512x512.png", "id": "1963167287862669", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619187_1963167291196002_8623706016118764924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyBTZFFBH-kQ7kNvwGzlO1c&_nc_oc=AdqsA_FI_4bvSBBv7swu5y9geCrA15AhfMFnmC-OIJ7TwHDuxMMJZMYpD7xp03GmSNc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbu4oq4YsFj6APctWlXHzIvZ7c4hQln7N9iscUgRM8fg&oe=6AC91A51"}, {"file_name": "Cover_landscape.png", "id": "1414701440178062", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618277_1414701443511395_2798405465944603676_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfwIQ9In690Q7kNvwGlDtwv&_nc_oc=Ado1yshPP4j_qS2GF7taoP6gJ5Lxn2vBqYlPMk3chWv8HBMedVWyKRgUbf7-zY1lHis&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA8pRdVztxVUTtGOIIdcyp27uSDaYPtzgsXBzfy95M-A&oe=6AC911E6"}, {"file_name": "HeroCover.png", "id": "1291863762221604", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618484_1291863765554937_9147686361582286101_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wiq2uXYETmsQ7kNvwHltnx0&_nc_oc=AdpnyAMswZ11WQnMHLU7t-vMD-Q5YRgYO6f3apCWRFkXSQetr00gUJLD-24ua6GuOyY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoibNoTVKMCS_d-8Y46Lr6cytsTY0lwZtbyQaplHbBBg&oe=6AC8F164"}, {"file_name": "Logo.png", "id": "1148963270414958", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308222_1148963273748291_7733004916691207047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJQ5swJ5k8kQ7kNvwFoYBbp&_nc_oc=AdoZcMPW2hcdYK3nlhXVTRadX5oYYHXfQLq5KiTEu9zOhS69JZrO8H42hA_lcU0BtXE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMw5MOLxatYA2
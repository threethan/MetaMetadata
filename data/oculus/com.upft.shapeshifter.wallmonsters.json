-Ki8ngRqXX0vdEKiOA_Gw&oe=6A22DCB1"}, {"file_name": "result.png", "id": "898435236182173", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619450_898435239515506_1929314706789456380_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLPT6V8wCpwQ7kNvwH0Q1z-&_nc_oc=AdrkB6i8e8dI3Rb9e2mMkBZJvpzP7GwXaQIVxYTdRvtG5f9VAu43GoCpFRtKVEFv6HE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kcuFORcioj5s7llc2lDCIe71MDI8ypJ8_qW0XqkOWig&oe=6A22F627"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1563253174945477", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619159_1563253178278810_4504840969696443324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmogLWV2MPsQ7kNvwHiWJBK&_nc_oc=Ado37sTo6wILRsfepST1oCyfvNLckC51XP15_yAefWpyOuPAahqnEeMgy3EtfCpOVXY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mqmuLvJnObq_gRzw3QTtbdWw611ODEwRl_M1gTZZsZQ&oe=6A22FA9C"}, "display_name": "Wall Monsters", "keywords": ["Wall", "Action", "Posing", "Monsters"], "long_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWall Monsters come at you relentlessly from the front, back, sides, and even above.\nStay calm, move fast, and aim for high scores and combos!\n \nChoose from three difficulty levels: Easy, Normal, and Hard.\nUse your whole body to overcome every Wall Monster!\nCan you withstand this relentless onslaught?\n", "short_description": "Wall Monsters is an action game played by taking full-body poses.\n\nNext thing you know, you're floating in space.\nWait\u2026 is that a wall coming straight at you?\nThe Wall Monster is closing in\u2014!\n \nQuickly analyze the shape of the wall and strike the perfect pose to slip through!\nWa
cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5YLxV7JtxgQ7kNvwEUMkEF&_nc_oc=Adrcgq8Z1vtI_nv4vaFlmOcMk_9zrjrECth27kl2rfa0AaXpXJQwIzz7VGwJVQcf9Ms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vL7c5opURvVpjhnTNaKn1bGmCuwptSNKbxgU_RpX5Xg&oe=6A37FDB6"}, {"file_name": "New Project (7).png", "id": "798350516559597", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623443_798350519892930_1560081321232217765_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRp38Xt_O6YQ7kNvwGnWFmH&_nc_oc=AdqTkCCupgdzzo1GFdGPhCbSnPTCKd2QAIOCojOjpFQMdKrDbBgc6dQsjIPGx0hVi1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Fy_pxdP5TCjl_Oo_qobWRK_N_yd845ogeDeG5A5Q0jw&oe=6A380A18"}, {"file_name": "New Project (10).png", "id": "3731861303783780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623295_3731861310450446_5348136877483091074_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=881X5lR5_cMQ7kNvwHdz3ip&_nc_oc=AdpELOp7LB8ECShH9nlq2zqg_fYmTGzul_I1vv76iVdhcrRzvjygtHOcQcjciXnuIWQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8m4XUQNaL0GwKBVgV_o3zo6XQm86_DbTj8rQdjDD6HAA&oe=6A37ED2B"}, {"file_name": "New Project (11).png", "id": "1914260709196193", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_1914260712529526_2259095922812246388_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jyVBd33VJcQ7kNvwGh66EB&_nc_oc=Adp026Vo5tBUj-d8b0g4nGPPXLLJvZ-8KT3oKq6apuBKHCx-7E1LfrXDhnnzzthY8qg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OAFWGybJPqyWnM5Enjw5StV8oq2WmmPM8720dQfgKRQ&oe=6A37FC25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Whispers of the Wendigo", "keywords": [], "long_description": "Whispers of the Wendigo is a multiplayer VR horror survival experience set deep within a cold, haunted forest. Trapped with other players, your only objective is to survive as long as possible while an unseen presence stalks you through the darkness.\n\nExplore the forest to find safety, follow distant sounds that may guide\u2014or mislead\u2014you, and decide whether staying together or splitting up will increase your chances of survival. The Wendigo lurks beyond the fog, watching, listening, and striking when fear takes hold.\n\nBuilt from the ground up for VR, Whispers of the Wendigo emphasizes immersion, proximity voice chat, and intense psychological horror. Every footstep, every whisper, and every scream matters\u2014because in this forest, being heard can be a death sentence.", "short_description": "Whispers of the Wendigo is a multiplayer VR horror survival game where players must endure the night in a cursed forest. Stay together, listen carefully, and survive for as long as you can while something hunts you from the trees."}]}, "developer_name": "TheOfficialTuck", "developer_privacy_policy_url": "https://sites.google.com/view/whispersofthewendigo/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/whispersofthewendigo/terms-of-service", "publisher_name": "TheOfficialTuck", "support_website_url": null, "website_url": "https://sites.google.com/view/whispersofthewendigo?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24623067627369861"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "889222786796090"}]}, "baseline_of
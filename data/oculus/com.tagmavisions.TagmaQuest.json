opy", "keywords": [], "long_description": "This VR multiplayer simulation was created by Tagmavisions for lumbar endoscopy training. The app is under development in collaboration with University of S\u00e3o Paulo Endoscopy Specialization Course. Medical image reconstructions were included in the virtual environment and the main activities were included for puncture and approach training. A multi player environment offers conditions for real time interaction and case discussions. Funding by FAPESP (2020/05306-4). Obs: Any off-platform monetization of content accessible in this app conforms to the Oculus Bulk IAP or Subscription Licenses app policy outlined here: https://developer.oculus.com/policy/app-policies/", "short_description": "VR multiplayer simulation for lumbar endoscopy training. Developed by Tagmavisions in collaboration with University of S\u00e3o Paulo Endoscopy Specialization Course. Funding by FAPESP (2020/05306-4)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tagmavisions.com.br/online-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tagmavisions Treinamentos Digitais Ltda.", "support_website_url": "https://www.tagmavisions.com.br/", "website_url": "https://www.tagmavisions.com.br/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1030075917663237"}, "review_me
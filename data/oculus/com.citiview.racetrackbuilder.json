-ord5-1.oculuscdn.com/v/t64.5771-25/499623111_2147987122741192_3227670610243864448_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TB2t0VUB8eEQ7kNvwHr3q95&_nc_oc=Adq8xfc7lvjxOnU5E6Duc-VB-g3n-8HGIXMSxUGAH8IFG6QzA_YGPe3aiJYh8gbvSQw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzQHRCeWt4rr9G5O-q5ZYJDxiMZRNpIapZVk3eHDNl3Q&oe=6AFDAD85"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1601985561620956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628050_1601985564954289_4285912568655179525_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fl3TT9H8lFEQ7kNvwGlfEK4&_nc_oc=AdqugnaqIIZLSM7tzAzKfmQeSsVf59a0_arpln78esydZd3cyKugZZiBUnRS3ID8BoU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV9EDhYntplbGs0WnyZzKWZnePCMGuIE6LChs0x_Yn6w&oe=6AFDB04C"}, {"file_name": "screenshot_4_2560x1440.png", "id": "977384908718232", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622195_977384912051565_8071875755796276533_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqRwCFiDmZ8Q7kNvwHCpdJc&_nc_oc=AdryNk0qCIvelJ2RCWIrBS93McENIcLjbe8XxX68Efp0kIocDKO_Jq86z692fR9J5wk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-99e_AL7DOqOi6vJATEeCKc-59xtIWbI_lmpVlAIX-Q&oe=6AFDC3DE"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1384772717187247", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620403_1384772720520580_7682020222865660194_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LY831j6he5oQ7kNvwGWKpCq&_nc_oc=AdpE63lk8e5vlJQYwnvQYcNkNTSaAD8c1vMeaCZNbFt7eGPrfHZDdwmK-mP3Vpd3gS8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAh2_b3EpQhb9aBbBzYMVYVrFktPMrQwQ2HJGIb7q0xg&oe=6AFDD737"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1413057186885180", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604360590_1413057190218513_3279807436463333710_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqYsJKkHUg0Q7kNvwGeQvTR&_nc_oc=AdqtWp4SHkULvTha3PNjHa0bob5RoiK8uNKXodj15A7KovArAVxeThc5nsscjDHnP-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ0aDzhnmW-UzLb_0p0stMO2b3v-kBCqu_OOdRqW2v4Q&oe=6AFDE2AB"}, "display_name": "Race Track Builder", "keywords": ["racing", "cars", "track", "builder", "sandbox"], "long_description": "Your circuit. Your rules. Your race.\n\nBUILD\nPress Y to open the round build wheel. Pick a straight, a corner, a hairpin, an S-bend or a lane shift and aim it at the end of your road - it snaps on perfectly. Add a start grid and a start gantry, climb ramps up onto bridges and send the road over itself with an overpass. 24 road pieces in all, including big bumps and speed bumps.\n\nRACE\nPoint at a car and press A. 3-2-1-GO, and the trigger is your gas pedal. Brake for the corners, climb over the flyover and hold your line against rival cars over 3, 5 or 10 laps, or race alone and set a track record. Take a corner too fast and you are off the track. Your lap, place and time are on your wrist.\n\nTHE SKY GARAGE\nBuild on a 60 metre floor in a penthouse motorsport club high above a sunny city: a glass wall onto the skyline, supercars on turntables, a pit stop cafe, a lounge with a giant screen, sim racing rigs, grandstands and a winners' podium.\n\nMAKE IT YOURS\n12 race car colors, grandstands, pit garages, banner towers, checkered flags, billboards and trees, and four circuit styles: grass, desert, snow and city.\n\nStart from three ready-made circuits - Grand Prix, Speedway and Mountain Pass - or an empty floor. Undo, auto-save and music included.", "short_description": "Build your own race circuit in a penthouse motorsport garage, then race it. Snap together straights, corners, hairpins, S-bends, ramps and flyover bridges from a round build wheel, put race cars on the start grid and squeeze the trigger to race rival cars over 3, 5 or 10 laps. 24 road pieces, 12 race cars, grandstands and pit garages, four circuit styles and three ready-made circuits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-racetrackbuilder.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-racetrackbuilder.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1326146143911582"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620559_2707692669677963_8085010651697519281_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkBSHapq_2YQ7kNvwHC1WMb&_nc_oc=Adrn-l_hEnA0EcdeOtYRim1YcNSE0I44e534rOVSePeNOZq6n3YgDoYfhI1D9fkSQh0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-wJzs4Gyhj73DGcc3U1ueK73nY6UYEIMB0lxr867Dgw&oe=6AFDBDAC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Race Track Builder", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1789734480, "las
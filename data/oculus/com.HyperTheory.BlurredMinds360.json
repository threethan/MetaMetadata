n.com&_nc_ss=7f20f&oh=00_AQLfUpA7RikqNXCRMrUQsHGJCh18V4lzD1-B_b4afi6fnA&oe=6ABE5BEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blurred Minds: Virtual House Party", "keywords": [], "long_description": "\nExperience a VR house party simulation developed by the Blurred Minds team from Social Marketing @ Griffith, Griffith University.\n\nThe VR House Party is a gamified drama that unfolds at a teen house party with a range of storylines determined by students as they watch and drink \u2026 or don't drink. The VR House Party is an immersive 'choose your own live-action adventure' where users become the directors.\n\nBlurred Minds has been built following a decade of research and development. All Blurred Minds resources have been co-created with students, Health and Physical Education teachers and alcohol and drug experts and built with the support of game developers and curriculum consultants. Extensive formative research and ongoing development have allowed us to create a cutting-edge alcohol and drug education resources that are evidence-based and effective.", "short_description": "The VR House Party is a gamified drama that unfolds at a teen house party with a range of storylines determined by students as they watch and drink \u2026 or don't drink. The VR House Party is an immersive 'choose your own live-action adventure' where users become the directors."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1VmwdihcDXm2mZGR4GJ93zhRVRzjEA3uM/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Hyper Theory", "support_website_url": null, "website_url": "https://www.blurredminds.com.au/free-resources/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_
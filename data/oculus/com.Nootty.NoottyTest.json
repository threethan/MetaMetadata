cbau0TNE3bVySGevzdMuZ3JOWQ&oe=6B0C6103"}, {"file_name": "com.Nootty.NoottyTest-20210210-150455.png", "id": "266554814820147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572923_266554821486813_8465835489645455722_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrjXhIihkyQQ7kNvwGsRnAu&_nc_oc=AdqNQubXk_Z9koBkqJjnaxFmOuKDXiKNorQlBxmHgXUUcYEPUAP5D9JvXmHysPed03Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQReb4kr2S0VHm-DUm5tTPLR62kE8Lx1FT6bQcXOQ7-S8w&oe=6B0C5D0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2q51cuKIBgQ7kNvwGLCWzQ&_nc_oc=Adq49TvZI095OgjIbw_JL39ELubiKzn6CEdHntfwcCnMqu7KSWBl6dLwY8R2hvIJCaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR9TKx3LXvWGGtzxdZIZ60R4qXgtslg6bSo0KJZzCtfcA&oe=6B0C6391"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXW7NVC-9pwQ7kNvwGMFFku&_nc_oc=AdrCidOdEuu8l_v-ltLfmPJwkSRsZcmVLmwMn0r2pjWeLrHdb9Ydu033hU1XxAJa_ac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaVe8ixxu32HAFq5yNoIRltg3Re0RAfDRFIkP2bWIrRQ&oe=6B0C7E1F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031427_710847756257633_4920996515863165822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BqZcibA0yYQ7kNvwE0jTmt&_nc_oc=Adpdm0MDUC7UHX91QaPcdrwaVXBWca6KGCTTPXOlO4Se9NgbUXIMuGEt5JIzkDTVi4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRVBjP1CAn0XI7JOGlix7YYl5lArPZrv4yqgx4xnnKZlg&oe=6B0C4DD1"}, {"file_name": "Nootty(2560x1440).png", "id": "252757496304678", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75443244_252757499638011_5051225089560449728_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzeL85aeYmkQ7kNvwGJHoFp&_nc_oc=Ado5s0ZeaJRIphBXiBv0jaiRmSOnePIpZSA2yRtLHkxSq4rmXAYH__N5JWh8wcpzhMs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQenFhi91308Z6BFOwWTInPIeNV3uusi6F7MgJHp8tHNg&oe=6B0C6EE8"}, {"file_name": "Nootty(1440x1440).png", "id": "179994250147513", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982488_179994253480846_100820845935342575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phxJ9OrXEzgQ7kNvwGS02Ip&_nc_oc=AdobO4Bsy9Rp9Dkj5p3gvTtnCjMuQNFUnqx79ACdegBzDZoxsBFAXCwIDWEVjCBD_Q4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ-j5WSPJxnX0E3Plsk3YfKr9PxnvsxgyV4vbBDS3KAmg&oe=6B0C5C1E"}, {"file_name": "Nootty(1008x1440).png", "id": "164451818615369", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75297584_164451821948702_721346520530735164_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHGjXt9TmJgQ7kNvwETBVF_&_nc_oc=Adq7fEkng6LplbQMmm9u5-7eRtt87jNyPpEeJFOGU8oEfADlgFEGeTrk-2B-c9TYRQk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQF7SRIZIp7ZGZ2FBlC-AdEpkTKiPEPtAftty9UrUuSSw&oe=6B0C80A8"}, {"file_name": "NoottyOculus.png", "id": "248589113344273", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75441573_248589116677606_9018835002442137465_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Shq1fHq5-sEQ7kNvwHppLMU&_nc_oc=AdrHu7qY5V8EpVmLrpIVAJP_PRwrT7yPJEwh-TOm_7yMhafDqWluxpttmLxW0_mgM-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSrUc5Sid6qnU2O5WRJvh4ROPcBTIMF4cBjdS0cLVT7-Q&oe=6B0C5DF3"}]}, "id": "782017002411087", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nootty", "keywords": [], "long_description": "Gr\u00e2ce \u00e0 l'application et au casque Oculus Quest/Oculus Quest 2, les professionnels comme les clients finaux peuvent voir leurs projets d'un tout nouveau point de vue.\nChangez les couleurs, les textures et les mat\u00e9riaux directement en VR et partagez votre exp\u00e9rience avec d'autres utilisateurs.\nConnectez-vous \u00e0 diff\u00e9rents projets avec 2 autres personnes ou plus. Parlez et interagissez pour faire un choix et d\u00e9couvrir ce que veulent vraiment vos clients pour leur futur int\u00e9rieur.", "short_description": "Nootty est une application \u00e0 destination des professionnels de l'am\u00e9nagement d'int\u00e9rieur.\nL'application leur permet de visualiser leurs conceptions en VR et de plonger en total immersion avec leurs clients afin de leur offrir une toute nouvelle exp\u00e9rience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nootty.fr/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Unity3D
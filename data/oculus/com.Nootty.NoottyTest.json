drfZOpL8Z7v6H_kfhLoJXTa1KwZNeSec54wvuAIaT5F6ih1LISHrBNbf5od65BytB4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHiBBKBz9SZoZfTbFc7rXErAWD7uw4WXwph3-mJRioyA&oe=6AF9E80E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94CVfY5mwrcQ7kNvwE5YIg6&_nc_oc=Adp-_7gzJ6Ptu0wV-xscKnY04q7L0Wam9wIq_EMyYYplsO6w4elOPvNPtzPVlA7JX4A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAU4-jdR71XSsgzm9YrU8eIjYMRkM2rG-0P38R8Z6ExQ&oe=6AF9B651"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0c7773rsrgMQ7kNvwEp4KHV&_nc_oc=Adr4FeNZa9fUi9iH23Bes7BYwgwMXxadmdgxdAuHNMLnzsdkOMlZheBHDUmVNS4g15U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZlhvsHApB8rXx0Ca240QJXFfWpLYQs5oDybVsKs7lvw&oe=6AF9D0DF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
doLpXBEjIwgIkrOdPskZk1XQ7zyfTsQDo3yhkLDqKsuONkXWrJsw-I8PqrB-7GPPz0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOL7Xgj7gwWDs3lo7OXltnqIsS8Yfn2le3uK8s7yhnqxA&oe=6ACD150E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTYr6u4SgD8Q7kNvwEN8-MX&_nc_oc=AdqQQMKPN160XN-5Ri4lyUgkP78GQAJ3gDHm8LDkTB_mQ1iBO4RwljHWM5HPTi-AC7w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOh2TJUhsLFzrho7S94SCCPJcBqY2uOAZ_M1gsd6lBiQ&oe=6ACCE351"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gg4A3fGo3-oQ7kNvwH9jdny&_nc_oc=Adrah4K6DsOee5Ngfxdws2P3uoXr3B0gQoq9oxYrzV66th7ta-DF15CCgmEV8ZoqbiU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJoWjN7WfdQAk4o3Dg7oCtyKFxXLLRc_uzg1C54i2H8Q&oe=6ACCFDDF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
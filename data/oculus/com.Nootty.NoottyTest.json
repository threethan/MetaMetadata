By4yKVT41r_vXPKcWGLfbY3MAA&oe=6B0B0F83"}, {"file_name": "com.Nootty.NoottyTest-20210210-150455.png", "id": "266554814820147", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572923_266554821486813_8465835489645455722_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrjXhIihkyQQ7kNvwF1vk1P&_nc_oc=Adp7mp0RgCovM1XNi4UaU6XVERM3RhmQ3C9r8ei8XIKVmsZ41_FNCegpOJqrz1IumHc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQL0xch22Gem_pfmdIIpHjHoOrEbwsXHwekQwOzPuLsNw&oe=6B0B43CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2q51cuKIBgQ7kNvwFLAmz-&_nc_oc=AdoIFVqCrixMMeHNDz3iWf-oUXnN-FaGY0isF-qZR0OcWm0cJR_ViqGKc-KJ5aHC4Os&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQReJ51SCe202G9DdN7TIRCVyjHG4e9L8Xj6lr9DvOHtGQ&oe=6B0B1211"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQ7Ub7xZpRAQ7kNvwGYMNFt&_nc_oc=Adp7XDaeTa9Ymn48bMbEpfnpnrJKdlRTAQX1Q0MkLtRFCz39GeVwc4SqMr3xoFsJoRA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwhuL_0Goq7WCGpSqQzAiBdYa8OamRCExP6PT7wZ3zDg&oe=6B0B2C9F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031427_710847756257633_4920996515863165822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BqZcibA0yYQ7kNvwGuAgEe&_nc_oc=Adq0jgMsnfySI8ZVo-000aKsnSgpXa2ih7BQcky926zUE0WDzkwE07vK-SL2sqovIS8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQVj_SYizvihmbEZXM3U5RSpiToIaFIROTTSLwSEoofoA&oe=6B0B3491"}, {"file_name": "Nootty(2560x1440).png", "id": "252757496304678", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75443244_252757499638011_5051225089560449728_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzeL85aeYmkQ7kNvwEZDUBO&_nc_oc=AdqOkcpYvtt_dVHQqlnhgWkVSviHz8xnEPvc_fj07YewnU8gFtKWclUfZHxc10Xr-8k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTU6-774FpX8D-JXvp2_63mNGIIqbSSzi3_E2iO5sfjEg&oe=6B0B1D68"}, {"file_name": "Nootty(1440x1440).png", "id": "179994250147513", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982488_179994253480846_100820845935342575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phxJ9OrXEzgQ7kNvwF1oK1p&_nc_oc=AdojKksILKpfqOtrxnEH9gBicSW766k2gW_5qVBO2I1OI0Z8N5xdq6Nb1A1XWKV3_h8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSDMsmZW4aq3Vaz7R4tFxR8IsSOnhqWovdUnPMHOdE4HQ&oe=6B0B42DE"}, {"file_name": "Nootty(1008x1440).png", "id": "164451818615369", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75297584_164451821948702_721346520530735164_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHGjXt9TmJgQ7kNvwFIT2M2&_nc_oc=AdokswB4pyKzRhErdHf92FhShHJhr_KKZ32NZhVdCitcMv0AIEoE9GpSp34YSDVsbRY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1zFFAPZBUsC3kWgE7LHpugY70gN0lzRVAJ-HA8QnGXA&oe=6B0B2F28"}, {"file_name": "NoottyOculus.png", "id": "248589113344273", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75441573_248589116677606_9018835002442137465_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Shq1fHq5-sEQ7kNvwEfNHIf&_nc_oc=Adp4ISXvN3hu6x0VIHY25_J-kP44YISSHRPF6CF6XrClUC8kxIvwLsJ2MfLTTQt5yyg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQShAkYqWuYkQ4psT3PVFRgut4OyBpl_bqozt3b22J5J-A&oe=6B0B0C73"}]}, "id": "782017002411087", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nootty", "keywords": [], "long_description": "Gr\u00e2ce \u00e0 l'application et au casque Oculus Quest/Oculus Quest 2, les professionnels comme les clients finaux peuvent voir leurs projets d'un tout nouveau point de vue.\nChangez les couleurs, les textures et les mat\u00e9riaux directement en VR et partagez votre exp\u00e9rience avec d'autres utilisateurs.\nConnectez-vous \u00e0 diff\u00e9rents projets avec 2 autres personnes ou plus. Parlez et interagissez pour faire un choix et d\u00e9couvrir ce que veulent vraiment vos clients pour leur futur int\u00e9rieur.", "short_description": "Nootty est une application \u00e0 destination des professionnels de l'am\u00e9nagement d'int\u00e9rieur.\nL'application leur permet de visualiser leurs conceptions en VR et de plonger en total immersion avec leurs clients afin de leur offrir une toute nouvelle exp\u00e9rience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nootty.fr/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Unity3D
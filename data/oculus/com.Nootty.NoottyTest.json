dqOM_jnTWMxO32NDrSlW2cXscA0gPledBQkTSNDJX1Pj5D4qJ3z0UYfxbYT47m_slM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeK9nqeCpKrX7iaNtopM26bS7XGXUrKNWnkb9U-675lg&oe=6AD25B0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ftf68YPWEIQ7kNvwE3BAYT&_nc_oc=Ado2WsMWRcSjJMSYa9xrvuJJykyhOZ2LPpCcQw7Yq_D5Ev7_fUGvhlEMhP-Z8ST3Xbc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGXV1bJg-hCPQL4jG8s4_BBoVP5S_8nLiLAu9sCfzrhQ&oe=6AD22951"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmN4IkjDYpcQ7kNvwFAULWb&_nc_oc=Adp7g6SY7C6yMhaBoNaryjJLplF4NSLeAwOq1ghK5mFREyyjDCIsJB43JCPANVkN5Bw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP58oiWulbqFSvGGJtgod-aC03yBHPBiP6SlzzTKo7PMg&oe=6AD243DF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
dqVW54eAYOCzZ_drVWi6ky9L3FBpZKRz0mbQwWJ4udDnL5h56TactPBMPi61hd44LI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGvCZvOGiOrwySAnheNDGbE2NMAyB53njN1QaQuP1bSw&oe=6AE1F4CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJqKecygzk0Q7kNvwHY3yxz&_nc_oc=AdpiVgDjNkR_o93n54znO1nWs7BndTPtKRAMOuVtmc9zypC5t2Rja-qmU5UA9SwzpB8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd_rLZ0un70pxb5ll_tdtU7sdxwb6h2s1Nk06qk0zsCw&oe=6AE1FB51"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJwK-1RxDiQQ7kNvwHex7Lr&_nc_oc=AdqAMl8E7985r4ptICtkIbmaMBArTJ2giV9fc62IG8GZ1ygL1RUkJSplSaMfC2B3qHQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPte3vtqZIQ3iiF0vmDCPpd_DPqMGED6kVJ_lV0xK8ehQ&oe=6AE215DF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
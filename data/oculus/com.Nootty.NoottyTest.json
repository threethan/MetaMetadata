dr9DHTQPcgHCaRJUDMuxx--7qQKPP-OQ2n0Z-DlmIwHU1WoX_nrevHSKHpAQwlga58&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIp91H-F7f1fJPypdM2zr4JvBU_JNoUYoNWmKB2-gfjg&oe=6AF0AD8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KP8LWKrOnyAQ7kNvwEgFqu9&_nc_oc=Adq8CUIJxkTsAvXOiQzidNj4hc6mAt2u_evd7mYJ-9FP1Y0K9JGceKmxm1rS8xyo_f0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWJ_heJlu7YCV1RoOoCiQ58gSMEVlFRBx97CnJxXmP6w&oe=6AF07BD1"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCq-MelXtUUQ7kNvwFujexL&_nc_oc=AdpMZgRYOP3PYF8wiHbecUj2CQbjAUeL0g5Q2RWchOeBDZpvb4eoaf9TQ3ASyR1_P4I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQ-WRLN_k5Yh33L6ZF8GiM6TP7R08TytQPkU4w-7hKtg&oe=6AF0965F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
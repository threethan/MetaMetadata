dpZO4EqQjjdn3wV0G4gE0BO4ouf4LF55BKbf1Jly7WY_ylzU5CjU7k3wKyO_KHDHXQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEeKXR6DMtaPzJ0k9EyLVQ9kncNEHBnMiAx-CJ41bl9A&oe=6AEA160E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6nt_pwbmt8Q7kNvwEN4sCv&_nc_oc=AdqxuLMgjjc9qN_mGq14JJUQtrSdd63T16gZXrr9PoaXr4JCf8SUWfhE_7veaWwcU2Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8Y_dKH4O6P8QHtiW0dEuffrLn5unMIzQAQiDhqxdp6Q&oe=6AE9E451"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tC4fwwr-2_4Q7kNvwGPE8Pz&_nc_oc=Adoyp__slQeMWsIfB6miBExfYRP6Fve_GtPZRs62qI4v3svNMoerlPyhknZEgSaS544&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxkYM17Gx0v1UamPh2d_2legeJFrGVkdiIF0-a7RnTXQ&oe=6AE9FEDF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
xG3enBAcF_ptPE99n6ccDAmwww&oe=6AFC8F03"}, {"file_name": "com.Nootty.NoottyTest-20210210-150455.png", "id": "266554814820147", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572923_266554821486813_8465835489645455722_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRIPegap6aMQ7kNvwEyaTi0&_nc_oc=Adq06UFMd64PbLkC-ph7GUtBQTGYo4JJTlKmq1g0Zvgv9jvSUxfgitpZyKDXOxyBeyE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW-5TrYzrmMJGHfcrLcHLF00tRBBorbF8c1nMem1JvMQ&oe=6AFC8B0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8JChNDstKMQ7kNvwEkiWu_&_nc_oc=Ado-HhwkMaHmB2OMWwv0jruV56TJ_Plmp95p--HWHAhGtpXhsCzL759piRVaySo5giw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-cm7GixaBosnWuoZVZ0lO5M1eZGc3P0Md7aAwYLpUfw&oe=6AFC9191"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ywxy5ecsSEQ7kNvwEaXQyR&_nc_oc=Adp7wh2qw6seGI8AFcj-xVRtR7me4XfDv_hMP4YgYEGJ0tmVE3N5EOEF82D8AjyCCJ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7e4G9gX7pqlP2UV-cPggJpF5A_2pxsnaLAMxi4bIAWg&oe=6AFC73DF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031427_710847756257633_4920996515863165822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfCMM7RGXfgQ7kNvwGlc7YU&_nc_oc=AdpHq-LoJaHxg4byK02hKjEk2YFZOFVqPFsFAERL-NFDGh5U-zYiQkpRL2c9oFl_ar4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZo1Ryr-sFWx8P-refk2A8Gj9M6E9yXRpRFuQRi9VGew&oe=6AFC7BD1"}, {"file_name": "Nootty(2560x1440).png", "id": "252757496304678", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75443244_252757499638011_5051225089560449728_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_1ViECpGxMQ7kNvwHPZpIz&_nc_oc=Adq6cx-xCDuKgpFq4qqW5Gau1GZvX-LEBl81ZqndsvUG2qL--Y3IoKeQcLvPriic5jU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQgaGaR9hxCUlGGCvqyfu7DlkKLIZAxm6ehiaFv4mr4Q&oe=6AFC64A8"}, {"file_name": "Nootty(1440x1440).png", "id": "179994250147513", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982488_179994253480846_100820845935342575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnumOoSjZqAQ7kNvwHzysFR&_nc_oc=Ado0AdNn3oT63N197ue7YuN870qpO8YCib5xSbQBmN-qqYSFbt-RY1rnLax40v9OM2U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROKOdh06vAiMO1tcWhA_MO7ZebGds1IGKS86LUMdg_uA&oe=6AFC8A1E"}, {"file_name": "Nootty(1008x1440).png", "id": "164451818615369", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75297584_164451821948702_721346520530735164_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SR0W6R2dvXgQ7kNvwFNcK_p&_nc_oc=Adr0h9SEHpoPZ36X29j2LgCYLMa9-ufbrBxEWCYtqHTZ3pqAibMdVaKPbIUkUVJXPVM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjEbxUhMK-9kYSQ2kWUoJdyJapDpYkVxnj6KY5QECEpw&oe=6AFC7668"}, {"file_name": "NoottyOculus.png", "id": "248589113344273", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75441573_248589116677606_9018835002442137465_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRu6EpyNr4gQ7kNvwHukMaA&_nc_oc=Adp_23kFkV7Z6orr4i_GKTOFSYrSvQqx5-KqxkKAjTskiGP02yXZu5FLj4YgYzsrfLM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuaJbskIRPOMnuAqgBNzNvuZMCUlcDnZEtnL2p4nPNXA&oe=6AFC8BF3"}]}, "id": "782017002411087", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nootty", "keywords": [], "long_description": "Gr\u00e2ce \u00e0 l'application et au casque Oculus Quest/Oculus Quest 2, les professionnels comme les clients finaux peuvent voir leurs projets d'un tout nouveau point de vue.\nChangez les couleurs, les textures et les mat\u00e9riaux directement en VR et partagez votre exp\u00e9rience avec d'autres utilisateurs.\nConnectez-vous \u00e0 diff\u00e9rents projets avec 2 autres personnes ou plus. Parlez et interagissez pour faire un choix et d\u00e9couvrir ce que veulent vraiment vos clients pour leur futur int\u00e9rieur.", "short_description": "Nootty est une application \u00e0 destination des professionnels de l'am\u00e9nagement d'int\u00e9rieur.\nL'application leur permet de visualiser leurs conceptions en VR et de plonger en total immersion avec leurs clients afin de leur offrir une toute nouvelle exp\u00e9rience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nootty.fr/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Unity3D
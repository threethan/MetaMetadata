dp33HZDVidVpTrA9L5Y87E2I33A0fGE0fGh4KRX78zfVR__aybZ5j7uJSF2e2I-Q98&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgLfryrCvkSCDS5mgwlTjh4t6rqt5hOASgOfI2dqrzgQ&oe=6AF3508E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rHYfoRtntMQ7kNvwFNmGCj&_nc_oc=AdqgU1_l1lXsVtYqlZQ-YE8Lf2Sq2wTtFWTnnky0Zn5bSvdOr407myG6gf0_zg0z1Kg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQpWfFrM748RkH2WWspbA7wtvhpvjJS-h_iWN7pYXDsA&oe=6AF35711"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCq-MelXtUUQ7kNvwGtobzx&_nc_oc=Adoz4Tg63NOPvFxwzgwWYixokNhUKqEkbpWbjUpwbEg6LC10H7FunykUxeXE5k78G84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV095zo8XUqPTr0_Z_BWF3Vw071cSdLcWJ2eMrN_02Cg&oe=6AF3395F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
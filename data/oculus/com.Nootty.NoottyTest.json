drnl8QRalSvGl9BcIEnLiFQ6hFsX0LFLHduniz5yQUpWybYPSFYisVyHhuNfPvFQhE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSq-qBR8dl8MiSz2J8wuxHfZdenpwkNApx8rh788QayQ&oe=6AECB90E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNpJ_iLXTUUQ7kNvwFd6YFr&_nc_oc=AdoFZv90dXt_I1vac5ZUoWAb-4slyJRh6_sWkvLSecWkmzU6oNc2qJCnxpsX1oCIQfk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_SVHDywr7bSXQObUkHWvAA8yfITmzxqaCBCzO0XsQLw&oe=6AEC8751"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vk8GYwjcMAQ7kNvwExibXY&_nc_oc=Adqg0r9_zv2lX6fVh-L3y8V9CK2o1j-Z-4J0zm1HgpqUepxVoQsZ7jA1bsMgo7HHghQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGh9FTcbKuaOpJaipKQRDQiFi85YKEWgg2Kvo0ohWOXQ&oe=6AECA1DF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
T1Bp7Cz_o2jtcfvs8tOaNXZ9VA&oe=6B09BE03"}, {"file_name": "com.Nootty.NoottyTest-20210210-150455.png", "id": "266554814820147", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572923_266554821486813_8465835489645455722_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeHpu3B0HsoQ7kNvwFrm3FN&_nc_oc=AdqBJGsxiCWq0ZvU0JG4KcvHmIYSOv2SJ8CDmFMfPWwUcLh-caSfLTMIzjNv0nUWXxY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo7DMma9FUgVgxQ_0xLAm53aMNOFzMMfjhDrwKOgcQJw&oe=6B09BA0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaK7pDYyMgIQ7kNvwFka71s&_nc_oc=AdpixDeLylFFEjY5sCWm5gJNujDpbDJNd_FnffGquJ_dfXHUCD4RltP-EuiMvVtadJI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjRNcEcnDm4aMLSdeYCsAejuphFtgh1-15mdVMDZNMRg&oe=6B09C091"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQ7Ub7xZpRAQ7kNvwHs0s-M&_nc_oc=AdqBZgqPWt-qKFLSUZvCDAiyZDeJRZ_bwfmA3vMq7lS2aHWrHCY6PXYqi38RNDWUHaM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT50gtAg0YmMkchvpsCxbcXs90fyYR2BQ1FlXYXRHTirg&oe=6B09A2DF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031427_710847756257633_4920996515863165822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BqZcibA0yYQ7kNvwFFhY3S&_nc_oc=AdoZOl51hD3fi3r0fxt_3OId8BCw_nd8YtJfrvfR2aVDqQiE4d4sIV1vlmv8o_ixnWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEL7AtQddYantdMWj_eUjspAXrlRGo3kFXIJfFQucRkA&oe=6B09AAD1"}, {"file_name": "Nootty(2560x1440).png", "id": "252757496304678", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75443244_252757499638011_5051225089560449728_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrQvRsQle6AQ7kNvwERiX-9&_nc_oc=AdqUW8jyggQyYS05UCjgqxubB3FYGN3JeIssKIFqB4VvmwmbLOMwIDM34L53pTXyJNA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQViNhU5c_7E-m5IYQMDK3izrR_BEcp32UqMqraSlH5Q&oe=6B09CBE8"}, {"file_name": "Nootty(1440x1440).png", "id": "179994250147513", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982488_179994253480846_100820845935342575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPp8WA21vNUQ7kNvwGYfAk0&_nc_oc=AdpQBHB0hqfvj1VGE1r40MO5RuOnEQYG8haNJKeMQvboswXeuFl_WM1W5tRS7hI6GxY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjz4XDho5and19QjfEpVqCXqusRxieGdWqU-2Xj8FFUQ&oe=6B09B91E"}, {"file_name": "Nootty(1008x1440).png", "id": "164451818615369", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75297584_164451821948702_721346520530735164_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHGjXt9TmJgQ7kNvwEin8Nb&_nc_oc=Adq29iN29DyrbQxOFTd5tfdu_w4Nx1gj9O7riXmmL-nSBC1h4cna8RHreYNee1kWtr4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_sOKISKIQrwQdcDfhsK0tPEa-tOAYJ7EzqWAyf6nY-A&oe=6B09A568"}, {"file_name": "NoottyOculus.png", "id": "248589113344273", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75441573_248589116677606_9018835002442137465_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diMztZLKWboQ7kNvwGwKEMX&_nc_oc=Ado-tCSnMLmbJlCBE46z5Fcs8QKSQ2V89hpV7su6zf6bgJD8ABVRs5wfYbuSFPjXpSM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXS47i01nivCHbaHftSzaZq_G010SPxtEwf6IA-jCXQg&oe=6B09BAF3"}]}, "id": "782017002411087", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nootty", "keywords": [], "long_description": "Gr\u00e2ce \u00e0 l'application et au casque Oculus Quest/Oculus Quest 2, les professionnels comme les clients finaux peuvent voir leurs projets d'un tout nouveau point de vue.\nChangez les couleurs, les textures et les mat\u00e9riaux directement en VR et partagez votre exp\u00e9rience avec d'autres utilisateurs.\nConnectez-vous \u00e0 diff\u00e9rents projets avec 2 autres personnes ou plus. Parlez et interagissez pour faire un choix et d\u00e9couvrir ce que veulent vraiment vos clients pour leur futur int\u00e9rieur.", "short_description": "Nootty est une application \u00e0 destination des professionnels de l'am\u00e9nagement d'int\u00e9rieur.\nL'application leur permet de visualiser leurs conceptions en VR et de plonger en total immersion avec leurs clients afin de leur offrir une toute nouvelle exp\u00e9rience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nootty.fr/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Unity3D
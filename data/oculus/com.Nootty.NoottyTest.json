dqgIfF6cTcVHBI2AhZ-p0ixJQPgER0qVr97-zWLzGiZW-RcQWbjks7m7c7M2k_9B-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEY602UnOdF9uhdCyUcfCjHJY32Gb5FfC1G478FO_eZA&oe=6AE73ACE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6nt_pwbmt8Q7kNvwGvjQqh&_nc_oc=Adp3PBsQZs9vqGj94vHdm6GV3fTIdZqdzopnxDmY3AEHRb3q3MvwBapqEk-JxWojiw0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLL3FQ3ag2M_45a34REeP_Q9_dCOSlIbe8PnReWxttGg&oe=6AE74151"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sEBHynr6rgQ7kNvwGx35FB&_nc_oc=AdoFpBjMka0mdIwtqK2nXlp1X7o6LFCA_nVVDEOazYTTGyJEh10WiBkKhs-Urct97lE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzCNmUWgopJ_GX4fUNeLtbvkqfwb76fOXuTSQtYkzvXg&oe=6AE75BDF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
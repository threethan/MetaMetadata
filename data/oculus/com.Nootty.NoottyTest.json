dqWn58wZizd6TxeODUEYoNxBBbzUA5G2DO1Sw-604osv1Ba7uQNSBbMo25mTggOGgQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7cLt_gBBnEYt1TJya3qbGETtBB87sLa5Erx7aKD2-bw&oe=6AE0A34E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJqKecygzk0Q7kNvwFjqFdT&_nc_oc=AdqRCFdcFLVbMp1brEq5c_6vC6FMSHUYfpV96tkijqzJSvYqbMwDbBSp4oMtpm_zWkk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNalqowHPHm3cxt0QU9SjwshNRCs2wnPADNXLjKTJtX7w&oe=6AE0A9D1"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJwK-1RxDiQQ7kNvwFwTxOX&_nc_oc=AdqPu6sJ7mge-2F1-UtnMfP3xEomlxbCqyfutL3VWVEXT3Z1bJGUNiDgmGWZxDL2pWI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJ4mq3AgNRrPvCcHC3r2tWgIQMfdfXwpYiQVcupil2qw&oe=6AE0C45F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
dp0ClMNxjiedFdULhq3iOc4nJM8y9N8bkafle7PVGFTi1KH-UsrAiUsVoEV1Nkg1i4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg38bjclNFuTAPgFo2M3sbWPBtp-FT5vCdVB2IBGlOLg&oe=6ADE004E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmTyHURk8VIQ7kNvwF3Z2s_&_nc_oc=Adrtx9GH_xtiNJXXrdJjcHY1D56WHrPWS27FHvSe3imFkPysfTEttsuwspxqmI2n4hQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw0lBHWz3WEis1pKp0pCV4Z0nnOyBJzAv3X1qPG8atVg&oe=6ADE06D1"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwSMesBkjioQ7kNvwHQUc30&_nc_oc=Adp4vvoWg2hOFpu87y8B7GzQ-9qWqzLjpBB6xZnFY2Zpp-XInFAX0JbZ7kD8hw6JMOI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNUOj-L4Jnzv_pYFdhoqdHxCP3Y58JpuWFycZLfzoJVg&oe=6ADE215F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
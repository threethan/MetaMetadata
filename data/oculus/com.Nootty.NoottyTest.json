a6O81HJ8COsJ2LkpDETSQKWXrg&oe=6B008383"}, {"file_name": "com.Nootty.NoottyTest-20210210-150455.png", "id": "266554814820147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572923_266554821486813_8465835489645455722_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDqq1NDI47oQ7kNvwHYR3lt&_nc_oc=AdpNEmV2jdKI02MJgmOze_YBWlS-21KM5jirj4Z8JAHnGMSR_KiM_Itf1aCwFLI7eKk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzqg0ZGdyCtuTYiJ2Qt1wh7bWeuiFpmPihYZ0oowCuTw&oe=6B007F8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYACY7WlQzQQ7kNvwHPptky&_nc_oc=AdrhjlkqTgP6axhfap5M2l_rz3VNNvDkWiSYRehyTvO4pz4RiJERr37eDjF5vgZZQng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5AeVIwga479j270mEuXmEFM7p4G1tExmLxNjsuNH4Lw&oe=6B008611"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s05y_k53i-wQ7kNvwFIFfP8&_nc_oc=AdpUJ51HvFJIZmspbFjhTIT8Uyzg86gQsknXBKwF-0GS7lzBDDugBDnm0_UAtplqz4k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG0ajYRrnhrhMeGmj8P_aexJLARMGEsrcfLMoAEWMfrg&oe=6B00685F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031427_710847756257633_4920996515863165822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyqv5G4c4fwQ7kNvwGiN5Va&_nc_oc=Adohiq3jQMFpFaazHeakMeStiuldsii2yH_r_Fu5NkWNS8-9k7eNFHrxpQKdCAg0t9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY2XBtSxQTtiHRQ95JkZF3OyijyaL_vmeA0YLjRuLhmQ&oe=6B007051"}, {"file_name": "Nootty(2560x1440).png", "id": "252757496304678", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75443244_252757499638011_5051225089560449728_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0uiAysACC8Q7kNvwHUABiL&_nc_oc=AdqvTx_ihCnJb_9NyFETFGyxTsUcwVHdCWaJdNegPUCV5V5T4Ur4jAy1H-gAyiFXNXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4bl-0DoqKc8rKjpxtqsziw8AZ0VymL9v1HzUcbVxCTg&oe=6B005928"}, {"file_name": "Nootty(1440x1440).png", "id": "179994250147513", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982488_179994253480846_100820845935342575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_6inZo4YBcQ7kNvwGeqC92&_nc_oc=Adr_aJ0PDXLAIxJvptIrBeKXwoNaiEz8Bu-UPVyJrZ_7qscDY7slLaNkRzX4p_2O_LU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwRWqyZvaWt9m6vbOMjJ297Wt0eRhfC8Ot2yDkShTFDA&oe=6B007E9E"}, {"file_name": "Nootty(1008x1440).png", "id": "164451818615369", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75297584_164451821948702_721346520530735164_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcVbZOOFU3gQ7kNvwGLCCD8&_nc_oc=AdrV8RdbQ_BswyOWuKjW-0ASHNOU9ZLsYTTO6sGErNkUeVR1y61EINFDqJalKLY8OJM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNjYMp5FgasrLvlKov5RkDqczYX2QbAYMN6IVK_tmtSQ&oe=6B006AE8"}, {"file_name": "NoottyOculus.png", "id": "248589113344273", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75441573_248589116677606_9018835002442137465_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJBrD7AApLwQ7kNvwGkDeeA&_nc_oc=AdqPW5kk8VggWQqEaT9aBZbjIriA00amopL8Z969inoIm3hO9zEfG0bl4ykp9B6Mgoc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvpFbWOW2LP0etVRiwszsSwlgz36v4J6I8gpfseWS6Mg&oe=6B008073"}]}, "id": "782017002411087", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nootty", "keywords": [], "long_description": "Gr\u00e2ce \u00e0 l'application et au casque Oculus Quest/Oculus Quest 2, les professionnels comme les clients finaux peuvent voir leurs projets d'un tout nouveau point de vue.\nChangez les couleurs, les textures et les mat\u00e9riaux directement en VR et partagez votre exp\u00e9rience avec d'autres utilisateurs.\nConnectez-vous \u00e0 diff\u00e9rents projets avec 2 autres personnes ou plus. Parlez et interagissez pour faire un choix et d\u00e9couvrir ce que veulent vraiment vos clients pour leur futur int\u00e9rieur.", "short_description": "Nootty est une application \u00e0 destination des professionnels de l'am\u00e9nagement d'int\u00e9rieur.\nL'application leur permet de visualiser leurs conceptions en VR et de plonger en total immersion avec leurs clients afin de leur offrir une toute nouvelle exp\u00e9rience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nootty.fr/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Unity3D
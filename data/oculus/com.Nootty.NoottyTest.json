WnPRkz16BIPEgKZL6HSXCIlBvA&oe=6B047803"}, {"file_name": "com.Nootty.NoottyTest-20210210-150455.png", "id": "266554814820147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572923_266554821486813_8465835489645455722_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChWzLTEA0lcQ7kNvwFGS9eL&_nc_oc=Adrnj1eYi9Bxok3R5zAsfQBrCmkCGLx6i6kBdL-RYBRe-3-ljCltfiKiKD4f8YYkgzU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTstxyEEfplQwHESj7PNhcvQ8KYZefyPflOtzwloSjD9g&oe=6B04740E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38Q1yJAsDJUQ7kNvwEFuYup&_nc_oc=AdqZdRquFMrxZ_0z-LxrkaKRHt658a9X5w-BFGE9FjoIR0DvsIS9iNhxfOL8jOPhj_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlO1ITsByFyLw3JeLpqH9wNE0eT2o0AFoDiHo4_-EjEA&oe=6B047A91"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykSs6Qthd34Q7kNvwG-Hzgs&_nc_oc=AdqeNVLEPf_olwZjvGD-Lub5iJ1jmYK8ERB8YB3ig-slUZfb8GYwShF2rK_64_-nBfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_DgMHdROvkzx7xuHFL089OKF7H7DfTwpIRtcKllndYA&oe=6B045CDF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031427_710847756257633_4920996515863165822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaHE1dHMMxkQ7kNvwHxfXre&_nc_oc=AdouOUpalw6g3-wE0W5BZin10YmaE5BO7Yo5SI4zSAQqyEoCmkaaGDzvqhw9ZPOd4b0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd4cAWClBXXdVhE0rtHodbxH8NDo6KXDhS1tUqLGt-4g&oe=6B0464D1"}, {"file_name": "Nootty(2560x1440).png", "id": "252757496304678", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75443244_252757499638011_5051225089560449728_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDpE_EPp4wkQ7kNvwGNSHin&_nc_oc=Adqz_gkkRzrO1KP8YZi7-bs8LRe3fc0YhCUk0EgpqyyhIbnpfhgxtB3zakCRNylt5HY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHiwEjqRBqZw-6nGQ1TucbKUYqyuzAMXGeVejboo-gAg&oe=6B0485E8"}, {"file_name": "Nootty(1440x1440).png", "id": "179994250147513", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982488_179994253480846_100820845935342575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7ED5_ADG64Q7kNvwE8fDlJ&_nc_oc=AdrkTvRiY3JidiIqe6dJMcwTCXIkThqhQYCoKlondwFUj8PJvZaIwnju4oLuRU2COg0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzrPU3YZtC_laa41UzWpyqPupTx9zHzePqMglIYExxdg&oe=6B04731E"}, {"file_name": "Nootty(1008x1440).png", "id": "164451818615369", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75297584_164451821948702_721346520530735164_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FvCxIoX6lIQ7kNvwFEomzM&_nc_oc=AdqsPd2IyKhVcl2JMuJAiOJgXPFZ3t_wRTlF3qzZ19lR2nOfVyVMmcUe7joQxgExNIg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwK2erDZX4gQNxg6SeUK7eAgtH7UnGJUqWO1VbsvGGew&oe=6B045F68"}, {"file_name": "NoottyOculus.png", "id": "248589113344273", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75441573_248589116677606_9018835002442137465_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhBjL3ShAuQQ7kNvwGkb5Qd&_nc_oc=AdpHBJHDBPk_XuZz_gHnFfdbZq0H-aRz_I0zh-lEvvQ0toiE_NBJ4ijxsc18_ULptyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl7CCx6rvMWSYROkpQqG3g_TkELQ2WzMFqqlOe24a0tQ&oe=6B0474F3"}]}, "id": "782017002411087", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nootty", "keywords": [], "long_description": "Gr\u00e2ce \u00e0 l'application et au casque Oculus Quest/Oculus Quest 2, les professionnels comme les clients finaux peuvent voir leurs projets d'un tout nouveau point de vue.\nChangez les couleurs, les textures et les mat\u00e9riaux directement en VR et partagez votre exp\u00e9rience avec d'autres utilisateurs.\nConnectez-vous \u00e0 diff\u00e9rents projets avec 2 autres personnes ou plus. Parlez et interagissez pour faire un choix et d\u00e9couvrir ce que veulent vraiment vos clients pour leur futur int\u00e9rieur.", "short_description": "Nootty est une application \u00e0 destination des professionnels de l'am\u00e9nagement d'int\u00e9rieur.\nL'application leur permet de visualiser leurs conceptions en VR et de plonger en total immersion avec leurs clients afin de leur offrir une toute nouvelle exp\u00e9rience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nootty.fr/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Unity3D
8ATHZYf9wqO9i0t6R7UFjTF6HA&oe=6AFDE083"}, {"file_name": "com.Nootty.NoottyTest-20210210-150455.png", "id": "266554814820147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572923_266554821486813_8465835489645455722_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRIPegap6aMQ7kNvwFCZMcw&_nc_oc=AdrdbUL3m4ZTIbW1aEVXe-l_SdqbpeWPgUtfEiXo3wP0Q1j6LkhfCvo1N8glijz1uvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxTEXLrcV3s58iLaqz630C8rXAvSvZhVoQfdewxMY5cw&oe=6AFDDC8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8JChNDstKMQ7kNvwEEiRNz&_nc_oc=AdpIfUjUIMYRC4rqtig20Wng-B3AkyAbeyxpUaXfVll3RCcvo1wMPAAvh9f4MPVA1kI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP3QpRLn2kXSp1X2pKzcdnVGDinESX_Zdd5xSdaOhjww&oe=6AFDE311"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ywxy5ecsSEQ7kNvwGHztnz&_nc_oc=AdqXlzIYiB9eNGMNh6PnMEA6D2x0Ftp034TX65ACOdJDddT9Qjr2XMdYZrIbKyD6L3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqeHVYlb0DydZlI9LzH342922txHGV4NrttNLuHiDQQg&oe=6AFDC55F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031427_710847756257633_4920996515863165822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyqv5G4c4fwQ7kNvwHEhQsg&_nc_oc=Adow5gHodzv5djsKQ9jQfbdBuj48P4FEI-pr7sn7n6M03iTHDTtOt677rhDIlPMQP00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM-W8VDzOhJawwVl6cgRscVVXbCoQZaXfUp4BdYZO4tw&oe=6AFDCD51"}, {"file_name": "Nootty(2560x1440).png", "id": "252757496304678", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75443244_252757499638011_5051225089560449728_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_1ViECpGxMQ7kNvwGNLjys&_nc_oc=Adr15QO2PPWN0ApFlFAnj6qgNBGSzs4BNapT83vgH706qfvegyXgv3quOekY2ImjK80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWrdtdvNq6KkdHtxa5hNKHkRzM6iafs1jTsy-ItuItiA&oe=6AFDB628"}, {"file_name": "Nootty(1440x1440).png", "id": "179994250147513", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982488_179994253480846_100820845935342575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnumOoSjZqAQ7kNvwHO8IQZ&_nc_oc=AdpMQ2MqidTscGr7N0mAqFAYm530fcCmEinElx0ho4rP2B2bXvhwItVUMjkNvd_Wa3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4xsy0UXnaS5PxgR3kiJlaibjwTRW3tLsrXy5WQeohXA&oe=6AFDDB9E"}, {"file_name": "Nootty(1008x1440).png", "id": "164451818615369", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297584_164451821948702_721346520530735164_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcVbZOOFU3gQ7kNvwF5jZUy&_nc_oc=AdrtPAvK9MqRJLe0f-5tA4EiyvYF6ek0imWe9A4i6VVFQz-L_w40SfUJdOShTdf8KBU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf5F0bWoJ_cxJkesOqBY1FVFNWX0pdJ_zIwD95JJ569A&oe=6AFDC7E8"}, {"file_name": "NoottyOculus.png", "id": "248589113344273", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75441573_248589116677606_9018835002442137465_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRu6EpyNr4gQ7kNvwGmpMWy&_nc_oc=AdpRANVihRAIcy_hUMpEUbcugUFvhuhnTqNYrUmH05WSkf8f-mlPHDj-KeHi6OH_sFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9NUcAmIeViexzPuE4Lzyc0u5KDhJaxoCnKF8gmI1dDg&oe=6AFDDD73"}]}, "id": "782017002411087", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nootty", "keywords": [], "long_description": "Gr\u00e2ce \u00e0 l'application et au casque Oculus Quest/Oculus Quest 2, les professionnels comme les clients finaux peuvent voir leurs projets d'un tout nouveau point de vue.\nChangez les couleurs, les textures et les mat\u00e9riaux directement en VR et partagez votre exp\u00e9rience avec d'autres utilisateurs.\nConnectez-vous \u00e0 diff\u00e9rents projets avec 2 autres personnes ou plus. Parlez et interagissez pour faire un choix et d\u00e9couvrir ce que veulent vraiment vos clients pour leur futur int\u00e9rieur.", "short_description": "Nootty est une application \u00e0 destination des professionnels de l'am\u00e9nagement d'int\u00e9rieur.\nL'application leur permet de visualiser leurs conceptions en VR et de plonger en total immersion avec leurs clients afin de leur offrir une toute nouvelle exp\u00e9rience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nootty.fr/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Unity3D
drf1cy1-LrUsPLGPlxHilfD6Hk17cFiUC4u9gxyV5uwkAB3jLfYM4d38uii99qBe40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvQ8BrYFIJE991k6WlHGV2uCwZOaIe0KoyseYx3Qvvmg&oe=6AEB2F4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNpJ_iLXTUUQ7kNvwHxYzN5&_nc_oc=AdrlbK3FBiAGitAQgtviS6KkbIfbcySNcQfE-oj5cgLhmcdxdm797Bu5NGh8dhX-6gU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVIsX_Rkl8ZTYgIqHviCqMrM8y_RIImLF9mMNkUe8M5Q&oe=6AEB35D1"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tC4fwwr-2_4Q7kNvwHUTYBl&_nc_oc=AdppZ2UvPTSbjEqpTJ_vkoNQ65rcEvBzjLR_uK7bH6XYfWglnHT0-8ujEfDbUWKpoiY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF0PmdfgrRdZ9PJNO-V9cTEKMSO8F839qqTfedEy7sUg&oe=6AEB505F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
k-T9MdUsreJWSaP9xvrTWwTo-w&oe=6AFB3D83"}, {"file_name": "com.Nootty.NoottyTest-20210210-150455.png", "id": "266554814820147", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572923_266554821486813_8465835489645455722_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRIPegap6aMQ7kNvwHjF4sX&_nc_oc=AdpQNNnlsK8_cN8xQmE1gpWTETSVAPhNuA8zgxt9alCFSXFhAjEqoKIObZ2LhpaZYmI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSAHm03Txr46IMuoRw7uPS3oGQfkUV8hDzqSVtqnyz2Q&oe=6AFB398E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8JChNDstKMQ7kNvwH8wRhn&_nc_oc=AdqEXedG9boD8dfL29AaTUv2zhZz5b4ZZwagyYXaMI6zC2gvi9AiJqf2ACyaw8HSvkA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi_ZZVPxvwQDABWIZ9AKthazWGOTwgCPA7CAY-sljJ6w&oe=6AFB4011"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0c7773rsrgMQ7kNvwFjB-Eb&_nc_oc=Adrk-71OD_q8jG9EZzpyl-TPYY_jFEvkHVB9dmQ9xVE24MwaHQxPp_8VE_s6m5qo_kg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV9pvzGR--46Eu4Mbn_ClwUN2nKyfYxJa9EjkRaN78Hg&oe=6AFB225F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031427_710847756257633_4920996515863165822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfCMM7RGXfgQ7kNvwFpcweZ&_nc_oc=AdpgTLxcvjFxLUY2UxUstfrlXzVQFU1wwgY4haN9oFjbzrRGg5Wu6ioWptpM_zi5JBM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQWCQkZivwrYS2FT6Yc8J9aVovFnBEHH8DZCQP6osF9A&oe=6AFB2A51"}, {"file_name": "Nootty(2560x1440).png", "id": "252757496304678", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75443244_252757499638011_5051225089560449728_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_1ViECpGxMQ7kNvwEkmhkE&_nc_oc=Adq_k9nDyn5_N4gYPQcUoR2QSzZKYdUFf_RRTMubT4gjE0rXW5uzTLIfQHBMOqEBnSQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR80vdxGXLpB-uPyAasnqkyoCx5MRsYtfgmBbPIb3L0oQ&oe=6AFB4B68"}, {"file_name": "Nootty(1440x1440).png", "id": "179994250147513", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982488_179994253480846_100820845935342575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnumOoSjZqAQ7kNvwHgV7J1&_nc_oc=AdrCTZ-wN-9NlMaDhsrYL7KlvsV3CW9brliiKSxIkFAQ7Cbnviut9oZDUaI3yXTca0U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaysvWQzsxhmk1X4_tVz3_TMbgusZzvaSPviYpoe9OzQ&oe=6AFB389E"}, {"file_name": "Nootty(1008x1440).png", "id": "164451818615369", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75297584_164451821948702_721346520530735164_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SR0W6R2dvXgQ7kNvwFCkm07&_nc_oc=Adr-DfNk6sc2NQ-jN3X5UhcYsqwud_wh7-fLg8MBQnTNINPHc9xMSxNH8HgmZ-IPpqc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1SSLdgUFdJcyBiICZrGeDq1IOSezUSLe7dLx9ulfUnA&oe=6AFB24E8"}, {"file_name": "NoottyOculus.png", "id": "248589113344273", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75441573_248589116677606_9018835002442137465_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRu6EpyNr4gQ7kNvwGWXUfq&_nc_oc=Adob_MKeZnk9Z09LhiKy-iAQcFtmXgNv5SmUj1BKRNzN5IerXTBDjR6kC_sIg9in1bg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPQ8-VICr3GKBrOo6NIJdM5tOUdMsZqjGxVw9gX10o6A&oe=6AFB3A73"}]}, "id": "782017002411087", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nootty", "keywords": [], "long_description": "Gr\u00e2ce \u00e0 l'application et au casque Oculus Quest/Oculus Quest 2, les professionnels comme les clients finaux peuvent voir leurs projets d'un tout nouveau point de vue.\nChangez les couleurs, les textures et les mat\u00e9riaux directement en VR et partagez votre exp\u00e9rience avec d'autres utilisateurs.\nConnectez-vous \u00e0 diff\u00e9rents projets avec 2 autres personnes ou plus. Parlez et interagissez pour faire un choix et d\u00e9couvrir ce que veulent vraiment vos clients pour leur futur int\u00e9rieur.", "short_description": "Nootty est une application \u00e0 destination des professionnels de l'am\u00e9nagement d'int\u00e9rieur.\nL'application leur permet de visualiser leurs conceptions en VR et de plonger en total immersion avec leurs clients afin de leur offrir une toute nouvelle exp\u00e9rience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nootty.fr/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Unity3D
drNLS9MNf8zco8GSJ4uCXkiYxunUkKwmRTjs9GU72Rhy5x4wSEc6ot2iea26K6dAas&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeSh5P_W2ku0VPzTxOYKYDI2H5y5otyRnsOq_MyJuR0w&oe=6ADCAECE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmTyHURk8VIQ7kNvwE0oVkc&_nc_oc=AdqfC4aqp8VBBF86Gv1RM_6BJkyXxmJxHl3mddZ_nwKsejpiajgLB3CVK1FV9d_5FWU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR727NA2NFfYx4Klo88K5EJo2YnA5NzYGE6pIfhoUvIQ&oe=6ADCB551"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwSMesBkjioQ7kNvwGpcE-Z&_nc_oc=AdoLGQO57f_DBTmr57qY9Evy6gEaVyVMUPdyROGBpe_ah-i_JXY6EZ-_-0dTNE9leKs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPXxFJmhtxyDC3E047uxLwvWkhMIhcaQDCI2Ch7ExWaw&oe=6ADCCFDF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
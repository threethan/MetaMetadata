To6_8LRrflhYQsGqKdbTFKC9VQ&oe=6B105583"}, {"file_name": "com.Nootty.NoottyTest-20210210-150455.png", "id": "266554814820147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572923_266554821486813_8465835489645455722_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O6nWDMUQ7UQ7kNvwHAfn5X&_nc_oc=AdplkA1D595qy7lb1imlKBh1-ySc7C9VKngk7Ttijt92JmXBEoEn76SW4IrY28i1SEc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUQmhG5PrvvxIn56yXhxKmbwPw8vc8GAl7YSCU-yQYgqQ&oe=6B10518E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOqvgJEBgUYQ7kNvwFpy7lY&_nc_oc=Adq0MkrKHZj0_TLJiF1CFs_3AHiZMC29ihaTFB0XQ7BGl_YeBCKtJJulp_9fyH1gaxM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVI54bmnpN2kPe2ODOuRjEXwPFxS8wc6j2aGTDyFQnEw&oe=6B105811"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAdrowpFUJcQ7kNvwHlD0CH&_nc_oc=AdobRgUEBmvYlOwpa3KFr1DKz2u7sAzokFBIpcktLEXBm8AfhKC5uIYlvetPlZy3e2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUVpQXDa5VH0kJSDy3WzjB4ZAeFSvPkefsx4pnOvbh1mA&oe=6B103A5F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031427_710847756257633_4920996515863165822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9kWzSVGkyQQ7kNvwG5L06p&_nc_oc=AdrajdOizfW8tegH627Git1hugDZIQQNE_9EitDP2xHModRI3x83vV0PviRB8xFBP4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW4BcmUeWHlNYMK5pPrj7l1jcHsJaqvJwmfeMfxbyqQeQ&oe=6B104251"}, {"file_name": "Nootty(2560x1440).png", "id": "252757496304678", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75443244_252757499638011_5051225089560449728_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dm7M8NY44dAQ7kNvwETkE9s&_nc_oc=AdoBpwXFc5YuBdrhOI6MLKXOVcdeh4h1EiBlWYjqUlMZsKVT4_OD5Nye4vRS7yb0lKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLotZm3MKxbANGxGvF7McSHyklbblQV6H6oXjv2QhQfw&oe=6B106368"}, {"file_name": "Nootty(1440x1440).png", "id": "179994250147513", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982488_179994253480846_100820845935342575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTFIm3LF46kQ7kNvwGSK1uI&_nc_oc=AdpPTBNyI5Bie7V33migc-oIkMaOX7ipFAQ6jeAQvH5TjnZLFdOpVxatGt5wI8-Sn0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXJuFOM8z8W4PcqYYwVYNEtAMVvqTNh7ztomHrwC9i0qw&oe=6B10509E"}, {"file_name": "Nootty(1008x1440).png", "id": "164451818615369", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75297584_164451821948702_721346
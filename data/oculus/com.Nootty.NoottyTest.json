dqDABQFdSu9WVvU3QSQWqiFUsBO21mqpArOhCSYpf9DrGopPAmc8o46617l5SRcmbA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrWS2Sp01n2n8IxRW93BMyIyf4Y27_pkLtmpw55VLPJA&oe=6ADF51CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJqKecygzk0Q7kNvwGWAaqJ&_nc_oc=AdozUHIyCdpxbMco6CsA2m7a8leWufwV7T2-qD691hUkdNl-pF0I27XUhaIMQcs8wn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTfKHd4B0oQbrvXGnJKe2u4T8IfyIBeW0Z1o8x8M5EoA&oe=6ADF5851"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwSMesBkjioQ7kNvwHq89zg&_nc_oc=AdryWmQ8ayOKmMZIYHmwLuG_SdFHEtuuPStfzoP2OTVAp7_pcOWVvgW1LUsg8y922q8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0zfrok3MC3ebdYdCp1lH3gshlzSI-t4XNB9uJGIGsqg&oe=6ADF72DF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
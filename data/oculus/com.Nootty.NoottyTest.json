qLbQEEmZxRTpjrhu8qkF8XlQoQ&oe=6B0DB283"}, {"file_name": "com.Nootty.NoottyTest-20210210-150455.png", "id": "266554814820147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572923_266554821486813_8465835489645455722_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrjXhIihkyQQ7kNvwFlnxut&_nc_oc=AdqxenDYpbEUu39P-LgOYJOZXT6BxAboly4rygmnAg2GW_raXVXjmQsBOgtqeOPbSIM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSYoaB0hniFscOMLcQ8Wah9Som975-UDsMmn_B85wmoYg&oe=6B0DAE8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2q51cuKIBgQ7kNvwEYphpS&_nc_oc=Adr-EvngWZGR2ZjlDYluMEAASnUIX1NmWsHPBLSTgc4al-w3cl3L7n-m7T9P-QkRURk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQSEmnQFle43QZeRH_QeAGbBZqbRlinOawmFR7g_zVaIw&oe=6B0DB511"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXW7NVC-9pwQ7kNvwFq4xb5&_nc_oc=AdrXKyiZvx_xZZwPNKEnt8CEUZH6dYGsJFewHkuJIwEFCXGLvMXPCEgQf2UIzsajiGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS6q7V04lPY_FSOeIoTG_HNbdAoztKZ8rZvL_Id7zAl3A&oe=6B0DCF9F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031427_710847756257633_4920996515863165822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9kWzSVGkyQQ7kNvwF0wbJP&_nc_oc=AdpHlZWgK7R_NFd7P_MjU54coYZL4f5dtQ-oFhKqk6SgASTP6F9Dcw7sVzgJQBba-f4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYrh9CMfnLbJRI7sT0oi2LgC1bb6qgivfyEjv0CvBWOw&oe=6B0D9F51"}, {"file_name": "Nootty(2560x1440).png", "id": "252757496304678", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75443244_252757499638011_5051225089560449728_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzeL85aeYmkQ7kNvwHPhEhI&_nc_oc=AdpMB6xadiA_rbXRRHlxPJ7DLanzzzExEs53o5WykARqGp2OWL0gkfrH8Ktv2BBcNlg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQuI9WeHWqJ3r2ByDat6K9r8Or5ngpnrgZsMomjb_m2w&oe=6B0DC068"}, {"file_name": "Nootty(1440x1440).png", "id": "179994250147513", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982488_179994253480846_100820845935342575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phxJ9OrXEzgQ7kNvwEYEGsd&_nc_oc=Ado5_pmYgiDoYIPRu13GxW4R-VK3nc939z-n1dJX8ULOIw_4SBEK8pAGX_nIrk2oEUU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQIKg7hS6spiEfvUZ7AB4sQmgeEEoPpDg0tykzW3Dhgg&oe=6B0DAD9E"}, {"file_name": "Nootty(1008x1440).png", "id": "164451818615369", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297584_164451821948702_721346520530735164_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT4l4i0X90MQ7kNvwFycYBP&_nc_oc=Adpm-AyFucJWRKv4P7SAtiRj8lkGS9Leue9jSM_W5SkvLwi4Yjyifo4F9KFCuQg667w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQN_TsNlfgHSZ4pmA_mLrChzytnr43NBb9JnErlJ8mXmg&oe=6B0D99E8"}, {"file_name": "NoottyOculus.png", "id": "248589113344273", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75441573_248589116677606_9018835002442137465_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Shq1fHq5-sEQ7kNvwHIFLzF&_nc_oc=AdrxuqSy2Xryp4E8xeCFe1NfnKvxYMPYANcU-pfwTcAP9eXEZVd2uZ6pBDTegEe6SaU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoXdgz0gqh09_FX2S2lCweggM7_wsoM-DoUVoWtvFMoA&oe=6B0DAF73"}]}, "id": "782017002411087", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nootty", "keywords": [], "long_description": "Gr\u00e2ce \u00e0 l'application et au casque Oculus Quest/Oculus Quest 2, les professionnels comme les clients finaux peuvent voir leurs projets d'un tout nouveau point de vue.\nChangez les couleurs, les textures et les mat\u00e9riaux directement en VR et partagez votre exp\u00e9rience avec d'autres utilisateurs.\nConnectez-vous \u00e0 diff\u00e9rents projets avec 2 autres personnes ou plus. Parlez et interagissez pour faire un choix et d\u00e9couvrir ce que veulent vraiment vos clients pour leur futur int\u00e9rieur.", "short_description": "Nootty est une application \u00e0 destination des professionnels de l'am\u00e9nagement d'int\u00e9rieur.\nL'application leur permet de visualiser leurs conceptions en VR et de plonger en total immersion avec leurs clients afin de leur offrir une toute nouvelle exp\u00e9rience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nootty.fr/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Unity3D
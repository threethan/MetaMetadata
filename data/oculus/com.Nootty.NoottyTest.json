NXnW_p8QiRwZlkIlJFrGprtCkA&oe=6B032683"}, {"file_name": "com.Nootty.NoottyTest-20210210-150455.png", "id": "266554814820147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572923_266554821486813_8465835489645455722_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChWzLTEA0lcQ7kNvwHL5CA0&_nc_oc=AdpFIIhivrCRkrG3iREyyIXoCpKAOJdT4BQpbHiKPjBKDa6_qVHzDxEedI6WMbtySBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtJfUDPA-gWuVS9OFi3WMD2qQVfqp95CW7HlcXK8eeXg&oe=6B03228E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38Q1yJAsDJUQ7kNvwF5R0ot&_nc_oc=AdpQ-mOLm1zPg1IqYuwU4L2BV5GUzadGihooghFEGhuIoCbhbHGNdUf_kXybLWK0hM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb707B1wkxW_D2bq_TEeN1NjhYai0T4gXF4Ynb6KECIQ&oe=6B032911"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s05y_k53i-wQ7kNvwFRbv-h&_nc_oc=AdoQMsI92GZr7qdf6hxAlm9r2DKmZAzRxD-O_O3LU5TcGtRuCe4YnA58kpv-kzfPIos&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwEnQ9A3owJb42GQ18AV_ipkmZsDdZYTl7L8zLywPQ9Q&oe=6B030B5F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031427_710847756257633_4920996515863165822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaHE1dHMMxkQ7kNvwEH82PS&_nc_oc=AdpqsJWvqNdDduUJYM222Su3WXQdDUCr5uJbduNdudzIsTQ37HhtSDjmXKqWI4sVogU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcQjsXlnC2G7mkIoLH8AqSK7M_4xWH6SY4Ab6Ilc1xng&oe=6B031351"}, {"file_name": "Nootty(2560x1440).png", "id": "252757496304678", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75443244_252757499638011_5051225089560449728_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDpE_EPp4wkQ7kNvwFktw3O&_nc_oc=AdoQ72xbMnXnDI9R5dbsxN2Lb-sb8pLFJKMFaRd9h9tLd-9png5PeZHdSyNrut0CLDA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWTTxUrQw0KUgQsABDoe8OVPPyEx52CGywopQy4QlqVg&oe=6B033468"}, {"file_name": "Nootty(1440x1440).png", "id": "179994250147513", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982488_179994253480846_100820845935342575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7ED5_ADG64Q7kNvwHOLVp3&_nc_oc=Adr8Sb0tKad8wblTEfNQqDJXzhVmgfz150MU5bq5bBIxyYjUUXe9MbcjCIioQOPIFhI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ48do3xgM4b162QqPYL5dPSKUrYqfFXNtDdW4G-t8Jnw&oe=6B03219E"}, {"file_name": "Nootty(1008x1440).png", "id": "164451818615369", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75297584_164451821948702_721346520530735164_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FvCxIoX6lIQ7kNvwHF392B&_nc_oc=AdqGznxUUP4Yw8wMhinsJxYqi3UriDVLPR307hkA1DGWHeQWYY9Q7s8r8RFfu6ntjHc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSg7Gf6u3fkQDpjFihMuMTEn709K-ESCx2wvHaqzR_Oxg&oe=6B030DE8"}, {"file_name": "NoottyOculus.png", "id": "248589113344273", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75441573_248589116677606_9018835002442137465_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhBjL3ShAuQQ7kNvwErVC8f&_nc_oc=Adr7sK22n8iQHyBX51K7PsGGOhBgckYWTEmEexvu0rKvqprk7GaDOLpFCdLyXnWz3BY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPCAMq1AsFIafxK9PhfwypsLUXRC0y2FScSUeJ23Juxg&oe=6B032373"}]}, "id": "782017002411087", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nootty", "keywords": [], "long_description": "Gr\u00e2ce \u00e0 l'application et au casque Oculus Quest/Oculus Quest 2, les professionnels comme les clients finaux peuvent voir leurs projets d'un tout nouveau point de vue.\nChangez les couleurs, les textures et les mat\u00e9riaux directement en VR et partagez votre exp\u00e9rience avec d'autres utilisateurs.\nConnectez-vous \u00e0 diff\u00e9rents projets avec 2 autres personnes ou plus. Parlez et interagissez pour faire un choix et d\u00e9couvrir ce que veulent vraiment vos clients pour leur futur int\u00e9rieur.", "short_description": "Nootty est une application \u00e0 destination des professionnels de l'am\u00e9nagement d'int\u00e9rieur.\nL'application leur permet de visualiser leurs conceptions en VR et de plonger en total immersion avec leurs clients afin de leur offrir une toute nouvelle exp\u00e9rience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nootty.fr/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Unity3D
drE9GIDAmXifyEStQ186Wgx1pvPTrzNPXBGv8t-jm3HqOxaRX7_ekv3UFfHIMaNpU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpmJvs9k2A6vdi_H7XJKykkyAHLr9ifi_HSbXz9oMx5Q&oe=6AEE0A8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNpJ_iLXTUUQ7kNvwEsUMFH&_nc_oc=AdpjgA2Drp9-Pb5nwvenjOGtBxD71xxDr7lXNIxvpaWmrLBYCYTxrmKIfZQzET1FHf8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQivATvsHHK8Z7fkeiu89BTlodm08iYq0rY7_If_Nr_ww&oe=6AEDD8D1"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vk8GYwjcMAQ7kNvwHqENvN&_nc_oc=AdqhtkT96pCWqwXZpEd5-sd6OXflanWAc_3Xo9vw4OVtZqK9q9c3KRkVWQckCYwzW2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwnHT0Lnolo8hHA6Pnml1cOml25j_4TZEKTL0ieGw7Qw&oe=6AEDF35F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
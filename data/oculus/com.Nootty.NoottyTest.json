doLn9R_buIVaediWFyzOhhGozur8m3z6kwxJc3-PwTtn3pZOX0xBgViiT_qHD-IGBc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3elZMA6lqB7HnkYAWgQHIV8v2jUixLu1M9Qp3ObUw6w&oe=6AE5E94E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rDISW3yC_cQ7kNvwGxj0OA&_nc_oc=AdonjQGr65jBy2HyCjTIMND2yN-nhoDzdTmoQUy9CJ6jcr8vJMtX7Q8aTljUdkyb3rk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNQZ6zXkToc93G-k0HAAz3VQBoEpGV-7eNZEqJspUsdg&oe=6AE5EFD1"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sEBHynr6rgQ7kNvwHm3HpZ&_nc_oc=Ado9Vou8nT32jsGuwM3SGIXLgTtYUa88aWJiDbI_ZPEIfxR-F5SMbhcYhlRq_oSfewI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTOetfO3CSl3UJRoX1fhl3XTHM0Hq5e9aRH_ZsEuLDNg&oe=6AE60A5F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
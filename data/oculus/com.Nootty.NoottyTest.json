do9v2KgQX-7UhTk_I0LtJY9ZcGtYCJKAnX95nxzR31_nssSaty2J0SiWQV8kKcY2NA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkaR_bji2rInJPJu6fO6XdSjBnh8ARgxuPXsuMWsqGpQ&oe=6AE497CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rDISW3yC_cQ7kNvwGzPgss&_nc_oc=Adq72syr8OhLY3xcXmmJWEaf2Gq6dwBSiv8Sm7T0hydf0Y5_H1QnrZXhXhHoYdxmooE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHR_Jv8Hq7y7R21MRIESnNaaZrDU5js7Mm3S1BygV2Pw&oe=6AE49E51"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sEBHynr6rgQ7kNvwGgHpGS&_nc_oc=Adpo0yKI5K3xOJrR8FMxu1Bw9Wi-627eGuDFaYy3niKno1oSKW7gNTvs56b4PQaeW8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfPzzvSNgko3ik6gG_TKRvD5ghCCYpUhq48ln0wX21AQ&oe=6AE4B8DF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
o-hbJgRFTdpzs_6X_e5KI_TdhA&oe=6B0F0403"}, {"file_name": "com.Nootty.NoottyTest-20210210-150455.png", "id": "266554814820147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572923_266554821486813_8465835489645455722_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O6nWDMUQ7UQ7kNvwGCgh8G&_nc_oc=Ado_qTxNeWd-EH-8xcl9Gt4jRaT2pQxE24ZPYKGnflydbNs0XwVqe_3Wm7IDcnJt7XE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6_bpwBss0P0Mv2PuoAoZexg-WCJpbtKtUfFxu92r4eg&oe=6B0F000E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOqvgJEBgUYQ7kNvwFF81eK&_nc_oc=AdpiTk5ZWkjumDjopqQ5-_OBBgfNJX29FP4zOiGdfQp_DRtd2V_tNpJILRXlBELR2-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVsirj95vF2iIrl5KZqAJmpIzkv5zoRK8K3Dg2DDG_B4g&oe=6B0F0691"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXW7NVC-9pwQ7kNvwGivAGw&_nc_oc=Adq4qPLS2zaf7owUY0orOtirHzTpxM0PiF3ctZ9cylLxuf0BtbpTV2zdF19HmrhG1fk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUlbRVxjjY2y_SGprDzu2QQ50rgji-Gd8LGz2Zb8bzHsw&oe=6B0F211F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031427_710847756257633_4920996515863165822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9kWzSVGkyQQ7kNvwEb_FKQ&_nc_oc=AdoXRdHm9Ki2iV7A17sIxMNHOlODeRQ_9TP2kDeVlSyIpvlBmHNHkJK9vNP0YsHeB80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWV74-XbaWc9dezxt0mCnmlgOGcobpG_x44AaJECgOymA&oe=6B0EF0D1"}, {"file_name": "Nootty(2560x1440).png", "id": "252757496304678", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75443244_252757499638011_5051225089560449728_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dm7M8NY44dAQ7kNvwF6sezv&_nc_oc=Adq_erqGNCQArPW9Km_S1tVQTLZPiDa_NfgVB2gUsA9Fv3U3I26HjPFFa9y3iYUTDuk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV0nbql-_Fz6lHiFANLDh3cB6z0janPyHq6Mjfd4-89cA&oe=6B0F11E8"}, {"file_name": "Nootty(1440x1440).png", "id": "179994250147513", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982488_179994253480846_100820845935342575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTFIm3LF46kQ7kNvwFiqidK&_nc_oc=Adp7ovHDqjPdEsKXoHUVtJe6JTpfwHQ8c_Fm9k2402XQE2DVIVIoVJrNoWgTsA3ENMY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXS46BPaBlLXYMX3PMevqrhHn2FD3Q9E1U9xac4NTX6Mw&oe=6B0EFF1E"}, {"file_name": "Nootty(1008x1440).png", "id": "164451818615369", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75297584_164451821948702_721346520530735164_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT4l4i0X90MQ7kNvwFPmmKr&_nc_oc=Adqh0jzyhEKWflwPgpLVwaS_2YME6EbG8jxwDWz_CF3AEQTkL-LU_JxFPqk3Rnfgt2A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXbJiuMWjGpVGlRQ5-j2m_KXfyRHHjrAM5TFqxknvSAgw&oe=6B0F23A8"}, {"file_name": "NoottyOculus.png", "id": "248589113344273", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75441573_248589116677606_9018835002442137465_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vU-9kOXkMy4Q7kNvwEFNv62&_nc_oc=AdqeUSVmV7ab5OEiNOQdkG237-pWsio_Nbjw8K4zWNRpIPPtLU9phgShhcI8_gj3SnI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWwBnBougJnoYKpAP22wuB8Xp4-eA5Z4o31LQDshUoxcg&oe=6B0F00F3"}]}, "id": "782017002411087", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nootty", "keywords": [], "long_description": "Gr\u00e2ce \u00e0 l'application et au casque Oculus Quest/Oculus Quest 2, les professionnels comme les clients finaux peuvent voir leurs projets d'un tout nouveau point de vue.\nChangez les couleurs, les textures et les mat\u00e9riaux directement en VR et partagez votre exp\u00e9rience avec d'autres utilisateurs.\nConnectez-vous \u00e0 diff\u00e9rents projets avec 2 autres personnes ou plus. Parlez et interagissez pour faire un choix et d\u00e9couvrir ce que veulent vraiment vos clients pour leur futur int\u00e9rieur.", "short_description": "Nootty est une application \u00e0 destination des professionnels de l'am\u00e9nagement d'int\u00e9rieur.\nL'application leur permet de visualiser leurs conceptions en VR et de plonger en total immersion avec leurs clients afin de leur offrir une toute nouvelle exp\u00e9rience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nootty.fr/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Unity3D
dpFCVkA8-nRG6V05zhplM2PHzzMRaVv7Bg6VBgQAGGXykfBUoYhhz0p5fTQH_13qbw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB2cDRMVYkMR8e7bMBU8U3tfkGR4PVciawDjmAUALbsQ&oe=6AEF5C0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KP8LWKrOnyAQ7kNvwE08juG&_nc_oc=AdpBYTWS6WWMs7Rd-P1qaNBWwUK2pGRqtkpyjMloAssvBCl4SdtfL8rKicG0UCfMb0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4i8hpiqAgjzUzQ1wxR0rpoJHaWWFDIH0DVsNJ0nqAXg&oe=6AEF6291"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vk8GYwjcMAQ7kNvwER-y8v&_nc_oc=AdpTOKKEy33S5AjM2AizJfqElvuZQbpPXcpC2PPDb_EIQN_ZLrWJTPf93Lln4bPlHn4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2Zpq5o2Vzkw32DmXR0BwInkdNXsLQXqmhKE1F4ktcCw&oe=6AEF44DF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
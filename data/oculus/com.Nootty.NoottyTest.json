dowD2djIeT0tLIKPLjUSGBnFKGRvGJsTJ3_ihIjS3LNo6th-SEfOz5S_du-Ffgo1Mw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5MNpXiXPPAB1FzK00nobAf_xm3ABkFlEPhCjyP0ABFQ&oe=6AE88C4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6nt_pwbmt8Q7kNvwErkB-2&_nc_oc=Adr7Wri7-YgapO28ffXoUIbwr-z6aWam5dOpBBb_HVEAjGUrpji7pgbkyXt1EbKisHI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuknWxP2EnSqRKVeVx9FEDr1ukNONTePwVKKkWIQX-Vg&oe=6AE892D1"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tC4fwwr-2_4Q7kNvwFm_Xg2&_nc_oc=AdobNtjgvKo-iZ7aUiiI32JI61WdYwwe4M36oNUZDf71JMNirMdne6c1tlXASVHjn5I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX_dgo8wklhJHDI-tMt264AszmOBplDwpkfelGdySjLA&oe=6AE8AD5F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
dobbb_bMxz8xVnabpuiQgX5026tUn5ddHDyPs1aixyEYTdRgEDDjyNg38cMFQbgdIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlz3Rmcy6QztSzvsVOK75CGpNpthiGZO18qRflx4EvyA&oe=6AF5F38E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rHYfoRtntMQ7kNvwF0YOKp&_nc_oc=Adqp9D8nQsCbIcrjJjeJxIGmpHaSzt7hd9K8pC1MI5VtKwaOPb39wEsqeDQC41thRN4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu0xfnXbO11Imv_e1Vch2rb1emwPFkzZIxiwsT-3LX7Q&oe=6AF5C1D1"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I09UowfJZh8Q7kNvwFa6Zsv&_nc_oc=AdqBnm7jCqQxUvHNR55fqzlMbKZ_o8v9xt5nd7IdWKk7lwut7mNMEn723di0yt1t1rA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMf7XxTfvr4IIoR_CngbBy7bFhsnM7320xrPGGOHSCpQ&oe=6AF5DC5F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
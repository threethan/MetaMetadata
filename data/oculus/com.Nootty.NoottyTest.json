It5FK4XFbHuLR1y5FpNaa-MMyA&oe=6B01D503"}, {"file_name": "com.Nootty.NoottyTest-20210210-150455.png", "id": "266554814820147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572923_266554821486813_8465835489645455722_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDqq1NDI47oQ7kNvwEt4G7J&_nc_oc=AdoUsWi53ntIThS98qZXN4Lm8U9iClfHI8qb1ju1FuR7vj9K7VmqEaIuJkLmh2qvUdM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF2PjRhESToLVyFldt6BseHB9B8qoxctshrDQAEUWEPw&oe=6B01D10E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYACY7WlQzQQ7kNvwE2Neuj&_nc_oc=AdqP0f4Sq2DXmpNuYV5OY9-7sWk54_TCe0x4UpHRZcriO7tTszqeMqpNDZ9q6SvP_vo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4u-CCY8pr73ooQ-GwAQ1XenBem2xhw_9qjUVpwe_tNQ&oe=6B01D791"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s05y_k53i-wQ7kNvwGEXYZn&_nc_oc=AdrQAY3K_xq23KUkfVGntnP7TeJ1XkIxTghClQsahf_Dx95hyqXH2xTuw56h7HbS78Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgy7PiQYghFPTlsO1mhtXO2Ew196NGSzzog_CsMYr10w&oe=6B01B9DF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031427_710847756257633_4920996515863165822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaHE1dHMMxkQ7kNvwF_0ByH&_nc_oc=AdpAYbQNvcHO_NigDZ67Odq49LjDWIRHjzxNDlMg2VJ-d9iB5HKb8vqUkIpbMsk57Gw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX2siUrObwZQU4OaPQl88gcA2HQzIhOai3BwKH2q5tjA&oe=6B01C1D1"}, {"file_name": "Nootty(2560x1440).png", "id": "252757496304678", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75443244_252757499638011_5051225089560449728_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0uiAysACC8Q7kNvwEuKWSa&_nc_oc=Adpg8IrY_EirTmZJ7I_UJwvi6DaLW0O4hbkm25BoB6n0mkbpeRFCUWwnGLldDnSJCDY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDwaI1pYk5KpA5Ex4CIWG4zUUmAKpXNYdnX9ZmZdWgxg&oe=6B01E2E8"}, {"file_name": "Nootty(1440x1440).png", "id": "179994250147513", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982488_179994253480846_100820845935342575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_6inZo4YBcQ7kNvwEHW7G3&_nc_oc=AdrLtQ_BGsqRzY80EC4Jdu6PmLly427bBz3mJQSkNWl_iBcqffoE-qGEYYqCCIZRZHM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyvBsRq7v51jJXuDFz2X-nfSMEVQjyo-LAKTjMKKacEw&oe=6B01D01E"}, {"file_name": "Nootty(1008x1440).png", "id": "164451818615369", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75297584_164451821948702_721346520530735164_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FvCxIoX6lIQ7kNvwGqJoGq&_nc_oc=AdrnvQoAyPTset4VScMUjivrIrj5uPXmYnVh2nYBkMJG2ckgeEp4V-nUUsg6KRrygTI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8XFMLYefZu9CQ767phrtApmbSSlVr41pYnmmyWyWnnQ&oe=6B01BC68"}, {"file_name": "NoottyOculus.png", "id": "248589113344273", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75441573_248589116677606_9018835002442137465_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJBrD7AApLwQ7kNvwEWUEZS&_nc_oc=Adq9wsSYvJ8G0tTDXgyrXK3I6IzO1CIIzYk6Miwy_U_nW2wjGjOKLWa14AJifqaIHzc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMXkdWaceg8YZBpruwi3CvIsMnoENBvYs6WZCilLchZw&oe=6B01D1F3"}]}, "id": "782017002411087", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nootty", "keywords": [], "long_description": "Gr\u00e2ce \u00e0 l'application et au casque Oculus Quest/Oculus Quest 2, les professionnels comme les clients finaux peuvent voir leurs projets d'un tout nouveau point de vue.\nChangez les couleurs, les textures et les mat\u00e9riaux directement en VR et partagez votre exp\u00e9rience avec d'autres utilisateurs.\nConnectez-vous \u00e0 diff\u00e9rents projets avec 2 autres personnes ou plus. Parlez et interagissez pour faire un choix et d\u00e9couvrir ce que veulent vraiment vos clients pour leur futur int\u00e9rieur.", "short_description": "Nootty est une application \u00e0 destination des professionnels de l'am\u00e9nagement d'int\u00e9rieur.\nL'application leur permet de visualiser leurs conceptions en VR et de plonger en total immersion avec leurs clients afin de leur offrir une toute nouvelle exp\u00e9rience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nootty.fr/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Unity3D
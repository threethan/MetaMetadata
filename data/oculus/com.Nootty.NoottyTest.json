dpiB8ctM2W2gISk1-FFgHY9esx70FeKHlLOKkL6O2EEtrI7YfVBfvCdWAdTn_C75xc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdq8ecpGcoCTG8F0QtrQM09fhePUhaqwWbj4f0CufF8Q&oe=6ACFB80E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ftf68YPWEIQ7kNvwErRJND&_nc_oc=AdoBZn7SIvZDpRpbQWV7WrM_rjvISgNy06AS7p8_kJ32u5NzR_ua7OXiY7CZ3zlxJGw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPT-Yjer0ujX2mNph0yfn8jfqITEiJqbFG_FSLFxRw65Q&oe=6ACF8651"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gg4A3fGo3-oQ7kNvwGcn5_g&_nc_oc=AdqSSZ3bu2bUmUHP3gAbun3Y-zeuw06PBX-W5iHSSAJU6DZhQu5f8sIUbueJaxzJOCc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIY3ObNOas5zba_6fZV_srIcWHPLiSoVCOBB5Ig_BIqw&oe=6ACFA0DF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
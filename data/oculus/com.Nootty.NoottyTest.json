mVMxPrJ0K2HKDMrbR0zLfC_QIw&oe=6B05C983"}, {"file_name": "com.Nootty.NoottyTest-20210210-150455.png", "id": "266554814820147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572923_266554821486813_8465835489645455722_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChWzLTEA0lcQ7kNvwESaUZq&_nc_oc=AdoWvGGzbsxo4Rh1UN4hiupMTezhia0FYeyHaFWo_9ZUp9XGivkPdoU1mlvQD8Up81g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzHSyrm48qRWZkeEsoCGpsI2guEM1mi74YvKJXMAtrzg&oe=6B05C58E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38Q1yJAsDJUQ7kNvwH-FU2X&_nc_oc=Adrtj38WJoE6qtze7lurjVmpuvT2FI9CpDiQAD2l7pfzE6OsxkLqg5AI4241s0FagFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSezYDCfLwQd9bdpnajzstsQEfviV8P-rL6twPgLcbBGg&oe=6B05CC11"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykSs6Qthd34Q7kNvwGYk2uj&_nc_oc=Adq54EP4RngnFA3qFFcjJ44s9v4IHqhcbY5t3ekqsj81ip5pF1o1YJr6lBS9x0Wjw_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPu8LszSuKABAHoc_Dw2s9IW-Jd8vcQ2eFJ4n5x9By_Q&oe=6B05AE5F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031427_710847756257633_4920996515863165822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaRJsSJGBQsQ7kNvwGgibgg&_nc_oc=Ado0UCH70_Mjmn2uroYmwothOuOg5ol6FXaczHb25q2hix_l1lto7-7acfQ5eKZTSzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrk35Z2pjpdKY0Au3xFWZHRsjRg7STps3hXDpd6I03vQ&oe=6B05B651"}, {"file_name": "Nootty(2560x1440).png", "id": "252757496304678", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75443244_252757499638011_5051225089560449728_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDpE_EPp4wkQ7kNvwFiUae0&_nc_oc=AdptUYDMDbObHQ-uIaSXLvBpfMdLTA7LWfJ5CmhpcCfJCKvJiWjq3AghZflUdP68NMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv4vYJXXrJHnn2UfjzxRkDGNGykT5doyIemhgXf6KzSA&oe=6B05D768"}, {"file_name": "Nootty(1440x1440).png", "id": "179994250147513", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982488_179994253480846_100820845935342575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7ED5_ADG64Q7kNvwGvcRJD&_nc_oc=AdpG3xdpJWLM8IteNX5boWxxyYujYZ7ITyD5g4l8nvKPrrcvPyQDqslb4M7ez0_fx0k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnQmcf1pUUuFwGQVxQHY_C7jPyS36VPI3WPmiSJTg9Iw&oe=6B05C49E"}, {"file_name": "Nootty(1008x1440).png", "id": "164451818615369", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75297584_164451821948702_721346520530735164_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrlWunlhFTAQ7kNvwEpyAJY&_nc_oc=Adp57taAD5bxlbUyh1ODF8uUWAY5l97hUNv0Q7ZcWokOqOTHHnDBlgI-k75VT1-6ktU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcv6JJ9xkkUckxG2pk7daASUHxoGXR-PWSQ7J-off9Yg&oe=6B05B0E8"}, {"file_name": "NoottyOculus.png", "id": "248589113344273", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75441573_248589116677606_9018835002442137465_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhBjL3ShAuQQ7kNvwH6x3SG&_nc_oc=AdpoZhuYsGAMzn79_HR8Ymc7Ke_kHzftYE3kezaGvOBbBA0zZQYT9gNgEDtg7RuhU_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwEvPBkU-4H7AYBLC1XHbwUH907AX7LZzPX9jOFrDtjQ&oe=6B05C673"}]}, "id": "782017002411087", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nootty", "keywords": [], "long_description": "Gr\u00e2ce \u00e0 l'application et au casque Oculus Quest/Oculus Quest 2, les professionnels comme les clients finaux peuvent voir leurs projets d'un tout nouveau point de vue.\nChangez les couleurs, les textures et les mat\u00e9riaux directement en VR et partagez votre exp\u00e9rience avec d'autres utilisateurs.\nConnectez-vous \u00e0 diff\u00e9rents projets avec 2 autres personnes ou plus. Parlez et interagissez pour faire un choix et d\u00e9couvrir ce que veulent vraiment vos clients pour leur futur int\u00e9rieur.", "short_description": "Nootty est une application \u00e0 destination des professionnels de l'am\u00e9nagement d'int\u00e9rieur.\nL'application leur permet de visualiser leurs conceptions en VR et de plonger en total immersion avec leurs clients afin de leur offrir une toute nouvelle exp\u00e9rience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nootty.fr/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Unity3D
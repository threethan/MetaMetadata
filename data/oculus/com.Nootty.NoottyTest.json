Ash701YmhghqtzdDo1E4i4Ftxw&oe=6B071B03"}, {"file_name": "com.Nootty.NoottyTest-20210210-150455.png", "id": "266554814820147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572923_266554821486813_8465835489645455722_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeHpu3B0HsoQ7kNvwGJk5_T&_nc_oc=AdqxYy29adERME6zLTr2nQruf6jZZrkZf9EZVFAL7t8aEkQFSXNqi0JK_oZOvuX0nJE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN4fk24vGyMj-4UvEiQyVAFo9xjd29G1aI3FBzRYDwEA&oe=6B07170E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaK7pDYyMgIQ7kNvwEBRHUY&_nc_oc=AdoggxRK6O2ZQyeGB5gN7Wyj7cGAvBhI_jOildWull2h0sl4IboTNIrOmpcKqll0FTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUlAKRdCG6sy5wOp0epB09UmYgFuUOmAGTZs9RsZhx4w&oe=6B071D91"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykSs6Qthd34Q7kNvwHjuYdQ&_nc_oc=AdrRPsRa56gGbpy16mn4e3cfaYiojEkY_trO9-9qdmOJMOvSp7qg6D62tR9VNyRtHRM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPUZPIIPjk-1v0_DRusdmGm7cEHTBr-EAn0PAKRb-hqQ&oe=6B06FFDF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031427_710847756257633_4920996515863165822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaRJsSJGBQsQ7kNvwFdsRCv&_nc_oc=Adrk4PZ9Mj2wn-g7yIkx6tBvaDKVEs9UvzMmnTx4Ou-py2rU8p4yO9B7FNsKb0XWIuA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMhV_1hsvwbcTXSDlg2zWzd1JUlRMaHqmG3UFXqXxMsA&oe=6B0707D1"}, {"file_name": "Nootty(2560x1440).png", "id": "252757496304678", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75443244_252757499638011_5051225089560449728_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrQvRsQle6AQ7kNvwGoVg9j&_nc_oc=AdpwdjWc9sxqMkjA80xHWfQGGMaWjWyl3ohz-U7tO0kDgdh1wNGL64hobc1XIVgSPh4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7RRklKoW-wnRW3pVMMpd7dYeFcWOIyB7FriOucdy57Q&oe=6B0728E8"}, {"file_name": "Nootty(1440x1440).png", "id": "179994250147513", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982488_179994253480846_100820845935342575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPp8WA21vNUQ7kNvwFg8KHL&_nc_oc=AdpxUp39EgvaorZ3CnfFPnI91uY-F9wp9DuPeFfyaxTQOwHzcBv7uxNIIBhxznrFw-A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB99rjsq3fmOIkuL_EIU9jLuwMxsrbLDPMdOJ_oms8Uw&oe=6B07161E"}, {"file_name": "Nootty(1008x1440).png", "id": "164451818615369", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75297584_164451821948702_721346
doQ8USGSaR_Cpvau8shMWb3FLBtFfMVv5mriAsu6qT8TH14ee6lgKMEVBq02Rc78vs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcu5W8hRVQUaV4Ti-UaRQ-sSW32NYWZ3Fed_pVgUpyUg&oe=6AD3AC8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3nP49TqFAkQ7kNvwEph-JL&_nc_oc=Adp6_eJLZQ3C_5sw2cb0PDtao5gcfuiE-iDvUptj9xGXrKJSnxERi44JCFV3Ah3j6rQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8__9XMuxmvs00jp42LfpAJMbqtBsKdx3xqk4eVkambg&oe=6AD3B311"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmN4IkjDYpcQ7kNvwG34nmQ&_nc_oc=AdrrQ-lVEqDTgUyVDEtZXA-lRxFfv-Jq2E41GpOeq7lzE-AnDncrSJKA-DVjG9hUXoE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6QTgqAMKFujh_LaviabNpg5mfeVyqpGPRSjgQfn961A&oe=6AD3955F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
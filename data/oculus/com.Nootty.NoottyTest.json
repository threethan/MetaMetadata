nuNK0NJQIrZh_2wA-ETPZXscOQ&oe=6B086C83"}, {"file_name": "com.Nootty.NoottyTest-20210210-150455.png", "id": "266554814820147", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572923_266554821486813_8465835489645455722_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeHpu3B0HsoQ7kNvwEz4eZG&_nc_oc=AdpD1iyt_PrmCkFUFzqWkVz1CAxotTLGeIaG1KeOqdeIdJdBHunLYhOHzCdyQYkpgeE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd2NnDFqvF5Yd_vIyqAYfhwqxIVHCvISyF91QH9uCiyA&oe=6B08688E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaK7pDYyMgIQ7kNvwE2v33P&_nc_oc=AdodREZRylu8Koh7V5RStmizogX1y5L_mF_yK9CTAQVYhRUBAQFFOuvXBEJ0n3qNY6o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxcCFMlh38DFeoYbUNQHmIu26dPCa219zpOrMldwClyA&oe=6B086F11"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQ7Ub7xZpRAQ7kNvwHHIvYr&_nc_oc=AdpyDSpTTFR93BIxEJ7Wz0WpLrayKl6OwpM9S1QrXRVd1HrBS1V_sSSm7h_GTtS0EH4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDT8mtwL1dnLOhGkE4gP_F3OcYPT95RSIunaX3dVqRDw&oe=6B08515F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031427_710847756257633_4920996515863165822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaRJsSJGBQsQ7kNvwEwSLHa&_nc_oc=AdrHjhCnusBo7l_Yq--47FCzl7djH1Dbj2mXucWt9TJgyGmdLOfM1Xa4X46gVjbCodo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjbFVEyAi2WH-hQhh8njeewKsV2JBPzi50udtZgklteQ&oe=6B085951"}, {"file_name": "Nootty(2560x1440).png", "id": "252757496304678", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75443244_252757499638011_5051225089560449728_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrQvRsQle6AQ7kNvwG8Rhto&_nc_oc=AdrlicgjXLTpQj7KQx0jOB810JS10zmQ8z8uFKF4PH8Isbs7AKg30QxlwTzuzDFFz7U&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-Ip4CuVBMZQXggLDBQhGxMRYWR6h2mJVPk_oGgKRg-w&oe=6B084228"}, {"file_name": "Nootty(1440x1440).png", "id": "179994250147513", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982488_179994253480846_100820845935342575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPp8WA21vNUQ7kNvwFQPeAX&_nc_oc=AdrvSWJ3FXnjAIxG_Taz7du1wTucXAHPSV-YARLgxS-RPZ6YdBisCzPhCEzB0UFM9oM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnhKAyJGDFnsxyw1KaIkxXQe1MqbonIAl02i-BHlRnRw&oe=6B08679E"}, {"file_name": "Nootty(1008x1440).png", "id": "164451818615369", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75297584_164451821948702_721346520530735164_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrlWunlhFTAQ7kNvwFqyU3e&_nc_oc=AdoHHmFKl7oU_8XAopkcur308JYFAmfqPfM1IA2MDHYod4uAiJvD6d5E3Y85c9AVupE&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhQzBTouc0iHt-rWrqlxtzA6tX2b4nlNFpMQtMAQVXLA&oe=6B0853E8"}, {"file_name": "NoottyOculus.png", "id": "248589113344273", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75441573_248589116677606_9018835002442137465_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diMztZLKWboQ7kNvwEADI6E&_nc_oc=Adq7UFOm4LfVXvWVDWUBSJrnrLTWY1cQxHiR3msgqGk7VxqMgrpGiskLW5AcqXt3hHk&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwQcJpn89G7KHWhb9RC9ljucHDLHmYfo0wg4SHa19vVw&oe=6B086973"}]}, "id": "782017002411087", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nootty", "keywords": [], "long_description": "Gr\u00e2ce \u00e0 l'application et au casque Oculus Quest/Oculus Quest 2, les professionnels comme les clients finaux peuvent voir leurs projets d'un tout nouveau point de vue.\nChangez les couleurs, les textures et les mat\u00e9riaux directement en VR et partagez votre exp\u00e9rience avec d'autres utilisateurs.\nConnectez-vous \u00e0 diff\u00e9rents projets avec 2 autres personnes ou plus. Parlez et interagissez pour faire un choix et d\u00e9couvrir ce que veulent vraiment vos clients pour leur futur int\u00e9rieur.", "short_description": "Nootty est une application \u00e0 destination des professionnels de l'am\u00e9nagement d'int\u00e9rieur.\nL'application leur permet de visualiser leurs conceptions en VR et de plonger en total immersion avec leurs clients afin de leur offrir une toute nouvelle exp\u00e9rience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nootty.fr/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Unity3D
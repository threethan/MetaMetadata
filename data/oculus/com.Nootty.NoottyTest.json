dqQl3wNzNYNZfgSDAfVz69A3WmenNaf9WEwg8lSbl4_66p77oms8xUTYnxHCW3M0lo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5gA1tSzpexhV-2Wm1U7QM-AC-y34Oc-oHwC4cGbFpdA&oe=6AF7450E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94CVfY5mwrcQ7kNvwGIMcUD&_nc_oc=Adowwew5zMBGN4kGGIkEOJG9oH_UqXG6VzE4JULO9rBqplT2AcCXxKPmpDH39hoTCBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_SdYfktIx7jKEAAD82jbhdeaDldRRsZaUtEhcVlQuyw&oe=6AF71351"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I09UowfJZh8Q7kNvwEhFf6F&_nc_oc=Ado5K9v20EQ7b06k84VbqvciDtddjEkorOn8UvN7eaPHf-8mps-mopFNUIhceBf_tzM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlAR6XhdUs7lhpTUB_sqic1E6qztLW4WFiPArfekL3zA&oe=6AF72DDF"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
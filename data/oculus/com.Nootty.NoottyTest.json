doQ2bnIxgBQeIPlyAXitHJNEX9CYENVs_jYkl3xWTNMQLNxVcM0Wvr6eIMgldkYSPg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXCJsy7mYiOVWEJyuWUwJHmuJ95-Vy239aTZlSQa0DXg&oe=6ACE668E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "442463046947810", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003233_442463050281143_4499776814812912669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTYr6u4SgD8Q7kNvwHSqabb&_nc_oc=AdoamqRez444fCY-IPlxzFhuP8qkuLCFaJq4rjJ4VKI-vBpt937CfF5AMNP8asOPazA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4GVg8kUPYQo3Q74dvHEnuFPAbZAJtd02k6gBpUviqBA&oe=6ACE34D1"}, "display_name": "Nootty", "keywords": [], "long_description": "Thanks to this application and the Oculus Quest/Oculus Quest 2 device, professionels and final customers can see their project from a whole new point of view.\nChange colors, textures and materials directly in VR and share the experience with other users.\nConnect to different projects with 2 or more other people. Talk and interact to make a choice and find what your customers really want for their futur interior furnishing project.\n", "short_description": "Nootty is an application for interior furnishing professionals.\nThis application allow them to view their design in VR and dive with their client and so offer a totally new experience."}, {"images": {"nodes": [{"file_name": "Nootty(1080x360).png", "id": "770427760562356", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462964_770427763895689_5909917451180536418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gg4A3fGo3-oQ7kNvwFhgOLJ&_nc_oc=AdpA6pgOtQ3m3YLWNd-FBkCk6xaU3iAX0njTW9S1oCVXDjQBFdtoc3F6s1ecN319pmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMW3dl7zmQa1T9logWplekO0gwqtKipxVyJXHqhTFSxZg&oe=6ACE4F5F"}, {"file_name": "Nootty(3000x900).png", "id": "710847752924300", "image_type": "APP_IMG_HERO", "uri": "h
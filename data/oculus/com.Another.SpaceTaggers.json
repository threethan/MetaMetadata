ughout the game world.\nThese installations can take the form of intricat\n\n", "short_description": "Project Space is a fan game which was inspired by gorilla tag. You can do anything you want in the game. No limits!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-spaxe/home/", "developer_terms_of_service_url": null, "publisher_name": "charlz", "support_website_url": null, "website_url": "https://sites.google.com/view/project-spaxe/home/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9285866321541046"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9582366295224379", "version": "1.1.106"}, "id": "647307914947464", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9285866291541049", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9582366295224379"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "647307914947464"
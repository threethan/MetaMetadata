_1292981762063031_5662785230539159921_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERWz9czeUugQ7kNvwFv_tdF&_nc_oc=Adk7gmQLt7LanoAQy5Q1RHq0CSaX3G7nFZvCFoxEHR7xP7R300AO7Ui4Y8UbjRyvSls&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxBd-WkiWN0mnWLC8A5DxuiRLTry_05WnV6xX0eaBdJqg&oe=69B80081"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-11-11 014402.png", "id": "1486019871979954", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001697_1486019875313287_7078103566163614601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkgYaHMdZcIQ7kNvwGFAwGQ&_nc_oc=Adml33dN4N3YMqaCbq-tpqHzxcJI67-vsnrDi-XVPbhl4UKuztPX7us7lc3qXECWS8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx93cXh6rxNfXJHShHHFHLl9GfaI-bEJ-OCRv-aqQh6Ug&oe=69B80899"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-11-11 014432.png", "id": "1234407270981227", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462959_1234407277647893_5841525584057925938_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KA8yk9x0wEQ7kNvwEwhWjp&_nc_oc=Adm9ar7aDN4-LUKxa_CeNpqFUNZKCnzlGbmnVyuneIKzZzpH5K7q8qqdIQ-ZUhPhqBU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyTUxI8JcKEzYvFRxr03UqMYZp_qt4JL49ADGyhrzuikA&oe=69B7F68B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-11-11 014432.png", "id": "3868474483425400", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974900_3868474486758733_3812446690659617114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSNxntDjuOMQ7kNvwFZG2HB&_nc_oc=Admz4gToa1mVYWGAoE1DdXBxcpt8gUIS0gaHyzBLpj1cD_O964vb4tcwN78aPBkdGnY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyW8iACUFvE9jlsrke3nDuHB5edfFsV5TFY4L7L8t3Uqg&oe=69B7F2F4"}, "display_name": "Bridge Escape", "keywords": ["Bridge", "Elite", "Fantasy", "Comfort", "Brillant"], "long_description": "In Bridge Escape, you find yourself in a high-stakes adventure where every step on the bridge could be your last. This VR game takes you to various challenging bridge environments, each packed with dangers, puzzles, and secrets to uncover. Navigate narrow pathways, dodge swinging traps, and overcome environmental hazards that test both your reflexes and problem-solving skills. Every level presents unique challenges that will push you to think quickly, react swiftly, and adapt to changing conditions.\n\nWith realistic graphics, immersive sound effects, and responsive VR controls, Bridge Escape pulls you into a world of suspense and excitement. Collect rewards, unlock new paths, and master your escape skills as you progress through increasingly difficult levels. Designed to keep players on the edge of their seats, Bridge Escape is more than just a game; it's a journey through perilous bridges where every decision counts. Prepare to face the ultimate challenge\u2014will you make it to the end, or will the bridge claim you as its next victim?", "short_description": "Bridge Escape challenges players to navigate through treacherous bridges filled with obstacles and thrilling puzzles. In this immersive VR experience, cross perilous gaps, dodge unexpected dangers, and unlock new routes. The game demands quick thinking and sharp reflexes to survive. Will you make it to the other side, or will the bridge claim another victim? Put on your headset and begin the ultimate test of courage and skill in Bridge Escape."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/bridge-escape", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id":
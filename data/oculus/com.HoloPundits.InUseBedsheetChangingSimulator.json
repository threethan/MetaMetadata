&oe=6A64C33F"}, {"file_name": "Bed sheet_Screenshot_05.png", "id": "619361271153140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391923_619361274486473_8029553198169132531_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMZ9msJRcj8Q7kNvwHCO4iy&_nc_oc=AdqmU6Nck1bszlcuP_TxigBb3hr3fteLLvZJVj-z0OAwDxA7T22EWlDEMok38yEwdH8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0v9yhD9xPkAtMPsppofze21CUWw794l-gJ1U4NxqWvg&oe=6A64C045"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bed sheet_Screenshot_04.png", "id": "1178107930729380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392034_1178107937396046_711254869686822222_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1C6vvDrXSBgQ7kNvwHzJ44u&_nc_oc=AdqwkI3jJLEF4AeKg2WWo5Hf1G1SVciGzYOlkbXDJP9-FQOXW2Puy_2w6KTpeV4lDMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7WNy3dCPF8qKJFpXjmisMgHI40vjIcZ6-znowUFe2vQ&oe=6A64A3DE"}, "display_name": "In-Use Bed Sheet Changing Simulator", "keywords": ["CNA", "nurse", "nursing", "training", "simulator"], "long_description": "The **Changing Sheets Simulator** from XR Guru offers medical assistants an immersive VR experience to practice this critical skill. With step-by-step guidance and real-time feedback, users learn to replace bed linens while ensuring the patient\u2019s safety and comfort. \n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.   \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning. \n \n # Key Features:  \n - Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners.  \n - AI Companion: An interactive assistant that responds to user queries and provides clarifications to meet learning needs. (NOTE: Generative AI is still experimental) \n\n# Learning Objectives: \n1. Understand the procedure for changing sheets on an in-use bed. \n2. Apply correct body mechanics for patient and caregiver safety. \n3. Ensure patient hygiene and comfort during the process. \n4. Demonstrate proficiency in disposing of soiled linens and maintaining a clean workspace. \n\nThis VR training module builds confidence and competency in real-world caregiving scenarios. ", "short_description": "Learn to change bed sheets with an occupied patient safely and efficiently in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "fr", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9640899129320991"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1780607286186565"}, {"status": "PUBLISHED", "id": "1422742778691802"}]}, "baseline_offer": {"id": "1780607286186565"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749743640, "status": "PUBLISHED", "id": "1780607286186565"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24082762008041463", "version": "1.0"}, "
FFniI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUlS-P7nNS9ZMrrWP3XzKRsraDtpDXV4EwcojltjUOe0Q&oe=6B106C00"}, {"file_name": "SS_3.png", "id": "1155684683657889", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620655_1155684686991222_8257656111213054370_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RU01HE3fa8IQ7kNvwFZmkWL&_nc_oc=AdriiMJWXyZq4m-svgYXZieW1E_FlYyGzEI2ag-cyqHtTgCwHejxpJvUil1Tp5EyDug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWG-WUzD6s_RjCyNDrNYHnbU0IeXZM__2TLUn4nj-rZMA&oe=6B1035CB"}, {"file_name": "SS_2.png", "id": "1089501877409439", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593877129_1089501884076105_5780016174705185221_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gavhBzrsVkQ7kNvwHUfP7t&_nc_oc=AdqLKBVr7IGRNB4o7u9HjAJni_i_kRDOKWz6Kqrl3EllJSCpYwLurRW2zcI5dG1JQjQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXT7HCCNe9ZaF5J3mjYzGC5ZJX_PqQp4nMBfMQPPUGbbQ&oe=6B10562A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Off-Road 4x4 Driving & Racing Simulator", "keywords": ["offroaddriving", "mountaindriving", "4x4driving", "jeepracing", "offroadadventure"], "long_description": "Get ready for an exciting off-road adventure in Off-Road 4x4 Driving & Racing Simulator! Drive powerful 4x4 vehicles, explore challenging environments, and test your driving skills across rocky roads, muddy tracks, steep hills, and rugged mountain trails.\n\n\ud83d\ude99 **Exciting Off-Road Driving**\nTake control of powerful 4x4 vehicles and navigate rough terrain, sharp turns, and difficult paths.\n\n\ud83c\udfc1 **Thrilling Racing Adventures**\nEnjoy exciting off-road racing, overcome obstacles, and challenge your driving skills on rugged tracks.\n\n\ud83c\udf04 **Explore Rugged Environments**\nDiscover adventurous locations filled with rocky roads, muddy trails, steep slopes, and challenging routes.\n\n\ud83c\udfae **Realistic Driving Experience**\nEnjoy smooth vehicle controls. Accelerate, brake, steer, and improve your off-road driving skills.\n\n\ud83d\udede **Conquer Challenging Terrain**\nClimb steep hills, cross rough roads, and overcome obstacles using careful driving and precise control.\n\n\ud83d\udd25 **Key Features**\n\u2022 Exciting 4x4 off-road driving\n\u2022 Challenging terrain and rugged tracks\n\u2022 Thrilling off-road racing\n\u2022 Steep hills, rocky roads, and muddy trails\n\u2022 Easy and engaging driving controls\n\u2022 Adventurous environments to explore\n\u2022 Fun challenges for off-road enthusiasts\n\nStart your engine, choose your vehicle, and experience the thrill of off-road driving today!", "short_description": "Take on extreme off-road tracks, conquer rugged terrain, and experience thrilling 4x4 driving and racing adventures!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angelgamestudioprivatelimited/home", "developer_terms_of_service_url": null, "publisher_name": "ANGEL GAME STUDIO PRIVATE LIMITED", "support_website_url": null, "website_url": "https://angelgamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1494502470403216"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604360590_276231
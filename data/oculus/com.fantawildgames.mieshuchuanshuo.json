cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBezJxtPaskQ7kNvwFDXSHt&_nc_oc=AdpXH1QvK2I9s2vAn3-FUOFQnI8xiBf8W6qTIaEUa6DrXO3BXOOgKJgp2bcVUbVAIKw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjLIlUhg4sjT7g7yGiIjbvlm2TFyEkRCisY7-NlsOQcg&oe=6B01CDBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5f62\u8c61\u56fe2560.png", "id": "816818129819537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974626_816818133152870_2351498789293778528_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URaKbj6pBU8Q7kNvwE3h2PD&_nc_oc=AdpLYD6_Vv0xsYGc3aQRlBqTl9fRgRlZGzyMn7yyrUKeYNuqFlCei77onPURiUG8nAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNGYteed0fBsIXzfhPcDO-LDlOihBc3K2KUwQf4ucQLw&oe=6B01C550"}, "display_name": "Rat It Demo", "keywords": [], "long_description": "As an outlaw alchemist drifting around the ocean. While exploring an abandoned pirate ship, You Have uncovered rats who have been corrupted by the evil spirits of the deep. It is your duty to pick up magical slingshot paired with alchemical projectiles to exterminate these monsters and uncover the secret in the ship.\n\n- Dynamic VR aiming and shooting mechanism.\n- Combat enemies with different distinct styles and characteristics.\n- Meticulously crafted level designs and engaging interactive \n  elements.\n- Develop your own style of strategy, grow as you play.\n- Advanced enemy AI and mysterious evil boss, learn to exploit their \n  weaknesses.\n\nJoin the official discord for future news:https://discord.gg/gjbp4Q9HeA", "short_description": "Rat It is a single-player magic shooter game in VR. As the alchemist, you must wield your powerful slingshot to eradicate all the evil monsters on a medieval sailing ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fountainmeta.com/privacy-policy-en.html", "developer_terms_of_service_url": null, "publisher_name": "Fountain Game Studio", "support_websit
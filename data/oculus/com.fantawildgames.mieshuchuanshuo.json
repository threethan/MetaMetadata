F"}, {"file_name": "4.png", "id": "1064866034494701", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222939_1064866037828034_4670002475192863315_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnb6ud6BpcoQ7kNvwEbq4sP&_nc_oc=Adn000OMjrbQhKqG8AVJz4DAMK1ViQ6UpyxVASTV9vwU21djsERForTLnE8hSWxEMmU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGEd1gQ6vkp2VWLoewkXbo_x7j5eyQPQL28WxBMNtlmA&oe=69B14C66"}, {"file_name": "5.png", "id": "234278879597490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569431_234278882930823_2680378952232249544_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4ar0Dh-g78Q7kNvwESsWp4&_nc_oc=Adnr4Aiijf-FzZkkCCKi4ylfmVjIeFN6cYVWALob3AXRcr2WDjJp6zMInYE2WMEtsWo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyyh_hSaENJLsaMi4J5AXI0sKJa2jggclfC9lhs06KQZQ&oe=69B166FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5f62\u8c61\u56fe2560.png", "id": "816818129819537", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974626_816818133152870_2351498789293778528_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jgsHCq4Y2MQ7kNvwHiFmkL&_nc_oc=AdlmUvhetqBpKYFKQYOtyfP0zikqEtTef0CrfTSQ1m3qYjhrHGJN6UQLPe796MUfn_U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzxu1VpqA6UjLim4f9pbvblZrHeUUg3PFaUtfxxOH2SBA&oe=69B15E90"}, "display_name": "Rat It Demo", "keywords": [], "long_description": "As an outlaw alchemist drifting around the ocean. While exploring an abandoned pirate ship, You Have uncovered rats who have been corrupted by the evil spirits of the deep. It is your duty to pick up magical slingshot paired with alchemical projectiles to exterminate these monsters and uncover the secret in the ship.\n\n- Dynamic VR aiming and shooting mechanism.\n- Combat enemies with different distinct styles and characteristics.\n- Meticulously crafted level designs and engaging interactive \n  elements.\n- Develop your own style of strategy, grow as you play.\n- Advanced enemy AI and mysterious evil boss, learn to exploit their \n  weaknesses.", "short_description": "Rat It is a single-player magic shooter game in VR. As the alchemist, you must wield your powerful slingshot to eradicate all the evil monsters on a medieval sailing ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fountainmeta.com/privacy-policy-en.html", "developer_terms_of_service_url": null, "publisher_name": "Fountain Game Studio", "support_website_url": null, "website_url": "https://www.fountainmeta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "674751320761419"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3130772420563785"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1695106800, "status": "PUBLISHED", "id": "3130772420563785"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23966112563033225", "version": "1.0.0.10"}, "id": "209024611821045", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9968391023231948", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "23966112563033225"}, "release_status": "SCHEDULED"}, "binary_release_channe
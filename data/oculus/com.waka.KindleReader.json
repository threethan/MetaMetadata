8241444_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlauVW0-f14Q7kNvwGPfgKx&_nc_oc=AdrSs4kZaYlMrTdvFCThB3be9MCoi2hcxyFK_nQFul4diZhZsstCuXboC2FlQxfmyxY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfVNPasqahNvIDX-LfCJK7c4UfFnDfETfam68GaIs_WA&oe=6AD384C4"}, {"file_name": "Group 3 (1).png", "id": "6521183777965497", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75481473_6521183784632163_9201723830803460786_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-9lg5Hayb8Q7kNvwGbCAB6&_nc_oc=Adp8k3x56Fp1pkPLLugTwJ3p-9-lfFlLqzpbHsbcoyi3TNwyNJ56mp0uuO-apZAE78g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpHSU0Ag5qdZLwdSKuSBj1Bw75Ht8kcVhJTmEQJxSeGQ&oe=6AD39937"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KindleReader", "keywords": [], "long_description": "Browse the web at your leisure.\nYou can also launch your Kindle from the Menu on the left of your view.\n\nAdded support for special character input on the keyboard.\n\nThis app uses QuestPro's eye/hand tracking system.\n\nReading is possible by simply moving your gaze.\nIt also implements keyboard input, which can be entered with just a glance and a pinch.\n*Quest2 supports controller operation only\n\nBefore launching the application, please calibrate the eye tracking in the settings of the device.\nSettings > Motion Tracking > Eye Tracking > Adjust Eye Tracking > Redo", "short_description": "This is allows web browsing in VR"}]}, "developer_name": "Waka", "developer_privacy_policy_url": "https://sites.google.com/view/kindlereaderapp/", "developer_terms_of_service_url": null, "publisher_name": "Waka", "support_website_url": null, "website_url": "https://sidequestvr.com/user/285692", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
8241444_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYPqjD-gkwIQ7kNvwHhHVqC&_nc_oc=AdoHz6R48jm0k4FXw9CygztRn0y9M2Tta9hFWd96-sjdZSh-l_IYmLyRROb992pWh2g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCRCbeWSzgBVqFwmhMQO338nLOfNnMw2qx6G1AToYg0A&oe=6AE9EE44"}, {"file_name": "Group 3 (1).png", "id": "6521183777965497", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481473_6521183784632163_9201723830803460786_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2evSdqnDsUQ7kNvwExadEB&_nc_oc=AdqadL9kDQQnVge8tPVx4y5Mzl-AhxRiqZ-GMejBDfYLJdCSWlT8lqj35S_ZE5bcrRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvfprrzlQYQen5I_3gEeRh4soqEwpd2Tldos2peDTV7A&oe=6AEA02B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KindleReader", "keywords": [], "long_description": "Browse the web at your leisure.\nYou can also launch your Kindle from the Menu on the left of your view.\n\nAdded support for special character input on the keyboard.\n\nThis app uses QuestPro's eye/hand tracking system.\n\nReading is possible by simply moving your gaze.\nIt also implements keyboard input, which can be entered with just a glance and a pinch.\n*Quest2 supports controller operation only\n\nBefore launching the application, please calibrate the eye tracking in the settings of the device.\nSettings > Motion Tracking > Eye Tracking > Adjust Eye Tracking > Redo", "short_description": "This is allows web browsing in VR"}]}, "developer_name": "Waka", "developer_privacy_policy_url": "https://sites.google.com/view/kindlereaderapp/", "developer_terms_of_service_url": null, "publisher_name": "Waka", "support_website_url": null, "website_url": "https://sidequestvr.com/user/285692", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
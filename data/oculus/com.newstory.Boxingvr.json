ns": {"nodes": [{"id": "8970217599676970"}]}, "id": "1763235957784160"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "28192760653655960"}]}, "id": "586422750390422"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8736061393083704"}]}, "id": "1937343350097969"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8814742151905485"}]}, "id": "1209147106859134"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8744862058914930"}]}, "id": "2308575472812150"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8514194758664547"}]}, "id": "1289317375812588"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8402744566513201"}]}, "id": "448697474873488"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "9200623683297266"}]}, "id": "8365918743430767"}]}}, "firstRevision": {"nodes": [{"application": {"id": "9787197494656963", "release_date": 1746228360, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29012030171747074"}, "id": "965153675777697"}]}}, "binary": null, "live_binary": null, "created_date": 1793328829, "id": "29162052330078190", "is_initial_release": false, "name_with_fallback": "v131", "pdp_metadata_with_fallback": {"version": 78, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "29162064090077014"}, "release_status": "RELEASED", "id": "9787197494656963"}, "id": "29162064090077014", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9787197494656963", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "26265452923061985"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2651725188611471", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fit Beat Combat : Boxing Fitness Workout", "keywords": ["Cardio", "Exercise", "Dance", "Music", "MR"], "long_description": "# \ud83e\uddb5 Neues Update: Knee Strike & 3 neue Tracks!\nBringe dein Workout aufs n\u00e4chste Level mit dem brandneuen Knee Strike und 3 neuen Tracks!                                                                            \n{1459650419399137}\n\n# \u26a1 Sofortige Fitness, sofortiger Spa\u00df \ud83c\udfb5\n{2049681145601375}\nHeadset aufsetzen und in Sekunden losschlagen. Keine Einrichtung, keine Wartezeiten, keine komplizierten Men\u00fcs. Sofortiges Cardio erh\u00f6ht deinen Puls und bringt deinen K\u00f6rper in Bewegung.\n\n# \ud83c\udfdf\ufe0f Dein privater Ring, deine Regeln.\n{4238372609714179}\nIn deiner virtuellen Arena bestimmst du das Tempo. Schlage zu und weiche zu pulsierender Musik aus \u2013 ohne Druck oder Urteile. Dank einfacher Steuerung bist du sofort in Bewegung.\n\n# \ud83d\udcaa Fitness, die sich gut anf\u00fchlt.\nVergiss den Druck. Genie\u00dfe die Bewegung und erreiche deine Ziele \u2013 ob Stressabbau, bessere Ausdauer oder Gewichtsverlust \u2013 bequem und privat von zu Hause aus.\n\n# \ud83c\udfb6 Dein pers\u00f6nlicher Soundtrack zum Erfolg.\nMit deiner pers\u00f6nlichen Playlist macht Training mehr Spa\u00df. W\u00e4hle aus vielen Songs, schlage im Rhythmus zu und entdecke neue Favoriten f\u00fcr deinen Fitness-Soundtrack.\n\n# \ud83d\udd25 Hauptmerkmale:\n- \u26a1 Sofortige Action: Headset aufsetzen, in Sekunden mit dem Schlagen beginnen.\n- \ud83d\udcaa Ganzk\u00f6rper-Cardio: Beanspruche Arme, Rumpf und Beine f\u00fcr maximale Ergebnisse.\n- \ud83c\udfb5 Mitrei\u00dfender Soundtrack: Musik, die Lust auf Bewegung macht.\n- \ud83c\udfe0 Mixed Reality (MR) Fitness: Hol dir das Workout-Spiel in deine reale Welt.\n\n# Starte jetzt dein Workout.", "short_description": "Fit Beat Combat! Get fit having fun with music & coaching! Thrilling full-body workout. Quit boring exercises & achieve your ideal body!"}, {"images": {"nodes": []}, "id": "1643783283903311", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fit Beat Combat : Boxing Fitness Workout", "keywords": ["Cardio", "Exercise", "Dance", "Music", "MR"], "long_description": "# \ud83e\uddb5 \u6700\u65b0\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\uff1aKnee Strike \uff06 3\u3064\u306e\u65b0\u66f2\u304c\u767b\u5834\uff01\n\u65b0\u30a2\u30af\u30b7\u30e7\u30f3\u300cKnee Strike\u300d\u30683\u3064\u306e\u65b0\u66f2\u3067\u3001\u30ef\u30fc\u30af\u30a2\u30a6\u30c8\u3092\u3055\u3089\u306b\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\uff01                 \n{1094825993160381}\n\n# \u26a1 \u3059\u3050\u306b\u30d5\u30a3\u30c3\u30c8\u30cd\u30b9\u3001\u3059\u3050\u306b\u697d\u3057\u3044 \ud83c\udfb5\n{2681836245510343}\n\u30d8\u30c3\u30c9\u30bb\u30c3\u30c8\u3092\u88ab\u308c\u3070\u3001\u6570\u79d2\u3067\u30d1\u30f3\u30c1\u3092\u7e70\u308a\u51fa\u305b\u307e\u3059\u3002\u9762\u5012\u306a\u8a2d\u5b9a\u3084\u5f85\u3061\u6642\u9593\u3001\u8907\u96d1\u306a\u30e1\u30cb\u30e5\u30fc\u306f\u4e00\u5207\u3042\u308a\u307e\u305b\u3093\u3002\u5fc3\u62cd\u6570\u3092\u4e0a\u3052\u3001\u4f53\u3092\u52d5\u304b\u3059\u3001\u5373\u52b9\u6027\u306e\u3042\u308b\u6709\u9178\u7d20\u904b\u52d5\u3092\u697d\u3057\u307f\u307e\u3057\u3087\u3046\u3002\n\n# \ud83c\udfdf\ufe0f \u30d7\u30e9\u30a4\u30d9\u30fc\u30c8\u30ea\u30f3\u30b0\u3001\u3042\u306a\u305f\u3060\u3051\u306e\u30eb\u30fc\u30eb\u3002\n{2379280385889038}\n\u3042\u306a\u305f\u5c02\u7528\u306e\u30d0\u30fc\u30c1\u30e3\u30eb\u30a2\u30ea\u30fc\u30ca\u3067\u306f\u3001\u81ea\u5206\u306e\u30da\u30fc\u30b9\u3067\u9032\u3081\u3089\u308c\u307e\u3059\u3002\u30d7\u30ec\u30c3\u30b7\u30e3\u30fc\u3084\u5468\u56f2\u306e\u76ee\u3092\u6c17\u306b\u3059\u308b\u3053\u3068\u306a\u304f\u3001\u5fc3\u8e8d\u308b\u97f3\u697d\u306b\u5408\u308f\u305b\u3066\u30d1\u30f3\u30c1\u3084\u30c0\u30c3\u30b8\u3092\u6c7a\u3081\u307e\u3057\u3087\u3046\u3002\u30b7\u30f3\u30d7\u30eb\u306a\u64cd\u4f5c\u3067\u3001\u3059\u3050\u306b\u4f53\u3092\u52d5\u304b\u305b\u307e\u3059\u3002\n\n# \ud83d\udcaa \u5fc3\u5730\u3088\u3044\u30d5\u30a3\u30c3\u30c8\u30cd\u30b9\u3002\n\u30d7\u30ec\u30c3\u30b7\u30e3\u30fc\u306f\u5fd8\u308c\u307e\u3057\u3087\u3046\u3002\u30b9\u30c8\u30ec\u30b9\u89e3\u6d88\u3001\u30b9\u30bf\u30df\u30ca\u5411\u4e0a\u3001\u30c0\u30a4\u30a8\u30c3\u30c8\u306a\u3069\u3001\u76ee\u6a19\u3092\u9054\u6210\u3059\u308b\u559c\u3073\u3068\u4f53\u3092\u52d5\u304b\u3059\u697d\u3057\u3055\u3092\u3001\u81ea\u5b85\u3067\u30d7\u30e9\u30a4\u30d0\u30b7\u30fc\u3092\u5b88\u308a\u306a\u304c\u3089\u767a\u898b\u3067\u304d\u307e\u3059\u3002\n\n# \ud83c\udfb6 \u6210\u529f\u3078\u306e\u30d1\u30fc\u30bd\u30ca\u30eb\u30b5\u30a6\u30f3\u30c9\u30c8\u30e9\u30c3\u30af\u3002\n\u81ea\u5206\u3060\u3051\u306e\u30d7\u30ec\u30a4\u30ea\u30b9\u30c8\u304c\u3042\u308c\u3070\u3001\u30a8\u30af\u30b5\u30b5\u30a4\u30ba\u306f\u3082\u3063\u3068\u697d\u3057\u304f\u306a\u308a\u307e\u3059\u3002\u8c4a\u5bcc\u306a\u697d\u66f2\u304b\u3089\u304a\u6c17\u306b\u5165\u308a\u3092\u9078\u3073\u3001\u30ea\u30ba\u30e0\u306b\u5408\u308f\u305b\u3066\u30d1\u30f3\u30c1\u3092\u653e\u3061\u307e\u3057\u3087\u3046\u3002\u65b0\u3057\u3044\u304a\u6c17\u306b\u5165\u308a\u3092\u898b\u3064\u3051\u3066\u3001\u30d5\u30a3\u30c3\u30c8\u30cd\u30b9\u306b\u6700\u9069\u306a\u30b5\u30a6\u30f3\u30c9\u30c8\u30e9\u30c3\u30af\u3092\u4f5c\u308a\u4e0a\u3052\u3066\u304f\u3060\u3055\u3044\u3002\n\n# \ud83d\udd25 \u4e3b\u306a\u7279\u5fb4\uff1a\n- \u26a1 \u30a4\u30f3\u30b9\u30bf\u30f3\u30c8\u30a2\u30af\u30b7\u30e7\u30f3\uff1a\u30d8\u30c3\u30c9\u30bb\u30c3\u30c8\u3092\u88ab\u308c\u3070\u3001\u3059\u3050\u306b\u30d1\u30f3\u30c1\u958b\u59cb\n- \ud83d\udcaa \u5168\u8eab\u306e\u6709\u9178\u7d20\u904b\u52d5\uff1a\u8155\u3001\u4f53\u5e79\u3001\u811a\u3092\u4f7f\u3063\u3066\u6700\u5927\u9650\u306e\u6210\u679c\u3092\n- \ud83c\udfb5 \u6c17\u5206\u304c\u4e0a\u304c\u308b\u30b5\u30a6\u30f3\u30c9\u30c8\u30e9\u30c3\u30af\uff1a\u4f53\u3092\u52d5\u304b\u3057\u305f\u304f\u306a\u308b\u97f3\u697d\n- \ud83c\udfe0 MR\uff08\u8907\u5408\u73fe\u5b9f\uff09\u30d5\u30a3\u30c3\u30c8\u30cd\u30b9\uff1a\u73fe\u5b9f\u4e16\u754c\u306b\u30ef\u30fc\u30af\u30a2\u30a6\u30c8\u30b2\u30fc\u30e0\u3092\u878d\u5408\u3002\n\n# \u4eca\u3059\u3050\u30ef\u30fc\u30af\u30a2\u30a6\u30c8\u3092\u59cb\u3081\u307e\u3057\u3087\u3046\u3002", "short_description": "Fit Beat Combat! Get fit having fun with music & coaching! Thrilling full-body workout. Quit boring exercises & achieve your ideal body!"}, {"images": {"nodes": []}, "id": "1316973010495036", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fit Beat Combat : Boxing Fitness Workout", "keywords": ["Cardio", "Exercise", "Dance", "Music", "MR"], "long_description": "# \ud83e\uddb5 Derni\u00e8re mise \u00e0 jour : Knee Strike et 3 nouvelles pistes !\nBoostez votre entra\u00eenement avec le tout nouveau mouvement Knee Strike et 3 nouvelles pistes !                                           \n{4562791137329282} \n\n# \u26a1 Fitness instantan\u00e9, plaisir instantan\u00e9 \ud83c\udfb5\n{2102684333905371}\nEnfilez le casque et frappez en quelques secondes. Sans r\u00e9glages, attente ni menus compliqu\u00e9s. Du cardio pour faire battre votre c\u0153ur et bouger.\n\n# \ud83c\udfdf\ufe0f Votre ring priv\u00e9, vos r\u00e8gles.\n{26352310647721888}\nDans votre ar\u00e8ne virtuelle, vous donnez le rythme. Frappez et esquivez en musique, sans pression ni jugement. Des commandes simples pour commencer.\n\n# \ud83d\udcaa Le fitness qui fait du bien.\nOubliez la pression. Prenez plaisir \u00e0 bouger et atteignez vos objectifs : r\u00e9duire le stress, gagner en endurance ou perdre du poids, chez vous et en toute intimit\u00e9.\n\n# \ud83c\udfb6 Votre bande-son personnelle vers le succ\u00e8s.\nEntra\u00eenez-vous avec votre playlist ! Choisissez parmi de nombreux morceaux, frappez en rythme, d\u00e9couvrez de nouveaux favoris et cr\u00e9ez la bande-son id\u00e9ale de vos s\u00e9ances.\n\n# \ud83d\udd25 Caract\u00e9ristiques principales :\n- \u26a1 Action instantan\u00e9e : Mettez le casque et frappez en quelques secondes.\n- \ud83d\udcaa Cardio pour tout le corps : Sollicitez bras, abdos et jambes pour un maximum de r\u00e9sultats.\n- \ud83c\udfb5 Bande-son stimulante : Une musique qui donne envie de bouger.\n- \ud83c\udfe0 Fitness en R\u00e9alit\u00e9 Mixte (MR) : Int\u00e9grez le jeu \u00e0 votre environnement r\u00e9el.\n\n# Commencez votre entra\u00eenement maintenant.", "short_description": "Fit Beat Combat! Get fit having fun with music & coaching! Thrilling full-body workout. Quit boring exercises & achieve your ideal body!"}, {"images": {"nodes": []}, "id": "1147747577703859", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fit Beat Combat : Boxing Fitness Workout", "keywords": ["Cardio", "Exercise", "Dance", "Music", "MR"], "long_description": "# \ud83e\uddb5 \u00daltima actualizaci\u00f3n: \u00a1Knee Strike y 3 nuevas pistas!\n\u00a1Potencia tu entrenamiento con el nuevo movimiento Knee Strike y 3 pistas totalmente nuevas!                                                     \n{1614893733713394}\n\n# \u26a1 Fitness al instante, diversi\u00f3n al instante \ud83c\udfb5\n{957766106812491}\nPonte el visor y lanza pu\u00f1etazos en segundos. Sin configuraci\u00f3n, esperas ni men\u00fas complicados. Cardio que acelera tu coraz\u00f3n y te pone en movimiento.\n\n# \ud83c\udfdf\ufe0f Tu ring privado, tus reglas.\n{907116615498227}\nEn tu arena virtual, t\u00fa marcas el ritmo. Golpea y esquiva al son de m\u00fasica trepidante, sin presi\u00f3n ni juicios. Controles sencillos para moverte en segundos.\n\n# \ud83d\udcaa Fitness que te hace sentir bien.\nOlvida la presi\u00f3n. Disfruta movi\u00e9ndote y alcanza tus objetivos: aliviar el estr\u00e9s, mejorar tu resistencia o perder peso, desde la comodidad y privacidad de tu hogar.\n\n# \ud83c\udfb6 Tu banda sonora personal hacia el \u00e9xito.\nHaz ejercicio con tu propia lista de reproducci\u00f3n. Elige entre muchas canciones y lanza pu\u00f1etazos al ritmo. Descubre nuevas favoritas y crea la banda sonora perfecta para entrenar.\n\n# \ud83d\udd25 Caracter\u00edsticas principales:\n- \u26a1 Acci\u00f3n instant\u00e1nea: Ponte el visor y empieza a golpear en segundos.\n- \ud83d\udcaa Cardio de cuerpo completo: Activa brazos, core y piernas al m\u00e1ximo.\n- \ud83c\udfb5 Banda sonora motivadora: M\u00fasica que te da ganas de moverte.\n- \ud83c\udfe0 Fitness en Realidad Mixta (MR): Lleva el juego de entrenamiento a tu mundo real.\n\n# Empieza tu entrenamiento ahora.", "short_description": "Fit Beat Combat! Get fit having fun with music & coaching! Thrilling full-body workout. Quit boring exercises & achieve your ideal body!"}, {"images": {"nodes": [{"file_name": "3.png", "id": "2009570946420566", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628067_2009570949753899_6618325895674502354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atI2BJK1kmsQ7kNvwH89NbL&_nc_oc=AdrAhnf_55yufxcn7Gr8KXbQN-G6ckgadGHmzuS05wcOtT0x47cSzwNy291uqr5UjeU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj9UqQpq2IeU3jFYSANiS2r5-IGrDKhUhiPftQ_lo_CQ&oe=6AEDD764"}, {"file_name": "4.png", "id": "1725650019196469", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620669_1725650022529802_4376168917420830660_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99_wDYAf8yYQ7kNvwEl6WYF&_nc_oc=AdrzQ5R5vh0uesuqVAkSNhRUJ24-aButi_v3Hl1FAKf6cRj6-dSlXUpWFmB7mhKuakY&_nc_zt=3&
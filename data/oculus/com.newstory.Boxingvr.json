XA&oe=6A7DB395"}, {"file_name": "screenshot4.png", "id": "3508709025927990", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391985_3508709029261323_3016583868344724243_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-istZ65MpgQ7kNvwFTuLPV&_nc_oc=Adqg-8IPD2VxGeLZKNFcLCSYS9Aw5uNGzeyueoArRkXkwWjPgQqvtqT6jYE0BgHkyTY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJhDzL7rbPl04naNDGgX6AJ9FTxJqfER9fhZDFauOEsg&oe=6A7DBDA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1333140684643275", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391976_1333140687976608_7978945902575114739_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9Zz8TLSMLEQ7kNvwE9364H&_nc_oc=AdoDKavD4lQEsHUvU2BTToUuYJ0eYKQVhGa4NLvcYSRwzZexgZPvXK7jpdkrV4xHhoA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF24La1S98W4k8BtaQ-BTLaEaAU56Y7x21DErIklS6IZQ&oe=6A7DC210"}, "display_name": "Fit Beat Combat : Free Style Boxing", "keywords": ["Fitness", "Boxing"], "long_description": "# Catch the Rhythm, Punch Your Way to Fit in VR!\n\nTired of boring workouts? Ready to **truly enjoy** getting fit? Welcome to **Fit Beat Combat Boxing**! Experience an exhilarating **VR fitness game** on Meta Quest where rhythm meets power! This isn't just another game \u2013 it's your personal boxing ring, high-energy dance floor, and path to a healthier, stronger you. An addictive **VR workout** challenge!\n\n# Feel the Beat, Land the Punch!\n\nDynamic VR arenas meet heart-pumping music. Simple controls: put on your Quest headset (2, 3, or Pro) & move! Notes sync to infectious beats. Unleash your inner champion! **Jab, cross, hook, and uppercut** notes with precision. **Duck and weave** past obstacles, keeping your body moving and heart rate soaring. Intuitive, exhilarating, fun **full-body workout** to make you sweat! Perfect for cardio and calorie burning!\n\n# Your Personal Coach Awaits!\n\nYou're not alone. Our expert **virtual instructor** guides form, pushes you, & cheers you on. Learn technique and feel the burn. Adapts for **beginners** to **fitness pros** to keep you motivated.\n\n# Workout Your Way!\n\nDitch boring apps & gyms! **Fit Beat Combat Boxing** is your fun, effective fitness routine. Smash beats to reach goals like **weight loss**, boosting **stamina**, improving **coordination**, or **stress relief**!\n\n# Key Features:\n\n- **Rhythm Boxing Gameplay:** Punch, duck, dodge to music! Music & exercise.\n- **Full-Body Workout:** Arms, core, legs workout for max calorie burn.\n- **Engaging Soundtrack:** Energizing music keeps you moving.\n\n\n", "short_description": "Rhythm Boxing Fitness! Get fit having fun with music & coaching! Thrilling full-body workout on Meta Quest. Quit boring exercises & achieve your ideal body!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9888987014478010"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1380758903347046"}]}, "baseline_offer": {"id": "1380758903347046"}, "is_approved": true, "firstOffe
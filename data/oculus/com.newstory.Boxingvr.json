FUalZy_wRw&oe=6B103E2E"}, {"file_name": "screenshot1.png", "id": "1191477619115653", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821799_1191477622448986_335158506262625688_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhtwgHzIaLEQ7kNvwHq9dNc&_nc_oc=AdqH5yOhl_s6mf-AHCNi0BTd0qsURKNyyOxzsNMXAHiFXHSKcWuAuZcV6qbtPS4gTAw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW3CRIEWXjqXVpyBVEAfAlpImbMljrB6iNhvkEw16Fz_g&oe=6B104D77"}, {"file_name": "screenshot.png", "id": "1014885264124822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819375_1014885267458155_4732627606674535666_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-zjPqSDsOUQ7kNvwF-oA7S&_nc_oc=Adq4ed5J5vyayqE1E-xmOQ1_znx6TpADE9p8T2KFfqEXHNmdpo9M7_ng5GlWxZTI7L0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWbMAcIfbbl7N14vONuXgyoZPSBBKju4alfo5RBCz-nGw&oe=6B103725"}, {"file_name": "screenshot2.png", "id": "592606743148111", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391923_592606746481444_8966562253819213417_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0SiHBE5B7YQ7kNvwHajCf9&_nc_oc=AdqfYcac-vqvGiYmXyk5BDC8TEKi9gvVTEZ5h6oxISZFVWurB7IpMxEYmi3Ox2m41ZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWshWDnQkamtY_f8Ai8gok7gybaxYc9aINx1Sw23oKQIg&oe=6B104255"}, {"file_name": "screenshot4.png", "id": "3508709025927990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391985_3508709029261323_3016583868344724243_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omZW9Zq_KD8Q7kNvwEWo9Rk&_nc_oc=AdprKAgTUgRosaH58YeqUHh0PgbGgnaIYDRsFHWmrXSs-yrVXg-15oOA45nosmOuN74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUruIG4HK5krCYqfqS1o-MIf8V_M8CTSDhsmsJ6-BJjcg&oe=6B104C67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1333140684643275", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391976_1333140687976608_7978945902575114739_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjI8PAghMwsQ7kNvwEDT_y-&_nc_oc=AdqZh5PRzytaH9LVCIG8W-w32AZwSPwmazS_GfhoMMNNWY5Bm_N0OcHCp9Vv4XKN9D4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWkpCqKygjdtIW-N8tGzulXBtfdw_sNGh_xlxAOpZxFUA&oe=6B1050D0"}, "display_name": "Fit Beat Combat : Free Style Boxing", "keywords": ["Fitness", "Boxing"], "long_description": "# Catch the Rhythm, Punch Your Way to Fit in VR!\n\nTired of boring workouts? Ready to **truly enjoy** getting fit? Welcome to **Fit Beat Combat Boxing**! Experience an exhilarating **VR fitness game** on Meta Quest where rhythm meets power! This isn't just another game \u2013 it's your personal boxing ring, high-energy dance floor, and path to a healthier, stronger you. An addictive **VR workout** challenge!\n\n# Feel the Beat, Land the Punch!\n\nDynamic VR arenas meet heart-pumping music. Simple controls: put on your Quest headset (2, 3, or Pro) & move! Notes sync to infectious beats. Unleash your inner champion! **Jab, cross, hook, and uppercut** notes with precision. **Duck and weave** past obstacles, keeping your body moving and heart rate soaring. Intuitive, exhilarating, fun **full-body workout** to make you sweat! Perfect for cardio and calorie burning!\n\n# Your Personal Coach Awaits!\n\nYou're not alone. Our expert **virtual instructor** guides form, pushes you, & cheers you on. Learn technique and feel the burn. Adapts for **beginners** to **fitness pros** to keep you motivated.\n\n# Workout Your Way!\n\nDitch boring apps & gyms! **Fit Beat Combat Boxing** is your fun, effective fitness routine. Smash beats to reach goals like **weight loss**, boosting **stamina**, improving **coordination**, or **stress relief**!\n\n# Key Features:\n\n- **Rhythm Boxing Gameplay:** Punch, duck, dodge to music! Music & exercise.\n- **Full-Body Workout:** Arms, core, legs workout for max calorie burn.\n- **Engaging Soundtrack:** Energizing music keeps you moving.\n\n\n", "short_description": "Rhythm Boxing Fitness! Get fit having fun with music & coaching! Thrilling full-body workout on Meta Quest. Quit boring exercises & achieve your ideal body!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9888987014478010"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1380758903347046"}]}, "baseline_offer": {"id": "1380758903347046"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746228360, "status": "PUBLISHED", "id": "1380758903347046"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29344169205199834", "version": "0.8.0"}, "id": "965153675777697", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9787197494656963", "is_concept": fals
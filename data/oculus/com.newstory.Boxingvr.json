ons": {"nodes": [{"id": "9282212405125443"}]}, "id": "1077625760409013"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8970217599676970"}]}, "id": "1763235957784160"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "28192760653655960"}]}, "id": "586422750390422"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8736061393083704"}]}, "id": "1937343350097969"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8814742151905485"}]}, "id": "1209147106859134"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8744862058914930"}]}, "id": "2308575472812150"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8514194758664547"}]}, "id": "1289317375812588"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8402744566513201"}]}, "id": "448697474873488"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "9200623683297266"}]}, "id": "8365918743430767"}]}}, "firstRevision": {"nodes": [{"application": {"id": "9787197494656963", "release_date": 1746228360, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29344169205199834"}, "id": "965153675777697"}]}}, "binary": null, "live_binary": null, "created_date": 1794879820, "id": "29417748361175251", "is_initial_release": false, "name_with_fallback": "v136", "pdp_metadata_with_fallback": {"version": 82, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "29417748334508587"}, "release_status": "RELEASED", "id": "9787197494656963"}, "id": "29417748334508587", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9787197494656963", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "26265452923061985"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "40188252717486951", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fit Beat Combat : Boxing Fitness Workout", "keywords": ["Cardio", "Exercise", "Dance", "Music", "MR"], "long_description": "# \ud83c\udfcfNeues Update: Swing Flow!\nSchwing den Schl\u00e4ger und triff die Noten! Bring dein Workout mit Swing Flow auf Touren!                                                                                                       \n{1482453920650023}\n\n# \ud83e\uddb5 Mehr Power mit Knee Strike!\nBring dein Workout mit dem kraftvollen Knee Strike aufs n\u00e4chste Level!\n{1159251357040592}\n\n# \u26a1 Sofort Fitness, sofort Spa\u00df \ud83c\udfb5\n{1823665408684663}\n\nHeadset auf und in Sekunden losboxen. Ohne Vorbereitung, Warten oder komplizierte Men\u00fcs. Direktes Cardiotraining, das Herz und K\u00f6rper in Schwung bringt.\n\n# \ud83c\udfdf\ufe0f Dein Ring, deine Regeln.\n{2565205847323314}\nIn deiner virtuellen Arena bestimmst du das Tempo. Schlage und weiche zu mitrei\u00dfender Musik aus, ohne Druck oder Bewertung.\n\n# \ud83d\udcaa Fitness, die sich gut anf\u00fchlt.\nHab Spa\u00df an Bewegung und erreiche deine Ziele: Stress abbauen, Ausdauer steigern oder abnehmen, ganz bequem und ungest\u00f6rt zu Hause.\n\n# \ud83c\udfb6 Dein Soundtrack zum Erfolg.\nMit deiner Playlist macht Training mehr Spa\u00df. W\u00e4hle aus vielen Songs und schlage im Takt. Entdecke neue Favoriten f\u00fcr deinen perfekten Fitness-Soundtrack.\n\n# \ud83d\udd25 Highlights:\n- \u26a1 Sofort loslegen: Headset auf und in Sekunden losboxen\n- \ud83d\udcaa Ganzk\u00f6rper-Cardio: Trainiere Arme, Rumpf und Beine f\u00fcr maximale Ergebnisse\n- \ud83c\udfb5 Mitrei\u00dfende Musik: Songs, die Lust auf Bewegung machen\n- \ud83c\udfe0 Mixed-Reality-Fitness (MR): Hol das Workout-Spiel in deine reale Umgebung.\n\n# Starte jetzt dein Workout!", "short_description": "Fit Beat Combat! Get fit having fun with music & coaching! Thrilling full-body workout. Quit boring exercises & achieve your ideal body!"}, {"images": {"nodes": []}, "id": "1658913105935770", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fit Beat Combat : Boxing Fitness Workout", "keywords": ["Cardio", "Exercise", "Dance", "Music", "MR"], "long_description": "# \ud83c\udfcf\u00daltima actualizaci\u00f3n: \u00a1Swing Flow!\n\u00a1Batea las notas! \u00a1Dale m\u00e1s energ\u00eda a tu entrenamiento con Swing Flow!                                                                                                  \n{1479379370810109}\n\n# \ud83e\uddb5 \u00a1M\u00e1s energ\u00eda con Knee Strike!\n\u00a1Lleva tu entrenamiento al siguiente nivel con el potente movimiento Knee Strike!\n{2338769150246482}\n\n# \u26a1 Fitness al instante, diversi\u00f3n inmediata \ud83c\udfb5\n{2630171710742308}\n\nPonte el visor y empieza a golpear en segundos. Sin preparativos, esperas ni men\u00fas complicados. Cardio al instante que acelera tu coraz\u00f3n y pone tu cuerpo en movimiento.\n\n# \ud83c\udfdf\ufe0f Tu ring, tus reglas.\n{1135537286074100}\nEn tu arena virtual, t\u00fa marcas el ritmo. Golpea y esquiva con m\u00fasica vibrante, sin presi\u00f3n ni juicios.\n\n# \ud83d\udcaa Fitness para sentirte bien.\nDisfruta movi\u00e9ndote y alcanza tus metas: aliviar el estr\u00e9s, mejorar tu resistencia o perder peso, con la comodidad y privacidad de tu hogar.\n\n# \ud83c\udfb6 Tu banda sonora hacia el \u00e9xito.\nEntrenar es m\u00e1s divertido con tu playlist. Elige entre muchas canciones y golpea al ritmo. Descubre nuevos favoritos y crea tu banda sonora ideal para entrenar.\n\n# \ud83d\udd25 Caracter\u00edsticas:\n- \u26a1 Acci\u00f3n inmediata: ponte el visor y golpea en segundos\n- \ud83d\udcaa Cardio de cuerpo completo: trabaja brazos, tronco y piernas para maximizar resultados\n- \ud83c\udfb5 M\u00fasica motivadora: canciones que te invitan a moverte\n- \ud83c\udfe0 Fitness en realidad mixta (MR): lleva el juego de entrenamiento a tu mundo real.\n\n# \u00a1Empieza a entrenar ahora!", "short_description": "Fit Beat Combat! Get fit having fun with music & coaching! Thrilling full-body workout. Quit boring exercises & achieve your ideal body!"}, {"images": {"nodes": []}, "id": "1319425960285942", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fit Beat Combat : Boxing Fitness Workout", "keywords": ["Cardio", "Exercise", "Dance", "Music", "MR"], "long_description": "# \ud83c\udfcf\u6700\u65b0\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\uff1aSwing Flow\uff01\n\u30d0\u30c3\u30c8\u3092\u632f\u3063\u3066\u30ce\u30fc\u30c4\u3092\u6253\u3068\u3046\uff01\u300cSwing Flow\u300d\u3067\u30ef\u30fc\u30af\u30a2\u30a6\u30c8\u3092\u3055\u3089\u306b\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\uff01                                                                   \n{1793742395235645}\n\n# \ud83e\uddb5 \u30cb\u30fc\u30b9\u30c8\u30e9\u30a4\u30af\u3067\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\uff01\n\u529b\u5f37\u3044\u30cb\u30fc\u30b9\u30c8\u30e9\u30a4\u30af\u3067\u3001\u30ef\u30fc\u30af\u30a2\u30a6\u30c8\u3092\u3055\u3089\u306b\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\uff01\n{1145483124547237}\n\n# \u26a1 \u3059\u3050\u904b\u52d5\u3001\u3059\u3050\u697d\u3057\u3044 \ud83c\udfb5\n{28769435342756513}\n\n\u30d8\u30c3\u30c9\u30bb\u30c3\u30c8\u3092\u88c5\u7740\u3059\u308c\u3070\u3001\u6570\u79d2\u3067\u30d1\u30f3\u30c1\u3092\u30b9\u30bf\u30fc\u30c8\u3002\u6e96\u5099\u3082\u5f85\u3061\u6642\u9593\u3082\u3001\u8907\u96d1\u306a\u30e1\u30cb\u30e5\u30fc\u3082\u3042\u308a\u307e\u305b\u3093\u3002\u5fc3\u62cd\u6570\u3092\u4e0a\u3052\u3001\u4f53\u3092\u52d5\u304b\u3059\u6709\u9178\u7d20\u904b\u52d5\u3092\u3059\u3050\u306b\u697d\u3057\u3081\u307e\u3059\u3002\n\n# \ud83c\udfdf\ufe0f \u81ea\u5206\u3060\u3051\u306e\u30ea\u30f3\u30b0\u3001\u81ea\u5206\u3060\u3051\u306e\u30eb\u30fc\u30eb\u3002\n{2658475121258919}\n\u81ea\u5206\u3060\u3051\u306e\u30d0\u30fc\u30c1\u30e3\u30eb\u30a2\u30ea\u30fc\u30ca\u3067\u3001\u30da\u30fc\u30b9\u3092\u6c7a\u3081\u308b\u306e\u306f\u3042\u306a\u305f\u3002\u30d7\u30ec\u30c3\u30b7\u30e3\u30fc\u3084\u4eba\u76ee\u3092\u6c17\u306b\u305b\u305a\u3001\u5fc3\u8e8d\u308b\u97f3\u697d\u306b\u5408\u308f\u305b\u3066\u30d1\u30f3\u30c1\u3084\u56de\u907f\u3092\u697d\u3057\u307f\u307e\u3057\u3087\u3046\u3002\n\n# \ud83d\udcaa \u6c17\u6301\u3061\u3088\u304f\u697d\u3057\u3081\u308b\u30d5\u30a3\u30c3\u30c8\u30cd\u30b9\u3002\n\u30d7\u30ec\u30c3\u30b7\u30e3\u30fc\u306f\u5fd8\u308c\u307e\u3057\u3087\u3046\u3002\u30b9\u30c8\u30ec\u30b9\u89e3\u6d88\u3001\u6301\u4e45\u529b\u30a2\u30c3\u30d7\u3001\u6e1b\u91cf\u306a\u3069\u3001\u81ea\u5206\u306e\u76ee\u6a19\u306b\u5411\u304b\u3063\u3066\u4f53\u3092\u52d5\u304b\u3059\u559c\u3073\u3092\u3001\u5feb\u9069\u3067\u30d7\u30e9\u30a4\u30d0\u30b7\u30fc\u306e\u5b88\u3089\u308c\u305f\u81ea\u5b85\u3067\u697d\u3057\u3081\u307e\u3059\u3002\n\n# \ud83c\udfb6 \u76ee\u6a19\u9054\u6210\u3092\u5f8c\u62bc\u3057\u3059\u308b\u3001\u81ea\u5206\u3060\u3051\u306e\u30b5\u30a6\u30f3\u30c9\u30c8\u30e9\u30c3\u30af\u3002\n\u304a\u6c17\u306b\u5165\u308a\u306e\u30d7\u30ec\u30a4\u30ea\u30b9\u30c8\u304c\u3042\u308c\u3070\u3001\u904b\u52d5\u306f\u3082\u3063\u3068\u697d\u3057\u304f\u306a\u308a\u307e\u3059\u3002\u591a\u5f69\u306a\u697d\u66f2\u304b\u3089\u9078\u3093\u3067\u3001\u30ea\u30ba\u30e0\u306b\u5408\u308f\u305b\u3066\u30d1\u30f3\u30c1\u3002\u65b0\u3057\u3044\u304a\u6c17\u306b\u5165\u308a\u3092\u898b\u3064\u3051\u3066\u3001\u30d5\u30a3\u30c3\u30c8\u30cd\u30b9\u306b\u3074\u3063\u305f\u308a\u306e\u30b5\u30a6\u30f3\u30c9\u30c8\u30e9\u30c3\u30af\u3092\u4f5c\u308a\u307e\u3057\u3087\u3046\u3002\n\n# \ud83d\udd25 \u4e3b\u306a\u7279\u5fb4\uff1a\n- \u26a1 \u3059\u3050\u306b\u30b9\u30bf\u30fc\u30c8\uff1a\u30d8\u30c3\u30c9\u30bb\u30c3\u30c8\u3092\u88c5\u7740\u3057\u3066\u3001\u6570\u79d2\u3067\u30d1\u30f3\u30c1\u958b\u59cb\n- \ud83d\udcaa \u5168\u8eab\u306e\u6709\u9178\u7d20\u904b\u52d5\uff1a\u8155\u30fb\u4f53\u5e79\u30fb\u811a\u3092\u4f7f\u3063\u3066\u3001\u904b\u52d5\u52b9\u679c\u3092\u6700\u5927\u9650\u306b\n- \ud83c\udfb5 \u6c17\u5206\u304c\u4e0a\u304c\u308b\u30b5\u30a6\u30f3\u30c9\u30c8\u30e9\u30c3\u30af\uff1a\u601d\u308f\u305a\u4f53\u3092\u52d5\u304b\u3057\u305f\u304f\u306a\u308b\u97f3\u697d\n- \ud83c\udfe0 \u8907\u5408\u73fe\u5b9f\uff08MR\uff09\u30d5\u30a3\u30c3\u30c8\u30cd\u30b9\uff1a\u73fe\u5b9f\u306e\u7a7a\u9593\u3067\u30ef\u30fc\u30af\u30a2\u30a6\u30c8\u30b2\u30fc\u30e0\u3092\u697d\u3057\u3082\u3046\u3002\n\n# \u4eca\u3059\u3050\u30ef\u30fc\u30af\u30a2\u30a6\u30c8\u3092\u59cb\u3081\u3088\u3046\u3002", "short_description": "Fit Beat Combat! Get fit having fun with music & coaching! Thrilling full-body workout. Quit boring exercises & achieve your ideal body!"}, {"images": {"nodes": [{"file_name": "A.png", "id": "4671824699768420", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593869844_4671824703101753_602400326884814174_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEtq_oT5CoYQ7kNvwGUiPGG&_nc_oc=AdplU8w177xpMVEZi9fVqeUKtlCjOUjkijNxJNYRRqevcdrTZFSvmV6tNi6xTSTizyo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUrrrTBqgevtAP7jS5W8v_hrozXZGWRKC9Cg92RuzZ9dg&oe=6B105348"}, {"file_name": "Thanksgiving_Equirectangular.png", "id": "1889909521892059", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619369_1889909525225392_7393719136551401644_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6AaJz8B-xAQ7kNvwGDYlSK&_nc_oc=AdpRvP3PH3xuN5XBm-4vtmKotRHQVxT
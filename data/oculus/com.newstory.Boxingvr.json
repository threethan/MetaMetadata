b=1-7&_nc_sid=6e7a0a&_nc_ohc=xO6NixoB9c8Q7kNvwFTww3a&_nc_oc=AdpxyhEVpWnJuTOj_WMd1KKk9kQU9UF7TEqT7sap7Of5jVbBzY70knA2-knrxeyA3BU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MkMDFMNvhUk4FGjK8PF7nicdJI_63b3nDQ1I5yhzWZg&oe=6A25A277"}, {"file_name": "screenshot.png", "id": "1014885264124822", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819375_1014885267458155_4732627606674535666_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heqoB8GeZVsQ7kNvwHe-QOX&_nc_oc=Adpva7dl1au19gIcWtUvA1ZoK6ZQ2CWHknzBrtEW70FGyUG_p_R9vru1z1jSIM6tODE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TFwak37QRVoibll0GZM4p6OJhEZEwFUyA1DEienyL4Q&oe=6A258C25"}, {"file_name": "screenshot2.png", "id": "592606743148111", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391923_592606746481444_8966562253819213417_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iM8QZO8YmJ0Q7kNvwEDZK90&_nc_oc=Adp0zqh4Ah54jf3szWMTlerajUE0w3sobS5GerVN2s5l2FVevOGBHXwAuLqLfcQd7hk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dnwitClZTEM7_5Uic3JD77MZWHyaocN4TDDrx0_Q4Uw&oe=6A259755"}, {"file_name": "screenshot4.png", "id": "3508709025927990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391985_3508709029261323_3016583868344724243_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OTIi4Cw4aQQ7kNvwHu9h6_&_nc_oc=Adqw6LAX5JqeFBHb9GRpa5faBmH5rBQfiups7dpKUKjG4ghnsQdAPgQ4hiPfRC3a4SY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CGzj2xFpHqfjD0oJxaip9mQGml6jE9adKxHr1dJy4Pw&oe=6A25A167"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1333140684643275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391976_1333140687976608_7978945902575114739_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cThW4BvKLv0Q7kNvwFE3U9C&_nc_oc=AdpcWKQj-jFTY2fg9wRDXxYAJHPUErgd68YBi2_9PlN3cKUugYsvkYimyWozqC9sS_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QHB97dKrRsVskohCFRl_xS4KP78HER-23SwOP6Uc9MA&oe=6A25A5D0"}, "display_name": "Fit Beat Combat : Free Style Boxing", "keywords": ["Fitness", "Boxing"], "long_description": "# Catch the Rhythm, Punch Your Way to Fit in VR!\n\nTired of boring workouts? Ready to **truly enjoy** getting fit? Welcome to **Fit Beat Combat Boxing**! Experience an exhilarating **VR fitness game** on Meta Quest where rhythm meets power! This isn't just another game \u2013 it's your personal boxing ring, high-energy dance floor, and path to a healthier, stronger you. An addictive **VR workout** challenge!\n\n# Feel the Beat, Land the Punch!\n\nDynamic VR arenas meet heart-pumping music. Simple controls: put on your Quest headset (2, 3, or Pro) & move! Notes sync to infectious beats. Unleash your inner champion! **Jab, cross, hook, and uppercut** notes with precision. **Duck and weave** past obstacles, keeping your body moving and heart rate soaring. Intuitive, exhilarating, fun **full-body workout** to make you sweat! Perfect for cardio and calorie burning!\n\n# Your Personal Coach Awaits!\n\nYou're not alone. Our expert **virtual instructor** guides form, pushes you, & cheers you on. Learn technique and feel the burn. Adapts for **beginners** to **fitness pros** to keep you motivated.\n\n# Workout Your Way!\n\nDitch boring apps & gyms! **Fit Beat Combat Boxing** is your fun, effective fitness routine. Smash beats to reach goals like **weight loss**, boosting **stamina**, improving **coordination**, or **stress relief**!\n\n# Key Features:\n\n- **Rhythm Boxing Gameplay:** Punch, duck, dodge to music! Music & exercise.\n- **Full-Body Workout:** Arms, core, legs workout for max calorie burn.\n- **Engaging Soundtrack:** Energizing music keeps you moving.\n\n\n", "short_description": "Rhythm Boxing Fitness! Get fit having fun with music & coaching! Thrilling full-body workout on Meta Quest. Quit boring exercises & achieve your ideal body!"}]}, "developer_name": null, "developer_priva
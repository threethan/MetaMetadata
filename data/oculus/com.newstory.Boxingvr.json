h=00_Af818pp1s3LuR96gVOfrUIr1tyiGi_JB48E7S37jkrm2fg&oe=6A47DA2E"}, {"file_name": "screenshot1.png", "id": "1191477619115653", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821799_1191477622448986_335158506262625688_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vIUrVyCi50Q7kNvwGiz_hK&_nc_oc=AdpYmSmnnl7P_-DTKypFLvj_SDA5UXAfZZaueeePZn8tOZ-mZXDVYz_YE4hBURp3JEw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y-bojni8GIOPpymqhR5sL1wy60rnN47OzIxTdQpr5Bg&oe=6A47B137"}, {"file_name": "screenshot.png", "id": "1014885264124822", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819375_1014885267458155_4732627606674535666_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2s42Ojaqn0Q7kNvwFgq8tk&_nc_oc=Adolav80dfitUH5rwU7Il_8dnyl_bf8-Tj2bY8Xvpt4a3JB5tmSlvsfeK3RKkyPWg_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pvW3gMtfas39x_kfnyecTK019695AK4dIPBHNPPyLEw&oe=6A47D325"}, {"file_name": "screenshot2.png", "id": "592606743148111", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391923_592606746481444_8966562253819213417_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrMdRFmMH5QQ7kNvwHkVfsU&_nc_oc=AdqwiOH7rkQ86uvQxl_SoAXBHkcXe2tMtYGNpsXQr5TlH81c9m1ro8h06N5Xe-VhQdA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c64qV8k3iylBb-so8tn2SKOMVPhLQiZFR_DilguIFyg&oe=6A47DE55"}, {"file_name": "screenshot4.png", "id": "3508709025927990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391985_3508709029261323_3016583868344724243_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRd1ETwhAegQ7kNvwH9nUwe&_nc_oc=AdpI4Ck6vQaGGGjNWXQkiwvVP7tfTsINP3ZhRa9VJ0perlHPOZLrQiz5S7k4_Rnwhrw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dMefqjx4-4BlmW5UnpR8UBYJ77_QmcAjiuehYCfdjrQ&oe=6A47B027"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1333140684643275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391976_1333140687976608_7978945902575114739_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIop8sb-fkcQ7kNvwGtDtLB&_nc_oc=Adou8shSSNFLkcFpOPFhrnT68XgI_VxJNSXR4Hsyva6BDpRvdjovUI19t6Z57LcJPNg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WTCM5v1SzA3bKplkDPNWoH_kVn3wsDnC4MRq_9foPQg&oe=6A47B490"}, "display_name": "Fit Beat Combat : Free Style Boxing", "keywords": ["Fitness", "Boxing"], "long_description": "# Catch the Rhythm, Punch Your Way to Fit in VR!\n\nTired of boring workouts? Ready to **truly enjoy** getting fit? Welcome to **Fit Beat Combat Boxing**! Experience an exhilarating **VR fitness game** on Meta Quest where rhythm meets power! This isn't just another game \u2013 it's your personal boxing ring, high-energy dance floor, and path to a healthier, stronger you. An addictive **VR workout** challenge!\n\n# Feel the Beat, Land the Punch!\n\nDynamic VR arenas meet heart-pumping music. Simple controls: put on your Quest headset (2, 3, or Pro) & move! Notes sync to infectious beats. Unleash your inner champion! **Jab, cross, hook, and uppercut** notes with precision. **Duck and weave** past obstacles, keeping your body moving and heart rate soaring. Intuitive, exhilarating, fun **full-body workout** to make you sweat! Perfect for cardio and calorie burning!\n\n# Your Personal Coach Awaits!\n\nYou're not alone. Our expert **virtual instructor** guides form, pushes you, & cheers you on. Learn technique and feel the burn. Adapts for **beginners** to **fitness pros** to keep you motivated.\n\n# Workout Your Way!\n\nDitch boring apps & gyms! **Fit Beat Combat Boxing** is your fun, effective fitness routine. Smash beats to reach goals like **weight loss**, boosting **stamina**, improving **coordination**, or **stress relief**!\n\n# Key Features:\n\n- **Rhythm Boxing Gameplay:** Punch, duck, dodge to music! Music & exercise.\n- **Full-Body Workout:** Arms, core, legs workout for max calorie burn.\n- **Engaging Soundtrack:** Energizing music keeps you moving.\n\n\n", "short_description": "Rhythm Boxing Fitness! Get fit having fun with music & coaching! Thrilling full-body workout on Meta Quest. Quit boring exercises & achieve your ideal body!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9888987014478010"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1380758903347046"}]}, "baseline_offer": {"id": "1380758903347046"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746228360, "status": "PUBLISHED", "id": "1380758903347046"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27560035650279874", "version": "0.6.2"}, "id": "965153675777697", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9787197494656963", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27560035650279874"}, 
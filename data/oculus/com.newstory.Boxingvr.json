name": "table_mountain_1_16k.png", "id": "870455398840533", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830893_870455405507199_575131571864202814_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9XZyuFjZVUQ7kNvwE2toxo&_nc_oc=AdrCkjIbAdQyFYzm0YOGo_QySEYljmzPxJMknRxNnih4B1Ch52JQ4sThvqn9cPS2NkU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBywswraoGtkFBFGcKKrpL2Ntye0H6am3BQ_aA2mttEQ&oe=6AEDD5C8"}]}, "id": "1124995300495689", "locale": "en_US", "screenshots": [{"file_name": "FPS.png", "id": "919250077473154", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_919250080806487_580455298902170055_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyaA4avwvgsQ7kNvwEbX3ns&_nc_oc=AdpixKXw9DAplGXkOt6JawffkdlRqyL3SWAnBAnDwnyumXNrrRdH8ifiVUN4JDLEWNc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8l_K5QB3hk4uUqAVmzEjzQ2sv1ZEr-eAy6_PaYQbONg&oe=6AEE0B3C"}, {"file_name": "photoreal.png", "id": "1931946477409053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296342_1931946484075719_4778743855189044071_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y88aYGlgUW4Q7kNvwGx83cv&_nc_oc=AdoPxMYurtib4hgAd55QinDWJtNfnxaWBIhbXmCAaL6FUAd2nxLzh6OpmqOo2Xhfzjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXQ4Bf2eMqRyZx3vFwLj4M8fyNPUBO76aF8S9Uq3uLSA&oe=6AEDF5E3"}, {"file_name": "04.png", "id": "917549137867701", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619704_917549144534367_1516646845863402957_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqD0zFt5dn0Q7kNvwFoKMN4&_nc_oc=AdqjtWVDfJCz94FgTmvZo2PKM0qk4pOsEW6LWBHJe8k2cyvV5fR03gM9H6GcuR7Mquo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGc0NhUrRkTcnorYw1hZL46mPBxLO3NSFC5DCA4xl5bg&oe=6AEDED7B"}, {"file_name": "Hand01.png", "id": "1250494173188580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295901_1250494176521913_1969780014278436682_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYQkNoV-r8gQ7kNvwFFLxcQ&_nc_oc=Adrb3lnUfosn81psdhsqapRp4BpTAG3C7pARnM7z-sLpvlbzgvjS1UTYFER8ImBZz7c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMGurgmRFDyx1wcHoD3pas4vAyjzVPPm_TpHr1Dzvwag&oe=6AEDDCB0"}, {"file_name": "03.png", "id": "819071991221979", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620965_819071994555312_4872624989676096735_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eH5dn2NpSkQQ7kNvwHA5I3k&_nc_oc=AdqhormEXKXHFuyk9lZtrZEKYAHB3J441dLrqx9R-_BPI3DF6CVJ7i5w7zkV7mXy3fk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCI0OS5zI1X1WK1Jz9O0xDwrk6BnYZvuqns6-afxUElA&oe=6AEDDF07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1393147342809311", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628893_1393147346142644_4835142897793746956_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5U3jTDd3lgQ7kNvwGA6eSR&_nc_oc=Adohuv9ciloSDh6kaxCYhdVPWyc4MCHc2gjIJz1UYzMGclpEsBcUtJFZ08RMqOypt24&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlqbnktK1Yg7jmNo9cprUPkHJBxT5r-Gh02WfaQzl3CA&oe=6AEDF57F"}, "display_name": "Fit Beat Combat : Boxing Fitness Workout", "keywords": ["Cardio", "Exercise", "Dance", "Music", "MR"], "long_description": "# \ud83e\uddb5 Latest Update: Knee Strike & 3 New Tracks!\nPower up your workout with the brand-new Knee Strike move and 3 fresh tracks!                                                                                                                  \n{1438345965070088}\n\n# \u26a1 Instant Fitness, Instant Fun \ud83c\udfb5\n{1602260954447685}\n \nPut on your headset and you're throwing punches in seconds. No setup, no waiting, no complicated menus. Just instant cardio that gets your heart pumping and your body moving.\n\n# \ud83c\udfdf\ufe0f Your Private Ring, Your Rules.\n{933141996220885}\nIn your own virtual arena, you set the pace. Punch and dodge to heart-pumping music without pressure or judgment. Simple controls mean you're moving in seconds.\n\n# \ud83d\udcaa Fitness That Feels Good.\nForget the pressure. Discover the joy of moving your body and reaching your goals\u2014whether it's stress relief, improved stamina, or weight loss\u2014all from the comfort and privacy of your home.\n\n# \ud83c\udfb6 Your Personal Soundtrack to Success.\nExercising is more fun when it\u2019s set to your personal playlist. Choose from a wide variety of songs and throw punches to the rhythm. Discover new favorites and build the perfect soundtrack for your fitness.\n\n# \ud83d\udd25 Key Features:\n- \u26a1 Instant Action: Put on headset, start punching in seconds\n- \ud83d\udcaa Full-Body Cardio: Engage your arms, core, and legs for maximum results\n- \ud83c\udfb5 Uplifting Soundtrack: Music that makes you want to move\n- \ud83c\udfe0 Mixed Reality (MR) Fitness: Bring the workout game into your real world.\n\n# Start Your Workout Now.", "short_description": "Fit Beat Combat! Get fit having fun with music & coaching! Thrilling full-body workout. Quit boring exercises & achieve your ideal body!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_mod
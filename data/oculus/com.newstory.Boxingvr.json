b=1-7&_nc_sid=6e7a0a&_nc_ohc=YAmbE85SU7cQ7kNvwEIAT_d&_nc_oc=Adpz3HatESSPNcfyOooKRxBrbF4umLPNv_vz3VbDZ1qyETFKHwlQy4h5UJm9K2plOtg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UkxpQX3f9NDPr6XNanBRfPtjOB44efnIO2XHSMUNfqg&oe=6A329937"}, {"file_name": "screenshot.png", "id": "1014885264124822", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819375_1014885267458155_4732627606674535666_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdJoGAC29xQQ7kNvwGtq01S&_nc_oc=AdqV-SupF19Cr5RHnrGvQ8GiByhq9FkTrFxM4BNQq9yoNOSeDtKnpJDb7GMQCZljEnY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_E3MSebjWp6rkhA0S5cl0OWpgqQqfGlkvYGmSUlUX3Ag&oe=6A32BB25"}, {"file_name": "screenshot2.png", "id": "592606743148111", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391923_592606746481444_8966562253819213417_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnWeaq-Qs4wQ7kNvwGoSNk0&_nc_oc=AdqLbvWoJ4FliAFZbIfKA_BE4PURZ0IKGsdwS8Bnvl_IJGjWe8kjaSAkhUopdm__X90&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g3cE68D66lR8IPfEGlfjnrwxhzmmWIZOMcKMmI3bdfQ&oe=6A32C655"}, {"file_name": "screenshot4.png", "id": "3508709025927990", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391985_3508709029261323_3016583868344724243_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PImK3tDAEzcQ7kNvwFVd3th&_nc_oc=AdpgPOPtB7vpYj8r7X86pn88yJQI3PxxycqNaKrdx-Gr9zJgFpxeHX2ce0JF9O9y1WQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O1qjmk9Aec40111gnQxA25Vhw25qImFLxPv6MnHoQ0Q&oe=6A329827"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1333140684643275", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391976_1333140687976608_7978945902575114739_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoEPYU2Kg7EQ7kNvwGXP4GR&_nc_oc=Adql-NOADB4-EN_JS2gax4UZWElIuXgRj9LOU3lyxLBeWcIEXz95MSjN_flVeAcLuPc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87weuDmRPpr-WvKde-dNfqE6jrzYm-ZPY8SxuUP6qbHQ&oe=6A329C90"}, "display_name": "Fit Beat Combat : Free Style Boxing", "keywords": ["Fitness", "Boxing"], "long_description": "# Catch the Rhythm, Punch Your Way to Fit in VR!\n\nTired of boring workouts? Ready to **truly enjoy** getting fit? Welcome to **Fit Beat Combat Boxing**! Experience an exhilarating **VR fitness game** on Meta Quest where rhythm meets power! This isn't just another game \u2013 it's your personal boxing ring, high-energy dance floor, and path to a healthier, stronger you. An addictive **VR workout** challenge!\n\n# Feel the Beat, Land the Punch!\n\nDynamic VR arenas meet heart-pumping music. Simple controls: put on your Quest headset (2, 3, or Pro) & move! Notes sync to infectious beats. Unleash your inner champion! **Jab, cross, hook, and uppercut** notes with precision. **Duck and weave** past obstacles, keeping your body moving and heart rate soaring. Intuitive, exhilarating, fun **full-body workout** to make you sweat! Perfect for cardio and calorie burning!\n\n# Your Personal Coach Awaits!\n\nYou're not alone. Our expert **virtual instructor** guides form, pushes you, & cheers you on. Learn technique and feel the burn. Adapts for **beginners** to **fitness pros** to keep you motivated.\n\n# Workout Your Way!\n\nDitch boring apps & gyms! **Fit Beat Combat Boxing** is your fun, effective fitness routine. Smash beats to reach goals like **weight loss**, boosting **stamina**, improving **coordination**, or **stress relief**!\n\n# Key Features:\n\n- **Rhythm Boxing Gameplay:** Punch, duck, dodge to music! Music & exercise.\n- **Full-Body Workout:** Arms, core, legs workout for max calorie burn.\n- **Engaging Soundtrack:** Energizing music keeps you moving.\n\n\n", "short_description": "Rhythm Boxing Fitness! Get fit having fun with music & coaching! Thrilling full-body workout on Meta Quest. Quit boring exercises & achieve your ideal body!"}]}, "developer_name": null, "developer_priva
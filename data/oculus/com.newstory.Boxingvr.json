vu54ogI-B-yVDpOXnF6R_vgrwniPMncP6kb2RlVEZa0628&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY5PKKguh0oja_I5xqe8v3BYGrG3EAQL2RgPU7wcQ25w&oe=6AEDF025"}, {"file_name": "screenshot2.png", "id": "592606743148111", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391923_592606746481444_8966562253819213417_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lKoHu5IyDEQ7kNvwHDFWoI&_nc_oc=AdrE_DH8X-NT1S3FHgkTpThJG9tVCkeyRuKJPrqT_k3taTpvTb5XF22AvyFMWDPATsg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnskOljP44bfwJ7Zk_U8yQmMaMttmrqI9GU2WQ_gHbGg&oe=6AEDFB55"}, {"file_name": "screenshot4.png", "id": "3508709025927990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391985_3508709029261323_3016583868344724243_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVmMjZ4vpX0Q7kNvwGij3DI&_nc_oc=AdoSzWeoFz2Dx1Bxg6bM42X8RxJLH-qPs5pk9G5btly4UAtB9AhMwWLjoz4nRbWDR8g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_iS5EG9PfG2YRBTz7n7ByeDpTulsyMrY-EkKyE7yeXg&oe=6AEE0567"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1333140684643275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391976_1333140687976608_7978945902575114739_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M33NAtzwMxYQ7kNvwGT_PTp&_nc_oc=AdqlLd8gJVT4OjD0moruuEY8jK53qWL_G9-6J3GtlEnWqg55VjUseTSacCPzEk6Cjcc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs6K3X7pNTEZ99Y-nk8klUhX7YsFFmAZ74j2SRNXz5sA&oe=6AEE09D0"}, "display_name": "Fit Beat Combat : Free Style Boxing", "keywords": ["Fitness", "Boxing"], "long_description": "# Catch the Rhythm, Punch Your Way to Fit in VR!\n\nTired of boring workouts? Ready to **truly enjoy** getting fit? Welcome to **Fit Beat Combat Boxing**! Experience an exhilarating **VR fitness game** on Meta Quest where rhythm meets power! This isn't just another game \u2013 it's your personal boxing ring, high-energy dance floor, and path to a healthier, stronger you. An addictive **VR workout** challenge!\n\n# Feel the Beat, Land the Punch!\n\nDynamic VR arenas meet heart-pumping music. Simple controls: put on your Quest headset (2, 3, or Pro) & move! Notes sync to infectious beats. Unleash your inner champion! **Jab, cross, hook, and uppercut** notes with precision. **Duck and weave** past obstacles, keeping your body moving and heart rate soaring. Intuitive, exhilarating, fun **full-body workout** to make you sweat! Perfect for cardio and calorie burning!\n\n# Your Personal Coach Awaits!\n\nYou're not alone. Our expert **virtual instructor** guides form, pushes you, & cheers you on. Learn technique and feel the burn. Adapts for **beginners** to **fitness pros** to keep you motivated.\n\n# Workout Your Way!\n\nDitch boring apps & gyms! **Fit Beat Combat Boxing** is your fun, effective fitness routine. Smash beats to reach goals like **weight loss**, boosting **stamina**, improving **coordination**, or **stress relief**!\n\n# Key Features:\n\n- **Rhythm Boxing Gameplay:** Punch, duck, dodge to music! Music & exercise.\n- **Full-Body Workout:** Arms, core, legs workout for max calorie burn.\n- **Engaging Soundtrack:** Energizing music keeps you moving.\n\n\n", "short_description": "Rhythm Boxing Fitness! Get fit having fun with music & coaching! Thrilling full-body workout on Meta Quest. Quit boring exercises & achieve your ideal body!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
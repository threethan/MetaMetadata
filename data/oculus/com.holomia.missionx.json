C38nSN7jXbmaLg4udk7zr8TDMQTQdywq1MOTITDJdOvAuw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVs0oiiUwxFyNx33Pf-K2Tf1l0EqVjf-dsje9Z-aVZIg&oe=6B05A243"}, {"file_name": "ScreenShot_5_2560x1440.png", "id": "452941665801976", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974766_452941669135309_8968881839752891046_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hl18KfoA44EQ7kNvwECGLyW&_nc_oc=AdpkogW8HczhC0TNriQQq6K7pnr0LjFqxAAAX6fXHV1mYU6unoFHivW5ol7-iQWeCDc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQOMlF8A7vGw-PDRCozwW7mRc_zOi5kQ1hqMfDacOikw&oe=6B05B5AA"}, {"file_name": "MR1.png", "id": "903222641336761", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001710_903222644670094_3915023995443464496_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQiFz8acdVsQ7kNvwHOxQCm&_nc_oc=AdpdiU_9-1juKXP7zwXm15pl9k0urL5I9vo9zD2d8ml-Yq6Lx06Qsn4xVS607Gb6seM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStlbrZo94HXtnuYSzsf8eusbknvl6bqEIDQSr77CjQGg&oe=6B05CC31"}, {"file_name": "MR2.png", "id": "1582603442567220", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_1582603445900553_445949884455277596_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEr6w644KasQ7kNvwGweS-l&_nc_oc=Adr7l6831pW9f6qh2A7YS5m4YStTCJUwxN_hnJToIbQOPp-WUHNgZgy2TKGud9b0ZxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCKOy0-8hl46yuez0S4Q9MEsoHj5vtAyuNBA4N5wOamA&oe=6B05A4C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440_2.png", "id": "285702526555529", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_285702533222195_869352482818595611_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cs52pquHbwIQ7kNvwH8ETZi&_nc_oc=AdpkxgwtT4p5xdS_p7avxXsbrJ21npZW425m5AYutEMGQdS9OSfoIU_JgD09HWL5kAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3xwBdmRhFXggWp28tbSJ0WHg40h9KSHzJoBZ4VnYsWQ&oe=6B05AFB9"}, "display_name": "MissionX VR Laser Tag", "keywords": [], "long_description": "Unlock a new era of Mixed reality gaming! \n\nStep into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4x4 1vs1 \n- free size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk\n\n\u2b50\ufe0f Note \u2b50\ufe0f\n- When playing multiplayer, mark a position on the floor, player stands at that position, looks straight and holds the home button on the controller for 3 seconds to synchronize the position in the game.\n- To use the large play space, it is necessary to turn off the Guardian. At this time, you need to pay attention to your own safety to avoid bumping into furniture in the house.\n\nMissionX, a competitive multiplayer FPS game that will turn your play space into a free-roam virtual battlefield. With MissionX, you can create a fun and active shooting laser arena for friends and family right in your backyard, warehouse, basketball court...for a battle or team up against the AI enemy.\n\nGot any questions or feedback? Please shoot us an email at missionx@holomia.com", "short_description": "Step into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4m x 4m 1vs1 \n- free-size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\uf
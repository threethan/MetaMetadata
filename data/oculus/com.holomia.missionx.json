mBPivQPzCvAOo4MpodHXlqEMkE4RHG3_FaU2vUA4CCax40&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8SJecNiKJy5w7xzaVByrq91ckRu86VM6R5ZgrqV-xhQ&oe=6B0B2083"}, {"file_name": "ScreenShot_5_2560x1440.png", "id": "452941665801976", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974766_452941669135309_8968881839752891046_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rihJK8zy2ZAQ7kNvwHh71Ih&_nc_oc=AdrR2JscPvhC6jYXV2XCw0ROdxtGdyv0mN4q9r-qqg7jxdIv4cAMg-siu75AIY4cq7g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQrEapcKbWtHN7ttZ0Hb1Dx5HcyZgl_vt4uFyIDLZZK2A&oe=6B0B33EA"}, {"file_name": "MR1.png", "id": "903222641336761", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001710_903222644670094_3915023995443464496_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmI23z_RUcUQ7kNvwGzJYW1&_nc_oc=AdpfFLJMQNvjmmz5iTvLaca-9YhvYVEOdH3PYqZ5bUJ-dRPNMnp69pe6Pjpqz7YzEz0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTg7dOn9UD56r33dKQuSYJ9tsYhIXN-Prjk5CezstOqJg&oe=6B0B1231"}, {"file_name": "MR2.png", "id": "1582603442567220", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_1582603445900553_445949884455277596_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTEJi_DwZMYQ7kNvwEH4Rhf&_nc_oc=AdrDrk-t9-Z1sZh5MK_j32D_1Vtifs1CBfDYMwPrxEXlH4AZeondcpnQD4EOMvcLsaA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhS_VS-dKwtBWfdzn9pMoprrPd_6LruHh3_129VBJUqg&oe=6B0B2306"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440_2.png", "id": "285702526555529", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974454_285702533222195_869352482818595611_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2pxUE4TZvMQ7kNvwFMWifd&_nc_oc=AdqsunHYMjskHM3vR-0Jbel2cW8YMK7QH5x4yOby386mwcILVOL5pdFCpfQLwzamgbc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcL09cZCkRJ7HyDSO3hTS-UEiEigTZ2iIacX07hWr7cw&oe=6B0B2DF9"}, "display_name": "MissionX VR Laser Tag", "keywords": [], "long_description": "Unlock a new era of Mixed reality gaming! \n\nStep into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4x4 1vs1 \n- free size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk\n\n\u2b50\ufe0f Note \u2b50\ufe0f\n- When playing multiplayer, mark a position on the floor, player stands at that position, looks straight and holds the home button on the controller for 3 seconds to synchronize the position in the game.\n- To use the large play space, it is necessary to turn off the Guardian. At this time, you need to pay attention to your own safety to avoid bumping into furniture in the house.\n\nMissionX, a competitive multiplayer FPS game that will turn your play space into a free-roam virtual battlefield. With MissionX, you can create a fun and active shooting laser arena for friends and family right in your backyard, warehouse, basketball court...for a battle or team up against the AI enemy.\n\nGot any questions or feedback? Please shoot us an email at missionx@holomia.com", "short_description": "Step into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4m x 4m 1vs1 \n- free-size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\uf
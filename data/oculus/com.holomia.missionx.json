fP2Uxd2pZeRqsaW2X5DhQtaklYac9fyissxFCiXUAmimUU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCUF4sV44zdBFiWFiP6gJy-G988w67sOA9iXtcPPrqtw&oe=6B09CF03"}, {"file_name": "ScreenShot_5_2560x1440.png", "id": "452941665801976", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974766_452941669135309_8968881839752891046_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rihJK8zy2ZAQ7kNvwGudq3g&_nc_oc=Ado63A8Pfh5ISCubGBlIg5gSm2osznnPGPJvyuKZlErzG94oNB1ron2L__GEyezuecA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXCyeMQPHuOdLrdbjXlKoHezKpXbORnbCTblUTBqUU2Q&oe=6B09AA2A"}, {"file_name": "MR1.png", "id": "903222641336761", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001710_903222644670094_3915023995443464496_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmI23z_RUcUQ7kNvwHt5brs&_nc_oc=Adq3HyJP-oEt5_619cViovgSlvfaLmdOfxOcA4kANq7lrbx0Zf4eMD-dT_TKQQ3SSkQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJA2ZGf8fzhdrBNwp0Xkh_ZeziKWAn39pl2AJs3YZGaQ&oe=6B09C0B1"}, {"file_name": "MR2.png", "id": "1582603442567220", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974873_1582603445900553_445949884455277596_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTEJi_DwZMYQ7kNvwFKOMkz&_nc_oc=AdpX78PpfhUMqmMj0e0LByv5q06dozWhprGISM0ywwRPH4rCiiqx6EJMLRKxb2kBKSg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8n4LuBusqektte-EQtwLfx6-7p_kY19DhCZ27VOfOSA&oe=6B09D186"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440_2.png", "id": "285702526555529", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974454_285702533222195_869352482818595611_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2pxUE4TZvMQ7kNvwHxaEPz&_nc_oc=Adpx04HohXjA04wNf3NxRcD5YAgri392AIv7dUJM-MmUvC0YVWxS4bMfBeYKqgCWpf4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuTYHSfRd8URyeo1EZ4nk8lpfytTYfM9cLDwQUQV2RqA&oe=6B09A439"}, "display_name": "MissionX VR Laser Tag", "keywords": [], "long_description": "Unlock a new era of Mixed reality gaming! \n\nStep into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4x4 1vs1 \n- free size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk\n\n\u2b50\ufe0f Note \u2b50\ufe0f\n- When playing multiplayer, mark a position on the floor, player stands at that position, looks straight and holds the home button on the controller for 3 seconds to synchronize the position in the game.\n- To use the large play space, it is necessary to turn off the Guardian. At this time, you need to pay attention to your own safety to avoid bumping into furniture in the house.\n\nMissionX, a competitive multiplayer FPS game that will turn your play space into a free-roam virtual battlefield. With MissionX, you can create a fun and active shooting laser arena for friends and family right in your backyard, warehouse, basketball court...for a battle or team up against the AI enemy.\n\nGot any questions or feedback? Please shoot us an email at missionx@holomia.com", "short_description": "Step into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4m x 4m 1vs1 \n- free-size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\uf
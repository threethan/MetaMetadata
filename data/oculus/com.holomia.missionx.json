rWeNpbTVQZJGRhlOWqUs94V4M-CswhZW1ZdXqA0zaXq1n4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ31J-JnPReY6BT6x2uZaDcpb2TL7qWbXiiwnLFw2DSbQ&oe=6B084543"}, {"file_name": "ScreenShot_5_2560x1440.png", "id": "452941665801976", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974766_452941669135309_8968881839752891046_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rihJK8zy2ZAQ7kNvwGnCBl2&_nc_oc=AdoGGVY8HJrgonFj-vKFppp9n6gXkK6sk6pesBHcw9xUmOa_U5zfd1EX3t0gor9-1Ag&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkXrnhdUS7bp2qvWwG8-1elhYqfzbPMDLgeEJkBDc7hg&oe=6B0858AA"}, {"file_name": "MR1.png", "id": "903222641336761", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001710_903222644670094_3915023995443464496_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmI23z_RUcUQ7kNvwFehAHg&_nc_oc=Adp67AENuAwjXh0E-lXwMFRYrhnyL1YA2ALJzcwYJPMQuuhb2a0c1YP40JlrX0dmDUw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_bZcL0DOBNee9S79p-9FdEWI5VU0aepNUc1kpS87dBQ&oe=6B086F31"}, {"file_name": "MR2.png", "id": "1582603442567220", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974873_1582603445900553_445949884455277596_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTEJi_DwZMYQ7kNvwEN6NI5&_nc_oc=AdqperXL_3EWRTOSSd05wkzMfaPJdNbMwhu9jFuZZZoQ_nJYlymHtT6QWQKDjsIiqiw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc4Tm21BCm27L7vMoOA1K5HB2-7FuKMRHGqqa6AJOoTg&oe=6B0847C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440_2.png", "id": "285702526555529", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974454_285702533222195_869352482818595611_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2pxUE4TZvMQ7kNvwGaPSXw&_nc_oc=AdqTCPoaXtLwlZW5aVMQ--hvDPnuUDUbRHX_hWZVh67qlTiGdTOgIjrr0JkcDQQyC6k&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlmMLCwM_TFK8e5xX41YWIN4sIL10wMPbEp3d_nw-Fqw&oe=6B0852B9"}, "display_name": "MissionX VR Laser Tag", "keywords": [], "long_description": "Unlock a new era of Mixed reality gaming! \n\nStep into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4x4 1vs1 \n- free size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk\n\n\u2b50\ufe0f Note \u2b50\ufe0f\n- When playing multiplayer, mark a position on the floor, player stands at that position, looks straight and holds the home button on the controller for 3 seconds to synchronize the position in the game.\n- To use the large play space, it is necessary to turn off the Guardian. At this time, you need to pay attention to your own safety to avoid bumping into furniture in the house.\n\nMissionX, a competitive multiplayer FPS game that will turn your play space into a free-roam virtual battlefield. With MissionX, you can create a fun and active shooting laser arena for friends and family right in your backyard, warehouse, basketball court...for a battle or team up against the AI enemy.\n\nGot any questions or feedback? Please shoot us an email at missionx@holomia.com", "short_description": "Step into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4m x 4m 1vs1 \n- free-size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\uf
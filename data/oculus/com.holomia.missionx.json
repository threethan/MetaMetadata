5309_8968881839752891046_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6ihcfDkHCEQ7kNvwG2UzC2&_nc_oc=AdrX7RBMgs7FGQ6bsNcATVg5C-gNqWMNyBg2eG78yQcsAA-oCKGfKQPk6CnnskO-YKQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMhfbNyzDiNdEa2KjiNy_QgVVTk0fFbJFt57d1U39PoQ&oe=6A8ED66A"}, {"file_name": "MR1.png", "id": "903222641336761", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001710_903222644670094_3915023995443464496_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YeKFqjL9xAQ7kNvwGEIfmu&_nc_oc=AdqtS6rsEWkQrJ4QD3frk2IO1jPHPHn3RHfKysE17JB24_V7I5n7AZ-J99LIy6LfiqU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHz9_i4y2ezX0w82rYOXQBIcAiPlugcFqrZ--kXK70Qow&oe=6A8EECF1"}, {"file_name": "MR2.png", "id": "1582603442567220", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974873_1582603445900553_445949884455277596_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFvW9AwRm0kQ7kNvwHQ7uRu&_nc_oc=AdqmXzYpupf6zh4JJnSnHVvh2YQ68i_ZeZl0f8QW3daZfaGr0hYlDGCfttuopYBPfLc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4vgIVkckBR-ZneTlLhOWnNp8lUfPwjKhHyM_zAxhIcQ&oe=6A8EC586"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440_2.png", "id": "285702526555529", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974454_285702533222195_869352482818595611_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyg-Zt_PO8UQ7kNvwHZzi7h&_nc_oc=AdoWjCEGdFyQlltFF6n3sUWqIKqMY3f-QF-6m3uIpZrPgzEgOrWH9lD45VpWR2tMA9A&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZJKuvglmBUpZXC4Vw2Z0NXVcVdN2F5n6hQS4TY1sdhQ&oe=6A8ED079"}, "display_name": "MissionX VR Laser Tag", "keywords": [], "long_description": "Unlock a new era of Mixed reality gaming! \n\nStep into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4x4 1vs1 \n- free size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk\n\n\u2b50\ufe0f Note \u2b50\ufe0f\n- When playing multiplayer, mark a position on the floor, player stands at that position, looks straight and holds the home button on the controller for 3 seconds to synchronize the position in the game.\n- To use the large play space, it is necessary to turn off the Guardian. At this time, you need to pay attention to your own safety to avoid bumping into furniture in the house.\n\nMissionX, a competitive multiplayer FPS game that will turn your play space into a free-roam virtual battlefield. With MissionX, you can create a fun and active shooting laser arena for friends and family right in your backyard, warehouse, basketball court...for a battle or team up against the AI enemy.\n\nGot any questions or feedback? Please shoot us an email at missionx@holomia.com", "short_description": "Step into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4m x 4m 1vs1 \n- free-size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk"}]}, "developer_name": "Holomia", "developer_privacy_policy_url": "https://missionxvr.com/privacy", "developer_terms_of_service_url": "https://missionxvr.com/term_of_use", "publisher_name": "Holomia", "support_website_url": "https://missionxvr.com/index", "website_url": "https://missionxvr.com/i
HcAsFHZ8B101DYB9yRV8vvbxHmdUk0s13w7F3F9bZay7XU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW2GNHiXb2GGSYHHPEu_57TQEw3NOCx4KUysgnshMNF8Q&oe=6B106683"}, {"file_name": "ScreenShot_5_2560x1440.png", "id": "452941665801976", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974766_452941669135309_8968881839752891046_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1rMnE0ltykQ7kNvwE0xqD_&_nc_oc=Adovkd9caFX4Z46Ek_lqV7w5ukZsc5OfelfqR7lfd844fp31PGKJNUSfeb8JTI0ypiw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVXA4vHFqxcNARqaMs9O2PeVoFg2dGWl1K25UhGPsi8Hw&oe=6B1041AA"}, {"file_name": "MR1.png", "id": "903222641336761", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001710_903222644670094_3915023995443464496_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sD4hhCGSHBEQ7kNvwH9p4-W&_nc_oc=AdrcoOUAmpvbfL9ZQzCOb2ZumrUEyHV2eookMMb6rpW-a29FgFmVr5meMPHhPpEV008&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWiHG2EHL4H96spYLqLzgH1EX2PuxEgaAY7aVmI68hxmA&oe=6B105831"}, {"file_name": "MR2.png", "id": "1582603442567220", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_1582603445900553_445949884455277596_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKKv-Qm8Xr0Q7kNvwEMmBvh&_nc_oc=Adp_Z5WJ-4F-1l_8cXnyF_GfL2QPVhxehKFS2dyiNqjXMWU5qZL63jRVTc-BE_JuAEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6uPrHxxo3c5ZXk9vHE2Rz-A_O4CAUmt3HenyvgzlRyg&oe=6B106906"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440_2.png", "id": "285702526555529", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_285702533222195_869352482818595611_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXORz5e1OTcQ7kNvwGrhmv7&_nc_oc=AdrexXw5H-UWGplgVzELhhOymE_KklZd2x3BGjEM5_zW7yQyqhQzHYuwocI1QfsnkU0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWNhD0rc8AvJIFukGT_X_tlYPC7POnM-TUAYw9LyzSN0A&oe=6B103BB9"}, "display_name": "MissionX VR Laser Tag", "keywords": [], "long_description": "Unlock a new era of Mixed reality gaming! \n\nStep into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4x4 1vs1 \n- free size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk\n\n\u2b50\ufe0f Note \u2b50\ufe0f\n- When playing multiplayer, mark a position on the floor, player stands at that position, looks straight and holds the home button on the controller for 3 seconds to synchronize the position in the game.\n- To use the large play space, it is necessary to turn off the Guardian. At this time, you need to pay attention to your own safety to avoid bumping into furniture in the house.\n\nMissionX, a competitive multiplayer FPS game that will turn your play space into a free-roam virtual battlefield. With MissionX, you can create a fun and active shooting laser arena for friends and family right in your backyard, warehouse, basketball court...for a battle or team up against the AI enemy.\n\nGot any questions or feedback? Please shoot us an email at missionx@holomia.com", "short_description": "Step into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4m x 4m 1vs1 \n- free-size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\uf
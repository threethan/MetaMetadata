xIDVP5ZwnBZwm-Zf8GyN9Exd_4hdnFJSqiHLeNGD6t8BTI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE7faAUSlO0YiwdMc9Te4brskc6QgjQcC1mlwCgxW5lQ&oe=6AFF0AC3"}, {"file_name": "ScreenShot_5_2560x1440.png", "id": "452941665801976", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974766_452941669135309_8968881839752891046_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccXnXHnrewsQ7kNvwEI37a4&_nc_oc=Adqqo2SJ7JKxAg7OanB6NsFF8_RSGhcNG9W0LvDNgy1sr5Ny5KD6wy9ytNlzEJBZr_E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLbn6sL2e1qxFAydtOCNm_0XO25wbricXNliaduBrXgw&oe=6AFF1E2A"}, {"file_name": "MR1.png", "id": "903222641336761", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001710_903222644670094_3915023995443464496_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM-pJxlSk7wQ7kNvwHRV3Eg&_nc_oc=AdqkORASoIUJSkFgFHw-go_nioot_HYMY767VYOEf3CEyubS5axSlq8tePalFODEbG8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPl291k3hF7xGO-N9jMKk7Hpyh1NfHBzlI8AewmWsC6Q&oe=6AFF34B1"}, {"file_name": "MR2.png", "id": "1582603442567220", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974873_1582603445900553_445949884455277596_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6gwwy_nMN8Q7kNvwFLWdFW&_nc_oc=Adony-QjnP7VEkc4AdGUpfxjbm7uBdfAAe5krbm5Ny5F2FAmDwvZR4ygUWp6LZkxWmM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU6_tBVGeeiPAmTbjdC5Iar5L6o2fZPIDPAD0IEQ1QaA&oe=6AFF0D46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440_2.png", "id": "285702526555529", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974454_285702533222195_869352482818595611_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sv4IX7q5-qIQ7kNvwGSIN8m&_nc_oc=AdoY6MtoCa4JuE6NlLV60lJA8Fs9JoSrsmeu1diqI9V_aAg_AXbghRRpoNGFCKqgwKc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYlqSQMj9HrW0Lm_MaPPcJw_90V50CJcJyc_4M3hMnbw&oe=6AFF1839"}, "display_name": "MissionX VR Laser Tag", "keywords": [], "long_description": "Unlock a new era of Mixed reality gaming! \n\nStep into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4x4 1vs1 \n- free size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk\n\n\u2b50\ufe0f Note \u2b50\ufe0f\n- When playing multiplayer, mark a position on the floor, player stands at that position, looks straight and holds the home button on the controller for 3 seconds to synchronize the position in the game.\n- To use the large play space, it is necessary to turn off the Guardian. At this time, you need to pay attention to your own safety to avoid bumping into furniture in the house.\n\nMissionX, a competitive multiplayer FPS game that will turn your play space into a free-roam virtual battlefield. With MissionX, you can create a fun and active shooting laser arena for friends and family right in your backyard, warehouse, basketball court...for a battle or team up against the AI enemy.\n\nGot any questions or feedback? Please shoot us an email at missionx@holomia.com", "short_description": "Step into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4m x 4m 1vs1 \n- free-size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\uf
752891046_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVQkEEgcm4oQ7kNvwHiJ7mr&_nc_oc=AdooWYuFi4G5oigp70AqVhazjaA3RHkAZib_-SDJRDypyMmx1AnNzgydmjJ4NzJh9-c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxPYzNgtiItBX6olvO9JLODw7NcjfD8B-YwCKC3h147Q&oe=69C520EA"}, {"file_name": "MR1.png", "id": "903222641336761", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001710_903222644670094_3915023995443464496_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNvoa_4pCoIQ7kNvwF9A_P6&_nc_oc=AdpshqB2hawiMoCRKHPn5IWQvO4smyOUq0qWNoc_KHGVZwb8oO5kTdd3MNCiYBQTUOM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwX_VOmgx4FSLGr773ouT-JF64OlVPTSdNj1W9ANlkZQ&oe=69C53771"}, {"file_name": "MR2.png", "id": "1582603442567220", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974873_1582603445900553_445949884455277596_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zvoUXlqJlEQ7kNvwHf1MO0&_nc_oc=AdpeOBAf3lPnc_jE5_pp6avmRzZzBb_P87KmWjxVNqEmkPIsQyeKzKCKDcH7zTlq46E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTHaN-6ksBy5u11fjTZ5yJKzvqIuRMcMAUmwROVYRiyg&oe=69C51006"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440_2.png", "id": "285702526555529", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974454_285702533222195_869352482818595611_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zrPE-Z3Qs8Q7kNvwHYddm5&_nc_oc=AdrCCSiBV5rcbrGLNzrV3LGZYBPWJS3QNx_Fkva5xpyu4SIHGX5LlJplXV1e2DWl7nM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlSqxCGwhx1Lj_MsPA6iRi_I_g6tq2x4x29yQo5IEH-g&oe=69C51AF9"}, "display_name": "MissionX VR Laser Tag", "keywords": [], "long_description": "Unlock a new era of Mixed reality gaming! \n\nStep into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4x4 1vs1 \n- free size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk\n\n\u2b50\ufe0f Note \u2b50\ufe0f\n- When playing multiplayer, mark a position on the floor, player stands at that position, looks straight and holds the home button on the controller for 3 seconds to synchronize the position in the game.\n- To use the large play space, it is necessary to turn off the Guardian. At this time, you need to pay attention to your own safety to avoid bumping into furniture in the house.\n\nMissionX, a competitive multiplayer FPS game that will turn your play space into a free-roam virtual battlefield. With MissionX, you can create a fun and active shooting laser arena for friends and family right in your backyard, warehouse, basketball court...for a battle or team up against the AI enemy.\n\nGot any questions or feedback? Please shoot us an email at missionx@holomia.com", "short_description": "Step into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4m x 4m 1vs1 \n- free-size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk"}]}, "developer_name": "Holomia", "developer_privacy_policy_url": "https://missionxvr.com/privacy", "developer_terms_of_service_url": "https://missionxvr.com/term_of_use", "publisher_name": "Holomia", "support_website_url": "https://missionxvr.com/index", "website_url": "https://missionxvr.com/index", "category": "
752891046_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=503f4mu9TbwQ7kNvwEU0wd0&_nc_oc=AdpD_Ka-XOw7sjMiSKEuanUdMPAs1IpHCJ1v-Q0uUIdcwnvX2Fgw8dLHKZeGIjndmP4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD8JT34-ukag-sGkC1nn_dADHpzAwj5eMB2MQ5p2uglw&oe=6AE8B4AA"}, {"file_name": "MR1.png", "id": "903222641336761", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001710_903222644670094_3915023995443464496_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6CZ1tlihrUQ7kNvwHAdrDQ&_nc_oc=AdrQ7uawR8PMQuHdwyG09Yjgy95OyP6VALulq_i_M2-YPLyNAlbr4E6qBQFvDcRA_nU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb_QwY-80hHS43-zZPa8tWNS3GDeKeiRivYsIaO9XujA&oe=6AE892F1"}, {"file_name": "MR2.png", "id": "1582603442567220", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974873_1582603445900553_445949884455277596_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amSxMtIl2LAQ7kNvwHGyA0B&_nc_oc=Adpj_WX0fMXPmSL9_z5d9TNx7w92IKGueXVsb-4j04S7wBvh0MqnuG98yQsvBvbD0wc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREghPO4mM_dgHEB9Z25b2_Em6FQkseZHbnUxR2LXF4mA&oe=6AE8A3C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440_2.png", "id": "285702526555529", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974454_285702533222195_869352482818595611_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouCTNrsLtFkQ7kNvwEiyoMN&_nc_oc=AdpPWjQoNGByyDgIvyobQuooiJdJ5rAmhEwx6m5j5gYmhR2In1ywai6dLr0jemSqio0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlylsky5m1vCSPKkQP4DOjFi7l2uTRZEiytiY7UcDdFg&oe=6AE8AEB9"}, "display_name": "MissionX VR Laser Tag", "keywords": [], "long_description": "Unlock a new era of Mixed reality gaming! \n\nStep into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4x4 1vs1 \n- free size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk\n\n\u2b50\ufe0f Note \u2b50\ufe0f\n- When playing multiplayer, mark a position on the floor, player stands at that position, looks straight and holds the home button on the controller for 3 seconds to synchronize the position in the game.\n- To use the large play space, it is necessary to turn off the Guardian. At this time, you need to pay attention to your own safety to avoid bumping into furniture in the house.\n\nMissionX, a competitive multiplayer FPS game that will turn your play space into a free-roam virtual battlefield. With MissionX, you can create a fun and active shooting laser arena for friends and family right in your backyard, warehouse, basketball court...for a battle or team up against the AI enemy.\n\nGot any questions or feedback? Please shoot us an email at missionx@holomia.com", "short_description": "Step into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4m x 4m 1vs1 \n- free-size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk"}]}, "developer_name": "Holomia", "developer_privacy_policy_url": "https://missionxvr.com/privacy", "developer_terms_of_service_url": "https://missionxvr.com/term_of_use", "publisher_name": "Holomia", "support_website_url": "https://missionxvr.com/index", "website_url": "https://missionxvr.com/index", "category": "
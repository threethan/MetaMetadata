ze6-atUwQzqKQP8F022lvgjw3hJudAo_CoAJ20PYCeyses&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUZ9u27TbAJ4EMkZ-TZEHhyYSAlbKLNPDXnlRq-0G4eQ&oe=6AFDB943"}, {"file_name": "ScreenShot_5_2560x1440.png", "id": "452941665801976", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974766_452941669135309_8968881839752891046_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccXnXHnrewsQ7kNvwETCBuL&_nc_oc=AdofPsJJJALx10DhD18jLAOp8IlAVJIMZgKrQH_smIvIoiSjLMo9pkPFwacfrroRbTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCiUtHIBGhsbR1nGmqKKNbpwZ6YkdzXGNt-F-oneALbg&oe=6AFDCCAA"}, {"file_name": "MR1.png", "id": "903222641336761", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001710_903222644670094_3915023995443464496_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM-pJxlSk7wQ7kNvwEa_1XO&_nc_oc=Adrute_Up1bf03bIP70OqchrIfmXG2fk8XfVjj5fhLzRqwOGTb5g2ME_Xbs9TYEhLqM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx3ePJ23fCcAKxFrMMldM0bQ5AWBgkxFTRjb-Seja1SA&oe=6AFDE331"}, {"file_name": "MR2.png", "id": "1582603442567220", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_1582603445900553_445949884455277596_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6gwwy_nMN8Q7kNvwGwXyVw&_nc_oc=AdpKjZzQEiGbkz6ESqPf-gplUmjMJtLrsj-KP-ToZCccM_dP7LTlBn3kE6-TFboOw5M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfFen7q2BuJxNUF862dCfdjDX3bgff709RFbAQ6xhauA&oe=6AFDBBC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440_2.png", "id": "285702526555529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_285702533222195_869352482818595611_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sv4IX7q5-qIQ7kNvwHGLvUx&_nc_oc=AdrLc3aYIN7MmEytNOMzk6T8tyPrlAAjODrT4vOCTNI9bQi1pbOik6Q-bvLD1J4Bv84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCM7yp-GC-9kwOJJOud3L2PzjD7UyEKInU7luO125wFw&oe=6AFDC6B9"}, "display_name": "MissionX VR Laser Tag", "keywords": [], "long_description": "Unlock a new era of Mixed reality gaming! \n\nStep into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4x4 1vs1 \n- free size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk\n\n\u2b50\ufe0f Note \u2b50\ufe0f\n- When playing multiplayer, mark a position on the floor, player stands at that position, looks straight and holds the home button on the controller for 3 seconds to synchronize the position in the game.\n- To use the large play space, it is necessary to turn off the Guardian. At this time, you need to pay attention to your own safety to avoid bumping into furniture in the house.\n\nMissionX, a competitive multiplayer FPS game that will turn your play space into a free-roam virtual battlefield. With MissionX, you can create a fun and active shooting laser arena for friends and family right in your backyard, warehouse, basketball court...for a battle or team up against the AI enemy.\n\nGot any questions or feedback? Please shoot us an email at missionx@holomia.com", "short_description": "Step into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4m x 4m 1vs1 \n- free-size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\uf
nc_ohc=HVJFy9MCNtYQ7kNvwHx7q25&_nc_oc=Adn89bbufYR-FttgGTvdZ_zCKyVjd9HR9sPQ49Gt-5c_O2vOvgCaCORoETm0FX2a8Ao&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBN-IloFFmAVU_A7XTBqeNW6KvRdWUuR1FTvY96fwEWw&oe=69B6A06A"}, {"file_name": "MR1.png", "id": "903222641336761", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001710_903222644670094_3915023995443464496_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73eqCJL9GtMQ7kNvwEIfSm0&_nc_oc=AdkUVjzW6HBwSAVPfqbhsYXUVPIiTUacRBiJlV_cnQzLgRpdQ0SJWDwUW5SCG3ewtnw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZHan9rKWgHFseGxmqPuPvVzhnqMN2T3UR8VUlhiMbxA&oe=69B6B6F1"}, {"file_name": "MR2.png", "id": "1582603442567220", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974873_1582603445900553_445949884455277596_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8qKGPftg0oQ7kNvwHRiDRe&_nc_oc=AdnFucgPhuPhQDXilR4rBTaPTCOfsKsx1Ayh2E8spe7qXJx9HlzjjggPwyQxRVYSEQE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxoEBikDU8WTbTxXgBYCPk8UOrwZUnRvaVbJqqFSEDZA&oe=69B68F86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440_2.png", "id": "285702526555529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974454_285702533222195_869352482818595611_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koIe9kyQEUEQ7kNvwHKHPts&_nc_oc=AdlZyVJw7nHhHUKCtUrvv1pdL9aIm0MJ2NYRoH3u_KN7WXPuB1kh7GBPo_5FYOBme1Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfPTSDQLLv-a-6zBQhXuYv3vhGUZe3hyPUAlyt7nnGwA&oe=69B69A79"}, "display_name": "MissionX VR Laser Tag", "keywords": [], "long_description": "Unlock a new era of Mixed reality gaming! \n\nStep into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4x4 1vs1 \n- free size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk\n\n\u2b50\ufe0f Note \u2b50\ufe0f\n- When playing multiplayer, mark a position on the floor, player stands at that position, looks straight and holds the home button on the controller for 3 seconds to synchronize the position in the game.\n- To use the large play space, it is necessary to turn off the Guardian. At this time, you need to pay attention to your own safety to avoid bumping into furniture in the house.\n\nMissionX, a competitive multiplayer FPS game that will turn your play space into a free-roam virtual battlefield. With MissionX, you can create a fun and active shooting laser arena for friends and family right in your backyard, warehouse, basketball court...for a battle or team up against the AI enemy.\n\nGot any questions or feedback? Please shoot us an email at missionx@holomia.com", "short_description": "Step into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4m x 4m 1vs1 \n- free-size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk"}]}, "developer_name": "Holomia", "developer_privacy_policy_url": "https://missionxvr.com/privacy", "developer_terms_of_service_url": "https://missionxvr.com/term_of_use", "publisher_name": "Holomia", "support_website_url": "https://missionxvr.com/index", "website_url": "https://missionxvr.com/index", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": []
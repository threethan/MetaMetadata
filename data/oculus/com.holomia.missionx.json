2V0jIr38OmsAwNq3N-ZGeFWz_5fD6Qqc19mSTtHYvdZjrY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQShBVRBqQBc6JNx8hmdsQTUAAD8O_77GYvBAWTsPcrptA&oe=6B0DC383"}, {"file_name": "ScreenShot_5_2560x1440.png", "id": "452941665801976", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974766_452941669135309_8968881839752891046_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffpI4m7Q4VgQ7kNvwG-8cmK&_nc_oc=AdqQHTxut9fpZ0qqL9BUZCpiZhaekqb3uSmamt-PLG1Te6oPo6HtQGSY6ufiSufnAdE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQPALgV8OnICOYJMIYbTLrrFKPfgasslvSdqz7wS22vDw&oe=6B0D9EAA"}, {"file_name": "MR1.png", "id": "903222641336761", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001710_903222644670094_3915023995443464496_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siBlitKv2m0Q7kNvwFlbu56&_nc_oc=AdoKl5k3_s6KWyUQO4LMjwZOUlECzO-i1y6jqX8e0XqEAbltD5-sZP9si4ziBvL9f0A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYnJ_YvqE_KK-RcFpRLktsyYW5HELSAe7mefJca1GjFg&oe=6B0DB531"}, {"file_name": "MR2.png", "id": "1582603442567220", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_1582603445900553_445949884455277596_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Td7Em4fRTBgQ7kNvwFWF1CP&_nc_oc=AdrQbicQZ4VX0bMtwejH7o5m0TQAmjxruxaEL0x6UOs4JPLkBOuBkY93yYxpm8Plq_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS6SMfH6u76KPHTRis48LlSaoSvz6JEGA6e2tigz1xoQw&oe=6B0DC606"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440_2.png", "id": "285702526555529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_285702533222195_869352482818595611_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1V_LIY7BxIQ7kNvwG4zMhz&_nc_oc=AdrZa-iP8hCaJUFxuGBuM8jNw6mx3cSAMaJ5VYuQu4KK6q-Ey8RQ0VT8wE0ynBTg5kk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQKobVEgZ_3SAvLFYu_h89jEnR_SGvncNwe9Gii85X98w&oe=6B0DD0F9"}, "display_name": "MissionX VR Laser Tag", "keywords": [], "long_description": "Unlock a new era of Mixed reality gaming! \n\nStep into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4x4 1vs1 \n- free size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk\n\n\u2b50\ufe0f Note \u2b50\ufe0f\n- When playing multiplayer, mark a position on the floor, player stands at that position, looks straight and holds the home button on the controller for 3 seconds to synchronize the position in the game.\n- To use the large play space, it is necessary to turn off the Guardian. At this time, you need to pay attention to your own safety to avoid bumping into furniture in the house.\n\nMissionX, a competitive multiplayer FPS game that will turn your play space into a free-roam virtual battlefield. With MissionX, you can create a fun and active shooting laser arena for friends and family right in your backyard, warehouse, basketball court...for a battle or team up against the AI enemy.\n\nGot any questions or feedback? Please shoot us an email at missionx@holomia.com", "short_description": "Step into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4m x 4m 1vs1 \n- free-size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\uf
yEPoaIcMO-O6Uo7UHJgv5Vmm0QpD4MNTrpMtUGFu7-sBcY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0a9jdOAvQD39OCLWVQdt8MSc5LfLS9WOMN2m8oCnfbg&oe=6B033783"}, {"file_name": "ScreenShot_5_2560x1440.png", "id": "452941665801976", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974766_452941669135309_8968881839752891046_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ys2aHUvXnIQ7kNvwHGXTRQ&_nc_oc=AdruROBZm7yv47xPLBpiX31oxi92TPttRjg4Wkg4BSRtUFGobzVlIhj2KOTlFejyXq8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD3eSP21e7cw71DG75wQ52cAA9SJtCKCbWUTB-BFLcjg&oe=6B0312AA"}, {"file_name": "MR1.png", "id": "903222641336761", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001710_903222644670094_3915023995443464496_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgH3pIl8R-IQ7kNvwHWEDUh&_nc_oc=Ado5i5oiL3OW9t4bLT8bGeQ3VM5_YD9VwxHXLfIH0zkEo6c5ls4SggHZGjfjC_DJOeE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6llpfWqzTNxXFMD5LqsA_Z9AsuIoXoPSmUJklate8Ew&oe=6B032931"}, {"file_name": "MR2.png", "id": "1582603442567220", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_1582603445900553_445949884455277596_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWW5S5Zr90gQ7kNvwE6kB6s&_nc_oc=AdoZAfBA04o54EZ1scMX6t3sqazSDRaMI68AfTA32ledRtyWkqumjxRNRl7E7mVoEAw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3DU_LK5sGWdT4z-JpFYSDYuRFkhh4YWXxjEtyQoLMvg&oe=6B0301C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440_2.png", "id": "285702526555529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974454_285702533222195_869352482818595611_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93tCsw3sHVkQ7kNvwFwfh6W&_nc_oc=Adq-owEDpPmShng02w-9KA7VYt8Yi2MvtYy-XkNl8B_fEQk8Ho19_MtljvFDodjouIY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVucEXpcsnOFDEtrWgkFM3GPrDMDHgsjZnljGPRtUC6Q&oe=6B030CB9"}, "display_name": "MissionX VR Laser Tag", "keywords": [], "long_description": "Unlock a new era of Mixed reality gaming! \n\nStep into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4x4 1vs1 \n- free size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk\n\n\u2b50\ufe0f Note \u2b50\ufe0f\n- When playing multiplayer, mark a position on the floor, player stands at that position, looks straight and holds the home button on the controller for 3 seconds to synchronize the position in the game.\n- To use the large play space, it is necessary to turn off the Guardian. At this time, you need to pay attention to your own safety to avoid bumping into furniture in the house.\n\nMissionX, a competitive multiplayer FPS game that will turn your play space into a free-roam virtual battlefield. With MissionX, you can create a fun and active shooting laser arena for friends and family right in your backyard, warehouse, basketball court...for a battle or team up against the AI enemy.\n\nGot any questions or feedback? Please shoot us an email at missionx@holomia.com", "short_description": "Step into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4m x 4m 1vs1 \n- free-size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\uf
c_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsXatK2A7p1T2gxuqaIfGAyYYmVjunBMOiWKGQJzNxGBw&oe=699AF0EA"}, {"file_name": "MR1.png", "id": "903222641336761", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001710_903222644670094_3915023995443464496_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZbrbkuZ1KkQ7kNvwHcdpSk&_nc_oc=AdkyAJt-uUV2MBr0XENOJCz2ojksojTulP-F4N2rdW_Kd9KG9_lYVvsHJY12S5quqWI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvWTl1ZWy2gNZJ-SmQepX1N4B51mKPt8IORlu-Mx8ZzPw&oe=699B0771"}, {"file_name": "MR2.png", "id": "1582603442567220", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974873_1582603445900553_445949884455277596_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F42EueXFbcUQ7kNvwEbyhAl&_nc_oc=AdkxGCLnO166GS3S6pRXmzWI5yoSzIwNFDd8N0G3w5U3EdkvJfxmKeh7E_cGidqKCNs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvX_-YD2UGAcjk71YUv8xng9NHXISdForF1xJZ-r2VqVQ&oe=699AE006"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440_2.png", "id": "285702526555529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_285702533222195_869352482818595611_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_X5g0XY2RAQ7kNvwFIMZcQ&_nc_oc=Adl_XFXZFsuKcpZdiPAO7H8wVbNE_W4b0mRo_BJt83fJXxWLVQTbr-N_3BKLw6QNI44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs44_C8xlJJwvhfzki0ButqbbHVuPJgEH2u3gkFkrVBtg&oe=699AEAF9"}, "display_name": "MissionX VR Laser Tag", "keywords": [], "long_description": "Unlock a new era of Mixed reality gaming! \n\nStep into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4x4 1vs1 \n- free size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk\n\n\u2b50\ufe0f Note \u2b50\ufe0f\n- When playing multiplayer, mark a position on the floor, player stands at that position, looks straight and holds the home button on the controller for 3 seconds to synchronize the position in the game.\n- To use the large play space, it is necessary to turn off the Guardian. At this time, you need to pay attention to your own safety to avoid bumping into furniture in the house.\n\nMissionX, a competitive multiplayer FPS game that will turn your play space into a free-roam virtual battlefield. With MissionX, you can create a fun and active shooting laser arena for friends and family right in your backyard, warehouse, basketball court...for a battle or team up against the AI enemy.\n\nGot any questions or feedback? Please shoot us an email at missionx@holomia.com", "short_description": "Step into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4m x 4m 1vs1 \n- free-size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk"}]}, "developer_name": "Holomia", "developer_privacy_policy_url": "https://missionxvr.com/privacy", "developer_terms_of_service_url": "https://missionxvr.com/term_of_use", "publisher_name": "Holomia", "support_website_url": "https://missionxvr.com/index", "website_url": "https://missionxvr.com/index", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}, 
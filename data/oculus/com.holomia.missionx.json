nc_ohc=EEeXI-hkSsAQ7kNvwHBYvxA&_nc_oc=AdmvhAPTbyj9n4UzyoyA3APUWh_Ch6gJxZTl-wnHSxWsHVt8wYvWOs8Av65iXjhKhyA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxZGKHHroV70gDYkHZtRwWTNQ5CaieVd4rBkKhw1JeYkg&oe=69B2ABEA"}, {"file_name": "MR1.png", "id": "903222641336761", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001710_903222644670094_3915023995443464496_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WiJLOx893sQ7kNvwE8qDjn&_nc_oc=AdlNu_MGjtZvNm5naDzDu-PAdW-jvTeCM6Mmy2AIe5lGt0PN9pUxfqcWr3-rtNUy2sg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzknyj4v2bWpjrAFzhh3sk4nnmhkzCFRO57Z_zBr-Mhig&oe=69B2C271"}, {"file_name": "MR2.png", "id": "1582603442567220", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974873_1582603445900553_445949884455277596_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HY-8Wo3J6cQ7kNvwEyZtik&_nc_oc=AdlfY1AmST7ZxS2NizlVehdnVSUWNjlfS0mY6wBZimy9UDzJ6l5xUnxiSGOI2yPKgAI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzXzTXV_ZrfrIdi-vS350Xxj92XipdZPR1E1WjCOSgMOg&oe=69B29B06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440_2.png", "id": "285702526555529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_285702533222195_869352482818595611_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RO7DSvAe3bIQ7kNvwFl5_wv&_nc_oc=AdntlKct12fMzi6X9yD48YJTFg-zjGeG9EbGWEQB3BIFLxQIahDLvPq85sMfsh-_OZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxDwF-DlyTVQ0zm6_S1Qm70Ghb075mnDgv-sp7W6useCg&oe=69B2A5F9"}, "display_name": "MissionX VR Laser Tag", "keywords": [], "long_description": "Unlock a new era of Mixed reality gaming! \n\nStep into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4x4 1vs1 \n- free size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk\n\n\u2b50\ufe0f Note \u2b50\ufe0f\n- When playing multiplayer, mark a position on the floor, player stands at that position, looks straight and holds the home button on the controller for 3 seconds to synchronize the position in the game.\n- To use the large play space, it is necessary to turn off the Guardian. At this time, you need to pay attention to your own safety to avoid bumping into furniture in the house.\n\nMissionX, a competitive multiplayer FPS game that will turn your play space into a free-roam virtual battlefield. With MissionX, you can create a fun and active shooting laser arena for friends and family right in your backyard, warehouse, basketball court...for a battle or team up against the AI enemy.\n\nGot any questions or feedback? Please shoot us an email at missionx@holomia.com", "short_description": "Step into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4m x 4m 1vs1 \n- free-size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk"}]}, "developer_name": "Holomia", "developer_privacy_policy_url": "https://missionxvr.com/privacy", "developer_terms_of_service_url": "https://missionxvr.com/term_of_use", "publisher_name": "Holomia", "support_website_url": "https://missionxvr.com/index", "website_url": "https://missionxvr.com/index", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": []
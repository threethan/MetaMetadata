nc_ohc=Z0bUEi57qRYQ7kNvwHa43qZ&_nc_oc=Adp65R8AOUjxpAa5oWa6lOAeJ9yMltKBpHLhFqe_9KOU5bo-MQre-PJHLP65pv3rjdg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkQUTmGsxO_I49iMlOFvxtihl4kgHMCJI-p0wlCqKfAA&oe=69C12C6A"}, {"file_name": "MR1.png", "id": "903222641336761", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001710_903222644670094_3915023995443464496_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tZ7zREy9cQQ7kNvwHT3YyA&_nc_oc=AdoD8kfh1sdsDNeBMds2YBPhS7Kyng1FOBB258WobX0hPrqt8X-z76t2W8POn1Mg9Qc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyKJWAntaS7QISAUpm_RAVonR3QbYWShymqOg5eE_fEXQ&oe=69C142F1"}, {"file_name": "MR2.png", "id": "1582603442567220", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974873_1582603445900553_445949884455277596_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H11RbKeqspsQ7kNvwHOE4Ha&_nc_oc=Ado-qGvQPuj238TDmDi8c190d1CrZM_oE8oF6c42S_TLBjAwSLHdxoBnuV4liQxZOuY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_xPfV0KyKVbMEn3I4nUggYTaNzojG5o7mWWJmU6iVgA&oe=69C11B86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440_2.png", "id": "285702526555529", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974454_285702533222195_869352482818595611_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6EAsXN3OvQQ7kNvwGx1Qr6&_nc_oc=AdpNivNhfnCZxtvmAHABppBfeKe2M4CJEz0NlmGhp_gt3bCx5qBmlfvBFsnD5J_Zv4Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzoMnh_KQ-p_C5L-PsozZ0eiDAbGDie7te6SufHDr-hxA&oe=69C12679"}, "display_name": "MissionX VR Laser Tag", "keywords": [], "long_description": "Unlock a new era of Mixed reality gaming! \n\nStep into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4x4 1vs1 \n- free size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk\n\n\u2b50\ufe0f Note \u2b50\ufe0f\n- When playing multiplayer, mark a position on the floor, player stands at that position, looks straight and holds the home button on the controller for 3 seconds to synchronize the position in the game.\n- To use the large play space, it is necessary to turn off the Guardian. At this time, you need to pay attention to your own safety to avoid bumping into furniture in the house.\n\nMissionX, a competitive multiplayer FPS game that will turn your play space into a free-roam virtual battlefield. With MissionX, you can create a fun and active shooting laser arena for friends and family right in your backyard, warehouse, basketball court...for a battle or team up against the AI enemy.\n\nGot any questions or feedback? Please shoot us an email at missionx@holomia.com", "short_description": "Step into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4m x 4m 1vs1 \n- free-size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk"}]}, "developer_name": "Holomia", "developer_privacy_policy_url": "https://missionxvr.com/privacy", "developer_terms_of_service_url": "https://missionxvr.com/term_of_use", "publisher_name": "Holomia", "support_website_url": "https://missionxvr.com/index", "website_url": "https://missionxvr.com/index", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": []
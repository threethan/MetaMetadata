g8U_z5NkWOIdR9VDgxKEiJn85unYwlBFQ6-AtBO04r17q8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMrUV0ClDyExHCHgLoSePor1ahdwHPvEriNMCMX1ZGZQ&oe=6AFB1643"}, {"file_name": "ScreenShot_5_2560x1440.png", "id": "452941665801976", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974766_452941669135309_8968881839752891046_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LK1WXaQ76XIQ7kNvwEFep1y&_nc_oc=Adq22KHl4pBYtazIF3I55Tyq45B2_-x6sFNb0H8xBFHWH_QB0eZcelZH87HUgC1z-Dk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSjUOJWsQ84mifZO9DL8KUaMY99250WuSASDM90LErvw&oe=6AFB29AA"}, {"file_name": "MR1.png", "id": "903222641336761", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001710_903222644670094_3915023995443464496_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3tHp-_Sr9EQ7kNvwHOIAmO&_nc_oc=Adq9Sv8hQSVNfHhVYwTkCp7HDOB3EHYwXOZsFEhHWWEaQCLitkwGn63zIKPZA69P_CM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-qKQVYiMWPwgjVTAXQ7Tng3jZ5b_MZvu_qKzngNePdg&oe=6AFB4031"}, {"file_name": "MR2.png", "id": "1582603442567220", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974873_1582603445900553_445949884455277596_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6ZcluQyju0Q7kNvwG3m4Ed&_nc_oc=AdqaEd-GjMbY0uVMcDAovHk1QJUyFcnKD7IC62Ulu3GScfIYymRRFxt6IKN1ANWnSag&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUHkG8hK5oblXsz-QAmPxUPtQR3axD4rbjUBRkOZCmdQ&oe=6AFB18C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440_2.png", "id": "285702526555529", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974454_285702533222195_869352482818595611_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyaFqudcqJgQ7kNvwFq7crz&_nc_oc=AdrXQU9tmpP8RwZO60KE-X21u-8VAMDgt2xZVukzPM7SPcji2-CuVPmHiY6vTVYSISY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7oUrIZ1WYIOkenrKb61pcYehpiIhprwX36p280tBkaA&oe=6AFB23B9"}, "display_name": "MissionX VR Laser Tag", "keywords": [], "long_description": "Unlock a new era of Mixed reality gaming! \n\nStep into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4x4 1vs1 \n- free size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\ufe0f\n- Create your Mixed reality arena: https://youtu.be/cAhBCJast0U \n- How to set up the game: https://youtu.be/iJJDlxrCwSk\n\n\u2b50\ufe0f Note \u2b50\ufe0f\n- When playing multiplayer, mark a position on the floor, player stands at that position, looks straight and holds the home button on the controller for 3 seconds to synchronize the position in the game.\n- To use the large play space, it is necessary to turn off the Guardian. At this time, you need to pay attention to your own safety to avoid bumping into furniture in the house.\n\nMissionX, a competitive multiplayer FPS game that will turn your play space into a free-roam virtual battlefield. With MissionX, you can create a fun and active shooting laser arena for friends and family right in your backyard, warehouse, basketball court...for a battle or team up against the AI enemy.\n\nGot any questions or feedback? Please shoot us an email at missionx@holomia.com", "short_description": "Step into a new era of immersive gaming where you can roam freely, strategize, and compete in thrilling battles. With state-of-the-art VR technology, realistic weaponry, and heart-pounding action, MissionX delivers an unparalleled laser tag experience. \n\n\u2b50\ufe0f Arena size \u2b50\ufe0f \n- pre-made 4m x 4m 1vs1 \n- free-size customizable for up to 5vs5 in Mixed reality.\n\n\u2b50\ufe0f Instructions \u2b50\uf
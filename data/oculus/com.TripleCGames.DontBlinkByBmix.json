nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-twu75DfO8wQ7kNvwFLrKtE&_nc_oc=AdpX5q5giOVIklSrXupX6GKO5Jdk1G6kvuJmhSpgLBQIMsPrL-hU9UNSJNUNotanG9w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPP2numekAJroV6Ol1qt4MiZsnfrZ-ASmzTONNzKN-F8w&oe=6AD0D847"}, {"file_name": "screenshottwo25601440 (2).png", "id": "1687269142513551", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623400_1687269145846884_2166149891676883949_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tosqjl6ed_IQ7kNvwEgEuN2&_nc_oc=AdoVceWR1zfJF9xnKhWKdVBkqO3EbSBATWfeN_W3W9JNdRittS25IZfeCeTkwdSWaKY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsirPVbS4jVFvReHJUG0TZg2fXLTtrpsdKefaIiN38oA&oe=6AD0E61E"}, {"file_name": "screenshotthree25601440 (1).png", "id": "1343650354615870", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/654944867_1343650357949203_3868148605712296193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2th_WW7ikuYQ7kNvwGt2VbX&_nc_oc=AdoyxEDmBS96l3JIxmbv2D8_hazHIq7upK6-Nx4IdywZgBPSdM-1ZaaUcdG3h2nrXWE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNN-Qs2lV8XJBB3iX92N6ixpBYCtRqKlb_qntaIXBXUCA&oe=6AD101FB"}, {"file_name": "screenshotfour25601440 (1) (1).png", "id": "2892073441144845", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622285_2892073444478178_8597454688962741907_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qrjfU_OWwYQ7kNvwFwEGkW&_nc_oc=AdqTOiKFXACNp63y5VVgC_gil7jILQEgl1wUaatA6xfgrwt3Qom5wJFNe0zTKUnEv3s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJQmwDHVd3qaypbQ9InzMy7eTRJW4PlVsBskiO9Qnp2w&oe=6AD0D104"}, {"file_name": "asd sdafdasdasdasdasdasd (1).png", "id": "1510587407278895", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620429_1510587410612228_8892002452761795225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JemtRi0uXkkQ7kNvwHqrk1s&_nc_oc=Adq3GQEI3I2ve_3mFSQdrYYOH711uL5r0LwaxfIZtQSd5epCrtPLEDbHDwPzIJSzUKc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJpdITfYuXAZs2LhvPHsHZFTNNRHgEVx5VP4tsE0W6mA&oe=6AD0DCEA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dont Blink", "keywords": ["horror", "scary", "backrooms", "liminal"], "long_description": "Don't Blink is a multiplayer VR horror game by TripleCGames that drops you and your friends into the Backrooms \u2014 an endless expanse of flickering fluorescent lights, damp carpet, and the constant hum of something that should not be there.\nLevel 1 \u2014 The Office\nExplore the iconic yellow-wallpapered corridors of Level 1 with up to 10 players. A relentless entity roams the halls, hunting by sight and sound. Coordinate with your team using real-time proximity voice chat \u2014 but be careful, it can hear you too.\nLevel 2 \u2014 The Labyrinth (Coming Soon)\nNavigate a twisting maze where the monster freezes only when someone is watching it. With multiple players, survival becomes a coordination game \u2014 someone always has to be looking. The moment everyone looks away, it moves. Can your group keep eyes on it long enough to escape?\nFeatures\n\nMultiplayer VR horror for up to 10 players\nReal-time proximity voice chat\nRelentless AI entity with dynamic targeting and ambush behavior\nCosmetic customization system\nBuilt ground-up for Meta Quest\n\nMore levels, entities, and game modes in development.", "short_description": "Don't Blink is a multiplayer VR horror experience set in the infamous Backrooms. Explore endless liminal corridors with friends while being hunted by a terrifying entity. Stay silent, stay still, and whatever you do \u2014 don't blink. Features proximity voice chat, a relentless AI monster, and more levels coming soon. How long can you survive?"}]}, "developer_name": "BmixBOI", "developer_privacy_policy_url": "https://sites.google.com/view/dont-blink-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "TripleCGames", "support_website_url": null, "websit
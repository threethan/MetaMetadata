nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7QYi2J0yjEQ7kNvwFW7149&_nc_oc=Adqd02JBuAWLAHbEIB41dmqwFiCr6VZ9C5daP4SuhEeU4Hwf6n6yKzpaTCt9YR65i9I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkSIwz7QvpEyPKDkyfLjxPbOuo-b2hRKkoSlNOswoAQA&oe=6AD229C7"}, {"file_name": "screenshottwo25601440 (2).png", "id": "1687269142513551", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623400_1687269145846884_2166149891676883949_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztIq7t8FdPoQ7kNvwHvSxpm&_nc_oc=AdpWfd2tcWFMdxOxKqAT-eP8q2bXbL025Ur_VS1dRPwTCFOyPP8vvwYv_ZPJKg901fU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUGQMWh7Qp09c7P06MU4I9nleylgCFRluPPozCHJUwaA&oe=6AD2379E"}, {"file_name": "screenshotthree25601440 (1).png", "id": "1343650354615870", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/654944867_1343650357949203_3868148605712296193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7s3omzWPDjEQ7kNvwF4JIdP&_nc_oc=AdrtQTaGe4_QnoekHgSH_O0Vs3Va1MIYG4WL29O-o15nbQBLbO0GyiTL4k_Asj5LwbE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGgk3OG_uBH_HMxQOdb12acTxRy7bEwGIAc_8h5e9_-A&oe=6AD2537B"}, {"file_name": "screenshotfour25601440 (1) (1).png", "id": "2892073441144845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622285_2892073444478178_8597454688962741907_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qrjfU_OWwYQ7kNvwEEi1o1&_nc_oc=AdoTkjpSXBmvOOruJKshDEkpOzPYTJIGmiX-pLm2yiS4QQeGih48CTY2uImr0rvPur0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO64bXm2QriqS0Lsi8xYieQufIxpow049Gc6EZd4T7gPg&oe=6AD25AC4"}, {"file_name": "asd sdafdasdasdasdasdasd (1).png", "id": "1510587407278895", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620429_1510587410612228_8892002452761795225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeoIvzDpmX8Q7kNvwHNfWPW&_nc_oc=AdoQIFwOxQSGELP_iaUpNowxxrrdnyd9zjQKSPPJjxjR0-pIgf9Ggm6YNZ1o5zkt2do&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSCpngMOKUlsDG7Kcx1xEwh1zixMPCeY5tK5T5FWkrbA&oe=6AD22E6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dont Blink", "keywords": ["horror", "scary", "backrooms", "liminal"], "long_description": "Don't Blink is a multiplayer VR horror game by TripleCGames that drops you and your friends into the Backrooms \u2014 an endless expanse of flickering fluorescent lights, damp carpet, and the constant hum of something that should not be there.\nLevel 1 \u2014 The Office\nExplore the iconic yellow-wallpapered corridors of Level 1 with up to 10 players. A relentless entity roams the halls, hunting by sight and sound. Coordinate with your team using real-time proximity voice chat \u2014 but be careful, it can hear you too.\nLevel 2 \u2014 The Labyrinth (Coming Soon)\nNavigate a twisting maze where the monster freezes only when someone is watching it. With multiple players, survival becomes a coordination game \u2014 someone always has to be looking. The moment everyone looks away, it moves. Can your group keep eyes on it long enough to escape?\nFeatures\n\nMultiplayer VR horror for up to 10 players\nReal-time proximity voice chat\nRelentless AI entity with dynamic targeting and ambush behavior\nCosmetic customization system\nBuilt ground-up for Meta Quest\n\nMore levels, entities, and game modes in development.", "short_description": "Don't Blink is a multiplayer VR horror experience set in the infamous Backrooms. Explore endless liminal corridors with friends while being hunted by a terrifying entity. Stay silent, stay still, and whatever you do \u2014 don't blink. Features proximity voice chat, a relentless AI monster, and more levels coming soon. How long can you survive?"}]}, "developer_name": "BmixBOI", "developer_privacy_policy_url": "https://sites.google.com/view/dont-blink-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "TripleCGames", "support_website_url": null, "websit
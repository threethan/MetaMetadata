nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7QYi2J0yjEQ7kNvwGELiyj&_nc_oc=Adoo9cDmjpixjamy89NziMG6NbNQpaluDcyCc8LlV5DmkzqHDFC5P1OvGdI_TO5d_hU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLQ6p7zOvT6E2Crq4xsAxCilFxXoEb6K3wvXXxnGTZwg&oe=6AD3B387"}, {"file_name": "screenshottwo25601440 (2).png", "id": "1687269142513551", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499623400_1687269145846884_2166149891676883949_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztIq7t8FdPoQ7kNvwHr7Tpe&_nc_oc=Adq_hrDJDUjivvPzFQh-iWQqQfxuO-zuvLMqB39peOubU8bY8HdM0poZHd6c7jdgOwQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv6QfGt7LaVCoBF77HW-pxP8TmgJCse5QJX2coNBllfQ&oe=6AD3891E"}, {"file_name": "screenshotthree25601440 (1).png", "id": "1343650354615870", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/654944867_1343650357949203_3868148605712296193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7s3omzWPDjEQ7kNvwHdKPFf&_nc_oc=AdooqAfaRRdVSBV_wTndZ4T40GJMjE8Acq6t4qs3F2a0cIoeTybdL9WGz8mpAsUMN90&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlQ9kHKel0tk6q-lEKqulWpIhG8m108z73Eqtm94tP4w&oe=6AD3A4FB"}, {"file_name": "screenshotfour25601440 (1) (1).png", "id": "2892073441144845", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499622285_2892073444478178_8597454688962741907_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qrjfU_OWwYQ7kNvwF3pRhR&_nc_oc=AdpwDuAsqJvOGFuTLfTt5T7D9xFqES3IuexqkR7rwbVQdjHVtNXhpg3Jkp1FYkuXx6M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLTFa_ZaUvJQVtMS4i0kxTR69KSYF_h6ahsLeDdmWG7A&oe=6AD3AC44"}, {"file_name": "asd sdafdasdasdasdasdasd (1).png", "id": "1510587407278895", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620429_1510587410612228_8892002452761795225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeoIvzDpmX8Q7kNvwEt3cwE&_nc_oc=AdqeBOhgN02HEUOh_CTkDqjOu49FL_3GkyrWYvMncRZNA9luvNCtxJI9FWw-7pXR4tk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnbqCDi02swE9YUbG3UhNUbwgM5xhz_kyZuP3nORyEhw&oe=6AD3B82A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dont Blink", "keywords": ["horror", "scary", "backrooms", "liminal"], "long_description": "Don't Blink is a multiplayer VR horror game by TripleCGames that drops you and your friends into the Backrooms \u2014 an endless expanse of flickering fluorescent lights, damp carpet, and the constant hum of something that should not be there.\nLevel 1 \u2014 The Office\nExplore the iconic yellow-wallpapered corridors of Level 1 with up to 10 players. A relentless entity roams the halls, hunting by sight and sound. Coordinate with your team using real-time proximity voice chat \u2014 but be careful, it can hear you too.\nLevel 2 \u2014 The Labyrinth (Coming Soon)\nNavigate a twisting maze where the monster freezes only when someone is watching it. With multiple players, survival becomes a coordination game \u2014 someone always has to be looking. The moment everyone looks away, it moves. Can your group keep eyes on it long enough to escape?\nFeatures\n\nMultiplayer VR horror for up to 10 players\nReal-time proximity voice chat\nRelentless AI entity with dynamic targeting and ambush behavior\nCosmetic customization system\nBuilt ground-up for Meta Quest\n\nMore levels, entities, and game modes in development.", "short_description": "Don't Blink is a multiplayer VR horror experience set in the infamous Backrooms. Explore endless liminal corridors with friends while being hunted by a terrifying entity. Stay silent, stay still, and whatever you do \u2014 don't blink. Features proximity voice chat, a relentless AI monster, and more levels coming soon. How long can you survive?"}]}, "developer_name": "BmixBOI", "developer_privacy_policy_url": "https://sites.google.com/view/dont-blink-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "TripleCGames", "support_website_url": null, "websit
t-iad3-1.oculuscdn.com/v/t64.5771-25/499620429_1510587410612228_8892002452761795225_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBo5fCih-k8Q7kNvwHNWwDI&_nc_oc=Adr9_SXtMjlSTLti2YpXhLfG9lsTFMrkPgpa_L8YqjPDeftnP8Qa5t97MAsgyK-NwGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdyWA1hNxiSeWPGIqNnJ1NjqV-CVtDKd6yJFKE24oMKQ&oe=6B05D12A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dont Blink", "keywords": ["horror", "scary", "backrooms", "liminal"], "long_description": "Don't Blink is a multiplayer VR horror game by TripleCGames that drops you and your friends into the Backrooms \u2014 an endless expanse of flickering fluorescent lights, damp carpet, and the constant hum of something that should not be there.\nLevel 1 \u2014 The Office\nExplore the iconic yellow-wallpapered corridors of Level 1 with up to 10 players. A relentless entity roams the halls, hunting by sight and sound. Coordinate with your team using real-time proximity voice chat \u2014 but be careful, it can hear you too.\nLevel 2 \u2014 The Labyrinth (Coming Soon)\nNavigate a twisting maze where the monster freezes only when someone is watching it. With multiple players, survival becomes a coordination game \u2014 someone always has to be looking. The moment everyone looks away, it moves. Can your group keep eyes on it long enough to escape?\nFeatures\n\nMultiplayer VR horror for up to 10 players\nReal-time proximity voice chat\nRelentless AI entity with dynamic targeting and ambush behavior\nCosmetic customization system\nBuilt ground-up for Meta Quest\n\nMore levels, entities, and game modes in development.", "short_description": "Don't Blink is a multiplayer VR horror experience set in the infamous Backrooms. Explore endless liminal corridors with friends while being hunted by a terrifying entity. Stay silent, stay still, and whatever you do \u2014 don't blink. Features proximity voice chat, a relentless AI monster, and more levels coming soon. How long can you survive?"}]}, "developer_name": "BmixBOI", "developer_privacy_policy_url": "https://sites.google.com/view/dont-blink-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "TripleCGames", "support_website_url": null, "website_url": "https://sites.google.com/view/dont-blink-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1012079958139573"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1005920861919233"}]}, "baseline_offer": {"id": "1005920861919233"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781178960, "status": "PUBLISHED", "id": "1005920861919233"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1145876071426627", "version": "0.5"}, "id": "1425791242684628", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1006776612003241", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1145876071426627"}, "release_status": "RELEASED"}, "binary_release_channels": {"
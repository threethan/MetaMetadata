=7f20f&oh=00_AQEA_PzLLDnSeMyMzFbUQ6_y6YQixrZzWN-1cUHAO93cUQ&oe=6A82F07F"}, {"file_name": "Adobe Express - file (21).png", "id": "1552344403339981", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499294643_1552344406673314_307472206365219018_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9f_wmFr6FEQ7kNvwGe4ZUu&_nc_oc=Adryo9seobUJIdyDbpXK0krfETRRkN9FM5SchZxzbsnOeFLOpxqth_qe1n55mWqYdOI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKAPutCOaBAuLZlLMAF7z_AkD51IocX5MzvwOs_CxOpw&oe=6A83095A"}, {"file_name": "image5.png", "id": "4405966936385187", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499305443_4405966939718520_7358778608815373503_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0Dmybc35ZAQ7kNvwGseS_v&_nc_oc=AdpKj3UWGyoiH7oPbnax8A6RHswgImFCvTf5AzP-gH3xhMRh7vsKe7O92ZjaK-3M0z0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJPY8Ze5LD0jMliV8ClKRPp62DH3aLb0pcNWIRYY7ayw&oe=6A8302B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dont Blink", "keywords": ["horror", "scary", "backrooms", "liminal"], "long_description": "Don't Blink is a multiplayer VR horror game by TripleCGames that drops you and your friends into the Backrooms \u2014 an endless expanse of flickering fluorescent lights, damp carpet, and the constant hum of something that should not be there.\nLevel 1 \u2014 The Office\nExplore the iconic yellow-wallpapered corridors of Level 1 with up to 10 players. A relentless entity roams the halls, hunting by sight and sound. Coordinate with your team using real-time proximity voice chat \u2014 but be careful, it can hear you too.\nLevel 2 \u2014 The poolrooms\ndo not stare at the monster.....\n\nLevel 3\nNavigate a twisting maze where the monster freezes only when someone is watching it. With multiple players, survival becomes a coordination game \u2014 someone always has to be looking. The moment everyone looks away, it moves. Can your group keep eyes on it long enough to escape?\n\nand more levels!\nFeatures\n\nMultiplayer VR horror for up to 10 players\nReal-time proximity voice chat\nRelentless AI entity with dynamic targeting\nCosmetic customization system\nBuilt ground-up for Meta Quest\n\nMore levels, entities, and game modes in development.", "short_description": "Don't Blink is a multiplayer VR horror experience set in the infamous Backrooms. Explore endless liminal corridors with friends while being hunted by a terrifying entity. Stay silent, stay still, and whatever you do \u2014 don't blink. Features proximity voice chat, a relentless AI monster, and more levels coming soon. How long can you survive?"}]}, "developer_name": "BmixBOI", "developer_privacy_policy_url": "https://sites.google.com/view/dont-blink-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "TripleCGames", "support_website_url": null, "website_url": "https://sites.google.com/view/dont-blink-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1057834273564141"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499292426_4516355728642471_7743451222082669724_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac7dEUh-cqsQ7kNvwGRwlls&_nc_oc
": "en_US", "screenshots": [{"file_name": "001 (Copy) (Copy).png", "id": "3965745296809823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982704_3965745300143156_6617120882965128165_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqUQKGsL3eQQ7kNvwHuLYAk&_nc_oc=AdkKyq2o9ugFJWFV5-dtViLTeBWpa8I2oGmxxuxHXx_PKtGKjlsttGuYguKeZPYSEX0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAF9spmE4KmHtHPBQxVtSI5uFptzF7A63ZWX05dkmoLA&oe=69AD7B13"}, {"file_name": "008 (Copy) (Copy).png", "id": "228669952137250", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974844_228669955470583_5354321749578787730_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyVkXFams9wQ7kNvwHwnp7_&_nc_oc=Admw6lJf2WUm16UrqtX2yUBAWzWx0oJz7kn5cCkXNcBYsmDXemGBGz7vgxyezLswsuQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw88fSRExnH83vYgxKrD0S0eNoeidD5PeyfZRyg2cl1Lw&oe=69AD761F"}, {"file_name": "003 (Copy) (Copy).png", "id": "711720876197030", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569432_711720879530363_2218981563442948547_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYwsJOsGcs8Q7kNvwFvSbHM&_nc_oc=AdlndFhU57qNC0Qf7jhWxgelsovv3InziAMFfo0GipmVXg8Jh8ZaCx7DJE-5QNWbHOs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFPclGub982v0ujK-TV4hVJRx62iS58uzs5pfEvpwS7g&oe=69AD8695"}, {"file_name": "007 (Copy) (Copy).png", "id": "251845326322375", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974485_251845329655708_8143617825416042553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4ylLiugV9IQ7kNvwG3qBt9&_nc_oc=Adk9iVm-OWn_k8tRQuBi81BWGcrxA7G7ptYLFYEKa8FylBImT8LXpVeifBGsEojDYUU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyEigDax0B7hBZTGHKKu7XNpbHfROawAGSd2PeApndgA&oe=69AD8286"}, {"file_name": "009 (Copy) (Copy).png", "id": "1142100859554896", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036685_1142100862888229_8765398433102123381_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GG0F-U1IWpgQ7kNvwGnGfZN&_nc_oc=AdniHjCWuu8ouhAekSEKVKMee308-wHGhXpIM06DpDFoLi9rUsC6V6t-H2NZNXo4GVs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnTTcEHYo2DwUbzIIRfa6yZELJO1wIAg7pfUNiP0PoNg&oe=69AD6FAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 X 1440.png", "id": "714665772746761", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240101_714665776080094_8723710778086863969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6R-NvQjnHoQ7kNvwE4bTyi&_nc_oc=AdliwnVAnkY_156y1DD9jMmNiyciMT0j1kdVb4YCixagvPk3bSKAtQ0RthTe9mBtulo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfybROjT9Y5LisbhGu56e2RMK4rv8pXp94EHz1dfNf71vA&oe=69AD6BB0"}, "display_name": "The Final Overs", "keywords": [], "long_description": "Experience the thrill of the death-overs with this action-packed VR Cricket game developed from the ground up for Oculus Quest. \n\nWhile everyone is asked to stay inside homes & cricket grounds have gone cheerless & crowd-less, revive the vigor of cricket by not being a mere spectator but by actually being in the shoes of a batsman and chasing a mighty target in just a few overs. \n\nFEATURES\nQuick Matches - Get to the ground within seconds and restart matches seamlessly!\nT20 Mode\nSix varieties of bowlers with different specialty (leg-spin, off-spin, fast, outswing, medium-fast)\nSeveral competitive leaderboards (separate for different modes)\nRealistic physics\nLast ball replay in slo-mo\nCelebration on scoring 50 or 100 runs\nExciting commentary\nMultiple bat choices\nAdjust bat alignment to controller\n\nJoin our Discord to connect with us and other players: \nhttps://discord.com/invite/rNBxHshvx2\n(we are highly active and responsive there)", "short_description": "With incredibly simplistic gameplay, The Final Overs doesn\u2019t require any professional hands to hurl the ball way into the crowd with a powerful swing of the bat. Even if you\u2019re new & know little to nothing about cricket, this game offers you the basic experience to effortlessly familiarize yourself with it and enjoy it without needing to learn about the sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thefinalovers.com/TFO-PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "https://www.thefinalovers.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "462677658852213"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1199954237680265"}, {"status": "PUBLISHED", "id": "637351769243865"}, {"status": "PUBLISHED", "id": "948712513324517"}, {"status": "PUBLISHED", "id": "563086306556967"}, {"status": "PUBLISHED", "id": "546866848093418"}, {"status": "PUBLISHED", "id": "1235614771190435"}, {"status": "PUBLISHED", "id": "605628397172711"}, {"status": "PUBLISHED", "id": "1082865175680770"}, {"status": "PUBLISHED", "id": "868362124641764"}, {"status": "PUBLISHED", "id": "453267239125309"}, {"status": "PUBLISHED", "id": "182308563773169"}, {"status": "PUBLISHED", "id": "416473693564221"}, {"status": "PENDING", "id": "307788101632026"}]}, "baseline_offer": {"id": "868362124641764"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750438800, "status": "PUBLISHED", "id": "1199954237680265"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": 
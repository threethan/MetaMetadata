_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-4EBP0aH6Ctsx5gKrbPvUwpzX_r2wE2gHef5ULP8Uug&oe=69D0FF7F"}, {"file_name": "thumbnail six.png", "id": "1876583566474274", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391911_1876583569807607_8034973670934466146_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FybAImKDk4kQ7kNvwGhiZiq&_nc_oc=AdqNEbOfoYlXBCHFBOiINLXltzP1eyOsWHNt7IE7rr41G2bJAvy4f4FB4TWNy2ZxhoQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzs6j2kHRQjvy2mncF6ZjDnCMx8HPwq5AdbpKY9xGxp8Q&oe=69D11BD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "2231284957226545", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982499_2231284960559878_7927798837045485971_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uta6e0hG_BIQ7kNvwER7tn-&_nc_oc=Adr1ifn74JNaqWzvzjOvjSUUDLlnfdC2vgf-01jCY7gw3UOIUABNmKl8RUrMJHmS8ws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmLjwE3cK2edqV01IONOt4hKUe1G8FpmRI3EW4jaLe7g&oe=69D10FB3"}, "display_name": "Final Overs - VR Cricket", "keywords": ["Cricket", "Sports", "ibcricket", "vrcricket", "cricketbat"], "long_description": "Play the world\u2019s second most popular sport with 2+ billion fans now in an epic VR cricket experience. Final Overs takes cricket gaming to the next level in VR with innovative physics, aesthetic world-class stadiums, & many more exciting gameplay features.\n\nStep into the jam-packed virtual stadiums & establish your cricketing legacy as an aspiring cricketer. Take on AI-powered bowling side, or compete with your friends in local multiplayer matches. \n\n{1023212629369308}\n\nWorld-class matches in **aesthetic stadiums**\n\n{668555419152122}\n\nFully immersive experience with **realistic physics**\n\n{1048927140621971}\n\nThrilling matches against **international teams**\n\n{566880399852693}\n\nPolish your batting skills with **timing meter**\n\n{692412490107446}\n\nChallenge friends in **local multiplayer** mode using mobile\n\n{1230393305762003}\n\n**OTHER FEATURES:**\n\n- Multiple cricket formats: quick match, T20, ODI\n- Track your progress in your profile\n- AI-driven intelligent fielding & bowling system\n- AI Coach match summary & tips\n- Multiple difficulty levels\n- Immersive world-class stadiums\n- Practice net\n- Regular updates\n\nThese, and many other incoming features make Final Overs worth the experience. DOWNLOAD now and rise as a star in VR cricket!", "short_description": "Bring your cricketing dreams to reality in this highly immersive VR cricket game! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://finalovers.cricket/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "https://finalovers.cricket/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9814793011922517"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974888_702288425421610_1326782060541322224_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIz4SHPY_w8Q7kNvwF87cNt&_nc_oc=AdrayFwzaSZqlGyWATnNfLTZexPyOks3EnL1bDxp-Gn3UCkD24aYE4b5yebYhEespFQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw70sZbYDFagDHviZfoNpuQhyCfmM55IDiI8wWkWKMtBg&oe=69D0F501"}
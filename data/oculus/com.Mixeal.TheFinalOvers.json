_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ALCNdgDek6Pn1UCQ0I3dYp5hmdIH5MuFqHRsFtxtVSw&oe=6A34183F"}, {"file_name": "thumbnail six.png", "id": "1876583566474274", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391911_1876583569807607_8034973670934466146_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIVYueNdz-UQ7kNvwHjRxIY&_nc_oc=AdrKKYdYtFcNCmzhpvQ8yvipLeY3B-YJi51R3nlT3nRfzsha_oANvifDh9HXizveZVI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94ZQy80Hys80kdmeSI8yjeiqbajsXyWi2axR0VKZuRAw&oe=6A33FC57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "2231284957226545", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982499_2231284960559878_7927798837045485971_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeusxcMUTtYQ7kNvwH-cZYs&_nc_oc=Adpqi8DSB989dxZMTHEuxOxbyv_4E7YZTINBvv6WMbMtxn9Dqve0D38MzpH2-cyUgZw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gP_s7DtkQhgSf9uf6SqBZQ-7h4ye4YrPsSew9uCeqbw&oe=6A33F033"}, "display_name": "Final Overs - VR Cricket", "keywords": ["Cricket", "Sports", "ibcricket", "vrcricket", "cricketbat"], "long_description": "Play the world\u2019s second most popular sport with 2+ billion fans now in an epic VR cricket experience. Final Overs takes cricket gaming to the next level in VR with innovative physics, aesthetic world-class stadiums, & many more exciting gameplay features.\n\nStep into the jam-packed virtual stadiums & establish your cricketing legacy as an aspiring cricketer. Take on AI-powered bowling side, or compete with your friends in local multiplayer matches. \n\n{1023212629369308}\n\nWorld-class matches in **aesthetic stadiums**\n\n{668555419152122}\n\nFully immersive experience with **realistic physics**\n\n{1048927140621971}\n\nThrilling matches against **international teams**\n\n{566880399852693}\n\nPolish your batting skills with **timing meter**\n\n{692412490107446}\n\nChallenge friends in **local multiplayer** mode using mobile\n\n{1230393305762003}\n\n**OTHER FEATURES:**\n\n- Multiple cricket formats: quick match, T20, ODI\n- Track your progress in your profile\n- AI-driven intelligent fielding & bowling system\n- AI Coach match summary & tips\n- Multiple difficulty levels\n- Immersive world-class stadiums\n- Practice net\n- Regular updates\n\nThese, and many other incoming features make Final Overs worth the experience. DOWNLOAD now and rise as a star in VR cricket!", "short_description": "Bring your cricketing dreams to reality in this highly immersive VR cricket game! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://finalovers.cricket/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "https://finalovers.cricket/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9814793011922517"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974888_702288425421610_1326782060541322224_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEJf9jtxhJcQ7kNvwFTQtNt&_nc_oc=Adq5LLox2zfqCjYGNNElRl12TSbUdkXacUScjQvXLhbQRJJVVznxWWxQpnx6XCUDUpo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rftUplo63Am6FXQJX3FkewCuLr_MNQYoZ73Evqplkdg&oe=6A340DC1"}
scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV_uHAVaLopf_HRlBCZ5KGtOWMiUr8Xsz9l9zwvO9KrIw&oe=6B106257"}, {"file_name": "scre.png", "id": "1014826410337105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75617322_1014826413670438_995575470037502135_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63ysgbzdjDEQ7kNvwEk9tYP&_nc_oc=AdovkMI6qwrMAWp1Gi3Ak1RFemxNY8f7NDV1C9hrAHKZIOx2Mul4bBq3KSDugQs4knA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVYqz3hh9WbLBoqDa5AUsU781O3JHyDgdRrx-lDNCWWcA&oe=6B1042BF"}, {"file_name": "thumbnail six.png", "id": "1876583566474274", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391911_1876583569807607_8034973670934466146_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpD6v3dtGN8Q7kNvwEq2P1q&_nc_oc=AdruVugTVkLzL0mBVyPRJO5ch42r3QrQCmhMIYAzuXaQrE1Rgks7FVp665CvewGAgwg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW19n7Lm9H0dTEFStElbBY-GqfYlvp56wVKVnfJwIXsNQ&oe=6B105F17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "2231284957226545", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982499_2231284960559878_7927798837045485971_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zxe8GSR8BTYQ7kNvwE9fcEl&_nc_oc=Adq9UoPOwx5TO3QRxhTdg16dw_JyNuQboi61HDLYHEYIdfzk3C0X_JXAaGdg8oKXgV0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXHKf3vaCj5C8yGKWl3jhPWVPqYhBxEtdylLmb9KZKUig&oe=6B1052F3"}, "display_name": "Final Overs - VR Cricket", "keywords": ["Cricket", "Sports", "ibcricket", "vrcricket", "cricketbat"], "long_description": "Play the world\u2019s second most popular sport with 2+ billion fans now in an epic VR cricket experience. Final Overs takes cricket gaming to the next level in VR with innovative physics, aesthetic world-class stadiums, & many more exciting gameplay features.\n\nStep into the jam-packed virtual stadiums & establish your cricketing legacy as an aspiring cricketer. Take on AI-powered bowling side, or compete with your friends in local multiplayer matches. \n\n{1023212629369308}\n\nWorld-class matches in **aesthetic stadiums**\n\n{668555419152122}\n\nFully immersive experience with **realistic physics**\n\n{1048927140621971}\n\nThrilling matches against **international teams**\n\n{566880399852693}\n\nPolish your batting skills with **timing meter**\n\n{692412490107446}\n\nChallenge friends in **local multiplayer** mode using mobile\n\n{1230393305762003}\n\n**OTHER FEATURES:**\n\n- Multiple cricket formats: quick match, T20, ODI\n- Track your progress in your profile\n- AI-driven intelligent fielding & bowling system\n- AI Coach match summary & tips\n- Multiple difficulty levels\n- Immersive world-class stadiums\n- Practice net\n- Regular updates\n\nThese, and many other incoming features make Final Overs worth the experience. DOWNLOAD now and rise as a star in VR cricket!", "short_description": "Bring your cricketing dreams to reality in this highly immersive VR cricket game! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://finalovers.cricket/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "https://finalovers.cricket/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes"
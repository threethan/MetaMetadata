ent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_1142100862888229_8765398433102123381_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRCK78Ik__wQ7kNvwHUMg8x&_nc_oc=AdrMTmIIFXkR8EKMl3Ija6OpOR-gkAoQEznhG42Gulr-a6LlAt7vEVF-K8D9XHBiCPE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfsXUMXqTdCUGL58qeT0-XuadKUtc-N1NbEa9zhd4aFA&oe=6A67532E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 X 1440.png", "id": "714665772746761", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240101_714665776080094_8723710778086863969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKJwD8eVUggQ7kNvwFGAajZ&_nc_oc=AdrF05mI7LFbGZSHHVERf-DGHidQzrkHuUBpHPm_m3Thq2oUgCF7I_KPYB2fb2gBFZw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf7Ivznw9KtkzGJ-PW5eupoOCYLojD-cd0Go6Mmzv_VQ&oe=6A674F30"}, "display_name": "The Final Overs", "keywords": [], "long_description": "Experience the thrill of the death-overs with this action-packed VR Cricket game developed from the ground up for Oculus Quest. \n\nWhile everyone is asked to stay inside homes & cricket grounds have gone cheerless & crowd-less, revive the vigor of cricket by not being a mere spectator but by actually being in the shoes of a batsman and chasing a mighty target in just a few overs. \n\nFEATURES\nQuick Matches - Get to the ground within seconds and restart matches seamlessly!\nT20 Mode\nSix varieties of bowlers with different specialty (leg-spin, off-spin, fast, outswing, medium-fast)\nSeveral competitive leaderboards (separate for different modes)\nRealistic physics\nLast ball replay in slo-mo\nCelebration on scoring 50 or 100 runs\nExciting commentary\nMultiple bat choices\nAdjust bat alignment to controller\n\nJoin our Discord to connect with us and other players: \nhttps://discord.com/invite/rNBxHshvx2\n(we are highly active and responsive there)", "short_description": "With incredibly simplistic gameplay, The Final Overs doesn\u2019t require any professional hands to hurl the ball way into the crowd with a powerful swing of the bat. Even if you\u2019re new & know little to nothing about cricket, this game offers you the basic experience to effortlessly familiarize yourself with it and enjoy it without needing to learn about the sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thefinalovers.com/TFO-PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "https://www.thefinalovers.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "462677658852213"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1019085047540556"}, {"status": "PUBLISHED", "id": "1199954237680265"}, {"status": "PUBLISHED", "id": "637351769243865"}, {"status": "PUBLISHED", "id": "948712513324517"}, {"status": "PUBLISHED", "id": "563086306556967"}, {"status": "PUBLISHED", "id": "546866848093418"}, {"status": "PUBLISHED", "id": "1235614771190435"}, {"status": "PUBLISHED", "id": "605628397172711"}, {"status": "PUBLISHED", "id": "1082865175680770"}, {"status": "PUBLISHED", "id": "868362124641764"}, {"status": "PUBLISHED", "id": "453267239125309"}, {"status": "PUBLISHED", "id": "182308563773169"}, {"status": "PUBLISHED", "id": "416473693564221"}, {"status": "PENDING", "id": "307788101632026"}]}, "baseline_offer": {"id": "868362124641764
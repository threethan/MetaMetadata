&_nc_sid=6e7a0a&_nc_ohc=rG5z1oR_W_4Q7kNvwFJufw5&_nc_oc=Adrml_Y3LoC2m_GJvRvjvySq3apEk9OQdj5rUHtdMDzSwwav11daA8zKXzvKgPtQZ5A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQudpxYc_puR8kvqetsJIXrgwqNHU9jpV0WHmo_qWMvxw&oe=6AFDB515"}, {"file_name": "007 (Copy) (Copy).png", "id": "251845326322375", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974485_251845329655708_8143617825416042553_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYkRtFnDTQsQ7kNvwHMmvJm&_nc_oc=AdrgMGSS0b0LGcQ-IODDFcEHpDxYTnqX6Z8qXGZUAFXQ5ddz26VXnlvkxdiTfMB_tEM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqWxVbyFINxwJY2cRTBCjGXs6BSQwBT-pMsQWyl4YOkQ&oe=6AFDB106"}, {"file_name": "009 (Copy) (Copy).png", "id": "1142100859554896", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036685_1142100862888229_8765398433102123381_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWqJXpn9LukQ7kNvwHo0i2X&_nc_oc=Adrj_M18kYkANc-8O546i8Y-keQz1hpQjPE9SCl3cxhz_goT7xTLwm8otqkxPf3Bc0g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1249cCokbk0SWZtg15Fu1hBvu62G_Pyh6hswiJHnO8w&oe=6AFDD66E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 X 1440.png", "id": "714665772746761", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240101_714665776080094_8723710778086863969_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydVmD_NPVuwQ7kNvwE7I0fh&_nc_oc=AdrckIc-itxwp_n2TzoVdor1dPb0DQ7-S2ASUzbIvwSFWBSkC90qVCwuJc9IoEABUi4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQMuEZvWRwp0cpE9jfs_3mzbQ_CqR9IAQkI78SsBEsag&oe=6AFDD270"}, "display_name": "The Final Overs", "keywords": [], "long_description": "Experience the thrill of the death-overs with this action-packed VR Cricket game developed from the ground up for Oculus Quest. \n\nWhile everyone is asked to stay inside homes & cricket grounds have gone cheerless & crowd-less, revive the vigor of cricket by not being a mere spectator but by actually being in the shoes of a batsman and chasing a mighty target in just a few overs. \n\nFEATURES\nQuick Matches - Get to the ground within seconds and restart matches seamlessly!\nT20 Mode\nSix varieties of bowlers with different specialty (leg-spin, off-spin, fast, outswing, medium-fast)\nSeveral competitive leaderboards (separate for different modes)\nRealistic physics\nLast ball replay in slo-mo\nCelebration on scoring 50 or 100 runs\nExciting commentary\nMultiple bat choices\nAdjust bat alignment to controller\n\nJoin our Discord to connect with us and other players: \nhttps://discord.com/invite/rNBxHshvx2\n(we are highly active and responsive there)", "short_description": "With incredibly simplistic gameplay, The Final Overs doesn\u2019t require any professional hands to hurl the ball way into the crowd with a powerful swing of the bat. Even if you\u2019re new & know little to nothing about cricket, this game offers you the basic experience to effortlessly familiarize yourself with it and enjoy it without needing to learn about the sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thefinalovers.com/TFO-PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "https://www.thefinalovers.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "us
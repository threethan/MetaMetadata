ptbLRwzhVmz1R3Osqw3H2SSqK2yDJbv8SaTFG9R-w3po&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGQs_Kx2QhPP5ZDPk0ocitTPQUxz38ruokdFTK-Bp9MA&oe=6AF34F6B"}, {"file_name": "12331069_325227431215746_1854924533224439808_n.png", "id": "1006546063204597", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75557063_1006546066537930_8563168750526423667_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9WYlY1F6vUQ7kNvwECN6cf&_nc_oc=Adqa6rgX10Qj-rmXuSOVTFKnxhUAx-qRTUKjBBZukq1axexLrjw8Z-hYAdEW74_OdF0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7XAZ_DmCGRhzBx0RiMdpAeNd4VU3eDDakX_F-gugumQ&oe=6AF33AE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SHOWTIME-VR_cover-art_2560x1440.png", "id": "3907622612592163", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982678_3907622615925496_3240964338705721185_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyadndmmPQMQ7kNvwHPiF9N&_nc_oc=AdqRxzZSA1OHP-kz661vAg_1pbwpY6tIYcmtaTjiV7Bwj_S4nQinpdtlPyJdektFazA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeqQtsAobjfPzu8TaP2omanjy6PJgrYhA1_CIVnAVGmQ&oe=6AF3459D"}, "display_name": "Showtime VR", "keywords": [], "long_description": "Showtime VR enables remote management of many VR headsets. The solution includes a 360 player which is installed on the headset and is able to play 360 and 180 degrees videos (2D and 3D) and 360 graphics and photos (panoramas) up to 8192x4096px as a slideshow. The controller application is installed on a tablet or PC/Mac. The content can be played synchronically on all headsets or asynchronically. Showtime VR is designed for business professional presentations, marketing campaigns activations, movie shows - VR theatre solution, kiosk solutions \u2013 little involvement of staff, fair presentations, events - everywhere where you need to have full control over the headsets and the content presented on them, where you have to manage remotely the VR headsets and would like to present the VR content in synchronic way. The 360 Showtime VR player works only with Showtime VR controller application.", "short_description": "Showtime VR helps you manage remotely numerous VR headsets and play synchronically 360/180 degrees videos and 360 graphics/photos on many VR headsets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://showtimevr.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Showtime VR", "support_website_url": null, "website_url": "http://showtimevr.eu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "MEDIA_PLAYER", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP"], "id": "341682724532507"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3890794587803960"}, {"status": "PUBLISHED", "id": "147905780549265"}]}, "baseline_offer": {"id": "3890794587803960"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740567660, "status": "PUBLISHED", "id": "3890794587803960"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35265564489697316", "version": "5.14.31"}, "id": "1029650107544261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicati
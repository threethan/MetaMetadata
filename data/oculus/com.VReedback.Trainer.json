003254_534512422141517_8319121500853562997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7PxkysEjwIQ7kNvwEnW_PX&_nc_oc=AdmiXf7kOgaCPDdIwqaXfh5ngNF9Kvb0rbY93BBRu40rdQJyyFqWlokevcXqkd53GC4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsivwfTYUWXzq0too2EjdYFvXGA8wlPCy6me0z7X1Eu2A&oe=69A05542"}, {"file_name": "ImpSH5A.png", "id": "959163268794868", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031623_959163272128201_387016303826545432_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGS8Fm3Dyv8Q7kNvwHGe1H5&_nc_oc=AdnpsDKT1e1lRvp3tGbahtJ45FPxCKbbQZw15UPwQqcEU4uHmRnJa7n2xdiHGIyGDZ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfukuleZnAkfwon_0zJmX659_QKiFVTQxRos5i98kBWVsA&oe=69A02B51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "888722919055193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035351_888722922388526_3788059232677356028_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoKSBgHrCI0Q7kNvwE4AoFC&_nc_oc=AdlZ3X9tkUKuHhG07q_nC3KI0iBWyz8V1OlENHXCoqrNT_6y7miGuEBug9qF_VqJPdM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afud3xgDLw0Bukn5X7Cohfp_sCdCSfB0XsoAss23WsrTnw&oe=69A03A63"}, "display_name": "Impression VR", "keywords": [], "long_description": "With Impression VR you can effectively train your next presentation, whether it's in front of the class, colleagues or in a job interview!\n\nIn each of the 3 rooms you can set...\n- how the audience is composed\n- how long the presentation may be (with stopwatch)\n- how attentive the audience listens\n\nAfterwards you can rewatch and listen to how well you did.\n\nThe current rooms are:\n- Conference room with 3 spectators (job interview)\n- Conference room with 7 spectators (team meeting)\n- Seminar room with 20 spectators*\n\n*less on Quest 1 devices", "short_description": "With Impression VR you can effectively train your next presentation, whether it's in front of the class, colleagues or in a job interview!\n\nIn each of the 3 rooms you can set...\n- how the audience is composed\n- how long the presentation may be (with stopwatch)\n- how attentive the audience listens\n\nAfterwards you can rewatch and listen to how well you did.\n\nThe current rooms are:\n- Job Interview\n- Team meeting\n- Seminar room\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vreedback.de/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VReedback GmbH & Co. KG", "support_website_url": null, "website_url": "https://vreedback.de/impressionvr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1233860373920237"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974549_981194892863481_1773089365847593838_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMUKQjyPtSAQ7kNvwGWbp6Z&_nc_oc=Adkc0jPaUk_CpkQdTTaPnnvufp-h3ocgsTpGX9Sj45r3lZdKNKKyZPyJ4OvNcsPBGQA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu7NLTUAzq155sI2Z9rPF-SluUb9cp8zkfCME7PXoaUOA&oe=69A05693"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Impression VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_dat
.com&_nc_ss=7f20f&oh=00_Af53ZVcSmQHUkLJWNaQEglAiEjlxYVEsCv3QyZ3CSZo7MA&oe=6A0B36F4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQiOnhCJU8kQ7kNvwFVCe4x&_nc_oc=AdrQkYq2OYyETE9bd2yndNFMCykJ9DDNVKA3BIAPkvoOJxLmPIH5Gbclp3u5CWtLh9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VDInT5PgzKKDpjcyPbEexHFUASkJkSwR5jXhDtsLkXA&oe=6A0B0274"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfRH8GCXO4YQ7kNvwG3QmN_&_nc_oc=AdoBybqvZ4ARPh8uRT3HCYUltzxoTAQ3Rk6J3ekbwA6UWd7HssuQcE62FlZvxH8v7UI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aRcZcR3W48jPCsYAVt43hW-68iLYYsEwtfzspd136cw&oe=6A0B2545"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2f7YAvtL3ZEQ7kNvwF8og7C&_nc_oc=AdqTgpBeiey_82Ju_70AJIpQkF9I2qhuhICLaU7MWfse2KEUX8Vf5l2eNJ3IRjgTOHc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XkPExB4KeqSip2q4vJEnqEkUUqY5c4YETf-9EAh4ioA&oe=6A0B05C7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzKudFsZNvoQ7kNvwGoxtFM&_nc_oc=AdojdiSjvkreLm86FyggdJuYTjU7tCxjtkQPU2ws_bV8WVgn14KjkzPqa_E1OJ9Bx1g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vkc2Ldp7WK8w63VsSkgcQ0X4jX15CwLUhWCgZV_q_IA&oe=6A0B137C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inuOzj9w0D0Q7kNvwFwqm0b&_nc_oc=AdqEbtOWTdq6U2aUAJw0TnmgY1Y4F4-Xh3p_yDCoLG7Nh4bpYLFORd2tUPJmvLdvMDI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jaiWswLhaOuF5k4oAm7V0Au7oTeVou4f-jREONnSMuw&oe=6A0B04AB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
.com&_nc_ss=7f20f&oh=00_Af9dDfQPnA0b31u3ZSYmQBX12l02p8t45agUhAjEwXUlXw&oe=6A3020F4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2GuOUemH3MQ7kNvwE9RUnn&_nc_oc=AdoYdwS6Qot5DezPMjXJ6o3eUb6PylnHuuFFRLRih-0iDXMw0FOHdK5HHYPRUSHNM30&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xBa4LpanM9wnFR7mj9FbP-tx1lF139YCGJAcqiPu3zQ&oe=6A3024B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lpUxdDm6qQQ7kNvwEIauBY&_nc_oc=AdpgX4gJfY5YLIy6hhu5_AroRyth2YdKXdwl6--Pp9I2EkUMqXYlmYofmpef0gu1AfQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kl80jU16IepCRxW9HlTvP02mTNsmWAuuITSdH2cNa4Q&oe=6A300F45"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-2ubqi1ca4Q7kNvwEA68MJ&_nc_oc=AdqH0yXjRsesyzBW-oZhHeSeWZ4R7YomGDIdx1H1eKNcR8fbCXhyvNCAPKWXMdnPc8s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MP0rrcpXa-eCcy80_R0OnVFcVUB_Wc2S1G2bYiZ-sSQ&oe=6A302807"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJSn8xiuQCYQ7kNvwGSQrHe&_nc_oc=AdoLz6Ur6hNpkbQS3OGuXx71HSNQGwXzxI4DwRdkBrN6J-i8cpVrGOH9v2-qtazTHZQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6tyJUtVVUNOrplZ9m-UGSpZrfV8lx665fA9elbiqZDw&oe=6A2FFD7C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0K9bn4ClXM4Q7kNvwGyyhd4&_nc_oc=AdqvoQ54QMJnYVUGhOxncleg0Z0eXG8Ecobln-_9g8ZbE5ovPjkY5m1FkrHEpPhdgd8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1fWaqqdI7D0zLf-GdLG1B1L9dChX3561k4ZsEnxRbKw&oe=6A3026EB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
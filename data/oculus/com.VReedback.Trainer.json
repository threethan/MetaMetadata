.com&_nc_ss=7f20f&oh=00_AQBd5eC51o7wP-JoY3aZ-PLchwLvCy92cerNbuauAECeMQ&oe=6A689934"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgCgCxSyw1sQ7kNvwEKdWT8&_nc_oc=AdqyMCH4IHg5i_dR2aq9KuCwA_2V_y-0duO1pbJupbovTYFPHeQ0QnF-i78y7PuV5Tg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLxkuYHPNvQPnkZmnR8Nh_1w5cWAfTa18T4elC8cYwNA&oe=6A689CF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEal_6sb6JwQ7kNvwEtnLRm&_nc_oc=AdrBRBy9I9otMFOWSTx4GiIXDjFh2TliLwXFGKsIbBU6wntX2HKERFzezMRK95qKWiE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUpeOiWcm2xrZ6AdCunSC1OSzlF3PsK8aZutS3ClgP7A&oe=6A68BFC5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtYTnU7g9xwQ7kNvwF3RHK9&_nc_oc=Adru8X6djIxak6Gmxvdksx3-CA50Bj7pEJOarpQI0r2cnAYm8FZ2dqGBUEjO3txPPSY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBNYAlI4AWo9yK5zxXZsEK44YH06BCXRXh1B85Xigw2g&oe=6A68A047"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAsKqNn6540Q7kNvwFLkr8z&_nc_oc=Adr1lhZtYmaMXnqE7GRHHIB_6098MWGOuG38iz7Mm9WuOhtncrbcQOt-hFozceFmKoM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBV03X3ndinXYR49q8InUF00Su4A2pbqAWDNJMdc8wkdQ&oe=6A68ADFC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkTg4VGXJlIQ7kNvwHfuXym&_nc_oc=Adpq9GNz_MnHiBOh6H7OT2VPdXWLiWB_3JvRFm8J1au4MqJjBuL5GpFBSNd3RlcyBkQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwEgdxz7jxsHLp61-oGOuyxnN1AeijAvBTeIU7-vnq9w&oe=6A689F2B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
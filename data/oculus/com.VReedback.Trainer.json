.com&_nc_ss=7f20f&oh=00_AQKzm1xiCP2HsVZkHB_BSpiSLB_zKrVJUBhXx6iovGTPgw&oe=6AB93CF4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2qTciaf46IQ7kNvwFsw7Fa&_nc_oc=Adr0m-8f5hK8oo2z2JfPmUDQpJAaryzfvr1cob2_TW2aWCUSAt9UbDaYR44gxFSNxq8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWjAJ7XcVWLBAgEM_TfwwvlevfOMwYUlkFdJvlEuEBMw&oe=6AB940B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ig3Zgf54VoQ7kNvwHXN6SU&_nc_oc=AdrccdNepVQi1TfZ6obSb6OpP4iGlUxl07C8marMbeg11aQNwjH0XTXJnyN2gFoaisI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJD16v2XgZ-t3Fg1gMBn_HsN9xWfzXOFJ5LYWzA-Ni4Q&oe=6AB92B45"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPrsqyDYMPkQ7kNvwG5x0Uy&_nc_oc=Adr26xhXubxYjb8mVQ2bcldwy5xPY3U-rrA_cZTVh7WXjyV9waWXdO8Gt-N3niyaOxU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLhW86xGUVTOboWyYb3NBiX30dBvFqYTePt7ey8A72jg&oe=6AB90BC7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKRTP_1hPooQ7kNvwHbDmUS&_nc_oc=AdqyWj0zZAeYnYiY6Ee3kasqrnCdq6bLUi5zHoTtNhMlXI2_DbKz2QWV6qZjwXwnX04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4Ap5ND4XMhsgRcaYa2ahCupX9c8xlmjby9VOjBVWrtw&oe=6AB9197C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhsJkFp4OAsQ7kNvwG3eSOp&_nc_oc=AdqBGDVUGOsU5VQ1AmjjNFiAdH_U2GUa4fHMcv35rUe1dj8cgeDJU19dLebcLZ3kGCg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS5W0paNvtH28PmlF91bm3ulwqm7AEmmWmlOYadF6Juw&oe=6AB90AAB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
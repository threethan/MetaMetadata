.com&_nc_ss=7a30f&oh=00_Af3JeDacswQNgDMtO83wct14-g0dlm6MyCil9QStb11cuQ&oe=69E614B4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QyPFWrekz0Q7kNvwEnYq4-&_nc_oc=AdrErA82Rd3gmlOmeTXh_0J2mzeDVFVDADOeZ0wFRGXtOAM5jvvHO8hlPeVcVnRnJbI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VZrmqNQ2FoiVlVqalSSncWzOaQvZQSlEKn7x350lg0g&oe=69E61874"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD4Yd6r7fQAQ7kNvwF0vtbj&_nc_oc=AdoLvdlIE3MpLgLHEd5WPyXOlksEW8Jt1mEtpYJZBppMC13IjxetrI8zsRTgMEnDC3w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01u30PQeOG8Su0oU3nyIpQumcbeGRc4HyN3psyml6plw&oe=69E63B45"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdBtOTaf5qUQ7kNvwH_NzxB&_nc_oc=AdrJLvfYeLwgOENThhw5y9Iz56SB8F3gZ93hNLngeWrWXxDAJS1yLU6lhvQs8zOxRoo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pNS1xV8q2ox775C2wY2xUqoiLYf9DXur_oFoiHOsC_Q&oe=69E61BC7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7Fhqa0Ga-cQ7kNvwFpxgSx&_nc_oc=AdrT9HprB17KhhLBByc-icjb2jxvGx5tYZuTVVKoG3epPScQwSTXONJWxGC6ozT982A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ifbcs6qEMGXHIDaiG1_yEBOKEywTZsAFLwVJf3CIdAA&oe=69E6297C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JswsxjlIFsEQ7kNvwF6kiwj&_nc_oc=AdonmzORxATrFlAopzx2jl24Vk-KXDIEN5rkY01w8Q_xXWh9li3JMmkfroPd3G5zwA4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0A2gF_WHsiqhqymX63K-Ruy3fqjQu1hA81nsDL4ZZLHw&oe=69E61AAB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
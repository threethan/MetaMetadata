.com&_nc_ss=7f20f&oh=00_Af9E8TDQ96NVpJDw_O1VmBXWmniKJKKoitxZaZTYdwxgGg&oe=6A341574"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjpkghW3KEwQ7kNvwH7iWyM&_nc_oc=AdoxuZCzr4fTvDA6wkPISpQhrKKev_ilLW39s5i9421FT2GDRv2bxrZs1Q5YCteD8ys&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nhiRsQK_VJQkuNS0C7uHnltXkKMdL_gPxJpRRwzRxPw&oe=6A341934"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTZEj3Get8IQ7kNvwGTHq04&_nc_oc=Adp9n45zv4BJtM5bY4I-u4mLGcOCiwAnpOKFBqaOuw0Vde0PvN-lBSUybCJUEZYJZz8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TNUqmlybx-stqjPKDxHVEA7xuhfTgOgzPvtohTka-Fw&oe=6A3403C5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zj4-xYn3lsIQ7kNvwF8K5LX&_nc_oc=AdpEBSLavidmlgY5dOFLMjy1_MfXXQ2SDj9i4ZGYxRtrfoBJ_D3B2FZz_vNsRO__0pc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uDKU-yxWpyo0l20r-etNm5P_nUYs3xRhZzZSmkOYSuQ&oe=6A341C87"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7cBwD5vXucQ7kNvwHkAMCJ&_nc_oc=AdqXdZnUSycSLRpljLmhnz8Ogu5rev76b3QoQdZtxVoinbm3Dagcz9zavKkFJ4nMgYQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EpB2DzGThDOqYp7H4dt6u1CI-8K30Tx9QEMg20RWjDA&oe=6A33F1FC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7MXoI9t6O-oQ7kNvwFSqxpq&_nc_oc=AdoP1fL91xPtyCSAACAb25tTFyqOQbT4qK13w5EpnT5W6MY9p82lHXdlmYjLO7Ib-us&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SWK9-ND_RUM1jArn25lhGDlVVXjGi3zS5qYWK4GJGKQ&oe=6A341B6B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
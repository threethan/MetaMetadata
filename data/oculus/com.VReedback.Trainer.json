.com&_nc_ss=7f20f&oh=00_AQMHF3pTIOqBZDpMdYqX-S9q869TlhFHmjieXJw1q59ifA&oe=6ADCD574"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4pklZXLk-oQ7kNvwGc38EJ&_nc_oc=AdoSc09uXBphOY3ERaa1O4ZhQzhIO0xaxA5kLV8hyG0JRCJPZT-bX1FdMvPTr6EdJ5U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuc4iFUWfYkqDJCRBswyKRNYxiqHc4mVhltxQXjUWqZA&oe=6ADCD934"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0cHcYJ_GMkQ7kNvwER31oq&_nc_oc=Ado9vDTZwbAFRgAuG7vuKFNlzZMdfF_CCxKU1K7G_trkaW4rmcCUwN7foGZA0rNdNBY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1HMC0iL1kam4mchtswLrxnfEA2n_-z2bJGpj8VJaF1A&oe=6ADCC3C5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2nvNwMZ1PsQ7kNvwHkZ7dw&_nc_oc=AdpYh0hHJotbASFQzrNU8Z34OQrKWfRGyye0jBg_1RyHoOSCVxyFWcQoqC91TC3tLCM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_ezhE0jm72N9l_bZU7GwwdhWtkOO2lWRPOdH-v50PAA&oe=6ADCA447"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReVrJBkiUBEQ7kNvwFGV-ux&_nc_oc=AdrRTDSseJ_ccfwLJSJ5OJ50mNUuE7xpgIaLoUsqNuxXhl9BUxX_dAWXZT-g5KecrJk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFUYah7hroKZDYlu8MHx9vDNMDGQuFtwxVET94Fnb1hA&oe=6ADCB1FC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RFAOFAglXgQ7kNvwFNd9To&_nc_oc=Adocq5cvNfIPxmlqhcwKUYmClUMZFtc9HFro9YJW0cp5ommL0Y2xXAggA6G0HZmJA1A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9x8Iz1slEnkz2RA8SlMnflA0ynONf6v8WNx_1xP4XrQ&oe=6ADCA32B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
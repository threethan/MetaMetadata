.com&_nc_ss=7f20f&oh=00_AQNIVeCF0HUV9Q7rMjRTQO8LMfQIrPx92smhUZojqvqSBg&oe=6ACA6074"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pB7igH6XX0Q7kNvwG-nQ7r&_nc_oc=AdqhHrplRfN0nc0bMYaINs1t159vkTTeiuOleJn0UabXvOd9qbAt1GaxSC4HcGg0A1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNq9H-BB_fDBhf3vXPVCP-HLoeMEqThDuZikPtLQHcEug&oe=6ACA6434"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEiVvBsUu5gQ7kNvwGeKF5W&_nc_oc=AdqTJL4RqSew08HU42vXLA008jEO2SbIcdIcIjfN1kAAMhW42GaAiXdzQczt89_BrQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2z51tqJGj0Z_qR6qy9LjJ3jQ2YyC4Z833k_hTmDZmGw&oe=6ACA4EC5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Clm7tCDXxQUQ7kNvwGQFgOB&_nc_oc=Ado6ILlTpByVOVGod-Dw9BkbwfvUWw4Go9mPsYMMfRMOtp17AxPnBonmvB1zJpyCblo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpZZ-tV5EmwsK31rH0CsT76faKjfn-naaZ0bPGWTpNCg&oe=6ACA6787"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhkJHiBiEuAQ7kNvwFEb429&_nc_oc=AdrhcqvqaPjjbzKn2CNEmgW0k1-ZWOllUpRYAg3UM6laA3gy2AZzw46Qm0ypR_kKvRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-YrIoHKufXOlqoocFf4C6FFb0PNDFyScJUlH2bD1lrQ&oe=6ACA753C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLR3Yt_eWrgQ7kNvwFFF5Bs&_nc_oc=AdqyvlC8fXeT_YybjqQ-QgIPTTW2v0LG_-qZGghq2DWmuPUIc_ZJB_qT_5nbLKA28j8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOy55Vb8Dd8Z8Yrn1cvyYdrTpD7XnAtgo84Z7FU2fz0dw&oe=6ACA666B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
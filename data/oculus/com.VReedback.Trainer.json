.com&_nc_ss=7f20f&oh=00_AQHsmgihwiPJghixfm7kCMfslWwDIN_8sXhdyHiMsvByUQ&oe=6A883D34"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcYkILqeGacQ7kNvwEcX1em&_nc_oc=AdqYe5NNEEfUTJb6YLBk3VfO1uTMas5QBIE2O1DnvsgTgHHxlyb6dO9UBgsUIn3CKh0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0hdzzqgL-rv5HH95bKzJEqAF3UVUCcns2AAtWW9bzmQ&oe=6A8840F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaH2rKT8OfYQ7kNvwEAZa-q&_nc_oc=AdrcojILL78O9gkzuN-DLQyjk0ryDB8HPZLTmvEk6CqxnSLt7ALO98c3EwTkAlb0zRo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGctMZl5raF2cRycs_46iyI3hzh7h5B8ra4QeuXfJt2xA&oe=6A882B85"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bo0KQIuAawcQ7kNvwEE9AED&_nc_oc=AdqrqoRf16zFZGEUFwf8nOV4ae24COHSB1Tp9A_7jHkH7f42iwzCDS0zsB_7ZFtHFdk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENyTcV5KI0wzqstRIjqwrlyz_x8KIYRX1YKnvuXKD1eQ&oe=6A884447"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-xNcenL6joQ7kNvwE16Uyj&_nc_oc=AdpELo_2VyFjcHSeotOsBUekGx9eTRd1kWhmKo-pM9LvapaYgSpS7CKnQPxGoU_C7-Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMWPX3CEeXLie5gctNI3K7SMZN98ge31Mtr8z3HDt4wA&oe=6A8851FC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LU7jh2OQ0LAQ7kNvwE4t1dj&_nc_oc=Adr1zGuh7jKk8S6CxRQuD5rFQimOgNwaevGC8cLraK5PGKPJ3gw3Yg0XwFC-0f0bxAk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiC00sgt743bzDdx6U2_B81lVh195feiQ2wI-ODTCDTA&oe=6A88432B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
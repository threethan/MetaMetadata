.com&_nc_ss=7f20f&oh=00_Af9UZnIttZJhBSpVPYrhammZ-7LIcVBhFb8QFrA3yDi7Sg&oe=6A32C3F4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjpkghW3KEwQ7kNvwHDPj8n&_nc_oc=Ado5-gC8dQDSlJ3BVIVxYFKG8bgw05p8Om0FoATxjFr11KP3ZGzVA1WIRUrIUXLQptg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o0FvAeRbzu9HXWkjb8PWqq6gU5TtUGu78dTN86J-ZLA&oe=6A32C7B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lpUxdDm6qQQ7kNvwGuXAj-&_nc_oc=AdrLwr4pwb5VxnpKlJWXWMeWsgEBAW8hGstinSSa6isXpp16YX-9l5YKQRCwNGJsvJk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2eN_-ITnhVHbxYl5oaix97FDtb878AHf2NV8mldvrMg&oe=6A32B245"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-2ubqi1ca4Q7kNvwHJsZKG&_nc_oc=AdqRJBiiKWLEiiQWOjwygmigXgmorKDPAZlOh6L7dT3W7yAFEhd3nnLAqg9-Ic9P-Uo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_j-Bdfvjgx-X3eaqS5mja9sw07gY5WMOQ-hYtFo7IhMg&oe=6A3292C7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7cBwD5vXucQ7kNvwF8Ckcw&_nc_oc=Ado8QZXuF-rawqyfjobQnWXywAfbXF13lAYZPk_F90RT4JKgxwYFpaFfAd42oH_QbWU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rGwzKxXbEf5Jjk6zNBLc69kSz2A3yIXkyQMiHifMd9Q&oe=6A32A07C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7MXoI9t6O-oQ7kNvwFF3HxU&_nc_oc=AdqryZWNoKGD4XwBjrrs3lI6onCKISb_uvZudgGVUZVo159aRNjWqqXzNLRrOwBoECQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dEmS4AirfW0Euy1MrA5VrMs8QnYpFw_n8HROLqTajnA&oe=6A3291AB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
.com&_nc_ss=7f20f&oh=00_AQMGKycAzK4aVyKYgjqvBHMdKCHBHcd80AP_8c45mZaGwQ&oe=6AC90EF4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pB7igH6XX0Q7kNvwEZFQsC&_nc_oc=Adr7drTn06OrW250k5M6GlPIr-7pWS3-FuYkNKTQyYbuzc1kzYvxo07EHXimHEIACo8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPw2fK9wk78CVAEhpan1qQhjQGyAczRudKTB6oMd96Q8w&oe=6AC912B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hep0YbygCsQ7kNvwGoRlI0&_nc_oc=AdrzQV0sTHKuIrkFP6kEd7VG3Kv08L904cUeDn72E-lHNZfKv17_tnvfgWHbnerh4xM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-ANyo-LYKj5WGTKTWE5tQWkmWaM6T-YB7J7m666YXwg&oe=6AC8FD45"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3FraKYhlywQ7kNvwEhGm1h&_nc_oc=AdpWZfRgTKuhUCsqQSuBK3jp7rQp-UEdVfwfpheAB35Orm0qLUF8awqmSuFpi3vY3tw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyrgNUlY8fLJEsmcP4mLN6zqXzsxuH47svhAX7jNHCBQ&oe=6AC91607"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhkJHiBiEuAQ7kNvwEnvDBi&_nc_oc=Adp3TxsQj-PiDKJZXuwzV33tJl6QeN-h64xbttK3BePq4FZNzYcBTFZlf1ezMruXBQE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRPZUu9yKAlDiUYT0gkFYge7PPUr3iVnzDNoFg_mJQkg&oe=6AC8EB7C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLR3Yt_eWrgQ7kNvwF0Cq12&_nc_oc=AdpdAe7sdx3FIh-nCzpEUwjmhCXLc2KAERc79jOaqaDiBG__0KPJybdwPo5kp9FVg-M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcy7xrawX8BeydE25Coa7JE5xwNdFK9dJjpB07QOzBDA&oe=6AC914EB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
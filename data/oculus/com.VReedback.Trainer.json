.com&_nc_ss=7f20f&oh=00_AQHsE_KifLt0tU34Ng2oCi1vvJ_mLDy_9y0sgCxc2qd4Tw&oe=6A805434"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdfHKcaxG-UQ7kNvwFT-G1c&_nc_oc=AdqULqCPuk4bkG2Ki8du6RWZbYjIVXDPomyCPJ2wCq38vdXHHZOO6_U7We66xJeAy5w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvelJtfpmIpGzAhtF4DgK2UsuyHMzOXN2bo8hjmoq-QA&oe=6A8057F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBLAMXQWS1wQ7kNvwHH8qDq&_nc_oc=AdogK_X3ju1dkDm7l9EJmXUreENs_bBFGlJaOYggOVwi17HbIZq-6ClV9Voh51DxOBY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNCVFUhenqZRFNh0cXlX-2B_btcNDOP4uox5I6jBk_hQ&oe=6A804285"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5n8yTjLF_AQ7kNvwHhGF4c&_nc_oc=AdoN8j_uy1eS-46XIoPxFDZOh0l_HMhvHhgg18sHfnVO4s0zgk21gTFSHN2MLnZPdaw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgnneU5IgVA-01tWohVY5iOfWVntTP45AsdRtvyHpWng&oe=6A805B47"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwcLmG8OBNEQ7kNvwEpUSbK&_nc_oc=Adpz4qC1oyfmzmq88RfZPt6eFtsyMHgfOFylnn3BdS7Impr2_O2QeVRDIQ_TzN1BMu8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETT6LUo1IpF7T1BEVe6VAPl6GryRGmFsSyflXBW3Q8RQ&oe=6A8068FC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jchpo-tWX6IQ7kNvwGbSFYM&_nc_oc=Adqvd_WOza_o_f3Z5nZaf-yz4F0ZYK7gUODBr9gcN_1ya09cdK-aDzzobK1LPlvpUWY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPPluhbWC0315r5aGIhw9s2VaSLQN_5-Nh6Vc_lfvqNQ&oe=6A805A2B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
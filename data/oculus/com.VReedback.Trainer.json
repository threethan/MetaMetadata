.com&_nc_ss=7a30f&oh=00_Af2IrmxllvuGQz6lDJCmZddCVhKUyAmndwWpw5A7-arUUA&oe=69DA3734"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAOx_dAzRy8Q7kNvwH_kIWv&_nc_oc=Adoudz8Ysi2smuBMQ1bH39uYLGT6ntUkjsG027HTlcJO14lXvFPU7CU-Ln7uXWjtSLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37Ikk4IjJ5lB487fTsNkVTbNX-h_PjfeCG32YwuLBtsQ&oe=69DA3AF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtZjNBX5ZnsQ7kNvwHgYSzg&_nc_oc=AdrXAmCUtIgUh4Pkd2SvwKY9fklb4iYErErAudUFln4VG54XzgmnpG3mZ2ugesnum1Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13uyd5F_IzaJxxPzxSCubfFJVZ_HeNMgfzOF_FTQp7_Q&oe=69DA5DC5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH8FjdakyZUQ7kNvwECOLyL&_nc_oc=AdovfSBnMM_6nQjn_g89_N6BsrM2ez2YsaI1yo27TZmWYbyicpgn2PjB9PKOpg4EfrA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1D6xjtZeKxjkFdBUzayMmamhkgWsraSAHTNqEFknkGsA&oe=69DA3E47"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmvDg4DWmDYQ7kNvwH37IZs&_nc_oc=AdrWgMNHn0KqhZnTZsPPfMYmDLqz1p4UEa5Ob6a5bAgW-pJkwk-ImbiXLhmET6fVf9M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nUtkKezXLGPL4hX9YXS6cCq0ns2HvD2w1ZeYkxm2LmQ&oe=69DA4BFC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vA9UVcWdMYYQ7kNvwF_SDZ5&_nc_oc=AdpMIk6e2EHmuS-0YBea3S78hMBLME3EMimgE05sasNalI4mt9xZMQekJBNa-mGG9mk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qMWlhYtR8ruhHGwmSOfVWfzmqNFT9w7uYNIMZud8Geg&oe=69DA3D2B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
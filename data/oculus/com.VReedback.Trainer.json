.com&_nc_ss=7f20f&oh=00_Af5sKP6aM5z9hedbNUmg0vY6qXcagJUp2dUcJc5GG7SJVQ&oe=69FB2CB4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Wvjt8xfMYYQ7kNvwH6keh3&_nc_oc=Adqj1nGlIt9eN865asdt2cnHqhbx1DgBNrwxEszZcBaMmAOR_9aQk-vuPE96VcxYaHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6b4zVcgv-0Gnk7Jb52fSYpZ2lX_7GXhyfGniLppUhLOQ&oe=69FB3074"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CK9S_2GjW-MQ7kNvwGSpPlR&_nc_oc=AdpqNAnczLZR6xYmL-KEqgIjr_r19F4IV4ei7Us-x2mdbwb9guzz41lFlHnDLOAT80U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sRjra08ipmHcVUWQoIHoV72L6Z8nZb3oj9PfN6hWW4Q&oe=69FB5345"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ttj3COQl6ZkQ7kNvwFhY-CO&_nc_oc=Adp72Wq2_qyr3PJ4i2M5EMgFvwfRMsAteZuTqK27EEIYGSivGwaoa8arEqtBxcEIqiM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YDguswRoO0AWxsoNeFOEsS9MWvpuqhSmwuRh3MnS05w&oe=69FB33C7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeRmUYczkwIQ7kNvwFzO_7X&_nc_oc=Adog6Obkqzl9PAa4-gQL63wAIDibUnUxqN3BKBWPZkVVDD0IUJqO85M2Xwg1Q5OLUzw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-UiAXTLTf7mfgqtw-tppfrbkLMHW97u9OQXPi81xCGA&oe=69FB417C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjNm6MFqCNAQ7kNvwGf2VQU&_nc_oc=AdqgOo0ngxCHF9FHqLyd-bCwDXaR2nASgMdU0tgZ5knUD0A6eNNdmVH9bWjgOJvHlCQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WCHFhl4zx1u5X5Zul4fGwj7mfH8hwzTWQb1aizoJqsA&oe=69FB32AB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
.com&_nc_ss=7f20f&oh=00_Af-x_Rl4BGS-wazlyuES0TGY9RnsqOGStzoaei5o1S4I0w&oe=6A3BFE74"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHCTzGLUM5UQ7kNvwEqC0YK&_nc_oc=AdqEpmX84_frpZWAmhRWQX7YubAbLvZEompaEhjyywt03smCkrKwlJB9cPaHhFWM7gY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vpl3zTND1vd_0IWBkVb_9l_hKkjMgpETW6kQKRtsCuQ&oe=6A3C0234"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amHV3AeNsSAQ7kNvwGSKzhl&_nc_oc=Adq8CrXQg1RlJKSL8TiI0xcsSO-5JpWG0kCwXTlSgrMFEvh6tBgoS5uWegJirnpiJXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FXeV4DUl_kj1l_yeB_njX2QabP6mbEYSeQ9X5ZF5-bg&oe=6A3BECC5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oaGkmMJeaAQ7kNvwF-P95t&_nc_oc=AdogHfP_hhcn9K9KfsDhMWtj_az1CqQD9eRYAimhOAQEtcPPRybsx8rSAynwJxs9DAU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vCHlac1gvsNKmYlok7FjS9sgNWumFhE4IKYMSPEpTRA&oe=6A3BCD47"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CTyCaNESn4Q7kNvwE9wSx5&_nc_oc=AdriYxk2M09T2LSnkv-Nc4OTxM0mrtQeFa1X1s8JwQpfKRg0SZ8Yx0HYfN7NhBsPT20&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l98rSW52af0hKu4hcqu8xXEl0ObUdml6k_c9CImAyPw&oe=6A3BDAFC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bF1AZ3PdH-IQ7kNvwFk9cOq&_nc_oc=Ado_g2DqnzhYYgwDkC1yI7kjXSdF2LwT11NCm_FvdyYEejlk9BJXWWMo7zDRf9XJg0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KzlpHEE0IUix608Z7hp5NybXYAB_VkC5383k55cdgAg&oe=6A3BCC2B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
003254_534512422141517_8319121500853562997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iV3SUeuwfPoQ7kNvwFIUArZ&_nc_oc=AdlppyMBJlSj0yBP7fHVAGSsEqLNvPjqaeWUGdAQR5ELrOTJaq8iEYAgFQ9ePKOR-wg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvTQATE7j8ciCv2tYdvRDiZoI7tuL7Q2Y6Jbo8VDNB-aQ&oe=69A6ECC2"}, {"file_name": "ImpSH5A.png", "id": "959163268794868", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031623_959163272128201_387016303826545432_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgFpuAp_sC4Q7kNvwHio9RF&_nc_oc=AdkirQRkJ9hA8YppUE11oqt83gWTjczKfN4Fp4aCEB0IOjwQaVUI0SfzZW3f5nEhYhk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuRXplDNBuucgo0E_ENcdxnFMPL4d_2-2sv0KsjAuio6g&oe=69A6C2D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "888722919055193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035351_888722922388526_3788059232677356028_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPlYv8iAYKEQ7kNvwFMkwOt&_nc_oc=AdnoW2x9GKkNleWB676CKf-Y3CitduD6Y1yJ93hdgBhPQreH54b0htMYoZmVdFWci7s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuqfiihcLbqXRry-EvLvXEl9f-j6w9TMi5xUDVuRVGwuQ&oe=69A6D1E3"}, "display_name": "Impression VR", "keywords": [], "long_description": "With Impression VR you can effectively train your next presentation, whether it's in front of the class, colleagues or in a job interview!\n\nIn each of the 3 rooms you can set...\n- how the audience is composed\n- how long the presentation may be (with stopwatch)\n- how attentive the audience listens\n\nAfterwards you can rewatch and listen to how well you did.\n\nThe current rooms are:\n- Conference room with 3 spectators (job interview)\n- Conference room with 7 spectators (team meeting)\n- Seminar room with 20 spectators*\n\n*less on Quest 1 devices", "short_description": "With Impression VR you can effectively train your next presentation, whether it's in front of the class, colleagues or in a job interview!\n\nIn each of the 3 rooms you can set...\n- how the audience is composed\n- how long the presentation may be (with stopwatch)\n- how attentive the audience listens\n\nAfterwards you can rewatch and listen to how well you did.\n\nThe current rooms are:\n- Job Interview\n- Team meeting\n- Seminar room\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vreedback.de/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VReedback GmbH & Co. KG", "support_website_url": null, "website_url": "https://vreedback.de/impressionvr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1233860373920237"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974549_981194892863481_1773089365847593838_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=776EyMo117wQ7kNvwGO1Vhf&_nc_oc=Adk9dlrqsGLvc1KLPGxYXYIwG5Q8anwv9b6Fa0jtcnQ1BmKZM73S6NXyHK7O_1Nxip4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftbttgYK9mcz2X1YnUAscQK-_Nn3WGdHeLUnVSnpv9BNw&oe=69A6EE13"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Impression VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_dat
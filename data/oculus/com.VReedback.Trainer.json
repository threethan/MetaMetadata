.com&_nc_ss=7a30f&oh=00_AfyCTb87W5zE29P3cVb9IEArHv1yjLxmnIxLHw8uv6Rz3A&oe=69D0FCB4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gh0mYsfnowUQ7kNvwF-AAcD&_nc_oc=AdoqGyQ9K250m9FQNuY2L2R73hloYO8CeXKwshaqLjdtfOlXatgirFK--aNf3u2NFzM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrEYw9uQguZhP0vOKhCa1ZD1AAyMPfWfsaw9Sp8DKGxw&oe=69D10074"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NENOsixATB0Q7kNvwHFkBBX&_nc_oc=Adq1YOykRYnLzvnr72-qpeSu5wo_aDChuoG5YprvCbarjoZIPTrIc0_3ExdaPcqL_kM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwq3nQJSb3-mlL4bUmvo3bk9b9mS1gzmfxxXJmqthXhlg&oe=69D12345"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYCFuiehqq8Q7kNvwHo8Uxt&_nc_oc=Adqi2mw6KtU2ZHtrWeaCfED-3_riEgBCi4FwERU9TviZtk8IitI0T72vkAutDSz3nCI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJuIdEerdu1YLDfm47zhU81TNfQhakWaXUEMrS4FZbRg&oe=69D103C7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yksXh8Nj3bUQ7kNvwGy5wvm&_nc_oc=Adr-yoaZcg0waPrktVsFtOaUJA09UhveSx2pKIp6T5BUceyvDHnrXKjrTkVTF_UWdVA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUAisNZBA0nQdrVXU9-XChMHJ2XZLIj0GXvqOFRwFNfw&oe=69D1117C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZjW7-nLJwkQ7kNvwF8J5_k&_nc_oc=AdrLGzgRIonPvSFTG1AY57UY1ijWgotx8tNgAJJIsa47bMVIxSPe0S4zXLKgPg8JL8s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdeyXnQKMmlt-HoGDlIhPjC7inHTRHOtv5qGil_hM7oA&oe=69D102AB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
.com&_nc_ss=7f20f&oh=00_AQK5bRQUDN3nwrx9pE4f_jikNcFVlTpB3uuy3MFihHHETA&oe=6AA6C7F4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBqwlB2OGV8Q7kNvwENO9yY&_nc_oc=AdpM5pHYhECMXvq2t__qG_ZaTr6-d70cxWMovo7wY3NC35tvgZ_MNpRxyF3lqCLdq_I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMz1tG4gYzV0uCn8gGX-mA184jl8202ZUSq3jcgVEw8g&oe=6AA69374"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OR4xkB6KX1gQ7kNvwGcZ9Ea&_nc_oc=AdrP28J3_bx5trJ9w_SXAnr5L3hXar4ZslTqoolqdNV8HC809z5gMGm-ok3HQOr3m4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBIOi4iVYkk9Y-_35RuvI1xcSo5YTPFIFXODHkLvgGZg&oe=6AA6B645"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyMdB0UUjqcQ7kNvwGChJmm&_nc_oc=AdogtI1N_6tvmryFi3Fy3tJs1gAMZ1WhqaOCpPDb16abP5eDxb5N1x1xlf8-93_qePw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9VT_bnEmYXBXdch5vabpLxMToSo3fnqWWX1KvVT2KOg&oe=6AA696C7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pcrE_CLJtoQ7kNvwHapEWG&_nc_oc=AdpZCCdRfRrMW4iR6ezgnsMceucamIkrZp8yqR8r0BtLiwomgalMHkeClOSeMLwfp8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtL7rtDBBHqWZiY5UWpLgrS0A6gTiNEJSTxcXAdzj2Lg&oe=6AA6A47C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMHr6SeRrYEQ7kNvwF0NFne&_nc_oc=Adpu9HH-vnDOVA_8tW7X89yz6ry5hHh52JZC_lvz054R1jnPmFjd87_YeqX4d0WRmLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJy_nEaIDgeseu3kCXN7E6oRaPL_nRPRdbh1WZ94ZGEnw&oe=6AA695AB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
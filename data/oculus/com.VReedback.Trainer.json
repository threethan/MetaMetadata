.com&_nc_ss=7f20f&oh=00_Af2XTfx-yxy3E9Y9NpnGtEGcJ4xKu3An2HI1K_VtuyHKfg&oe=69F8C1F4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKAlhXR32oUQ7kNvwE-ZYQY&_nc_oc=Adr1FkNtxDHHJYaFVzHjQ6EYOjQ94tCrkde7yH6VTLWQJPGdr6SChxJz5z1eVsefrqE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0DAHVOzzcWPXWOgd65IjAmML7EbEsRmWha3pdV0DGeSQ&oe=69F88D74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CK9S_2GjW-MQ7kNvwFnwIT4&_nc_oc=AdoacsmLKBFhMe-GVHyUL2t59qA-Q7GnPv4HAeg8AiQ5_8LtuLisEZzmaHrLRYSGJuY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Vm8Ws-7Kv3903DGguBDOIaGcHjwXQPEeFPmDSZvDq3A&oe=69F8B045"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ttj3COQl6ZkQ7kNvwFDGpP5&_nc_oc=AdqMwf1zyftE4HNj75L1y0LgWIAaBkNnLH5DXYsyfugTKEaJJm0e2nDOPRFAjU6rU6Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kzxi4BKH2MVgg1xASG741nArt-iE-TsxNjWEXaUjWHA&oe=69F890C7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgCwZ-zyEvoQ7kNvwENubAj&_nc_oc=AdrXKjMHXWRHH3do66eLfd1EIjbmUEDoHrVo1V-G04kF40UJVBI3C4fNF92LsDfMG7s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Ubl4hEk3yJZD0T3t5NsFHhbtiRQfg4dTNkqQBbrrc5Q&oe=69F89E7C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHMPCcRHWJYQ7kNvwFbQthE&_nc_oc=Adrc10qc3l2-6GzEGgo43tfQXOgzE-oeBa5AG3hG4wjaKBcqttXa1Hfn0EVVnHKnKiE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0H-kAOkTXQ63TPL5nyNT_YjAAHrc-kVh0H-epQ3HXgfg&oe=69F88FAB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
.com&_nc_ss=7f20f&oh=00_AQQwwX8UzUwX3t8Wf-P1YBg_kSeJ0YrGzqUgMgwN3MD9ng&oe=6AF33EF4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20lgz1rTp10Q7kNvwFmV7KI&_nc_oc=AdrMDqKuTGryzfk-YnKCmo018uFoF1k1qP9m7C_H-haIdR0F6NDnovf6hNPIysnNRyU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGY1nc4bSsUWU6Y_OPwcFzNt1-oeioKq0kmNYODRI-jg&oe=6AF342B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64ynBMbp52IQ7kNvwFFFgnK&_nc_oc=Adq5UCzGCf1fxQcb8bEam4sWuNTWL-HuF524MgBQWwPpVXkPI2bJD_CFR6cVwi-7bso&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQxNM63yjoS2wD_jloElh-v4B-yO-l8pr_JwG3zeQldQ&oe=6AF32D45"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pi-NLOBg7ucQ7kNvwGlnHTl&_nc_oc=AdrKTfPAuYCCK668LafyMT8S-ZWwS32o3HFK3xSNjBiYdN9z4elLnj3WaE-th3bJRVo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3G7To7584JLiNorkZViKm90kUlGIqKL5NfISGLhswjA&oe=6AF34607"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPPxqr9heZYQ7kNvwExLBY-&_nc_oc=Adq_dNzw9ti05JpPIzpxXEUPzkYMY66y5p4_qhw3FZGFrFdcQ3WOyoFJqjDuvx5fXIA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTU_1jtQ8tKR2ERJ9L-Bz9JhyK-Eg_U4_v8EPNpn5ECA&oe=6AF353BC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ulwn280tK4AQ7kNvwHApxPH&_nc_oc=Adp5FrLvDuloD1JITb8SvVHqz8YLSLZF3OnEChhuqBEkoeHjZ9dImRx6_HGjZ6xWZuo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQun06RgHcjfBUBgcNGdGFjGl0KtyUIjtVLQZ_8W1L8qQ&oe=6AF344EB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
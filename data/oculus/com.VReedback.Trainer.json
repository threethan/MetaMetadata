.com&_nc_ss=7f20f&oh=00_Af8FDTlSMR0aZxoKY0hDSd3HJo4sxalY2ums0nq874ktRw&oe=6A2D7DF4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2GuOUemH3MQ7kNvwGRw5Sc&_nc_oc=AdofEyvdkAc5UGQMTfuCUe6jnQOQNtmukKICqcRsPnLnirTc81V4RFObRVqadld4ioo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dqUf6t4HJuNFOIR2ecJAJgC-7hu02dm8NB5xokV5Dxw&oe=6A2D4974"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNsEp56g79MQ7kNvwFvepWE&_nc_oc=AdqnxTsf1hGU20wGn6ut-o_y2rJ599LndQKWd2F9J9sizdLtAniXCZdNfYLoTy2sg44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fW7AGStGss7bUkrhKAbTmxjMugWUfRYVopl6tYM2m_w&oe=6A2D6C45"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNOJQlPkJAAQ7kNvwHzZfnV&_nc_oc=Adq529lSjpibg_lhfuSfBQOmONsWTZXHqwVh0x8w0wK5KNPBfUDFnzZRbWq38lq9BHU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_08RkXYq1S0MzzdEmNmHp5Q76qbR8lztW7BYTO7s5TTg&oe=6A2D4CC7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVeddECAqr8Q7kNvwHoCRRa&_nc_oc=Adou7k7vlyz3_85uK-IhfZaGXJ3H3BvWKEZhTEV1Dg5aXO7VRAGlpZGnyfSW4iKLeUU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kERwullQFtIuiQ9mUqOGbW7eRMwej4n7Plz0jCvtdNQ&oe=6A2D5A7C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0K9bn4ClXM4Q7kNvwFpLIQt&_nc_oc=AdooVzd0XuVnziy6pECpmYKbyJkZmq-1MNSiussMDUB5Fk4A4m_SatgEMcnbYcdDF3s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xcxgXmAEQBF8WsFPfT8tbMm1HvxJSYDcp6knhIFVBAg&oe=6A2D4BAB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
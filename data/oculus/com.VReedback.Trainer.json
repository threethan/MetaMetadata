.com&_nc_ss=7a30f&oh=00_Af0zY9RzxZRX16F87ezI0ec5rotWPW68WHgS4Tpu88ypOA&oe=69E4C334"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHnSYqMdEKQQ7kNvwGjCQQc&_nc_oc=AdqSMu5Jn0tL7Y-EVkxUYTnvMc9Bwng-S8Y_2VTgtIKPChjcKsJRFvTnX8wASr-lluY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aGnggyktT0do9kA9dU3uaX5FZVrKohxoLHRb6D0NbAA&oe=69E4C6F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD4Yd6r7fQAQ7kNvwFzD2jw&_nc_oc=AdoK7cJlYe88YthRCM3Wpe7tPcQbXQTcPT4i-hnHQ_zhlNmNBwQohazz42dWNLq-9fM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hBD9vFR7-KVxRH9ZU9KmPl5CskUBNdjhiZDFDBRxPRw&oe=69E4E9C5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdBtOTaf5qUQ7kNvwFZVmCL&_nc_oc=AdrsTCGtaHBpE_IZ5DGWhzMJ4w6AoadWJK6v0wpua8wJyHSVh_nG1egaer-dCo11X68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AXt1DX-OHwQeM4-W4P1_WFUhnaiMbRw9qIqMDP3_d1A&oe=69E4CA47"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7Fhqa0Ga-cQ7kNvwEXT7-p&_nc_oc=AdriPb4CUOFe_mA9KGLrZgNqYdu5gOKUN5BNfWYYMd4RMNeMSeRNtARqrvvFhbMrJFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ftHX9s8YDFnLbtkuhINeYqvm91xl4A9rUFWXlZH2OCQ&oe=69E4D7FC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIfSJVojl-AQ7kNvwHcA_RD&_nc_oc=Adp4Rtv0lm8ClPgNV5Ui43xrLb1wAvkEK3Zo06Z5iCV-FwNLQBCtchj_OMgBQHGothM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39jqIPFN4OT0OFR7E2oDbhAXeSZywA2RFGDmj5nWnqLA&oe=69E4C92B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
.com&_nc_ss=7f20f&oh=00_AQLmvNGt8kNdu24aM1g_CZZZxsh_q-jM1SOC7GNsytQoAw&oe=6AB699F4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dt3Hcv21av8Q7kNvwHyh1KD&_nc_oc=Ado1Y7xjgrpTBd1C198XdBdGjYr7TRp1QnOhCQnEl86aJX597SHg87lKTungbOX3Ir4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMmblbQJReg0NNdWt_a4nhPtRVgW_OE5HG6J_3R24J5w&oe=6AB69DB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ig3Zgf54VoQ7kNvwGp-veK&_nc_oc=Adpz4jqIiIkeAlSjQIstUIf7-ltQO6rM60iAXTN5Fy5WUHlWt7KB7-CJHf5V-y5LHdU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK4nmR9Ak8jHmbEr4UFt52jEErQTYP0unxJ0v54G3jtg&oe=6AB68845"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPrsqyDYMPkQ7kNvwFJjrho&_nc_oc=Adox7kQvyST-XCgKhw9FvQ1GbKHRDG5EoLY_TQ1lexk37lcBiMkbSipNB2al5c1aCGA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVaoUW9FfKmNEAOxFq9eaR-AGxWGP4DJmippIhDHhylw&oe=6AB668C7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geEjlev_pPcQ7kNvwHG7EYj&_nc_oc=Adpv0grj96RHlNbxHK5XXInp6gDqZmYnDyWP36iEb2x_K68HMEQdRxiXEdCxHAF172E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3TyhGFEszJoT-7B2PGYk4HTkQjcmqBumsdQw-x2qG_Q&oe=6AB6767C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dOS7QInShYQ7kNvwHbYt8h&_nc_oc=Adpr6w45H56TyBv8xIO-dHRUBbZx7adnuF1o0I4k5Wmd-VYpPAMTFsvhXSM_BIralik&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJSa871GIw8bdiPVcQkE9uB2JBzOAzLkWtlum40xtrSg&oe=6AB69FEB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
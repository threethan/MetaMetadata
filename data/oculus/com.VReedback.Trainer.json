.com&_nc_ss=7f20f&oh=00_AQIPFZRREBntSHaNiGKHdBfx7OhavtIcsL3YhfeHStoO3g&oe=6ABE82F4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zVuz158uFQQ7kNvwEGW-hF&_nc_oc=Adpxb8pNVEJe5zYa0LFRwchKsAXZIOWXzDmvnOutcFElvtDxvCCCuMhSdZ0-wHJCWYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxqOCBXz2Y-vAeSSuYLxBEz1CwGl-N3gYNmcQaN_aqXA&oe=6ABE86B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xy87DZbhmJoQ7kNvwER1y-N&_nc_oc=AdoAa-3uppH9SiNhppAhucwv3cefMDfR6_yNFuk79BZP_m4MbaHGr03yJ9zqVqG8n5o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7jUMiDnZsU0-K3VfZVEkrcI0z9P90wrz0axnOAwmEWw&oe=6ABE7145"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILd9F3J3-cEQ7kNvwEdKUG2&_nc_oc=AdqUjqwRwlA5F9DXNERDSdnTR53wknqZS-xJhw5iRlbWPru8FS5cKu-SBfXFmRpqJDY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk30GeRn5trDYUX3BYUHXEKIWCHEWj8iXi3pXSy0G5iA&oe=6ABE8A07"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAwBnt-cFy8Q7kNvwEZ7Odn&_nc_oc=AdrHTnzbnVLE7SEHN6jJu3vo54FiRPbRN5th6hTpTlXiB2Kbnrjl2bkNlrHf6soP4Xs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN8atCBjS0UjoBwAOxNo4pbwuM3t9aHu1VFlrXmBPmRw&oe=6ABE5F7C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upLF_Uw2o2sQ7kNvwGXbYlk&_nc_oc=Ado8v-AbwXY93FpNfqQqGj4mxHdAwRiKTgZs_jJU1Xzo_q-poqvXi8Xdg692X0j1Mcw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBLWvCdTrWS-EQ8mdVYfhnnMlVoBXpCCuUuIW2TfAiyw&oe=6ABE88EB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
.com&_nc_ss=7f20f&oh=00_Af_KRh7pVj-qAhkAKEWdAqGlrWeuiWbvuhxktP5p3dZUfQ&oe=6A4500B4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7yZwlbIU1YQ7kNvwGZH7L0&_nc_oc=Adq5pQPt04ypSdX9PVC-Yf4exF7vjzroXbfJiZiW_if0DnoxKYPYfQn3jduP4U-cgbI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Dsl8Lm4ceh4fWlTk3T9xIt1IWLko-F1zpXw_Tf3m-nA&oe=6A450474"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0lYlWZGq_UQ7kNvwFYJ9rN&_nc_oc=AdrqFQHxQ5w7OL7p7lQw-PFTV7rZveySU4J8Gdcc1bF1HBNO5gXC1uGYtaEK7cDsSTA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k0ZS1AbHGvsZTaWRByKSXyhlm3Uftv2xOCVs7F4qUMA&oe=6A452745"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VR2NBFj3CT8Q7kNvwFAROO_&_nc_oc=AdrnwVWucOdnlsM3f-yeqJOv53PquuJGJ4su97sacG5_RhSJYgEdAQr8Ymjgc9xdVL8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_d8EFy7fbs7Igjl0zkWjDcJtwXMnnbK0JnShVP2XseVg&oe=6A4507C7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-lIm8gEXQIQ7kNvwHnKzsc&_nc_oc=AdoNBpK4oVUqdP9OyDPR1x5XhhpCSzHWGhThsYXX7Vroa4iTe4SW5yNURyF5A_bV_1Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f974vLmCMhgjeteNCDUQAENJTHk5ZV3IqgB6wcgAKXw&oe=6A45157C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUBeb3Vp7N4Q7kNvwH7inbg&_nc_oc=AdqT7_aB8ab8AT6AI9cy7rbE5pT_IYMtJodxnX9-g-NtGxWUsQumC8LyBxCkMxdpG08&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HIGUgVO9ubTmxzTStLBM-WpQlJ4VJrcrQBbx3cQg7qw&oe=6A4506AB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
.com&_nc_ss=7f20f&oh=00_Af6IANmGoYARprZWu4un6mLS2Ru_ySmMx4Kx9kRYOj3PJw&oe=6A1C5A74"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZsBI9pQeh0Q7kNvwGAN1RU&_nc_oc=Adrc-AWopz5peXQgmKsgxFxh7p6Tt_NycU_b5i2bkKV_Pszy85zkk4jsD4RMhJetXI4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NE19fXpY8P1_JWEqJ3rgNdMdW8DYPtWQ8X3dGpuH2BQ&oe=6A1C5E34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQjX-77hsVIQ7kNvwGoiIzy&_nc_oc=AdrkTGKPHtxpBYz9F8nlPBd1mgAe1cS3lZrTn5uARSP8OLRXyn0NJkvgKuQpZHwemlI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hLF0GeZ0HrlUsUqTiC0KHqUC6PyHP5daPwFFbblZWtA&oe=6A1C48C5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahsKjR9ZrzYQ7kNvwEvIUlg&_nc_oc=Ados_O5GVW7RTAyg8hAXeqr9_oGUmrcbofKKZW86_PapHw7KiaSPwMAjIksfr2rR5H4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Yl3FrxZqPcNTweoliEnLdPrm2zza-IEvc6b_xylXRJg&oe=6A1C6187"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhezIPRgEQwQ7kNvwGNXcFz&_nc_oc=Adr2kAMJav8vqUrH0fVX-6G5zqoVBhnCtv-tA2xoQ5_8mq1Ly6rEc1FQt3Yb7aGsLOs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DLjAntzKd2zVh4ZIq2OirXtgelVDGP6gd0VustqT39g&oe=6A1C36FC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tpftt-r9WF0Q7kNvwED9H65&_nc_oc=AdpIMMnbdwv6qAZtUO27WTj6Yftqu49tN00fVLlmnO1O5Qm0s58A0Uzp4jt_6AfalRM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-dniESE7XYmR1xACewcFMxhnjFluieYl-QQhd3anlZA&oe=6A1C606B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
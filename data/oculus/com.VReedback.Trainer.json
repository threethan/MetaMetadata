ng", "id": "217316117620606", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75375759_217316120953939_45630775306426973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amrULNDzp7AQ7kNvwEQsw7W&_nc_oc=Admz9SAxw0rs8VKJBdClxMK-pookipUYkfpfoRCkHqT1ZR6fJU5pWyD-6raBntqxFcg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afs2ywt1VNCQ8RRaP-oeqJZjmjmBrwNpSatKZlHzEUBi0w&oe=69A18F99"}, {"file_name": "ImpSH4A.png", "id": "534512418808184", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39003254_534512422141517_8319121500853562997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7PxkysEjwIQ7kNvwHybjMy&_nc_oc=AdkmFnuIjHyDZXvuHeKk4Hz2oJgTIZ3SjhDQDWfQ15EAfe3nTl2ApK9PUm4NJ1Opv_8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvPV85E5P36WIA3VzdFfiwKTvC1tN09_iHHx5eCGLYdBg&oe=69A1A6C2"}, {"file_name": "ImpSH5A.png", "id": "959163268794868", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031623_959163272128201_387016303826545432_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtbsaVY_B3YQ7kNvwEbKHU0&_nc_oc=AdnNf1RdhxkHMyLrRQ-L-7ZGMGvtjKQif_XqLSxGowRHBT5iwDTlu39byLnC7DPaYHY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv3iBtKjNtxHacqe75Kct6qbUAz2T40Ic3vbQ72MHwntg&oe=69A17CD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "888722919055193", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39035351_888722922388526_3788059232677356028_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoKSBgHrCI0Q7kNvwFTfSmQ&_nc_oc=AdlRkhW3VrT_wTSmova4NvpI5v2wEOwjEDr4L7hucB9WzFMYpRLD2C7s9OGerckS088&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afs8qhraziQ55RtWlp6uD4FudR0kyzxr48uAmrSl-HO25w&oe=69A18BE3"}, "display_name": "Impression VR", "keywords": [], "long_description": "With Impression VR you can effectively train your next presentation, whether it's in front of the class, colleagues or in a job interview!\n\nIn each of the 3 rooms you can set...\n- how the audience is composed\n- how long the presentation may be (with stopwatch)\n- how attentive the audience listens\n\nAfterwards you can rewatch and listen to how well you did.\n\nThe current rooms are:\n- Conference room with 3 spectators (job interview)\n- Conference room with 7 spectators (team meeting)\n- Seminar room with 20 spectators*\n\n*less on Quest 1 devices", "short_description": "With Impression VR you can effectively train your next presentation, whether it's in front of the class, colleagues or in a job interview!\n\nIn each of the 3 rooms you can set...\n- how the audience is composed\n- how long the presentation may be (with stopwatch)\n- how attentive the audience listens\n\nAfterwards you can rewatch and listen to how well you did.\n\nThe current rooms are:\n- Job Interview\n- Team meeting\n- Seminar room\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vreedback.de/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VReedback GmbH & Co. KG", "support_website_url": null, "website_url": "https://vreedback.de/impressionvr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1233860373920237"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "890807225355074"}]}, "baseline_offer": {"id": "890807225355074"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1681808400, "s
.com&_nc_ss=7f20f&oh=00_AQF4CAtSGlw03Ub6qJdqMI_vJz7fQTv8U4UXUI0fT1tDvw&oe=6A95DCB4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLVROyaegs8Q7kNvwF-NEmA&_nc_oc=Adovecuwi6HvjgLatHjEFQDcub_K_Y-sXn4TCJ9p9J4cA0wzpv_UCePDfp8aRdtaPdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkOhG39jbAl_ThjbB1AFNKG2XaC4hEBHKtvsyqdbJM5A&oe=6A95E074"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqFrXxMjTb0Q7kNvwEiulTA&_nc_oc=AdpwSQDO504B4Db12p1BAd3QgrW7IIK4B0pXKortYOf6ynCNiNwtfRjpcOsobYBJZso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIBBfqwraWl1CsVEdlVhCYOlEcXNpgoPHDJozsQRyQRg&oe=6A95CB05"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4oeVsBFhZMQ7kNvwFx_YCn&_nc_oc=AdpOJPWgbZ6IvOFTzDL_YB8aA92ft3zEKK5gjGi77kAefVvevPZX9HRXMQp00vPAU_A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRnQAqFFP1BvH_ACU_hpSxichkkyQ0DKA88zDMoSXPsQ&oe=6A95E3C7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ct9e2hykUEQ7kNvwFyqZDx&_nc_oc=AdrZG0VAZyBAeTdKi_ZbbPIdIJIAMCaUgOxSZWlQeLU30BWVgZqNfMLOslHsPhnPeKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE81w4cawhlOJ9DWLp40z4VZbEcHEBJBPAOuDDxtufu5Q&oe=6A95B93C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEMi3hwRghMQ7kNvwE03b_l&_nc_oc=AdpQZkB2W2QdambDi66_bTYADonDobY9OUtct-VVneoS1iRs-Qat9_v7UzvONvlAu-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEce4fasn9oNsZ7mKtwlCn8a-AV2RbZmoGkDv_Q1iatmw&oe=6A95E2AB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
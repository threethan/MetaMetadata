ng", "id": "217316117620606", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375759_217316120953939_45630775306426973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSEBkf1ST6AQ7kNvwEeLhtM&_nc_oc=AdlqXkf88VbTYVMCK7yljG7ixQwObu7kJr_7feI1_K2VCJi53hChvUmr4S6ocVL4Emg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftJstZiB-h8KyiZHa0JePAPAVt4_a6GNpW9E7vcF_hIDA&oe=699AF819"}, {"file_name": "ImpSH4A.png", "id": "534512418808184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003254_534512422141517_8319121500853562997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OXuwz8vuIAQ7kNvwFnw1Ng&_nc_oc=AdnUhMVR6PhJhov-Qkpwgupv3uBkB-dOthUMPFks226RGYL7Boi_j-MvVIF5gY4gT9Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvWL5f8JrUceIKX6voI-PebFIcZQW8xZFIF2kheRpd2pQ&oe=699B0F42"}, {"file_name": "ImpSH5A.png", "id": "959163268794868", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031623_959163272128201_387016303826545432_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d943A4ZhVgsQ7kNvwF9JZZw&_nc_oc=Admbl2dpNuqQ4sCSw75sphoZ94eK5dcseCyKPau0iHs0sFTFjVWI13xW71Tj_9Uvde4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsfImgAFQzuWGEEtK_Tg99z3WHxierS4ywWldkS9spS0g&oe=699AE551"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "888722919055193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035351_888722922388526_3788059232677356028_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0S1X4oA32QQ7kNvwEsTsyC&_nc_oc=AdkQzN0VoRjqj4NLph7SVyHVmboGZ4y5OfiYCkYi02_uTvFvt9-Nh6499X3c3beU3gM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsk7ErWm22b-2l95WMRJOhrH0kwcLHrQbd3UElg2u2_Og&oe=699AF463"}, "display_name": "Impression VR", "keywords": [], "long_description": "With Impression VR you can effectively train your next presentation, whether it's in front of the class, colleagues or in a job interview!\n\nIn each of the 3 rooms you can set...\n- how the audience is composed\n-
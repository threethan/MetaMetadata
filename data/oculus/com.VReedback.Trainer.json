.com&_nc_ss=7f20f&oh=00_Af7-_TqBMYST5c9ntmoVxGmHdwiQuOjUgjFIuwG2CdlgvA&oe=6A19B774"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZsBI9pQeh0Q7kNvwGbgbl8&_nc_oc=AdqOG9FnG94YFZfujfFgHjcu5X106hyFPfAk1vTVZBy5jhy_J6eVaFUC1aTss8iGcOg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iIrsv73KDIfNYaK13bfL97xZ-MsAMyz71WPDFSYpQcA&oe=6A19BB34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMR4S9lt9ZEQ7kNvwF47gG2&_nc_oc=Adr1YEHGehnzfWoDBUr0qNTEXBaCriZpR1YMaIlsk_yVIRggZpzZOt-_zku4GHlx5XA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OQ0zPvxRwlJ7X8ypw07EEqXUw5iGQ7I43wJL1MCB4dg&oe=6A19A5C5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GM9aHGLuPo0Q7kNvwGmNokc&_nc_oc=AdrT11Z1mnqg8a2mm2WuhjC26U8Xd70tV3jbPoH7b-mMLBDaKdQSgwqwZM8tQ3PK_yk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YboX87aQTTA_frHYDsf_NjQx_wKklqdm44QAOf4x-GA&oe=6A19BE87"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyYTS6xNbsYQ7kNvwH2ZSzQ&_nc_oc=AdrxHOWCi5_SS4Zf5tE-lKifk7L3CllRec1-HMKLD5PPRH4JrVTtxzgEUBLAICZYX5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wXhiqcFIoBWb5lZawFTtltfLMcTeyLsU9RMx4NvPKMQ&oe=6A1993FC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tpftt-r9WF0Q7kNvwHQyink&_nc_oc=AdomqIrQHZ09Ec1bHacUwQT5vDuB_yfstiVX9jWncqmUDbeTmWGCa8skPgHgZw9pa6k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6chbvR6hVxg2_t_BaL2M57e3HQW8L1yjdd1eDj_rYkrA&oe=6A19BD6B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
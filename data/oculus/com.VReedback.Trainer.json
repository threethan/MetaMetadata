.com&_nc_ss=7f20f&oh=00_AQAdlIWHJh6bQ6OFXkBFxApqP9PUPL5r5ulhxQjCpTbUMA&oe=6A562434"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVE4vzvXXM0Q7kNvwH3GJe-&_nc_oc=AdqkMdBTssZkh8zyrjYdRfwlgc7AmRdPYtUyiPZ4Ccn7bp7baTG24-r9jVnpm748zWI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnX5CzeVQStcR4yQegNf3xJxyIL1CIGOAmw1P4voivHw&oe=6A5627F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_C42OySSrrMQ7kNvwGofkyo&_nc_oc=Adrr-DPVnmn2QIrt8uNn09uO5zIXQFxSOtGzNFMgZyzDvb1A5QYAa-zl3GDygcf20SI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf1OTyhWOfhExWUxstUJulWQ5Mck0mziIzFtmuCGiE1A&oe=6A564AC5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kUAX8yasNcQ7kNvwGAnCin&_nc_oc=AdquqAIxvgJFLRnIAADss07INxXr_UVsCUvyENwJHJ8Crx8zwzUPmBazosmUdKGRwBI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHS-BvysiBB7xPsaEHSvbpGWWvGhK0e2KjdVbnilt-Rw&oe=6A562B47"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzT84B3gpFkQ7kNvwHjzsH5&_nc_oc=AdpwQ2OMzXIzfnL6sxBig1_V9ReXHATtwQG5WvNXfflON0Gsp_fSHuv7GWncde5rGwk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEesfVGtwa_N3sfMOdYsfrleyOkKlZxs0a-ojqMaybAw&oe=6A5638FC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aV0jpeOmtYgQ7kNvwEMgpG8&_nc_oc=Adq3eFT8YDZ7qCW6S69sKJS3yeRWawARK90m2dbjUjHJnbKjGY9c4KHvE-bB9g0tPGQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAinO5H9G0ycd6jdhUK72r6PMCJB2GUl79qDi9sMpaIHA&oe=6A562A2B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
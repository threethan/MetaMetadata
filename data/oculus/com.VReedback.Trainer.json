.com&_nc_ss=7f20f&oh=00_AQCHkqfrFveKns-kfv_xaDQobP9WxHtUc53v24KavOLBZw&oe=6A538134"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAz4O3PD19UQ7kNvwHQBcBj&_nc_oc=AdpMlQsOpXMxHhCp_W2IYaUVJKxIfJBZsAnMiEFg8VZFF6u590nmzL17xpgcbwsgtgU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQGZRehxXhiNeLpTjvVeHte9fhW0AgH1KrstWP0nQv9w&oe=6A5384F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_C42OySSrrMQ7kNvwFvFoj2&_nc_oc=AdozNrqpEmyhIAPp3wi7M_hhHLu_HOBAN9bdMjtWQq_1C41sx30bVXt2GgLjd960nes&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAByaWpH3OHNKrSzBAhiOXe5ZySVyoykPis8yXjOvRWhQ&oe=6A53A7C5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kUAX8yasNcQ7kNvwFLaGt0&_nc_oc=AdrYMAszw7akFdG4tYOXCONsrs1yXxLs5j8J4_MMsZmzTjp_ZE0Qo4mHgNiOJy6WgsM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbAjDwYv1mHeqIN-Cke5w4B1DZsBC_SC0NU3KbJkAiSw&oe=6A538847"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlNVyFVzV70Q7kNvwEQlnyo&_nc_oc=AdrqPnnfBnIxrsjb6eHy0e_6HveEDHe7YBFYB2wlGt5_2z6LNbTiDmyVQ5iv-zSmWrY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGZWvqqKcH69nm_anQuYvHccDhj1FD25psYJ6NFY2MBA&oe=6A5395FC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yf7_6N1p2SUQ7kNvwH4dvHn&_nc_oc=Adql3x-1rYQ01QNSZlVnOnCrjgUkP2ubUbRGOXYyV9GJMCvxq9t81Gcv-7YyWmFJ6u0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDh-39htut82mcK0B61WKIRSs9ObvXUp6XciacBL3ix-Q&oe=6A53872B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
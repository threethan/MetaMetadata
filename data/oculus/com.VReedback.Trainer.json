.com&_nc_ss=7f20f&oh=00_AQGODriktA5FVfRcnMlfmC4i34z_nAn681NrtqwEboPbOA&oe=6A972E34"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLVROyaegs8Q7kNvwHZQH5A&_nc_oc=AdpEHSF1cuLSNUNU84fNJADf2dauZ5x4hSPD8Izj4WPsDu-wwBERDRxoe7la6-eMfik&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbLcikBoUa3bbitYO0cyYtPjroBMU0Es4KE-DrL4v8pw&oe=6A9731F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTprJPER_JgQ7kNvwG2C-Q5&_nc_oc=Adr963FrcfQ1B6iC5Kw18sKpKCJgeYYVw1uNLCWruhawSHn525HFtvjqkS0LP9p-HcU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIgrqN-tFltl0hG_uMt7dlPt9rRpG2_xin0Zbpg9qWww&oe=6A971C85"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImnWe1NLiT0Q7kNvwFKOf-7&_nc_oc=AdoSjB-7EOGd-DBKtPX5sAIC4DaL0B0NULeZaCylr5x2tYxFGG9AigBRZrbGvx-IgmA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELWyk6YSps37BMGEnkewFG1bcN5MpswiAVbqohWJKWJA&oe=6A973547"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ct9e2hykUEQ7kNvwG7Ph53&_nc_oc=AdqyJw5FJdUzfcn9GEyz_gRa7H8vW9P6sVUZUYzRLzYXMyC_HrhrxSby9im-bYlEzdk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF25lHN8tthtX8chmuw4rgz6KwOw2wNy2CAG5wPZqT63Q&oe=6A9742FC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEMi3hwRghMQ7kNvwGMDfOp&_nc_oc=Adp-WStMyynJy-4sRyiwz39R3jNEW2EpxptHU2xcvcXXsrYF1gXSk9hOTQNgmRfTqj4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDq713pMn-M5ziuiLzTdED0UKCAnCWDiV0ZwIaUvErqQ&oe=6A97342B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
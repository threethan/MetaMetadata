.com&_nc_ss=7f20f&oh=00_AQGBwe9MwV0XyZ2ZC4QLTD6caLgFH-gaspOi5WqQVBxA_w&oe=6A7C5FB4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-t2Twa5d8gkQ7kNvwEOgyu7&_nc_oc=AdpPowUdXG6ONVFMEsHU8SAm0psOptcBvPtUUZrBPdK65eXI2HM17f7spbjwQ_3_6jg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6NZEkrtOWG9hUyg18mDH253_CMkFmRm9h2a4hHS9T9g&oe=6A7C6374"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vopC-04v2CQQ7kNvwEEfRwL&_nc_oc=AdpZNxRrg0riyytkGeVqu1ZACPF6GLCUisrnXq0_iZCvgtopzCVVFdFLt9DQCOpm8k8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7CmXCr_zqDnOb9l5MpcPXehwSX1Iawe-mKMlJRxNRNg&oe=6A7C4E05"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJDPDk8ZlYsQ7kNvwFecXX-&_nc_oc=AdqHxAuqePSgjtI4xyz3bmYvRYt9J5BOhim0Iutt5yJbb6udeHm-PrMRBI9dydy2_iA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF16Cs2h-R496jskn-_jJEsSJoPfsa5oM-NyRNMVw83IQ&oe=6A7C66C7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZ20ewgMAHUQ7kNvwHRpOew&_nc_oc=AdqNsY9qHC-1brgK89lpMTL0qwb6lSXBqtf9QtP9KIxi7uP1v30yApI0LJXJw2Td7xY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLsaAfNxEA-pKR5BnXWfxQygjgasj4haRkMWvPC0fIKw&oe=6A7C747C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0q9uUDQvRc4Q7kNvwF4gxL_&_nc_oc=AdrqTA4vyIIAqa1OTXvBc6crQ7u5ZSN72___fbggIfwEvs_nRDIVtcfw5VuU7q2F3m8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8Tnt91N3dN6EQBm07VbkTcI-fbcFREaDcZX7caaRHng&oe=6A7C65AB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
XYtcQ7kNvwF7QDyN&_nc_oc=Adrlk4wvsyygYOKnKntQ5mrNBr2oIygNP4IddzCCSdlSnc4J1mRojHy9rl1B4PmarbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREpVxXjTAPb2idha-lEh3nD8sn1Ybth1uAmrpzKXmXcQ&oe=6B01C4A3"}, "display_name": "Impression VR", "keywords": [], "long_description": "With Impression VR you can effectively train your next presentation, whether it's in front of the class, colleagues or in a job interview!\n\nIn each of the 3 rooms you can set...\n- how the audience is composed\n- how long the presentation may be (with stopwatch)\n- how attentive the audience listens\n\nAfterwards you can rewatch and listen to how well you did.\n\nThe current rooms are:\n- Conference room with 3 spectators (job interview)\n- Conference room with 7 spectators (team meeting)\n- Seminar room with 20 spectators*\n\n*less on Quest 1 devices", "short_description": "With Impression VR you can effectively train your next presentation, whether it's in front of the class, colleagues or in a job interview!\n\nIn each of the 3 rooms you can set...\n- how the audience is composed\n- how long the presentation may be (with stopwatch)\n- how attentive the audience listens\n\nAfterwards you can rewatch and listen to how well you did.\n\nThe current rooms are:\n- Job Interview\n- Team meeting\n- Seminar room\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vreedback.de/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VReedback GmbH & Co. KG", "support_website_url": null, "website_url": "https://vreedback.de/impressionvr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
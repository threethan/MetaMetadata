.com&_nc_ss=7f20f&oh=00_AQEbEUOGYN7foaqEb0nNj_-cmV_VMWuUDQ8XGw-jQaVyhQ&oe=6A9177B4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjCkMdrZqy4Q7kNvwHyK1Am&_nc_oc=Adrqdsx-xBUW51oB0AiDeXAafhFKeIlb2XpKAj7Fnc4iNSvFqyKryOQyWYOTGsXsB-A&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP3lEBqrpaWRW7ZjnazSKu8e2316b2TIL2wZ4NfmrtrQ&oe=6A917B74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJCIDPsl-V8Q7kNvwGggyKe&_nc_oc=AdpWSL-gvO4Youyf4TbB0ze155QVLLXkyinzpRhC7MiEsB1tjekFNLwJARrnmCaIdK8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhkwZDvTCyS0UPA0U63_tZek-VOzH948UCErNcDabHqw&oe=6A916605"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvUt_mfJjQcQ7kNvwFFMndW&_nc_oc=AdpD76nHbuYAhdfCneumefL_K--Nt1sMPSYVFCmAi3HVqY_4Dxk9B2IHyNhqtLGC6wQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLhoSquA4cUBsvM_aBIWB8mtOdYJqErqKIDqSV_KCBqQ&oe=6A917EC7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGBL3NIOVf0Q7kNvwGNt1H7&_nc_oc=Adp1Rl0LpM4CvjUYLT6_HhCoscY-GXt8xq_Y_C8_kzz2YU95a5XChv3VLU1lWpQy9h8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNzdVUIXnTHdZuN38-_KchY3iIzKiJMWW_9ptudk7Ymw&oe=6A918C7C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fueMhnoNrwQ7kNvwE7zjLh&_nc_oc=AdrwbscVmp0OYJqGs2IW0OeCS4SCJtYn911k9GROAROzkHzTlr-MWBUsTs0c9VB1CS8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb26JRDHCEW4ny9D1o07_y_uq-gjVmWY5NqeYfCBhDaw&oe=6A917DAB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
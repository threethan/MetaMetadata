.com&_nc_ss=7f20f&oh=00_AQNTmHikvO_-wqKNxOzz-UmHLOassZml9ayU196Q042zxA&oe=6AC7BD74"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pB7igH6XX0Q7kNvwFxMuoo&_nc_oc=Adp5-ZCBBaWL0npQPiRDnfBCEohDwlsUTsIMBViKNxfZaGDv8IPQbGHx5n4UftwNuTU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs2jcrKBhM0NawXoyEnw3z2B3UGuAdiw3VRACdr62-1Q&oe=6AC7C134"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hep0YbygCsQ7kNvwGe3pus&_nc_oc=AdoV6J2SWqY4v1vSqffyvrNJQ4AMmaICZexdTxf60obeOJFUqoW-6RoxY405PHZhbgc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRweG2-eCRRhHI_MqliBl09OUUl6WA7oa1uEeJZwc3wg&oe=6AC7ABC5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3FraKYhlywQ7kNvwFxQTjd&_nc_oc=AdpoEwd0ZiVIZodNmsUxJceIcZ2Zzzh9l-0300IQ6GYq-i6BGZdtciVPSbaVz4vGMac&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv5_5TlLz-ktG8fS1j5TEm-kB6bxwb4DVEdR1rNUiMeQ&oe=6AC7C487"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ct5QriTJ9qQQ7kNvwGGOcFk&_nc_oc=AdpoWOk73_Aivtg5l17pXmceHoPrV3HhIwXF4SqM7GgEGx_tu2YMQQuZ0wfSqpbWMII&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGoyJskdCW2N33x3kaLwuh3YiVyZDCudYmNhnSxCLT2w&oe=6AC799FC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLR3Yt_eWrgQ7kNvwEQlKsE&_nc_oc=AdpkMOPV7X_rbXNfU8IrjI91RgLM0X7sWIoIe9Pu3JCy4Kaj_15_P6bhisGUtFBTMUc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTDWrvN7Z4FTbMgiwAiszKkV72dpLt4rV1PT2tI-QGSQ&oe=6AC7C36B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
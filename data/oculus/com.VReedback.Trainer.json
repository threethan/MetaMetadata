.com&_nc_ss=7f20f&oh=00_AQHRrGLOQrj4twKBchviYfMSqD9uHXDu7vMGfbKcSLf8Gw&oe=6A8AE034"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcYkILqeGacQ7kNvwERVhTW&_nc_oc=AdrblqnPbF12VnsaTDOLY12Mdnr6v3dcUqzP3nvsLGTS_9EtaSbxD8P2DWWrrJs9vdI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGo6ygTAIqTEMKmrigiQT127uLhDjcxfaQqxAf9lxEhOw&oe=6A8AE3F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaH2rKT8OfYQ7kNvwEsxJGM&_nc_oc=AdpvtoVXWSoyQlpkAKJLrnMFtxTNyWsJCfKGZuitzP80OXGE5JVXHGcI3SxZdFt0GxE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe0ylbgYH2iHLfVs1hl21sAcl3CxmMY3O8da2QeDFrJw&oe=6A8ACE85"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4Ssk3EBkJEQ7kNvwFZr9Z5&_nc_oc=AdqX9wGfmSjDiDfqB2wQOKCEs09fCtl47VEgDYFS5CH9DVplyF2c1lZlSfYGo0jQ6qg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3yMqX-0lQc7eV20BDoVRjAAnC8sLEmJ8Dw-oP9Tztkw&oe=6A8AE747"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2RkRYy72SoQ7kNvwHp4gqJ&_nc_oc=Adog1Us62BfnKJwM20h9gqMVM6Zf8-rr5l4PUIqYsZ6KG3QD_14C12NJwrpzmokq25Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJda9YPmxVC29lWsNIbDaAZ1yLUhRnzT2whoRd-s1YhA&oe=6A8AF4FC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LU7jh2OQ0LAQ7kNvwFMWRUq&_nc_oc=Adqqua2BC9GZvSokVUW6onotLNt5TdyfSmU_b8zbVeUORZcigZuo-hz0H753YV47Pqs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYP2EK20sIM4sWhZOAF3B0eqcurHOyXuF5P4oHPrr9BQ&oe=6A8AE62B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
XX_-VKJwhse8aWd97Hm2QFPoYJNfuaKAXiwyTrWiqtGBFyl318iFdKo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gQxzmMC432lBBJJ2BJYUXl_O_JjwSgABJ7NvNXyhcbw&oe=69D79D19"}, {"file_name": "ImpSH4A.png", "id": "534512418808184", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003254_534512422141517_8319121500853562997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHsnU1dHmZkQ7kNvwEy6f2F&_nc_oc=AdpOnqSmoXdmj4PuHo91qMF0VBXTzauYVLX2EygU5Sz3JO5YjQwKA-KiNrLy8ILFRhU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3R2Lt5Ili3q5dXVk8V1bExeZaYe82mrm0NPF3VIEL48w&oe=69D7B442"}, {"file_name": "ImpSH5A.png", "id": "959163268794868", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031623_959163272128201_387016303826545432_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44g-N5wm1yYQ7kNvwE_m-Al&_nc_oc=Adry9HNp0pjHvEboU--0Sf6XPViOmvrqqBEtGNoDSGHwIk4WVP2QK19cf7nGFh8toPA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NO3DS8a9Ew-t5mhnNrwrkK2aAEM65gr2KqUdg16Z5qg&oe=69D78A51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "888722919055193", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035351_888722922388526_3788059232677356028_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UU7YJr2uYYQ7kNvwEH4nkN&_nc_oc=AdoyAPR3-7KYt6KcPpt1h3f4OdlUOUStOysTwllV4l4ExNdFWL_N_NAZfXomY6NNAUI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zZRNiO8xEv2COW2YPShflqTy8Q8zOp_ydnaIJPK4bOQ&oe=69D79963"}, "display_name": "Impression VR", "keywords": [], "long_description": "With Impression VR you can effectively train your next presentation, whether it's in front of the class, colleagues or in a job interview!\n\nIn each of the 3 rooms you can set...\n- how the audience is composed\n- how long the presentation may be (with stopwatch)\n- how attentive the audience listens\n\nAfterwards you can rewatch and listen to how well you did.\n\nThe current rooms are:\n- Conference room with 3 spectators (job interview)\n- Conference room with 7 spectators (team meeting)\n- Seminar room with 20 spectators*\n\n*less on Quest 1 devices", "short_description": "With Impression VR you can effectively train your next presentation, whether it's in front of the class, colleagues or in a job interview!\n\nIn each of the 3 rooms you can set...\n- how the audience is composed\n- how long the presentation may be (with stopwatch)\n- how attentive the audience listens\n\nAfterwards you can rewatch and listen to how well you did.\n\nThe current rooms are:\n- Job Interview\n- Team meeting\n- Seminar room\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vreedback.de/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VReedback GmbH & Co. KG", "support_website_url": null, "website_url": "https://vreedback.de/impressionvr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1233860373920237"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974549_981194892863481_1773089365847593838_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnkfv8XaftYQ7kNvwEekSXh&_nc_oc=AdobGyk0p6MPwziH0sxHuME2Kn1ItxhoLjvPekUSpqZYODBguPHj6U9-bf6WOFpgnVc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0
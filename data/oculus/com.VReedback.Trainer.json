.com&_nc_ss=7f20f&oh=00_Af5648lSsLhCzDEeYUiJrouXa5v_gDIRR4Flt1jRcluPFg&oe=6A1B08F4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZsBI9pQeh0Q7kNvwE2ApBe&_nc_oc=Adr0yR1f6d2dixK-xiipbD657AnrHDH4YOc7RRC_YYcVqWCQ4_Pm0aW1dhZLgE6PY8k&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fqoxKBMk8IzpzZi31qatolbPuiZJFC8hzY2SSl2JHNw&oe=6A1AD474"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMR4S9lt9ZEQ7kNvwF_wb8m&_nc_oc=Adoc_r7x-ge-qo3OHcAv67kCAzXvcgjiq8h0VcmDCdHlKfvgd71uMLb_fr5-T_r1kJ0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VOTApmPdnunfVxVCDjWUu0GLVKhI5BdKxu9nTdSVh2g&oe=6A1AF745"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GM9aHGLuPo0Q7kNvwEjYUR8&_nc_oc=Adqrn0sP3TbVrtrH5hTPtP8ZGMaihxAxgvZFpsadbjSw4z9JPv3piFJNPEWWo2Bjieo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZeSB-OvX9FD_URT4oBQMJw9g4U0nEzPtTS2AZGC6wLQ&oe=6A1AD7C7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhezIPRgEQwQ7kNvwEVHIvV&_nc_oc=AdraBc1juNy97d_hebCWjlQ7s_KOH0hQXEqGJnqZHXlhDACCyJnO3edx6FoW5vA83u0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uJc7byKL23JiiLjgtKr8DOmohNUKqWdhs6guDSc6M1A&oe=6A1AE57C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tpftt-r9WF0Q7kNvwGYw9cg&_nc_oc=AdpFcnpbHpzNcYFJJwDyDX56g68xKeu_c8nLarUUX6oQ6Au9kcBvaP9WZ0rgBJjDZu8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68gExa5-DyaWuOFTlvQvNIETEkZbAOiDjDYp3RRuwaEg&oe=6A1AD6AB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
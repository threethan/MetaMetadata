.com&_nc_ss=7f20f&oh=00_Af5xePy7CAclvkOvbPuHzS_4TlO0wpvq09WXJty6bKIs1g&oe=69FE07F4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rv1nxgLXs38Q7kNvwEqbFiO&_nc_oc=AdrorvRSU8A4KR2HS_QDu-3WMYrLgXJ61rcGredhmjvTgZIGqaQWsmnAfejYfQ2rTg8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ws8TGSeihfSoETmmNTTiAzSJT1z0juPWb5zdc5LIW5g&oe=69FDD374"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opMWheo_POIQ7kNvwGmJQuN&_nc_oc=Ado2XGGHDLT6UxQRV6Z9IsiYZic1HS-8nwIx3xAmyUUtKgUPyf8OPLuaZwxcZ3uBRK4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zxEQ7EKsX8j6UjF7LUyVAgqjYTzEw20MC80_q2EtLHg&oe=69FDF645"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jZJqfS586EQ7kNvwFTGhp3&_nc_oc=AdoMmTtcOpWnOByIKjZrhy13QeYY5_BtTGpEfTSRDo0qKUjWobwn5WQORrGx3h3iDFc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xwqiXbZWXcNF3FFoNCw48ZlzEcsRVntUumf2PyGHuIQ&oe=69FDD6C7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeRmUYczkwIQ7kNvwGDINK3&_nc_oc=Adrfo5VQW5umP-lvK9G18AjM6X2JmNJ7c1VSOlPS9wUcFUDnnqyXWMXRmveEEtMeW-c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48_y6MPuON5myN4pQckAAa9mXBwkfF5gu3fWACBSIj4A&oe=69FDE47C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VG8_TY_qUoQ7kNvwH2MYHe&_nc_oc=AdrwEiVsoXhGgCQU6vcRTElB5a_Gxt-2viPwBXu3-1Uk9B1D_jJEYJl49-Bp53fZF74&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NwuSdJwhcQ9vEbuRimNsMpLB3-VblC1UAcqXtUCsUKw&oe=69FDD5AB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
ng", "id": "217316117620606", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375759_217316120953939_45630775306426973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSEBkf1ST6AQ7kNvwHo0SpK&_nc_oc=Adn90Gv11T10WxxGjwnpmaAf-ix5F46i7INCN2rqLKwUf4LhnzDzIjUwMltjETctRtU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftqTtJIZNI1r737IcdGikM1C6c0MQQMDhT7jrDowIFaGA&oe=6999A699"}, {"file_name": "ImpSH4A.png", "id": "534512418808184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003254_534512422141517_8319121500853562997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OXuwz8vuIAQ7kNvwHfdXfG&_nc_oc=AdlBhN1k5IHKqYHDp6ESVuEyk-UIYN7VyeG_F226Wo2hrRxM7SOWpQt5CJY9NGRDJtE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsuH7TYTPZjMmvghYak-JRDtmhCC6FrUfzs1jkgPopWoQ&oe=6999BDC2"}, {"file_name": "ImpSH5A.png", "id": "959163268794868", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031623_959163272128201_387016303826545432_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d943A4ZhVgsQ7kNvwGY0al6&_nc_oc=Adn5CpPU3gDZypK138JbzC9IODEkS-MrkfoxcPFPIDj5_d9aEF4flyytRk8okQVfPog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu8a29MbTyOVcab2cyOJmqFkhdy_CC-wIp15CogbX1mKw&oe=699993D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "888722919055193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035351_888722922388526_3788059232677356028_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0S1X4oA32QQ7kNvwEI_qTN&_nc_oc=Adlz96zOdkcoa-2Xcf6-2OSQeupIWyIlPM98-5KZVk9vxdo2qrAYwNMZ5tPbyos7a_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv2TpfQtSI71GIDTNXPW5YYTcnGJWgxiC0Bagi2nFmRAg&oe=6999A2E3"}, "display_name": "Impression VR", "keywords": [], "long_description": "With Impression VR you can effectively train your next presentation, whether it's in front of the class, colleagues or in a job interview!\n\nIn each of the 3 rooms you can set...\n- how the audience is composed\n-
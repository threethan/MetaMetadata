.com&_nc_ss=7a30f&oh=00_Af246gmp2yAQJwomPJYLDlzqVdmHclYIoIlZEoPY10I8IQ&oe=69E22034"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHnSYqMdEKQQ7kNvwEnVyp8&_nc_oc=Adod82OSYWPUzCXHHfcMlFrVoVd5biLFbZhQRiDLhP-P_TgSFc5gcA-IRnfMVy0cw3s&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_N6YZSsL2uE6aCdefYzilO0NaE5JpF5B4tJBQjxZo6Q&oe=69E223F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0e2EMT-ai_IQ7kNvwHKd8OA&_nc_oc=AdosyYQrVPafqPHLrANVhGXy1wFZ6giF1YNSHMCz2r2OFCtpFAoOBPXOPK_QWbLaVo4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RUCRiMR_UmaXv3h3mo05ttj-daanL8sbDPjpkXJwI8Q&oe=69E246C5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1vEs5P-5W8Q7kNvwG0JRS9&_nc_oc=Adooa40_rPrueiCL_ZBtXO6LggwSccqALLzBsjCpF66cGVay895xD6Gs2VecXomAnXo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22-HIGTywMxjjIJCRQxS2wi8gZCECgfR3brV7aTzpGsQ&oe=69E22747"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLibAmVRoJEQ7kNvwG2ubwi&_nc_oc=AdrLAdCRnUIoDAUtAL9aLrrOeOfYU3rvAeXc1U7x_Vs2wVbVy-nSUIPtipbwtcee3Oc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WM25QJbOvS2UN5MB1uQ0LCuZcSLK8Vgtn2q_1b4r2tg&oe=69E234FC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIfSJVojl-AQ7kNvwELoMlP&_nc_oc=AdrfI3NFoTjNKEkctqEAOSv9jTrlVpdoAg-q8Or5nHtQOHLgAPhGxvd02PnlLU7GPy4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03tiQTCXaIqJut1Ro2Ws9ljMrJgb7fQWH-cq7j_z3VTQ&oe=69E2262B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
.com&_nc_ss=7f20f&oh=00_AQAJWzdfQLSGjmQku679btbzn4hTelg3g2INF5m5gDp9vg&oe=6A5CBBB4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqahGyJnyz4Q7kNvwEcaNUQ&_nc_oc=AdpfFGuEp3OFzIOoy2rlEhhPQLPBzDSsakWFZd3xGCMTRPPraidFew1HwgdRg_8Lzeg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEZ3WwICL0_h-p1bG_pWYS4EMaOarpK7ouMs0UgZXIxQ&oe=6A5CBF74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjYKWugA4Z4Q7kNvwEGnj2K&_nc_oc=AdpOveNIGwB3JclpcUmdyxShr9rTO0nw-gJLWZeNy33i1FQL-_TmbfdTZ_6Ym89MTFc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0EgOK_EyHgiW4Wu_kyCgKyJKGDtk94TRmPmg9pDIDzw&oe=6A5CE245"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48OxDJ8Kg80Q7kNvwHnUAde&_nc_oc=AdrxTXCfXlA_WYfJoB5y9VCx9Yr9nM9aK4spOGwH98VNeMzyWP9zeEbcHpcQBH9yfDA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCt52lOYXUHMFvzULwByRqdbUx0tjf0Jwg9xNvgBdOmOw&oe=6A5CC2C7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugnzxLwXdw0Q7kNvwEh5MEe&_nc_oc=AdptaDjBbH62BUdbQKL2bcIX0Ur664S418LxOZYMRL7rR9gyRMV8Yg4rB9HUZwktH54&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmn5gzVFZ8ddq8VGSswPmwk9tul_77kZdsTDQ9YfucmQ&oe=6A5CD07C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLt3kXA7s0cQ7kNvwGKUUT7&_nc_oc=Adpm8yksZ7mtRMTm4l5igKbTsfztitZfJbdOM1q1zO5krAid0QkYo7eHW41sNg2AlAk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFMEeSCElpOItipGBXBUoBkppsN3xd5LIama4PMCYL8g&oe=6A5CC1AB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
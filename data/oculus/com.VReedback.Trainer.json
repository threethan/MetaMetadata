.com&_nc_ss=7f20f&oh=00_AQD572ZT5zU4sNBO-2G2ic5engvUiw7xY-JzQ_Kgg9Yl_w&oe=6A4E3B34"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPhK0yqAD6QQ7kNvwG8JiWd&_nc_oc=AdqjGfSe_b3eDd0d8CaI6-wBR-BLqiadeoIR3M2awrxe5c4X-akIyyVZ-QtoFovhc0Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpLlERkgVKEg5qEcqIDXIfFcRajZD2U2zjPSLzR9l7Zg&oe=6A4E3EF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfUjbbcAk9QQ7kNvwHkBPB1&_nc_oc=AdqygeauAS1dBLN1pO_0ocR8YRK0evFezmfvQJ-q00TR7gKkatKaj51AhGUFFHgOYs4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAulkH-etSEN6TcHI4v8-DjwXbQXmzYoNsB0AT-RDzESA&oe=6A4E61C5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-J1_3wCTVQQ7kNvwHGX1vK&_nc_oc=AdpTTFQZVTbdivu_M7_Y2kqawI6KkWkm0SnWG2U_p3q_w5RF0Od9vSdHGWImXNcBFIg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALXm69EdV-Fjvme6A-M3rYr9azGkNv_c9S5Yohyb3B4Q&oe=6A4E4247"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NDczExMOQIQ7kNvwEiCXy-&_nc_oc=AdpMrABnb8pBVP2J2Xw0qoIulkY1mBEh3O-NxnbAeXuBp3bv_qIfWQoYD8wtLxhN1m8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF0cWAZ2-zZLBownFXabVMNSoRcSeeCMftXaRmJL6vzQ&oe=6A4E4FFC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GiF6IzDqKC4Q7kNvwEN1gvs&_nc_oc=AdqOQiQAE3h883uWr3mWlm0GFqS0QwdP9pTHuJ9eLNdx7oezgRUeDvEtLnXLipHlfeI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIhMQBp9IEensdXpwSXr1HoKdcX0CnAoWo5zNXsuskWA&oe=6A4E412B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
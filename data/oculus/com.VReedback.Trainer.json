5ZQG2CVic&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFq6IcvM7dA9HA9qnXbb-f6NPE9njo4gpmVaU9dsleCVg&oe=6A8ED4B4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoBST0gStIUQ7kNvwHnhWjS&_nc_oc=AdpJyQWfxZtxYMsUtAnSCQ2phY5s-m4-_hxqdzpgp8SASAthGVEKYGL_9mh8PtexzPs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDdJOYav39_z78LogK1RsyJeSGfSkDCAYUe21rII3mMw&oe=6A8ED874"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJCIDPsl-V8Q7kNvwHpai6L&_nc_oc=AdqMv3aRafqgJmizGHO57raDturel-qvG4WCzQrlURF7SIxcNexXetpUv7XjvKZiLrg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnDlIqFKUxM9GSiPukSfOBwiZ-RfzLnV4AkKpfh2lMsQ&oe=6A8EC305"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvUt_mfJjQcQ7kNvwEyL3jI&_nc_oc=AdpGRbDeJ82Ocl2FKaxKpR8uyYXhk0yJPXZ6_7KcifYQlgXOZ1FUfgnCEez1kqmqw4w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYfREiXrtgClZ9PyjzoDWB2yqiW9w8KPZlm1RmSy6aGw&oe=6A8EDBC7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0X-Lheb5-W4Q7kNvwGi07W9&_nc_oc=AdqamOaeBXsXO1rs63CCf2NNfKlmtxezVjbGPOivwvKpYN2stsiK57cHADLByRdHv8A&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNpJUDNbdRna3OV9zVw0GrB5-GX2BYrbKobZPQbHJqMA&oe=6A8EE97C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yfQI9LN_wUQ7kNvwGMSwCN&_nc_oc=AdojaOMPWGn6dAFJ0mea8N6qyV6CRBPDaIoWePaeF0n5YywVmmLCbKNEK69eEIgRUSE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-UFQiVnrGtVCmVJQ_fc5De8tHvpFrU360K7QxHIFPpQ&oe=6A8EDAAB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38
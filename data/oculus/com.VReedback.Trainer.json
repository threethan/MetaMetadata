.com&_nc_ss=7f20f&oh=00_Af6bkCKEONOv8gP5MSVhjvarEcCZhYAHReJc6McUXSHgPA&oe=6A15C2F4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Te74ZimXsEQ7kNvwHsD3aO&_nc_oc=Adqhx3--unrTEG1WTQiXL7817_mhAdd851tRCZc0BGWrhco3oaCQBTMQ8IUGz5-mNAQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7n4a0_XEkv3forCCnZFQeTLh4DecfMdLg3idTO922X8A&oe=6A15C6B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbi4nvzYWIsQ7kNvwHQcwfb&_nc_oc=AdogCUKPAdLfVv3lCLpSlrU5YK0J0cVN7WsAZHdgMegmn7POAaxT97rb5t4e95ROWo8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b94hB8t5QGsQOTvQ2aGLKsIS1quytj0n2_RKYCbNG5g&oe=6A15B145"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VixjJxaqb_QQ7kNvwHowIuo&_nc_oc=AdqSyGtZRVjP9lZaa6tRdBWB2yd9WEAFTxnYtSddXKD3kDfJBws7v08x3mgonJaLVGo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CWpSxpqFXt1OIzRptk_-C2wLJqNsH8vVpL4oGo6QzqQ&oe=6A1591C7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5_AvJ5aNsAQ7kNvwFUqB4w&_nc_oc=AdpqLBo-CCutflqdv7UL6DCPg2ISnCMF0phWFrRp8wlYvORHjYZazhgk5rpT-0NOhJ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_lIKqQC7TYOoWcXn-4Pyc0tTxNBnD8UyDJLwZkVvT5A&oe=6A159F7C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmshizxuAxMQ7kNvwEBnq3r&_nc_oc=AdpSteSr-uCswC-6Qunt0edpn6J-hvAlUvRKcjHC10mvSXBH6LWB61h4ebUXUhlYHwg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PtFwdxiaq7tw0NjseasVKk9X3FA2N3yRsmNiZm4dzTg&oe=6A1590AB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
.com&_nc_ss=7f20f&oh=00_AQEFs6WrTXNS6Qk_LOyNUZygIUGHaDll4yBp1-HE5Z2p7Q&oe=6A71D3B4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9VXMY_py2sQ7kNvwFwamTV&_nc_oc=AdoIgHuHsQ-2QvXbY4x60p6r9ve77rdCGLzdX02Ox9w5uwIsUQLKuu1aerbcBvsRd0I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWRpyEeTo_i5Udb65BU4Lcu-oNOC0X9BzJHyDF3Z42vw&oe=6A71D774"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVvN--JHzFAQ7kNvwG8JA8h&_nc_oc=AdoI6OCCD_bhOfffERLyBXahRmZD8poaPMQ4dV9ACcCTDntw81l4-WIyKcR3hOYYjAw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyIR_yB9O8LxP0T1w5Z4qJsSFsJgIWt5P6EnCJFhi-Fw&oe=6A71FA45"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1OOtYhYI6IQ7kNvwFVEOyQ&_nc_oc=AdoL7bs3bU6wu6LvrO7z1MUZ2QfRDE4hBabCNY4UOvrfBVrPknonfJOtJFcFJ9lMOjI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZK8NIvRacMYsi_9ReWTy7PISaDQ_AGAJMuqDgxGpFwQ&oe=6A71DAC7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGeTNlSwjOQQ7kNvwEizdg8&_nc_oc=Adrq-EeOF6EqsEaEP2ZpYC6PhXmXP9RnJ61uXJOpxyfVvaHnMr83-odLp4-h85YtAos&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUc083ba15Pd_ldnYzh_I2jI4xW1X3XVWHtbQzYuk8jA&oe=6A71E87C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTNBXcIknYcQ7kNvwEwFGRo&_nc_oc=AdrGquGCxn0gX9KtpgRF6OaDCNtnQQeQdqkaTFNV5aANILNk8e7aGRqZicPzNn-nPe4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfpmoMJiHJWeE9pCrZz05N-36DGD2gqQXve6IuTT_xuA&oe=6A71D9AB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
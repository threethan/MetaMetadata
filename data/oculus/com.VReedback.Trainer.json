.com&_nc_ss=7f20f&oh=00_AQFZhH1GD_ZNHBpGAdUaw7AI7cixoYTiQWOhs3JqXVoXbg&oe=6A7476B4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5b0sJ9flicQ7kNvwH7xuNa&_nc_oc=AdpG5Kjs5J3i6NPPyBhAOmsaDMzdfSheIQP3Z9HtnZ-tKj_l7KuA6QPOi0-y4dNyz2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-9jvD6YPDaASh6U3VAiEKXXwOR-3QTGEkcTid1afSlA&oe=6A747A74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nI_zuMZl7T8Q7kNvwEa0HlA&_nc_oc=AdoPj6oQeyYS1_BCd8Dy1Z-lduQLsLn5JlqXVfdIbl2qmafyQkbs57ZcHzW0fHFmb9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnU4C1_GIE2ytfH9fWyUpBlLOc8lKRvdAkIh-pilUavg&oe=6A749D45"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuiO0KIg1DsQ7kNvwHTCqaL&_nc_oc=AdplmEvkWpzu_IsCjurD11_IPlNwd_snWIkArPgvjhv375G_zG5S4YiooAgendquQko&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEx2BvJVQj2CAl726ye7q5fkID7HRvuXP_qv0mfmwcOLQ&oe=6A747DC7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGeTNlSwjOQQ7kNvwE6O4eW&_nc_oc=AdqkpZ2aDq-iRs_ZWQpsarulpHK5qoFNWUiwkzVeVLvQyLmKZBxuvpJg6pAQ6mVhDYE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGSJXd-VkfwDCu-2HpmZ4MSFx4xxNBnEeOixbjAD0kkA&oe=6A748B7C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJi4Q-qidJ0Q7kNvwHbhsnF&_nc_oc=Adom17oP5eLv22rvPu0Psh6h3W1fol1w4m041PRZjVYR7_JHclisSYRChOSwT2_BhN8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQb5q3oSRcjJ4KP45ZOZknVjqbVsvAlR0wJACuOGKWuw&oe=6A747CAB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
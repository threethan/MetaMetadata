.com&_nc_ss=7f20f&oh=00_AQJKV0R5AQv6PdlUsziLC0V5LTSy9GTcF9cukVHybQ34rA&oe=6A9C3BF4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fP_LmfvS3AQ7kNvwHaK9CB&_nc_oc=Ado9EUMELSEGqoEpFDZJlAYUTJdQIfWzIp-t9tpB20xHnJVNctjPIe2sDN9Cvx_AMrY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxKPIsP3YSbrVSgPH35ZZq_rqYyIEjJtpZwVEjoUgUGw&oe=6A9C3FB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMIHaHp3DH8Q7kNvwH6cAhd&_nc_oc=Adru1U5-UsTXygxW05JMwO0aGYQV5EKuM1JlIxNrpLLXVlVkFaBhda3xfmgEk91in7Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiNAxcT7Ev4KTNcEu5WTtYVdR9YJ2G0nPlV1_wzT13og&oe=6A9C2A45"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9s3OmoR8_oQ7kNvwGv1v17&_nc_oc=AdrPsSaYrLBE0aIl3zoY1Qoi_2RI5nN-pQQCwgSZ5NJTwwJY-sgKE0obciKkJmhHgk4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuvL0djKXthfGi4xuN_oJocsu1_7xd-QG1pFpNbUoxkw&oe=6A9C0AC7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7WCaHbpnsYQ7kNvwGbPLQZ&_nc_oc=AdqBEhEoSVjg6HkbOP6B5LhoQ-ngSGsepUzdnC7EBORBXhW2X8NRmRDPVuX4tK24A6s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICVaIW5NtOY0VjFYAqe_6oIP9CxWtC_-xu-NbL6AppiA&oe=6A9C187C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3kac8J1vBcQ7kNvwHWG3fV&_nc_oc=AdrH7TSdmhQzxHvi19IwldTPBMO3ya5XLwwqhdXru2HgoTmcb5t2rSe3V3-lVqk2oww&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJO78va2JAdhhOY2oZHnrLL0KOnuBzV4ccLlVwOQvS6_g&oe=6A9C41EB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
.com&_nc_ss=7f20f&oh=00_Af_0fN7oFwqyzBVJ_ybC1wNfhuSE5HyeLB9ukNZRnN0F7g&oe=6A414474"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr2rpSg8XUAQ7kNvwHNzb1O&_nc_oc=AdqJhVJpu7MipINmYEasGx7m223H7DgtYnb7cJ59y2OdGHw4q4vB0f6Vq7tmd3fRLcc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JEHXeTow5HSXNySWDwD9DrALex7L_DMdKvReIQ5-xYA&oe=6A410FF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0lti1T4nysQ7kNvwG-Lg3C&_nc_oc=Adrv0oSljOFC6CO2dohsjl8_KvEexxmZKG8wMZglMKPU1TUyCHy906m1P3wfksi5LzI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yZLy6lOsl29Z1IxN9wMw4zNqxZqUiEmyc2dvlS7QtAQ&oe=6A4132C5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5WvTHrxsr8Q7kNvwFgXIDL&_nc_oc=Adpcp7m02u9b6x14YeBGQQcJBBqOG5e7cbIHpzxH-ofiJ8CxPLabjJBXsVR1WUj1Kh4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I3U-SmAuf5sYwXSTcUDy7lkLTKFkW1Zr5QsAyJ_oirg&oe=6A411347"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z28VYp4dChsQ7kNvwGE7XYz&_nc_oc=Ado9flWV9s9V2tLP1LZfQKbviQdDiXYSAvwp7jKVmjEonG8b3rnbkvMbvJ-LIRGb3Gs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DgpkgXO-oDibkx9klA0LJ_X1YF8Ac6ZT730coc4IrnQ&oe=6A4120FC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8HuFMngx1AQ7kNvwEfH1di&_nc_oc=AdqukAgqyCXvk6eOg6mktYmCFqk7x0u4eJB05rxdflS5metEwqJs0wKhxd7Sg6Gos3M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--OWwLvy_xIY9mEkU7evJicYJQTb-UZcFlc17wwv4gQw&oe=6A41122B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
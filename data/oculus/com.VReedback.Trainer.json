.com&_nc_ss=7f20f&oh=00_Af4DC8xVwZm2bm5cKw_UarviqWADizx_EL7PaEWu6AoKtw&oe=6A09AD34"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQiOnhCJU8kQ7kNvwHZevLs&_nc_oc=AdrJv-Nmh1Aker15tpeq1LKjVHdKzNeyfwyWaOhCja_HKqLurP6L4GfvXG5xOm4-HIU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44xuNJ9N4J5sh0CCetTqFT1ZT6H8YoRz_ZbvPFqFZ3aw&oe=6A09B0F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfRH8GCXO4YQ7kNvwFTBTu5&_nc_oc=AdqEVxD0s8pmf8e1BMwZO7CbgzvBf7acW1NuoqPhPwRbZMRX5gOSJrISfkAsisskZYk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LAJaj9AAHQ_U-sZOJnUBMngkg89MB-nO9Ck3MMwaeoQ&oe=6A09D3C5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2f7YAvtL3ZEQ7kNvwH0kU4R&_nc_oc=AdpvaowVHmcDBlQM1zg1p4cr0A0NdjmvUVc6zkWxb_OSFqMq2POa8Wm3yj1TxQWw38Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qTaRar4F-6hd9W6UakcHoLSjt2jNRc6oBIQ0zBm5ciQ&oe=6A09B447"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87XI9g8Md64Q7kNvwF5YcWw&_nc_oc=AdqKu7yZ28rAaO7x5MyrrblLMA2o1pPSlKn0FClKIrdV4WxQEej8m9Lhig6vISKJRi0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dT_dEPp5WilUkWSLbQNzfH__Pd9VJLR7XTtRuN3ghEA&oe=6A09C1FC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inuOzj9w0D0Q7kNvwGsXr2u&_nc_oc=AdrHj1THC_sXiD2aep6IKg-YyWHcqnc3YZF9quMpv-IDDFcA6m-KuRFMrlzi1fFGItk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ElvoD1tU3YrPiJ-FWcKdztVI_llGSgyOJTKJ3th3mhg&oe=6A09B32B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
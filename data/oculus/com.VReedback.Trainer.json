.com&_nc_ss=7f20f&oh=00_AQGzGUw0B_m-YLHGc1e1CUV_aoOPqR3Cn-omBMgom9Mejg&oe=6A941AB4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLVROyaegs8Q7kNvwEKgtqA&_nc_oc=Adpte9w1XtRD7uSeV3CDij7M0YBG5Cegkijn770ofZY5yrrbDvMrZraNtgFDlTqaZo4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbw0IuK1s0pk2byZWzf5Dln56zAiAZ-s-FhCx_wWr45w&oe=6A941E74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqFrXxMjTb0Q7kNvwEQ8GOw&_nc_oc=AdrpFbXRsyOAoFnkq9m-hSIxUy16KOhvx4YDZT9mtotzujQ8iRpFxhB68EFSewGAdnI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr1WxR6IJKy-Iet7bIzhTTzBH3KAHGhaDYg_AtlH3w0g&oe=6A940905"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4oeVsBFhZMQ7kNvwE3KUgH&_nc_oc=Adpm-d2d0Yf6jPCv9M7UncWU76BqH64rdvfB3gqoa3_jnMvO6cOwZ6T2DPBC6RfU7f8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVyBc_3WiradGSeZRjGD_FhS8K9-bmT3y0wZ-KxL1T-g&oe=6A9421C7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGBL3NIOVf0Q7kNvwHybIK0&_nc_oc=AdqPVL2u5bcomZiLWFRF71wK6Z5Q8SBoY56kO98FTfdgX3zJqStfBKOLmsgCdym5llg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQp0Kng5rXvNiLRwvrneHKVyS4ZWfsEH_KU5dFCDn9Sg&oe=6A942F7C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEMi3hwRghMQ7kNvwEBuXoG&_nc_oc=Adpvl_2C5tkGR8MkTf00wOMIUoqyFVgM3aZC_CJ_YpXqX0Lb4xfyVNlSLRwgrcFKtXk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjG9x0Yorkxf4EtuxxASiUZYq24pcrfV8wuxC57f_k3g&oe=6A9420AB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
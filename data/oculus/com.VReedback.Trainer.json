.com&_nc_ss=7f20f&oh=00_AQLmdAe7dlXpc29JlUndqaYTnNT024SRneSZib-LQ4Op3A&oe=6AA03074"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwLy5sVwOEMQ7kNvwHowg1k&_nc_oc=AdrnpoDXQRxl18W91taKjkaDpE4X_K7lZiihSXzZY9QsgDtWGCtubINrMAMDQpiTpUM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKo5BzKyVagJmEqahY60Kj2ImKa252FbjJPdjapzd9Rig&oe=6A9FFBF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey0pcSQlHfcQ7kNvwFSB0YK&_nc_oc=Adq69eCcFxp56pTvPBRjaHSJMdprs3ilWn734Ey5Bhxci52P5GZQTLLUi4Ghq3Ha4-k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE8vx0TV0YZvDLddauqnIPLu4xHhfyCVc6ZRAihWXu8w&oe=6AA01EC5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJX4mMiwrqEQ7kNvwE84v7i&_nc_oc=AdrFd6PfraLBPqKbewrjIFX5mXZ2UioH1KDsuJT-XEoToc0mDTcaTnK4hl0NfPlrfYU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY8TCTWaeuZWrKw8DH9Ydv9qTLiSlZJS4QzS5sTDXG2Q&oe=6A9FFF47"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzGEbMj80_4Q7kNvwE06aYg&_nc_oc=Adrh-YtWk-RyNqT0ly0YvMO-QPBDL1vWIldb5m4uXaIVGxPjDu-Td_UWi6pq9RCnYwU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcVAo3eNsRX__BcYne__ls1NmRzZMOuQzNeWqI4MZumg&oe=6AA00CFC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSkkOnAhXzsQ7kNvwHJBkz2&_nc_oc=Adp18TSUp7LWmFjDUNdFmjzeF67AqCjxeRLNekWRLCUZlyvaEDZwbYigUfTspnZ8iMs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD9EvN56c3mdZs6p1QJhVaKceFGoBcPbgXw0auS1eDRA&oe=6A9FFE2B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
.com&_nc_ss=7a30f&oh=00_Af1xOSVUphB9zJ40SPJY8gq0B3IZ1uEDKUdsMObr1_SMrA&oe=69DB88B4"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAOx_dAzRy8Q7kNvwENbxmH&_nc_oc=AdrwATxzZQJ3ZWwGRfSqDaLLJWOyPSxU2libSceNwjed7-AdxL4fWFlHQNlMjt66Y18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0t-dIfV_Jfj1dQAV6rtAXsZm2MK-X4soqMCcjoDlyp8Q&oe=69DB8C74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtZjNBX5ZnsQ7kNvwH-UlZZ&_nc_oc=AdpJUTjvS_X7uC3prO47u8NUUAEw9IKX7XCS70i6zKZUE1E1zBFNs9lUO_OZiYUK2kk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Muq65HGVElmeCOW6L6TYfPmpWq0AOORXfw-ZMPvcYUg&oe=69DBAF45"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH8FjdakyZUQ7kNvwHLecwG&_nc_oc=Adr8O-MzLgSN28e63jzMHxVv4HqbtFUCJATYXWjeVY-P5ZO0wF8UpiPmBCX6ABFxFTc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZeGKl9C6Aj3iWbOyKlfmCv4dgDvkb-twqCqYwQsC3rA&oe=69DB8FC7"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRGeDxuoah8Q7kNvwH_q6f_&_nc_oc=Ado2oaeORO9S9M9rYSpC3vgOnR0VtK9geOS4d1rkG-_pW566R2Wzs5ZREfxs_bi8Vu8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tuMhaxTlDcHKUPIFXlDTVDM9QquPiLj2nLTT0GGskxg&oe=69DB9D7C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vA9UVcWdMYYQ7kNvwG2dyjQ&_nc_oc=AdpIIprXM8jpw2P_5AHxYE2cQxlo2c6zfRvqWXelDjdfliSOfQSQTod4JrVwCWjnVrI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aUErT9q--CljSHVCASu5Eg8cRMgKius_wZ0yYDWpCXw&oe=69DB8EAB"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
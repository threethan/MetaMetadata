.com&_nc_ss=7f20f&oh=00_Af0CKjQVS5geQiLVxBzh_O5dKd6ly1KqHJCLGeRcgIq9Vg&oe=69F49534"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5iB_OL7d9m4Q7kNvwEOAb9Z&_nc_oc=AdoMzexdimWTdssuGbFxgZ28r2IJ8AZ17mQDYb1X9dFV2vkTXRBV6g3lLO_vX0gFB-g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KDwOOJB9qAN37xIT_EDKaiEYR7WvHE3sCADe0IXeqBA&oe=69F498F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l809vGquDTkQ7kNvwExiX_Q&_nc_oc=AdoA3ZETKrpcXoBMbFwcXBl8zwLW2Cdd4eTBdZMChJ_J99IKrDxaSgJm9ToyVzjH5vw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1forxzx4cY1_0l2RIEoEyLyAWDIp--2h5gh0gDimzggA&oe=69F4BBC5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWu3RzHuq8MQ7kNvwFy_o0k&_nc_oc=AdonAijmVtKd5pp0QMsQLmNHG-tHYgCMgOpUut8TmVvQAGiQhcqN5xUcz9-gYTJvDfE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CajmUY9GUCwpeHLklb3zn1L59FGvHQnXqIRMjOBkyPA&oe=69F49C47"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0ZaLnH50J4Q7kNvwH7_Hf3&_nc_oc=Adp__K1JPSTRRab81Uy-PBWYLkxUh8uL86maOIvb2nUe1_ya3pInxLGAQpiBUZCaFwg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2B0dfxvLo209rRe-MQcxpCXpZsMgwVzeNfB9tHkq3aMg&oe=69F4A9FC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArS4byLzkA0Q7kNvwGUL_uQ&_nc_oc=AdqrM_eosANSopw6faBV3jjZMsyDeCedHkpcHUqzJT6aIKVcii3bCZGPlW-4meFzG1k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0t2D_RCAp9sNLzHAMFddPyvUA4TnAoRjqVLwbIJrt-hA&oe=69F49B2B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
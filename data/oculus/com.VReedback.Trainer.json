.com&_nc_ss=7f20f&oh=00_AQCUq4_OscDRjogHSsRbg3JChm97QkxV-8J0I--tTNxsGQ&oe=6A65F634"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82zZyxFvz2AQ7kNvwG1NsKK&_nc_oc=AdqVlD2uzEYFjenrn_UhNCYmkyRK2-jJdprSkaTDowM5oY16JLx3GDjnZVcg79NN36E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuXDxfnl2U8TKeq1Ysg2hkXxmZXpYwSkrqRU-B8GTSVg&oe=6A65F9F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLc3mTt8vHoQ7kNvwG-Wcxh&_nc_oc=Adoljn4ALSGFxHQ9roXyjZyizhcIAEZdJ31gHpkekX2vBpgi6RhD3N7MeYeP_HgNxP0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQvqY30HOHyQPrGs4sUWjpriMP0RB9GgyhjA74FBk8Kw&oe=6A661CC5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H69EeqHsbZYQ7kNvwEF8lRi&_nc_oc=AdoIxG8EtHCzjaIP8xYLwVwHeUEn39qvW8Cx2E7rBrHdUFdZawtKMc9QXsoPIshI0JQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzp5m2VGUusquDxXcZ091EKRIvkYs5R2cGXssJ6sB-jw&oe=6A65FD47"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAsKqNn6540Q7kNvwFBWzVp&_nc_oc=AdqI8s6D-40xcwWJNIHMjvzOeHmRi2y-xlTbWZE2dkTVHqgsoc_EcT0-IPIHSqmTPek&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMQVF2MBdXzvdR4Wgo4KntsaRV8o4EM3lXiDh4WWv1yQ&oe=6A660AFC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxsjPkcxqmoQ7kNvwFF43hO&_nc_oc=AdrbcPGgOZytkuOc8NxDMB73PdqUfpSlNzTnL7AnI7qeXYrF7Sq13aqFBrESJeVoZRA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4weatNg9La8SesbuOCNCr6mk2T-S7P-dT-zhCzFablA&oe=6A65FC2B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
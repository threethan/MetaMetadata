ng", "id": "217316117620606", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375759_217316120953939_45630775306426973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkP846dhxk0Q7kNvwHgykdc&_nc_oc=AdlryTP46QsWWdD-bwSyuP93qoYRvfXVOPJBh4rWlmF4KpW1LGHEOAw_S2MR03XqnjE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfudiCJlomPSRbZx_HcxnvxRmhJfPYJaWXlKpLa-AgAbKg&oe=69A03E19"}, {"file_name": "ImpSH4A.png", "id": "534512418808184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003254_534512422141517_8319121500853562997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7PxkysEjwIQ7kNvwEnW_PX&_nc_oc=AdmiXf7kOgaCPDdIwqaXfh5ngNF9Kvb0rbY93BBRu40rdQJyyFqWlokevcXqkd53GC4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsivwfTYUWXzq0too2EjdYFvXGA8wlPCy6me0z7X1Eu2A&oe=69A05542"}, {"file_name": "ImpSH5A.png", "id": "959163268794868", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031623_959163272128201_387016303826545432_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGS8Fm3Dyv8Q7kNvwHGe1H5&_nc_oc=AdnpsDKT1e1lRvp3tGbahtJ45FPxCKbbQZw15UPwQqcEU4uHmRnJa7n2xdiHGIyGDZ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfukuleZnAkfwon_0zJmX659_QKiFVTQxRos5i98kBWVsA&oe=69A02B51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "888722919055193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035351_888722922388526_3788059232677356028_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoKSBgHrCI0Q7kNvwE4AoFC&_nc_oc=AdlZ3X9tkUKuHhG07q_nC3KI0iBWyz8V1OlENHXCoqrNT_6y7miGuEBug9qF_VqJPdM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afud3xgDLw0Bukn5X7Cohfp_sCdCSfB0XsoAss23WsrTnw&oe=69A03A63"}, "display_name": "Impression VR", "keywords": [], "long_description": "With Impression VR you can effectively train your next presentation, whether it's in front of the class, colleagues or in a job interview!\n\nIn each of the 3 rooms you can set...\n- how the audience is composed\n-
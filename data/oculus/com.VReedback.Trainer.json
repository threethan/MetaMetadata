.com&_nc_ss=7f20f&oh=00_AQEvqZ_3w8PjTh9VI4G-kJPEk15MMElPTylCmLraAprQUA&oe=6A82F734"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdfHKcaxG-UQ7kNvwE2FrgP&_nc_oc=AdpEe8khFcGrtLczQmM4gyyplK4Wyhp0Dxz40Yf1XeutUa2InkEVJnMxPaQ9b4AIfgY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvpvWBYtRLwbyT_0X_bVC7EfiSNH2tBjxeHEZUuaua-A&oe=6A82FAF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApoRas9jMh4Q7kNvwHzPLGx&_nc_oc=AdqplnZzLwfWiuENOCCVJNcDqrbgv1eVCKMU6cGIBZXd8oSsqn-6A858gka-JM0YOL8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGD0iuA2aM6_peTGGge-tEraLLiYNmgMICF-giMsNvr2Q&oe=6A82E585"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97i5oXjob_8Q7kNvwHXdAIL&_nc_oc=AdphdweYwcTyerqif9yRk3CuIaDaj_cvpUeCoeG7T74Y1BoPhpMLgqjOBpBk1awhEJY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4XQfsn5j-sEtLri-qaUlski8WrfhWI46sZ_3G0_l2PQ&oe=6A82FE47"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-XPwNkCv3cQ7kNvwGsIrHZ&_nc_oc=AdoTcleuydSsi1CSCAPeRviZhF1vpLlhVFe1NWndQYhzU333ibOMP-4RFemYbSVDydQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOjGOikjS-JVnLw31r0lrKY0hjkCv4gwuCNwtQ5TyaPA&oe=6A830BFC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jchpo-tWX6IQ7kNvwGgR5sS&_nc_oc=AdpyGIH6IaVyKvGfLPMiNqitVcokhoiUGxbguOupY0NgDN-rAtEGK76CyFi2GOMerhE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH3ESFCcRBjx7391kMpR7299VY4yPkdxF2NNDSM9bgKQ&oe=6A82FD2B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
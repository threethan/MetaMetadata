.com&_nc_ss=7f20f&oh=00_Af0gEA6JArv3Gdb0RZg6Yto8bAW7IrSUvxBuu_mFP0EfLQ&oe=69F73834"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKAlhXR32oUQ7kNvwH7sTLN&_nc_oc=AdoTiORD5aEhEewUJXQbiKIlLJ--u8TZJrltbZEQEuujbGo2VZz0V_2LMxR-7E0NNN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2C9dtHkv4yMNuweFktotbscFAe23w-395aM8Inn_JcPg&oe=69F73BF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l809vGquDTkQ7kNvwH6Tr3g&_nc_oc=AdpkTzrqwhVYb5rEHjto_1TZ87h6WmgksBMofIVEY5-NbYKIYAlOLjyagSdeBGFNeyM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1oDpvOL_Lso2OKuXtDkX7HTzdF7lWbR9XwjJR6zgqCzw&oe=69F75EC5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWu3RzHuq8MQ7kNvwHp32qR&_nc_oc=Adpv1yGL_whBCFFMKgXFtu_7_r6dKUcc6omzNssyN_Ue8CQNU5CdU9jno3bTFentR5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0QcPW77-XlwDEOUIgLHr0pv14gkMQXTtPhUb4aqU-y-g&oe=69F73F47"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgCwZ-zyEvoQ7kNvwEjZIU7&_nc_oc=AdqfwvOce8cz4LgkkDg8EFSa33ZHm4VDZAoaU2aTQwstJKWXbYZDO_oUyvCc2R66Rdo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FDXJpxb2cSrAPCZgJWckTR6aoO0sM4GD3n7Qf8iFaQw&oe=69F74CFC"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHMPCcRHWJYQ7kNvwGWL0jg&_nc_oc=Adp1PfS9pXObF2Mieqj_dJjJgUG65KNFzetBr0zqeB1I04401t3Gr1OaStx28Z9ZBII&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0VKwAchBGPg_q7rsw2qX9qv5zsLT7ILcgkaJ9r0ikdmg&oe=69F73E2B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
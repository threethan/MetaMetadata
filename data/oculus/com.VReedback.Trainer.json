.com&_nc_ss=7f20f&oh=00_AQTFJTTxU7hZtlWtKcqZZWF9O37gMo6VUrrNKtZr7j6Rdw&oe=6AF9D674"}, {"file_name": "screenshot5hq.png", "id": "550579877218012", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75222945_550579880551345_5114370144800722005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDEh-EYV2U8Q7kNvwFgQwlp&_nc_oc=AdrYFpZ70MfQZfaBhEzDD8oD0iSCMlIS_JhFcd2AnZvOtc251g78pLdKtrOghdWhrLI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjAqZ7BdI3yxtNz8OEJ_GfTMEIuWuj2_Wt7mCL8yztPQ&oe=6AF9DA34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImpCoverTrailer.png", "id": "190678030335129", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982458_190678033668462_4619655899146826552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aw6CY7QNZrcQ7kNvwFvG4QD&_nc_oc=AdqxfeSMvSZN3YuixUPsd_YIOM5SnH7x_8O0NWTsch5lJAMaire0WiIoh20txXSi3pU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9QSmIQvanMtchfQAhzV-wb_3YJLp1Qx83xPQ6V-plXQ&oe=6AF9C4C5"}, "display_name": "Impression VR", "keywords": [], "long_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Konferenzraum mit 7 Personen (Team Meeting)\n- Seminarraum mit 20 Personen*\n\n*weniger auf Quest 1 Ger\u00e4ten", "short_description": "Mit Impression VR kannst Du deine n\u00e4chste Pr\u00e4sentation effektiv trainieren, egal, ob vor der Klasse, den Kollegen oder im Bewerbungsgespr\u00e4ch!\n\nIn jedem der 3 R\u00e4ume kannst einstellen...\n- wie das Publikum sich zusammensetzt\n- wie lange der Vortrag maximal sein darf (mit Stoppuhr)\n- wie Aufmerksam das Publikum zuh\u00f6rt\n\nIm Nachgang kannst Du dir nochmal anschauen und anh\u00f6ren, wie gut Du dich geschlagen hast.\n\nDie aktuellen R\u00e4ume sind:\n- Konferenzraum mit 3 Personen (Bewerbungsgespr\u00e4ch)\n- Seminarraum"}, {"images": {"nodes": [{"file_name": "ImpLandscape.png", "id": "2476178992540280", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/65398055_2476178995873613_5890563130306836643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4iAxqTU578Q7kNvwEuIUef&_nc_oc=AdpfPWWFZIeJBbOa_4QHTrGluAKmwYXpFN8VL60bDBjPLmzKe6oAGydgm95FlqO2_Ec&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStyktFXJDOeYCGmqLep1jcGufFunyVBgAwyNON6z775g&oe=6AF9DD87"}, {"file_name": "ImpCover.png", "id": "2401543720011882", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57575350_2401543723345215_1378399666035813534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKoW1VBhk8wQ7kNvwG4lBqx&_nc_oc=AdpnSuGLN8Qgo0ibqKRqNTUhyWQBLqaNt56utkot2FL4xhfJA2pYSjFAdqg2Ie7Nicw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPMBgASAF-mYGd29c4yJ7nvdgZsQqUBrkXatNutCW70w&oe=6AF9EB3C"}, {"file_name": "ImpHero.png", "id": "1575384222929044", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974551_1575384226262377_3077729185527084450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoWdXejpBBoQ7kNvwEwKX8X&_nc_oc=Adr5XiVF1Au_vE_DF0rSrxl5d-tvd8q2B4ucatMg8llT3pkHL-vl5TOlua5nIV7GjFs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw4ZeQI5rUgdfo2wO3SUeqKMGDK-_ZYw8CvludA-3ysA&oe=6AF9DC6B"}, {"file_name": "Basic ohne Claim (3).png", "id": "1408933533196382", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974709_1408933536529715_4465469510707743650_n.png?_nc_cat=1
e": "FencingLogo1440x1440.png", "id": "517367608071050", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499294659_517367611404383_1397769206406713974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-lAtYghyNEQ7kNvwF0dQuV&_nc_oc=Adp8XlO1IdHfqaW3be73URlbE7E5qc2QrMTsfT1aGJX25LKix5gcsuwvSCStfkMySsc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvi2NAThBMcau_IhEX4hFsbUkIJf97wvygQo9TL69f7g&oe=6ABE60C2"}]}, "id": "27392615427076906", "locale": "en_US", "screenshots": [{"file_name": "ReleaseScreenshot8.png", "id": "912798427232667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75481468_912798430566000_2729299982741186472_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exkp3ltFN6wQ7kNvwG0XZfx&_nc_oc=AdpwscQ8tuPW2TE6fPTgPwLPh8da327uKETGiSagtb5MpJ39xtUyjubPBiY7svl1Gzw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5A2ytMSqdnKdUotK9LynjsjXS34mZoJu_YU-rnc6q1Q&oe=6ABE8994"}, {"file_name": "ReleaseScreenshot7.png", "id": "989097866248110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75441584_989097869581443_7052414312117143552_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OA3QsuOerAQ7kNvwEpdyB6&_nc_oc=Ado3jsjfI8JMullTT6v8lodWDu2BM0wCWv90qnN-InrvE0bFDHcstBSdyDcyf8RPePg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJskKaRzcZNkWrIvnMG9ajiUDTJC6YP5iA5JTeT6Ozl8A&oe=6ABE8332"}, {"file_name": "ReleaseScreenshot9.png", "id": "2154022881650929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036702_2154022891650928_5406795738181765858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpEFHXdyEHgQ7kNvwE9ysNV&_nc_oc=Adr8EMdeFpGe-Ik62ThSz5j8fve98N0XlXaZB7CxrCIYLikDCtwIG8jrJQ6giiOvh40&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvd262b73aQifJgzF18W2GoBMgknK2-CAZd-PUvdGCKg&oe=6ABE5896"}, {"file_name": "ReleaseScreenshot5.png", "id": "1213561989637350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1213561992970683_1845508366569867310_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfmRA-BuiV0Q7kNvwGSdwAQ&_nc_oc=AdqHhQ8Gs4rH4t434FqMmoKzWtX2I2IP67d_x83xMqzNcOYj6KrzDbhz_EfJFFaibYY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJD8jBtzMiTnmFRsUCT_9b7Q6y9yRfpsLdj4_aWPQ0SQ&oe=6ABE6659"}, {"file_name": "ReleaseScreenshot6.png", "id": "3458630831095027", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_3458630834428360_4621810464157570933_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_E8Hg0P7agQ7kNvwEjU_bE&_nc_oc=Adq2fLOKseR0k-XAQb7Dm87LCNJng5tI5hwLZh-BN5gCuajY5KqAsaEty3v2qTFjExE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkYq6NjdAO4sChZ-JItITdrYDdqcFzQW0li7wknraj1g&oe=6ABE8668"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "900495181837608", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974816_900495185170941_9018293698527672932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNglaxHe8ToQ7kNvwF7dHgH&_nc_oc=AdpZPF8Bu3HgGtpLiEArCPWtbz8UBnhmoyon6JE3GLj93ZvlIp5hLM3DDp339MLkDwA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU8ZiLhRJd8Z2JREGKqKFoe9xtU9crBhn01lfjg5yTkw&oe=6ABE574F"}, "display_name": "Brazil Fencing Club", "keywords": ["Fencing", "Sports", "Sword", "Fighting", "Foil"], "long_description": "It would have been nice to get some foil fencing practice in, but unfortunately, your fencing club is closed tonight...\n\nBut you have another option. You could fence with the Brazil Fencing Club, located in the exotic lands of Brazil. What? South America? No... This Brazil is located in the foil fencing capital of the world: Indiana.\n\nWelcome to Brazil Indiana's Fencing Club, We never close. We have fencers practicing at our club 24-hours a day and 365 days a year. Anyone anywhere can fence with this club. No long car trips necessary. This is because our club only exists in virtual reality! Hope you will join us at practice today.\n", "short_description": "The Brazil Fencing Club has nine hoosier foil fencers ready to challenge you. Test your fencing skill and see if it holds up against these wacky fencers. Use actual real world fencing skills in a virtual reality game that closely simulates actual real world foil fencing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/brazilfencingclub/home", "developer_terms_of_service_url": null, "publisher_name": "Counterparry", "support_website_url": null, "website_url": "https://sites.google.com/view/brazilfencingclub/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28173465008927868"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499294659_517367611404383_1397769206406713974_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-lAtYghyNEQ7kNvwF0dQuV&_nc_oc=Adp8XlO1IdHfqaW3be73URlbE7E5qc2QrMTsfT1aGJX25LKix5gcsuwvSCStfkMySsc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlhJt6N11wlwF4SV3aLWqBsyi2-94QLqMpvglmv-46Pg&oe=6ABE60C2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Brazil Fencing Club", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"top
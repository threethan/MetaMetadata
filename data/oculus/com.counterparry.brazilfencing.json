e": "FencingLogo1440x1440.png", "id": "517367608071050", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294659_517367611404383_1397769206406713974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oH6qSF-fYYIQ7kNvwFy79Um&_nc_oc=AdqiYJjehPkP6mlAeF_Xz-ziJJjWcWxnZQZHt_FFbU4rx9NIaJg7F6QMTUfooMXmEDA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDhWPcuU-vujqN6ZNgRajeunznRxkQI2N3YQBI-Jr7cg&oe=6AC103C2"}]}, "id": "27392615427076906", "locale": "en_US", "screenshots": [{"file_name": "ReleaseScreenshot8.png", "id": "912798427232667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481468_912798430566000_2729299982741186472_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vk8FjphRzAoQ7kNvwHt_Od-&_nc_oc=Adq2p5N8oguEJVUOwlfwhQ89rfoJ7bpYQJOjm0NAdWefHGiBw-qvDcAHBU5zLzwdczM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsoN6N6Q6Se4-JjxdZ4lVkbXakXRjjsuvihlBkSMCZqA&oe=6AC12C94"}, {"file_name": "ReleaseScreenshot7.png", "id": "989097866248110", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75441584_989097869581443_7052414312117143552_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTXIZuP9sUsQ7kNvwGOUfkU&_nc_oc=Adob3BX8T6jxoisBAiwUAMAUeksfxh0pNfkTxF-sPhE84c1LNUCg0-epzr6FMy3Skrc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgbWj1ncd5JtnhTHporEB29QTWbILM5wiZAoRJUmLL0w&oe=6AC12632"}, {"file_name": "ReleaseScreenshot9.png", "id": "2154022881650929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036702_2154022891650928_5406795738181765858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFvLCIMReF0Q7kNvwH8fFvL&_nc_oc=AdqV4ADwE5Qid1dWLHAXez7hCEijvtoQJ5_JKBJ0DNezrh4BsBQeVvrLPdt936s6_qA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrLvqWEfzZNZCvN9KdTDb9Y_r3M20PHalTRt_1m_Zu3A&oe=6AC133D6"}, {"file_name": "ReleaseScreenshot5.png", "id": "1213561989637350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974531_1213561992970683_1845508366569867310_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfmRA-BuiV0Q7kNvwFaeS7e&_nc_oc=AdpUhgUpFukNR3nSDQF6lIhcAkTJ-E66ZrOEhtHflVlMEbT7UjWsZd2POuBl18fmsRI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3B14249caiGycxJ2cbhXo1iLBeKEe1K8SKnvFKAd4HA&oe=6AC10959"}, {"file_name": "ReleaseScreenshot6.png", "id": "3458630831095027", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_3458630834428360_4621810464157570933_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGrFXSph1usQ7kNvwGMsrsE&_nc_oc=AdoHAbuakN9fmUNnuyRf3w7Naw0dcvnhbGnNICCLyDFb7gS_tFaGJqIAztradLJlEGU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvjZFSRdee0o0IBlV9kVB7LDqI6LQDjapcKozqi-v0sA&oe=6AC12968"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "900495181837608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_900495185170941_9018293698527672932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNglaxHe8ToQ7kNvwGgejWD&_nc_oc=AdqZ-CtHDDw6cpEY-iu8XV0xkk0oZqlYzmYgygEsDvtOTXuDqRIWPkufcZYynECdYiI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPeHJV8Mrp7ehibEW8xTbNjFLp9iR-vlNS3ooql4FSxQ&oe=6AC1328F"}, "display_name": "Brazil Fencing Club", "keywords": ["Fencing", "Sports", "Sword", "Fighting", "Foil"], "long_description": "It would have been nice to get some foil fencing practice in, but unfortunately, your fencing club is closed tonight...\n\nBut you have another option. You could fence with the Brazil Fencing Club, located in the exotic lands of Brazil. What? South America? No... This Brazil is located in the foil fencing capital of the world: Indiana.\n\nWelcome to Brazil Indiana's Fencing Club, We never close. We have fencers practicing at our club 24-hours a day and 365 days a year. Anyone anywhere can fence with this club. No long car trips necessary. This is because our club only exists in virtual reality! Hope you will join us at practice today.\n", "short_description": "The Brazil Fencing Club has nine hoosier foil fencers ready to challenge you. Test your fencing skill and see if it holds up against these wacky fencers. Use actual real world fencing skills in a virtual reality game that closely simulates actual real world foil fencing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/brazilfencingclub/home", "developer_terms_of_service_url": null, "publisher_name": "Counterparry", "support_website_url": null, "website_url": "https://sites.google.com/view/brazilfencingclub/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28173465008927868"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294659_517367611404383_1397769206406713974_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oH6qSF-fYYIQ7kNvwFy79Um&_nc_oc=AdqiYJjehPkP6mlAeF_Xz-ziJJjWcWxnZQZHt_FFbU4rx9NIaJg7F6QMTUfooMXmEDA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPY9renhc78aaYVoHN-rRBqxFsKdErizp727Srff8rX1g&oe=6AC103C2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Brazil Fencing Club", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"top
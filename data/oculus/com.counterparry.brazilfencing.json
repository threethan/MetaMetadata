fk2iSb-4mIsK4x4OnBUpynJOrVfwgdfxlINZa3_mRg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2o0LdS8DcOCQTltLgt3ohWGjkWj0RUTXnt3-DoKXLSw&oe=6AB90828"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "900495181837608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_900495185170941_9018293698527672932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0303z8zr9ZIQ7kNvwE-PhyL&_nc_oc=Adq2Ef5xxBRGCQasvNKEbrVSDVo7BWM7VYyQC-FqJpSnLk4EvKI8FhfRA03ipHc-L-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjL8sNNjCMo87RFQ2CTI3ubO4Sawn9gMX7Vy-Lrz2ktA&oe=6AB9114F"}, "display_name": "Brazil Fencing Club", "keywords": [], "long_description": "You were hoping to get in some foil fencing practice tonight. Unfortunately, your club is closed tonight...\n\nBut you have another option. You could fence with the Brazil Fencing Club, located in the exotic lands of Brazil. What? South America? No... This Brazil is located in the foil fencing capital of the world: Indiana.\n\nWelcome to Brazil Indiana's Fencing Club, We never close. We have fencers practicing at our club 24-hours a day and 365 days a year. Anyone anywhere can fence with this club. No long car trips necessary. This is because our club only exists in virtual reality! Hope you will join us at practice today.\n\nThe Brazil Fencing Club has nine hoosier foil fencers ready to challenge you. Test your fencing skill and see if it holds up against these wacky fencers. Use actual real world fencing skills (like beat attacks, disengages, parry ripostes and more) in a virtual reality game that closely simulates actual real world foil fencing.", "short_description": "The Brazil Fencing Club has nine hoosier foil fencers ready to challenge you. Test your fencing skill and see if it holds up against these wacky fencers. Use actual real world fencing skills in a virtual reality game that closely simulates actual real world foil fencing."}]}, "deve
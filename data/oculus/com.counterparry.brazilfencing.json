content-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_3458630834428360_4621810464157570933_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kd3ZGwxNV0QQ7kNvwEj6lRH&_nc_oc=AdlQ2T4qS6z6mg2SDYGeDCHb9A5jQNrka94aUDRveR2Fr9sTSNhBIp2qR4DoO92mz6Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs_ZFub1Ijaex2r-BRO6-ef6PJ9fVpX8oxFHjjPydt8WA&oe=69984FA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "900495181837608", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974816_900495185170941_9018293698527672932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6r9x4I9uf0gQ7kNvwGIuBVN&_nc_oc=AdkhSu4iKhKC0m00BqRczjuSR7gCW33c1rGPk0jLB5l4XPR57adhJYjsdd4nuI9BDv0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfshZ-bzgLTdexVZ426favU72oqeFRuZRIhYvVkhNXLVMg&oe=699858CF"}, "display_name": "Brazil Fencing Club", "keywords": [], "long_description": "You were hoping to get in some foil fencing practice tonight. Unfortunately, your club is closed tonight...\n\nBut you have another option. You could fence with the Brazil Fencing Club, located in the exotic lands of Brazil. What? South America? No... This Brazil is located in the foil fencing capital of the world: Indiana.\n\nWelcome to Brazil Indiana's Fencing Club, We never close. We have fencers practicing at our club 24-hours a day and 365 days a year. Anyone anywhere can fence with this club. No long car trips necessary. This is because our club only exists in virtual reality! Hope you will join us at practice today.\n\nThe Brazil Fencing Club has nine hoosier foil fencers ready to challenge you. Test your fencing skill and see if it holds up against these wacky fencers. Use actual real world fencing skills (like beat attacks, disengages, parry ripostes and more) in a virtual reality game that closely simulates actual real world foil fencing.", "short_description": "The Brazil Fencing Club has nine hoosier foil fencers ready to challenge you. Test your fencing skill and see if it holds up against these wacky fencers. Use actual real world fencing skills in a virtual reality game that closely simulates actual real world foil fencing."}]}, "developer_name": null, "developer_privacy_policy_url": "http://brazilfencingclub.darkdire.com/#privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Counterparry", "support_website_url": null, "website_url": "http://brazilfencingclub.darkdire.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7806972622670406"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "866555915924193"}, {"status": "PUBLISHED", "id": "1473235066892526"}, {"status": "PUBLISHED", "id": "483765297639158"}]}, "baseline_offer": {"id": "866555915924193"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765273620, "status": "PUBLISHED", "id": "866555915924193"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25865187559755636", "version": "1.16.127"}, "id": "1172603213910493", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7806972616003740", "is_concept": false, "latest_released_binary": {"__typename": "Androi
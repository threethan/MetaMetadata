e": "FencingLogo1440x1440.png", "id": "517367608071050", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294659_517367611404383_1397769206406713974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLCO5mczBSkQ7kNvwHGyr-n&_nc_oc=AdpwkpTAZ7ZGr0OdQ_MxGyUkUaR9DrwTdmpKAQd4wJG05pHxt9xyF2OUN5MdLmM2CVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZVS8Huqo08eh6IPMi0LCqV-vI9hnBVIG9v2SZ8WBR_A&oe=6ADF5642"}]}, "id": "27392615427076906", "locale": "en_US", "screenshots": [{"file_name": "ReleaseScreenshot8.png", "id": "912798427232667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481468_912798430566000_2729299982741186472_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lwbndjR6XkQ7kNvwHwEAWB&_nc_oc=AdrCwgpcu7hujKCNRXF-Fou_ALzTI5n7bPewKNvxjh3AvDQUptotNEplPzkURj00T8c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRnwFpRbFvV6qA-kMX79suI-Fc-E475UUT1oCVVUrSrg&oe=6ADF46D4"}, {"file_name": "ReleaseScreenshot7.png", "id": "989097866248110", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75441584_989097869581443_7052414312117143552_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7bV8-TiW9cQ7kNvwEXeUHP&_nc_oc=Ado1RSF-SKFfuo6tlvhSdLd6qwEgQ0Z5-Rd6_xskWyKlzHVdI6zg4QoXgq0smredgY8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOjUCwqmpYhYCUfpAhsgPVt7DcrB0LMVh0n2zxrgEYBQ&oe=6ADF78B2"}, {"file_name": "ReleaseScreenshot9.png", "id": "2154022881650929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036702_2154022891650928_5406795738181765858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgI0SYAs5ckQ7kNvwEKs4P9&_nc_oc=Adoo420AN5bMr4ImpllAH4ST-NWwhXJ6H6kWTIDMFw1HndhnVXYXNxR8lyc5ddHoCNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtGFnig8mHYaeQPhUoXucLgM36wdZyKzprV2isOBkkVw&oe=6ADF4E16"}, {"file_name": "ReleaseScreenshot5.png", "id": "1213561989637350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974531_1213561992970683_1845508366569867310_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hl0cuVgSOyoQ7kNvwFiNSaG&_nc_oc=AdoegMJe-7p118eXPKA6BmaA401Fb2LM33LeUd4Pbe2OBhwgBlI3gO7wBkmte5Lj7n8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA4kr1LFTzzgD0e9-H7dMWKsRcdXO4hJc47ks152C4uw&oe=6ADF5BD9"}, {"file_name": "ReleaseScreenshot6.png", "id": "3458630831095027", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_3458630834428360_4621810464157570933_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyL7JRLI16UQ7kNvwHmLoiz&_nc_oc=AdrhWrhzDGoaF0FnpGPrlVo3qZPoeF2ZE8PPonl_jPRkNbWO1AgF4_EPQzg83KUyn3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMluEgVEQatkA8sz0gFpEZFQJew7630i2i8nmXwkdI9zA&oe=6ADF7BE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "900495181837608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_900495185170941_9018293698527672932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQLW8Pl1hZkQ7kNvwE58xUw&_nc_oc=Adrv_uWLXiFSLNBDKCusyNMeC2HkM6LectUZaIE2Ge5xU4JgOn_oAZMJI5CW46m79ZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPye_1uYve6w2gCZ_7IZl2DHXzj16bNCncroilZKwgaAA&oe=6ADF4CCF"}, "display_name": "Brazil Fencing Club", "keywords": ["Fencing", "Sports", "Sword", "Fighting", "Foil"], "long_description": "It would have been nice to get some foil fencing practice in, but unfortunately, your fencing club is closed tonight...\n\nBut you have another option. You could fence with the Brazil Fencing Club, located in the exotic lands of Brazil. What? South America? No... This Brazil is located in the foil fencing capital of the world: Indiana.\n\nWelcome to Brazil Indiana's Fencing Club, We never close. We have fencers practicing at our club 24-hours a day and 365 days a year. Anyone anywhere can fence with this club. No long car trips necessary. This is because our club only exists in virtual reality! Hope you will join us at practice today.\n", "short_description": "The Brazil Fencing Club has nine hoosier foil fencers ready to challenge you. Test your fencing skill and see if it holds up against these wacky fencers. Use actual real world fencing skills in a virtual reality game that closely simulates actual real world foil fencing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/brazilfencingclub/home", "developer_terms_of_service_url": null, "publisher_name": "Counterparry", "support_website_url": null, "website_url": "https://sites.google.com/view/brazilfencingclub/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28173465008927868"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294659_517367611404383_1397769206406713974_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLCO5mczBSkQ7kNvwHGyr-n&_nc_oc=AdpwkpTAZ7ZGr0OdQ_MxGyUkUaR9DrwTdmpKAQd4wJG05pHxt9xyF2OUN5MdLmM2CVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOv2kBO7UPiPC5eys4PIvvIb97a81x5kOgO2Qm4Rekh9w&oe=6ADF5642"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Brazil Fencing Club", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"top
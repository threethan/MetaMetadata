38974531_1213561992970683_1845508366569867310_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ph07OBbTRMIQ7kNvwFPKLYr&_nc_oc=AdqQHak6Zw3Tc7T3ggHbl57kZlR_aNyTSFBSRClqBDkFHCBXez_OtxR4mSqIxDVPZZ8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTONHu0EDADUOHuxZ66q90KTevgiemuiDHnG6mcIyMH5w&oe=6AFB4399"}, {"file_name": "ReleaseScreenshot6.png", "id": "3458630831095027", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974740_3458630834428360_4621810464157570933_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VnwUaVeP-AQ7kNvwGApUC3&_nc_oc=Adr6GhfKc438HDGOvG6XmWHNB_rHFnXNLLsdZN3e52jdG6lKYIKsWMFnkUcz4OVqAQ8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCD_gR4EmRlaa_0jH0rXNxhU7EVKLmgjFdenHvn3AWTg&oe=6AFB2B68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "900495181837608", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974816_900495185170941_9018293698527672932_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrV_WacHppwQ7kNvwHkhcaZ&_nc_oc=Adp4CT7WUT4Q60ORiQg2PJ7pSlFryYikwEVDDVgfu8x72HSrM2Lea3fRoEUB6F4GcaM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwgJbeRv-z2Q27eDXBBpGT_stXHe8tw1bGWDhS12xMzg&oe=6AFB348F"}, "display_name": "Brazil Fencing Club", "keywords": [], "long_description": "You were hoping to get in some foil fencing practice tonight. Unfortunately, your club is closed tonight...\n\nBut you have another option. You could fence with the Brazil Fencing Club, located in the exotic lands of Brazil. What? South America? No... This Brazil is located in the foil fencing capital of the world: Indiana.\n\nWelcome to Brazil Indiana's Fencing Club, We never close. We have fencers practicing at our club 24-hours a day and 365 days a year. Anyone anywhere can fence with this club. No long car trips necessary. This is because our club only exists in virtual reality! Hope you will join us at practice today.\n\nThe Brazil Fencing Club has nine hoosier foil fencers ready to challenge you. Test your fencing skill and see if it holds up against these wacky fencers. Use actual real world fencing skills (like beat attacks, disengages, parry ripostes and more) in a virtual reality game that closely simulates actual real world foil fencing.", "short_description": "The Brazil Fencing Club has nine hoosier foil fencers ready to challenge you. Test your fencing skill and see if it holds up against these wacky fencers. Use actual real world fencing skills in a virtual reality game that closely simulates actual real world foil fencing."}]}, "developer_name": null, "developer_privacy_policy_url": "http://brazilfencingclub.darkdire.com/#privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Counterparry", "support_website_url": null, "website_url": "http://brazilfencingclub.darkdire.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7806972622670406"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "2048243442503259"}, {"status": "PUBLISHED", "id": "995120200212073"}, {"status": "PUBLISHED", "id": "940309271681891"}, {"status": "PUBLISHED", "id": "866555915924193"}, {"status": "PUBLISHED", "id": "1473235066892526"}, {"status": "PUBLISHED", "id": "483765297639158"}]}, "baseline_offer"
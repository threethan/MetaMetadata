scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVSYr1VT0B_-SaHAyULe8Dacu70vEIGeg2dY9hZnsM2ew&oe=6B104DD6"}, {"file_name": "ReleaseScreenshot5.png", "id": "1213561989637350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974531_1213561992970683_1845508366569867310_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8jaTECx7C8Q7kNvwFzg5BE&_nc_oc=AdocBxp8uz3Uh8d8wW-EnFnlVemn9EvIaN2q2vMlsmZOdb6fyrJHIiMTPaOQP28UNIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXpMXfDMbpt5FDgeG96EonGg2372PotmtK1jM1Y4aRFpw&oe=6B105B99"}, {"file_name": "ReleaseScreenshot6.png", "id": "3458630831095027", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_3458630834428360_4621810464157570933_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ys3HaKPgVvQQ7kNvwF90mj-&_nc_oc=AdrNld7e6HIrf-LFusu0m5yzWSbEiRFpaYMXjat3yM4eYNX9BJtnS8FGyoByVQCGllg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVSPJEWB5ZmfBYAOy1QF5VMPZYLANmb_9_zmoaKOwqelQ&oe=6B104368"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "900495181837608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_900495185170941_9018293698527672932_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_jFp-w-nz0Q7kNvwFAZv6P&_nc_oc=AdqOszdRL0JXDOY1s9_WnKcJrGjjtdSq9FFWj_gnhysGl_j62pahUeKHzU542_8LVPg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUNjyy3V2NSnJG71Hwa9_490F4AcOt1onmsUcQw5gR-Iw&oe=6B104C8F"}, "display_name": "Brazil Fencing Club", "keywords": ["Fencing", "Sports", "Sword", "Fighting", "Foil"], "long_description": "It would have been nice to get some foil fencing practice in, but unfortunately, your fencing club is closed tonight...\n\nBut you have another option. You could fence with the Brazil Fencing Club, located in the exotic lands of Brazil. What? South America? No... This Brazil is located in the foil fencing capital of the world: Indiana.\n\nWelcome to Brazil Indiana's Fencing Club, We never close. We have fencers practicing at our club 24-hours a day and 365 days a year. Anyone anywhere can fence with this club. No long car trips necessary. This is because our club only exists in virtual reality! Hope you will join us at practice today.\n", "short_description": "The Brazil Fencing Club has nine hoosier foil fencers ready to challenge you. Test your fencing skill and see if it holds up against these wacky fencers. Use actual real world fencing skills in a virtual reality game that closely simulates actual real world foil fencing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/brazilfencingclub/home", "developer_terms_of_service_url": null, "publisher_name": "Counterparry", "support_website_url": null, "website_url": "https://sites.google.com/view/brazilfencingclub/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28173465008927868"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499294659_517367611404383_1397769206406713974_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZUce-uxIAkQ7kNvwHSzkuG&_nc_oc=Adrn9bOmTp79bI_cuUW_0wzqq6c0a4dluy4QwYgXjNWGK4cAH_C0EcwACrvqc7dXmsQ&_nc_zt=3&_nc_ht=scontent-ia
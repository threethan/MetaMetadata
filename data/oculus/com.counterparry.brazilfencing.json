e": "FencingLogo1440x1440.png", "id": "517367608071050", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499294659_517367611404383_1397769206406713974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPsi9Vhw_lEQ7kNvwFqkYWD&_nc_oc=AdqbZEpPLUyWqisaipCYXtMzOq4zndvKhKy2qA64B1xbxi4_4nDiebNCL2OsHYKwhNU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeCs0VB3ZN-KDe7HQ7anzM0qZGXKzG1vkskmpKsuU_AA&oe=6AE34AC2"}]}, "id": "27392615427076906", "locale": "en_US", "screenshots": [{"file_name": "ReleaseScreenshot8.png", "id": "912798427232667", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75481468_912798430566000_2729299982741186472_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgU6PpuCmA0Q7kNvwHhBuQI&_nc_oc=Ado-fvN15O_3-kMoBh5-jb-YUQgcZdduSUgDhhRICb53PD9sCLwdiAAkXhXOCKwjCK8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeZBxIT2gosNNapB1PIvooERaILV7GiatXfpndYplICg&oe=6AE33B54"}, {"file_name": "ReleaseScreenshot7.png", "id": "989097866248110", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75441584_989097869581443_7052414312117143552_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sX-ddraN1ZYQ7kNvwHudMYr&_nc_oc=Adq-VwzD_GvNjy7CyoOc3ERgLdPoC3ZIMuL38g_MFL4chNjZjocRYFl59bpGCOL5034&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2madHpt8nAtogykozlpYrsegqo70aziovnR8DCJus-w&oe=6AE36D32"}, {"file_name": "ReleaseScreenshot9.png", "id": "2154022881650929", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036702_2154022891650928_5406795738181765858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lpdpo9z5BWsQ7kNvwEdxXtc&_nc_oc=AdowS1uwnKVlZ7VlIbVnkjYrwaio4D8zqQQv-1KYRPfQ-4vQZdoRU4i8jz0q5UyRUfM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDipkTJid2WIl_POIo3znEaxMKCWh-jBexgFIpFPueuw&oe=6AE34296"}, {"file_name": "ReleaseScreenshot5.png", "id": "1213561989637350", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974531_1213561992970683_1845508366569867310_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOXQL4x_hUIQ7kNvwEsx1nJ&_nc_oc=AdrZhlj5JCwi_bjNTRPt4qBxQrx7A_3JAZ_H8jzaTm8UGve26ZVKNtu8GCA4W2i7kdk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_IGjORAxinI41VpL6RJEoHiH5xpJ5a4hKZvfd9CGwgg&oe=6AE35059"}, {"file_name": "ReleaseScreenshot6.png", "id": "3458630831095027", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974740_3458630834428360_4621810464157570933_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WsAlN_IZwUQ7kNvwE4XuIj&_nc_oc=AdpFktTqs20R6mbh0osuNia03dgOBSwBTRwr4iI9bfAgTAdef_O4VExcFTtp4isflog&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZcJijuUS-ogTQWu-_mlUwuFxdqqKeaY4fSVi2DMHrXQ&oe=6AE33828"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "900495181837608", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974816_900495185170941_9018293698527672932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Xa4Z2sDoj8Q7kNvwG179ru&_nc_oc=AdrgZ2qFBQukBlsCTsn33x99JZS_99iJf7hMiaW6DgyWd-E8vNzDAZl6XBUxlyGLk6A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo0F4efmxxmDVCgLZqFt0gFjopRFauIzNVCaKbtY0SMg&oe=6AE3414F"}, "display_name": "Brazil Fencing Club", "keywords": ["Fencing", "Sports", "Sword", "Fighting", "Foil"], "long_description": "It would have been nice to get some foil fencing practice in, but unfortunately, your fencing club is closed tonight...\n\nBut you have another option. You could fence with the Brazil Fencing Club, located in the exotic lands of Brazil. What? South America? No... This Brazil is located in the foil fencing capital of the world: Indiana.\n\nWelcome to Brazil Indiana's Fencing Club, We never close. We have fencers practicing at our club 24-hours a day and 365 days a year. Anyone anywhere can fence with this club. No long car trips necessary. This is because our club only exists in virtual reality! Hope you will join us at practice today.\n", "short_description": "The Brazil Fencing Club has nine hoosier foil fencers ready to challenge you. Test your fencing skill and see if it holds up against these wacky fencers. Use actual real world fencing skills in a virtual reality game that closely simulates actual real world foil fencing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/brazilfencingclub/home", "developer_terms_of_service_url": null, "publisher_name": "Counterparry", "support_website_url": null, "website_url": "https://sites.google.com/view/brazilfencingclub/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28173465008927868"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499294659_517367611404383_1397769206406713974_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPsi9Vhw_lEQ7kNvwFqkYWD&_nc_oc=AdqbZEpPLUyWqisaipCYXtMzOq4zndvKhKy2qA64B1xbxi4_4nDiebNCL2OsHYKwhNU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhvpvaMA92LpxT-227rrk0ZyyMx1R931rDr8R6m9l7qw&oe=6AE34AC2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Brazil Fencing Club", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"top
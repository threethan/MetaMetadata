e": "FencingLogo1440x1440.png", "id": "517367608071050", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294659_517367611404383_1397769206406713974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvI4Y5t_diQQ7kNvwESXAgA&_nc_oc=AdrZM2rACZmpxudXPyq_Fkt21Bsj48NLDXvpGIR5lOr2Es7AfiyxB49flZwh3rtM3ZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOy0FGCKvB_8MOhZMTG3o7NuvWahZDzdfRCgeuqJEkYGw&oe=6ACA7682"}]}, "id": "27392615427076906", "locale": "en_US", "screenshots": [{"file_name": "ReleaseScreenshot8.png", "id": "912798427232667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481468_912798430566000_2729299982741186472_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lpu61avjOgwQ7kNvwHqsT0Q&_nc_oc=Adqs5OQJ5JNyvTz91i-lX1OmY1X1Hy8x4d6TVJt2YyAx5F5seqQahJNFRJFS_sUEk3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKXyQRp6nGJHzaAan_jgBwgawHPBUcZs0ozRhzuDiAvg&oe=6ACA6714"}, {"file_name": "ReleaseScreenshot7.png", "id": "989097866248110", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75441584_989097869581443_7052414312117143552_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOFCMiwcxdwQ7kNvwHQu658&_nc_oc=AdoivY6YK7DK7RfLp18IAxwRXSoJIffKvhtse6qHgEKLEsoIgz_IUKxEpGyxOQzZf5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPScpB_XCpn7ITmyZ6SXpm4WZJxP8Tr4qwyFGfZ5o5C_A&oe=6ACA60B2"}, {"file_name": "ReleaseScreenshot9.png", "id": "2154022881650929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036702_2154022891650928_5406795738181765858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaAW454ARloQ7kNvwEIA_jn&_nc_oc=AdqMV2St9NH0JJrpLyWuKiR05hKJfKgEVE_KVmegLx5dKq8uIdFra4K1QeRkcRk28gk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrfcoIIwCm5MUg_emi96Ctu8eNemQkJEmTAU5y0BQjHQ&oe=6ACA6E56"}, {"file_name": "ReleaseScreenshot5.png", "id": "1213561989637350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974531_1213561992970683_1845508366569867310_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTX-gYsj87cQ7kNvwFxm001&_nc_oc=AdqA92RIr7nQ0AbS7nFeKgTotyytBoxCJZwEbpyH6FIU5K1v09luyq2vXWhf0CTG_VI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8BvH5G2og1YrnW-2a1PialAk0_tTSqZyx1f0ozdK3hA&oe=6ACA43D9"}, {"file_name": "ReleaseScreenshot6.png", "id": "3458630831095027", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_3458630834428360_4621810464157570933_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0FXSeLw1JQQ7kNvwERzRH6&_nc_oc=AdocZc7lug8uPtJ-9u_3HPCjfM0FmLuZEi_g_kA3azTYtnpsIZ4sgrhOIfVWQ9zijo8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3B-onMdYwDJ-vFn4FC3zgPVe6gD89pPfiLSQx7_XP1Q&oe=6ACA63E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "900495181837608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_900495185170941_9018293698527672932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHdoPJMdJNUQ7kNvwFjgNqP&_nc_oc=AdrrldbSiQLUydrQnl1wYa33_zd0qCRj1YOhuW-FexUWd6nMmhsbvCmmmmKm_vaeFwY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_NnAVtogkJxzadNn6D_Rv9M0fycgGNk5Ur-FsEXGsPw&oe=6ACA6D0F"}, "display_name": "Brazil Fencing Club", "keywords": ["Fencing", "Sports", "Sword", "Fighting", "Foil"], "long_description": "It would have been nice to get some foil fencing practice in, but unfortunately, your fencing club is closed tonight...\n\nBut you have another option. You could fence with the Brazil Fencing Club, located in the exotic lands of Brazil. What? South America? No... This Brazil is located in the foil fencing capital of the world: Indiana.\n\nWelcome to Brazil Indiana's Fencing Club, We never close. We have fencers practicing at our club 24-hours a day and 365 days a year. Anyone anywhere can fence with this club. No long car trips necessary. This is because our club only exists in virtual reality! Hope you will join us at practice today.\n", "short_description": "The Brazil Fencing Club has nine hoosier foil fencers ready to challenge you. Test your fencing skill and see if it holds up against these wacky fencers. Use actual real world fencing skills in a virtual reality game that closely simulates actual real world foil fencing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/brazilfencingclub/home", "developer_terms_of_service_url": null, "publisher_name": "Counterparry", "support_website_url": null, "website_url": "https://sites.google.com/view/brazilfencingclub/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28173465008927868"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294659_517367611404383_1397769206406713974_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvI4Y5t_diQQ7kNvwESXAgA&_nc_oc=AdrZM2rACZmpxudXPyq_Fkt21Bsj48NLDXvpGIR5lOr2Es7AfiyxB49flZwh3rtM3ZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgee9JtcQkhpHOkGOsEX0QDU2GaM8681XPkxyD9wlnCw&oe=6ACA7682"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Brazil Fencing Club", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"top
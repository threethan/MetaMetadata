66569867310_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7m6GF3xzNfsQ7kNvwHHB_um&_nc_oc=AdnEnYUmLFPP-8MfY696xlQtax8YLnmxhPX6jxr-aWX8IE4Js-4pElBYyNc2oANwQME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1srzSQFUjHbNwfLFol_WpCBIIFdfPi3mzJjm_s87EFA&oe=69B568D9"}, {"file_name": "ReleaseScreenshot6.png", "id": "3458630831095027", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974740_3458630834428360_4621810464157570933_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtPLlIa_7hUQ7kNvwFD4pNv&_nc_oc=AdnDVu1YWdnfpnCHmw1MKSlBGkPLqa3FFw2VumGa9yUIlL-UOMXpaoHuJX7JdgWE8Z0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvxFbf87FcjRjld1T8DlpULaR2uiAOnmE74PFj3LgLQw&oe=69B550A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "900495181837608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974816_900495185170941_9018293698527672932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ilq6vedRWeEQ7kNvwHa3rkA&_nc_oc=AdlDmPoWpp4jD5PSuIVoipl9bKvy_MCNREUdI-kb3RXMiydLZnX6qego7dOfOF_nTUQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzI_47fE5Ev-Gl6NSx68m25oyzQbf_EVEGTsK7mRW-VCA&oe=69B559CF"}, "display_name": "Brazil Fencing Club", "keywords": [], "long_description": "It would have been nice to get some foil fencing practice in, but unfortunately, your fencing club is closed tonight...\n\nBut you have another option. You could fence with the Brazil Fencing Club, located in the exotic lands of Brazil. What? South America? No... This Brazil is located in the foil fencing capital of the world: Indiana.\n\nWelcome to Brazil Indiana's Fencing Club, We never close. We have fencers practicing at our club 24-hours a day and 365 days a year. Anyone anywhere can fence with this club. No long car trips necessary. This is because our club only exists in virtual reality! Hope you will join us at practice today.\n", "short_description": "The Brazil Fencing Club has nine hoosier foil fencers ready to challenge you. Test your fencing skill and see if it holds up against these wacky fencers. Use actual real world fencing skills in a virtual reality game that closely simulates actual real world foil fencing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/brazilfencingclub/home", "developer_terms_of_service_url": null, "publisher_name": "Counterparry", "support_website_url": null, "website_url": "https://sites.google.com/view/brazilfencingclub/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26533079022966483"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499294659_517367611404383_1397769206406713974_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLG_z2NMEP0Q7kNvwFp7_do&_nc_oc=AdkBqmvqiWCRgqeJrX4VPp3RmWxd_XJauwFSv6YcM8BPBgQ2Q2elSnArQ2zmhzzSFPY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9swydZIgdSbea8GVaMtB9edspbnHq6axleo4MBmCeww&oe=69B56342"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Brazil Fencing Club", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}]
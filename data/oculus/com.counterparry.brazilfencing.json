scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaw0P8Iw-yZos3Soi44NWVxu_dtbFRun_ADk4BboSf0w&oe=6B007BD6"}, {"file_name": "ReleaseScreenshot5.png", "id": "1213561989637350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974531_1213561992970683_1845508366569867310_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlM7xOVeMMAQ7kNvwHOT_Du&_nc_oc=AdoDe1RoEaTzO6LUoHS0LBz7kDVcHG5ueDX3TyVCaqfLxg5eUH8-tuo0UQ5DEbzZqoo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8oTioB-J94LQk96rThMYVOeHaG6jaTjReIf4Q6_QbDw&oe=6B005159"}, {"file_name": "ReleaseScreenshot6.png", "id": "3458630831095027", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_3458630834428360_4621810464157570933_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVU2sYYDDRYQ7kNvwFJdtiy&_nc_oc=AdrAbT3VvmQwl6b608BjH47UklmqSiyd0gI3_uBs7hyrIoiWOwE7ICsisNmfwS0dopI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTttDfCicUC0mv0V49G_C9DYGd9egPF20MQGAEeBSbn8A&oe=6B007168"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "900495181837608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_900495185170941_9018293698527672932_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHkltEgMcBsQ7kNvwEsfvJ3&_nc_oc=AdoJxhcMx7mQ4-l2Y9maTz02rYY1_4-BqSZORswU0ilKq6iGTbKBcK_rzrgKmUmZQhQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTltPH-hmBbpkmo7mxII5uUdMS5joNxWJGe5-xhcmx6bg&oe=6B007A8F"}, "display_name": "Brazil Fencing Club", "keywords": ["Fencing", "Sports", "Sword", "Fighting", "Foil"], "long_description": "It would have been nice to get some foil fencing practice in, but unfortunately, your fencing club is closed tonight...\n\nBut you have another option. You could fence with the Brazil Fencing Club, located in the exotic lands of Brazil. What? South America? No... This Brazil is located in the foil fencing capital of the world: Indiana.\n\nWelcome to Brazil Indiana's Fencing Club, We never close. We have fencers practicing at our club 24-hours a day and 365 days a year. Anyone anywhere can fence with this club. No long car trips necessary. This is because our club only exists in virtual reality! Hope you will join us at practice today.\n", "short_description": "The Brazil Fencing Club has nine hoosier foil fencers ready to challenge you. Test your fencing skill and see if it holds up against these wacky fencers. Use actual real world fencing skills in a virtual reality game that closely simulates actual real world foil fencing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/brazilfencingclub/home", "developer_terms_of_service_url": null, "publisher_name": "Counterparry", "support_website_url": null, "website_url": "https://sites.google.com/view/brazilfencingclub/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28173465008927868"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499294659_517367611404383_1397769206406713974_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnpW427IIdsQ7kNvwFe-uLt&_nc_oc=AdrutHhGUpAZWsXHIX7f9U69xDJJ44t8IEfn3asFUf6YzKzd3snH5sqHC_5Kok-3igI&_nc_zt=3&_nc_ht=scontent-ia
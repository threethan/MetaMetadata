e": "FencingLogo1440x1440.png", "id": "517367608071050", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294659_517367611404383_1397769206406713974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qsv1EzptS08Q7kNvwHic3XQ&_nc_oc=Adp-AppfLcznJTx1t7Uxv5B1GV9qo76wqBRYLThHIXn37x-YbFLj7DecFDPCaJTDnhg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk09NlJEU6peiFg3tB_F0hst-7IEG9f3QNtfy7p3Wc4Q&oe=6AC649C2"}]}, "id": "27392615427076906", "locale": "en_US", "screenshots": [{"file_name": "ReleaseScreenshot8.png", "id": "912798427232667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481468_912798430566000_2729299982741186472_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wu0BjQWwmEQ7kNvwGkTzPy&_nc_oc=AdooGmSm_t9BtbrKOaS02IggkrJXVeSTsMDCk0wHumkxgyjBhQxCxQGK_JFNrUNRbOA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwQ2-AsJL5Ms8TVN7WF_z0YRY1Uvf250OI7lncixUZkQ&oe=6AC67294"}, {"file_name": "ReleaseScreenshot7.png", "id": "989097866248110", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75441584_989097869581443_7052414312117143552_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arqDP-iRy24Q7kNvwF3QYGr&_nc_oc=AdpHgOrTOoctnznVWAQlzC8AM-YvwnhICXesRzGESc-BcBZDLrAPL9kGKdJo7yCusgY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsdmZreD2O_m03SsJpaAxM8maxmaLR9xRpNSuSGpssVg&oe=6AC66C32"}, {"file_name": "ReleaseScreenshot9.png", "id": "2154022881650929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036702_2154022891650928_5406795738181765858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWMPA_zVHdgQ7kNvwG5wyJr&_nc_oc=Adr1v2sWlfwuXkvD-8lKkTXuItm2QYysR504OO5hGAXEoQrjIznPNZ6NO0BNnnuoyn0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkHxgVkf0_CWET4r8p-cpM08EPL75pjixn303Jp05RlA&oe=6AC64196"}, {"file_name": "ReleaseScreenshot5.png", "id": "1213561989637350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974531_1213561992970683_1845508366569867310_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqY-UQl1MR8Q7kNvwHem6fR&_nc_oc=AdoEc1c7heCj1jaV7j69kPybKQKewKhKHJkWTFZZ8tJ3T1gNXIkfaLJMrjOoxdT-Gqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxTEw7A9r5naSWMvql9O_PA55Z3Eav5aoz9QSi1TzRiw&oe=6AC64F59"}, {"file_name": "ReleaseScreenshot6.png", "id": "3458630831095027", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_3458630834428360_4621810464157570933_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VLRfU-RXgwQ7kNvwGH7G25&_nc_oc=AdpmuMxzABCJbK7FeSDXQLICP_8oAkrDNa2A5H1V-nexmQf8K6Cl7ziz7mnB9nhUkN8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpGTUASQhaXa4D_K3NTNoAzVu-fYF3G7m5wydlidRG9w&oe=6AC66F68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "900495181837608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974816_900495185170941_9018293698527672932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXbXo25Oob8Q7kNvwFi3y72&_nc_oc=Adoi8mI3K7Zj11z2nmUcGUPBwCTaCnd-ZB2jrYPz7H86Wj4aI-NEoHjXgrP2PyJp4CI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhTFUupKXoyd6h8Nsle8sQ_2BIP0djUc5xMCEy_czP4Q&oe=6AC6788F"}, "display_name": "Brazil Fencing Club", "keywords": ["Fencing", "Sports", "Sword", "Fighting", "Foil"], "long_description": "It would have been nice to get some foil fencing practice in, but unfortunately, your fencing club is closed tonight...\n\nBut you have another option. You could fence with the Brazil Fencing Club, located in the exotic lands of Brazil. What? South America? No... This Brazil is located in the foil fencing capital of the world: Indiana.\n\nWelcome to Brazil Indiana's Fencing Club, We never close. We have fencers practicing at our club 24-hours a day and 365 days a year. Anyone anywhere can fence with this club. No long car trips necessary. This is because our club only exists in virtual reality! Hope you will join us at practice today.\n", "short_description": "The Brazil Fencing Club has nine hoosier foil fencers ready to challenge you. Test your fencing skill and see if it holds up against these wacky fencers. Use actual real world fencing skills in a virtual reality game that closely simulates actual real world foil fencing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/brazilfencingclub/home", "developer_terms_of_service_url": null, "publisher_name": "Counterparry", "support_website_url": null, "website_url": "https://sites.google.com/view/brazilfencingclub/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28173465008927868"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294659_517367611404383_1397769206406713974_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qsv1EzptS08Q7kNvwHic3XQ&_nc_oc=Adp-AppfLcznJTx1t7Uxv5B1GV9qo76wqBRYLThHIXn37x-YbFLj7DecFDPCaJTDnhg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVsBtqc0Cxh4nqgq_V1BXzQi_-gmRmDThgCXWx290bKQ&oe=6AC649C2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Brazil Fencing Club", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"top
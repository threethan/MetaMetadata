66569867310_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YiLB0TTn1YQ7kNvwHFaBwF&_nc_oc=Adm_1Firw3DMEPiJwdy3IrxNIbDDmKBSvDcQzT4yh6O0p1p2UDX4uKeUOtLXSAfpDzo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvoFQxRbh1z4mZj9VITRXD1hZHit1nOF7_-OU5fDCR25g&oe=69A98B59"}, {"file_name": "ReleaseScreenshot6.png", "id": "3458630831095027", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974740_3458630834428360_4621810464157570933_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFuT_xh_UMwQ7kNvwF1p3jz&_nc_oc=AdmSEpqg1SviAoOmc7JKpF8HNJpOlu3a4g_JKs3xpKtZOIJBfcS-ltNsbN6ADzD-5Q4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftrjSHlsy7JUgn_-artEXu6AdWcZgtT-P_CjJaMQXYeIg&oe=69A97328"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "900495181837608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974816_900495185170941_9018293698527672932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spb9S6JYi9MQ7kNvwHyyVT1&_nc_oc=AdlgAmj3xsPW9vndxEdBt6H6mzpfvi55oYw-OCXjxDiOOcLfhX-bWKjJrXIYykUZWk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvR5TgNs-WqtcgVIbLrjV9rEwCfiRR14tyoL8ZjD3r92Q&oe=69A97C4F"}, "display_name": "Brazil Fencing Club", "keywords": [], "long_description": "It would have been nice to get some foil fencing practice in, but unfortunately, your fencing club is closed tonight...\n\nBut you have another option. You could fence with the Brazil Fencing Club, located in the exotic lands of Brazil. What? South America? No... This Brazil is located in the foil fencing capital of the world: Indiana.\n\nWelcome to Brazil Indiana's Fencing Club, We never close. We have fencers practicing at our club 24-hours a day and 365 days a year. Anyone anywhere can fence with this club. No long car trips necessary. This is because our club only exists in virtual reality! Hope you will join us at practice today.\n", "short_description": "The Brazil Fencing Club has nine hoosier foil fencers ready to challenge you. Test your fencing skill and see if it holds up against these wacky fencers. Use actual real world fencing skills in a virtual reality game that closely simulates actual real world foil fencing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/brazilfencingclub/home", "developer_terms_of_service_url": null, "publisher_name": "Counterparry", "support_website_url": null, "website_url": "https://sites.google.com/view/brazilfencingclub/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26533079022966483"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499294659_517367611404383_1397769206406713974_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-mBLKJpsdYQ7kNvwGZc6t7&_nc_oc=AdnPT23BnSvq-uVikgKOIRFBiyT7YVKYGF1tP21wz9yYpuAgzG_5hBYhwxQ3kGcWh_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsHUBaMYvcVER8F1alhEeMfPQTcc7qA3FuuX-tBn6Wahw&oe=69A985C2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Brazil Fencing Club", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}]
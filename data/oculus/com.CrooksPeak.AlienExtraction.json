_440604124442062_7746272478342335081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiQm0nzEf3gQ7kNvwH6JGMW&_nc_oc=AdkIhq9FQcESnKFr-Q2QnlIIvw5rumi2Hg6CL1xLJJgPD_cQ0zEH0JASmTHwX8kzzPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftE4YUsSbdComxkeTsUM2Aorn4tf5KuVcfbXUp2tnLJcw&oe=69998EAD"}, "display_name": "Alien Extraction Demo", "keywords": [], "long_description": "There's a big alien mess and somebody's gotta clean it up...\n\nControl an alien infested space station from the safety of your security desk in this funny, brain bending strategy game. Guide the station janitor, Lenny, through dangerous winding levels and solve the station's mysteries along the way.\n\n- Scour video feeds for alien movement or lost clues\n- Pilot drones to explore, distract aliens and lead Lenny to safety\n- Control the facility from the comfort of your security desk\n- Traverse the facility minimap; just don\u2019t trust it\n- Attempt to mute the station AI when it starts insulting you...\n\nFull game releasing March 2022!", "short_description": "Control an alien infested space station in this lighthearted VR strategy puzzle game. Guide Lenny the janitor through deadly and dangerous levels: sneak, burn, distract, pilot, blast and clean his way to safety. Control drones, check cameras and complete puzzles to solve the station's mysteries. Full game releasing March 2022!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://alienextraction.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Crooks Peak", "support_website_url": "https://alienextraction.com/bug", "website_url": "https://alienextraction.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "STRATEGY", "NARRATIVE"], "has_in_app_ads": n
ailer_thumbnail": {"file_name": "oculusCoverArtLandscape.png", "id": "440604121108729", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462963_440604124442062_7746272478342335081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGkDGuq02yQQ7kNvwHw2FJs&_nc_oc=AdqE4xKFObToP9cv7KGUcNkP9_MV6TXzxvhVdvMcREvJwXrBt4Fh_Eqks4snAEdMSEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBUBSvclXH_XT8FjpNpCTY8Hp17yOuyKjAP0TYzAZVaQ&oe=6A8C22AD"}, "display_name": "Alien Extraction Demo", "keywords": [], "long_description": "There's a big alien mess and somebody's gotta clean it up...\n\nControl an alien infested space station from the safety of your security desk in this funny, brain bending strategy game. Guide the station janitor, Lenny, through dangerous winding levels and solve the station's mysteries along the way.\n\n- Scour video feeds for alien movement or lost clues\n- Pilot drones to explore, distract aliens and lead Lenny to safety\n- Control the facility from the comfort of your security desk\n- Traverse the facility minimap; just don\u2019t trust it\n- Attempt to mute the station AI when it starts insulting you...\n\nFull game releasing March 2022!", "short_description": "Control an alien infested space station in this lighthearted VR strategy puzzle game. Guide Lenny the janitor through deadly and dangerous levels: sneak, burn, distract, pilot, blast and clean his way to safety. Control drones, check cameras and complete puzzles to solve the station's mysteries. Full game releasing March 2022!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://alienextraction.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Crooks Peak", "support_website_url": "https://alienextraction.com/bug", "website_url": "https://alienextraction.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": 
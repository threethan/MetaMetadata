25/491824592_1104051511837473_7300729811494928850_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eXkfgAlG2wQ7kNvwH0ghmF&_nc_oc=AdolOqZDvtn-EvQk-HlJmN9YST2OYznfNmfIc-Ap8P5dMCntExmelTch-bS1fdeNKyg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyjB_ObwOxhpxx4JvRsjK8QTXqMoPqlFj8dosR0lASwA&oe=6AE337FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "26262241333414061", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303198_26262241343414060_4193274196742979869_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQr-fjHJ2_gQ7kNvwG20L4N&_nc_oc=Adpq5-J6AvQAL_nNlVsnodX_uWqGVTz-D6kAo8OCObLqeq5TAuI0e5AeMWUicxQo3zk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKjqamDfNfM69uJ38-L-f4FHNGg4xvddYPP7TmW2YL6A&oe=6AE35EF3"}, "display_name": "Rate My Farm", "keywords": ["multiplayer", "parkour", "challenge", "farming", "social"], "long_description": "**Why You\u2019ll Love It:**\n\n\n\ud83c\udf31 **Simple & Fun VR Farming**\n\nThrow seeds, watch them grow, and harvest with real VR physics. Big, shiny, and weird plants \u2014 every harvest feels different\n                                                                                                                                                                           \n{836428726088819}\n\n\ud83c\udfc3 **Daily Parkour Challenges = Faster Growth**\n\nComplete fun parkour trials every day to boost plant growth, earn rewards, and upgrade your farm faster. Skill = progress.\n\n{782948787606548}\n\n\ud83d\udc6b **Play Together in a Shared World**\n\nSee other players, visit their farms, help each other, trade seeds, or just run around and have fun together.\n\n{839832729098726}\n\n\ud83c\udfa8 **Customize Your Farm & Character**\n\nDecorate your farm, unlock cosmetics, and show your style to everyone around you.\n\n{942926708114296}\n\n\ud83d\udcf8 **Clip-Ready & Funny Moments**\n\nFails, speedruns, huge harvests, and co-op chaos \u2014 perfect for clips and sharing.\n\n{1478212800331859}\n\n\ud83d\udea7 **Early Access \u2014 More Coming Soon**\n\nNew parkour maps, plants, events, and cosmetics are added regularly. Your feedback helps shape the game.\n\n\ud83d\udc49 Jump in now and grow your farm faster with parkour and friends.", "short_description": "VR farming sandbox with real physics: plant, grow, and harvest weird crops, complete daily parkour challenges for boosts, and hang out with friends in a shared world. Customize your farm, make funny moments, and shape the game during Early Access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fibrum.com/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "FIBRUM", "support_website_url": null, "website_url": "https://fibrum.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "24862142073410688"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827567_1612038613177262_2996504766136631971_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFnXZ0lUkakQ7kNvwFs-THd&_nc_oc=AdqJYSmri2UOn7ScpS7-YAD1tt5db0UBKf1_gs4YRnhl79O0L5OsR88FmVqG8yNHKbI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhXw-MiOYSFaXicaZ87Cl
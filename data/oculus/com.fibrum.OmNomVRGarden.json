3_4149410431979059_4325136862180923221_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwBOrn_floIQ7kNvwGWKB_z&_nc_oc=AdoIM5Pvj5Nz1y3xoCA7JSZlWFyu0PKqBCRZNKDlNKv5o1owA40qBbq82CHoWyughIM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtmQ3j6mohwocXOOc-hrQaxFwBQ0seERM0rVePJQxS5w&oe=6AA3F7B9"}, {"file_name": "Screenshot-03.png", "id": "2110521903071277", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819859_2110521906404610_8133001014812942380_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FiIPSo23UgQ7kNvwEI7JLP&_nc_oc=AdrSWsR_2s__rUeOROm6pAYbZ1jg25kjgRh0QEVNClmu9VI6doizV2V1U8rH74GI0F4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAdH2ShaTSy4jkXGzbS1ngi-gsds_v6_oeD67BlSN3gw&oe=6AA406F6"}, {"file_name": "Screenshot-05.png", "id": "829409626824604", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491825470_829409633491270_3298198916308075793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9KLY2Ts69EQ7kNvwEyjtE1&_nc_oc=AdoyxdIZRBMPQ9eNayORGfwqmkMaSa82d2-FAjkCVXSptyOhx-OrGAYB2c-JxTIlE6U&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl5MzKjDKgc5kJl4cjRuPzS0vP_Xa4qhGmv4HnhFYmzQ&oe=6AA3EFCD"}, {"file_name": "Screenshot-06.png", "id": "1438875284614061", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821099_1438875287947394_4273846274148478484_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAqzfXfv6IIQ7kNvwHniVuh&_nc_oc=AdoTBLB0o8oQDQelfsst3_EgNO1kXPcgCT_SDkqOJRKuyElzWLv6L_0jR5xziOZQFw4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzXX_FoNP6zpBtKF2dcSQI7Sf5CnSxn8wgPgbuBZbwDA&oe=6AA3EF24"}, {"file_name": "Screenshot-12.png", "id": "1104051508504140", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824592_1104051511837473_7300729811494928850_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxjXqaPSq0sQ7kNvwHyIhPA&_nc_oc=Adok6W4WcPdp9s6WkUPycj6pqWysIRiNz1ysjk_6N5woL4LdrPF5e0Gmpyhl5M8fX6Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkK9sXSjjbojORisnSOeo8e1mDNoo_lqZLWf491gH1jw&oe=6AA3EFFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "26262241333414061", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499303198_26262241343414060_4193274196742979869_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9wILEiYFv8Q7kNvwH0Phbg&_nc_oc=Adr3SfCJKwqCmfN2qYuxRXYXAxMUkX2pxqQIBWk7-Qv-GeFI1T2KdeCEOnVhaaAP20Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWcNx_jv4X8xegKMvE8tay5gG21nsigjDukNPcYqyOhw&oe=6AA416F3"}, "display_name": "Rate My Farm", "keywords": ["multiplayer", "parkour", "challenge", "farming", "social"], "long_description": "**Why You\u2019ll Love It:**\n\n\n\ud83c\udf31 **Simple & Fun VR Farming**\n\nThrow seeds, watch them grow, and harvest with real VR physics. Big, shiny, and weird plants \u2014 every harvest feels different\n                                                                                                                                                                           \n{836428726088819}\n\n\ud83c\udfc3 **Daily Parkour Challenges = Faster Growth**\n\nComplete fun parkour trials every day to boost plant growth, earn rewards, and upgrade your farm faster. Skill = progress.\n\n{782948787606548}\n\n\ud83d\udc6b **Play Together in a Shared World**\n\nSee other players, visit their farms, help each other, trade seeds, or just run around and have fun together.\n\n{839832729098726}\n\n\ud83c\udfa8 **Customize Your Farm & Character**\n\nDecorate your farm, unlock cosmetics, and show your style to everyone around you.\n\n{942926708114296}\n\n\ud83d\udcf8 **Clip-Ready & Funny Moments**\n\nFails, speedruns, huge harvests, and co-op chaos \u2014 perfect for clips and sharing.\n\n{1478212800331859}\n\n\ud83d\udea7 **Early Access \u2014 More Coming Soon**\n\nNew parkour maps, plants, events, and cosmetics are added regularly. Your feedback helps shape the game.\n\n\ud83d\udc49 Jump in now and grow your farm faster with parkour and friends.", "short_description": "VR farming sandbox with real physics: plant, grow, and harvest weird crops, complete daily parkour challenges for boosts, and hang out with friends in a shared world. Customize your farm, make funny moments, and shape the game during Early Access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fibrum.com/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "FIBRUM", "support_website_url": null, "website_url": "https://fibrum.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "24862142073410688"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2310462119444958"}]}, "baseline_offer": {"id": "2310462119444958"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771612920, "status": "PUBLISHED", "id": "2310462119444958"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26443203405304539", "version": "0.5"}, "id": "845477258424993", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typ
A52"}, "display_name": "Darts Battle VR", "keywords": [], "long_description": "Welcome to Darts Battle VR! Compete online against real players in thrilling multiplayer darts battles.\nPlay in tournaments and top the leaderboard or Invite and challenge your friends to fun, competitive darts battles. In Darts Battle VR you're going to experience the authentic arcade gameplay that will push your skills to the limit. \n\n- Tournaments - Compete with players on your skill level and win great rewards.\n- Friends Battle - Challenge your friends in online matches\n- Training - Build up your skills to hit the Bulls Eye.\n- Leaderboard - Climb the leaderboard to the top.", "short_description": "Welcome to Darts Battle VR! Compete online against real players in thrilling multiplayer darts battles.\nPlay in tournaments and top the leaderboard or Invite and challenge your friends to fun, competitive darts battles. In Darts Battle VR you're going to experience the authentic arcade gameplay that will push your skills to the limit. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://taskoob.com/dartsbattlevr/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Taskoob Inc.", "support_website_url": null, "website_url": "https://taskoob.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interacti
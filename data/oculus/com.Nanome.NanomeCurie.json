ile_name": "sc5.png", "id": "3270579766560966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031482_3270579769894299_4653679679600901337_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZFcjaiUy64Q7kNvwHjYfCz&_nc_oc=AdoQmQgOt4JZM8iVNGDDMjPajAaUAsgujDrMcdVlX9_kBkPBOt3Il7eCBZh4EvRAjmQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXiBs-AUWRJm1xZ2cOS4wNjH3DOCIJOXyKyHdplm-5HZw&oe=6B104D0C"}, {"file_name": "sc3.png", "id": "584823983390992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036692_584823986724325_8291326327419087112_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YR6MnPrtOsQ7kNvwE1n9Ep&_nc_oc=AdqixzSmB3JKZo19NoGzuOms2pfxc_pXYezRSwHa4aFVFSlCAS-xd1Qkr_7LQYUuuS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUY_Vom46tD27gw2-ffdc9xKtU4uUIhWAiY0qOmAyA98A&oe=6B10570F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1104649477080318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75500282_1104649480413651_7871445613027647639_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jiSlDOdcdQQ7kNvwHWMUpV&_nc_oc=Ado70D0aeHzKBRhxzF_aJWR6knGPWWlz_o0hEcZ0SJYuuwpKlsbS3seQY2EwS6NJmdY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXrXICyctqNgeh1ntqIUFXsOoUuBtSl0-T621B9AnKLFw&oe=6B10450F"}, "display_name": "Nanome", "keywords": ["Productivity", "Science", "Education", "Learning", "STEM"], "long_description": "Nanome is the ultimate interface for scientific discovery, starting with molecular data. With Nanome, top R&D labs conduct cutting-edge research but, Nanome isn\u2019t just for experts, it\u2019s also used by students and amateur scientists studying chemistry and biology. Anyone can build 3D molecules or simulate an entire protein made of hundreds of atoms, all in one collaborative environment. Transform the way you learn and design molecular structures with Nanome.\n\nSome features require subscription licenses. Visit nanome.ai/pricing for more infomation\n\nFeatures\n\u2022Import molecules from databases\n\u2022Build with any element w/ periodic table\n\u2022View different molecular representations \n\u2022Measure distances & angles\n\u2022Mutate amino acids \n\u2022Flexible python api plugin system for the custom computational integrations\n\u2022In-app web browser, whiteboard, notepad, and camera\n\u2022Spatial Recording: a transformative way to learn chemistry and asynchronously communicate molecular insights\n\u2022Meta Avatars\n\u2022Passthrough MR", "short_description": "Nanome is the ultimate interface for scientific discovery, starting with molecular data. With Nanome, top R&D labs conduct cutting-edge research but, Nanome isn\u2019t just for experts, it\u2019s also used by students and amateur scientists studying chemistry and biology. Anyone can build 3D molecules or simulate an entire protein made of hundreds of atoms, all in one collaborative environment. Transform the way you learn and design molecular structures with Nanome. Visit nanome.ai/pricing for more info."}]}, "developer_name": "Nanome Inc.", "developer_privacy_policy_url": "https://nanome.ai/downloads/Nanome-Privacy.pdf", "developer_terms_of_service_url": "https://nanome.ai/downloads/Nanome-TOS.pdf", "publisher_name": "Nanome Inc", "support_website_url": "https://docs.nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "MEDICINE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
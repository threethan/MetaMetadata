4879_848588210743937_6332883574121633268_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21EdWidMF8QQ7kNvwE-Ae4q&_nc_oc=AdrBKwywFVOcoeyR7YnQiunW7ZynpI7p_O8-hJnOo7VOd9gpzMuplrlyS5g-uhwuDOU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6iypLT5eIhVHwa1GSs1R2HY3Z3byx1pUKy1uJjG_wdw&oe=6AA14CA7"}, {"file_name": "\u5fae\u4fe1\u622a\u56fe_202409052019221.png", "id": "1064850925215128", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035364_1064850928548461_235034156146903613_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lw45M9Qh5F4Q7kNvwHz5s9q&_nc_oc=AdqyKBUs4Ohgvp3UlxtZErRAcJVL_zOkNNCpPK29-mWGcw1bMtg2oQPOOn1HDqRbcnM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuV-4KV7vL1XVqKdgPchxZFn9xe2srEKoFXWzmJigVdA&oe=6AA1557A"}, {"file_name": "\u5fae\u4fe1\u622a\u56fe_202409052024412.png", "id": "1027222682052964", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036657_1027222688719630_4691095364271922775_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0hzOZDY5R8Q7kNvwFcqdfa&_nc_oc=Adp-Vkm7Fqwe1f5HvBD9E-qZ777JaotZx2ugSx2CXXM8HaatnLE6rYv5dSvikgTxbn8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkq_1PmKXoVbfqRLPjQWbhoFZLrQ4kienXHsdhMO1Sxg&oe=6AA16C43"}, {"file_name": "\u5fae\u4fe1\u622a\u56fe_202409052036017.png", "id": "1158166763015236", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036688_1158166766348569_7576093945753263112_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW5oUFapOJYQ7kNvwHdIUkb&_nc_oc=AdoYUrbzKuiyouYClfTHE18DKZ1ynyQdTQfdhjqIb7puw9Q0HaKJy6clzV08VdlPUmg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK69H95NsPk2xUxU4M67jdSZtwJhgX5ixM-24QmlUgbIw&oe=6AA15380"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5fae\u4fe1\u622a\u56fe_202409052017561.png", "id": "486806884277322", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974795_486806887610655_7571555457014809771_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7EuMrVxGp8Q7kNvwENEKXC&_nc_oc=Adp-fu6MW23VrSqLxcyVYYHNEABsWCiGxS_QnuaIVfhvOIzmut8Qr0ghw-NYOdeVh_I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsUxdJyt72kbBTllcvussHVRx9bIdfs4AIOePlnNekaQ&oe=6AA172F8"}, "display_name": "SwordTrip", "keywords": ["Chinese", "Sword", "Fight"], "long_description": "You will enter cities in Chinese-themed environments with random time-of-day changes, encountering generous merchants or unexpectedly powerful elite warriors. As you fight, you will unlock new divine abilities and enhance your basic attributes, gradually challenging a variety of uniquely designed bosses.\n\nFeatures:\n    Chinese-style scenes with random time-of-day changes: Immerse yourself in environments reflecting Chinese cultural aesthetics with dynamic time shifts.\n    Comfortable VR interaction experience: The game offers smooth and active VR interactions such as small jumps and flying swords. The AI logic of enemies significantly reduces the need for constant movement, ensuring players experience no motion sickness while enjoying a comfortable interaction.\n    A faster-paced combat system: Unlike purely physics-based VR combat, SwordTrip features faster-paced combat, allowing you to experience sword clashes and slashes without the frustration of weapons getting stuck, offering smoother and more thrilling battles.\n    Unique roguelite divine ability system: Unlike other VR roguelites, where rewards primarily boost basic stats, SwordTrip introduces a divine ability system specifically designed for VR interactions, making each divine ability a delightful surprise!\n    Chinese cultural interaction hub: In addition to combat, players can engage in calligraphy or painting with a brush in the game, and even customize images on the hall\u2019s drawing board.", "short_description": "\"SwordTrip\" is a Chinese-style action roguelite VR game. Pick up your sword and grow stronger amidst the flashes of blades. Enjoy a unique skill system designed specifically for VR, allowing you to create and refine your favorite combat style."}, {"images": {"nodes": []}, "id": "539992845136179", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u5251\u9014", "keywords": ["\u5251\u9014", "SwordTrip", "\u4e2d\u56fd"], "long_description": "\u300a\u5251\u9014\u300b\u662f\u4e00\u6b3e\u56fd\u98ce\u52a8\u4f5croguelite VR\u6e38\u620f\u3002\u73a9\u5bb6\u901a\u8fc7\u5173\u5361\u5956\u52b1\u89e3\u9501\u795e\u6280\uff0c\u5229\u7528\u4e13\u95e8\u4e3aVR\u4ea4\u4e92\u8bbe\u8ba1\u7684\u6280\u80fd\u7cfb\u7edf\uff0c\u5b8c\u6210\u81ea\u5df1\u504f\u7231\u7684\u6280\u80fd\u6784\u7b51\uff0c\u4eab\u53d7\u5f3a\u5927\u7684\u6218\u6597\u529b\u4ee5\u51fb\u8d25\u654c\u4eba\uff01\n\u4f60\u5c06\u5728\u968f\u673a\u65f6\u6bb5\u53d8\u5316\u7684\u4e2d\u56fd\u7279\u8272\u98ce\u683c\u573a\u666f\u4e2d\u6740\u5165\u57ce\u5185\uff0c\u906d\u9047\u53ef\u80fd\u539a\u9053\u7684\u5546\u4eba\uff0c\u51fa\u5176\u4e0d\u610f\u7684\u7cbe\u82f1\u4fa0\u5ba2\uff0c\u6108\u6218\u6108\u52c7\u7684\u4f60\u8fd8\u4f1a\u968f\u7740\u6e38\u620f\u8fdb\u7a0b\u89e3\u9501\u65b0\u7684\u795e\u6280\uff0c\u5f3a\u5316\u4f60\u7684\u57fa\u7840\u5c5e\u6027\uff0c\u9010\u6b65\u6311\u6218\u591a\u4e2a\u5177\u6709\u4e0d\u540c\u7279\u8272\u7684BOSS\u3002\n\n\u7279\u8272\uff1a\n\uf075\u968f\u673a\u65f6\u6bb5\u53d8\u5316\u7684\u4e2d\u56fd\u7279\u8272\u98ce\u683c\u573a\u666f\n\uf075\u8212\u9002\u7684VR\u4ea4\u4e92\u4f53\u9a8c\uff1a\u6e38\u620f\u4e2d\u8bbe\u8ba1\u4e86\u5c0f\u8df3\u3001\u98de\u5251\u7b49\u8212\u9002\u4e3b\u52a8\u4ea4\u4e92\u65b9\u5f0f\uff0c\u540c\u65f6\u654c\u4ebaAI\u903b\u8f91\u4e5f\u6781\u5927\u51cf\u5c11\u4f60\u7684\u79fb\u52a8\u9700\u6c42\uff0c\u4fdd\u8bc1\u4e86\u73a9\u5bb6\u6e38\u73a9\u8fc7\u7a0b\u4e2d\u4e0d\u4f1a\u4ea7\u751f\u7729\u6655\u611f\uff0c\u63d0\u4f9b\u4e86\u8212\u9002\u7684\u4ea4\u4e92\u3002\n\uf075\u66f4\u4e3a\u723d\u5feb\u7684\u6218\u6597\u7cfb\u7edf\uff1a\u76f8\u6bd4\u4e8e\u7eaf\u7269\u7406\u6a21\u62df\u7684VR\u6218\u6597\uff0c\u300a\u5251\u9014\u300b\u62e5\u6709\u8282\u594f\u66f4\u4e3a\u5feb\u901f\u7684\u6218\u6597\uff0c\u4f53\u9a8c\u5200\u5251\u78b0\u649e\u548c\u6325\u780d\u7684\u540c\u65f6\u4e0d\u5fc5\u62d8\u6ce5\u4e8e\u6b66\u5668\u5361\u4f4f\u7684\u7a98\u5883\u3002\n\uf075\u72ec\u7279\u7684\u8089\u9e3d\u795e\u6280\u7cfb\u7edf\uff1a\u76f8\u6bd4\u4e8e\u5176\u4ed6VR\u8089\u9e3d\u6e38\u620f\u7684\u5956\u52b1\u51e0\u4e4e\u4ec5\u5bf9\u57fa\u7840\u5c5e\u6027\u63d0\u5347\uff0c\u5145\u5206\u8003\u8651VR\u6e38\u620f\u5bf9\u4e8e\u6218\u6597\u6570\u636e\u4e0d\u654f\u611f\u7684\u7279\u8272\uff0c\u300a\u5251\u9014\u300b\u4e13\u95e8\u8bbe\u8ba1\u5e76\u5f00\u53d1\u4e86\u57fa\u4e8eVR\u4ea4\u4e92\u7684\u795e\u6280\u7cfb\u7edf\uff0c\u76f8\u4fe1\u6bcf\u4e00\u4e2a\u795e\u6280\u90fd\u4ee4\u4f60\u60ca\u53f9\uff01\n\uf075\u5177\u6709\u4e2d\u56fd\u6587\u5316\u4ea4\u4e92\u7684\u5927\u5385\uff1a\u73a9\u5bb6\u5728\u6253\u6253\u6740\u6740\u4e4b\u4f59\uff0c\u4e5f\u53ef\u4ee5\u5728\u6e38\u620f\u4e2d\u5229\u7528\u6bdb\u7b14\u4e66\u5199\u6216\u7ed8\u753b\uff0c\u751a\u81f3\u662f\u81ea\u5b9a\u4e49\u5927\u5385\u753b\u677f\u91cc\u7684\u56fe\u50cf\u3002", "short_description": "\u300a\u5251\u9014\u300b\u662f\u4e00\u6b3e\u56fd\u98ce\u52a8\u4f5croguelite VR\u6e38\u620f\u3002\u62ff\u8d77\u5251\uff0c\u5728\u5200\u5149\u5251\u5f71\u4e2d\u4e0d\u65ad\u6210\u957f\uff0c\u4eab\u53d7\u4e13\u95e8\u4e3aVR\u6253\u9020\u7684\u79d8\u7c4d\u7cfb\u7edf\uff0c\u6784\u7b51\u4f60\u6700\u559c\u6b22\u7684\u6218\u6597\u6d41\u6d3e\u3002"}]}, "developer_name": "OB Game", "developer_privacy_policy_url": "https://docs.google.com/document/d/1aqUBM25j91XePElIZTMvBoLXG9VoU-NWBpUfKJiDZDQ/edit#heading=h.tyrw81i0phpd", "developer_terms_of_service_url": null, "publisher_name": "OB Game", "support_website_url": null, "website_url": "https://linktr.ee/SwordTrip", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{
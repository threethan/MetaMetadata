ss=7f20f&oh=00_AQPs8EqAs60I4nh9H7f8nzMpJ20eKQDydUdkXoycY0ObRw&oe=6AC8FEE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-01-09 181523.png", "id": "9084397391616400", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031612_9084397404949732_2477358446331235604_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GY44ooDyXmgQ7kNvwGKlh8Z&_nc_oc=AdoVtwzqJgrQPXqReLmYBvgouqVwZdi_N303l_RA8oMm3SwhEN15sq_MnH4KInndbIg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPWKaZPjAOqKkWVQalvsHnkwJUgfSPV7_uNyuADEGgEQ&oe=6AC8EFA7"}, "display_name": "Office io", "keywords": ["office", "Managment", "Comfort", "ArcadeIdle", "Idle"], "long_description": "Office IO takes you into the heart of a vibrant virtual office, designed exclusively for the Meta Quest platform. Experience the fast-paced and engaging world of modern office life as you tackle challenges, interact with a dynamic virtual team, and complete tasks that test your problem-solving skills and strategic thinking.\n\nWith high-quality visuals, intuitive VR controls, and a touch of humor, Office IO delivers an immersive office experience like never before. Organize your workspace, manage projects, and lead important meetings while exploring beautifully crafted office environments. Whether you're optimizing workflows, handling workplace challenges, or climbing the corporate ladder, every moment in Office IO is engaging and rewarding.\n\nDesigned for a broad audience, Office IO offers a unique and entertaining take on office simulation, making it a great addition to your Meta Quest library. Step in and redefine what it means to work smart and play hard!", "short_description": "Office IO is a vibrant and engaging simulation game designed for the Meta Quest platform. Step into the dynamic world of a modern office, where you manage tasks, collaborate with virtual colleagues, and solve challenges to advance your career. With immersive environments, intuitive controls, and playful mechanics, Office IO delivers a fresh and interactive take on office life.\n\nBlending fun, strategy, and creativity, Office IO offers an exciting VR experience that captures the essence of workpla"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28681856214738762"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2605347409889505"}, {"status": "PUBLISHED", "id": "873786515725873"}, {"status": "PUBLISHED", "id": "2376918042772066"}, {"status": "PUBLISHED", "id": "1612265416606182"}, {"status": "PUBLISHED", "id": "1120632486541064"}, {"status": "PUBLISHED", "id": "1345299430088709"}, {"status": "PUBLISHED", "id": "1423472645285924"}, {"status": "PUBLISHED", "id": "2379189909107636"}]}, "baseline_offer": {"id": "1423472645285924"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787079600, "status": "PUBLISHED", "id": "2605347409889505"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_tes
0D3TTYVbv2Kx5RIKA-QRbDQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBBW0wOSh1Sr3bPyAymhB-fCTl4-22K1T6C7S94t7ZLQ&oe=6AFF2193"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "167780120485320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162711_167780123818653_1745195269932187648_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5LRj-3U00gQ7kNvwG4D2XV&_nc_oc=AdpevV6zj2ZwW7XwHNARGCpcroM2_vS5H_nEtyuDTCcLZt5vonWEEDtAU5ZepjJfYDI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVVnhQW7YFaT5cGWFPjQKI5ap65UmRWVcWkRQleK_6aQ&oe=6AFF34C8"}, "display_name": "Tricky Tanks", "keywords": ["shooter"], "long_description": "Tricky Tanks is a tricky shooter with voxel style graphics. \n\nMove your tank through different battlefields and shoot all tanks. With increasing levels the tanks appear in different colors which mean different skills. Also the battlefield settings varies at each level.\n\nThe controls are intuitive and support the head mounted touch controller, the Gear VR controller or a game controller. \n\nThe difficulty is adjustable by activating markers which indicate the position of the tanks.", "short_description": "Tricky Tanks is a tricky shooter with voxel style graphics. \n\nMove your tank through different battlefields and shoot all tanks. With increasing levels the tanks appear in different colors which mean different skills. Also the battlefield settings varies at each level."}]}, "developer_name": "Marco Preiss", "developer_privacy_policy_url": "http://www.jatrix.de/trickytanks/#policy", "developer_terms_of_service_url": "http://www.jatrix.de/trickytanks/index.html", "publisher_name": "Jatrix", "support_website_url": null, "website_url": "http://www.jatrix.de/trickytanks/index.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": n
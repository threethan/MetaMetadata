711_167780123818653_1745195269932187648_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvLK2DSRZ0cQ7kNvwF2628e&_nc_oc=AdqCQP7wa2bZ7mlXS9fKbdeeg6nCacjZheloWKnfnduzq5-xhTaxe7LUosWuSAGOZFA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInbT-MqdqmnEF9K5x2uw4s4P37vm8BLrpqiXt7_GiBuA&oe=6AAE9108"}, "display_name": "Tricky Tanks", "keywords": ["shooter"], "long_description": "Tricky Tanks is a tricky shooter with voxel style graphics. \n\nMove your tank through different battlefields and shoot all tanks. With increasing levels the tanks appear in different colors which mean different skills. Also the battlefield settings varies at each level.\n\nThe controls are intuitive and support the head mounted touch controller, the Gear VR controller or a game controller. \n\nThe difficulty is adjustable by activating markers which indicate the position of the tanks.", "short_description": "Tricky Tanks is a tricky shooter with voxel style graphics. \n\nMove your tank through different battlefields and shoot all tanks. With increasing levels the tanks appear in different colors which mean different skills. Also the battlefield settings varies at each level."}]}, "developer_name": "Marco Preiss", "developer_privacy_policy_url": "http://www.jatrix.de/trickytanks/#policy", "developer_terms_of_service_url": "http://www.jatrix.de/trickytanks/index.html", "publisher_name": "Jatrix", "support_website_url": null, "website_url": "http://www.jatrix.de/trickytanks/index.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_mod
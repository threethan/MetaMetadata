99618093_1853283946072044_2772755658415629446_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJwuZLGnNYMQ7kNvwGXI5A5&_nc_oc=AdnvDxKU0pM_ub4g6jVcAjzxtWerfaXWFW2JPDrn2Ww7AfHnCOc6wrRoxHDwUD-nLCY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftodYsssEJTSTwD1xXXExnlPeB7iANxGTzDH6rXVAH4MA&oe=699C3E05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyVisionFirst Landscape (3).png", "id": "1382461536789220", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619594_1382461543455886_7948902597013940080_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wublXfFZn7IQ7kNvwFe1XEK&_nc_oc=AdnHT95BOaacxy4-uiRLAJlgfTf8b96RwTVzem-6kiCWpnogALjRO67EbNWAsEV4HEc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsi2xRBtfNdwpR0rugeBpeARF-GMF9v4t0iCOXLfPSc6A&oe=699C40CB"}, "display_name": "MyVisionFirst Vision Training", "keywords": ["visiontherapy", "braintraining", "visionexercise", "eye", "brain"], "long_description": "MyVisionFirst Vision Training is an advanced virtual reality vision training platform by Neuro-Optometrist Dr. Bryce Appelbaum to unlock the full potential of your visual system. Built on the science of neuroplasticity, the program helps you train the connection between your eyes and brain using immersive 3D environments that challenge and strengthen visual performance.\n\nEach module targets key visual skills\u2014focus flexibility, depth perception, tracking, eye teaming, and visual processing\u2014through guided, gamified sessions that are both engaging and clinically effective. By integrating measurable feedback and real-time performance tracking, MyVisionFirst Vision Training allows patients and clinicians to monitor progress and optimize results over time. \n\nUsed in functional vision practices and by individuals worldwide, this system bridges the gap between clinical care and at-home reinforcement, helping users see, think, and perform at their best\u2014whether recovering from visual challenges, enhancing sports performance, or optimizing focus in today\u2019s screen-driven world.", "short_description": "MyVisionFirst Vision Training is a cutting-edge virtual reality vision training system by Neuro-Optometrist Dr. Bryce Appelbaum. It helps retrain the eye-brain connection for better visual performance\u2014improving focus, depth perception, and eye coordination\u2014through immersive, science-based exercises designed for home or clinic use."}]}, "developer_name": null, "developer_privacy_policy_url": "https://myvisionfirst.com/privacy-policy-vr/", "developer_terms_of_service_url": "https://www.opticstrainer.com/terms-of-service/", "publisher_name": "MyVisionFirst", "support_website_url": null, "website_url": "https://myvisionfirst.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24346142551728486"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303976_875685184805997_670152725190907335_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PS392HP_cnIQ7kNvwHtvp4e&_nc_oc=AdlpxzoNGN4xpYPu2Me5X8qq12Ig9MwE_vWeTPcYDl1eYfuD-pQEr36kMuwWoeTTV6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftgudiy3AIfY9sk8uy-ciMpYG6uP8h87KbpfGb146KPsQ&oe=699C662F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MyVisionFirst Vision Trainin
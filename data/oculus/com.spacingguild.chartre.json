n-MDdjz77OA2uWUZpl77w&oe=6B105DE3"}, {"file_name": "screenshot_20261114_183726_809.png", "id": "1603764895102920", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828008_1603764898436253_4206632787396647663_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1L90OgeAU8Q7kNvwGtGS3X&_nc_oc=Adp091Lid7n38bmAHnb9ms44BB1NHetF20yZgIQMCA4W6Jxd54Bb8S2-gC1YIPd-eIg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUFPyEYkEcTjH3YIdrJATT1aJXVI9QS4ejAYbH3-oZnOQ&oe=6B104126"}, {"file_name": "screenshot_20261114_194432_466.png", "id": "29091024580563192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828008_29091024600563190_610975371164462191_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_qslNtMJtQQ7kNvwGIkCiU&_nc_oc=Adq1x-rW4YuSarKNTw3tNonGnNVO6BFH6LeWUDKjY7ozWwtmHZ2cgVqyEzeEZw3qCpI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX6nH844dMStnEFRaYwKrp7kZNgMXNRzIzHU-nfWf4tvg&oe=6B1036C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meditate with the tables of chartres", "keywords": ["meditation", "meditate", "visual"], "long_description": "Practice the Tables of Chartres in virtual reality.\n\nThe circle, the square and the rectangle: three simple shapes that make up a meditative practice for focus and inner calm. Soften your gaze until the shapes merge into one, and let your mind settle.\n\nFeatures\n\u2022 A guided introduction teaches the technique step by step\n\u2022 Peaceful environments, from island beaches and starry nights to mountain summits, a painted valley and outer space\n\u2022 Passthrough mode: practice with the shapes floating in your own room\n\u2022 Adjustable shapes, ambient soundscapes and a practice timer\n\u2022 Gentle practice tips that unlock as you keep practicing\n\nAbout the Tables\nAdditional info about meditating with the tables of chartres can be found online. The developer does not provide any.", "s
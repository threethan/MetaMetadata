QBBIZZXMKjUdavPcqzoLg&oe=6B0C6963"}, {"file_name": "screenshot_20261114_183726_809.png", "id": "1603764895102920", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828008_1603764898436253_4206632787396647663_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7W8YIApzUHUQ7kNvwFqtj63&_nc_oc=AdrN9vLDcJ4mM8ezWnpeUxP4PwNaLZJWmcyhiRFVeOQ44jc1kbiWkT4VHXiuzLF09cA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSb0t5LnYcXSDPDLa68EnlFDGT7JJgfWhPNT1p6LYlzCA&oe=6B0C4CA6"}, {"file_name": "screenshot_20261114_194432_466.png", "id": "29091024580563192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828008_29091024600563190_610975371164462191_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtQBbi0ka9sQ7kNvwEOtzzd&_nc_oc=AdqiZlJPqlDqsYeiOq6i-fK5_bbSpTFL3zg1derYuK4G5C7X19st18kfL47p5MjxjV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTw0FUUKL__IYM6ABqvzM3nAhexAcX-cr3wkhfc07dUZg&oe=6B0C7A80"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meditate with the tables of chartres", "keywords": ["meditation", "meditate", "visual"], "long_description": "Practice the Tables of Chartres in virtual reality.\n\nThe circle, the square and the rectangle: three simple shapes that make up a meditative practice for focus and inner calm. Soften your gaze until the shapes merge into one, and let your mind settle.\n\nFeatures\n\u2022 A guided introduction teaches the technique step by step\n\u2022 Peaceful environments, from island beaches and starry nights to mountain summits, a painted valley and outer space\n\u2022 Passthrough mode: practice with the shapes floating in your own room\n\u2022 Adjustable shapes, ambient soundscapes and a practice timer\n\u2022 Gentle practice tips that unlock as you keep practicing\n\nAbout the Tables\nAdditional info about meditating with the tables of chartres can be found online. The developer does not provide any.", "s
5vca56VuiRyv8qoPowDLw&oe=6B0DBAE3"}, {"file_name": "screenshot_20261114_183726_809.png", "id": "1603764895102920", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828008_1603764898436253_4206632787396647663_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1L90OgeAU8Q7kNvwGLOhis&_nc_oc=AdrQpbyXKe6BEErBCEEUS4qcEYiWy_27ruzHuYH-WLjx0EPwqxguFVmb6pUDKR2_RX0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRatG5Av4C4DlEnSctzq22QrWH9GVoMd1ydbdNefBMFFw&oe=6B0D9E26"}, {"file_name": "screenshot_20261114_194432_466.png", "id": "29091024580563192", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828008_29091024600563190_610975371164462191_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtQBbi0ka9sQ7kNvwEAoarw&_nc_oc=Adrc39qXHWoWp16QJvHbSXBIiuu85r_jeKfSEfCdr6B_H1unrw3b8rHOk7r9s_E47kc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS63Iv2OtYOfIhmJBkjV6cO2RBWnh8RUULTVfR7_26c7g&oe=6B0DCC00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meditate with the tables of chartres", "keywords": ["meditation", "meditate", "visual"], "long_description": "Practice the Tables of Chartres in virtual reality.\n\nThe circle, the square and the rectangle: three simple shapes that make up a meditative practice for focus and inner calm. Soften your gaze until the shapes merge into one, and let your mind settle.\n\nFeatures\n\u2022 A guided introduction teaches the technique step by step\n\u2022 Peaceful environments, from island beaches and starry nights to mountain summits, a painted valley and outer space\n\u2022 Passthrough mode: practice with the shapes floating in your own room\n\u2022 Adjustable shapes, ambient soundscapes and a practice timer\n\u2022 Gentle practice tips that unlock as you keep practicing\n\nAbout the Tables\nAdditional info about meditating with the tables of chartres can be found online. The developer does not provide any.", "s
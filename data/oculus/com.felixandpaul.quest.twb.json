oe=6A9C3F76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/8DtJFC", "id": "769731000148554", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974765_769731003481887_149131538078892032_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yah7fUH6gu0Q7kNvwF-VxJD&_nc_oc=AdoZZeKZ_eoXmpv9AfqkFFBjz7dbIGE5hz6h2L80vIGCfemKzeRw1_QR8U5DwNCdidM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINMl4sydimGvfv5TX1-CutPNzzr1maV2bxmrUnqsFhEg&oe=6A9C20B3"}, "display_name": "Traveling While Black", "keywords": ["Travel", "Freedom", "Sundance", "Felix", "Movie"], "long_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities.\n\nAcademy Award winner Roger Ross Williams and Emmy Award-winning Felix & Paul Studios' film transports you to historic Ben's Chili Bowl in Washington DC. The viewer shares an intimate series of moments with several of the patrons of Ben's as they reflect on their experiences of restricted movement and race relations in the U.S. \n\nConfronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to not only remember the past but to learn from it, and facilitate a dialogue about the challenges minority travelers still face today.", "short_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities. Visit historic Ben's Chili Bowl and join patrons as they share and reflect on their experiences. Confronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to facilitate a dialogue about the challenges minority travelers still face today."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url":
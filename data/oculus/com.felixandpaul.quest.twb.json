9L8WZ_RXMQ7kNvwGw3sR_&_nc_oc=Ado-WWasNZXRrpZaKfeowy7-qarSiheeTebin9jSVOCjBdI0ilW_8p5jagHCTTiOJvo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1MVI3A56Q9L6QwtrcNaTNjCgDnXxzJs_rnsU0jH8KtA&oe=6AFB3150"}, {"file_name": "migrated_image.png", "id": "194962201920289", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974640_371040416908649_8619036792181489664_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Z59vAjVOzkQ7kNvwH3ELcF&_nc_oc=AdoJwWfKE8hOxisTF1ulKYDBtiFM-vNR_RrCZuTE-jMECakYGMvgcWUserb9hNeswb8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjXTR-3f72a7BmEBy_Cg4amkE5VUIrBWgq0afGIBdwZA&oe=6AFB2B76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/8DtJFC", "id": "769731000148554", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974765_769731003481887_149131538078892032_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EtNZCShjWQQ7kNvwEjxiD_&_nc_oc=AdpdvbP8zPfoyzU4cJbfgtqQCgrVqllJoisDehJh_W1NvkFlOV3xKv8k9N7OEp17OUA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaxruLV5TGaVa9Xh2jdjd3PYFyDpC8LCWoO62kxkzK6w&oe=6AFB44F3"}, "display_name": "Traveling While Black", "keywords": ["Travel", "Freedom", "Sundance", "Felix", "Movie"], "long_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities.\n\nAcademy Award winner Roger Ross Williams and Emmy Award-winning Felix & Paul Studios' film transports you to historic Ben's Chili Bowl in Washington DC. The viewer shares an intimate series of moments with several of the patrons of Ben's as they reflect on their experiences of restricted movement and race relations in the U.S. \n\nConfronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to not only remember the past but to learn from it, and facilitate a dialogue about the challenges minority travelers still face today.", "short_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities. Visit historic Ben's Chili Bowl and join patrons as they share and reflect on their experiences. Confronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to facilitate a dialogue about the challenges minority travelers still face today."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "https://www.felixandpaul.com/privacy", "developer_terms_of_service_url": "https://www.felixandpaul.com/license", "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "319217486805522"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1292775990904538"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1568394000, "status": "PUBLISHED", "id": "1292775990904538"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test
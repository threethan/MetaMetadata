.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLqs5cw1DiMQ7kNvwECquDR&_nc_oc=Ado6ry6i7uJHzkImzwwBCTAYC9mMyZOSG62Cp8KLFiHh2VJU-QFbj3dvmZvikbETz0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_biimN6XqXYVExYLo2z-p-Jjb9cjN79hp39qJf08JCA&oe=6B05A392"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75196228_959140557801733_2761266729802792960_n.png", "id": "716448385683270", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_716448389016603_2302833598379675402_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPrO-ceYbt4Q7kNvwFAGNGY&_nc_oc=AdpACKSux5rmrTt8VI0QTYYfnwzcZr7kZvA-J5J6LfIfpsZM9zy7kOQJyDDyDIqtrRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC5ArmbCAZH8ArxGmcLkpl0dPGUPLc5SQAZ1XzI3bmlg&oe=6B05BE1F"}, "display_name": "Work Window", "keywords": [], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires you to go through a set up process on first login that can take about 20 minutes that downloads additional assets before you can play. For more information on this and app permissions please go to: https://support.workwindow.com.au/en", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://support.workwindow.com.au/en", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "338697318262763"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1586244282025198"}, {"status": "PUBLISHED", "id": "3952816711464637"}]}, "baseline_offer": {"id": "1586244282025198"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737334020, "status": "PUBLISHED", "id": "1586244282025198"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28821592037444397", "version": "10.2.4677"}, "id": "2829450057303158", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3901430703220542", "is_concept":
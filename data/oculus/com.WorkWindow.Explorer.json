c_sid=6e7a0a&_nc_ohc=pOgUhGJPs1YQ7kNvwGFd8nJ&_nc_oc=Adphqrt-bFXIuKgevR7nI6Vyvrj1D790iUt0_Zud7w72u9E51XNMuzh5-hqgO7N8h3E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iCsH_H8rrhqVtKHbNlq-ksFGSzUYR11QzX6FcEPyIdg&oe=6A031DA6"}, "display_name": "Work Window", "keywords": ["careers", "career", "education", "work", "window"], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. \n\n\n", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. "}]}, "developer_name": "Work Window", "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://workwindow.atlassian.net/servicedesk/customer/portals", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873
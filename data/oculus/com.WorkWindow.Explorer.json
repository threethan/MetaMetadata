4145635798_2398443249632462471_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UBqwiTld20Q7kNvwGTxDXR&_nc_oc=AdpzNYCIfIDCeg9YgRpaqSFfoQ-fel8VwBEJmW79ZrM_Bho03y5bZtg3ARA1nUJ7Xd4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt6u5ImPvRDeaufvAfHikgEN-iYzVICaWCnsOedUFaTA&oe=6AA93C79"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUfn-wh_adgQ7kNvwFuwUJL&_nc_oc=AdoP5ICIbOnIeVQdf7jhvlz_MV0jVHCs2VGR6v2vhCG8cDXBiS9LH3G49DNjhBRTd9c&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr5hZIRc1WuBJj1UjaXvM4ZRELz7rs1vdzcCPH501fag&oe=6AA95124"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUoHIQbwSFIQ7kNvwEWrCIp&_nc_oc=AdpieimfIVosKZ7KurF2PfYBueRHcstSesHyWs3Y7dY4ZB5rKblcd9yWc5kjjmKZ7Rs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6uCJR_hfrwnwR5ZlndmEMgOnvkIkw5bwRnwHPAJ5Byg&oe=6AA93C3B"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTsmF9RsLNIQ7kNvwHZ5ibF&_nc_oc=Adr-uqtQhv0VI1oTWmKt-EJ_2niHCbsTA7O001DoogoCDO_WaWmUu6lN_l4tnayMhvA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnRAqw5ZaQFbMo3zcuaFM7xCsodvulmVOY2JsOpymNHw&oe=6AA95A92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metaStore_coverart_landscape_1260x1440.png.png", "id": "9472476746144168", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473402619_9472476749477501_8390684063437743400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0zr54Tz1O8Q7kNvwH_7Fa7&_nc_oc=AdoHNT--D1eeUUoo_0kYyjuSo2trv86NmAyEhel4PhWfgUZCCYxNAV5c03MPcWvX768&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHWQn63lLBVJ14wni7NPOseMTHOFfsTNpgpV1ggk_Ilw&oe=6AA93AA6"}, "display_name": "Work Window", "keywords": ["careers", "career", "education", "work", "window"], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. \n\n\n", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. "}]}, "developer_name": "Work Window", "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://workwindow.atlassian.net/servicedesk/customer/portals", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626
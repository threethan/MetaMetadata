c_oc=AdrO7HdH_QG5gq5yJSI2QI0RE8Ktj7Ym5kc3HRjGIfullFRQEQPIce2DNnuhRZvTAy8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADnk4bLhL5vdINLyK0dkrK_MaJsiVUuvxeq-Sb1rmOSQ&oe=6A4E44F9"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0H-73NfNn4Q7kNvwExdij5&_nc_oc=AdrVsffrgsAdJBr3rie2pzSyR--7fZF_CZAUxoDBX7z6GnPGFdudiY3CPCktoYij8ZE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUl4QuzeL8AFbgYUWJ6HPZLCO6tTm3oEo-xv3JNEm1hw&oe=6A4E59A4"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UejDPz6rZR8Q7kNvwFX4LbR&_nc_oc=AdpmBxiO6JXOgF4WzhGd1G0o1vwUWfYTWACDmiGXGvt1fR6CvjaUBbYdhGMWd7pNBWk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU5mFnfal5v62S4jqXizbNb9hqr2c0FO30t2Qk14Mfuw&oe=6A4E44BB"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SM8oOM8UAbsQ7kNvwHeKY3r&_nc_oc=AdpggFgW9Zi1nsdy32T7zmUMgcVAPeEG3iraQdvL1GdpEaixi0xZz8-9BF0XnUxhe9A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5V2JukdVxbBtCX2rvtvndIpaWw7Jiq8kg0i6pY9h-Wg&oe=6A4E6312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75196228_959140557801733_2761266729802792960_n.png", "id": "716448385683270", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982696_716448389016603_2302833598379675402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPJcGNDACAkQ7kNvwFcrT18&_nc_oc=AdprbouigfJtHM8l0gnYa3---n7I99Lj5He2LVzDrA6RFh68ybnLsh-YJtcPlKq2aTI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGlIgNlZ9P4epm97T09Hq6CMVP9VinRZSI1fEItlaQXw&oe=6A4E455F"}, "display_name": "Work Window", "keywords": [], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires you to go through a set up process on first login that can take about 20 minutes that downloads additional assets before you can play. For more information on this and app permissions please go to: https://support.workwindow.com.au/en", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://support.workwindow.com.au/en", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics"
5798_2398443249632462471_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Udwky-fFHPgQ7kNvwHomd2A&_nc_oc=AdriqW6EGQvpTaPw1WfddIBcyP2P_cZo-HwvaigQtsu48Zajilx4p4mBpXRMsRRz2z4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af289-K0kaxIB3zvtlOWjTXRQ4Fa2m-2_wwl4Hy9gFihLA&oe=69DA40F9"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqWEjO68Uk4Q7kNvwHHJfQA&_nc_oc=Adq2Ja2bZZ5OFbhbREBOcdB4cWA_jvBy8arK90RwCIYFXgpRWSQOtay4Js20-urLMBU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UDarcAtJkDQb6GH0PlJZk8p75fHkrUnGR9tzcVJa5eA&oe=69DA55A4"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDHJS6LgvQ4Q7kNvwHUv1uQ&_nc_oc=AdpsNyI0xPRrlHhsUdslmpCEYEW8m0_Q0IHy2pXtO5fumpZ00qhQi6qDXsqKihlcZgI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UQKdfzVeANqMgvxj1BN5DreDJIY5FG12Hp3X5PDblAA&oe=69DA40BB"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OV409URU0gQ7kNvwGnCRV_&_nc_oc=AdrQk_MAjEIpp60c-D14wTSdR00sT27J6TlcBCRO40O1unUqLOCdEOix6_jmvIK5djM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vM4Ful649AZC-k9kiUth4-thZ6Q4aHgqr1DRBgMrFww&oe=69DA5F12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metaStore_coverart_landscape_1260x1440.png.png", "id": "9472476746144168", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473402619_9472476749477501_8390684063437743400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGTNF2badXcQ7kNvwH5ghZn&_nc_oc=AdovCaaBluwbBrkCiTEI_4jS5XwVnyaXbfYndbEBBm2t7eyVnC0SZrvJkFbMMArdWq4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27SFC2CDVw5MNcGgpirnCsUl6NRVQplAmsBmLnAWn40Q&oe=69DA3F26"}, "display_name": "Work Window", "keywords": ["careers", "career", "education", "work", "window"], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. \n\n\n", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. "}]}, "developer_name": "Work Window", "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://workwindow.atlassian.net/servicedesk/customer/portals", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873
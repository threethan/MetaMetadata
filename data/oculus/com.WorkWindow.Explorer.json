c_oc=AdrZO6Ulxs0d0ADdq7gL6_Ip5Gi7jeGLCHkyz0bi6kV2QhnIqSLxksmhfL9o3clvg-w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91YoMn0enxTt4hgqhaHr2EzUXr6DBZi2SBJMccd-NQ5g&oe=6A244D39"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIowNM3t4xcQ7kNvwGYFfj4&_nc_oc=AdpDPl0m0lpz37fst2vcyRn3CzdkSuRnxy6ZaxUMKkUKlMBSB0DqcHFU7WK6eMYofgY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ioYK5tvcpGxYlIjUcrBoViHCCVMj9KmIE388689scag&oe=6A2429A4"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtWk4z4cBJMQ7kNvwFdKdWV&_nc_oc=Adqx9burcUaW39Sbgy1DbQPHaLg41VB2xDQmhI66QNnSHA0v55o_cCIjqxCXwrCaXhk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GCaRnPMT2uJuiWDiKycSyu8yLeNxMAs2f_n28nRumGQ&oe=6A244CFB"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBeUIFmk_akQ7kNvwGWU3SE&_nc_oc=AdqS32V3jqSc866xLwa-9960FiudSGIGrki6dTWgtAFWQhanLe33u9gpfQJT3S4BEsc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CjuNF_r2QQw6KTS7x16so6Khrpk-fmgh2nsM7p91iWg&oe=6A243312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75196228_959140557801733_2761266729802792960_n.png", "id": "716448385683270", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982696_716448389016603_2302833598379675402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91dAh9eALtQQ7kNvwElG-So&_nc_oc=AdpmegXun-UliZKLD-eA5OH_JcC55-PShu60D_Ki0xjoFfF_tzNWQDO3a863pUIrMPI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GmtYVKlwrfpvJRG49KL4vs0ut7Y-kG9HUtdxY5ax9tw&oe=6A24155F"}, "display_name": "Work Window", "keywords": [], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires you to go through a set up process on first login that can take about 20 minutes that downloads additional assets before you can play. For more information on this and app permissions please go to: https://support.workwindow.com.au/en", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://support.workwindow.com.au/en", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics"
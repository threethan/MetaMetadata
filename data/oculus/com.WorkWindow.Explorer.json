_oc=AdqwT8gzr7pnHRHOp-wRM2c_3SGEDIZMKkXeP2geUncN7_RGLqHEfYgg1HvGM9RnKI8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iamyNJLn_4QYvkzGhDIY8Jtnl-nY0Mak7wTnSRBlvcA&oe=6A09B6F9"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9NfKVT8iFwQ7kNvwHkPBmR&_nc_oc=AdqD1pQ_goVN4LRllfMRxrqwDL0SFHTn93M91FOTmJbbGbkfoFehIAobGoCH36MDoDA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o6RV7U9PowiD8BPMCoRM7LYimhZ35IGtaqZ5-WH6o2Q&oe=6A09CBA4"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-wDBmuMtAQQ7kNvwFuHRW4&_nc_oc=AdpUnfeQEcPxx0WiZ-208L9Wk7AzmilKUGBy5SY7IbDfwczEJ5B60bXGECo1XjmQ8Xo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q-hx-FC44OkeXqyOzvz6PB0Dc5Wf09sOhH4thJjLuAw&oe=6A09B6BB"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6c5B9tx0VIQ7kNvwEtU6Aa&_nc_oc=Adpdw2exPrOIZ3OIGab32EdVXqJ17GjsLeiAep5tTpkqyqsvq9H4CV7-pMLyo8nnN5c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wqWB2FzR-d0YJGMyZYjUehlMF0vjPSccYBY3SQnHe6A&oe=6A09D512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75196228_959140557801733_2761266729802792960_n.png", "id": "716448385683270", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982696_716448389016603_2302833598379675402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUq8bNtmb14Q7kNvwETCn9Y&_nc_oc=AdqGuGyHpnJMdIJnnk26YmI3UfrT2UCUQCNYNy0aJP_8iXIZa2Zxdv7uCUTb81BHe6M&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5D8B_2txn8VKmTOkeI3G-owJWz-gTYLfKbp5SNImvDQQ&oe=6A09B75F"}, "display_name": "Work Window", "keywords": [], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires you to go through a set up process on first login that can take about 20 minutes that downloads additional assets before you can play. For more information on this and app permissions please go to: https://support.workwindow.com.au/en", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://support.workwindow.com.au/en", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics":
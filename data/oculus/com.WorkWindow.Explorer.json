c_oc=Adp1oY_E4bB8bO7Zj8Tv_6WDYrAg9FARsSJP84_FUdLNrCikukE6_09Jk_w4F561CCE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmxMZPgAS_OFPN3XpKs78P3URCGgGiSCfDQ6BH6tNM9g&oe=6AD3A4B9"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jSq_1LNTzAQ7kNvwFGRbsE&_nc_oc=AdpSiYw8YINz_d3Q7gqLfaoegZgAMZZWW3SZCqc2RuS2tehse9XvnvLAQXCd5F_XBIA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtmY2E7_zQhe-6SvZii2RvYY_89BEyOO3DENjtfv6m3Q&oe=6AD3B964"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5w983Oe4NyMQ7kNvwEuWMBh&_nc_oc=AdrCMtavKvMkNGBWSdQN61hFwHZbio3__yvlRIkjIIuV6VvyE8mTZjyGjSmA0WN-suQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrCbHBPMd0Tg-0a_FNdHwpaB4ZuPYRPAA7IKp8XXm3rw&oe=6AD3A47B"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cUZKqHtAeEQ7kNvwExYwqG&_nc_oc=Adph_TJeOlI7A-ZgbQ4jEM6BuEx6sB5KbjflqdZ5EXOuH1dRqbYyXvHSqlHsacn4OXI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDfnY-h_wmXEc05miP8hYxI97GRHBHyE8ovEaBNKACuw&oe=6AD38A92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75196228_959140557801733_2761266729802792960_n.png", "id": "716448385683270", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982696_716448389016603_2302833598379675402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ty_uUUboFEUQ7kNvwE_eumz&_nc_oc=Adr19QakIWXc0SeRJk0rY4AsgGSGj8f7FlUy7zSAxLJ6hiyTXYDz4JKjOhBvPTQA93c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZ96v5TQTPPOD0QfjFR-dj5q7Ukr9yeEElZStH9RAwAw&oe=6AD3A51F"}, "display_name": "Work Window", "keywords": [], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires you to go through a set up process on first login that can take about 20 minutes that downloads additional assets before you can play. For more information on this and app permissions please go to: https://support.workwindow.com.au/en", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://support.workwindow.com.au/en", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics"
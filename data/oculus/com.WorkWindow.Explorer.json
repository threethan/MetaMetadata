_oc=AdpTsU_B3rv1pIUCO7YPXtjKX8j78Slh81OxUXCShxbwMIV_ozMhmslYv4Dflj66HBk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gwmVbPLEIyTlYkouUZKB8PIpXgMRKvEVuCFsuK3WILQ&oe=6A0C59F9"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9NfKVT8iFwQ7kNvwG-uvEG&_nc_oc=AdrAuLtaIug1CxPA2rAx_BNYniMCMBubvbOCVCoD3E_3TWlO_N-m0TwYJfMl4C2QpuA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wWmktFQ0BHReclf6qoqdgFGFy9UWmGbcg67KfFAGzFg&oe=6A0C6EA4"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gcQJmd8C44Q7kNvwF4BZDK&_nc_oc=Adqb_TSLWR8kaHs1bPV_n5gm7G4XGAJmPc_gElOITPeXeChbohv_RnLab7WJNg44eFk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tq9eUHaLfJcLKHFXNdM3MOX2ibraNF2j0aNtE79F_wg&oe=6A0C59BB"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82i-XbygiWIQ7kNvwEbF3cF&_nc_oc=Adr509ji8EdVIeF66g0ya3Jsy_BpfvD4kcUgz_XLKBdzYxre77MzACJpGivUoMRQqoo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CT0tQrnlP1WVZ_sYfnijlyQdHENev5oHIkeYYLM6z5w&oe=6A0C7812"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75196228_959140557801733_2761266729802792960_n.png", "id": "716448385683270", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982696_716448389016603_2302833598379675402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_KCrpSNEmMQ7kNvwH9gITl&_nc_oc=Adqg7bKa5OhrgRDFTFKTHkA39Izr2GGDrSfE2bw-wTUqdFI44hAXBfbW_DJZ2QgyPTs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BJY3wKQoLZDWhPHQg7F4MvunjAN5hppI5t5xCIgbq4g&oe=6A0C5A5F"}, "display_name": "Work Window", "keywords": [], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires you to go through a set up process on first login that can take about 20 minutes that downloads additional assets before you can play. For more information on this and app permissions please go to: https://support.workwindow.com.au/en", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://support.workwindow.com.au/en", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics":
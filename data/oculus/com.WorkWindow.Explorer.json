35798_2398443249632462471_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJLjsclJIE8Q7kNvwFQhEo-&_nc_oc=Adqi7lfCFbcB79ooMPa141PhdqnnjliiBbBpC4089bGY9ijXPXsArUQqTu1MsArt1Tw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvWXp6cfMUXj04j0wdU9he54pLjslcZfrTAnPJwxaYLQ&oe=6AE09B79"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjEtRkpq8c8Q7kNvwGbtS_g&_nc_oc=AdqA52XooSedyasHQ02BMqpdv-kWMLDuSYPi1W0KLBjpy0baC2x_4yCcGjq1OKWa2bc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-dqwGrkaIgFylVL21xNyIzqLFYcJ8lVHSXRIedSZT4A&oe=6AE0B024"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lYblZ7eF8gQ7kNvwFKulAd&_nc_oc=AdpXqkxZv5Xbbxzv75Uoq7IKI-1dollDfWo8Ni3H0fDEocdkf86fCDXyl9wMwzbNAVc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHDLO6vmkZM8WQJO-EqBtNnP5MrGiHVbX2rOQ_TlWDDw&oe=6AE09B3B"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoLqqam2cq8Q7kNvwGop4Qh&_nc_oc=AdrPD7eTQsndJPFcVM7teaDaPrECXLEJQodLCD63zWfn6My3_LCHdCOt0w-WRuHA_0U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaUn7FnoMMgMu90jaEKndgmR9Aay1Z-q-gSWqW7kvWhg&oe=6AE0B992"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metaStore_coverart_landscape_1260x1440.png.png", "id": "9472476746144168", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473402619_9472476749477501_8390684063437743400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Em_ZF5UNNSgQ7kNvwH95iQW&_nc_oc=AdrqjKOrVaaidzUmDwpXO8uxUJ6WhTmGIaBzPLLnvzN122x0KDaku_jCMYI2AqY7sMk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQHOBA0kjQ3uF3sSC9QtYLAgWhzpcGM_vhdAg_307Aqg&oe=6AE099A6"}, "display_name": "Work Window", "keywords": ["careers", "career", "education", "work", "window"], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. \n\n\n", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. "}]}, "developer_name": "Work Window", "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://workwindow.atlassian.net/servicedesk/customer/portals", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "36269221144287
r0PqwFrONh0fiKPzGKwdw&oe=6B06F512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metaStore_coverart_landscape_1260x1440.png.png", "id": "9472476746144168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473402619_9472476749477501_8390684063437743400_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_joCtNWtuSUQ7kNvwHaIoGI&_nc_oc=AdomEZ_OFPyktn1xhUb2z8yVChPmDrE5cRLF5xUBbKn7dJgIUBYd8MTtNkEajfh4J38&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFiRglcf3zyOm9jquhsl77JCu8eFHn9V2M3-1Szkrljw&oe=6B070D66"}, "display_name": "Work Window", "keywords": ["careers", "career", "education", "work", "window"], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. \n\n\n", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. "}]}, "developer_name": "Work Window", "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://w
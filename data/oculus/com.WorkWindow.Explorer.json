4145635798_2398443249632462471_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zop2wiAGosQ7kNvwFjFrc3&_nc_oc=Adp4xs7RN1IVZHQzXw6tAJLfH--Nxl4qhP-NNGHIkg-YSZxkvUzUaJJIB3Q6kxajtdk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhwd6rUPLmtxTJSK2Wl2tbb3nYJvLXvC0pmX_vmOUGrQ&oe=6A7DBAF9"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VB6rNe0V8EQ7kNvwEkg_Zq&_nc_oc=AdocWXIjQXxH6jUVQcY44DjvrBo24l4IiTEts6iQKuvndSiSEP_aKEZT_taqBk_rlh0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErrrBYaciBDg4HMrmyyxhHIkhcMkciwxhGSWB-kYV9vg&oe=6A7DCFA4"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVyW6wPKyAcQ7kNvwGFzONV&_nc_oc=AdqxsbmDLmyHg96a1hc9y3TyHDPJT0cGgEG-PN_45wTRyQDk6JvCOLDdxl_7AWlRo0M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOctioEl76uqVqddAv5psXyJ8E4rq5q-SljKGvq-JWmA&oe=6A7DBABB"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8I0DnuHb7Q4Q7kNvwGcbNXc&_nc_oc=AdpgwqOVgofsuFLWKUU2mX2ejNCExkDSZNL5h-NdPyKBPSDrBU5aw5AmGnruXza3P7k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeAS3xx1MTxe8cVEK94S6EByxNi5O8CbMm5KZRvlqejg&oe=6A7DA0D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metaStore_coverart_landscape_1260x1440.png.png", "id": "9472476746144168", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473402619_9472476749477501_8390684063437743400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKSYBbOeeuoQ7kNvwEw4q3z&_nc_oc=AdqGQimERW9P46HKVratbikX0nusVYXSAGhUBsnnP8ZEbZB5wTLkNzfagEULd92Rrrs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCZYkrYsJNMNEtmaDBPQJf_zFEcjjsrX66TlKa0n_ryg&oe=6A7DB926"}, "display_name": "Work Window", "keywords": ["careers", "career", "education", "work", "window"], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. \n\n\n", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. "}]}, "developer_name": "Work Window", "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://workwindow.atlassian.net/servicedesk/customer/portals", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626
c_oc=Adpj7nGhnXGgzqZZ69jI3FHifXES-WzZS19ZnELtxsJZRT-yhQ6EQvgaOQI9j_MsrMw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1pHEhbt8DhnMKAkk7Fgw57PX7grN8_ydKcpJHrFecxA&oe=6A65FFF9"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ti_Is-sktP0Q7kNvwF-yQIJ&_nc_oc=AdpuqINEEgCqagBrj8F2zqZ16Vzixq6jgkq20VjRbqpV4YC1OoHcTR5QOYi3JpeQEu8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACgDyf2QkJv2oi_iNOUvs6QKC2mvqIjl4VcObeYuk5Kw&oe=6A6614A4"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocheN8ZlAQUQ7kNvwH77ij0&_nc_oc=Adr0APDqaUqVha4Gc1B_bqYlk9R6p_7uVaf7UbZmhB_37DoPPX9PpAwd0zRsFo9ZdyM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPG1fBlGvqpmIbZnJVdnBJ-e9lSswDB9xUcInil1eCsw&oe=6A65FFBB"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK5YPRpHFJsQ7kNvwHE2R4H&_nc_oc=AdpVRrIELUDT-qFckqx6YlOIEGYerwbLOMOH3cUapTe0HbtkiK8j9JQKi6ib7OH4e0s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAI8_ErIt60Z97v0bUSeRa9W3mJHnbRWMZSZbLbKW684w&oe=6A661E12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75196228_959140557801733_2761266729802792960_n.png", "id": "716448385683270", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982696_716448389016603_2302833598379675402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVN-0Sv2FXEQ7kNvwFS2oM4&_nc_oc=AdqYo6hVLf4Qw0hOxn8P9Rw6umphXSV2UL8rrOLvP3YcAbw_NBZlE3YN_zpDavTahrA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCibQNRAki5lDVZEPqd_zblZKEGvJW7yzbduYybe3VMqw&oe=6A66005F"}, "display_name": "Work Window", "keywords": [], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires you to go through a set up process on first login that can take about 20 minutes that downloads additional assets before you can play. For more information on this and app permissions please go to: https://support.workwindow.com.au/en", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://support.workwindow.com.au/en", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics"
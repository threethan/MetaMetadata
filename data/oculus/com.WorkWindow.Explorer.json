_oc=AdpOYgwxn-5FzBH9o56AOTSYzb8r5b5ZRxrNze6oqmrZzn5-Iwk6rqv66T3UW98MbZ0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7q26uKNU6O7XUi-CVRp9WFfwiU2i19poXmI94gA4tcGQ&oe=6A1C2BF9"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0N_fPuZd4UQ7kNvwEKxlaX&_nc_oc=AdpjBKLSxupa5ljhP-huPSeIBlDJEugMaXuWQG-HbAptoYy423GRWfnWOPZYyAWrlW4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nP6FJKWF7i5HtxaNpdUQOWZ92Y96Xr4YWKG15aBUGwQ&oe=6A1C40A4"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5UtEuhHaycQ7kNvwHiZ4DL&_nc_oc=Adp86sLKhjFooc2yPP-IpwZ1-YsufSvlb0QOfTtjhbvXnIojeoXgbpV9mAGjZWstngM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70o-HBcOJRXOi3pG96Vs3OQapz--SLyD9Wcr6jBFeKGQ&oe=6A1C2BBB"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfEkBB16su4Q7kNvwGCVD_R&_nc_oc=Ado8U_wRFwMfGhC7OkU7r1ysBZ-2M8ZecAsMxNL51FZNhmlJn2c-2ql7VJ-1dTC61wE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oocCWYc3g_Hl9V2EbJAU6Jt-z2jC4-BawbnwDBwKJZw&oe=6A1C4A12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75196228_959140557801733_2761266729802792960_n.png", "id": "716448385683270", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982696_716448389016603_2302833598379675402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnkUdI_oyqYQ7kNvwHPB6QD&_nc_oc=AdpxSpOmiY58YcnZ7HfO6jZnr76J3GLhZOZiJSEILUELq5JoqkHzwqzYq5RmGwAeTj8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NZPB0j21IuDHG-_xcWSfdA0l5k088ukvMB_Mcq9ECyQ&oe=6A1C2C5F"}, "display_name": "Work Window", "keywords": [], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires you to go through a set up process on first login that can take about 20 minutes that downloads additional assets before you can play. For more information on this and app permissions please go to: https://support.workwindow.com.au/en", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://support.workwindow.com.au/en", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics":
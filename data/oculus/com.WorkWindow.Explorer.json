4145635798_2398443249632462471_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8aUiEtJhdYQ7kNvwGGB_uZ&_nc_oc=Adrql-Jyt7eaAp2uytRHL5fuyPnJJqUJI9W947XgXx61Tjs8XQgJ386x61xNnHXwTFo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDbtUVC1vnJmweWALJeaZ8oy0oRfqpJvK66wcEGJ-sfA&oe=6AAE8279"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPsYbL7_4bsQ7kNvwHKnk0y&_nc_oc=AdpIWsZ9NNSM5G5CVEYgW6UjB8KLPELECapehtGC5iY3ZC1Ghq1XSoxJ3u9u8vt2rlM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3HmCRZxzSDLEyNaaVzroFVNGOM6LJ4__UzxNVw2Mwxg&oe=6AAE9724"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MoK1TPGRRkQ7kNvwHJ9VAy&_nc_oc=AdqKCdjaqrgfHjpe7S94A_AHdNQK1LOunet_8U5lINYHioObwIQB5204A2_uSTLmpGM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj4h3o7ysFTod9szp-hF-7yegHGod_r2ah64npF8IURQ&oe=6AAE823B"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeHSlxR-PIQQ7kNvwGFCq0I&_nc_oc=AdrODqpnfFuqiOdtStMhQD6JEccVxhgkz2opmsUXnwpg8WAFyB1ARcxJl19VWDtnnas&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_8MBi_Q2akMlyLn1qMm6vLtrAxbrdWR-68glicGmESg&oe=6AAEA092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metaStore_coverart_landscape_1260x1440.png.png", "id": "9472476746144168", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473402619_9472476749477501_8390684063437743400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cl6-mh9YqmUQ7kNvwF1x6rD&_nc_oc=AdqX30sCpfaKyKKZy3OV3W-0YcmZXiOH8iTu_lcYxjnaN6KbxDl6sMJ6CKbHk50-Qj8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9snytpnyEP2QLCPWzeeFTHb39uZURhPf_soHB3iwcfQ&oe=6AAE80A6"}, "display_name": "Work Window", "keywords": ["careers", "career", "education", "work", "window"], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. \n\n\n", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. "}]}, "developer_name": "Work Window", "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://workwindow.atlassian.net/servicedesk/customer/portals", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626
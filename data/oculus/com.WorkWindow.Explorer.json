35798_2398443249632462471_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPp92QA6oZ0Q7kNvwG6rUXl&_nc_oc=AdphCjXAQOukITXqIRK3ig8z0PQ2dNxvlBq6PF3MQCat7tyhpVVFKuGi8m9hfua1Tqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyX5O60SFotWBTVCbvHJ6sVpLRO4DGDZLoI2l-exmk0A&oe=6AC675B9"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fj9AIRMKl7IQ7kNvwEgp_61&_nc_oc=AdrOpgu5u61X0R-xmNuRE_pUPhnanQUhSIlb7P5qEQwVYF7Gk8tgbwK3z_o-Tfscn3E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlRO1NQcB3C3Z9-xkq-vnlyfdDtkwyAqxCnxyAqLYSvA&oe=6AC65224"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWXBro9heJoQ7kNvwGYzaTi&_nc_oc=Adqo4eLnFk-0OhAxL4k3H04C9fHLX45Y_qsnk-sDzranehUwotNm3m9eQBH8hHu-B2o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzBljc0ShEhYUq1dvNBYaaFT2FAzGHJC5ERcUS8d3-kw&oe=6AC6757B"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTEyQPX4brQQ7kNvwEUck1n&_nc_oc=Adr1rINqwsZrqzafo_SBd8HJeuroufUI5cRmJIrRTjM-iSLHDRgE7EcD5gOEANXPYZQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMttWpdcRTo72jkknspD2Lz806pwRzp6o90fI_oIYZSbA&oe=6AC65B92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metaStore_coverart_landscape_1260x1440.png.png", "id": "9472476746144168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473402619_9472476749477501_8390684063437743400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ap0fJH1ANFEQ7kNvwHcRUkm&_nc_oc=AdrT1365tsyAY8Tt3iTwPm8gfLte7ynzm51IAAXQNxy8DNBhg4k8R3kyOOde4oY7wPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXgMcgIf_SQm5DMlxeCsEsqmEx4RulxI4VYsCJ9GzidQ&oe=6AC673E6"}, "display_name": "Work Window", "keywords": ["careers", "career", "education", "work", "window"], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. \n\n\n", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. "}]}, "developer_name": "Work Window", "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://workwindow.atlassian.net/servicedesk/customer/portals", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "36269221144287
fP64eQ0944Q7kNvwGgCkyv&_nc_oc=AdrhvrctGWVKXv35v2qlM0iMDEhck_rTkZ2fLHZSV5eRiewxgSWtUXEo3aps7JLjWGQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ6ftnutENltt29vrukQ6SL-O_2r-f34_1TBVMR5gTrQ&oe=6A8D8CF9"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Coa7J02oUTYQ7kNvwFOCraH&_nc_oc=AdrYQG8MbHtWrKaHSmhMfo8xoZvNgJD7jd2RS6Ofpuji3lHiUgB6XX0pr-93jgQX5HM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6AaBdngEB-AAgx44WrnruzL0sXdNc0smeM1jQb__xXw&oe=6A8D6964"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E22zelTHL_sQ7kNvwH-Df-N&_nc_oc=Ado2NQfcBN6PSTa3-Udw0Mft4LMBEbfm6AXB_5dHwzL96hi4E2V5IwT6H0AGwZR8MMY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExR6SBmr5Ba69OpW8dilFfXfHL1Tk0zCGP6D_NYLms9w&oe=6A8D8CBB"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXKiEvNQWjYQ7kNvwFv9pvU&_nc_oc=AdrHSda77y84dmWzBZ0vyfuTQ-l80RJ98GbXZgfTGFx9d02Q342yWaqPW-jTbiypZhc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaVwER9IfZp2t9zupQbo4Te7weGbcGNa4cDVSe46CRLw&oe=6A8D72D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75196228_959140557801733_2761266729802792960_n.png", "id": "716448385683270", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982696_716448389016603_2302833598379675402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhfMxCfRabEQ7kNvwGtnorq&_nc_oc=AdrBY-tI2vlM5bFr1g0rE61_76INt7eCTJ6AMde4dCeX7t0eTvNBcm-6TbTlsG_fHDs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlLOn6OyvaoblesRj4mstOcXEYxVBMjiUK_ykJOfjzGw&oe=6A8D8D5F"}, "display_name": "Work Window", "keywords": [], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires you to go through a set up process on first login that can take about 20 minutes that downloads additional assets before you can play. For more information on this and app permissions please go to: https://support.workwindow.com.au/en", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://support.workwindow.com.au/en", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category
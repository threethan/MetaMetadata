35798_2398443249632462471_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1nLFwbN4fwQ7kNvwEYvYDU&_nc_oc=Ado2UkRXFtFZT-3ckzV67ST2vfmlh4jO1n15UseVc26IOIJ_CM9Z9NT4b5OrDiOyq-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv0lNE9qwiE4dCwmqqiWnZ0EIObOHK9lWvym4UHCWxvQ&oe=6AEF5439"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jEt1_LRA5QQ7kNvwGFDrDT&_nc_oc=Adp5AyItpp7e_ODphM1QI2EpqitpvG-yFB8OJ5KUJ_qk8JbfPi9ImkinqCGqgSE9XAo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8PrHsrvtYFzLikhJgDH-JrcefxtJq64wOEksJSjnQ1g&oe=6AEF30A4"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVyhSPtU_h4Q7kNvwGzNAY2&_nc_oc=AdoB2-eFjGCpIm26Km22lUrMkLZrp9U0KMUeCJZOQroa0KCxs4fj8q4hADl-37E86lo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWV5oOfeRWqg6VfJbvTAJEohj1mpJyx_3IL6CpdSpqvQ&oe=6AEF53FB"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yem2SVB9kgQ7kNvwEt1XAQ&_nc_oc=AdrESHgc6pI7FM7c5r86Mkq5yt84-J8eIEwfH6ZMKSw9GvUEf-nKlUqzbbUTsF7AmU4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpePpeGmjM5yciHbjGe4SysBNyDxpYdihH6gSKgolHgg&oe=6AEF3A12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metaStore_coverart_landscape_1260x1440.png.png", "id": "9472476746144168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473402619_9472476749477501_8390684063437743400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WEVJsqYylkQ7kNvwE2eXpO&_nc_oc=AdqifBnAZMqBU1rdQRHdf4mAXGZCF4FmKviASXkDrRme5sDeaVD0bM5UliyArc5AmIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXwoiyI20gduqKwRKwYSke-Rfjxe6loLpA_8fllEASgQ&oe=6AEF5266"}, "display_name": "Work Window", "keywords": ["careers", "career", "education", "work", "window"], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. \n\n\n", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. "}]}, "developer_name": "Work Window", "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://workwindow.atlassian.net/servicedesk/customer/portals", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "36269221144287
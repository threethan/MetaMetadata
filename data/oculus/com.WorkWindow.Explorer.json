4145635798_2398443249632462471_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjQOqSOq7CoQ7kNvwF99UBW&_nc_oc=AdpksRkyCPFA0uolZhCP-X1lYV9DH1eZvlbFZ3WLogPrAicmBzScd6MA6W4s84Paa2g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-s5cZGatrHJIel-g-5dx1u_bzabN15w__i00a8dheKFA&oe=6A36C239"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lu66YcgUFzsQ7kNvwH-VQnf&_nc_oc=AdoNtgMtV7shvfJ8Me-JUxT4aD2tK8pgFQ-ofbhzsDkSKGGv11wUIHfqqxCZO5Qbbrg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Z8EQ5muRsq4Ia1fHvDywtkBTpcLDfS1Lf44BpnOB3pg&oe=6A369EA4"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xx0RUbbgPzcQ7kNvwGLkVJU&_nc_oc=Ado2KqbQ-zof-QQCKNfVVYoSlzRKt5wT0cVFj3qv5w64VN0JwQxh1MiszxhcUbCnfSQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i42-FDP2MXLApkr4ruQhBDz1ACk8MmE9Bx8rMozt48A&oe=6A36C1FB"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5Hmaj0k84wQ7kNvwEmZmi-&_nc_oc=Adr5_RmWIMQ5-mJb7cbL40fOoLCllMS4sQ0vcp2vZfjw9fDEwiHgYT_j7savnyZXfhM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Pn7oquZuvk80CJkhxZN-SucnVUs715PRiPvkJbU0MdQ&oe=6A36A812"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metaStore_coverart_landscape_1260x1440.png.png", "id": "9472476746144168", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473402619_9472476749477501_8390684063437743400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9Yzi5FEMKEQ7kNvwFDNTQC&_nc_oc=AdoVJ9z9hHUbM_ofEGpaOePFKGsjL6lgTqFMB6Olg7PXziTWNp24mX_s6uoOVYt6x-A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UBvNe6IWfvCAnK2Fv8qnyNUlIJwTLxAezCQjXSt0FRQ&oe=6A36C066"}, "display_name": "Work Window", "keywords": ["careers", "career", "education", "work", "window"], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. \n\n\n", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. "}]}, "developer_name": "Work Window", "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://workwindow.atlassian.net/servicedesk/customer/portals", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626
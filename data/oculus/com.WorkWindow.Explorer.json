35798_2398443249632462471_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDDG4U0PJXwQ7kNvwHoNjtr&_nc_oc=Adq4rokS5Xo2DB9M_XeWT1FQ9LMsmZRSW-SMcNQKQs-b5TonbjtaVCrCS5A08DELrqI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmQBeDn9oiO76srKx9jhYfpT2_CLz-GoaiAj_YXCa2Zw&oe=6AF73D39"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keMWJU5m9DMQ7kNvwGgDuMR&_nc_oc=AdoG4u4wObbXq5qj3PIUrc3uc-s_Gkm8_CEXOYdRzd18fMMUwgPxiH2uirq0SoMMryk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCsXkpynGxRDeHQv6eB_dNBTJQcNSPVABd3oKMuLeSTQ&oe=6AF719A4"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ri6qPyfRLEoQ7kNvwEvFmv3&_nc_oc=AdoaqTcZAmO5i9dm1aOTzqR3Y7cbd8RNGdxKONt-R1MW0uYLJ68PXoCzPLh8wPm0YPw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgziZxiDbDbAIpUhW4CR0NH8f-t83KCF1u_Vhk2LbiEQ&oe=6AF73CFB"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSJuFHFPk04Q7kNvwH-sfHQ&_nc_oc=Adr_97FI6FiMQF5Xkvjz4x_jIdToJ4FCBudj8pxveNAJNQg4k7rk4Unwi3R6q_w1lNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-YYIGLq5NR1lfWTzYokXp1tE1xhOrIwlA29nIRnRFjw&oe=6AF72312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metaStore_coverart_landscape_1260x1440.png.png", "id": "9472476746144168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473402619_9472476749477501_8390684063437743400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3IcVtH_XFcQ7kNvwHV1Rlc&_nc_oc=AdrIYN9bkIErr4pPuCO1tiWmsyeslrYTzqO3k6gr6UzRjK3nQ1A68OENBc_NeUQ3RdI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq3RWtOojPuDgNKBWSb41iibIZOwt-gvnni9GF5XoJhw&oe=6AF73B66"}, "display_name": "Work Window", "keywords": ["careers", "career", "education", "work", "window"], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. \n\n\n", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. "}]}, "developer_name": "Work Window", "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://workwindow.atlassian.net/servicedesk/customer/portals", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "36269221144287
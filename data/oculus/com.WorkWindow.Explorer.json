_oc=AdpjzH_3Nu-1G4t2OkIKA5CyAxMxgoEqRYRpDUl0qxtQ1LvKhbgzXm3Q8bjS3JOX-XQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KneRVrHvrEScydw2rmR4TFidmX0Xj_xjgeFB0SoRQDA&oe=69E61E79"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlkQr7Fxpj0Q7kNvwHoxICJ&_nc_oc=AdpDsYQDW6_V8AG4riuBOrSw_z8Tg9PSwQv-oYISVgle7QHBIqEg42RRxWTvf_21AUg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lcBHHXtSmpIelBayk_PTeFCqr6jIWLi4oMBNrtNmpSg&oe=69E63324"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAlJ6pBzOL4Q7kNvwG0JdN0&_nc_oc=AdoHGhyxk7SAupa2S6ILPexftncZIgTHlQtbYQ7PYuLHn9Hw7SxkPYZDWbY5I1tqO1s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iTexSlgKWpJtH_HcX-DbHaPkBMCqYqMSb7SZynBmfig&oe=69E61E3B"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5H9ain66YwkQ7kNvwEvjpVD&_nc_oc=AdrnDeCCxCAGX5dzq9AXeEBxlU_k5xLeE6V-a2-iZ-dNCtbuOp88wnLgI9KiyLhX0pk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kgfheK08ewoesPunvZ6YAksNR1WempLl9G4qRHva38A&oe=69E63C92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75196228_959140557801733_2761266729802792960_n.png", "id": "716448385683270", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982696_716448389016603_2302833598379675402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaHvICzBAikQ7kNvwH-hwtJ&_nc_oc=AdqTaIi4xHwsp6WdjMZrspSN_yPWrQJsOlJq8xCnuSjj7_UePa1OB1m6tTa0C-17l2s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jiERTnxjZnKaknBINSEEaukL99XJkbGygLAEvWhshog&oe=69E61EDF"}, "display_name": "Work Window", "keywords": [], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires you to go through a set up process on first login that can take about 20 minutes that downloads additional assets before you can play. For more information on this and app permissions please go to: https://support.workwindow.com.au/en", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://support.workwindow.com.au/en", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics":
_oc=Adpon32oG5ELcQuFydFEQDPfe9mSoo-0nzbMH0K4-oJaiB5Cf5eG82TadWWmYxzhodU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxS3NwFPjS_QHJ9oxO1l-hs6karMXDXu0pGXZm7dF2gdw&oe=69C91D79"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_oq3YAegFEQ7kNvwEigRut&_nc_oc=Adq5i8ttXsySmCwxgakVGzS3HPi-9WCq_p6HMF9o5vAaPpqgj2kdwSTCXtQnSV0S9vI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKcY-XFn-D0hEMuARoWaL7eESiVAdI8mJJvobdgnIfKA&oe=69C93224"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVhOqrlL9aMQ7kNvwG3aEqz&_nc_oc=Adowy8vubUUCWhrVWxtKA9EXmB8lpp06namH8muE6MDyHSB_Ml9xIGgr-l3liDw8aI4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPWnmObrJ4qlcLFojTQn_7Bgp5lBTjMH2NKit2sT1bxQ&oe=69C91D3B"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEZ8UxvCUEAQ7kNvwGEndQB&_nc_oc=AdpcUTFxvm_SCO5kyfiD__rKzZgiw81XGP-vVyL5KRzQdmT_JLDaaRAxOlK9Do4p_lA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwvn7Qq5TIB9CIKDLYnx2_pmKRYxzYyUZTdO0064Ag_kg&oe=69C90352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75196228_959140557801733_2761266729802792960_n.png", "id": "716448385683270", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982696_716448389016603_2302833598379675402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4X_ldnu0FUQ7kNvwEgyjBa&_nc_oc=Adp3-U0kTD0AyjM0qbfkwEOtTnufNI2-YGW--g28iWZTVi5FxAOtv8XpKhpjCpC8cuI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzpriAEg301AVZh1et9__FstQZh7Yzu9vUNp7vo92TOfA&oe=69C91DDF"}, "display_name": "Work Window", "keywords": [], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires you to go through a set up process on first login that can take about 20 minutes that downloads additional assets before you can play. For more information on this and app permissions please go to: https://support.workwindow.com.au/en", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://support.workwindow.com.au/en", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics":
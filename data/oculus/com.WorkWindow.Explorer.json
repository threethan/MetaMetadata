145635798_2398443249632462471_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyHp1d-26xMQ7kNvwEbUp5u&_nc_oc=AdrNUgbMoG2MkU8traGgP7j2RQGCIwSPh0TKDSPFr6LDQSnJMfW7WebCQBkyFplkhqc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hQjn7KvGCaxXk_Zo9mI5uWCVyy0fO0Y_ulkBwKWVwhQ&oe=6A119FF9"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmSi_XRO4DEQ7kNvwFYly4b&_nc_oc=Adr9JGo4Ke2ST8VE3UMfNepT4M_EvJtvSlLX9dPiTJKoKn_CrjRBcXRz0SBC8OKg3Kg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-VPCTz0NDAeROsAnDCC8drbvRkdr-1UI7XPRKe5tSlQ&oe=6A11B4A4"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JucKT-N63MQ7kNvwErge0q&_nc_oc=Ado2kEw_HncZJ5NkaZAHf0OH5-XmSe6yM117-i_wP6VYkAjIiLbnkZ5B9ban0wBaI_k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60roA0_fqec5Giu7NqtuwQo4HuJ2zRImomYUdcUV4fHg&oe=6A119FBB"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IpV-2w0lr8Q7kNvwHzIIc-&_nc_oc=AdrCTSk1g0Y2VYAvIgMq5iCsVanTR0OTFOmxbBEjhZS-VXpzwOgSMtrdWcGk4LF_sKo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5azUptLyn1JVllRVGInnbYrYOHoe0eTNAr6oNKOMvAkw&oe=6A11BE12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metaStore_coverart_landscape_1260x1440.png.png", "id": "9472476746144168", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473402619_9472476749477501_8390684063437743400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snRMEzuPITkQ7kNvwFZrbSC&_nc_oc=Adq1Azu2WrCENX4F5owjhIODmMblhFGQm38ub9KItdJtbuKoD8W_4xELkZYObRwLuVA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D9T0YyeowLCgbgjouz4GN3O3tcddfO5kED231zxVj0g&oe=6A119E26"}, "display_name": "Work Window", "keywords": ["careers", "career", "education", "work", "window"], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. \n\n\n", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. "}]}, "developer_name": "Work Window", "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://workwindow.atlassian.net/servicedesk/customer/portals", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "36269
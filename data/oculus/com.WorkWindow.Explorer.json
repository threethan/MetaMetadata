35798_2398443249632462471_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvuSJAiAJpQQ7kNvwEyURTK&_nc_oc=AdruVKEJEGi9Tg6FbnpbCX06Rpy810weZO3FIR7P53QRfADheXKUb3Xv0sU7tMVMjkI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jcBEduVJRh5CURvS_dYKe5ANx5unKoKzzCmwcw9QdQA&oe=6A4115F9"}, {"file_name": "39031621_538352793616932_2214955153268670464_n.png", "id": "1268532100213926", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75476596_1268532103547259_6102145425697430473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GAKjW9npWQQ7kNvwHxorwE&_nc_oc=AdogkMNzqNKuy7O8ArNmanMy2dHn79rcWOk69LaIdP81-b22-UzEBMgLuG4ZnuCPs38&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pfg4qDXzYNrErruxuntwYh64XvBfrj5r-ravk24mJCA&oe=6A412AA4"}, {"file_name": "39031539_2768322023202234_9130312383451889664_n.png", "id": "138184358130872", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982622_138184361464205_8626304434474729384_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pi0y1GcH2N4Q7kNvwE1w5X0&_nc_oc=AdoF3WqK6eDTUNorWBMzDH1NlnH8rHheBoGlBx3M74spfaL8l-nl-8m8LCUhLXcwNN0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KSoi65ZxknkHaeGGvTqFX2JMRYm4tVifkpOAsukWiFw&oe=6A4115BB"}, {"file_name": "38982712_822622928193027_4252812466867666944_n.png", "id": "3745620218866056", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75269301_3745620222199389_4033177396883429855_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqS1KWMso6AQ7kNvwEBwwQW&_nc_oc=AdojU6Sht19VWwy8y6BUjVaCHI3iSlgsPWBnbKBr2qC7ygofMRgmD4S5OMcTOxcvi98&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91_IOl3wIkzrURnXB6ooMrwj6bgqgwx0cBZudCua3q7g&oe=6A413412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metaStore_coverart_landscape_1260x1440.png.png", "id": "9472476746144168", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473402619_9472476749477501_8390684063437743400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVk_UC7YSxEQ7kNvwEV6-P0&_nc_oc=Adqh5QFik_Bg-MLp6XZjI81NLqBPHr_mEvcItBsGkxdgkCTo-MJfqbh12XncHMJUcOI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EbZRcYs3GA9diOREnhixhzaWshL8Hup6WJBumowzsOg&oe=6A411426"}, "display_name": "Work Window", "keywords": ["careers", "career", "education", "work", "window"], "long_description": "Frustrated by how difficult it was to find the time or contacts to engage with industry to explore our career options, and the unengaging traditional career resources available, we started Work Window so students could access the experiences that they actually want to use to help decide on a career path.\n \nThrough interactive virtual reality job shadowing and informational interview experiences, we transport students to the workplaces of their interest. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. \n\n\n", "short_description": "We transport students to the workplaces of their interest, so they can gain insight into the world of work and make more informed career decisions. Work Window allows them to feel like they are really there, in order to narrow in on their career options, and build the confidence to take the next steps in their career development journey.\n\nThis application requires an external subscription. "}]}, "developer_name": "Work Window", "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window", "support_website_url": "https://workwindow.atlassian.net/servicedesk/customer/portals", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "36269221144287
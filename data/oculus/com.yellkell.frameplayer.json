8927770794", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827567_28419288951104125_7135315158463717051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxNDSeGrqNMQ7kNvwH5UHI4&_nc_oc=AdrnaZ-DOpotK6aisfrEo-DP85NcgIyzb0sLRY_47rPI58eC3nQFinV4DdM7-gPGkUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4j4EeeLs6fIjx9xT4sH3JF16IcNbSTlJ-9r4_j9Qzjw&oe=6AF7358D"}, "display_name": "FramePlayer", "keywords": ["player", "VR180", "3D", "360", "video"], "long_description": "FramePlayer is a video player for your own videos.\n\nGET VIDEOS ON IT IN SECONDS\nTurn on Wi-Fi upload in the Library. Open the address it shows on your computer or phone (or screenshot the QR code with your headset and tap it on your phone), enter the two-digit code and drop your videos in. They go straight into your library. No cables, no extra apps.\n\nPLAYS WHAT YOU HAVE\nFlat, 180\u00b0, 360\u00b0, fisheye and 3D side-by-side or top-and-bottom videos. FramePlayer reads the format from the file name and remembers your adjustments for each video.\n\nSTREAM FROM YOUR SERVER\nBrowse SMB shared folders, DLNA servers like Plex and Jellyfin, and WebDAV on your NAS, and play straight from them.\n\nYOUR CONTROLS\nRemap every controller button, or put the controllers down and use hand tracking.\n\nPASSTHROUGH VIDEOS\nRemove green and blue screen backgrounds, and play passthrough videos with their own masks, so your room shows around the people in them.\n\nFramePlayer is free. Passthrough videos are a one-time in-app purchase.", "short_description": "Play your own videos on your Quest: flat, 180\u00b0, 360\u00b0 and 3D. Send videos from your computer or phone over Wi-Fi with no cables or extra apps, or stream them from your media server over SMB, DLNA or WebDAV. Remap every button, or put the controllers down and use hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yellkell.com/frameplayer/privacy/", "developer_terms_of_service_url": null, "publisher_name": "yellkell", "support_website_url": null, "website_url": "https://yellkell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368413826366284"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2050875868950396"}]}, "baseline_offer": {"id": "2050875868950396"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793747220, "status": "PUBLISHED", "id": "2050875868950396"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1384895021384831", "version": "0.3.0-alpha.19"}, "id": "1472197708126718", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1361403123734021", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1384895021384831"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1472197708126718"}]}, "change_log": "\"Passthrough videos now show your room on Meta Quest. Flat 3D videos (half side-by-side and over/under) display at the right shape. New hands drawn as a glove of light.\"", "created_date": 1793749595, "id": "1384895021384831", "version": "0.3.0-alp
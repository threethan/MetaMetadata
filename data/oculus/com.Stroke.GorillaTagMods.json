Tjx58Rr5HNcwr9Qg6vg&oe=6A9D5F7E"}, {"file_name": "Lab_1440p_10.04.2026_01-22-45.png", "id": "1969647650348524", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618064_1969647653681857_1774697938776346218_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1f1d9dM2KH0Q7kNvwFBJbpP&_nc_oc=Adoqen2c_l_OWK_38rnyCdOMYuuqJu9pBrW83TCnOjh0-KUhBqH5G1TQKrevUuRyz7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILxwtHUgdmW1KYm2bE_jfvIHRww8f2AJaKZ7dz_Wr6yA&oe=6A9D754F"}, {"file_name": "Lab_1440p_10.04.2026_01-21-36.png", "id": "897293843291847", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622186_897293846625180_271312401216630256_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C74ArHjSosIQ7kNvwEocHt2&_nc_oc=Adq9Jfi-nrUVDUIH4i3XwzLexbPa54Laj9HxhAhXGMffQ3NUjN-RrNbgfzFHuokOvjw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXVIRb_OMaUxZD8OEI1l6dLHduWmAD5JLxMrFO_qogrA&oe=6A9D7794"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Baboon MODS", "keywords": ["Scary", "Baboon", "MODS"], "long_description": "Step into the wild\u2026 if you dare. Scary Baboon MODS is a heart-pounding VR horror experience that throws you into a chaotic jungle where nothing feels safe. With custom mods that twist the game into darker, more terrifying versions, every moment is unpredictable.\n\nExplore eerie environments, encounter disturbing creatures, and survive intense chases that will test your reflexes and courage. Each mod adds a new layer of horror\u2014whether it\u2019s creepy visuals, jump scares, or completely reimagined gameplay.\n\nWhether you're playing solo or with friends, Scary Baboon MODS delivers a unique mix of fear, fun, and madness that keeps you coming back for more.\n\nFeatures:\n\n\ud83d\udc12 Custom horror mods with unique gameplay twists\n\ud83c\udf11 Dark, immersive VR environments\n\ud83d\ude31 Jump scares and intense chase mechanics\n\ud83c\udfae Multiplayer chaos and replayability\n\ud83d\udd27 Constantly evolving mod content\n\nDo you have what it takes to survive the jungle\u2026 or will the horror consume you?", "short_description": "Step into the wild\u2026 if you dare. Scary Baboon MODS is a heart-pounding VR horror experience that throws you into a chaotic jungle where nothing feels safe. With custom mods that twist the game into darker, more terrifying versions, every moment is unpredictable.\n\nExplore eerie environments, encounter disturbing creatures, and survive intense chases that will test your reflexes and courage. Each mod adds a new layer of horror\u2014whether it\u2019s creepy visuals, jump scares, or completely reimagined game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rtxgorillagames/privacy", "developer_terms_of_service_url": null, "publisher_name": "RTX Gorilla Games", "support_website_url": null, "website_url": "https://sites.google.com/view/rtxgorillagames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26604096329225115"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619486_1279376390408983_2446161269432955145_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z74PvI21An4Q7kNvwGud_PH&_nc_oc=AdqyxPsAaPrvIWm-OWddKT
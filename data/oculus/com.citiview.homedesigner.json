ea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWwWSftP32RAOF4-T_iQ92BBaU-9MabQSvYY9ea5Dtwg&oe=6AF33799"}, {"file_name": "screenshot_4_2560x1440.png", "id": "947560381390605", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604375581_947560384723938_7224049743864181564_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZoKSyQ0xbIQ7kNvwH3Uh0X&_nc_oc=AdqF3ykiYu-Ui9QNcssNaB5ZP1L9zxDFfXtqcqMNd1zSHvLH2yZ8flIyFi7K4Tyacao&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSuPNfq3N3SvNI8oiSypiff-dhHfMNsziNCmAYLCFA2A&oe=6AF32802"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1060337573480698", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830576_1060337576814031_289460850062541989_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxAEdADVeNgQ7kNvwE7N4__&_nc_oc=AdpYDsl7_PbboJUu8dNexV9mHaEnEoSlfWVOn3c7kAcXJJdic-xkyaftUHv2SCMTdSs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSna43j6DxehHFfcec9ZYRqOm45RZpHhoQoY5H48pFq8A&oe=6AF339EE"}, "display_name": "Home Designer", "keywords": ["home", "house", "interior", "furniture", "decorating"], "long_description": "HOME DESIGNER hands you the keys to three empty houses and a wheel full of furniture.\n\nTHE DESIGN WHEEL\nNine pages on one circle menu: LIVING, DINING, BEDROOM, KITCHEN, BATHROOM, LIGHTS, DECOR, PAINT and FLOORS. Sofas, beds, bunks, dressers, dining sets, kitchen runs, baths, showers, bookshelves, plants, rugs and televisions.\n\nIT KNOWS WHERE THINGS GO\nPoint at a wall and a sofa turns and sits flush against it, facing into the room. Point at the top of a sideboard with a lamp and it lands on it. Aim a kitchen unit at the side of another and they line up as one run. Mirrors and wall televisions hang at the height you point. Pendants and chandeliers drop from the ceiling. Nothing slides into a wall or blocks a doorway.\n\nPAINT AND FLOORS\nPick a colour, point at any wall, pull the trigger and the whole room changes. Twelve wall colours and ten floors: oak, walnut, herringbone, pale plank, tile, marble, stone and carpet.\n\nTHREE HOMES\nThe Studio, a bright one-room flat with its own bathroom. The Family Home, seven rooms around a central hall. The Villa, ten rooms with a great room and a gallery. Each home keeps its own design. Press SHOW HOME and a designer's layout moves in piece by piece, then change anything you like.\n\nEvery lamp you place really lights the room. Sunlight comes through every window onto a garden of trees and flowers. Everything auto-saves, and undo goes back forty steps. Standing or roomscale, with smooth walking and snap turning.", "short_description": "Three empty homes and a wheel full of furniture. Point at a wall and the sofa turns and sits flush against it. Point at a table and the lamp lands on top. Hang a TV, drop a pendant from the ceiling, then repaint the whole room in one pull and swap the floor under it. Eighty-four pieces, twelve wall colours, ten floors. Fill a studio, a family home and a ten-room villa, or let a show home move in and make it your own. Every home saves itself."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/homedesigner/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/homedesigner/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes
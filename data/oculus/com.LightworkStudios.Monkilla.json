=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYvQz8ffGhEQ7kNvwG5jc6U&_nc_oc=Ado6z3k7I6ANwpfpAKKgtojx4t3IYHlaRitddbyRip94ZUntTAzw0hA5tMlsDwFbttY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IqGx0ZVMWnPOLUNnwuvT8sEtF_IzaTXEVVLCANs_aCw&oe=6A414549"}, {"file_name": "Screenshot 2025-07-18 002411_resized.png", "id": "2553619074996037", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307339_2553619078329370_5108031840223583726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxjDgdjoC-AQ7kNvwEA9DN1&_nc_oc=AdpCF0U7OsbAlt4gjwJXJZ0b5h7yyqt5jBuTXnwHoBqxkopDJSsx3VDkiG9PODR51hc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WVOHPAYTVnLCBiup1Cs18guHqj2rCQVDCNg5K3AXWVA&oe=6A413094"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-05-11 011613_resized.png", "id": "1289416572874879", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824203_1289416576208212_4430979673932353510_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJFFqXRPxm0Q7kNvwG-R_op&_nc_oc=Adp_FnqvuCS-Ut6fSPHhi5SmfRQdHMIl8jbMaWlutUjscsVArsHNQRzl4NT6DHe0SHU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y-7gSIXZ_8jjcprmDGNxrbEpzKq52V2B55DgpUA7fHQ&oe=6A411E9D"}, "display_name": "Monkilla", "keywords": [], "long_description": "Welcome to Monkilla!\nGet ready for a wild adventure inspired by the hit game Gorilla Tag! In Monkilla, movement is everything \u2014 swing, jump, climb and zipline using just your hands and controllers. No need for walking locomotion just your controllers!\n\n\ud83c\udf32 Explore Diverse Maps\nTraverse the vast and exciting environments!\n\nForest: Hang around the gazebo and make some friends while having a blast at tag!\n\nCity: Explore our various displays of cosmetic. it may not be much but we are expanding this bute as is! \n\nCaves: Venture into the depths of the caves and mines to figure out the secrets of project REVOC...\n\nCanyon: Leap across floor to floor with many ziplines about to help you move!\n\n\ud83c\udfae Movement \nUse your hands to propel yourself forward, climb trees, scale walls, and swing about!. Every motion is powered by your own physical effort. like your pulling yourself along with your character!\n\n\ud83d\udc6c Play in a privte or with friends\nJoin a public lobby or invite your friends to a private session. Play some tag! or hang out and use our in built menus for even more fun! \u2014 it\u2019s up to you! Try different game modes like tag, casual and our modded experience, just explore at your own pace.\n\n\u2728 What Are You Waiting For?\nAdventure awaits in Monkilla! Whether you're Tagging other monkeys, uncovering secrets of the cave and REVOC, or running wild in the city, there\u2019s always something new to discover in monkilla!\n\n", "short_description": "Welcome to Monkilla! Go Around the maps. Swing on some trees. Check out the City. Go into the caves. and explore! Use your hands to move. \n\nBased of the hit vr game: Gorilla Tag\n\nExplore all our maps and have fun! Join a friend or play some tag!\n\nRun and jump and swing using the controller in your hands to move!\nExplore the various maps that are to offer! including the city cave forest and canyon!"}]}, "developer_name": "Light Work Studios", "developer_privacy_policy_url": "https://sites.google.com/view/light-work-studios-privacymk/home", "developer_terms_of_service_url": null, "publisher_name": "Light Work Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/light-work-stuudios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "re
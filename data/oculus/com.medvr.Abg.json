.medvr.Abg-20251224-121409-0.00_00_08_28.Still004.png", "id": "868175495825476", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618293_868175499158809_3560963665408877151_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uMpL6EEDWoQ7kNvwEm2ePf&_nc_oc=Adq9S8encTWdYHpgz7U4mj5ElWu6-WKrKdWmXjcNPqmRQqFS4FMakrFU_lwZELE8JKE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_bDKxop5x2mUWohT8NJTgxyvC607gCUeceKCIzb5bkA&oe=69E8D938"}, {"file_name": "com.medvr.Abg-20251224-121409-0.00_00_13_26.Still005.png", "id": "1792425384782546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618069_1792425388115879_5140686146519858561_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwunNqy3RZwQ7kNvwFO6vmh&_nc_oc=AdrBLnJBzRcrWYOVDucJ5Ca5y1AUBjsBdOTYBdBsgaNYyqsvRvORPVLqg_aO5Atexbo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TR0TxfUUwpzYcbUo6Ti_zZGOgMoJ8ggpD3lAUN-tbjQ&oe=69E8BAA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arterial Blood Gas", "keywords": ["Medvr", "Arterial", "blood", "gas", "VR"], "long_description": "Arterial Blood Gas is a hands-on VR simulation designed to train healthcare learners in performing arterial blood gas sampling safely and accurately. The experience guides users through patient communication, consent, hand hygiene, equipment setup, artery identification, sample collection, and post-procedure monitoring. Realistic clinical scenarios reinforce proper technique, infection control, and patient safety while allowing repeated practice without risk. Ideal for students and clinical professionals, this immersive training improves procedural confidence and supports competency-based learning in a controlled virtual environment.", "short_description": "Arterial Blood Gas is an immersive VR training simulation that teaches the step-by-step ABG sampling procedure. Practice patient interaction, equipment preparation, arterial puncture, and post-procedure care in a realistic, risk-free clinical environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "26078978881709702"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "861965976755928"}]}, "baseline_offer": {"id": "861965976755928"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769690340, "status": "PUBLISHED", "id": "861965976755928"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26397285343212386", "version": "2.2"}, "id": "1203710505223436", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26078978851709705", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26397285343212386"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1203710505223436"}]}, "change_log": null, "created_date": 1770725396, "id": "26397285343212386", "version": "2.2", "
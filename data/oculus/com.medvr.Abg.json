vr.Abg-20251224-121409-0.00_00_02_09.Still001.png", "id": "853690917700323", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618069_853690924366989_3010497815623709389_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoVvo4bVtM0Q7kNvwGBzky6&_nc_oc=AdpuefZHY1e2sbYYZs3b-Hqwy1BHSJqKl3c6APIdycFXyMk-mkNTT2vy3vRT9-bbh4Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIuv1pGjRMSe4qI0F1Saq0--faoPQULalaVUn0uiTZhQ&oe=6B031FC8"}, {"file_name": "com.medvr.Abg-20251224-121409-0.00_00_07_04.Still003.png", "id": "1297730899066743", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620504_1297730902400076_6465610088701193364_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqexIbU2_goQ7kNvwHrVuq0&_nc_oc=AdrZ8YptGO8Z2SUus1dK5MDYN3xQV5kaiSrI4qUl2icKmYMywpxcWtQ-CHO7AwU7e1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPNAr61sHnll2jFLdUnJMmCjNxc4eYKZm-UIOSbkAMRA&oe=6B032C46"}, {"file_name": "com.medvr.Abg-20251224-121409-0.00_00_08_28.Still004.png", "id": "868175495825476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618293_868175499158809_3560963665408877151_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovqr55us09QQ7kNvwEpHr2-&_nc_oc=AdqlwQCOM_KRASQbX2WPRIf0zIg7LS_WMevwurKYilmt-F0es5IwNe0M_wTP97iJexc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjm7qMZyXrEBY3LKFS5paPerkHyEsMz2ZBEVI_xl1VNQ&oe=6B033278"}, {"file_name": "com.medvr.Abg-20251224-121409-0.00_00_13_26.Still005.png", "id": "1792425384782546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618069_1792425388115879_5140686146519858561_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxRCm9Q-z98Q7kNvwFnbigw&_nc_oc=AdpE2beFGImaMv-o-v4BTKOEf91Gbw7wY3qBp-tYW6DyEbe4hIahY2RX5oUELO0HsLk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlwO7NtS8jZhkbox1Pc7dNgQ32lPNFOdxC8JbdnmnFFg&oe=6B0313E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arterial Blood Gas", "keywords": ["Medvr", "Arterial", "blood", "gas", "VR"], "long_description": "Arterial Blood Gas is a hands-on VR simulation designed to train healthcare learners in performing arterial blood gas sampling safely and accurately. The experience guides users through patient communication, consent, hand hygiene, equipment setup, artery identification, sample collection, and post-procedure monitoring. Realistic clinical scenarios reinforce proper technique, infection control, and patient safety while allowing repeated practice without risk. Ideal for students and clinical professionals, this immersive training improves procedural confidence and supports competency-based learning in a controlled virtual environment.", "short_description": "Arterial Blood Gas is an immersive VR training simulation that teaches the step-by-step ABG sampling procedure. Practice patient interaction, equipment preparation, arterial puncture, and post-procedure care in a realistic, risk-free clinical environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULT
vr.Abg-20251224-121409-0.00_00_02_09.Still001.png", "id": "853690917700323", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618069_853690924366989_3010497815623709389_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsHIwJiP2mgQ7kNvwENyuoc&_nc_oc=AdqgpwtvhGMKIwFLwRaV4QNb1fgvvy1qOmpLaY-1VRAfZ1fmXwv6NNIsO15Qw8s8hag&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbEn1FH0uX1SJFt1v-9ZPL1QfPK9vI0L45qIkweKPYLg&oe=6B0865C8"}, {"file_name": "com.medvr.Abg-20251224-121409-0.00_00_07_04.Still003.png", "id": "1297730899066743", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620504_1297730902400076_6465610088701193364_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXTCy3ch6PgQ7kNvwFc-QRn&_nc_oc=AdoMwAdyMPHNsHUYf-rtnWQU31bijQv0B7uNqeGYHAjM_PdtqdIMCyT3lCHoLgsogLg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStj4PcXiJf1wEcHCLhktdnGxmTZYzmRyh5Aptih09hbg&oe=6B087246"}, {"file_name": "com.medvr.Abg-20251224-121409-0.00_00_08_28.Still004.png", "id": "868175495825476", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618293_868175499158809_3560963665408877151_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AI9ANQX_SnYQ7kNvwHdd6A-&_nc_oc=AdoEJt-OpN9BMYTAY3NPhtpnf5ZH11uk7Sj-1GY4JN5nN5PyRUCSaHZe9qRQKSEA_EA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRHOlvR1WM00Ro1k-KfUrsxZ0Fl0Fr1tWAVocknr6CRg&oe=6B084038"}, {"file_name": "com.medvr.Abg-20251224-121409-0.00_00_13_26.Still005.png", "id": "1792425384782546", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618069_1792425388115879_5140686146519858561_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gTEqBSU1boQ7kNvwHQJ2R0&_nc_oc=AdqG3Sf2plvtwGODF9LB15XEhGxQGTLkKCFZHiMrInKQPhSTDZa-2Z6UDdxL8H6qC_Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvw2I9mLkVzqGb35OTl4uBP4yZanWjA75Vc-x66hrD-Q&oe=6B0859E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arterial Blood Gas", "keywords": ["Medvr", "Arterial", "blood", "gas", "VR"], "long_description": "Arterial Blood Gas is a hands-on VR simulation designed to train healthcare learners in performing arterial blood gas sampling safely and accurately. The experience guides users through patient communication, consent, hand hygiene, equipment setup, artery identification, sample collection, and post-procedure monitoring. Realistic clinical scenarios reinforce proper technique, infection control, and patient safety while allowing repeated practice without risk. Ideal for students and clinical professionals, this immersive training improves procedural confidence and supports competency-based learning in a controlled virtual environment.", "short_description": "Arterial Blood Gas is an immersive VR training simulation that teaches the step-by-step ABG sampling procedure. Practice patient interaction, equipment preparation, arterial puncture, and post-procedure care in a realistic, risk-free clinical environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULT
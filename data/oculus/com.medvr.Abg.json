9_5140686146519858561_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeqYr83GaFoQ7kNvwEmoC81&_nc_oc=AdkqgOzqGCMWWZ98dhCg0RMl1aS81FLnvHhBjBbZlHy0PpEJHh1CxD0k9rRn_3J1w_0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvFwJ5SNuB1HXZw9H8B3jJ1PftHImT5vc3RKvMqm8Sdbw&oe=699D9521"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arterial Blood Gas", "keywords": ["Medvr", "Arterial", "blood", "gas", "VR"], "long_description": "Arterial Blood Gas is a hands-on VR simulation designed to train healthcare learners in performing arterial blood gas sampling safely and accurately. The experience guides users through patient communication, consent, hand hygiene, equipment setup, artery identification, sample collection, and post-procedure monitoring. Realistic clinical scenarios reinforce proper technique, infection control, and patient safety while allowing repeated practice without risk. Ideal for students and clinical professionals, this immersive training improves procedural confidence and supports competency-based learning in a controlled virtual environment.", "short_description": "Arterial Blood Gas is an immersive VR training simulation that teaches the step-by-step ABG sampling procedure. Practice patient interaction, equipment preparation, arterial puncture, and post-procedure care in a realistic, risk-free clinical environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, 
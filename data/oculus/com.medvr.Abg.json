9_5140686146519858561_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IICulHfDPTgQ7kNvwHkF3rP&_nc_oc=AdkzqRYsawuL8kE59NuSGFKZYnUtvzflyCLZPv9HLsOVI7z9bcGtLxJoQ1M0a2TMDiU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv7cjgAvNDgWwmhDsRBKFGt91JS0vhl7R6G_SDzhXat_Q&oe=69984F21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arterial Blood Gas", "keywords": ["Medvr", "Arterial", "blood", "gas", "VR"], "long_description": "Arterial Blood Gas is a hands-on VR simulation designed to train healthcare learners in performing arterial blood gas sampling safely and accurately. The experience guides users through patient communication, consent, hand hygiene, equipment setup, artery identification, sample collection, and post-procedure monitoring. Realistic clinical scenarios reinforce proper technique, infection control, and patient safety while allowing repeated practice without risk. Ideal for students and clinical professionals, this immersive training improves procedural confidence and supports competency-based learning in a controlled virtual environment.", "short_description": "Arterial Blood Gas is an immersive VR training simulation that teaches the step-by-step ABG sampling procedure. Practice patient interaction, equipment preparation, arterial puncture, and post-procedure care in a realistic, risk-free clinical environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, 
wHuPlSG&_nc_oc=AdoaWz3ZDPBDlt6uoyRsMCQdxBsBVSUdv5zkb-eD4kv2KTehQwn87jGOgqjJ1p_5T-8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJ-PRJGUr71qRpC4L3NLKc2DPirjftykzrWtYFCB5Swg&oe=69CD29B8"}, {"file_name": "com.medvr.Abg-20251224-121409-0.00_00_13_26.Still005.png", "id": "1792425384782546", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618069_1792425388115879_5140686146519858561_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMACbHt61-cQ7kNvwF61p-W&_nc_oc=AdpOBhCJcdlrqgtUQb3g_3NlaAohZhwKoGNdnHcILIkBOwh-L5x11yfRkV41oH3HIeI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8sM2CCDalGCIVBJIe67FElnqYh2hXWogNp6IiOoKN5A&oe=69CD0B21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arterial Blood Gas", "keywords": ["Medvr", "Arterial", "blood", "gas", "VR"], "long_description": "Arterial Blood Gas is a hands-on VR simulation designed to train healthcare learners in performing arterial blood gas sampling safely and accurately. The experience guides users through patient communication, consent, hand hygiene, equipment setup, artery identification, sample collection, and post-procedure monitoring. Realistic clinical scenarios reinforce proper technique, infection control, and patient safety while allowing repeated practice without risk. Ideal for students and clinical professionals, this immersive training improves procedural confidence and supports competency-based learning in a controlled virtual environment.", "short_description": "Arterial Blood Gas is an immersive VR training simulation that teaches the step-by-step ABG sampling procedure. Practice patient interaction, equipment preparation, arterial puncture, and post-procedure care in a realistic, risk-free clinical environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url":
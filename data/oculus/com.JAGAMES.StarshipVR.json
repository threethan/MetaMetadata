uscdn.com/v/t64.5771-25/38974583_2885382471677884_7963674681236647067_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXeYUZRYaRoQ7kNvwFcrUcZ&_nc_oc=Adqq9WLYqANaYyGxEwbK7Y8etRkE-3iIl--h_FQmBTTjbi3DmIuFJ-dqp0SJ1hW4RgU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvTdcCPZkMMSB47y3RUwi-5nV8AXhFiJe6o9wZhFJC6g&oe=6B10655D"}, "display_name": "StarshipVR", "keywords": [], "long_description": "StarshipVR is a 3rd person action shooter, where you fight off waves of enemy ships! Wield your Starship in one hand, and a Gravity Gun in the other as you battle for survival. Use the Gravity Gun to hurl asteroids or as a protective sheild against incoming missiles - or blast away the enemy frigates with your ship's laser cannon!\n\nCurrently in Alpha phase!\n\nCOMING SOON:\n- more levels\n- alternate weapons\n- left handed mode\n- more SFX", "short_description": "StarshipVR is a 3rd person arcade-style spaceship shooter! Pilot your Starship to defeat waves of enemy ships and become the best in the galaxy!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/7e004194-74ec-4bcf-a512-9bf734070663", "developer_terms_of_service_url": null, "publisher_name": "Jordan Ariel", "support_website_url": null, "website_url": "http://jordan-ariel.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCA
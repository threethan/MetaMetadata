Rk3PR0Qp2ZNGvnMb8JjKhyTTCfO9EeZF1ii5IkXPfs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd1wBOie3BhBxCpcyryhujtfHYM6c9IyFxUNX7DE1wpQ&oe=6B05BFE5"}, {"file_name": "CoverArt_2560x1440.png", "id": "2174735556804199", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824700_2174735560137532_3349091047432593729_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m70itT8bKvQQ7kNvwGU4pZs&_nc_oc=Ado3owZbzbaIPK6ujjQMYwZ8fql_4Y9BqBthevsEVdfBsfVGkClbdgFAUU6nOFMOXyk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCNyeyOcUBa6SM-jWssDN-ll9LrMwYSh_n8rZlj6EF2w&oe=6B05D4B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Become The Monster", "keywords": ["lethalape", "becomethemonster", "scary", "horror", "free"], "long_description": "BECOME THE MONSTER is an asymmetric multiplayer VR horror game. Each round, one player is the monster and hunts the survivors. The survivors have to stay alive and fight back.\n\nPLAY THE MONSTER\nPick your monster and move with your own body. Swing your arms to run faster, and use your hands and your size to catch and kill. Each monster plays differently:\n\nHush: a silent stalker that picks off survivors from a distance.\nHarvestman: a fast, long-limbed hunter that can jump.\nHussDemon: a very fast demon with legs and no arms. It rams players down.\n\nPLAY THE SURVIVOR\nWork together and watch each other\u2019s backs. Grab weapons, reload them by hand and fight the monster off before it finds you.\n\nFULL VR, FULL BODY\nEverything is done with your hands in VR: grabbing, aiming, reloading and swinging your arms to move.\n\nTALK TO EACH OTHER\nProximity voice chat lets you hear the people around you. Warn your friends, or listen for the monster.\n\nKILL REPLAYS\nAfter each round, the kills from that round play back for everyone, so you can see what happened.\n\nEARN AND CUSTOMIZE\nWin rounds to earn coins. Spend them in the shop on new characters, and climb the leaderboards.\n\nSWITCH SERVERS\nIf a server is full, use the server switch in the lobby to join another one.\n\nThis game contains graphic violence and gore. It is for mature players only.", "short_description": "One player becomes the monster. Everyone else must survive. A VR horror game of hide, hunt and scream."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cblerim.github.io/CBGames/", "developer_terms_of_service_url": "https://cblerim.github.io/CBGames/", "publisher_name": "CBGames", "support_website_url": "https://cblerim.github.io/CBGames/", "website_url": "https://cblerim.github.io/CBGames/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1103237965754456"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1548632647024723"}]}, "baseline_offer": {"id": "1548632647024723"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793034180, "status": "PUBLISHED", "id": "1548632647024723"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1126866800058239", "version": "0.24"}, "id": "2062023594443691", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_a
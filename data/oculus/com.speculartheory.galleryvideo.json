e immersive\ntechnologies to uniquely amplify the storytelling for each individual project. Collaborating with clients\nfrom Fortune 500 companies to major film studios to indie filmmakers, Specular Theory has built an\nunparalleled track record for crafting startlingly effective new narratives using immersive technologies.\n\nHave feedback? Need help? Email us at: hello@speculartheory.com.\n", "short_description": "Download our app to get your ongoing dose of premium VR content and unique experiences created by\nSpecular Theory and our featured partners."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.speculartheory.com/privacy/", "developer_terms_of_service_url": "http://www.speculartheory.com/terms-of-service/", "publisher_name": "Specular Theory", "support_website_url": null, "website_url": "http://speculartheory.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "357277042607498"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1637029173253743"}]}, "baseline_offer": {"id": "1637029173253743"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1473231600, "status": "PUBLISHED", "id": "1637029173253743"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3305851926131443", "version": "1.2.3"}, "id": "923877981040752", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries
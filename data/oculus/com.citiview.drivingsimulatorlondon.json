74438630510607095_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkg3nulILpAQ7kNvwEIOfia&_nc_oc=AdqaEdCLfYnpun5ejnEorRZlwPGf8r7QvEGEsxcZyPaRTg_UYgRg2RCckdXDW0gStxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSSC-9uJgInj6GEFZ_Cum7A1oVVgIAZMfyLrsPp5qMgw&oe=6AFDDCB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3746766438806187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312068_3746766442139520_274616311266069679_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBE3H5u5714Q7kNvwEj3yPd&_nc_oc=AdpPTWB4vsDsb1cuM97CFwm5Itmr92flRlEgUsK1QFmW8fXbHGmkZqyKA0hfzuTPRx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqoEIjQBfyYpqbRV6-2Hd2QykCm-mX6nOh-3O7PLqY8Q&oe=6AFDBE09"}, "display_name": "Driving Simulator London", "keywords": ["driving", "car", "simulator", "london", "racing"], "long_description": "The dream drive, from the driver's seat - in London.\n\nTHE CAR\nA right-hand-drive V12 sports car with a race cockpit: racing wheel, bucket seats, roll cage, shift lights and a live display. Reach out with your own hands - grip the wheel, work the stick with your left hand, pull the handbrake - or drive with the joysticks.\n\nA REAL 6-SPEED MANUAL\nMove the stick through a real H-pattern: 1 3 5 up top, 2 4 6 underneath, reverse far right. Rev to the shift lights and snap the next gear in. Prefer to cruise? Switch to automatic.\n\n29 MILES OF WEST LONDON, ON THE LEFT\nThe M4 past Heathrow, the M25, the A40 Western Avenue past the Hoover Building, the North Circular under the Wembley arch and the elevated M4 over Brentford. UK signs, mph and pounds.\n\nROAD EVENTS\nSeven events on real roads: Heathrow Run, Orbital Blast, Western Avenue, North Circular, The Flyover, The Full Loop and Rush Hour. Race for gold - your best run comes back as a ghost car to beat.\n\nSPEED CAMERAS AND NEAR MISSES\nSix speed cameras record your top speed. In Rush Hour, close passes build your combo; a crash loses it.\n\nSUNSET, DAY AND NIGHT - with an original soundtrack on London FM.\n\nPlus British paint colours, twenty achievements, career ranks from L-Plates to King Of London, and a map with quick travel.", "short_description": "Slide into the race seat of a right-hand-drive V12 sports car and drive a 29-mile loop of real West London - on the left. Blast down the M4 past Heathrow, run the M25, take the A40 Western Avenue past the Hoover Building, swing round the North Circular under the Wembley arch and fly over Brentford on the elevated M4. Shift a real 6-speed manual with your own hand, race road events against your own ghost, set your best at the speed cameras and weave through rush hour."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/drivingsimulatorlondon/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/drivingsimulatorlondon/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1387635891099613"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"node
tY0a8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRmQOhgQAbJpuzdgL0hNl5CtQYTp7YGovzJvnomeTzvg&oe=6AECA2BB"}, {"file_name": "Screenshot 2026-09-17 at 02.02.58.png", "id": "28345182678507784", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825470_28345182708507781_6592056845728323808_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9SINda49HoQ7kNvwEs7obX&_nc_oc=Adr-3IdJWfBwagBXGzHvQiwBzjJbQZVIjPp2ykzJWThSOy0JsGOXLV68q2CyGLVR0q8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD28wVwa3kfrR3NsAfp_4tFHlZBWWXDXU8p8mo011lIg&oe=6AEC9FCB"}, {"file_name": "Adobe Express - file (5).png", "id": "4734239600140881", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824741_4734239603474214_8047515021453460091_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNwcXhuUkLwQ7kNvwGZ18jJ&_nc_oc=AdridY_RDKFLpYnVUrZVuFVAAUbrVwXwE2O5NjcqcohPJGrunkdOri9Q9K4Fuo9Y0KQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaRIfCRZxXS1PdKzRBdjQ34NOP5HXrR0AJjgpJiU0XRw&oe=6AEC9BA0"}, {"file_name": "Adobe Express - file (6).png", "id": "2232693613941723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825470_2232693617275056_3701863832233514816_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3FMfJGc8wQQ7kNvwFq4E8x&_nc_oc=AdpoDURWsbM1qFLrcjttfABZ_AArs04feS2xGMSDSgoINRfTX0eb7ziaqxYxnvpZhcQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRavYmLqeDktZ007t49o717UTJvfDgxdqZ9wKmI5KqARg&oe=6AECAAAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Doobles high quality (1).png", "id": "1596234372535674", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825462_1596234375869007_342087398617529741_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA3nYBajTDUQ7kNvwHbSga3&_nc_oc=Adr6ivuWz6uSNkVDH-xaVc20iKCUHEsujR00DrviwQwwajvEiAhHx5vEkUUUZpaGyB0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUWLdVTzmag48ZsB49z7ruFKLhqnYu_cEbm6VEO7ClWg&oe=6AECB8A0"}, "display_name": "Doobles", "keywords": ["Survival", "Horror", "Scary", "Social", "Island"], "long_description": "Doobles is a social multiplayer locomotion game inspired by Gorilla Tag, focused on exploration, interaction, teamwork, and survival. Explore the world with other players, socialize, and earn XP that can be used to purchase gear. Prepare yourself and your friends before night arrives.\n\nDuring the day, players can explore the environment, interact with others, and prepare for what comes after sunset. Gear purchased with XP can provide useful advantages when nighttime begins.\n\nWhen the sun goes down, creatures emerge and begin hunting players. Players must stay alert, keep moving, use their equipment wisely, and cooperate with others to survive. Some creatures may be easier to avoid, while others can make surviving the night more difficult. Hiding can help temporarily, but players need to stay aware of their surroundings and work together.\n\nSurviving through the night and reaching sunrise rewards players with XP that can be used to prepare for future nights. The longer you survive, the more important teamwork, movement, and good use of your equipment become.\n\nDoobles supports multiplayer lobbies where players can cooperate and compete while exploring the world together. Proximity voice chat allows players to communicate with people nearby, making teamwork and encounters more interactive.\n\nExplore, socialize, prepare your gear, and work together. Once night falls, do whatever you can to survive until sunrise.", "short_description": "Doobles is a social multiplayer locomotion game inspired by Gorilla Tag. Explore the world, meet and interact with other players, and earn XP through gameplay. Use your XP to purchase gear that can help you prepare for the night. When the sun goes down, creatures emerge and begin hunting players. Work together, use your gear, and stay on the move as you try to survive until sunrise.\n\n\n"}]}, "developer_name"
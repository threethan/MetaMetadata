_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZYng5CZWEG-GxTdZcAfuWEgyUfgtf1cZFAdOa00c8Iw&oe=6AEC8AC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Adobe Express - file (10).png", "id": "1838833506935456", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391788_1838833510268789_1776430007727559424_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkG7NKFqxA0Q7kNvwGqJJda&_nc_oc=AdqOnJB3tZzfSDCiHKJDRgH1L_obD_25dph9U7S57Q7t16y_-HtPPXiOxrg_AbVkTYo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0gpMVqfMU2b4YCFSnaZBldpHKZfdJ7eC3Bs4KZ3AbzQ&oe=6AEC9681"}, "display_name": "Doobles", "keywords": ["Survival", "Horror", "Scary", "Social", "Island"], "long_description": "Doobles is a fast-paced multiplayer VR game blending parkour movement with survival horror. Inspired by Gorilla Tag, it features a dynamic day-night cycle where players must evade creatures in the dark while working together to survive.\n\nPlayers control nimble creatures that can leap, swing, and traverse an open-world environment. The goal is to survive as many nights as possible, earning XP to buy survival tools.\n\nThe game alternates between day and night. During the day, players are safe and can explore, interact, and purchase tools using XP. Players strategise and form teams for better survival chances.\n\nAt night, creatures emerge, hunting players. Some are slow and predictable, while others are fast and cunning. Players must stay on the move, use tools wisely, and cooperate. Hiding may work briefly, but the creatures are relentless. Surviving the night rewards XP, but staying out too long is dangerous. Reaching sunrise grants XP for use the next day.\n\nUp to dozens of players can join a lobby, fostering cooperation and competition. Proximity voice chat enhances encounters. Some may build safe zones, while others brave the night alone for greater rewards.\n\nWith movement-based VR gameplay, cooperative horror, and social dynamics, Doobles offers an exhilarating survival experience. Will you survive the night, or will darkness consume you?", "short_description": "Doobles is a happy Gorilla tag inspired locomotion game, very chill and social, definitely not a scary game, until the sun falls... try and survive the night with your friends and purchase gear with XP that will help you at night time."}]}, "developer_name": "MXPZ GT", "developer_privacy_policy_url": "https://www.termsfeed.com/live/a9a2bd37-8dd1-4bb5-a6c5-6ca92fdd8eff", "developer_terms_of_service_url": null, "publisher_name": "MXPZ GT", "support_website_url": null, "website_url": "https://www.termsfeed.com/live/a9a2bd37-8dd1-4bb5-a6c5-6ca92fdd8eff", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23904832505773809"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4073627646190053"}]}, "baseline_offer": {"id": "4073627646190053"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747683840, "status": "PUBLISHED", "id": "4073627646190053"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25153698600887187", "version": "0.43"}, "id": "647734234275934", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "Andr
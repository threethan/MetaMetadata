9_4469253096065542526_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDdn__wQA28Q7kNvwEEemG8&_nc_oc=AdrceCtqTM2Klc8lwFRWpq0YELmWgMiacU92D5hJXOyZTj6h2EVQE-G02ntus6Hd1x8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GTpAAjlZo-mFDOU6p0cN4BB7XiQo_NWIpGDiFGCOBKQ&oe=6A36BE93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "335947718898792", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031402_335947722232125_1566035296004914683_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dq0sri39xlAQ7kNvwHai1qn&_nc_oc=Adr2L_7FEsS_gMnTRcGwsNWLbi1dRQEF54ziVRukzK8kY3DNtIq4jBafoFA8PXwHyHM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZTaO9EoR2x7UPY7LRB4HRCImqfkvyP1ruWjJ5UCLfAQ&oe=6A36A4B7"}, "display_name": "Steel Core", "keywords": [], "long_description": "Steel Core is not just a game; it's a mind-blowing adventure that will challenge your skills and captivate your senses! Do you have what it takes to become the ultimate mech pilot and thwart the mechanical invasion? Prepare for an adrenaline-fueled, groundbreaking VR experience like no other. \n\nThe fate of humanity rests in your hands. \nWill you rise to the challenge?", "short_description": "Step into the futuristic world of Steel Core! Become a mech pilot, armed to the teeth to battle swarms of relentless enemy drones as they burst through the walls around you! The fate of humanity rests in your hands. Do you have what it takes to survive this mixed-reality bullet hell?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1FE_KRzfpVu6qAcrM23w0e3OD7cIHwmDUBi2oD_4PxEM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chicken Waffle", "support_website_url": null, "website_url": "https://www.chickenwaffle.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"},
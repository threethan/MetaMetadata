9_4469253096065542526_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsfcTKP69MUQ7kNvwHwbXxf&_nc_oc=AdqzijXAn1zSqWgfLkm5twY2UHIo44RYVf9vu9kqlH1LcWUMQ_p8k4h2luk92xhWXVg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2b7EDKMbhR4rKPeflarjq4093b79U6cTv8_8sc2qI9Q&oe=6AA938D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "335947718898792", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031402_335947722232125_1566035296004914683_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2er2tvePQMQ7kNvwFwRMkM&_nc_oc=AdqjwRRvLz1aA8ixRyValKxhiSubK-NVe3gpqhXTVjU7jiXfEVINS3CxoXRDTtiUnlA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV2XYLQ_UVxGnOse8VETPM17k-QLCeBYibyXLfmlwlCQ&oe=6AA95737"}, "display_name": "Steel Core", "keywords": [], "long_description": "Steel Core is not just a game; it's a mind-blowing adventure that will challenge your skills and captivate your senses! Do you have what it takes to become the ultimate mech pilot and thwart the mechanical invasion? Prepare for an adrenaline-fueled, groundbreaking VR experience like no other. \n\nThe fate of humanity rests in your hands. \nWill you rise to the challenge?", "short_description": "Step into the futuristic world of Steel Core! Become a mech pilot, armed to the teeth to battle swarms of relentless enemy drones as they burst through the walls around you! The fate of humanity rests in your hands. Do you have what it takes to survive this mixed-reality bullet hell?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1FE_KRzfpVu6qAcrM23w0e3OD7cIHwmDUBi2oD_4PxEM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chicken Waffle", "support_website_url": null, "website_url": "https://www.chickenwaffle.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"},
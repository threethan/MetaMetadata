"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iz7DvB3KHcQ7kNvwEzlBT8&_nc_oc=Adqelpeo62d-pYCb6_Tc7RPC_Jt3XjloV_z1C74uw9jbok-ELt11dSwFcIPg9siVbJw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IJtda83uT4B2j2dCoxIwrlzBzXP0KdO2f9D53XTCsNQ&oe=69D25B57"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfL81kQlTTIQ7kNvwGF9KjC&_nc_oc=AdpXXMH63Z_NIQH19uronxrrfdJ2jvfqtRhWcwdbGbIJKAy1ONG6Sr4fy3mhfYBlINQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OK1-fgGHYZscOmFSjHitoPv416X69fnZ6L3yl6tR-qw&oe=69D26D5A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37XgPtGnhiwQ7kNvwFLMH2A&_nc_oc=AdqJYFbyOIGH_3D39umYARf_RziC7XdYdkDq2zJ2UdWotpVE2oE8zSS_FwI_P5Rly4Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f0JDqkoauavYSBpaa0o2DM_aRunWQNck3FisgjRg3kQ&oe=69D24D8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlwrL7XnvmgQ7kNvwGExs53&_nc_oc=AdoRzBjY-_c4YiEofBELkBl1wmh9ys_rJvQIcTTWbJ4xvLXVbkAML9euYj1mr3lNzTs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NempO8na0Ydjpx529STnRk6Qbn2pZieBqBsRQtyFKsQ&oe=69D25B53"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zs7gxjyXNIQ7kNvwF4VetF&_nc_oc=Adp-SzxGLOgOKtNtiI6mox7sg9zU2qN_Em1Kgk_tDXUFe6Xy63eXEXnzDgvFBFO_dvc&_nc_zt=3&_nc_h
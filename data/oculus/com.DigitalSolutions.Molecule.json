392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omO7KXGQ4ZAQ7kNvwE3_MUu&_nc_oc=Adk2bK8va8A5DeJllCvHxMleL_JoyCkA7VU5OmYSdg4OFbxeltwNMKnAaoeyhqdOiXw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs2CtAEmHyUkd6JrPntiR7QxtOt7WsDyScuo2PtdAJnXA&oe=69A2E557"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBHQbKVRvsIQ7kNvwGDgvIg&_nc_oc=AdkbN-1Z2YrnlaAbOW-Fq5PmKzELcoiPn8LlrqcpTie0f_xJq8x8KNeJHKM2c6G2kQ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv1pRnAhe8d3VEqOEv6E6b4mkWZtFdKTtq7tP2gw1zDlQ&oe=69A2F75A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuO0Bvj5nq8Q7kNvwEaFSPL&_nc_oc=AdkO7YarMYjquCjPCXYx6tgbxXU-Ft3ifF-iAi3_uwzyIb3KEKHApvvAD18F4Bq4_UA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afurx1BG-crFAp6bggSU_PcFIWOmKfc5tfeSheZgy0nRFg&oe=69A2D78B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZO9V5_zY1cQ7kNvwHdo2Tu&_nc_oc=AdkPuO2V0yKfjlsl5ooRPQg_Dg92rwB_e0gh2Kz3mVHGCEdb9Ashp-c6rqI7JZ12sLA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft4DKQxEh0UWJR52PnMGQqdQiJlYndDmYYVvYzfR6CeUw&oe=69A2E553"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQcM65sq96sQ7kNvwGULqQ5&_nc_oc=AdkxVX2FoZwOhaw7EC4i5xz_L3epvRZoyh0ZqXEQgx8OW5FLQUpULCTaTQJrAw-D1IU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsHSrUpmt8WhvVr6rrhzhu6JKHMAt0XhTBfonJVFO0LdA&oe=69A2FA9A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false,
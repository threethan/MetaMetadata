/v/t64.5771-25/473392185_1411802089802553_5106385707752524655_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMrIHQCw7WcQ7kNvwHMrMAn&_nc_oc=AdowtWDJvkx81b1TZ-LAEGBPteJcWPmou2cLEPBYLKTq73BtEHLI3ModXhncqds9el0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlK2nXjYBENhKqcseH1xPtW3XGyuVoTzGj9Wo5Mm_3OA&oe=6B01C82E"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q42T5OngvAoQ7kNvwEd5HiB&_nc_oc=AdqTd-8fa0vKebujOvw_TMQ88BDglKcmhOCtziTLh-HFSGCyXt--fyP096LkeHE8ico&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK9XP6CfSAau5WN3bf0sGtmePHtzBbU7JQUz8JeN5T7w&oe=6B01CC97"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fL8s7z7abfkQ7kNvwHFiHfQ&_nc_oc=AdqwozKj5wUBlbCk-kaIoDNykoaD7eMbRhK8hLGbHFVRNh6BQKggIiSD6y_L4tM5W-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRylPCxpKVXpGodlYkzyfI_7uOIW6bZpBM4N0Hu1p910g&oe=6B01DE9A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvM0GHEBIREQ7kNvwFlvxNL&_nc_oc=AdoTFeVxSa5MxnqnMqS9-mR7b4DaPjrMplMtVqMpimcl93OdXqlXEiX61hvfBoEPdig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPM9nPNi5Nh9ACVNFmm9_MpMI5vpB3q0FzfPuVJ7lfOg&oe=6B01BECB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWCVAkWaUTsQ7kNvwHRXI2p&_nc_oc=AdqTYghVK5FCi1qGN4MLBCF_rtwPauQgU_HL7pDJSglp7oYwwCj_LB9_RLuMZEneneE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvzJAM10uTHnhO2U6NS0b02c-xcIr2LwmsO866iHxKLA&oe=6B01CC93"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
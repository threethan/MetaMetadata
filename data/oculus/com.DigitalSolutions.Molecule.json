"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31i6zmlhswMQ7kNvwFZWJu5&_nc_oc=Adox31FaKr7ngHzGuyVUUYn8hW2FFzFytbCViCPWyd_k9-a5SwpAJHPKrDIYvZKA7tM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72XgX9PAnPVQCjdwhOZgZBPARr9_sw5JGxW3ZEouUnUw&oe=6A1D80D7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zx9DT5YlnA0Q7kNvwH4n3P9&_nc_oc=AdrzVtn-sIgDBN_rBC3CsLQAw08PFdRcbNurn80j9iwuY1W5XtsxWm92MVX-KnGe6lw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kmrje80loqDzxeAnI6Xay8KjRN8bqtRzNcqorYswJww&oe=6A1D92DA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBFLBriBrLgQ7kNvwFvSd_p&_nc_oc=Adp-dFucuI3DloEFuKPF_PSa69hiR7YfyTLgQWnyZMr7cDq3sxNVpl56wfAo005mGdw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i9TMiPR6_aFMZdwHqCDW44GsLE2zHtuOrgE5tV50BWQ&oe=6A1DAB4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--LLW9gfWMsQ7kNvwEq4LC1&_nc_oc=AdpIKyiybpUlh_ajTjlUncjMEkPgrxcCms0do3hpzi7Tb8EbkvYqtFOSr9lPE3vdTzM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dVzzP1jDReB0GITPM1kTUKtEMcU8bSmG1fpXjHXIRQA&oe=6A1D80D3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNPFNCvoNY8Q7kNvwEPV0pv&_nc_oc=AdoGP5aZkWF-VYJ71uoYUQ0dTuC-8x7UPBwRNiagFtUk8C7ulbrp3WQMLkNrJ-WAnhk&_nc_zt=3&_nc_h
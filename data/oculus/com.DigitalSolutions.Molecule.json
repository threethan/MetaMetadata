329096738203478", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxQWcUCuo0EQ7kNvwHWMO5T&_nc_oc=AdmeuWCpIpZ1_GYmTbaQMESoqe3JiW0PM8JOcRaMLYpXhEuZHGMFk1gyk53tF3HeQ30&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy_QgnuHzQ-htQHqAqWxibt9Te7cnS4eTE-ouzfsPsmmg&oe=69AC1FD7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oB6259vJldUQ7kNvwFy9qgY&_nc_oc=AdnAuhUlIS6WQ5BnD_B1b6i7Uu9kjESZVYaRMzab2T0dlqjbbzYBdygxRFj-_CoE3TM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYJGTGbYmooBvNkNHmtcBPgDQdbIcPmOq37LTbSPJrEw&oe=69AC31DA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7xX83zWQwwQ7kNvwHXXRPB&_nc_oc=AdnqFwEc7VB1W-yYlDUokIcqx3T-dmbN__bA_dBsD6l6RtktQJD2IKGog3FWfzgDiYc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAIytHtRk11kJ8z7GgLF59DtxsYoCkLWNscLlPntzRyA&oe=69AC120B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3Eqyrc3RFAQ7kNvwG17TPj&_nc_oc=AdmjWIZJj5Be5UF6YAsaKELr0Vi0_DP7WxBrFvlsS3yhH8TySJ3xEVjf0Fe0DboU7eE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxfuqKO7122gVB1Mflilg1J2dxYVAWAOUoS3KrcJBe8oA&oe=69AC1FD3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2nXk82du-oQ7kNvwFE4QDH&_nc_oc=AdlFZG3kNV2z_dy-K2JT46yVrZ1mefwP8giLd5t0U9RjLF2avx9mlKj7gEUAR6WFtyw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxbR
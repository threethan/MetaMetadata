"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzW_rjRQzscQ7kNvwEV3ZJt&_nc_oc=AdrDBwd4rB-cHuq7JFHx6ATI1s7n-W4QaXG-Ze7BnEfDRWiu6SVvRB5Jqz_-WTb5ZfE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BiqI3NFew000yPITyLqR3_JgTYA23TcFGh8Oimc2UKw&oe=6A183AD7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LDflocqHssQ7kNvwH-UWrY&_nc_oc=Adr552y344YsnvFXaQaNz60WovSvBABCVHp1eVS6ceASu6iUEUedG_Z9vuXFevm7Kjs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kVgYH48CtonmSZxNnBPaLg6OS0tNvf7n7hCiQ79m16Q&oe=6A184CDA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myMtoWf0HsYQ7kNvwFeo5ir&_nc_oc=AdooJeMQNMCv11yoYEy7FXeoX66Q-Jqy1BRbTy_R3Q0MvSBaDX7-0fDLSrvvHcE1z1w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZSzEMmxnUsXFai-Ni1zKW53_mc3ZZf0y395uebkq8Xw&oe=6A18654B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltiHJPfKAr8Q7kNvwE9-OVv&_nc_oc=AdpR97YZ-BWfmolT0nh8sZnz3lFtgWx9mXDBIzDQnRFSP2MEb9MLnVaM5j0LE2pvn8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KrllzwdQ_RRG43LnD3sxqe1a3vENsLIxlDQNv5fagmA&oe=6A183AD3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAdg6KAiQD0Q7kNvwEgMMxi&_nc_oc=Adr2LacJ3SN17pLBdMz_mnorSw1--LsHXf2q65dhehnfeWIh_XsCFSc3UaJ4Dn-Nkd4&_nc_zt=3&_nc_h
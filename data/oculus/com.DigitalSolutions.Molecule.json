329096738203478", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wotXE041czAQ7kNvwH_Alyw&_nc_oc=AdkCA-eDDNLOFdbyxKjPD6Wyvy35piceLrvFVf35IfvJf7rfythiuGceHk3JhUgY4PI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKhSyfIYTcVY19wdoC3-r_Y1B9_Aic5qtifyDOHswXhg&oe=69AEC2D7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dC1u5tF9jQQ7kNvwHR3Mzf&_nc_oc=AdnCSMUGyiIPPOqdRRJpVNpFXIM_SP_Suk_mAcYqbw6HG4SiJFPge8x6YF3b60u6M5E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvZ_Nv02ZB6knw0GFljmtbFZlqCr6kj3cyZEALkiOfYQ&oe=69AED4DA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVd_KkKBzUoQ7kNvwGXb0qj&_nc_oc=AdkPOqMgwJ-4mmvDZ3rY39E03Y6xx83hNzFfeeu-zjyxZ5Zw2hcEgSTof8e5zBlrh0g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzt_15Z9RcAmlRo8uxoCLBW2VrsfV_v1RONkQ81bwo3Ig&oe=69AEB50B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3Eqyrc3RFAQ7kNvwE0GG-k&_nc_oc=AdnCtW4_oDVU1rsM_T2ow4WQ_zsRc4NN_IQnn85AnG5F-1_k4HmjnersMY0q--8uPX0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPwMQaU38jWFjhZe7-gcfQBu4NuDQxypjuDyeSO6qQ7Q&oe=69AEC2D3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2nXk82du-oQ7kNvwHY9jHg&_nc_oc=Adkgfs49mDZDI534O10aQ8JLyJajXKr3vTlSfkDzo7WABgshd9tKnE79AK2BPcuycM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2y
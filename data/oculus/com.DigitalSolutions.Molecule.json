"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RN-64-4Mt8wQ7kNvwHe_kIc&_nc_oc=Ado3yGefn8izjsAdXME7GxVAh3bFavhbNkzXX1khrTi6dBYd9qCVlJzIYqyjTOtbs38&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ntT8EYdU8uFwQjijYLQDqCelE9c79P9CY-URITOFUfw&oe=6A09BA57"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkM4MJNGQu4Q7kNvwFzxJgF&_nc_oc=AdrQtTcPyFadIKeyzWxHhY6okMRR9jCA81OB9B-h3iSmJFGweyPxP99g0N0jmNSaHAI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dgXLnsBLgbGmaRxY-BoKh1z2CRbc1kED-a62MLQlO3g&oe=6A09CC5A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpCS8E-otpAQ7kNvwHMNhFu&_nc_oc=Adrfu87EMEGtzx7smJvYpAryLLlj-O4xnHYWTt5XMNp4khwlbjAIsGMqUjWJIsUiOBg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40typF8whLJRq2HzIUH6Fyv4yENlK4oqXTP8QaEHePbg&oe=6A09E4CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuiVZo3Axt8Q7kNvwGolqZr&_nc_oc=AdrLVht_jP0YC15kNphAcps9D_fBNcycv3g43nzDwe-gtn632_g9W38-kgB6nzBSpoc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XGLyHJ3f_oxOUmF4Z9k3sxW9RCkn6hnsTw0kR6fPVSw&oe=6A09BA53"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqmVpsgohewQ7kNvwGVvGan&_nc_oc=AdrDPzvqjlLaXXLIcvzwoC5JC9BMI6a-cqH15OrvrPCjqJjIZfHu6uRf3tls3j13F4I&_nc_zt=3&_nc_h
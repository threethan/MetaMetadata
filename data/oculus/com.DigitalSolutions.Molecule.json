"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi3SLyZ0bnoQ7kNvwEhMQ70&_nc_oc=Adq2sXQOPTD6wYw2RDigs6jCS37tX3A5ixYiKA9jRsxKmaN5q2OuZ1PhSSjwWnP3-Ls&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50Mvjty1hhx4qaPS4XfLLN3wGnLQAH0JmN7Al72dM2Jw&oe=69FDDCD7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDxxVq_0dOwQ7kNvwFO-o5l&_nc_oc=Adr_Y6vrC0mcRnE1k8wcSynVgX2i1RgQGklpNLIK5kFgjRglT7kx8SY6E8ZA4e9yBNs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UWLjNw8IAtdB9T1InzuRawCi0-zPAyXHaRO6dg_uvOQ&oe=69FDEEDA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efdstAwBeOoQ7kNvwEFRfvF&_nc_oc=AdpeVPaEJhisfSS0tzWpLF3KTEvugcqPTX9UHyiWhunYhbLmk8ueI0_c64UsGBvFtQc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lGpPJ5FefIwRlLaPaf62dN-wFfQdF9EV_jEie34mXhg&oe=69FDCF0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irAV0YWa2YkQ7kNvwFB_FWR&_nc_oc=Adr9XrHkc7i-nGCH6Pnxla-is6dTt7tyCZxrWhG7XEyrqVmMLHZJflnLEydiWsBmf6E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PO8bVHGercm1h7LsuS8tDEQ4i44MUiqWwk1t-PSF4VQ&oe=69FDDCD3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYutyGMzwX8Q7kNvwEVI6-K&_nc_oc=AdqIgNk7pmDsA9oU_xlb2wZrHO4rmupV2XYzTZ0g-IlWTicN_Zyy2K0CT9mYbcIGFYs&_nc_zt=3&_nc_h
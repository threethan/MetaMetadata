/v/t64.5771-25/473392185_1411802089802553_5106385707752524655_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8Kn92PartAQ7kNvwE4fIa-&_nc_oc=Adr8NCMhmhLOem4C3J_CrQLoURlrb7L4bmn7Aky8LRk43U7WnuEdeNRUkeIlkdfIt10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaQbXKoF3csomhX5fmwP-Gb1CiQC_rIPK95_OGWS1Pig&oe=6B0C542E"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jh_Z2LlFLWUQ7kNvwEbuGto&_nc_oc=Adqpm2qrdioVHi9lh09A7NfyB_PP6Da44CBHx92074gmN-bcUdA9exJuXXiqwlc6w2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvOiT-vOlo_yxrwymI2yb5qhSbdVZ0ozQtRsqp9X6e0A&oe=6B0C5897"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anUyq2hNKTQQ7kNvwEG6xpC&_nc_oc=Adp0k_UfWG0CYOJyq8P1A2EPUb49csRlszBdnQWMIMhReuxdresaZiy5n7zVwvC6-jk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2VBd2e3xlpjbEVV1N2Mwqi_moVbUu1AJwpExDCfxZ-g&oe=6B0C6A9A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVBTLiv_Ey8Q7kNvwHKUyE6&_nc_oc=Adowkf5pBZp9v11EV-WiwswF0t0EW58GvOl6pyArVxNVWRbNNI_s764Etg_HJUJjm1c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_zW2s4OTcfPqtYMpa23Ge8LFF4SOfy7E0kiRjv7ghmg&oe=6B0C830B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvSGmHGqsjEQ7kNvwHeHTkU&_nc_oc=AdptLZXWJrKa24AF-AgiMIbthD-phwFNLCD1EwJjuhWqvToeN32Q0QRjiIX7KEDz8B4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQVvfjvOIGQIhAZLYWjlnKUyZy_0stZJwqbhSAabU2zUw&oe=6B0C5893"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bn-NY2FxlAAQ7kNvwGOjaZq&_nc_oc=AdqPfs0aFAjyA4zTsQM-ss134565kjTGEQ7Udew_2Ayo4hdHqNdMd3KlIWL7HntHnBA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DyvUN99PxSQg7O9d4QMoKCxcRpNazI1xtunGEmjH06Q&oe=6A33EA57"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uypAxYhR5NMQ7kNvwGkEBbL&_nc_oc=Adoeu6sCPAgpmqCOos2RwyFeF5LVx6TaLi_zFo9KtSrDvRJG9JUE-Ej6vyNqUUTEQzY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5aGmEVu3m7yGasrbGurmHXZgbLSJjodXpvWckK8btDg&oe=6A33FC5A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKyN1ZUn6WUQ7kNvwEm55Nr&_nc_oc=Adrfhi9WzKKvskDG8kZ1JZLBU6rqOwan7YykKgulriLBKPeznvc5Z9ZapbBPQRN2-60&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yQj9QAKwLPOxPveXNyZwToLwyx-K0lSrNaScMqbVk2Q&oe=6A3414CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsQbZmIr3sQQ7kNvwHYjOmn&_nc_oc=AdrTmHPhFYW4zC7HY9FZhkxtsxa96iYnUaqYXGVJ-DP-5Lcd5y1ffDGO1vnzboF-kUg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wnIlSMU7lq40hctG_S6XN6PQpFwC66U-g0U0WQxoJJA&oe=6A33EA53"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVKBD9CxeMAQ7kNvwGOnYhH&_nc_oc=AdqUjVQUGFry8Z7-949RkXP8W5RIUmMRsB4a_8qc7RaLiZ9cyLXnaUGltqOBBuHMs1E&_nc_zt=3&_nc_h
"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dh4KiOO7ThsQ7kNvwFOBjCI&_nc_oc=Adr9MZoYydkZ0JLSYRFkDuyKZLYLt5w_fprTJzdC4vd-bXS-4dFvTNRLiy4zMuPEH_E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG088Vo8wNqSm6oNJ4EG5Kx8N-6XQo8UswvVIYJGu3AZg&oe=6A7483D7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhgHJfK8o6AQ7kNvwHQNvHc&_nc_oc=AdpwNZiXEKsHReGOvBq9-9KtphlItTiv7cQnN8nasbVMUMnu2hekGtG9ocBGZoyDG88&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSmlyqJrFtsw8MugSvEfWa7V-uyORELKlrz0av1N10ug&oe=6A7495DA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRxlp_xcBAAQ7kNvwFOsgQ3&_nc_oc=AdowCDEUdIkB3KZL-XErUA7NqCt6XurdxY_f4n8o1UTY8wtZn_MjP8wp12J7_uc1SAg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxmztsMUdZIMMMJmUqkKPOTrkt5XgutWbvFN1Chzt50g&oe=6A74760B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QBUdDKM0B4Q7kNvwG7YgMi&_nc_oc=Adq9PmocO4TKCploZckf4PezJjV3hG9rZxb1kq7zxUXkqtJWsqGg9lEf3iWmKmaWV48&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtwz7VHqvP5biE4ojF5Q18cEJnchpGsboeA-ZvKV89qQ&oe=6A7483D3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoKZ9iqZ-4EQ7kNvwG0AdgI&_nc_oc=AdpQsxcLzIADbn4fOYFNbcc9CS9tKoIMUlY0G2pGhgD96nA-uf4Ay4gLBlXD1rm0fCY&_nc_zt=3&_nc_h
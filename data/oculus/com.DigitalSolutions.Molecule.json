"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bn-NY2FxlAAQ7kNvwFjFHWd&_nc_oc=Adqajosj-u9ri3DwAzXQ4K0Kri4r0_HClYwv-x-MkzrvKURFXKdq-Cigoe2WfNqdCwk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DVNBhwfJtSEI2MZRauiO1sT_zSGTZgnxNWFLGSsaCXQ&oe=6A3298D7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uypAxYhR5NMQ7kNvwHbc0KU&_nc_oc=AdrjSfJC42r5FKZpnEbrbtKKnOPB9KmCJjh2-1J0U8jjf5rl4EEIz6QmHUCzlltvcDk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3J1G_KFY18sdQMU4XzfH6IFYps4sa58a3azBpeLlZTg&oe=6A32AADA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yf9MhmvRHBQQ7kNvwETGgyY&_nc_oc=Ado4jPI8UsYgiM9_aeTT17hDW7x1D-bVEl30d0LxMLAs19NdWBnAMjmErB2WhaKJmx8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rEZMbMt7P0rLo2yDLfmb7dQNNsQOEYTBqYiIcrA3iRQ&oe=6A32C34B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsQbZmIr3sQQ7kNvwHeY_dz&_nc_oc=AdoKmH7GhyMVnTpWD4UrOn2sgHZPprPBCnEt4a92q0Sx4G-QAcaSfFgswfFJvu1aN7s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8uMn_4V_WmvvxsCcN8dN2qdNac63NwL_WuKV6du6--Q&oe=6A3298D3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVKBD9CxeMAQ7kNvwF6og8e&_nc_oc=AdroC5RRBwN_9rzIEOYwxvkSxneXmHH888d8yKv2FqGx1vVtubPMgdhj_KAtreGag0I&_nc_zt=3&_nc_h
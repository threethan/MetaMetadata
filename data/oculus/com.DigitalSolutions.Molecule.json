&oe=6A85A2EE"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phHlUEId3F0Q7kNvwHtJVRr&_nc_oc=AdqZpIMK-FVy592EIryl-hAXMEGbj-XtrDgDpLv-ujOmGla7mNUle-QRzqFcbqWa5EI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcf8I3gM6qKZHHLlrY4E2ee5rxcg92Vu5VGeXnduRyWA&oe=6A85A757"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8h4nEWiJzgQ7kNvwG-57eP&_nc_oc=AdrP10dgZZaSJS1n7RlDdgpfdbBDweKIN2L7iTvuwSEBNrk-vaIVf5x65Bx7m3DQwnQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMXVnQKk3rgHtl6rUJ3rxyLmKY0S9W9GtNOCxKD3wUiA&oe=6A85811A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWPWAl0couIQ7kNvwEbLeZP&_nc_oc=Adqx2en3KtPCnrCJt_kGYzWElxPpwONLlpGm3bEjhHNKUKhFL6sIgUBb9aseFBTPRkY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEI3oPBE0_iIZ1ANm2VThLcQXhxD-s3F2CctLeQRi6lsQ&oe=6A85998B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZDnjw6S6AgQ7kNvwEmYnGb&_nc_oc=AdoJkzO6q4BqTRsk-AOnzwbiTKxbQHKCJQJy2Jgnb2kEXe7l1cBRUVrBLT5M48OVdMI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHj_TedZzl9U9JbZCsiGiDEFuxCn6kreR7ZHnTKD1xtQ&oe=6A85A753"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0RlYQJTzK4Q7kNvwGNF7ax&_nc_oc=Adp9W5mxG-UKOLZRiR94R7Xicvyb_WpyxwobCn8NumFKiKZYtXkZ1u8Et6tCF6
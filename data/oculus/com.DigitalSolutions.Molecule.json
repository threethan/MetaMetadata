"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnFXwsVRdw8Q7kNvwG0HVq_&_nc_oc=AdoD60qIZfWJdwP_cWGmB87Y2ryvd_15En4LYrlCFJS2vlVpQRzujGI1FZuoY6v3g0I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iSVImRQZsjnRCaCbKKMWVJ1Qn6667c7F8-5Ip_sGsSw&oe=6A2FF5D7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S92BFMCm9HAQ7kNvwEEp51t&_nc_oc=AdqEfnzASlha9w6UZ4fkL1PWqT4PoKE0XArFDInXUzMFGML6jHkn5U4BR6OJS9XuVIE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ohbHejycSfK5QBwInO-QnWMT-I6kuvd1719iEkpIjGQ&oe=6A3007DA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yf9MhmvRHBQQ7kNvwHkZsTf&_nc_oc=AdrccEmDw9vPQPDy5NLpUf5Lwz9uAUp5jZYH41WGQ8aXloHjSHYKqXV9qJvAuqlG6dA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DEYyLiX5EjJDtGdruSfpqxIGh-Iguk4NjRCoPIwm8zw&oe=6A30204B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djnRIFfV6OsQ7kNvwEAd68W&_nc_oc=AdomXdTxVXXdiQIOV4vwXlNfDYC3QboSgbJL_xDT2Rw4pNMzb4-3-eEnhLHmWIpkG0Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BdYl8WHikVQtDaScc2Fj27XHA1V_Rac2BZZ8XSVpBww&oe=6A2FF5D3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OThO7qFv8wMQ7kNvwFky9Ls&_nc_oc=AdpjMuIlLXa1Jr1GlRKOM3wFR5wT2fDv50WmxQPbr4-aWPZkbfVZn-OVRIUYXknsNwU&_nc_zt=3&_nc_h
392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omO7KXGQ4ZAQ7kNvwHflIe-&_nc_oc=AdmqUE1naowsNwSB61EvcuTc8lYpW-zsZJN72jH-h1kxgFzq0dFsv_dd1aafnyhjPC8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs7c0cjsXnUbL1161Rx06o_W0gpVJfXc2A0Z8nTn67CYQ&oe=69A436D7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBHQbKVRvsIQ7kNvwHR7qk0&_nc_oc=AdnHenEA2IuzfMGhqusAOGsAmk-vwl_hPMookUeOc6t9SeMI-HHxZ2EG1s1YmSV8Dgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfteYDeBXPtM6fV2U5-ejHEfnLsTbL-ZoAm5uP1A3ag4JA&oe=69A448DA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuO0Bvj5nq8Q7kNvwEFEfwi&_nc_oc=AdkX8Mxcoz0akmkBLodaqzaxYr2N5Z8dCWcqrgjoDaIM8eh2I1ttOoEOd50b-HzFraI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfshjP2wA_u5RzUISGA9-8sX-OlliliRceDPQYVteYqKug&oe=69A4290B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcBJa4yjl2wQ7kNvwEHW2U-&_nc_oc=AdmgQq1ImPsdtMLL1ici58tKkT1xziOyGI2F5_NyNSLMzZNZqPX75XwGJRXedU7yUPw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afva92XELj0NsrUj5Z2wG_BjywtFWApIMWVB8v008ZIlqg&oe=69A436D3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5-XzfCG_zYQ7kNvwFW_PnR&_nc_oc=Adk9F3z-SiViOkvgRu7g7SEAcac2oFM8TRFzZA4gZ-Mwhsx7F3GFqNRxi11Gm84cta0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuiNFXo-sZ63dgvfq_HK4IdcwegvhWIqoqn_OM5tuwDxw&oe=69A44C1A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false,
"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEWbvrkqIYgQ7kNvwEwK-QX&_nc_oc=Adpd-T5xR7CzJWHwmH2_lG4_FvvAJ1Vl1LWY5-IWw1t72efFz23a8q3-I6nGc33PivY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LHzAqqQ_2WjJvFn9o6s9dIk1EyWDR1XZ-4SS-kh0DMw&oe=69FB39D7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dW3NTSam8vcQ7kNvwHKSzQ8&_nc_oc=AdpsBUYsSqYuEk1FIZ-x6iOQ0_EzW7BjD7GHvX8nMr23zJ4wvxaAYKiDzceXcTOmwqY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YGNx87mn8Be4w3SMzZmJgYX4ZD_AhGT5lXT82AAqEqQ&oe=69FB4BDA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3G26hEvJoYQ7kNvwEmNglj&_nc_oc=AdrucxfDdbHp1Ac1O2XVx8RF7bfPfmR47BOti5jZ7uQdRJFeuiVJLhNYKIh1DXhnkWs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JxPHr1t3YTcd3dbyHTcbvfgg4j4veAb3jzYifJ9kxAQ&oe=69FB2C0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irAV0YWa2YkQ7kNvwHGXh1Q&_nc_oc=AdpKfgg4d12AyrGweMb1Vat7C0lhlMAyH7xfzKW76hMlO6P_7wglX6V6UgGatXzaxNU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_N5gWzf0CYV97DmDRQWFFc4LE353KlatDWK9_oBYwYw&oe=69FB39D3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYutyGMzwX8Q7kNvwFfby6J&_nc_oc=Adpp6UNDUXKdhb8TmVh2D111R3hWP62dYzaXaKJsc2ElIGZqQGdQFfKtgfTVpTVVm9M&_nc_zt=3&_nc_h
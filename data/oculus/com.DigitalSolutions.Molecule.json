"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNdMEhAOlMMQ7kNvwHjHGgZ&_nc_oc=AdrGtV6CLgaKFHp8DgW86a2j5jnfmfWW5TSeTHslUOGZZduImq6sFG4o64gJfgZOV4M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_a8WifXqOiceWCreI0nUaEVyI-t_qLGkFTMejFa890oQ&oe=6A2C0157"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QN5CA7lLCrgQ7kNvwFHtxdc&_nc_oc=Adp1arEdywXlnLZWQ6ODowoJpcZc9i5o6FjkqlU5S9CVw9c025_ynhqOR25LDzrysYU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rI5oFj0itxe9cqSK7sGJjr-Rpw8q2Acn-idhxkOL2EQ&oe=6A2C135A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVjppwGS-JUQ7kNvwEZoEOR&_nc_oc=AdrJp2_e8thzElecbMoxszojyjmoTFJiVIZe3Puyp2_YvE1vJ480R5EemhjKwEXRyeg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hZtlxDQMB4Duz0gFE23OJUY8asn2BHeP0qqLa_I3OYw&oe=6A2C2BCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTejT5_zPcwQ7kNvwE5ljW9&_nc_oc=Adp_SiFoYG7jxIamCSh1iQxEoVxWjbpMcr3jsi5W1RbJhgd7YhpfCB9bOmxa7rpelZc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IrwdkPYbXyykIshW3egV_GMpVQm0yk91l7G9Jn5_f3Q&oe=6A2C0153"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WmSSgLoVbsQ7kNvwGaB3UV&_nc_oc=Adr5h_awTWjiR_D18bw6QOTDnmKBwB8EIxKqh-YxqLPNAd2VKktos3c9-wUFFDMAafQ&_nc_zt=3&_nc_h
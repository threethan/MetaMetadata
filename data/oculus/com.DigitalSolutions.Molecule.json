"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wF9x6HvYQCkQ7kNvwHsbaYR&_nc_oc=AdrdTWAnwEZG7DvTJmOCRQbnR9ivsOGtQtTGnjTq5xtiCJQifkvpKf6Q5aplLD48ksE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-d1YSmKI5SnI2rXJvox_dRI0_h6U0oslCbhyFDasjJA&oe=69E8C4D7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-4VcR4YaN4Q7kNvwEFn6_K&_nc_oc=AdoBS0TPpHbcOM4iBtjuvQqW-iCR9LdCh0zvMhXlnJFGlzqVhgxD-8M_i5GcZNTEYG4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lVD22YgIBAhU193adcuOymgclgdMoOc1scx4AySVWbw&oe=69E8D6DA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rY2Q2c-QNEQ7kNvwHVM6pA&_nc_oc=AdoJpfxhUXXyPKSYqDKR2u7lvB1wEEGkae6EslbhKFPj4cTQ-me-Xh5fuTz7SSuXbMw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39_zTIvf9EWxYrd3DcXc71eZK1XdmuDiJvfcGYMez6nA&oe=69E8B70B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-3DFCgwb24Q7kNvwEXHQ_f&_nc_oc=Adp1pr1jCDKyhzVNaJR7cxkkGmmL_DzO7CqmUOQu4rnUo36NXTgujqiHwmDHuUhnz_8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Pumb4ZCuegcUdEs5TvM2fLNWRN_q8LaR1HSaDKW-mvg&oe=69E8C4D3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8v5y7IO2OCMQ7kNvwHjKgjg&_nc_oc=Adol4epgbM1a0N1qS7-eBu4o7u6G8TNbdTKYk-loTiLlIR4SQfmi3mwGtNIy2UrwA9U&_nc_zt=3&_nc_h
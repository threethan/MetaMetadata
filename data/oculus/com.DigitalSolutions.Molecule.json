392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcyMMilnLk0Q7kNvwESbTlG&_nc_oc=AdoSqYDoOHRYWyD-8g2_muVd7RoYGkP9FcXWjmaAWpiyYYBKiasf-JexiJ-BVrmtY7A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0umhzd7effUPNQ8Jmzfwl5xhdfLLZr5dic20zSAFLKXg&oe=69F0ADD7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5dr7O5KmFkQ7kNvwErpJ5q&_nc_oc=AdrDpaIaKBNk5Z2VgiE5jxIaQERxTlJgDwOLx5JS1Si2yRlaDbK6sEpERsHX23sw9WQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0eFIyb7bJv0SkD422aWD6ZYf5ITBkNYO3OMsK7UVawpw&oe=69F0BFDA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7YLvmqYclgQ7kNvwGNMMF_&_nc_oc=Adp2k7serPUZvZFCTLbPVR5cAs0PFpeCRAK_5GUiQ44LK-ZwVTp4_DFMnFMz1cnoBO0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1H3UhjIlpQSbPdRzyd5aDkgaLEBcNW967GI_MBMGMYHA&oe=69F0A00B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kao1EaP3bDAQ7kNvwEPEBuT&_nc_oc=AdrYoHW0iNUbr8nv8rw1SXJ0eat2_uJ_7luVoPQp5agfwkNurZHSZ4Z25so88OGGlmc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0Kc0_Es2q-wjNMjaU7fliQLzQACb9xoUo_EcHLpTftew&oe=69F0ADD3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8r9-FgHzKUEQ7kNvwE9XyA-&_nc_oc=AdqM_73P_1usRvGePCXAJ8LtaTY02kaUJzavnDvVqZ_aFYZdAfrpoWbNPL24h1bbqo8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2quvhWE2M1gHthDyJHFmCmXuzA4qt9XotHzqfQkbkSMQ&oe=69F0C31A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false,
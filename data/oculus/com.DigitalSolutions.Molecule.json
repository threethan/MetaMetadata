"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Do8ziHi_uHAQ7kNvwEY0gSo&_nc_oc=Adp03Gzt3a-GA1mbNSmd8Mq6aYVCFRFfGJ2w51j5E4ohqu_6okvSVKBbgfd79Xpxyc8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50gIIGNKy2_IeqhBhaNwRp62drD0oZW5_a6gibfiXSbQ&oe=6A0868D7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNbvxBsOioYQ7kNvwFHS0qd&_nc_oc=AdqVt6DCoBX1Vo5FQ8B819WHZ_vrtluIs1kXrBfjcXZNsg0uQQhPkCFctvqv0GGwlGg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gMwEbi9ljRov96G8ixxBS_7ifZDahRQ6v3qbu3NT76w&oe=6A087ADA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpCS8E-otpAQ7kNvwHiIG22&_nc_oc=AdqIlTsWd79A4ZV8g4ScrlERuZcXYvGajh-KLGjS5A-SWYn1UVb4iHhcSJFU4GN90LE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FJ5J4VcY3ddhpBplOk-T-XUUGkTSJiBz9pJxqvEJjMg&oe=6A085B0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuiVZo3Axt8Q7kNvwFZpv8F&_nc_oc=AdoNgbUerYiie2G4QO7KLOUJ6PH8raG7Cmvwx1SMhv82LaxPA1JA846IJwPA1El0hSw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4omHrm7nWtJwKEsGoS6vPJJ7BFUonqWFLGzgvQgrRu5w&oe=6A0868D3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqmVpsgohewQ7kNvwGqv199&_nc_oc=Adp5WiA-g0njGeBNbr6Rz2fF_W7ZJtwXw7Gn7J2BRtdx_IPTcOtb3igC7mRwq36OZ2k&_nc_zt=3&_nc_h
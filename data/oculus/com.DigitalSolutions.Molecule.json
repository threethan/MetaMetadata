Tk-kgDw_1edEo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEafoTnAbwBS_pzId90yzMwAPem5UwnN6TJNsvHilV7HA&oe=6A8D8BEE"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3VJyBG6ajwQ7kNvwFhWHNQ&_nc_oc=AdrTGbrDV3ZLsSGQFdfNLKUp3791ZggHfptqqWelP1_Xupra0y_ZHmPYXv05bIXk5G4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbposT9O0OtENEKADgTt5HWg0F6WsnhcG1H9YSGOzRXA&oe=6A8D9057"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAWX9M7zF4MQ7kNvwFOIxWY&_nc_oc=Adr1ayrycIVfxvD0SM8VU5r-4xIr_n8o_mFi7SN3o-s6qaMxfkw4J5BEX7bMpZ3bvww&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyTzIj-D8OwEp06DnKhITjoZstc9GMsRXmV_ZvJkgF6w&oe=6A8D6A1A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCu_3W53qHkQ7kNvwFE-z4S&_nc_oc=AdqcNmySL30GlslB9srY-FWTUJ25s6_ueh8IVKyXIkx46zwFZlQ-4suMy4cy_EebWjc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHL0fTmpbIR10tm-THpqeA3j9eR3f2Apv8eBrznjWdQKA&oe=6A8D828B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_YCBXS7lQsQ7kNvwEvsrmu&_nc_oc=Adr2wQKKNOiqTLS2l6Dv4bS3fpQdAQT3-2-SRyh08vVRDklg4a2M4yCtnrFP0enZqHo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE33nekxFTylTe_cBTlUfJAMSCrneHwv5SOG_giVV-mjQ&oe=6A8D9053"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109
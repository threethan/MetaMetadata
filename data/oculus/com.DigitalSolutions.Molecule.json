"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sb0MytavsBkQ7kNvwHsUS_i&_nc_oc=AdpQo8L5z_Z8p5PTFQdcoF4x1uXx8rTU-nhqAKHrWWmsLp1J8RSC08n3gzfJvgTZqPA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Lsfp6_Yr4Gg30VuFqL9Trn7luQkUj4gRQdXjERhqmpA&oe=6A198C57"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8wCWZSNdpgQ7kNvwGam3fM&_nc_oc=AdrTWilU7OeI83yUcM1WmLZYKB97wdBf0dOyBgj6QMFEN_Tsei54o4lDJq6bUjNbyjc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nFpWxDY_FErpXRXtyhid1Ly4uZEaiWAQEbhVOb_E-4A&oe=6A199E5A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myMtoWf0HsYQ7kNvwFGhCe-&_nc_oc=AdrrfOrYFvsLjruazkgsO7QL6N01rUSezDOu70OFvk6bWyq4ibvBXDjZZvOjbfxw2M0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6diOBl0uWwK0UR9q0X51Of_w0ZPqaJCKGltDeqwIOnNg&oe=6A19B6CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltiHJPfKAr8Q7kNvwGQyjT9&_nc_oc=AdoNgqCEGUubtBBLPlh_ZYKsZpSZP0mDg7ZPjZDCuYC_fWnpqJ2USxBZrDXUHprdlOM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dHPvc5tzbWQ267a-5-ootyGTSRZztVDjO-nobXy8D-A&oe=6A198C53"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAdg6KAiQD0Q7kNvwHQxudl&_nc_oc=AdrNXNJR5coi9XU5zLopkhJja_7Zc1UdrluwuNrde9oGZ1xGzPCePPuLw3nBKD0vHaY&_nc_zt=3&_nc_h
329096738203478", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gprBuVa8NkQ7kNvwHTvDd0&_nc_oc=AdnYjKcwmyu1MnEr6SPW1g1Iu8jowwMwE6eyYj9ZRDEekAlUOL4WykMN7OJP6sUCxe4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxp8Jon15gskpwRZ93V1nPqR8moIma0xF4EnyRXUiKv0w&oe=69B94ED7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HDwVaiDuygQ7kNvwFMvql6&_nc_oc=AdkEwpS-M86T9M13fbnpWW6nHxilFGZP9yaPcbIKpgRW7LzA9kom6rmStYYKFMbF9nk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpM4jBvxWowj0n0eITinc9v1qV8IM6FKeJy-vNCKvlyg&oe=69B960DA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op5NT7JVyAcQ7kNvwHICt5I&_nc_oc=Adlh8R6LW72LNsWg9AglB3WrDtT3ovin3EPBk73IkYNesqJT3ztaOEVLerL5icHCJt4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzrtqFtwQR43PZ-ZAYUFaRGFdNhBNESdciQBZu4Tqm64w&oe=69B9410B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Zc6UyWXQ6kQ7kNvwEkW5AC&_nc_oc=Adnk4_vIq6OdQRXRYeHfVv9aRv-vvqI5pnTOT3I2zD8R8DhTk94i1WivWBE9xib5QSQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz83VN8wUwhYAtWRXXbDF2pdQfz29QN7XY5kGKg8OOSeg&oe=69B94ED3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhcS6q_hgCcQ7kNvwG2NJG0&_nc_oc=AdlaJCuDznc80TruccGy6axim-uRBo6_8RM2inHEeD9rPWQrTxPHFqj3mCZCJU7lG48&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwLD
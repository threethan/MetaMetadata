"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Do8ziHi_uHAQ7kNvwHRIHHg&_nc_oc=Adoma0AbhiBD2vSfjy5U8UlOShxw0rkvR51CVFUe4Ja7rSpWI4nhFnVfIT5o5MTRnLo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ybEO5ibwiuD72E0ormqGkDRNZgbNUp7SreHUKOIY8mw&oe=6A071757"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNbvxBsOioYQ7kNvwE6Khli&_nc_oc=AdpOWJwmEJ2KXRLuCdo57siNdiwdnHEvnwPeG2ibKTl0Jph9BElUxfPBbF4XP8Aqqwk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69ExaxG6z31YvDhnTSCy46CfZK-FwlrqlI8ILsEHl5aw&oe=6A07295A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28zo1LILv48Q7kNvwGGGEPt&_nc_oc=Ado7EIW7H8-aZFycztfxiV4pagBUKIlCI3fLRRTklrKFauayTyg7jdNc-SQmv7Ps-C0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WpqCfGM8DttqAvvwgVuPGjfkBMBZnc4ExKvdEuJpSPg&oe=6A0741CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuiVZo3Axt8Q7kNvwHSZ998&_nc_oc=AdpX1Uazwi5DyCcaNp3IQDjdnW0fgMZhqFCJKyeulAm6yrwXvt9NXY6tcfUKgLp-G-w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43deioTfe7I-Zemfdmh0WcPSCPP_6hyXu_xXiPBpVDng&oe=6A071753"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqmVpsgohewQ7kNvwGmsznW&_nc_oc=Adpif91WWBXzIl0bz0E34dpkdRr5ygCjfYZeHG5vABwg8o5iYvpzp7yDo-QRZWBDPew&_nc_zt=3&_nc_h
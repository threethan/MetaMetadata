"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbfzI2bxcSQQ7kNvwHgJRjd&_nc_oc=Adr4koLnKrEknaLCRujq3VlIn_77ghZ3BwZg7uLFvbxiHQ9X6-T_xlTRCr73DQi5h5c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmJzRl8-nbNyapap3R3rZ_mDN1lHj5hKVJ03CS9V9zEg&oe=6A50EB57"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPYJrEwmJysQ7kNvwFCuQlq&_nc_oc=AdoldhEbhVmgE2j5aPTIuiG-l7vnph218mLKgt7HvgIV5lRcqYYKxPr7Q2IPl9qtdlU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPLDhIahJft1BumNfAikHoaFICx9YqQ37CgZY7wbYSfQ&oe=6A50FD5A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAFRCshXwaIQ7kNvwGsS6LQ&_nc_oc=AdoytyZRPJydrDlMn6ezCgE4DKTsW6MYhqqD6wrQB0T09g8Rv2NHyCb3AcJi6tXZ_WY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAv0rBRNVnBsX4HnjjdmSYno8FyDTd7Idg-OukfTYs2DA&oe=6A5115CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIDdTXGqvw8Q7kNvwHPmp6g&_nc_oc=Adpm3BKbC0frEZc3a337_X9VjwEB7na34XF4E3_QgnDv-04QebF1DQ6HwE1ATF1hAEE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyF6JkLvViWFi6YPIolkcHpHgebNYuSdk0k8RAJiOeqA&oe=6A50EB53"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1jOA0JCRG4Q7kNvwHGyLj4&_nc_oc=AdprbsAN5txLKhpD5tOt5vmSKc2gZWCBBQSlkj-3p9wHfyMJPWvzQ_NoAArcNwXWDL4&_nc_zt=3&_nc_h
392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jffaOfNSMiQQ7kNvwGrcBbT&_nc_oc=AdkDhcyBHCPtELi2N-X1LLkREKcMo5mrw3bNwmgW3sFp2v-uZZgCAnxs84HBkZyKOsA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvvZzKt_xUvIG-gAc0NSoO4nZxeZoM5zR6YsY2RPFPkXQ&oe=699D9F57"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yH21XRTJzJUQ7kNvwFqma61&_nc_oc=AdmU1AvBP5ZenyKMjlxxMC9MfKe81rW4P_--DAHQ2w9zQvZhB14y5i7-PObBr-iN7j0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfubiKIZbhQKiecJqVociTt64XqM3M9OEg4D2x052Ommmg&oe=699DB15A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4DmDjNvTrEQ7kNvwGpACf2&_nc_oc=Adm-EFI_tf_gY3CpSnzqj0h2a2wm_Id4lqh23aYxNPMk6gszP0RaOzblaC-cGszCcv0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs7eW3sMPKw8q5FZhC009Qxn8lVtwCNRdyphwXsWljoWg&oe=699D918B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6LDTh4vQl8Q7kNvwFG6lj-&_nc_oc=AdkDI9iHw79hcjgrsJ4A6_ltAGRxGJGgN-rjirYPKGrgMxQSr1LFvnlUvDGAytZ6fi0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftIFBGJYcmVULGHev9Ho5D1UqOC8vHk5b2hRjGyjA0Zgg&oe=699D9F53"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lza7cACvybgQ7kNvwFl4oL4&_nc_oc=Adng4V1dvJnR8C52eAarcTRJRpJ2YlfcRyJZw2lowyjpfT067m7ztRkbBJerYJbL0_k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuUh1CLvZNmpXeyFBxbqgORpZbArSEFujAJ_m5es_0zAA&oe=699DB49A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false,
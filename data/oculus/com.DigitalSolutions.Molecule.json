"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhEZ8BRVwNoQ7kNvwHZ2nxo&_nc_oc=Adrs5rpsiCDrSDbsDj5MoDKe8aemta1zcbrMb33RsFRjcGATR9YhVr2i4x-b6RN2PGs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7h2Wy7K58ledOr6H_E4StT2Blmv4T0jciglLW7lr99tA&oe=6A1051D7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbVy4hqx6rAQ7kNvwHATyiR&_nc_oc=Ado_b1SFazvEmUry5aNulqOtsDMsZ0GZZemEI9aQcwW99yTAzQiq9vuqar2PUTbgdp4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43C2m6kWGRn-pTtwEqM-3pIU4HJlORCLiotCEBS0t90g&oe=6A1063DA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tdYx3-zHvkQ7kNvwFWZMt7&_nc_oc=AdpG1SWC2qfJVMtxylVXBOItE9msZUCdknvmjph_Fm0zWSXQUTnDnDhlD5ixgf0kt2c&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LoroA4gyCbQoTsAZ0fcN8fYz7wk_o2IkUVezrWCmUiA&oe=6A107C4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jk7l9Vp3_t0Q7kNvwFhxydW&_nc_oc=AdqFsJEqME5MD3T-mcwQw4w8PtCx-mV_KWoVrXJcAq1mRmkI6F4tiQta6IhZzgXtI-o&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66o5hnV0AOyxjInvdnPwmCkqov6trznyFQkvkPYTcK6A&oe=6A1051D3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGrUn4a-VrQQ7kNvwEJEo1M&_nc_oc=Adol9enmnUtPTcqrBLNx1vMYfy9p2QoLb49NaBRkstg1DS3YVCbnXsG8Xpp4G8GX3fk&_nc_zt=3&_nc_h
329096738203478", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4w_uGET_NxcQ7kNvwFqy0wL&_nc_oc=AdnyhXCA3uRUM2Wbq3qHAKtO45re8nyQch5NnDnmRg6yGO2axeKnxMTkw58xrjY9IqA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxz8xD9z8WKu4-u_S4DGDbymiDzJHdiWABkbJ0F0_SrxQ&oe=69BFE657"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOWmX1LJAcgQ7kNvwGJ_DIs&_nc_oc=Adn9yg_edacTjuNYBUrEu2xtbkCBd0FbmPAX_4LgwzO9FXDfPCYCgyV_wCM_a2O0-gw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwTLCqrANDn6sOkgyg5YQ4hwb0xuH2wLFFeiuRUmWDQUw&oe=69BFF85A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgjIE5u_hzoQ7kNvwFX7OuB&_nc_oc=Adn8XBJ2csfoBRkQBHWHYchbw6vxevg_pXl5wuQXErNnVh72TH5DVQjZlM09a4i9MII&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzlegUjIsgwx0j4oAnIyF9HZhTcuK1FNZuonr4-TElBBA&oe=69BFD88B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3OOABO2DKsQ7kNvwHoiWW8&_nc_oc=AdkJ7RQkK45MsEljYR77raZmcQQLqw_rjfqOCkxTjSj_YkIQcX_2nmXHACG8WHBM-Xs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzwce1cWyQT8XLhMTGVwki6dVJtcY-GrTNX-1noQTEgSg&oe=69BFE653"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ei7REg-pjW4Q7kNvwFXaU0G&_nc_oc=AdmpWNvjWJ6OePLJc_YkAHLHGoI4bMM6RO_zWwGj1E-Ed7-cqRqjgXa6wm0fniKioxY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZj
"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IJ0IKl5omkQ7kNvwHfRyXO&_nc_oc=AdrGGF8QloeVNTuko8blG0wuu3031HaipqbLr15qv4GI0UgKYlPNz63Hl8S7DmJ-XJ0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAr9BNzg1R5qKH_0jizo9fheLKg_FJIEQRviaWe6bQOcg&oe=6A58D457"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGZy6uLmduYQ7kNvwEf9k25&_nc_oc=Adp4MmH2Vq5kZTAXPURIF5eA_8HbnZBdqMv01IvBPAR30fTJJumkTkoVqa_0r_8cw3Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3_hefky-0Z3-D3nbxlg9JEvHzSVzGzsbal0UVf95lnQ&oe=6A58E65A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyBVAVv7k_sQ7kNvwFnAJg8&_nc_oc=AdpA3lo7vbCqFV3hz_29gw2you_frdGRLaOiiYkC8TSpekBQ8uUNwPu9fc4Zd4tOXDI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMeYtRw3VODbeqyEjRknBeP3zeN61QmpAKLJTuuMix_Q&oe=6A58C68B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uYS15V9cl4Q7kNvwFKLUmC&_nc_oc=AdrCYOJHddldiGKu3R4ic7v4vxjp4p5yQ7Bnqqz3tAj9W5TlFju_eF6_GF5T-dagLq4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmxTsSs52AiYVRwRxn9TVXV_TWbQcv_BzAjElnxWXB5A&oe=6A58D453"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sq62dwLU90IQ7kNvwFypNx2&_nc_oc=Adp3P1Z4KAyWwejMF3OEg8Llfr2NKNA3adEKfW6_OeB6L0aW1LuiGWpMjYFLCV0FkEI&_nc_zt=3&_nc_h
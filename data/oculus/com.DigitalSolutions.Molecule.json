"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGDkPXpDIKEQ7kNvwGwcn5T&_nc_oc=AdpitZ6HQBlQABU6Tl498z81PXbiUzYmkT9VGJ7RhZ8XWUUQQG9YVLYNt54a7p0ATP0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0Yo13I0c0wu2Iwx627WSTKLlyk-MmQAE8MuDGf8uByQ&oe=69CD1557"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYO8ZfF_dKMQ7kNvwFZnPjL&_nc_oc=AdqSHtjXrorrCCnSVu37ytia0jigL84CEbSzzGQD9Uan4c8xnJi6QMKtkP9ChCeJrR4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxub3_tFefouQdnxe71C7eJCb5ckYRI_i3avB8Tx_kvoQ&oe=69CD275A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpBO8Y4dW8YQ7kNvwFefXPK&_nc_oc=AdovtZE6yxmehUr3TzLnVw3uDodQgog229ehx89FIYb3q6CC0zpSudS87nG4EUrZPso&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwX46yVJlbDA7mGv0d9MMct_CEUjkbamQ1IaKszUb8L2w&oe=69CD078B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fy4IXAsw_PAQ7kNvwFKVtCn&_nc_oc=AdrqUPua2p3zSwf0QcwX3Og89HHf7y2MSmpkukOa8-rjAhU1F5Lf9kXunh7ApkSTQzs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-IA70cnyAzsOL0iAB6M0sMxdFBn42n_bMWMNWOzpAGQ&oe=69CD1553"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGwMEFW2Fm8Q7kNvwFEMeQm&_nc_oc=Adocdy1Q3CrXRbDqCUNWiHlH2RWi-98b6yC73PE6qBO1fTNYf2iclIQwNezgQBV3xEs&_nc_zt=3&_nc_h
"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-v4bRX--VgQ7kNvwHONGdo&_nc_oc=Adqv5qIe8Eq9pX3ZAZ6BmQbnBgxetO_YOTVy2-3FXpGq4VmaEpIrTbw1bf9R9RZIKsI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZaTo1fen5GyxrLlInxctA5QqZDpIHx9wp2kronvEujw&oe=6A69F7D7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zztF69JvKUQ7kNvwEMEn1G&_nc_oc=AdoAHDQ3bKBdIPQ0ooiyR93PB2oiEJGABpA_-CVk2JmNuOCteZME_CR4hZZURGLxZPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrIkX0UAT7Et0xdhW3HrKlj9qsPvliWyKZLVKibBp9Lw&oe=6A6A09DA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NjdistuzngQ7kNvwHGXk09&_nc_oc=Adrcfs_U_ZQY2AOay681plgS3gmL20nTTF4wM9Sg7Ipwh0KfwmgCy1f7JJcR7TuisuY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK6zuiQ67hbrx9NyPQOo1lN_wNCxYQvSrWUB00gI8LnA&oe=6A69EA0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5FhzlwLgdIQ7kNvwH8B90Q&_nc_oc=AdrsINoOep58kAKc2X_d5Bb4aH9NJWOD0deqoBQamM0QqaOzgPaeFgBP-DozzX78Teg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyg42fo3WIWxNxgEAyeGR9XmGa_UEojejulU8vNBOTOQ&oe=6A69F7D3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZIVR2dS4qoQ7kNvwH2nyRR&_nc_oc=AdqsgdpdfOoie3-jhu08kX_6YobUnmYt7CFYT3W79W6mmRjpRDBDpFtRi-cWjuO02Hg&_nc_zt=3&_nc_h
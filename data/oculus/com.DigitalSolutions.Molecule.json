"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aswub7ea03cQ7kNvwFPO6Y8&_nc_oc=Adq-CMlCDkdfU4Sx8dIPHxf_boB-YUDW_7G5uELxKSeyGSqZXPksP09c8vbo1WkDMjI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MV13epqv1KxuxMYBMxm0HqzHM16KsHQjecs4RZej0Bw&oe=69DF8A57"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XboJ2J54EMEQ7kNvwGaO_fi&_nc_oc=Adpg6UYLQqId1aJIcCMX7BqJA5tSnAmNoKz_UvtQEA4_CJbbSB0lQ5j7ppaiEA6i3xU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fT7N9f3NPr1PERjRcR_GUBg6RAXOoROUByN0JSkr26Q&oe=69DF9C5A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpjMdgirUQoQ7kNvwGaViDt&_nc_oc=Adr4IIcmKZHO3h-oe0YVw4HMTz3bLNV_HO4RsteGNDnJ1R7bv0muZrHKHm1Y92yZSUM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1w3ebCLc89xaAQ-29hk-T_DC1lIw0rzpf4m6BHpmqvSg&oe=69DF7C8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZ3ufzjTKTMQ7kNvwHmGR3v&_nc_oc=AdpGpCun3CfuWgToHGYDRyAP_Qq9mIQMve52E9N-wMonCZNziDr0Szz36otn508pmr4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3evWInuNWwDEHLP9GmIxPhOviSsLLHxM8JaNfj4kTP7A&oe=69DF8A53"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rY01eGj8jVIQ7kNvwFq34El&_nc_oc=AdoAzgft2mHDtKpQNROocUFd1PeN00xDEDw4HBvCgGMbOtRH_qaYTH2d9MZPJsG3ZT8&_nc_zt=3&_nc_h
"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WB7ZOjf7XlUQ7kNvwE3q5io&_nc_oc=Ado6LhQp71DNtYmPUD5ZLGThwlGTrIx5Aqd4yBwR9TIs2-K-De-QAV4ksB28ne9xL3s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xpXfLyoPMVZw7m76nBHFfbRdtU5FQmXovP9h8YADH8Q&oe=69DA4457"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWH0chq5AQ8Q7kNvwFgTzAZ&_nc_oc=AdriDs6wOxN6HV5hTG_n3vWJBEt0cc_SAV_UBoO04NVFHbIivr4PIuJDW3pke8UHcWI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FEU2Gov9ggrwnMZUqfxxxBrrezsrkCyxGu4qmUz04uA&oe=69DA565A"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BY9tjNpuxIQ7kNvwH0rjAW&_nc_oc=AdpBIf_5qWrm0812npWECmHsrZyzEbp1iAbZGzbmSM84MBA2ALab8HNyiJII0Sjj5_A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WT-H3MOMjzGnF8Kd0zoC2Y47MFRawRpPEyoHM0bnoPw&oe=69DA368B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grPouCHaEasQ7kNvwFxOn4T&_nc_oc=Adq51cuLR4KqZ1b8qpxJliFmzWBsU4iN2lpTzKfIzoXoEuGSfRyXowSv5n0Ku-kRNlI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cQN64oU8xFoCpJ6wRfeyKvhEZOUT7x2l0bD8vWzXFEA&oe=69DA4453"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRMyXJ48zAIQ7kNvwGi88_n&_nc_oc=Adp-bzQoQqel1v0v1hnxKoSI2JYF1A5FxGW0uuPNFI7tq2LCsRIEczCR_P3Jjvi0jRE&_nc_zt=3&_nc_h
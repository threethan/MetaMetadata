392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JV0iLJcd6IwQ7kNvwGj-kH4&_nc_oc=AdkLoBxGqitkawa5t3RvCVqk4l_tJkOA28aQB9Md7_f47m02fKVstr0Xraon2jki1Q8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afsud9o-wuKO3E-wveJDZ-64Fr5286HgFj62-UdxAmOmXA&oe=69A193D7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMkL--dvPvIQ7kNvwGYVbRY&_nc_oc=AdmnTmcIBUifDWybh6c-Z-fdPV6pTgM6mYnxtkHE4A9PYSi2G2K5U2J4TBopA2QZZ2E&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvqtASfbaWL1fwST6nV5eKrK9n1oBjHMbT54zSt-ZYWJA&oe=69A1A5DA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuO0Bvj5nq8Q7kNvwEh4H7A&_nc_oc=AdlwwXpAc-Hs2Z7jjf8txhm8ASBapdutOfJN9ThRBzYbpEaeHQwVB3wGSp7a-y37nXc&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfskHLK1ICX-7GoiXwcOtNxrwUaQaCH77IhLkWR2RxTXcg&oe=69A1860B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZO9V5_zY1cQ7kNvwHcgmB6&_nc_oc=AdmbiS02wfy40MCUixgqJyaQc7zGgHZPFvGGCXgvc4z455oUp2ngv7rMIJgPFyWlA2o&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsBuBSBgvsu1Bpidyx6bs6G4PJWS0_Pmoxs0lIJdyVBgg&oe=69A193D3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQcM65sq96sQ7kNvwFzgpbV&_nc_oc=Adk0qxL1CgDZxNob3sFONvdclHrpLIHd3MD6G1d9tKkc7Em71odyJkhU0AuSE2K2AuY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu7pK5wyPhIV8YMRKrrVGdhFMIT_N24-DGAEJstAvJjxA&oe=69A1A91A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false,